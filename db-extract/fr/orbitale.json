                    }
                ],
                "senses": [
                    {
                        "sense_id": "5bc90854-95e9-3ec6-8a14-a4ce398efa4a",
                        "entry_id": "8e2198fb-f045-3246-8c1c-558b81b50a91",
                        "glosses": [
                            "Fonction mathématique représentant l’onde stationnaire associée à un électron en interaction avec les autres particules constituant l’atome ou l’entité moléculaire considérés, et qui détermine la région de l’espace correspondant à une probabilité de présence donnée de cet électron et à son niveau d’énergie."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "43b067ba-5fdd-4b1a-86b2-13b0ba810b56",
                                "sense_id": "5bc90854-95e9-3ec6-8a14-a4ce398efa4a",
                                "text": "Dans FHIPP [126], les auteurs ont donc préféré ne pas désécranter le pseudopotentiel avec cette orbitale, mais plutôt avec l’orbitale de référence."
                            },
                            {
                                "example_id": "cc98a623-27b0-4524-9d05-0af33ba99e11",
                                "sense_id": "5bc90854-95e9-3ec6-8a14-a4ce398efa4a",
                                "text": "Orbitales atomiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83f84801-e23e-4ec9-b620-24c9c56a79ce",
                        "source_entry_id": "8e2198fb-f045-3246-8c1c-558b81b50a91",
                        "source_sense_id": "5bc90854-95e9-3ec6-8a14-a4ce398efa4a",
                        "target_lang_word": "orbital",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orbital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7607a9a9-36fd-3e2f-9081-3e6073f97c5a",
                                        "entry_id": "d9756cd2-e615-3390-be2b-56c79cdbca51",
                                        "glosses": [
                                            "Of or relating to, or forming an orbit (such as the orbit of a moon, planet, or spacecraft)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "977cca6d-9e68-424e-9836-03bbab7403bd",
                                                "sense_id": "7607a9a9-36fd-3e2f-9081-3e6073f97c5a",
                                                "text": "The 1.2-meter-diameter (4-foot-diameter) telescope has set off on a monthlong journey to its orbital destination of the sun-Earth Lagrange point L2, which is nearly 1 million miles (1.6 million kilometers) away from Earth and also home to NASA’s James Webb Space Telescope. Euclid will keep pace with Earth as our planet orbits the sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9b8bd11-6134-30c3-99ec-0818980587c6",
                                        "entry_id": "d9756cd2-e615-3390-be2b-56c79cdbca51",
                                        "glosses": [
                                            "Of or relating to the eye socket (eyehole)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00ec237a-0f20-38dd-8e03-74fad098dc04",
                                        "entry_id": "d9756cd2-e615-3390-be2b-56c79cdbca51",
                                        "glosses": [
                                            "(of roads, railways) Passing around the outside of an urban area."
                                        ],
                                        "tags": [
                                            "UK",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c544cb36-a3e8-47b3-8a25-f050fdfad1ec",
                                                "sense_id": "00ec237a-0f20-38dd-8e03-74fad098dc04",
                                                "text": "The M25 is an orbital motorway around London."
                                            },
                                            {
                                                "example_id": "3870e404-a4e9-408e-a5fd-cd8437379fca",
                                                "sense_id": "00ec237a-0f20-38dd-8e03-74fad098dc04",
                                                "text": "The rail orbital routes outside of the M25 and South Coast are challenging. The corridors aren't particularly reliable, and in some places they don't exist. [...] But the reliability and journey times, particularly on the orbital routes: one train an hour from Gatwick Airport to Reading? Surely we can do better than that?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orbital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "180184fe-4bf6-3be1-8c38-8cc6923da86a",
                                        "entry_id": "227156c7-892f-3f32-84eb-afc5874a357d",
                                        "glosses": [
                                            "A specification of the energy and probability density of one or more electrons at any point in an atom or molecule, representable as a wave function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
