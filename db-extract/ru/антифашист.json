                    }
                ],
                "senses": [
                    {
                        "sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                        "entry_id": "acb27e67-a74b-3971-a642-7eae2f49589e",
                        "glosses": [
                            "человек, ведущий борьбу с фашизмом, противник фашизма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f31aba7d-277d-4da4-94c4-eb8812d6556f",
                                "sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                                "text": "Штурмовые отряды, вооружённые до зубов, избивают антифашистов и евреев, производят повальные обыски и аресты."
                            },
                            {
                                "example_id": "fa8ee040-cef0-4adf-a3ff-54c1bba12daf",
                                "sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                                "text": "Постепенно мне становилось ясно, что существовала какая-то группа немецких антифашистов, связанная с Бухом, они помогали военнопленным, которым удалось бежать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e34e2cf-1d26-40c0-8a64-a7227725a0c3",
                        "source_entry_id": "acb27e67-a74b-3971-a642-7eae2f49589e",
                        "source_sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                        "target_lang_word": "antifascist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antifascist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "108108f2-49a5-3da2-87c3-b75c7d64a1ed",
                                        "entry_id": "f5abaf55-b1dd-3f5f-b36f-f64e1a6f449b",
                                        "glosses": [
                                            "Opposed to the tenets of fascism; antifa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c519f96-f063-4f3c-a0ae-26829ea5c592",
                                                "sense_id": "108108f2-49a5-3da2-87c3-b75c7d64a1ed",
                                                "text": "Subsequently, the GDR’s antifascist tradition would be diluted, distorted, and refashioned into an ahistorical national origins myth in which the citizens of East Germany were officially proclaimed the “victors of history,” but where little space remained for the real and complicated history, not to mention ambivalent role of Stalinized Communism, behind it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antifascist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ed91451-cf28-3c90-bc0f-5174fbe35b53",
                                        "entry_id": "a23dc4bd-0eb5-3aa6-9f6a-6cb0bfe08e94",
                                        "glosses": [
                                            "A person opposed to the tenets of fascism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "428eb7a5-6e47-4eb0-b235-c3952067b78b",
                                                "sense_id": "3ed91451-cf28-3c90-bc0f-5174fbe35b53",
                                                "text": "After the AA/BO split in 2001, Antifas continued to work locally and regionally as dedicated networks of antifascists opposing far-right demonstrations and gatherings, though many also take up other left-wing issues and causes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40cb6307-54a8-4f0c-bce5-d2b19bca5482",
                        "source_entry_id": "acb27e67-a74b-3971-a642-7eae2f49589e",
                        "source_sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                        "target_lang_word": "antifascista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "858073aa-eafa-4fc9-bf16-52af2dd20bdf",
                        "source_entry_id": "acb27e67-a74b-3971-a642-7eae2f49589e",
                        "source_sense_id": "a067b57d-d082-32d4-8256-d1b525235a8e",
                        "target_lang_word": "反法西斯",
