                        "entry_id": "d5a2d14b-9fe1-38f8-8376-f3643f7a4be8",
                        "glosses": [
                            "het veel verschillende vormen hebbend; het gevarieerd zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef95aa7a-a74d-44c2-850b-460b0baf4a2e",
                                "sense_id": "f326a48d-fa42-325b-980e-05587153cc32",
                                "text": "De hele veelvormigheid, de bekoring, de schoonheid van het leven bestaat juist uit licht en schaduw."
                            },
                            {
                                "example_id": "9163be3e-6a74-4486-9efa-37d387a841d1",
                                "sense_id": "f326a48d-fa42-325b-980e-05587153cc32",
                                "text": "Die veelvormigheid gaat ten koste van de duidelijkheid, stelt Schultz. Ze doet de aanpassing op verzoek van een commissie die heeft gekeken hoe de verschillende verkeersborden langs de weg duidelijker kunnen."
                            }
                        ]
                    }
