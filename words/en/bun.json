                            "target_lang_translations": {
                                "ru": "Мистер <w>Бун</w> переехал из Камбоджи в США в девяностых.",
                                "zh": "文先生在九十年代从柬埔寨移居美国。"
                            }
                        },
                        {
                            "text": "The local directory lists several families with the surname <w>Bun</w>.",
                            "target_lang_translations": {
