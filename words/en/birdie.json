                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My grandmother's name was <w>Birdie</w>.",
                            "target_lang_translations": {
                                "pl": "Moja babcia miała na imię <w>Birdie</w>."
                            }
                        },
                        {
                            "text": "Everyone in the small town knew <w>Birdie</w>.",
                            "target_lang_translations": {
                                "pl": "Wszyscy w małym miasteczku znali <w>Birdie</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
