                            }
                        },
                        {
                            "text": "The final <w>computation</w> showed a significant increase in the company's annual profit.",
                            "target_lang_translations": {
                                "ru": "Итоговый <w>расчёт</w> показал значительный рост годовой прибыли компании."
                            }
                        }
                    ],
                    "synonyms": [
