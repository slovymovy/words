                        ]
                    },
                    {
                        "translation_id": "d12f4448-7065-498f-aa21-605f204fca46",
                        "source_entry_id": "fbbba379-3a81-3c42-9eff-be4be64fea71",
                        "source_sense_id": "44848ad5-5f1f-3339-90da-94196df4ea1a",
                        "source_sense_description": "niet mis de verstaan, met slechts één betekenis",
                        "target_lang_word": "eindeutig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindeutig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                        "entry_id": "c6962fd6-1f16-3873-9abf-f6724e1bf73a",
                                        "glosses": [
                                            "keine andere Möglichkeit zulassend; nur eine Deutung zulassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13299546-0d0e-4622-bab2-ba344e007e04",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "Dieser Brief ist eine eindeutige Absage."
                                            },
                                            {
                                                "example_id": "861e056c-eca0-4f8b-bce1-b5ae0344d9f1",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "Eindeutiger kann man es wohl kaum formulieren, wenn man nicht beleidigen will."
                                            },
                                            {
                                                "example_id": "110e88b3-7a38-4aa7-a1fa-181b049bbc78",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "Die Pisa-Schulleistungsvergleiche der Organisation für wirtschaftliche Organisation und Entwicklung (OECD) sind eindeutig: Die schulischen Leistungen 15-Jähriger mit zwei Jahren Kindergartenerfahrung sind im Durchschnitt besser als die von gleichaltrigen Mitschülern, die keine Kita besucht haben."
                                            },
                                            {
                                                "example_id": "70ff2d6f-14b6-499d-856b-2bafd8ed40c0",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "„Das Material erlaubt aber in jedem Falle mehr als eine Deutung oder enthält mehr als ein Bewertungskriterium, ist also mehrdimensional und mehrperspektivisch angelegt und enthält eindeutige aber vielfältige Schlussfolgerungen.“"
                                            },
                                            {
                                                "example_id": "cd4913a0-d0b2-42c5-bb06-fcf3dfa021a5",
                                                "sense_id": "793e78ef-519e-3308-b5f3-445b4b09a3d5",
                                                "text": "„Die Forscher Dr. Lisa Welling und Justin Mogilski haben dabei herausgefunden, dass Personen mit ‚dunklen Persönlichkeitszügen‘ (‚Dunkle Triade‘), also Personen, die eindeutig narzisstische, machiavellistische und psychopathische Züge aufweisen, aus bestimmten, pragmatischen Gründen mit dem/der Ex befreundet bleiben“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b8b9f00-a837-41fe-a857-fd476835c86a",
                        "source_entry_id": "fbbba379-3a81-3c42-9eff-be4be64fea71",
                        "source_sense_id": "44848ad5-5f1f-3339-90da-94196df4ea1a",
                        "source_sense_description": "niet mis de verstaan, met slechts één betekenis",
                        "target_lang_word": "unequivocal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unequivocal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25d04c6d-5008-3afd-a863-f306dc81c7f1",
                                        "entry_id": "275dfc8f-ff9d-37a2-b376-8185bb243e8c",
                                        "glosses": [
                                            "Unambiguous; without equivocation or ambiguity; singularly clear, unmistakable, or unquestionable"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48938af3-19d4-44d8-b6c1-f0fc35314426",
                                                "sense_id": "25d04c6d-5008-3afd-a863-f306dc81c7f1",
                                                "text": "I want you to give me an unequivocal guarantee on that."
                                            },
                                            {
                                                "example_id": "79c7a129-a4f9-4051-ab00-1b076f8a11d7",
                                                "sense_id": "25d04c6d-5008-3afd-a863-f306dc81c7f1",
                                                "text": "There exists no moral system under which there do not arise unequivocal cases of conflicting obligation."
                                            },
                                            {
                                                "example_id": "02028f20-4c05-47e7-afcb-4a4e1238812e",
                                                "sense_id": "25d04c6d-5008-3afd-a863-f306dc81c7f1",
                                                "text": "Finally, in order to construct an integrated picture of genetic alterations in GBMs, the unequivocal alterations were mapped onto known gliomagenic pathways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92b618b9-6458-305c-aa54-7a5f3f2e9057",
                                        "entry_id": "275dfc8f-ff9d-37a2-b376-8185bb243e8c",
                                        "glosses": [
                                            "Without equal, matchless."
                                        ],
                                        "tags": [
                                            "dated",
                                            "possibly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcea9876-785c-45f2-928e-334cc5c5d726",
                                                "sense_id": "92b618b9-6458-305c-aa54-7a5f3f2e9057",
                                                "text": "the unequivocal scope of the Golden Gate Bridge"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2881d408-a5a1-4d0c-9dff-4021938f3698",
                        "source_entry_id": "fbbba379-3a81-3c42-9eff-be4be64fea71",
                        "source_sense_id": "44848ad5-5f1f-3339-90da-94196df4ea1a",
                        "source_sense_description": "niet mis de verstaan, met slechts één betekenis",
                        "target_lang_word": "unambiguous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unambiguous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c308d35b-81ca-38c0-8b09-2fe6a016aa17",
                                        "entry_id": "9a2c7049-c02e-347e-97cd-5ee2b91b701f",
                                        "glosses": [
                                            "Clear, and having no uncertainty or ambiguity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24f2c8b9-2220-4189-9467-467cf34b0620",
                                                "sense_id": "c308d35b-81ca-38c0-8b09-2fe6a016aa17",
                                                "text": "An LR(k) grammar is clearly unambiguous, since the definition implies every derivation tree must have the same handle, and by induction there is only one possible tree. It is interesting to point out furthermore that nearly every grammar which is known to be unambiguous is either an LR(k) grammar, or (dually) is a right-to-left translatable grammar, or is some grammar which is translated using \"both ends toward the middle.\" Thus, the LR(k) condition may be regarded as the most powerful general test for nonambiguity that is now available."
                                            },
                                            {
                                                "example_id": "4ca578e3-c2e8-4bee-a11d-5345d43ff168",
                                                "sense_id": "c308d35b-81ca-38c0-8b09-2fe6a016aa17",
                                                "text": "At the height of the crisis, according to a retired SAC wing commander, SAC airborne alert bombers deliberately flew past their turnaround points toward Soviet airspace, an unambiguous threat which Soviet radar operators would certainly have recognized and reported. \"I knew what my target was,\" the SAC general adds: \"Leningrad.\" The bombers only turned around when the Soviet freighters carrying missiles to Cuba stopped dead in the Atlantic."
                                            },
                                            {
                                                "example_id": "fedb6fd0-e453-4415-b1db-3e7818a2729f",
                                                "sense_id": "c308d35b-81ca-38c0-8b09-2fe6a016aa17",
                                                "text": "Other editors opposed to Atsme’s edits were just as unambiguous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "982d3c2f-0a44-4c92-8876-9d53c78793a6",
                        "source_entry_id": "fbbba379-3a81-3c42-9eff-be4be64fea71",
                        "source_sense_id": "44848ad5-5f1f-3339-90da-94196df4ea1a",
                        "source_sense_description": "niet mis de verstaan, met slechts één betekenis",
                        "target_lang_word": "explicite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d87160bf-9b08-37f3-8998-1a510851bbe4",
                                        "entry_id": "9d738dbb-7ef5-32cf-a862-177dae6adb38",
                                        "glosses": [
                                            "Qui est exprimé, rédigé ou énoncé par quelque chose de manière directe, d’une façon claire et précise sur laquelle on ne peut se tromper. Dans le cas d’un texte, l’explicite est ce qu’il affirme textuellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64d9896b-4148-4a2e-9245-7e98a46b80b2",
                                                "sense_id": "d87160bf-9b08-37f3-8998-1a510851bbe4",
                                                "text": "Monsieur, en arrivant près du carrosse, fut frappé de cet éclat ; il témoigna son admiration en termes assez explicites pour que le chevalier de Lorraine haussât les épaules dans le groupe des courtisans"
                                            },
                                            {
                                                "example_id": "7a66d584-dce3-45df-a506-1294013ef797",
                                                "sense_id": "d87160bf-9b08-37f3-8998-1a510851bbe4",
                                                "text": "J'ai reçu des nouvelles du front ; lequel, on ne me le dit pas. Le timbre de la poste est mystérieux. Il porte seulement ces mots peu explicites : Trésor et Postes, 20 octobre."
                                            },
                                            {
                                                "example_id": "f8943b0e-81a8-43ed-9fff-0b584263d814",
                                                "sense_id": "d87160bf-9b08-37f3-8998-1a510851bbe4",
                                                "text": "M. de Grandville aurait dit à Camusot : « Vous resterez pendant toute votre vie juge d’instruction !… » il n’aurait pas été plus explicite que dans cette phrase complimenteuse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "explicite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dde9369-c5df-3f3e-9e8e-9033c374779d",
                                        "entry_id": "98e2fd56-9140-312e-a40c-8dfca3ebb37f",
                                        "glosses": [
                                            "Ce qui est clair et évident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "030667ba-3fb2-4f9c-a0a7-f140106e08fd",
                                                "sense_id": "1dde9369-c5df-3f3e-9e8e-9033c374779d",
                                                "text": "Il savait implicitement, et lors de leurs entretiens bimensuels son divisionnaire allait parfois jusqu’à l’explicite, que ce qu’on attendait de lui maintenant n’était plus essentiellement de résoudre des affaires, mais plutôt de désigner ses successeurs, de coopter ceux qui devraient, après lui, les résoudre."
                                            }
                                        ]
                                    }
                                ]
                            },
