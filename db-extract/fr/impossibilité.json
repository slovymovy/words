                                        "glosses": [
                                            "die Tatsache, dass etwas nicht sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b4b9108-2cec-49bb-8107-a9fdc5df38b0",
                                                "sense_id": "a79b34d1-e045-3ac5-915f-4dcd2e291e62",
                                                "text": "„Der sich auf die Unmöglichkeit gemäß § 1447 ABGB Berufende hat die Unmöglichkeit der von ihm verlangten Leistung zu behaupten und zu beweisen (6 Ob 531/78).“"
                                            },
                                            {
                                                "example_id": "e61f4b42-feb9-49b3-b79f-fd3cdf291448",
                                                "sense_id": "a79b34d1-e045-3ac5-915f-4dcd2e291e62",
                                                "text": "„Das war offenbar ein Ding der Unmöglichkeit, aber eine seltsame Schicksalsfügung machte das Unmögliche möglich.“"
                                            },
                                            {
                                                "example_id": "f066241f-a9ae-44d1-9337-f25d1693914a",
                                                "sense_id": "a79b34d1-e045-3ac5-915f-4dcd2e291e62",
                                                "text": "„Mir war, als gehörte ich einer ganz anderen Gattung von Wesen an und stünde so tief unter ihr, daß ich nichts als die Unmöglichkeit einer Annäherung empfand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
