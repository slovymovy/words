                "senses": [
                    {
                        "sense_id": "81a7ca50-9745-30e6-a18a-f187ad7fb83f",
                        "entry_id": "a926459c-e937-30d5-99ab-bb942d0f229a",
                        "glosses": [
                            "Qualité d’une personne ou d’une personnification encline à changer, évoluer, qui n’est pas immuable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "485cbf65-95cb-4861-ab78-c4850a224df5",
                                "sense_id": "81a7ca50-9745-30e6-a18a-f187ad7fb83f",
                                "text": "Le dandysme, au contraire, se joue de la règle et pourtant la respecte encore. Il en souffre et s’en venge tout en la subissant ; il s’en réclame quand il y échappe ; il la domine et en est dominé tour à tour : double et muable caractère !"
                            }
                        ]
                    },
                    {
                        "sense_id": "cecfcdf3-279d-3e00-bd14-77d91996fd8a",
                        "entry_id": "a926459c-e937-30d5-99ab-bb942d0f229a",
                        "glosses": [
                            "Qui est capricieux, inconstant, versatile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38618928-0f80-4b37-968f-b0c5e7271636",
                                "sense_id": "cecfcdf3-279d-3e00-bd14-77d91996fd8a",
                                "text": "Est-il rien de plus vain qu’un songe mensonger\nUn songe passager, vagabond et muable ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "24cd4d63-c976-334a-a75e-8ef27dc51a67",
                        "entry_id": "a926459c-e937-30d5-99ab-bb942d0f229a",
                        "glosses": [
                            "Que l’on peut muer, transformer, changer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94807cdc-25c6-4632-8ef3-3d9a24e7cf30",
                                "sense_id": "24cd4d63-c976-334a-a75e-8ef27dc51a67",
                                "text": "Et si, changeant, l’étoile prit un plus vif éclat, que devins-je, moi, par une nature de toutes matières muable !"
                            }
                        ]
                    }
                ],
