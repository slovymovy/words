                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e4ee339-e8b3-32eb-af4e-e6a5c8160a13",
                        "entry_id": "bb47ffe9-ec5d-36c1-b88d-35cd1d8e1a75",
                        "glosses": [
                            "de specifieke kennis die men nodig heeft voor het uitoefenen van een beroep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd1e3ee-be54-49f3-803a-8e736871484e",
                                "sense_id": "8e4ee339-e8b3-32eb-af4e-e6a5c8160a13",
                                "text": "Maandagavond komt zij, gezicht van Fox Sports, achter de decoder vandaan om op RTL 7 de sportquiz ’Matchwinner Pro’ te presenteren. Een vraag die in ieder geval met ’ja’ kan worden beantwoord: heeft Hélène Hendriks (37) de mannen in de voetbalwereld overtuigd met haar vakkennis?"
                            },
                            {
                                "example_id": "abd2e523-df34-447c-baac-9832dbfb73fa",
                                "sense_id": "8e4ee339-e8b3-32eb-af4e-e6a5c8160a13",
                                "text": "Mede gezien het recente scherpe debat over de positie van de inmiddels afgetreden minister van Defensie had ik verwacht dat er bij de selectie van de nieuwe ploeg strengere criteria zouden gelden. Daarvan blijkt geen sprake. Kennelijk is bewezen loyaliteit van groter belang dan vakkennis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f04bafc-72ee-421b-bcc5-2860902b13d9",
                        "source_entry_id": "bb47ffe9-ec5d-36c1-b88d-35cd1d8e1a75",
                        "source_sense_id": "8e4ee339-e8b3-32eb-af4e-e6a5c8160a13",
