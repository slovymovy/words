                                                "sense_id": "71acceb5-8768-31a1-8029-74ad383abab5",
                                                "text": "Ich finde im Wäschetrockner hin und wieder eine einzelne Socke."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "00fe23d2-cec5-34e7-a2ba-d74b741c9ebd",
                                        "entry_id": "161f4f11-1a80-398f-98bf-99d9918273c4",
                                        "glosses": [
                                            "in einer Abfolge immer nur jeweils eins verwenden und dann zum nächsten übergehen"
                                        ],
                                        "tags": [
                                            "adverbiell verwendet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8c1c6b1-8a01-4aa0-a13e-c9f5f3a2fa92",
                                                "sense_id": "00fe23d2-cec5-34e7-a2ba-d74b741c9ebd",
                                                "text": "Zeugen werden grundsätzlich einzeln verhört, um gegenseitige Beeinflussung zu vermeiden."
                                            },
                                            {
                                                "example_id": "f66c0b15-5e79-4c77-a776-1de91ed01532",
                                                "sense_id": "00fe23d2-cec5-34e7-a2ba-d74b741c9ebd",
                                                "text": "Die Beispiele werden wir uns einzeln anschauen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aa60d3ae-6bac-34da-b04b-e9ee09231503",
                                        "entry_id": "161f4f11-1a80-398f-98bf-99d9918273c4",
                                        "glosses": [
                                            "den einen oder den anderen betreffend, wenige individuell verschiedene"
                                        ],
