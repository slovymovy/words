                        "glosses": [
                            "südlicher Teil Finnlands, der unter anderem am Bottnischen und Finnischen Meerbusen liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93f379c2-8d7d-4cf8-a352-b71b12f5e77f",
                                "sense_id": "bb0846a3-d90f-35f8-893f-1c9a6a1cacb6",
                                "text": "„Finnische Truppen besetzen Hangö in Südfinnland, nachdem die Stadt und der Hafen von der sowjetischen Ostseeflotte geräumt wurden.“"
                            },
                            {
                                "example_id": "866b625e-fbcd-4790-9250-88fa228c5a8b",
                                "sense_id": "bb0846a3-d90f-35f8-893f-1c9a6a1cacb6",
                                "text": "„In Nordfinnland gibt es zahlreiche Nordlichter in den Monaten von September bis Anfang April und in Südfinnland von Anfang August bis Mai.“"
                            }
                        ],
