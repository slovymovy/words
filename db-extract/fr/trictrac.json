                                "target_word": "Zabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                        "entry_id": "ec122483-c134-334f-955a-0a76da067252",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1eb5fb9-8049-425d-83a5-0132caac394b",
                                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                                "text": "Frau Zabel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "3398dc48-7a9c-4358-a4de-5605ebf789f1",
                                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                                "text": "Herr Zabel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "0057e18f-cab9-48fc-a4fd-e68c3f7ffb9e",
                                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                                "text": "Die Zabels fliegen heute nach Düsseldorf."
                                            },
                                            {
                                                "example_id": "2ae69575-5260-49f6-b72a-47ae29d5b36c",
                                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                                "text": "Der Zabel trägt nie die Pullover, die die Zabel ihm strickt."
                                            },
                                            {
                                                "example_id": "589d8b5c-d2dd-474f-a4a1-8a3f9fee0370",
                                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zabel kommt, geht der Herr Zabel.“"
                                            },
                                            {
                                                "example_id": "9360c567-f180-4b3b-9793-27e6fea84ebe",
                                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                                "text": "Zabel kommt und geht."
                                            },
                                            {
                                                "example_id": "dabdcec4-f5c1-4522-8a58-96b28c8d400f",
                                                "sense_id": "d9f939c6-618d-3e62-9ad4-8d89e86d4b01",
                                                "text": "Zabels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d32b7cb6-36a6-4ff8-bb0b-c526ab258068",
                        "source_entry_id": "8babbb27-e7f3-373f-9d0c-db0afe28f67f",
                        "source_sense_id": "aed1a927-583d-3b6a-beb5-d659c450de38",
                        "source_sense_description": "Tableau sur lequel on joue",
                        "target_lang_word": "Spielbrett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spielbrett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10e61536-6a26-334b-8d02-e192c355177c",
                                        "entry_id": "0399c231-79af-3003-b7ec-74eba47c73f8",
                                        "glosses": [
                                            "Platte aus Holz, Pappe oder anderen Materialien, die mit einer bestimmten Grafik (dem Spielplan) versehen ist, die für die regelkonforme Durchführung eines Brettspiels benötigt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1f34e4-ec26-417f-a021-d8316a48666b",
                                                "sense_id": "10e61536-6a26-334b-8d02-e192c355177c",
                                                "text": "Wenn mein Sohn beim Mensch-ärgere-dich-nicht verliert, wirft er das Spielbrett samt Figuren einfach vom Tisch."
                                            },
                                            {
                                                "example_id": "053bbee5-076a-4e4d-bfb3-1872274664ef",
                                                "sense_id": "10e61536-6a26-334b-8d02-e192c355177c",
                                                "text": "„Es sind uns keine Spielregeln erhalten geblieben, aber sowohl durch die Entdeckung der Fundstücke wie Spielbretter und Papyri als auch aufgrund des ägyptischen Brauches, die Wände der Gräber mit Szenen des irdischen Lebens auszuschmücken, […] konnte man mit Hilfe ethnographischer Studien sowie mit ein wenig Phantasie und dem richtigen Gespür die Spielweise rekonstruieren.“"
                                            },
                                            {
                                                "example_id": "f1eccf51-f183-4ef3-9a65-1ae50c4d1c3b",
                                                "sense_id": "10e61536-6a26-334b-8d02-e192c355177c",
                                                "text": "„Einzig in ihrer Art ist auch das mit der ersten arabischen Erwähnung gleichaltrige, im 10. Jahrhundert geschnitzte hölzerne irische Spielbrett, auf das man in Ballinderri gestoßen war und das heute in Dublin aufbewahrt wird.“"
                                            },
                                            {
                                                "example_id": "50ac1e58-f86a-43d2-a2d9-3d1f59078a75",
                                                "sense_id": "10e61536-6a26-334b-8d02-e192c355177c",
                                                "text": "„Damit der Schulweg wirklichkeitsgerecht auf dem Spielbrett abgebildet werden kann, muss er vom Kinde zunächst erkundet werden.“"
                                            },
                                            {
                                                "example_id": "8c6a4d23-ca30-4e15-be3e-2cb01b6e0c8d",
                                                "sense_id": "10e61536-6a26-334b-8d02-e192c355177c",
                                                "text": "„Er liebte Spiele, ob er nun vor dem Spielbrett saß oder Kinder beim Spiel beobachtete oder eine Ringkämpfertruppe für einen Wettkampf anheuerte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
