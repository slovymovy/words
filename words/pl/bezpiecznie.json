    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d741ae70-a5bf-3f9f-81ae-c4db9087693d",
                    "sense_definition": "w sposób niestwarzający zagrożenia lub wolny od niebezpieczeństw",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bezpieczeństwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W nowym mieszkaniu możemy wreszcie poczuć się całkowicie <w>bezpiecznie</w>.",
                            "target_lang_translations": {
                                "en": "In the new apartment, we can finally feel completely <w>safe</w>."
                            }
                        },
                        {
                            "text": "Kierowca jechał bardzo ostrożnie, abyśmy dotarli na miejsce <w>bezpiecznie</w> i na czas.",
                            "target_lang_translations": {
                                "en": "The driver drove very carefully so that we would arrive at our destination <w>safely</w> and on time."
                            }
                        }
                    ],
                    "synonyms": [
                        "spokojnie",
                        "pewnie"
                    ],
                    "antonyms": [
                        "niebezpiecznie"
                    ],
                    "common_phrases": [
                        "czuć się bezpiecznie",
                        "dotrzeć bezpiecznie"
                    ],
                    "target_lang_definitions": {
                        "en": "in a way that does not pose a threat or is free from danger"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "safely",
                                "target_lang_sense_clarification": "without risk, harm, or danger"
                            },
                            {
                                "target_lang_word": "securely",
                                "target_lang_sense_clarification": "in a secure, stable, or protected manner"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffad7090-7238-3e7e-8970-c2cc1d918f16",
                    "sense_definition": "z pewnością, niezawodnie lub bez obaw",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pewność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Możesz <w>bezpiecznie</w> założyć, że jutrzejsze spotkanie odbędzie się zgodnie z planem.",
                            "target_lang_translations": {
                                "en": "You can <w>safely</w> assume that tomorrow's meeting will go ahead as planned."
                            }
                        },
                        {
                            "text": "Rycerz ruszył <w>bezpiecznie</w> naprzód, nie zważając na grożące mu niebezpieczeństwa.",
                            "target_lang_translations": {
                                "en": "The knight moved <w>boldly</w> forward, paying no heed to the perils that threatened him."
                            }
                        }
                    ],
                    "synonyms": [
                        "pewnie",
                        "śmiało"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "znaczenie przestarzałe lub rzadko używane we współczesnej polszczyźnie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "with confidence, without fear or doubt; safely"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "safely",
                                "target_lang_sense_clarification": "with reasonable certainty and without risk of being wrong"
                            },
                            {
                                "target_lang_word": "boldly",
                                "target_lang_sense_clarification": "fearlessly or without hesitation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61c3c0c2-4204-355e-91ae-e2ad670b82ec",
                    "sense_definition": "zbyt zuchwale, lekkomyślnie lub bez należytej ostrożności",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "brawura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młodzieniec postąpił nader <w>bezpiecznie</w>, wdając się w dyskusję z uzbrojonymi strażnikami.",
                            "target_lang_translations": {
                                "en": "The young man acted far too <w>rashly</w>, getting into an argument with armed guards."
                            }
                        },
                        {
                            "text": "Poczęli sobie zbyt <w>bezpiecznie</w> poczynać na wrogim terytorium, co ściągnęło nieszczęście.",
                            "target_lang_translations": {
                                "en": "They began acting far too <w>recklessly</w> in hostile territory, which brought about disaster."
                            }
                        }
                    ],
                    "synonyms": [
                        "lekkomyślnie",
                        "zuchwale"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "znaczenie historyczne i przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "too boldly, recklessly, or without due caution (archaic)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "recklessly",
                                "target_lang_sense_clarification": "without caution, overly boldly"
                            },
                            {
                                "target_lang_word": "rashly",
                                "target_lang_sense_clarification": "foolhardily or incautiously"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}