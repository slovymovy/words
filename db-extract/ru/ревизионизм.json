                                    {
                                        "sense_id": "55ab2d29-8407-39d8-a703-950cb1035833",
                                        "entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                                        "glosses": [
                                            "richting in het socialisme die op een geleidelijke verandering van de maatschappij aanstuurt, niet op revolutie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435cd63c-6132-4d7c-96bd-9aa812034c1c",
                                                "sense_id": "55ab2d29-8407-39d8-a703-950cb1035833",
                                                "text": "Revisionisme was in het internationale communisme heel lang een beledigende term voor alles met afwijkende meningen"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ad9880a-a1ba-3406-a3c0-66db5b19bc4a",
                                        "entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                                        "glosses": [
                                            "de opportunistische herziening of herschrijving van de geschiedenis op grond van latere, nationalistisch, religieus of ideologisch gedreven opvattingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "412f61a7-3bb4-498b-8322-eb27841b6094",
                                                "sense_id": "2ad9880a-a1ba-3406-a3c0-66db5b19bc4a",
                                                "text": "Het is in Latijns-Amerika dat een aantal mensen zich het meest beijveren om de ‘zwarte legende’ van de veroveringen uit te wissen; om de religieuze en juridische instellingen die de gouverneurs en belastingambtenaren van het oude Spanje naar dit continent gebracht hebben, uitbundig te prijzen; om aan te tonen dat het Spaanse ezeltje meer heeft gedaan om de Indiaan een menswaardig bestaan te geven dan alle liberale of democratische ideeën van de vorige eeuw ... In naam van de ‘hispaniteit’ - waarbij men soms wijst op de milde houding van José Martí jegens Spanje - komt men tot een historisch revisionisme dat de schijn heeft van ‘malinchisme’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4472d831-5005-3bcd-bff8-bdcd1ad5aff3",
                                        "entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                                        "glosses": [
                                            "politieke stroming in een land die een eerder gesloten verdrag dat tot het afstaan van territoria of gebieden heeft geleid, wil laten herzien of opzeggen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
