                        "glosses": [
                            "een kwantitatief of kwalitatief tekort aan woonruimte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7604affa-563a-46cd-9758-fcf45b7f3606",
                                "sense_id": "6f1aca0a-bd4f-31da-a49f-5038d48dbb8f",
                                "text": "Tegelijkertijd stijgt de woningnood en is duidelijk dat bij allerlei vastgoedprojecten de gemeente totaal niet aan handhaving doet waardoor ontwikkelaars vrij spel hebben en regels aan de lopende band met voeten wordt getreden."
                            },
                            {
                                "example_id": "8d105bfd-af51-4370-8024-7d118ad3e5d7",
                                "sense_id": "6f1aca0a-bd4f-31da-a49f-5038d48dbb8f",
                                "text": "Deze respondent is duidelijk geen fan van ’tiny houses’, woningen van maximaal 50 vierkante meter met alles erop en eraan. Een nipte meerderheid ziet echter wel een oplossing in deze woontrend. „Vooral leuk voor jongeren: studerenden en starters, Ook vindt ruim de helft dat grote steden de groeiende woningnood te lijf moeten gaan door meer in de hoogte te bouwen."
                            }
                        ]
                    }
