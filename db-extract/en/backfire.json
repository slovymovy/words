                "senses": [
                    {
                        "sense_id": "fdd1c919-5d62-3aa6-8d74-e2277963a653",
                        "entry_id": "71101637-0397-3317-88dd-cca12cc8de42",
                        "glosses": [
                            "To fire in the opposite direction, for example due to an obstruction in the barrel."
                        ],
                        "tags": [
                            "intransitive",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5f420ec6-bf5b-3106-87aa-903bafa8c271",
                        "entry_id": "71101637-0397-3317-88dd-cca12cc8de42",
                        "glosses": [
                            "To experience a premature ignition of fuel or an ignition of exhaust gases, making a popping sound."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cf68e981-1621-4653-87f0-5d5c3a695f81",
                                "sense_id": "5f420ec6-bf5b-3106-87aa-903bafa8c271",
                                "text": "It was just after the Biafran war, and all the local people were still jumpy. Any time a car backfired or a police siren howled, they would dive under desks or tables instinctively."
                            }
                        ]
                    },
                    {
                        "sense_id": "7fdf5ef9-262a-35fc-aed5-a8c2c731d56c",
                        "entry_id": "71101637-0397-3317-88dd-cca12cc8de42",
                        "glosses": [
                            "To fail in a manner that brings down further misfortune."
                        ],
                        "tags": [
                            "idiomatic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "09c49f74-a4ee-47f7-a140-67b10211ad77",
                                "sense_id": "7fdf5ef9-262a-35fc-aed5-a8c2c731d56c",
                                "text": "His attempt to make money by importing luxury cars backfired horribly when fuel prices tripled."
                            },
                            {
                                "example_id": "386132fe-af88-4f37-8f67-19d9ab4bcdfe",
                                "sense_id": "7fdf5ef9-262a-35fc-aed5-a8c2c731d56c",
                                "text": "Her plan backfired on her."
                            },
                            {
                                "example_id": "84058d08-305a-4b08-a5a4-2b7c6a6ed4ca",
                                "sense_id": "7fdf5ef9-262a-35fc-aed5-a8c2c731d56c",
                                "text": "Obsessed only with cost, 'Sir Humphrey' saw that Transport for London 'got away' with ticket office closures on the Tube with only minor public pushback and miscalculated that it could do the same on the national network. This assumption backfired spectacularly."
                            }
                        ]
                    },
                    {
                        "sense_id": "24367a3b-d88b-3433-a1c3-df6024b53bd6",
                        "entry_id": "71101637-0397-3317-88dd-cca12cc8de42",
                        "glosses": [
                            "To set a back fire (small, controlled fire to limit spread of a larger fire)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
