                        "glosses": [
                            "een apparaat waarmee je grotere of kleinere takken van een boom of struik kunt knippen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54ae4919-682f-40ad-8c4a-a3adda5817e6",
                                "sense_id": "f69a3510-fad4-3532-bbdc-804ee143718d",
                                "text": "Mijn eerste boom gaat krakend om. Dan komen de mensen met de snoeitangen die de resterende takken afknippen, als aasgieren die zich op een prooi storten. Dit is leuk, meer dan leuk. Ik kan een boom vellen! Ik wil er een meeslepen naar mijn grot. En overal ruikt het naar hars, die op mijn broek, jas en haar blijkt te zitten. Ik wil meer bomen doodmaken, nog veel meer."
                            }
                        ]
                    }
