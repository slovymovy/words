                        "entry_id": "48c498bb-88e0-3708-9ef9-5943c45bda0a",
                        "glosses": [
                            "The quality of being fearless."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "59db7d8b-8d8d-4784-95e3-30c294c056ae",
                                "sense_id": "e8bcad94-0d6d-3224-826c-e8521cc40a34",
                                "text": "Anne was indignant with that straight-out and generous indignation which belongs to women, who are ready to follow their principles to any result with more inconsiderate fearlessness than men."
                            },
                            {
                                "example_id": "44907e95-c803-43aa-9d12-3e0a4e35a362",
                                "sense_id": "e8bcad94-0d6d-3224-826c-e8521cc40a34",
                                "text": "The only thing to fear is fearlessness / The bigger the weapon, the greater the fear / Hyena is ambassador to here"
                            }
                        ]
                    }
                ],
