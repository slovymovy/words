                "senses": [
                    {
                        "sense_id": "0bec9e9d-b9b3-3afe-b7dc-730391b18aa8",
                        "entry_id": "8db6b462-aa87-30de-9b1c-f40a0100b4af",
                        "glosses": [
                            "Brief, den man schreibt, wenn man jemandem auf Wiedersehen sagen möchte, zum Beispiel wenn man sich umbringen möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "686ecbdb-3497-47ed-b1f9-11fb17371ee2",
                                "sense_id": "0bec9e9d-b9b3-3afe-b7dc-730391b18aa8",
                                "text": "Anneliese schrieb ihre letzten Worte in einen Abschiedsbrief und nahm dann die Herztabletten von ihrer Oma."
                            },
                            {
                                "example_id": "7acd0046-616f-4cb0-87d2-3859ea832a1e",
                                "sense_id": "0bec9e9d-b9b3-3afe-b7dc-730391b18aa8",
                                "text": "„Was sie vom Hergang der Tat wußte, berichtete sie in ihrem Abschiedsbrief an Nikolai.“"
                            },
                            {
                                "example_id": "20faf42b-e981-4ae0-8022-f862c8370ca6",
                                "sense_id": "0bec9e9d-b9b3-3afe-b7dc-730391b18aa8",
                                "text": "„Zur gleichen Zeit, da Thomas Lieven in seiner Zelle im »Aljube« zu Lissabon, ein Gefühl arktischer Kälte in der Magengrube, ihren Abschiedsbrief las, saß die schwarzhaarige, hinreißend gebaute Konsulin auf der anderen Seite der Erdkugel im Salon des teuersten Appartements im teuersten Hotel von San José, der Hauptstadt der Republik Costa Rica.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdbe45de-3eed-446d-8476-3cb4bde96f20",
                        "source_entry_id": "8db6b462-aa87-30de-9b1c-f40a0100b4af",
                        "source_sense_id": "0bec9e9d-b9b3-3afe-b7dc-730391b18aa8",
                        "source_sense_description": "Brief, den man zum Abschied schreibt",
                        "target_lang_word": "farewell letter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b598e31b-4ebf-4c9c-9262-73a461146be4",
                        "source_entry_id": "8db6b462-aa87-30de-9b1c-f40a0100b4af",
                        "source_sense_id": "0bec9e9d-b9b3-3afe-b7dc-730391b18aa8",
                        "source_sense_description": "Brief, den man zum Abschied schreibt",
                        "target_lang_word": "suicide note",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suicide note",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b72ca55-b373-32ec-8f66-183f6fe99bf0",
                                        "entry_id": "8374fd82-509e-337f-be91-defab155bccd",
                                        "glosses": [
                                            "A message, usually a written note, left by someone who later attempts or commits suicide, usually explaining the reason for the suicide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76560c59-7150-4377-879b-3c6858331cad",
                                                "sense_id": "4b72ca55-b373-32ec-8f66-183f6fe99bf0",
                                                "text": "Park left a suicide note to efface his trail and vanished - to turn up here the next day as Bonnie's grandfather."
                                            },
                                            {
                                                "example_id": "432740dc-0104-48d5-8571-5460b2979de2",
                                                "sense_id": "4b72ca55-b373-32ec-8f66-183f6fe99bf0",
                                                "text": "Twice I bought barbiturate pills, enough to finish anyone, and once I wrote a suicide note."
                                            },
                                            {
                                                "example_id": "017f77d6-ff34-4a46-9c91-aa46d6bb17b1",
                                                "sense_id": "4b72ca55-b373-32ec-8f66-183f6fe99bf0",
                                                "text": "In any event, in this round-robin of personal memories, this prolix suicide note is as close to a catamnestic report — that is, a patient history from Arthur himself as we are able to get."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
