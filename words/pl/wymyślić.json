{
    "word_family": [
        "wymyślać",
        "wymyślny",
        "wymyślenie",
        "myśleć",
        "pomysł"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11b28f91-4ceb-32ff-880e-2634e81e483f",
                    "sense_definition": "stworzyć w myślach coś nowego, wpaść na pomysł lub skonstruować plan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kreacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy szybko <w>wymyślić</w> prezent na urodziny dla naszej mamy.",
                            "target_lang_translations": {
                                "ru": "Нам нужно быстро <w>придумать</w> подарок на день рождения для нашей мамы."
                            }
                        },
                        {
                            "text": "Naukowiec <w>wymyślił</w> urządzenie, które ułatwia codzienne gotowanie.",
                            "target_lang_translations": {
                                "ru": "Учёный <w>изобрёл</w> устройство, которое облегчает ежедневную готовку."
                            }
                        }
                    ],
                    "synonyms": [
                        "gw. (Górny Śląsk) wysztudiyrować"
                    ],
                    "common_phrases": [
                        "wymyślić rozwiązanie",
                        "wymyślić plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "создать что-то в мыслях, найти идею или разработать план"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придумать",
                                "target_lang_sense_clarification": "идею, план или решение"
                            },
                            {
                                "target_lang_word": "изобрести",
                                "target_lang_sense_clarification": "устройство или новый метод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aca9bc34-6a97-389f-98ea-a3dd51946f1b",
                    "sense_definition": "stworzyć nieprawdziwą historię lub usprawiedliwienie; zmyślić coś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fikcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uczeń <w>wymyślił</w> wymówkę, żeby uniknąć trudnego sprawdzianu z matematyki.",
                            "target_lang_translations": {
                                "ru": "Ученик <w>придумал</w> отговорку, чтобы избежать трудной контрольной по математике."
                            }
                        },
                        {
                            "text": "Cała ta opowieść nie jest prawdziwa, po prostu ją sobie <w>wymyśliła</w>.",
                            "target_lang_translations": {
                                "ru": "Вся эта история неправда, она просто её себе <w>выдумала</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wymyślić kłamstwo",
                        "wymyślić wymówkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "сочинить неправдивую историю, отговорку; сфабриковать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдумать",
                                "target_lang_sense_clarification": "ложь или небылицу"
                            },
                            {
                                "target_lang_word": "сочинить",
                                "target_lang_sense_clarification": "оправдание или историю"
                            },
                            {
                                "target_lang_word": "придумать",
                                "target_lang_sense_clarification": "отговорку или неправду"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68a23d58-59af-302d-80d7-46b918f7a875",
                    "sense_definition": "uroić sobie coś, bezpodstawnie w coś uwierzyć lub wyobrazić sobie zagrożenie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fikcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znowu <w>wymyśliłeś</w> sobie jakieś problemy, które w ogóle nie istnieją.",
                            "target_lang_translations": {
                                "ru": "Ты снова <w>напридумывал</w> себе какие-то проблемы, которых вообще не существует."
                            }
                        },
                        {
                            "text": "Nie martw się na zapas, niepotrzebnie <w>wymyśliłaś</w> najgorszy możliwy scenariusz.",
                            "target_lang_translations": {
                                "ru": "Не переживай раньше времени, ты зря <w>навоображала</w> худший из возможных сценариев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wymyślić problem"
                    ],
                    "target_lang_definitions": {
                        "ru": "внушить себе что-либо без оснований, навоображать лишнего"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напридумывать",
                                "target_lang_sense_clarification": "несуществующие проблемы или сложности"
                            },
                            {
                                "target_lang_word": "навоображать",
                                "target_lang_sense_clarification": "пугающие или ложные сценарии"
                            },
                            {
                                "target_lang_word": "внушить себе",
                                "target_lang_sense_clarification": "необоснованную мысль или страх"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}