                ],
                "senses": [
                    {
                        "sense_id": "85dccba1-b779-3800-9ce9-1442b1accd44",
                        "entry_id": "5ee88ed0-ab69-3645-9aff-be8dab516ab6",
                        "glosses": [
                            "Sicherheit beim Fahren eines Fahrzeuges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d15c3327-63d9-415c-bb68-202f6c695831",
                                "sense_id": "85dccba1-b779-3800-9ce9-1442b1accd44",
                                "text": "„Gleichzeitig können wir durch härtere Federn auftretende Nick- und Wankwinkel reduzieren, was sich ebenfalls positiv auf die Fahrsicherheit auswirkt.“"
                            },
                            {
                                "example_id": "52ba0d5a-1097-4dc0-b44f-230b128dab60",
                                "sense_id": "85dccba1-b779-3800-9ce9-1442b1accd44",
                                "text": "„In diesem Kapitel werden die Auswirkungen von Cannabiskonsum auf die Fahrsicherheit, Fahreignung und das Unfallrisiko untersucht.“"
                            },
                            {
                                "example_id": "302ba74b-668c-481d-b52e-457d21f4ef83",
                                "sense_id": "85dccba1-b779-3800-9ce9-1442b1accd44",
                                "text": "„Sie kommen aus dem Bereich Motorsport, haben sich einen Namen gemacht und planen ein Produkt zum Thema Fahrsicherheit beim Autofahren.“"
                            },
                            {
                                "example_id": "52bd531b-8416-417d-be61-dc5437c3c8f3",
                                "sense_id": "85dccba1-b779-3800-9ce9-1442b1accd44",
                                "text": "„Die Fahrsicherheit eines hohen, schmalen Fahrzeugs lässt sich zwingend nur mit einer Neigungsfähigkeit erhöhen und sicherstellen.“"
                            },
                            {
                                "example_id": "47040814-628f-4f92-bbc2-1490b14d91a5",
                                "sense_id": "85dccba1-b779-3800-9ce9-1442b1accd44",
                                "text": "„Die Fahrsicherheit hingegen ist die situative Fähigkeit, sicher am Straßenverkehr teilzunehmen.“"
                            },
                            {
                                "example_id": "25cda34d-33fa-4053-aee5-44c36f598cf2",
                                "sense_id": "85dccba1-b779-3800-9ce9-1442b1accd44",
                                "text": "„Erkrankungen spielen bei der Begutachtung von Einschränkungen der Fahrsicherheit und Fahreignung zwar eine untergeordnete Rolle, haben jedoch im ärztlichen Alltag eine große Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
