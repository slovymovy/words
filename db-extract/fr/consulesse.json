                                "target_senses": [
                                    {
                                        "sense_id": "b7f4f1cf-5fcd-365c-a8de-e6f3ce310eb4",
                                        "entry_id": "bbe56d46-7f44-3350-a67a-aff83bb45bb8",
                                        "glosses": [
                                            "Vertreterin eines Landes in einem anderen Land mit eingeschränkten diplomatischen Funktionen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d80f2e-37f1-4709-b7c7-bcaec6653547",
                                                "sense_id": "b7f4f1cf-5fcd-365c-a8de-e6f3ce310eb4",
                                                "text": "Heute kam die Konsulin aus dem Nahen Osten wieder."
                                            },
                                            {
                                                "example_id": "f8f6aac1-a9e3-47bb-89cc-d7c2b3e9b04d",
                                                "sense_id": "b7f4f1cf-5fcd-365c-a8de-e6f3ce310eb4",
                                                "text": "„Wieder hatte die Konsulin verloren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14dd51a7-cb35-31d3-8361-735a82754f3c",
                                        "entry_id": "bbe56d46-7f44-3350-a67a-aff83bb45bb8",
                                        "glosses": [
                                            "Ehefrau eines Konsuls (in heutiger Bedeutung)"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15144f62-2942-4a68-ba0b-d68217df3355",
                                                "sense_id": "14dd51a7-cb35-31d3-8361-735a82754f3c",
                                                "text": "Die Konsulin reist ihrem Ehemann nach."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c75e3806-e470-40a6-ab1a-201debc2350a",
                        "source_entry_id": "1c3fbd94-0876-3159-b83f-506edc3e1ba8",
                        "target_lang_word": "consuless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consuless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "525ade7b-efb7-30b2-9e30-2850d17154c4",
                                        "entry_id": "ff1abaaf-81a2-344a-a3ca-700dbcd2a812",
                                        "glosses": [
                                            "A female consul or the wife of one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a09144a-15ed-4927-bea5-1615e61e8db8",
                                                "sense_id": "525ade7b-efb7-30b2-9e30-2850d17154c4",
                                                "text": "You [children] have been told, that Buonaparté is—“a very good?—man:”—that “A Chief-Conſul—” (self-appointed; and all but omnipotent)—“A Chief-Conſul, and proſtitute Conſuleſs, are far better than your old-faſhioned Kings and Queens."
                                            },
                                            {
                                                "example_id": "3e358b58-9f26-4ee3-b418-c75346d4259a",
                                                "sense_id": "525ade7b-efb7-30b2-9e30-2850d17154c4",
                                                "text": "The Consul and Consuless finding the magnificent and beautiful reſidence of St Cloud, too circumſcribed for their grand levee and feſtival days, are about to have the Palace of Verſailles refitted."
                                            },
                                            {
                                                "example_id": "ad3bdaac-abc7-4c13-b514-9e6a049401fe",
                                                "sense_id": "525ade7b-efb7-30b2-9e30-2850d17154c4",
                                                "text": "If you leave us an only daughter, no matter; she shall be Consuless, and Pontificia Maxima, into the bargain. We want a series of hereditary Consuls, and Consulesses."
                                            },
                                            {
                                                "example_id": "801e767b-2d63-4441-b26f-1dedc7cbd1a7",
                                                "sense_id": "525ade7b-efb7-30b2-9e30-2850d17154c4",
                                                "text": "However, the 8-month-old battle probably will be unsuccessful, because [Eugene Vincent] Wanless, who prefers to be called Consul Eugene, refuses to obtain the required car insurance on grounds that insurance companies are “false idols” and only God can prevent auto accidents anyway. Wanless, who resides with his wife, Consuless Alice, in an apartment on SR A1A with a breathtaking view of the ocean, claims to represent God the Father as “Consul Eugene of the Society of Universal Love” and “Aquarian-Age ambassador.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
