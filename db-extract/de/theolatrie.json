                ],
                "senses": [
                    {
                        "sense_id": "4b375fc4-1f06-3524-b03f-e63ee57b56a6",
                        "entry_id": "325acc75-e59d-3201-a52f-60c714fcdfe6",
                        "glosses": [
                            "die (oftmals das Äußere betonende) Verehrung, Anbetung Gottes, der Dienst am Gott"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "bbe3aa75-5d05-41ae-ab4e-df34e3d80b17",
                                "sense_id": "4b375fc4-1f06-3524-b03f-e63ee57b56a6",
                                "text": "Die Verehrung Gottes oder der Götter muß ersetzt werden durch die Verehrung des Menschen, die Anthropolatrie muß an die Stelle der ehemaligen Theolatrie treten."
                            },
                            {
                                "example_id": "a443904f-121e-486c-86ed-23a6f2730552",
                                "sense_id": "4b375fc4-1f06-3524-b03f-e63ee57b56a6",
                                "text": "Denn in jener Inschrift, die aber nach und nach schon von der Zeit verwischt worden, ist die Basileolatrie unmittelbar mit der Theolatrie in Verbindung gebracht, so daß beide Arten der Anbetung als Pflicht gefordert werden."
                            },
                            {
                                "example_id": "268cc2ed-1d66-4e56-9c82-f45314694809",
                                "sense_id": "4b375fc4-1f06-3524-b03f-e63ee57b56a6",
                                "text": "Der Theologie als Dogma entsprach die Theokratie als Regime und die Theolatrie als Kultus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
