                        ]
                    },
                    {
                        "translation_id": "43e338c5-b859-4e69-a077-9dfa1e292685",
                        "source_entry_id": "f9eae262-e7ea-38c7-940c-14b1d7318877",
                        "source_sense_id": "394faf37-c526-389a-944f-3ae05e361e51",
                        "target_lang_word": "barcarolle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barcarolle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "caa00f9a-2dd6-30ac-b1f2-d62783d78715",
                                        "entry_id": "eed6b3a7-5bd9-3cd4-8134-6954f18e8929",
                                        "glosses": [
                                            "Variante orthographique de barcarole, chanson des gondoliers de Venise."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3540885c-b193-37d1-9f2a-efe9e7692c76",
                                        "entry_id": "eed6b3a7-5bd9-3cd4-8134-6954f18e8929",
                                        "glosses": [
                                            "Variante orthographique de barcarole, air de musique où l’on imite la coupe et le rythme de ces chansons."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8154dfcd-b103-46ed-b6e0-4b6cd52ce6b8",
                                                "sense_id": "3540885c-b193-37d1-9f2a-efe9e7692c76",
                                                "text": "Et les Assis, genoux aux dents, verts pianistes,\nLes dix doigts sous leur siège aux rumeurs de tambour,\nS'écoutent clapoter des barcarolles tristes,\nEt leurs caboches vont dans des roulis d'amour."
                                            },
                                            {
                                                "example_id": "7367c756-61b3-4d7d-b3a6-5dbfd59cc824",
                                                "sense_id": "3540885c-b193-37d1-9f2a-efe9e7692c76",
                                                "text": "Une musique résonne, une sorte de barcarolle sentimentale, et partout sur son passage vacillent des lampes d’ambiance colorées, y compris dans l’eau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5465d9e-c882-4532-b4a1-728592493cc4",
                        "source_entry_id": "f9eae262-e7ea-38c7-940c-14b1d7318877",
                        "source_sense_id": "394faf37-c526-389a-944f-3ae05e361e51",
                        "target_lang_word": "barcarole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barcarole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9c62ed9-5cc8-3500-ac23-b07c79a87342",
                                        "entry_id": "e8a2ebd5-fe7b-3603-be5e-1b3596dbc262",
                                        "glosses": [
                                            "Chanson, air traditionnellement chanté par les gondoliers vénitiens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d5511f0-d881-4841-9d26-e7c70d40be35",
                                                "sense_id": "f9c62ed9-5cc8-3500-ac23-b07c79a87342",
                                                "text": "La dame lui dit de chanter une barcarole."
                                            },
                                            {
                                                "example_id": "cbc259a3-1ab9-4ce2-a1f9-f36307efa1d7",
                                                "sense_id": "f9c62ed9-5cc8-3500-ac23-b07c79a87342",
                                                "text": "Un peu plus loin, dans l’oratoire, un quatrième piano accompagnait dix à douze pensionnaires au moins, qui prenaient leur leçon et chantaient en chœur une barcarole dont je me rappelle trois mots : « fraîche brise » et « Venise. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b10a629-3210-3d0d-b5ea-bd57dccf8f4b",
                                        "entry_id": "e8a2ebd5-fe7b-3603-be5e-1b3596dbc262",
                                        "glosses": [
                                            "Composition musicale dans ce style."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a0b35ad-a63a-3851-9ef1-ef06ee8e155d",
                                        "entry_id": "e8a2ebd5-fe7b-3603-be5e-1b3596dbc262",
                                        "glosses": [
                                            "Motif rythmique ternaire composé du motif « noire — croche »."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
