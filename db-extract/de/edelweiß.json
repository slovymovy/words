                                                "example_id": "8973530a-2a92-42fb-a612-f37812d25005",
                                                "sense_id": "d1500c26-5cde-3a6e-96b1-a24917b448cb",
                                                "text": "'Op mijn bovenarm staat een begrafeniskruis met daarin een bloem, een edelweiss. Ik heb nog twee andere tatoeages, maar deze heeft de meeste waarde. Het kruis staat er voor mijn opa. Hij is vorig jaar overleden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
