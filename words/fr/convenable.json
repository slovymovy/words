                {
                    "sense_id": "08378998-2278-3c25-b0ba-b0f492d1c5e5",
                    "sense_definition": "Qui est raisonnable, suffisant ou bien proportionné.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proportionné",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a prescrit ce traitement à une dose <w>convenable</w> pour soulager rapidement le patient.",
                            "target_lang_translations": {
                                "en": "The doctor prescribed this treatment at an <w>adequate</w> dose to relieve the patient quickly.",
                                "ru": "Врач назначил это лечение в <w>достаточной</w> дозе, чтобы быстро облегчить состояние пациента.",
                                "de": "Der Arzt verordnete diese Behandlung in einer <w>ausreichenden</w> Dosis, um dem Patienten rasch Linderung zu verschaffen.",
                                "es": "El médico recetó este tratamiento a una dosis <w>suficiente</w> para aliviar rápidamente al paciente.",
                                "zh": "医生开的这种治疗剂量<w>足够</w>，能让患者迅速缓解症状。"
                            }
                        },
                        {
                            "text": "Ils ont réussi à acheter cette maison à un prix <w>convenable</w> après de longues négociations.",
                            "target_lang_translations": {
