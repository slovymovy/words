                            {
                                "example_id": "6641525e-ec65-48f1-b5ad-eb9202edec2e",
                                "sense_id": "ad321d3f-e2ad-33a0-b23e-b6f35bef7e84",
                                "text": "The cult of Mithra had been spread by soldiers and had thrived particularly in the frontier provinces of the empire."
                            },
                            {
                                "example_id": "24a98e48-62c9-4745-af38-3eefc230878d",
                                "sense_id": "ad321d3f-e2ad-33a0-b23e-b6f35bef7e84",
                                "text": "The Roman Mithra was best known for his act of slaying a bull; yet there is no indication that the Iranian Mithra ever made his way into a bullpen for any reason. The Roman Mithra didn't appear at all interested in contract enforcement or escorting demons into hell."
                            }
                        ]
