        "nl-extract.jsonl": [
            {
                "entry_id": "07ffd43b-1de1-3424-9d90-729521b8450d",
                "word": "meiose",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dbc6ac29-0674-3efc-bf62-442a4e1a2ea0",
                        "entry_id": "07ffd43b-1de1-3424-9d90-729521b8450d",
                        "glosses": [
                            "celdeling waarbij geslachtscellen ontstaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87051f7-da35-447b-a0fd-97c43a155725",
                                "sense_id": "dbc6ac29-0674-3efc-bf62-442a4e1a2ea0",
                                "text": "Bij meiose ontstaan vier verschillende dochtercellen, die allemaal een unieke combinatie van erfelijke eigenschappen bezitten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4db8cc68-5150-49e0-aa86-175463d94bb6",
                        "source_entry_id": "07ffd43b-1de1-3424-9d90-729521b8450d",
                        "source_sense_id": "dbc6ac29-0674-3efc-bf62-442a4e1a2ea0",
                        "source_sense_description": "(biologie) celdeling waarbij geslachtscellen ontstaan",
                        "target_lang_word": "Meiose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meiose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ae0438d-c333-38b9-aded-ca1b2ca7da8b",
                                        "entry_id": "81b16fd1-b885-39f6-b1ec-15c4672880e3",
                                        "glosses": [
                                            "besondere Form der Zellkernteilung, wobei im Unterschied zur gewöhnlichen Kernteilung, der Mitose, die Anzahl der Chromosomen halbiert wird"
                                        ],
                                        "tags": [
                                            "Genetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77251aea-9baf-45d2-817f-d16ded26d86e",
                                                "sense_id": "6ae0438d-c333-38b9-aded-ca1b2ca7da8b",
                                                "text": "„Die Meiose läuft in zwei Teilungsschritten ab. In der Meiose I (Anmerkung: Reduktionsteilung) werden die homologen Chromosomen, die aus je zwei Chromatiden bestehen voneinander getrennt. Die Meiose II (Anmerkung: Äquationsteilung) ist eine im Prinzip mitotische Teilung, in der die beiden Chromatiden voneinander getrennt werden.“"
                                            },
                                            {
                                                "example_id": "b618843a-9e37-4e57-8d46-c6347e4b3a36",
                                                "sense_id": "6ae0438d-c333-38b9-aded-ca1b2ca7da8b",
                                                "text": "Immerhin musste die Evolution diploide Organismen hervorbringen, d.h. Organismen, bei denen die Chromosomen doppelt vorliegen. Diese müssen dann in einer Meiose wieder auf einfache Chromosomensätze reduziert und dann mit Hilfe von Sexualität neu kombiniert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "158e9361-0f94-479a-838a-e85fc093cb93",
                        "source_entry_id": "07ffd43b-1de1-3424-9d90-729521b8450d",
                        "source_sense_id": "dbc6ac29-0674-3efc-bf62-442a4e1a2ea0",
                        "source_sense_description": "(biologie) celdeling waarbij geslachtscellen ontstaan",
                        "target_lang_word": "meiosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meiosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "430b339d-c932-36bc-8b83-852ad4569f1b",
                                        "entry_id": "a3c2a8f4-859f-375a-913f-b72e5de17246",
                                        "glosses": [
                                            "A figure of speech whereby something is made to seem smaller or less important than it actually is."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fead9b3-4153-45d5-8afd-289b5d7f64a8",
                                                "sense_id": "430b339d-c932-36bc-8b83-852ad4569f1b",
                                                "text": "I knew, with one of those secret knowledges that can exist between two people, that her suicide was a direct result of my having told her of my own attempt – I had told it with a curt meiosis that was meant to conceal depths; and she had called my bluff one final time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b745168d-75ce-334b-8050-fbe1073d5bbe",
                                        "entry_id": "a3c2a8f4-859f-375a-913f-b72e5de17246",
                                        "glosses": [
                                            "Cell division of a diploid cell into four haploid cells, which develop to produce gametes."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb440b53-a851-4625-a9f0-478b0e8b15fc",
