                ],
                "senses": [
                    {
                        "sense_id": "2acb9b1d-33d9-3022-8aeb-112af49ce181",
                        "entry_id": "92da7b9a-387c-36b9-a458-c42e9999f8dc",
                        "glosses": [
                            "aan elkaar klemmende felgekleurde blokjes waarmee jonge kinderen iets kunnen maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c21de5-4510-4ff7-9961-060065e823b1",
                                "sense_id": "2acb9b1d-33d9-3022-8aeb-112af49ce181",
                                "text": "En dan het kind zelf. Die interesseert zich niet voor Montmartre of het uitzicht op de Mont Blanc; die was liever thuis gebleven om met zijn duplo te spelen."
                            },
                            {
                                "example_id": "bee69102-bd10-48d4-acb7-88e1d6d80860",
                                "sense_id": "2acb9b1d-33d9-3022-8aeb-112af49ce181",
                                "text": "Zij zit op de grond, bij haar duplo, en draait een rood blokje tussen haar vingers. ‘Mamma! Hoeveel koningen en koninginnen zijn er in Europa?’"
                            }
                        ]
                    },
                    {
                        "sense_id": "007447f2-232e-3e22-8605-90d98fa9f82a",
                        "entry_id": "92da7b9a-387c-36b9-a458-c42e9999f8dc",
                        "glosses": [
                            "versie van een tekst die identiek is aan het origineel"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4fec4bc8-4bfd-44d6-a41e-082bdb924bd6",
                                "sense_id": "007447f2-232e-3e22-8605-90d98fa9f82a",
                                "text": "Waarom hebt U me niet geschreven dat hetgeen ik stuurde niet mooi was of niet goed genoeg voor Hollands Maandblad! Nu ik van die dingen geen duplo heb weet ik het niet meer. Ze zijn gemaakt in een zenuwachtige tijd (examens en velerlei afmattend gemier met het ‘Leids Universiteits Blad’)."
                            },
                            {
                                "example_id": "5eb8590a-94dd-493c-ba3d-782673f8db94",
                                "sense_id": "007447f2-232e-3e22-8605-90d98fa9f82a",
                                "text": "Door den havenmeester zal voor die betaling bewijs in duplo worden afgegeven aan den belanghebbende. Tegen de overgifte van het duplo der quitantie door laatstgemelde aan den kommanderenden officier van 's Konings wachtschip, zullen de bedoelde hulpmiddelen aan de gedachte belanghebbende verstrekt worden."
                            }
                        ]
                    }
