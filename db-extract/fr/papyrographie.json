                        "entry_id": "278837d1-7098-3880-b366-12893b05f71d",
                        "glosses": [
                            "Procédé de reproduction similaire à la lithographie mais où l’on remplace la pierre par du carton fortement comprimé et très dur appelé carton-pierre."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "01d670c1-389e-42a4-9e05-ef473a5bd395",
                                "sense_id": "224aa233-4f75-372e-b553-95aa5d7cf984",
                                "text": "Nous aurions besoin dʼune tyrannie de ce genre pour coordonner la papyrographie, qui se disperse, comme, depuis Scaliger et Gruter, sʼétait dispersée lʼépigraphie."
                            },
                            {
                                "example_id": "21a7bd0d-184b-4652-9f58-82fb17dfc809",
                                "sense_id": "224aa233-4f75-372e-b553-95aa5d7cf984",
                                "text": "Les personnes qui désireront s'en procurer doivent s'adresser à M. A. Senefelder , inventeur de la lithographie et de la papyrographie , rue Servandoni , no 13 , près Saint - Sulpice ."
                            }
                        ]
                    }
