                                                "sense_id": "73c935a4-e723-3b4e-b2c9-19993971dc6b",
                                                "text": "Sie kam hinter dem Paravent hervor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c074633-a7ff-365a-a2be-7850bd4b64cd",
                                        "entry_id": "0108fe46-b52c-38df-a1c0-6d3304555dcf",
                                        "glosses": [
                                            "Ofenschirm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cda8da7-9176-4cd9-b67d-bb9b0cdbf75a",
                                                "sense_id": "5c074633-a7ff-365a-a2be-7850bd4b64cd",
                                                "text": "Er hat ein Paravent vor den Ofen gesetzt, um nicht so sehr von der Hitze belästigt zu werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5db364af-fe3a-4c33-a063-3e7439bd121f",
                        "source_entry_id": "8846954a-db62-3d4a-8d18-5e06384ad7ef",
                        "source_sense_description": "Sorte de meuble",
                        "target_lang_word": "Wandschirm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wandschirm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4ac6500-d128-3786-afd1-d3c428a60cbe",
                                        "entry_id": "a3e1b97c-0200-397a-801c-7d7a6bad2ecd",
                                        "glosses": [
                                            "beweglicher Schutzschirm gegen Kälte, Zugluft, als Sichtschutz und dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d322f93-4c16-496b-86e0-d9a23cac50d4",
                                                "sense_id": "b4ac6500-d128-3786-afd1-d3c428a60cbe",
                                                "text": "„Sie hatte deshalb in dem Obergeschosse des an der Straße gelegenen Gebäudes hinter Wandschirmen Tische decken und dort viele Zierlaternen aufhängen lassen.“"
                                            },
                                            {
                                                "example_id": "8ccd3e3d-acf2-458b-be2b-c890e3149364",
                                                "sense_id": "b4ac6500-d128-3786-afd1-d3c428a60cbe",
                                                "text": "„An das Kabinett schloss sich ein Korridor, in welchem ein Wandschirm mit zerrissenem Stoffbezuge stand.“"
                                            },
                                            {
                                                "example_id": "a0ab55e9-2bc0-45ea-9cad-2a1dffdb3233",
                                                "sense_id": "b4ac6500-d128-3786-afd1-d3c428a60cbe",
                                                "text": "„Sie zog einen Wandschirm vor und legte sich völlig ausgezogen zu Bett, wie ich von ihr selbst in Genua einige Tage später erfuhr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
