                                                "sense_id": "3c31bd2b-722a-328b-96c1-63be4446d249",
                                                "text": "Der Wagen hat Sitzbezüge aus Velours."
                                            },
                                            {
                                                "example_id": "04df3ce3-2184-4630-be9a-0adf8e2a97f7",
                                                "sense_id": "3c31bd2b-722a-328b-96c1-63be4446d249",
                                                "text": "„Ingibjörn nahm ein Tuch und putzte seine Brille, bevor er sie in ein mit Velours bezogenes Etui legte.“"
                                            }
                                        ],
