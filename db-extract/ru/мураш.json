                "senses": [
                    {
                        "sense_id": "fdd696a8-dbdd-307d-aa0c-595e7fade876",
                        "entry_id": "16f22152-dec6-34f2-a994-8cd5ac169e61",
                        "glosses": [
                            "разг. муравей (обычно мелкий)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f224bf-8e27-473f-8b4d-556af95f750e",
                                "sense_id": "fdd696a8-dbdd-307d-aa0c-595e7fade876",
                                "text": "Голова каравана была уже на той стороне и тянулась к горам, точно вереница чёрных мурашей по белой скатерти…"
                            }
                        ]
                    },
                    {
                        "sense_id": "14c9f380-fef5-3ae7-8598-6a71663627a6",
                        "entry_id": "16f22152-dec6-34f2-a994-8cd5ac169e61",
                        "glosses": [
                            "разг. то же, что мурашка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ea0a230-be42-42bb-b607-30f8268b1787",
                                "sense_id": "14c9f380-fef5-3ae7-8598-6a71663627a6",
                                "text": "А потом, как увлечётся сам да начнёт свои приключения рассказывать, так, поверите ли, у меня от восторга мураши по спине бегали."
                            }
                        ]
                    }
