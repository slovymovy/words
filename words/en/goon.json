                    "frequency": "Middle",
                    "semantic_group_id": "criminal_or_fighter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The corrupt businessman hired a couple of <w>goons</w> to intimidate the witnesses before the trial.",
