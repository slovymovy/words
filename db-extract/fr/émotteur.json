                    {
                        "sense_id": "0b43e17f-ea08-351e-8900-d22a30db9949",
                        "entry_id": "a31b8c79-0669-329b-9905-a930b25a1a3e",
                        "glosses": [
                            "Qui émotte, qui se débarrasse des mottes de terre restées en place après un labour en les brisant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6137acd-22ef-4741-8116-0bc3b28909f8",
                                "sense_id": "0b43e17f-ea08-351e-8900-d22a30db9949",
                                "text": "Le rouleau émotteur lourd, si les conditions dʼhumidité sont optimales désagrège le sol, nivelle et nʼincorpore pas les chaumes superficiels."
                            },
                            {
                                "example_id": "dfd3719f-10b6-4ce1-8765-bd2d1be5fda1",
                                "sense_id": "0b43e17f-ea08-351e-8900-d22a30db9949",
                                "text": "Nous y introduirons une herse articulée pour les prairies surtout et une herse émotteuse qui convient mieux que le rouleau à nos terres, un butteur, un scarificateur que nous considérons comme indispensable pour lʼameublissement du sol en fond."
                            }
                        ]
                    }
