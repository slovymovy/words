                                    },
                                    {
                                        "sense_id": "201a3cc5-61ef-3c1e-87c7-cad7bb755966",
                                        "entry_id": "09986738-932a-3abb-81ad-491cf30c1b53",
                                        "glosses": [
                                            "A summary, précis or epitome; an abridgement or abstract."
