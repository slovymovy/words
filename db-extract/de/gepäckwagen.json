                "senses": [
                    {
                        "sense_id": "80505293-24b4-30ac-a6c2-1b5c5930187f",
                        "entry_id": "89593c5b-2491-3b99-9fb4-3614f88490d1",
                        "glosses": [
                            "Eisenbahnwagen zum Transport von Gepäck"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "862dc307-491c-453d-bab8-d3a2a87d2b39",
                                "sense_id": "80505293-24b4-30ac-a6c2-1b5c5930187f",
                                "text": "„Und tatsächlich saß er sehr bald gemütlich in einem Waggon erster Klasse (denn sein Blatt zahlte ihm natürlich alle Spesen) und wußte seine freigegebenen Koffer unberührt im Gepäckwagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1a622e2d-a4a3-30b7-9913-260bca370866",
                        "entry_id": "89593c5b-2491-3b99-9fb4-3614f88490d1",
                        "glosses": [
                            "handliches Gefährt zum Transport von Gepäck beim Gehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6258a7b5-60da-4531-9320-9e51da122243",
                                "sense_id": "1a622e2d-a4a3-30b7-9913-260bca370866",
                                "text": "„Sie sah einen Mann mit einem Gepäckwagen, der abrupt stoppte und zurücksetzte, um einen Schraubenschlüssel aufzuheben, der ihm heruntergefallen war.“"
                            },
                            {
                                "example_id": "503d1973-d6a2-43e6-aca1-2ed80474b73e",
                                "sense_id": "1a622e2d-a4a3-30b7-9913-260bca370866",
                                "text": "„Ich schob den rostigen Gepäckwagen hinter ihm her und sah mich jedes Mal um, wenn jemand Persisch sprechend an mir vorbeiging.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
