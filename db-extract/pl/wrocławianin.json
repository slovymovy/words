                "senses": [
                    {
                        "sense_id": "b44fe7ca-fc32-3318-a236-f5da068eed94",
                        "entry_id": "c54be065-94f5-3f54-bdbe-29923a1e70de",
                        "glosses": [
                            "native or inhabitant of Wrocław"
                        ],
                        "tags": [
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "d2538f3c-b739-43c0-8f57-a0221669aec4",
                                "sense_id": "b44fe7ca-fc32-3318-a236-f5da068eed94",
                                "text": "Niewykluczone, że wrocławianin wiózł narkotyk na własny użytek.",
                                "translation": "It's possible that the inhabitant of Wrocław was carrying the drug for private use.",
                                "english": "It's possible that the inhabitant of Wrocław was carrying the drug for private use."
                            },
                            {
                                "example_id": "0e788f75-5447-4aff-b548-e0dee1bfd9be",
                                "sense_id": "b44fe7ca-fc32-3318-a236-f5da068eed94",
                                "text": "Panie Profesorze, dziękuję za odpowiedź, zwłaszcza ze względu na to, że ministrem kultury jest wrocławianin…",
                                "translation": "Professor, thank you for the answer, especially that the minister of culture is a native of Wrocław…",
                                "english": "Professor, thank you for the answer, especially that the minister of culture is a native of Wrocław…"
                            },
                            {
                                "example_id": "a7f22d12-ebf0-4747-ac8e-d2bd8dc91067",
                                "sense_id": "b44fe7ca-fc32-3318-a236-f5da068eed94",
                                "text": "Komisarz Zygfryd Holewa, czując, że ma oto sprawę, która może decydować o jego awansie, zapomniał natychmiast o zakazie wydanym Mockowi i ruszył ostro do akcji w stylu, który wrocławianin lubił.",
                                "translation": "Commissioner Zygfryd Holewa, feeling that he had a case that could decide his promotion, immediately forgot about the ban issued to Mock and launched into action in a style that the Wrocławian liked.",
                                "english": "Commissioner Zygfryd Holewa, feeling that he had a case that could decide his promotion, immediately forgot about the ban issued to Mock and launched into action in a style that the Wrocławian liked."
                            }
                        ]
                    }
