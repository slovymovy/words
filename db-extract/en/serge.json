                "senses": [
                    {
                        "sense_id": "930e77e1-0da7-30f2-a84b-cf058c4f5385",
                        "entry_id": "305c5f05-82fc-3bb9-bd2b-93e71a9459d7",
                        "glosses": [
                            "A type of worsted cloth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "44d3a783-8f3f-4053-afb6-37f48105965f",
                                "sense_id": "930e77e1-0da7-30f2-a84b-cf058c4f5385",
                                "text": "Lucy, who had only seen her in either the large loose wrapping dress of serge, or in the quaint simplicity of the Puritanic garb, then so general in England, could not restrain an exclamation of admiration as she returned to their chamber."
                            },
                            {
                                "example_id": "91d2f362-f471-4aee-90a4-98346b73b95a",
                                "sense_id": "930e77e1-0da7-30f2-a84b-cf058c4f5385",
                                "text": "What I noticed most strongly was his smell, of hair oil and serge and cigarette smoke, and something else, something intimate and sour and wholly, shockingly other."
                            }
                        ]
                    },
                    {
                        "sense_id": "37e17b1d-90d8-35dc-8c87-4cbfefc4feb1",
                        "entry_id": "305c5f05-82fc-3bb9-bd2b-93e71a9459d7",
                        "glosses": [
                            "A garment made of this fabric."
                        ],
                        "tags": [
                            "countable",
                            "metonymically",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4a583a8-1f17-409b-b76e-da96e3a16d85",
                        "source_entry_id": "305c5f05-82fc-3bb9-bd2b-93e71a9459d7",
                        "source_sense_description": "type of cloth",
                        "target_lang_word": "са́ржа",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "са́ржа",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2541724e-e57e-39a4-8532-f23a407ffccf",
                                        "entry_id": "df9b4336-b034-30ae-b1a5-ad0a8c26b351",
                                        "glosses": [
                                            "текст. хлопчатобумажная, шёлковая или искусственная ткань с диагональным переплетением нитей и наклонными рубчиками на лицевой поверхности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "142d7947-94a7-4f8d-b69e-25222cf3ebd5",
                                                "sense_id": "2541724e-e57e-39a4-8532-f23a407ffccf",
                                                "text": "Гимназические шинели были светло-серого цвета, на вате, со стёганой серой подкладкой из саржи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdc98100-1bc5-34a7-8644-cd75582288b6",
                                        "entry_id": "df9b4336-b034-30ae-b1a5-ad0a8c26b351",
                                        "glosses": [
                                            "текст. саржевое переплетение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d4006e-fb76-4a96-a3f4-9824ba6bc0a4",
                                                "sense_id": "fdc98100-1bc5-34a7-8644-cd75582288b6",
                                                "text": "Благодаря применению особого вида переплетения — сложной саржи, на лицевой поверхности образуется резко выраженный мелкий рубчик."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
