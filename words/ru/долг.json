    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8dfc1705-b985-3e90-babd-2b14efb5e636",
                    "sense_definition": "То, что взято взаймы (обычно деньги) и должно быть возвращено.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "debt_finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой друг попросил у меня денег в <w>долг</w> до зарплаты.",
                            "target_lang_translations": {
                                "en": "My friend asked me for a <w>loan</w> until payday.",
                                "es": "Mi amigo me pidió dinero <w>prestado</w> hasta el día de cobro.",
                                "fr": "Mon ami m'a demandé de l'argent en <w>prêt</w> jusqu'à la paie."
                            }
                        },
                        {
                            "text": "Вам нужно как можно скорее вернуть этот <w>долг</w> банку.",
                            "target_lang_translations": {
                                "en": "You need to repay this <w>debt</w> to the bank as soon as possible.",
                                "es": "Tiene que devolver esta <w>deuda</w> al banco lo antes posible.",
                                "fr": "Vous devez rembourser cette <w>dette</w> à la banque dès que possible."
                            }
                        }
                    ],
                    "synonyms": [
                        "задолженность",
                        "заём"
                    ],
                    "common_phrases": [
                        "взять в долг",
                        "дать в долг",
                        "вернуть долг",
                        "быть в долгу",
                        "влезть в долги"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that is borrowed (usually money) and must be returned.",
                        "es": "Algo que se pide prestado (normalmente dinero) y que debe devolverse.",
                        "fr": "Somme d'argent ou bien emprunté qui doit être remboursé."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "debt",
                                "target_lang_sense_clarification": "money owed"
                            },
                            {
                                "target_lang_word": "loan",
                                "target_lang_sense_clarification": "money borrowed"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deuda",
                                "target_lang_sense_clarification": "dinero pendiente de pago"
                            },
                            {
                                "target_lang_word": "débito",
                                "target_lang_sense_clarification": "compromiso de pago o deuda"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "dette",
                                "target_lang_sense_clarification": "argent dû"
                            },
                            {
                                "target_lang_word": "emprunt",
                                "target_lang_sense_clarification": "somme empruntée"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0050bff8-7dac-39bd-a95b-788e90fc741e",
                    "sense_definition": "Моральная или юридическая обязанность, то, что необходимо исполнить.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moral_obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач считал своим профессиональным <w>долгом</w> помочь каждому пациенту.",
                            "target_lang_translations": {
                                "en": "The doctor considered it his professional <w>duty</w> to help every patient.",
                                "es": "El médico consideraba que era su <w>deber</w> profesional ayudar a cada paciente.",
                                "fr": "Le médecin considérait comme son <w>devoir</w> professionnel d'aider chaque patient."
                            }
                        },
                        {
                            "text": "Защита природы — это наш общий гражданский <w>долг</w>.",
                            "target_lang_translations": {
                                "en": "Protecting nature is our common civic <w>duty</w>.",
                                "es": "La protección de la naturaleza es nuestro <w>deber</w> cívico común.",
                                "fr": "La protection de la nature est notre <w>devoir</w> civique commun."
                            }
                        }
                    ],
                    "synonyms": [
                        "обязанность",
                        "обязательство"
                    ],
                    "common_phrases": [
                        "чувство долга",
                        "гражданский долг",
                        "выполнить долг",
                        "по долгу службы",
                        "священный долг"
                    ],
                    "target_lang_definitions": {
                        "en": "A moral or legal obligation, something that must be fulfilled.",
                        "es": "Obligación moral o legal, aquello que es necesario cumplir.",
                        "fr": "Obligation morale ou légale, ce qui doit être accompli."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "duty",
                                "target_lang_sense_clarification": "moral or legal obligation"
                            },
                            {
                                "target_lang_word": "obligation",
                                "target_lang_sense_clarification": "responsibility"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deber",
                                "target_lang_sense_clarification": "obligación moral o ética"
                            },
                            {
                                "target_lang_word": "obligación",
                                "target_lang_sense_clarification": "exigencia o responsabilidad que se debe cumplir"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "devoir",
                                "target_lang_sense_clarification": "obligation morale ou civique"
                            },
                            {
                                "target_lang_word": "obligation",
                                "target_lang_sense_clarification": "responsabilité à remplir"
                            }
                        ]
                    }
                }
            ]
        }
    ]
