{
    "word_family": [
        "naysay",
        "naysaying"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "307486b8-2610-3144-82b0-280028d84686",
                    "sense_definition": "A person who habitually expresses negative views, doubts, or opposition to something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "skeptics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ignored the <w>naysayers</w> and succeeded with his idea despite their constant criticism.",
                            "target_lang_translations": {
                                "ru": "Он игнорировал <w>скептиков</w> и добился успеха со своей идеей, несмотря на их постоянную критику."
                            }
                        },
                        {
                            "text": "The politician dismissed his opponents as mere <w>naysayers</w> who offered no real solutions.",
                            "target_lang_translations": {
                                "ru": "Политик отмахнулся от своих оппонентов как от обычных <w>критиканов</w>, которые не предлагали никаких реальных решений."
                            }
                        }
                    ],
                    "synonyms": [
                        "pessimist",
                        "doubter",
                        "cynic"
                    ],
                    "antonyms": [
                        "yeasayer",
                        "yea-sayer"
                    ],
                    "common_phrases": [
                        "ignore the naysayers",
                        "dismiss the naysayers",
                        "critics and naysayers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который постоянно выражает негативное мнение, сомнение или несогласие с чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скептик",
                                "target_lang_sense_clarification": "человек, сомневающийся в успехе или истинности чего-либо"
                            },
                            {
                                "target_lang_word": "пессимист",
                                "target_lang_sense_clarification": "человек, склонный видеть всё в мрачном свете"
                            },
                            {
                                "target_lang_word": "противник",
                                "target_lang_sense_clarification": "тот, кто выступает против какой-либо идеи или плана"
                            },
                            {
                                "target_lang_word": "критикан",
                                "target_lang_sense_clarification": "человек, склонный к постоянной и часто необоснованной критике"
                            }
                        ]
                    }
                }
            ]
        }
