                                            {
                                                "example_id": "c2e2a7f2-1c3b-44d2-b22d-395fd88fefb4",
                                                "sense_id": "b343efd6-2571-3e4f-a9b2-e3fdd64d0718",
                                                "text": "L'année suivante [1983], la diffusion dans les pays occidentaux du téléfilm Le Jour d'après (The Day After) marque les esprits, alors que la tension est vive entre les gouvernements de Ronald Reagan et de Youri Andropov."
                                            },
                                            {
                                                "example_id": "ce16b129-41f6-46a5-867d-2b14e26e54b2",
                                                "sense_id": "b343efd6-2571-3e4f-a9b2-e3fdd64d0718",
                                                "text": "« J’aimerais changer mon téléphone depuis des mois. S’il y a une bonne offre, ce sera l’occasion, sinon on attendra », explique Youri."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
