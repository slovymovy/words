                                "target_senses": [
                                    {
                                        "sense_id": "209ef159-c797-3e55-880f-e72275e00152",
                                        "entry_id": "f4338c66-90a8-3eb7-a744-d0ae1862c803",
                                        "glosses": [
                                            "A person who writes, or produces literary work; an author can refer to themselves as \\\"the writer\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7350d69c-01cb-438f-acbb-79b2340af658",
                                                "sense_id": "209ef159-c797-3e55-880f-e72275e00152",
                                                "text": "Has your girlfriend written you another letter already? She’s quite a writer!"
                                            },
                                            {
                                                "example_id": "ac28cb66-e64f-41ec-8056-be7f92c69b1f",
                                                "sense_id": "209ef159-c797-3e55-880f-e72275e00152",
                                                "text": "I met some of my favourite authors at the writers' convention."
                                            },
                                            {
                                                "example_id": "4b398f46-61e5-4775-ac5d-f875c73cbd82",
                                                "sense_id": "209ef159-c797-3e55-880f-e72275e00152",
                                                "text": "the present writer (referring to oneself as the writer)"
                                            },
                                            {
                                                "example_id": "dd389b11-31de-403b-ace2-3128542ee783",
                                                "sense_id": "209ef159-c797-3e55-880f-e72275e00152",
                                                "text": "Beautie alone is a ſoveraigne remedy againſt feare,griefe,and all melancholy fits; a charm,as Peter de la Seine and many other writers affirme,a banquet it ſelfe;he gives inſtance in diſcontented Menelaus that was ſo often freed by Helenas faire face: and ʰTully, 3 Tusc. cites Epicurus as a chiefe patron of this Tenent."
                                            },
                                            {
                                                "example_id": "c0e964ab-a109-4523-a9d5-1a27790a2123",
                                                "sense_id": "209ef159-c797-3e55-880f-e72275e00152",
                                                "text": "Though the writer has striven to dwell on aspects that have passed, or are passing away, it will be apparent that many features of Midland practice have been adopted as standard for the L.M.S.R. and other railways."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df82a2fe-0db2-36e7-85ef-78e512f7b6d5",
                                        "entry_id": "f4338c66-90a8-3eb7-a744-d0ae1862c803",
                                        "glosses": [
                                            "Anything that writes or produces output."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b522f60-5200-4adc-a6b8-c9dffb572b34",
                                                "sense_id": "df82a2fe-0db2-36e7-85ef-78e512f7b6d5",
                                                "text": "If the writer is set to autoflush mode, then all characters in the buffer are sent to their destination whenever println is called."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "582ef6c4-f943-3943-8068-58b1d92f8b26",
                                        "entry_id": "f4338c66-90a8-3eb7-a744-d0ae1862c803",
                                        "glosses": [
                                            "The seller of an option."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf2a92fb-f337-380e-9cf3-95d14123afdf",
                                        "entry_id": "f4338c66-90a8-3eb7-a744-d0ae1862c803",
                                        "glosses": [
                                            "A clerk of a certain rank in the service of the East India Company, who, after serving a certain number of years, became a factor."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7486ce1d-5f2e-3bb1-b1a2-eb3caa594bdc",
                                        "entry_id": "f4338c66-90a8-3eb7-a744-d0ae1862c803",
                                        "glosses": [
                                            "An ordinary legal practitioner in Scottish country towns."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69032c1a-93a9-3580-9b18-f3195827da4e",
                                        "entry_id": "f4338c66-90a8-3eb7-a744-d0ae1862c803",
                                        "glosses": [
                                            "A petty officer in the United States navy who keeps the watch-muster and other books of the ship."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8f1f8b1-9d8e-38c5-af9d-ddde418b68d0",
                                        "entry_id": "f4338c66-90a8-3eb7-a744-d0ae1862c803",
                                        "glosses": [
                                            "A graffiti artist."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abfbc792-2958-4317-afd1-9c0f0eb80e1d",
                                                "sense_id": "e8f1f8b1-9d8e-38c5-af9d-ddde418b68d0",
                                                "text": "Writers were reunited with their crews, none having seen each other since back in the day, since they'd spun from teenage affiliations into lives more burdened and serious."
                                            },
                                            {
                                                "example_id": "5172104f-3397-4c85-87d6-ba300536caeb",
                                                "sense_id": "e8f1f8b1-9d8e-38c5-af9d-ddde418b68d0",
                                                "text": "Two aspects of style co-exist in graffiti art, as explained in chapter 2. There is a writer's personal style, and there is iconic style, or style as convention."
                                            }
                                        ]
                                    }
                                ]
