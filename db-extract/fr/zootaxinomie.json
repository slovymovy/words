                "senses": [
                    {
                        "sense_id": "1ee192c7-0315-329e-b972-09873a81acec",
                        "entry_id": "e253da05-6755-3cb8-852b-b25b4b4f0790",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ae2da7-e404-4f0f-ab3f-9b9f5bff1ad6",
                                "sense_id": "1ee192c7-0315-329e-b972-09873a81acec",
                                "text": "Depuis B. Rensch, la zootaxinomie - reconnaît des espèces monotypiques et polytypiques. Les espèces monotypiques sont homogènes dans toute leur aire géographique, qui est généralement limitée."
                            },
                            {
                                "example_id": "593e405f-ff4b-4590-8045-f847020428da",
                                "sense_id": "1ee192c7-0315-329e-b972-09873a81acec",
                                "text": "Les mushi constituent en effet la catégorie la plus intrigante de la zootaxinomie populaire japonaise (Laurent, 1998 : 107-148 ; 2002 : 1-5). Cette catégorie englobe, outre l’ensemble des insectes ainsi que la plupart des autres arthropodes (sauf les crabes, crevettes, écrevisses et groupes apparentés), quelques mollusques, des groupes moins connus d’invertébrés, des larves de batraciens, voire des reptiles."
                            }
                        ]
                    }
