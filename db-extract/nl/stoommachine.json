                "senses": [
                    {
                        "sense_id": "3595e9b1-624a-30ab-a317-793ee52ae35b",
                        "entry_id": "ff3421e1-fe39-3417-9c8f-2c6f743f0966",
                        "glosses": [
                            "een machine die door middel van stoom drijfkracht ontwikkelt"
                        ],
                        "tags": [
                            "motortechniek"
                        ],
                        "examples": [
                            {
                                "example_id": "f16e303b-a9cf-448b-87b8-110902d6ebd2",
                                "sense_id": "3595e9b1-624a-30ab-a317-793ee52ae35b",
                                "text": "De stoommachine is al drie keer kapot gegaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0095ae2-5f87-4935-9d27-b805ccd2f7d2",
                        "source_entry_id": "ff3421e1-fe39-3417-9c8f-2c6f743f0966",
                        "source_sense_id": "3595e9b1-624a-30ab-a317-793ee52ae35b",
                        "source_sense_description": "een machine die door middel van stoom drijfkracht ontwikkelt",
                        "target_lang_word": "Dampfmaschine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dampfmaschine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5da2333-f52a-3af6-a1b8-1cfd5cb43dd3",
                                        "entry_id": "068977e8-122b-39d7-a068-5cf347258039",
                                        "glosses": [
                                            "eine Vorrichtung, die mechanische Arbeit aus Wärmeenergie durch Erhitzen von Wasser gewinnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37ed627-087e-4df0-814d-b7b670d0b76f",
                                                "sense_id": "e5da2333-f52a-3af6-a1b8-1cfd5cb43dd3",
                                                "text": "„Die erste Dampfmaschine wurde im Jahr 1655 von Edward Somerset, Marquis und Earl von Worcester, entworfen. Im Jahr 1685 produzierte Denis Papin ein erstes funktionierendes Modell, und 1712 installierte Thomas Newcomen im englischen Tipton die erste echte verwendbare Dampfmaschine.“"
                                            },
                                            {
                                                "example_id": "c52b691b-306a-4681-b9bb-ff18ee16e1f7",
                                                "sense_id": "e5da2333-f52a-3af6-a1b8-1cfd5cb43dd3",
                                                "text": "„Endlich eine Dampfmaschine, die eine Drehbewegung erzeugt: James Watt verbesserte die damals verbreitete Newcomen-Dampfmaschine ganz wesentlich.“"
                                            },
                                            {
                                                "example_id": "2e0d2147-8021-4927-9a9b-5881655fd9c0",
                                                "sense_id": "e5da2333-f52a-3af6-a1b8-1cfd5cb43dd3",
                                                "text": "„In einer Dampfmaschine wird die Wärme über das Medium Wasserdampf transportiert – heißer Dampf versetzt einen Kolben in Bewegung und verwandelt so Wärme in Arbeit.“"
                                            },
                                            {
                                                "example_id": "94211757-85cd-424b-b720-8deff0f4249c",
                                                "sense_id": "e5da2333-f52a-3af6-a1b8-1cfd5cb43dd3",
                                                "text": "„Schließlich brachte die Bahn die zwei Dampftraktionsmaschinen herbei, die die Boote durch die Wildnis schleppen würden, und gleichentags tauchten aus dem Nichts fünfhundert prachtvolle südafrikanische Zugochsen mit gewaltigen Hörnern auf, welche die Boote weiterziehen sollten, wenn die Dampfmaschinen versagten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
