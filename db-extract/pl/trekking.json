                                    {
                                        "sense_id": "6bce61ec-fc64-37ab-92b6-67465cde7b02",
                                        "entry_id": "abeb5c31-8df3-3172-acec-a5f30109a0d4",
                                        "glosses": [
                                            "A journey by ox wagon."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af7f61a8-3335-3a60-aaed-ddda377e1a0e",
                                        "entry_id": "abeb5c31-8df3-3172-acec-a5f30109a0d4",
                                        "glosses": [
                                            "The Boer migration of 1835–1837."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4b552fd-e8db-36e5-86d1-cef2143a097b",
                                        "entry_id": "abeb5c31-8df3-3172-acec-a5f30109a0d4",
                                        "glosses": [
                                            "A slow or difficult journey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61588fec-8943-4d9e-97f2-d99c63d0781b",
                                                "sense_id": "e4b552fd-e8db-36e5-86d1-cef2143a097b",
                                                "text": "We're planning a trek up Kilimanjaro."
                                            },
                                            {
                                                "example_id": "461dc5bf-b0b3-4580-bbb7-a19b8fd07c8d",
                                                "sense_id": "e4b552fd-e8db-36e5-86d1-cef2143a097b",
                                                "text": "Early the next morning I set off on the long and hazardous trek through jungles and hills into Assam, and regretfully said \"good-bye\" to the gallant little Burma Railways, which had functioned to the last and played a big part in evacuating many thousands of refugees and wounded soldiers in the path of the rapidly advancing Japanese."
                                            },
                                            {
                                                "example_id": "1aa3cc44-c6bd-486d-9f52-a7d23441cef1",
                                                "sense_id": "e4b552fd-e8db-36e5-86d1-cef2143a097b",
                                                "text": "Young Indians looking for work opportunities have made up a sizeable portion of undocumented migrants in the US, many after making the dangerous trek through Latin America to reach the US southern border."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0403c107-b16e-35f7-a69a-5069215c13ed",
                                        "entry_id": "abeb5c31-8df3-3172-acec-a5f30109a0d4",
                                        "glosses": [
                                            "A long walk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e63998-6977-4fa0-a360-92f851e70bd5",
                                                "sense_id": "0403c107-b16e-35f7-a69a-5069215c13ed",
                                                "text": "I would drive to the shops from here; you can walk, but it's quite a trek."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57cc7561-a240-3e3c-967f-2bd1420b1fca",
                                        "entry_id": "1857e0da-288a-3267-b3ce-a456ecdd7a02",
                                        "glosses": [
                                            "To make a slow or arduous journey."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
