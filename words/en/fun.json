{
    "word_family": [
        "funny",
        "funniness",
        "funfilled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68ae3bc5-6e69-308b-9e7b-4e3ddf86f710",
                    "sense_definition": "Amusement, enjoyment, or pleasure derived from an activity.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had so much <w>fun</w> at the beach yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на пляже нам было очень <w>весело</w>."
                            }
                        },
                        {
                            "text": "The children are having <w>fun</w> playing in the garden.",
                            "target_lang_translations": {
                                "ru": "Дети <w>развлекаются</w>, играя в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "amusement",
                        "enjoyment",
                        "pleasure"
                    ],
                    "antonyms": [
                        "boredom",
                        "misery"
                    ],
                    "common_phrases": [
                        "have fun",
                        "lot of fun",
                        "just for fun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удовольствие, радость или наслаждение, получаемое от какой-либо деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "веселье",
                                "target_lang_sense_clarification": "радостное настроение или времяпровождение"
                            },
                            {
                                "target_lang_word": "удовольствие",
                                "target_lang_sense_clarification": "приятное чувство от занятия"
                            },
                            {
                                "target_lang_word": "развлечение",
                                "target_lang_sense_clarification": "занятие для отдыха и радости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86fa3b75-83a4-34cc-ae0b-ec06da34531f",
                    "sense_definition": "Playful, often noisy, activity or behavior.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party was full of <w>fun</w> and games for everyone.",
                            "target_lang_translations": {
                                "ru": "На вечеринке было полно <w>забав</w> и игр для всех."
                            }
                        },
                        {
                            "text": "Stop all that <w>fun</w> and horseplay before someone gets hurt.",
                            "target_lang_translations": {
                                "ru": "Прекратите это <w>веселье</w> и возню, пока кто-нибудь не пострадал."
                            }
                        }
                    ],
                    "synonyms": [
                        "boisterousness",
                        "horseplay",
                        "rough and tumble"
                    ],
                    "common_phrases": [
                        "fun and games"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игривая, часто шумная деятельность или поведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забава",
                                "target_lang_sense_clarification": "игра или развлечение"
                            },
                            {
                                "target_lang_word": "потеха",
                                "target_lang_sense_clarification": "шумное веселье или смешная ситуация"
                            },
                            {
                                "target_lang_word": "игры",
                                "target_lang_sense_clarification": "активное развлечение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a33b27f-056d-3edd-a4b5-bdea04e50122",
                    "sense_definition": "Providing enjoyment or being amusing.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "enjoyable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>fun</w> time at the birthday party.",
                            "target_lang_translations": {
                                "ru": "Мы <w>весело</w> провели время на дне рождения."
                            }
                        },
                        {
                            "text": "He is such a <w>fun</w> person to be around.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>весёлый</w> человек, с ним приятно находиться рядом."
                            }
                        }
                    ],
                    "antonyms": [
                        "boring",
                        "dull"
                    ],
                    "common_phrases": [
                        "fun time",
                        "fun person",
                        "fun activity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приносящий удовольствие или являющийся занимательным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весёлый",
                                "target_lang_sense_clarification": "вызывающий радость или смех"
                            },
                            {
                                "target_lang_word": "классный",
                                "target_lang_sense_clarification": "разговорное: очень приятный, интересный"
                            },
                            {
                                "target_lang_word": "забавный",
                                "target_lang_sense_clarification": "развлекательный, вызывающий улыбку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9256db4-f4b3-3548-b25b-beee3d80a6e8",
                    "sense_definition": "Whimsical, flamboyant, or lighthearted in style.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "enjoyable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This year's fashion style is much more <w>fun</w> than recent seasons.",
                            "target_lang_translations": {
                                "ru": "Стиль моды в этом году гораздо более <w>игривый</w>, чем в прошлых сезонах."
                            }
                        },
                        {
                            "text": "She wore a <w>fun</w> hat with bright feathers to the event.",
                            "target_lang_translations": {
                                "ru": "На мероприятие она надела <w>забавную</w> шляпу с яркими перьями."
                            }
                        }
                    ],
                    "antonyms": [
                        "serious",
                        "conservative"
                    ],
                    "common_phrases": [
                        "fun fashion",
                        "fun style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причудливый, яркий или легкомысленный по стилю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игривый",
                                "target_lang_sense_clarification": "о стиле или одежде"
                            },
                            {
                                "target_lang_word": "прикольный",
                                "target_lang_sense_clarification": "сленг: необычный и классный"
                            },
                            {
                                "target_lang_word": "яркий",
                                "target_lang_sense_clarification": "броский и жизнерадостный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "551c5dbd-8a82-3a9a-a0ab-53ab95f35570",
                    "sense_definition": "To tease, kid, or joke with someone in a playful way.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't get angry; I was only <w>funning</w> you about your haircut.",
                            "target_lang_translations": {
                                "ru": "Не сердись, я просто <w>подшучивал</w> над твоей причёской."
                            }
                        },
                        {
                            "text": "He likes to <w>fun</w> with his friends during their lunch break.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>дурачиться</w> с друзьями во время обеденного перерыва."
                            }
                        }
                    ],
                    "common_phrases": [
                        "just funning"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to mean teasing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дразнить, подшучивать или шутить с кем-то в игривой манере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подшучивать",
                                "target_lang_sense_clarification": "по-доброму смеяться над кем-то"
                            },
                            {
                                "target_lang_word": "дурачиться",
                                "target_lang_sense_clarification": "вести себя несерьёзно"
                            },
                            {
                                "target_lang_word": "разыгрывать",
                                "target_lang_sense_clarification": "устраивать шутку над кем-то"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}