                            "plural"
                        ],
                        "form": "dholes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0af89d2-dd7d-30e6-ab5c-688f7055bdc0",
                        "entry_id": "bbf894c8-54b8-30d8-bf22-272b835800d3",
                        "glosses": [
                            "Espèce de canidé sauvage asiatique, Cuon alpinus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1feb6e46-bc21-4587-af06-b8f732a9dd62",
                                "sense_id": "a0af89d2-dd7d-30e6-ab5c-688f7055bdc0",
                                "text": "Un dhole adulte a besoin de manger environ 1,9 kg de viande par jour ou, de façon plus générale, 10 % de son poids total."
                            },
                            {
                                "example_id": "a6e57f7d-3f86-4285-a077-3399c3ed5bdb",
                                "sense_id": "a0af89d2-dd7d-30e6-ab5c-688f7055bdc0",
                                "text": "Exclusivement carnivore, le dhole (Cuon alpinus ) est considéré comme l’un des plus redoutables prédateurs de toute l’Asie."
                            },
                            {
                                "example_id": "3d646d97-a042-4150-8dfe-91d970c02e43",
                                "sense_id": "a0af89d2-dd7d-30e6-ab5c-688f7055bdc0",
                                "text": "En fait, sa réputation vient du fait que les dholes attaquent en groupe et tuent rarement leur proie du premier coup."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44cc3543-bd5f-493e-b158-598c05e487b2",
                        "source_entry_id": "bbf894c8-54b8-30d8-bf22-272b835800d3",
                        "source_sense_id": "a0af89d2-dd7d-30e6-ab5c-688f7055bdc0",
