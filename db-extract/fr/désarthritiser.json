                                "example_id": "ef20cdac-6abe-469b-9358-a9042ff4c000",
                                "sense_id": "da701c66-a67d-305d-975a-b707b498ea2c",
                                "text": "Pourtant, moi, Dr Myrrhman, malgré ces conditions extrêmes, je vais vous apporter la joie, la grâce, l’envie de sautiller partout, de retrouver votre jeunesse, de désarthritiser vos articulations."
                            },
                            {
                                "example_id": "d7b66528-1961-4779-baee-27734d22d084",
                                "sense_id": "da701c66-a67d-305d-975a-b707b498ea2c",
                                "text": "S’arthritiser, c’est vieillir Se désarthritiser, c’est rajeunir."
                            }
                        ]
                    }
