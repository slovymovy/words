                "senses": [
                    {
                        "sense_id": "f24a41a1-c37f-3e47-86a0-5e691b2c6f8a",
                        "entry_id": "9befd7ad-d34b-39be-b7f0-e7feab03d7f7",
                        "glosses": [
                            "начать ныть, издавать протяжные, жалобные звуки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eef6848f-805a-4e28-8f75-20fd560c4400",
                                "sense_id": "f24a41a1-c37f-3e47-86a0-5e691b2c6f8a",
                                "text": "Две гитары за стеной/Жалобно заныли…/С детства памятный напев,/Милый, это ты ли?"
                            }
                        ]
                    },
                    {
                        "sense_id": "65ad19fe-a6d8-3c22-af72-f5c47aa8c5e7",
                        "entry_id": "9befd7ad-d34b-39be-b7f0-e7feab03d7f7",
                        "glosses": [
                            "раздаться (о жалобных звуках)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9ed3010d-5d2e-351b-b84e-ec7f8686100f",
                        "entry_id": "9befd7ad-d34b-39be-b7f0-e7feab03d7f7",
                        "glosses": [
                            "начать со слезами, стонами надоедливо жаловаться на что-л., упрекать кого-л. в чем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4aeaa55c-c3eb-31fe-8d30-ec038f616231",
                        "entry_id": "9befd7ad-d34b-39be-b7f0-e7feab03d7f7",
