                    "frequency": "Low",
                    "semantic_group_id": "grammaticale vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wind bleef de hele nacht <w>razend</w> om het kleine huisje heen waaien.",
                            "target_lang_translations": {
                                "en": "The wind continued <w>raging</w> around the small house all night long."
                            }
                        },
                        {
                            "text": "Al <w>razend</w> uitte de man zijn ongenoegen over de gang van zaken.",
                            "target_lang_translations": {
