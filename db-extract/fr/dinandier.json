                                        "sense_id": "b80b0b8f-df3b-3e4c-a764-6b1488d7fbd6",
                                        "entry_id": "be695e30-97f3-3cf3-882a-bd79e936fae5",
                                        "glosses": [
                                            "A South Asian barbet, Psilopogon haemacephala, with crimson forehead and throat, best known for its metronomic call that has been likened to a coppersmith striking metal with a hammer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e471ac5a-3746-4b31-b801-93ca76dffafc",
                                                "sense_id": "b80b0b8f-df3b-3e4c-a764-6b1488d7fbd6",
                                                "text": "More noises came from a dusty tree, where brown birds creaked and floundered about looking for insects; another bird, the invisible coppersmith, had started his ‘ponk ponk’."
                                            }
                                        ]
                                    }
                                ]
