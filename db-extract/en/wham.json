                ],
                "senses": [
                    {
                        "sense_id": "8f37092f-b269-3fe5-8800-d93156b0f07d",
                        "entry_id": "474a9aef-16c3-3aa1-b503-a96e9a9c3ca2",
                        "glosses": [
                            "A forceful blow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa28e4a1-6754-41a2-bb20-2be9266307b0",
                                "sense_id": "8f37092f-b269-3fe5-8800-d93156b0f07d",
                                "text": "Roger was given a violent wham by his boxing opponent."
                            },
                            {
                                "example_id": "6019f678-c066-412c-99a7-010c3fa82ec1",
                                "sense_id": "8f37092f-b269-3fe5-8800-d93156b0f07d",
                                "text": "Might be a good idea to have a wham at it, anyway. Stop it getting away. Knock it out so that we can have a proper look at it."
                            }
                        ]
                    },
                    {
                        "sense_id": "6243642c-4045-3ba2-adf5-e59d0b7a74a5",
                        "entry_id": "474a9aef-16c3-3aa1-b503-a96e9a9c3ca2",
                        "glosses": [
                            "The sound of such a blow; a thud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21a692eb-6f54-4d71-9153-ba1e4d12ed5a",
                                "sense_id": "6243642c-4045-3ba2-adf5-e59d0b7a74a5",
                                "text": "We heard a wham as the hammer struck the wall."
                            }
                        ]
                    },
                    {
