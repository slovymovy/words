                        "entry_id": "70add8bb-b957-3d8f-be1b-8d5bedacab95",
                        "glosses": [
                            "epoka w dziejach ludzkości, trwająca od ok. 5-3 mln r. p.n.e. do ok. 10000 r. p.n.e."
                        ],
                        "tags": [],
                        "examples": [
