                "senses": [
                    {
                        "sense_id": "3043e3d4-c99f-3023-81d9-5463af983f1c",
                        "entry_id": "bf0d7873-748b-3704-83b0-23d4d1cef0dc",
                        "glosses": [
                            "besonders teure und prestigeträchtige Uhr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdae33d9-0c50-4e8e-a6c6-660bdeb715e8",
                                "sense_id": "3043e3d4-c99f-3023-81d9-5463af983f1c",
                                "text": "„Wurde Anfang des Jahres noch auf eine Trendwende in der Uhrenindustrie gehofft, lief gerade im letzten Jahr das Geschäft mit den Luxusuhren mehr schlecht als recht […]“"
                            },
                            {
                                "example_id": "4f11ba4a-ea47-46d3-8c22-7106b6fdc69a",
                                "sense_id": "3043e3d4-c99f-3023-81d9-5463af983f1c",
                                "text": "„Die Menschen in Glashütte jedenfalls können sich die Luxusuhren von Firmen wie A. Lange & Söhne, Glashütte Original und Moritz Grossmann eher nicht leisten, wie ein Mitarbeiter des Uhrenmuseums Glashütte erzählt.“"
                            }
                        ],
