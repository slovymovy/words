                "senses": [
                    {
                        "sense_id": "8558b7bb-20d1-39ce-b2ab-54fd641f6118",
                        "entry_id": "54a60a2d-8301-37b2-a266-a9107154a719",
                        "glosses": [
                            "berufliche Tätigkeit bei der Polizei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "941bd69d-819b-4473-a903-51838462f804",
                                "sense_id": "8558b7bb-20d1-39ce-b2ab-54fd641f6118",
                                "text": "„Sir, bitte nehmen Sie zur Kenntnis, dass ich zum nächstmöglichen Zeitpunkt aus dem Polizeidienst ausscheiden werde.“"
                            },
                            {
                                "example_id": "c86fdc49-1b9a-44cb-9dfc-9ce78b07f6f4",
                                "sense_id": "8558b7bb-20d1-39ce-b2ab-54fd641f6118",
                                "text": "„Er hatte zu viele Jahre im Polizeidienst hinter sich, um noch an die soziologische Lüge zu glauben.“"
                            },
                            {
                                "example_id": "a93e7a94-fdcb-4a91-9654-4b0b33992a52",
                                "sense_id": "8558b7bb-20d1-39ce-b2ab-54fd641f6118",
                                "text": "„Daneben sah er sich Tests für Autofahrer im Polizeidienst an und auch die gerichtspsychologische Arbeit.“"
                            },
                            {
                                "example_id": "4f89b29a-8fa9-48c3-901d-c9978c32a0a7",
                                "sense_id": "8558b7bb-20d1-39ce-b2ab-54fd641f6118",
                                "text": "„Der Graukopf Corbin mit den herrlich schiefen Zähnen ist das Produkt von zwanzig Jahren Morddezernat und fünfzehn Jahren Polizeidienst.“"
                            },
                            {
                                "example_id": "f9c59594-6dc5-47bc-9578-6d189dbcbdc2",
                                "sense_id": "8558b7bb-20d1-39ce-b2ab-54fd641f6118",
                                "text": "„Kommissar Malangi verkörpert nicht unbedingt die Sicherheit eines Mannes, der seit sechsunddreißig Jahren im Polizeidienst ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
