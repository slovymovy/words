        "nl-extract.jsonl": [
            {
                "entry_id": "b0fb5e49-d3ee-313e-8931-e4d993acd4c5",
                "word": "buiteling",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "67e86c19-81bb-4530-ba9b-a9119a45dcfc",
                        "entry_id": "b0fb5e49-d3ee-313e-8931-e4d993acd4c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "buitelingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce839a5f-6811-3efc-9be0-ee6d2cf0c51a",
                        "entry_id": "b0fb5e49-d3ee-313e-8931-e4d993acd4c5",
                        "glosses": [
                            "vallen en over de kop gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95683757-e4a7-4234-89e8-61c22164ead2",
                                "sense_id": "ce839a5f-6811-3efc-9be0-ee6d2cf0c51a",
                                "text": "Maar het broodnodige momentum werd verkwanseld met elke foutieve pass en nodeloze buiteling. Nee, Barcelona stak niet in grootse vorm, de gouden voetjes konden elkaar moeilijk vinden in de mêlee van PSG-withemden. Precisie ontbrak, Messi’s wil ontbrak. Na ruim een half uur amper gevaarlijk te zijn geweest dwong Andrés Iniesta met een desperate poging op de achterlijn vijf minuten voor rust ineens de 2-0 af. Een eigen goal was het van Layvin Kurzawa, frommelwerk dat zich moeilijk verhoudt met de grootsheid van Barça – maar niemand gaf daar wat om."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "027d0e42-05f3-498a-9634-b4f6b7e02557",
                        "source_entry_id": "b0fb5e49-d3ee-313e-8931-e4d993acd4c5",
                        "source_sense_id": "ce839a5f-6811-3efc-9be0-ee6d2cf0c51a",
                        "source_sense_description": "vallen en over de kop gaan",
                        "target_lang_word": "tumble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5c90c6f-2431-3476-999a-267369720df6",
                                        "entry_id": "001811b1-1d85-3c66-9364-71517b33e581",
                                        "glosses": [
                                            "A fall, especially end over end."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79f9df0b-4290-43fd-b5d6-bae63bb47684",
                                                "sense_id": "e5c90c6f-2431-3476-999a-267369720df6",
                                                "text": "I took a tumble down the stairs and broke my tooth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6315f115-fffa-3dcd-b2f8-8ba21ffbde86",
                                        "entry_id": "001811b1-1d85-3c66-9364-71517b33e581",
                                        "glosses": [
                                            "A disorderly heap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a759a382-14c4-47a5-a9c7-6978ded1a967",
                                                "sense_id": "6315f115-fffa-3dcd-b2f8-8ba21ffbde86",
                                                "text": "When at last we stopped in a tumble of bodies on the grass, laughing, and in Dad's case, out of breath, we were like little kids (I mean 5 or 6! After all I am 12!) at the end of a playground session."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a48102d2-be77-33ef-b4e2-1afe2db953a1",
                                        "entry_id": "001811b1-1d85-3c66-9364-71517b33e581",
                                        "glosses": [
                                            "An act of sexual intercourse."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "279fe2af-b71b-4376-a775-749054ad6fa7",
                                                "sense_id": "a48102d2-be77-33ef-b4e2-1afe2db953a1",
                                                "text": "Wouldn't it be jolly now, / To take our Aertex panters off / And have a jolly tumble in / The jolly, jolly sun?"
                                            },
                                            {
                                                "example_id": "7e3fa4ae-f838-4c32-9f76-963b1dbfbe9d",
                                                "sense_id": "a48102d2-be77-33ef-b4e2-1afe2db953a1",
                                                "text": "When you've just had a tumble between the sheets and are feeling rumpled and lazy, she may want to get up so she can make the bed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e46322-34ab-3fb5-a84d-e0a1263e6690",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To fall end over end; to roll over and over."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6d2158f-adce-4017-9f10-928c26472b86",
                                                "sense_id": "c8e46322-34ab-3fb5-a84d-e0a1263e6690",
                                                "text": "He who tumbles from a tower surely has a greater blow than he who slides from a molehill."
                                            },
                                            {
                                                "example_id": "c6b9366a-bd1f-4c9b-a9fd-4b6eb6fdcb72",
                                                "sense_id": "c8e46322-34ab-3fb5-a84d-e0a1263e6690",
                                                "text": "“Heavens!” exclaimed Nina, “the blue-stocking and the fogy!—and yours are pale blue, Eileen!—you’re about as self-conscious as Drina—slumping there with your hair tumbling à la Mérode! Oh, it's very picturesque, of course, but a straight spine and good grooming is better.[…]”"
                                            },
                                            {
                                                "example_id": "b11fa136-1264-4093-849f-e89d06743df2",
                                                "sense_id": "c8e46322-34ab-3fb5-a84d-e0a1263e6690",
                                                "text": "The two animals tumbled over each other in their eagerness to get inside, and heard the door shut behind them with great joy and relief."
                                            },
                                            {
                                                "example_id": "04311946-c1a6-4588-a333-ad0d06031ee4",
                                                "sense_id": "c8e46322-34ab-3fb5-a84d-e0a1263e6690",
                                                "text": "Before so many of Europe's crowns came tumbling off the heads of their royal owners, Continental Europe could show a rich variety in the matter of royal trains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d1cece5-9bda-352f-9740-5e505a0bc651",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To throw headlong."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5a4a452-dd60-4a4d-a9b2-054e369d1344",
                                                "sense_id": "0d1cece5-9bda-352f-9740-5e505a0bc651",
                                                "text": "His hand went after his revolver almost that instant mine did. I was a second too quick for him, for my shot tumbled him from his mule just as his ball whistled harmlessly past by my head."
                                            },
                                            {
                                                "example_id": "73392437-a8e2-4bca-b5ab-c19285327ad8",
                                                "sense_id": "0d1cece5-9bda-352f-9740-5e505a0bc651",
                                                "text": "[Spillikins] was played with ivory or bone pieces about five inches long with assorted ends. These were tumbled out of a box into a pile on the table and each player, using a specially designed tool, would try in turn to remove a spillikin without upsetting the others in the pile."
                                            },
                                            {
                                                "example_id": "7274287b-96ac-47f5-a1d3-92bfbe299fd7",
                                                "sense_id": "0d1cece5-9bda-352f-9740-5e505a0bc651",
                                                "text": "[A] surge of muddy water tore him free from his sandy nook and tumbled him down the gully."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff1370ba-2be1-32d6-a10d-5e5f28dde251",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To perform gymnastics such as somersaults, rolls, and handsprings."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ade9f80a-ef40-3fd3-bd0a-6daa783c4310",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To drop rapidly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a268231a-2662-4aa8-81f4-b76ad7daaad7",
                                                "sense_id": "ade9f80a-ef40-3fd3-bd0a-6daa783c4310",
                                                "text": "Share prices tumbled after the revelation about the company's impending failure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8988d259-90b3-31b2-aa09-65e43407e8a9",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To smooth and polish (e.g. gemstones or pebbles) by means of a rotating tumbler."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e651e17-1c0b-3bd6-809e-e18f30266ca7",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To have sexual intercourse."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90391eae-b1d8-3d6a-aafa-23f5d07d5225",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To move or rush in a headlong or uncontrolled way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df5fe8d9-5cf4-40d1-b1aa-a2406bddfa42",
                                                "sense_id": "90391eae-b1d8-3d6a-aafa-23f5d07d5225",
                                                "text": "Whether he ever thought of it at all, might be a question ; but, if he ever did chance to cast his mind that way after a comfortable dinner, no doubt, like a good sailor, he took it to be a sort of call of the watch to tumble aloft, and bestir themselves there, about something which he would find out when he obeyed the order, and not sooner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "601e1c1c-9002-3f2f-99e8-e9f9803c878b",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To muss, to make disorderly; to tousle or rumple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40cf34fe-0cd3-474e-9298-e1d2126f9fdd",
                                                "sense_id": "601e1c1c-9002-3f2f-99e8-e9f9803c878b",
                                                "text": "to tumble a bed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "411f474e-e664-375e-aaf2-a144f836dc15",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To obscure the audit trail of funds by means of a tumbler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ddd5d36-6c89-456d-97b4-12a41b9d32db",
                                                "sense_id": "411f474e-e664-375e-aaf2-a144f836dc15",
                                                "text": "Now it’s easy to purchase bitcoins on any number of mainstream markets and “tumble” them so that their point of purchase is obscured."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cf482de-24f6-3658-b082-be31edb355f9",
                                        "entry_id": "13d62cdc-4ccf-3d98-a7b7-b1a6ad582793",
                                        "glosses": [
                                            "To comprehend; often in tumble to."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c081c1b-01d1-4d48-8d70-3b13021e6d89",
                                                "sense_id": "6cf482de-24f6-3658-b082-be31edb355f9",
                                                "text": "Speaking of this language, a costermonger said to me: \"The Irish can't tumble to it anyhow; the Jews can tumble better, but we're their masters. Some of the young salesmen at Billingsgate understand us, — but only at Billingsgate; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
