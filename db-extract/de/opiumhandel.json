                ],
                "senses": [
                    {
                        "sense_id": "3b7a8007-037e-35a7-89e9-4c43e75be6e3",
                        "entry_id": "dfa62266-28fd-314e-b554-e91844a4c567",
                        "glosses": [
                            "Handel mit Opium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "908d124e-4f0f-45e6-a7f1-2c71097ee100",
                                "sense_id": "3b7a8007-037e-35a7-89e9-4c43e75be6e3",
                                "text": "„Mit Opium sind die Bewohner des heutigen Laos seit dem 18. Jahrhundert vertraut, als der Opiumhandel mit China begann und sich in Folge dessen die Drogensucht im Land ausbreitete.“"
                            },
                            {
                                "example_id": "355b77a4-5013-454a-acad-2f9ec50f26e8",
                                "sense_id": "3b7a8007-037e-35a7-89e9-4c43e75be6e3",
                                "text": "„Betätigungsfeld der Klipper war der Transport von Gütern, die schnell ans Ziel kommen mussten, etwa Tee, Wolle, Früchte und sogar Eis, sowie Post; auch beim gewinnträchtigen Sklaven- und Opiumhandel wurden sie eingesetzt.“"
                            },
                            {
                                "example_id": "7087fa11-f1ea-41d4-9ea5-e69ce418a673",
                                "sense_id": "3b7a8007-037e-35a7-89e9-4c43e75be6e3",
                                "text": "„Als China den Opiumhandel durch Kontrolle der Händler und Beschlagnahmung der Ware zu unterbinden begann, reagierte Großbritannien darauf mit der Entsendung von Kriegsschiffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
