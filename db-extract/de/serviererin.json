                "senses": [
                    {
                        "sense_id": "4fccb4f5-bd7a-399a-b935-0a60f1e723e9",
                        "entry_id": "6f19969e-368c-3d4d-a3e1-308cc00db3be",
                        "glosses": [
                            "Angestellte in der Gastronomie, deren Aufgabe die Bedienung der Gäste ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16d0f1b3-efea-4a20-ad40-3389e7bab819",
                                "sense_id": "4fccb4f5-bd7a-399a-b935-0a60f1e723e9",
                                "text": "„Sie war Serviererin in einem Nachtlokal, dort waren wir uns auch näher gekommen, teuer war mir das gekommen, jede Nacht die Zeche für Barbara und mich.“"
                            },
                            {
                                "example_id": "7c8e892e-e4e2-4ff2-b8a4-0d833a95d4ab",
                                "sense_id": "4fccb4f5-bd7a-399a-b935-0a60f1e723e9",
                                "text": "„Die in der Gastwirtschaft tätig gewesene Serviererin AS gab zu Protokoll, dass der ihr bekannte Beschuldigte stark alkoholisiert gewesen wäre.“"
                            },
                            {
                                "example_id": "a782c4ec-d2af-4999-bc2b-8a76bbc068eb",
                                "sense_id": "4fccb4f5-bd7a-399a-b935-0a60f1e723e9",
                                "text": "„In nicht weniger als 1.238 Folgen gab sie die Serviererin »Frau Anni«, zuerst als Partnerin von Alfred Böhm, der den Ober spielte, dann von Rudolf Buczolich.“"
                            },
                            {
                                "example_id": "1b17d241-651b-40e4-be28-fad1bb5e0289",
                                "sense_id": "4fccb4f5-bd7a-399a-b935-0a60f1e723e9",
                                "text": "„Die Serviererin kam und bot mir mehr Kuchen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
