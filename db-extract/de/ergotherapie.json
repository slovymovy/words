                "senses": [
                    {
                        "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                        "entry_id": "57cbea12-80fc-32ea-aa6e-bcdb73313be7",
                        "glosses": [
                            "Therapieform, die sich mit der Ausführung konkreter Betätigungen und deren Auswirkungen auf den Menschen und seiner Umwelt befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f80db1-6bdc-4bd0-bda6-1a93c29cff38",
                                "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                                "text": "„Ein Kind, das nicht bastelt oder keine Bilder malt, kommt zur Ergotherapie, wer stottert, wird zum Logopäden geschickt.“"
                            },
                            {
                                "example_id": "724b9ebe-7788-4336-9f95-a5e8b2e014c3",
                                "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                                "text": "„Die Ergotherapie unterstützt den Patienten in der Bewältigung seines Alltags.“"
                            },
                            {
                                "example_id": "84918391-4f7e-4787-a0fc-5fd1703c6b19",
                                "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                                "text": "Eine Kombination aus Ergo-, Physio- und Sporttherapie hat mich nach meinem Unfall wieder fit für den Beruf gemacht."
                            },
                            {
                                "example_id": "b80a581b-d9e8-4631-9851-e2c0c62ccde5",
                                "sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                                "text": "„Nach der Ergotherapie durfte ich einen neuropsychologischen Test machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c212aa1f-441f-4f72-af1b-6c9cf8744ed5",
                        "source_entry_id": "57cbea12-80fc-32ea-aa6e-bcdb73313be7",
                        "source_sense_id": "2c152a03-723d-3be5-bbe2-2976ab32d8f9",
                        "source_sense_description": "Therapieform, die sich mit der Ausführung konkreter Betätigungen und deren Auswirkungen auf den Menschen und seiner Umwelt befasst",
                        "target_lang_word": "ergothérapie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ergothérapie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e050e34-4cd7-3827-8981-f0189fe6bd8b",
                                        "entry_id": "40a47b96-78c3-3552-a89f-2f604ca9cf49",
                                        "glosses": [
                                            "Traitement utilisant le travail manuel pour guérir une personne malade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eb8442c-184a-4568-a60e-195ef08c3581",
                                                "sense_id": "8e050e34-4cd7-3827-8981-f0189fe6bd8b",
                                                "text": "L'ergothérapie a un rôle prépondérant tout au long du processus de rééducation, de réadaptation et de réinsertion des personnes en situation de handicap physique ou psychique."
                                            },
                                            {
                                                "example_id": "cb7da6bd-31e8-456a-86f1-713b9fc6d0c6",
                                                "sense_id": "8e050e34-4cd7-3827-8981-f0189fe6bd8b",
                                                "text": "Dans les années 1970 où se situent les prises en charge d’ergothérapie que nous allons raconter, la profession était souvent qualifiée de « bricolothérapie »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
