                "senses": [
                    {
                        "sense_id": "15ddb5ba-f864-3de9-a288-d691f003af08",
                        "entry_id": "c2f34a70-d56a-3fb1-b9a6-5d510603454d",
                        "glosses": [
                            "wahrnehmbarer Geruch nach Zwiebeln in der Umgebungsluft, an sich selbst oder direkt an Zwiebeln; durch das Geruchsorgan wahrgenommene Ausdünstung"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "86822090-df80-4d49-9b3e-c093d1a68d05",
                                "sense_id": "15ddb5ba-f864-3de9-a288-d691f003af08",
                                "text": "„Bekannt ist das den charakterischen Knoblauch- und Zwiebelgeruch hervorrufende Diallyldisulfid.“"
                            },
                            {
                                "example_id": "8e2ad007-378d-4e97-953e-2880b1be732e",
                                "sense_id": "15ddb5ba-f864-3de9-a288-d691f003af08",
                                "text": "„Der Zwiebelgeruch soll weiter reduziert werden.“"
                            },
                            {
                                "example_id": "7a5ed15e-0f2f-418c-8163-3850d588daf0",
                                "sense_id": "15ddb5ba-f864-3de9-a288-d691f003af08",
                                "text": "„Mit Beginn der Kampagne der Zwiebeltrocknungsanlage in Alteglofsheim sind wieder Beschwerden der Bürgerinitiative über den Zwiebelgeruch rund um die Anlage aufgetreten.“"
                            },
                            {
                                "example_id": "7b7a9358-8b61-4dc5-ae00-57f71593ba7f",
                                "sense_id": "15ddb5ba-f864-3de9-a288-d691f003af08",
                                "text": "„Donnerstagmittag gerieten sie an der Wohnungstüre wegen des angeblich penetranten Zwiebelgeruchs derart in Streit, dass der 70-Jährige unvermittelt ein Küchenmesser zog und wie von Sinnen auf seinen Kontrahenten einstach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
