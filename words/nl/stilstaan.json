                {
                    "sense_id": "ab30fffe-762c-3fc1-9d36-95a12172ab01",
                    "sense_definition": "Zich niet verder ontwikkelen; op hetzelfde niveau blijven zonder vooruitgang.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je stopt met leren, zal je persoonlijke ontwikkeling <w>stilstaan</w>.",
                            "target_lang_translations": {
                                "ru": "Если ты перестанешь учиться, твое личное развитие <w>остановится</w>.",
                                "en": "If you stop learning, your personal development will <w>stagnate</w>.",
                                "pl": "Jeśli przestaniesz się uczyć, twój rozwój osobisty <w>stanie w miejscu</w>.",
                                "de": "Wenn du aufhörst zu lernen, wird deine persönliche Entwicklung <w>stillstehen</w>.",
                                "fr": "Si tu arrêtes d'apprendre, ton développement personnel va <w>stagner</w>.",
                                "it": "Se smetti di imparare, il tuo sviluppo personale <w>ristagnerà</w>.",
                                "cs": "Pokud přestaneš studovat, tvůj osobní rozvoj bude <w>stát na místě</w>.",
                                "tr": "Öğrenmeyi bırakırsan, kişisel gelişimin <w>duraklayacaktır</w>.",
                                "es": "Si dejas de aprender, tu desarrollo personal se <w>estancará</w>.",
                                "zh": "如果你停止学习，你的个人发展就会<w>停滞</w>。"
                            }
                        },
                        {
                            "text": "Het lijkt in dit oude dorpje alsof de tijd heeft <w>stilgestaan</w>.",
                            "target_lang_translations": {
                                "ru": "В этой старой деревушке кажется, будто время <w>остановилось</w>.",
                                "en": "In this old village, it seems as if time has <w>stood still</w>.",
                                "pl": "W tej starej wiosce wydaje się, jakby czas <w>zatrzymał się</w> w miejscu.",
                                "de": "In diesem alten Dorf scheint es, als ob die Zeit <w>stillgestanden</w> hätte.",
                                "fr": "Dans ce vieux village, on dirait que le temps s'est <w>arrêté</w>.",
                                "it": "In questo vecchio villaggio sembra che il tempo si sia <w>fermato</w>.",
                                "cs": "V téhle staré vesničce to vypadá, jako by se <w>zastavil</w> čas.",
                                "tr": "Bu eski köyde sanki zaman <w>durmuş</w> gibi.",
                                "es": "En este pueblo antiguo parece como si el tiempo se hubiera <w>detenido</w>.",
                                "zh": "在这个古老的小村庄里，时间仿佛<w>停滞</w>了。"
                            }
                        }
