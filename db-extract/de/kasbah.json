                "senses": [
                    {
                        "sense_id": "f0da1e55-4afa-343a-a25c-3235d4e2c2a3",
                        "entry_id": "65b8bb2c-a327-3ee1-81ea-9f78d2a6f44a",
                        "glosses": [
                            "Schloss oder Burg in arabischen Städten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efdc7d6f-b119-4e23-b5e0-b95aee41a04e",
                                "sense_id": "f0da1e55-4afa-343a-a25c-3235d4e2c2a3",
                                "text": "Durch stattliche Tore gelangt man in die Altstadt, wo sich die Kasbah, die ursprüngliche Festung, Mellah, das jüdische Viertel, und die Medina, das eigentliche Zentrum mit den Souks, befinden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b3531fe1-c8c2-3be7-9d31-7893ad494d8d",
                        "entry_id": "65b8bb2c-a327-3ee1-81ea-9f78d2a6f44a",
                        "glosses": [
                            "Altstadt oder arabisches Viertel in Städten Nordafrikas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9beaaba-ea0f-4eb9-997f-8225fd4b5623",
                                "sense_id": "b3531fe1-c8c2-3be7-9d31-7893ad494d8d",
                                "text": "Bis 1962 okkupierten die Franzosen die Metropole, die erst ab dem Ende des 19. Jahrhunderts über die Mauern, die die Kasbah mit der Zitadelle umschlossen, hinauswuchs. Die meisten Gebäude der Kasbah stammen aus osmanischer Zeit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
