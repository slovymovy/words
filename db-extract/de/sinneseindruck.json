                ],
                "senses": [
                    {
                        "sense_id": "93d20d5f-7e81-30cb-8a00-c27d9bb36e76",
                        "entry_id": "0f6f31d9-c25b-31a4-8b3c-e5c3df7ee7cd",
                        "glosses": [
                            "Aufnahme eines Faktums der Außenwelt in das eigene Bewusstsein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e19abd9f-a770-424b-bb08-5e360dee4e53",
                                "sense_id": "93d20d5f-7e81-30cb-8a00-c27d9bb36e76",
                                "text": "„Im Traum erzeugt das offenbar widersprüchliche Sinneseindrücke (Luft, die durch geschlossene Backen strömt) und signalisiert so ebenfalls, dass man schläft.“"
                            },
                            {
                                "example_id": "cb921e2c-627a-463d-a35f-af76faf4e088",
                                "sense_id": "93d20d5f-7e81-30cb-8a00-c27d9bb36e76",
                                "text": "„Die älteren Theorien hatten, wie Stern darlegt, den Anfang des kindlichen Seelenlebens im Empfangen von Sinneseindrücken und im Verknüpfen der Empfindungen und ihrer Nachwirkungen zu Vorstellungskomplexen gesehen, die auf Grund des Assoziationsmechanismus möglich wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
