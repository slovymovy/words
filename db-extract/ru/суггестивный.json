                ],
                "senses": [
                    {
                        "sense_id": "1b0dacdc-d3ce-3972-94b1-2f1e5d6180ad",
                        "entry_id": "16765756-b5f3-3532-bd0a-0f811a209869",
                        "glosses": [
                            "воздействующий на чьи-либо мысли, подсознание или поведение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3a484bb-5506-4438-8f06-816559aab009",
                                "sense_id": "1b0dacdc-d3ce-3972-94b1-2f1e5d6180ad",
                                "text": "А между тем этот странный бас и впрямь обладает какой-то магией, таинственной суггестивной силой."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfae3a67-a0f0-3b49-ad0a-99134b3b3a9f",
                        "entry_id": "16765756-b5f3-3532-bd0a-0f811a209869",
                        "glosses": [
                            "психол. основанный на внушении, гипнозе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b476eedc-7b1c-4a7e-a249-a2748a2cf75c",
                                "sense_id": "dfae3a67-a0f0-3b49-ad0a-99134b3b3a9f",
                                "text": "Разработанный нами новый способ психологического (психотерапевтического) лечения табачной зависимости ― «двойное кодирование» ― основан на принципе выработки у пациента отрицательного условного рефлекса на табак с помощью группового суггестивного воздействия и механического раздражения точек Валле."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e7f524a-50ce-4c74-b961-8578e6128253",
                        "source_entry_id": "16765756-b5f3-3532-bd0a-0f811a209869",
                        "target_lang_word": "suggestive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suggestive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba266cb6-f03f-3e3e-a4b2-f1d4a6312271",
                                        "entry_id": "f85350d3-bdab-3bc7-9e72-3522acf632ed",
                                        "glosses": [
                                            "Tending to suggest or imply."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f6a0ba-254a-403b-b226-f9ef339bf065",
                                                "sense_id": "ba266cb6-f03f-3e3e-a4b2-f1d4a6312271",
                                                "text": "The painting is abstract, but the colors are suggestive of fruit or the Mediterranean."
                                            },
                                            {
                                                "example_id": "5edcc428-b40e-4d73-adf7-8a726d17bf71",
                                                "sense_id": "ba266cb6-f03f-3e3e-a4b2-f1d4a6312271",
                                                "text": "But Sophia's mother was not the woman to brook defiance. After a few moments' vain remonstrance her husband complied. His manner and appearance were suggestive of a satiated sea-lion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1a27af5-f776-36b4-9bd1-b75eda2392df",
                                        "entry_id": "f85350d3-bdab-3bc7-9e72-3522acf632ed",
                                        "glosses": [
                                            "Suggesting romance, sex, etc.; risqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4025fe7d-3b79-4fa8-ad51-7541ac181f1f",
                                                "sense_id": "c1a27af5-f776-36b4-9bd1-b75eda2392df",
                                                "text": "She crossed her legs and shot him a suggestive smile."
                                            },
                                            {
                                                "example_id": "81b1b8f0-5715-4087-bd2e-aa26d0ff37c7",
                                                "sense_id": "c1a27af5-f776-36b4-9bd1-b75eda2392df",
                                                "text": "Girls read fashion and celebrity magazines at younger and younger ages and look for the same kinds of sexy, suggestive clothing worn by the models."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5ae212c-48e1-3818-bd20-2e3e1ad3d668",
                                        "entry_id": "f85350d3-bdab-3bc7-9e72-3522acf632ed",
                                        "glosses": [
                                            "Relating to hypnotic suggestion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
