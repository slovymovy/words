                                    {
                                        "sense_id": "3faca7f0-f7fe-30ac-9a90-1cdaf9c89331",
                                        "entry_id": "32329d60-8048-317e-a170-4e5aac83228f",
                                        "glosses": [
                                            "A fighter or participant in the medieval Crusades."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "881bcc0e-9354-419d-9941-bca20031a69d",
                                                "sense_id": "3faca7f0-f7fe-30ac-9a90-1cdaf9c89331",
                                                "text": "Tony's face expressed relief, and Nettie sat silent for a moment until the vicar said “It was a generous impulse, but it may have been a momentary one, while in the case of monk and crusader there must have been a sustaining purpose, and possibly a great abnegation, a leaving of lands and possessions.”"
                                            },
                                            {
                                                "example_id": "cf95b000-4c35-4bce-b275-6ed023e02fe4",
                                                "sense_id": "3faca7f0-f7fe-30ac-9a90-1cdaf9c89331",
                                                "text": "the crusaders of the Middle Ages"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "191413d3-055d-3ffd-9ca9-699f718f2e50",
                                        "entry_id": "32329d60-8048-317e-a170-4e5aac83228f",
                                        "glosses": [
                                            "A person engaged in a crusade."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4545f801-efa4-30e3-9219-7b5869f72179",
                                        "entry_id": "32329d60-8048-317e-a170-4e5aac83228f",
                                        "glosses": [
                                            "An American, especially a soldier or leader who wages war against Islamist militants."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b281bb8-f735-471c-b65e-902351bce703",
                                                "sense_id": "4545f801-efa4-30e3-9219-7b5869f72179",
                                                "text": "1998, Osama Bin Ladenhttps://irp.fas.org/world/para/docs/980223-fatwa.htm\nSecond, despite the great devastation inflicted on the Iraqi people by the crusader-Zionist alliance, and despite the huge number of those killed, which has exceeded 1 million... despite all this, the Americans are once against trying to repeat the horrific massacres, as though they are not content with the protracted blockade imposed after the ferocious war or the fragmentation and devastation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16c051de-d88a-3114-a2d7-3297607734b8",
                                        "entry_id": "32329d60-8048-317e-a170-4e5aac83228f",
                                        "glosses": [
                                            "A Westerner; a Christian, especially of European descent or a missionary."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slur"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac692de0-7808-30b4-bb2a-91263c8f1679",
                                        "entry_id": "32329d60-8048-317e-a170-4e5aac83228f",
                                        "glosses": [
                                            "(either attributively or in the plural) The United States and its Western allies."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a813776e-484d-4c48-aa36-1b2c1d178abf",
                        "source_entry_id": "ea6dd9b9-dd03-38e7-9241-830bcca06b4a",
                        "target_lang_word": "Kreuzritter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreuzritter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03d2dce1-2cc6-3ad4-9534-0f49d963b0dc",
                                        "entry_id": "7e864c37-7f5f-33dc-a920-41f2ede130d9",
                                        "glosses": [
                                            "adliger Teilnehmer eines Kreuzzuges im Mittelalter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0ecabbe-0c4a-4cad-bf9c-137f8dd89785",
                                                "sense_id": "03d2dce1-2cc6-3ad4-9534-0f49d963b0dc",
                                                "text": "„Leonhard Reichartinger […] war ein Kreuzritter aus bayrischem Adel.“"
                                            },
                                            {
                                                "example_id": "dc686d24-95a4-45dd-8cf9-cfe912eece6c",
                                                "sense_id": "03d2dce1-2cc6-3ad4-9534-0f49d963b0dc",
                                                "text": "„Vier Jahre später trafen die Kreuzritter in der Region ein und siedelten sich im Kulmer Gebiet an, das ihnen von Konrad zugeteilt worden war.“"
                                            },
                                            {
                                                "example_id": "e1796191-fe3d-428a-9897-670df690ad80",
                                                "sense_id": "03d2dce1-2cc6-3ad4-9534-0f49d963b0dc",
                                                "text": "„Die Neuordnung des Nahen Ostens durch die Kreuzritter wurde von den umliegenden arabischen Staaten wie dem Emirat von Syrien, dem Kalifat von Kairo - und damit wären wir in Afrika - und nicht zuletzt vom Sultanat der Seldschuken kritisch beäugt.“"
                                            },
                                            {
                                                "example_id": "5646feee-5a30-4b44-8142-89f67f22551c",
                                                "sense_id": "03d2dce1-2cc6-3ad4-9534-0f49d963b0dc",
                                                "text": "„Schon nach den Niederlagen der Kreuzritter gegen die Muslime hatten Kaufleute versucht, neue Handelsrouten zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
