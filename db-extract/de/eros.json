        "de-extract.jsonl": [
            {
                "entry_id": "8020d2fc-0ca1-39c2-84c8-017e733a568d",
                "word": "Eros",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "6cc19a0f-d37b-4225-9412-a3f81b990fe6",
                        "entry_id": "8020d2fc-0ca1-39c2-84c8-017e733a568d",
