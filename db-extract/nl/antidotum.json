                                "example_id": "df8a399d-02ac-4ff4-a74b-d11c651744be",
                                "sense_id": "b87aef3b-48c1-3af2-96cb-a017ae032921",
                                "text": "Bestaat hier een antidotum voor?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "768c04e8-c861-4b0a-a48d-dad3ac9eb213",
