{
    "word_family": [
        "sectional",
        "sectioning",
        "dissection",
        "intersection",
        "subsection",
        "venesection"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46283e46-5d8b-394e-b97c-dcc9b5db522b",
                    "sense_definition": "A distinct part, piece, or subdivision of something larger.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fruit is divided into several small <w>sections</w> that are easy to peel apart.",
                            "target_lang_translations": {
                                "ru": "Плод разделен на несколько маленьких <w>долек</w>, которые легко отделяются друг от друга."
                            }
                        },
                        {
                            "text": "A broad <w>section</w> of the population expressed their support for the new environmental policy.",
                            "target_lang_translations": {
                                "ru": "Широкие <w>слои</w> населения выразили поддержку новой экологической политике."
                            }
                        }
                    ],
                    "synonyms": [
                        "part",
                        "piece",
                        "division",
                        "slice",
                        "snippet"
                    ],
                    "antonyms": [
                        "whole"
                    ],
                    "common_phrases": [
                        "broad section",
                        "small section",
                        "cross section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обособленная часть, кусок или подразделение чего-то целого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "секция",
                                "target_lang_sense_clarification": "часть конструкции или здания"
                            },
                            {
                                "target_lang_word": "часть",
                                "target_lang_sense_clarification": "общий термин для доли целого"
                            },
                            {
                                "target_lang_word": "слой",
                                "target_lang_sense_clarification": "группа населения или общества"
                            },
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "часть фрукта или сегмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e756d9d0-573b-3da6-a884-1b6658c64071",
                    "sense_definition": "A specific part of a document, book, or legal text, often marked with a number or symbol.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "document_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please refer to <w>section</w> four of the contract for details regarding the payment schedule.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, обратитесь к <w>разделу</w> четыре контракта для получения подробной информации о графике платежей."
                            }
                        },
                        {
                            "text": "The last <w>section</w> of the report contains all the necessary data and charts.",
                            "target_lang_translations": {
                                "ru": "Последняя <w>часть</w> отчета содержит все необходимые данные и диаграммы."
                            }
                        }
                    ],
                    "synonyms": [
                        "part",
                        "division"
                    ],
                    "common_phrases": [
                        "next section",
                        "final section",
                        "legal section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная часть документа, книги или юридического текста, часто обозначенная номером или символом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздел",
                                "target_lang_sense_clarification": "крупная часть документа или книги"
                            },
                            {
                                "target_lang_word": "статья",
                                "target_lang_sense_clarification": "пункт закона или договора"
                            },
                            {
                                "target_lang_word": "параграф",
                                "target_lang_sense_clarification": "небольшой подраздел текста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70ce921f-98d5-3f33-9de3-10e3a73047ba",
                    "sense_definition": "A group of instruments or musicians within an orchestra or band.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brass <w>section</w> played very loudly during the final part of the symphony.",
                            "target_lang_translations": {
                                "ru": "Группа медных <w>духовых</w> играла очень громко в финальной части симфонии."
                            }
                        },
                        {
                            "text": "The conductor asked the rhythm <w>section</w> to keep a steady beat throughout the song.",
                            "target_lang_translations": {
                                "ru": "Дирижер попросил ритм-<w>секцию</w> держать ровный темп на протяжении всей песни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brass section",
                        "rhythm section",
                        "string section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа инструментов или музыкантов в оркестре или группе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "семейство инструментов, например, духовые"
                            },
                            {
                                "target_lang_word": "секция",
                                "target_lang_sense_clarification": "музыкальное подразделение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "163d6ca4-c537-30bf-90e7-a7e626ff8f23",
                    "sense_definition": "A piece or part that has been cut out from a larger object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist examined a thin <w>section</w> of the leaf under a powerful microscope.",
                            "target_lang_translations": {
                                "ru": "Ученый исследовал тонкий <w>срез</w> листа под мощным микроскопом."
                            }
                        },
                        {
                            "text": "He removed a small <w>section</w> of the damaged pipe to replace it with a new one.",
                            "target_lang_translations": {
                                "ru": "Он удалил небольшой <w>отрезок</w> поврежденной трубы, чтобы заменить его новым."
                            }
                        }
                    ],
                    "synonyms": [
                        "cutting",
                        "slice"
                    ],
                    "common_phrases": [
                        "thin section",
                        "cut section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кусок или часть, вырезанная из более крупного объекта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срез",
                                "target_lang_sense_clarification": "тонкая пластинка для микроскопа"
                            },
                            {
                                "target_lang_word": "сечение",
                                "target_lang_sense_clarification": "вид предмета в разрезе"
                            },
                            {
                                "target_lang_word": "отрезок",
                                "target_lang_sense_clarification": "часть трубы или линии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "029ec2b2-9834-3c23-a0b9-376dbc3c3790",
                    "sense_definition": "A small military unit, typically consisting of ten to fifteen soldiers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "military_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The infantry <w>section</w> moved quietly through the forest to avoid detection by the enemy.",
                            "target_lang_translations": {
                                "ru": "Пехотное <w>отделение</w> тихо двигалось через лес, чтобы избежать обнаружения противником."
                            }
                        },
                        {
                            "text": "Each <w>section</w> is led by a non-commissioned officer who reports to the platoon leader.",
                            "target_lang_translations": {
                                "ru": "Каждым <w>отделением</w> командует сержантский состав, который подчиняется командиру взвода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "infantry section",
                        "rifle section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое военное подразделение, обычно состоящее из десяти-пятнадцати солдат."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделение",
                                "target_lang_sense_clarification": "низшее воинское подразделение"
                            },
                            {
                                "target_lang_word": "секция",
                                "target_lang_sense_clarification": "в некоторых армиях — подразделение взвода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26988f7c-7e3c-3596-afff-edf9d5c4f67c",
                    "sense_definition": "A surgical incision, or a short way of referring to a Caesarean <w>section</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby was delivered by emergency <w>section</w> after complications arose during labor.",
                            "target_lang_translations": {
                                "ru": "Ребенок родился путем экстренного кесарева <w>сечения</w> после осложнений во время родов."
                            }
                        },
                        {
                            "text": "The surgeon carefully closed the <w>section</w> scar after the successful operation.",
                            "target_lang_translations": {
                                "ru": "Хирург осторожно зашил шрам от <w>разреза</w> после успешной операции."
                            }
                        }
                    ],
                    "synonyms": [
                        "sectio"
                    ],
                    "common_phrases": [
                        "emergency section",
                        "caesarean section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хирургический разрез или сокращенное название кесарева сечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сечение",
                                "target_lang_sense_clarification": "как в термине 'кесарево сечение'"
                            },
                            {
                                "target_lang_word": "разрез",
                                "target_lang_sense_clarification": "хирургический надрез"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86239226-a336-3d99-abb1-40205f5a32af",
                    "sense_definition": "A unit of land area equal to one <w>square mile</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "land_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer owns a full <w>section</w> of land in the northern part of the province.",
                            "target_lang_translations": {
                                "ru": "Фермер владеет целой <w>секцией</w> земли в северной части провинции."
                            }
                        },
                        {
                            "text": "The map shows how the territory was divided into <w>sections</w> for the new settlers.",
                            "target_lang_translations": {
                                "ru": "На карте показано, как территория была разделена на <w>участки</w> для новых поселенцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "square mile"
                    ],
                    "common_phrases": [
                        "land section"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица площади земли, равная одной квадратной миле (в Северной Америке)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "секция",
                                "target_lang_sense_clarification": "участок земли в одну кв. милю"
                            },
                            {
                                "target_lang_word": "участок",
                                "target_lang_sense_clarification": "общий термин для земли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "26226327-c48e-326f-ab2d-ecaa097cb1d6",
                    "sense_definition": "To divide, cut, or separate something into distinct parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divide_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef will <w>section</w> the grapefruit before serving it for breakfast.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар <w>разделит</w> грейпфрут на дольки перед подачей на завтрак."
                            }
                        },
                        {
                            "text": "We need to <w>section</w> off the construction area to keep the public safe.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>отгородить</w> зону строительства, чтобы обеспечить безопасность граждан."
                            }
                        }
                    ],
                    "common_phrases": [
                        "section off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять, разрезать или отделять что-либо на отдельные части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделять",
                                "target_lang_sense_clarification": "делить на части"
                            },
                            {
                                "target_lang_word": "разрезать",
                                "target_lang_sense_clarification": "делить с помощью ножа"
                            },
                            {
                                "target_lang_word": "отгораживать",
                                "target_lang_sense_clarification": "отделять зону (section off)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2be2f9c0-ad64-341c-a7d7-15b7d120a781",
                    "sense_definition": "To compulsorily commit someone to a psychiatric hospital for treatment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_medical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctors decided to <w>section</w> the patient for her own safety after the incident.",
                            "target_lang_translations": {
                                "ru": "Врачи решили принудительно <w>госпитализировать</w> пациентку ради ее собственной безопасности после инцидента."
                            }
                        },
                        {
                            "text": "He was <w>sectioned</w> under the Mental Health Act following a severe breakdown.",
                            "target_lang_translations": {
                                "ru": "Его <w>поместили</w> в психиатрическую клинику согласно Закону о психическом здоровье после тяжелого срыва."
                            }
                        }
                    ],
                    "common_phrases": [
                        "be sectioned"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Принудительно поместить кого-либо в психиатрическую больницу для лечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "госпитализировать",
                                "target_lang_sense_clarification": "в принудительном порядке"
                            },
                            {
                                "target_lang_word": "упечь в психушку",
                                "target_lang_sense_clarification": "разговорный вариант"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b6c8292-4183-3171-afd5-77533c6586d8",
                    "sense_definition": "To perform a Caesarean section on a person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medical team had to <w>section</w> her immediately when the baby's heart rate dropped.",
                            "target_lang_translations": {
                                "ru": "Медицинской бригаде пришлось немедленно <w>сделать</w> ей кесарево, когда у ребенка упал пульс."
                            }
                        },
                        {
                            "text": "The surgeon explained why it might be necessary to <w>section</w> the mother during delivery.",
                            "target_lang_translations": {
                                "ru": "Хирург объяснил, почему может потребоваться <w>прооперировать</w> мать во время родов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Провести операцию кесарева сечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать кесарево",
                                "target_lang_sense_clarification": "проводить операцию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}