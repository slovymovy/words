    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3db910c2-3528-3523-a8bb-af4e3c838bd6",
                "word": "wampum",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "997a6501-372b-47a6-a296-281f7d2d4a00",
                        "entry_id": "3db910c2-3528-3523-a8bb-af4e3c838bd6",
                        "tags": [
                            "plural"
                        ],
                        "form": "wampums"
                    },
                    {
                        "form_id": "cc8debe6-3c79-40f9-96e4-d6aa5330cd4c",
                        "entry_id": "3db910c2-3528-3523-a8bb-af4e3c838bd6",
                        "tags": [
                            "plural"
                        ],
                        "form": "wampum"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0d715f4-5d02-3cfa-9dc4-e071cec6c55c",
                        "entry_id": "3db910c2-3528-3523-a8bb-af4e3c838bd6",
                        "glosses": [
                            "Small cylindrical beads made from polished shells (especially white ones) which have been strung together, formerly used by Native American peoples of eastern North America for various purposes including as jewellery and money, and for record-keeping; (countable, archaic) one such bead."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "09048eac-e804-4118-a7f9-1dd9f1aa196e",
                                "sense_id": "a0d715f4-5d02-3cfa-9dc4-e071cec6c55c",
                                "text": "[A]mong the Red Men of America the giving of the white belt of wampum was the deepest pledge of honor; […]"
                            },
                            {
                                "example_id": "2f7307db-8734-4bee-b592-0ca33e6b1b26",
                                "sense_id": "a0d715f4-5d02-3cfa-9dc4-e071cec6c55c",
                                "text": "From his lodge went Hiawatha, / Dressed for travel, armed for hunting; / Dressed in deer-skin shirt and leggings, / Richly wrought with quills and wampum; / On his head his eagle-feathers, / Round his waist his belt of wampum, […]"
                            },
                            {
                                "example_id": "25b7ceae-6861-4efd-bcc6-ea7c0d87ef8e",
                                "sense_id": "a0d715f4-5d02-3cfa-9dc4-e071cec6c55c",
                                "text": "These title deeds are of wampum, the grant of an Indian chief to the first Dowell, who left Farnham in Surrey in company with William Penn."
                            }
                        ]
                    },
                    {
                        "sense_id": "a26552b6-0731-3ca9-bbc6-1b1e71c21923",
                        "entry_id": "3db910c2-3528-3523-a8bb-af4e3c838bd6",
                        "glosses": [
                            "Money."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d1ca81b6-e628-4e11-9923-97112f35957b",
                                "sense_id": "a26552b6-0731-3ca9-bbc6-1b1e71c21923",
                                "text": "[Kenneth O'Keefe, letter] Have that seven quid. Or else I'll be kaput. […] [Sebastian Dangerfield, letter in reply] Kenneth, we all want wampum. And as you must know, if only I had some I would be only too willing to share. But the only thing I have here is a pile of business magazines which I am going to burn for a fire."
                            },
                            {
                                "example_id": "f60a8eb9-2320-46a4-88b7-788f271fd516",
                                "sense_id": "a26552b6-0731-3ca9-bbc6-1b1e71c21923",
                                "text": "[M]ore and more people in the folk world suddenly discovered there was more than a little wampum to be made by discovering a trace of Indian blood in their past and donning the traditional headband."
                            }
                        ]
                    },
                    {
                        "sense_id": "19c71766-ab16-39dd-9fc4-7082a21f3df5",
                        "entry_id": "3db910c2-3528-3523-a8bb-af4e3c838bd6",
                        "glosses": [
                            "Ellipsis of wampum snake (“the common kingsnake or eastern kingsnake (Lampropeltis getula)”)."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "countable",
                            "ellipsis",
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
