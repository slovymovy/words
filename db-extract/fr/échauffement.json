                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rozcvička",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "a8247c73-1f6d-399b-bcaf-b1a704ba57cf",
                                        "entry_id": "8f06d124-9704-305d-91d1-e6682e5f4974",
                                        "glosses": [
                                            "tělesné cvičení zaměřené na protáhnutí rozhýbaní a zahřátí těla"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c0ef0e1-2a54-4bd9-90a4-67f9e0307eff",
                                                "sense_id": "a8247c73-1f6d-399b-bcaf-b1a704ba57cf",
                                                "text": "Rozcvička po ránu rozhýbala ztuhlé svaly, a už se zase řádilo, soutěžilo a hlavně tancovalo."
                                            },
                                            {
                                                "example_id": "fc91fe18-4472-4545-8226-ddfb9839b135",
                                                "sense_id": "a8247c73-1f6d-399b-bcaf-b1a704ba57cf",
                                                "text": "Každodenní rozcvičky nám neslouží jen pro dobrý pocit, ale jsou tou nejlepší službou právě pro svalstvo. Jeho protažením ho připravíte na další pohybové aktivity během dne."
                                            },
                                            {
                                                "example_id": "aaeb4630-92b8-48c0-a0bd-c687705f5934",
                                                "sense_id": "a8247c73-1f6d-399b-bcaf-b1a704ba57cf",
                                                "text": "Když jsem byl mladý, jezdil jsem na tábory, a tamní život měl hodně z vojenského drilu: ranní budíček, rozcvičky , hlídání tábora, nástupy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d50725-a9e0-3391-be75-f5559e287a95",
                                        "entry_id": "8f06d124-9704-305d-91d1-e6682e5f4974",
                                        "glosses": [
                                            "rozcvičení se v nějaké činnosti, aktivitě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cbb3759-c5e9-4cee-8a63-cf5d54217b93",
                                                "sense_id": "c5d50725-a9e0-3391-be75-f5559e287a95",
                                                "text": "„Vyjeli jsme se sypači zejména na hlavní tahy k hraničním přechodům,“ řekl včera dispečer Správy a údržby silnic Ústeckého kraje. „Byla to taková malá rozcvička na to , co na nás nyní čeká,“ poznamenal."
                                            },
                                            {
                                                "example_id": "5ac4d70e-a80d-444f-a8a1-dfcb4f7f6970",
                                                "sense_id": "c5d50725-a9e0-3391-be75-f5559e287a95",
                                                "text": "Autor zadání profesor Suchomel se k námětu ze světa zvířat neuchýlil poprvé. „Je to pro nové studenty dobrá rozcvička, zkusit vytvořit stavbu pro jiné tvory, než jsou lidé. Proto řadu let spolupracujeme s muzeem i zoologickou zahradou.“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89111cab-93b0-3442-afd4-ccc761ecbf17",
                                        "entry_id": "8f06d124-9704-305d-91d1-e6682e5f4974",
                                        "glosses": [
                                            "soubor cviků, popř. jiných úkonů, používaných při rozcvičce (1)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
