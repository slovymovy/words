                    {
                        "translation_id": "d7c6f5d6-6415-4031-82f9-e18fb31b3e48",
                        "source_entry_id": "04cfa130-c094-31b0-8f3e-89343d25ec54",
                        "source_sense_id": "70156f82-19e0-396e-8aac-b4e8b704937d",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Unterschied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterschied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f9ec3b2-321b-3005-bc50-2ad2cac253f5",
                                        "entry_id": "23a44436-ae62-3ac3-bb1c-d6c3f83127c0",
                                        "glosses": [
                                            "Nicht-Übereinstimmung zweier Objekte beziehungsweise Dinge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d8e1096-37cf-4e47-90f9-ab5fa4a77fb7",
                                                "sense_id": "9f9ec3b2-321b-3005-bc50-2ad2cac253f5",
                                                "text": "„Der wesentliche Unterschied zwischen beiden Sportarten besteht in den Fluggeräten.“"
                                            },
                                            {
                                                "example_id": "723535a3-f5aa-4b31-b6b3-e8ab79c4a651",
                                                "sense_id": "9f9ec3b2-321b-3005-bc50-2ad2cac253f5",
                                                "text": "Zwischen der behaupteten Darstellung und den tatsächlich beweisbaren Umständen liegt ein großer Unterschied."
                                            },
                                            {
                                                "example_id": "a33b7ae5-8e85-47e5-a8f6-4cd5c6b49ce6",
                                                "sense_id": "9f9ec3b2-321b-3005-bc50-2ad2cac253f5",
                                                "text": "Der Unterschied von Mann und Frau liegt zwar im Wesen der Natur, jedoch wird dieser Unterschied oftmals sehr einseitig missbraucht."
                                            },
                                            {
                                                "example_id": "e04f7526-7836-4fb8-a220-64b5ce379db5",
                                                "sense_id": "9f9ec3b2-321b-3005-bc50-2ad2cac253f5",
                                                "text": "„Der Unterschied zwischen ober- und untergärigem Bier liegt im Verhalten der Hefe beim Brauvorgang.“"
                                            },
                                            {
                                                "example_id": "f84ca732-34a0-4a81-a4ff-adcdaf35f5dc",
                                                "sense_id": "9f9ec3b2-321b-3005-bc50-2ad2cac253f5",
                                                "text": "„Ist der Unterschied zwischen Männern und Frauen ein Fantasieprodukt, wie das Kastensystem in Indien oder die Rassentrennung in den Vereinigten Staaten?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "beb5bb5d-298b-3f7f-8816-ebf9dc51feb5",
                                        "entry_id": "23a44436-ae62-3ac3-bb1c-d6c3f83127c0",
                                        "glosses": [
                                            "einschätzende Unterscheidung von etwas; Abgrenzung zu etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07b84956-19a3-4823-b9b1-e2803d802dc8",
                                                "sense_id": "beb5bb5d-298b-3f7f-8816-ebf9dc51feb5",
                                                "text": "„Der wesentliche Unterschied zwischen beiden Sportarten besteht in den Fluggeräten.“"
                                            },
                                            {
                                                "example_id": "1ef093de-1a80-4e40-b886-9da026d03b53",
                                                "sense_id": "beb5bb5d-298b-3f7f-8816-ebf9dc51feb5",
                                                "text": "„Ist der Unterschied zwischen Männern und Frauen ein Fantasieprodukt, wie das Kastensystem in Indien oder die Rassentrennung in den Vereinigten Staaten?“"
                                            },
                                            {
                                                "example_id": "25016c4d-e8b7-41d7-844f-527298a7d635",
                                                "sense_id": "beb5bb5d-298b-3f7f-8816-ebf9dc51feb5",
                                                "text": "Die Eltern machten keinen Unterschied zwischen ihren drei Kindern, sie behandelten sie alle gleich."
                                            },
                                            {
                                                "example_id": "82b868dd-e7eb-4403-8364-a59c8bed1717",
                                                "sense_id": "beb5bb5d-298b-3f7f-8816-ebf9dc51feb5",
                                                "text": "„Den meisten Menschen sind Beweise und der Unterschied zwischen Meinungen und Fakten wichtig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
