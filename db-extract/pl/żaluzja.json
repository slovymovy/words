                                            {
                                                "example_id": "39372edb-0c97-4611-b418-5500160fa725",
                                                "sense_id": "b3b7bdc5-cc65-34a4-b772-f79305306789",
                                                "text": "A service hatch with sliding shutter is situated at the end of the kitchen next to the dining compartment. […] A shutter, in three parts, is fitted, which when lowered completely encloses the bar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shutter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c956b8a9-28be-34f3-b724-67fd50f99ec8",
                                        "entry_id": "360920d6-8ffe-35da-82f2-4da1aede29a0",
                                        "glosses": [
                                            "To close shutters covering."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dddf03c-627e-4f17-8989-6b937a709d2d",
                                                "sense_id": "c956b8a9-28be-34f3-b724-67fd50f99ec8",
                                                "text": "Shutter the windows: there's a storm coming!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25b379e9-1e7c-3366-9e1c-06f94007eb3d",
                                        "entry_id": "360920d6-8ffe-35da-82f2-4da1aede29a0",
                                        "glosses": [
                                            "To close up (a building) for a prolonged period of inoccupancy."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d70dd77-885a-4ac9-888b-70805886f63b",
                                                "sense_id": "25b379e9-1e7c-3366-9e1c-06f94007eb3d",
                                                "text": "It took all day to shutter the cabin now that the season has ended."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87e21f38-73d2-3639-afdc-a84255d37286",
                                        "entry_id": "360920d6-8ffe-35da-82f2-4da1aede29a0",
                                        "glosses": [
                                            "To cancel or terminate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7b711e5-5391-43fa-a7d1-bf67e66b96b1",
                                                "sense_id": "87e21f38-73d2-3639-afdc-a84255d37286",
                                                "text": "The US is seeking to get Iran to shutter its nuclear weapons program."
                                            },
                                            {
                                                "example_id": "90c49ffc-d9b0-421e-8572-d084fc88fdff",
                                                "sense_id": "87e21f38-73d2-3639-afdc-a84255d37286",
                                                "text": "This company was shuttered in 2002."
                                            },
                                            {
                                                "example_id": "4983ef75-05e3-410a-a4db-81f29631f509",
                                                "sense_id": "87e21f38-73d2-3639-afdc-a84255d37286",
                                                "text": "It has been a dithery decade for nuclear policy. After the 2011 disaster at the Fukushima nuclear plant in Japan, several countries began shuttering their reactors and tearing up plans for new ones."
                                            },
                                            {
                                                "example_id": "8c84b858-0230-493a-b42e-f5f0ca811d15",
                                                "sense_id": "87e21f38-73d2-3639-afdc-a84255d37286",
                                                "text": "After some additional legal wrangling, Morse, exhausted and out of money, withdrew his remaining appeals and shuttered the production in April 1883."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bbe888f-e7cc-3f40-bb90-1f7e438a262d",
                                        "entry_id": "360920d6-8ffe-35da-82f2-4da1aede29a0",
                                        "glosses": [
                                            "To rain heavily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bde0bfdd-386a-4ce5-a6a8-433fad832d98",
                                                "sense_id": "4bbe888f-e7cc-3f40-bb90-1f7e438a262d",
                                                "text": "Mollie Wilson was a teenager living with her parents in Donaghmore in Tyrone, Northern Ireland [and said this]: 3rd September [1939] When Chamberlain made his declaration of war, there was violent thunder and lightning and rain shuttered down. I had always trusted rain too."
                                            },
                                            {
                                                "example_id": "8bca2651-acb7-4289-8168-af4e39274270",
                                                "sense_id": "4bbe888f-e7cc-3f40-bb90-1f7e438a262d",
                                                "text": "It's a bastard of a day, shuttering rain, but I can still shape up the hills off in the distance."
                                            },
                                            {
                                                "example_id": "76ceff9e-f955-436b-aefd-741e5b6c3d0e",
                                                "sense_id": "4bbe888f-e7cc-3f40-bb90-1f7e438a262d",
                                                "text": "... looked at the rain shuttering down outside and thought about the Fosters. He had been a perfect gentleman , although rather old and pernickety and set in his ways, but[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
