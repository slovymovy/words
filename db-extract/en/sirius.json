                                    {
                                        "sense_id": "fc9512e0-6931-3f3b-b593-e994a5bd9cce",
                                        "entry_id": "af193741-7ab6-3e09-9c19-85c96a823016",
                                        "glosses": [
                                            "Étoile principale de la constellation du Grand Chien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c90019c0-eac9-409d-ad91-890dc96bcf12",
                                                "sense_id": "fc9512e0-6931-3f3b-b593-e994a5bd9cce",
                                                "text": "Vue de la Terre, Sirius est l’étoile la plus brillante du ciel (après le Soleil)."
                                            },
                                            {
                                                "example_id": "602ce9ae-216e-4923-a0ac-7d8780776e68",
                                                "sense_id": "fc9512e0-6931-3f3b-b593-e994a5bd9cce",
                                                "text": "Madame, reprit Paul Vence, je ne dirai pas, comme Renan, mon maître bien-aimé : « Qu’est-ce que cela fait à Sirius ? » parce qu’on me répondrait raisonnablement : « Que fait le gros Sirius à la petite Terre ? »"
                                            },
                                            {
                                                "example_id": "5b2e7d38-4d29-4a51-914c-fb98c5b0c22e",
                                                "sense_id": "fc9512e0-6931-3f3b-b593-e994a5bd9cce",
                                                "text": "La nuit, des observations de Canopus, Sirius et Achernar fixèrent ma position."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23283336-74f5-4e00-9377-4b246864cf33",
                        "source_entry_id": "45d06e23-125a-3760-b9b0-9e8d2b849aea",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Sirius",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sirius",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e5a0eb1-7d8f-3af1-bda1-30d1a2477881",
                                        "entry_id": "0b1d67f1-62d3-3e06-b29a-b0728ca7f147",
                                        "glosses": [
                                            "der im Winter links unterhalb des Orion-Sternbildes sichtbare hellste Fixstern des Himmels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a87857-a415-4176-99b0-fefa5ffafd7e",
                                                "sense_id": "0e5a0eb1-7d8f-3af1-bda1-30d1a2477881",
                                                "text": "Sirius ist mit 8,8 Lichtjahren Entfernung einer der nächsten Fixsterne."
                                            },
                                            {
                                                "example_id": "602d3a78-794f-408b-a1d2-77c3c3b4b1e1",
                                                "sense_id": "0e5a0eb1-7d8f-3af1-bda1-30d1a2477881",
                                                "text": "„Und da die Schöpfung harmonisch ist, müßten die Bewohner des Sirius riesenhaft groß, die des Mars von mittlerem Wuchs und die der Venus ganz klein sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
