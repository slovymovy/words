                                        "glosses": [
                                            "um etwas herumstellen, einkreisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e673b811-b52f-404d-9cf5-5ad9b06416be",
                                                "sense_id": "064b5fd5-3635-336f-b715-a04e1578ef25",
                                                "text": "Kommen Sie mit erhobenen Händen heraus! Das Gebäude ist umstellt!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "umstellen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39839e12-224c-3977-a64f-1ef33d932860",
                                        "entry_id": "fd068c9f-daa8-37f3-b149-ac027b063ea9",
                                        "glosses": [
                                            "etwas von einem Ort auf einen anderen verlagern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d86044-bbdc-4475-93e0-47d92092f38e",
                                                "sense_id": "39839e12-224c-3977-a64f-1ef33d932860",
                                                "text": "Ich habe die Möbel in meiner Wohnung umgestellt."
                                            },
                                            {
                                                "example_id": "ba3dc408-63b8-4a2f-b3ad-7b9c9277cb9b",
                                                "sense_id": "39839e12-224c-3977-a64f-1ef33d932860",
                                                "text": "Sie stellte alle Vasen wieder um."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0bd3d65b-8787-3e90-bfb7-8011436a6766",
                                        "entry_id": "fd068c9f-daa8-37f3-b149-ac027b063ea9",
                                        "glosses": [
                                            "eine Einstellung in einem oder mehreren Geräten verändern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b2f86cd-3dd2-4d1f-a715-9797df44cc8a",
                                                "sense_id": "0bd3d65b-8787-3e90-bfb7-8011436a6766",
                                                "text": "Ich vergesse immer, die Uhr auf Sommerzeit umzustellen."
                                            },
                                            {
                                                "example_id": "11017da2-33ec-4f3e-942a-549411d20303",
                                                "sense_id": "0bd3d65b-8787-3e90-bfb7-8011436a6766",
                                                "text": "„Laut einem Bericht des Korea Herald hat die Regierung von Südkorea vor, ihre Rechner auf Linux umzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3e6f85a3-f8ea-3254-ad99-a7d1244b2080",
                                        "entry_id": "fd068c9f-daa8-37f3-b149-ac027b063ea9",
                                        "glosses": [
                                            "die eigene Einstellung ändern, sich auf eine Änderung einstellen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9afb8b64-b22c-41d2-93a5-474321a40440",
                                                "sense_id": "3e6f85a3-f8ea-3254-ad99-a7d1244b2080",
                                                "text": "Ich stelle bald meine Ernährung komplett um."
                                            },
                                            {
                                                "example_id": "c3022bdb-e782-4bc3-afab-323333c328c2",
                                                "sense_id": "3e6f85a3-f8ea-3254-ad99-a7d1244b2080",
                                                "text": "Daraufhin wird sich auch meine Familie auf die neue Ernährung umstellen müssen."
                                            },
                                            {
                                                "example_id": "a31acbb7-9f16-47d8-b82b-51c51f3c51a2",
                                                "sense_id": "3e6f85a3-f8ea-3254-ad99-a7d1244b2080",
                                                "text": "„Die ersten Universitäten haben […] angekündigt, dass sie in den nächsten Tagen die Vorlesungen ein- und auf Fernunterricht umstellen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
