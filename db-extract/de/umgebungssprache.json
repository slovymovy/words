                "senses": [
                    {
                        "sense_id": "4d93c0a8-bfb3-32e2-b4af-265d32685175",
                        "entry_id": "29e689b0-df25-3ab1-afe0-7e6b69ba4deb",
                        "glosses": [
                            "Sprache, die von den Menschen gesprochen wird, die im gleichen Umfeld leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5a2457-bd2d-4e09-8583-39bf433fbd03",
                                "sense_id": "4d93c0a8-bfb3-32e2-b4af-265d32685175",
                                "text": "„Haben sie sich sprachlich angepasst und Elemente ihrer neuen Umgebungssprache übernommen?“"
                            },
                            {
                                "example_id": "6661c65e-e3f2-4cb2-9b52-27773954c477",
                                "sense_id": "4d93c0a8-bfb3-32e2-b4af-265d32685175",
                                "text": "„Auch der aus Spendersprachen übernommene Sonderwortschatz wird phonetisch-phonologisch gänzlich an die regionale Umgebungssprache angepasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3f64d755-906d-3e74-95fc-0b30f5f01465",
                        "entry_id": "29e689b0-df25-3ab1-afe0-7e6b69ba4deb",
                        "glosses": [
                            "Sprache, die sich in der Nachbarschaft einer anderen Sprache befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "181912a9-db5d-4c87-9fd1-63138a45e9a9",
                                "sense_id": "3f64d755-906d-3e74-95fc-0b30f5f01465",
                                "text": "„Einige Dialekte des Armenischen besitzen Ejektive, was für indogermanische Sprachen atypisch ist und vermutlich auf den Einfluss der Umgebungssprachen zurückzuführen ist.“"
                            },
                            {
                                "example_id": "e777256a-4b64-461c-bf7d-153d159379f1",
                                "sense_id": "3f64d755-906d-3e74-95fc-0b30f5f01465",
                                "text": "„Namen von Pflanzen und Bäumen wurden oft aus den Umgebungssprachen direkt übernommen und sind daher im modernen Jiddisch meist, aber nicht ausschließlich, slawischer Herkunft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
