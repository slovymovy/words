                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c542ae33-fb5f-47d5-a44a-7e9b2184bf9e",
                                                "sense_id": "39611318-6597-3185-a909-2bf297d51902",
                                                "text": "Старый вождь повёл за собой несколько айнских племён."
                                            },
                                            {
                                                "example_id": "f2955899-07e4-4f59-911e-11e124307978",
                                                "sense_id": "39611318-6597-3185-a909-2bf297d51902",
                                                "text": "Невельской требовал от айнского старосты, чтобы он их привёл назад, и, разгорячась, взял его за бороду."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91e78fcd-1a51-35fd-ae8f-675d7526e1ed",
                                        "entry_id": "8e2bc98f-7840-3df0-83bd-c8348bf43af0",
                                        "glosses": [
