                    "sense_id": "2cdc9d91-5eb4-3dc0-905a-d85c2f3dea6f",
                    "sense_definition": "taki, który kieruje się rozsądkiem, myśli racjonalnie lub świadczy o mądrości i roztropności",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "intelekt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podjąłeś bardzo <w>rozumną</w> decyzję, która uchroniła naszą firmę przed stratami.",
                            "target_lang_translations": {
                                "ru": "Ты принял очень <w>разумное</w> решение, которое спасло нашу компанию от убытков."
                            }
                        },
                        {
                            "text": "To niezwykle <w>rozumny</w> człowiek i zawsze można liczyć na jego trafną radę.",
                            "target_lang_translations": {
                                "ru": "Это исключительно <w>разумный</w> человек, и всегда можно рассчитывать на его дельный совет."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozsądny",
                        "mądry",
                        "inteligentny",
                        "niegłupi"
                    ],
                    "antonyms": [
                        "bezrozumny",
                        "nierozumny",
                        "niemądry",
                        "nieinteligentny"
                    ],
                    "common_phrases": [
                        "rozumna decyzja",
                        "rozumny człowiek"
                    ],
                    "target_lang_definitions": {
                        "ru": "руководствующийся здравым смыслом, мыслящий рационально или свидетельствующий о мудрости и рассудительности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разумный",
                                "target_lang_sense_clarification": "рассудительный, толковый, целесообразный"
                            },
                            {
                                "target_lang_word": "благоразумный",
                                "target_lang_sense_clarification": "осмотрительный, практичный"
                            },
                            {
                                "target_lang_word": "рассудительный",
                                "target_lang_sense_clarification": "здравомыслящий, спокойный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d20a3dbc-fece-3659-b491-18c3b590a39a",
                    "sense_definition": "obdarzony zdolnością logicznego myślenia, świadomością i intelektem; cechujący istotę myślącą",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intelekt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Naukowcy od dziesięcioleci poszukują śladów <w>rozumnego</w> życia w odległych zakątkach wszechświata.",
                            "target_lang_translations": {
                                "ru": "Учёные десятилетиями ищут следы <w>разумной</w> жизни в далёких уголках вселенной."
                            }
                        },
                        {
                            "text": "Człowiek uważa się za jedyną w pełni <w>rozumną</w> istotę zamieszkującą naszą planetę.",
                            "target_lang_translations": {
                                "ru": "Человек считает себя единственным по-настоящему <w>разумным</w> существом, населяющим нашу планету."
                            }
                        }
                    ],
