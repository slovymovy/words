                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chief",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f4f8364-2e66-39db-84c2-a395eb5107af",
                                        "entry_id": "b6294855-5be0-30e9-bc0a-2b11e5299178",
                                        "glosses": [
                                            "The leader or head of a tribe, organisation, business unit, or other group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b67b5d08-85cd-44a7-801b-32ab4f7ab2aa",
                                                "sense_id": "6f4f8364-2e66-39db-84c2-a395eb5107af",
                                                "text": "In virtue of this privilege, in testimony of my affectionate respect for a revered chief, in conformity with what I believe to be the wish of all the Members of the scientific department, over which I have the honour to preside, and to perpetuate the memory of that illustrious master of accurate geographical research, I have determined to name this noble peak of the Himalayas ‘Mont Everest.’"
                                            },
                                            {
                                                "example_id": "fe1ed575-a6e6-4311-8bc6-3bdfd341e0fa",
                                                "sense_id": "6f4f8364-2e66-39db-84c2-a395eb5107af",
                                                "text": "My father, Gadla Henry Mphakanyiswa, was a chief by both blood and custom."
                                            },
                                            {
                                                "example_id": "0d4a8c38-2e60-4adb-812e-c84f588440de",
                                                "sense_id": "6f4f8364-2e66-39db-84c2-a395eb5107af",
                                                "text": "All firefighters report to the fire chief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ee1128-5a52-3be4-906f-3a90483c707b",
                                        "entry_id": "b6294855-5be0-30e9-bc0a-2b11e5299178",
                                        "glosses": [
                                            "Headship, the status of being a chief or leader."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "502dc888-f05e-41a5-ad2f-b457e3ff7230",
                                                "sense_id": "a8ee1128-5a52-3be4-906f-3a90483c707b",
                                                "text": "Bob is our troubleshooter in chief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63511ba-e432-3ad2-8ed8-e39928023dc3",
                                        "entry_id": "b6294855-5be0-30e9-bc0a-2b11e5299178",
                                        "glosses": [
                                            "The top part of a shield or escutcheon; more specifically, an ordinary consisting of the upper part of the field cut off by a horizontal line, generally occupying the top third."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb67d388-0dd1-44a8-9857-1ddba19a3822",
                                                "sense_id": "a63511ba-e432-3ad2-8ed8-e39928023dc3",
                                                "text": "When the Chief is Charged with any figure, in blazon it is said to be \"On a Chief\"."
                                            },
                                            {
                                                "example_id": "b4141a41-a274-49f2-a251-2dea13ed7878",
                                                "sense_id": "a63511ba-e432-3ad2-8ed8-e39928023dc3",
                                                "text": "The shield was silver, charged with a red cross voided (that is, with the centre cut out and only the edges left), between in chief (that is, above the horizontal limb of the cross) two black dragon's wings, and in base two red daggers, and in the centre of the cross a black winged helmet; on a red chief (a broad band across the top of the shield), a silver pale (a broad vertical band), and thereon eight black arrows crossed X-wise, four and four, and encircled with a black band, between on the dexter three bendlets (narrow bands slanting from dexter chief to sinister base) enhanced (that is, raised above the centre), and on the sinister a fleur-de-lis, all of gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76609fe8-78c7-34b4-9b40-fa881f3b06a3",
                                        "entry_id": "b6294855-5be0-30e9-bc0a-2b11e5299178",
                                        "glosses": [
                                            "The principal part or top of anything."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7feca033-cb15-3f67-8043-4b6923d9a9bb",
                                        "entry_id": "b6294855-5be0-30e9-bc0a-2b11e5299178",
                                        "glosses": [
                                            "An informal term of address."
                                        ],
                                        "tags": [
                                            "ironic",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e46108d-7eff-4f47-8d89-b6eae1c9860f",
                                                "sense_id": "7feca033-cb15-3f67-8043-4b6923d9a9bb",
                                                "text": "“How old are you, chief?” the elevator guy said."
                                            }
                                        ]
                                    },
