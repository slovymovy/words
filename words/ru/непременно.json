{
    "word_family": [
        "непременный",
        "непременность",
        "всенепременно"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c8060320-1c31-3e19-a356-5d885c3f043d",
                    "sense_definition": "Обязательно, во что бы то ни стало, при любых условиях.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <w>непременно</w> встретимся с вами завтра.",
                            "target_lang_translations": {
                                "en": "We will <w>certainly</w> meet with you tomorrow.",
                                "zh": "我们明天<w>一定</w>会和你见面。"
                            }
                        },
                        {
                            "text": "Ты <w>непременно</w> должен прочитать эту интересную книгу.",
                            "target_lang_translations": {
                                "en": "You must read this interesting book <w>without fail</w>.",
                                "zh": "你<w>务必</w>要读读这本有趣的书。"
                            }
                        }
                    ],
                    "synonyms": [
                        "обязательно",
                        "в любом случае",
                        "несомненно",
                        "определённо"
                    ],
                    "antonyms": [
                        "ни в коем случае",
                        "никогда"
                    ],
                    "common_phrases": [
                        "непременно нужно",
                        "непременно приду",
                        "непременно сделаю"
                    ],
                    "target_lang_definitions": {
                        "en": "Without fail; certainly; at any cost.",
                        "zh": "表示无论如何、在任何情况下都一定会发生，强调确定性或必要性。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "certainly",
                                "target_lang_sense_clarification": "Used to express certainty or strong affirmation"
                            },
                            {
                                "target_lang_word": "without fail",
                                "target_lang_sense_clarification": "Used to indicate that something must happen, no matter what"
                            },
                            {
                                "target_lang_word": "by all means",
                                "target_lang_sense_clarification": "Used to emphasize permission or agreement, or to express 'certainly'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一定",
                                "target_lang_sense_clarification": "表示确定无疑，用于强调必然性。"
                            },
                            {
                                "target_lang_word": "务必",
                                "target_lang_sense_clarification": "表示必须做到，常用于祈使句或强调任务。"
                            },
                            {
                                "target_lang_word": "肯定",
                                "target_lang_sense_clarification": "表示对某事发生的确定性。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f4965668-fc0f-3569-96f5-28b3b47f9299",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>непременный</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это условие для вступления в наш клуб <w>непременно</w>.",
                            "target_lang_translations": {
                                "en": "This condition for joining our club is <w>indispensable</w>.",
                                "zh": "这是加入我们俱乐部的<w>必不可少</w>的条件。"
                            }
                        },
                        {
                            "text": "Соблюдение всех правил безопасности на заводе <w>непременно</w>.",
                            "target_lang_translations": {
                                "en": "Observance of all safety rules at the factory is <w>mandatory</w>.",
                                "zh": "遵守工厂的所有安全规定是<w>强制性</w>的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Indispensable; obligatory (short form of the adjective).",
                        "zh": "形容词“不可或缺的”或“强制性的”的中性短形式，表示某事是必须遵守或具备的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "indispensable",
                                "target_lang_sense_clarification": "Absolutely necessary or essential"
                            },
                            {
                                "target_lang_word": "mandatory",
                                "target_lang_sense_clarification": "Required by rule or law; obligatory"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "必不可少",
                                "target_lang_sense_clarification": "形容绝对需要，缺之不可。"
                            },
                            {
                                "target_lang_word": "强制性",
                                "target_lang_sense_clarification": "指必须执行的，具有约束力的。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}