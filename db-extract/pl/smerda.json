                        "glosses": [
                            "kmieć zależny od księcia, zobowiązany do posługi (także zbrojnej) dla niego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee8a7cea-aef9-456f-b2c5-036d236188cd",
                                "sense_id": "b7ce439c-2e7b-3bff-b647-5a894d73c2d2",
                                "text": "Minęło dni kilka, a około grodu nic słychać nie było. Rozsyłano stąd na zwiady smerdów i poprzebieraną czeladź do bliższych dworów i chat, nigdzie o żadnym ruchu wojennym nie wiedział nikt"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e4ce4e27-7b14-34df-a1f8-9ffa2fba883a",
                        "entry_id": "83e32ae1-f091-304c-b64f-4bb5ec44a6a4",
                        "glosses": [
                            "smarkacz, smarkul, młokos"
                        ],
                        "tags": [
                            "humorous",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a24fa2e0-68f9-42d2-9fb5-d4b3f275e1ab",
                                "sense_id": "e4ce4e27-7b14-34df-a1f8-9ffa2fba883a",
                                "text": "Ledwie od ziemi odrósł, smerda jeden, a już takie figurki z gliny lepił i z drzewa wyrzynał."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
