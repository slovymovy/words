                    "frequency": "Middle",
                    "semantic_group_id": "ablehnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Chef <w>wies</w> meine Bitte um eine Gehaltserhöhung leider sofort <w>ab</w>."
                        },
                        {
                            "text": "Er konnte ihr kein Angebot machen und musste die Anfrage höflich <w>abweisen</w>."
                        }
                    ],
                    "synonyms": [
