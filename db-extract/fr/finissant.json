                        "glosses": [
                            "Celui qui est sur le point de finir ses études."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "b7bbf1b6-50b2-464f-b36e-67f9579feee1",
                                "sense_id": "b6fbed9d-84cc-3cfc-881a-2e0f8f341e3a",
                                "text": "À travers cet événement, les finissants montrent avec faste et allégresse qu’ils ont franchi une étape importante dans leur scolarité et donc dans leur inscription dans la société."
                            }
                        ]
                    }
                ],
