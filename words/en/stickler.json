{
    "word_family": [
        "stick"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f5ce004-065f-3086-8038-b40520ed3752",
                    "sense_definition": "Someone who insistently advocates for something, especially for strict observance of a formal rule.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "advocate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor is a <w>stickler</w> for grammar and will deduct points for every minor mistake.",
                            "target_lang_translations": {
                                "cs": "Profesor je <w>puntičkář</w> na gramatiku a strhne body za každou drobnou chybu."
                            }
                        },
                        {
                            "text": "My boss is a real <w>stickler</w> for punctuality and expects everyone to arrive exactly on time.",
                            "target_lang_translations": {
                                "cs": "Můj šéf je velký <w>pedant</w> na dochvilnost a očekává, že všichni dorazí přesně na čas."
                            }
                        }
                    ],
                    "synonyms": [
                        "dogmatist",
                        "formalist",
                        "pedant",
                        "traditionalist"
                    ],
                    "common_phrases": [
                        "stickler for rules",
                        "stickler for detail"
                    ],
                    "target_lang_definitions": {
                        "cs": "Člověk, který vyžaduje přísné dodržování pravidel nebo detailů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "puntičkář",
                                "target_lang_sense_clarification": "člověk, který lpí na detailech a přesnosti"
                            },
                            {
                                "target_lang_word": "pedant",
                                "target_lang_sense_clarification": "člověk přehnaně dbající na formální správnost a pravidla"
                            },
                            {
                                "target_lang_word": "hnidopich",
                                "target_lang_sense_clarification": "člověk, který kritizuje malichernosti (pejorativní)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "205d089c-30ee-3ed6-b0b9-710e5b981d3d",
                    "sense_definition": "A referee or adjudicator at a fight, wrestling match, or duel who ensures fair play.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "referee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, a <w>stickler</w> was present at every duel to ensure the rules were followed.",
                            "target_lang_translations": {
                                "cs": "Za starých časů byl u každého souboje přítomen <w>rozhodčí</w>, aby zajistil dodržování pravidel."
                            }
                        },
                        {
                            "text": "The appointed <w>stickler</w> watched the match closely to prevent any unfair tactics by the fighters.",
                            "target_lang_translations": {
                                "cs": "Určený <w>dohlížitel</w> pozorně sledoval zápas, aby zabránil neférovým praktikám bojovníků."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rozhodčí nebo dohlížitel při souboji či zápase, který zajišťuje dodržování pravidel."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozhodčí",
                                "target_lang_sense_clarification": "osoba dohlížející na pravidla v zápase"
                            },
                            {
                                "target_lang_word": "dohlížitel",
                                "target_lang_sense_clarification": "osoba zajišťující férový průběh souboje"
                            }
                        ]
                    }
                }
            ]
        },
        {
