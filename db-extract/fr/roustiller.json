                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4561c603-bfc1-41c5-ae5f-3ccf44dbab38",
                                "sense_id": "0e13fa18-234b-392d-be29-1c5c2496b0ed",
                                "text": "Parfaitement ! gronda Patte d’Ours, et je grognerai même plus : pourquoi se trouvaient-ils dans cette caverne de Peladed’Ourse, ces incendiaires pyromanes, prêts à roustiller leur proie ?"
                            },
                            {
                                "example_id": "e180b3c4-9d0f-432d-92a5-3020eddd7b21",
                                "sense_id": "0e13fa18-234b-392d-be29-1c5c2496b0ed",
                                "text": "La lumière grésillante finirait bien par leur roustiller la rétine !"
                            },
                            {
                                "example_id": "815d3715-cc73-4912-b963-6131b2150363",
                                "sense_id": "0e13fa18-234b-392d-be29-1c5c2496b0ed",
                                "text": "Trois pigeons, dûment bourrés d’aromates, roustillent sur une broche."
                            }
                        ]
                    }
