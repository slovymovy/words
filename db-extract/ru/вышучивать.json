                "senses": [
                    {
                        "sense_id": "d0d239b4-1768-329b-9915-bcbc65fe4f05",
                        "entry_id": "cd98610b-eb6e-3ea3-aaa5-8165cae75bba",
                        "glosses": [
                            "разг. выставлять кого-либо или что-либо серьёзное в смешном виде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17e82e05-75cf-4cdc-b377-ae2f942f2185",
                                "sense_id": "d0d239b4-1768-329b-9915-bcbc65fe4f05",
                                "text": "Миша и Эдуард были сегодня в смешливом настроении, они вышучивали танцующих."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb055a42-6390-368a-aed3-cb62eae5a72d",
                        "entry_id": "cd98610b-eb6e-3ea3-aaa5-8165cae75bba",
                        "glosses": [
                            "рег. добывать или получать что-либо шутками, шутя, или служа шутом, шутя, недуманно, негаданно [Даль]"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
