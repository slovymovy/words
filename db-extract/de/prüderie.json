                    },
                    {
                        "translation_id": "49f3f9a1-977c-478d-8e54-e8971d055384",
                        "source_entry_id": "6b0dd66b-3054-3ec9-8063-461bff7a6ce6",
                        "source_sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                        "source_sense_description": "übertrieben schamhafte Haltung",
                        "target_lang_word": "pruderie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pruderie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44dfdf24-9d69-3ddd-9099-c6abdb3e7939",
                                        "entry_id": "3d7d4de7-5e31-3cc2-9738-dfea3305273e",
                                        "glosses": [
                                            "Réserve outrée et affectée en ce qui touche à la pudeur et à la bienséance ; pudibonderie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc036265-024b-43ca-b5b5-3f0497a3535d",
                                                "sense_id": "44dfdf24-9d69-3ddd-9099-c6abdb3e7939",
                                                "text": "Les enfants étaient ravis de ce seul mot cabaret, que prononce avec tant de plaisir la pruderie moderne."
                                            },
                                            {
                                                "example_id": "6d0f6514-b047-4fac-b16c-1fee3a67de5f",
                                                "sense_id": "44dfdf24-9d69-3ddd-9099-c6abdb3e7939",
                                                "text": "Après quelques hésitations et quelques pruderies qui semblèrent de bon augure à Samuel, madame de Cosmelly à son tour lui fit ses confidences."
                                            },
                                            {
                                                "example_id": "8587c753-6d7f-42ea-a749-de1307707436",
                                                "sense_id": "44dfdf24-9d69-3ddd-9099-c6abdb3e7939",
                                                "text": "[…] ; ils ne se rendent aucun compte du progrès de nos mœurs ; encore moins soupçonnent-ils que leur pruderie archaïque fait rire jusqu'à ces enfants dont ils prétendent protéger la candeur."
                                            },
                                            {
                                                "example_id": "97f17179-46c3-4f75-b918-03a5784ed44b",
                                                "sense_id": "44dfdf24-9d69-3ddd-9099-c6abdb3e7939",
                                                "text": "Ces étudiantes national-socialistes cent pour cent affichent volontiers une allure soldatesque qui contraste, étrangement, avec leur pruderie réelle et touchante."
                                            },
                                            {
                                                "example_id": "ea775191-2db7-4820-93f4-0817f968b12e",
                                                "sense_id": "44dfdf24-9d69-3ddd-9099-c6abdb3e7939",
                                                "text": "Spacieuse et basse, la pièce était meublée à l’ancienne mode et gardait cet air de pruderie aimable qu’on voit encore aux vieilles demeures de la région."
                                            },
                                            {
                                                "example_id": "60dab7c3-b3a4-484f-a4a4-7e4b08a122fe",
                                                "sense_id": "44dfdf24-9d69-3ddd-9099-c6abdb3e7939",
                                                "text": "Mais comment faire comprendre la pruderie hystérique qui interdisait alors à une dame de proférer ne fût-ce que le mot « pantalon » ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77943f0c-4e80-4192-a7b7-19c09678bedf",
                        "source_entry_id": "6b0dd66b-3054-3ec9-8063-461bff7a6ce6",
                        "source_sense_id": "fbcc7af8-ac3a-3127-a2a5-db3d9b13df63",
                        "source_sense_description": "übertrieben schamhafte Haltung",
                        "target_lang_word": "bégueulerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bégueulerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2cb9d21-6ebf-3200-bcfa-5e261802331f",
                                        "entry_id": "d204fec8-49b5-36a9-863b-6921981c102e",
                                        "glosses": [
                                            "Caractère, air, ton d’une personne bégueule."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06110676-be6a-4fcd-85f5-7425a45026d9",
                                                "sense_id": "d2cb9d21-6ebf-3200-bcfa-5e261802331f",
                                                "text": "On ne peut supporter sa bégueulerie."
                                            },
                                            {
                                                "example_id": "8583cf08-fa04-4230-8e83-378a0d5f2b5a",
                                                "sense_id": "d2cb9d21-6ebf-3200-bcfa-5e261802331f",
                                                "text": "C’est un trait de bégueulerie des plus ridicules."
                                            },
                                            {
                                                "example_id": "a7e221b0-b8ab-406b-8d64-c5031d35b37d",
                                                "sense_id": "d2cb9d21-6ebf-3200-bcfa-5e261802331f",
                                                "text": "La riposte d’Henriette est un peu gaillarde ; mais il n’y a pas d’homme qui ne préférât la franchise un peu vive de la cadette à la bégueulerie sournoise de l’aînée."
                                            },
                                            {
                                                "example_id": "3db52edc-3dab-47fb-960a-8a7128ea3cb1",
                                                "sense_id": "d2cb9d21-6ebf-3200-bcfa-5e261802331f",
                                                "text": "Ce n’est pas là, surtout si l’on imagine ce que pouvaient être les chansons de matelots, le témoignage d’une « bégueulerie » indignée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
