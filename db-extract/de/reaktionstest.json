                "senses": [
                    {
                        "sense_id": "00ae070a-7e43-3d95-af8a-25a22f655604",
                        "entry_id": "5c958cad-7317-34be-81f3-2bbe28f30b71",
                        "glosses": [
                            "Überprüfung der Zeit, innerhalb derer eine Verhaltensänderung durch einen Reiz erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f39d7c3b-bed9-4cb5-b36c-27827992a917",
                                "sense_id": "00ae070a-7e43-3d95-af8a-25a22f655604",
                                "text": "„Im Zweifelsfall sollten Patienten auf eine Beratung beim Arzt oder Apotheker bestehen - oder sich freiwillig einem Reaktionstest unterziehen.“"
                            },
                            {
                                "example_id": "a4661f25-e76d-4aff-81ca-a89fc4bd0a6c",
                                "sense_id": "00ae070a-7e43-3d95-af8a-25a22f655604",
                                "text": "„Parallel dazu verschlechterte sich anfangs die Motorik der Probanden und wurde nach 24 Stunden wieder besser, wie mit einem Reaktionstest festgestellt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
