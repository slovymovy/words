                ],
                "senses": [
                    {
                        "sense_id": "8ee8416a-e1eb-3707-a16d-58bf5e54cd68",
                        "entry_id": "76b57eaf-fb99-3b45-91f9-2b6f42a000ab",
                        "glosses": [
                            "Mehrere Latten parallel nebeneinander und oft federnd montiert, als Unterlage für eine Matratze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "416d6272-92b6-401f-b1df-8882dcdb4bd2",
                                "sense_id": "8ee8416a-e1eb-3707-a16d-58bf5e54cd68",
                                "text": "Ein hochwertiger Lattenrost sorgt für gesunden Schlaf."
                            },
                            {
                                "example_id": "9816b186-e609-400b-9517-c3737b029f29",
                                "sense_id": "8ee8416a-e1eb-3707-a16d-58bf5e54cd68",
                                "text": "„Ich stellte mich darauf ein, jeden Abend in diesem Stockbett zu liegen, zu lesen, Musik zu hören oder einfach nur auf den Lattenrost des oberen Bettes zu starren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7f7600eb-671e-3da6-b19b-aff58a016852",
                        "entry_id": "76b57eaf-fb99-3b45-91f9-2b6f42a000ab",
                        "glosses": [
                            "Mehrere Latten parallel nebeneinander oder gitterförmig montiert, z.B. als Fußboden, als Laufsteg im Freien oder als Einlagebrett für Regale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2baa5d29-e975-43fb-bc39-5210e331583d",
                                "sense_id": "7f7600eb-671e-3da6-b19b-aff58a016852",
                                "text": "Lattenroste aus tropischem Hartholz verschaffen sicheren Stand bei Arbeiten auf rutschigem Boden."
                            },
                            {
                                "example_id": "4d69cbe1-ebc8-44ec-98ca-b677eb798085",
                                "sense_id": "7f7600eb-671e-3da6-b19b-aff58a016852",
                                "text": "„Braune irdene Krüge, auf Lattenrosten aufgereiht, waren randvoll mit Milch gefüllt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
