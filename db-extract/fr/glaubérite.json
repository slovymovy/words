                        "glosses": [
                            "Sulfate de sodium et de calcium de formule Na₂Ca(SO₄)₂."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee82056-b41d-4827-aac4-e0fa9e77d74b",
                                "sense_id": "c492f7d6-60d9-3ecb-b08c-eaaebf8869ad",
                                "text": "Les sulfates anhydres comportent des groupements (SO4)²⁻ maintenus par des ions métalliques qui, selon leur grosseur les écartent plus ou moins : les ions Na⁺ se contentent d'un site octaédrique dans la thénardite, mais s'entourent de sept ions oxygène dans la glaubérite."
                            },
                            {
                                "example_id": "3afdf9fc-04c7-4441-b027-213f45f22fbb",
                                "sense_id": "c492f7d6-60d9-3ecb-b08c-eaaebf8869ad",
                                "text": "La localité type de la glaubérite est Villarubia Espagne."
                            }
                        ]
