                                        "entry_id": "ec753d68-33d5-36cb-a412-c30fcd784ed1",
                                        "glosses": [
                                            "Cité hellénique de l'Antiquité, dans la province romaine de l'Asie, lieu de pèlerinage célèbre au temple d’Artémis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58f16ae-3a2d-4fa0-a76b-a1f9c2bc6298",
                                                "sense_id": "a05a70dd-b00c-340b-ade0-a06cf5cd8b43",
                                                "text": "Le principe n’était d’ailleurs pas nouveau puisque l’on trouve mention d’un système similaire en vigueur à Éphèse au ive siècle avant JC (jugement rapporté par Vitruve)."
                                            },
                                            {
                                                "example_id": "894e5644-b914-452d-8327-8bec4b011820",
                                                "sense_id": "a05a70dd-b00c-340b-ade0-a06cf5cd8b43",
                                                "text": "A Éphèse, les premières grosses chaleurs estivales échauffent les esprits. Dans les églises, dans les rues, sur les places publiques, évêques, prêtres et moines, nestoriens et cyrilliens se prennent à partie et s'invectivent en termes crus. La situation devient intenable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78ff60ba-fdfb-3bd0-91fe-c5b803073453",
                                        "entry_id": "ec753d68-33d5-36cb-a412-c30fcd784ed1",
                                        "glosses": [
                                            "Ville de Turquie, bâtie près du site de la cité antique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
