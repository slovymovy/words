        "nl-extract.jsonl": [
            {
                "entry_id": "9387b2e7-12b6-3240-be76-952b273d64e3",
                "word": "strelend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5281c939-0002-349f-9222-1224f2561b49",
                        "entry_id": "9387b2e7-12b6-3240-be76-952b273d64e3",
                        "glosses": [
                            "zacht aaiend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32239acc-ce23-4566-b2a8-9d2da158586d",
                                "sense_id": "5281c939-0002-349f-9222-1224f2561b49",
                                "text": "Het tijdschrift Cosmopolitan liet een onderzoek uitvoeren onder vijfhonderd vrouwen tussen de achttien en veertig jaar. Hieruit blijkt dat de Hollandse vrouw de voorkeur geeft aan een lief woordje en een strelende hand in bed."
                            },
                            {
                                "example_id": "071a2162-914c-463c-9307-1151f461aa72",
                                "sense_id": "5281c939-0002-349f-9222-1224f2561b49",
                                "text": "Minstens zo strelend – maar dan voor het oor – is de bijzondere muziek in Het lied van de zee."
                            },
                            {
                                "example_id": "a704497f-2245-4546-a2bc-bf97d33c21d9",
                                "sense_id": "5281c939-0002-349f-9222-1224f2561b49",
                                "text": "„Breng haar maar naar huis!”, schreeuwt een van de leerlingen. „Goed plan, goed plan.” Met gladde praat en strelende bewegingen uit karakter ‘Peter’ het idee bij de door actrice Esther ter Horst (bekend als Monkie Wildspieker van Van Jonge Leu en Oale Groond) gespeelde ‘Anne’."
                            }
                        ]
                    },
                    {
                        "sense_id": "02aec021-4e1b-3443-b9f4-c702281a1309",
                        "entry_id": "9387b2e7-12b6-3240-be76-952b273d64e3",
                        "glosses": [
                            "heel eervol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3da670b5-f698-42aa-8b24-475ee0f5098a",
                                "sense_id": "02aec021-4e1b-3443-b9f4-c702281a1309",
                                "text": "Dat zei Ryan wel vaker en hoewel Bibi het een strelende gedachte vond dat haar beste vriendin kennelijk dacht dat zij zo’n mannenmagneet was, had ze van al die aandacht waar Ryan over repte vooralsnog weinig gemerkt."
                            }
                        ]
                    }
