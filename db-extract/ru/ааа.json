                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3f1faa-59f6-40bd-a552-81114f2c9f62",
                                                "sense_id": "55934003-dd0e-35b7-9a97-fb75259c8bd5",
                                                "text": "Oh, wow! That's amazing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afdbaed6-0fdf-3874-82cd-7e12d6f390cf",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "Expression of understanding, affirmation, recognition, or realization."
                                        ],
                                        "tags": [],
