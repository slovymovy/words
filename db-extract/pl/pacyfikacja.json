                            "tłumienie buntu, powstania, strajku itp., zwykle przy użyciu siły zbrojnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6bd082c-9f29-4241-b3fd-77ea7bf7c6a9",
                                "sense_id": "7289a738-d6a0-3611-a7ac-dee70e968c12",
                                "text": "Podczas izraelskiej pacyfikacji na Zachodnim Brzegu Jordanu zginął Palestyńczyk, a dwóch zostało rannych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
