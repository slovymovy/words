                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b2adbb9-ff3d-3864-adac-3988fbf726a0",
                        "entry_id": "c20e0ed9-4a2e-3436-8736-b59370fd8189",
                        "glosses": [
                            "verstijfd en onbuigzaam"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8719713b-bb99-4751-a43c-21c495c8821e",
                                "sense_id": "6b2adbb9-ff3d-3864-adac-3988fbf726a0",
                                "text": "De starre houding van de apartheidsregering leidde tot haar isolement."
                            },
                            {
                                "example_id": "67ebcf75-a0ff-444f-9d87-a6267704d688",
                                "sense_id": "6b2adbb9-ff3d-3864-adac-3988fbf726a0",
                                "text": "Misschien ligt het aan mij, maar veel mannen worden met het verstrijken van de jaren star en steeds minder flexibel."
                            },
                            {
                                "example_id": "4dccd63c-8709-4a37-9c2a-86f5e8577986",
                                "sense_id": "6b2adbb9-ff3d-3864-adac-3988fbf726a0",
                                "text": "Ik was er op een bepaalde manier altijd trots op geweest dat ik nog nooit een joint had gerookt, maar realiseerde me dat dit misschien wel de starre houding van een oude man was geworden."
                            },
                            {
                                "example_id": "4882ba20-e9e6-4e60-be60-e7912189056e",
                                "sense_id": "6b2adbb9-ff3d-3864-adac-3988fbf726a0",
                                "text": "Hoewel de meeste mechanische eigenschappen vergelijkbaar zijn met die van op conventionele wijze vervaardigde onderdelen, zijn ze alleen erg star."
                            }
                        ]
                    }
                ],
