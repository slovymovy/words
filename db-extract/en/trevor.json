                "senses": [
                    {
                        "sense_id": "e3d2a630-f6c3-3b92-9668-d22836714cb6",
                        "entry_id": "1f50a899-11c8-3a9d-9764-3e63fbfa1dd2",
                        "glosses": [
                            "A male given name from Welsh, from Welsh Trefor. Popular in the UK in the 1950s and the 1960s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf295374-7cd6-4dd1-8937-fc4a84bd78d3",
                                "sense_id": "e3d2a630-f6c3-3b92-9668-d22836714cb6",
                                "text": "He never wasted a word even to tell his name until that was required of him by the rules. When he said 'Trevor' it was a statement of fact, not as it would have been with the others a statement of shame or defiance. - - - There was every reason why T., as he was afterwards referred to, should have been an object of mockery - there was his name ( and they substituted the initial because otherwise they had no excuse not to laugh at it ) - - -"
                            },
                            {
                                "example_id": "ba23081f-4eaf-4c60-8e19-104d89d522f5",
                                "sense_id": "e3d2a630-f6c3-3b92-9668-d22836714cb6",
                                "text": "The designer of the study, Trevor Dupuy, was a decorated US Army colonel, a noted military historian and a founding faculty member of Harvard University’s Defense Studies Program."
                            }
                        ]
                    },
                    {
                        "sense_id": "e572b71d-468d-3062-84eb-e0793c980e53",
