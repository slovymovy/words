                        "entry_id": "d3a2ee44-f680-3e2f-8898-075b4b06043a",
                        "glosses": [
                            "перен. почувствовать неуверенность в своих силах, потерять надежду на успех"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d36526cc-5c40-4b3e-96da-22818ed60a0d",
                                "sense_id": "d2111dfe-d340-3827-a8ea-f50d733b44dc",
                                "text": "Он не взялся за эту работу, испугался трудностей."
                            }
                        ]
