                    {
                        "translation_id": "d44b87b7-16b5-4e5f-90a8-e2c0e0045f05",
                        "source_entry_id": "0380f90a-8517-3072-9bd7-5006f2472c15",
                        "source_sense_id": "fe919350-dbc1-39e0-a01d-9ae270dfda2c",
