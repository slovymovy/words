                "senses": [
                    {
                        "sense_id": "3a32968b-4fb1-3284-93dc-f012464794cf",
                        "entry_id": "38422666-c1ea-37a2-994f-128a001ac3b9",
                        "glosses": [
                            "Restaurant, das sich auf einem Schiff befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f00b3320-f475-40ca-8d4e-f215b9b0bde6",
                                "sense_id": "3a32968b-4fb1-3284-93dc-f012464794cf",
                                "text": "„In der Hafenecke lag ein großer Wohnkahn, ›Zum fliegenden Holländer‹ hieß das Ding und war ein Schiffsrestaurant.“"
                            },
                            {
                                "example_id": "b964cc5b-5e37-4e88-9416-2a93e3401f59",
                                "sense_id": "3a32968b-4fb1-3284-93dc-f012464794cf",
                                "text": "„Die Behörden teilten lediglich mit, die Leichen von zwei in Rettungswesten gekleideten älteren Menschen seien an einem Treffpunkt für die Evakuierungsaktion nahe dem Schiffsrestaurant entdeckt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
