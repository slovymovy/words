                "senses": [
                    {
                        "sense_id": "0c21bbe7-b646-3402-99d4-7e7d770036fa",
                        "entry_id": "f54858b5-d8eb-3a15-b543-e77786b8e100",
                        "glosses": [
                            "Vorrichtung zum Spülen von Wasser ins Toilettenbecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "848b3523-349c-4739-96c4-7eae4a347860",
                                "sense_id": "0c21bbe7-b646-3402-99d4-7e7d770036fa",
                                "text": "Weil die Toilettenspülung schon wieder nicht funktionierte, rief er den Hausmeister."
                            },
                            {
                                "example_id": "41482f1a-f36d-4c8e-b1fe-a8661d4a4123",
                                "sense_id": "0c21bbe7-b646-3402-99d4-7e7d770036fa",
                                "text": "Er [der Hydrologe Marco Cremona] fängt das Wasser auf, das auf sein Dach regnet und auf den Boden fällt - und nutzt es zum Beispiel für die Toilettenspülung. \"40 bis 50 Prozent des Wassers, das man zuhause benutzt, könnte mit Wasser zweiter Klasse gedeckt werden, mit Regenwasser: die Toilettenspülung, die Wäsche in der Waschmaschine, Putzen, Autowaschen und im Garten. Dafür braucht man kein erstklassiges Trinkwasser\", sagt Cremona."
                            },
                            {
                                "example_id": "3555dc7c-570e-4758-9b73-f9dc046b3d01",
                                "sense_id": "0c21bbe7-b646-3402-99d4-7e7d770036fa",
                                "text": "Sonnenkollektoren versorgen bereits den gesamten Campus mit Energie, ein Regenwasserspeicher für die Toilettenspülung ist in Planung."
                            },
                            {
                                "example_id": "a8c0f733-e0a6-40e0-85f0-edb8a9922f02",
                                "sense_id": "0c21bbe7-b646-3402-99d4-7e7d770036fa",
                                "text": "„Irgendwo war eine Toilettenspülung zu hören.“"
                            },
                            {
                                "example_id": "6f06f2b4-b254-4b38-b86b-2c2b81ff8659",
                                "sense_id": "0c21bbe7-b646-3402-99d4-7e7d770036fa",
                                "text": "„Von dem Konzert hatte ich übrigens am nächsten Tag noch einen dermaßen starken Tinnitus, dass ich am Morgen nach dem Pinkeln die Toilettenspülung nicht hörte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
