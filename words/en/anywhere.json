{
    "word_family": [
        "anywhere-else"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0c4fc836-b12f-3874-9d5a-40b9b15a3b71",
                    "sense_definition": "In or at any location.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't know where I left my keys; they could be <w>anywhere</w> in the house.",
                            "target_lang_translations": {
                                "ru": "Я не знаю, где оставил ключи; они могут быть <w>где угодно</w> в доме.",
                                "zh": "我不知道把钥匙落在哪里了；它们可能在屋里的<w>任何地方</w>。"
                            }
                        },
                        {
                            "text": "You can sit <w>anywhere</w> you like because the theater is almost empty.",
                            "target_lang_translations": {
                                "ru": "Вы можете сесть <w>куда угодно</w>, так как театр почти пуст.",
                                "zh": "你可以<w>随便</w>坐，因为剧院里几乎没人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "be anywhere",
                        "sit anywhere",
                        "anywhere else"
                    ],
                    "target_lang_definitions": {
                        "ru": "В любом месте или в какой-либо локации.",
                        "zh": "在任何地方或某个位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "где угодно",
                                "target_lang_sense_clarification": "в любом месте по выбору"
                            },
                            {
                                "target_lang_word": "где-нибудь",
                                "target_lang_sense_clarification": "в каком-то неопределенном месте"
                            },
                            {
                                "target_lang_word": "где-либо",
                                "target_lang_sense_clarification": "в любом из возможных мест"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任何地方",
                                "target_lang_sense_clarification": "无论何处"
                            },
                            {
                                "target_lang_word": "到处",
                                "target_lang_sense_clarification": "在各个地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11a5198d-9cce-30ff-8f16-ab984a3e0136",
                    "sense_definition": "To or in the direction of any location.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am staying home today and I am not going <w>anywhere</w>.",
                            "target_lang_translations": {
                                "ru": "Я сегодня остаюсь дома и ни <w>куда</w> не пойду.",
                                "zh": "我今天待在家里，哪儿也<w>不</w>去。"
                            }
                        },
                        {
                            "text": "Are you going <w>anywhere</w> special for your summer vacation this year?",
                            "target_lang_translations": {
                                "ru": "Вы поедете <w>куда-нибудь</w> в особенное место в летний отпуск в этом году?",
                                "zh": "今年暑假你打算去什么<w>特别的地方</w>吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go anywhere",
                        "not going anywhere",
                        "anywhere special"
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении любого места или куда-либо.",
                        "zh": "去往任何方向或某个地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куда-нибудь",
                                "target_lang_sense_clarification": "в неопределенное место"
                            },
                            {
                                "target_lang_word": "куда угодно",
                                "target_lang_sense_clarification": "в любое место по выбору"
                            },
                            {
                                "target_lang_word": "куда-либо",
                                "target_lang_sense_clarification": "в какое-то из мест"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任何地方",
                                "target_lang_sense_clarification": "无论去哪儿"
                            },
                            {
                                "target_lang_word": "哪儿",
                                "target_lang_sense_clarification": "用于否定句表示不去任何地方"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "187dd059-b06c-37f3-a3dc-ba8c9963852f",
                    "sense_definition": "Any location or an unknown location.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Anywhere</w> is better than here when the weather is this cold.",
                            "target_lang_translations": {
                                "ru": "<w>Любое место</w> лучше, чем здесь, когда такая холодная погода.",
                                "zh": "天气这么冷，去<w>任何地方</w>都比待在这儿强。"
                            }
                        },
                        {
                            "text": "If <w>anywhere</w> has the book you need, it will be the central library.",
                            "target_lang_translations": {
                                "ru": "Если <w>где-то</w> и есть нужная вам книга, то это в центральной библиотеке.",
                                "zh": "如果<w>什么地方</w>有你需要的那本书，那一定是中心图书馆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "anywhere is better"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое место или неизвестная локация.",
                        "zh": "任何地点或未知的地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любое место",
                                "target_lang_sense_clarification": "какая угодно локация"
                            },
                            {
                                "target_lang_word": "где-нибудь",
                                "target_lang_sense_clarification": "какое-то место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任何地方",
                                "target_lang_sense_clarification": "指代任意位置"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ba1d480-bff3-3e13-b11a-5f733309d3c3",
                    "sense_definition": "A person without strong cultural or social ties to a specific place; a cosmopolite.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a digital nomad, he considers himself an <w>anywhere</w> with no fixed roots.",
                            "target_lang_translations": {
                                "ru": "Как цифровой кочевник, он считает себя <w>космополитом</w> без постоянных корней.",
                                "zh": "作为一名数字游民，他认为自己是一个没有固定根基的<w>世界公民</w>。"
                            }
                        },
                        {
                            "text": "The political essay discussed the divide between the local 'somewheres' and the global <w>anywheres</w>.",
                            "target_lang_translations": {
                                "ru": "В политическом эссе обсуждался разрыв между местными «оседлыми» и глобальными <w>людьми мира</w>.",
                                "zh": "这篇政治论文讨论了本土的“守成者”与全球化的“<w>世界公民</w>”之间的分歧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cosmopolite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек без сильных культурных или социальных связей с конкретным местом; космополит.",
                        "zh": "指没有特定文化或社会归属感的人；世界公民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "космополит",
                                "target_lang_sense_clarification": "человек мира"
                            },
                            {
                                "target_lang_word": "человек без корней",
                                "target_lang_sense_clarification": "не привязанный к месту"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "世界公民",
                                "target_lang_sense_clarification": "具有全球视野且不局限于一地的人"
                            },
                            {
                                "target_lang_word": "无根之人",
                                "target_lang_sense_clarification": "没有固定地域归属感的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}