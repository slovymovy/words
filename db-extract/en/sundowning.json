                    {
                        "sense_id": "fa0f055e-4a09-3914-9204-8bd45ac625b3",
                        "entry_id": "687db342-bfff-3260-a8a2-50c39e6e8c87",
                        "glosses": [
                            "A state of agitation, confusion, or delirium, especially in patients suffering from Alzheimer's disease, which begins daily at nightfall and which is alleviated by daylight."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ddf601d1-c9b8-4bdf-ae09-df9ae86751bb",
                                "sense_id": "fa0f055e-4a09-3914-9204-8bd45ac625b3",
                                "text": "Impaired judgment and sundowning (increased confusion when orienting cues diminish at night) often makes it necessary to restrict and protect the delirious patient."
                            },
                            {
                                "example_id": "08597a28-a15e-4591-9644-4f2525f1542a",
                                "sense_id": "fa0f055e-4a09-3914-9204-8bd45ac625b3",
                                "text": "Polysomnography and othersleep measures show sleep fragmentation with shortening of N3 sleep togetherwith excessive daytime sleepiness (EDS) and sundowning as the main findings in AD patients."
                            }
                        ]
                    }
