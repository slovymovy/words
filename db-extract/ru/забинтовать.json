                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb3ba60-cc63-3b67-85c8-b0c13ab534f0",
                                        "entry_id": "acbfac6a-4470-3ef3-bf97-c106d137ebd7",
                                        "glosses": [
                                            "Soigner une plaie ou une blessure ; lui faire un pansement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff1f5ef6-5a46-4576-8b03-b9970e7de1a5",
                                                "sense_id": "cfb3ba60-cc63-3b67-85c8-b0c13ab534f0",
                                                "text": "L'assistance médicale était organisée ; les infirmeries indigènes, créées dans chacun de nos postes, voyaient affluer, chaque jour, des centaines de consultants dont certains venaient se faire panser les blessures reçues en nous combattant ; […]."
                                            },
                                            {
                                                "example_id": "6efd2fd0-9091-4a15-a277-89f0717d55d7",
                                                "sense_id": "cfb3ba60-cc63-3b67-85c8-b0c13ab534f0",
                                                "text": "Les blessures des arbres doivent être soigneusement pansées au mastic."
                                            },
                                            {
                                                "example_id": "8c2865b5-ba25-4eab-b768-dd40d217c10f",
                                                "sense_id": "cfb3ba60-cc63-3b67-85c8-b0c13ab534f0",
                                                "text": "Elle insista pour que je fasse comme elle voulait, et c’est seulement après que le cocher eut reçu l’ordre de se tenir prêt, et une servante d’empaqueter quelques effets indispensables, c’est alors seulement qu’elle m’autorisa à panser sa plaie et à l’aider à se changer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9cf0cb9-a866-3aa8-a7d8-964885baf2d6",
                                        "entry_id": "acbfac6a-4470-3ef3-bf97-c106d137ebd7",
                                        "glosses": [
                                            "Consoler, soulager."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3080a223-a561-4778-9feb-534dccac02c2",
                                                "sense_id": "f9cf0cb9-a866-3aa8-a7d8-964885baf2d6",
                                                "text": "Toujours penchée sur le grabat des âmes, Elle lavait les plaies, pansait les blessures, réconfortait les défaillantes langueurs des conversions."
                                            },
                                            {
                                                "example_id": "fcea74ec-6dfe-48cb-8774-dc658fe4386b",
                                                "sense_id": "f9cf0cb9-a866-3aa8-a7d8-964885baf2d6",
                                                "text": "Elle avait été blessée dans son amour-propre, il s’employa à panser sa déception."
                                            },
                                            {
                                                "example_id": "3d29abba-b4b8-45c9-b7ed-3e01f0d71b23",
                                                "sense_id": "f9cf0cb9-a866-3aa8-a7d8-964885baf2d6",
                                                "text": "Si les sondages se confirment et que Joe Biden remporte l'élection du 3 novembre, ce sera lui qui aura à panser les plaies derrière Donald Trump."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a36a64-8c36-3b09-a1e8-6232a109668e",
                                        "entry_id": "acbfac6a-4470-3ef3-bf97-c106d137ebd7",
                                        "glosses": [
                                            "Réparer un objet."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72fd61ea-e3b6-4e31-bdcb-5dc6285dd745",
                                                "sense_id": "b6a36a64-8c36-3b09-a1e8-6232a109668e",
                                                "text": "Le patron, ce soir-là, pansait son accordéon avec de la colle de pâte et des morceaux de vieux corsages ; on avait la paix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9a4806-d80e-33f1-95eb-72842e978083",
                                        "entry_id": "acbfac6a-4470-3ef3-bf97-c106d137ebd7",
                                        "glosses": [
                                            "Faire la toilette d’un animal, en particulier d’un cheval, l’étriller, le brosser, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a955b3-4b30-4f42-9d2c-dd5341c61218",
                                                "sense_id": "7b9a4806-d80e-33f1-95eb-72842e978083",
                                                "text": "Cogolin conduisit les chevaux à l’écurie, les pansa, les fit boire et leur donna à manger."
