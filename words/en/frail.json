                {
                    "sense_id": "dca61d28-e1ed-39f3-a78a-cc877f3c74f6",
                    "sense_definition": "A rush used for weaving baskets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "baskets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weavers gathered <w>frail</w> along the riverbank to prepare for their work.",
                            "target_lang_translations": {
                                "ru": "Ткачи собирали <w>камыш</w> по берегу реки, чтобы подготовиться к работе."
                            }
                        },
                        {
                            "text": "This type of <w>frail</w> is highly valued for its strength and flexibility.",
                            "target_lang_translations": {
                                "ru": "Этот вид <w>рогоза</w> высоко ценится за свою прочность и гибкость."
                            }
                        }
