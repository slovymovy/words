                },
                {
                    "sense_id": "128d0db3-53fd-39a7-bd9c-a132a30dacb4",
                    "sense_definition": "een kritische beoordeling geven van een werk; recenseren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beoordeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe boek werd uitgebreid <w>besproken</w> in het literaire supplement van de krant.",
                            "target_lang_translations": {
                                "en": "The new book was <w>reviewed</w> extensively in the newspaper's literary supplement.",
                                "ru": "Новая книга была подробно <w>прорецензирована</w> в литературном приложении к газете."
                            }
                        },
                        {
                            "text": "De criticus gaat vanavond de nieuwste film <w>bespreken</w> op de nationale televisie.",
                            "target_lang_translations": {
                                "en": "The critic is going to <w>review</w> the latest film on national television tonight.",
                                "ru": "Критик сегодня вечером будет <w>делать обзор</w> на новейший фильм на национальном телевидении."
                            }
