{
    "word_family": [
        "fatalement",
        "fatalisme",
        "fataliste",
        "fatalité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7e0f0fda-9a4b-3ade-88b1-5f1fae90900f",
                    "sense_definition": "Qui provoque la mort de manière directe ou certaine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accident de la route a été <w>fatal</w> pour le conducteur de la moto."
                        },
                        {
                            "text": "Les médecins ont tout tenté mais cette blessure <w>fatale</w> ne laissait aucun espoir."
                        }
                    ],
                    "synonyms": [
                        "létal",
                        "mortel"
                    ],
                    "antonyms": [
                        "bénin",
                        "inoffensif"
                    ],
                    "common_phrases": [
                        "blessure fatale",
                        "coup fatal",
                        "issue fatale"
                    ]
                },
                {
                    "sense_id": "6c183bfe-6efd-33c4-9405-3d6f0f5f419d",
                    "sense_definition": "Qu'on ne peut éviter, qui arrive inévitablement en vertu du destin ou des circonstances.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans un entraînement sérieux, l'échec à cette compétition était tout à fait <w>fatal</w>."
                        },
                        {
                            "text": "Quand l'heure <w>fatale</w> approche, rien ne peut retarder la fin du délai imposé."
                        }
                    ],
                    "synonyms": [
                        "inéluctable",
                        "inévitable"
                    ],
                    "antonyms": [
                        "évitable"
                    ],
                    "common_phrases": [
                        "heure fatale"
                    ]
                },
                {
                    "sense_id": "31441fcc-b39f-3fe9-b437-84a2ff10edad",
                    "sense_definition": "Qui cause des malheurs irréversibles ou entraîne la ruine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette erreur de gestion s'est révélée <w>fatale</w> pour l'avenir de l'entreprise familiale."
                        },
                        {
                            "text": "Ce retard de quelques minutes a été <w>fatal</w> à nos chances d'obtenir le contrat."
                        }
                    ],
                    "synonyms": [
                        "catastrophique",
                        "désastreux",
                        "funeste",
                        "néfaste"
                    ],
                    "antonyms": [
                        "bénéfique",
                        "salutaire"
                    ],
                    "common_phrases": [
                        "erreur fatale"
                    ]
                },
                {
                    "sense_id": "b8b0d827-1683-38c5-8368-37dec0a5d595",
                    "sense_definition": "Qui exerce une séduction irrésistible et souvent dangereuse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "seduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce classique du cinéma, l'actrice incarne une femme <w>fatale</w> redoutable."
                        },
                        {
                            "text": "Son charme <w>fatal</w> finissait toujours par troubler tous ceux qui l'approchaient."
                        }
                    ],
                    "synonyms": [
                        "envoûtant",
                        "irrésistible"
                    ],
                    "antonyms": [
                        "repoussant"
                    ],
                    "common_phrases": [
                        "femme fatale"
                    ]
                }
            ]
        }
    ]
}