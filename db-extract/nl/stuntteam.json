                        "entry_id": "12c058d9-cdfa-3b57-adc6-1b97898efff2",
                        "glosses": [
                            "groep mensen die samen gevaarlijke stunts uitvoeren ter vermaak van het publiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d4687c3-0da6-4a30-a3b7-48165506ef61",
                                "sense_id": "9b051d86-4f80-37c4-850d-1e2d8f14be2c",
                                "text": "\"Ik was ervan op de hoogte dat een stuntteam werk zou gaan uitvoeren in ons dorp. Die vergunning is verleend. Ik wist niet dat er een monstertruck bij was\", aldus Gerritsen."
                            },
                            {
                                "example_id": "85ffbb3b-75c7-4d4d-a739-72039d39cf95",
                                "sense_id": "9b051d86-4f80-37c4-850d-1e2d8f14be2c",
                                "text": "Zo'n 130.000 Britten juichten de koningin toe toen ze samen met haar man prins Phillip, vlak voor de paardenraces op de renbaan Epsom, werd rondgereden over het parkoers. Daarna werd de 86-jarige vorstin getrakteerd op een luchtshow van het stuntteam 'The Red Arrows'."
                            }
                        ]
                    }
