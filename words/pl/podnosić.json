{
    "word_family": [
        "podnieść",
        "podnośnik",
        "podnoszenie",
        "wynosić",
        "unosić"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9e27561-00ea-3fb6-b235-357a8b438709",
                    "sense_definition": "brać coś do góry lub przemieszczać w wyższe położenie",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ruch_w_gore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chłopiec schyla się i powoli <w>podnosi</w> z ziemi ciężki plecak.",
                            "target_lang_translations": {
                                "ru": "Мальчик наклоняется и медленно <w>поднимает</w> с земли тяжёлый рюкзак."
                            }
                        },
                        {
                            "text": "Uczeń grzecznie <w>podnosi</w> rękę, ponieważ chce zadać nauczycielowi pytanie.",
                            "target_lang_translations": {
                                "ru": "Ученик вежливо <w>поднимает</w> руку, потому что хочет задать вопрос учителю."
                            }
                        }
                    ],
                    "synonyms": [
                        "unosić"
                    ],
                    "antonyms": [
                        "opuszczać"
                    ],
                    "common_phrases": [
                        "podnosić rękę",
                        "podnosić wzrok",
                        "podnosić głowę"
                    ],
                    "target_lang_definitions": {
                        "ru": "брать что-либо вверх или перемещать в более высокое положение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "руку, взгляд, лежащий предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db9597bc-9a8e-3f05-ada6-58ee4aa138b2",
                    "sense_definition": "sprawiać, że coś staje się większe pod względem wartości, stopnia lub natężenia",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zwiekszanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Właściciel sklepu regularnie <w>podnosi</w> ceny z powodu rosnących kosztów.",
                            "target_lang_translations": {
                                "ru": "Владелец магазина регулярно <w>поднимает</w> цены из-за растущих расходов."
                            }
                        },
                        {
                            "text": "Kiedy się denerwuje, często niepotrzebnie <w>podnosi</w> głos na innych.",
                            "target_lang_translations": {
                                "ru": "Когда он нервничает, он часто без надобности <w>повышает</w> голос на окружающих."
                            }
                        }
                    ],
                    "antonyms": [
                        "opuszczać"
                    ],
                    "common_phrases": [
                        "podnosić ceny",
                        "podnosić głos",
                        "podnosić kwalifikacje"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать что-либо больше по значению, уровню или интенсивности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "цены, голос"
                            },
                            {
                                "target_lang_word": "повышать",
                                "target_lang_sense_clarification": "квалификацию, уровень, цены"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "652c0896-ce3c-3c93-a78f-fdcaea51d921",
                    "sense_definition": "ustawiać coś przewróconego w pozycji pionowej",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pionowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wiatr przewrócił drewniane krzesło, więc sąsiad szybko je <w>podnosi</w>.",
                            "target_lang_translations": {
                                "ru": "Ветер опрокинул деревянный стул, поэтому сосед быстро его <w>поднимает</w>."
                            }
                        },
                        {
                            "text": "Pracownik ostrożnie <w>podnosi</w> przewróconą barierkę przy drodze.",
                            "target_lang_translations": {
                                "ru": "Работник осторожно <w>поднимает</w> упавшее ограждение у дороги."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ставить упавший или опрокинутый предмет в вертикальное положение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "упавший предмет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8677d585-9f4a-38f0-b6e3-97a75d1bcadb",
                    "sense_definition": "umieszczać coś na większej wysokości lub montować wyżej",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch_w_gore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mechanik <w>podnosi</w> cały blat roboczy, aby dopasować go do swojego wzrostu.",
                            "target_lang_translations": {
                                "ru": "Механик <w>приподнимает</w> всю рабочую поверхность, чтобы подогнать её под свой рост."
                            }
                        },
                        {
                            "text": "Ekipa budowlana <w>podnosi</w> poziom podłogi przed ułożeniem nowych płytek.",
                            "target_lang_translations": {
                                "ru": "Строительная бригада <w>поднимает</w> уровень пола перед укладкой новой плитки."
                            }
                        }
                    ],
                    "antonyms": [
                        "opuszczać"
                    ],
                    "common_phrases": [
                        "podnosić poprzeczkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "помещать что-либо на бóльшую высоту или монтировать выше"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "уровень чего-либо, планку"
                            },
                            {
                                "target_lang_word": "приподнимать",
                                "target_lang_sense_clarification": "столешницу, конструкцию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "127f103d-9db4-38f7-b6fe-5094d889d24b",
                    "sense_definition": "dźwigać lub wciągać ciężkie przedmioty w górę za pomocą maszyn lub lin",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ruch_w_gore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Potężny dźwig na budowie bez trudu <w>podnosi</w> stalowe konstrukcje na dach.",
                            "target_lang_translations": {
                                "ru": "Мощный строительный кран без труда <w>поднимает</w> стальные конструкции на крышу."
                            }
                        },
                        {
                            "text": "Załoga statku powoli <w>podnosi</w> ładunek z pokładu na nabrzeże portowe.",
                            "target_lang_translations": {
                                "ru": "Экипаж судна медленно <w>поднимает</w> груз с палубы на портовую набережную."
                            }
                        }
                    ],
                    "synonyms": [
                        "unosić"
                    ],
                    "antonyms": [
                        "opuszczać"
                    ],
                    "target_lang_definitions": {
                        "ru": "поднимать тяжелые предметы вверх с помощью машин или тросов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "грузы краном, лебёдкой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}