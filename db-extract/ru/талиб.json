                                "target_senses": [
                                    {
                                        "sense_id": "d08fc1cf-85a3-37e5-8059-a861372c2d6f",
                                        "entry_id": "54e1c4b5-3994-37dc-bc07-0f610ffe1276",
                                        "glosses": [
                                            "A member of the Taliban."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da40a1e8-b86d-4d30-ad43-81f5a81d0b39",
                                                "sense_id": "d08fc1cf-85a3-37e5-8059-a861372c2d6f",
                                                "text": "The Talib lifted his Kalashnikov and fired rounds into the air. Another Talib behind him brandished a whip."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
