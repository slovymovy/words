    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ee328b7-d45e-32a4-af3f-09034235e73e",
                    "sense_definition": "jemandem mit den Händen oder einem Gegenstand die Kehle zudrücken, sodass die Atmung behindert wird",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ersticken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Angreifer versuchte, sein wehrloses Opfer mit beiden Händen zu <w>würgen</w>."
                        },
                        {
                            "text": "Der enge Kragen des Hemdes <w>würgte</w> ihn den ganzen Abend lang."
                        }
                    ],
                    "synonyms": [
                        "erdrosseln",
                        "erwürgen"
                    ],
                    "common_phrases": [
                        "jemanden am Hals würgen"
                    ]
                },
                {
                    "sense_id": "45fd3d13-518a-3710-ba68-37417b8de545",
                    "sense_definition": "krampfhafte Bewegungen im Rachen oder Magen machen, als müsste man sich übergeben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "brechreiz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen des widerlichen Geruchs im Treppenhaus musste der Hausmeister plötzlich heftig <w>würgen</w>."
                        },
                        {
                            "text": "Das kranke Kind bekam einen Hustenanfall und begann kurz darauf zu <w>würgen</w>."
                        }
                    ],
                    "common_phrases": [
                        "vor Ekel würgen"
                    ]
                },
                {
                    "sense_id": "2f60f014-c6c8-3fe7-8b8f-112bbb9a742d",
                    "sense_definition": "große Mühe haben, etwas hinunterzuschlucken, oder sich fast daran verschlucken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schluckbeschwerden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Junge <w>würgte</w> an einem viel zu großen Stück trockenem Brot."
                        },
                        {
                            "text": "Weil das Fleisch extrem zäh war, <w>würgte</w> sie lange an jedem einzelnen Bissen."
                        }
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "an einem Bissen würgen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bdbf9b8f-9c8f-3a5b-99cb-b547bbdc7afe",
                    "sense_definition": "das Auftreten eines Brechreizes oder Zudrücken der Kehle; Substantivierung des Verbs <w>würgen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "substantivierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein plötzliches <w>Würgen</w> im Hals hinderte ihn daran, den begonnenen Satz zu beenden."
                        },
                        {
                            "text": "Nach dem Verzehr der verdorbenen Mahlzeit litt der Patient unter anhaltendem und schmerzhaftem <w>Würgen</w>."
                        }
                    ]
                }
            ]
        }
    ]
