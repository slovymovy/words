                        "source_sense_id": "7a2576e7-04f6-3e3e-bb7a-c56cf2bd6c81",
                        "source_sense_description": "Erkrankung der Wirbelsäule",
                        "target_lang_word": "hernie discale",
                        "target_lang_code": "fr",
