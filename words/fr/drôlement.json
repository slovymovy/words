                {
                    "sense_id": "e8e102b0-aca8-31af-92b1-fab50b029c46",
                    "sense_definition": "S'emploie de manière ironique dans une réponse pour signifier le contraire de ce qui est demandé ou affirmé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu penses qu'il a apprécié ta remarque ? — Oui, <w>drôlement</w> !",
                            "target_lang_translations": {
                                "en": "Do you think he appreciated your comment? — <w>Yeah, right</w>!",
                                "ru": "Ты думаешь, ему понравилось твоё замечание? — <w>Ну да, как же</w>!",
                                "nl": "Denk je dat hij je opmerking heeft gewaardeerd? — <w>Ja hoor</w>!",
                                "de": "Glaubst du, dass ihm deine Bemerkung gefallen hat? — <w>Na klar</w>!",
                                "pl": "Myślisz, że docenił twoją uwagę? — <w>Akurat</w>!",
                                "it": "Pensi che abbia apprezzato il tuo commento? — <w>Figuriamoci</w>!",
                                "cs": "Myslíš, že ocenil tvou poznámku? — No <w>jasně</w>!",
                                "tr": "Senin yorumunu beğendiğini mi düşünüyorsun? — <w>Tabii</w> ya!",
                                "es": "¿Crees que le ha gustado tu comentario? — ¡<w>Ya, claro</w>!",
                                "zh": "你觉得他喜欢你刚才那句评论吗？——<w>才怪</w>呢！"
                            }
                        },
                        {
                            "text": "Vous avez reçu de l'aide pour les travaux ? — Oui, <w>drôlement</w>, j'ai tout fait seul.",
                            "target_lang_translations": {
                                "en": "Did you get any help with the work? — <w>Oh, sure</w>, I did it all by myself.",
                                "ru": "Вам помогли с ремонтом? — <w>Ага, конечно</w>, я всё сделал сам.",
                                "nl": "Heeft u hulp gehad bij de klussen? — <w>Ja, tuurlijk</w>, ik heb alles alleen gedaan.",
                                "de": "Haben Sie bei den Arbeiten Hilfe bekommen? — <w>Ja klar</w>, ich habe alles allein gemacht.",
                                "pl": "Miał Pan jakąś pomoc przy remoncie? — <w>No pewnie</w>, wszystko zrobiłem sam.",
                                "it": "Ha avuto aiuto per i lavori? — <w>Come no</w>, ho fatto tutto da solo.",
                                "cs": "Dostal jste při těch pracích nějakou pomoc? — No, <w>samozřejmě</w>, všechno jsem udělal sám.",
                                "tr": "Tadilatta yardım aldınız mı? — <w>Elbette</w>, her şeyi tek başıma yaptım.",
                                "es": "¿Recibió ayuda para las obras? — <w>Cómo no</w>, lo hice todo solo.",
                                "zh": "您装修的时候有人帮忙吗？——<w>当然</w>啦，都是我一个人干的。"
                            }
                        }
