{
    "word_family": [
        "rebater"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91291257-94ce-3dab-b6b0-71f5b634721d",
                    "sense_definition": "A partial refund or return of an amount already paid for a product or service.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_deduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company offered a fifty dollar <w>rebate</w> to customers who purchased the new smartphone before December.",
                            "target_lang_translations": {
                                "ru": "Компания предложила <w>возврат</w> пятидесяти долларов клиентам, купившим новый смартфон до декабря."
                            }
                        },
                        {
                            "text": "You can claim a <w>rebate</w> by mailing in your original receipt and the completed form.",
                            "target_lang_translations": {
                                "ru": "Вы можете запросить <w>возврат части средств</w>, отправив по почте оригинал чека и заполненную форму."
                            }
                        }
                    ],
                    "common_phrases": [
                        "claim a rebate",
                        "mail-in rebate",
                        "tax rebate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Частичный возврат суммы, уже уплаченной за товар или услугу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возврат части платежа",
                                "target_lang_sense_clarification": "денежная сумма"
                            },
                            {
                                "target_lang_word": "рибейт",
                                "target_lang_sense_clarification": "маркетинговый термин"
                            },
                            {
                                "target_lang_word": "скидка",
                                "target_lang_sense_clarification": "в форме возврата средств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6801e357-1eaf-3834-9786-24eb5802ab6b",
                    "sense_definition": "A deduction or discount from a total amount that is due to be paid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_deduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contractor agreed to a small <w>rebate</w> on the final bill because the project was finished late.",
                            "target_lang_translations": {
                                "ru": "Подрядчик согласился на небольшую <w>скидку</w> в итоговом счете, так как проект был завершен с опозданием."
                            }
                        },
                        {
                            "text": "The government announced a <w>rebate</w> on energy bills to help families with the rising cost of living.",
                            "target_lang_translations": {
                                "ru": "Правительство объявило о <w>вычете</w> из счетов за электроэнергию, чтобы помочь семьям в условиях роста стоимости жизни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "energy bill rebate",
                        "rent rebate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вычет или скидка с общей суммы, подлежащей оплате."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скидка",
                                "target_lang_sense_clarification": "с цены или счета"
                            },
                            {
                                "target_lang_word": "уступка",
                                "target_lang_sense_clarification": "в цене"
                            },
                            {
                                "target_lang_word": "вычет",
                                "target_lang_sense_clarification": "из суммы платежа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c79af07-0554-3bc1-876e-1651c8bc9df7",
                    "sense_definition": "A rectangular groove or step cut into the edge of a piece of wood or stone to join it with another piece.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "woodworking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For your existing windows, the glazing <w>rebates</w> will also have to be deepened to provide the extra gap.",
                            "target_lang_translations": {
                                "ru": "В ваших существующих окнах оконные <w>фальцы</w> также придется углубить, чтобы обеспечить дополнительный зазор."
                            }
                        },
                        {
                            "text": "The carpenter used a specialized plane to create a clean <w>rebate</w> along the edge of the door frame.",
                            "target_lang_translations": {
                                "ru": "Плотник использовал специальный рубанок, чтобы сделать чистую <w>четверть</w> по краю дверной коробки."
                            }
                        }
                    ],
                    "synonyms": [
                        "rabbet"
                    ],
                    "common_phrases": [
                        "glazing rebate",
                        "cut a rebate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямоугольный паз или уступ, вырезанный на кромке дерева или камня для соединения с другой деталью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фальц",
                                "target_lang_sense_clarification": "в столярном деле"
                            },
                            {
                                "target_lang_word": "четверть",
                                "target_lang_sense_clarification": "вид выемки в дереве"
                            },
                            {
                                "target_lang_word": "паз",
                                "target_lang_sense_clarification": "выемка на кромке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6422d8a3-a7a9-354f-9557-fe8f0433b8c7",
                    "sense_definition": "To return a portion of a payment or to deduct an amount from a bill.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "financial_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manufacturer decided to <w>rebate</w> ten percent of the purchase price to all early adopters.",
                            "target_lang_translations": {
                                "ru": "Производитель решил <w>вернуть</w> десять процентов от покупной цены всем первым покупателям."
                            }
                        },
                        {
                            "text": "If you pay the full amount upfront, the service provider will <w>rebate</w> the processing fee.",
                            "target_lang_translations": {
                                "ru": "Если вы оплатите всю сумму авансом, поставщик услуг <w>вернет</w> комиссию за обработку платежа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rebate the cost",
                        "rebate a portion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуть часть платежа или вычесть сумму из счета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвращать часть суммы",
                                "target_lang_sense_clarification": "после оплаты"
                            },
                            {
                                "target_lang_word": "делать скидку",
                                "target_lang_sense_clarification": "вычитать из счета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa0321f7-e0ff-3157-99ba-74a3b41e733c",
                    "sense_definition": "To cut a rectangular groove or step into the edge of a material, typically wood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "woodworking_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needed to <w>rebate</w> the edges of the boards so they would fit together seamlessly.",
                            "target_lang_translations": {
                                "ru": "Ему нужно было <w>выбрать четверти</w> на краях досок, чтобы они плотно прилегали друг к другу."
                            }
                        },
                        {
                            "text": "The apprentice learned how to <w>rebate</w> a timber frame using traditional hand tools.",
                            "target_lang_translations": {
                                "ru": "Подмастерье учился <w>делать фальцы</w> в деревянной раме, используя традиционные ручные инструменты."
                            }
                        }
                    ],
                    "synonyms": [
                        "rabbet"
                    ],
                    "common_phrases": [
                        "rebate the edge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вырезать прямоугольный паз или уступ на кромке материала, обычно дерева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбирать четверть",
                                "target_lang_sense_clarification": "в столярном деле"
                            },
                            {
                                "target_lang_word": "фальцевать",
                                "target_lang_sense_clarification": "делать выемку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f364bee-0fc7-33f0-acca-4bd66112b46f",
                    "sense_definition": "To make something less sharp or keen; to blunt the edge or point of a weapon or tool.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "blunting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight chose to <w>rebate</w> his sword before the practice match to avoid injuring his opponent.",
                            "target_lang_translations": {
                                "ru": "Рыцарь решил <w>затупить</w> свой меч перед тренировочным поединком, чтобы не ранить противника."
                            }
                        },
                        {
                            "text": "Years of neglect served to <w>rebate</w> the once sharp blade of the old garden shears.",
                            "target_lang_translations": {
                                "ru": "Годы небрежного обращения <w>затупили</w> когда-то острое лезвие старого садового секатора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rebate the edge"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or literary contexts regarding weaponry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо менее острым; затупить лезвие или острие оружия или инструмента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тупить",
                                "target_lang_sense_clarification": "делать менее острым"
                            },
                            {
                                "target_lang_word": "притуплять",
                                "target_lang_sense_clarification": "острие или лезвие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}