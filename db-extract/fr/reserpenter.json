                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32cfbd78-0123-44d1-8073-ea0934913a05",
                                "sense_id": "db75f1b4-c7f6-39db-b1a5-967acd45f2b6",
                                "text": "Ils choisissent un arbre, mais après avoir pris quelque hauteur, les voici tous qui bêlent et reserpentent vers la terre."
                            },
                            {
                                "example_id": "d1e11718-f40c-4c41-9990-20e7d995d304",
                                "sense_id": "db75f1b4-c7f6-39db-b1a5-967acd45f2b6",
                                "text": "Le temps de saluer une ou deux chapelles pour rateurs de virages, et le sentier pentu reserpente à travers la forêt décharnée de Chora."
                            }
                        ]
                    }
