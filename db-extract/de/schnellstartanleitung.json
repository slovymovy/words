                ],
                "senses": [
                    {
                        "sense_id": "726aa9e4-c706-3acf-9196-4ef173242be8",
                        "entry_id": "eb7f90e9-e13b-324d-a39d-dc5133fbd56d",
                        "glosses": [
                            "Anleitung, die die wichtigsten Schritte beschreibt, um ein Produkt schnell und einfach in Betrieb zu nehmen oder zu verwenden, sodass Nutzer das Produkt sofort nutzen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343d9e8a-08a8-4cd6-aef3-0ca125ca0df9",
                                "sense_id": "726aa9e4-c706-3acf-9196-4ef173242be8",
                                "text": "„In der Verpackung befinden sich eine automatische Entleerungsstation, der Mini-Saugroboter und der Mopp, ein Beutel mit einem Ersatzfilter, ein Staubbeutel, ein Paket mit Einwegmopptüchern, eine Schnellstartanleitung und ein Benutzerhandbuch.“"
                            },
                            {
                                "example_id": "a54f5586-2081-45ae-9133-bbd750b20479",
                                "sense_id": "726aa9e4-c706-3acf-9196-4ef173242be8",
                                "text": "„Hierfür wird einfach über den QR-Code an der Unterseite oder in der Schnellstartanleitung die Website aufgerufen und den Anweisungen gefolgt.“"
                            },
                            {
                                "example_id": "4984d867-57b8-40b1-a9d7-571c4c4adac2",
                                "sense_id": "726aa9e4-c706-3acf-9196-4ef173242be8",
                                "text": "„Die einzelnen Schritte beschreibt Microsoft in der Schnellstartanleitung zur Inbetriebnahme von Dev Boxes.“"
                            },
                            {
                                "example_id": "3bc7f9d0-de4b-4f19-9a80-db22fa417e08",
                                "sense_id": "726aa9e4-c706-3acf-9196-4ef173242be8",
                                "text": "„Mithilfe dieser Schnellstartanleitung ist es ein Kinderspiel [sic!] die AiO einzubauen.“"
                            },
                            {
                                "example_id": "6a35f0da-6b90-4ce2-a963-03ee966e2482",
                                "sense_id": "726aa9e4-c706-3acf-9196-4ef173242be8",
                                "text": "„Zum Lieferumfang gehören neben der Konsole, [sic!] ein USB-Typ-C-Kabel, ein USB-Typ C-auf-USB-Typ A-Adapter, ein Standfuß aus Kunststoff sowie eine Schnellstartanleitung und eine Garantiekarte.“"
                            },
                            {
                                "example_id": "3fd29a58-fec8-4931-ae65-99b6a80569b0",
                                "sense_id": "726aa9e4-c706-3acf-9196-4ef173242be8",
                                "text": "„Im Set mit dem iopool EcO Wassermonitor kommt eine Schnellstartanleitung auf Französisch, Englisch, Niederländisch und Spanisch.“"
                            },
                            {
                                "example_id": "6b997373-8404-44cf-b775-78be6f204d89",
                                "sense_id": "726aa9e4-c706-3acf-9196-4ef173242be8",
                                "text": "„Dank einer Schnellstartanleitung kommt nie Langeweile auf und das Produkt kann sofort ausprobiert werden.“"
                            },
                            {
                                "example_id": "31902a87-3fef-4351-a817-8b1fd27c6212",
                                "sense_id": "726aa9e4-c706-3acf-9196-4ef173242be8",
                                "text": "„Öffnet man den Deckel, sieht man auf dessen Innenseite die Schnellstartanleitung, auf der rechten Seite das Zubehör und links das TREZOR Model T.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
