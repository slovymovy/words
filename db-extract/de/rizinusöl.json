                ],
                "senses": [
                    {
                        "sense_id": "a9f25d52-8a97-3c48-b2c3-13f752f1237c",
                        "entry_id": "963fb4a2-6afb-3cec-a4e7-f0c14f55092c",
                        "glosses": [
                            "Öl aus dem Samen des Rizinus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "183e5021-f76d-48ac-ae88-dc3956394f2d",
                                "sense_id": "a9f25d52-8a97-3c48-b2c3-13f752f1237c",
                                "text": "„Wir wissen, daß wir Heinrich von Riesenfeld fernhalten werden, selbst wenn wir ihn besoffen machen oder ihm Rizinusöl in seinen Sonntagsfrühschoppen mischen müssen.“"
                            },
                            {
                                "example_id": "608e85f9-c186-4d41-877f-7544694b7d3e",
                                "sense_id": "a9f25d52-8a97-3c48-b2c3-13f752f1237c",
                                "text": "„Holmes behauptet, er habe zufällig gehört, wie ich ihn gewarnt hätte, mehr als zwei Tropfen Rizinusöl zu nehmen, während ich ihm gleichzeitig Strychnin in großen Dosen als Beruhigungsmittel empfahl.“"
                            },
                            {
                                "example_id": "e9cf2b3d-a419-4a45-a192-23ee341b87ef",
                                "sense_id": "a9f25d52-8a97-3c48-b2c3-13f752f1237c",
                                "text": "„Was sie nicht bemerkt haben: Toller und Hasenclever hatten die Kartoffelpuffer in Rizinusöl gebacken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
