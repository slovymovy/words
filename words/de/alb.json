                    "sense_id": "9f9a3616-8473-3cfe-b301-6581ae9c189b",
                    "sense_definition": "Meist unheimlicher oder böswilliger Naturgeist in den Mythen und Sagen des germanischen Altertums.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In den alten germanischen Sagen warnte man die Dorfbewohner vor dem heimtückischen <w>Alb</w> im Wald."
                        },
                        {
                            "text": "Die Menschen glaubten damals, dass böse <w>Alben</w> den Schlafenden die Luft abschnüren könnten."
                        }
                    ],
                    "synonyms": [
                        "Elb",
                        "Elf"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vor allem in der germanischen Mythologie und Sage gebräuchlich"
                        }
                    ]
                },
                {
                    "sense_id": "bb620153-897e-3d5e-b20e-682381b6a112",
                    "sense_definition": "Zustand quälender seelischer Bedrückung, beklemmender Angst oder Albtraum.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychische_belastung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der schrecklichen Nachricht lag die Sorge wie ein finsterer <w>Alb</w> auf ihrer Seele."
                        },
                        {
                            "text": "Er wachte mitten in der Nacht schweißgebadet auf, als hätte ihn ein böser <w>Alb</w> heimgesucht."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "heute weitgehend durch Albtraum ersetzt"
                        }
                    ]
                }
            ]
        },
        {
