                ],
                "senses": [
                    {
                        "sense_id": "f402c3af-04a7-3b71-9f3b-51a57fda1f13",
                        "entry_id": "34accab4-93f3-324f-bdc1-ab34c8bd0e55",
                        "glosses": [
                            "Eintopf aus Norddeutschland, der je nach Rezept aus Kartoffeln, Gewürzgurken und Corned Beef oder aus geschmortem Weißkohl und Hackfleisch besteht"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "e3a2b9b5-43ae-4de6-aa5a-8fec151d1e6d",
                                "sense_id": "f402c3af-04a7-3b71-9f3b-51a57fda1f13",
                                "text": "Er schälte die Kartoffeln mit einem Lächeln im Gesicht, denn heute gab es Moppelkotze."
                            },
                            {
                                "example_id": "172dcde0-1f93-416f-9419-3354bb4eda42",
                                "sense_id": "f402c3af-04a7-3b71-9f3b-51a57fda1f13",
                                "text": "„Genauso schlicht und ähnlichen Inhalts gestaltet sich die Moppelkotze (pürierte Kartoffeln, Äpfel, Wurst, Gewürzgurken, Corned Beef). Der Name schildert das Gekochte tatsächlich so unfein, wie es auch unkundige Leser vermuten würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "86404910-338e-3e76-9e8f-fdbf6e3cee62",
                        "entry_id": "34accab4-93f3-324f-bdc1-ab34c8bd0e55",
                        "glosses": [
                            "Eintopf aus Berlin, der zum Beispiel aus grünen Bohnen und Gurke („Gartenwurst“ genannt) besteht oder auch Dosenrindfleisch aus der sogenannten Senatsreserve enthält"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "772460bc-b950-4e08-993c-06c1089c8194",
                                "sense_id": "86404910-338e-3e76-9e8f-fdbf6e3cee62",
                                "text": "Kasseler mit Sauerkraut, Döner mit allem, Moppelkotze mit Gartenwurst (wie der Berliner liebevoll den Bohneneintopf mit Gurke nennt), dazu eine Berliner Weiße rot oder grün – herrlich."
                            },
                            {
                                "example_id": "7f4c676a-c9a9-4d8d-8944-6252f4c1d4bd",
                                "sense_id": "86404910-338e-3e76-9e8f-fdbf6e3cee62",
                                "text": "„In vielen Berliner Haushalten gehörte etwa die Moppelkotze, der Eintopf aus Beständen der Senatsreserve, zum festen Speiseplan.“"
                            },
                            {
                                "example_id": "b0fff878-5eac-4a25-b619-704acaf7f514",
                                "sense_id": "86404910-338e-3e76-9e8f-fdbf6e3cee62",
                                "text": "Besonders die Konserven mit Rinder- und Schweinefleisch zu minimalen Preisen erfreuten sich bei Berliner Hausfrauen wachsender Beliebtheit. Aus diesen Senatsbüchsen kreierten sie mit Zutaten der Phantasie die berühmte Berliner \"Moppelkotze\"."
                            },
                            {
                                "example_id": "2315b865-599b-4d28-b29a-3b255ebac54c",
                                "sense_id": "86404910-338e-3e76-9e8f-fdbf6e3cee62",
                                "text": "„Broiler wird bejubelt, obwohl man ihn „Gummiadler“ nennt, Kochklops geht auch noch. „Tote Oma“, „Kinderpuller“, „Verkehrsunfall“, „Moppelkotze“ und „Elefantenpopel“ sind weniger beliebt.“"
                            },
                            {
                                "example_id": "8f7f3f89-f046-4b51-9cc5-7828f7d3e450",
                                "sense_id": "86404910-338e-3e76-9e8f-fdbf6e3cee62",
                                "text": "Selbst in Kochbüchern war die Senatsreserve ein normaler Bestandteil. Ein Rezept mit dem Vertrauen erweckenden Namen »Moppelkotze« beginnt ganz selbstverständlich mit der Zutat: eine Dose Senatsreserve."
                            },
                            {
                                "example_id": "ade23d21-4260-4336-bc3f-6ccb6c35ed1a",
                                "sense_id": "86404910-338e-3e76-9e8f-fdbf6e3cee62",
                                "text": "Sonntags gibt es ein Schmankerl: Konservenfleisch mit grünen Bohnen und Kartoffelpüree, kurz \"Moppelkotze\"."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6bd429d4-acae-3ab0-9b41-68e204d6503b",
                        "entry_id": "34accab4-93f3-324f-bdc1-ab34c8bd0e55",
                        "glosses": [
                            "Fleischsalat"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "40bb3b43-8b1c-481f-a230-c6ca75e01fb2",
                                "sense_id": "6bd429d4-acae-3ab0-9b41-68e204d6503b",
                                "text": "„Abends holte jemand einen Plastiktopf mit „Fleischsalat“ aus dem Kühlschrank und sagte: det is Moppelkotze.“"
                            },
                            {
                                "example_id": "08bc5f17-26d0-4d3e-aefb-774b55d020a9",
                                "sense_id": "6bd429d4-acae-3ab0-9b41-68e204d6503b",
                                "text": "Wenn er det nich' weeß, sagte der Alte, dann kennt er unsre schöne Moppelkotze ja ooch nich', diesen klein ge- schnibbelten roten Wurstsalat für'n Mittach."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "72e08dea-4443-3892-a922-4aa9b21d8010",
                        "entry_id": "34accab4-93f3-324f-bdc1-ab34c8bd0e55",
                        "glosses": [
                            "etwas Schlechtes, Unsinniges, Unerwünschtes oder auch Ekelerregendes"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "35ba4442-150c-43be-8bb5-1e9be4b96b63",
                                "sense_id": "72e08dea-4443-3892-a922-4aa9b21d8010",
                                "text": "Alles Moppelkotze!"
                            },
                            {
                                "example_id": "1864b50d-a0be-4842-ba9f-b5bafbe9edb1",
                                "sense_id": "72e08dea-4443-3892-a922-4aa9b21d8010",
                                "text": "Mario kommt: “MoppelKotze in dem neuen Imbiß. Hoab Ieh mal probiert. Schmeckt nieh, eefach wiederlich“."
                            },
                            {
                                "example_id": "ed02df49-cfe1-45ac-b48c-abd9784971ca",
                                "sense_id": "72e08dea-4443-3892-a922-4aa9b21d8010",
                                "text": "Ich erinnere mich auch an „Moppelkotze“, ein Begriff aus meiner Kindheit, den ich in Verbindung mit der „geliebten Schulspeisung“ bringe. Da wurde oft Essen angeboten, das zum Kotzen schmeckte."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
