                    {
                        "sense_id": "1dc11a21-5e72-3d8f-a0ad-aa563fc96250",
                        "entry_id": "ee87a9dd-639c-3b63-ab2e-0d9596629c00",
                        "glosses": [
                            "aus Los Angeles stammende Straßengang"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "178fb7d9-bbb5-431b-b237-1aa20059a8e5",
                                "sense_id": "1dc11a21-5e72-3d8f-a0ad-aa563fc96250",
                                "text": "„In der Einfahrt stand noch ein Pick-up Truck, ein knallroter, ziemlich neuer Dodge Ram, und der Südstaatenflaggenaufkleber im Rückfenster verriet Court, dass weder die Blacks noch die Crips noch die Bloods von D.C. hier ihren Stützpunkt hatten.“"
                            },
                            {
                                "example_id": "30d2568f-812b-4cf6-84c8-9eb1ba112d47",
                                "sense_id": "1dc11a21-5e72-3d8f-a0ad-aa563fc96250",
                                "text": "„Wer ein Tatto hat, in dem das B durchgestrichen ist, gehört zu den Crips.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2bfb7e4a-fbe1-3422-acea-270abb425cec",
                        "entry_id": "ee87a9dd-639c-3b63-ab2e-0d9596629c00",
                        "glosses": [
                            "ein Mitglied dieser Gang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fd6e904-f85c-4f94-88d0-b529261cc7ce",
                                "sense_id": "2bfb7e4a-fbe1-3422-acea-270abb425cec",
                                "text": "„An der ersten liegt ein toter Crip auf dem Gehweg.“"
                            },
                            {
                                "example_id": "e4afd01f-41bf-4503-b98f-a7cae3ef00b6",
                                "sense_id": "2bfb7e4a-fbe1-3422-acea-270abb425cec",
                                "text": "„›Ja, Joseph, Doo-Rag und seine Kumpel auf der Straße würden durchaus Anweisungen von einem ehemaligen Crip annehmen, solange dabei ausreichend Geld für sie herausspringt.‹“"
                            }
                        ],
