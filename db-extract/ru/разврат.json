                "senses": [
                    {
                        "sense_id": "d81146d3-b9b0-380f-9be0-ad45a05faae5",
                        "entry_id": "84d42be0-8e52-3b74-b4ef-712ea5677476",
                        "glosses": [
                            "debauch, debauchery, depravity, dissipation, lechery"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff5ea04-406b-43ad-9d83-cf252bf97a1c",
                                "sense_id": "d81146d3-b9b0-380f-9be0-ad45a05faae5",
                                "text": "Развра́т был характе́рен для э́того вре́мени.",
                                "translation": "Debauchery was characteristic for this time.",
                                "english": "Debauchery was characteristic for this time."
                            },
                            {
                                "example_id": "a1003dec-fd94-4fe8-9128-5c607a0a6814",
                                "sense_id": "d81146d3-b9b0-380f-9be0-ad45a05faae5",
                                "text": "— Где вы — там развра́т, зло, — сказа́л Пьер жене́. — Анато́ль, пойдёмте, мне на́до поговори́ть с ва́ми, — сказа́л он по-францу́зски.",
                                "translation": "“Where you are, there is vice and evil!” said Pierre to his wife. “Anatole, come with me! I must speak to you,” he added in French.",
                                "english": "“Where you are, there is vice and evil!” said Pierre to his wife. “Anatole, come with me! I must speak to you,” he added in French."
                            }
                        ]
                    }
                ],
