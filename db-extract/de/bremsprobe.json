                "senses": [
                    {
                        "sense_id": "8ee955bc-8d4f-3250-bb66-e4d5667833fe",
                        "entry_id": "90084df4-9eda-3d30-a636-9ac624ec8722",
                        "glosses": [
                            "Vorgang zur Überprüfung der Funktionstüchtigkeit einer Bremsanlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0477c4f-a0cd-48e0-91db-992ae57501c7",
                                "sense_id": "8ee955bc-8d4f-3250-bb66-e4d5667833fe",
                                "text": "„Es gehört zu seiner täglichen Aufgabe, vor Beginn der Schicht das Zugseil zu inspizieren, eine Bremsprobe durchzuführen und darauf zu achten, dass sich die beförderten Güter richtig ‚einschleifen‘.“"
                            },
                            {
                                "example_id": "c82395b7-cf74-4db5-af3d-a0220583ce64",
                                "sense_id": "8ee955bc-8d4f-3250-bb66-e4d5667833fe",
                                "text": "„Er soll es unterlassen haben, den Bremsabsperrhahn zu öffnen und eine abschließende Bremsprobe durchzuführen.“"
                            },
                            {
                                "example_id": "b8f252bd-aa9e-448d-9cbe-4d7a1525d95f",
                                "sense_id": "8ee955bc-8d4f-3250-bb66-e4d5667833fe",
                                "text": "„Die eine Lok wegfahren, die andere startklar machen und ankuppeln, dann Bremsprobe – die Zeit verrinnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
