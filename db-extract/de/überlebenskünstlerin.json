                "senses": [
                    {
                        "sense_id": "be517372-dae6-31ec-9c8f-8d756ec993f3",
                        "entry_id": "8517941e-0924-3ec0-8dca-1c2a41d7288c",
                        "glosses": [
                            "weibliche Person, die alle Probleme und Widrigkeiten erfolgreich übersteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8103ae97-6cf8-47b1-9063-755f5e6730d1",
                                "sense_id": "be517372-dae6-31ec-9c8f-8d756ec993f3",
                                "text": "„Kritikern gefiel die Art, wie die Entwicklung der Hauptfigur von einer unerfahreneren Forscherin hin zu einer erfahrenen Überlebenskünstlerin erzählt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41af0345-55e5-4380-ae33-fbe8b18cd7f9",
                        "source_entry_id": "8517941e-0924-3ec0-8dca-1c2a41d7288c",
                        "source_sense_id": "be517372-dae6-31ec-9c8f-8d756ec993f3",
                        "source_sense_description": "weibliche Person, die alle Probleme und Widrigkeiten erfolgreich übersteht",
                        "target_lang_word": "survivalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "survivalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c714cc1-cfd2-336b-bbc1-7166bf93ef89",
                                        "entry_id": "ecc04b04-8019-3727-827e-4ff5694934d7",
                                        "glosses": [
                                            "A person who believes in being prepared to survive and is actively preparing for possible future emergencies and disruptions in local, regional, national, or international social or political order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ad636b8-b623-4437-8331-8bcd985e0b47",
                                                "sense_id": "2c714cc1-cfd2-336b-bbc1-7166bf93ef89",
                                                "text": "But why would survivalists flock to Pinterest, a site that was adopted early-on by people who wanted to share design ideas for home goods? In a way, preppers are actually the ideal user for the site."
                                            },
                                            {
                                                "example_id": "4ed290a7-9754-4567-93cd-1ecbf0d6c17c",
                                                "sense_id": "2c714cc1-cfd2-336b-bbc1-7166bf93ef89",
                                                "text": "The arrival of a starving mother and daughter (perfectly embodied by Olwen Fouéré and Mia Goth) disrupts the survivalist’s methodical routines and hardened emotions. Sex can be traded for food and shelter, but trust has no price;[…]"
                                            },
                                            {
                                                "example_id": "2d6eafa9-4a8e-4620-ba9b-b5e433a06ff2",
                                                "sense_id": "2c714cc1-cfd2-336b-bbc1-7166bf93ef89",
                                                "text": "But there are also French “survivalists” who – at least until about a decade ago – shared the drawbridge mentality of the Americans stocking up on peanut butter and ammo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
