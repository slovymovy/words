{
    "word_family": [
        "grieve",
        "aggrieve",
        "grievous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30eb653f-e823-3e25-80b8-b473e566d78b",
                    "sense_definition": "A formal complaint, especially in the context of a unionized workplace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The employee decided to file a <w>grievance</w> after being denied his scheduled break.",
                            "target_lang_translations": {
                                "ru": "Сотрудник решил подать официальную <w>жалобу</w> после того, как ему отказали в положенном перерыве."
                            }
                        },
                        {
                            "text": "Management met with the union representative to discuss the latest <w>grievance</w> regarding workplace safety.",
                            "target_lang_translations": {
                                "ru": "Руководство встретилось с представителем профсоюза, чтобы обсудить очередную <w>претензию</w> касательно безопасности на рабочем месте."
                            }
                        }
                    ],
                    "synonyms": [
                        "trouble"
                    ],
                    "common_phrases": [
                        "file a grievance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная жалоба или трудовой спор, особенно в контексте профсоюзной организации или трудовых отношений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалоба",
                                "target_lang_sense_clarification": "официальное трудовое заявление"
                            },
                            {
                                "target_lang_word": "претензия",
                                "target_lang_sense_clarification": "официальное требование или рекламация"
                            },
                            {
                                "target_lang_word": "трудовой спор",
                                "target_lang_sense_clarification": "разногласие между работником и работодателем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4950db50-8cfb-3272-9116-ce877a39f3c9",
                    "sense_definition": "A wrong or hardship suffered, which is the grounds of a complaint.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens gathered to voice their <w>grievances</w> against the new tax policy.",
                            "target_lang_translations": {
                                "ru": "Граждане собрались, чтобы высказать свои <w>претензии</w> по поводу новой налоговой политики."
                            }
                        },
                        {
                            "text": "He spent years nursing a <w>grievance</w> over the unfair treatment he received at his previous job.",
                            "target_lang_translations": {
                                "ru": "Он годами таил в себе <w>обиду</w> из-за несправедливого отношения на прошлой работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardship",
                        "wrong",
                        "grievance"
                    ],
                    "common_phrases": [
                        "list of grievances"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причина для недовольства; пережитая несправедливость, ущемление прав или причиненный ущерб, служащие поводом для жалоб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "причиненная несправедливость"
                            },
                            {
                                "target_lang_word": "повод для жалобы",
                                "target_lang_sense_clarification": "основание для недовольства"
                            },
                            {
                                "target_lang_word": "претензия",
                                "target_lang_sense_clarification": "нарекание, справедливое основание жаловаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d4dddd8-2480-301e-985f-cca7b0ee7e20",
                    "sense_definition": "Feelings of being wronged; outrage; resentment, bitterness or anger.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political movement was fueled by a deep sense of <w>grievance</w> among the working class.",
                            "target_lang_translations": {
                                "ru": "Политическое движение подпитывалось глубоким чувством <w>обиды</w> среди рабочего класса."
                            }
                        },
                        {
                            "text": "He nursed his <w>grievance</w> for years, unable to forgive the way he had been treated.",
                            "target_lang_translations": {
                                "ru": "Он годами лелеял свою <w>обиду</w>, не в силах простить то, как с ним обошлись."
                            }
                        }
                    ],
                    "synonyms": [
                        "vexation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство несправедливой обиды, горечи, возмущения или затаенной злобы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обида",
                                "target_lang_sense_clarification": "чувство задетого самолюбия или несправедливости"
                            },
                            {
                                "target_lang_word": "негодование",
                                "target_lang_sense_clarification": "возмущение, чувство ущемленности"
                            },
                            {
                                "target_lang_word": "горечь",
                                "target_lang_sense_clarification": "чувство горькой обиды и досады"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e07983d9-ff99-39e3-b8d5-3317bd69670e",
                    "sense_definition": "A complaint or annoyance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She expressed her <w>grievance</w> about the loud noise coming from the apartment next door.",
                            "target_lang_translations": {
                                "ru": "Она выразила своё <w>недовольство</w> громким шумом из соседней квартиры."
                            }
                        },
                        {
                            "text": "The manager listened patiently to every <w>grievance</w> brought forward by the staff members.",
                            "target_lang_translations": {
                                "ru": "Менеджер терпеливо выслушал каждую <w>жалобу</w>, высказанную сотрудниками."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyance",
                        "nuisance",
                        "trouble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение недовольства, сетование или повод для раздражения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалоба",
                                "target_lang_sense_clarification": "выражение недовольства"
                            },
                            {
                                "target_lang_word": "сетование",
                                "target_lang_sense_clarification": "высказывание огорчения или досады"
                            },
                            {
                                "target_lang_word": "недовольство",
                                "target_lang_sense_clarification": "выраженная претензия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}