                    "sense_id": "a666ccbe-a628-3eea-9d0c-a0f243519d5f",
                    "sense_definition": "odczuwać duże zimno, mróz",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "odczuwanie zimna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stał więc i <w>marzł</w>, gdy nagle usłyszał tuż za sobą okrzyk: „Janek!”",
                            "target_lang_translations": {
                                "en": "So he stood there and <w>froze</w>, when suddenly he heard a shout right behind him: \"Janek!\"",
                                "ru": "Он стоял и <w>мёрз</w>, когда вдруг прямо за собой услышал возглас: «Янек!»",
                                "nl": "Hij stond er dus en <w>had het koud</w>, toen hij plotseling vlak achter zich een kreet hoorde: \"Janek!\"",
                                "de": "Er stand also da und <w>fror</w>, als er plötzlich direkt hinter sich den Ruf hörte: „Janek!“",
                                "fr": "Il restait donc là et <w>gelait</w>, quand soudain il entendit un cri juste derrière lui : « Janek ! »",
                                "it": "Se ne stava lì a <w>gelare</w>, quando all'improvviso sentì un grido proprio dietro di sé: «Janek!»",
                                "cs": "Stál tam tedy a <w>mrzl</w>, když náhle přímo za sebou uslyšel výkřik: „Janku!“",
                                "tr": "Öylece durup <w>üşüyordu</w> ki birden hemen arkasında bir ses duydu: \"Janek!\"",
                                "es": "Estaba allí de pie y <w>se helaba de frío</w>, cuando de repente oyó un grito justo detrás de él: «¡Janek!».",
                                "zh": "他就这样站着<w>挨冻</w>，突然听到身后有人喊道：“亚内克！”"
                            }
                        },
                        {
                            "text": "Jeśli nie założysz czapki, będziesz <w>marznąć</w> na przystanku.",
                            "target_lang_translations": {
                                "en": "If you don't put on a hat, you'll <w>freeze</w> at the bus stop.",
                                "ru": "Если не наденешь шапку, будешь <w>мёрзнуть</w> на остановке.",
                                "nl": "Als je geen muts opdoet, zul je <w>koukleumen</w> bij de bushalte.",
                                "de": "Wenn du keine Mütze aufsetzt, wirst du an der Haltestelle <w>frieren</w>.",
                                "fr": "Si tu ne mets pas de bonnet, tu vas <w>avoir froid</w> à l'arrêt de bus.",
                                "it": "Se non metti il berretto, <w>avrai freddo</w> alla fermata.",
                                "cs": "Když si nevezmeš čepici, budeš na zastávce <w>mrznout</w>.",
                                "tr": "Bere takmazsan durakta <w>üşürsün</w>.",
                                "es": "Si no te pones el gorro, vas a <w>pasar frío</w> en la parada.",
                                "zh": "如果你不戴帽子，在车站等车时就会<w>受冻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ziębnąć"
                    ],
                    "common_phrases": [
                        "marznąć na kość"
                    ],
                    "target_lang_definitions": {
                        "en": "to feel very cold; to suffer from cold temperatures",
                        "ru": "испытывать сильный холод, страдать от мороза",
                        "nl": "het heel koud hebben, kou lijden",
                        "de": "Kälte empfinden, unter niedrigen Temperaturen leiden",
                        "fr": "Ressentir un froid intense, souffrir du froid",
                        "it": "avere o patire molto freddo",
                        "cs": "cítit velký chlad nebo zimu, mrznout",
                        "tr": "Aşırı soğuk veya don hissetmek, soğuktan üşümek",
                        "es": "Sentir mucho frío una persona o animal",
                        "zh": "感到非常寒冷；挨冻，受冻"
