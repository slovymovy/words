            "senses": [
                {
                    "sense_id": "9b23cec0-93e9-3d73-8af7-151c7535bf9d",
                    "sense_definition": "Donner de nouveau quelque chose à quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "donner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu me <w>redonner</w> un verre d'eau fraîche s'il te plaît ?"
                        },
                        {
                            "text": "Le professeur a accepté de lui <w>redonner</w> une chance pour son contrôle."
                        }
                    ],
                    "synonyms": [
                        "redistribuer"
                    ],
                    "common_phrases": [
                        "redonner une chance"
                    ]
                },
                {
                    "sense_id": "eb36c34f-8664-3bc6-8392-6a7b56e49ec5",
                    "sense_definition": "Rendre ou restituer à quelqu'un ce qui lui appartenait ou lui a été emprunté.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "restituer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de lui <w>redonner</w> ses clés avant de partir ce soir."
                        },
                        {
                            "text": "Il m'a promis de me <w>redonner</w> mon livre dès la fin de la semaine."
                        }
                    ],
                    "synonyms": [
