                                "target_lang_sense_clarification": "o kriminalitě nebo menších záležitostech"
                            },
                            {
                                "target_lang_word": "malicherný",
                                "target_lang_sense_clarification": "o věcech, které nemají velký význam"
                            }
                        ]
