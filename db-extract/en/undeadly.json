    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3360c262-7d39-3d1f-afa1-9637a5aeda38",
                "word": "undeadly",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eb36333c-2892-3afc-a44b-6212b04294bf",
                        "entry_id": "3360c262-7d39-3d1f-afa1-9637a5aeda38",
                        "glosses": [
                            "Not subject to death; immortal."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "84556fb9-df06-43af-8a71-5148a7136218",
                                "sense_id": "eb36333c-2892-3afc-a44b-6212b04294bf",
                                "text": "\"The soul also hath her death, namely, when it lacketh and is destitute of the eternal and godly life, which truly and justly is called the life of the soul: but undeadly or immortal is it called, because it never ceaseth to live, how miserable soever the life of it be. [...]\""
                            },
                            {
                                "example_id": "7711535f-004c-400b-a953-95d23ad6fa75",
                                "sense_id": "eb36333c-2892-3afc-a44b-6212b04294bf",
                                "text": "He aye was and aye shall be, undeadly and everlasting."
                            },
                            {
                                "example_id": "d0e9784a-6bfd-4507-88ec-09bfb43deff4",
                                "sense_id": "eb36333c-2892-3afc-a44b-6212b04294bf",
                                "text": "And also a soul in this state is dwelling between the terms of deadly life and undeadly life."
                            },
                            {
                                "example_id": "f17271dd-2a51-4be3-a4be-36bc88b7aebb",
                                "sense_id": "eb36333c-2892-3afc-a44b-6212b04294bf",
                                "text": "But I believe that the undeadly gods have spread and sown the souls within the bodies of mankind to the intent that the men should see and inhabit the countries, [...]"
                            },
                            {
                                "example_id": "baec226f-3b85-44f5-a45b-552120c27dca",
                                "sense_id": "eb36333c-2892-3afc-a44b-6212b04294bf",
                                "text": "Tempting as it was to hang up on the man and be done with it, that wouldn't do. Who knew what sort of undeadly minions de Piaget was capable of commanding."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4c71676-9a8b-3583-8f6d-03193dcb7477",
                        "entry_id": "3360c262-7d39-3d1f-afa1-9637a5aeda38",
                        "glosses": [
                            "Unable to be killed, quenched, or terminated; eternal; everlasting."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1bdd0560-55bd-4792-bd78-abbc330a8f70",
                                "sense_id": "a4c71676-9a8b-3583-8f6d-03193dcb7477",
                                "text": "Much of his subsequent work related to processes for resolving what he once called \"undeadly quarrels\" in the international arena."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9192b66-b1e8-3b3a-a405-4aa7ab6576b0",
                        "entry_id": "3360c262-7d39-3d1f-afa1-9637a5aeda38",
                        "glosses": [
                            "Of or pertaining to the undead."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "91f90483-ac4a-3e2e-8cca-6f2ed8e3b2ed",
                "word": "undeadly",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "676dc800-7b01-3c1e-b9fa-2c5f09ef20cf",
                        "entry_id": "91f90483-ac4a-3e2e-8cca-6f2ed8e3b2ed",
                        "glosses": [
                            "Not deadly; not causing, producing, or resulting in death; harmless."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3a1a4f86-9b62-4a1f-b8cd-a50af65d7e91",
                                "sense_id": "676dc800-7b01-3c1e-b9fa-2c5f09ef20cf",
                                "text": "Ulysses, knowing well The wound undeadly (setting back his foot to form his stand) Thus spake to Socus: \"O thou wretch, thy death is in this hand, That stay'st my victory on Troy, and where thy charge was made In doubtful term [...]\""
                            },
                            {
                                "example_id": "046e9981-a0c9-47e1-909a-6152b23b3a05",
                                "sense_id": "676dc800-7b01-3c1e-b9fa-2c5f09ef20cf",
                                "text": "[...] among boulders with my weapons deadly and undeadly."
                            },
                            {
                                "example_id": "3565379c-e65f-4caa-a53a-a3ce1fe5137a",
                                "sense_id": "676dc800-7b01-3c1e-b9fa-2c5f09ef20cf",
                                "text": "She does not care if it is a tobaccoroller or molesnake or any undeadly animal."
                            },
                            {
                                "example_id": "dba564f5-f717-450e-bd91-ed33bffc9528",
                                "sense_id": "676dc800-7b01-3c1e-b9fa-2c5f09ef20cf",
                                "text": "[...] each surrounded by a luminous contour, and hang an instant in space, as time slowed and each permutation of shapes appeared, to begin their gentle, undeadly descent, [...]"
                            }
                        ]
                    }
                ],
