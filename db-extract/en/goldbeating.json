                                "example_id": "ffd583e4-7ec0-487a-aac6-9af1b56d348e",
                                "sense_id": "13f53d3e-021d-3301-b334-59db3350d084",
                                "text": "The popular late-19th-century trend of using gold leaf for decorating brought the goldbeating industry to the area."
                            },
                            {
                                "example_id": "8d4cceea-c640-4415-b232-bfef8381f197",
                                "sense_id": "13f53d3e-021d-3301-b334-59db3350d084",
                                "text": "The art of goldbeating is of great antiquity, being referred to by Homer; and Pliny states that one ounce of gold was extended to 750 leaves, each leaf being four fingers square, which is three times the thickness of the ordinary leaf gold of the present time."
                            },
                            {
                                "example_id": "f929d85f-95d4-460a-8dda-254e72f15462",
                                "sense_id": "13f53d3e-021d-3301-b334-59db3350d084",
                                "text": "My father engaged two young guild apprentices from our neighbor's larger workshop to help transport the wooden stump, hammers, and other supplies from the goldbeating studio."
                            }
                        ]
