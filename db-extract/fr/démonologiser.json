                "senses": [
                    {
                        "sense_id": "de6b3be7-7a33-38bc-9bb1-2481ec1724c8",
                        "entry_id": "76cc97b9-52c4-34d8-a7a3-55920516bf5a",
                        "glosses": [
                            "Donner un caractère démonologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2011279-b15e-4f3d-bca5-ba1b01157526",
                                "sense_id": "de6b3be7-7a33-38bc-9bb1-2481ec1724c8",
                                "text": "Pourquoi concevoir une industrie culturelle à démonologiser ?"
                            },
                            {
                                "example_id": "bcf557a9-f75e-466a-a9de-08472bbad92d",
                                "sense_id": "de6b3be7-7a33-38bc-9bb1-2481ec1724c8",
                                "text": "Emise tant par l'extrême droite que par les anarchistes, elles fonctionnent par rebonds de la propagande communiste et visent à démonologiser le parti."
                            },
                            {
                                "example_id": "47ff0367-877c-4ad8-8de2-71ca75d6d75c",
                                "sense_id": "de6b3be7-7a33-38bc-9bb1-2481ec1724c8",
                                "text": "Brzezinski a écrit que « les masses ont tendance à démonologiser les affaires étrangères »."
                            }
                        ]
                    }
