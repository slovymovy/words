                "senses": [
                    {
                        "sense_id": "3c043323-06f6-350c-b0fd-2564652c59d4",
                        "entry_id": "80f1676b-600f-3193-abcb-6997d065d740",
                        "glosses": [
                            "wedstrijd die men speelt op het terrein van de tegenstander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fa9d602-33e4-449e-81d8-8550713d0994",
                                "sense_id": "3c043323-06f6-350c-b0fd-2564652c59d4",
                                "text": "Afgelopen seizoen bijvoorbeeld pakte Barcelona-middenvelder Andres Iniesta bewust een tweede gele kaart in de heenmatch van de kwartfinales van de Champions League tegen het Oekraïense Shakhtar Donetsk. Daardoor miste hij de terugwedstrijd, maar was hij wel weer speelgerechtigd voor de halve finales."
                            },
                            {
                                "example_id": "fbf5b064-f79a-4ed3-a3e3-b98da124d643",
                                "sense_id": "3c043323-06f6-350c-b0fd-2564652c59d4",
                                "text": "Borussia verloor met 2-0 nadat de heenmatch op 3-3 was geëindigd. Lazio treft in de achtste finales Stuttgart, dat Racing Genk uitschakelde."
                            },
                            {
                                "example_id": "d7656260-8602-4810-8ef9-e4adf7d302a4",
                                "sense_id": "3c043323-06f6-350c-b0fd-2564652c59d4",
                                "text": "De rivaliteit tussen de aanhang van PSG en die van Anderlecht dateert van iets meer dan 20 jaar geleden. Op 24 november 1992 vielen er in de heenmatch van de achtste finales van de UEFA Cup veel gewonden bij rellen tussen hooligans van PSG en die van Anderlecht. Sindsdien kijken beide clans elkaar het wit uit de ogen. 'Sinds de loting hebben we ons op deze wedstrijd voorbereid', klinkt het in hooligankringen."
                            }
                        ]
                    }
