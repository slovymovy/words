{
    "word_family": [
        "environment",
        "environmentally",
        "environmentalist",
        "environmentalism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ce84c5f4-c8e5-36c4-a855-b81b96a6a9a1",
                    "sense_definition": "Relating to the natural world and the impact of human activity on its condition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nature_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pollution is a serious <w>environmental</w> problem that affects the entire planet.",
                            "target_lang_translations": {
                                "ru": "Загрязнение — это серьезная <w>экологическая</w> проблема, которая затрагивает всю планету.",
                                "zh": "污染是一个影响整个星球的严重<w>环境</w>问题。"
                            }
                        },
                        {
                            "text": "The government passed new laws for <w>environmental</w> protection.",
                            "target_lang_translations": {
                                "ru": "Правительство приняло новые законы об <w>охране окружающей среды</w>.",
                                "zh": "政府通过了新的<w>环保</w>法律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ecological"
                    ],
                    "common_phrases": [
                        "environmental protection",
                        "environmental impact",
                        "environmental issues",
                        "environmental science"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к природе и влиянию на неё деятельности человека.",
                        "zh": "与自然界以及人类活动对其状况的影响有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экологический",
                                "target_lang_sense_clarification": "относящийся к экологии и взаимодействию с природой"
                            },
                            {
                                "target_lang_word": "относящийся к окружающей среде",
                                "target_lang_sense_clarification": "общий описательный перевод"
                            },
                            {
                                "target_lang_word": "природоохранный",
                                "target_lang_sense_clarification": "связанный с защитой природы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "环境的",
                                "target_lang_sense_clarification": "指与环境相关的通用术语"
                            },
                            {
                                "target_lang_word": "生态的",
                                "target_lang_sense_clarification": "指与生态系统或自然平衡相关的"
                            },
                            {
                                "target_lang_word": "环保的",
                                "target_lang_sense_clarification": "指与环境保护相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1dc0c7b-b28f-3587-8b8c-027d85682d8f",
                    "sense_definition": "Designed or operating in a way that does not harm the natural world; eco-friendly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Consumers are increasingly looking for <w>environmental</w> products that reduce waste.",
                            "target_lang_translations": {
                                "ru": "Потребители все чаще ищут <w>экологичные</w> продукты, которые способствуют сокращению отходов.",
                                "zh": "消费者正越来越多地寻找能减少浪费的<w>环保</w>产品。"
                            }
                        },
                        {
                            "text": "The company adopted an <w>environmental</w> policy to lower its carbon footprint.",
                            "target_lang_translations": {
                                "ru": "Компания приняла <w>экологическую</w> политику, чтобы уменьшить свой углеродный след.",
                                "zh": "该公司采取了一项<w>环保</w>政策以降低其碳足迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eco-friendly",
                        "green"
                    ],
                    "antonyms": [
                        "harmful"
                    ],
                    "common_phrases": [
                        "environmental products",
                        "environmental policy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разработанный или действующий таким образом, чтобы не наносить вреда природе; экологичный.",
                        "zh": "设计或运作方式不会对自然界造成损害的；生态友好的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экологичный",
                                "target_lang_sense_clarification": "безопасный для экологии"
                            },
                            {
                                "target_lang_word": "экологически чистый",
                                "target_lang_sense_clarification": "не содержащий вредных веществ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生态友好的",
                                "target_lang_sense_clarification": "指对环境无害的"
                            },
                            {
                                "target_lang_word": "环保的",
                                "target_lang_sense_clarification": "指对环境友好的产品或政策"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0d2adde-bad5-3f97-8f5a-3cf106e4a0b4",
                    "sense_definition": "Any factor relating to the physical conditions, such as temperature or humidity, in which hardware or equipment operates.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer checked the system <w>environmentals</w> to ensure the servers would not overheat.",
                            "target_lang_translations": {
                                "ru": "Инженер проверил <w>параметры окружающей среды</w> системы, чтобы убедиться, что серверы не перегреются.",
                                "zh": "工程师检查了系统的<w>运行环境</w>，以确保服务器不会过热。"
                            }
                        },
                        {
                            "text": "Proper management of <w>environmentals</w> is crucial for the longevity of the equipment.",
                            "target_lang_translations": {
                                "ru": "Правильное управление <w>условиями эксплуатации</w> имеет решающее значение для долговечности оборудования.",
                                "zh": "妥善管理<w>环境参数</w>对于延长设备寿命至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conditions",
                        "factors"
                    ],
                    "common_phrases": [
                        "system environmentals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Факторы окружающей среды (такие как температура или влажность), влияющие на работу оборудования.",
                        "zh": "与硬件或设备运行时的物理条件（如温度或湿度）相关的任何因素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "условия эксплуатации",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "параметры окружающей среды",
                                "target_lang_sense_clarification": "физические условия работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运行环境",
                                "target_lang_sense_clarification": "指设备工作的物理环境条件"
                            },
                            {
                                "target_lang_word": "环境参数",
                                "target_lang_sense_clarification": "指影响设备运行的物理指标"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}