                "senses": [
                    {
                        "sense_id": "65a8bd7f-e70c-3ace-ab85-afbfd4b7a11c",
                        "entry_id": "20a15362-65a9-3b39-b3d7-2a9bad0d13d7",
                        "glosses": [
                            "pokarm"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "1c401543-7a48-4c2b-b1ce-705670bc68c2",
                                "sense_id": "65a8bd7f-e70c-3ace-ab85-afbfd4b7a11c",
                                "text": "Znam jedną restaurację ze swojskim jadłem tuż obok dworca w Katowicach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bb38321-26af-46ab-806d-572979e87c75",
                        "source_entry_id": "20a15362-65a9-3b39-b3d7-2a9bad0d13d7",
                        "source_sense_id": "65a8bd7f-e70c-3ace-ab85-afbfd4b7a11c",
                        "target_lang_word": "яство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "яство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "191b59d8-16dc-308d-a344-07d9576c43f1",
                                        "entry_id": "af7dc6f9-c18b-33b5-ac0a-2131f9de8186",
                                        "glosses": [
                                            "устар. или ирон., еда, кушанье, как правило, то, что употребляется в пищу в данный момент"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11cb09c0-d82d-4169-9538-67136fc7c059",
                                                "sense_id": "191b59d8-16dc-308d-a344-07d9576c43f1",
                                                "text": "Стол ломится от яств."
                                            },
                                            {
                                                "example_id": "198ec0b7-6346-4ec9-b314-49a6976a5ad9",
                                                "sense_id": "191b59d8-16dc-308d-a344-07d9576c43f1",
                                                "text": "Она вставала только затем, чтобы велеть подать какое-нибудь новое яство."
                                            },
                                            {
                                                "example_id": "3206c905-0fbd-4192-a9a6-a4b02de282eb",
                                                "sense_id": "191b59d8-16dc-308d-a344-07d9576c43f1",
                                                "text": "Стол уставился яствами и питиями."
                                            },
                                            {
                                                "example_id": "2c1c352f-0c7c-4499-95df-0674a85e36d4",
                                                "sense_id": "191b59d8-16dc-308d-a344-07d9576c43f1",
                                                "text": "— Не яства же сахарны поставить вам! И хлебом не корми, да дай винца."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
