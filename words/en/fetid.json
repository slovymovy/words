{
    "word_family": [
        "fetidity",
        "fetidness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "94c48abe-2285-3105-841d-08b8d44e9487",
                    "sense_definition": "Having a very unpleasant or offensive smell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fetid</w> odor of the swamp made everyone hold their breath.",
                            "target_lang_translations": {
                                "cs": "<w>Páchnoucí</w> odér z bažiny přiměl všechny zadržet dech."
                            }
                        },
                        {
                            "text": "He walked into the <w>fetid</w> room and immediately opened the window.",
                            "target_lang_translations": {
                                "cs": "Vstoupil do <w>smrduté</w> místnosti a okamžitě otevřel okno."
                            }
                        }
                    ],
                    "synonyms": [
                        "stinking",
                        "foul",
                        "malodorous"
                    ],
                    "antonyms": [
                        "fragrant",
                        "aromatic"
                    ],
                    "common_phrases": [
                        "fetid air",
                        "fetid odor"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající velmi nepříjemný nebo odpudivý zápach."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "páchnoucí",
                                "target_lang_sense_clarification": "obecné označení pro něco, co vydává nepříjemný odér"
                            },
                            {
                                "target_lang_word": "smrdutý",
                                "target_lang_sense_clarification": "expresivnější výraz pro silně zapáchající věc"
                            },
                            {
                                "target_lang_word": "zapáchající",
                                "target_lang_sense_clarification": "popisný výraz pro aktivní proces vydávání zápachu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d699718a-c6f5-39f3-b8e7-914c8566b4b3",
                    "sense_definition": "The pungent-smelling plant known as asafoetida or its resinous extract.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional medicine was prepared using a small amount of <w>fetid</w>.",
                            "target_lang_translations": {
                                "cs": "Tradiční lék byl připraven s použitím malého množství <w>asafoetidy</w>."
                            }
                        },
                        {
                            "text": "Some herbalists refer to the resin of the plant simply as <w>fetid</w>.",
                            "target_lang_translations": {
                                "cs": "Někteří bylinkáři označují pryskyřici této rostliny jednoduše jako <w>čertovo lejno</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "asafoetida"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pryskyřice z rostliny známé jako ločidlo čertovo lejno (asafoetida), která má pronikavý zápach."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "asafoetida",
                                "target_lang_sense_clarification": "odborný název pro pryskyřici používanou v kuchyni a medicíně"
                            },
                            {
                                "target_lang_word": "čertovo lejno",
                                "target_lang_sense_clarification": "tradiční lidový název pro tuto aromatickou pryskyřici"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}