        "fr-extract.jsonl": [
            {
                "entry_id": "9e0a7070-abe4-3bbf-8859-ba7b0bacc343",
                "word": "conciliabule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "96470f0c-8cba-4b55-b824-3974dd28f3ba",
                        "entry_id": "9e0a7070-abe4-3bbf-8859-ba7b0bacc343",
                        "tags": [
                            "plural"
                        ],
                        "form": "conciliabules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66fd6a19-cb2b-3665-8964-f2a5fce8e3c1",
                        "entry_id": "9e0a7070-abe4-3bbf-8859-ba7b0bacc343",
                        "glosses": [
                            "Assemblée de prélats schismatiques ou convoqués irrégulièrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa72dc10-c3ba-42a6-8b41-96a4a4de3679",
                                "sense_id": "66fd6a19-cb2b-3665-8964-f2a5fce8e3c1",
                                "text": "Ce n’était pas un concile, c’était un conciliabule."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5fb2fac-e51c-329b-882e-7595c0d82d4c",
                        "entry_id": "9e0a7070-abe4-3bbf-8859-ba7b0bacc343",
                        "glosses": [
                            "Conférence secrète où président d’ordinaire des sentiments de malveillance ou d’hostilité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aed3da5-3613-4817-b105-16d01f870a6b",
                                "sense_id": "c5fb2fac-e51c-329b-882e-7595c0d82d4c",
                                "text": "C’est des conciliabules qui se tiennent chez les femmes de chambre que sortent la plupart des désordres d’un ménage."
                            },
                            {
                                "example_id": "c38cfe26-c88f-471c-86d8-f62c84d36b4d",
                                "sense_id": "c5fb2fac-e51c-329b-882e-7595c0d82d4c",
                                "text": "Les conciliabules des dentellières, les quaroyes, comme on dit en langage du cru, sont célèbres à Mirecourt et fort redoutés des gens qui craignent les on-dit."
                            },
                            {
                                "example_id": "9a731117-4daa-4ea7-87cf-e547f94ab672",
                                "sense_id": "c5fb2fac-e51c-329b-882e-7595c0d82d4c",
                                "text": "Des conciliabules inutiles se tiennent entre les envoyés des nations."
                            },
                            {
                                "example_id": "b5d2bf77-0feb-4112-96a6-3b0d4cd2c993",
                                "sense_id": "c5fb2fac-e51c-329b-882e-7595c0d82d4c",
                                "text": "On y est comme au théâtre, non pas seulement parce que les acteurs du Français y tiennent conciliabule autour d’une choucroute, mais parce qu’on aperçoit de sa place un spectacle qui ne lasse jamais."
                            },
                            {
                                "example_id": "859f4c02-44b2-4906-b527-24c43e9a781e",
                                "sense_id": "c5fb2fac-e51c-329b-882e-7595c0d82d4c",
                                "text": "La décision ne fut pas facile à prendre pour lui. Elle donna encore lieu, comme je l’ai appris après coup par toutes sortes de détours, à une interminable série de conciliabules."
                            }
                        ]
                    },
                    {
                        "sense_id": "23c7fa7a-3510-3934-a17d-bf0cf1a25463",
                        "entry_id": "9e0a7070-abe4-3bbf-8859-ba7b0bacc343",
                        "glosses": [
                            "Assemblage, réunion."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7a440122-807e-45f1-a47e-a2a51c263763",
                                "sense_id": "23c7fa7a-3510-3934-a17d-bf0cf1a25463",
                                "text": "La brise soufflait sur ce conciliabule de bateaux, comme éprouvant le besoin de l’éparpiller, d’en débarrasser la mer ; et ils commençaient à se disperser, à fuir comme une armée en déroute, — rien que devant cette menace écrite en l’air, à laquelle on ne pouvait plus se tromper."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e624fee-d58b-4078-8960-7febc29f0e88",
                        "source_entry_id": "9e0a7070-abe4-3bbf-8859-ba7b0bacc343",
                        "target_lang_word": "leise Unterhaltung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f43fb614-7175-4ea3-8bcf-0e285c4fb00f",
                        "source_entry_id": "9e0a7070-abe4-3bbf-8859-ba7b0bacc343",
                        "target_lang_word": "Geflüster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geflüster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                        "entry_id": "9ce12df3-badd-373d-981b-393770bd5f4a",
                                        "glosses": [
                                            "durch ein sehr leises Miteinander-Sprechen verursachtes anhaltendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee006756-b6a1-4673-bd0f-005afbfab824",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "Das Geflüster in den hinteren Reihen stört die Veranstaltung."
                                            },
                                            {
                                                "example_id": "bd53957a-ae43-4d50-9db5-d5b3d9d0f4f5",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "„Plötzlich war Geflüster zu hören.“"
                                            },
                                            {
                                                "example_id": "f501a22a-82a7-4874-803b-a40910d9c163",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "„Es kam Frau Holle vor, als ob mit dem ersten Dämmerlicht ein Geflüster und Gemurmel durch das Ruinenviertel ging.“"
                                            },
                                            {
                                                "example_id": "65b95749-3782-4f02-be9a-bf137524ce6c",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "„Über ihrem ernsten Geflüster am prasselnden Feuer schlief ich ein.“"
                                            },
                                            {
                                                "example_id": "695a92ee-5d7f-4f2e-86a1-7f1efbd25386",
                                                "sense_id": "bafe586f-e99d-35b4-9289-0149d41474df",
                                                "text": "„Ich machte kehrt und malte mir das Geflüster und die fade Küsserei aus, die hinter meinem Rücken aufs neue begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4a2184b-4fae-4b68-a78e-a4a0345b3098",
