                "translations": [
                    {
                        "translation_id": "efe5d690-82d0-4ef9-8ddc-7f8f624b2071",
                        "source_entry_id": "bdaf4f86-dc9a-361c-a9c2-ad89b56bda82",
                        "target_lang_word": "imp",
