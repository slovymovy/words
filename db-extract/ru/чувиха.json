                ],
                "translations": [
                    {
                        "translation_id": "e6ce706e-1df5-4f22-a2b5-5ef8d33e2e00",
                        "source_entry_id": "7b635502-0a6e-3c6f-a32e-23a98952b034",
                        "target_lang_word": "meuf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meuf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a799d953-90c7-3d09-bb61-d851e12e163e",
                                        "entry_id": "8caef8df-e81d-38f0-956a-a9de22a3afad",
                                        "glosses": [
                                            "Femme."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec24a707-0ab2-4cd8-873e-996d180c1852",
                                                "sense_id": "a799d953-90c7-3d09-bb61-d851e12e163e",
                                                "text": "J'écris de chez les moches, pour les moches, les vieilles, les camionneuses, les frigides, les mal baisées, les imbaisables, les hystériques, les tarées, toutes les exclues du grand marché à la bonne meuf. Et je commence par là pour que les choses soient claires ; je ne m'excuse de rien, je ne viens pas me plaindre."
                                            },
                                            {
                                                "example_id": "66197d71-6665-4eb9-9cc8-4f74ab55aa11",
                                                "sense_id": "a799d953-90c7-3d09-bb61-d851e12e163e",
                                                "text": "Une meuf michto, grande blonde sexy, jean et veste en cuir, traverse au loin un passage clouté."
                                            },
                                            {
                                                "example_id": "fe35609d-e5dd-4759-b7e0-dd3a4f3a9459",
                                                "sense_id": "a799d953-90c7-3d09-bb61-d851e12e163e",
                                                "text": "Je réalise, assez rapidement, que Roland Barthes, ce n’est pas un « fou des meufs »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ba810f3-f8a1-3ccf-9b41-6d37cb196835",
                                        "entry_id": "8caef8df-e81d-38f0-956a-a9de22a3afad",
                                        "glosses": [
                                            "Fille."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e53d8ec-4667-4279-8950-d7e5b2e07d26",
                                                "sense_id": "6ba810f3-f8a1-3ccf-9b41-6d37cb196835",
                                                "text": "Je suis sûre qu'elle n'est même pas intelligente. […]. Elle n'est même pas belle. Si encore il avait rencontré quelqu'un de mieux que moi, j'aurais pu admettre. Là, la meuf, elle ne casse pas trois pattes à un canard."
                                            },
                                            {
                                                "example_id": "7ff1a15a-02cd-4cda-b893-1ba85e65ede6",
                                                "sense_id": "6ba810f3-f8a1-3ccf-9b41-6d37cb196835",
                                                "text": "Heureusement que t'habites pas dans la cité des 3000, meuf."
                                            },
                                            {
                                                "example_id": "9855db3b-5704-41c9-bd7e-3f9fcf9b7783",
                                                "sense_id": "6ba810f3-f8a1-3ccf-9b41-6d37cb196835",
                                                "text": "Non mais madame ça fait trois fois que je me fais bacher par la même meuf."
                                            },
                                            {
                                                "example_id": "94f5f7b1-90c0-4a27-aab2-e9a7659f3753",
                                                "sense_id": "6ba810f3-f8a1-3ccf-9b41-6d37cb196835",
                                                "text": "Mais tu es trop drôle, meuf, tu viens de te décrire…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "510bdd57-642d-31d0-8518-83c64c78e571",
                                        "entry_id": "8caef8df-e81d-38f0-956a-a9de22a3afad",
                                        "glosses": [
                                            "Amie de cœur ; fiancée ; amante ; maîtresse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "844816e0-39da-49f9-b55c-03f3783773f8",
                                                "sense_id": "510bdd57-642d-31d0-8518-83c64c78e571",
                                                "text": "Je l'ai vu la nouvelle meuf de Romain. Celle qui l'a rendu amoureux comme un imbécile."
                                            },
                                            {
                                                "example_id": "bdce344b-9581-445c-b9af-5e6c76158abf",
                                                "sense_id": "510bdd57-642d-31d0-8518-83c64c78e571",
                                                "text": "Chuis avec Tiphaine, c'est ma meuf, tu vois, putain de ta race, j'l'ai dans l'bide, c plus fort que moi, j'la kiffe trop, elle est trop mortelle. Putain qu'est-ce qu'elle est bonne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0a312ad-b8bd-4865-b3c3-843ddad37e5a",
                        "source_entry_id": "7b635502-0a6e-3c6f-a32e-23a98952b034",
                        "target_lang_word": "gonzesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gonzesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                        "entry_id": "32891077-264f-3609-baf8-ece5beb05b2a",
                                        "glosses": [
                                            "Femme ou jeune femme, nana."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "familiar",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ac9d0c-e4b3-48a4-8afb-c747da288b98",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "Il m'accompagne jusqu'à la porte de mon hôtel : « Nous avons aussi des cajibis de nuit où dansent de très belles gonzesses. Si vous n'avez pas les foies, allez-y. »"
                                            },
                                            {
                                                "example_id": "7d4c445d-abad-4ac8-9cb2-610af759a97c",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "— À cause des grosses gonzesses qu’est là, poursuivit l’étonnant garçon, l’nom de « Vacherie » a été donné à la boite."
                                            },
                                            {
                                                "example_id": "1adc7244-6765-4c91-8d24-2a139b36bb13",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "Partage ou non partage,\nTout est à notre usage :\nN’épargnons le poitou.\nPoissons avec adresse\nMézières et gonzesses,\nSans faire de regout."
                                            },
                                            {
                                                "example_id": "a207601b-b673-479b-94de-3e8c1a4cfa8e",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "Ça ne court pas les fêtes, des broquilles comme les vôtres, et ça se reconnaît. Si ce n’est pas dégoûtant pour une gonzesse de porter des perles comme ça, il y a de quoi nourrir une famille pendant des années !"
                                            },
                                            {
                                                "example_id": "5dd80a78-c375-4046-9cd8-83618917f3b6",
                                                "sense_id": "6776cad9-b170-3a17-aee0-ff2a21b095f1",
                                                "text": "Eh bien, ça se passe sous votre Paris de mes couilles, mon vieux. Votre Paname comme vous dites, qui sent si bon Chanel, avec plein de belles gonzesses qui trottinent, il repose sur du pus et de la crevaison !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9591b222-59e6-32e4-a88f-71237f2b5319",
                                        "entry_id": "32891077-264f-3609-baf8-ece5beb05b2a",
                                        "glosses": [
                                            "Homme efféminé, sans courage, pleutre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "colloquial",
                                            "offensive",
                                            "pejorative",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f03255b-809a-401b-9f47-9093b82da6cf",
                                                "sense_id": "9591b222-59e6-32e4-a88f-71237f2b5319",
                                                "text": "Les « gonzesses », personne ne les appelait plus autrement, s’occupaient du ménage dans les piaules, briquaient les chiottes, ciraient les chaussures, raccommodaient les boutons, les épaulettes, préparaient le café à nos retours de saut ou de crapahutage."
                                            },
                                            {
                                                "example_id": "15b18213-573a-463b-9cfc-35d8497885d9",
                                                "sense_id": "9591b222-59e6-32e4-a88f-71237f2b5319",
                                                "text": "T’as peur d'un teckel ? Ma parole, t’es une vraie gonzesse !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
