        "fr-extract.jsonl": [
            {
                "entry_id": "49574d2e-3980-30f8-a498-201fe268e2f5",
                "word": "stanner",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "86f21efc-4b87-3a2e-96b5-43a70f204cff",
                        "entry_id": "49574d2e-3980-30f8-a498-201fe268e2f5",
                        "glosses": [
                            "Suivre un groupe de K-pop ou un membre du groupe en particulier, rejoignant un fandom."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2e82d7a4-87d0-47f8-aaea-a1131d317f15",
                                "sense_id": "86f21efc-4b87-3a2e-96b5-43a70f204cff",
                                "text": "Je stanne déjà BTS et Itzy mais j'aimerai bien commencer à stanner IVE."
                            },
                            {
                                "example_id": "95215de2-b716-4c35-b60c-5e73af303171",
                                "sense_id": "86f21efc-4b87-3a2e-96b5-43a70f204cff",
                                "text": "J'ai arrêté de stanner Seungri de Bigbang depuis l'affaire du Burning Sun."
                            },
                            {
                                "example_id": "63f8c2af-a999-4baf-b789-a65799c78e11",
                                "sense_id": "86f21efc-4b87-3a2e-96b5-43a70f204cff",
                                "text": "J'ai appris que ma mère stannait aussi des groupes de K-pop par le passé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5a61f5e-49b9-4930-8d67-5c099aed5e35",
                        "source_entry_id": "49574d2e-3980-30f8-a498-201fe268e2f5",
                        "source_sense_id": "86f21efc-4b87-3a2e-96b5-43a70f204cff",
                        "target_lang_word": "stan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e4b30a-796f-308a-b110-c5d01b36df87",
                                        "entry_id": "45d9a962-2e0c-3644-8243-15e9152dd023",
                                        "glosses": [
                                            "An extremely obsessive fan of a person, group, character, or creative work, particularly one whose fixation is unhealthy or intrusive."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f40eff49-ee75-48c7-8b12-34024709ae72",
                                                "sense_id": "a3e4b30a-796f-308a-b110-c5d01b36df87",
                                                "text": "IU stan"
                                            },
                                            {
                                                "example_id": "107ea6f4-ac29-42f7-92b2-09c464c82290",
                                                "sense_id": "a3e4b30a-796f-308a-b110-c5d01b36df87",
                                                "text": "K-pop stan"
                                            },
                                            {
                                                "example_id": "9c72a1de-bee8-4f21-a508-430f92cb5d1e",
                                                "sense_id": "a3e4b30a-796f-308a-b110-c5d01b36df87",
                                                "text": "Dream stan"
                                            },
                                            {
                                                "example_id": "3f38e6dc-556d-45e2-b3e7-3ee35e2fe963",
                                                "sense_id": "a3e4b30a-796f-308a-b110-c5d01b36df87",
                                                "text": "I know the in-depth detailed life of a stan because I am one. I'm one of those Lady Gaga fans, […]"
                                            },
                                            {
                                                "example_id": "b55701f5-95a6-4253-9cd0-03667cb0bf50",
                                                "sense_id": "a3e4b30a-796f-308a-b110-c5d01b36df87",
                                                "text": "I am the biggest stan for Selena because she is my queen. She made Disney interesting and I have always watched her."
                                            },
                                            {
                                                "example_id": "1b795ada-291d-470d-be31-4cb783f5de54",
                                                "sense_id": "a3e4b30a-796f-308a-b110-c5d01b36df87",
                                                "text": "Incidents have occurred with stans showing up to pop stars' residences, as has happened with Madonna, Taylor Swift and others."
                                            },
                                            {
                                                "example_id": "01f85c10-d0ae-42a9-a631-fd9d659f0942",
                                                "sense_id": "a3e4b30a-796f-308a-b110-c5d01b36df87",
                                                "text": "K-pop stans have been getting increasingly involved in American politics in recent months. After the Trump campaign solicited messages for the president’s birthday on June 8, K-pop stans submitted a stream of prank messages."
                                            },
                                            {
                                                "example_id": "14c6f163-3760-46e7-85d3-463c57db776d",
                                                "sense_id": "a3e4b30a-796f-308a-b110-c5d01b36df87",
                                                "text": "“Stans will literally go to any extent to defend anyone,” he said of Mr. Depp’s supporters, adding: “Amber Heard, she has not got that fan base.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65a32450-71b3-3d09-9237-65efbb31c639",
                                        "entry_id": "85000e1a-a95d-3b3b-b558-b0c35d00d16c",
                                        "glosses": [
                                            "To act as a stan (for); to be an obsessive fan (of)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed69c5e2-bcd5-49ab-9c41-d2c192786fac",
                                                "sense_id": "65a32450-71b3-3d09-9237-65efbb31c639",
                                                "text": "We stan a queen."
                                            },
                                            {
                                                "example_id": "fd2d7376-4408-4e77-94bf-90df4a402de5",
                                                "sense_id": "65a32450-71b3-3d09-9237-65efbb31c639",
                                                "text": "For quotations using this term, see Citations:stan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc34b62f-31b0-3572-8ac4-7eb32f3f52c4",
                                        "entry_id": "06314a11-9d95-31be-8ce1-665fc01b3974",
                                        "glosses": [
                                            "A country - often ex-Soviet - whose name ends with \\\"-stan\\\" such as Turkmenistan, Uzbekistan, and Kazakhstan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
