                    ],
                    "common_phrases": [
                        "expended fuel",
                        "expended shells",
                        "expended cartridge"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tamamen harcanmış, kullanılmış ya da tükenmiş olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kullanılmış",
                                "target_lang_sense_clarification": "mühimmat, yakıt vb. için"
