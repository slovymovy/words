                    "frequency": "Middle",
                    "semantic_group_id": "éthique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision est légale, mais elle reste <w>moralement</w> contestable pour beaucoup de citoyens."
                        },
                        {
                            "text": "Il refuse de participer à ce projet car il le juge <w>moralement</w> inacceptable."
                        }
                    ],
                    "synonyms": [
