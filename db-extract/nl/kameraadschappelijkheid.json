                                            {
                                                "example_id": "1ea9e44d-8067-4f7b-88ff-1e3f4308e1a6",
                                                "sense_id": "f40786fd-b89c-38c3-824e-872a358bd12c",
                                                "text": "[…]But then the mind much ſufferance doth or'e ſcip,\n When griefe hath mates,and bearing fellowſhip :\n How light and portable my paine ſeemes now,\n When that which makes me bend, makes the King bow,\n He childed as I fathered,Tom away,\n Marke the high noyſes and thy ſelfe bewray,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91294843-60a4-33c9-82d9-0ba037779e10",
                                        "entry_id": "7afa6a4a-09d2-3425-82dc-d88e01e23701",
                                        "glosses": [
                                            "A feeling of friendship, relatedness or connection between people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b60f2f7-0056-4146-ac17-f790abd14b41",
                                                "sense_id": "91294843-60a4-33c9-82d9-0ba037779e10",
                                                "text": "The grace of the Lord Jesus Christ and the love of God and the fellowship of the Holy Spirit be with you all."
                                            },
                                            {
                                                "example_id": "8a178266-68c7-48b6-9cf1-0c3b5b7a9924",
                                                "sense_id": "91294843-60a4-33c9-82d9-0ba037779e10",
                                                "text": "A King thou art by name, and a King of good fellovvſhippe by nature, vvhereby I ominate this Encomion of the king of fiſhes vvas predeſtinate to thee from thy ſvvadling clothes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838301d3-a718-37b0-99ef-b725cbba3990",
                                        "entry_id": "7afa6a4a-09d2-3425-82dc-d88e01e23701",
                                        "glosses": [
                                            "A merit-based scholarship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d48d637e-7887-453f-b1ad-49a57bfe7c42",
                                                "sense_id": "838301d3-a718-37b0-99ef-b725cbba3990",
                                                "text": "There is a significant investment in scholarships and fellowships and traineeships, so that we are also making sure that we’re investing in domestic work force."
                                            },
                                            {
                                                "example_id": "3446b5ed-1422-4926-a426-299fbe0a093a",
                                                "sense_id": "838301d3-a718-37b0-99ef-b725cbba3990",
                                                "text": "It will go toward 20 full-tuition fellowships for students of color, as well as to endow the initiative in perpetuity, provide relief for the existing scholarship fund and bring in artists of color as visiting faculty over the next five years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d093679-5a0c-358e-90e7-d9cfd58b72a8",
                                        "entry_id": "7afa6a4a-09d2-3425-82dc-d88e01e23701",
                                        "glosses": [
                                            "A temporary position at an academic institution with limited teaching duties and ample time for research."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
