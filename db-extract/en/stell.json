                    {
                        "sense_id": "65b4e3a7-1d1c-3bd1-ab53-f5c63a2b2962",
                        "entry_id": "07e5720c-ee3b-37e9-ad85-11029fb42a06",
                        "glosses": [
                            "A prop; a support, as for the feet in standing or climbing."
