                        "examples": [
                            {
                                "example_id": "8abd82b0-1bdf-4c28-90c4-29ea3238017b",
                                "sense_id": "f5c4b5dd-ace8-30fb-976d-11c1374461d0",
                                "text": "„Der volle Mond war bisher durch einen lichten Saum leichter silberner Wolken geflogen und sank nun in eine bleifarbige, graue Schneewolke.“"
                            }
