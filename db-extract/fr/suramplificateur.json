                                        "sense_id": "5bdf5505-4dcd-38bd-a2a3-fca7162ee98f",
                                        "entry_id": "1f1b86ec-6dc4-3fa1-99c9-6ba4698d328a",
                                        "glosses": [
                                            "A motor-generator set used for voltage regulation in direct current electrical power circuits."
                                        ],
