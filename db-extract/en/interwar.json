                        "cross_references": [
                            {
                                "target_word": "Zwischenkriegszeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                        "entry_id": "0e5f7083-f425-3403-818b-3a73a83aebb5",
                                        "glosses": [
                                            "Zeitraum zwischen zwei Kriegen, speziell zwischen den beiden Weltkriegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19419ea4-070c-45cb-a29f-edc7f537ff1b",
                                                "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                                "text": "„In der Hetze der Presse spiegelten sich nur die Einstellungen wider, welche die Kirchenhierarchie in der Zwischenkriegszeit (und davor) vertreten hatte.“"
                                            },
                                            {
                                                "example_id": "fd65c742-d38a-4912-94c8-25d83c5f9097",
                                                "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                                "text": "„Die deutsche Geschichtsschreibung hat in der Zwischenkriegszeit eindeutig gegen die Alleinschuldthese Stellung genommen und sich erfolgreich bemüht, die Wahrheit zu erforschen.“"
                                            },
                                            {
                                                "example_id": "7d75399c-6c82-4003-b1bc-4112df546ba4",
                                                "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                                "text": "„In einem sauber gefegten Treppenhaus aus der Zwischenkriegszeit stieg ich auf bräunlich-weißgesprenkelten Terrakottastufen empor.“"
                                            },
                                            {
                                                "example_id": "516ca591-7577-4aab-a6f5-ac6777930347",
                                                "sense_id": "1708663c-7bb6-3e2c-95d0-c1afeab48645",
                                                "text": "„Die neuen Freiheiten und die Auffächerung des politischen Spektrums waren nicht die einzigen Gründe für den Aufschwung, den die jiddische Presse in der Zwischenkriegszeit vor allem in Polen nahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
