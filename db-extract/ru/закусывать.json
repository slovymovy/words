                                "sense_id": "94a8ade7-86e6-3e08-93fe-84f12025d382",
                                "text": "заку́сывать ры́бой",
                                "translation": "to have a bit of fish",
                                "english": "to have a bit of fish"
                            },
                            {
                                "example_id": "38b59902-b787-48ec-bd9b-339efea6b153",
                                "sense_id": "94a8ade7-86e6-3e08-93fe-84f12025d382",
                                "text": "заку́сывать во́дку ры́бой (колбасо́й)",
                                "translation": "to drink vodka with fish (sausage)",
                                "english": "to drink vodka with fish (sausage)"
                            },
                            {
                                "example_id": "ac229c3d-d659-4a21-9982-3ca6d9658e15",
                                "sense_id": "94a8ade7-86e6-3e08-93fe-84f12025d382",
                                "text": "Ста́лин ел дете́й и заку́сывал горчи́цей.",
