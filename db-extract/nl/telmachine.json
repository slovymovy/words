        "nl-extract.jsonl": [
            {
                "entry_id": "6a8648d1-03dc-3a49-9987-beaa85963969",
                "word": "telmachine",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "199ec13f-af89-4cfe-8d24-7299b2379137",
                        "entry_id": "6a8648d1-03dc-3a49-9987-beaa85963969",
                        "tags": [
                            "plural"
                        ],
                        "form": "telmachines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e43305d9-57fe-3645-a478-1c4db85b29d9",
                        "entry_id": "6a8648d1-03dc-3a49-9987-beaa85963969",
                        "glosses": [
                            "een machine waarmee men een speciaal soort voorwerp kan tellen, machine die kan optellen en aftrekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed503234-9054-4769-84ba-3c1570f1c0ba",
                                "sense_id": "e43305d9-57fe-3645-a478-1c4db85b29d9",
                                "text": "De uitnodigende telmachine voor bankbiljetten die hij op zijn designbureau heeft staan, doet vermoeden dat sommige andere klanten niet met lege handen komen. Maar bewijzen daarvan zien we niet. Integendeel. In de chique gangen waar we doorheen moeten en de kleine kamertjes waarin vergaderd wordt, hangt veelal doodse stilte. Alsof we niet in een bank zijn terechtgekomen, maar in een mortuarium."
                            },
                            {
                                "example_id": "d34790dc-72e1-4b24-9318-c94566e99376",
                                "sense_id": "e43305d9-57fe-3645-a478-1c4db85b29d9",
                                "text": "Om zijn radiometrische datering van gesteenten te kunnen voortzetten moest hij zijn uitrusting vaak lenen of in elkaar flansen. Op een gegeven moment werden zijn metingen feitelijk vertraagd omdat hij moest wachten tot de universiteit hem een eenvoudige telmachine zou geven."
                            },
                            {
                                "example_id": "bdcde028-d268-4521-9abe-19b2395ad95a",
                                "sense_id": "e43305d9-57fe-3645-a478-1c4db85b29d9",
                                "text": "Kamphuis ontving vorig jaar een vals biljet in Eibergen en vier, vijf jaar geleden één in Denekamp. \"Maar vier op één dag, dat heb ik nog niet eerder meegemaakt\", zegt de ondernemer. \"Vanmorgen ben ik naar de bank gegaan. De telmachine gooide ze er zo uit.\"De Nederlandse [sic!] Bank vergoedt de schade niet. Ik heb nu een detectieapparaat gekocht. Ik wil dat mij dit niet nog een keer overkomt."
                            },
                            {
                                "example_id": "645a08df-cdc5-4215-99b3-caa70f316be5",
                                "sense_id": "e43305d9-57fe-3645-a478-1c4db85b29d9",
                                "text": "In een vitrine staat een telmachine, die Lowell gebruikte om de afstand tussen zijn kanalen te berekenen. In een andere vitrine ligt Lowells hoed. En de telescoop die hij op zijn vijftiende verjaardag van zijn vader had gekregen en waarmee hij voor het eerst naar Mars keek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "703d925f-7fc4-4d40-acf9-adbeb2f61617",
                        "source_entry_id": "6a8648d1-03dc-3a49-9987-beaa85963969",
                        "source_sense_id": "e43305d9-57fe-3645-a478-1c4db85b29d9",
                        "source_sense_description": "eenvoudige rekenmachine",
                        "target_lang_word": "calculator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calculator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72ea55e3-ceb5-3e2c-b8c3-59276d645594",
                                        "entry_id": "7e862993-9f05-332c-9582-938f050acd91",
                                        "glosses": [
                                            "A mechanical or electronic device that performs mathematical calculations; sometimes, an electronic one specifically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a546999f-941c-49fa-83d4-5522f5c5a4f5",
                                                "sense_id": "72ea55e3-ceb5-3e2c-b8c3-59276d645594",
                                                "text": "electronic calculator;   pocket calculator"
                                            },
                                            {
                                                "example_id": "25ce6f2e-3f51-4429-b8c5-cd40da3a451b",
                                                "sense_id": "72ea55e3-ceb5-3e2c-b8c3-59276d645594",
                                                "text": "The calculator on a bookkeeper's desk in the 1950s was an adding machine with mechanical guts."
                                            },
                                            {
                                                "example_id": "527c5a98-f2d5-4944-8456-5e238d626b53",
                                                "sense_id": "72ea55e3-ceb5-3e2c-b8c3-59276d645594",
                                                "text": "I told him to hand me a calculator and he jokingly placed an adding machine at my side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "236d6694-1edd-39d6-8cdb-157de5894894",
                                        "entry_id": "7e862993-9f05-332c-9582-938f050acd91",
                                        "glosses": [
                                            "A person who performs mathematical calculation."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c983c95d-40b3-4af0-ad5a-7fade303e24a",
                                                "sense_id": "236d6694-1edd-39d6-8cdb-157de5894894",
                                                "text": "During the war, his grandmother had worked at the Bletchley Park decoding station as a calculator."
                                            },
                                            {
                                                "example_id": "03bb80d9-6947-426f-b1f8-601fdf4b8df6",
                                                "sense_id": "236d6694-1edd-39d6-8cdb-157de5894894",
                                                "text": "First, many real-world investors bear little resemblance to the cool calculators of efficient-market theory: they're all too subject to herd behavior, to bouts of irrational exuberance and unwarranted panic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                        "entry_id": "7e862993-9f05-332c-9582-938f050acd91",
                                        "glosses": [
                                            "A person who calculates (in the sense of scheming)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871b81b5-a2b4-4e58-8c1b-5f31d901ab23",
                                                "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                                "text": "Near-synonyms: schemer, plotter; manipulator"
                                            },
                                            {
                                                "example_id": "b43291fd-07fd-4dc3-8d60-169ca081edd5",
                                                "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                                "text": "He revealed himself to be a cold-blooded calculator out to sabotage his colleagues."
                                            },
                                            {
                                                "example_id": "4ca7a3be-05b4-4e33-9885-f846e54fa476",
                                                "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                                "text": "Talk not thus, I implore you, Evelyn: do not imagine me the worldly calculator that my enemies deem me."
                                            },
                                            {
                                                "example_id": "088e02c3-185e-418d-b63a-482e6c2c5da8",
                                                "sense_id": "28fed7a7-cb2e-3d83-baed-bb6a750bb30d",
                                                "text": "You have in the merchant the shrewd calculator of probable contingencies; we shall see that we have in the prophet the absolute proclaimer of necessary and inevitable facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4d1bfed-3381-3bd0-91c4-794e00968229",
                                        "entry_id": "7e862993-9f05-332c-9582-938f050acd91",
                                        "glosses": [
                                            "A set of mathematical tables."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
