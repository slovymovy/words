                "senses": [
                    {
                        "sense_id": "9c07a299-e567-3dd4-95d0-f816f4808289",
                        "entry_id": "990be76f-8a24-3a70-9da3-d394071511a3",
                        "glosses": [
                            "Sans fondement, qui ne repose sur rien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f637da3-ed27-419d-935d-b583d494fdf6",
                                "sense_id": "9c07a299-e567-3dd4-95d0-f816f4808289",
                                "text": "La rumeur qu’il était mort se révéla infondée."
                            },
                            {
                                "example_id": "1d4872b6-69b2-4b4d-b644-3cd04a28a39c",
                                "sense_id": "9c07a299-e567-3dd4-95d0-f816f4808289",
                                "text": "Mais, moi, j’avais vu la vache bleue. Je l’ai défendue, mais personne ne m’a crue non plus. Tout le monde m’a accusée de dire des choses infondées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90620755-63ac-4f11-9c90-77765735d24b",
                        "source_entry_id": "990be76f-8a24-3a70-9da3-d394071511a3",
                        "source_sense_id": "9c07a299-e567-3dd4-95d0-f816f4808289",
                        "target_lang_word": "baseless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baseless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c71da2dd-e6e9-3b97-83f8-995eb557fe99",
                                        "entry_id": "dc25f9f5-4f04-3b81-bf66-716cf3440e12",
                                        "glosses": [
                                            "Of reasoning: based on something that is not true, or not based on solid reasons or facts; unfounded; without a basis."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "360eddd7-6421-480a-9147-00e092aaf08b",
                                                "sense_id": "c71da2dd-e6e9-3b97-83f8-995eb557fe99",
                                                "text": "baseless accusations; baseless rumors"
                                            },
                                            {
                                                "example_id": "1447717f-5a6e-44a9-9593-cb8de5c17e18",
                                                "sense_id": "c71da2dd-e6e9-3b97-83f8-995eb557fe99",
                                                "text": "But Rodríguez says, “Neither the law nor the facts support Senator Grassley’s baseless allegations and extrapolated conclusions."
                                            },
                                            {
                                                "example_id": "19712db6-1734-4efa-9424-3023819ce0d9",
                                                "sense_id": "c71da2dd-e6e9-3b97-83f8-995eb557fe99",
                                                "text": "Speaking to RAIL, a DfT spokesman said: \"We do not recognise these baseless, false figures. Just last month we provided an update to Parliament on the costs of the project and confirmed that it would be delivered within the funding envelope. […].\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b31921a0-1b95-37b4-a3b2-34fcb1e662ad",
                                        "entry_id": "dc25f9f5-4f04-3b81-bf66-716cf3440e12",
                                        "glosses": [
                                            "Without a physical base."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b62b8ff2-87df-417e-befb-3e53915140b3",
                                                "sense_id": "b31921a0-1b95-37b4-a3b2-34fcb1e662ad",
                                                "text": "More significant still — and most obviously in debt to the painterly imagination — this floating statue is the first baseless statue ever made. It is as though Bernini had taken Michelangelo's 'Pieta' and made it fly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed6d2f7a-6424-4687-a5b0-88caa30271d3",
                        "source_entry_id": "990be76f-8a24-3a70-9da3-d394071511a3",
                        "source_sense_id": "9c07a299-e567-3dd4-95d0-f816f4808289",
                        "target_lang_word": "groundless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groundless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4685ef6-9d6f-3b54-ae7e-7aacad4139d2",
                                        "entry_id": "4892bb27-1789-352f-96a1-1e163589fd80",
                                        "glosses": [
                                            "Without any grounds to support it; baseless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66e90edd-6e12-46b6-a10d-a46d47b2d5a5",
                                                "sense_id": "b4685ef6-9d6f-3b54-ae7e-7aacad4139d2",
                                                "text": "[B]e the consequences what they may, they shall not move an inch, nor a hair's-breadth from the ground of their groundless spiritual independence, […]"
                                            },
                                            {
                                                "example_id": "bfaa6d30-8515-45f9-b565-0f9e55c8d2f0",
                                                "sense_id": "b4685ef6-9d6f-3b54-ae7e-7aacad4139d2",
                                                "text": "At that stage any fears among home fans of a possession monopoly by Laudrup's side were proving groundless, with Cardiff having their fair share of the ball and territory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
