                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d661feee-cbc0-48b9-aa5f-d9cd6a6cdb76",
                                "sense_id": "dd168e12-a9eb-380e-a422-1e98b56146d8",
                                "text": "А сейчас я себе рубаху постирал и сосновые щепки жую против цинги."
                            }
                        ]
                    }
