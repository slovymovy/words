                "senses": [
                    {
                        "sense_id": "f1ff22a5-a137-3926-a056-ce59e28af3ba",
                        "entry_id": "10641049-46a3-39b0-a324-0ed24a410c77",
                        "glosses": [
                            "Turm, der anlässlich der Weltausstellung in Paris errichtet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff6925c6-c5b5-48d4-839a-3c2ad2b22659",
                                "sense_id": "f1ff22a5-a137-3926-a056-ce59e28af3ba",
                                "text": "Wir werden morgen den Eiffelturm besichtigen."
                            },
                            {
                                "example_id": "e087d977-1942-459e-a03f-bfab4828cb9e",
                                "sense_id": "f1ff22a5-a137-3926-a056-ce59e28af3ba",
                                "text": "„An diesem Abend sollte die erste – von hoffentlich vielen – Bloomsday-Partys in Joyce' neuem Zuhause am Square de Robiac in der Nähe des Eiffelturms stattfinden.“"
                            },
                            {
                                "example_id": "9d0fcda5-5eba-4233-95d6-8a540d1c3326",
                                "sense_id": "f1ff22a5-a137-3926-a056-ce59e28af3ba",
                                "text": "„Wir haben eine Bootsfahrt auf der Seine gemacht und den Eiffelturm bestiegen, sind durchs Marais spaziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
