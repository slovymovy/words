                                        "examples": [
                                            {
                                                "example_id": "5c9675d0-242c-470d-a7df-9562585b2864",
                                                "sense_id": "952ba6dc-2b6b-391f-a44c-216a9ea8adc0",
                                                "text": "Es gibt Milch, die nicht leicht und schnell verkäst."
                                            },
                                            {
                                                "example_id": "7289ad4d-43ea-4659-8912-c31f13b8fa50",
                                                "sense_id": "952ba6dc-2b6b-391f-a44c-216a9ea8adc0",
                                                "text": "„Stutenmilch, die nicht zum Verkäsen geeignet ist, ist sehr wässrig und hilft manchen bei Kuhmilchunverträglichkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db63f69d-fca6-3cc7-9297-480c5896e390",
                                        "entry_id": "2cd401e3-3d1f-318e-afd3-8f7f99e5ca41",
                                        "glosses": [
                                            "zu Käse machen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "308d5ea3-a322-46e2-b238-83532550b66c",
                                                "sense_id": "db63f69d-fca6-3cc7-9297-480c5896e390",
                                                "text": "„Stutenmilch, die nicht zum Verkäsen geeignet ist, ist sehr wässrig und hilft manchen bei Kuhmilchunverträglichkeiten.“"
                                            },
                                            {
                                                "example_id": "16b0f999-c160-408d-9554-010c3d3398ad",
                                                "sense_id": "db63f69d-fca6-3cc7-9297-480c5896e390",
                                                "text": "Die Bäuerin begann noch am gleichen Tag, den Milchüberschuss zu verkäsen."
                                            },
                                            {
                                                "example_id": "9a91334f-5a80-4f59-b545-b653f4b78522",
                                                "sense_id": "db63f69d-fca6-3cc7-9297-480c5896e390",
                                                "text": "„Im Gegensatz zu anderen Ländern wird in Deutschland nur ein relativ geringer Anteil der insgesamt erzeugten Milch verkäst, viel größer ist der Anteil der verbutterten Vollmilch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "29a2502a-7d22-3edb-b78b-ec95289d71f3",
                                        "entry_id": "2cd401e3-3d1f-318e-afd3-8f7f99e5ca41",
                                        "glosses": [
                                            "eine käseartige Struktur bekommen"
