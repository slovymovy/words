                "senses": [
                    {
                        "sense_id": "dac6ca8e-2901-3552-adf4-b95456163af7",
                        "entry_id": "e564922a-b825-3544-87b6-c1e568111475",
                        "glosses": [
                            "grundlegende, essentielle, unverzichtbare Tätigkeit/Aktivität"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "36b9227c-164b-4893-87f5-59ef4c4d288b",
                                "sense_id": "dac6ca8e-2901-3552-adf4-b95456163af7",
                                "text": "„Laufen ist eine Grundbetätigung des Menschen.“"
                            },
                            {
                                "example_id": "cf436680-3949-4699-b034-b8c8f5c71b7d",
                                "sense_id": "dac6ca8e-2901-3552-adf4-b95456163af7",
                                "text": "„Es ist eine natürliche Grundbetätigung des Menschen, die jeder von Natur aus kann, ohne sie umständlich erlernen zu müssen.“"
                            },
                            {
                                "example_id": "afa844c9-879c-4fb0-9f2e-748183258063",
                                "sense_id": "dac6ca8e-2901-3552-adf4-b95456163af7",
                                "text": "„Elektrizität ist bekanntlich ein Bewegungszustand, welcher als Grundbetätigung aller Kraft angesehen wird.“"
                            },
                            {
                                "example_id": "a5bf460d-4816-4972-96a1-d9d6a5b3f25a",
                                "sense_id": "dac6ca8e-2901-3552-adf4-b95456163af7",
                                "text": "„Ein im Sinne des § 8 Abs. 3 UWG klagebefugter Verband muss in der Lage sein, seine Fixkosten aus der Existenz, Grundausstattung und Grundbetätigung, Prozesskosten in Verfahren bis hin zur Revisionsinstanz und gegnerische Kostenerstattungsansprüche zu finanzieren.“"
                            },
                            {
                                "example_id": "ef21e971-357a-4d6c-9e40-a9e9b3d0fa30",
                                "sense_id": "dac6ca8e-2901-3552-adf4-b95456163af7",
                                "text": "„Der Kläger wird durch die Mitgliedsbeiträge in Höhe von c.a. [sic!] 600.000 € mit ausreichenden finanziellen Mitteln ausgestattet, die es ihm ermöglichen, seine Fixkosten aus der Existenz, seine Grundausstattung, Grundbetätigung und etwaige gegnerische Kostenerstattungsansprüche abzudecken.“"
                            },
                            {
                                "example_id": "61b96439-4ed5-4ee8-bbaa-5e96de1f1daa",
                                "sense_id": "dac6ca8e-2901-3552-adf4-b95456163af7",
                                "text": "„Darüber hinaus ermögliche sie eine gewisse sportliche Grundbetätigung, die mittlerweile als Grundbedürfnis einzuordnen sei.“"
                            },
                            {
                                "example_id": "1826d874-59b0-41ff-8ded-845d4bc8117b",
                                "sense_id": "dac6ca8e-2901-3552-adf4-b95456163af7",
                                "text": "„Darüber hinaus ermöglicht die wasserfeste Prothese dem Kläger eine gewisse sportliche Grundbetätigung, die der Gesunderhaltung dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
