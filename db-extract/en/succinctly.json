                ],
                "translations": [
                    {
                        "translation_id": "a0bdbb51-7b35-49e4-8921-a8244d93119e",
                        "source_entry_id": "e43b98fd-5064-318f-b3f3-36373878d148",
                        "source_sense_id": "f5f531c3-645c-3fef-84bb-0278e3aceb4d",
                        "source_sense_description": "kurz und bündig, knapp, lakonisch, prägnant, lapidar",
                        "target_lang_word": "kurz und bündig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurz und bündig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                        "entry_id": "11e605df-cdd1-3ea1-b2cb-52a91ad368b6",
                                        "glosses": [
                                            "deutlich, knapp und prägnant"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e1eda2-5345-47af-8312-625441523709",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "Am Ende der Vortrags fasste der Redner zusammen: „Kurz und bündig: Alle Straßen, also auch Autobahnen, gehören in Staatshand!“"
                                            },
                                            {
                                                "example_id": "1c46c9a2-6b79-40d5-b692-8949e501eef5",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "Der CEO wandte sich an seine Mitarbeiter: „Kurz und bündig: Wir müssen besser werden!“"
                                            },
                                            {
                                                "example_id": "cb7f7acd-818b-4a4f-b225-a24b5ce39148",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "Auf NDR-Nachfrage teilte das Bundespresseamt kurz und bündig mit: „Der Bitte der Hamburger Polizei konnte das BPA aus rechtlichen Gründen nicht entsprechen.“"
                                            },
                                            {
                                                "example_id": "b8b9fff1-05bc-4cd9-94e7-3bebda4db757",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "Augustinus definiert in De mendacio ca. 395 n. Chr. die Lüge kurz und bündig: Es lügt, wer täuschen will."
                                            },
                                            {
                                                "example_id": "8e5a3f95-b30d-474b-99bf-ccaded55fe7a",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "In einer SMS sollte man den Text kurz und bündig halten."
                                            },
                                            {
                                                "example_id": "124b3f3a-84ee-45c5-9568-0bbb0f8b9bae",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "Elisabeth Selbert (SPD): \"Ich hatte [im Parlamentarischen Rat] beantragt, den Artikel 3 so zu formulieren: Männer und Frauen sind gleichberechtigt, ganz kurz und bündig.\""
                                            },
                                            {
                                                "example_id": "b6f48da5-4090-412a-ac6a-bf59abb7e5a6",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "Auf dem Centre Court des All England Lawn Tennis and Croquet Clubs kämpfen überraschend zwei deutsche Spielerinnen um den Weltturnier-Sieg, was ein BBC-Reporter kurz und bündig wie folgt zusammenfasst: „The women's final was an all german affaire between Fräulein Aussem and Krahwinkel, won by Fräulein Aussem.“"
                                            },
                                            {
                                                "example_id": "3b554680-972e-4e7f-b809-801b4182a306",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "Der ganz eigene Sound des Romans - kurz und bündig, nur das Notwendigste erzählend – zeugt vom Gespür des Autors für die Belange und die Seelenlage der Dorfbewohner."
                                            },
                                            {
                                                "example_id": "bb3dd034-634b-4de0-81d8-1a34b88a40ff",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "Redox ist ein Unix-Betriebssystem, das in Mozillas noch junger Programmiersprache Rust geschrieben wurde […] Warum ein weiteres Betriebssystem überhaupt gebraucht werde, wird kurz und bündig mit »Windows 10, System D, Ubuntu Unity« beantwortet."
                                            },
                                            {
                                                "example_id": "ce9d77bb-1c01-4864-b214-6b8cf845a943",
                                                "sense_id": "c58871ca-cb5f-315c-a6a9-c47530800a00",
                                                "text": "Legendär: Augenthalers 44-Sekunden-Pressekonferenz: […] Augenthaler stellte sich selbst vier Fragen, die er kurz und bündig beantwortete, und verließ zur Verblüffung der Journalisten […] nach nur 44 Sekunden das Podium."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
