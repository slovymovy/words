                                    {
                                        "sense_id": "275bbf6a-293f-3a5d-8e25-827e8552b745",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Action de renvoyer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7eaae90-0a9e-42ab-8e5c-95799eda7f5a",
                                                "sense_id": "275bbf6a-293f-3a5d-8e25-827e8552b745",
                                                "text": "Renvoi de marchandises."
                                            },
                                            {
                                                "example_id": "75d57e02-6089-40b8-8fba-a729396d92db",
                                                "sense_id": "275bbf6a-293f-3a5d-8e25-827e8552b745",
                                                "text": "Renvoi d’une lettre de change."
                                            },
                                            {
                                                "example_id": "817f9404-984a-4e01-a7f0-b8a481261177",
                                                "sense_id": "275bbf6a-293f-3a5d-8e25-827e8552b745",
                                                "text": "Le renvoi d’un présent."
                                            },
                                            {
                                                "example_id": "fd9a82e0-8f62-4b67-99dc-e1b0d6475995",
                                                "sense_id": "275bbf6a-293f-3a5d-8e25-827e8552b745",
                                                "text": "Le renvoi du son, des paroles par l’écho, leur répercussion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de030da7-cefe-3e5c-a7b5-bad40c374ac1",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Renvoi téléphonique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6c3c7b-dc2c-4fad-b6d6-f02f8c5b31fa",
                                                "sense_id": "de030da7-cefe-3e5c-a7b5-bad40c374ac1",
                                                "text": "Il a défini le renvoi du poste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ec24349-85dc-3b4e-ba4c-ca55aa2c63b8",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "En parlant d’une personne, action de retirer à quelqu’un sa fonction, son emploi, de le congédier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa1b5257-132e-40ed-8ab7-30102a2f8684",
                                                "sense_id": "6ec24349-85dc-3b4e-ba4c-ca55aa2c63b8",
                                                "text": "Le renvoi d’un ministre."
                                            },
                                            {
                                                "example_id": "7f8d00e5-493b-4b2c-9230-cd5e94e8d8de",
                                                "sense_id": "6ec24349-85dc-3b4e-ba4c-ca55aa2c63b8",
                                                "text": "Le renvoi d’un employé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8c14632-b90e-33c5-aaef-a9d6d0cceef2",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Ajournement, remise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad27d83-0508-4a70-8623-0cc7af9676d6",
                                                "sense_id": "b8c14632-b90e-33c5-aaef-a9d6d0cceef2",
                                                "text": "Le renvoi de la cause à huitaine, aux prochaines assises."
                                            },
                                            {
                                                "example_id": "08bc25f1-d3a1-4f0b-b057-b6d2e381334d",
                                                "sense_id": "b8c14632-b90e-33c5-aaef-a9d6d0cceef2",
                                                "text": "Plusieurs députés demandaient le renvoi de la discussion au lendemain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "627f4d54-e76c-3b36-aeff-5c87e0881969",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Action de renvoyer une demande, une proposition, etc., à ceux qui doivent l’examiner, y faire droit, ou en rendre compte."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a478572-36c4-4dcf-adf7-27d8060b9007",
                                                "sense_id": "627f4d54-e76c-3b36-aeff-5c87e0881969",
                                                "text": "La Chambre des députés a ordonné le renvoi de cette pétition au ministre de la guerre."
                                            },
                                            {
                                                "example_id": "7ceafc28-c6f5-4e82-b7fe-49baf9b93065",
                                                "sense_id": "627f4d54-e76c-3b36-aeff-5c87e0881969",
                                                "text": "Le renvoi d’une proposition dans les bureaux, à l’examen des bureaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c68a50e-8704-3512-98dc-40d4bc41b34f",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Il désigne particulièrement, en termes de jurisprudence, l’action de renvoyer une partie, un procès en matière civile ou criminelle devant un autre tribunal que le tribunal saisi."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf460a79-1458-4a16-aabe-2ff9f8ab54af",
                                                "sense_id": "6c68a50e-8704-3512-98dc-40d4bc41b34f",
                                                "text": "Il a obtenu son renvoi devant ses juges naturels."
                                            },
                                            {
                                                "example_id": "a002379b-1950-4db5-84e9-4792d83822b5",
                                                "sense_id": "6c68a50e-8704-3512-98dc-40d4bc41b34f",
                                                "text": "Demande en renvoi."
                                            },
                                            {
                                                "example_id": "5547779e-6241-4b1d-9334-ec159a4a1e74",
                                                "sense_id": "6c68a50e-8704-3512-98dc-40d4bc41b34f",
                                                "text": "Demander un renvoi."
                                            },
                                            {
                                                "example_id": "16402b26-d734-41e0-b372-9b64f145ac95",
                                                "sense_id": "6c68a50e-8704-3512-98dc-40d4bc41b34f",
                                                "text": "Arrêt de renvoi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ae86072-a31a-36be-abba-5e538e4abf93",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "En parlant d’un texte, désigne une marque, chiffre, lettre ou signe, qui renvoie le lecteur à une marque semblable placée hors du texte et après laquelle se trouve une note."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05e6c5c-1aab-4158-9ce2-6a28103a685a",
                                                "sense_id": "6ae86072-a31a-36be-abba-5e538e4abf93",
                                                "text": "Une trop grande quantité de renvois fatigue le lecteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f2ef5af-e38e-319a-9b3a-d870dae0e004",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Avertissement qui indique qu’on trouvera à une autre page du même livre la suite de ce qui est interrompu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f53d4f-c1b8-404c-b0ef-eb90d89bb6da",
                                                "sense_id": "2f2ef5af-e38e-319a-9b3a-d870dae0e004",
                                                "text": "Il y a dans ce bréviaire, dans ce livre de prières beaucoup de renvois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5378f41-16bb-31a4-bbad-7c19461799a2",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Il se dit également en parlant d’un acte notarié, d’un écrit, et désigne la marque qui renvoie à une addition écrite en marge ou au bas de la page et qui doit se joindre au texte ; il se dit aussi de l’addition même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d4745f-3ffb-4765-9897-643126bd8867",
                                                "sense_id": "b5378f41-16bb-31a4-bbad-7c19461799a2",
                                                "text": "Il y a dans cette minute des renvois qui ne sont point parafés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d2ce5b2-ebed-302f-8383-774875c51bce",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Signe qui, correspondant à un autre signe semblable, indique qu’il faut recommencer à l’endroit où ce dernier se trouve placé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "486b29d8-899f-3360-88fe-49bce926d679",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Éructation produite par une contraction de l’estomac."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2c66294-283d-48ba-b45c-550538c88249",
                                                "sense_id": "486b29d8-899f-3360-88fe-49bce926d679",
                                                "text": "N'oublions pas qu’il y a également, dans la famille, une histoire d’héritage qui peut mettre du gras dans le placard et donner des renvois de colère au plus brave type de la terre."
                                            },
                                            {
                                                "example_id": "9db98682-112e-4578-a1da-325a49f5de39",
                                                "sense_id": "486b29d8-899f-3360-88fe-49bce926d679",
                                                "text": "Quand elle eut fini son biberon, Dany la redressa et attendit l’inévitable et précieux renvoi."
                                            },
                                            {
                                                "example_id": "154cf81e-4678-454e-90bd-44a35e9e4c04",
                                                "sense_id": "486b29d8-899f-3360-88fe-49bce926d679",
                                                "text": "Il eut à la fin du repas deux ou trois renvois patriarcaux, et s’en fut chanceler vaguement à ses affaires."
                                            },
                                            {
                                                "example_id": "f8b3a824-757e-4fc4-b754-adc23c08128d",
                                                "sense_id": "486b29d8-899f-3360-88fe-49bce926d679",
                                                "text": "Derrière l’amertume de ses renvois d'estomac, il ressentait comme un sentiment diffus de corruption. Il but un verre d’eau dans lequel il avait laissé fondre un comprimé digestif et ses scrupules se dissipèrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e96f2bd7-2643-338b-994c-cbc256eef856",
                                        "entry_id": "1d45ef07-1283-3bf3-a4ce-e2e1085ee3c1",
                                        "glosses": [
                                            "Dispositif de guidage d’un lien souple — cordage, élingue, chaîne… — et permettant un changement de la direction de l’effort de traction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
