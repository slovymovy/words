                        "glosses": [
                            "particuliere onderneming waar patiënten behandeld kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a79d488b-b78e-489b-97a5-73fc19bbef97",
                                "sense_id": "82f1fc68-badb-38c1-8fc2-a150972ec012",
                                "text": "Mijn steiger en boothuis zijn een soort privékliniek geworden met één enkele patiënt."
                            },
                            {
                                "example_id": "80593cf0-3fd5-426b-b1fb-eca2897f0fbf",
                                "sense_id": "82f1fc68-badb-38c1-8fc2-a150972ec012",
                                "text": "Haar echtgenoot heeft een vaste baan, met een goede ziektekostenverzekering voor het hele gezin. Luciana kon terecht in een privékliniek. Haar tante, Silvana, moest naar een publiek ziekenhuis. \"Om naar een particulier ziekenhuis te kunnen gaan, moet je geld hebben, of een goede baan. Dat had mijn moeder niet\", verzucht haar dochter, Ana."
                            }
                        ]
                    }
