                        "source_sense_id": "122e599e-56c1-321b-b60d-12dd7a79bcb5",
                        "source_sense_description": "kleine parasieten die voorkomen in het schaamhaar, maar ook op wimpers...",
                        "target_lang_word": "morpion",
                        "target_lang_code": "fr",
