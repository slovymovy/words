{
    "word_family": [
        "confondre",
        "confusion",
        "confusément"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2634f5b9-234b-3928-a1e4-55ebbeb211e5",
                    "sense_definition": "Qui éprouve de la honte, de la gêne ou un vif embarras.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est resté tout <w>confus</w> après s'être rendu compte de son erreur."
                        },
                        {
                            "text": "Je suis vraiment <w>confus</w> de vous déranger à une heure si tardive."
                        }
                    ],
                    "synonyms": [
                        "gêné",
                        "embarrassé",
                        "honteux"
                    ],
                    "antonyms": [
                        "assuré",
                        "fier"
                    ],
                    "common_phrases": [
                        "tout confus",
                        "rester confus"
                    ]
                },
                {
                    "sense_id": "e21bbcd5-0089-3297-a147-15a7fc0f30f6",
                    "sense_definition": "Qui manque d'ordre, de netteté ou de clarté pour l'esprit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son explication était si <w>confuse</w> que personne n'a réussi à comprendre le problème."
                        },
                        {
                            "text": "Je n'ai plus qu'un souvenir très <w>confus</w> des événements de cette soirée."
                        }
                    ],
                    "synonyms": [
                        "brouillon",
                        "embrouillé",
                        "flou",
                        "obscur"
                    ],
                    "antonyms": [
                        "clair",
                        "limpide",
                        "net",
                        "précis"
                    ],
                    "common_phrases": [
                        "souvenir confus",
                        "explication confuse"
                    ]
                },
                {
                    "sense_id": "94bb64c6-e59c-3e56-941e-302a95f25e30",
                    "sense_definition": "Qui se mêle à d'autres perceptions et ne se distingue pas nettement, en parlant de sons ou d'images.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un bruit <w>confus</w> montait de la rue animée dès le lever du soleil."
                        },
                        {
                            "text": "Elle entendait des murmures <w>confus</w> venant de la pièce voisine."
                        }
                    ],
                    "synonyms": [
                        "indistinct",
                        "vague"
                    ],
                    "antonyms": [
                        "distinct",
                        "audible"
                    ],
                    "common_phrases": [
                        "bruit confus",
                        "murmures confus"
                    ]
                },
                {
                    "sense_id": "fe2b0f47-e31b-3606-9710-c592dfc7d622",
                    "sense_definition": "Dont les éléments matériels sont mélangés de façon désordonnée et impossibles à distinguer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vieux papiers formaient un amas <w>confus</w> au fond du tiroir."
                        },
                        {
                            "text": "Au fond de l'atelier régnait un mélange <w>confus</w> d'outils et de ferraille."
                        }
                    ],
                    "synonyms": [
                        "désordonné",
                        "indifférencié",
                        "pêle-mêle"
                    ],
                    "antonyms": [
                        "ordonné",
                        "distinct"
                    ],
                    "common_phrases": [
                        "amas confus"
                    ]
                },
                {
                    "sense_id": "59a297d9-eb74-3b19-abbc-2b164685f3f6",
                    "sense_definition": "Qui réunit des qualités ou des droits opposés sur une même personne.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces charges juridiques sont devenues <w>confuses</w> en sa personne après la signature du contrat."
                        },
                        {
                            "text": "Les droits du débiteur et du créancier étaient désormais <w>confus</w> en un seul héritier."
                        }
                    ],
                    "antonyms": [
                        "séparé"
                    ]
                }
            ]
        }
    ]
}