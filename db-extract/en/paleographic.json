                "senses": [
                    {
                        "sense_id": "85040b21-be29-329a-bc1c-1389a181d6c7",
                        "entry_id": "07465409-8fd6-33bb-adeb-7b52fd8f92f6",
                        "glosses": [
                            "Of or pertaining to paleography."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "84522ece-28a6-4e2b-b0f2-7f05c544554e",
                                "sense_id": "85040b21-be29-329a-bc1c-1389a181d6c7",
                                "text": "Paleographic students are more or less familiar with about seventy early inscribed stones in Wales. The value of these monuments, as corroborative evidence of historical facts, in connection with waning popular traditions, is well understood."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d7c382a-5110-47e7-96ce-1df8ce66c3ca",
