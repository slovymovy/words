                        "examples": [
                            {
                                "example_id": "63be279a-165f-486b-a485-6cefcf3d7474",
                                "sense_id": "009812ed-b837-33e5-b200-e0a281ae2640",
                                "text": "Het landelijk cold case-team Rotterdam is mogelijk een seriemoordenaar op het spoor die verantwoordelijk is voor de moord op vijf prostituees. Bij het heronderzoek van de vijf oude moordzaken zijn opvallende overeenkomsten gevonden, meldt Nieuwsuur."
                            },
                            {
                                "example_id": "aa9e1dde-d2e4-477d-8ecb-43cb368e2b51",
                                "sense_id": "009812ed-b837-33e5-b200-e0a281ae2640",
                                "text": "Volgens de Rekenkamer is het algoritme om het risico op uitkeringsfraude in te schatten getraind met bevooroordeelde data. Er zijn vooral data gebruikt van uitkeringsontvangers die eerder al een heronderzoek gekregen hebben, in plaats van data van alle uitkeringsontvangers. Daardoor kan het zijn dat het algoritme mensen met bepaalde kenmerken die niet per se relevant zijn er eerder uitpikt voor heronderzoek."
                            }
                        ]
                    }
