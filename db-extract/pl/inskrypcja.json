                        ],
                        "examples": [
                            {
                                "example_id": "d7abd2a4-ffcc-421a-9944-f8f7720a1f6a",
                                "sense_id": "a1a6baf1-0b4c-3295-9287-56e2c8f2e895",
                                "text": "Około tysiąc linii tekstu inskrypcji zostało wyrytych na skale około 100 metrów nad drogą."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
