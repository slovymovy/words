                    {
                        "sense_id": "86f70639-6ea5-3802-8993-5b4faa738fee",
                        "entry_id": "32e02d3c-0f8e-30dc-a6e8-8451931b4c2a",
                        "glosses": [
                            "eine öffentliche römische Badeanlage"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a53a99de-68f8-4812-92f5-4ae3eadc0e96",
                                "sense_id": "86f70639-6ea5-3802-8993-5b4faa738fee",
                                "text": "Schon in römischer Zeit bestanden die Thermen aus mehreren komplexen Baugruppen mit einer Vielzahl unterschiedlicher Räume."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9543372d-ca0e-317d-b104-c6e8f89e0f92",
                        "entry_id": "32e02d3c-0f8e-30dc-a6e8-8451931b4c2a",
                        "glosses": [
                            "eine natürliche Quelle, deren durchschnittliche Wassertemperatur höher als die mittlere Jahrestemperatur des Ortes ist, an dem sie zutage tritt"
                        ],
                        "tags": [
                            "Thermalquelle"
                        ],
                        "examples": [
                            {
                                "example_id": "a916adab-f7be-41b3-970c-086469f99e38",
                                "sense_id": "9543372d-ca0e-317d-b104-c6e8f89e0f92",
                                "text": "Karlsbad ist eine Therme."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b3f8ef7a-4999-3fb0-af42-1b0f881a480d",
                        "entry_id": "32e02d3c-0f8e-30dc-a6e8-8451931b4c2a",
                        "glosses": [
                            "ein über einer Thermalquelle errichtetes Bad oder Heilbad"
                        ],
                        "tags": [
                            "Thermalbad"
                        ],
                        "examples": [
                            {
                                "example_id": "9b126a6e-1fd9-48ec-bcbc-01e554022c33",
                                "sense_id": "b3f8ef7a-4999-3fb0-af42-1b0f881a480d",
                                "text": "Karlsbad ist eine Therme."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "c78507be-a280-37cb-b1f6-63e6edc42a10",
                        "entry_id": "32e02d3c-0f8e-30dc-a6e8-8451931b4c2a",
                        "glosses": [
                            "eine meist mit Öl oder Gas betriebene wandhängende Heizanlage (nur für die Heizung), oder als Kombitherme (für Warmwasser und Heizung)"
                        ],
                        "tags": [
                            "Etagenheizung"
                        ],
                        "examples": [
                            {
                                "example_id": "2f5aeb31-6e8c-4075-bf20-c2b5dcc7a45d",
                                "sense_id": "c78507be-a280-37cb-b1f6-63e6edc42a10",
                                "text": "Die Thermen sollten nur vom Fachmann eingebaut werden."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06cee9e4-f872-4302-84a6-3027e23b2add",
                        "source_entry_id": "32e02d3c-0f8e-30dc-a6e8-8451931b4c2a",
                        "source_sense_id": "86f70639-6ea5-3802-8993-5b4faa738fee",
                        "source_sense_description": "Architektur: historisch: eine öffentliche römische Badeanlage",
                        "target_lang_word": "thermal bath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fe8e7952-4a4d-449b-8a1c-52f96d8ab80c",
                        "source_entry_id": "32e02d3c-0f8e-30dc-a6e8-8451931b4c2a",
                        "source_sense_id": "86f70639-6ea5-3802-8993-5b4faa738fee",
                        "source_sense_description": "Architektur: historisch: eine öffentliche römische Badeanlage",
                        "target_lang_word": "thermes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thermes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fec8c08-e8fc-35a8-b18b-b96827800123",
                                        "entry_id": "25b449f4-d5ea-38ea-a010-1f4d3fb18c19",
                                        "glosses": [
                                            "Établissement de bains publics chauds, qui comprenait souvent des palestres, des gymnases, des bibliothèques, des jardins, etc."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b2c8dc7-4f74-425a-8a04-beae1ce6ec9a",
                                                "sense_id": "2fec8c08-e8fc-35a8-b18b-b96827800123",
                                                "text": "Les thermes de Titus, de Caracalla, de Dioclétien, dont les ruines imposantes existent encore à Rome, abritent des festivals l'été."
                                            },
                                            {
                                                "example_id": "4531b381-979c-42ec-8fc0-6f82b43b61ef",
                                                "sense_id": "2fec8c08-e8fc-35a8-b18b-b96827800123",
                                                "text": "Près de Cluny, ce palais romain, à belles arches cintrées, c'étaient les Thermes de Julien (…)"
                                            },
                                            {
                                                "example_id": "c6d84843-4f54-4051-b357-1ed34a8b50f3",
                                                "sense_id": "2fec8c08-e8fc-35a8-b18b-b96827800123",
                                                "text": "Le plan que suivit l'administration française pour le déblaiement du Forum fut celui que Raphaël avait proposé à Léon X : (…) elle enleva les terres qui recouvraient l'emmarchement du Colisée, vida l'intérieur de l'arène et fit reparaître sept ou huit salles des bains de Titus.\n Ailleurs le Forum de Trajan fut exploré ; on répara le Panthéon, les Thermes de Dioclétien, le temple de la Pudicité patricienne. Des fonds furent assignés pour entretenir, hors de Rome, les murs de Faléries et le tombeau de Cecilia Metella."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db5182e6-af3c-3491-943b-82ffab3f8e08",
                                        "entry_id": "25b449f4-d5ea-38ea-a010-1f4d3fb18c19",
                                        "glosses": [
                                            "(Aujourd’hui) Établissement thermal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811bb79b-b8dd-4b19-ad6a-ae0fbc267f65",
                                                "sense_id": "db5182e6-af3c-3491-943b-82ffab3f8e08",
                                                "text": "Une navette mène les curistes de la gare aux thermes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
