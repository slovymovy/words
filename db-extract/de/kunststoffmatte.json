                ],
                "senses": [
                    {
                        "sense_id": "0677bc30-e179-342c-80d0-78bc57d2ec9b",
                        "entry_id": "6c920341-17dc-3df4-add6-848dc6fdb20b",
                        "glosses": [
                            "Matte aus Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dca48bb1-5edb-4cc9-8f66-43bbc66324a2",
                                "sense_id": "0677bc30-e179-342c-80d0-78bc57d2ec9b",
                                "text": "„Die Kunststoffmatten gibt es in verschiedenen Farben und Abmessungen.“"
                            },
                            {
                                "example_id": "5d643327-d886-4457-be01-65ec2b799271",
                                "sense_id": "0677bc30-e179-342c-80d0-78bc57d2ec9b",
                                "text": "„Ein Spezialschlepper beim Einbürsten von Quarzsand in die zuvor verlegte Kunststoffmatte.“"
                            },
                            {
                                "example_id": "3ef662e1-b2ef-42e4-b56a-978f61f5164e",
                                "sense_id": "0677bc30-e179-342c-80d0-78bc57d2ec9b",
                                "text": "„Hans Renner hat vor gut 60 Jahren in der DDR die Kunststoffmatte für das Sommerskispringen erfunden. Renner ist bei nassem Wetter auf seiner Polyvinylchloridmatte vor der Haustür ausgerutscht und kam auf die Idee, diesen Effekt für das Skispringen im Sommer zu nutzen. Mit viel Tüftelei erfand er die Kunststoffmatte im großen Stil.“"
                            },
                            {
                                "example_id": "c398e7da-b6c4-47e5-a17f-9fb14635dd53",
                                "sense_id": "0677bc30-e179-342c-80d0-78bc57d2ec9b",
                                "text": "„Erstmals wurden im Auslaufbereich einer Schanzenanlage neue Kunststoffmatten ausgelegt und getestet.“"
                            },
                            {
                                "example_id": "4d7d4ba0-3bf2-4fbc-bc5a-a2b75075fcb7",
                                "sense_id": "0677bc30-e179-342c-80d0-78bc57d2ec9b",
                                "text": "„Heutzutage werden auch fast alle größeren Schanzen bei Neubauprojekten oder Umbaumaßnahmen mit den grünen Kunststoffmatten ausgerüstet, doch vor allem für die Nachwuchsspringer sind die kleinen Mattenschanzen essenziell, um ganzjähriges Training zu ermöglichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
