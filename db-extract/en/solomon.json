                                    {
                                        "sense_id": "92fe1af4-4898-3f7e-bdd3-eefd8a91b013",
                                        "entry_id": "bd6a01f4-3e19-348c-843d-fa09bb457e03",
                                        "glosses": [
                                            "Roi juif de la Bible, bâtisseur du temple éponyme à Jérusalem (vers 900 av. J.-C.)."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "Biblical",
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee74252d-b808-4b0d-94a1-24738da2ea1f",
                                                "sense_id": "92fe1af4-4898-3f7e-bdd3-eefd8a91b013",
                                                "text": "Ce rocher sacré existe toujours au milieu de la mosquée d’Omar à Jérusalem. Cette mosquée est surtout connue sous le nom d’El-Sakhra (le rocher),elle se trouve sur l’Esplanade des mosquées qui occupe l’emplacement du temple de Salomon."
                                            },
                                            {
                                                "example_id": "504d5dba-2237-469e-87f2-9575c48f565e",
                                                "sense_id": "92fe1af4-4898-3f7e-bdd3-eefd8a91b013",
                                                "text": "S'il n'existe aucune source en dehors de la Bible sur sa royauté, Salomon est réputé pour sa sagesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "411ccba6-f999-32de-a331-e9e18afea118",
                                        "entry_id": "bd6a01f4-3e19-348c-843d-fa09bb457e03",
                                        "glosses": [
                                            "Îles Salomon (État) ou îles Salomon (entité géographique)."
                                        ],
                                        "tags": [
                                            "Pays",
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0cfe0ee-d286-4862-9f5f-b370a744164b",
                                                "sense_id": "411ccba6-f999-32de-a331-e9e18afea118",
                                                "text": "Les Salomon sont situées sur la Ceinture de feu du Pacifique, où se heurtent des plaques tectoniques provoquant une intense activité sismique et volcanique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
