                "senses": [
                    {
                        "sense_id": "ed1ea3b5-7ed9-3c30-8b1c-e0947c845695",
                        "entry_id": "fb1c7174-5306-3b21-98d8-894a770f12e0",
                        "glosses": [
                            "grondig, met kracht, met volle inzet, niet te onderschatten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df35c478-32aa-44bd-b790-fade73ef4167",
                                "sense_id": "ed1ea3b5-7ed9-3c30-8b1c-e0947c845695",
                                "text": "Zij stootten op duchtige tegenstand."
                            },
                            {
                                "example_id": "b13b54e0-fc2a-4ccb-a41a-607e977a8938",
                                "sense_id": "ed1ea3b5-7ed9-3c30-8b1c-e0947c845695",
                                "text": "`Onze gasten kunnen gerust slapen in de wetenschap dat hun vertrekken duchtig worden bewaakt; zei Montebello. `Om zich toegang te verschaffen tot de bovenverdiepingen dient men te passeren tussen de hybride verschijningsvorm van de angst en het verraderlijk spinnende poesje dat voor raadselen stelt, die respectievelijk staan voor het weinig realistische zelfbeeld van de man en het wezen van de vrouw, als u het mij toestaat u te amuseren met mijn dilettantisme op het gebied van de symboliek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2e3a5fa-065a-43b3-9a48-c3a1fccf11e7",
                        "source_entry_id": "fb1c7174-5306-3b21-98d8-894a770f12e0",
                        "source_sense_id": "ed1ea3b5-7ed9-3c30-8b1c-e0947c845695",
                        "source_sense_description": "grondig, met kracht, met volle inzet, niet te onderschatten",
                        "target_lang_word": "tüchtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tüchtig",
