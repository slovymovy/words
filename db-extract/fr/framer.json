                "senses": [
                    {
                        "sense_id": "b38814db-976b-3d3e-aa42-1cacc33bad6c",
                        "entry_id": "657a09cd-20c9-3131-9f61-3bac204fb59c",
                        "glosses": [
                            "Renforcer, assurer une meilleure structure pour quelque chose."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "7851699d-cb23-4e8b-8271-af853ff00ab1",
                                "sense_id": "b38814db-976b-3d3e-aa42-1cacc33bad6c",
                                "text": "La bonne façon de faire c'est de framer le mur a 1\" foam pis mettre d’la R-12(3.5\" d'épais) dans le mur en 2x3."
                            },
                            {
                                "example_id": "fa00feb7-cafb-46cc-ba83-63890f84079b",
                                "sense_id": "b38814db-976b-3d3e-aa42-1cacc33bad6c",
                                "text": "Sur le plancher, c'est le bois pour framer les murs et la fournaise (la vraie!) qui attend d'être installée dans les prochains jours."
                            },
                            {
                                "example_id": "852f7285-8bb9-4b26-9b62-2af32be1f013",
                                "sense_id": "b38814db-976b-3d3e-aa42-1cacc33bad6c",
                                "text": "Pour ma part, j'ai \"framé\" le tout en pin traité (Goodfellow) et j'ai fait le dessus en cèdre rouge que j'ai eu à prix raisonnable (25$ par planche de 16' (1,25\"x5,5\" ), aussi de Goodfellow)."
                            }
                        ]
                    }
