                                    {
                                        "sense_id": "63abceb2-49b3-3dff-813d-b1054d511ba9",
                                        "entry_id": "c6ae843b-dbf6-3875-9533-8c5491b6dd65",
                                        "glosses": [
                                            "A system of national government in which power is divided between a central authority and a number of regions with delimited self-governing authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1be37024-cdc7-47f5-aa01-4b8387c651d0",
                                                "sense_id": "63abceb2-49b3-3dff-813d-b1054d511ba9",
                                                "text": "Where consociationalism and federalism overlay one another, moreover, the continuity of the latter depends on the stability of consociationalism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f551680-3e20-3d1d-95c7-49d21c8042e5",
                                        "entry_id": "c6ae843b-dbf6-3875-9533-8c5491b6dd65",
                                        "glosses": [
                                            "The belief that such a system is superior to other forms of government."
