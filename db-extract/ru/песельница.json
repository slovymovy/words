                        "examples": [
                            {
                                "example_id": "73668c2a-f241-4c7c-84a6-cff1d1d6a0a0",
                                "sense_id": "1c05595f-23cc-3971-afdb-7b9047da1f23",
                                "text": "Большая она была песельница, и даже господа её иной раз вечером заставляли петь."
                            },
                            {
                                "example_id": "e8ae80f1-4ce4-4c2e-82d3-e1cc66dbc829",
                                "sense_id": "1c05595f-23cc-3971-afdb-7b9047da1f23",
                                "text": "Песельниц отпустили лишь под утро, угостив пивом и мёдом и дав по серебрушке."
                            }
                        ]
                    }
