                "senses": [
                    {
                        "sense_id": "c4e82774-dd8e-3849-8a2e-428213f30cf4",
                        "entry_id": "72ba124c-3cf3-325d-9653-76354bed7c6f",
                        "glosses": [
                            "Person, die sich berufsmäßig mit dem Transport von Gütern befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73084a1c-0bcc-46a0-9919-5f6dc16f65f6",
                                "sense_id": "c4e82774-dd8e-3849-8a2e-428213f30cf4",
                                "text": "„Diese Menschen haben es meist als Selbstständige zu einem gewissen Wohlstand gebracht, als Bauunternehmer und Barbesitzer, Spediteure und Handwerker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "758ff51a-b7b4-4247-8580-f29e293c6639",
                        "source_entry_id": "72ba124c-3cf3-325d-9653-76354bed7c6f",
                        "source_sense_id": "c4e82774-dd8e-3849-8a2e-428213f30cf4",
                        "source_sense_description": "Person, die sich berufsmäßig mit dem Transport von Gütern befasst",
                        "target_lang_word": "forwarder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forwarder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32f23f8b-2892-3232-9ecc-a3404abe8720",
                                        "entry_id": "714a50bb-6f54-3f80-afdf-d2ddfa8e4513",
                                        "glosses": [
                                            "One who, or that which, forwards something to another destination."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "forwarder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2abdd1c8-f97e-3bca-99f0-1d165a5bbf9d",
                                        "entry_id": "087c9b99-154c-39fa-8612-097e17555ab5",
                                        "glosses": [
                                            "Comparative form of forward: more forward."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "comparative",
                                            "dialectal",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a95a468b-42e1-440d-bd05-204991b84a58",
                                                "sense_id": "2abdd1c8-f97e-3bca-99f0-1d165a5bbf9d",
                                                "text": "It is hard to draw evill men to good actions, especially for Church and State; therefore will I suspect that wherein they are more forwarder then honester men."
                                            },
                                            {
                                                "example_id": "609ac1b2-1b3f-45b9-8dce-6d40eb5b59a4",
                                                "sense_id": "2abdd1c8-f97e-3bca-99f0-1d165a5bbf9d",
                                                "text": "But whilst she is moving from her perigee to her apogee, her true place is observed to be forwarder than her mean place, and therefore, throughout that half of her orbit, the equation must be added to her mean place, in order to find her true place."
                                            },
                                            {
                                                "example_id": "18a87cd6-0bc5-4706-9a20-74188f312f48",
                                                "sense_id": "2abdd1c8-f97e-3bca-99f0-1d165a5bbf9d",
                                                "text": "He tried thinking his way through the problem, but that did not get him any forwarder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f702845b-d907-4386-845c-6896b784cdfe",
                        "source_entry_id": "72ba124c-3cf3-325d-9653-76354bed7c6f",
                        "source_sense_id": "c4e82774-dd8e-3849-8a2e-428213f30cf4",
                        "source_sense_description": "Person, die sich berufsmäßig mit dem Transport von Gütern befasst",
                        "target_lang_word": "transitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86ad8f5b-2f9a-3889-a02d-376537149f19",
                                        "entry_id": "16e1d3b3-21ad-39f5-8c5e-f01555b81aa3",
                                        "glosses": [
                                            "Relatif à un transit de marchandises."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e29f0cff-56cd-4ce7-9535-8a97a316f4c0",
                                                "sense_id": "86ad8f5b-2f9a-3889-a02d-376537149f19",
                                                "text": "L'ile de Van-Ninh devint très rapidement un des centres de commerce les plus considérables de la région, […]; elle fut le lieu de ravitaillement des contrées environnantes, le port transitaire de tous les articles d'importation étrangère, et le grand marché des produits naturels du Tonkin montagneux, du Quang-Si oriental et d'une partie du Quang-Tong."
                                            },
                                            {
                                                "example_id": "aa9929a5-c89d-4b1e-b200-467544a66b59",
                                                "sense_id": "86ad8f5b-2f9a-3889-a02d-376537149f19",
                                                "text": "On comprend que le gouvernement de Bruxelles, voyant du jour au lendemain réduites presque à néant les recettes de ses bureaux luxembourgeois, ait mis tout en œuvre pour entraver ou contrôler ce trafic transitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61cd118d-068c-3ef8-9f7d-7a2879f520ea",
                                        "entry_id": "16e1d3b3-21ad-39f5-8c5e-f01555b81aa3",
                                        "glosses": [
                                            "Qualifie un état par lequel transitent des marchandises."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5153d4d-34e4-452b-aec9-6d7ea3406148",
                                                "sense_id": "61cd118d-068c-3ef8-9f7d-7a2879f520ea",
                                                "text": "Cinquième principe : L’État transitaire, qui conserve la pleine souveraineté sur son territoire, aura le droit de prendre toutes les mesures indispensables pour que l'exercice du droit au transit libre et sans restriction ne porte, en aucune façon, atteinte à ses intérêts légitimes de tout ordre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05acb4ef-f0fa-3b3b-868a-0aa976d73bab",
                                        "entry_id": "0d78242a-e75a-3a77-8bb4-2ec540ae8b51",
                                        "glosses": [
                                            "Intermédiaire prenant en charge pour le compte d'une entreprise exportatrice (ou importatrice) les opérations liées à la logistique (transport, stockage…), soit en tant que simple exécutant des ordres de son client (mandataire), soit en tant que coordinateur de ces opérations (commissionnaire)."
                                        ],
                                        "tags": [
                                            "Logistique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee49d682-1aaf-4ee3-9d55-65bcc643239d",
                                                "sense_id": "05acb4ef-f0fa-3b3b-868a-0aa976d73bab",
                                                "text": "A peine cette loi était-elle promulguée, qu'une coalition se forma entre les grandes compagnies de navigation d'une part et les transitaires de Marseille d'autre part. Les résultats de cette coalition devant avoir pour effet d'augmenter dans une proportion considérable les frais d'importation et d'exportation entre la France et l'Algérie, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
