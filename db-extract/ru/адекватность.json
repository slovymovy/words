                "senses": [
                    {
                        "sense_id": "5a713867-024f-3464-bfb2-7bb8c365ffdb",
                        "entry_id": "fa112204-9f43-369c-88d0-4686358522f6",
                        "glosses": [
                            "книжн. свойство по значению прилагательного адекватный; соответствие, тождество, достоверность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30a2202-64b1-4b75-a840-bbbdbfe872a8",
                                "sense_id": "5a713867-024f-3464-bfb2-7bb8c365ffdb",
                                "text": "Это было редкостное единение мечты с действительностью. Поразительная адекватность желаний и возможностей. Недосягаемое тождество усилий и результатов…"
                            },
                            {
                                "example_id": "a836e274-4158-49b9-9473-181407fefb86",
                                "sense_id": "5a713867-024f-3464-bfb2-7bb8c365ffdb",
                                "text": "Затем проанализируем результаты макроэкономического моделирования TPBK и проверим их адекватность по отношению к отечественной экономике."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8fb52b1-e112-4a10-8025-76ac26584bbf",
                        "source_entry_id": "fa112204-9f43-369c-88d0-4686358522f6",
                        "source_sense_id": "5a713867-024f-3464-bfb2-7bb8c365ffdb",
                        "target_lang_word": "adequacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adequacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                                        "entry_id": "cf991ec8-d879-3ffb-9625-270412415acf",
                                        "glosses": [
                                            "The quality of being sufficient, adequate or able to meet the needs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f299b25e-60f9-4a02-8b37-e654a992c1f9",
                                                "sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                                                "text": "His zeal is, of course, unquestionable; his adequacy, however, I doubt."
                                            },
                                            {
                                                "example_id": "aae3378b-ee65-4f0c-9eea-5e31e6b22382",
                                                "sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                                                "text": "GREETINGS, adventurer! In honor of your adequacy, I bring you a gift from the Dunmer people!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2294335-50e3-4fea-a09b-bfb24fdfd145",
