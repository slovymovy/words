                        {
                            "trait_type": "form",
                            "comment": "past tense form"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme passée du verbe rétrécir, indiquant une diminution de taille ou de volume."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "a rétréci",
                                "target_lang_sense_clarification": "passé composé du verbe rétrécir"
                            },
                            {
                                "target_lang_word": "rétrécit",
                                "target_lang_sense_clarification": "passé simple du verbe rétrécir"
                            }
                        ]
                    }
                }
            ]
        },
        {
