                                        "entry_id": "8303f4ab-468c-3a62-8e0c-5f251f2e8fa0",
                                        "glosses": [
                                            "Any plant of the genus Plantago, with a rosette of sessile leaves about 10 cm (4\\\") long with a narrow part instead of a petiole, and with a spike inflorescence with the flower spacing varying widely among the species. See also psyllium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1144732-6bea-40da-ae19-237ec2b925a5",
                                                "sense_id": "9b06f432-ae41-3d75-bf67-1696f05287d1",
                                                "text": "The roots of Plantain and Pellitory of Spain beaten to powder and put into hollow teeth, takes away the pains of them."
                                            },
                                            {
                                                "example_id": "17a6aa9f-f557-4a03-8b83-68ec400afed5",
                                                "sense_id": "9b06f432-ae41-3d75-bf67-1696f05287d1",
                                                "text": "The paths too are overgrown, but easily identified by the presence on them of round-leaved plantains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plantain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc3e2b4-aafc-3519-9fa2-dce79421e540",
                                        "entry_id": "3114d03a-4707-380d-a1c4-50b6df60675d",
                                        "glosses": [
                                            "A plant in the genus Musa, the genus that includes banana, but with lower sugar content than banana."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95d9dd1f-e296-32ae-8fec-f2f3d1e05849",
                                        "entry_id": "3114d03a-4707-380d-a1c4-50b6df60675d",
                                        "glosses": [
                                            "The fruit of the plant, usually cooked before eating and used like potatoes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "116af7bc-793c-4a9f-9235-60d6199b62ef",
                                                "sense_id": "95d9dd1f-e296-32ae-8fec-f2f3d1e05849",
                                                "text": "We were sitting at the tables in the port, eating an unhurried breakfast of delicious mojarra fish from the swamp and slices of fried green plantain, when my mother resumed the offensive in her personal war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
