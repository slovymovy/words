                ],
                "senses": [
                    {
                        "sense_id": "2c6aaa5c-03ec-324b-9d42-df5cddc9d48b",
                        "entry_id": "183fc222-ee30-3afc-85a4-a7cbb70af1cd",
                        "glosses": [
                            "innerer Teil eines Nests"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82f486b0-bea7-480d-a49c-087d2750d1ca",
                                "sense_id": "2c6aaa5c-03ec-324b-9d42-df5cddc9d48b",
                                "text": "„Das Innennest besteht aus Grasrispen und einer Auskleidung der Mulde mit trockenen Blättern.“"
                            },
                            {
                                "example_id": "eaca440a-3b3d-4ca6-adae-575997c87dda",
                                "sense_id": "2c6aaa5c-03ec-324b-9d42-df5cddc9d48b",
                                "text": "„Bevor das [Weibchen] mit der durchgehenden Bebrütung des Geleges beginnt, hält es sich manchmal schon einige Tage zuvor bis zu einer Stunde im Nest auf; dabei verbaut es immer wieder einzelne Halme und Fäden des Außennestes und muldet das Innennest aus.“"
                            },
                            {
                                "example_id": "bd119a84-a123-4001-8dc0-3181f75bea03",
                                "sense_id": "2c6aaa5c-03ec-324b-9d42-df5cddc9d48b",
                                "text": "„Auf reichlich Moos, Fasern und Flechten wird ein Innennest errichtet, das mit Haaren und Wolle weich gepolstert ist.“"
                            },
                            {
                                "example_id": "d0a9dcaa-01bc-46e6-8473-fcb1b141e3c7",
                                "sense_id": "2c6aaa5c-03ec-324b-9d42-df5cddc9d48b",
                                "text": "„Das Außennest, das längsoval um das Innennest lagert, enthält mehr Nistmaterial.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
