                    "sense_id": "7b5508fa-cd12-32d6-89df-1dd132daf14c",
                    "sense_definition": "iets wat de aandacht trekt en vasthoudt omdat het boeiend of interessant is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boeiend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar wist een <w>pakkend</w> verhaal te vertellen over de geschiedenis van de stad.",
                            "target_lang_translations": {
                                "en": "The teacher managed to tell a <w>compelling</w> story about the history of the city."
                            }
                        },
                        {
                            "text": "De schrijver koos een <w>pakkende</w> titel voor zijn nieuwe boek om meer lezers te trekken.",
                            "target_lang_translations": {
                                "en": "The writer chose a <w>catchy</w> title for his new book to attract more readers."
                            }
                        }
                    ],
                    "synonyms": [
