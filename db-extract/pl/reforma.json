                "senses": [
                    {
                        "sense_id": "4b1d5eca-c9bf-3910-95be-af9d972c7af1",
                        "entry_id": "f4681033-ce7f-31ad-8acc-60f238e399be",
                        "glosses": [
                            "zmiana lub szereg zmian mająca na celu ulepszenie dziedziny, której dotyczy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b781ea9-0ce9-4a59-b966-d37b259082d2",
                                "sense_id": "4b1d5eca-c9bf-3910-95be-af9d972c7af1",
                                "text": "W 1999 roku w Polsce miały miejsce dwie reformy – zarówno podziału administracyjnego, jak i systemu oświaty."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b28ffc32-160b-441d-bd3d-147e0bc9d705",
                        "source_entry_id": "f4681033-ce7f-31ad-8acc-60f238e399be",
                        "source_sense_id": "4b1d5eca-c9bf-3910-95be-af9d972c7af1",
                        "target_lang_word": "reform",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94003b5c-c834-32e7-8bfb-eeb529ececa1",
                                        "entry_id": "c37a6928-53eb-3e66-ba1a-92925933b37e",
                                        "glosses": [
                                            "The change of something that is defective, broken, inefficient or otherwise negative, in order to correct or improve it"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07e3d8a9-0778-4dac-88cf-8a1825c74408",
                                                "sense_id": "94003b5c-c834-32e7-8bfb-eeb529ececa1",
                                                "text": "The elections need to undergo a serious reform."
                                            },
                                            {
                                                "example_id": "62db1196-e1f3-4db8-af0b-b4726087066e",
                                                "sense_id": "94003b5c-c834-32e7-8bfb-eeb529ececa1",
                                                "text": "Major reform is needed to improve the efficiency in the factory."
                                            },
                                            {
                                                "example_id": "1ea4247d-e282-44e3-97ba-95ba649f532f",
                                                "sense_id": "94003b5c-c834-32e7-8bfb-eeb529ececa1",
                                                "text": "19 February 2011, Barack Obama, Presidential Weekly Address, America Will Win the Future\n[…] over the past two years, my administration has made education a top priority. We’ve launched a competition called “Race to the Top” – a reform that is lifting academic standards and getting results; not because Washington dictated the answers, but because states and local schools pursued innovative solutions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reform",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6330f77f-a969-3059-bf54-967f8717670f",
                                        "entry_id": "843ed598-3438-3fc8-b8c5-838fdd7d26f6",
                                        "glosses": [
                                            "To put into a new and improved form or condition; to restore to a former good state, or bring from bad to good; to change from worse to better."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "227d48c2-b42b-4326-bbc9-6cd7d77d0a35",
                                                "sense_id": "6330f77f-a969-3059-bf54-967f8717670f",
                                                "text": "to reform a profligate man; to reform corrupt manners or morals; to reform a criminal"
                                            },
                                            {
                                                "example_id": "bf5ce8f5-667d-4ba3-920e-8a5502fc5e1b",
                                                "sense_id": "6330f77f-a969-3059-bf54-967f8717670f",
                                                "text": "In this interview with Law Editors and Correspondents, he speaks on the gains of reforming the Directorate of Public Prosecutions (DPP), efforts to keep underage persons out of jail."
                                            },
                                            {
                                                "example_id": "3953a3dd-a4de-4797-a33d-f6f7a901cd9c",
                                                "sense_id": "6330f77f-a969-3059-bf54-967f8717670f",
                                                "text": "“There was always something a bit wrong with him,” she said, “but nothing you mightn’t have hoped for, not till they took him and carried him off and reformed him”"
                                            },
                                            {
                                                "example_id": "cb7629e6-31ff-4074-8b71-2988f2b8f56b",
                                                "sense_id": "6330f77f-a969-3059-bf54-967f8717670f",
                                                "text": "Thus human nature seems to lie under the disadvantage, that the example alone of a vicious prince, will in time corrupt an age; but the example of a good one, will not be sufficient to reform it without farther endeavours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e9ed2a4-8dbe-346d-a59b-312e93324f96",
                                        "entry_id": "843ed598-3438-3fc8-b8c5-838fdd7d26f6",
                                        "glosses": [
                                            "To return to a good state; to amend or correct one's own character or habits."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ce1424-e02c-4f11-b256-ecbb4bd2ebca",
                                                "sense_id": "8e9ed2a4-8dbe-346d-a59b-312e93324f96",
                                                "text": "It is hoped that many criminals, upon being freed, will eventually reform."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16c7981e-6345-3115-b58f-919cc099fb27",
                                        "entry_id": "843ed598-3438-3fc8-b8c5-838fdd7d26f6",
                                        "glosses": [
                                            "To form again or in a new configuration."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "104a7ece-dc81-4b65-a5a1-cb79cf32c24e",
                                                "sense_id": "16c7981e-6345-3115-b58f-919cc099fb27",
                                                "text": "This product contains reformed meat."
                                            },
                                            {
                                                "example_id": "a8571333-11ec-419e-9b06-c0aeaa4b7515",
                                                "sense_id": "16c7981e-6345-3115-b58f-919cc099fb27",
                                                "text": "The regiment reformed after surviving the first attack."
                                            },
                                            {
                                                "example_id": "8b29ec89-9f47-4806-8291-26225949a881",
                                                "sense_id": "16c7981e-6345-3115-b58f-919cc099fb27",
                                                "text": "Since first tossing its cartoonish, good-time cock-rock to the masses in the early ’00s, The Darkness has always fallen back on this defense: The band is a joke, but hey, it’s a good joke. With Hot Cakes—the group’s third album, and first since reforming last year—the laughter has died. In its place is the sad wheeze of the last surviving party balloon slowly, listlessly deflating."
                                            },
                                            {
                                                "example_id": "8de4abd5-4a2f-4b7d-bfbf-a4c5d7ae9689",
                                                "sense_id": "16c7981e-6345-3115-b58f-919cc099fb27",
                                                "text": "Two-car CrossCountry Class 170/5 diesel multiple units are being extended to three-car formations and reclassified as Class 170/6s, to boost capacity on the Birmingham-Stansted Airport route. So far, two have been reformed by Arriva TrainCare at Bristol Barton Hill and put back into traffic."
                                            },
                                            {
                                                "example_id": "47dfe8a5-ba43-43b3-9ba3-c67679a96adf",
                                                "sense_id": "16c7981e-6345-3115-b58f-919cc099fb27",
                                                "text": "England reformed, this time with Kelly at the head of a 4-4-1, and rode out the final few minutes to force extra time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8a896c9-c9c8-466c-8b3b-ea179f691403",
                        "source_entry_id": "f4681033-ce7f-31ad-8acc-60f238e399be",
                        "source_sense_id": "4b1d5eca-c9bf-3910-95be-af9d972c7af1",
