                                        "entry_id": "1acd7f32-af5e-368e-a4d1-8d37e97a593e",
                                        "glosses": [
                                            "Synonym of goddamn."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26730348-07c1-486a-acaf-03a68d24baf4",
                                                "sense_id": "442aedc8-c86a-3c75-8eef-45102e4da6a6",
                                                "text": "Goddammit, you wrecked my car while I was cleaning it!"
                                            },
                                            {
                                                "example_id": "c7c6fc72-7526-403c-a478-ff740aff1068",
                                                "sense_id": "442aedc8-c86a-3c75-8eef-45102e4da6a6",
                                                "text": "Goddammit, who the hell stole half of my money?!"
                                            },
                                            {
                                                "example_id": "473e6098-44c2-4ab2-8e3b-e5c84343ee50",
                                                "sense_id": "442aedc8-c86a-3c75-8eef-45102e4da6a6",
                                                "text": "Goddammit, I told you to shut up three times already!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
