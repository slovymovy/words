            "senses": [
                {
                    "sense_id": "bc922701-0302-3c7e-8d6e-a7d1620bd4ad",
                    "sense_definition": "zachtjes heen en weer bewegen, gewoonlijk om een zuigeling in slaap te brengen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wiegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kindje werd zachtjes <w>gewiegd</w> onder het zingen van een slaapliedje.",
                            "target_lang_translations": {
                                "en": "The child was gently <w>rocked</w> while a lullaby was being sung."
                            }
                        },
                        {
                            "text": "De moeder probeerde de baby in slaap te <w>wiegen</w> door zachtjes heen en weer te lopen.",
                            "target_lang_translations": {
                                "en": "The mother tried to <w>rock</w> the baby to sleep by walking gently back and forth."
                            }
                        }
                    ],
                    "synonyms": [
                        "schommelen"
                    ],
                    "common_phrases": [
                        "in slaap wiegen"
                    ],
                    "target_lang_definitions": {
                        "en": "to move gently back and forth, usually to lull an infant to sleep"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rock",
                                "target_lang_sense_clarification": "to move a baby or cradle gently"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8044269d-b650-349f-8158-9393e0dfc868",
                    "sense_definition": "ritmisch heen en weer bewegen of schommelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wiegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bomen <w>wiegen</w> zachtjes in de wind tijdens de storm.",
                            "target_lang_translations": {
                                "en": "The trees <w>sway</w> gently in the wind during the storm."
                            }
                        },
                        {
                            "text": "Zij zag de bloemen in de tuin heen en weer <w>wiegen</w>.",
                            "target_lang_translations": {
                                "en": "She saw the flowers in the garden <w>swaying</w> back and forth."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwaaien",
                        "deinen"
                    ],
                    "common_phrases": [
                        "wiegen in de wind"
                    ],
                    "target_lang_definitions": {
                        "en": "to move or sway rhythmically back and forth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sway",
                                "target_lang_sense_clarification": "to move slowly from side to side"
                            },
                            {
                                "target_lang_word": "rock",
                                "target_lang_sense_clarification": "to move back and forth in the wind"
                            }
                        ]
                    }
                }
            ]
        },
