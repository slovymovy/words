                ],
                "senses": [
                    {
                        "sense_id": "43684d55-616f-3dc8-9bf3-495336e20eff",
                        "entry_id": "57a96cdd-bf55-3888-a1ea-8d466ed4abb6",
                        "glosses": [
                            "eine Wissenschaft, die einen genau definierten Bereich der Gesamtwirklichkeit untersucht und dort Zusammenhänge und Abhängigkeitsverhältnisse von Tatsachen darstellt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c553367-e3f9-4a28-b055-80e17a9fadc0",
                                "sense_id": "43684d55-616f-3dc8-9bf3-495336e20eff",
                                "text": "„Die Einzelwissenschaften stellen ihren jeweiligen Gegenstand nicht in den allumfassenden Zusammenhang des Seins.“"
                            },
                            {
                                "example_id": "ceba5d81-3316-454c-b04d-ee5e81be00cb",
                                "sense_id": "43684d55-616f-3dc8-9bf3-495336e20eff",
                                "text": "Über den Gegenstandsbereich einer Einzelwissenschaft hinaus sind deren Methoden nicht mehr angemessen."
                            },
                            {
                                "example_id": "15d4a22f-6420-4bce-b48c-8fc9009720e0",
                                "sense_id": "43684d55-616f-3dc8-9bf3-495336e20eff",
                                "text": "Die Philosophie zielt im Gegensatz zu allen Einzelwissenschaften auf eine Vertiefung des Wissens, indem sie nach den Bedingungen der Möglichkeit dieser Einzelwissenschaften fragt."
                            },
                            {
                                "example_id": "5655b37d-0d4e-4642-9613-b6f38bf3a1ed",
                                "sense_id": "43684d55-616f-3dc8-9bf3-495336e20eff",
                                "text": "„Soll dabei das Bewußtsein nicht verlorengehen, worin Ursprünge und Ziele von Wissenschaften liegen können und welche Chancen und Gefahren mit Wissenschaft überhaupt geschaffen werden, so müssen die Einzelwissenschaften das Gespräch untereinander suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
