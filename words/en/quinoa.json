                },
                {
                    "sense_id": "e86d9cdb-3ee3-3223-8ab9-16355e646073",
                    "sense_definition": "An Andean plant (Chenopodium quinoa) cultivated primarily for its edible seeds.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quinoa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers in the Andes have cultivated <w>quinoa</w> for thousands of years.",
                            "target_lang_translations": {
