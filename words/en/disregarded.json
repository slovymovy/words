                            }
                        },
                        {
                            "text": "His concerns were <w>disregarded</w> by the committee during the meeting.",
                            "target_lang_translations": {
                                "nl": "Zijn zorgen werden tijdens de vergadering door de commissie <w>genegeerd</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ignored",
                        "overlooked",
                        "neglected"
                    ],
                    "antonyms": [
                        "considered",
                        "heeded"
                    ],
                    "target_lang_definitions": {
