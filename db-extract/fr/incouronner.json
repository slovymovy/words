                "senses": [
                    {
                        "sense_id": "98126f19-8cd4-314a-9ed4-6ad96c205963",
                        "entry_id": "9a541967-89b9-3a8b-9b4c-0dec4c3e506e",
                        "glosses": [
                            "Couronner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "395ccce0-3f54-44bb-8a62-4f85fde52541",
                                "sense_id": "98126f19-8cd4-314a-9ed4-6ad96c205963",
                                "text": "Ce n’était point une œuvre, organique, un être, d’ensemble, qu’il décapitait ou qu’il découronnait, une œuvre qu’il incapitait ou qu’il incouronnait."
                            },
                            {
                                "example_id": "ef8e0eb0-ba11-4552-9ec7-d6f42b0b9aa0",
                                "sense_id": "98126f19-8cd4-314a-9ed4-6ad96c205963",
                                "text": "Flamboyant, enfin détendu, il a fini par incouronner le Neuchatelois, redevenu tout simplement «Didier»."
                            }
                        ]
                    }
                ],
