                ],
                "senses": [
                    {
                        "sense_id": "6c2164a6-6880-3c89-891a-81768a56bf24",
                        "entry_id": "0b48fa31-2452-3d0d-8ca0-896bbda84f2c",
                        "glosses": [
                            "Donner un caractère sculptural à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0573b688-9d8f-44e6-aaad-d59765e592b5",
                                "sense_id": "6c2164a6-6880-3c89-891a-81768a56bf24",
                                "text": "L'artiste transpose l'écriture sur les murs, sur le sol, il joue avec elle, jusqu'à même la sculpturaliser."
                            },
                            {
                                "example_id": "b413e2bd-9951-4a25-8b8c-9ba8b8d48317",
                                "sense_id": "6c2164a6-6880-3c89-891a-81768a56bf24",
                                "text": "C’est par exemple le cas d’Henri Foucault, dont ce portrait de femme enceinte en 2008, un des tout derniers de la collection, n’a rien à voir avec ses superbes photogrammes rehaussés d’épingles ou percés de trous pour les « sculpturaliser »."
                            },
                            {
                                "example_id": "a748994d-5aaf-4ec5-b708-a53b1ba9fbde",
                                "sense_id": "6c2164a6-6880-3c89-891a-81768a56bf24",
                                "text": "Je veux \"sculpturaliser\" ce phénomène en le reproduisant artificiellement dans une salle."
                            }
                        ]
                    }
