{
    "word_family": [
        "clamorous",
        "clamorously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87d0df71-e948-366b-ba8d-2ed217b08cab",
                    "sense_definition": "A loud and confused noise, especially that of people shouting vehemently.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>clamour</w> of the crowd outside the stadium was deafening as the team arrived.",
                            "target_lang_translations": {
                                "nl": "Het <w>rumoer</w> van de menigte buiten het stadion was oorverdovend toen het team aankwam."
                            }
                        },
                        {
                            "text": "He could barely hear his own thoughts over the constant <w>clamour</w> of the busy city streets.",
                            "target_lang_translations": {
                                "nl": "Hij kon zijn eigen gedachten nauwelijks horen boven het constante <w>lawaai</w> van de drukke stadsstraten."
                            }
                        }
                    ],
                    "synonyms": [
                        "uproar",
                        "din",
                        "hubbub"
                    ],
                    "antonyms": [
                        "silence",
                        "quiet"
                    ],
                    "common_phrases": [
                        "public clamour"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British and Canadian spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een luid en verward lawaai, vooral van mensen die heftig schreeuwen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "rumoer",
                                "target_lang_sense_clarification": "algemene term voor luid en verward lawaai"
                            },
                            {
                                "target_lang_word": "lawaai",
                                "target_lang_sense_clarification": "algemene term voor storend geluid"
                            },
                            {
                                "target_lang_word": "kabaal",
                                "target_lang_sense_clarification": "sterk, vaak storend geluid"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "286b6f55-1862-3b16-a541-089d42bd08be",
                    "sense_definition": "To shout loudly or insistently, often to demand something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The protesters continued to <w>clamour</w> for immediate changes to the new environmental policy.",
                            "target_lang_translations": {
                                "nl": "De demonstranten bleven <w>schreeuwen om</w> onmiddellijke veranderingen in het nieuwe milieubeleid."
                            }
                        },
                        {
                            "text": "Fans began to <w>clamour</w> for the band to return to the stage for an encore.",
                            "target_lang_translations": {
                                "nl": "Fans begonnen te <w>eisen</w> dat de band terugkeerde naar het podium voor een toegift."
                            }
                        }
                    ],
                    "synonyms": [
                        "demand",
                        "insist"
                    ],
                    "common_phrases": [
                        "clamour for"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British and Canadian spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Luid of aandringend schreeuwen, vaak om iets te eisen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "eisen",
                                "target_lang_sense_clarification": "met klem vragen om iets"
                            },
                            {
                                "target_lang_word": "schreeuwen om",
                                "target_lang_sense_clarification": "luidkeels verzoeken om iets"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11f75c1d-74b6-36c7-95c8-2fde4a4f15d9",
                    "sense_definition": "To praise or salute someone loudly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "noise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loyal subjects gathered to <w>clamour</w> their king with songs of victory.",
                            "target_lang_translations": {
                                "nl": "De trouwe onderdanen verzamelden zich om hun koning met overwinningsliederen toe te <w>juichen</w>."
                            }
                        },
                        {
                            "text": "They stood at the gates to <w>clamour</w> the returning hero with loud cheers.",
                            "target_lang_translations": {
                                "nl": "Ze stonden bij de poorten om de terugkerende held met luid gejuich te <w>begroeten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "acclaim",
                        "hail"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand luidkeels prijzen of begroeten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "toejuichen",
                                "target_lang_sense_clarification": "met gejuich begroeten of prijzen"
                            },
                            {
                                "target_lang_word": "toeroepen",
                                "target_lang_sense_clarification": "iemand luidkeels aanspreken of begroeten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}