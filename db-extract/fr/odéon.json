                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ωδείο",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "0f77cc54-cc0d-30ab-b18b-d50b9f1941ef",
                                        "entry_id": "601adf44-6c32-390b-ba8f-4c05fa1291a3",
                                        "glosses": [
                                            "σχολή όπου διδάσκεται η μουσική"
                                        ],
                                        "tags": [
                                            "μουσική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "199b27d8-1587-4e57-84c7-1854f4a5a71c",
                                                "sense_id": "0f77cc54-cc0d-30ab-b18b-d50b9f1941ef",
                                                "text": "σπούδασε στο ωδείο Αθηνών"
                                            },
                                            {
                                                "example_id": "640bbd15-abf0-43b8-9578-ec6d9aeee48f",
                                                "sense_id": "0f77cc54-cc0d-30ab-b18b-d50b9f1941ef",
                                                "text": "※ Δύο φίλες της από το ωδείο τής είχαν στείλει μηνύματα από το μεσημέρι, αγωνιώντας να μάθουν πώς είχε πάει στη συμμετοχή της στον πρώτο γύρο του διαγωνισμού. Πρόκριση;!!! είχε γράψει η μια, προσθέτοντας εμότικον και χειροκροτήματα. (Ντορίνα Παπαλιού, Η φωνή στα χέρια της, Εκδόσεις Ίκαρος, 2024)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8109215f-bb7b-325a-a5d7-3afc98eaf6d5",
                                        "entry_id": "601adf44-6c32-390b-ba8f-4c05fa1291a3",
                                        "glosses": [
                                            "το κτίριο όπου γινόταν η προετοιμασία μουσικών ή θεατρικών παραστάσεων πριν την επίσημη παρουσίασή τους στο θέατρο"
                                        ],
                                        "tags": [
                                            "στην αρχαιότητα"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a16fff74-a77f-44b3-9cba-ff99286c8550",
