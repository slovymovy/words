                ],
                "senses": [
                    {
                        "sense_id": "c37a32f5-6e6b-376e-a1e2-e75491c3b7af",
                        "entry_id": "2fe75eb7-6d56-35df-85a5-135e1cd2d4d6",
                        "glosses": [
                            "an der Seite befindliche Öffnung oder Tür zum Hereingehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1baa4f9b-632b-4ce1-bc67-c2e890594231",
                                "sense_id": "c37a32f5-6e6b-376e-a1e2-e75491c3b7af",
                                "text": "Sie müssen den Seiteneingang benutzen, der Vordereingang ist momentan wegen Umbaumaßnahmen gesperrt."
                            },
                            {
                                "example_id": "97e38acf-f25f-453b-9dd7-591c9cc76851",
                                "sense_id": "c37a32f5-6e6b-376e-a1e2-e75491c3b7af",
                                "text": "Diese Kirche hat mehrere Seiteneingänge."
                            },
                            {
                                "example_id": "a4edfaef-f8e5-4419-9648-37c05724f32c",
                                "sense_id": "c37a32f5-6e6b-376e-a1e2-e75491c3b7af",
                                "text": "„Aber den Seiteneingang zum Keller gibt es noch.“"
                            },
                            {
                                "example_id": "a62fd12f-8531-483b-b712-397510e80d60",
                                "sense_id": "c37a32f5-6e6b-376e-a1e2-e75491c3b7af",
                                "text": "„Der Knabe rutschte vom Brunnenrand, kam näher und führte sie durch eine enge Gasse zu einem Seiteneingang.“"
                            },
                            {
                                "example_id": "376e29ce-007f-4a6a-a478-9fec79437335",
                                "sense_id": "c37a32f5-6e6b-376e-a1e2-e75491c3b7af",
                                "text": "„Beim Lyceum-Theater wartete schon ein dichtes Menschengewühl an den Seiteneingängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
