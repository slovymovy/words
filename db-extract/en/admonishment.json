                                "target_senses": [
                                    {
                                        "sense_id": "bdaf1f8d-b91e-39de-ab74-b42c1c016868",
                                        "entry_id": "1368a576-9ea1-3faf-ae9b-e6569a26fc58",
                                        "glosses": [
                                            "Handlung, mit der jemand zu etwas veranlasst oder von etwas abgehalten werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99d9a47-34fb-4ef1-ae25-5ab3d35c26fc",
                                                "sense_id": "bdaf1f8d-b91e-39de-ab74-b42c1c016868",
                                                "text": "„Dann gingen die beiden, Leas endlosen Ratschlägen und Ermahnungen glücklich entronnen.“"
