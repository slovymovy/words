                {
                    "sense_id": "93dd3dcf-fd3b-37c7-9607-b5c5935e2263",
                    "sense_definition": "A language that is primarily spoken in East Asia and is the official language of Japan.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "japan_language",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "It takes a lot of practice to speak <w>Japanese</w> fluently.",
                            "target_lang_translations": {
