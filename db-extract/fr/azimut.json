        "fr-extract.jsonl": [
            {
                "entry_id": "ffbea3ae-c0c1-3bbd-831a-35fc02eae074",
                "word": "azimut",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "af11eacb-a9b8-4157-b21d-35f84256bd0e",
                        "entry_id": "ffbea3ae-c0c1-3bbd-831a-35fc02eae074",
                        "tags": [
                            "plural"
                        ],
                        "form": "azimuts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6138c6f4-352e-3829-9f1b-2a6e91118cb7",
                        "entry_id": "ffbea3ae-c0c1-3bbd-831a-35fc02eae074",
                        "glosses": [
                            "Dans le système de coordonnées horizontales, angle séparant le méridien d'un lieu et un plan vertical passant par l'astre dont on cherche la direction ; cet angle est mesuré de 0 à 360° dans le sens rétrograde (ou horaire) et se note habituellement « A ». L'azimut est utilisé conjointement à la hauteur pour déterminer la direction d'un corps céleste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e8937d-20aa-41de-888b-79e216871a4c",
                                "sense_id": "6138c6f4-352e-3829-9f1b-2a6e91118cb7",
                                "text": "La Lune avait une hauteur de 34°57' dans l’azimut 106°."
                            },
                            {
                                "example_id": "4916e90e-54be-4efc-82a5-11824e62f39f",
                                "sense_id": "6138c6f4-352e-3829-9f1b-2a6e91118cb7",
                                "text": "Azimut oriental, occidental."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa045e12-2c0d-353b-9390-b4c0d03c1feb",
                        "entry_id": "ffbea3ae-c0c1-3bbd-831a-35fc02eae074",
                        "glosses": [
                            "Angle dans le plan horizontal, mesuré de 0 à 360° dans le sens horaire entre le méridien du point de station et l'orthodromie reliant ce point au lieu de destination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feecd056-8786-434e-859a-7a08c25ea64a",
                                "sense_id": "fa045e12-2c0d-353b-9390-b4c0d03c1feb",
                                "text": "Les azimuts 0°, 90°, 180° et 270° correspondent respectivement aux directions du nord, de l’est, du sud et de l’ouest."
                            }
                        ]
                    },
                    {
                        "sense_id": "e50b4937-7e99-3a44-8472-011b19f4d428",
                        "entry_id": "ffbea3ae-c0c1-3bbd-831a-35fc02eae074",
                        "glosses": [
                            "Direction."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11541d4b-c8ba-45f3-9c83-19dd9614e6ad",
                        "source_entry_id": "ffbea3ae-c0c1-3bbd-831a-35fc02eae074",
                        "target_lang_word": "Azimut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Azimut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7d760fc-723e-3697-91b7-9e2b844b9dc8",
                                        "entry_id": "4e6f9343-826a-3a40-bc63-8925848f5ba1",
                                        "glosses": [
                                            "Winkel zwischen der Vertikalebene eines Gestirns und dem südlichen Meridian"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ffc974-ccb9-4825-85c7-17ae96a01db6",
                                                "sense_id": "c7d760fc-723e-3697-91b7-9e2b844b9dc8",
                                                "text": "Die Horizontebene, Zenit und Nordpol geben auf der Kugel ein Koordinatennetz für Höhen und Azimut."
                                            },
                                            {
                                                "example_id": "535fd225-a9ee-4e5f-b028-893bfd10c743",
                                                "sense_id": "c7d760fc-723e-3697-91b7-9e2b844b9dc8",
                                                "text": "„Das waren Kurs- und Strömungsberechnungen, Azimute von Gestirnen sowie Küstenbilder und die entsprechenden Seekarten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75cc046e-1b5e-40a0-8f39-fa5f6cdfd82b",
                        "source_entry_id": "ffbea3ae-c0c1-3bbd-831a-35fc02eae074",
                        "target_lang_word": "azimuth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "azimuth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40504f27-f314-389a-9808-45808cd0a86e",
                                        "entry_id": "2a4b5f35-f836-3dc1-881b-a31ffe70fccc",
                                        "glosses": [
                                            "An arc of the horizon intercepted between the meridian of the place and a vertical circle passing through the center of any object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78b1ffbc-cb64-41c8-b135-3dcbd7581724",
                                                "sense_id": "40504f27-f314-389a-9808-45808cd0a86e",
                                                "text": "the azimuth of a star"
                                            },
                                            {
                                                "example_id": "208c0c1e-e140-4834-a4db-8305ab160e80",
                                                "sense_id": "40504f27-f314-389a-9808-45808cd0a86e",
                                                "text": "the azimuth or bearing of a line surveying"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfea26ac-a33c-3806-b3a2-9305519d8b53",
                                        "entry_id": "2a4b5f35-f836-3dc1-881b-a31ffe70fccc",
                                        "glosses": [
                                            "The quadrant of an azimuth circle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9210d62-6715-4cc4-8c51-6b8b01348a4d",
                                                "sense_id": "dfea26ac-a33c-3806-b3a2-9305519d8b53",
                                                "text": "The dome, being constructed of wood, was light by comparison with the rest of the structure, and the wheels which allowed it horizontal, or, as Swithin expressed it, azimuth motion, denied it a firm hold upon the walls; so that it had been lifted off them like a cover from a pot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
