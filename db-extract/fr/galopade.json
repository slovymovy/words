                ],
                "senses": [
                    {
                        "sense_id": "31981d00-82ef-3f1f-b8b4-d1177b60c048",
                        "entry_id": "4a20decf-9efa-3461-9653-d2589652d728",
                        "glosses": [
                            "Action de galoper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb1cfbdf-e38c-46f8-83d9-b1e4fae75931",
                                "sense_id": "31981d00-82ef-3f1f-b8b4-d1177b60c048",
                                "text": "Au milieu de cette quiétude retentit soudain, ce soir là, le bruit d’une galopade lointaine."
                            },
                            {
                                "example_id": "51ebbbc4-1235-4bcf-81da-5ac89f18d9d8",
                                "sense_id": "31981d00-82ef-3f1f-b8b4-d1177b60c048",
                                "text": "Une galopade retentit derrière nous, accompagnée de hurlements sauvages."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae5f7c9a-d55a-3bf1-9b3f-f8f42af0c828",
                        "entry_id": "4a20decf-9efa-3461-9653-d2589652d728",
                        "glosses": [
                            "Petite course au galop."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6c2b7421-eeb9-456f-bcc8-5465ff74ea7d",
                                "sense_id": "ae5f7c9a-d55a-3bf1-9b3f-f8f42af0c828",
                                "text": "Tous les regards se portèrent vers le ciel pour voir s’il n’était pas chevauché par quelque galopade de spectres."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3d09ccc-ad1a-3403-a25d-92f96e80a507",
                        "entry_id": "4a20decf-9efa-3461-9653-d2589652d728",
                        "glosses": [
                            "Espace que l’on parcourt en galopant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e328b0b-0ac2-4caf-a277-b473c3cca94a",
                                "sense_id": "c3d09ccc-ad1a-3403-a25d-92f96e80a507",
                                "text": "D’ici là il n’y a qu’une galopade."
                            }
                        ]
                    },
                    {
                        "sense_id": "556cb3fb-6671-3e01-9862-9b63b33e382a",
                        "entry_id": "4a20decf-9efa-3461-9653-d2589652d728",
                        "glosses": [
                            "Sorte de galop."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5388023a-c756-41b7-86dd-86ddf0d445bf",
                                "sense_id": "556cb3fb-6671-3e01-9862-9b63b33e382a",
                                "text": "La galopade est un galop en trois temps, lent, relevé, raccourci et cadencé, qui porte aussi les noms de galop d’école, galop de manège, etc., etc."
                            }
                        ]
                    }
