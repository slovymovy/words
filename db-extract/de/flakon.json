                                "target_senses": [
                                    {
                                        "sense_id": "8bb10a5f-bb56-3ce5-8bc2-58961c88577d",
                                        "entry_id": "eafc654d-34f0-3c5d-baa8-fa623bf44b4b",
                                        "glosses": [
                                            "Bouteille de dimensions réduites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57cc6baa-8e8d-409e-afa7-077b828fe376",
                                                "sense_id": "8bb10a5f-bb56-3ce5-8bc2-58961c88577d",
                                                "text": "Elle achetait les onguents, des pots de fard, des crayons, qui traînaient sur tous les meubles, avec des houppettes de poudre de riz et des flacons d’odeur. Ses journées, elle les passait, devant sa glace, à se maquiller, à se contempler."
                                            },
                                            {
                                                "example_id": "3bd22750-d89e-45f2-9077-41f83d87303e",
                                                "sense_id": "8bb10a5f-bb56-3ce5-8bc2-58961c88577d",
                                                "text": "Sur le buffet, rien qu’une chaîne hi-fi et un flacon d’ambre solaire entamé."
                                            },
                                            {
                                                "example_id": "c5371070-2d98-4bd4-a90f-0179e07a3d2c",
                                                "sense_id": "8bb10a5f-bb56-3ce5-8bc2-58961c88577d",
                                                "text": "[…] nous étions soutenus par une sorte d’espérance et aussi par un flacon de kirsch."
                                            },
                                            {
                                                "example_id": "77e9f844-df4c-497b-96f5-aaede75cc086",
                                                "sense_id": "8bb10a5f-bb56-3ce5-8bc2-58961c88577d",
                                                "text": "Offrir cinq cents flacons de vinaigre des quatre-voleurs comme produit désinfectant au bureau de bienfaisance du XIᵉ arrondissement, c’est un acte généreux […]"
                                            }
                                        ]
                                    }
                                ]
                            }
