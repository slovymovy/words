                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9841308-ca56-3220-b3ae-e4dd50871aba",
                        "entry_id": "f232623a-dc5d-327b-baeb-b6387f22409a",
                        "glosses": [
                            "Qui a tient du machisme, pensée d’Ernst Mach."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb28ce9-6796-4772-b6ff-5487df0f019c",
                                "sense_id": "c9841308-ca56-3220-b3ae-e4dd50871aba",
                                "text": "Auteur des livres : Les Constructions philosophiques du marxisme, Mach et le marxisme (1907-1908) dans lesquels il développa les vues machistes en philosophie, estimant nécessaire de compléter ainsi le marxisme."
                            },
                            {
                                "example_id": "877b3335-6acc-456a-b3c0-2ef60058880b",
                                "sense_id": "c9841308-ca56-3220-b3ae-e4dd50871aba",
                                "text": "L'expérience même (au sens humain du mot, et non au sens machiste du mot), qui a crée en nous la ferme conviction qu'il existe, indépendamment de nous, d'autres hommes et non de simples complexes de mes sensations de haut, de bas, de jaune, de solide, etc., c'est cette expérience qui crée notre conviction que les choses, le monde, le milieu, existent indépendamment de nous."
                            },
                            {
                                "example_id": "4fafdde6-3db6-4c2c-971b-207a409fe65a",
                                "sense_id": "c9841308-ca56-3220-b3ae-e4dd50871aba",
                                "text": "Marc est chauvin et affiche volontiers ses penchants machistes, mais rien qui semble insurmontable pour Sarah. Elle y voit plutôt une forme de piquante altérité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
