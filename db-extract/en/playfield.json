                        "glosses": [
                            "A playing field."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01053619-3081-44e5-b189-18f54362ba43",
                                "sense_id": "c8fd5e99-f58a-3e05-b926-821bf4f0032c",
                                "text": "The position of the playfield is here identified as lying north of this open space between it and the burn, and occupying the haugh which extended west […]"
                            },
                            {
                                "example_id": "5899b49c-7843-4307-931b-bbddb80a7b8e",
                                "sense_id": "c8fd5e99-f58a-3e05-b926-821bf4f0032c",
                                "text": "It has been recommended by some recreational specialists that there should be one such playfield for each 500 children of high school age."
                            }
                        ]
                    },
                    {
                        "sense_id": "41b87c5a-82c0-34c9-8058-0ad41c6523b5",
                        "entry_id": "3bd7da18-4ddc-3b6a-9761-284826b7b42f",
                        "glosses": [
                            "The area within which a game (especially a video game) is played."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8b4af4b-473f-4a05-a74e-64185d351956",
                                "sense_id": "41b87c5a-82c0-34c9-8058-0ad41c6523b5",
                                "text": "The game has a tilt feature — tilt Fireball and a tilt sign glows and the scoring stops. The full-sized, full-color commercial playfield even has a special friction silk-screened surface so the ball will roll and not slide."
                            },
                            {
                                "example_id": "bc5dfd53-c7da-409b-867f-6b23e7c83a85",
                                "sense_id": "41b87c5a-82c0-34c9-8058-0ad41c6523b5",
                                "text": "In this case, the playfield is more disorienting and feels more like the maze that it is."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a7182fe-4a0b-3689-bafb-3a42d4331150",
                        "entry_id": "3bd7da18-4ddc-3b6a-9761-284826b7b42f",
                        "glosses": [
                            "The main surface inside the machine where the ball moves and the game takes place."
