                        "entry_id": "d6fafe68-b310-39a4-8825-d9663e6f4d98",
                        "glosses": [
                            "Logiciel servant d’intermédiaire de communication entre plusieurs applications, généralement complexes ou distribuées sur un réseau informatique."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "e7aa8f92-ba01-428f-bb97-de1d108a272a",
                                "sense_id": "4b69e30c-9b08-372f-a250-20e575d73cc8",
                                "text": "En raison des volumes importants de données, l’intergiciel utilise généralement un entrepôt de données et des outils d’exécution intelligents."
                            },
                            {
                                "example_id": "a6a1b9e1-f29e-452c-bcde-cb43906cf834",
                                "sense_id": "4b69e30c-9b08-372f-a250-20e575d73cc8",
                                "text": "Elle était chargée de faire visiter les locaux à un consultant en intergiciels venu de France."
                            }
                        ]
                    }
                ],
