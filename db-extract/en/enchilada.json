                        "sense_id": "77ee8a69-2879-3541-ab4f-1deb4d3a7e86",
                        "entry_id": "21234e56-034e-30e4-8e4c-bde1f31f2972",
                        "glosses": [
                            "A Mexican dish made by wrapping a filling in a tortilla, then baking in a sauce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe9d20e7-e653-44d9-88cf-3f1b31cdd5ca",
                                "sense_id": "77ee8a69-2879-3541-ab4f-1deb4d3a7e86",
                                "text": "It was a nice little pub in the middle of nowhere / Anywhere would have been better / I ordered enchiladas and I ate 'em"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6b13155-d78a-40a1-91e6-3fb69d432592",
                        "source_entry_id": "21234e56-034e-30e4-8e4c-bde1f31f2972",
                        "source_sense_id": "77ee8a69-2879-3541-ab4f-1deb4d3a7e86",
                        "source_sense_description": "Mexican dish",
                        "target_lang_word": "Enchilada",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enchilada",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01a44944-5872-3e29-83dd-4ce6fae175eb",
                                        "entry_id": "39dfaba8-24cf-3884-accd-245b40aabbed",
                                        "glosses": [
                                            "mexikanisches Gericht, bestehend aus gefüllten Tortillas mit Soße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e8af99-5ea4-44a2-aa65-337aa12b083b",
                                                "sense_id": "01a44944-5872-3e29-83dd-4ce6fae175eb",
                                                "text": "„Driver und Shannon tranken zunächst ein paar Scotch, aßen dann Chips mit Salsa, eine höllisch scharfe Brühe, dazu grüne Enchiladas.“"
                                            },
                                            {
                                                "example_id": "dc04e886-806b-4965-b127-5b1ae44a4e06",
                                                "sense_id": "01a44944-5872-3e29-83dd-4ce6fae175eb",
                                                "text": "„In einem der kleinen Rezeptheftchen, die man im Supermarkt bekam, hatte er ein Rezept für Enchiladas gefunden und mit Tortillas, Monterey-Jack-Käse, gerösteten roten Chilis, Pilzcremesuppe und grüner Enchiladasoße für sie zubereitet.“"
                                            },
                                            {
                                                "example_id": "36c77f8f-cf2c-4f7d-888b-d7ea9d5f5f76",
                                                "sense_id": "01a44944-5872-3e29-83dd-4ce6fae175eb",
                                                "text": "„Nach alledem genehmigte er sich eine Enchilada aus der Mikrowelle und trank dazu eine Flasche Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
