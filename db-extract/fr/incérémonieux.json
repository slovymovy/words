                                "target_senses": [
                                    {
                                        "sense_id": "e874d461-b053-3b1a-b3ee-4554f1e71734",
                                        "entry_id": "f7e93782-290b-3d30-aa77-c44a778ef8a1",
                                        "glosses": [
                                            "Not ceremonious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba4495f3-be1b-4ed5-acdb-29962ee1718a",
                                                "sense_id": "e874d461-b053-3b1a-b3ee-4554f1e71734",
                                                "text": "Mrs. De Brooke replied, that she could have no objection to form the acquaintance of Mrs. Belmour, since it appeared she was so unceremonious and so conformable to the taste of her friends, in respect to her mode of visiting them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "110f59ed-0302-4d5f-8e18-6a3e2442ceeb",
                        "source_entry_id": "7f4d24ed-4520-3eb0-ad55-2e582d24446a",
                        "source_sense_id": "b75ca167-2ecc-3447-87b9-5d5f373fc50a",
                        "target_lang_word": "бесцеремонный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бесцеремонный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "40732a6e-aa49-3e38-86fa-e574e678d632",
                                        "entry_id": "ae00a044-b4a4-3b98-bc0b-66b058624c16",
                                        "glosses": [
                                            "пренебрегающий правилами приличия, этикета; развязный, беззастенчивый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7193f222-035e-479e-a660-0cd0c53144c5",
                                                "sense_id": "40732a6e-aa49-3e38-86fa-e574e678d632",
                                                "text": "На этой ненависти к политическим шпионам и к бесцеремонному вторжению их в Лондон основал Эдвин Джеме свою защиту."
                                            },
                                            {
                                                "example_id": "5579cf8a-b5fe-4829-80ba-4f99d04666d1",
                                                "sense_id": "40732a6e-aa49-3e38-86fa-e574e678d632",
                                                "text": "Сколь было бесцеремонно это предложение, столь же бесцеремонен был и последовавший на него ответ."
                                            },
                                            {
                                                "example_id": "7edf73cf-5a1f-46cf-a7cc-933676148dfd",
                                                "sense_id": "40732a6e-aa49-3e38-86fa-e574e678d632",
                                                "text": "Мне, уединенно и трезво воспитанному мальчику, выросшему в барском степенном доме, весь этот шум и гам, эта бесцеремонная, почти буйная веселость, эти небывалые сношения с незнакомыми людьми так и бросились в голову."
                                            },
                                            {
                                                "example_id": "67ba209e-85ca-4ab0-8746-9b3cf6e1ebc8",
                                                "sense_id": "40732a6e-aa49-3e38-86fa-e574e678d632",
                                                "text": "Семен Иванович продолжал до тех пор свою бесцеремонную речь, пока не был приглашен замолчать."
                                            },
                                            {
                                                "example_id": "1ceeec60-6dc9-4ee0-9813-ca66f2b5fc30",
                                                "sense_id": "40732a6e-aa49-3e38-86fa-e574e678d632",
                                                "text": "Громкий и самый бесцеремонный залп хохота раздался разом, так что заснувший за дверью ребёнок проснулся и запищал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8da4561-edb3-356a-8687-c5ea9c712fcd",
                                        "entry_id": "ae00a044-b4a4-3b98-bc0b-66b058624c16",
                                        "glosses": [
                                            "выражающий такое пренебрежение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "426773fe-cd5d-4746-9941-20793cab7aef",
                                                "sense_id": "b8da4561-edb3-356a-8687-c5ea9c712fcd",
                                                "text": "Нижние чины теперь обращались с ним самым бесцеремонным образом, словно это был тюк с дешевым товаром, а не командующий эскадрой."
                                            },
                                            {
                                                "example_id": "1cea56a1-c562-4c47-a732-0a2c220e7ddc",
                                                "sense_id": "b8da4561-edb3-356a-8687-c5ea9c712fcd",
                                                "text": "Это был отказ, причем бесцеремонный, не обставленный хотя бы из приличия политесом и демагогией."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
