{
    "word_family": [
        "союзник",
        "союзный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c30db7de-a6e6-3eee-90a2-c139b1dbeb80",
                    "sense_definition": "Объединение людей, организаций или государств ради общей цели, совместных действий.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "alliance_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Европейский <союз> принял новые законы о торговле.",
                            "target_lang_translations": {
                                "en": "The European <w>Union</w> adopted new trade laws.",
                                "zh": "欧洲<w>联盟</w>通过了新的贸易法。"
                            }
                        },
                        {
                            "text": "Писатели решили создать свой профессиональный <союз>.",
                            "target_lang_translations": {
                                "en": "The writers decided to create their own professional <w>union</w>.",
                                "zh": "作家们决定成立自己的专业<w>协会</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "объединение",
                        "альянс",
                        "коалиция"
                    ],
                    "common_phrases": [
                        "творческий союз",
                        "профессиональный союз",
                        "заключить союз",
                        "вступить в союз"
                    ],
                    "target_lang_definitions": {
                        "en": "An association formed by people, organizations, or states for a common purpose or mutual benefit.",
                        "zh": "为实现共同目标或共同利益而由个人、组织或国家组成的联合体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "union",
                                "target_lang_sense_clarification": "political or trade organization"
                            },
                            {
                                "target_lang_word": "alliance",
                                "target_lang_sense_clarification": "pact or coalition between parties"
                            },
                            {
                                "target_lang_word": "league",
                                "target_lang_sense_clarification": "association of groups"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "联盟",
                                "target_lang_sense_clarification": "政治或组织间的联合"
                            },
                            {
                                "target_lang_word": "协会",
                                "target_lang_sense_clarification": "专业或行业组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cdbed1a-b87a-3df1-aa0f-4c785956df4d",
                    "sense_definition": "Служебная часть речи, которая соединяет слова, части сложного предложения или отдельные предложения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammar_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом предложении пропущен сочинительный <союз>.",
                            "target_lang_translations": {
                                "en": "A coordinating <w>conjunction</w> is missing in this sentence.",
                                "zh": "这个句子中漏掉了一个并列<w>连词</w>。"
                            }
                        },
                        {
                            "text": "Учитель объяснил нам, как правильно использовать этот <союз>.",
                            "target_lang_translations": {
                                "en": "The teacher explained to us how to correctly use this <w>conjunction</w>.",
                                "zh": "老师向我们解释了如何正确使用这个<w>连词</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "сочинительный союз",
                        "подчинительный союз"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammar"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A word used to connect words, phrases, clauses, or sentences.",
                        "zh": "用于连接词、短语、分句或句子的虚词。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conjunction",
                                "target_lang_sense_clarification": "grammar part of speech"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "连词",
                                "target_lang_sense_clarification": "语法中的词类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3157d892-b3dc-3457-9497-acd68dc4cf9c",
                    "sense_definition": "Тесная связь между людьми, взаимное единение; супружество.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bond_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Их счастливый брачный <союз> длился пятьдесят лет.",
                            "target_lang_translations": {
                                "en": "Their happy marital <w>union</w> lasted fifty years.",
                                "zh": "他们幸福的<w>婚姻</w>持续了五十年。"
                            }
                        },
                        {
                            "text": "Это был удивительный <союз> ума и сердца.",
                            "target_lang_translations": {
                                "en": "It was an amazing <w>union</w> of mind and heart.",
                                "zh": "这是理智与情感的奇妙<w>结合</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "партнёрство",
                        "соединение"
                    ],
                    "antonyms": [
                        "разлад",
                        "распад"
                    ],
                    "common_phrases": [
                        "брачный союз",
                        "семейный союз",
                        "священный союз"
                    ],
                    "target_lang_definitions": {
                        "en": "A close connection or unity between people; the state of being married.",
                        "zh": "人与人之间紧密的联系或结合；婚姻状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "union",
                                "target_lang_sense_clarification": "marriage or spiritual bond"
                            },
                            {
                                "target_lang_word": "bond",
                                "target_lang_sense_clarification": "close connection"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结合",
                                "target_lang_sense_clarification": "人与人之间的紧密联系"
                            },
                            {
                                "target_lang_word": "婚姻",
                                "target_lang_sense_clarification": "夫妻关系"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8287a148-f266-3b6c-90ce-5b8cfcf40cbb",
                    "sense_definition": "Сокращённое название Советского Союза (СССР).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ussr_group",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Мои родители родились и выросли в <Союзе>.",
                            "target_lang_translations": {
                                "en": "My parents were born and grew up in the <w>Union</w>.",
                                "zh": "我的父母出生并成长于<w>苏联</w>。"
                            }
                        },
                        {
                            "text": "После распада <Союза> многое в стране изменилось.",
                            "target_lang_translations": {
                                "en": "After the collapse of the <w>Union</w>, much changed in the country.",
                                "zh": "<w>苏联</w>解体后，国内发生了许多变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "СССР",
                        "Союз Советских Социалистических Республик",
                        "Советский Союз"
                    ],
                    "common_phrases": [
                        "Герой Союза"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in conversation referring to the USSR"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "refers to a historical state"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A short name referring to the Soviet Union (USSR).",
                        "zh": "指代苏联（USSR）的简称。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Union",
                                "target_lang_sense_clarification": "referring to the USSR"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苏联",
                                "target_lang_sense_clarification": "指代苏联"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06b57cbb-24c8-3634-ae6b-24ebc8f389a0",
                    "sense_definition": "Название серии советских и российских многоместных космических кораблей.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "space_group",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "Космонавты успешно вернулись на Землю на корабле «<Союз>».",
                            "target_lang_translations": {
                                "en": "The cosmonauts successfully returned to Earth on the \"<w>Soyuz</w>\" spacecraft.",
                                "zh": "宇航员乘坐“<w>联盟号</w>”飞船成功返回地球。"
                            }
                        },
                        {
                            "text": "Запуск ракеты с кораблем «<Союз>» транслировали по телевидению.",
                            "target_lang_translations": {
                                "en": "The launch of the rocket with the \"<w>Soyuz</w>\" spacecraft was broadcast on television.",
                                "zh": "搭载“<w>联盟号</w>”飞船的火箭发射过程进行了电视直播。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A series of Soviet and Russian spacecraft designed for carrying crew.",
                        "zh": "一系列用于载人的苏联及俄罗斯航天器。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Soyuz",
                                "target_lang_sense_clarification": "spacecraft name"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "联盟号",
                                "target_lang_sense_clarification": "航天器名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "016c0f15-bdc7-37c1-9cfc-403d83695837",
                    "sense_definition": "Федерация северных штатов США во время Гражданской войны.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "history_group",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "Армия <Союза> одержала решающую победу в этой битве.",
                            "target_lang_translations": {
                                "en": "The <w>Union</w> army won a decisive victory in this battle.",
                                "zh": "<w>联邦</w>军队在这场战役中取得了决定性胜利。"
                            }
                        },
                        {
                            "text": "Президент Линкольн стремился сохранить <Союз> любой ценой.",
                            "target_lang_translations": {
                                "en": "President Lincoln strove to preserve the <w>Union</w> at any cost.",
                                "zh": "林肯总统不惜一切代价力求维护<w>联邦</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Соединённые Штаты Америки"
                    ],
                    "antonyms": [
                        "Конфедерация"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The federation of Northern states during the American Civil War.",
                        "zh": "美国南北战争期间北方各州的联邦。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Union",
                                "target_lang_sense_clarification": "US historical context"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "联邦",
                                "target_lang_sense_clarification": "美国历史背景"
                            }
                        ]
                    }
                }
            ]
        }
    ]
