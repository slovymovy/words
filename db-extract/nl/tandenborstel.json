                                    }
                                ]
                            },
                            {
                                "target_word": "toothbrush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17ec99b9-c84e-3587-ac3a-5f7f7fc1a83c",
                                        "entry_id": "9d695d1b-a5b0-3d1a-91d2-6570ac713f76",
                                        "glosses": [
                                            "To clean or scrub with a toothbrush."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fca9100-8aa0-45c3-8789-5988c457917c",
                                                "sense_id": "17ec99b9-c84e-3587-ac3a-5f7f7fc1a83c",
                                                "text": "In Rome, a restorer toothbrushed away some candle-grime over God's Sistine Chapel eye to reveal an eyebrow of Groucho Marx proportion."
                                            },
                                            {
                                                "example_id": "ba7bce1c-d5e1-4ab4-944b-cbdae09602b9",
                                                "sense_id": "17ec99b9-c84e-3587-ac3a-5f7f7fc1a83c",
                                                "text": "I toothbrushed the stale rum stink from my mouth and stared at myself in the cabinet mirror."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb99fe7d-57fe-4030-8974-31c21ee8fd49",
                        "source_entry_id": "a193d1d1-2d84-38f9-8912-9a1b14263de8",
                        "source_sense_id": "2b74d985-d749-3ad8-a7b9-ebf8e1b8517b",
                        "source_sense_description": "borsteltje om de tanden mee te reinigen",
                        "target_lang_word": "brosse à dents",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brosse à dents",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2249b4ed-bd35-3b25-9693-7e7e1d5fe384",
                                        "entry_id": "62581917-4a5c-3d12-9863-25f126fafcbb",
                                        "glosses": [
                                            "Objet muni de poils ayant pour but de nettoyer les dents, utilisé avec du dentifrice."
                                        ],
                                        "tags": [
                                            "Hygiène"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7bdf61a-8795-40bd-819a-a08a77ebb5e6",
                                                "sense_id": "2249b4ed-bd35-3b25-9693-7e7e1d5fe384",
                                                "text": "Elle revient du cabinet de toilette, […], une brosse à dents à la main, la bouche toute mouillée et vermeille, les cheveux épars."
                                            },
                                            {
                                                "example_id": "1d7cc032-39ac-4eee-b664-4c2bae52c85d",
                                                "sense_id": "2249b4ed-bd35-3b25-9693-7e7e1d5fe384",
                                                "text": "Le nettoyage de la bouche doit être fait avec le plus grand soin après chaque repas ; la brosse à dents doit passer partout, enlever soigneusement toutes les parties d’aliments qui ont pu se placer entre les dents."
                                            },
                                            {
                                                "example_id": "f71e85a0-77ea-4c7e-9847-9e072000137c",
                                                "sense_id": "2249b4ed-bd35-3b25-9693-7e7e1d5fe384",
                                                "text": "Voyez-vous, je n’ai que faire de tout ce bric-à-brac qui vous est nécessaire. Ma brosse à dents, voilà tout mon bagage."
                                            },
                                            {
                                                "example_id": "a57ffb96-912f-4da8-963d-4eaf39193932",
                                                "sense_id": "2249b4ed-bd35-3b25-9693-7e7e1d5fe384",
                                                "text": "Il est à peu près aussi grand que vous, et il porte une petite moustache, genre brosse à dents."
                                            },
                                            {
                                                "example_id": "990b307e-48b9-4ecd-952f-223e10defb3e",
                                                "sense_id": "2249b4ed-bd35-3b25-9693-7e7e1d5fe384",
                                                "text": "Notre foyer s'équipait, se suréquipait de tous les appareils et gadgets qui simplifient la vie domestique. Grille-pain, brosse à dents électrique, chaîne 2 × 100 watts et autres remparts illusoires contre le vide de l'existence."
                                            },
                                            {
                                                "example_id": "b5f28a58-699a-40b0-a805-764b57bef9f1",
                                                "sense_id": "2249b4ed-bd35-3b25-9693-7e7e1d5fe384",
                                                "text": "La brosse à dents avec manche en bois et poils en soies de porc, fabriquée d'abord en Chine vers 1490, ne sera introduite en Europe qu'un demi-siècle plus tard."
                                            },
                                            {
                                                "example_id": "c3a2d076-c28f-47aa-9823-a9b54b47d73c",
                                                "sense_id": "2249b4ed-bd35-3b25-9693-7e7e1d5fe384",
                                                "text": "Sur l’étagère, dans un gobelet en plastique, trônaient ses sept brosses à dents. Liane en possédait une pour chaque jour de la semaine : lundi bleu, mardi rouge, mercredi jaune, selon un roulement précis et parfaitement maîtrisé. Liane considérait que les brosses à dents avaient droit au repos."
                                            },
                                            {
                                                "example_id": "e578a073-507c-491c-a68d-6abe42da0e11",
                                                "sense_id": "2249b4ed-bd35-3b25-9693-7e7e1d5fe384",
                                                "text": "La brosse à dents moderne n’a été inventée qu’en 1780, pendant le séjour en prison d’un certain William Addis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49e1c211-13c5-3570-bd95-50bf533c26a0",
                                        "entry_id": "62581917-4a5c-3d12-9863-25f126fafcbb",
                                        "glosses": [
                                            "Aspect d’une moustache."
                                        ],
                                        "tags": [
                                            "Barbe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab6226b8-763f-477a-82cf-ee2cb68830d9",
                                                "sense_id": "49e1c211-13c5-3570-bd95-50bf533c26a0",
                                                "text": "Un homme tout petit, tout rond, au visage quasi enfantin que des moustaches claires, taillées en brosse à dents, rendaient encore plus flou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
