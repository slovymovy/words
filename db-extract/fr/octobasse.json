                    {
                        "sense_id": "6707a15a-eeb7-3922-8672-cb148329e978",
                        "entry_id": "82c2a61a-e47d-3049-b126-a54d684e5f71",
                        "glosses": [
                            "Instrument de musique de la famille du violon, équipé de trois cordes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d55107c6-65c1-46a3-852d-235e19a397bd",
                                "sense_id": "6707a15a-eeb7-3922-8672-cb148329e978",
                                "text": "Il peut s’agir d’objets dont il a été fabriqué un seul exemplaire, comme l’octobasse […]."
                            },
                            {
                                "example_id": "36b22372-24f5-4882-be02-8db1c0ee056c",
                                "sense_id": "6707a15a-eeb7-3922-8672-cb148329e978",
                                "text": "De nombreux enfants des écoles visitent chaque jour le musée. L’impressionnante octobasse de J.-B. Vuillaume les subjugue."
                            },
                            {
                                "example_id": "1fb65cc6-37ab-437e-9f85-e38a646905f6",
                                "sense_id": "6707a15a-eeb7-3922-8672-cb148329e978",
                                "text": "Il s’adressa à sa compagne en roumain, d’une voix d’octobasse."
                            }
                        ]
                    }
                ],
