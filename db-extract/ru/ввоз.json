                        ]
                    },
                    {
                        "translation_id": "484f31eb-b8d1-499a-8f3e-55d7c1b25ba9",
                        "source_entry_id": "f4c2db08-1a7e-3f05-8cd8-e5465017182a",
                        "source_sense_description": "действие по значению гл. «ввозить»",
                        "target_lang_word": "importation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "importation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f578bdf2-9445-3ba2-a095-0ec6f3563516",
                                        "entry_id": "5043e740-ae40-3cfc-9566-d6e477bad04d",
                                        "glosses": [
                                            "Action d’importer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "302fb218-d824-4e08-9fc2-bac989deea6f",
                                                "sense_id": "f578bdf2-9445-3ba2-a095-0ec6f3563516",
                                                "text": "Ces derniers jugent déloyales les importations de tomates iraniennes."
                                            },
                                            {
                                                "example_id": "4e794ac7-d364-407e-932f-e5908d690b83",
                                                "sense_id": "f578bdf2-9445-3ba2-a095-0ec6f3563516",
                                                "text": "La société Funboard importe des planches à roulettes de Corée et de Taïwan selon les modèles. La dernière commande concerne l’importation de 8 000 planches à roulettes au prix unitaire de 100 USD CIF Le Havre."
                                            },
                                            {
                                                "example_id": "8c1759c4-8bc0-4171-afc7-031339d8d4c9",
                                                "sense_id": "f578bdf2-9445-3ba2-a095-0ec6f3563516",
                                                "text": "— Faudra-t-il donc, écrit Jules Marouzeau à propos du français, chaque fois que nous pratiquons une importation, avoir recours pour la désigner à quelque procédé périphrastique ? C’est ce que nous avons fait, après quelles hésitations ! pour le mot pomme de terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62f056fc-2cc9-335b-aaba-fda3e891190c",
                                        "entry_id": "5043e740-ae40-3cfc-9566-d6e477bad04d",
                                        "glosses": [
                                            "Marchandises importées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adf6e244-712f-4db4-b917-2b1db88836ec",
                                                "sense_id": "62f056fc-2cc9-335b-aaba-fda3e891190c",
                                                "text": "Si l'on prend comme exemple l'approvisionnement alimentaire, on entend par autosuffisance une complète indépendance à l'égard des importations pour répondre aux besoins alimentaires d'une collectivité ou d'une ville, un objectif difficilement atteignable même en vertu du scénario le plus optimiste."
                                            },
                                            {
                                                "example_id": "2e50f530-24bc-4b69-8124-b08d36347e47",
                                                "sense_id": "62f056fc-2cc9-335b-aaba-fda3e891190c",
                                                "text": "Les importations ont été beaucoup moins considérables que les exportations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd15a0bc-2043-3e70-9339-1caf2b072755",
                                        "entry_id": "5043e740-ae40-3cfc-9566-d6e477bad04d",
                                        "glosses": [
                                            "Transport d’un pays dans un autre."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81c30532-745e-4326-985e-4f901c56c640",
                                                "sense_id": "dd15a0bc-2043-3e70-9339-1caf2b072755",
                                                "text": "Ce constat n’est pas nouveau : le keynésiano-fordisme des Trente Glorieuses s’est bâti sur le recours massif à l’importation de travailleurs immigrés venus du Tiers monde."
                                            },
                                            {
                                                "example_id": "f734908b-1267-4bfd-9c0b-b74f55ecebcb",
                                                "sense_id": "dd15a0bc-2043-3e70-9339-1caf2b072755",
                                                "text": "L’importation du choléra en Europe."
                                            },
                                            {
                                                "example_id": "2f7836f5-6022-4e40-8c8b-05208eea6a0b",
                                                "sense_id": "dd15a0bc-2043-3e70-9339-1caf2b072755",
                                                "text": "L’importation de modes étrangères. — L’importation d’idées subversives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
