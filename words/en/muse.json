{
    "word_family": [
        "musing",
        "muser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad1fcc58-032a-38ed-9591-128f66d041f2",
                    "sense_definition": "To become lost in thought or to ponder deeply.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She would often sit by the window and <w>muse</w> about her future.",
                            "target_lang_translations": {
                                "ru": "Она часто сидела у окна и <w>размышляла</w> о своем будущем."
                            }
                        },
                        {
                            "text": "He stopped to <w>muse</w> on the strange events of the past week.",
                            "target_lang_translations": {
                                "ru": "Он остановился, чтобы <w>обдумать</w> странные события прошедшей недели."
                            }
                        }
                    ],
                    "synonyms": [
                        "cogitate",
                        "contemplate",
                        "meditate",
                        "ponder",
                        "reflect",
                        "ruminate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Погружаться в глубокие размышления или задумываться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размышлять",
                                "target_lang_sense_clarification": "глубоко и сосредоточенно думать о чем-либо"
                            },
                            {
                                "target_lang_word": "задумываться",
                                "target_lang_sense_clarification": "погружаться в свои мысли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "935bdeb7-710a-3269-8d13-7d231a970d7f",
                    "sense_definition": "To think about or meditate on a specific subject.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher liked to <w>muse</w> on the nature of human existence.",
                            "target_lang_translations": {
                                "ru": "Философ любил <w>размышлять</w> о природе человеческого существования."
                            }
                        },
                        {
                            "text": "They spent the afternoon <w>musing</w> on the possibilities of the new project.",
                            "target_lang_translations": {
                                "ru": "Они провели день, <w>размышляя</w> о возможностях нового проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "consider",
                        "mull",
                        "ponder",
                        "think"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обдумывать или размышлять о конкретной теме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдумывать",
                                "target_lang_sense_clarification": "тщательно рассматривать какую-то тему или вопрос"
                            },
                            {
                                "target_lang_word": "размышлять над",
                                "target_lang_sense_clarification": "анализировать конкретный предмет или проблему"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "36c11816-5f79-304a-a1ee-aa1391c47b9c",
                    "sense_definition": "A person or force that serves as a source of artistic inspiration.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inspiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter considered his wife to be his greatest <w>muse</w>.",
                            "target_lang_translations": {
                                "ru": "Художник считал свою жену своей величайшей <w>музой</w>."
                            }
                        },
                        {
                            "text": "The beautiful landscape served as a <w>muse</w> for the young poet.",
                            "target_lang_translations": {
                                "ru": "Прекрасный пейзаж послужил <w>музой</w> для молодого поэта."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или сила, служащие источником творческого вдохновения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "му́за",
                                "target_lang_sense_clarification": "переносное значение: вдохновитель на творчество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0210e114-eefb-3785-9e08-5f774d9a5813",
                    "sense_definition": "One of the nine ancient Greek goddesses who presided over the arts and sciences.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "The ancient writer prayed to a <w>Muse</w> for help with his epic poem.",
                            "target_lang_translations": {
                                "ru": "Древний писатель молил <w>Музу</w> о помощи в создании своей эпической поэмы."
                            }
                        },
                        {
                            "text": "In Greek mythology, each <w>Muse</w> was responsible for a different branch of art.",
                            "target_lang_translations": {
                                "ru": "В греческой мифологии каждая <w>Муза</w> отвечала за определенный вид искусства."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из девяти древнегреческих богинь, покровительниц искусств и наук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "му́за",
                                "target_lang_sense_clarification": "мифологическое божество"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "48de0491-2cfc-3edb-98f8-0e5de6bb30b2",
                    "sense_definition": "A city located in Shan State, Myanmar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The border town of <w>Muse</w> is a major hub for trade between Myanmar and China.",
                            "target_lang_translations": {
                                "ru": "Приграничный город <w>Мусе</w> является крупным торговым узлом между Мьянмой и Китаем."
                            }
                        },
                        {
                            "text": "Many goods are transported through <w>Muse</w> every single day.",
                            "target_lang_translations": {
                                "ru": "Множество товаров перевозится через <w>Мусе</w> каждый день."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город, расположенный в штате Шан, Мьянма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Му́се",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}