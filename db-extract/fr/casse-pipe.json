                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "Ende eines Werkzeuges wie eines Hammers oder Schlägels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4c2c71e-d39a-4fdc-a93d-f3acd5259344",
                                                "sense_id": "0f1193af-a6f6-3212-ad9e-05608e193979",
                                                "text": "Dieser Hammer hat einen schwereren Kopf."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "8c54d500-fdc4-3440-9ab8-c205f393de43",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "oberer, vom übrigen Text getrennter Teil einer beschriebenen Seite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3910b89b-8e62-4c5e-8d7e-7a7b215bce3f",
                                                "sense_id": "8c54d500-fdc4-3440-9ab8-c205f393de43",
                                                "text": "Im Kopf des Briefes stand die falsche Adresse."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "33962215-3065-3145-b5c8-82b313d72318",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "jene Seite einer Münze, die eine Abbildung einer Person zeigt"
                                        ],
                                        "tags": [
                                            "Münzwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "045f4a4e-41ae-4342-9a5e-cbfec09bca23",
                                                "sense_id": "33962215-3065-3145-b5c8-82b313d72318",
                                                "text": "Lass uns eine Münze werfen; was wählst du, Zahl oder Kopf?"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "b33025ff-c802-3b1e-876d-52e1cc4991fd",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "Bauteil, Gerät, Maschinenteil, das aufgesetzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "828e63c8-a39e-48e4-b8f1-6b44959bd279",
                                                "sense_id": "b33025ff-c802-3b1e-876d-52e1cc4991fd",
                                                "text": "Wir müssen nur noch den Kopf montieren, dann sind wir fertig."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "99fcccf0-e9bf-3d50-9d11-53f5a4178dc5",
                                        "entry_id": "f07a9e59-ac9d-30df-a2e7-d4782f93b713",
                                        "glosses": [
                                            "oberster Teil eines dreieckigen Segels"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f811c8-a667-4758-b53a-1af09fdddeaa",
                                                "sense_id": "99fcccf0-e9bf-3d50-9d11-53f5a4178dc5",
                                                "text": "Der Kopf wird meist verstärkt durch ein Brett aus Kunststoff oder Aluminium."
                                            },
                                            {
                                                "example_id": "c7f94487-d4e7-4b10-bbfd-1f684ce96448",
                                                "sense_id": "99fcccf0-e9bf-3d50-9d11-53f5a4178dc5",
                                                "text": "„Ein Groß mit horizontalem statt spitz zulaufendem Kopf – das war bisher konventionellen Riggs vorbehalten.“"
                                            },
                                            {
                                                "example_id": "edf66ac6-0170-46f6-8052-5575a244d7a1",
                                                "sense_id": "99fcccf0-e9bf-3d50-9d11-53f5a4178dc5",
                                                "text": "„Obwohl es üblich ist, das Vorsegel »irgendwie« in seinen Sack zu stopfen, wenn nur der Kopf obenauf liegt, sollte man das Segel lieber vom Kopf zum Hals hin einrollen, wenn es für längere Zeit weggestaut bleiben soll. So vermeidet man Knicke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
                            }
                        ]
                    }
