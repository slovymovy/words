                    "sense_definition": "mający duże powodzenie, cieszący się popularnością i w związku z tym chętnie zatrudniany lub poszukiwany",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jako <w>wzięty</w> autor, w krótkim czasie podpisał korzystne umowy z kilkoma wydawcami.",
                            "target_lang_translations": {
                                "en": "As a <w>sought-after</w> author, he quickly signed lucrative contracts with several publishers."
                            }
                        },
                        {
                            "text": "Mój brat jest bardzo <w>wziętym</w> prawnikiem i rzadko ma wolny czas.",
                            "target_lang_translations": {
                                "en": "My brother is a very <w>in-demand</w> lawyer and rarely has free time."
                            }
                        }
                    ],
                    "synonyms": [
