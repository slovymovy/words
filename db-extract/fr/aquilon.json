                                "target_senses": [
                                    {
                                        "sense_id": "9e2dae34-d9f7-3405-a96b-22bab83a5a89",
                                        "entry_id": "055f092f-f1a4-3bb9-bc86-42fa8c980988",
                                        "glosses": [
                                            "The north wind."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2e46460-0b3c-46c6-8ba7-db36f065cfb0",
                                                "sense_id": "9e2dae34-d9f7-3405-a96b-22bab83a5a89",
                                                "text": "Whether it is most prudent to expose / Our lovely forms to keenest blasts of boreas"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "516e004f-73cb-4d72-8c7b-8cb7b745e1e8",
                        "source_entry_id": "78f0e7b0-b95a-31e4-a06c-ab3351957745",
                        "source_sense_description": "Vent du nord",
                        "target_lang_word": "northerly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
