    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                "word": "schoolie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "894b60d4-6fa5-4b32-92c8-f0a095c9d707",
                        "entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "tags": [
                            "plural"
                        ],
                        "form": "schoolies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b34fc4d7-7c84-3515-876c-b97ec21e19b3",
                        "entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "glosses": [
                            "A senior school student, especially a school-leaver, engaged in unsupervised celebrations during schoolies week."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "da37cb7c-c9c8-4542-b796-035dda4baeae",
                                "sense_id": "b34fc4d7-7c84-3515-876c-b97ec21e19b3",
                                "text": "Known as the Drug Awareness Network, it was able to find funding assistance for its work from the National Drug Education unit. The network devised a programme of activities which was later advertised to intending Schoolies by helpers walking the streets and distributing leafets containing information about forthcoming events."
                            },
                            {
                                "example_id": "76150636-fa61-43ec-af6e-5db793e89386",
                                "sense_id": "b34fc4d7-7c84-3515-876c-b97ec21e19b3",
                                "text": "Some of the locals prey on the Schoolies."
                            },
                            {
                                "example_id": "b46d6401-0a48-44a6-b5ba-41096c1a2d85",
                                "sense_id": "b34fc4d7-7c84-3515-876c-b97ec21e19b3",
                                "text": "If staying in November or December, the place is filled with hundreds of schoolies."
                            },
                            {
                                "example_id": "2d99cf30-89f1-4c92-b7fa-15b72866a8f8",
                                "sense_id": "b34fc4d7-7c84-3515-876c-b97ec21e19b3",
                                "text": "But the victim in this case had been a schoolie, she′d been assaulted during Schoolies Week, and her attacker might have been a fellow schoolie."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc32f302-4c43-3991-b64a-c815e9e11745",
                        "entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "glosses": [
                            "A schoolteacher."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cade4d5e-c776-3ec3-acdf-3d4cc91a128e",
                        "entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "glosses": [
                            "An education officer."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "fc0361a4-96c1-467f-8288-8bb21d5a7d74",
                                "sense_id": "cade4d5e-c776-3ec3-acdf-3d4cc91a128e",
                                "text": "Arbroath, being a training station for young naval airmen, also housed several ‘schoolies’ (education officers), four of whom lived in an adjacent building to mine. I quickly struck up a close friendship with two of the schoolies, Ron Horner and Vivian Price."
                            }
                        ]
                    },
                    {
                        "sense_id": "b93caf3c-1147-3351-9fe5-2124d97ab1d6",
                        "entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "glosses": [
                            "A juvenile gamefish (especially striped bass) at a stage where it tends to swim with others in schools rather than stay to itself."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "ef023176-fac3-4adb-9e73-ac7cceecc021",
                                "sense_id": "b93caf3c-1147-3351-9fe5-2124d97ab1d6",
                                "text": "1997 August, Lawrence Pine, Massachusetts′s Plymouth Rock Bass, Field & Stream, page 94,\nPoppers and Clouser-style flies can produce large numbers of schoolies that average 16 to 24 inches, with a sprinkling of fish from 24 to 28 inches."
                            },
                            {
                                "example_id": "d6bbf90a-c241-412a-8688-996ee06e2d92",
                                "sense_id": "b93caf3c-1147-3351-9fe5-2124d97ab1d6",
                                "text": "Oklahomans Jim Campbell and Gary Tyler caught 123 peacocks (including two teeners) by concentrating on the schoolies with jigs and other small lures that day."
                            },
                            {
                                "example_id": "61bd0710-c880-4395-a321-425bc91ac79b",
                                "sense_id": "b93caf3c-1147-3351-9fe5-2124d97ab1d6",
                                "text": "Schoolies tend to concentrate inside harbors and along beaches, often moving far inside tidal creeks and salt ponds."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebd95d4a-02ef-379d-8d80-2b7ecd846d96",
                        "entry_id": "9984c2f8-1348-376b-af62-9622a87354d3",
                        "glosses": [
                            "Synonym of school horse."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    }
                ],
