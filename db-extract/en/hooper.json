                    {
                        "translation_id": "6935c7bf-7f77-4128-b21c-05900458d759",
                        "source_entry_id": "5f43f055-b7de-3804-aa8c-fa77ca5b2fbe",
                        "source_sense_description": "One who applies hoop",
                        "target_lang_word": "Böttcher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
