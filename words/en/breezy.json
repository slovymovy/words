    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "21d9350a-ba54-38c0-b09a-de6aaf503450",
                    "sense_definition": "Pleasantly windy, with light winds blowing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a walk along the shore on a bright, <w>breezy</w> morning.",
                            "target_lang_translations": {
                                "ru": "Мы с удовольствием прогулялись по берегу ярким, <w>ветреным</w> утром."
                            }
                        },
                        {
                            "text": "It was a <w>breezy</w> day, perfect for flying kites in the park.",
                            "target_lang_translations": {
                                "ru": "Это был <w>свежий ветреный</w> день, идеально подходящий для запуска воздушных змеев в парке."
                            }
                        }
                    ],
                    "synonyms": [
                        "windy",
                        "airy",
                        "blowy"
                    ],
                    "antonyms": [
                        "calm",
                        "windless",
                        "still"
                    ],
                    "common_phrases": [
                        "breezy day",
                        "breezy afternoon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятно ветреный, со свежим легким ветром."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ветреный",
                                "target_lang_sense_clarification": "с умеренным свежим ветром"
                            },
                            {
                                "target_lang_word": "свежий",
                                "target_lang_sense_clarification": "о погоде, с прохладным ветерком"
                            },
                            {
                                "target_lang_word": "продуваемый",
                                "target_lang_sense_clarification": "открытый легкому ветру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0081fa50-e2b5-3d8b-b0ac-6dbe5cad2ec4",
                    "sense_definition": "Cheerfully confident, relaxed, and light-hearted in manner or tone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She greeted everyone with a <w>breezy</w> smile and sat down at the table.",
                            "target_lang_translations": {
                                "ru": "Она поприветствовала всех <w>непринужденной</w> улыбкой и села за стол."
                            }
                        },
                        {
                            "text": "His <w>breezy</w> manner made all the new employees feel comfortable immediately.",
                            "target_lang_translations": {
                                "ru": "Его <w>легкая и раскованная</w> манера общения помогла всем новым сотрудникам сразу почувствовать себя комфортно."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "carefree",
                        "jaunty",
                        "nonchalant"
                    ],
                    "antonyms": [
                        "gloomy",
                        "somber",
                        "serious"
                    ],
                    "common_phrases": [
                        "breezy manner",
                        "bright and breezy",
                        "breezy confidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жизнерадостный, непринужденный, уверенный в себе и беззаботный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непринужденный",
                                "target_lang_sense_clarification": "легкий и раскованный в общении"
                            },
                            {
                                "target_lang_word": "беззаботный",
                                "target_lang_sense_clarification": "веселый и легкий на подъем"
                            },
                            {
                                "target_lang_word": "жизнерадостный",
                                "target_lang_sense_clarification": "бодрый и оптимистичный"
                            },
                            {
                                "target_lang_word": "развязный",
                                "target_lang_sense_clarification": "чрезмерно раскованный, легкомысленный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee598ff1-ee9d-3941-a75e-d77db3d81ac5",
                    "sense_definition": "A girl or young woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He asked his friend who that new <w>breezy</w> talking to the group was.",
                            "target_lang_translations": {
                                "ru": "Он спросил своего друга, кто эта новая <w>цыпочка</w>, разговаривающая с компанией."
                            }
                        },
                        {
                            "text": "He spent the whole weekend hanging out with some local <w>breezies</w>.",
                            "target_lang_translations": {
                                "ru": "Все выходные он провел, зависая с местными <w>девчонками</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
