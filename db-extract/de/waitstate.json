                                        "entry_id": "93202f6d-aa0a-31a1-998e-3a6057c6eb73",
                                        "glosses": [
                                            "Any of several instances in which a computer's processor cannot execute instructions (either for the entire computer, or just for a specific task) until an I/O operation completes, or until an interrupt is resolved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d709ce1-a7e2-4d51-bbb9-75dac560ab6f",
                                                "sense_id": "7266a23e-4721-3aa8-910b-fc21f3380f5d",
                                                "text": "With memory that slow, the processor is going to spend most of its time on wait states."
                                            }
