                        "glosses": [
                            "Qui sert à prédire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9f9856e-d7f6-4e5a-922b-2f6c7081d57e",
                                "sense_id": "4d102d80-9e52-3e6e-a8c4-e7ecc74c2873",
                                "text": "Un modèle prédictif."
                            },
                            {
                                "example_id": "d74c47ea-a8be-49e0-931c-7d4672d8a601",
                                "sense_id": "4d102d80-9e52-3e6e-a8c4-e7ecc74c2873",
                                "text": "Analyse critique et valeurs prédictives des signes de pneumonies aiguës."
