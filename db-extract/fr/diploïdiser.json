                "senses": [
                    {
                        "sense_id": "cf853543-4e9d-3d8b-91dd-feb7982935f1",
                        "entry_id": "9770118b-9db2-32c1-8cf4-81aaa3864615",
                        "glosses": [
                            "Rendre diploïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344ed8e2-1c51-40fc-bda7-afc2be1590a9",
                                "sense_id": "cf853543-4e9d-3d8b-91dd-feb7982935f1",
                                "text": "On pouvait se demander si les diplontes d'isolats homothalles étaient capables de diploïdiser des haplontes d'isolats hétérothalles."
                            },
                            {
                                "example_id": "30a8da8b-fdcb-4e1c-b9e3-df9ed3906fb1",
                                "sense_id": "cf853543-4e9d-3d8b-91dd-feb7982935f1",
                                "text": "Comme les filaments de ce dernier sont divisés en cellules par plusieurs milliers de cloisons, on peut se demander comment les noyaux de l'haplonte de sexe opposé peuvent passer de cellule en cellule le long des filaments à diploïdiser."
                            }
                        ]
                    }
                ],
