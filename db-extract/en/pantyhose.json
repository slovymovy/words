                                                "sense_id": "3f97ed93-f61e-3ea6-aa5a-d740573b8bd9",
                                                "text": "Eine Feinstrumpfhose bekommt schnell eine Laufmasche."
                                            },
                                            {
                                                "example_id": "16115b11-47d1-40c0-ab92-046a9c3e0255",
                                                "sense_id": "3f97ed93-f61e-3ea6-aa5a-d740573b8bd9",
                                                "text": "Zum Abendkleid trägt die Frau eine schwarze Feinstrumpfhose."
                                            }
