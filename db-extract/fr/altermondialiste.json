                    {
                        "sense_id": "a5fcd465-a82b-3f69-86a9-0a9b004f83ed",
                        "entry_id": "69c777c1-ae43-3038-8ed0-1ca429d4ed78",
                        "glosses": [
                            "Qui recherche une autre façon d’organiser le commerce mondial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2026886-bc2d-4d74-afdb-fb0f668731b6",
                                "sense_id": "a5fcd465-a82b-3f69-86a9-0a9b004f83ed",
                                "text": "Malgré tout, puisqu'un autre monde est sans doute possible, l'utopie altermondialiste n'est donc pas qu'une illusion."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
