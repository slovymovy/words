                        "glosses": [
                            "een deel van een plaats dat voor het overgrote deel uit woonhuizen bestaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e97341-c1fe-4b44-9ca1-c69afaa94de7",
                                "sense_id": "0458c950-5ef8-3211-bd08-6738339ba93a",
                                "text": "De uitspraak kan vergaande gevolgen krijgen, omdat veel darkstores in de stad zijn gevestigd in woonwijken. Er zijn er nu 31 en er zijn veel klachten over."
                            }
                        ]
