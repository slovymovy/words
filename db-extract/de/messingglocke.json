                "senses": [
                    {
                        "sense_id": "2de3cd6f-1997-376c-a698-fdf435d93ddc",
                        "entry_id": "d4d918a0-64d2-3ac7-af2f-dbcbdebd777b",
                        "glosses": [
                            "Glocke aus Messing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b277e750-667b-41fc-841f-698b0f428d93",
                                "sense_id": "2de3cd6f-1997-376c-a698-fdf435d93ddc",
                                "text": "„Darin steckte er geschnitzte Stäbe und stellte je nach der Bedeutung des Verstorbenen und den Möglichkeiten der Familie Messingglocken, aus Holz geschnitzte oder aus Bronze gegossene Gedenkköpfe, Zeremonialschwerter und andere Gegenstände, die an den Toten und sein Leben erinnerten, auf dem Altar auf.“"
                            },
                            {
                                "example_id": "d1b7f802-6565-4e50-9e1f-e72e5d536f79",
                                "sense_id": "2de3cd6f-1997-376c-a698-fdf435d93ddc",
                                "text": "„Der junge britische Offizier hatte die Kaffeemaschine stehenlassen und läutete jetzt mit einer kleinen Messingglocke zum Beginn der ersten Sitzung dieses Vormittags.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
