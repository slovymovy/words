                        "entry_id": "00c81dc9-00ed-3bbe-9ccd-a0efae2ef9b7",
                        "glosses": [
                            "zich verstappen: per ongeluk misstappen zodat je bijvoorbeeld je enkel verzwikt en bijna valt"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "7cde8942-43ed-446f-9f13-fe6e765540ef",
                                "sense_id": "bcd8abe1-6144-3265-9643-02cd46249a6c",
                                "text": "Omdat ik het afstapje niet zag, heb ik me verstapt en moest ik met mijn verzwikte enkel naar het ziekenhuis."
                            },
                            {
                                "example_id": "daa3efde-7fee-4f74-ad12-35e0f5e92ed7",
                                "sense_id": "bcd8abe1-6144-3265-9643-02cd46249a6c",
                                "text": "Om mezelf rond te kunnen bewegen, moest ik over flinke bergen afval heen stappen. Soms verstapte ik me en zakte ik er zo doorheen."
                            }
                        ]
                    }
