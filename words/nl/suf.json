                    "sense_definition": "Gebiedende wijs van <w>suffen</w>.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "Vorm van suffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Suf</w> niet achter je bureau; sta even op en loop rond.",
                            "target_lang_translations": {
                                "en": "Don't <w>doze</w> at your desk; stand up for a moment and walk around."
                            }
                        },
                        {
                            "text": "<w>Suf</w> niet tijdens de les, want je mist belangrijke uitleg.",
                            "target_lang_translations": {
                                "en": "Don't <w>daydream</w> during the lesson, because you'll miss important explanations."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suf niet",
                        "suf even",
                        "suf door"
                    ],
                    "target_lang_definitions": {
