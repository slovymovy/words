                ],
                "senses": [
                    {
                        "sense_id": "934af827-e845-3f59-9253-843f2ec6cc09",
                        "entry_id": "6fbb1ef8-7c86-321e-af44-9e4a5ec95ba4",
                        "glosses": [
                            "Celle qui est d’une bêtise niaise et lourde."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "66c5bcf9-8c6a-4c13-afa6-76466c7f4f04",
                                "sense_id": "934af827-e845-3f59-9253-843f2ec6cc09",
                                "text": "Mais, petite bêtasse que vous êtes, toutes ces lettres-là, c’est pour rire, c’est des inventions ; ces lettres-là ne sont jamais arrivées à leur adresse."
                            },
                            {
                                "example_id": "2e4b13b0-251c-41a3-9418-51471221f3b7",
                                "sense_id": "934af827-e845-3f59-9253-843f2ec6cc09",
                                "text": "[…] elle me dit en riant : « Voilà mon petit jaunet, mon petit serin, qui va rendre sa maman aussi bêtasse que lui, pour peu que cela continue. »"
                            },
                            {
                                "example_id": "4a2ea4db-cb21-4029-aaa4-8bc93b861075",
                                "sense_id": "934af827-e845-3f59-9253-843f2ec6cc09",
                                "text": "Et cette bêtasse de Carmen Fantout qui roulait des yeux ravis en répétant : « Non, ce que c’est facile, ce que c’est facile ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68d03145-d7ca-46e8-9d13-32fe9d2640a1",
                        "source_entry_id": "6fbb1ef8-7c86-321e-af44-9e4a5ec95ba4",
                        "source_sense_id": "934af827-e845-3f59-9253-843f2ec6cc09",
                        "target_lang_word": "Dummkopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dummkopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                        "entry_id": "b5ab529b-6045-333b-aa6e-fa5857841d8c",
                                        "glosses": [
                                            "dummer Mensch"
                                        ],
                                        "tags": [
                                            "beleidigend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d766c218-9b4a-4a95-853b-f7216bb29309",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "Ich Dummkopf, dass ich die Schule abgebrochen habe!"
                                            },
                                            {
                                                "example_id": "cb12cc2a-833e-42e8-a38d-781479c290dd",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Nur Dummköpfe verlangen von euch, dass ihr eure Herkunft, eure Sprache und euren Glauben verleugnet.“"
                                            },
                                            {
                                                "example_id": "b0e128b8-38e9-4cbc-a6e9-ae178e29b143",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Heinrich Cuno ist ein unwissender Dummkopf, der sich vor Eitelkeit aufbläht.“"
                                            },
                                            {
                                                "example_id": "e24fcf47-41f7-4619-b127-a7ab3bd367c5",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Er war ein Dummkopf mit dem Verstand eines Hanswurstes und hielt alle, sie ihm zuhörten, für noch einfältiger.“"
                                            },
                                            {
                                                "example_id": "eb90df82-e3cd-4b6f-acf7-0cc6367134f7",
                                                "sense_id": "c68b54be-8bb8-3f98-9aac-a6f0b35b2df9",
                                                "text": "„Ich muß an jener Frau wohl doch leidenschaftlicher gehangen haben, als ich selber wußte; sonst würde es mir nicht so schwerfallen, zuzugeben, daß jener Dummkopf sie geliebt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
