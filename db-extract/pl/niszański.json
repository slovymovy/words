                "senses": [
                    {
                        "sense_id": "7df33208-eb61-3097-b55f-75ad2b1c4c68",
                        "entry_id": "3f6f0083-867f-3247-bc89-ea99d5589ef4",
                        "glosses": [
                            "związany z Niszem, dotyczący Niszu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb6463e-1486-4169-b0c9-bd97fbd6a2bb",
                                "sense_id": "7df33208-eb61-3097-b55f-75ad2b1c4c68",
                                "text": "Nie wiadomo, ile w tej całej historii jest prawdy, ale faktem pozostaje, że wieści o powstaniu niszańskim, a także o towarzyszących mu niepokojach w innych prowincjach mogły podziałać na wyobraźnię i zachowanie Vasojevicia"
                            },
                            {
                                "example_id": "97d3c654-3b99-4689-ba20-b1e2298ea01a",
                                "sense_id": "7df33208-eb61-3097-b55f-75ad2b1c4c68",
                                "text": "Turcy cofali się, zamierzając stawić czoła wojskom chrześcijańskim w Kotlinie Niszańskiej, ku której zmierzały koncentrujące się oddziały Iszak-beja, Turachan-beja i bejlerbeja Kassima-paszy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
