                                        "entry_id": "c6ddfe6e-5635-39b1-8e36-e627b67f1e72",
                                        "glosses": [
                                            "A person from Tajikistan or of Tajik descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17b2c9a7-32e3-43d2-acbb-51945763597f",
                                                "sense_id": "98715812-2c27-3a48-8adf-2fe8cdd08a8e",
                                                "text": "“True that it would be preferable that you marry a local, a Tajik, but Rasheed is healthy, and interested in you.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Tajik",
                                "target_lang_code": "en",
