                "senses": [
                    {
                        "sense_id": "a447a7c3-001d-3d31-a16c-c90201828a9a",
                        "entry_id": "b83d6e96-1688-35b4-be27-a09a7efc79ea",
                        "glosses": [
                            "verstärkende Form von Liebling, besonders geschätzte/bevorzugte Person/Sache"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "4549b410-9983-4f5a-b05c-25adf82a756b",
                                "sense_id": "a447a7c3-001d-3d31-a16c-c90201828a9a",
                                "text": "„Es waren zwar nicht meine Lieblingslieblinge, aber dennoch schade... Naja, wieder was dazu gelernt... Editiere immer in der Word-Datei und hüte sie wie ein Schatz.“"
                            },
                            {
                                "example_id": "e3d56b36-9806-4729-a261-dc2fe50cb03a",
                                "sense_id": "a447a7c3-001d-3d31-a16c-c90201828a9a",
                                "text": "„Da haben sich doch 2 meiner musikalischen Lieblingslieblinge zusammengetan und so ne Art Super-Lieblings-Dingsi² gegründet: die Super Toys.“"
                            },
                            {
                                "example_id": "f3dcc597-5f9b-432a-8132-09cd4becc8c7",
                                "sense_id": "a447a7c3-001d-3d31-a16c-c90201828a9a",
                                "text": "„Jeder, der bei »Pop« als erstes an »Diskurs« denkt, hat die Überschrift natürlich längst als Referenz an den Lieblingsliebling aller ernstmeinenden Popkritiker erkannt.“"
                            },
                            {
                                "example_id": "7e3dc692-ea0d-4ddd-b688-e34782631e6e",
                                "sense_id": "a447a7c3-001d-3d31-a16c-c90201828a9a",
                                "text": "„Ja Frau Vau, sie sind meine oberliebsten Lieblingslieblinge.“"
                            },
                            {
                                "example_id": "766ff68f-5c73-4643-ac83-b615344db982",
                                "sense_id": "a447a7c3-001d-3d31-a16c-c90201828a9a",
                                "text": "„Ich finde es erstaunlich, dass du immer meine Strickprojekte mit Namen kennst 😀 Ich denke, dass es sicherlich ein paar Lieblingslieblinge unter den Strickanleitungen gibt.“"
                            },
                            {
                                "example_id": "64cfbcd4-60ad-410a-b680-eef09e07f2b5",
                                "sense_id": "a447a7c3-001d-3d31-a16c-c90201828a9a",
                                "text": "„Um mich bei dir und meinem Lieblingsliebling KHB, dem Gelben im faulen Regierungsei, einzuschmeicheln, habe ich deshalb eine Collage entworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
