                "senses": [
                    {
                        "sense_id": "1242288d-9c1e-3941-a3ff-836fe0734f60",
                        "entry_id": "feefd81c-9f61-3869-a4f3-4f54846a1b6a",
                        "glosses": [
                            "Boot, das für Patrouillenfahrten Verwendung findet"
                        ],
                        "tags": [
                            "Polizei",
                            "Küstenwache",
                            "Zoll"
                        ],
                        "examples": [
                            {
                                "example_id": "0e98d5d7-5d7c-4213-9f01-946eca6184dc",
                                "sense_id": "1242288d-9c1e-3941-a3ff-836fe0734f60",
                                "text": "„Als ich vorsichtig wieder auftauchte, sah ich das Patrouillenboot abdrehen.“"
                            },
                            {
                                "example_id": "298fc127-c059-42ad-92a9-5eda3d7c2df1",
                                "sense_id": "1242288d-9c1e-3941-a3ff-836fe0734f60",
                                "text": "„Das Kreuzfahrtschiff habe geringfügige Schäden erlitten, die Seetüchtigkeit des Schiffes sei aber nicht beeinträchtigt worden. Das venezolanische Patrouillenboot habe dagegen schwere Schäden erlitten und sei mit Wasser vollgelaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fa9d07ba-9604-315b-89b9-03215fa0af14",
                        "entry_id": "feefd81c-9f61-3869-a4f3-4f54846a1b6a",
                        "glosses": [
                            "Boot, das für Patrouillenfahrten Verwendung findet",
                            "leicht bewaffneter, schneller Bootstyp, selten größer als eine Korvette, bei Maximalgröße einer Fregatte"
                        ],
                        "tags": [
                            "Polizei",
                            "Küstenwache",
                            "Zoll",
                            "als Schiffstyp"
                        ],
                        "examples": [
                            {
                                "example_id": "8be2fa51-deaa-4404-b015-d1196102a87c",
                                "sense_id": "fa9d07ba-9604-315b-89b9-03215fa0af14",
                                "text": "„Auffällig ist natürlich die Ausfuhrgenehmigung für das erste von 48 (Korrektur: wohl doch nur 33 plus drei für Kommando und Training) Patrouillenbooten an Saudi-Arabien – praktisch der Türöffner für diese Lieferungen ….“"
                            },
                            {
                                "example_id": "a542eb1d-4be6-433e-ada9-ccca3fcb4f07",
                                "sense_id": "fa9d07ba-9604-315b-89b9-03215fa0af14",
                                "text": "„Die Bundesregierung hat die Lieferung des ersten von insgesamt 48 Patrouillenbooten nach Saudi-Arabien genehmigt.“"
                            },
                            {
                                "example_id": "84f728e2-599c-4a5a-b926-2db3ae6999ac",
                                "sense_id": "fa9d07ba-9604-315b-89b9-03215fa0af14",
                                "text": "„Fünf mit Radar und Maschinengewehren ausgestattete ‚Offshore-Patrouillen-Boote‘ wiegen mehr als 1000 Tonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    }
                ],
