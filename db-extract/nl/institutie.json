                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "b469a592-7ba4-463b-9a35-f1c4d356485b",
                        "entry_id": "e55c861b-9380-3732-b63c-c3eca7a4b667",
                        "tags": [
                            "plural"
                        ],
                        "form": "instituties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb2ce184-d7ba-3054-9043-f9de2529025b",
                        "entry_id": "e55c861b-9380-3732-b63c-c3eca7a4b667",
                        "glosses": [
                            "staatsrechtelijke of burgerlijke organisatie"
                        ],
                        "tags": [
                            "maatschappij"
                        ],
                        "examples": [
                            {
                                "example_id": "d83ba899-1654-467b-85c3-e505c9ef66de",
                                "sense_id": "cb2ce184-d7ba-3054-9043-f9de2529025b",
                                "text": "Een dergelijke institutie wordt gedragen door normen en waarden. Dit is voor de ethiek een interessante opening in het gangbare economische model."
                            },
                            {
                                "example_id": "160dc2fb-b495-481a-a21f-3cb3b3b5144d",
                                "sense_id": "cb2ce184-d7ba-3054-9043-f9de2529025b",
                                "text": "Het is verleidelijk om na een maand presidentschap Trump en Poetin over één kam te scheren. Ze delen immers hun honger naar macht en rijkdom, zijn geobsedeerd met zichzelf, haten de media, hebben lak aan wetten en instituties en liegen er vrolijk op los."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad4bb915-0617-4105-9b39-8aef48e0fef4",
                        "source_entry_id": "e55c861b-9380-3732-b63c-c3eca7a4b667",
                        "source_sense_id": "cb2ce184-d7ba-3054-9043-f9de2529025b",
                        "target_lang_word": "institution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "institution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07216993-d544-3180-ac47-695429960ce4",
                                        "entry_id": "04ff358b-1da1-32a3-a1c1-71873e03312a",
                                        "glosses": [
                                            "Action par laquelle on institue, on établit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d36b0c-7141-47c2-ab22-16e2a0491af1",
                                                "sense_id": "07216993-d544-3180-ac47-695429960ce4",
                                                "text": "L’institution d’un ordre religieux."
                                            },
                                            {
                                                "example_id": "2542cfcc-0599-465f-bddf-c7f6f23592b1",
                                                "sense_id": "07216993-d544-3180-ac47-695429960ce4",
                                                "text": "L’institution des cours d’appel."
                                            },
                                            {
                                                "example_id": "417685de-25e3-4de5-8d9f-95232521ebdf",
                                                "sense_id": "07216993-d544-3180-ac47-695429960ce4",
                                                "text": "L’institution des Jeux olympiques."
                                            },
                                            {
                                                "example_id": "c7ad86bb-8b74-4895-abd3-9c8309af97db",
                                                "sense_id": "07216993-d544-3180-ac47-695429960ce4",
                                                "text": "Tout ce qui est d’institution humaine est sujet au changement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a40a3a3-6e8b-3cdd-b38d-efea893241d4",
                                        "entry_id": "04ff358b-1da1-32a3-a1c1-71873e03312a",
                                        "glosses": [
                                            "La chose instituée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754dc6fd-4791-4961-85d0-a6873394ea83",
                                                "sense_id": "7a40a3a3-6e8b-3cdd-b38d-efea893241d4",
                                                "text": "À Sparte, le vol était pratiqué et honoré : c’était une institution hiératique, un complément indispensable à l’éducation de tout Lacédémonien sérieux."
                                            },
                                            {
                                                "example_id": "70fd1546-1cda-4f4d-87ed-8349bd18d5c0",
                                                "sense_id": "7a40a3a3-6e8b-3cdd-b38d-efea893241d4",
                                                "text": "En France nous sommes traditionnels. […]. C'est l'extérieur des institutions, et non leur essence, qui possède chez nous le privilège de l'inviolabilité."
                                            },
                                            {
                                                "example_id": "63b1890c-244f-4b27-b77d-54eb0b755953",
                                                "sense_id": "7a40a3a3-6e8b-3cdd-b38d-efea893241d4",
                                                "text": "D’une manière générale, on peut poser en principe que les institutions matrimoniales et familiales, toujours établies en vue de favoriser la conservation de la forme sociale du moment, ont surtout un point de départ économique."
                                            },
                                            {
                                                "example_id": "0cd1b360-d5c7-463e-81fe-4cfbddfc0e7d",
                                                "sense_id": "7a40a3a3-6e8b-3cdd-b38d-efea893241d4",
                                                "text": "Le tatouage, en effet, est une institution dans la marine américaine et des heures de service sont spécialement réservées à ce divertissement artistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f31dfb69-5882-3357-a990-d59b8235923c",
                                        "entry_id": "04ff358b-1da1-32a3-a1c1-71873e03312a",
                                        "glosses": [
                                            "Organisation, organisme ou gouvernement, qui organise cette chose instituée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e4d48a-e3b6-4a74-9f64-573ca143e565",
                                                "sense_id": "f31dfb69-5882-3357-a990-d59b8235923c",
                                                "text": "Il faudrait, en premier lieu, répandre parmi nous, par le perfectionnement des institutions de crédit, l'usage des billets, des promesses, des reconnaissances."
                                            },
                                            {
                                                "example_id": "431fd01f-5477-4b1e-b02c-804df34e2f71",
                                                "sense_id": "f31dfb69-5882-3357-a990-d59b8235923c",
                                                "text": "Protégées par le prestige des guerres de la Liberté, les institutions nouvelles étaient devenues intangibles […]."
                                            },
                                            {
                                                "example_id": "561949f0-d2c0-490d-8694-34501a8af149",
                                                "sense_id": "f31dfb69-5882-3357-a990-d59b8235923c",
                                                "text": "[…] ils n'ignorent rien de tout cela et savent notamment fort bien que c'est en l’affirmant qu'ils créeront cette éternité de barbarie nécessaire au maintien des institutions qui leur sont chères."
                                            },
                                            {
                                                "example_id": "fddd5ce6-7785-4fd8-b5a1-3b3485cfc082",
                                                "sense_id": "f31dfb69-5882-3357-a990-d59b8235923c",
                                                "text": "Un des aspects courants de la sottise humaine est cette croyance, que l'on découvre chez tant d'honnêtes imprévoyants, que tout durera, à peu de chose près, comme nous voyons les institutions et les choses aujourd'hui."
                                            },
                                            {
                                                "example_id": "ceb2fe67-0f5b-46af-b49b-1e3f853d0af3",
                                                "sense_id": "f31dfb69-5882-3357-a990-d59b8235923c",
                                                "text": "Toutefois, les cités islamiques n'avaient jamais créé d'’institutions autonomes, pas plus qu'elles n'avaient pris de mesures de défense comparables à celles des ligues lombardes ou hanséatiques."
                                            },
                                            {
                                                "example_id": "aeb97b2a-644e-47c8-8f79-7c509368e827",
                                                "sense_id": "f31dfb69-5882-3357-a990-d59b8235923c",
                                                "text": "La prévalence de l'incontinence fécale en institution gériatrique était de 33 à 54 % selon la durée de l'étude."
                                            },
                                            {
                                                "example_id": "f85293e9-38b6-4e73-bd28-56ad36117307",
                                                "sense_id": "f31dfb69-5882-3357-a990-d59b8235923c",
                                                "text": "C'est au Procope, vénérable institution sise près du carrefour de l'Odéon, que sont apparus les premiers garçons de café, à partir de 1686."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7393a017-1ce8-326e-8182-a7bdd4985d84",
                                        "entry_id": "04ff358b-1da1-32a3-a1c1-71873e03312a",
                                        "glosses": [
                                            "École ; maison d’éducation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17835104-ea38-45ca-a76c-5d9b68278a99",
                                                "sense_id": "7393a017-1ce8-326e-8182-a7bdd4985d84",
                                                "text": "Il n’existe au Pérou aucune institution pour l’éducation de l’un ou de l’autre sexe ; l’intelligence ne s’y développe que par les forces natives."
                                            },
                                            {
                                                "example_id": "0034c6f6-68bc-4c4a-80ed-59792004eaa1",
                                                "sense_id": "7393a017-1ce8-326e-8182-a7bdd4985d84",
                                                "text": "Je finissais mes études chez un marchand de soupe, d’une grande ville du centre, à l’institution Robineau, célèbre dans toute la province par la force des études latines qu’on y faisait."
                                            },
                                            {
                                                "example_id": "427e99f3-8750-442d-a703-716f7ef6e507",
                                                "sense_id": "7393a017-1ce8-326e-8182-a7bdd4985d84",
                                                "text": "L’École Normale est une institution que les nations envient à la République : elle est une des têtes de la France qui est pourvue de chefs comme une hydre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
