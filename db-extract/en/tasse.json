                "senses": [
                    {
                        "sense_id": "56213fa0-cffd-39d5-a1bc-6b737b7303df",
                        "entry_id": "2031d447-e4f5-3ba4-8e76-d5bcabfb0a5a",
                        "glosses": [
                            "A piece of armor for the hips and thighs: one of a set of plates (each being of one piece or segmented) hanging from the bottom of the breastplate or from faulds."
                        ],
                        "tags": [
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5b87d1af-bad7-4097-ae38-40d029d5d792",
                                "sense_id": "56213fa0-cffd-39d5-a1bc-6b737b7303df",
                                "text": "This included the head-piece and gorgett, the back and breast, with skirts of iron called tasses or tassets covering the thighs, as may be seen in the figures, representing the exercise of the pike, published anno 1622, by the title of the Military Art of Training; the same kind of armour was worn by the harquebusiers."
                            },
                            {
                                "example_id": "60cde33f-d861-453d-a5f9-6e201c1acf15",
                                "sense_id": "56213fa0-cffd-39d5-a1bc-6b737b7303df",
                                "text": "The tasse, meant only to cover the hips, was so long that its edges scraped against the floor."
                            }
                        ]
                    }
                ],
