            "senses": [
                {
                    "sense_id": "f50b9e2d-66df-3eb3-b477-3b9e55490225",
                    "sense_definition": "causing annoyance, irritation, or worry",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "annoying_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a <w>bothering</w> experience with him yesterday, but fortunately nothing came of it.",
                            "target_lang_translations": {
                                "ru": "Вчера у меня был <w>неприятный</w> опыт общения с ним, но, к счастью, это ни к чему не привело."
                            }
                        },
                        {
                            "text": "The <w>bothering</w> noise from the construction site made it impossible to concentrate.",
                            "target_lang_translations": {
                                "ru": "<w>Раздражающий</w> шум со стройки мешал сосредоточиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoying",
                        "irritating",
                        "troublesome",
                        "disturbing"
                    ],
                    "antonyms": [
                        "pleasant",
                        "comforting"
                    ],
                    "common_phrases": [
                        "bothering experience",
                        "bothering thought",
                        "bothering noise"
                    ],
                    "target_lang_definitions": {
