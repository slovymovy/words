                                "target_senses": [
                                    {
                                        "sense_id": "1ec552f6-217f-32de-b4a7-2e2c1ff3a12d",
                                        "entry_id": "095236b7-899f-3501-8d8c-f12894ad3276",
                                        "glosses": [
                                            "Gâteau au chocolat composé de deux disques séparés par une couche de confiture d’abricots, et couvert d’un glaçage au chocolat noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3543cef-3521-4886-9970-0aaea2a85c62",
                                                "sense_id": "1ec552f6-217f-32de-b4a7-2e2c1ff3a12d",
                                                "text": "— Que je suis heureuse de vous accueillir ! Je vous attendais. J’ai préparé une tarte Sacher pour vous régaler tous."
                                            },
                                            {
                                                "example_id": "eb208d3b-fa3a-4ef0-9914-beeb22ef995a",
                                                "sense_id": "1ec552f6-217f-32de-b4a7-2e2c1ff3a12d",
                                                "text": "Vers 22 heures 45, la tarte Sacher qui clôturait les agapes consommée et le champagne final entamé, elle n’avait pas encore appris à ses trois adjoints directs, ni à moi, son patron, qu’elle partirait le lendemain."
                                            },
                                            {
                                                "example_id": "5f9b17b2-a687-467f-99af-f9dcedd94ed9",
                                                "sense_id": "1ec552f6-217f-32de-b4a7-2e2c1ff3a12d",
                                                "text": "Il y eut, en effet, une véritable guerre de palais entre la tarte Sacher de l’hôtel Sacher et la même tarte proposée par le café Demel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
