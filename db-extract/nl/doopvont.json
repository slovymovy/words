                        "sense_id": "fd213beb-5543-3f01-a0cd-0ad883cc6796",
                        "entry_id": "4b90b61a-bc69-37b8-bf8d-413908a008b4",
                        "glosses": [
                            "bekken voor de bediening van de doop en het bewaren van het doopwater in een kerkgebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63117aab-26fe-435e-aab0-ffe36cc04b2a",
                                "sense_id": "fd213beb-5543-3f01-a0cd-0ad883cc6796",
                                "text": "Het doopvont wordt gebruikt bij de bediening van het sacrament van de Heilige Doop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f869904-3154-4501-b813-41f512156573",
                        "source_entry_id": "4b90b61a-bc69-37b8-bf8d-413908a008b4",
                        "source_sense_id": "fd213beb-5543-3f01-a0cd-0ad883cc6796",
                        "source_sense_description": "een bekken voor de bediening van de doop en het bewaren van het doopwater in een kerkgebouw",
                        "target_lang_word": "Taufbecken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taufbecken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa14986-4495-3761-9de6-22a5cf607b64",
                                        "entry_id": "3d24b8aa-b69c-3017-8b73-1ba2a654efe6",
                                        "glosses": [
                                            "Behältnis, das in christlichen Kirchen der Taufe dient und mit geweihtem Wasser gefüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e29d04-4ceb-4cb3-b37d-25b4bf233e0b",
                                                "sense_id": "5fa14986-4495-3761-9de6-22a5cf607b64",
                                                "text": "Bei einer Taufe wird das Kind über das Taufbecken gehalten und mit Wasser benetzt."
                                            },
                                            {
                                                "example_id": "e52c5143-f944-4c98-be61-c7ab83aff553",
                                                "sense_id": "5fa14986-4495-3761-9de6-22a5cf607b64",
                                                "text": "„In Äthiopien ist es Brauch, den Täufling mit dem ganzen Körper ins Taufbecken zu tauchen.“"
                                            },
                                            {
                                                "example_id": "9e2261ec-a25f-4824-be45-65975fa36e42",
                                                "sense_id": "5fa14986-4495-3761-9de6-22a5cf607b64",
                                                "text": "„Der Grossvater, der Patenstelle an dem Kinde übernommen hatte, fürchtete, den Kleinen fallen zu lassen und trug ihn zitternd um das ausgebeulte blecherne Taufbecken herum, um ihn dann Prinzessin Marja als der Patin zu übergeben.“"
                                            },
                                            {
                                                "example_id": "6145f7c3-4713-4269-80d7-422d3a2edc21",
                                                "sense_id": "5fa14986-4495-3761-9de6-22a5cf607b64",
                                                "text": "„Indessen könne man in Chavignolles noch solche entdecken; so läge dort im Gäßchen an der Friedhofsmauer ein Taufbecken seit undenkbaren Zeiten unter dem Gras vergraben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
