                                    },
                                    {
                                        "sense_id": "0b85fc79-572f-3c88-ad80-fbb4527725d9",
                                        "entry_id": "2564384b-70cc-393e-94ee-0e9eaaf7e7d3",
                                        "glosses": [
                                            "A form of retaining wall used to support foundations or an embankment"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "537d6333-f550-307d-a66f-3174e1c1d780",
                                        "entry_id": "2564384b-70cc-393e-94ee-0e9eaaf7e7d3",
                                        "glosses": [
                                            "A form of lagging, in particular for boilers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcca0a4f-0b6f-40f3-8b40-0748c78b1cea",
                                                "sense_id": "537d6333-f550-307d-a66f-3174e1c1d780",
                                                "text": "Spun glass mattresses are used for lagging the boiler, which has three Ross pop safety valves on the front ring."
                                            },
                                            {
                                                "example_id": "2d7cd1cf-877e-467b-9f3e-b0a5166966e7",
                                                "sense_id": "537d6333-f550-307d-a66f-3174e1c1d780",
                                                "text": "The boiler and firebox are lagged with a lightweight Fibreglass mattress."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mattress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a55fe5fc-6caa-3740-9aa0-fa1924bdd4e9",
                                        "entry_id": "bd99d0b6-a626-3134-a2ad-0c42212aa4a3",
                                        "glosses": [
                                            "To cover with a thick layer, like a mattress; to blanket."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6106c24-78e6-48b2-9896-bb60567fdaf1",
                                                "sense_id": "a55fe5fc-6caa-3740-9aa0-fa1924bdd4e9",
                                                "text": "A comfortable litter of pine needles had mattressed the ground and spreading branches had been a canopy overhead."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ad141c9-adb3-48ea-93d1-8c61e524aabd",
                        "source_entry_id": "38ba417c-5883-3d7b-bef8-878099740e12",
                        "source_sense_description": "подстилка",
                        "target_lang_word": "Matratze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Matratze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d97da45-de4b-3f6b-849f-2bd156f4c965",
                                        "entry_id": "ede1bbf8-fe2d-3164-b7b9-98a96610a72d",
                                        "glosses": [
                                            "mit Rosshaar, Seegras oder Ähnlichem gefülltes oder aus Schaumstoff bestehendes Polster, das mit Stoff überzogen ist und das man meist auf Lattenroste oder Unterfederungen legt, um ein komfortables Liegen und Schlafen zu ermöglichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a152f447-fb08-4aa2-b75f-7c58fae1a6e3",
                                                "sense_id": "5d97da45-de4b-3f6b-849f-2bd156f4c965",
                                                "text": "Bei den meisten Hotelbetten sind mir die Matratzen zu weich."
                                            },
                                            {
                                                "example_id": "0a9bee77-986c-41ff-809b-d202b2d963ea",
                                                "sense_id": "5d97da45-de4b-3f6b-849f-2bd156f4c965",
                                                "text": "Meine Oma versteckte ihr Bargeld immer unter der Matratze."
                                            },
                                            {
                                                "example_id": "b8da87ed-a86e-484b-aa71-c468a9c4b6c6",
                                                "sense_id": "5d97da45-de4b-3f6b-849f-2bd156f4c965",
                                                "text": "„Und die Krönung: Das Paket, in dem das alles verpackt ist und geliefert wird, ist gleichzeitig ein Kinderbett mit Matratze und Bettbezug.“"
                                            },
                                            {
                                                "example_id": "18ce5059-b29a-4a0f-a73f-164b1d1c656c",
                                                "sense_id": "5d97da45-de4b-3f6b-849f-2bd156f4c965",
                                                "text": "„Ich liege auf der Matratze, mit Kopfkissen und Pelzdecke versorgt, unterm Teppichdach des Leiterwagens.“"
                                            },
                                            {
                                                "example_id": "7d63e012-0bda-45b9-90dd-3677c42c507a",
                                                "sense_id": "5d97da45-de4b-3f6b-849f-2bd156f4c965",
                                                "text": "„In der Kammer, die ich betrat, waren nur ein Tisch, ein Stuhl, ein kleiner Spiegel und ein Bett mit zusammengerollter Matratze, so daß nur deren Unterseite zu sehen war.“"
                                            },
                                            {
                                                "example_id": "91f2a724-7a98-41b3-8c6c-b21d2e9ce22b",
                                                "sense_id": "5d97da45-de4b-3f6b-849f-2bd156f4c965",
                                                "text": "„Eine Anzahl von eisernen Bettgestellen – sieben zählte er im schnellen Überblick – standen mit unbezogenen Matratzen herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d08734e6-53db-35aa-8c49-61e98e3105e6",
                                        "entry_id": "ede1bbf8-fe2d-3164-b7b9-98a96610a72d",
                                        "glosses": [
                                            "Kurzform von Sprungfedermatratze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ba8f8d-5f27-4c1e-ab4f-6baf1e9b5b9a",
                                                "sense_id": "d08734e6-53db-35aa-8c49-61e98e3105e6",
                                                "text": "„Jetzt wurde die Matratze untersucht und gefunden, daß auf den Federn nur eine dünne, lockere Schicht Haare liege, die ganze dicke Matratze, wie man ganz offen sehen konnte und wie es bei allen derartigen Polstern der Fall ist, ein hohler Raum sei.“"
                                            },
                                            {
                                                "example_id": "8bc591b7-9989-4f28-aa2c-8b7921e219b9",
                                                "sense_id": "d08734e6-53db-35aa-8c49-61e98e3105e6",
                                                "text": "Die Federn der Matratze quietschten bei jeder Bewegung des Schlafenden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1913d5ad-732a-391c-b937-a0cb83c741fa",
                                        "entry_id": "ede1bbf8-fe2d-3164-b7b9-98a96610a72d",
                                        "glosses": [
                                            "Polster, das als Auflage auf eine Sprungfedermatratze gelegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8b6e84a-fc04-446f-9680-a036a739efb3",
                                                "sense_id": "1913d5ad-732a-391c-b937-a0cb83c741fa",
                                                "text": "„Sprungfedermatratzen sind zweckmäßig und angenehm im Sommer ohne andere Auflage, im Winter aber nur bei Auslegung von dichten Matratzen oder Federbetten zu gebrauchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5da01e77-78d4-32d3-a173-01dc3868f8f9",
                                        "entry_id": "ede1bbf8-fe2d-3164-b7b9-98a96610a72d",
                                        "glosses": [
                                            "Kurzform von Luftmatratze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f22371-b44b-48be-98af-075bde7c93a6",
                                                "sense_id": "5da01e77-78d4-32d3-a173-01dc3868f8f9",
                                                "text": "Im Zelt schliefen sie auf Matratzen."
                                            },
                                            {
                                                "example_id": "cd3e2cf6-9c84-4684-b6b5-72924b87ae7e",
                                                "sense_id": "5da01e77-78d4-32d3-a173-01dc3868f8f9",
                                                "text": "Hol mal die Matratze aus dem Pool."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b6e4200b-8a11-39ec-bd05-47156b155e50",
                                        "entry_id": "ede1bbf8-fe2d-3164-b7b9-98a96610a72d",
                                        "glosses": [
                                            "üppiger Vollbart"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9d230fc-5cdd-46a7-9f9a-2804504683fe",
                                                "sense_id": "b6e4200b-8a11-39ec-bd05-47156b155e50",
                                                "text": "Dein Bart lässt dich sehr ungepflegt aussehen. Du solltest die Matratze endlich abrasieren."
                                            },
                                            {
                                                "example_id": "0b88171d-9e94-4161-b52f-afa0eb923c7d",
                                                "sense_id": "b6e4200b-8a11-39ec-bd05-47156b155e50",
                                                "text": "„»Der Kerl hatte gestern noch soo'ne Matratze im Gesicht.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
