                "senses": [
                    {
                        "sense_id": "ee50767d-1808-3d06-aa6f-558b716a8982",
                        "entry_id": "98ced269-722c-3b5a-9567-c6b0f04ef300",
                        "glosses": [
                            "Erlaubnis, die bei bestimmten Waren benötigt wird, um sie einführen zu dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29226c43-8f32-4358-bb5c-d4acad01d03f",
                                "sense_id": "ee50767d-1808-3d06-aa6f-558b716a8982",
                                "text": "„Für Einfuhrwaren ist eine Einfuhrgenehmigung dann erforderlich, wenn dies in einem Rechtsakt der Europäischen Union vorgesehen ist.“"
                            },
                            {
                                "example_id": "eb11450a-2e93-4eea-88dd-123adc687e32",
                                "sense_id": "ee50767d-1808-3d06-aa6f-558b716a8982",
                                "text": "„Der US-amerikanische Elektroauto-Hersteller Tesla Motors will sein Luxusmodell S in China auf den Markt bringen. Bisher stehe noch die Einfuhrgenehmigung der Behörden aus, sagte Tesla-Manager Jerome Guillen der englischsprachigen Tageszeitung China Daily.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
