                    }
                ],
                "senses": [
                    {
                        "sense_id": "7793f37e-49bf-3772-81c2-9f54f04f0b05",
                        "entry_id": "f3b67da2-2062-35ae-85c2-41255d348e12",
                        "glosses": [
                            "Qui tanne ; qui sert à tanner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bcf6664-79f8-436f-a977-6dfbeb15dd19",
                                "sense_id": "7793f37e-49bf-3772-81c2-9f54f04f0b05",
                                "text": "Le sumac s'emploie dans la proportion de 2 à 3 livres, selon son plus ou moins de force tannante, par chaque peau à coudrer."
                            },
                            {
                                "example_id": "2d8092f6-bcc5-4b60-a12c-f3ff40e3a2e2",
                                "sense_id": "7793f37e-49bf-3772-81c2-9f54f04f0b05",
                                "text": "L’emploi des substances tannantes a précisément pour objet d’empêcher l’accolement des fibres, de ménager leur indépendance, de leur permettre de glisser les unes sur les autres ; il rend en outre le cuir imputrescible."
                            }
                        ]
                    },
                    {
                        "sense_id": "a708d486-dbe1-3a7d-89db-146a97d84d2a",
                        "entry_id": "f3b67da2-2062-35ae-85c2-41255d348e12",
                        "glosses": [
                            "Se dit d’un produit qu’on applique sur les coussinets très sollicités des chiens de travail ou des chiens sportifs qui augmente l’épaisseur de la couche cornée et renforce ainsi la solidité des coussinets pour éviter les blessures."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "62dda3a1-6227-3fae-8822-6082aeba5702",
                        "entry_id": "f3b67da2-2062-35ae-85c2-41255d348e12",
                        "glosses": [
                            "Ennuyeux, fatigant"
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "222ac3df-4865-4227-9166-6347782a214b",
                                "sense_id": "62dda3a1-6227-3fae-8822-6082aeba5702",
                                "text": "— M. Bradamanti n’est pas encore rentré.\n— C’est insupportable !\n— Hein ! est-ce tannant, ma pauvre madame Séraphin !"
                            },
                            {
                                "example_id": "3027d42d-f7ae-433f-8e09-68914a65abe3",
                                "sense_id": "62dda3a1-6227-3fae-8822-6082aeba5702",
                                "text": "Vous pouvez être tranquille que c’est jamais une fille comme vous que j’épouserai, rétorqua-t-il. Je plains le gars qui vous aura comme épouse. Ce que vous serez tannante."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b6669be-e4dc-3639-8342-59cc74d6025f",
                        "entry_id": "f3b67da2-2062-35ae-85c2-41255d348e12",
                        "glosses": [
                            "Qui ne tient pas en place, dérange, généralement en parlant d’un enfant."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "30e29e54-2969-4214-8ad0-fe5f48076af7",
                                "sense_id": "7b6669be-e4dc-3639-8342-59cc74d6025f",
                                "text": "Un couple d’adolescents qui s’aiment follement, une danseuse de ballet, un élève du primaire pas mal tannant, deux chums qui vont pêcher et un groupe de personnes âgées qui font de la danse en ligne."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7d54fb3d-4a1a-3703-86b0-0025cae4ec8e",
                "word": "tannant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ea1b7590-d18b-4051-9754-369ba0a1049f",
