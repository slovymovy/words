                ],
                "senses": [
                    {
                        "sense_id": "4c2638b0-819b-33ee-a2ce-569166ba9a17",
                        "entry_id": "f989e6b6-7a0e-362b-8308-ab14ac6f6324",
                        "glosses": [
                            "Gesamtheit festgelegter Lerninhalte und -ziele, die in einem Gymnasium vermitteln werden und für einen bestimmten Zeitraum zu erreichen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4963fa6a-2a5e-42ef-b775-0d572a1586a5",
                                "sense_id": "4c2638b0-819b-33ee-a2ce-569166ba9a17",
                                "text": "„Stroh ist ehrlich genug anzuerkennen, welch extremes Übergewicht Latein (und Griechisch) im damaligen Gymnasialcurriculum hatten.“"
                            },
                            {
                                "example_id": "df7be268-736b-44f4-8899-bec790e9b8f7",
                                "sense_id": "4c2638b0-819b-33ee-a2ce-569166ba9a17",
                                "text": "„Es fällt aber auf, daß bei dem Gymnasialcurriculum und dem Hochschulcurriculum sich große Parallen ergeben.“"
                            },
                            {
                                "example_id": "31fb1964-f502-49b5-9624-a845d1c4fd4d",
                                "sense_id": "4c2638b0-819b-33ee-a2ce-569166ba9a17",
                                "text": "„Der unüberbrückbare Abstand zwischen vielen Arbeitereltern und einem Gymnasialcurriculum für ihre Kinder prägt sich in der Ansicht aus, das Sicherste bleibe allemal, frühzeitig Geld zu verdienen, dann habe man etwas in der Hand.“"
                            },
                            {
                                "example_id": "f4563951-bd30-4411-b568-3152481c890b",
                                "sense_id": "4c2638b0-819b-33ee-a2ce-569166ba9a17",
                                "text": "„In der Sekundarstufe II, der reformierten Oberstufe, hängt das Gymnasialcurriculum zu einem beträchtlichen Teil von den Willensentscheidungen der Schüler ab; die Lerninhalte wurden individuell verfügbar gemacht.“"
                            },
                            {
                                "example_id": "9e1a6b49-3b2c-49e9-a248-3f7194c68851",
                                "sense_id": "4c2638b0-819b-33ee-a2ce-569166ba9a17",
                                "text": "„Erwähnenswert ist auch, dass gerade in den Gymnasialcurricula (und nur da) die patriotischen, bürgerlichen Pflichten der Schule kaum erwähnt werden […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
