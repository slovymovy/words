                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Heist</w> at the conference.",
                            "target_lang_translations": {
                                "de": "Ich habe auf der Konferenz einen Mann namens Herrn <w>Heist</w> getroffen."
                            }
                        }
                    ],
                    "traits": [
