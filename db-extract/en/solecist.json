                "senses": [
                    {
                        "sense_id": "01fac716-1c4e-3be3-b9b7-b564dabedc0b",
                        "entry_id": "ae2aea87-f3fd-3d47-a583-4bf1a7508db1",
                        "glosses": [
                            "One who commits a solecism."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c361c98f-7b87-4d74-9d6c-6d402895af47",
                                "sense_id": "01fac716-1c4e-3be3-b9b7-b564dabedc0b",
                                "text": "Shall a noble writer, and an inspired noble writer, be called a solecist, and barbarian, for giving a new turn to a word so agreeable to the analogy and genius of the Greek tongue?"
                            },
                            {
                                "example_id": "a3457218-1804-4199-b59b-ea1e30ff4bb6",
                                "sense_id": "01fac716-1c4e-3be3-b9b7-b564dabedc0b",
                                "text": "Let me, therefore, urge you, if you ever feel condemned by such yielding, to become a solecist and wilfully and determinately break those laws of society that your conscience can not approve."
                            },
                            {
                                "example_id": "d627a0c1-c798-4c18-bfd8-9e2a8e98007c",
                                "sense_id": "01fac716-1c4e-3be3-b9b7-b564dabedc0b",
                                "text": "Too often is the college graduate a solecist through her ignorance of the customs and usages of that class whose life is made up of the minutiae of politeness."
                            }
                        ]
                    }
                ],
