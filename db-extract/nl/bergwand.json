                    {
                        "sense_id": "7e8154e5-ffbb-3ef1-9269-881e51e6e1fb",
                        "entry_id": "a1969bd9-4f69-3745-b37c-251e1945c436",
                        "glosses": [
                            "de steile zijkant van een berg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c9cfbc3-8110-4263-a1a7-c9184b25b9f7",
                                "sense_id": "7e8154e5-ffbb-3ef1-9269-881e51e6e1fb",
                                "text": "In het licht van mijn hoofdlamp zag ik een hele nieuwe dierenwereld: talloze kleine schorpioenen, duizendpoten en nachtvlinders renden en vlogen voor me uit en motachtige insecten cirkelden om mijn hoofd. Behoorlijk enerverend, zo in het donker over het smalle paadje langs de steile bergwand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fef8de0-099f-40d8-966b-d43d37c8a6a9",
                        "source_entry_id": "a1969bd9-4f69-3745-b37c-251e1945c436",
                        "source_sense_id": "7e8154e5-ffbb-3ef1-9269-881e51e6e1fb",
                        "source_sense_description": "de steile zijkant van een berg",
                        "target_lang_word": "Bergwand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bergwand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36836ff7-1030-35eb-a303-22cf44590f3e",
                                        "entry_id": "820a63e7-297b-3d18-ad01-583273afaffd",
                                        "glosses": [
                                            "steil aufragender, großflächiger Rand eines Berges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5665e794-ef37-4c6e-b630-317355fa7b4f",
                                                "sense_id": "36836ff7-1030-35eb-a303-22cf44590f3e",
                                                "text": "„Wir kommen durch Kalkberge, der Weg ist in die Bergwand hineingeschnitten, er ist überdacht, und es fehlt ihm bloß die eine Wand nach dem Terek zu, dann wäre es ein Tunnel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b5d8cb7-5e68-4314-9ce3-d264c0556ad5",
                        "source_entry_id": "a1969bd9-4f69-3745-b37c-251e1945c436",
                        "source_sense_id": "7e8154e5-ffbb-3ef1-9269-881e51e6e1fb",
                        "source_sense_description": "de steile zijkant van een berg",
                        "target_lang_word": "Felswand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Felswand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                        "entry_id": "1b9656d1-d814-3130-94ff-947ce6d42e83",
                                        "glosses": [
                                            "steil aufragender, großflächiger Fels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1ee647-1fb0-4209-bde5-13a696c52059",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "Am Ende des Tals erhob sich eine unüberwindliche Felswand."
                                            },
                                            {
                                                "example_id": "099d4610-3d3d-469c-98c8-861657ade690",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„Sie standen aufrecht und wie erstarrt an der Felswand, ihre Finger klammerten sich in die Risse, und ihre Beine waren ohne Kraft.“"
                                            },
                                            {
                                                "example_id": "360a0a13-e34c-41ee-b02e-7a9afe382bd6",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„Freunde und Profis des Klettersports haben eine neue Möglichkeit, in Berlin an künstlichen Felswänden zu trainieren.“"
                                            },
                                            {
                                                "example_id": "add22e89-2f45-4ce8-9394-988bdf950b9d",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„Erst am Ende des Tertiärs und insbesondere im Quartär hat sich die Ahr tiefer in das Rumpfgebirge eingeschnitten und auf diese Weise Felswände wie die Engelsley freigelegt.“"
                                            },
                                            {
                                                "example_id": "39f9ddd5-7822-46df-a903-1b27952d53a3",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„In diesem Moment ging von oben aus der Felswand ein Geschoßhagel auf uns nieder.“"
                                            },
                                            {
                                                "example_id": "b168bd06-ac7a-45ab-b609-1958a8826e55",
                                                "sense_id": "c16838ef-c8a8-3cb7-bf8b-7817da649edd",
                                                "text": "„Aber das Geläut der Kuhglocken wurde überdröhnt vom Lärm der Musikboxen und der Motorräder ohne Auspufftöpfe, deren Geknatter wie Maschinengewehrgarben von den Felswänden widerhallte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daa0a3fe-7f52-45e4-833c-132c2a3587fa",
