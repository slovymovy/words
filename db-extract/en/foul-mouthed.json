                                        "sense_id": "df0792ca-cf48-3347-a716-a5d9eab74446",
                                        "entry_id": "3e272012-43ed-3db4-8d27-9048708851af",
                                        "glosses": [
                                            "so, dass es nicht den üblichen Regeln des guten Benehmens oder Anstandes entspricht"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b5855d1-37b2-452b-a598-edd52113b997",
                                                "sense_id": "df0792ca-cf48-3347-a716-a5d9eab74446",
                                                "text": "Sie gab die unflätigsten Wörter von sich."
                                            },
                                            {
                                                "example_id": "80121da1-5a05-43cf-b58e-eba77786973a",
                                                "sense_id": "df0792ca-cf48-3347-a716-a5d9eab74446",
                                                "text": "„Da er nicht bigott sein wollte, war er anstößig; um seine Zuhörer zum Lachen zu bringen, erzählte er die unflätigsten Zoten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
