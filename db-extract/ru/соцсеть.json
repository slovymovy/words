                            "locative"
                        ],
                        "form": "соцсети́"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "993b6b71-1147-39c0-bc60-3cbfb1cb0928",
                        "entry_id": "1a2d88dd-7af7-37c6-b8ed-29809fde57c4",
                        "glosses": [
                            "сокр. от социальная сеть (специальный веб-сайт)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ba38d1-58bc-4acd-a1d2-7fcc687a182d",
                                "sense_id": "993b6b71-1147-39c0-bc60-3cbfb1cb0928",
                                "text": "Читателям же, как показывает статистика, неважно, что лайкать или постить в соцсетях — рекламный контент или редакционный; главное, чтобы он был интересным."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14201c35-4492-4de3-b8f7-56e2eddce011",
                        "source_entry_id": "1a2d88dd-7af7-37c6-b8ed-29809fde57c4",
                        "source_sense_id": "993b6b71-1147-39c0-bc60-3cbfb1cb0928",
                        "target_lang_word": "social network",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "social network",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcf9c06d-b67f-3da8-8a75-e9c3087f6927",
                                        "entry_id": "c549724f-7663-3eb0-9452-41d10bea9e14",
                                        "glosses": [
                                            "A network of personal or business contacts, especially as facilitated by social networking on the Internet."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800e4992-57bd-4176-b957-92da4090d7b1",
                                                "sense_id": "fcf9c06d-b67f-3da8-8a75-e9c3087f6927",
                                                "text": "The social network of interest in this volume is the personal social network that is centered on a particular child. Definitions of social network draw attention to the ties or linkages that connect individuals (and sometimes groups or institutions)—linkages that can be conduits for diverse resources."
                                            },
                                            {
                                                "example_id": "e634dfc9-b240-421d-854f-fc9a74126448",
                                                "sense_id": "fcf9c06d-b67f-3da8-8a75-e9c3087f6927",
                                                "text": "Civicizing public spaces is an antidote to marginalization and exclusion, and it requires that we restore linkages between municipalities, social networks, cultural institutions and communities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd2a66b-67bc-3493-bd13-277081100e6d",
                                        "entry_id": "c549724f-7663-3eb0-9452-41d10bea9e14",
                                        "glosses": [
                                            "A service allowing users to manage and interact with their network of friends or contacts on the Internet. (Called a social network application in precise usage that reserves social network to its original sense.)"
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "101a7e40-6db0-43c6-b8fe-9bf90d0d7e51",
                                                "sense_id": "1dd2a66b-67bc-3493-bd13-277081100e6d",
                                                "text": "The trends in recent years have focussed on online social networks, in which the social network is enabled as an internet application. Some examples of such networks are Facebook, LinkedIn and MySpace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc0b116a-feba-4eb6-bcfb-289d36eedc18",
                        "source_entry_id": "1a2d88dd-7af7-37c6-b8ed-29809fde57c4",
                        "source_sense_id": "993b6b71-1147-39c0-bc60-3cbfb1cb0928",
                        "target_lang_word": "réseaux sociaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réseaux sociaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e7e413f-234b-3795-a0f9-37a25f590664",
                                        "entry_id": "9301d332-40ab-3ca1-8ecd-5c219b70f01e",
                                        "glosses": [
                                            "Pluriel de réseau social."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d2126e-4aec-4af6-b474-10aac91c3910",
                                                "sense_id": "1e7e413f-234b-3795-a0f9-37a25f590664",
                                                "text": "Il faut bien comprendre qu'un business s'organise autour des réseaux sociaux destinés à capter des flux publicitaires"
                                            },
                                            {
                                                "example_id": "522cdc1b-f50b-453a-9f5d-1da6caeaabc7",
                                                "sense_id": "1e7e413f-234b-3795-a0f9-37a25f590664",
                                                "text": "Christine Kelly, conseillère au CSA, a tenu à rappeler que le « business organisé autour de ces réseaux sociaux» avait pour but de «capter des flux publicitaires», et que de citer un réseau plutôt qu’un autre revenait à « évincer la concurrence »."
                                            },
                                            {
                                                "example_id": "6dc9b075-71f3-4acc-9f28-429ad8c4a71e",
                                                "sense_id": "1e7e413f-234b-3795-a0f9-37a25f590664",
                                                "text": "Airbnb disrupte l’hôtellerie, Uber disrupte les taxis, les réseaux sociaux disruptent les médias…"
                                            },
                                            {
                                                "example_id": "c8cc1e76-f2cc-4ae5-9daa-854346336aee",
                                                "sense_id": "1e7e413f-234b-3795-a0f9-37a25f590664",
                                                "text": "Poursuivons notre tour d'horizon de la cybercriminalité sur les réseaux sociaux avec ce qui constitue sans doute le stade ultime de la menace : la propagande cyberdjihadiste."
                                            },
                                            {
                                                "example_id": "bf2f12ed-da2b-49ce-894c-21dcea6de2b6",
                                                "sense_id": "1e7e413f-234b-3795-a0f9-37a25f590664",
                                                "text": "Se fier aux médias sociaux pour savoir ce que la majorité des Québécois pensent, c’est comme baser ta vision du Québec sur ce que tu as entendu à deux heures et demie du matin dans un bar clandestin de Saint-Eugène-de-Guigues, une fois que le vendeur de baboche est passé et que les participants du Lac-à-l’épaule annuel de l’Association des chasseurs de sasquatchs ont débarqué après avoir passé trois heures à jouer à Donjons et Dragons dans leur tente-roulotte au Camping Le P’tit Paradis avec une caisse de Wallaroo Trail et trois boîtes de Pizza Pops pepperoni bacon."
                                            },
                                            {
                                                "example_id": "6474b6d7-4deb-4aa7-a422-5692611a15e8",
                                                "sense_id": "1e7e413f-234b-3795-a0f9-37a25f590664",
                                                "text": "Quoicoubeh est un phénomène issu des réseaux sociaux qui est apparu et disparaîtra probablement rapidement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
