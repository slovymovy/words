                                        "sense_id": "5f3a9ab0-4095-326e-9ae6-3dfa79db95fa",
                                        "entry_id": "afd36c34-11b9-3099-b5e4-6c01f4dc201d",
                                        "glosses": [
                                            "hladký povrch, obvykle skleněný, z rubové strany začerněný nebo natřený reflexním materiálem, který odráží světlo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c1c41a-bf1c-45e4-afe4-1a92803f7fc2",
                                                "sense_id": "5f3a9ab0-4095-326e-9ae6-3dfa79db95fa",
                                                "text": "Zlá královna se zeptala: „Zrcadlo, zrcadlo, řekni mi, kdo je v zemi zdejší, nejhezčí a nejkrásnější?“ A to muselo s pravdou ven: „Jsi krásná má paní, však na světě i v zemi zdejší Sněhurka je ta nejkrásnější!“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a5f65c-4a5a-3d4a-8626-ae675cc48519",
                                        "entry_id": "afd36c34-11b9-3099-b5e4-6c01f4dc201d",
                                        "glosses": [
                                            "inventura zboží mezi směnami v restauraci, hospodě či baru"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4d84261-fc6e-4bf3-a3f8-56de9b21dae0",
                                                "sense_id": "08a5f65c-4a5a-3d4a-8626-ae675cc48519",
                                                "text": "zpracování předávací inventury mezi směnami (tzv. hárek nebo zrcadlo) přímo na kase"
                                            },
                                            {
                                                "example_id": "e3ce9bc3-785f-4bcc-ab4c-2333aace0faf",
                                                "sense_id": "08a5f65c-4a5a-3d4a-8626-ae675cc48519",
                                                "text": "Zrcadlo, někdy nazývané také hárek, je rychlá operativní předávací inventura mezi směnami číšníků."
                                            }
                                        ]
                                    }
                                ]
                            }
