                        "examples": [
                            {
                                "example_id": "5b7050dc-db26-4c45-9ded-b11298e8f377",
                                "sense_id": "57e22f1d-7e30-3939-aacf-dd283003367a",
                                "text": "„In der zweiten Jännerwoche hielt mildes Wetter Einzug es regnete bis in hohe Lagen hinauf, die kaum handbreit tiefe Schneedecke wurde durchnässt.“"
                            },
                            {
                                "example_id": "6d108ec7-3b6e-4a82-9505-8d0f9003dff5",
                                "sense_id": "57e22f1d-7e30-3939-aacf-dd283003367a",
                                "text": "„In den Weihnachtsferien würden die Kinder die erste Jännerwoche bei ihrer Mutter in Kärnten verbringen.“"
                            }
                        ],
