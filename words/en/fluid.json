{
    "word_family": [
        "fluidity",
        "fluidly",
        "fluidize",
        "semifluid",
        "superfluid",
        "microfluidic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1993f108-1277-30b1-a4b7-7d3eedc1d4db",
                    "sense_definition": "A liquid substance, especially one that is consumed to maintain health.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "substance_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor advised him to rest and drink plenty of <w>fluids</w>.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал ему отдыхать и пить много <w>жидкости</w>.",
                                "zh": "医生建议他多休息，并多补充<w>水分</w>。"
                            }
                        },
                        {
                            "text": "You need to replace the <w>fluids</w> you lost while exercising in the heat.",
                            "target_lang_translations": {
                                "ru": "Вам нужно восполнить потерю <w>жидкости</w> после тренировки на жаре.",
                                "zh": "你需要补充在高温下运动时流失的<w>水分</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "liquid",
                        "drink",
                        "beverage"
                    ],
                    "antonyms": [
                        "solid"
                    ],
                    "common_phrases": [
                        "drink plenty of fluids",
                        "bodily fluids",
                        "loss of fluids"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкое вещество, особенно то, которое потребляется для поддержания здоровья.",
                        "zh": "液体物质，尤指为维持健康而摄入的液体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жидкость",
                                "target_lang_sense_clarification": "вещество"
                            },
                            {
                                "target_lang_word": "питьё",
                                "target_lang_sense_clarification": "напитки, жидкая пища"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "液体",
                                "target_lang_sense_clarification": "物质状态"
                            },
                            {
                                "target_lang_word": "水分",
                                "target_lang_sense_clarification": "人体所需的液体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f16cafdd-151f-3d1b-a31e-fdbe1752205f",
                    "sense_definition": "Any substance, such as a liquid or gas, that flows easily and has no fixed shape.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substance_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Air is technically a <w>fluid</w> because it flows and changes shape.",
                            "target_lang_translations": {
                                "ru": "Воздух технически является <w>текучей средой</w>, так как он течет и меняет форму.",
                                "zh": "从技术上讲，空气是一种<w>流体</w>，因为它会流动并改变形状。"
                            }
                        },
                        {
                            "text": "The mechanic checked the level of the brake <w>fluid</w> in the car.",
                            "target_lang_translations": {
                                "ru": "Механик проверил уровень тормозной <w>жидкости</w> в машине.",
                                "zh": "技工检查了车内刹车<w>液</w>的液位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "liquid"
                    ],
                    "antonyms": [
                        "solid"
                    ],
                    "common_phrases": [
                        "brake fluid",
                        "cleaning fluid",
                        "fluid mechanics"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "physics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое вещество, такое как жидкость или газ, которое легко течет и не имеет фиксированной формы.",
                        "zh": "任何易于流动且没有固定形状的物质，如液体或气体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жидкость",
                                "target_lang_sense_clarification": "техническая (напр. тормозная)"
                            },
                            {
                                "target_lang_word": "флюид",
                                "target_lang_sense_clarification": "физический термин"
                            },
                            {
                                "target_lang_word": "текучая среда",
                                "target_lang_sense_clarification": "физика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流体",
                                "target_lang_sense_clarification": "物理学名词"
                            },
                            {
                                "target_lang_word": "液体",
                                "target_lang_sense_clarification": "工业或机械用语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "33f57396-008e-34f9-a97b-99e40055c848",
                    "sense_definition": "Having the properties of a liquid or gas; capable of flowing easily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mixture should be <w>fluid</w> enough to pour into the mold.",
                            "target_lang_translations": {
                                "ru": "Смесь должна быть достаточно <w>жидкой</w>, чтобы её можно было залить в форму.",
                                "zh": "混合物应该足够<w>液态</w>，以便倒入模具中。"
                            }
                        },
                        {
                            "text": "Lava remains <w>fluid</w> as it flows down the side of the volcano.",
                            "target_lang_translations": {
                                "ru": "Лава остается <w>текучей</w>, пока стекает по склону вулкана.",
                                "zh": "熔岩沿火山侧面流下时依然保持<w>流动</w>状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "liquid",
                        "flowing",
                        "runny"
                    ],
                    "antonyms": [
                        "solid",
                        "frozen"
                    ],
                    "common_phrases": [
                        "fluid state"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий свойствами жидкости или газа; способный легко течь.",
                        "zh": "具有液体或气体特性的；能够轻易流动的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жидкий",
                                "target_lang_sense_clarification": "консистенция"
                            },
                            {
                                "target_lang_word": "текучий",
                                "target_lang_sense_clarification": "способный течь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "液态的",
                                "target_lang_sense_clarification": "物理状态"
                            },
                            {
                                "target_lang_word": "流动的",
                                "target_lang_sense_clarification": "描述状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25c41a81-1b07-3cbb-86db-a9642422cff7",
                    "sense_definition": "Likely to change; not fixed or stable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military situation is very <w>fluid</w> and reports are changing hourly.",
                            "target_lang_translations": {
                                "ru": "Военная обстановка очень <w>нестабильна</w>, и сообщения меняются каждый час.",
                                "zh": "军事局势非常<w>多变</w>，报告每小时都在更新。"
                            }
                        },
                        {
                            "text": "Our schedule for the trip is still <w>fluid</w>, so we can make changes if needed.",
                            "target_lang_translations": {
                                "ru": "Наш график поездки всё ещё <w>гибкий</w>, поэтому мы можем внести изменения при необходимости.",
                                "zh": "我们的旅行计划仍然很<w>灵活</w>，所以如果有需要我们可以做出调整。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unstable",
                        "changeable",
                        "variable"
                    ],
                    "antonyms": [
                        "stable",
                        "fixed",
                        "static"
                    ],
                    "common_phrases": [
                        "fluid situation",
                        "fluid plans"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к изменениям; не фиксированный и не стабильный.",
                        "zh": "易变的；不固定或不稳定的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изменчивый",
                                "target_lang_sense_clarification": "непостоянный"
                            },
                            {
                                "target_lang_word": "нестабильный",
                                "target_lang_sense_clarification": "о ситуации"
                            },
                            {
                                "target_lang_word": "гибкий",
                                "target_lang_sense_clarification": "о планах или графике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多变的",
                                "target_lang_sense_clarification": "指情况"
                            },
                            {
                                "target_lang_word": "灵活的",
                                "target_lang_sense_clarification": "指计划或安排"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17dd6ac3-5ca2-3c99-bf5b-ffb52af3de0a",
                    "sense_definition": "Moving in a smooth, graceful, and easy way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer impressed the audience with her <w>fluid</w> movements.",
                            "target_lang_translations": {
                                "ru": "Танцовщица впечатлила зрителей своими <w>плавными</w> движениями.",
                                "zh": "舞者以她<w>流畅</w>的动作给观众留下了深刻印象。"
                            }
                        },
                        {
                            "text": "He has a <w>fluid</w> golf swing that looks completely effortless.",
                            "target_lang_translations": {
                                "ru": "У него <w>плавный</w> замах в гольфе, который выглядит совершенно легким.",
                                "zh": "他的高尔夫挥杆动作<w>流畅</w>，看起来毫不费力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flowing",
                        "fluent"
                    ],
                    "antonyms": [
                        "stiff",
                        "awkward"
                    ],
                    "common_phrases": [
                        "fluid motion",
                        "fluid movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся мягко, грациозно и легко.",
                        "zh": "动作平稳、优美且轻松。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плавный",
                                "target_lang_sense_clarification": "о движении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流畅的",
                                "target_lang_sense_clarification": "指动作或姿态"
                            },
                            {
                                "target_lang_word": "柔和的",
                                "target_lang_sense_clarification": "指动作的质感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fc71bd1-c125-3b48-bb8d-475abc3af740",
                    "sense_definition": "Relating to a gender identity or sexual orientation that changes over time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They identify as <w>fluid</w> rather than strictly male or female.",
                            "target_lang_translations": {
                                "ru": "Они определяют себя как <w>флюидные</w>, а не строго как мужчина или женщина.",
                                "zh": "他们认为自己的性别认同是<w>流动</w>的，而非严格的男性或女性。"
                            }
                        },
                        {
                            "text": "Modern society is becoming more accepting of <w>fluid</w> identities.",
                            "target_lang_translations": {
                                "ru": "Современное общество становится более терпимым к <w>флюидным</w> идентичностям.",
                                "zh": "现代社会正变得越来越包容<w>流动</w>的身份认同。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gender fluid",
                        "fluid identity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к гендерной идентичности или сексуальной ориентации, которые меняются со временем.",
                        "zh": "指随时间变化的性别认同或性取向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флюидный",
                                "target_lang_sense_clarification": "гендерно-флюидный"
                            },
                            {
                                "target_lang_word": "изменчивый",
                                "target_lang_sense_clarification": "непостоянный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流动的",
                                "target_lang_sense_clarification": "指性别认同"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}