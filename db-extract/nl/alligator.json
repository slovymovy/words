                                        "sense_id": "4022d9e0-c4f0-3798-82ff-9187921a4451",
                                        "entry_id": "76af5d92-8db9-3cd6-8210-ea91c42417ac",
                                        "glosses": [
                                            "Vertreter der Gattung Alligator innerhalb von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a15212f3-b95e-426a-a08f-cc14d896f433",
                                                "sense_id": "4022d9e0-c4f0-3798-82ff-9187921a4451",
                                                "text": "Die Alligatoren sind am engsten mit den Kaimanen verwandt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49bcef25-3d60-4263-a2ab-30dc33e78a6a",
                        "source_entry_id": "b9a21469-40d0-3b02-b57d-79fcb098aea1",
                        "source_sense_id": "4298e28e-e11c-3b95-8c40-893a3f9f90c1",
                        "source_sense_description": "een grote krokodilachtige uit het geslacht Alligator",
                        "target_lang_word": "alligator",
                        "target_lang_code": "en",
