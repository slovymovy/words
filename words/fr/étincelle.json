                {
                    "sense_id": "5d44db12-858d-3460-b42e-f3db585cfff5",
                    "sense_definition": "Parcelle incandescente qui se détache d'un corps en feu ou produite par un frottement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "feu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une petite <w>étincelle</w> a suffi pour allumer le feu dans la cheminée."
                        },
                        {
                            "text": "Le forgeron martèle le fer brûlant sous une pluie d'<w>étincelles</w> brillantes."
                        }
                    ],
                    "common_phrases": [
                        "pluie d'étincelles",
                        "gerbe d'étincelles",
                        "faire des étincelles"
                    ]
                },
                {
                    "sense_id": "464541ea-683f-3042-a203-d296009b2259",
                    "sense_definition": "Manifestation vive et fugitive d'un sentiment, d'une idée ou d'une qualité intellectuelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sens_figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses yeux noirs brillaient d'une <w>étincelle</w> de malice quand elle souriait."
                        },
                        {
                            "text": "Malgré les difficultés de la situation, il conservait une <w>étincelle</w> d'espoir."
                        }
                    ],
                    "synonyms": [
