{
    "word_family": [
        "tidily",
        "tidiness",
        "untidy",
        "untidiness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3bbe7ec-07a7-3e27-8975-6544c5f6ca4d",
                    "sense_definition": "To make something neat and organized by putting things in their proper places.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>tidy</w> my room before the guests arrive this evening.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>убраться</w> в комнате до того, как сегодня вечером придут гости.",
                                "zh": "今晚客人来之前，我得把房间<w>整理</w>一下。"
                            }
                        },
                        {
                            "text": "Please <w>tidy</w> up your toys and put them back in the box.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>убери</w> свои игрушки и сложи их обратно в коробку.",
                                "zh": "请把你的玩具<w>收拾</w>好，放回盒子里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clean"
                    ],
                    "common_phrases": [
                        "tidy up your toys",
                        "tidy the house"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить что-либо в порядок и делать чистым, расставляя вещи по своим местам.",
                        "zh": "通过将物品放回原处来使某物变得整洁有序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убирать",
                                "target_lang_sense_clarification": "наводить порядок в комнате или доме"
                            },
                            {
                                "target_lang_word": "приводить в порядок",
                                "target_lang_sense_clarification": "делать организованным"
                            },
                            {
                                "target_lang_word": "наводить чистоту",
                                "target_lang_sense_clarification": "делать чистым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整理",
                                "target_lang_sense_clarification": "使物品变得整齐"
                            },
                            {
                                "target_lang_word": "收拾",
                                "target_lang_sense_clarification": "清理房间或物品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec838849-ea82-3d87-ad4d-a1bc6a16e824",
                    "sense_definition": "Arranged neatly and in order; not messy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "orderliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She always kept her desk immaculately <w>tidy</w> so nothing was ever out of place.",
                            "target_lang_translations": {
                                "ru": "Она всегда держала свой стол в безупречной <w>чистоте</w>, так что ничто никогда не лежало не на своем месте.",
                                "zh": "她总是把书桌保持得非常<w>整洁</w>，所以东西从不乱放。"
                            }
                        },
                        {
                            "text": "It is important to keep a <w>tidy</w> desk to stay productive at work.",
                            "target_lang_translations": {
                                "ru": "Важно поддерживать <w>порядок</w> на рабочем столе, чтобы оставаться продуктивным на работе.",
                                "zh": "保持书桌<w>整齐</w>对于提高工作效率很重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "neat",
                        "orderly",
                        "presentable",
                        "spick and span",
                        "clean"
                    ],
                    "antonyms": [
                        "messy",
                        "untidy",
                        "slipshod"
                    ],
                    "common_phrases": [
                        "keep a tidy desk",
                        "neat and tidy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аккуратно расположенный и упорядоченный; не создающий беспорядка.",
                        "zh": "排列整齐有序；不杂乱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аккуратный",
                                "target_lang_sense_clarification": "содержащийся в порядке"
                            },
                            {
                                "target_lang_word": "опрятный",
                                "target_lang_sense_clarification": "чистый и аккуратный на вид"
                            },
                            {
                                "target_lang_word": "чистый",
                                "target_lang_sense_clarification": "без грязи и мусора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "整洁",
                                "target_lang_sense_clarification": "干净且有条理"
                            },
                            {
                                "target_lang_word": "整齐",
                                "target_lang_sense_clarification": "排列有序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dc6d9e4-b171-35db-92de-9964e9b7f490",
                    "sense_definition": "Large or considerable in amount, especially regarding money.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investment scheme made a <w>tidy</w> profit for all the early shareholders.",
                            "target_lang_translations": {
                                "ru": "Инвестиционная схема принесла <w>кругленькую</w> прибыль всем ранним акционерам.",
                                "zh": "这项投资计划为所有早期股东带来了<w>可观的</w>利润。"
                            }
                        },
                        {
                            "text": "He inherited a <w>tidy</w> sum of money from his late uncle.",
                            "target_lang_translations": {
                                "ru": "Он унаследовал <w>приличную</w> сумму денег от своего покойного дяди.",
                                "zh": "他从已故叔叔那里继承了一笔<w>相当大</w>的钱。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a tidy profit",
                        "a tidy sum"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used with 'sum' or 'profit'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой или значительный по объему, особенно в отношении денег.",
                        "zh": "数量大或相当可观，尤指金钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кругленький",
                                "target_lang_sense_clarification": "о сумме денег или прибыли"
                            },
                            {
                                "target_lang_word": "приличный",
                                "target_lang_sense_clarification": "довольно большой"
                            },
                            {
                                "target_lang_word": "значительный",
                                "target_lang_sense_clarification": "существенный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可观的",
                                "target_lang_sense_clarification": "指金额或利润很大"
                            },
                            {
                                "target_lang_word": "相当大",
                                "target_lang_sense_clarification": "形容数量或金额"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "488ab25b-1b7f-3345-86a1-8e2df2796950",
                    "sense_definition": "Occurring at a suitable or favorable time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors waited for a <w>tidy</w> wind before departing from the harbor.",
                            "target_lang_translations": {
                                "ru": "Моряки ждали <w>попутного</w> ветра перед выходом из гавани.",
                                "zh": "水手们等待着<w>有利的</w>风向，然后才离开港口。"
                            }
                        },
                        {
                            "text": "It was a <w>tidy</w> season for planting the new crops.",
                            "target_lang_translations": {
                                "ru": "Это был <w>подходящий</w> сезон для посадки новых культур.",
                                "zh": "这是种植新农作物的<w>适时的</w>季节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opportune",
                        "seasonable",
                        "timely",
                        "fit",
                        "suitable"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий в подходящее или благоприятное время.",
                        "zh": "发生在合适或有利的时机。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благоприятный",
                                "target_lang_sense_clarification": "подходящий для чего-либо"
                            },
                            {
                                "target_lang_word": "уместный",
                                "target_lang_sense_clarification": "своевременный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "适时的",
                                "target_lang_sense_clarification": "时间恰当的"
                            },
                            {
                                "target_lang_word": "有利的",
                                "target_lang_sense_clarification": "对某事有帮助的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05746de8-d7aa-3606-ac17-74dbfce370ed",
                    "sense_definition": "Relating to data that has been structured in a specific way to make analysis easier.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to convert the raw spreadsheet into <w>tidy</w> data for the software.",
                            "target_lang_translations": {
                                "ru": "Нам нужно преобразовать необработанную таблицу в <w>структурированные</w> данные для программного обеспечения.",
                                "zh": "我们需要将原始电子表格转换为软件所需的<w>结构化</w>数据。"
                            }
                        },
                        {
                            "text": "The <w>tidy</w> format ensures that each variable is a column.",
                            "target_lang_translations": {
                                "ru": "<w>Упорядоченный</w> формат гарантирует, что каждая переменная является столбцом.",
                                "zh": "这种<w>整齐的</w>格式确保了每个变量都占据一列。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tidy data"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in data science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к данным, которые структурированы определенным образом для облегчения анализа.",
                        "zh": "指以特定方式结构化以便于分析的数据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "структурированный",
                                "target_lang_sense_clarification": "организованный для анализа"
                            },
                            {
                                "target_lang_word": "упорядоченный",
                                "target_lang_sense_clarification": "приведенный в систему"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结构化",
                                "target_lang_sense_clarification": "为了便于分析而组织的"
                            },
                            {
                                "target_lang_word": "整齐的",
                                "target_lang_sense_clarification": "格式规范的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1fd4f2f-b583-3856-884b-09bc849de89b",
                    "sense_definition": "A container or organizer used to keep small items in order.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought a new desk <w>tidy</w> to hold all my pens and paperclips.",
                            "target_lang_translations": {
                                "ru": "Я купил новый настольный <w>органайзер</w>, чтобы хранить в нем все свои ручки и скрепки.",
                                "zh": "我买了一个新的桌面<w>收纳盒</w>来放我的笔和回形针。"
                            }
                        },
                        {
                            "text": "The plastic sink <w>tidy</w> keeps the sponge and soap organized.",
                            "target_lang_translations": {
                                "ru": "Пластиковая <w>подставка</w> для раковины позволяет держать губку и мыло в порядке.",
                                "zh": "塑料水槽<w>整理架</w>让海绵和肥皂摆放得井井有条。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "desk tidy",
                        "sink tidy",
                        "cable tidy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер или органайзер, используемый для хранения мелких предметов в порядке.",
                        "zh": "用于将小物品保持整齐的容器或整理架。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "органайзер",
                                "target_lang_sense_clarification": "подставка для мелочей"
                            },
                            {
                                "target_lang_word": "подставка",
                                "target_lang_sense_clarification": "для канцелярских принадлежностей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收纳盒",
                                "target_lang_sense_clarification": "用于存放小物件的容器"
                            },
                            {
                                "target_lang_word": "整理架",
                                "target_lang_sense_clarification": "用于放置文具等物品的架子"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "c86428bd-42ca-334b-939a-daa1f3dab570",
                    "sense_definition": "An expression used to show agreement or that something is good.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"I'll meet you at the pub at eight.\" \"<w>Tidy</w>, see you then!\"",
                            "target_lang_translations": {
                                "ru": "«Встретимся в пабе в восемь». — «<w>Идёт</w>, увидимся!»",
                                "zh": "“八点我们在酒吧见。”“<w>太棒了</w>，到时候见！”"
                            }
                        },
                        {
                            "text": "That is a <w>tidy</w> result for the team after such a hard game.",
                            "target_lang_translations": {
                                "ru": "Это <w>отличный</w> результат для команды после такой тяжелой игры.",
                                "zh": "在经历了一场艰苦的比赛后，这对球队来说是一个<w>好极了</w>的结果。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in Wales"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение, используемое для выражения согласия или одобрения.",
                        "zh": "用于表示同意或某事很好的感叹词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отлично",
                                "target_lang_sense_clarification": "выражение одобрения"
                            },
                            {
                                "target_lang_word": "идёт",
                                "target_lang_sense_clarification": "выражение согласия"
                            },
                            {
                                "target_lang_word": "круто",
                                "target_lang_sense_clarification": "молодежный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "太棒了",
                                "target_lang_sense_clarification": "表示赞同或赞赏"
                            },
                            {
                                "target_lang_word": "好极了",
                                "target_lang_sense_clarification": "表示非常满意"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2f75cfea-6dbc-3adb-8f26-f97945d27332",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named John <w>Tidy</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Джон <w>Тайди</w>.",
                                "zh": "这本书的作者是一位名叫约翰·<w>泰迪</w>的人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тайди",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "泰迪",
                                "target_lang_sense_clarification": "英文姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
