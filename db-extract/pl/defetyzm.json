                "senses": [
                    {
                        "sense_id": "9ad3d3a2-fa62-3aaf-a711-07bf0e57dabd",
                        "entry_id": "6a2fbc02-bd7e-30fa-a942-3c51cf8e0c54",
                        "glosses": [
                            "niewiara w powodzenie sprawy, w zwycięstwo; przewidywanie porażki z góry, przed decydującą rozgrywką"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "4ef5be74-3926-4384-b7c5-594dfab1002d",
                                "sense_id": "9ad3d3a2-fa62-3aaf-a711-07bf0e57dabd",
                                "text": "Co wy mi tu, żołnierzu, defetyzm szerzycie? Posiłki nadejdą na czas, stulcie pysk i wracajcie kopać okopy!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1615bc68-1516-48f1-b892-2c8dd760448f",
                        "source_entry_id": "6a2fbc02-bd7e-30fa-a942-3c51cf8e0c54",
                        "source_sense_id": "9ad3d3a2-fa62-3aaf-a711-07bf0e57dabd",
                        "target_lang_word": "defeatism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defeatism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "553ac83d-a165-39a0-8a44-832748c5ba3e",
                                        "entry_id": "cf9fdd7e-3ee6-3a8b-9a32-da8842f6d3ec",
                                        "glosses": [
                                            "Acceptance of defeat without struggle."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c79484b-9cbd-45fe-9e94-b2ce91ca8521",
                                                "sense_id": "553ac83d-a165-39a0-8a44-832748c5ba3e",
                                                "text": "Objective assessment is good, but defeatism will reduce our potentials even when the prospects for victory have never been nearer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd4244ed-002e-4b21-b93b-3b14e0010577",
                        "source_entry_id": "6a2fbc02-bd7e-30fa-a942-3c51cf8e0c54",
                        "source_sense_id": "9ad3d3a2-fa62-3aaf-a711-07bf0e57dabd",
                        "target_lang_word": "poraženectví",
