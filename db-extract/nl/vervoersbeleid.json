                            {
                                "example_id": "6e0e9a86-db98-4406-bb1d-17b3c5114fe1",
                                "sense_id": "a6c450fd-6d0e-3494-af57-c9c9bf75ea8b",
                                "text": "In een stad als Milaan werd de fijnstoflimiet vorig jaar 60 dagen overschreden. Daarom is daar en in Rome besloten om in te zetten op een groener vervoersbeleid."
                            },
                            {
                                "example_id": "19349310-a28a-4d33-806f-47be4ec26ba8",
                                "sense_id": "a6c450fd-6d0e-3494-af57-c9c9bf75ea8b",
                                "text": "Als Uber alleen zou bemiddelen zou het vallen onder de regels die gelden op de Europese interne markt voor het vrij verrichten van diensten of elektronische handel. Maar de verantwoordelijkheid voor vervoersbeleid ligt bij de lidstaten en die mogen dus de voorwaarden bepalen waaraan Uber-chauffeurs moeten voldoen."
                            }
