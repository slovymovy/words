                                "target_senses": [
                                    {
                                        "sense_id": "bc2823cb-61da-31b4-8a75-8dc32f5443e4",
                                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                                        "glosses": [
                                            "Strict adherence to a given form of conduct, practice etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1d5c44c-59a6-356d-86c3-708508e66254",
                                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                                        "glosses": [
                                            "One of several alternative computational paradigms for a given theory."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49457ef9-f9a4-3474-bfe1-25bb486f5e34",
                                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                                        "glosses": [
                                            "An approach to interpretation and/or evaluation focused on the (usually linguistic) structure of a literary work rather than on the contexts of its origin or reception."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b254f85-25e2-32d1-9a79-d36d726668ab",
                                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                                        "glosses": [
                                            "The tendency to elevate formal above expressive value in music, as in serialism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75d8b347-aad3-3e6f-b098-0d6d23b24c88",
                                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                                        "glosses": [
                                            "A particular mathematical or scientific theory or description of a given state or effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd6be155-deb9-42f1-9155-82e526a3184e",
                                                "sense_id": "75d8b347-aad3-3e6f-b098-0d6d23b24c88",
                                                "text": "Heisenberg seems to have been motivated by his intense annoyance that Schrödinger's more intuitive version of quantum theory was more widely accepted than his own, even though both formalisms led to the same results."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feeba37b-c36c-38d2-8a77-8a35fb737b99",
                                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                                        "glosses": [
                                            "A formal expression of a grammar; a formal grammar; a set of rules of syntax that, without reference to semantics, determine whether a sequence of symbols is a well-formed sentence in a given formal language."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "751b8dd1-5ef2-457c-8bb5-392890917671",
                                                "sense_id": "feeba37b-c36c-38d2-8a77-8a35fb737b99",
                                                "text": "Dirac approaches quantum mechanics by means of a so-called symbolic method, the bracket formalism. Although this formalism has a mathematical flavour, in fact, it is based upon bold claims which lack mathematical foundation."
                                            },
                                            {
                                                "example_id": "6ddd3b93-3e5a-485f-abd1-3020e77d7345",
                                                "sense_id": "feeba37b-c36c-38d2-8a77-8a35fb737b99",
                                                "text": "1992, tuart M. Shieber, Constraint-based Grammar Formalisms, The MIT Press, page 51,\nIt is this abstraction that justifies considering these methods as characterizing constraint-based formalisms in general, rather than an individual formalism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aa0ebf6-c9ea-392c-8ce2-edf70589ff39",
                                        "entry_id": "58e8b6d5-832e-3484-8e59-b90e899cb2fa",
                                        "glosses": [
                                            "The ontological view of mathematics as a mere collection of string manipulation rules."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80c3fed2-fe1f-4f4d-8936-b9cf8d828c12",
