{
    "word_family": [
        "suddenly",
        "suddenness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c12cb270-09c2-327c-ad83-d31f2042a0af",
                    "sense_definition": "Occurring quickly with little or no warning or expectation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unexpected_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sudden</w> noise made everyone in the room jump.",
                            "target_lang_translations": {
                                "ru": "<w>Внезапный</w> шум заставил всех в комнате вздрогнуть.",
                                "zh": "<w>突然</w>的响声让屋里的每个人都吓了一跳。",
                                "de": "Das <w>plötzliche</w> Geräusch ließ jeden im Raum zusammenzucken."
                            }
                        },
                        {
                            "text": "There was a <w>sudden</w> change in the weather this afternoon.",
                            "target_lang_translations": {
                                "ru": "Сегодня днём произошла <w>резкая</w> перемена погоды.",
                                "zh": "今天下午天气发生了<w>突然</w>的变化。",
                                "de": "Heute Nachmittag gab es einen <w>plötzlichen</w> Wetterumschwung."
                            }
                        }
                    ],
                    "synonyms": [
                        "abrupt",
                        "unexpected"
                    ],
                    "antonyms": [
                        "gradual"
                    ],
                    "common_phrases": [
                        "sudden change",
                        "sudden death",
                        "sudden movement",
                        "sudden stop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий быстро, без предупреждения или неожиданно.",
                        "zh": "指发生得很快，几乎没有预兆或预期。",
                        "de": "Tritt schnell und ohne Vorwarnung oder Erwartung ein."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внезапный",
                                "target_lang_sense_clarification": "происходящий вдруг, неожиданно"
                            },
                            {
                                "target_lang_word": "неожиданный",
                                "target_lang_sense_clarification": "тот, которого не ждали"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "быстрый и сильный (об изменениях)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突然",
                                "target_lang_sense_clarification": "指发生得非常快，出人意料"
                            },
                            {
                                "target_lang_word": "意外",
                                "target_lang_sense_clarification": "指没有预料到的"
                            },
                            {
                                "target_lang_word": "猛烈",
                                "target_lang_sense_clarification": "指变化剧烈且迅速"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "plötzlich",
                                "target_lang_sense_clarification": "allgemeiner Begriff für etwas, das unerwartet geschieht"
                            },
                            {
                                "target_lang_word": "jäh",
                                "target_lang_sense_clarification": "betont die Heftigkeit und Abruptheit des Ereignisses"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b634405d-a1c1-3eb5-b165-192f0881a0e1",
                    "sense_definition": "Hasty, violent, rash, or precipitate in behavior or action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rash_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He regretted his <w>sudden</w> decision to quit his job without a plan.",
                            "target_lang_translations": {
                                "ru": "Он пожалел о своём <w>поспешном</w> решении уволиться без плана.",
                                "zh": "他后悔自己没做计划就<w>仓促</w>辞职的决定。",
                                "de": "Er bereute seine <w>übereilte</w> Entscheidung, seinen Job ohne Plan zu kündigen."
                            }
                        },
                        {
                            "text": "Her <w>sudden</w> outburst surprised her colleagues.",
                            "target_lang_translations": {
                                "ru": "Её <w>внезапная</w> вспышка гнева удивила коллег.",
                                "zh": "她<w>冲动</w>的情绪爆发让同事们感到惊讶。",
                                "de": "Ihr <w>plötzlicher</w> Wutausbruch überraschte ihre Kollegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "impetuous",
                        "impulsive",
                        "reckless",
                        "hotheaded"
                    ],
                    "common_phrases": [
                        "sudden impulse",
                        "sudden decision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поспешный, необдуманный или резкий в поведении или действиях.",
                        "zh": "指行为或动作仓促、鲁莽或草率。",
                        "de": "Hastig, unüberlegt oder vorschnell in Verhalten oder Handlungen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поспешный",
                                "target_lang_sense_clarification": "сделанный в спешке"
                            },
                            {
                                "target_lang_word": "скоропалительный",
                                "target_lang_sense_clarification": "принятый слишком быстро, необдуманно"
                            },
                            {
                                "target_lang_word": "импульсивный",
                                "target_lang_sense_clarification": "совершенный под влиянием порыва"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仓促",
                                "target_lang_sense_clarification": "指时间紧迫，准备不足"
                            },
                            {
                                "target_lang_word": "草率",
                                "target_lang_sense_clarification": "指做事不认真，考虑不周"
                            },
                            {
                                "target_lang_word": "冲动",
                                "target_lang_sense_clarification": "指受情绪支配，不加思考"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "übereilt",
                                "target_lang_sense_clarification": "ohne ausreichende Überlegung oder Vorbereitung"
                            },
                            {
                                "target_lang_word": "impulsiv",
                                "target_lang_sense_clarification": "aus einem plötzlichen Gefühl heraus handelnd"
                            },
                            {
                                "target_lang_word": "vorschnell",
                                "target_lang_sense_clarification": "zu schnell geurteilt oder gehandelt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "73236a3b-e036-36c4-9e5f-3ca20c22ff17",
                    "sense_definition": "An unexpected occurrence or surprise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unexpected_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All of a <w>sudden</w>, the lights went out in the entire building.",
                            "target_lang_translations": {
                                "ru": "<w>Внезапно</w> во всём здании погас свет.",
                                "zh": "<w>突然</w>之间，整栋楼的灯都灭了。",
                                "de": "<w>Plötzlich</w> ging im gesamten Gebäude das Licht aus."
                            }
                        },
                        {
                            "text": "The car stopped all of a <w>sudden</w> in the middle of the road.",
                            "target_lang_translations": {
                                "ru": "Машина <w>вдруг</w> остановилась посреди дороги.",
                                "zh": "车<w>突然</w>停在了马路中间。",
                                "de": "Das Auto hielt <w>plötzlich</w> mitten auf der Straße an."
                            }
                        }
                    ],
                    "common_phrases": [
                        "all of a sudden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "chiefly in the phrase 'all of a sudden'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неожиданное событие или сюрприз (преимущественно в идиоме 'all of a sudden').",
                        "zh": "指意想不到的事件或惊喜（主要用于“all of a sudden”短语中）。",
                        "de": "Ein unerwartetes Ereignis oder eine Überraschung (hauptsächlich in der Wendung 'all of a sudden')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неожиданность",
                                "target_lang_sense_clarification": "внезапное происшествие"
                            },
                            {
                                "target_lang_word": "вдруг",
                                "target_lang_sense_clarification": "эквивалент фразы 'all of a sudden'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "突然",
                                "target_lang_sense_clarification": "用于描述动作发生的瞬间"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "plötzlich",
                                "target_lang_sense_clarification": "als Teil der adverbialen Wendung 'plötzlich'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "62fecba7-7a73-3cd7-ae56-77f2f170be2d",
                    "sense_definition": "Suddenly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unexpected_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind <w>sudden</w> shifted direction during the storm.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>внезапно</w> сменил направление во время бури.",
                                "zh": "暴风雨中，风向<w>忽然</w>改变了。",
                                "de": "Der Wind änderte während des Sturms <w>plötzlich</w> seine Richtung."
                            }
                        },
                        {
                            "text": "A light <w>sudden</w> appeared in the distance.",
                            "target_lang_translations": {
                                "ru": "Вдали <w>вдруг</w> появился свет.",
                                "zh": "远处<w>忽然</w>出现了一道光。",
                                "de": "In der Ferne erschien <w>plötzlich</w> ein Licht."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "poetic or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно (устаревшее или поэтическое).",
                        "zh": "突然地（文学或古语用法）。",
                        "de": "Auf eine plötzliche Weise (literarisch oder veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внезапно",
                                "target_lang_sense_clarification": "наречие"
                            },
                            {
                                "target_lang_word": "вдруг",
                                "target_lang_sense_clarification": "наречие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "忽然",
                                "target_lang_sense_clarification": "表示情况发生得快"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "plötzlich",
                                "target_lang_sense_clarification": "gebräuchliches Adverb für 'auf einmal'"
                            },
                            {
                                "target_lang_word": "jäh",
                                "target_lang_sense_clarification": "gehobenere Ausdrucksweise für abrupt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}