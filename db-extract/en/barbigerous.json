                                "example_id": "beaac880-9217-4817-bb03-65330513e2bc",
                                "sense_id": "1d1aa57d-2baf-3738-a20a-0654ee4f9ec8",
                                "text": "1810, James Kennedy, Glenochel, Glasgow: R. Chapman, Volume 2, p. 118,\nProfoundly thoughtful looks the sage, / Barbigerous, and priestly mien’d;"
                            },
                            {
                                "example_id": "5aa15100-9d5a-4624-9521-b3ec7e2e80b1",
                                "sense_id": "1d1aa57d-2baf-3738-a20a-0654ee4f9ec8",
                                "text": "1972, Saul K. Padover, Karl Marx: An Intimate Biography, New York: McGraw-Hill, Chapter 20, p. 348,\nthe author magnificently barbigerous and the publisher elegantly bearded but bald"
                            },
                            {
                                "example_id": "d08f3d6e-47c9-40ba-8803-e536f6984dfe",
                                "sense_id": "1d1aa57d-2baf-3738-a20a-0654ee4f9ec8",
                                "text": "[…] check out a portrait of the earl and you’ll see on his chin a barbigerous bulk that makes the poor fellow look like an Elizabethan cross between two Sams: Uncle and Yosemite."
                            }
                        ]
