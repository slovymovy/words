                    {
                        "translation_id": "79533a69-9868-4212-b0ff-020dbf0b5f4b",
                        "source_entry_id": "7020fb2e-a176-3ae6-9c09-83c6341f75e4",
                        "source_sense_id": "8d66fc7e-9d64-392c-abe7-4696ae7c5c1d",
                        "target_lang_word": "Hitler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hitler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c273f92-b775-393b-a711-b62d44f1b827",
                                        "entry_id": "e1152025-6561-3977-992a-f90eff185dbd",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f09acc57-2319-41ba-9c9e-d829c85c91d4",
                                                "sense_id": "3c273f92-b775-393b-a711-b62d44f1b827",
                                                "text": "Alois Hitler war Adolf Hitlers Vater."
                                            },
                                            {
                                                "example_id": "f64d5d33-7197-46ef-b994-4e6523ac39c9",
                                                "sense_id": "3c273f92-b775-393b-a711-b62d44f1b827",
                                                "text": "„Jacob wußte gar nicht, wer dieser Hitler war.“"
                                            },
                                            {
                                                "example_id": "84ceee80-1d7c-4815-8c81-66d4353f8206",
                                                "sense_id": "3c273f92-b775-393b-a711-b62d44f1b827",
                                                "text": "„Die Ernennung Hitlers zum Reichskanzler scheint er kaum bemerkt zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a42156b-2a97-4b19-b477-22fdf9ce02e5",
