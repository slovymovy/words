                    "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                    "sense_definition": "As it was in the beginning or at first.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The building was <w>originally</w> a bank before it became a hotel.",
