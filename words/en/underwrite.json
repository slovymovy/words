{
    "word_family": [
        "underwriter",
        "underwriting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df4f37a9-d9a4-30d7-aa0b-ea4a201e5962",
                    "sense_definition": "To assume financial responsibility for something, such as an enterprise or risk, and guarantee it against loss.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>underwrite</w> the costs of the new international airport.",
                            "target_lang_translations": {
                                "nl": "De regering besloot <w>garant te staan voor</w> de kosten van de nieuwe internationale luchthaven."
                            }
                        },
                        {
                            "text": "Several major investment banks agreed to <w>underwrite</w> the initial public offering.",
                            "target_lang_translations": {
                                "nl": "Verschillende grote investeringsbanken gingen ermee akkoord om de beursgang te <w>garanderen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "guarantee",
                        "back",
                        "finance"
                    ],
                    "common_phrases": [
                        "underwrite the cost",
                        "underwrite the risk"
                    ],
                    "target_lang_definitions": {
                        "nl": "Financiële verantwoordelijkheid voor iets op zich nemen en garant staan tegen verlies."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "garant staan voor",
                                "target_lang_sense_clarification": "financieel instaan voor kosten of risico's"
                            },
                            {
                                "target_lang_word": "waarborgen",
                                "target_lang_sense_clarification": "zekerheid bieden voor financiële risico's"
                            },
                            {
                                "target_lang_word": "financieren",
                                "target_lang_sense_clarification": "geldmiddelen beschikbaar stellen of dekken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a962f2b-90c2-3e7b-941d-8bf6e76a92c9",
                    "sense_definition": "To evaluate risk and issue an insurance policy or security.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency agreed to <w>underwrite</w> the insurance policy after reviewing the property.",
                            "target_lang_translations": {
                                "nl": "Het agentschap stemde ermee in de verzekeringspolis te <w>dekken</w> na inspectie van het pand."
                            }
                        },
                        {
                            "text": "Few companies are willing to <w>underwrite</w> policies for flood-prone regions.",
                            "target_lang_translations": {
                                "nl": "Weinig bedrijven zijn bereid polissen te <w>verstrekken</w> voor overstromingsgevoelige gebieden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "underwrite a policy",
                        "underwrite an insurance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een risico beoordelen en een verzekeringspolis afsluiten of accepteren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "dekken",
                                "target_lang_sense_clarification": "een verzekeringsrisico accepteren"
                            },
                            {
                                "target_lang_word": "verzekeren",
                                "target_lang_sense_clarification": "een polis uitschrijven of accepteren"
                            },
                            {
                                "target_lang_word": "ondertekenen",
                                "target_lang_sense_clarification": "in verzekeringstermen: een polis accepteren en tekenen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e681032-c0ec-3cf5-9004-d393377bb96b",
                    "sense_definition": "To support, lend support to, or provide a foundation or guarantee for something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rigorous scientific research must <w>underwrite</w> all of our clinical decisions.",
                            "target_lang_translations": {
                                "nl": "Gedegen wetenschappelijk onderzoek moet de basis <w>vormen voor</w> al onze klinische beslissingen."
                            }
                        },
                        {
                            "text": "A shared sense of purpose serves to <w>underwrite</w> the entire organization.",
                            "target_lang_translations": {
                                "nl": "Een gedeeld gevoel van doelgerichtheid dient om de hele organisatie te <w>schragen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "support",
                        "endorse"
                    ],
                    "target_lang_definitions": {
                        "nl": "Ondersteunen, steun verlenen aan, of de basis/garantie vormen voor iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onderschrijven",
                                "target_lang_sense_clarification": "zich achter een idee of visie scharen"
                            },
                            {
                                "target_lang_word": "ondersteunen",
                                "target_lang_sense_clarification": "fundament of ruggensteun bieden"
                            },
                            {
                                "target_lang_word": "schragen",
                                "target_lang_sense_clarification": "de basis vormen voor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2affe2bc-b676-33a5-a16b-d9e6318fd736",
                    "sense_definition": "To write at the bottom or underneath something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "signature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clerk had to <w>underwrite</w> the terms beneath the primary clause of the treaty.",
                            "target_lang_translations": {
                                "nl": "De griffier moest de voorwaarden onder de primaire clausule van het verdrag <w>bijschrijven</w>."
                            }
                        },
                        {
                            "text": "Please <w>underwrite</w> your title directly below the provided signature line.",
                            "target_lang_translations": {
                                "nl": "Gelieve uw functie direct onder de aangegeven handtekeningregel <w>te noteren</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literal meaning"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Onderaan of onder iets schrijven (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ondertitelen",
                                "target_lang_sense_clarification": "eronder schrijven (letterlijk)"
                            },
                            {
                                "target_lang_word": "eronder schrijven",
                                "target_lang_sense_clarification": "onderaan noteren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b3d5d59-f5a8-34f8-9918-98b463b39ac4",
                    "sense_definition": "To sign or add one's signature to a document or agreement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "signature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Both parties gathered to <w>underwrite</w> the final agreement before the council.",
                            "target_lang_translations": {
                                "nl": "Beide partijen kwamen bijeen om de definitieve overeenkomst ten overstaan van de raad te <w>ondertekenen</w>."
                            }
                        },
                        {
                            "text": "He refused to <w>underwrite</w> the petition without further revisions.",
                            "target_lang_translations": {
                                "nl": "Hij weigerde de petitie te <w>ondertekenen</w> zonder verdere herzieningen."
                            }
                        }
                    ],
                    "synonyms": [
                        "sign",
                        "subscribe"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "signing meaning"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zijn handtekening onder een document of overeenkomst zetten."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ondertekenen",
                                "target_lang_sense_clarification": "een handtekening zetten onder een verdrag of document"
                            },
                            {
                                "target_lang_word": "onderschrijven",
                                "target_lang_sense_clarification": "zijn handtekening plaatsen ter bekrachtiging (formeel/ouderwets)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61beb65b-e266-33c3-8e3d-d515cb051590",
                    "sense_definition": "To submit to or put up with something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "submit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rebels refused to <w>underwrite</w> the harsh rule of the occupying forces.",
                            "target_lang_translations": {
                                "nl": "De rebellen weigerden zich <w>te onderwerpen aan</w> het harde bewind van de bezettingsmacht."
                            }
                        },
                        {
                            "text": "He could no longer <w>underwrite</w> such persistent insolence from his subordinates.",
                            "target_lang_translations": {
                                "nl": "Hij kon een dergelijke aanhoudende brutaliteit van zijn ondergeschikten niet langer <w>verdragen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "submit",
                        "endure"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "sense meaning submit to"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zich onderwerpen aan of verdragen (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verdragen",
                                "target_lang_sense_clarification": "dulden, accepteren"
                            },
                            {
                                "target_lang_word": "zich onderwerpen aan",
                                "target_lang_sense_clarification": "toegeven aan heerschappij of bevel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}