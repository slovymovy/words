                "senses": [
                    {
                        "sense_id": "3f21422b-a8ad-3e6d-b007-1c73ac2166cb",
                        "entry_id": "0342b501-ef4a-30e5-bcb3-8584dd694d90",
                        "glosses": [
                            "Agir de façon missionnaire vis à vis de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7cd723-b581-469b-b264-b6bbefeca09b",
                                "sense_id": "3f21422b-a8ad-3e6d-b007-1c73ac2166cb",
                                "text": "Etrange besoin des hommes blancs que celui qui depuis près de deux millénaires aboutit à « missionnariser », à imposer aux autres ses propres vérités."
                            },
                            {
                                "example_id": "1da88832-8270-4f1c-9303-07849f49fe1a",
                                "sense_id": "3f21422b-a8ad-3e6d-b007-1c73ac2166cb",
                                "text": "On m'a proposé les Philippines, je me suis dis \"chic ya la mer partout et pis en plus... sont déjà tous catho! pas besoin de missionnariser!"
                            },
                            {
                                "example_id": "42f22121-689d-4b57-a744-08d48f6f73cb",
                                "sense_id": "3f21422b-a8ad-3e6d-b007-1c73ac2166cb",
                                "text": "Désolé mais, quand je te lis, j'ai l'impression que tu te donnes une mission de missionnariser certains empires à ta vision du jeu."
                            }
                        ]
                    }
                ],
