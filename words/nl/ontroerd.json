    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af654b2b-ba98-3664-b211-5f0c93390e11",
                    "sense_definition": "een staat waarin een persoon verkeert als iets hem of haar emotioneel geraakt heeft",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude man was zichtbaar <w>ontroerd</w> toen hij zijn kleinkind voor het eerst zag.",
                            "target_lang_translations": {
                                "en": "The old man was visibly <w>moved</w> when he saw his grandchild for the first time.",
                                "ru": "Старик был заметно <w>растроган</w>, когда впервые увидел своего внука.",
                                "fr": "Le vieil homme était visiblement <w>ému</w> lorsqu'il a vu son petit-enfant pour la première fois."
                            }
                        },
                        {
                            "text": "Zij was diep <w>ontroerd</w> door de prachtige muziek die tijdens de ceremonie werd gespeeld.",
                            "target_lang_translations": {
                                "en": "She was deeply <w>touched</w> by the beautiful music played during the ceremony.",
                                "ru": "Она была глубоко <w>тронута</w> прекрасной музыкой, которая звучала во время церемонии.",
                                "fr": "Elle a été profondément <w>touchée</w> par la magnifique musique jouée pendant la cérémonie."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewogen",
                        "aangedaan",
                        "geraakt"
                    ],
                    "common_phrases": [
                        "diep ontroerd",
                        "zichtbaar ontroerd"
                    ],
                    "target_lang_definitions": {
                        "en": "a state a person is in when something has touched them emotionally",
                        "ru": "состояние человека, вызванное сильными эмоциональными переживаниями",
                        "fr": "état d'une personne qui est touchée ou émue par quelque chose"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moved",
                                "target_lang_sense_clarification": "emotionally touched"
                            },
                            {
                                "target_lang_word": "touched",
                                "target_lang_sense_clarification": "feeling a soft emotion"
                            },
                            {
                                "target_lang_word": "affected",
                                "target_lang_sense_clarification": "emotionally impacted"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тронутый",
                                "target_lang_sense_clarification": "испытывающий душевное волнение"
                            },
                            {
                                "target_lang_word": "растроганный",
                                "target_lang_sense_clarification": "испытывающий нежность или умиление"
                            },
                            {
                                "target_lang_word": "взволнованный",
                                "target_lang_sense_clarification": "находящийся под сильным впечатлением"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "ému",
                                "target_lang_sense_clarification": "qui ressent une vive émotion"
                            },
                            {
                                "target_lang_word": "touché",
                                "target_lang_sense_clarification": "sensiblement affecté par une attention ou un événement"
                            },
                            {
                                "target_lang_word": "bouleversé",
                                "target_lang_sense_clarification": "profondément remué émotionnellement"
                            }
                        ]
