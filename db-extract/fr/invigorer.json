                ],
                "senses": [
                    {
                        "sense_id": "13307c33-31db-384d-b1be-c01a34c570a6",
                        "entry_id": "303dafa3-3eb4-3a5f-9d33-f9b510142f2f",
                        "glosses": [
                            "Donner ou rendre de la vigueur."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "f200a7ae-2555-421d-9389-555c6b1db861",
                                "sense_id": "13307c33-31db-384d-b1be-c01a34c570a6",
                                "text": "Tant mieux, car notre physique et notre moral s'invigorent par cette variété d'occupations, et, comme je vous l'ai dit v dans ma première lettre, cette vie rurale et litterraire tout à la fois, qui est la vie du médecin de campagne, est ce qu'il y a de mieux pour l'homme."
                            },
                            {
                                "example_id": "48432c46-1514-4a14-bbc1-f5bec204d4a8",
                                "sense_id": "13307c33-31db-384d-b1be-c01a34c570a6",
                                "text": "C'est, comme ailleurs, le même précepte : invigorer ce qui est resté sain, afin d'en obtenir le développement aux dépens de ce qui est dévié."
                            },
                            {
                                "example_id": "886de155-4a38-433c-962b-a885392a3258",
                                "sense_id": "13307c33-31db-384d-b1be-c01a34c570a6",
                                "text": "Chercher à définir le niveau de dissolution, c'est apprendre à détecter les symptômes qui le trahissent et, somme toute, invigorer un esprit de recherche clinique rénové."
                            }
                        ]
                    }
                ],
