                ],
                "senses": [
                    {
                        "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                        "entry_id": "978e5375-6b50-3058-8cc1-7ddd8aef5970",
                        "glosses": [
                            "Dach/Decke von etwas (beispielsweise eines Cabriolets, eines Zelts) aus einem textilen Material (= Stoff)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b16e79cc-0c01-4638-a885-509b794d02b9",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "„Das Pfeifenwerk war nicht frei sichtbar, sondern von einem Baldachin als Stoffdach umschlossen.“"
                            },
                            {
                                "example_id": "9a8b9268-b9af-4d37-bf4b-3ddd8533248e",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "Das Stoffdach eines Cabriolets ist meist empfindlich."
                            },
                            {
                                "example_id": "9d6d3cb6-f3a2-4069-a46c-eb0fadebdc3a",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "„Nachdem die beiden Vorgängermodelle ein klappbares Hartdach hatten, wird der neue SL wieder mit einem Stoffdach angeboten.“"
                            },
                            {
                                "example_id": "f0885b20-3531-4f45-8bb7-824939c649f8",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "„Das zweitürige Cabriolet mit vier Sitzen war ab April 1994 lieferbar. Der Wagen ist mit einem Stoffdach versehen, das vollständig in einem Verdeckkasten versenkbar ist und unabhängig von der Kofferraumhaube durch eine eigene Haube geschützt wird.“"
                            },
                            {
                                "example_id": "19ff8bfb-deb1-4d0e-a9c8-7863a19dbaf6",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "„Der Roadster hat rahmenlose Schmetterlingstüren und ein Stoffdach, das in 15 Sekunden offen ist. Es lässt sich bis zu einer Geschwindigkeit von 50 km/h beim Fahren öffnen.“"
                            },
                            {
                                "example_id": "3f8263df-1e62-42be-945c-6876683857a2",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "„Besonders Cabriofahrer, deren Fahrzeuge ein Stoffdach haben, sollten die Reinigung in SB-Anlagen bevorzugen.“"
                            },
                            {
                                "example_id": "467ad986-b223-4454-8397-93a77f8c0a1c",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "„Das Fahrzeug hatte nur ein Stoffdach, so daß der Räuber leicht in den Fahrgastraum gelangen, die Zentralverriegelung lösen und den Kofferraum öffnen konnte.“"
                            },
                            {
                                "example_id": "489ad903-1edd-42a8-8196-4fe2cb8cd74f",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "„Das Stoffdach kann auf Knopfdruck per Elektromotor über die Führanlage der Lipizzaner gespannt werden, so sind sie vor Nässe und Wind geschützt.“"
                            },
                            {
                                "example_id": "2f16524e-ed0c-4347-a2a7-af1f1187f528",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "[Hängematte mit Stoffdach:] „Bei einer Übernachtung im Wald schützt das Stoffdach wiederum vor herabfallenden Dingen (oder Ausscheidungen).“"
                            },
                            {
                                "example_id": "cd177d6a-946e-4ac3-a6d5-d7441c80931c",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "„Holzbuden mit rot-weiß gestreiften Stoffdächern verwandeln heuer die ganze Altstadt zur Weihnachtsstadt.“"
                            },
                            {
                                "example_id": "43cbfdd7-0a27-47e1-bc2c-bc2804f48960",
                                "sense_id": "c8d60155-253c-3582-b32e-d4208b191fa4",
                                "text": "„Gleich um die Ecke hatten einige Indios einen Stand mit Stoffdach aufgebaut und verkauften zarten Mais und frisch geerntete Ollucos, an deren Schale noch Erde klebte;“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
