                                    {
                                        "sense_id": "f3945eb6-157f-3d43-b60d-513efd9251e6",
                                        "entry_id": "c1f98f1c-06f2-3cfc-ac14-2a36cd66e34e",
                                        "glosses": [
                                            "Vorgang, wenn etwas oder jemand verschwindet"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2efe1557-df40-4d76-aacc-5c6178891b71",
                                                "sense_id": "f3945eb6-157f-3d43-b60d-513efd9251e6",
                                                "text": "„Eine kurze Verschwindung mit einem Liebhaber ist zwar ein Fleck, aber doch ein Fleck, den die Zeit ausbleichet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba226a60-f995-4ce3-b4d2-4edbe004e95e",
                        "source_entry_id": "08084756-66a8-3b9d-adbf-2ede0f441699",
                        "source_sense_id": "cc8ceea2-0103-3af5-bd4d-5212de3c4c52",
                        "source_sense_description": "het verdwijnen",
                        "target_lang_word": "Verschwinden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschwinden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d944a26b-3670-380e-b416-eb7ebe6d45ee",
                                        "entry_id": "f7f1ca00-7322-3d03-a244-876f8b5561be",
                                        "glosses": [
                                            "der Vorgang, wenn etwas oder jemand sich unbemerkt entfernt oder unsichtbar wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "667a7239-6f91-410b-8628-095a0fc376bc",
                                                "sense_id": "d944a26b-3670-380e-b416-eb7ebe6d45ee",
                                                "text": "Das Verschwinden von Sandra ist rätselhaft."
                                            },
                                            {
                                                "example_id": "1053d1a2-2443-4806-aae9-2a0da14864e9",
                                                "sense_id": "d944a26b-3670-380e-b416-eb7ebe6d45ee",
                                                "text": "„Ich hatte die Küchentür zum Garten am Morgen geöffnet und beobachtet, wie die Schneedecke das Verschwinden der Welt vorantrieb und alles so leise, so still machte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "693945ca-9266-4003-94ea-0035d21b1504",
                        "source_entry_id": "08084756-66a8-3b9d-adbf-2ede0f441699",
                        "source_sense_id": "cc8ceea2-0103-3af5-bd4d-5212de3c4c52",
                        "source_sense_description": "het verdwijnen",
                        "target_lang_word": "disappearance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disappearance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99387188-bd05-3867-8dff-1eefaed2457c",
                                        "entry_id": "5465c48b-caa8-3b04-8ba3-e90a5e14750c",
                                        "glosses": [
                                            "The action of disappearing or vanishing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01537e54-e1c2-413a-a033-2766d92de292",
                                                "sense_id": "99387188-bd05-3867-8dff-1eefaed2457c",
                                                "text": "Wireless phone technology led to the disappearance of once-common coiled cords for telephone handsets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb8a30b-ddc9-352a-b05e-5a4a3dbcb30a",
                                        "entry_id": "5465c48b-caa8-3b04-8ba3-e90a5e14750c",
                                        "glosses": [
                                            "Passing out of sight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c6a5363-215f-44ed-bac5-896a10644f55",
                                                "sense_id": "8cb8a30b-ddc9-352a-b05e-5a4a3dbcb30a",
                                                "text": "From the shore, they watched the disappearance of the ships' masts into the haze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb6ca3bd-429d-35a3-ad8a-3a923ecd8a87",
                                        "entry_id": "5465c48b-caa8-3b04-8ba3-e90a5e14750c",
                                        "glosses": [
                                            "Leaving secretly of without explanation"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b26dde37-01b6-4300-92c0-83609579b14e",
                                                "sense_id": "fb6ca3bd-429d-35a3-ad8a-3a923ecd8a87",
                                                "text": "The prosecuting attorney was concerned about the potential disappearance of witnesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b70a0310-588e-3ba4-9948-a4555e15d430",
                                        "entry_id": "5465c48b-caa8-3b04-8ba3-e90a5e14750c",
                                        "glosses": [
                                            "Cessation of existence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6049a6a9-7fa5-41bc-968f-7f19e003e5ae",
                                                "sense_id": "b70a0310-588e-3ba4-9948-a4555e15d430",
                                                "text": "A single undoubted cure of a demonstrated cancer or sarcoma by this treatment would be enough to say definitely that the treatment exerts some specifically curative influence, for the spontaneous disappearance of undoubtedly malignant growths of this character is almost unknown."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e1e9242-41ce-45cb-91a0-a920fddffe73",
                        "source_entry_id": "08084756-66a8-3b9d-adbf-2ede0f441699",
                        "source_sense_id": "cc8ceea2-0103-3af5-bd4d-5212de3c4c52",
                        "source_sense_description": "het verdwijnen",
                        "target_lang_word": "disparition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disparition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efb1b31b-18da-3bac-9c45-8687922aa53b",
                                        "entry_id": "e483d2c8-d98c-3085-9d11-2d2da22a2b38",
                                        "glosses": [
                                            "Action de disparaître ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec2adba-5267-4aa8-acd8-82669bcc1d40",
                                                "sense_id": "efb1b31b-18da-3bac-9c45-8687922aa53b",
                                                "text": "Sans rien dire, je découvris ma boîte de biscuit, et je constatai la disparition de plusieurs galettes... Mon factotum n'avait pu résister à la tentation et m'en avait volé cinq ou six."
                                            },
                                            {
                                                "example_id": "bce643f1-ec9f-4bbb-a3a2-a411912162db",
                                                "sense_id": "efb1b31b-18da-3bac-9c45-8687922aa53b",
                                                "text": "Aujourd'hui, en de nombreuses localités, les hommes de métier ne forment plus guère de continuateurs et leur disparition serait pour l'Aveyron une cause de décadence de plus."
                                            },
                                            {
                                                "example_id": "62f1d155-8ac0-4bd4-9994-bfee74c23e52",
                                                "sense_id": "efb1b31b-18da-3bac-9c45-8687922aa53b",
                                                "text": "Notons en passant que le pâturage intensif amène une réduction notable et même la disparition de certaines Graminées (Koeleria, Festuca)."
                                            },
                                            {
                                                "example_id": "cdc6a3bb-bf52-4175-8c09-fb5535cf147c",
                                                "sense_id": "efb1b31b-18da-3bac-9c45-8687922aa53b",
                                                "text": "L'exposition en adret provoque la disparition du pergélisol et celui-ci s'y réduit comme une peau de chagrin et s'amincit."
                                            },
                                            {
                                                "example_id": "bd01f51c-6ca2-4e73-beb2-b9f0c36a9156",
                                                "sense_id": "efb1b31b-18da-3bac-9c45-8687922aa53b",
                                                "text": "— Vous voyez le petit bitoniau qui permet de passer du robinet à la douche ? Eh bien, il a disparu...\n— Très étrange, cette disparition, commente Emma. Personnellement, je ne connais aucun bitoniau qui parte se promener, comme ça, tout seul..."
                                            },
                                            {
                                                "example_id": "170c5436-28ee-4703-a39d-2571e9e9203e",
                                                "sense_id": "efb1b31b-18da-3bac-9c45-8687922aa53b",
                                                "text": ". On peut établir quelques nuances entre « extinction » et « disparition », le premier terme sous-entendant sans doute quelque chose de plus complet et définitif que le second. Ainsi, on pourra dire que l’ours brun a disparu (ou presque) des Pyrénées françaises, mais qu’il survit sur le versant espagnol, alors que lorsque l’on dit que le dodo de l’île Maurice est éteint, on sait très bien qu’il n’a subsisté nulle part et qu’on ne le reverra pas vivant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
