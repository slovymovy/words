                            {
                                "target_lang_word": "打补丁",
                                "target_lang_sense_clarification": "用材料填补破洞"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c998221-e97d-3293-8f6b-ead369658356",
                    "sense_definition": "To piece together or patch in a clumsy, haphazard manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "patch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The playwright had <w>clouted</w> together verses from various obscure sources into an awkward poem.",
                            "target_lang_translations": {
                                "zh": "剧作家从各种冷门出处生搬硬套，<w>拼凑</w>成了一首拙劣古怪的诗。"
                            }
                        },
                        {
                            "text": "Critics mocked the author for <w>clouting</w> several conflicting plots into one incoherent novel.",
                            "target_lang_translations": {
                                "zh": "评论家嘲笑作者把几个相互冲突的情节<w>胡乱拼凑</w>成一部前后矛盾的小说。"
                            }
                        }
                    ],
                    "synonyms": [
                        "botch",
                        "cobble"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historic sense meaning to patch clumsily"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "笨拙胡乱地拼凑或修凑"
                    },
                    "translations": {
                        "zh": [
