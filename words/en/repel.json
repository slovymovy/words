{
    "word_family": [
        "repellent",
        "repulsion",
        "repulsive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bfb7a53a-8449-368c-ae80-0ea6e9ed5a2b",
                    "sense_definition": "To drive back an attacking force or enemy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defensive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers managed to <w>repel</w> the enemy attack at the border.",
                            "target_lang_translations": {
                                "zh": "士兵们成功在边境<w>击退</w>了敌人的进攻。"
                            }
                        },
                        {
                            "text": "The army successfully <w>repelled</w> the <w>advancing</w> <w>force</w> during the night.",
                            "target_lang_translations": {
                                "zh": "军队在夜间成功<w>击退</w>了敌方的先遣部队。"
                            }
                        }
                    ],
                    "synonyms": [
                        "repulse",
                        "fend off"
                    ],
                    "common_phrases": [
                        "repel advancing force"
                    ],
                    "target_lang_definitions": {
                        "zh": "击退敌人的进攻或军事力量。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "击退",
                                "target_lang_sense_clarification": "用于军事或战斗语境，指成功抵御进攻。"
                            },
                            {
                                "target_lang_word": "抵御",
                                "target_lang_sense_clarification": "指防守并阻止敌方力量。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "546d4953-a3d3-364c-9a58-7daa462d2542",
                    "sense_definition": "To force something away using a physical or magnetic repulsive force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Like poles of a magnet <w>repel</w> each other.",
                            "target_lang_translations": {
                                "zh": "磁铁的同极会互相<w>排斥</w>。"
                            }
                        },
                        {
                            "text": "The special coating is designed to <w>repel</w> <w>water</w> <w>droplets</w> effectively.",
                            "target_lang_translations": {
                                "zh": "这种特殊涂层旨在有效<w>排斥</w>水滴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "push away"
                    ],
                    "antonyms": [
                        "attract"
                    ],
                    "common_phrases": [
                        "repel water"
                    ],
                    "target_lang_definitions": {
                        "zh": "利用物理或磁力将某物推开。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "排斥",
                                "target_lang_sense_clarification": "用于物理或磁学，指同性相斥。"
                            },
                            {
                                "target_lang_word": "排斥",
                                "target_lang_sense_clarification": "指表面处理以防止液体附着。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "126fe8ee-f351-3bf2-a5ff-8c5f67294765",
                    "sense_definition": "To cause someone to feel strong dislike or disgust.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smell of the rotting garbage <w>repelled</w> everyone who walked by.",
                            "target_lang_translations": {
                                "zh": "腐烂垃圾的气味让每个路过的人都感到<w>厌恶</w>。"
                            }
                        },
                        {
                            "text": "I was <w>repelled</w> by the <w>cruel</w> <w>behavior</w> shown in the video.",
                            "target_lang_translations": {
                                "zh": "视频中展现的残忍行为让我感到<w>反感</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disgust",
                        "revolt"
                    ],
                    "target_lang_definitions": {
                        "zh": "使人感到强烈的厌恶或反感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "厌恶",
                                "target_lang_sense_clarification": "指心理上产生强烈的反感。"
                            },
                            {
                                "target_lang_word": "反感",
                                "target_lang_sense_clarification": "指对某事或某人感到不快。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "515c87e7-e915-38d4-bfd7-a86d566beb98",
                    "sense_definition": "To ward off or prevent a negative influence or attack.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defensive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They used a special spray to <w>repel</w> mosquitoes during the hike.",
                            "target_lang_translations": {
                                "zh": "他们在徒步旅行时使用了一种特殊的喷雾来<w>驱赶</w>蚊子。"
                            }
                        },
                        {
                            "text": "The thick walls helped to <w>repel</w> the <w>harsh</w> <w>winter</w> <w>cold</w>.",
                            "target_lang_translations": {
                                "zh": "厚实的墙壁有助于<w>抵御</w>严冬的寒冷。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deter",
                        "ward off"
                    ],
                    "common_phrases": [
                        "repel mosquitoes"
                    ],
                    "target_lang_definitions": {
                        "zh": "驱赶或防止负面影响或攻击。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驱赶",
                                "target_lang_sense_clarification": "指将昆虫或害虫赶走。"
                            },
                            {
                                "target_lang_word": "抵御",
                                "target_lang_sense_clarification": "指防范恶劣环境或负面因素。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "457d16b8-e029-3e08-9156-0642c3195810",
                    "sense_definition": "To reject or refuse a request or demand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>repel</w> the proposal due to lack of funding.",
                            "target_lang_translations": {
                                "zh": "由于缺乏资金，委员会决定<w>驳回</w>该提案。"
                            }
                        },
                        {
                            "text": "The manager had to <w>repel</w> the <w>unreasonable</w> <w>demand</w> from the client.",
                            "target_lang_translations": {
                                "zh": "经理不得不<w>拒绝</w>了客户提出的无理要求。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reject",
                        "refuse"
                    ],
                    "target_lang_definitions": {
                        "zh": "拒绝或驳回某项请求或要求。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驳回",
                                "target_lang_sense_clarification": "指正式拒绝提案或申请。"
                            },
                            {
                                "target_lang_word": "拒绝",
                                "target_lang_sense_clarification": "指不接受某人的要求。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79b2bc6b-f3bf-3a75-9c10-85b97a2cacda",
                    "sense_definition": "To stop or block a shot in a sports context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goalkeeper managed to <w>repel</w> the powerful shot with his fingertips.",
                            "target_lang_translations": {
                                "zh": "守门员用指尖成功将那记强力射门<w>挡出</w>。"
                            }
                        },
                        {
                            "text": "The team <w>repelled</w> the <w>final</w> <w>shot</w> to secure the victory.",
                            "target_lang_translations": {
                                "zh": "球队<w>挡出</w>了最后一次射门，从而锁定了胜局。"
                            }
                        }
                    ],
                    "synonyms": [
                        "block",
                        "save"
                    ],
                    "common_phrases": [
                        "repel shot"
                    ],
                    "target_lang_definitions": {
                        "zh": "在体育比赛中挡住或扑出射门。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "挡出",
                                "target_lang_sense_clarification": "指守门员将球挡开。"
                            },
                            {
                                "target_lang_word": "扑出",
                                "target_lang_sense_clarification": "指守门员成功化解射门。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db5c9dbe-a19c-3d4d-8a10-87747e5bd1fa",
                    "sense_definition": "To turn someone away from a privilege, right, or position.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board chose to <w>repel</w> his application for the senior position.",
                            "target_lang_translations": {
                                "zh": "董事会决定<w>拒绝</w>他申请高级职位的请求。"
                            }
                        },
                        {
                            "text": "He felt <w>repelled</w> from the <w>exclusive</w> <w>club</w> without a clear reason.",
                            "target_lang_translations": {
                                "zh": "他感到自己被那个高级俱乐部<w>排斥</w>在外，却没有任何明确的理由。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deny",
                        "exclude"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in formal or historical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "拒绝某人获得特权、权利或职位。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拒绝",
                                "target_lang_sense_clarification": "指不予批准申请。"
                            },
                            {
                                "target_lang_word": "排斥",
                                "target_lang_sense_clarification": "指将某人排除在群体之外。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}