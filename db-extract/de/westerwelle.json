                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab2fb36d-b368-41d9-80fb-0f0ef52ee83e",
                                "sense_id": "c98d63f5-4b18-3052-aaa3-ea1aa685a06c",
                                "text": "Erst mal muss Westerwelle sich aus dem Zwang befreien, ständig im Internet nach Informationen zu seiner Krankheit zu suchen, die ihm seine Überlebenschance in Prozenten mitteilt."
                            },
                            {
                                "example_id": "0fb228e9-067c-479a-9f22-9729b0c513cd",
                                "sense_id": "c98d63f5-4b18-3052-aaa3-ea1aa685a06c",
                                "text": "\"Die Vereinten Nationen müssen die Welt widerspiegeln, wie sie ist, nicht wie sie war\", sagte Westerwelle am Samstag in New York."
                            }
                        ],
