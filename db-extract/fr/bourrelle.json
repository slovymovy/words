                "entry_id": "93958a51-d780-31ab-bce4-bdab8a273fc3",
                "word": "bourrelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b19219c-9041-43fd-b96c-9e245cab0624",
                        "entry_id": "93958a51-d780-31ab-bce4-bdab8a273fc3",
                        "tags": [
