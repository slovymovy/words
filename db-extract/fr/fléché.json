                ],
                "senses": [
                    {
                        "sense_id": "7dd59a57-11bc-39be-9802-e5d83e204dcb",
                        "entry_id": "ef3e96ce-f8d0-3f79-a4f5-26ae28309fb4",
                        "glosses": [
                            "Qui porte une flèche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eec3862f-2f01-46b9-900a-cee404c769c5",
                                "sense_id": "7dd59a57-11bc-39be-9802-e5d83e204dcb",
                                "text": "Qu'est-ce que l'existence, sinon un parcours plus ou moins fléché, plus ou moins balisé selon les êtres et les circonstances ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "28aeef8c-118f-34e6-9a05-d917fa6c24c2",
                        "entry_id": "ef3e96ce-f8d0-3f79-a4f5-26ae28309fb4",
                        "glosses": [
                            "(comptabilité publique) Se dit de recette ou de trésorerie ayant une affectation prédéterminée, ou des dépenses réalisées à ce titre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecb36550-7498-4ae4-98fb-b2b2c506ada2",
                                "sense_id": "28aeef8c-118f-34e6-9a05-d917fa6c24c2",
                                "text": "Mais la majeure partie de cet effort de relance est encore fléchée vers des projets traditionnels d’investissement."
                            },
                            {
                                "example_id": "4fdb28b8-ebeb-48bb-a027-e433ed8ebc64",
                                "sense_id": "28aeef8c-118f-34e6-9a05-d917fa6c24c2",
                                "text": "Les recettes fléchées constituent une exception au principe de globalisation des recettes et ont une utilisation prédéterminée par le financeur"
                            },
                            {
                                "example_id": "bec07e5a-0daf-42d4-8bd1-0597bc9b6daa",
                                "sense_id": "28aeef8c-118f-34e6-9a05-d917fa6c24c2",
                                "text": "Les opérations liées aux recettes fléchées doivent faire l’objet d’un suivi spécifique dès leur commencement et jusqu’à leur achèvement."
                            },
                            {
                                "example_id": "d4e8cf3b-b566-4ac7-96c0-fd7fea39d5b5",
                                "sense_id": "28aeef8c-118f-34e6-9a05-d917fa6c24c2",
                                "text": "80% des autorités locales ont constitué des réserves, en majorité fléchées, puis les ont beaucoup utilisées."
                            }
                        ]
                    },
                    {
                        "sense_id": "54972445-5426-3331-9c5c-9a70c309f02b",
                        "entry_id": "ef3e96ce-f8d0-3f79-a4f5-26ae28309fb4",
                        "glosses": [
                            "Se dit d'une pièce réalisée suivant la technique du fléché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a30e447-6a0a-44e5-9fda-a4552b9667e4",
                                "sense_id": "54972445-5426-3331-9c5c-9a70c309f02b",
                                "text": "La ceinture fléchée traditionnelle, dite de l'Assomption, est remarquable par sa taille."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ce7a2110-a6d4-3c09-afe2-253c4160bce2",
                "word": "fléché",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b76703e7-df8e-38db-bbc2-2b78aaea160f",
                        "entry_id": "ce7a2110-a6d4-3c09-afe2-253c4160bce2",
                        "glosses": [
                            "Technique de tressage, dans laquelle les brins sont entrecroisés en diagonale par rapport aux côtés de la pièce, et réalisent alternativement la trame et la chaîne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "761f53a6-49fc-4df9-855d-7ce6ab7a8151",
                                "sense_id": "b76703e7-df8e-38db-bbc2-2b78aaea160f",
                                "text": "Le fléché est une technique de tressage aux doigts. L'artisan(e) n'utilise aucun instrument contrairement à celui s'adonnant au tissage."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
