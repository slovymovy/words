                                    {
                                        "sense_id": "840b834c-fb02-379b-8007-d5d49f38424b",
                                        "entry_id": "bf6d471e-6da5-33df-bd23-a906e7fa00e5",
                                        "glosses": [
                                            "To inject with energy and enthusiasm."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b3643eb-8f4e-4369-8b9f-0219e19be4ef",
                                                "sense_id": "840b834c-fb02-379b-8007-d5d49f38424b",
                                                "text": "At least a couple of weeks since I last slept,\nKept takin' sleepers, but now I keep myself pepped."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d975191c-1039-3f55-bfb0-d6f31cd46d2e",
                                        "entry_id": "d2c11ad0-e4ae-33af-8411-6f6e949454e5",
                                        "glosses": [
                                            "Energy, high spirits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b824f55a-4bb2-42c8-aab8-047ed174aed4",
                                                "sense_id": "d975191c-1039-3f55-bfb0-d6f31cd46d2e",
                                                "text": "She was particularly pleased with the wine, which at not infrequent intervals she tasted. Beyond all doubt it promised to be of vintage quality. Clearly the long hot summer had put more than a little pep into the berries."
                                            }
                                        ]
                                    }
                                ]
