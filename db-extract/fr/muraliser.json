                        "glosses": [
                            "Donner un caractère mural à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78194b0e-97fe-4a45-be27-1c66dbd7a79a",
                                "sense_id": "a4df81a3-3519-39e9-ad88-658ff3aa8171",
                                "text": "je peux comprendre le désir de \"muraliser\" les prises électriques."
                            }
                        ]
                    },
                    {
                        "sense_id": "f76eab77-001c-3d8f-a7b2-f08468bb3afd",
                        "entry_id": "144c0e17-e547-3ba6-b232-af7a040813e8",
                        "glosses": [
                            "Faire des œuvres peintes murales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82441c4-70a5-4c8c-9b0d-5e0322abe1da",
                                "sense_id": "f76eab77-001c-3d8f-a7b2-f08468bb3afd",
                                "text": "Ce sentiment de \"créer\" de laisser une \"trace\" visible, la favorisation du contact humain avec les passants, sont autant d'éléments qui le motive à \"muraliser\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "c87037a7-d9f3-3a57-ba59-43e682f4d830",
                        "entry_id": "144c0e17-e547-3ba6-b232-af7a040813e8",
                        "glosses": [
                            "Se mettre à faire des œuvres peintes murales."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "1dfbe833-7feb-4b27-971d-737227d0d3be",
                                "sense_id": "c87037a7-d9f3-3a57-ba59-43e682f4d830",
                                "text": "Il commence à se muraliser en concevant quatre volets verticaux représentant les quatre saisons pour Léonce Rosenberg, son galeriste, qui lui fit découvrir De Stijl."
                            }
                        ]
                    }
