                "senses": [
                    {
                        "sense_id": "cfd81a86-fb16-3af7-ae58-0841f4bf51b8",
                        "entry_id": "573e5b6f-dc4f-35f3-bae1-1e6047ec7a55",
                        "glosses": [
                            "Verkehrsschild, das über die Richtung der Straßen Auskunft gibt und oft in der Nähe von Kreuzungen steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e1f1cee-d5a3-4336-b52d-6e1f5c887a57",
                                "sense_id": "cfd81a86-fb16-3af7-ae58-0841f4bf51b8",
                                "text": "„Während der Fahrt wird der Fahrzeugführer durch einen Vorwegweiser auf einen Tunnel mit der Tunnelkategorie C hingewiesen.“"
                            },
                            {
                                "example_id": "3f590b88-9230-4e18-b77e-8daad68f5252",
                                "sense_id": "cfd81a86-fb16-3af7-ae58-0841f4bf51b8",
                                "text": "„Nachdem sie die Kreuzung unfallfrei passiert hatten, gab ihnen ein Vorwegweiser darüber Auskunft, dass sie bald den Freizeitpark, Ostseite, erreichen würden.“"
                            },
                            {
                                "example_id": "29de0ac9-fb85-42d5-9862-f54827a1446c",
                                "sense_id": "cfd81a86-fb16-3af7-ae58-0841f4bf51b8",
                                "text": "„Auf einem Vorwegweiser liest sie, dass es noch drei Kilometer bis Akazienaue sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
