                        "sense_id": "5a5e9b0c-a8e8-36c6-b4c6-c5276cd14047",
                        "entry_id": "0798b1df-7814-3bbc-b905-13bef96158c6",
                        "glosses": [
                            "To deal insufficiently or inadequately; have dealings which are below requirement or expectation"
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "be6e0a49-f5b7-4ed4-91a3-7376434623ae",
                                "sense_id": "5a5e9b0c-a8e8-36c6-b4c6-c5276cd14047",
                                "text": "Another cause for sending bills late is that the Assessor could underdeal with property-owner by delaying assessment."
                            },
                            {
                                "example_id": "3c0edc50-9b24-49ab-b24c-258f3272ac2c",
                                "sense_id": "5a5e9b0c-a8e8-36c6-b4c6-c5276cd14047",
                                "text": "Extended family issues (Mom overdeals with his family and Dad underdeals with his family.)"
                            },
                            {
                                "example_id": "04b78830-a768-43f9-81f3-dda58fc7eac8",
                                "sense_id": "5a5e9b0c-a8e8-36c6-b4c6-c5276cd14047",
                                "text": "When one partner (usually the man) underdeals with a parent or family member, the other partner (usually the woman) is likely to overdeal with that same person."
                            }
                        ]
                    }
