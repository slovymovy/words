                "senses": [
                    {
                        "sense_id": "9e28a09b-11b8-308d-9e0f-d460797364db",
                        "entry_id": "b8d329a1-1ecd-3822-892d-7ba2bbc81321",
                        "glosses": [
                            "Cri du canard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e68fbece-7202-42a0-812b-8001378ba397",
                                "sense_id": "9e28a09b-11b8-308d-9e0f-d460797364db",
                                "text": "Ce matin, étendue sur les rochers noirs de Torshavn comme sur les rochers blancs de Malmousque, dans les rayons du soleil matinal, le teuf teuf animal d’une barque immobile, le cancanement discret de quelques canards flotteurs, avec l’île de Nolsoy en face comme le Château d’If, le clapotis gentil de la mer calme… même ennui à Torshavn qu’à Marseille, même morne sensation de vide, même panique nauséeuse, même attente désespérée."
                            }
                        ]
                    },
                    {
                        "sense_id": "35a4a1c0-0431-30dc-aa5b-07afd43e1adf",
                        "entry_id": "b8d329a1-1ecd-3822-892d-7ba2bbc81321",
                        "glosses": [
                            "Paroles confuses."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "400c85df-5f77-4efe-a68c-f5cc811fc866",
                                "sense_id": "35a4a1c0-0431-30dc-aa5b-07afd43e1adf",
                                "text": "Ah ! les longues, longues, lamentables vêpres, dans le cancanement des psaumes, la fadeur de l’encens, l’enluminure irisée des vitraux, le roulis ensommeillé des fidèles !"
                            }
                        ]
                    }
