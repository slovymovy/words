                        ],
                        "examples": [
                            {
                                "example_id": "6c1228b4-ed39-4872-92d8-fa5894481b7c",
                                "sense_id": "4a92479c-3ab1-35d4-a9f6-21e3c13a7fda",
                                "text": "--Reuben and the son were piking it down the quay next the river on their way to the Isle of Man boat and the young chiseller suddenly got loose and over the wall with him into the Liffey."
                            }
                        ]
                    }
                ],
