                ],
                "senses": [
                    {
                        "sense_id": "fba56051-057e-388b-bf42-ce7c1ce2a0ea",
                        "entry_id": "f1dd6017-4aab-3014-bc19-1d70f34fe59f",
                        "glosses": [
                            "in Deutschland zwischen Arbeitgeber und Gewerkschaft geschlossener Vertrag, in dem unter anderen die Löhne, die Arbeitszeiten, die Urlaubsansprüche und die Arbeitsbedingungen festgeschrieben sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "960a6e4f-e272-4035-adfc-6abf22e6259c",
                                "sense_id": "fba56051-057e-388b-bf42-ce7c1ce2a0ea",
                                "text": "„Ursprünglich wollten die Fluglotsen am Donnerstag von 6 bis 12 Uhr bundesweit die Arbeit niederlegen, nachdem sich die Gewerkschaft nicht mit der DFS auf einen neuen Tarifvertrag einigen konnte.“"
                            },
                            {
                                "example_id": "34f4937e-fcff-4aba-baee-53bc673f6116",
                                "sense_id": "fba56051-057e-388b-bf42-ce7c1ce2a0ea",
                                "text": "„Alle fünf Jahre verhandelt die MLB mit der Spielergewerkschaft einen neuen Tarifvertrag aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84a35a58-7266-44cd-abf7-fc7a2cdc0739",
                        "source_entry_id": "f1dd6017-4aab-3014-bc19-1d70f34fe59f",
                        "source_sense_id": "fba56051-057e-388b-bf42-ce7c1ce2a0ea",
