                    }
                ],
                "translations": [
                    {
                        "translation_id": "01bccb89-5012-4c8b-b0e7-827fc86b5e47",
                        "source_entry_id": "ace942e8-6a98-32c2-abd1-13712ea315db",
                        "source_sense_id": "ac22867b-2938-317d-8be9-e8286de5a0cb",
                        "source_sense_description": "Schrift für blinde Personen, bei der die Buchstaben ertastet werden können",
                        "target_lang_word": "Braille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Braille",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42c03e14-60a7-387d-87a0-7bcf854285c7",
                                        "entry_id": "681e3963-9f92-310f-a1bc-70f1625d9ca9",
                                        "glosses": [
                                            "Schrift für blinde Personen, bei der die Buchstaben kombinatorisch auf je sechs erhabenen, meist in Papier eingeprägten Punkten abgebildet sind, und daher ertastet werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ef3fb7-7741-4217-982b-d0e6e010052a",
                                                "sense_id": "42c03e14-60a7-387d-87a0-7bcf854285c7",
                                                "text": "„Da Russisch kein Q hat, kann es in Braille das Zeichen, das in lateinischen Schriften für Q (q) steht, für „tsch“ verwenden.“"
                                            },
                                            {
                                                "example_id": "8814eff5-5ffa-45a6-a8bf-4d87981b160f",
                                                "sense_id": "42c03e14-60a7-387d-87a0-7bcf854285c7",
                                                "text": "„Obwohl er schon seit anderthalb Jahren auf Braille bzw. eine große Lupe angewiesen war, faszinierte er seine neuen Freunde und Bekannten vor allem mit seiner ungeheuren Belesenheit: […].“"
                                            },
                                            {
                                                "example_id": "321f1b1e-893a-4e2d-a2a6-fe4b6129a0d2",
                                                "sense_id": "42c03e14-60a7-387d-87a0-7bcf854285c7",
                                                "text": "„Er lehnte jeden Vorschlag, sich auf Braille und andere Tasthilfmittel umzustellen, kategorisch ab, […].“"
                                            },
                                            {
                                                "example_id": "7f593cd4-53fc-4ae0-b81e-3059ae1f5203",
                                                "sense_id": "42c03e14-60a7-387d-87a0-7bcf854285c7",
                                                "text": "„Oder hol eine Stehleiter und schreib ihren Namen in Braille an die Decke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1576c41-450e-47c5-94d5-ddbcf1f5c8e3",
                        "source_entry_id": "ace942e8-6a98-32c2-abd1-13712ea315db",
                        "source_sense_id": "ac22867b-2938-317d-8be9-e8286de5a0cb",
