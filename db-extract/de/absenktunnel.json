                "senses": [
                    {
                        "sense_id": "65a2c974-9c84-3f8d-a6c6-9b171c1f30de",
                        "entry_id": "89ead2c2-9a8f-3f5a-acdf-30a4dc4962ab",
                        "glosses": [
                            "Tunnel, der aus an Land vorgefertigten Elementen besteht, die am Grund eines Gewässers zusammengefügt und verankert werden"
                        ],
                        "tags": [
                            "Bautechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "e61bf4be-aa80-4739-9b3d-14cb827c9266",
                                "sense_id": "65a2c974-9c84-3f8d-a6c6-9b171c1f30de",
                                "text": "„Es ist eines der größten Verkehrsvorhaben in Europa: der 18 Kilometer lange, sogenannte Absenktunnel für Autos, Lkw und Züge, der Fahrzeiten und -wege erheblich verkürzen kann.“"
                            },
                            {
                                "example_id": "eff4bbef-47cf-4b1a-b5c5-daf985a60afb",
                                "sense_id": "65a2c974-9c84-3f8d-a6c6-9b171c1f30de",
                                "text": "„Bei den jetzt unterzeichneten Verträgen geht es nach Angaben von Femern A/S um den gesamten Absenktunnel und die Tunnelelementefabrik, den Bau von Portalen und Rampen sowie den Aushub des Tunnelgrabens und Landgewinnungsarbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
