        "fr-extract.jsonl": [
            {
                "entry_id": "4f35606a-3858-31a6-9c4d-f624fff89761",
                "word": "micelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5118e36e-c798-4693-8cca-0a84cdebb8b9",
                        "entry_id": "4f35606a-3858-31a6-9c4d-f624fff89761",
                        "tags": [
                            "plural"
                        ],
                        "form": "micelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a4fd24d6-a019-34f3-a5fa-40f99efb8452",
                        "entry_id": "4f35606a-3858-31a6-9c4d-f624fff89761",
                        "glosses": [
                            "Agrégat sphéroïdal de molécules insolubles faiblement liées maintenues dans le solvant grâce à des agents qui les stabilisent, tels les détergents ou les macromolécules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88de1748-d21a-4913-a3b6-042fd4ed3165",
                                "sense_id": "a4fd24d6-a019-34f3-a5fa-40f99efb8452",
                                "text": "Les solutions colloïdales sont riches en micelles."
                            },
                            {
                                "example_id": "5041cec4-32e4-46f9-9498-fa649ee299d9",
                                "sense_id": "a4fd24d6-a019-34f3-a5fa-40f99efb8452",
                                "text": "Elles tendent à écarter les lignes et à raccourcir la molécule de dihydrol, car leur matière granulaire, avec l'état rotatoire prédominant du fascicule photonique qui ligature la micelle, tend à la sphériciser, au lieu de l’allonger, comme avec le fascicule magnétique étudié précédemment."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42cb95c3-121c-4330-8073-201575ba2a5b",
                        "source_entry_id": "4f35606a-3858-31a6-9c4d-f624fff89761",
                        "source_sense_id": "a4fd24d6-a019-34f3-a5fa-40f99efb8452",
                        "target_lang_word": "Mizelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mizelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1fa6b33-76ab-359b-a131-4235b60a8c14",
                                        "entry_id": "d7a0bd08-7eb4-3633-8f80-c63d1fd79312",
                                        "glosses": [
                                            "Aggregate (Assoziate) aus amphiphilen Molekülen bzw. grenzflächenaktiven Substanzen, die sich in einem Dispersionsmedium (meist Wasser) spontan zusammenlagern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1781007-a398-4bb5-ae9e-b3212c0a54dc",
                                                "sense_id": "b1fa6b33-76ab-359b-a131-4235b60a8c14",
                                                "text": "Bei der Fettverdauunung entstehen zudem mit Hilfe von Gallensalzen Mizellen."
                                            },
                                            {
                                                "example_id": "e5b317dc-9719-4035-ba40-e37f1616144f",
                                                "sense_id": "b1fa6b33-76ab-359b-a131-4235b60a8c14",
                                                "text": "Zunächst bilden sich annähernd kugelförmige Mizellen, mit den hydrophilen Gruppen an der Oberfläche und nach innen weisenden Alkylgruppen."
                                            },
                                            {
                                                "example_id": "7fea8477-0582-4b67-bce8-eb21c7ba36e4",
                                                "sense_id": "b1fa6b33-76ab-359b-a131-4235b60a8c14",
                                                "text": "Die Mizellen sind an ihrer Oberfläche positiv elektrisch geladen und ordnen sich paralel aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
