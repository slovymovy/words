                "senses": [
                    {
                        "sense_id": "5a7e141c-f35c-31c3-92d9-4276a02d7c53",
                        "entry_id": "3467ffe3-27a9-3e1c-881e-94995459b33e",
                        "glosses": [
                            "Appareil permettant de déterminer la fréquence cardiaque instantanée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "820ae3bc-d81f-45ab-9454-e2ebd71d02d9",
                                "sense_id": "5a7e141c-f35c-31c3-92d9-4276a02d7c53",
                                "text": "Tous les sujets étaient reliés à des cardiofréquencemètres et leurs ordinateurs étaient équipés de capteurs relevant la fréquence à laquelle les sujets passaient d’une fenêtre à l’autre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "191fb7c0-2377-4903-b37a-b0028eebca00",
                        "source_entry_id": "3467ffe3-27a9-3e1c-881e-94995459b33e",
                        "source_sense_id": "5a7e141c-f35c-31c3-92d9-4276a02d7c53",
                        "target_lang_word": "Herzfrequenzmessgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzfrequenzmessgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be59e0c8-4d3a-3e8b-9079-3112964fe52b",
                                        "entry_id": "7f2fba1c-5c36-3075-b40d-cee8eee915a2",
                                        "glosses": [
                                            "am Körper zu tragendes Gerät, das den Puls einer Person misst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "364cf381-f80e-4452-b077-ab078a0a85b1",
                                                "sense_id": "be59e0c8-4d3a-3e8b-9079-3112964fe52b",
                                                "text": "„Der Zwölfjährige trägt ein Herzfrequenzmessgerät, weil sein Herz plötzlich nachts schnell und heftig schlug.“"
                                            },
                                            {
                                                "example_id": "b6edddf4-b670-4f40-8be8-3e8bd53dcb47",
                                                "sense_id": "be59e0c8-4d3a-3e8b-9079-3112964fe52b",
                                                "text": "„Als Anfang der achtziger Jahre die ersten teuren Herzfrequenzmessgeräte für das Handgelenk auf den Markt kamen, hat das die Trainingswissenschaft im Freizeitbereich revolutioniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "529dd57a-b418-4d32-aa7e-f13b603d9c20",
                        "source_entry_id": "3467ffe3-27a9-3e1c-881e-94995459b33e",
                        "source_sense_id": "5a7e141c-f35c-31c3-92d9-4276a02d7c53",
                        "target_lang_word": "Pulsmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pulsmesser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6eefe3a4-ed83-369d-a83f-d4a140086926",
                                        "entry_id": "090fa824-c30a-34ac-b622-4c2e04290c2d",
                                        "glosses": [
                                            "am Körper zu tragendes Gerät, das den Puls einer Person misst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32b08de7-d141-400b-bd0c-d231523e0246",
                                                "sense_id": "6eefe3a4-ed83-369d-a83f-d4a140086926",
                                                "text": "„Mit Hilfe der Pulsmesser sollen Lehrer feststellen können, ob sich die Schüler ausreichend bewegt haben.“"
                                            },
                                            {
                                                "example_id": "ea67c02c-6dcf-4549-a69b-10902c6a07df",
                                                "sense_id": "6eefe3a4-ed83-369d-a83f-d4a140086926",
                                                "text": "„Als Geschenk bekam der knapp 60-jährige Ruheständler einen Pulsmesser, der ihn vor Überanstrengungen bewahren soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a31c7bd-1776-4ff6-879d-3a7364fe286d",
                        "source_entry_id": "3467ffe3-27a9-3e1c-881e-94995459b33e",
                        "source_sense_id": "5a7e141c-f35c-31c3-92d9-4276a02d7c53",
                        "target_lang_word": "Pulsometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pulsometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                                        "entry_id": "b3539a5d-ce3e-3817-9a4c-8539e903dc7b",
                                        "glosses": [
                                            "kolbenlose Vorrichtung zum Heben von Flüssigkeiten mithilfe von Wasserdampf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edca6e5f-13d7-44e0-a6c2-81e888c8eb37",
                                                "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                                                "text": "„Eine direkte Hebung des Wassers durch Dampf ist möglich durch das Pulsometer.“"
                                            },
                                            {
                                                "example_id": "61666550-bbce-4099-8d77-59c535d1b756",
                                                "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                                                "text": "„Ein Pulsometer zum Betrieb von einer Lokomotive aus mittels einer unterirdisch verlegten Leitung, ist in Bereitschaft.“"
                                            },
                                            {
                                                "example_id": "2294fdda-f16e-41b8-9e8b-1ad04a3e4df0",
                                                "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                                                "text": "„Pulsometer sind kolbenlose Dampfpumpen mit zwei Kammern, in die der Dampf abwechselnd eintritt, wobei er die Flüssigkeit herausdrückt.“"
                                            },
                                            {
                                                "example_id": "79f7ee4a-b5e0-4975-969b-ebc2a9cdfefe",
                                                "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                                                "text": "„Die gewöhnliche Pumpe war, da sie 1,2 m unter Wasser stand, unbrauchbar geworden, und schien in Folge dessen der Pulsometer die einzige Rettung zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
