                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45dc2f98-9763-3702-a01d-a81c28157ac3",
                                        "entry_id": "bf7dd2ec-cfad-3c8e-b3e7-5218ec73a452",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße ausdrucksstarkes (expressives) Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0890ad79-0126-4f9f-a3c9-be267646c80b",
                                                "sense_id": "45dc2f98-9763-3702-a01d-a81c28157ac3",
                                                "text": "„Die Expressivität der Sprache, d.h. ihre Fähigkeit, neben Gedanken auch Gefühle und emotionale Einstellungen der kommunizierenden Personen auszudrücken, stellt ein wichtiges, jedoch vernachlässigtes Kapitel der linguistischen Forschung dar.“"
                                            },
                                            {
                                                "example_id": "e7f0465c-6570-4655-95dc-bb084054c8df",
                                                "sense_id": "45dc2f98-9763-3702-a01d-a81c28157ac3",
                                                "text": "„Ihre Expressivität ist lustbetont, aktionsbezogen und auf spielerische Art gewalttätig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e9f0942-083f-3031-9948-796effa39f01",
                                        "entry_id": "bf7dd2ec-cfad-3c8e-b3e7-5218ec73a452",
                                        "glosses": [
                                            "Grad der Sichtbarkeit"
                                        ],
                                        "tags": [
                                            "über Erbanlagen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58df0a40-26b6-46f7-85cd-7565b9240c61",
                                                "sense_id": "1e9f0942-083f-3031-9948-796effa39f01",
                                                "text": "„Die Expressivität gibt den Grad an, mit dem eine bestimmte Merkmalsausprägung oder Verhaltensform auftritt. Eine hohe Expressivität besagt demnach, daß eine genotypisch vorgegebene Bandbreite oder ein Dispositionsspielraum auf phänotypischer Ebene voll ausgeschöpft wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
