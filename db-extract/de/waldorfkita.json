                        "glosses": [
                            "Kindertagesstätte, die nach der Waldorfpädagogik erzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3e1b008-4f45-4cd5-ba25-a94e07f78c4a",
                                "sense_id": "959bfc09-2712-35eb-ac86-52f577fda580",
                                "text": "„Dem frühen Einsatz elektronischer und audio-visueller Medien stehen die Waldorfkitas skeptisch bis ablehnend gegenüber.“"
                            },
                            {
                                "example_id": "db92b55b-39c9-4fde-b968-2162d5ad8e3f",
                                "sense_id": "959bfc09-2712-35eb-ac86-52f577fda580",
                                "text": "„Dass es kleineren Kindergärten in Flensburg leichter fällt, die im Januar gestartete Qualitätsoffensive schnell umzusetzen, zeigt das Beispiel der Waldorfkita an der Valentiner Allee.“"
                            }
