                        "sense_id": "89b45741-87e9-3e4e-8fcc-046bd0191018",
                        "entry_id": "4ce2bd6b-a956-3dd3-b992-01a78f35a138",
                        "glosses": [
                            "Fruit de cet arbrisseau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48195053-89b6-4266-92d1-421489adf8bf",
                                "sense_id": "89b45741-87e9-3e4e-8fcc-046bd0191018",
                                "text": "Le goji ou baie de goji est un fruit venu de Chine aux vertus exceptionnelles parait-t-il."
                            }
                        ]
                    }
