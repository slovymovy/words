                "senses": [
                    {
                        "sense_id": "af943d14-7935-3f00-ac3d-8b56af43c6c6",
                        "entry_id": "fd7173f8-8bd2-353b-953f-ad36124d24a3",
                        "glosses": [
                            "To make or become low."
                        ],
                        "tags": [
                            "ambitransitive",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "60cbdbbb-df06-421f-a913-881b49508ebc",
                                "sense_id": "af943d14-7935-3f00-ac3d-8b56af43c6c6",
                                "text": "[…] and a wide ware or float can be put down in lieu thereof, of the same height as the said water gates or floats when lowened, and of the exact width and other dimensions as the present float at Wangford mill, and in the same manner as the float at Wangford mill; […]"
                            },
                            {
                                "example_id": "24f9e686-2e68-4e3c-8a36-c126912b44cb",
                                "sense_id": "af943d14-7935-3f00-ac3d-8b56af43c6c6",
                                "text": "Must I be lowened from the clouds dazzling\nOlympus' heights unto the apex point\nWhich man nor scales, Joveward, save when we fill\nHis soul on wing with swiftly-thinning air,\nWherein gross mortal parts retard the rise?"
                            },
                            {
                                "example_id": "770fd84a-5511-404e-bb48-fdcfd9fc2819",
                                "sense_id": "af943d14-7935-3f00-ac3d-8b56af43c6c6",
                                "text": "And in the morning it will be foul weather to-day; for the sky is red and lowening."
                            }
                        ]
                    }
                ],
