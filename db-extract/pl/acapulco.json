                    },
                    {
                        "translation_id": "c7a269f8-7ccb-4e68-8793-0fa9364965eb",
                        "source_entry_id": "e954066d-25e9-3d13-bddb-e2afe797f57a",
                        "source_sense_id": "b96b0a3f-e0fd-3420-8d77-4e18c9fe72e8",
                        "target_lang_word": "Акапулько",
                        "target_lang_code": "ru",
