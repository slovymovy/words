                ],
                "senses": [
                    {
                        "sense_id": "94f8e96a-a343-35a1-8e26-52f1bf3c26b2",
                        "entry_id": "839534e5-69c2-330c-975e-6d131a583fb0",
                        "glosses": [
                            "Vorrichtung, die es ermöglicht, Informationen (Daten, akustische oder visuelle Medien) in einem Netz auszutauschen, ohne für dessen Funktionieren notwendig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7d74126-03cf-4ee4-80c6-08f6cf5c0c25",
                                "sense_id": "94f8e96a-a343-35a1-8e26-52f1bf3c26b2",
                                "text": "„Über ein landeseigenes Förderprogramm wegen der Corona-Pandemie wurden seit Januar 2021 weitere gut 22.000 mobile Endgeräte für die Schulen angeschafft.“"
                            },
                            {
                                "example_id": "193aa9d2-098c-443f-b1a0-413203f0406e",
                                "sense_id": "94f8e96a-a343-35a1-8e26-52f1bf3c26b2",
                                "text": "„Über Antrag hat das Zulassungsbüro festzustellen, ob ein Endgerät den technischen Anforderungen gemäß § 3 entspricht und zur Verbindung mit dem öffentlichen Fernmeldenetz geeignet ist.“"
                            },
                            {
                                "example_id": "049e46cf-0112-4255-9be1-aed07792f379",
                                "sense_id": "94f8e96a-a343-35a1-8e26-52f1bf3c26b2",
                                "text": "„Dass nicht alle technischen Vorgänge an ein und demselben Ort erfolgen, bedeutet nicht, dass das Faktum des Betreibens eines Spielapparates im Sinne des Wiener Vergnügungssteuergesetzes nicht an dem Ort erfolgt, an dem das jeweilige Endgerät steht ([…].“"
                            },
                            {
                                "example_id": "16a52f08-b62f-4509-ba6d-785c3b8c21fc",
                                "sense_id": "94f8e96a-a343-35a1-8e26-52f1bf3c26b2",
                                "text": "„Jesus, jetzt bin ich schon dreimal ins Büro und wieder hinausgegangen, weil ich solche Widerstände habe, den Rechner hochzufahren. Als wäre das Endgerät schuld am Internet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
