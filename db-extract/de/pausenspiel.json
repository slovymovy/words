                "senses": [
                    {
                        "sense_id": "49033763-d126-3fc2-a075-c4dccb4942ae",
                        "entry_id": "509fb422-67d8-3890-a6e4-0004999bea88",
                        "glosses": [
                            "entspannende Freizeitbetätigung zwischen zwei Arbeitsgängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69213ac5-d6f7-4967-9f88-18f83248b8ff",
                                "sense_id": "49033763-d126-3fc2-a075-c4dccb4942ae",
                                "text": "„Während seine Teamkollegen in Pekings Wukesong-Arena über die nächsten Spielzüge beraten, beobachtet der 2,29 Meter große Basketballer eines der vielen Pausenspiele, die sich die US-amerikanische Profiliga NBA ausgedacht hat, um die Zuschauer unaufhörlich zu bespaßen.“"
                            },
                            {
                                "example_id": "013c1f5c-f783-4894-b33a-00afbdb06ed6",
                                "sense_id": "49033763-d126-3fc2-a075-c4dccb4942ae",
                                "text": "„Gedacht sind die Pausenspiele eigentlich für die Grundschule: eine Kassette mit handlichen Karteikarten, die in der Klasse ihren festen Platz hat und aus der sich die Kinder selbstständig nach dem Pausenklingeln bedienen.“"
                            },
                            {
                                "example_id": "496c8f16-b948-4aaf-b2d7-017dcddbb59f",
                                "sense_id": "49033763-d126-3fc2-a075-c4dccb4942ae",
                                "text": "„Auch in Situationen, in denen man vor einer unangenehmen Aufgabe steht, lässt sich die Motivation vielleicht durch ein kurzes Pausenspiel aufbauen.“"
                            },
                            {
                                "example_id": "00e7b1e1-e95f-4c3b-b414-2b8fa8ca4d8e",
                                "sense_id": "49033763-d126-3fc2-a075-c4dccb4942ae",
                                "text": "„Aber neuerdings ist vor dem zögersamen Pausenspiel zu warnen, das im Deutschen Theater immer mehr um sich greift und selbst dem Solospiel der Episodisten unbegrenzten Raum gewährt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
