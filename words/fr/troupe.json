                    "semantic_group_id": "groupe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>troupe</w> d'enfants joyeux traversait le parc en chantant."
                        },
                        {
                            "text": "Les manifestants marchaient en <w>troupe</w> vers le centre de la ville."
