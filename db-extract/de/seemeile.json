                                        "sense_id": "d62747f7-e714-328b-b12d-08eaab86b913",
                                        "entry_id": "a2e56771-e13f-3a4a-b1f8-74cf10e90cff",
                                        "glosses": [
                                            "Synonym of nautical mile, a unit of distance now equal to exactly 1852 meters"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2a6086e-9793-35cc-a479-1c8a586693b0",
                                        "entry_id": "a2e56771-e13f-3a4a-b1f8-74cf10e90cff",
                                        "glosses": [
                                            "A former version of the nautical mile in Scandinavia equal to 4 minutes of arc or about 4 nmi."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b870cc26-2815-40ed-a9c0-b050c82ca4ef",
                        "source_entry_id": "9b5c30fd-f5f5-378b-b4d1-0544cf0f3e9e",
                        "source_sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
                        "source_sense_description": "Längenmaß aus der Seefahrt",
                        "target_lang_word": "nautical mile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nautical mile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b168166-7dd7-36c1-8bc4-72e09e6dd6dd",
                                        "entry_id": "c8f118ba-65f8-314e-bb7d-46d4c7e938fb",
                                        "glosses": [
                                            "A unit of length corresponding approximately to one minute of arc of latitude along any meridian. By international agreement it is exactly 1,852 metres (approximately 6,076 feet or 1.151 statute mile)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6649c446-c2c4-4482-ad6a-8dcb1a48f8b5",
                                                "sense_id": "0b168166-7dd7-36c1-8bc4-72e09e6dd6dd",
                                                "text": "Near-synonym: geographical mile (very close to the same distance)"
                                            },
                                            {
                                                "example_id": "9d006622-13bf-4887-81f5-38b4c848a181",
                                                "sense_id": "0b168166-7dd7-36c1-8bc4-72e09e6dd6dd",
                                                "text": "Personnel trenches have been constructed or improved in Tantung (40-05-50N 124-21-30E) and along roads 13 nautical miles (nm) south-southwest of Tantung and 1.5 nm west of the border (Figures 2 and 3)."
                                            },
                                            {
                                                "example_id": "a533fa59-8645-4b1f-ba77-07ef3107d8bb",
                                                "sense_id": "0b168166-7dd7-36c1-8bc4-72e09e6dd6dd",
                                                "text": "An even more impressive nineteenth-century militarized lighthouse is found on the Taiwanese Wuchiu island, located just 20 nautical miles off the Chinese coast. While much of the surrounding military structure has been demolished, its black tower and high walls painted in camouflage colours stand as reminders of the contested history of this small frontier island."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868b15ac-2626-3799-a3af-9df06ca28e26",
                                        "entry_id": "c8f118ba-65f8-314e-bb7d-46d4c7e938fb",
                                        "glosses": [
                                            "Synonym of sea mile, a historical Scandinavian unit of distance equal to about 4 nmi."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "255114d4-9bf7-4aba-915e-82ec8cceb3ae",
                        "source_entry_id": "9b5c30fd-f5f5-378b-b4d1-0544cf0f3e9e",
                        "source_sense_id": "3876c7d6-71e2-3438-98b6-3de286df123b",
