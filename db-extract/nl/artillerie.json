                "senses": [
                    {
                        "sense_id": "36e11d41-dbbb-37d6-ad49-ec37a1b4d2bd",
                        "entry_id": "44381b81-5884-36b3-bcb2-1a4fe061ed7b",
                        "glosses": [
                            "het wapen dat vuursteun geeft aan de eigen troepen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd591477-1c6f-4b40-a4bd-991bca7f6855",
                                "sense_id": "36e11d41-dbbb-37d6-ad49-ec37a1b4d2bd",
                                "text": "De artillerie schoot er flink op los."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1a54207-1a6b-497a-989d-6fae91ac37a2",
                        "source_entry_id": "44381b81-5884-36b3-bcb2-1a4fe061ed7b",
                        "source_sense_id": "36e11d41-dbbb-37d6-ad49-ec37a1b4d2bd",
                        "source_sense_description": "het wapen dat vuursteun geeft aan de eigen troepen",
                        "target_lang_word": "Artillerie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Artillerie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65e6af69-505f-3aa3-8a28-0132573467a9",
                                        "entry_id": "51614d2b-9339-3bc6-8b62-1dd0b6975021",
                                        "glosses": [
                                            "die Waffengattung der Geschütze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d17508dc-a31e-4dc9-8db5-6af650f0ad73",
                                                "sense_id": "65e6af69-505f-3aa3-8a28-0132573467a9",
                                                "text": "„Die englische Artillerie ist verstärkt, das hören wir sofort.“"
                                            },
                                            {
                                                "example_id": "1428044d-9609-451f-a7d3-718d9e6eece7",
                                                "sense_id": "65e6af69-505f-3aa3-8a28-0132573467a9",
                                                "text": "„Wenn sie Glück hatten, würde die japanische Artillerie nicht schießen, und vielleicht waren nicht allzu viele Scharfschützen zurückgelassen worden.“"
                                            },
                                            {
                                                "example_id": "7f7adbd3-8cbe-44fb-aee3-9af5d856b014",
                                                "sense_id": "65e6af69-505f-3aa3-8a28-0132573467a9",
                                                "text": "„Am nächsten Morgen melde ich mich bei der Artillerie, der Arzt untersucht mich, schüttelt den Kopf, ich habe Angst, daß ich nicht angenommen werde, ich sage, der Augenschein trügt, ich bin stark und gesund, ich will in den Krieg.“"
                                            },
                                            {
                                                "example_id": "db006df9-a35c-45ee-800f-81d3d805c224",
                                                "sense_id": "65e6af69-505f-3aa3-8a28-0132573467a9",
                                                "text": "„Bei der Artillerie müßten sie gut rechnen können.“"
                                            },
                                            {
                                                "example_id": "64d3f418-65a1-41c4-a7f6-bfd91588f55c",
                                                "sense_id": "65e6af69-505f-3aa3-8a28-0132573467a9",
                                                "text": "„Das Heer besteht aus vier Waffengattungen: dem Fussvolke (Infanterie), der Reiterei (Kavallerie), dem Geschützwesen (Artillerie) und dem Kriegsbauwesen (Genie, Ingenieure), welches letztere die Vertheidigung und den Angriff der festen Plätze leitet.“ (1834)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a67310ed-12f5-34cd-9e10-be8f9752d763",
                                        "entry_id": "51614d2b-9339-3bc6-8b62-1dd0b6975021",
                                        "glosses": [
                                            "schweres Geschütz, Geschütze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3711c5da-134d-4e69-be66-240e62398e83",
                                                "sense_id": "a67310ed-12f5-34cd-9e10-be8f9752d763",
                                                "text": "Wir müssen Artillerie auffahren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1fac1ea-930c-4cdb-a0ac-78083d6c6f03",
                        "source_entry_id": "44381b81-5884-36b3-bcb2-1a4fe061ed7b",
