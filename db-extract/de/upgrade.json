                    {
                        "sense_id": "1fd483f0-4ee6-3b21-a639-141fba36d519",
                        "entry_id": "698bb4c9-16e5-3512-a111-909c79c4ed27",
                        "glosses": [
                            "das Einspielen einer neuen Version einer Basissoftware, die gegenüber dem vorigen Softwarestand erweiterte Funktionalitäten enthält"
                        ],
                        "tags": [
                            "Software"
                        ],
                        "examples": [
                            {
                                "example_id": "dffb3791-2c77-467c-ba31-d09300c0b5cb",
                                "sense_id": "1fd483f0-4ee6-3b21-a639-141fba36d519",
                                "text": "„Mit der roten Taste wählst du die Upgrades aus und mit der grünen Taste änderst du die Position der Drohnen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "51acb1c2-3977-3ef5-ae76-8014eb05a4b5",
                        "entry_id": "698bb4c9-16e5-3512-a111-909c79c4ed27",
