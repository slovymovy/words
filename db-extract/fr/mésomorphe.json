            {
                "entry_id": "22170d43-9172-370a-a69d-86e36ed019f8",
                "word": "mésomorphe",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "42070f93-19ad-44e6-8c8c-d372306168ba",
                        "entry_id": "22170d43-9172-370a-a69d-86e36ed019f8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "mésomorphes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8f368c7-5b52-38be-a0cb-c843b866c839",
                        "entry_id": "22170d43-9172-370a-a69d-86e36ed019f8",
                        "glosses": [
                            "État de la matière intermédiaire entre le solide et le liquide. Cristal liquide."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "a1c4380d-dce5-465f-b27a-5ec35ea88821",
                                "sense_id": "d8f368c7-5b52-38be-a0cb-c843b866c839",
                                "text": "Un polymère mésomorphe nématique."
                            }
                        ]
                    },
                    {
                        "sense_id": "af9518d1-5a34-33da-831d-36516a2b43be",
                        "entry_id": "22170d43-9172-370a-a69d-86e36ed019f8",
                        "glosses": [
                            "Qualifie un corps moyen ni trop gros ni trop mince."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f5ae325-c618-4fed-b70f-71ba55e07f2e",
                                "sense_id": "af9518d1-5a34-33da-831d-36516a2b43be",
                                "text": "Le type mésomorphe est de nature énergique et prend facilement de la masse musculaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80abc99c-d614-4aff-9d8c-f53fe90a3dcb",
                        "source_entry_id": "22170d43-9172-370a-a69d-86e36ed019f8",
                        "source_sense_description": "ni gros ni mince",
                        "target_lang_word": "mesomorphic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mesomorphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87109a07-78d0-31d9-ad1f-5dc51b554c16",
                                        "entry_id": "6f6001cc-93b0-312c-a92f-803f54b91e1d",
                                        "glosses": [
                                            "Of or pertaining to a mesomorph."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b907884b-1b48-4e2f-a7ee-2523604893c4",
                                                "sense_id": "87109a07-78d0-31d9-ad1f-5dc51b554c16",
                                                "text": "For instance, compared to the typical ectomorphic or endomorphic child, the mesomorphic boy or girl may have more energy and a greater motivation for vigorous play with peers."
                                            },
                                            {
                                                "example_id": "faf4096c-5b81-419e-aef0-e4f8a1b1ff19",
                                                "sense_id": "87109a07-78d0-31d9-ad1f-5dc51b554c16",
                                                "text": "An average man is more mesomorphic than the phantom whereas the average woman is more endomorphic than the phantom (see figure 3.2)."
                                            },
                                            {
                                                "example_id": "c944cc19-76ae-45b9-95c4-00795316faa6",
                                                "sense_id": "87109a07-78d0-31d9-ad1f-5dc51b554c16",
                                                "text": "Players in the best teams were less endomorphic and more mesomorphic than those in the worst teams, but forwards and backs in the best teams did not differ in somatotype."
                                            },
                                            {
                                                "example_id": "85403741-496c-4a5f-8186-e8b1fb7f8877",
                                                "sense_id": "87109a07-78d0-31d9-ad1f-5dc51b554c16",
                                                "text": "Studies have found that elite athletes can be primarily mesomorphic with ectomorphic qualities or primarily mesomorphic with endomorphic qualities."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mesomorphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46808042-c1c9-3dcd-8de8-dc58be66d7d5",
                                        "entry_id": "eeb71c6f-3832-38e1-b567-ab937b096829",
                                        "glosses": [
                                            "Of or pertaining to phases of matter intermediate between solid and liquid; of or pertaining to liquid crystals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac1490a4-4b57-4dc3-babd-d0316cd983bc",
                                                "sense_id": "46808042-c1c9-3dcd-8de8-dc58be66d7d5",
                                                "text": "1958, Chemical Society (Great Britain), G. W. Gray, Steric Effects in Conjugated Systems, page 161,\nChanges in the chemical constitution of a mesomorphic compound may therefore radically alter the mesomorphic properties and thermal stabilities."
                                            },
                                            {
                                                "example_id": "883a1c0d-fb28-44a2-9b7c-cdae20118daf",
                                                "sense_id": "46808042-c1c9-3dcd-8de8-dc58be66d7d5",
                                                "text": "1993, Nikolaĭ Alʹfredovich Platė (editor, original Russian edition), S. L. Schnur (translator), Liquid-Crystal Polymers, page 132,\nThis x-ray is typical of mesomorphic structures which occupy an intermediate position between crystalline and amorphous with respect to the degree of order."
                                            },
                                            {
                                                "example_id": "c29ac327-b3f2-448b-90e7-fba8dee1e73f",
                                                "sense_id": "46808042-c1c9-3dcd-8de8-dc58be66d7d5",
                                                "text": "The thermodynamic conditions under which such a mesomorphic phase can interfere and affect the crystallization process are described in Fig. 5.40."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f79927a-bb50-42bc-bbab-c5c6376585aa",
                        "source_entry_id": "22170d43-9172-370a-a69d-86e36ed019f8",
