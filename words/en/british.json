{
    "word_family": [
        "Britain",
        "Briton",
        "Brit",
        "Britishness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "158bab37-cea7-377a-91d9-232839425c02",
                    "sense_definition": "Relating to the United Kingdom of Great Britain and Northern Ireland, its inhabitants, or their culture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uk_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She holds a <w>British</w> passport and travels often.",
                            "target_lang_translations": {
                                "ru": "У нее <w>британский</w> паспорт, и она часто путешествует.",
                                "zh": "她持有<w>英国</w>护照，经常旅行。"
                            }
                        },
                        {
                            "text": "We learned about the <w>British</w> Empire in history class.",
                            "target_lang_translations": {
                                "ru": "Мы изучали <w>Британскую</w> империю на уроке истории.",
                                "zh": "我们在历史课上学习了<w>大英</w>帝国。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "British Empire",
                        "British Isles",
                        "British citizen",
                        "British accent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Соединенному Королевству Великобритании и Северной Ирландии, его жителям или их культуре.",
                        "zh": "与大不列颠及北爱尔兰联合王国、其居民或其文化相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брита́нский",
                                "target_lang_sense_clarification": "относящийся к Великобритании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "英国的",
                                "target_lang_sense_clarification": "指与英国相关的"
                            },
                            {
                                "target_lang_word": "英式的",
                                "target_lang_sense_clarification": "指具有英国风格或特征的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48a5b73f-e2a6-3d62-9a7a-bf0310b5fcb3",
                    "sense_definition": "Relating to the ancient inhabitants of southern Britain or their language.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ancient_history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists discovered <w>British</w> artifacts from the Iron Age.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили <w>бриттские</w> артефакты железного века.",
                                "zh": "考古学家发现了铁器时代的<w>布立吞</w>文物。"
                            }
                        },
                        {
                            "text": "The <w>British</w> tribes resisted the Roman invasion.",
                            "target_lang_translations": {
                                "ru": "<w>Бриттские</w> племена сопротивлялись римскому вторжению.",
                                "zh": "<w>布立吞</w>部落抵抗了罗马人的入侵。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "refers to ancient history"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к древним жителям южной Британии (бриттам) или их языку.",
                        "zh": "与古代不列颠南部居民（布立吞人）或其语言相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бри́ттский",
                                "target_lang_sense_clarification": "относящийся к древним бриттам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布立吞的",
                                "target_lang_sense_clarification": "指古代不列颠民族"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "471b816c-b8ad-3d16-945d-0b9e15b31c5a",
                    "sense_definition": "The people who inhabit Great Britain or are citizens of the United Kingdom, considered collectively.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>British</w> are known for their politeness and queuing habits.",
                            "target_lang_translations": {
                                "ru": "<w>Британцы</w> известны своей вежливостью и привычкой соблюдать очередь.",
                                "zh": "<w>英国人</w>以礼貌和排队的习惯而闻名。"
                            }
                        },
                        {
                            "text": "Many <w>British</w> choose to spend their holidays in Spain.",
                            "target_lang_translations": {
                                "ru": "Многие <w>британцы</w> предпочитают проводить отпуск в Испании.",
                                "zh": "许多<w>英国人</w>选择去西班牙度假。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Britons",
                        "Brits"
                    ],
                    "common_phrases": [
                        "the British"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, населяющие Великобританию, или граждане Соединенного Королевства (как собирательное понятие).",
                        "zh": "居住在大不列颠岛的人或联合王国的公民（集合名词）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брита́нцы",
                                "target_lang_sense_clarification": "народ, население Великобритании"
                            },
                            {
                                "target_lang_word": "брита́нец",
                                "target_lang_sense_clarification": "житель Великобритании (мужской род)"
                            },
                            {
                                "target_lang_word": "брита́нка",
                                "target_lang_sense_clarification": "жительница Великобритании (женский род)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "英国人",
                                "target_lang_sense_clarification": "英国国民或居民"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "eff677ed-9b20-3440-a475-1b23abcf528b",
                    "sense_definition": "The English language as it is spoken and written in the United Kingdom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "language_modern",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "This dictionary focuses on <w>British</w> spelling conventions.",
                            "target_lang_translations": {
                                "ru": "Этот словарь ориентирован на <w>британские</w> правила орфографии.",
                                "zh": "这本词典侧重于<w>英式</w>拼写规范。"
                            }
                        },
                        {
                            "text": "Some words in <w>British</w> are quite different from American English.",
                            "target_lang_translations": {
                                "ru": "Некоторые слова в <w>британском</w> английском сильно отличаются от американского.",
                                "zh": "<w>英式英语</w>中的一些词汇与美式英语有很大不同。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often referred to as British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английский язык, на котором говорят и пишут в Соединенном Королевстве.",
                        "zh": "在联合王国使用的英语语言形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бри́танский а́нглийский",
                                "target_lang_sense_clarification": "язык"
                            },
                            {
                                "target_lang_word": "брита́нский",
                                "target_lang_sense_clarification": "разг. о языке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "英式英语",
                                "target_lang_sense_clarification": "英国使用的英语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9713fed-8725-3f80-aab8-1b9cbf6a4e02",
                    "sense_definition": "The Celtic language spoken by the ancient Britons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "language_ancient",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Linguists study Common <w>British</w> to understand the origins of Welsh and Cornish.",
                            "target_lang_translations": {
                                "ru": "Лингвисты изучают обще-<w>бриттский</w> язык, чтобы понять происхождение валлийского и корнского.",
                                "zh": "语言学家研究原始<w>布立吞语</w>以了解威尔士语和康沃尔语的起源。"
                            }
                        },
                        {
                            "text": "Very few written records of ancient <w>British</w> survive today.",
                            "target_lang_translations": {
                                "ru": "До наших дней сохранилось очень мало письменных памятников древнего <w>бриттского</w> языка.",
                                "zh": "现存的古代<w>布立吞语</w>书面记录非常少。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical linguistics context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кельтский язык, на котором говорили древние бритты.",
                        "zh": "古代布立吞人所说的凯尔特语。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бри́ттский",
                                "target_lang_sense_clarification": "древний язык"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布立吞语",
                                "target_lang_sense_clarification": "古代凯尔特语族的一种"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}