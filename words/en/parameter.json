                },
                {
                    "sense_id": "3bd34361-85e0-3f1e-8673-f97340888691",
                    "sense_definition": "A value kept constant during a specific calculation or experiment but varied across different versions of it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this equation, 'a' is a <w>parameter</w> that determines the slope of the curve.",
                            "target_lang_translations": {
                                "ru": "В этом уравнении «a» — это <w>параметр</w>, определяющий наклон кривой."
                            }
                        },
                        {
                            "text": "The scientist adjusted the unknown <w>parameter</w> to see how the model reacted.",
                            "target_lang_translations": {
                                "ru": "Ученый скорректировал неизвестный <w>параметр</w>, чтобы посмотреть, как отреагирует модель."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unknown parameter",
                        "adjustable parameter",
                        "constant parameter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина, остающаяся постоянной в рамках конкретного вычисления, но меняющаяся в разных его версиях."
