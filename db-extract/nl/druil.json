                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0225135-47bf-4b96-adf9-2426e89abc1c",
                                                "sense_id": "f4472949-06bc-3891-8883-b698ab3191f5",
                                                "text": "Nous fîmes la route dans un méchant tapecul."
                                            },
