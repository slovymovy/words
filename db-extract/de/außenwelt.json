                    {
                        "sense_id": "dd3517d5-52ab-37d5-ab84-4007c073745b",
                        "entry_id": "c621df06-ada4-3d1d-a32b-1bf2da925c67",
                        "glosses": [
                            "Monde extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a6a068-08d5-4039-8041-b981256acc51",
                                "sense_id": "dd3517d5-52ab-37d5-ab84-4007c073745b",
                                "text": "Um die Verbreitung der Krankheit einzudämmen, hat die Regierung in Peking bereits mehrere Städte von der Außenwelt isoliert.",
                                "translation": "Afin d'endiguer la propagation de la maladie, le gouvernement de Pékin a déjà isolé plusieurs villes du monde extérieur."
                            },
                            {
                                "example_id": "572f56ec-655a-4607-9192-740143d040cd",
                                "sense_id": "dd3517d5-52ab-37d5-ab84-4007c073745b",
                                "text": "In zahlreichen Alpentälern herrscht hohe Lawinengefahr und einige Gemeinden sind von der Außenwelt abgeschnitten.",
                                "translation": "Dans de nombreuses vallées alpines, le risque d'avalanche est élevé et certaines communes sont coupées du monde extérieur."
                            }
                        ]
                    }
                ],
