                            {
                                "target_lang_word": "拨号音",
                                "target_lang_sense_clarification": "电话信号音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c39eaa1-7b5b-3569-a578-8f038e972aef",
                    "sense_definition": "The definition, firmness, and healthy state of a muscle or organ.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "body_health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular swimming is excellent for improving muscle <w>tone</w>.",
                            "target_lang_translations": {
                                "ru": "Регулярное плавание отлично подходит для улучшения мышечного <w>тонуса</w>.",
                                "zh": "经常游泳对改善肌肉<w>张力</w>非常有益。"
                            }
