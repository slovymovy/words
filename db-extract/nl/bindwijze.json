                        "glosses": [
                            "de manier waarop de pagina's van een boek aan de rugzijde met elkaar verbonden zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41fdd1e9-c025-40b1-bf3b-bdc9de574734",
                                "sense_id": "4b37715f-a2ed-385d-91e2-8f36d4582c93",
                                "text": "Overigens brengt Strengholt morgen, twee dagen na de bijzetting van Prinses Juliana in het familiegraf van de Oranjes, een tweede boek uit mét beelden van de uitvaart. ”Koningin Juliana, moeder des vaderlands” verschilt qua prijs, omvang, inhoud, omslag en bindwijze met de eerste uitgave van Strengholt."
                            },
                            {
                                "example_id": "0e221665-44a0-4ac7-8d6b-51ea0c63a1fc",
                                "sense_id": "4b37715f-a2ed-385d-91e2-8f36d4582c93",
                                "text": "De materiaalkeuze, de bindwijze, het formaat en het onderwerp van het boek zijn voor mij allemaal belangrijke elementen voor een goed omslagontwerp. Ik houd van eenvoudige maar gelaagde beelden, die hun volledige boodschap pas prijsgeven na het lezen."
                            }
