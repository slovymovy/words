                ],
                "senses": [
                    {
                        "sense_id": "2f3e19d5-4782-3300-950d-72db76e17c2d",
                        "entry_id": "dc68923f-6907-3609-97ed-3abfda0bc201",
                        "glosses": [
                            "Personne qui compose, écrit ou interprète du rap."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d3b911d-bfdd-4a3b-ae66-6c83ff9d29ab",
                                "sense_id": "2f3e19d5-4782-3300-950d-72db76e17c2d",
                                "text": "Ils étaient dans la lignée de beaucoup de rappeurs et rappeuses qui véhiculaient des textes engagés. Parmi eux, il y avait la pionnière du rap féminin, Queen Latifah, qui créa une véritable révolution dans le monde machiste du hip-hop."
                            },
                            {
                                "example_id": "d36bfe41-676c-419e-99f0-23ac983cbe0b",
                                "sense_id": "2f3e19d5-4782-3300-950d-72db76e17c2d",
                                "text": "Le rappeur Kanye West est aussi un homme d’affaires avisé."
                            },
                            {
                                "example_id": "0beeb5a2-1e7c-417d-821e-2711dc33135a",
                                "sense_id": "2f3e19d5-4782-3300-950d-72db76e17c2d",
                                "text": "— Le look rappeur, avec ses panoplies fashion, les étiquettes de marques qui dépassent et le cliquetis des bijoux autour du cou, ça fait marcher flouze et bizness. C'est pour ça qu'on préfère les rebeus habillés en dollars aux rebeues fagotées en foulard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9d858ea-15de-43f8-af7e-ebde4ba9dee4",
                        "source_entry_id": "dc68923f-6907-3609-97ed-3abfda0bc201",
                        "source_sense_id": "2f3e19d5-4782-3300-950d-72db76e17c2d",
                        "target_lang_word": "Rapper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rapper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94aa9292-9c46-371d-a870-7f5c2ed4131e",
                                        "entry_id": "58a319b1-16a3-32cc-862d-c22203037b75",
                                        "glosses": [
                                            "Musiker, der rhythmischen Sprechgesang ausführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "683fa077-add2-4654-bc90-fb6991d8a6cd",
                                                "sense_id": "94aa9292-9c46-371d-a870-7f5c2ed4131e",
                                                "text": "Eminem ist ein bekannter amerikanischer Rapper."
                                            },
                                            {
                                                "example_id": "e3d178e5-0eaf-479e-8a9a-0d5ffe3bb1ac",
                                                "sense_id": "94aa9292-9c46-371d-a870-7f5c2ed4131e",
                                                "text": "„Die Rapper röchelten weiter.“"
                                            },
                                            {
                                                "example_id": "9b780aa1-a9dd-4191-a2aa-5ce6c4e0fe6e",
                                                "sense_id": "94aa9292-9c46-371d-a870-7f5c2ed4131e",
                                                "text": "„Da tritt The Knife neben isländischen Rappern auf.“"
                                            },
                                            {
                                                "example_id": "fb1b1ee2-3c77-4396-bd97-ea7ae45db6bd",
                                                "sense_id": "94aa9292-9c46-371d-a870-7f5c2ed4131e",
                                                "text": "„Es gibt drei Gruppen von Rappern mit Migrationshintergrund in Deutschland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
