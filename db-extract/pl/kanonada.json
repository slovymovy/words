                        ]
                    },
                    {
                        "translation_id": "6c49db11-0b7d-40b1-ac11-d9f81b7ef9ca",
                        "source_entry_id": "e833ce9a-7ad5-3d25-95ad-c5b4cb6764fb",
                        "source_sense_id": "6321e5b2-86cc-380a-9d2a-bccb9c2147a2",
                        "target_lang_word": "fusillade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fusillade",
