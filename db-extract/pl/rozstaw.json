                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "span",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "214dfdd9-ed5c-3937-a9ac-2f3c0cd437af",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "The full width of an open hand from the end of the thumb to the end of the little finger used as an informal unit of length."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24f543a2-d77b-3951-947d-8d8296ca462e",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "Any of various traditional units of length approximating this distance, especially the English handspan of 9 inches forming ⅛ fathom and equivalent to 22.86 cm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fcebca2-47c2-3250-9f84-c03771f8b7c2",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "A small space or a brief portion of time."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcfc3442-0091-4084-9661-f22cde49f9e4",
                                                "sense_id": "9fcebca2-47c2-3250-9f84-c03771f8b7c2",
                                                "text": "He has a short attention span and gets bored within minutes."
                                            },
                                            {
                                                "example_id": "f2d13d91-a60b-4419-8321-a55371f3c6a8",
                                                "sense_id": "9fcebca2-47c2-3250-9f84-c03771f8b7c2",
                                                "text": "\"Why in ten thousand years scarce will the rain and storms lessen a mountain top by a span in thickness?\""
                                            },
                                            {
                                                "example_id": "8b584ec5-ff2b-45df-8aee-09bec43a210f",
                                                "sense_id": "9fcebca2-47c2-3250-9f84-c03771f8b7c2",
                                                "text": "Yet not to Earth's contracted Span,\nThy Goodneſs let me bound; […]"
                                            },
                                            {
                                                "example_id": "b1c83c96-1bcb-488d-82c7-d6d30d6eca4c",
                                                "sense_id": "9fcebca2-47c2-3250-9f84-c03771f8b7c2",
                                                "text": "Life's but a span; I'll every inch enjoy."
                                            },
                                            {
                                                "example_id": "0d13dcde-4a67-4c74-9676-e19843cc9081",
                                                "sense_id": "9fcebca2-47c2-3250-9f84-c03771f8b7c2",
                                                "text": "The unsilent present is a time of evaporating attention spans,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99aa000d-d932-3f58-9ebb-49e252520652",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "A portion of something by length; a subsequence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225cd922-19ad-4b04-8eb5-712432151a64",
                                                "sense_id": "99aa000d-d932-3f58-9ebb-49e252520652",
                                                "text": "For example, in OpenOffice.org or Microsoft Word, each span of text can have a style that defines key characteristics about the text: • What font it uses • Whether it's normal, bolded, italicized, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ca33cca-68de-3a48-8100-6db8f0f72315",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "The spread or extent of an arch or between its abutments, or of a beam, girder, truss, roof, bridge, or the like, between supports."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e5289b0-a28d-486d-9562-81e244c2a265",
                                                "sense_id": "0ca33cca-68de-3a48-8100-6db8f0f72315",
                                                "text": "The force of the explosion demolished one pair of piers and two spans of the bridge crashed down into the river on top of the barges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cc9a3f9-feb6-39ac-adc1-d1b8548945fc",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "The length of a cable, wire, rope, chain between two consecutive supports."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "197a82bf-9852-37d8-a831-44851219cbb8",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "A rope having its ends made fast so that a purchase can be hooked to the bight; also, a rope made fast in the center so that both ends can be used."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e9e6e45-e485-3c1b-af03-892617d9a2a9",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "A pair of horses or other animals driven together; usually, such a pair of horses when similar in color, form, and action."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da4b0cfd-ab47-387e-9ff4-a34a9f770299",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "The space of all linear combinations of vectors within a set."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f98d3fc8-4445-39e2-ba70-c794e31ff9fa",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "The time required to execute a parallel algorithm on an infinite number of processors, i.e. the shortest distance across a directed acyclic graph representing the computation steps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baea8bc7-1427-4eba-8d91-843393d80553",
                                                "sense_id": "f98d3fc8-4445-39e2-ba70-c794e31ff9fa",
                                                "text": "We use the term span (also called depth, or dependence depth) to refer to the number of parallel steps assuming an unbounded number of processors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae27b763-faef-38ef-9e95-439ab1899c0a",
                                        "entry_id": "7440c894-f66c-3bc9-8e69-c7381be6242b",
                                        "glosses": [
                                            "wingspan of a plane or bird"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "span",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f65ad101-a229-330b-9017-93878fa94f3a",
                                        "entry_id": "4d32cdf1-f85c-3ad6-84ab-12911ecb1aa9",
                                        "glosses": [
                                            "To extend through the distance between or across."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e32d44-2695-436b-9c74-cf737ee1153d",
                                                "sense_id": "f65ad101-a229-330b-9017-93878fa94f3a",
                                                "text": "The suspension bridge spanned the canyon."
                                            },
                                            {
                                                "example_id": "33b3584b-090b-49f9-8a65-f5956eda247f",
                                                "sense_id": "f65ad101-a229-330b-9017-93878fa94f3a",
                                                "text": "The rivers were spanned by arches of solid masonry."
                                            },
                                            {
                                                "example_id": "3e21dd87-ae31-403f-8366-d092bc88825a",
                                                "sense_id": "f65ad101-a229-330b-9017-93878fa94f3a",
                                                "text": "Completed in 1823, Gaunless Bridge was designed by George Stephenson to span the River Gaunless in West Auckland, forming part of a line serving Witton Park Colliery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0cf531f-e579-33a0-9d1e-f676e92cd461",
                                        "entry_id": "4d32cdf1-f85c-3ad6-84ab-12911ecb1aa9",
                                        "glosses": [
                                            "To extend through (a time period)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31f4cf0f-0f6b-4c26-baa4-2148e8fef000",
                                                "sense_id": "d0cf531f-e579-33a0-9d1e-f676e92cd461",
                                                "text": "The parking lot spans three acres."
                                            },
                                            {
                                                "example_id": "3adfe3f1-5173-42c9-95fa-d6d6ea1b9324",
                                                "sense_id": "d0cf531f-e579-33a0-9d1e-f676e92cd461",
                                                "text": "The novel spans three centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdf31ec6-67f2-332f-8531-721d7590454a",
                                        "entry_id": "4d32cdf1-f85c-3ad6-84ab-12911ecb1aa9",
                                        "glosses": [
                                            "To measure by the span of the hand with the fingers extended, or with the fingers encompassing the object."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "677bf56c-6713-4d1f-9f21-04663ff62295",
                                                "sense_id": "cdf31ec6-67f2-332f-8531-721d7590454a",
                                                "text": "to span a space or distance; to span a cylinder"
                                            },
                                            {
                                                "example_id": "f675b67d-1cfb-4c2e-85d9-e14f9f25dae4",
                                                "sense_id": "cdf31ec6-67f2-332f-8531-721d7590454a",
                                                "text": "Mine hand alſo hath laid the foundation of the earth, and my right hand hath ſpanned the heauens: when I call vnto them, they ſtand vp together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1e18076-95c1-394c-9f05-c80e3a5f8080",
                                        "entry_id": "4d32cdf1-f85c-3ad6-84ab-12911ecb1aa9",
                                        "glosses": [
                                            "To generate an entire space by means of linear combinations."
