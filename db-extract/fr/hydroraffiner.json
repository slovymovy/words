                "senses": [
                    {
                        "sense_id": "46e95ee7-e6e3-35d3-b3da-eeb7b254b484",
                        "entry_id": "d3ec5490-a749-394f-9b0b-f9542b268f97",
                        "glosses": [
                            "Raffiner, éliminer les impuretés, en utilisant de l'hydrogène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8135c56-5128-4e99-bb53-74cdf8b541f3",
                                "sense_id": "46e95ee7-e6e3-35d3-b3da-eeb7b254b484",
                                "text": "C'est pourquoi certains raffineurs ont cherché, ces dix dernières années, à hydroraffiner directement les résidus atmosphériques;"
                            },
                            {
                                "example_id": "e507541e-01af-471c-8954-ca20f1cda15d",
                                "sense_id": "46e95ee7-e6e3-35d3-b3da-eeb7b254b484",
                                "text": "Avant d'aborder l'étape d'hydrocraquage proprement dite, il est recommandé d'hydroraffiner la DAO de manière à lui conférer, au poids moléculaire près, des caractéristiques semblables à celles du distillat sous vide avec lequel elle sera probablement mélangée dans l'étape d'hydrocraquage ;"
                            }
                        ]
                    }
                ],
