                    "frequency": "Middle",
                    "semantic_group_id": "genetik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wissenschaftler haben ein verändertes <w>Gen</w> entdeckt, das für die Entstehung der Krankheit verantwortlich ist.",
                            "target_lang_translations": {
                                "en": "Scientists have discovered an altered <w>gene</w> that is responsible for the development of the disease."
                            }
                        },
                        {
                            "text": "Die Farbe unserer Augen wird von mehreren <w>Genen</w> beeinflusst.",
                            "target_lang_translations": {
                                "en": "The color of our eyes is influenced by multiple <w>genes</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Erbanlage",
                        "Erbfaktor"
                    ],
                    "common_phrases": [
                        "defektes Gen",
                        "verändertes Gen"
                    ],
                    "target_lang_definitions": {
                        "en": "A segment of DNA that contains the instructions for making a protein and functions as a basic unit of heredity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gene",
                                "target_lang_sense_clarification": "biological unit of heredity"
