                                "sense_id": "ed66f046-d190-3de9-9335-6313e918412d",
                                "text": "Het model liep rustig en zelfbewust de catwalk op.",
                                "translation": "The model walked onto the catwalk calmly and confidently.",
                                "english": "The model walked onto the catwalk calmly and confidently."
                            }
                        ]
                    },
                    {
