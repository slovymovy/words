                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c04e6ad-cdf6-4009-b602-eed37afec94f",
                                                "sense_id": "28da80d4-db03-34b4-a2c8-ace0468d51a3",
                                                "text": "Wie viel Kilogramm hat Walter dieses Jahr denn schon abgenommen?"
                                            },
                                            {
                                                "example_id": "54031a19-d7e6-4fc0-87b9-7a7d84903a14",
                                                "sense_id": "28da80d4-db03-34b4-a2c8-ace0468d51a3",
                                                "text": "„Walter klopfte Gisèle unter dem Tisch aufs Knie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Walter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                        "entry_id": "8be596ce-c511-3569-822b-1a0901cfc1a2",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname mit großer Häufigkeit, in Deutschland flächendeckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee611d44-2d89-446c-8339-98a43654fb3b",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "Walters kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "a0930bd6-b8a5-4e20-b991-0e856016c09e",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "Hat der Herr Walter immer noch seinen kleinen Lebensmittelladen an der Hauptstraße?"
                                            },
                                            {
                                                "example_id": "d20e76a0-1a2a-42b1-8305-de59f5acbffc",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "Frau Walter ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "57c4c757-9a67-48ee-90d3-5f03073c963c",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "Herr Walter wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "50b1b7d8-0deb-48db-92a5-3dfc195d23ff",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "Die Walters kommen heute aus Krefeld."
                                            },
                                            {
                                                "example_id": "ac675971-4612-41d1-9d03-b52d2b90fdaf",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "Der Walter trägt nie die Schals, die die Walter ihm strickt."
                                            },
                                            {
                                                "example_id": "d963b002-7e6e-46af-91fe-fc010c1ab864",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Walter kommt, geht der Herr Walter.“"
                                            },
                                            {
                                                "example_id": "c4a00bc7-fabd-4b55-b2ec-3ff914151c12",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "Walter kommt und geht."
                                            },
                                            {
                                                "example_id": "ab5bc5f8-730e-4ec8-ad13-7d6d62770a1f",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "An verregneten Herbsttagen ist Familie Walters liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "05acae78-ce5a-4535-9fa0-c008ca170519",
                                                "sense_id": "478c8b45-c457-3905-bf06-e72455cdca8c",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Walter das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
