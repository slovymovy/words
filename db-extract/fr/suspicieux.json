                                "target_senses": [
                                    {
                                        "sense_id": "fc9e7871-b07c-3b9c-8235-74a1b7036f40",
                                        "entry_id": "ed7602fb-16b0-30c1-b7da-a69e40e6b5b8",
                                        "glosses": [
                                            "voll Argwohn, zum Verdacht neigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42992301-038d-44e5-a22a-126e7842e0f1",
                                                "sense_id": "fc9e7871-b07c-3b9c-8235-74a1b7036f40",
                                                "text": "Unser Nachbar ist ein argwöhnischer Mensch."
                                            },
                                            {
                                                "example_id": "44f1c6f3-1939-4847-8b13-ca8ca823ea3a",
                                                "sense_id": "fc9e7871-b07c-3b9c-8235-74a1b7036f40",
                                                "text": "Er ist argwöhnisch gegen seinen Schwager."
                                            },
                                            {
                                                "example_id": "d5c5c9a4-5fab-4ade-b376-ce3ac6748a36",
                                                "sense_id": "fc9e7871-b07c-3b9c-8235-74a1b7036f40",
                                                "text": "Sie schaute ihn argwöhnisch an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d84207bb-fb71-4a80-84da-68572b4922cf",
                        "source_entry_id": "aad4e7e9-d5ca-33ad-96fb-89fe3d9c4a5a",
                        "source_sense_id": "9de3a403-8ec8-34d4-8046-876ca0dcb22e",
                        "target_lang_word": "suspicious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suspicious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Arousing suspicion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa35fb88-2a10-4050-ac80-f679bdbafeff",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "His suspicious behaviour brought him to the attention of the police."
                                            },
                                            {
                                                "example_id": "27a8111f-9f4a-4205-9372-e2404ba097b3",
                                                "sense_id": "8bfcc51c-1ce3-38f1-a5f6-f5c7a900ab8d",
                                                "text": "If their views were entrancing their sanitation was primeval; if they possessed stables they were also next to the gas-works; if their gardens were delightful there were odours suspicious of mice in the bedrooms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Distrustful or tending to suspect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3193b015-3423-4083-a9da-ef80353812ab",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "We know he has a suspicious attitude to get-rich-quick schemes."
                                            },
                                            {
                                                "example_id": "dbd8c4d7-ff77-4d72-bdc0-98c2d27eee70",
                                                "sense_id": "900c6fee-d179-33fd-b02f-d92d5ed26dd2",
                                                "text": "Betraide by fortune and ſuſpitious loue,\nThreatned with frowning wrath and iealouſie,\nSurpriz’d with feare and hideous reuenge,\nI ſtand agaſt: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                        "entry_id": "1b546237-9749-332e-855e-9600cf3f8d8f",
                                        "glosses": [
                                            "Expressing suspicion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6586499-bdf0-4296-a6aa-3e12479378d1",
                                                "sense_id": "21af017c-5f19-33cd-8cfd-93039e522500",
                                                "text": "She gave me a suspicious look."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
