                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c614e677-45db-3baf-a369-beb3ba9b347e",
                        "entry_id": "410b33a0-31fd-3b98-a51d-6a2f41300c0f",
                        "glosses": [
                            "Détraquer, déranger."
                        ],
                        "tags": [
                            "Lyonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "9e139d42-80b8-472a-a64c-40f60f31d780",
                                "sense_id": "c614e677-45db-3baf-a369-beb3ba9b347e",
                                "text": "À l’avenir faudra plus se laisser détrancaner par cette engeance de profiteurs… le travail c’est nous !"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b7a280c-2a08-375e-9371-c9337640aae1",
                        "entry_id": "410b33a0-31fd-3b98-a51d-6a2f41300c0f",
                        "glosses": [
                            "Perdre la tête."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "da55e41b-0c7f-406c-a2fd-317ed768f9a6",
                                "sense_id": "9b7a280c-2a08-375e-9371-c9337640aae1",
                                "text": "Alors, expliqua Minicu, « elle avait détrancané », c’est-à-dire perdu la tête."
                            }
                        ]
