                    "frequency": "High",
                    "semantic_group_id": "gevaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De klimaatverandering <w>bedreigt</w> de natuurlijke leefomgeving van veel diersoorten.",
                            "target_lang_translations": {
                                "en": "Climate change <w>threatens</w> the natural habitat of many animal species.",
                                "ru": "Изменение климата <w>угрожает</w> естественной среде обитания многих видов животных."
                            }
                        },
                        {
                            "text": "Deze nieuwe ziekte kan de hele oogst van de boeren ernstig <w>bedreigen</w>.",
                            "target_lang_translations": {
                                "en": "This new disease can seriously <w>endanger</w> the farmers' entire harvest.",
                                "ru": "Эта новая болезнь может серьезно <w>поставить под угрозу</w> весь урожай фермеров."
                            }
