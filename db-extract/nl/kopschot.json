                        "glosses": [
                            "een meestal dodelijk schot in het hoofd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49af6657-a413-4420-ae48-5221c3550a80",
                                "sense_id": "7610a28c-d4b3-30a3-b8bc-2450bbd50c80",
                                "text": "Dertig meter van onze bunker lag een doode Russische soldaat. Vermoedelijk was hij reeds weken lang dood. Zijn heele houding wees erop, dat hij doodgeschoten werd toen hij kruipende den weg wilde naderen. Kopschot."
                            }
                        ]
                    },
                    {
                        "sense_id": "07f52b2d-0aa2-3a09-be4f-e1351f007dc7",
                        "entry_id": "f6f10a7a-c462-31ec-b8c1-ec6dcaa7e178",
                        "glosses": [
                            "een afscheiding in de vorm van een schot dat de passagiersruimte van een voertuig van de laadruimte scheidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c937f9c7-fcf0-4475-a261-10a7b4e38d7a",
                                "sense_id": "07f52b2d-0aa2-3a09-be4f-e1351f007dc7",
                                "text": "Ter bescherming van de chauffeur, maar ook van de lading, kan een kopschot geplaatst worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce917db6-8caa-3944-94e5-a64af4c29fe3",
                        "entry_id": "f6f10a7a-c462-31ec-b8c1-ec6dcaa7e178",
                        "glosses": [
                            "een eindschot aan de kopse kant van bijvoorbeeld een dakgoot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b2ee18-af67-4ef9-a1a3-4fbe0576c04d",
                                "sense_id": "ce917db6-8caa-3944-94e5-a64af4c29fe3",
                                "text": "De koelvitrine was zowel aan de linker- als aan de rechterkant voorzien van een kopschot van glas."
                            }
                        ]
                    }
