                "translations": [
                    {
                        "translation_id": "fedb9802-2f89-4de6-ae51-c7d35e52bd02",
                        "source_entry_id": "9d6c3ac1-fd5a-3517-88cf-5b6b5e101ede",
                        "source_sense_id": "f138afb2-5076-3233-9cc3-a28ddba648ec",
                        "source_sense_description": "weibliche Person, die im Verkauf von Handelswaren tätig ist",
                        "target_lang_word": "Verkäuferin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkäuferin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a8f5dfa-8d79-3df1-908a-875ecdeb432f",
                                        "entry_id": "4db0e8c8-3e7a-38ef-92da-72efaa65d16d",
                                        "glosses": [
                                            "weibliche Person, die etwas verkauft (hat)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e11ecb73-5bbb-4098-b8c8-d8c4939a8fb5",
                                                "sense_id": "2a8f5dfa-8d79-3df1-908a-875ecdeb432f",
                                                "text": "Die Verkäuferin wusste schon, warum sie den Wagen loswerden wollte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                        "entry_id": "4db0e8c8-3e7a-38ef-92da-72efaa65d16d",
                                        "glosses": [
                                            "weiblicher berufsmäßiger Verkäufer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "570fa4cd-3a5b-44c5-bd99-994947075566",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "Sie ist Verkäuferin beim Modehaus Puvogel."
                                            },
                                            {
                                                "example_id": "ed83f000-10b0-4837-ac6b-2d5e4a11ad17",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "„Und so erhielten die Veteranen und Kriegsversehrten in diesem Jahrzehnt Gesellschaft von ehemaligen Verkäuferinnen, früheren Milchmädchen, einstigen Arbeiterinnen und entlassenen Dienstmädchen.“"
                                            },
                                            {
                                                "example_id": "02ad4c61-b585-4bca-ba59-f96cc7fe3335",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "„Du gehst hinein, und die Verkäuferin schaut dich forschend an.“"
                                            },
                                            {
                                                "example_id": "fe69b797-1bac-4f98-9315-1f87d0023a3c",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "„Eine Verkäuferin steht hinter der Kasse, auf die wir zusteuern.“"
                                            },
                                            {
                                                "example_id": "49e344d1-beb4-4c7d-acfb-f87ed72734a5",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "„Die Verkäuferin betrachtet ihre Fingernägel und pustet über der Stirn eine splissige Haarsträhne hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84dadef5-fcfa-4e80-b2a6-410f646aa5a1",
                        "source_entry_id": "9d6c3ac1-fd5a-3517-88cf-5b6b5e101ede",
                        "source_sense_id": "f138afb2-5076-3233-9cc3-a28ddba648ec",
                        "source_sense_description": "weibliche Person, die im Verkauf von Handelswaren tätig ist",
                        "target_lang_word": "seller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dab04ce-64e0-3060-bfac-ac922029e894",
                                        "entry_id": "a5ebc96f-99df-39c1-b93a-b62fc1647771",
                                        "glosses": [
                                            "Someone who sells; a vendor; a clerk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23aaebf-2325-496a-932f-e0ba0f5a9092",
                                                "sense_id": "4dab04ce-64e0-3060-bfac-ac922029e894",
                                                "text": "Alisha was a seller of fine books."
                                            },
                                            {
                                                "example_id": "194c6e08-c2a4-4b0d-861b-09d9957603dd",
                                                "sense_id": "4dab04ce-64e0-3060-bfac-ac922029e894",
                                                "text": "De Beers, the world’s largest diamond producer, announced plans in 2017 to operate a carbon-neutral mine and pointed out that the FTC has warned lab-grown diamond sellers over the veracity of their environmental claims."
                                            },
                                            {
                                                "example_id": "88ce3980-d452-4ac7-af6d-8c7091a5ec4b",
                                                "sense_id": "4dab04ce-64e0-3060-bfac-ac922029e894",
                                                "text": "Amazon secured a major legal victory in its fight with rival eBay over seller poaching, with an arbitration panel ruling in its favor earlier this month, according to court filings by the company on Tuesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f7d9bd-424b-3e43-bcfc-be1dd8350502",
                                        "entry_id": "a5ebc96f-99df-39c1-b93a-b62fc1647771",
                                        "glosses": [
                                            "Something which sells."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e25637e-668f-4640-ab54-6793517d2ffa",
                                                "sense_id": "c4f7d9bd-424b-3e43-bcfc-be1dd8350502",
                                                "text": "Two of the books Alisha authored had become big sellers."
                                            },
                                            {
                                                "example_id": "eafc1ed1-84de-4dff-9043-850c36633ec5",
                                                "sense_id": "c4f7d9bd-424b-3e43-bcfc-be1dd8350502",
                                                "text": "Still, she sat in her chair and read it and reread it, six, seven times. She was pleased with it, she was pleased with herself. This time for sure, she said to herself. This one’s a seller. Really big."
                                            }
                                        ]
                                    }
                                ]
                            },
