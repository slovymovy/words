                "senses": [
                    {
                        "sense_id": "5bfc3bb0-4e39-3dd4-8ca5-e0eafb92b1ba",
                        "entry_id": "67764be8-d8e2-3eb6-b088-cc2265de74eb",
                        "glosses": [
                            "Fouiller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b012cf6-5aba-46ce-b75a-f986d1d976d8",
                                "sense_id": "5bfc3bb0-4e39-3dd4-8ca5-e0eafb92b1ba",
                                "text": "La confession en désuétude ça fait le beurre frais de la psychanalyse. L’essentiel… qu’il faut se confier, avouer les actions les plus secrètes, se fouillasser les tréfonds de l’âme ou du moi… appelez ça comme vous voulez."
                            },
                            {
                                "example_id": "514f5f14-e21e-42a9-a947-8b9f47e00ef5",
                                "sense_id": "5bfc3bb0-4e39-3dd4-8ca5-e0eafb92b1ba",
                                "text": "Ils ont commencé à rentrer dans sa maison, à fouillasser en dedans, à capoter les matelas et les chaises."
                            },
                            {
                                "example_id": "1bace690-64de-4e29-bc6f-160b434ffa7a",
                                "sense_id": "5bfc3bb0-4e39-3dd4-8ca5-e0eafb92b1ba",
                                "text": "Elle m’emmenait dès petiot à fouillasser sous les rochers, à secouer le varech."
                            }
                        ]
                    }
                ],
