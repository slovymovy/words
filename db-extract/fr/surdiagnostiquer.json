                ],
                "senses": [
                    {
                        "sense_id": "ca44237d-3662-3b11-a49d-f14c2c4dc7db",
                        "entry_id": "fde1ff52-c9ad-3a97-9f41-311a2f09960e",
                        "glosses": [
                            "Diagnostiquer plus souvent que ce qu’il faudrait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17279807-c1de-4e89-bbc5-1e54f5c1bac6",
                                "sense_id": "ca44237d-3662-3b11-a49d-f14c2c4dc7db",
                                "text": "En raison de la complexité à établir un diagnostic fiable et valide, il arrive fréquemment que ce trouble soit surdiagnostiqué ou qu'il apparaisse en association avec un autre trouble, ce qui peut alourdir le tableau clinique."
                            },
                            {
                                "example_id": "836f038b-c12a-42c4-97d6-8cb223e932fa",
                                "sense_id": "ca44237d-3662-3b11-a49d-f14c2c4dc7db",
                                "text": "On a des raisons de penser que les cliniciens ont tendance à surdiagnostiquer la Schizophrénie dans certains groupes ethniques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d089712-bd28-45f0-9543-f0c34b26eed4",
                        "source_entry_id": "fde1ff52-c9ad-3a97-9f41-311a2f09960e",
                        "source_sense_id": "ca44237d-3662-3b11-a49d-f14c2c4dc7db",
                        "target_lang_word": "overdiagnose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overdiagnose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07d210a2-9599-3300-bb82-f69b9a93cbf6",
                                        "entry_id": "00709d50-8131-39e4-af68-ce8dacbb7c10",
                                        "glosses": [
                                            "To diagnose something more often than it actually occurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e1c9c21-c9e0-4d2e-b60a-9911765f5c7e",
                                                "sense_id": "07d210a2-9599-3300-bb82-f69b9a93cbf6",
                                                "text": "Health experts deny claims that they overdiagnose mental health conditions."
                                            },
                                            {
                                                "example_id": "bc4585e8-514d-42a2-a673-ef48ba605451",
                                                "sense_id": "07d210a2-9599-3300-bb82-f69b9a93cbf6",
                                                "text": "Dissociative identity disorder is a contentious diagnosis: some professionals say the disorder is overdiagnosed; others say it doesn't even exist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d645a6c0-c277-3317-ba52-2cf391838269",
                                        "entry_id": "00709d50-8131-39e4-af68-ce8dacbb7c10",
                                        "glosses": [
                                            "To diagnose as a clinical case what is truly a subclinical case."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b393453-05ce-45c4-81e3-d22900336df4",
                                                "sense_id": "d645a6c0-c277-3317-ba52-2cf391838269",
                                                "text": "Her GP incorrectly referred her to a pulmonologist, overdiagnosing what was clearly a case of subclinical, mild allergy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
