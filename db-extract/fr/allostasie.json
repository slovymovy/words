                                        "glosses": [
                                            "The process of achieving stability, or homeostasis, in the body, through physiological or behavioral change."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1f5087f-84ad-4cae-92a7-7d7e98c50439",
                                                "sense_id": "2e281f85-962e-3878-9f72-52e05f2d4dee",
                                                "text": "This system of so-called allostasis, of maintaining control through constant change, stands in contrast to the mechanisms of homeostasis that keep the pH level and oxygen concentration in the blood within a narrow and invariant range."
                                            }
