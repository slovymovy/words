                                        "examples": [
                                            {
                                                "example_id": "29020196-ab3f-4cb3-a04a-85d20ddb3093",
                                                "sense_id": "5e0caad4-5eba-31e5-afa1-0513ac8ae5df",
                                                "text": "J’accrochai aux murs des aquarelles détestables de ma chère maman, celles qu’elle qualifiait — assez injustement d’ailleurs — de « préraphaélites », et fis un grand feu de tous ces poètes « lakistes » qui avaient gâché mon enfance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8b1116d-d559-4e14-acba-4d2cd4dc6c21",
                        "source_entry_id": "36bf191c-66ee-3ab3-acf0-185fb2678333",
                        "source_sense_id": "da53b930-3b78-3ea0-9dd5-5f8c4cb7b041",
