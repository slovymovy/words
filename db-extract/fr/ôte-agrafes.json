                        "target_lang_word": "Schwiegermutter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwiegermutter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ed959a4-9e66-31da-a7c5-11d2f4a2d988",
                                        "entry_id": "8b79e60a-3e1f-3dc2-8971-601f3c17b40a",
                                        "glosses": [
                                            "Mutter des Ehepartners"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2245383-8e39-43c3-8253-b09b08d49757",
                                                "sense_id": "4ed959a4-9e66-31da-a7c5-11d2f4a2d988",
                                                "text": "Meine Schwiegermutter kommt zu Besuch."
                                            },
                                            {
                                                "example_id": "e4c50b00-ca3f-470a-af87-f8a45f76d0df",
                                                "sense_id": "4ed959a4-9e66-31da-a7c5-11d2f4a2d988",
                                                "text": "„Im Juli hatte meine Schwiegermutter Geburtstag.“"
                                            },
                                            {
                                                "example_id": "38cf1672-09ee-4049-9f5e-d15bf2c6bfd0",
                                                "sense_id": "4ed959a4-9e66-31da-a7c5-11d2f4a2d988",
                                                "text": "„In der Tür des Berliner Zimmers taucht das Antlitz ihrer Schwiegermutter auf, schon halb in Kriegsbemalung.“"
                                            },
                                            {
                                                "example_id": "5dacd225-bb12-4f11-b990-30de52de23ed",
                                                "sense_id": "4ed959a4-9e66-31da-a7c5-11d2f4a2d988",
                                                "text": "„In meiner Verzweiflung lasse ich die Schwiegermutter einfliegen, obwohl ihre Omaqualitäten bisher eher bescheiden waren.“"
                                            },
                                            {
                                                "example_id": "63698e45-3b90-49b0-8a6b-0ce699ee90c6",
                                                "sense_id": "4ed959a4-9e66-31da-a7c5-11d2f4a2d988",
                                                "text": "„Eine Schwiegermutter, die jünger aussieht als ihre künftige Schwiegertochter, ein Vater, der zittert wie der Hoden eines Teppichklopfers – ich wäre misstrauisch.“"
                                            },
                                            {
                                                "example_id": "3bd986f6-66ee-4b6f-9519-157a202072f7",
                                                "sense_id": "4ed959a4-9e66-31da-a7c5-11d2f4a2d988",
                                                "text": "„Der Lastwagenfahrer hatte sie nicht verraten. Er hatte sie durch mehrere Straßensperren gebracht und sie in Schachty abgesetzt, wo sie die Nacht bei seiner Schwiegermutter und deren Familie verbracht hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
