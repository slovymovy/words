                ],
                "senses": [
                    {
                        "sense_id": "29261d6b-fc1e-3de3-bfdd-243f666e6cc9",
                        "entry_id": "afafb8f9-27c0-3f80-8cdc-9d013e938082",
                        "glosses": [
                            "Vokal, dessen Aussprachedauer verglichen mit Kurzvokalen länger ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a981afb-d928-4173-9661-ab67b6484047",
                                "sense_id": "29261d6b-fc1e-3de3-bfdd-243f666e6cc9",
                                "text": "Langvokale unterscheiden sich von Kurzvokalen dadurch, dass sie länger ausgesprochen werden."
                            },
                            {
                                "example_id": "8723049d-7a13-47b4-8e1e-127c2f1f1dd8",
                                "sense_id": "29261d6b-fc1e-3de3-bfdd-243f666e6cc9",
                                "text": "Der Vokal in \"See\" ist ein Langvokal, der in \"Bett\" ein Kurzvokal."
                            },
                            {
                                "example_id": "b6630fb0-9c3e-4099-93d6-f2a1b4a2af2a",
                                "sense_id": "29261d6b-fc1e-3de3-bfdd-243f666e6cc9",
                                "text": "„Beim Vokalismus werden drei Teilsysteme, nämlich Kurzvokale, Langvokale und Diphthonge, unterschieden.“"
                            },
                            {
                                "example_id": "1b28d721-0076-4787-a517-624c3c23813f",
                                "sense_id": "29261d6b-fc1e-3de3-bfdd-243f666e6cc9",
                                "text": "„Das Vokalsystem besteht aus 18 Phonemen: 7 Kurzvokale, 8 Langvokale und 3 Diphthonge.“"
                            },
                            {
                                "example_id": "013a215d-d672-47ab-aa7e-475eeb05c02a",
                                "sense_id": "29261d6b-fc1e-3de3-bfdd-243f666e6cc9",
                                "text": "„Trubetzkoy … selbst betrachtet die deutschen Langvokale, die im Silbenauslaut allein zulässig sind, allerdings als merkmallos…“"
                            },
                            {
                                "example_id": "9ccf7b49-9616-41cb-8b91-6f79099a7f42",
                                "sense_id": "29261d6b-fc1e-3de3-bfdd-243f666e6cc9",
                                "text": "„Diphthonge zählen hier, im Gegensatz zum Inselnordischen, immer als Lang- oder Doppelvokale.“"
                            },
                            {
                                "example_id": "f0de2e5d-ef8d-4348-a130-4220e19055ba",
                                "sense_id": "29261d6b-fc1e-3de3-bfdd-243f666e6cc9",
                                "text": "„In Fremdwörtern kommen Kurzvokale vor, die im Vergleich mit den Kurzvokalen der deutschen Erbwörter geschlossener (gespannt) artikuliert werden und dadurch in unseren Ohren wie Langvokale klingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
