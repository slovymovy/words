                "senses": [
                    {
                        "sense_id": "448c40f7-d0c4-3af0-afd2-da15fe791ac4",
                        "entry_id": "f4d5c16d-6f25-3bc8-9af9-4bc10a434c2f",
                        "glosses": [
                            "Devenir fluorescent, être fluorescent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "012ab66d-5ac9-4e60-9458-6bb786f15af4",
                                "sense_id": "448c40f7-d0c4-3af0-afd2-da15fe791ac4",
                                "text": "De plus, il a remarqué que quand le carbonate de chaux contient assez de manganèse pour fluorescer en joli jaune après calcination à l'air, on n'obtient pas d'aussi belles fluorescences vertes CaO + Cu."
                            },
                            {
                                "example_id": "ab22b484-1f86-4d77-841f-9203634f4987",
                                "sense_id": "448c40f7-d0c4-3af0-afd2-da15fe791ac4",
                                "text": "Ainsi que je l'ai déjà annoncé, l'introduction de 1 ou 2 centièmes de Cr203 dans cette magnésie lui donne la faculté de fluorescer en un beau rouge tout différent du rougeâtre de la MgO seule."
                            }
                        ]
                    }
