                "senses": [
                    {
                        "sense_id": "ca3feac2-02b0-37a3-8f0c-cf92462705ca",
                        "entry_id": "535c7fa9-fca7-3440-9ed1-b88276eec37a",
                        "glosses": [
                            "Enlever un écusson de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4b0c047-2167-4550-9493-23e6b30186c9",
                                "sense_id": "ca3feac2-02b0-37a3-8f0c-cf92462705ca",
                                "text": "Lorsqu’il eut enfin retrouvé la terre ferme, l’ancien préposé tira soigneusement sa veste d’uniforme et rajusta sa casquette postale désécussonnée."
                            },
                            {
                                "example_id": "ad5a14bc-8494-48b0-a83f-ee739c720ea2",
                                "sense_id": "ca3feac2-02b0-37a3-8f0c-cf92462705ca",
                                "text": "Deux ou trois, qui avaient trop forci pour s’accommoder de ces ajustements, combinaient la tenue bourgeoise et la militaire, la casquette et le ceinturon, le pantalon et la vareuse désécussonnée."
                            }
                        ]
                    }
