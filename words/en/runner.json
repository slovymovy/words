                        {
                            "text": "Apply some grease to the <w>runner</w> so the sliding door moves smoothly.",
                            "target_lang_translations": {
                                "ru": "Смажьте <w>полоз</w>, чтобы раздвижная дверь двигалась плавно."
                            }
                        }
