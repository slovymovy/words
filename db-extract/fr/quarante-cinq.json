        "fr-extract.jsonl": [
            {
                "entry_id": "0ebb8f9c-a98b-38b9-9b51-31eb98a3545c",
                "word": "quarante-cinq",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9bf6ba9-76d6-3116-a263-04afcdb3c3e4",
                        "entry_id": "0ebb8f9c-a98b-38b9-9b51-31eb98a3545c",
                        "glosses": [
                            "Quarante-quatre plus un, adjectif numéral cardinal correspondant au nombre 45."
                        ],
                        "tags": [
                            "Antéposé"
                        ],
                        "examples": [
                            {
                                "example_id": "ff5a50d0-5994-4438-9435-5c3fbbfd6e86",
                                "sense_id": "f9bf6ba9-76d6-3116-a263-04afcdb3c3e4",
                                "text": "Moi, à quarante-cinq ans, ça en fait déjà vingt-sept que je suis mariée avec un insupportable qui m’a volé ma jeunesse."
                            },
                            {
                                "example_id": "24188e38-d8b8-4253-a607-e7aa59e88f20",
                                "sense_id": "f9bf6ba9-76d6-3116-a263-04afcdb3c3e4",
                                "text": "Dans la catégorie moto, la lutte a fait rage jusqu’aux derniers instants, mais c’est l’Argentin Kevin Benavides qui a coiffé au poteau l’Australien Toby Price, de quarante-cinq secondes, après plus de 8 000 km de course dans le désert saoudien."
                            },
                            {
                                "example_id": "59eb877c-0940-4cb9-9ef8-29b1dc7e15f1",
                                "sense_id": "f9bf6ba9-76d6-3116-a263-04afcdb3c3e4",
                                "text": "Passionné d’astronomie, Gilles Munsch est tombé dans la marmite de l’ufologie il y a quarante-cinq ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d14a6d5-4dfa-3fef-9c14-7b99f3415cdf",
                        "entry_id": "0ebb8f9c-a98b-38b9-9b51-31eb98a3545c",
                        "glosses": [
                            "Quarante-cinquième."
                        ],
                        "tags": [
                            "Postposé"
                        ],
                        "examples": [
                            {
                                "example_id": "8ea39e61-6d01-4d9d-9cbb-a8c750234dba",
                                "sense_id": "1d14a6d5-4dfa-3fef-9c14-7b99f3415cdf",
                                "text": "Page quarante-cinq."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d360709-73f5-4d51-90b9-443ee40e61bb",
                        "source_entry_id": "0ebb8f9c-a98b-38b9-9b51-31eb98a3545c",
                        "target_lang_word": "fünfundvierzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
