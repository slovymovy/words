                                        "sense_id": "85a41a77-09d4-3b83-aa5c-e4e799085b4f",
                                        "entry_id": "e4bc7a08-ec58-3f41-8fae-bd6c1b05e224",
                                        "glosses": [
                                            "een gelegenheid, waar men thee kan drinken en een taartje erbij kan eten"
