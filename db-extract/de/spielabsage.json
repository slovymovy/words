                ],
                "senses": [
                    {
                        "sense_id": "6d23b5d7-e227-3c9f-bc8f-cef6b6dfb531",
                        "entry_id": "5314ed60-d169-3fe6-b33d-e618cc861a20",
                        "glosses": [
                            "Widerruf einer Spielzusage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0434755a-c2a4-4ed1-b566-29caad712e32",
                                "sense_id": "6d23b5d7-e227-3c9f-bc8f-cef6b6dfb531",
                                "text": "„Im Regelwerk der Europäischen Fußball-Union (UEFA) sind die Bestimmungen für eine Spielabsage und/oder Spielverweigerung unter den Artikeln 26 und 27 der Wettkampfordnung für die Champions League zusammengefasst.“"
                            },
                            {
                                "example_id": "b35d23b3-66f3-48b6-82dd-3535e20aa39f",
                                "sense_id": "6d23b5d7-e227-3c9f-bc8f-cef6b6dfb531",
                                "text": "„Die Erinnerungen an das EM-Vorrundenspiel im Sommer gegen Nordirland (1:0), aber auch an die schockierende Spielabsage in Hannover vor elf Monaten sind im Kreis der Nationalmannschaft noch präsent.“"
                            },
                            {
                                "example_id": "533b9ade-0147-48eb-a2bd-6e17c7e1568f",
                                "sense_id": "6d23b5d7-e227-3c9f-bc8f-cef6b6dfb531",
                                "text": "„Ein Experte einer privaten Sicherheitsfirma hat die Schuld für die Spielabsage im Old Trafford von Manchester übernommen.“"
                            },
                            {
                                "example_id": "3712c726-0800-4ca2-8f1e-7b60533ad1d8",
                                "sense_id": "6d23b5d7-e227-3c9f-bc8f-cef6b6dfb531",
                                "text": "„Ob dieser Fahndungsaufruf im Zusammenhang mit der Spielabsage steht, blieb unklar.“"
                            },
                            {
                                "example_id": "f083e484-5410-4675-a81c-00dae3b22dda",
                                "sense_id": "6d23b5d7-e227-3c9f-bc8f-cef6b6dfb531",
                                "text": "„Die Entscheidung zur Spielabsage sei während des Fluges und gleich nach der Landung getroffen worden, sagte de Maizière.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
