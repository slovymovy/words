                    "frequency": "Middle",
                    "semantic_group_id": "cloture_garde_corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'appuie contre la <w>balustrade</w> du balcon pour contempler le coucher de soleil."
                        },
                        {
                            "text": "L'architecte a choisi une magnifique <w>balustrade</w> en pierre taillée pour border la terrasse."
                        }
                    ],
                    "synonyms": [
