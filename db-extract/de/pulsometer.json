                "senses": [
                    {
                        "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                        "entry_id": "b3539a5d-ce3e-3817-9a4c-8539e903dc7b",
                        "glosses": [
                            "kolbenlose Vorrichtung zum Heben von Flüssigkeiten mithilfe von Wasserdampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edca6e5f-13d7-44e0-a6c2-81e888c8eb37",
                                "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                                "text": "„Eine direkte Hebung des Wassers durch Dampf ist möglich durch das Pulsometer.“"
                            },
                            {
                                "example_id": "61666550-bbce-4099-8d77-59c535d1b756",
                                "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                                "text": "„Ein Pulsometer zum Betrieb von einer Lokomotive aus mittels einer unterirdisch verlegten Leitung, ist in Bereitschaft.“"
                            },
                            {
                                "example_id": "2294fdda-f16e-41b8-9e8b-1ad04a3e4df0",
                                "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                                "text": "„Pulsometer sind kolbenlose Dampfpumpen mit zwei Kammern, in die der Dampf abwechselnd eintritt, wobei er die Flüssigkeit herausdrückt.“"
                            },
                            {
                                "example_id": "79f7ee4a-b5e0-4975-969b-ebc2a9cdfefe",
                                "sense_id": "3c84fe25-5961-3b06-b6c2-e62edc718b93",
                                "text": "„Die gewöhnliche Pumpe war, da sie 1,2 m unter Wasser stand, unbrauchbar geworden, und schien in Folge dessen der Pulsometer die einzige Rettung zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
