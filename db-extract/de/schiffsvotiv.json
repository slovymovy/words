                ],
                "senses": [
                    {
                        "sense_id": "f77cd848-016f-3686-96d2-ff817fb9ca1d",
                        "entry_id": "9b31b8f2-45f8-3af1-a141-7595db1307df",
                        "glosses": [
                            "Votivgabe durch einen Votanten, der zur See fährt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "39a0bd08-fc3e-41a0-b936-520f8997866c",
                                "sense_id": "f77cd848-016f-3686-96d2-ff817fb9ca1d",
                                "text": "Ein Schiffsvotiv ist gleichbedeutend mit dem Begriff Votivschiff und bezieht sich auf den Dank oder die Bitte eines Seefahrers."
                            },
                            {
                                "example_id": "c1b22769-3997-4f95-91b4-55823348b43a",
                                "sense_id": "f77cd848-016f-3686-96d2-ff817fb9ca1d",
                                "text": "„Das Patronat eines Heiligen wirkt sich höchstens insofern aus, als die darauf bezüglichen Votive häufiger vertreten sind als andere, […]. So fand ich in Sorrent […] vorwiegend Schiffsvotive und in Neapel […] vorwiegend Tiere.“"
                            },
                            {
                                "example_id": "46c81eb0-8641-482f-8c99-8b2f3e51aeb3",
                                "sense_id": "f77cd848-016f-3686-96d2-ff817fb9ca1d",
                                "text": "„Der vorliegende […] Band […] bringt eine genaue Übersicht aller ‚Schiffsmodelle‘ im kultischen Bereich. Es handelt sich dabei selbstverständlich vor allem um alte Schiffsvotive […]“"
                            },
                            {
                                "example_id": "0e45c574-17d3-43a7-a06f-5a6c7d4da3a2",
                                "sense_id": "f77cd848-016f-3686-96d2-ff817fb9ca1d",
                                "text": "„Tier- und Naturalopfer haben sich bei Ev. in Mittelfranken bis ins 19. Jh. […] erhalten, […] und bis ins 19. Jh. von ev. Schiffern gestiftete Schiffsvotive in norddeutschen und skandinavischen Kirchen.“"
                            },
                            {
                                "example_id": "2b4fb176-4da3-461d-ab27-13bb4c68beb0",
                                "sense_id": "f77cd848-016f-3686-96d2-ff817fb9ca1d",
                                "text": "„In einigen Kirchen fanden sich […] Votivbilder, in anderen Schiffsvotive aus älterer und neuerer Zeit.“"
                            },
                            {
                                "example_id": "0d71b0ef-b8da-4c49-abc4-0073235f77e9",
                                "sense_id": "f77cd848-016f-3686-96d2-ff817fb9ca1d",
                                "text": "„Das Heraion von Samos ist mit bis zu acht zu erschließenden originalen Schiffen, 22 erhaltenen ›Modellen‹, einer Schiffsteil-Nachbildung im Statuenverbund und einem Graffito eines der am besten mit Schiffsvotiven ausgestatteten griechischen Heiligtümer, […]“"
                            },
                            {
                                "example_id": "1f21fcf7-bc99-4078-9753-d17ab022add5",
                                "sense_id": "f77cd848-016f-3686-96d2-ff817fb9ca1d",
                                "text": "„Der Hinweis auf die Schiffsvotive, gewidmete Kindersärge […], geweihte Kleidungsstücke […] ließs wieder völkerpsychologische und religionsgeschichtliche Zusammenhänge ahnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
