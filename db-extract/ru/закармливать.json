                        "glosses": [
                            "to overfeed; to bring harm by overfeeding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c42a247c-11f9-4db1-9f08-4bb5728d323c",
                                "sense_id": "abaa9763-f0c2-3428-97b6-44dc9da830f7",
                                "text": "Быва́ли приме́ры на Руси́, что ма́тери из любви́ зака́рмливали дете́й свои́х до боле́зни и́ли до сме́рти.",
                                "translation": "There were instances in Rus when mothers, out of affection, would overfeed their kids to illness or death.",
                                "english": "There were instances in Rus when mothers, out of affection, would overfeed their kids to illness or death."
                            }
                        ]
                    }
