{
    "word_family": [
        "redeem",
        "redeemer",
        "redemptive",
        "redeemable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "126ad962-e9d9-3184-a112-765a4a1145c1",
                    "sense_definition": "The state of being saved from sin, error, or evil.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "salvation_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel explores themes of guilt and <w>redemption</w> in a war-torn country.",
                            "target_lang_translations": {
                                "ru": "В романе исследуются темы вины и <w>искупления</w> в охваченной войной стране.",
                                "tr": "Roman, savaşın yıktığı bir ülkede suçluluk ve <w>kurtuluş</w> temalarını işliyor."
                            }
                        },
                        {
                            "text": "He believed that his charity work was a path to <w>redemption</w> for his past mistakes.",
                            "target_lang_translations": {
                                "ru": "Он верил, что его благотворительная деятельность была путем к <w>искуплению</w> прошлых ошибок.",
                                "tr": "Hayır işlerinin, geçmişteki hataları için bir <w>keffaret</w> yolu olduğuna inanıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "salvation",
                        "deliverance",
                        "absolution"
                    ],
                    "antonyms": [
                        "damnation",
                        "condemnation"
                    ],
                    "common_phrases": [
                        "beyond redemption",
                        "seek redemption",
                        "path to redemption"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние спасения от греха, ошибок или зла.",
                        "tr": "Günahtan, hatadan veya kötülükten kurtulma durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искупление",
                                "target_lang_sense_clarification": "избавление от греха или вины"
                            },
                            {
                                "target_lang_word": "спасение",
                                "target_lang_sense_clarification": "духовное спасение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurtuluş",
                                "target_lang_sense_clarification": "manevi veya genel kurtuluş"
                            },
                            {
                                "target_lang_word": "keffaret",
                                "target_lang_sense_clarification": "günahların bedelini ödeme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6bba147-edb8-3a98-8988-eb1c436ebc60",
                    "sense_definition": "The act of making up for a mistake, fault, or failure to improve a situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "salvation_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a terrible first half, the team played with passion in search of <w>redemption</w>.",
                            "target_lang_translations": {
                                "ru": "После ужасной первой половины матча команда играла со страстью, стремясь к <w>реабилитации</w>.",
                                "tr": "Kötü geçen ilk yarının ardından takım, <w>telafi</w> arayışıyla tutkuyla oynadı."
                            }
                        },
                        {
                            "text": "Her excellent performance in the final exam was her <w>redemption</w> for the earlier failure.",
                            "target_lang_translations": {
                                "ru": "Ее отличный результат на выпускном экзамене стал ее <w>искуплением</w> за предыдущую неудачу.",
                                "tr": "Final sınavındaki mükemmel performansı, önceki başarısızlığının <w>telafisi</w> oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "atonement",
                        "restitution",
                        "compensation"
                    ],
                    "common_phrases": [
                        "chance at redemption",
                        "earn redemption"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по исправлению ошибки или неудачи для улучшения ситуации.",
                        "tr": "Bir durumu iyileştirmek için yapılan hata veya başarısızlığı telafi etme eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искупление",
                                "target_lang_sense_clarification": "заглаживание вины"
                            },
                            {
                                "target_lang_word": "реабилитация",
                                "target_lang_sense_clarification": "восстановление репутации"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "telafi",
                                "target_lang_sense_clarification": "hatayı düzeltme"
                            },
                            {
                                "target_lang_word": "itibarını kurtarma",
                                "target_lang_sense_clarification": "başarısızlık sonrası durumu düzeltme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01610981-a94c-3a54-85a7-1a8a154b01b6",
                    "sense_definition": "The repayment of a debt or the process of exchanging stocks, bonds, or coupons for money.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors requested the early <w>redemption</w> of their bonds to access cash quickly.",
                            "target_lang_translations": {
                                "ru": "Инвесторы потребовали досрочного <w>погашения</w> своих облигаций, чтобы быстро получить наличные.",
                                "tr": "Yatırımcılar, nakde hızlıca ulaşmak için tahvillerinin erken <w>itfasını</w> talep ettiler."
                            }
                        },
                        {
                            "text": "The bank charges a small fee for the <w>redemption</w> of points into gift cards.",
                            "target_lang_translations": {
                                "ru": "Банк взимает небольшую комиссию за <w>обмен</w> баллов на подарочные карты.",
                                "tr": "Banka, puanların hediye kartına <w>çevrilmesi</w> için küçük bir ücret alıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "repayment",
                        "liquidation",
                        "cash-in"
                    ],
                    "common_phrases": [
                        "redemption fee",
                        "redemption date",
                        "redemption of shares"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выплата долга или процесс обмена ценных бумаг или купонов на деньги.",
                        "tr": "Bir borcun ödenmesi veya hisse senedi, tahvil ya da kuponların paraya çevrilmesi süreci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "погашение",
                                "target_lang_sense_clarification": "облигаций или долга"
                            },
                            {
                                "target_lang_word": "обмен",
                                "target_lang_sense_clarification": "баллов или купонов"
                            },
                            {
                                "target_lang_word": "выкуп",
                                "target_lang_sense_clarification": "ценных бумаг"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "itfa",
                                "target_lang_sense_clarification": "borç veya tahvil ödemesi"
                            },
                            {
                                "target_lang_word": "nakde çevirme",
                                "target_lang_sense_clarification": "puan veya kuponların paraya dönüştürülmesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1674d6c3-cb59-3eb3-aa27-b3ca31b4f970",
                    "sense_definition": "The act of buying something back or recovering it by paying a fee or debt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He saved enough money for the <w>redemption</w> of his grandfather's watch from the pawnshop.",
                            "target_lang_translations": {
                                "ru": "Он скопил достаточно денег для <w>выкупа</w> дедушкиных часов из ломбарда.",
                                "tr": "Dedesinin saatini rehin dükkanından <w>geri almak</w> için yeterince para biriktirdi."
                            }
                        },
                        {
                            "text": "The contract specifies the terms for the <w>redemption</w> of the mortgaged property.",
                            "target_lang_translations": {
                                "ru": "В договоре указаны условия <w>выкупа</w> заложенного имущества.",
                                "tr": "Sözleşme, ipotekli mülkün <w>geri alınması</w> ile ilgili şartları belirtmektedir."
                            }
                        }
                    ],
                    "synonyms": [
                        "recovery",
                        "retrieval",
                        "buyback"
                    ],
                    "antonyms": [
                        "forfeiture"
                    ],
                    "common_phrases": [
                        "right of redemption"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выкуп чего-либо обратно или возврат имущества за плату.",
                        "tr": "Bir şeyi bir ücret veya borç ödeyerek geri alma eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкуп",
                                "target_lang_sense_clarification": "возврат заложенного имущества"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geri alma",
                                "target_lang_sense_clarification": "rehinli bir malı geri kazanma"
                            },
                            {
                                "target_lang_word": "kurtarma",
                                "target_lang_sense_clarification": "rehin veya borçtan çıkarma"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}