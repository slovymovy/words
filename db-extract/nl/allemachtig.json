                    {
                        "sense_id": "ae093dda-c2ec-3d2d-a9f1-1364647d51dc",
                        "entry_id": "da80fdd2-4571-35a6-9cac-8730527ef956",
                        "glosses": [
                            "verbazingwekkend, bijzonder, enorm"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "e910105d-f16f-4b0d-8b78-f024c5057af9",
                                "sense_id": "ae093dda-c2ec-3d2d-a9f1-1364647d51dc",
                                "text": "Dan merk je pas goed hoe allemachtig groot Afrika is."
                            },
                            {
                                "example_id": "440c0a7b-72dc-4639-904a-43c4251d987d",
                                "sense_id": "ae093dda-c2ec-3d2d-a9f1-1364647d51dc",
                                "text": "Daar kun je verlamd van raken, alleen maar doordat je met hem hebt gezoend terwijl je dat niet eens echt wilde omdat het zo allemachtig smerig is om je tong bij iemand anders in zijn mond te steken."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e8911ffa-3b62-32b0-86ed-187f1ca29783",
                "word": "allemachtig",
                "pos": "intj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c0d0b8ac-cdb1-3905-ace9-c99271e9b747",
                        "entry_id": "e8911ffa-3b62-32b0-86ed-187f1ca29783",
                        "glosses": [
                            "een uitroep van verbazing"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "f651e5f8-7810-4c55-95c2-42328dbc6902",
                                "sense_id": "c0d0b8ac-cdb1-3905-ace9-c99271e9b747",
                                "text": "Allemachtig, heeft hij dat echt gezegd?"
                            },
                            {
                                "example_id": "92436576-58e1-468d-822a-e00cfa8e003f",
                                "sense_id": "c0d0b8ac-cdb1-3905-ace9-c99271e9b747",
                                "text": "'Toe, Delly, doe het voor mij,' zei Cynth, terwijl ze tot mijn grote schrik het gedicht uit haar tas pakte en er weer gejuich door de benauwde kamer kabbelde, wat onzekerder ditmaal. Toen ik het haar een week geleden eindelijk had laten zien, als een schoolmeisje dat de lange weg aflegt naar het bureau van de onderwijzer, had ze het zwijgend gelezen. Daarna had ze haar armen om me heen geslagen en gefluisterd: 'Allemachtig, Delly, je bent echt gezegend.'"
                            }
                        ]
                    }
                ],
