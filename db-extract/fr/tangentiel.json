                "senses": [
                    {
                        "sense_id": "0269ba0c-2492-38a8-9c59-79b02875fab7",
                        "entry_id": "84021946-fd95-34d1-9530-eb17abc47700",
                        "glosses": [
                            "Qui a rapport à ce qui est tangent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "743d5dc2-da5c-42ee-a635-4868df7503fa",
                                "sense_id": "0269ba0c-2492-38a8-9c59-79b02875fab7",
                                "text": "D’après ce point de vue, chassant, comme frivole et même comme impie, cette idée, que la force tangentielle a pu être communiquée directement aux planètes par le doigt de Dieu je considère cette force comme naissant de la rotation des astres ; […]."
                            },
                            {
                                "example_id": "496982f3-77b6-4b24-b7fd-95aa34d67a4d",
                                "sense_id": "0269ba0c-2492-38a8-9c59-79b02875fab7",
                                "text": "Coordonnées tangentielles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c5ae382-5d5e-4f06-8ac8-2b01035d2e67",
                        "source_entry_id": "84021946-fd95-34d1-9530-eb17abc47700",
                        "source_sense_id": "0269ba0c-2492-38a8-9c59-79b02875fab7",
                        "target_lang_word": "tangential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tangential",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dcf301b-2c7c-34c3-9c5d-a877ceb7e6a5",
                                        "entry_id": "9793e315-2560-338e-9ab4-795614880a7e",
                                        "glosses": [
                                            "Referring to a tangent, moving at a tangent to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af6adc6b-5c45-41b1-8540-2c089b954d36",
                                                "sense_id": "0dcf301b-2c7c-34c3-9c5d-a877ceb7e6a5",
                                                "text": "The meteor came in on a tangential orbit and exploded about 8 or 10 miles above the earth's surface, just south of the Arctic Circle."
                                            },
                                            {
                                                "example_id": "3b9febc6-71b5-44f9-9ddb-06fbb9771cbf",
                                                "sense_id": "0dcf301b-2c7c-34c3-9c5d-a877ceb7e6a5",
                                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place. Applying a force tangential to the knob is essentially equivalent to applying one perpendicular to a radial line defining the lever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eb026eb-2e94-3090-a840-eb13618fd810",
                                        "entry_id": "9793e315-2560-338e-9ab4-795614880a7e",
                                        "glosses": [
                                            "Merely touching, positioned as a tangent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb9b6926-c970-459c-b88a-ce89275da6fc",
                                                "sense_id": "3eb026eb-2e94-3090-a840-eb13618fd810",
                                                "text": "The archoplasm divides and forms a very large spindle which first lies tangential to the surface of the nucleus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1268ca3b-3b3d-3c2f-9d8a-d3f0ea34f828",
                                        "entry_id": "9793e315-2560-338e-9ab4-795614880a7e",
                                        "glosses": [
                                            "Only indirectly related."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f6f0cd6-cfa7-4f3e-98b2-8b0748a3b272",
                                                "sense_id": "1268ca3b-3b3d-3c2f-9d8a-d3f0ea34f828",
                                                "text": "That subject is tangential to our discussion, and we cannot let it distract us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
