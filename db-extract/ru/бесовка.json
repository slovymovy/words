                "senses": [
                    {
                        "sense_id": "bf842558-a7d7-36b4-9af0-930d1009bdfc",
                        "entry_id": "95d15049-3be6-35da-bafe-f4451681fe15",
                        "glosses": [
                            "разг., сниж. ловкая, хитрая женщина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fe5b59-902b-4da1-91cd-10ed8418e0ef",
                                "sense_id": "bf842558-a7d7-36b4-9af0-930d1009bdfc",
                                "text": "Только Лидия подевалась куда-то. Бесовка! Заведет ведь, заманит."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3f7fb6b-d444-39cc-a6ae-5084ca22cef5",
                        "entry_id": "95d15049-3be6-35da-bafe-f4451681fe15",
                        "glosses": [
                            "прост., бран. злая, вздорная женщина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77afede0-b702-4ec4-ba46-ea488b552668",
                                "sense_id": "a3f7fb6b-d444-39cc-a6ae-5084ca22cef5",
                                "text": "На полу сидел больной ребенок и жадно теребил зубами приобретенную им с боя деревенскую лепешку, а растрепанная девчонка, присев перед ним на корточках, дразнила его языком и наделяла сильными эпитетами, между которыми чертенок играл немалую роль. ― Сама бесовка! Сама бесовка!"
                            }
                        ]
                    }
