                "senses": [
                    {
                        "sense_id": "5b5488b1-4561-3acc-837e-254f5ab5e4b0",
                        "entry_id": "8846db93-7ea3-3906-95ca-12f6f4ac9a48",
                        "glosses": [
                            "zu jedem Elementarteilchen existierendes komplementäres Teilchen"
                        ],
                        "tags": [
                            "Teilchenphysik",
                            "Kernphysik"
                        ],
                        "examples": [
                            {
                                "example_id": "a9b33eb2-ce15-4315-9bbb-f10d84d939d3",
                                "sense_id": "5b5488b1-4561-3acc-837e-254f5ab5e4b0",
                                "text": "„Im Standardmodell existieren zwölf Teilchen und zwölf Antiteilchen, welche in Leptonen und Quarks unterteilt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a58d03f-b04c-4f3f-9db0-b5242b6df04d",
                        "source_entry_id": "8846db93-7ea3-3906-95ca-12f6f4ac9a48",
                        "source_sense_id": "5b5488b1-4561-3acc-837e-254f5ab5e4b0",
                        "source_sense_description": "zu jedem Elementarteilchen existierendes komplementäres Teilchen",
                        "target_lang_word": "antiparticle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiparticle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a675d3d5-150b-38a9-b0f0-06e4bae1cf71",
                                        "entry_id": "4b1ac118-e7bd-318c-918f-e964595c237a",
                                        "glosses": [
                                            "A subatomic particle corresponding to another particle with the same mass, spin and mean lifetime but with charge, parity, strangeness and other quantum numbers flipped in sign; a particle that has a reversed world line to another."
                                        ],
                                        "tags": [
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c897cb19-4e85-46fa-b939-c3ccfa61d662",
                                                "sense_id": "a675d3d5-150b-38a9-b0f0-06e4bae1cf71",
                                                "text": "There could be whole antiworlds and antipeople made out of antiparticles. However, if you meet your antiself, don't shake hands!"
                                            },
                                            {
                                                "example_id": "77cb1608-ba5d-4d70-ad0c-af349ee5078f",
                                                "sense_id": "a675d3d5-150b-38a9-b0f0-06e4bae1cf71",
                                                "text": "Particles of matter and antimatter are identical, except for an opposite electrical charge. An electron has a negative charge whereas its antiparticle, the positron, has a positive charge, and both have an identical mass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81bb8d16-cb94-4eb0-9b15-233af32eb7ce",
                        "source_entry_id": "8846db93-7ea3-3906-95ca-12f6f4ac9a48",
                        "source_sense_id": "5b5488b1-4561-3acc-837e-254f5ab5e4b0",
                        "source_sense_description": "zu jedem Elementarteilchen existierendes komplementäres Teilchen",
                        "target_lang_word": "antiparticule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiparticule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9be28ed3-a32c-3a23-8514-418b3955736d",
                                        "entry_id": "6b4d4daa-724d-37de-b50e-fee42406c77d",
                                        "glosses": [
                                            "Analogue de la particule subatomique dont les masse, spin et durée de vie sont identiques, mais dont les charges électrique et faible sont opposées (et le cas échéant dont la charge de couleur est complémentaire)."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "296fbdb7-0d1b-4126-967e-3c14c4a69162",
                                                "sense_id": "9be28ed3-a32c-3a23-8514-418b3955736d",
                                                "text": "L'exercice est délicat car il est difficile d'empêcher de tels atomes d'entrer en contact avec des protons ou des électrons, lesquels s'annihilent avec leurs antiparticules correspondantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
