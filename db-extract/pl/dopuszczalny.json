                "senses": [
                    {
                        "sense_id": "ce4fbba0-8f18-3508-bfb3-86c92ad841c4",
                        "entry_id": "2c090100-fd7c-3fa4-b53f-9d26db1aa0db",
                        "glosses": [
                            "dozwolony, tolerowany w jakiejś sytuacji pod jakimś warunkiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6319c638-9466-48d6-ad44-d5f5c8f1f1bd",
                                "sense_id": "ce4fbba0-8f18-3508-bfb3-86c92ad841c4",
                                "text": "Szczegółowe zadania spoczywające na tej organizacji to ustalanie dopuszczalnych norm naświetlania, wykrywanie promieniowania oraz doskonalenie metod ochrony"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8320c61d-f1c1-4b20-b0a1-9afa548db84b",
                        "source_entry_id": "2c090100-fd7c-3fa4-b53f-9d26db1aa0db",
                        "source_sense_id": "ce4fbba0-8f18-3508-bfb3-86c92ad841c4",
                        "target_lang_word": "acceptable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acceptable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7632a5f-1fee-3f9b-ac7f-88cfb78ecf0e",
                                        "entry_id": "6d734766-0a24-3634-9124-a6ed090c43be",
                                        "glosses": [
                                            "Worthy, decent, sure of being accepted or received with at least moderate pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846ee3e5-493e-4a63-8dfd-b409ea91f920",
                                                "sense_id": "d7632a5f-1fee-3f9b-ac7f-88cfb78ecf0e",
                                                "text": "We need to find an acceptable present for Jeff."
                                            },
                                            {
                                                "example_id": "8132c64a-3160-4b03-a78a-6a44d974b541",
                                                "sense_id": "d7632a5f-1fee-3f9b-ac7f-88cfb78ecf0e",
                                                "text": "I think if post commanders of the unchaplained posts could employ acceptable clergymen […] then the needs might be met."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39f67e22-5f83-3500-add2-8e911fdfbb48",
                                        "entry_id": "6d734766-0a24-3634-9124-a6ed090c43be",
                                        "glosses": [
                                            "Barely worthy, less than excellent; passable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b024a8-e353-41a1-a135-1340abd07d93",
                                                "sense_id": "39f67e22-5f83-3500-add2-8e911fdfbb48",
                                                "text": "The designs were acceptable, but they were nothing special either."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acceptable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "474d6ece-ebd3-326f-be00-a41e1b562262",
                                        "entry_id": "01ecdd6e-ac69-3d85-8808-76ac4839ce4f",
                                        "glosses": [
                                            "Someone or something that is acceptable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66a2f49f-a140-43fd-b530-b9271ce1947b",
                                                "sense_id": "474d6ece-ebd3-326f-be00-a41e1b562262",
                                                "text": "The whole range of the knowable is divided into two classes, the acceptable and the avoidable. The acceptables are: Śiva, Śakti, Vidyesa, Mantra, Mantreśvara and the Jivas."
                                            },
                                            {
                                                "example_id": "4124e4b7-a442-4a3c-b6fc-9e03f63bc663",
                                                "sense_id": "474d6ece-ebd3-326f-be00-a41e1b562262",
                                                "text": "The good old acceptables are called “character” actors. An actor of the versatile order is called, casually, even contemptuously, a “character” actor."
                                            },
                                            {
                                                "example_id": "f76defd0-39d9-40d2-8d0d-1b26ed194aac",
                                                "sense_id": "474d6ece-ebd3-326f-be00-a41e1b562262",
                                                "text": "Close to 3 percent of the acceptables are free of DMF teeth while none of the rejectables have fewer than 7 DMF teeth."
                                            },
                                            {
                                                "example_id": "96df8181-1e1f-456f-8291-0eaac676ea47",
                                                "sense_id": "474d6ece-ebd3-326f-be00-a41e1b562262",
                                                "text": "The church will not be content to see that older persons are housed and entertained, or even that acceptables are worked out to provide them with therapy and income from jobs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cc1b627-e25b-486c-8f7a-cd6d269f1e22",
                        "source_entry_id": "2c090100-fd7c-3fa4-b53f-9d26db1aa0db",
                        "source_sense_id": "ce4fbba0-8f18-3508-bfb3-86c92ad841c4",
                        "target_lang_word": "permissible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permissible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dec91c4-4eb3-32cd-978b-656cad4375eb",
                                        "entry_id": "9e934d77-29b5-32eb-9c91-35dac9dcaea7",
                                        "glosses": [
                                            "permitted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8805fac7-df85-4113-a403-a8c7b62a541d",
                                                "sense_id": "0dec91c4-4eb3-32cd-978b-656cad4375eb",
                                                "text": "[...] Mr. M. N. Rollason points out that on four-track lines on which the fast lines, in the centre, are flanked by the slow lines, and running at speed is permissible on all four, the traveller can enjoy some quite exciting experiences when trains are doing a \"neck-and-neck\" on adjacent lines."
                                            },
                                            {
                                                "example_id": "6abfce5c-58ab-44f3-8b86-8490b91deb3a",
                                                "sense_id": "0dec91c4-4eb3-32cd-978b-656cad4375eb",
                                                "text": "The units will be allowed to run up to 90 m.p.h. between Chelmsford and Colchester, but their maximum speed of 100 m.p.h. is not permissible on the G.E. line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "528ae2d1-3bdb-35db-b92f-f30b0d74af3e",
                                        "entry_id": "9e934d77-29b5-32eb-9c91-35dac9dcaea7",
                                        "glosses": [
                                            "permissive"
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa69b64e-b36f-4b95-bff3-2eb9ed9f4528",
                                                "sense_id": "528ae2d1-3bdb-35db-b92f-f30b0d74af3e",
                                                "text": "As regards the incorporation of anglicisms and despite the efforts of the Real Academia Española (an official regulatory body which aims at the purity of the language), Spanish has usually been considered a rather permissible language."
                                            },
                                            {
                                                "example_id": "c578902f-846e-4caa-8444-f5a0cf194615",
                                                "sense_id": "528ae2d1-3bdb-35db-b92f-f30b0d74af3e",
                                                "text": "Japanese zoning is specified at a national level, and while local governments do have some control over their local developments, the end result is a zoning code that is very permissible compared to most other countries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87ed4699-b603-48d4-a286-c2b32e0c55ef",
                        "source_entry_id": "2c090100-fd7c-3fa4-b53f-9d26db1aa0db",
                        "source_sense_id": "ce4fbba0-8f18-3508-bfb3-86c92ad841c4",
