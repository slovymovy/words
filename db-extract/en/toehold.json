                                                "sense_id": "dddc9640-986c-3dfc-963c-26eb99eae860",
                                                "text": "Il faut mettre la prise mâle dans la prise femelle qui est ici."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5510576e-0daa-3eea-b3c5-e494f85f0ab3",
                                        "entry_id": "745d3fca-6004-3004-8ed7-0b565a29759d",
                                        "glosses": [
                                            "Terrain pris sur la mer."
                                        ],
                                        "tags": [
