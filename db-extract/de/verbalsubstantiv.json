                ],
                "senses": [
                    {
                        "sense_id": "3e413bc6-ea42-32c5-9653-f15ac5c100b1",
                        "entry_id": "8dca777c-63d9-3af0-b0ad-9a7e41363adc",
                        "glosses": [
                            "verschiedene Klassen von Substantiven, die durch Substantivierung von Verbformen entstehen"
                        ],
                        "tags": [
                            "Sammelbegriff für"
                        ],
                        "examples": [
                            {
                                "example_id": "d205a4d5-70b0-4a9a-adc0-a31bb092e8f8",
                                "sense_id": "3e413bc6-ea42-32c5-9653-f15ac5c100b1",
                                "text": "Die Wortwurzel von Verbalsubstantiven ist ein Verb."
                            },
                            {
                                "example_id": "cd1c9fb7-4b56-46c9-9ee9-bc66ab65e5a5",
                                "sense_id": "3e413bc6-ea42-32c5-9653-f15ac5c100b1",
                                "text": "„In anderen Sprachen und in früheren Sprachzuständen gibt es außerdem noch ein Gerundiv(um), das sogenannte Participium necessitatis (Partizip der Notwendigkeit; Angabe, daß das im Verb Ausgedrückte getan werden muß) und das Gerundium, ein zugehöriges Verbalsubstantiv.“"
                            },
                            {
                                "example_id": "4f0c7d6f-9d9f-4ef0-b84a-a36fa27ebd44",
                                "sense_id": "3e413bc6-ea42-32c5-9653-f15ac5c100b1",
                                "text": "„In diesem Zusammenhang konstruieren alle vier WR-Stilautoren den Gegensatz gutes Zeitwort — schlechtes Hauptwort, wobei sie sich bei der Diskussion von Hauptwörtern meist auf Verbalsubstantive beziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
