                    },
                    {
                        "translation_id": "836b01a7-d2b5-4707-becb-3178c321a6d4",
                        "source_entry_id": "cd80bc20-b396-387f-9e03-2780408cea5a",
                        "source_sense_id": "ec424ef4-beb3-3f9b-a957-8d5459658536",
                        "target_lang_word": "Wäsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wäsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a9d33cc-2f90-36ab-9481-47c30d53191b",
                                        "entry_id": "c1dbcff4-0244-36bf-b23b-eb474b475cdd",
                                        "glosses": [
                                            "Gesamtheit mehrerer Kleidungs- und Textilstücke, die kürzlich gewaschen wurden oder gewaschen werden sollen"
                                        ],
                                        "tags": [
                                            "Plural ungebräuchlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7d838f-5ef7-4d03-8a73-57ca2c1e1ff6",
                                                "sense_id": "5a9d33cc-2f90-36ab-9481-47c30d53191b",
                                                "text": "Ich muss noch die Wäsche bügeln."
                                            },
                                            {
                                                "example_id": "e43bf5ae-0eee-4d33-bbaf-b8bf4b3fb64a",
                                                "sense_id": "5a9d33cc-2f90-36ab-9481-47c30d53191b",
                                                "text": "„Am nächsten Morgen führte Claimont ein hochgewachsenes Mädchen in mein Zimmer, das mich an die Jüdin Lia erinnerte und schön war wie sie, aber weniger dünkelhaft; denn sie kam nur, um sich meiner Wäsche und meiner Spitzen anzunehmen.“"
                                            },
                                            {
                                                "example_id": "5167e3a5-a1b4-4dac-bb42-8ef31b28ba25",
                                                "sense_id": "5a9d33cc-2f90-36ab-9481-47c30d53191b",
                                                "text": "„Seine Wäsche gibt Papa Mostmann in die Wäscherei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cee99d3b-5ef1-3cb7-b65f-407be34846e5",
                                        "entry_id": "c1dbcff4-0244-36bf-b23b-eb474b475cdd",
                                        "glosses": [
                                            "der Vorgang des Waschens von ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "231e0f14-210e-4a88-87a7-f555feb1d025",
                                                "sense_id": "cee99d3b-5ef1-3cb7-b65f-407be34846e5",
                                                "text": "Ich gebe die Hose in die Wäsche."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "30c13d33-1f3d-3cae-8020-7105e58f6bc2",
                                        "entry_id": "c1dbcff4-0244-36bf-b23b-eb474b475cdd",
                                        "glosses": [
                                            "meist im Ausland stattfindende Vorgehensweise, Geld so anzulegen, dass seine Herkunft aus kriminellen Machenschaften nicht mehr nachweisbar ist"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f27d67fb-6797-41c5-8069-8d24208fa05b",
                                                "sense_id": "30c13d33-1f3d-3cae-8020-7105e58f6bc2",
                                                "text": "Er wurde wegen der Wäsche des Geldes angeklagt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1c701343-ef8a-3fb5-b371-110fb7663a78",
                                        "entry_id": "c1dbcff4-0244-36bf-b23b-eb474b475cdd",
                                        "glosses": [
                                            "(Damen-)Unterwäsche"
                                        ],
                                        "tags": [
                                            "einschränkend für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f53031d2-a19f-490e-a359-b7f13632944e",
                                                "sense_id": "1c701343-ef8a-3fb5-b371-110fb7663a78",
                                                "text": "Sie verdiente ihr Geld damit, auf Modenschauen Wäsche vorzuführen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ae5423b-d5d6-4574-9b3b-879ca95ddbcc",
                        "source_entry_id": "cd80bc20-b396-387f-9e03-2780408cea5a",
                        "source_sense_id": "ec424ef4-beb3-3f9b-a957-8d5459658536",
                        "target_lang_word": "постирушка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "постирушка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2a68f6aa-92b4-3085-86ac-f88c51c6d4dc",
                                        "entry_id": "6a8150bd-0929-3e12-ac1d-cec77e1652a6",
                                        "glosses": [
                                            "прост. небольшая стирка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d58c8023-15b2-4f16-ac19-6057c98760d1",
                                                "sense_id": "2a68f6aa-92b4-3085-86ac-f88c51c6d4dc",
                                                "text": "От окон разговор перешел к стирке и постирушке: стирка ― это крупное белье, а постирушка ― это платки, салфетки, так мелочь всякая среди недели стирается не прачкой, а прислугой."
                                            },
                                            {
                                                "example_id": "59866c17-79ba-406e-af2b-5b72dd358648",
                                                "sense_id": "2a68f6aa-92b4-3085-86ac-f88c51c6d4dc",
                                                "text": "Мне, говорит, дома как-то спокойней и постирушка ждёт."
                                            },
                                            {
                                                "example_id": "95240630-0d8e-441e-987c-231d79f27e1f",
                                                "sense_id": "2a68f6aa-92b4-3085-86ac-f88c51c6d4dc",
                                                "text": "И еще всякие постирушки брала ― и в море, и на дом, всегда у нее полное корыто стояло в кухонке."
                                            },
                                            {
                                                "example_id": "8831255f-a21c-4ac5-9954-5ecb997cf7bd",
                                                "sense_id": "2a68f6aa-92b4-3085-86ac-f88c51c6d4dc",
                                                "text": "Ночами зенитчицы азартно лупили из всех восьми стволов по пролетающим немецким самолетам, а днем разводили бесконечные постирушки: вокруг пожарного сарая вечно сушились какие-то их тряпочки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
