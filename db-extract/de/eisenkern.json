                ],
                "senses": [
                    {
                        "sense_id": "741caa9e-0ac1-3dfa-b63d-cc08d52676c6",
                        "entry_id": "f7f984d7-ec4b-3b27-a552-219b155f00e8",
                        "glosses": [
                            "Mitte eines Gegenstands/Körpers, die (größtenteils) aus Eisen besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8691e6f2-128f-4a0e-a831-c081380f1a47",
                                "sense_id": "741caa9e-0ac1-3dfa-b63d-cc08d52676c6",
                                "text": "„Theias Eisenkern hat sich mit dem der Erde verbunden und Teile des Mantels der Protoerde und von Theia wurden in den Orbit geschleudert, aus welchen der Mond entstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "547be533-a8a2-3aa5-9b45-c83e6cdc01b1",
                        "entry_id": "f7f984d7-ec4b-3b27-a552-219b155f00e8",
                        "glosses": [
                            "aus Protonen und Neutronen bestehender innerer Teil (Atomkern) des Atoms des Metalls mit der Ordnungszahl 26 (Eisen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a137b253-b510-43cd-ae93-ee27e5a4f40e",
                                "sense_id": "547be533-a8a2-3aa5-9b45-c83e6cdc01b1",
                                "text": "„Die Kruste von Neutronensternen besteht hauptsächlich aus Eisenkernen.“"
                            },
                            {
                                "example_id": "292a74a8-52c1-4239-9b7b-325c58d0113d",
                                "sense_id": "547be533-a8a2-3aa5-9b45-c83e6cdc01b1",
                                "text": "„Aus der Beziehung A = Z + N folgt, daß der Eisenkern aus 26 Protonen und 56 – 26 = 30 Neutronen aufgebaut ist.“"
                            },
                            {
                                "example_id": "32bcf00e-e57c-49e3-8d45-d622232cb2d0",
                                "sense_id": "547be533-a8a2-3aa5-9b45-c83e6cdc01b1",
                                "text": "„Dass die Differenz im Eisen so viel größer ist, liegt daran, dass der Eisenkern 26 Protonen und nicht nur eines enthält, weshalb er eine viel größere Kraft auf die Elektronen in der K- und L-Schale ausübt als der Wasserstoffkern auf sein Elektron.“"
                            },
                            {
                                "example_id": "8484bea2-5d65-46de-b114-70d1bc9dbf42",
                                "sense_id": "547be533-a8a2-3aa5-9b45-c83e6cdc01b1",
                                "text": "„Das schwerste Element, das der Stern bis dato gebildet hat, ist Eisen (Fe). Die Eisenkerne stellen demnach die Ausgangsprodukte (Edukte) für den s-Prozess dar.“"
                            },
                            {
                                "example_id": "766e2599-e0a1-4f6e-83db-ebf2c5b3dd25",
                                "sense_id": "547be533-a8a2-3aa5-9b45-c83e6cdc01b1",
                                "text": "„H. entstand zeitgleich und unabhängig 1984 in Dubna und Darmstadt durch Beschuß von Bleiatomen mit Eisenkernen [²⁰⁸Pb(⁵⁸Fe,n)²⁶⁵Hs].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
