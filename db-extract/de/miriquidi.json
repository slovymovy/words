                        "glosses": [
                            "Dunkelwald"
                        ],
                        "tags": [
                            "mythologisch"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad4dbd5c-c716-3c5e-ad2e-32ff66608e72",
                        "entry_id": "9beb07a9-eade-36c3-990f-75d2ef91e1df",
                        "glosses": [
                            "Urwald, der einst die Kammlagen des Erzgebirges und darüber hinaus große Teile des heutigen Sachsens bedeckte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e7176a-da35-4d0b-88ee-93b442abbdb4",
                                "sense_id": "ad4dbd5c-c716-3c5e-ad2e-32ff66608e72",
                                "text": "Diese alte Burg der Sorben-Wenden im einstigen Miriquidi-Walde soll schon im Jahre 912 bestanden haben und von den Hunnen erobert worden sein, ehe König Heinrich der Finkler und Städtegründer sie 933 ganz vertrieb."
                            },
                            {
                                "example_id": "c8ccedce-92fa-418c-bf52-b154aa65f1be",
                                "sense_id": "ad4dbd5c-c716-3c5e-ad2e-32ff66608e72",
                                "text": "In den Jahren um 1200 wurde durch Thietmar von Merseburg (MGH SS V, 807) das dicht bewaldete und unerschlossene Erzgebirge \"Miriquidi\" genannt. Das heißt soviel wie Dunkel- oder Finsterwald."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
