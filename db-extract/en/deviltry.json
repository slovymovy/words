                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "057176e9-e309-46d0-96b0-2b8d5a810e91",
                                                "sense_id": "09fe8f99-20d8-3a68-8c08-bb16b65cb877",
                                                "text": "„Und doch sitzt eine Teufelei dahinter.“"
                                            },
                                            {
                                                "example_id": "b6c8def6-7614-46c3-a1bb-e58e948479a2",
                                                "sense_id": "09fe8f99-20d8-3a68-8c08-bb16b65cb877",
                                                "text": "„Anscheinend steckte außer seiner sanften Liebe zu Büchern auch ein guter Schuss furchtloser Teufelei in ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e27862b4-8206-4b25-a039-75ee0427ee39",
                        "source_entry_id": "67a731e3-a573-3b40-a2ab-b89c80837b83",
                        "source_sense_id": "407d4a52-5d47-3889-95b5-39691c96cd33",
                        "source_sense_description": "devilry",
                        "target_lang_word": "Unfug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unfug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                        "entry_id": "c8c2c686-0329-3073-a32c-3a56648c51b3",
                                        "glosses": [
                                            "unsinniger oder ungehöriger Zustand; unsinnige oder ungehörige Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c5bbcc-5011-427c-b59c-a7418682a95d",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "Es ist ein Unfug, die Kinder zu erziehen, will sagen, ihnen zu befehlen, dafür aber den Erwachsenen zu gehorchen. Es ist schon deshalb ein Unfug, weil die Kindheit Stil hat und eine freimütige Vornehmheit, die man wohl zerstören, aber durch nichts ersetzen kann."
                                            },
                                            {
                                                "example_id": "fe620db1-9f39-49ce-a703-80d6c696168a",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "Daniels Sohn hat sich mit ihm auch angefreundet, die beiden pokulieren und würfeln zusammen und treiben viel Unfug."
                                            },
                                            {
                                                "example_id": "a15e443c-5455-418b-97f9-9f7b7e934e4c",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "Der Unfug mußte amtlich mit aller Strenge unterdrückt werden, denn man konnte darin ebensogut eine Verhöhnung der ehrsamen Schneiderzunft als des städtischen Polizeiwesens erblicken."
                                            },
                                            {
                                                "example_id": "247b0906-7bc3-4543-b8cc-eb420765590a",
                                                "sense_id": "53fd1e43-f398-3a95-9578-93f78ad6fa02",
                                                "text": "„Allerdings ist die Liste dessen, was man einst als unvermeidlich angesehen, später aber als Unfug erkannt hat, länger als unsere DNA.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
