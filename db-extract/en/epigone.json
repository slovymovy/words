                "entry_id": "34dc7e6c-bf37-315b-8d79-70d71f690b3c",
                "word": "epigone",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "caf5b7d2-e671-43c7-9357-6441e881466e",
                        "entry_id": "34dc7e6c-bf37-315b-8d79-70d71f690b3c",
                        "tags": [
