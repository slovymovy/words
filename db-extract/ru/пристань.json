                        "entry_id": "bbe054ee-9ee1-3d6f-b86f-0f3ff4a3619d",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "при́станях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8cfad3c-19bc-306d-a91b-9b2e286f6322",
                        "entry_id": "bbe054ee-9ee1-3d6f-b86f-0f3ff4a3619d",
                        "glosses": [
                            "место для причаливания и стоянки судов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98ea8c40-413e-45ad-9dec-62229360bf6a",
                                "sense_id": "a8cfad3c-19bc-306d-a91b-9b2e286f6322",
                                "text": "Множество кораблей прибывало в пристань, множество новых лиц появлялось на улицах."
                            },
                            {
                                "example_id": "d8d91f97-40cf-438b-ac37-edecfac0163c",
                                "sense_id": "a8cfad3c-19bc-306d-a91b-9b2e286f6322",
                                "text": "Не надо воображать себе, чтоб это была пристань благоустроенная, с анбарами, с укреплённою набережной и мощеным спуском: это просто так называемая «натуральная» пристань, большую часть навигационного времени непроходимо грязная, с невозможным спуском и ветхими, полуобвалившимися навесами вместо складочных помещений."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "292b44e0-f7dd-4dc6-9f4e-76b587475557",
                        "source_entry_id": "bbe054ee-9ee1-3d6f-b86f-0f3ff4a3619d",
                        "source_sense_id": "a8cfad3c-19bc-306d-a91b-9b2e286f6322",
                        "target_lang_word": "wharf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wharf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b52fd4bb-d914-3b63-a438-44880408504f",
                                        "entry_id": "0e83073a-aad5-3bd5-9357-3f06508ba63e",
                                        "glosses": [
                                            "An artificial landing place for ships on a riverbank or shore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ec12051-4c91-44ae-8c10-debeb67c4296",
                                                "sense_id": "b52fd4bb-d914-3b63-a438-44880408504f",
                                                "text": "Commerce pushes its wharves into the sea."
                                            },
                                            {
                                                "example_id": "c4cb90e1-27be-41ef-82b9-519b8e061916",
                                                "sense_id": "b52fd4bb-d914-3b63-a438-44880408504f",
                                                "text": "Out upon the wharfs they came, / Knight and burgher, lord and dame, / And round the prow they read her name, / The Lady of Shalott."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93254336-dc28-32e0-8b2c-be798e8df51c",
                                        "entry_id": "0e83073a-aad5-3bd5-9357-3f06508ba63e",
                                        "glosses": [
                                            "The bank of a river, or the shore of the sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "199746dd-13bb-4184-ae13-f3c3d21a5a03",
                                                "sense_id": "93254336-dc28-32e0-8b2c-be798e8df51c",
                                                "text": "the fat weed that roots itself in ease on Lethe wharf"
                                            }
                                        ]
                                    }
                                ]
                            },
