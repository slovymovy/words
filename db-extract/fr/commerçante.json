                ],
                "senses": [
                    {
                        "sense_id": "06f107d6-895b-377d-bce4-c288209fccf8",
                        "entry_id": "727d0c5a-623e-3b7f-bb09-130c362cf265",
                        "glosses": [
                            "Celle qui gagne sa vie en faisant du commerce."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "209eea57-0f0a-4239-beed-59b1892864c9",
                                "sense_id": "06f107d6-895b-377d-bce4-c288209fccf8",
                                "text": "En amour, monsieur, nous sommes toujours des naïfs, et les femmes des commerçantes."
                            },
                            {
                                "example_id": "1c27bc5f-611a-49a1-aeb6-db2369315381",
                                "sense_id": "06f107d6-895b-377d-bce4-c288209fccf8",
                                "text": "Marie-Thérèse est une commerçante, elle aime le contact avec les clients ainsi que les profits liés à la vente de ses produits."
                            }
                        ]
                    },
                    {
                        "sense_id": "a26f85e1-241e-3987-a8fd-e54f65f802ac",
                        "entry_id": "727d0c5a-623e-3b7f-bb09-130c362cf265",
                        "glosses": [
                            "Épouse d’un commerçant."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f7e4d0b9-44b5-4288-8858-dc261737737c",
                                "sense_id": "a26f85e1-241e-3987-a8fd-e54f65f802ac",
                                "text": "— C’est tout ? lui demanda la commerçante, en pensant que ce n’était pas Angélina qui faisait vivre le magasin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8c91f42-a010-44a7-84fe-1d0570c09aa2",
                        "source_entry_id": "727d0c5a-623e-3b7f-bb09-130c362cf265",
                        "source_sense_id": "06f107d6-895b-377d-bce4-c288209fccf8",
                        "source_sense_description": "Celle qui gagne sa vie en faisant du commerce",
                        "target_lang_word": "Händlerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Händlerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                                        "entry_id": "cdb95add-2485-37c9-b102-6c3be9cea456",
                                        "glosses": [
                                            "weibliche Person, die mit etwas handelt, einen Handel betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c67d88ce-02d2-4a23-ae00-7a6656cb8a02",
                                                "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                                                "text": "Die Händlerinnen haben sich darauf geeinigt, ihre Geschäfte in der Mittagszeit offen zu halten."
                                            },
                                            {
                                                "example_id": "6b6eba21-2b3d-4ff8-bde2-1ba6bb23d550",
                                                "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                                                "text": "„Die Händlerin aus Torshok bot ihm mit ihrer kreischenden Stimme ihre Waren an, besonders Pantoffeln aus Ziegenleder.“"
                                            },
                                            {
                                                "example_id": "1b961711-3c18-4082-9881-da3442da3155",
                                                "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                                                "text": "„Die Händlerin versteifte sich darauf, sie habe drei gesagt.“"
                                            },
                                            {
                                                "example_id": "7598c495-88ae-49ba-b046-35f82866eb5b",
                                                "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                                                "text": "„Der Zeitungsjunge, die Fischerfrauen auf dem Belsunce, die Händlerinnen, die ihre Läden öffneten, die Arbeiter auf dem Weg zur Frühschicht, sie alle gehörten zur Menge derer, die nie abfahren, mag geschehen, was will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
