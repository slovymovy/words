                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "f0ed5a54-2c89-4e4c-921b-b7820ddd513b",
                                "sense_id": "b792e9b3-1cf1-327b-8bf1-838cef756eca",
                                "text": "Хорошо ещё, что у нас граница надёжно охраняется, иначе захватившая судно литературная банда высадилась бы в Иерусалиме."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a2a513e-9819-334a-840a-91ed65285796",
                        "entry_id": "9069bb22-a7de-36d4-bb4a-0930e46c347e",
                        "glosses": [
                            "об ощущении или состоянии надёжности, уверенности"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": [
                            {
                                "example_id": "fb6a4dd3-7513-4d71-997e-4c4a54969f3a",
                                "sense_id": "2a2a513e-9819-334a-840a-91ed65285796",
                                "text": "Мне тепло, непроницаемо, надёжно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cac3abc-6198-42a9-a186-49e0af529849",
                        "source_entry_id": "9069bb22-a7de-36d4-bb4a-0930e46c347e",
                        "source_sense_description": "наречие",
                        "target_lang_word": "reliably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reliably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "242efb43-e275-345d-9d18-8dc7dfb36c88",
                                        "entry_id": "b616d159-afbb-3e48-90a2-aa0e61d48d65",
                                        "glosses": [
                                            "In a reliable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a84bed0-aa54-4f1b-b4a0-77f5d03af82a",
                                                "sense_id": "242efb43-e275-345d-9d18-8dc7dfb36c88",
                                                "text": "Genuine cowards follow the wicked and cannot reliably sustain any virtue."
                                            },
                                            {
                                                "example_id": "aa9d885a-f262-427d-a935-cbb1dd2b969c",
                                                "sense_id": "242efb43-e275-345d-9d18-8dc7dfb36c88",
                                                "text": "Above all, rail needs to be boring. By that, I mean that it must run its timetable reliably, day-in and day-out. Punctuality and reliability remain the bedrock of a successful railway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cde2bb0-4339-4e33-b090-5e9a05957f6b",
                        "source_entry_id": "9069bb22-a7de-36d4-bb4a-0930e46c347e",
                        "source_sense_description": "наречие",
                        "target_lang_word": "con seguridad",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "df0806e1-e571-435f-be7e-abb7f645409c",
                        "source_entry_id": "9069bb22-a7de-36d4-bb4a-0930e46c347e",
                        "source_sense_description": "наречие",
                        "target_lang_word": "getreulich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "86c10959-1018-4cc2-9098-d8f53b0e81db",
                        "source_entry_id": "9069bb22-a7de-36d4-bb4a-0930e46c347e",
                        "source_sense_description": "наречие",
                        "target_lang_word": "sicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                        "entry_id": "6ae7e153-ecee-35d8-89fa-203287fee3ff",
                                        "glosses": [
                                            "vor Gefahren geschützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57db07ed-359e-4c8e-9c3a-509d7bc79a2d",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„Drachenfliegen ist heute mindestens ebenso sicher wie Segelfliegen – dank enormer technischer Entwicklungen.“"
                                            },
                                            {
                                                "example_id": "7f563aae-e6f8-4b18-ae17-47fc367bdfc8",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "Sie verstauten das Geld an einem sicheren Ort."
                                            },
                                            {
                                                "example_id": "cd7e9d94-84d1-4c83-bc17-87b20c82ff2b",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„Fliegen war noch niemals so sicher, wie heute“, behaupten die Luftverkehrsunternehmen."
                                            },
                                            {
                                                "example_id": "314ec59f-9b0d-4e14-be57-7f054f3f0524",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„12.3.2011 angesichts der Fukushima-Katastrophe: ‘An so einem Tag darf man sicher nicht sagen, unsere Kernkraftwerke sind sicher. (Pause) Sie sind sicher.‘ “"
                                            },
                                            {
                                                "example_id": "8dd7849a-9d03-479f-9214-171684c21c1a",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„Und es gilt auch der Satz, zum Mitschreiben: Die Rente ist sicher!“ (Dr. Norbert Blüm, CDU, Bundesminister für Arbeit und Sozialordnung, Rede vor dem Deutschen Bundestag, 10. Oktober 1997)"
                                            },
                                            {
                                                "example_id": "3473209a-d922-4e99-a0d9-d7cdfa5e5f12",
                                                "sense_id": "0cec2c3a-a8f4-3032-a2a4-11a273680459",
                                                "text": "„Der Schiläufer, der ein steiles Gelände sicher hinabfahren will, muss Schutzreflexe abbauen. […] Er muss das Schutzstreben in die Rücklage aufgeben und mutig die Vorlage suchen, um seine Schier sicher führen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8bc96e97-7b73-3596-9c38-42e4bb2e1caa",
                                        "entry_id": "6ae7e153-ecee-35d8-89fa-203287fee3ff",
                                        "glosses": [
                                            "mit sehr hoher Wahrscheinlichkeit eintreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63b2537-2a86-436e-9b30-545c34728cff",
                                                "sense_id": "8bc96e97-7b73-3596-9c38-42e4bb2e1caa",
                                                "text": "Das ist ein sicherer Gewinn."
                                            },
                                            {
                                                "example_id": "4b6933d0-450e-46a3-876b-6330750d7f1f",
                                                "sense_id": "8bc96e97-7b73-3596-9c38-42e4bb2e1caa",
                                                "text": "Die Anzahl hochrangiger Banker auf dem Weltwirtschaftsforum in Davos ist enorm. Das ist eine gute Gelegenheit, mit ihnen darüber zu diskutieren, ob die Finanzmärkte seit der Krise [in 2008] sicherer geworden sind."
                                            },
                                            {
                                                "example_id": "41f77e1c-0e6b-408f-8f4d-a9f5b7ed0e50",
                                                "sense_id": "8bc96e97-7b73-3596-9c38-42e4bb2e1caa",
                                                "text": "Wieviel Orang-Utans noch in freier Wildbahn leben, ist nicht sicher, die Schätzungen liegen zwischen 70.000 und 150.000 Exemplaren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4a5ad3ee-ce6d-319c-b485-370bcfcaec53",
                                        "entry_id": "6ae7e153-ecee-35d8-89fa-203287fee3ff",
                                        "glosses": [
                                            "selbstbewusst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8384a64-ae64-448c-9c9f-c47f2a71d889",
                                                "sense_id": "4a5ad3ee-ce6d-319c-b485-370bcfcaec53",
                                                "text": "„Der Schiläufer, der ein steiles Gelände sicher hinabfahren will, muss Schutzreflexe abbauen. […] Er muss das Schutzstreben in die Rücklage aufgeben und mutig die Vorlage suchen, um seine Schier sicher führen zu können.“"
                                            },
                                            {
                                                "example_id": "da8f8127-eb09-48db-a296-ed131c60b941",
                                                "sense_id": "4a5ad3ee-ce6d-319c-b485-370bcfcaec53",
                                                "text": "Der Redner hatte ein sehr sicheres Auftreten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9732cbc0-23b3-3099-a352-c051dcd1924d",
                                        "entry_id": "6ae7e153-ecee-35d8-89fa-203287fee3ff",
                                        "glosses": [
                                            "bestimmt, gewiss, unzweifelhaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95153832-cbeb-4d62-88d9-a2eb200a4863",
                                                "sense_id": "9732cbc0-23b3-3099-a352-c051dcd1924d",
                                                "text": "Sicher, das können wir so machen. Dann treffen wir uns in einer halben Stunde."
                                            },
                                            {
                                                "example_id": "3eeb883a-87de-476e-a27b-f52ac6ce3a0f",
                                                "sense_id": "9732cbc0-23b3-3099-a352-c051dcd1924d",
                                                "text": "Ich bin mir sicher, dass Frau Gärtner noch anruft."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "sicher",
                                "target_lang_code": "de",
                                "target_senses": [
