        "fr-extract.jsonl": [
            {
                "entry_id": "c34c8e3d-ba82-301e-9b00-c7d92134d166",
                "word": "touffeur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "085106f4-899e-4a6f-83de-c809f8ff033d",
                        "entry_id": "c34c8e3d-ba82-301e-9b00-c7d92134d166",
                        "tags": [
                            "plural"
                        ],
                        "form": "touffeurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd2f1d0b-5df0-3564-9f96-c1b124fafbcb",
                        "entry_id": "c34c8e3d-ba82-301e-9b00-c7d92134d166",
                        "glosses": [
                            "Atmosphère épaisse et lourde qui saisit en entrant dans un lieu où la chaleur est extrême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ce4b0b-0c57-44db-8f7a-5c0e627d8856",
                                "sense_id": "fd2f1d0b-5df0-3564-9f96-c1b124fafbcb",
                                "text": "Nous sommes exposés dans notre climat, par l’effet des chaleurs de la fin de mai et du commencement de juin, à des touffeurs auxquelles les vers à soie résistent difficilement."
                            },
                            {
                                "example_id": "482da312-18a6-4bb8-8c83-25cff633d660",
                                "sense_id": "fd2f1d0b-5df0-3564-9f96-c1b124fafbcb",
                                "text": "Vers une heure du matin, sommés par la faim, nous entrâmes dans une gargote tapie dans l’ombre de la gare Montparnasse. Un caboulot terne et bas de plafond, d’une touffeur d’aspic populaire."
                            },
                            {
                                "example_id": "db9ae40b-8438-4496-8449-271a3091bdd3",
                                "sense_id": "fd2f1d0b-5df0-3564-9f96-c1b124fafbcb",
                                "text": "Dans le même temps des contre-courants se lèvent, charriant sur fond de musique houleuse une ardeur têtue à vivre autrement, à sortir des ghettos, des bourbiers des guerres, de la touffeur d’un quotidien compassé et mesquin."
                            },
                            {
                                "example_id": "c79b5db8-aa07-4837-b8d3-89c3c17e260a",
                                "sense_id": "fd2f1d0b-5df0-3564-9f96-c1b124fafbcb",
                                "text": "Elle aurait pu être une héroïne durassienne déambulant, l’air mélancolique, dans la touffeur d’un penthouse tropical."
                            },
                            {
                                "example_id": "2589b477-ed97-44b8-a823-b58ab4edf7f5",
                                "sense_id": "fd2f1d0b-5df0-3564-9f96-c1b124fafbcb",
                                "text": "La saison verte était de retour, celle des pluies et de la touffeur. Et elle succédait à l’interminable saison blonde, celle qui donnait durant neuf mois de l’année son teint de miel au veld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "128eeaf7-cf16-414f-b8ee-b76ad0d35b4d",
                        "source_entry_id": "c34c8e3d-ba82-301e-9b00-c7d92134d166",
                        "source_sense_id": "fd2f1d0b-5df0-3564-9f96-c1b124fafbcb",
                        "target_lang_word": "sultriness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sultriness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98d5603d-9ca1-36f8-9a00-92c9480bb639",
                                        "entry_id": "5f120c79-61ee-3a41-9d41-99eae1f9a73f",
                                        "glosses": [
                                            "The state or quality of being sultry."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de477b3b-0347-4115-94c1-bb4d0cfc0b1c",
                                                "sense_id": "98d5603d-9ca1-36f8-9a00-92c9480bb639",
                                                "text": "All I Need, Sylvester's most recent album, is first rate. Here is a dance record that doesn't forget it's a dance record: it delivers! From the easy sultriness of the title cut to the libidinous urgency of \"Hard Up,\" the seven selections […] have your foot tapping and your body jumping."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4270025d-1f1b-4402-a279-9714c4ffca63",
                        "source_entry_id": "c34c8e3d-ba82-301e-9b00-c7d92134d166",
                        "source_sense_id": "fd2f1d0b-5df0-3564-9f96-c1b124fafbcb",
                        "target_lang_word": "fug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4433748-527c-3cbc-9443-5fbb395d7cb9",
                                        "entry_id": "2441235c-50db-3dc3-8e76-57f3a7581bb5",
                                        "glosses": [
                                            "A heavy, musty, stuffy or unpleasant atmosphere, usually in a poorly-ventilated area."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed1c79fa-15f2-41f6-9e9b-12f86c9b83d6",
                                                "sense_id": "c4433748-527c-3cbc-9443-5fbb395d7cb9",
                                                "text": "'Made one quite thankful to get back to the fug, though as a rule I think the way these trains are overheated is something scandalous'."
                                            },
                                            {
                                                "example_id": "6b37425b-d77a-4666-8afa-4be8a46def76",
                                                "sense_id": "c4433748-527c-3cbc-9443-5fbb395d7cb9",
                                                "text": "On certain days, when hot currents shimmered off Oyster's Reef, we would detect the chalk-dust of the mullock heaps, acrid; or, from the opal mines themselves, the ghastly fug of the tunnels and shafts."
                                            },
                                            {
                                                "example_id": "7cad2ed9-10d0-4e0a-b6dc-5fa23747ef28",
                                                "sense_id": "c4433748-527c-3cbc-9443-5fbb395d7cb9",
                                                "text": "The gym teacher left that year, his successors had no interest in boxing, and society soon passed into a zone where the idea of thirteen-year-old boys punching each other's faces for educational purposes became as unthinkable as the dense fug of tobacco smoke in our school's staff room."
                                            },
                                            {
                                                "example_id": "51d5896f-6979-4823-9755-9821d2512bc7",
                                                "sense_id": "c4433748-527c-3cbc-9443-5fbb395d7cb9",
                                                "text": "The misty fug his breath had left on the window sparkled in the orange glare of the streetlamp outside."
                                            },
                                            {
                                                "example_id": "d658b9c8-a0ac-44ed-b88f-3fea8a0b88f1",
                                                "sense_id": "c4433748-527c-3cbc-9443-5fbb395d7cb9",
                                                "text": "That's what a fug was. You could have cut cubes out of the air and sold it for cheap building material."
                                            },
                                            {
                                                "example_id": "cf39a416-3d49-4d3c-9930-ccb808ca5d97",
                                                "sense_id": "c4433748-527c-3cbc-9443-5fbb395d7cb9",
                                                "text": "Inside, though, the little café was warm and bright, with a comforting fug of tea and baked bread and cakes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4ab3e2e-d333-35f6-a07d-990854de41bd",
                                        "entry_id": "2441235c-50db-3dc3-8e76-57f3a7581bb5",
                                        "glosses": [
                                            "A state of lethargy and confusion; daze."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d7bfcd8-1d3c-4310-a34a-1997f4e7b98a",
                                                "sense_id": "a4ab3e2e-d333-35f6-a07d-990854de41bd",
                                                "text": "So delicious after the fug of summer. It makes one feel so alive."
                                            },
                                            {
                                                "example_id": "fc144edd-4b7c-48b9-9708-d18d1e818dd4",
                                                "sense_id": "a4ab3e2e-d333-35f6-a07d-990854de41bd",
                                                "text": "Somewhere in the fug of her mind she remembered how to close it and fetched the pole, slotting it into the mechanism above and beginning to turn the handles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dfb0cec-adbd-3dd0-bd08-fc8ef4079388",
                                        "entry_id": "2441235c-50db-3dc3-8e76-57f3a7581bb5",
                                        "glosses": [
                                            "A state of chaos or confusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8715a556-a6bb-4018-8cc4-944b74ff90b3",
                                                "sense_id": "8dfb0cec-adbd-3dd0-bd08-fc8ef4079388",
                                                "text": "There was a fug of fear in the room."
                                            },
                                            {
                                                "example_id": "af62afec-8bcd-4f65-951a-5409937c8326",
                                                "sense_id": "8dfb0cec-adbd-3dd0-bd08-fc8ef4079388",
                                                "text": "Viewed from this perspective, the Victorian era reeks of a suffocating and bigoted complacency, and, no doubt, many white imperialists existed in a fug of self-righteous superiority."
                                            },
                                            {
                                                "example_id": "cf6cf49c-a792-472a-be69-3a899a3c42e5",
                                                "sense_id": "8dfb0cec-adbd-3dd0-bd08-fc8ef4079388",
                                                "text": "But now am in total fug about what to text Roxster about tonight, and whether I should tell him about the nits."
                                            },
                                            {
                                                "example_id": "37e61059-9475-46c0-8470-7015751a2a34",
                                                "sense_id": "8dfb0cec-adbd-3dd0-bd08-fc8ef4079388",
                                                "text": "Her translations are dimmed over with a fug of late eighteenthcentury poetic diction, a striving for sublimity or for sentimental effect."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59c5f000-11b1-30a1-9072-77a0edfea7ee",
                                        "entry_id": "94e5ac1f-2a57-32f7-affa-7a1d5d8f5066",
                                        "glosses": [
                                            "To create a fug (heavy unpleasant atmosphere)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b08e766-ef81-485b-a797-aef8cdb58eaa",
                                                "sense_id": "59c5f000-11b1-30a1-9072-77a0edfea7ee",
                                                "text": "Inside, the Golden Lion was fugged with the smoke of too many cigarettes and the unhappy sound of a darts team practising."
                                            },
                                            {
                                                "example_id": "924a1716-1f3e-48aa-b2cd-197ab3bd3642",
                                                "sense_id": "59c5f000-11b1-30a1-9072-77a0edfea7ee",
                                                "text": "I'd walked down, for maybe the last time, from my lodgings behind New Fish Street, through air already fugged with smoke from the morning fires."
                                            },
                                            {
                                                "example_id": "887fda8b-60a2-49ee-8bda-b4582f04644f",
                                                "sense_id": "59c5f000-11b1-30a1-9072-77a0edfea7ee",
                                                "text": "The rich sewer gases fugged around her and she shook her head, trying to clear it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b8d0068-8e9e-30bf-a8d2-ed7dc8a794de",
                                        "entry_id": "94e5ac1f-2a57-32f7-affa-7a1d5d8f5066",
                                        "glosses": [
                                            "To be surrounded by a fug (heavy unpleasant atmosphere)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1a4281-e6d4-4286-b76f-ba3fbb7675b9",
                                                "sense_id": "3b8d0068-8e9e-30bf-a8d2-ed7dc8a794de",
                                                "text": "\"Well, I like it a jolly sight better than fugging up in those carriages with all that gassing crowd of Garden Home fussers.\""
                                            },
                                            {
                                                "example_id": "384682ba-87f5-4b9d-9ff3-a089a3d77e19",
                                                "sense_id": "3b8d0068-8e9e-30bf-a8d2-ed7dc8a794de",
                                                "text": "The air was warm and close and the late afternoon sun was fugging through grey clouds and making them light - still grey, but light, really light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e349ce10-5e40-3960-ab8b-37d92abfdd42",
                                        "entry_id": "94e5ac1f-2a57-32f7-affa-7a1d5d8f5066",
                                        "glosses": [
                                            "To put into a fug (daze)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81954e6f-18bc-48a9-94d3-f9d12304fc9a",
                                                "sense_id": "e349ce10-5e40-3960-ab8b-37d92abfdd42",
                                                "text": "The adrenalin, though diminished, was still running through my veins; the red mist was lifting but my mind was fugged by this unfamiliar combination of hormones, slowly intermingling with indignity and contrition and the dawning of familiar, ignominious defeat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5cf5479-35df-37fb-aef0-fe62a643009f",
                                        "entry_id": "94e5ac1f-2a57-32f7-affa-7a1d5d8f5066",
                                        "glosses": [
                                            "To remain indoors, usually in a tightly closed room."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9def9052-22bf-334c-9c26-2575d6dd6099",
                                        "entry_id": "2769b188-55ba-3d2d-aafe-62d47af242c6",
                                        "glosses": [
                                            "Euphemistic form of fuck."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9fbfd43-9181-4b7e-accf-4d1bd5eed1ae",
                                                "sense_id": "9def9052-22bf-334c-9c26-2575d6dd6099",
                                                "text": "It's always somethin' or other. Ah, fug it. I'm away now."
                                            },
                                            {
                                                "example_id": "65730ecf-f267-481a-acdd-005b4ffab4b9",
                                                "sense_id": "9def9052-22bf-334c-9c26-2575d6dd6099",
                                                "text": "Oh fug. Whad a mess."
                                            },
                                            {
                                                "example_id": "62ea3ee8-acb2-41c9-ae80-ff75ee236b84",
                                                "sense_id": "9def9052-22bf-334c-9c26-2575d6dd6099",
                                                "text": "“Why is this door locked?” she shouts. “Oh fug!”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de53857d-1618-3d6d-b2db-f3ead0133193",
                                        "entry_id": "1c7fb2f5-2bcd-3418-b6b0-ba662676cf76",
                                        "glosses": [
                                            "Euphemistic form of fuck.",
                                            "Used to express displeasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71cdc7c7-f7ce-4fb8-a8ec-3ea2b3e3d098",
                                                "sense_id": "de53857d-1618-3d6d-b2db-f3ead0133193",
                                                "text": "He knew he would never eat them; they were merely an added load in his pack. Aaah, fug this."
                                            },
                                            {
                                                "example_id": "ce0a41fd-9e25-407c-b0fe-f0571f3a2701",
                                                "sense_id": "de53857d-1618-3d6d-b2db-f3ead0133193",
                                                "text": "Scornfully the driver answered, \"Fug you muthafug, you ain't gon drive this muthafuggin cah.\""
                                            },
                                            {
                                                "example_id": "1e068056-6695-4d5d-9454-51c1a48f9123",
                                                "sense_id": "de53857d-1618-3d6d-b2db-f3ead0133193",
                                                "text": "\"Fug this place,\" Jeff said. \"Let's go to the pier in case that jerk comes back with a gun.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4618294-34d7-39b6-8343-bca1cf86facd",
                                        "entry_id": "1c7fb2f5-2bcd-3418-b6b0-ba662676cf76",
                                        "glosses": [
                                            "Euphemistic form of fuck.",
                                            "To damage or destroy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268912b3-0d36-4d5d-a5db-e1ebc256f818",
                                                "sense_id": "a4618294-34d7-39b6-8343-bca1cf86facd",
                                                "text": "Zit my fault the rotary fugged up and the new one's buggered?"
                                            },
                                            {
                                                "example_id": "62a86cac-233d-4da4-83bd-7d2548bb8489",
                                                "sense_id": "a4618294-34d7-39b6-8343-bca1cf86facd",
                                                "text": "You mean like in Zola–because they were fugged up in their turn by their parents."
                                            },
                                            {
                                                "example_id": "116b0fbf-34e0-4611-8799-b85abb026991",
                                                "sense_id": "a4618294-34d7-39b6-8343-bca1cf86facd",
                                                "text": "Tell them every detail, so they can find an Apprentice again, because if they don't, they're fugged.”"
                                            },
                                            {
                                                "example_id": "912c6c2f-f249-4bdd-ad99-e64a4e64abaa",
                                                "sense_id": "a4618294-34d7-39b6-8343-bca1cf86facd",
                                                "text": "He did an imitation of Big Jerry in full-choke cantankerousness: “'You'll just fug it up.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6027fded-9940-329d-bd27-b90f63d49fdf",
                                        "entry_id": "1c7fb2f5-2bcd-3418-b6b0-ba662676cf76",
                                        "glosses": [
                                            "Euphemistic form of fuck.",
                                            "To copulate with."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49d47d00-8195-48c8-91f7-4f97cae69b5d",
                                                "sense_id": "6027fded-9940-329d-bd27-b90f63d49fdf",
                                                "text": "All went well until girls started writing things like, 'I want to win a date with Tuli because I want him to fug me.'"
                                            },
                                            {
                                                "example_id": "987b88da-5ede-4a0b-9dba-24595dbd6bf7",
                                                "sense_id": "6027fded-9940-329d-bd27-b90f63d49fdf",
                                                "text": "Married, two children, doesn't let him fug her any more."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dabba24-e794-3de6-ac77-25f44ad4e9ce",
                                        "entry_id": "11f082d1-9ce6-346f-bc03-1329bfb28fec",
                                        "glosses": [
                                            "Euphemistic form of fuck.",
                                            "Used as an intensifier."
                                        ],
                                        "tags": [
                                            "singular",
                                            "singular-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fcce1ff-1e96-4809-9d12-b176705d4846",
                                                "sense_id": "4dabba24-e794-3de6-ac77-25f44ad4e9ce",
                                                "text": "I don't know jes where the fug he think he is at."
                                            },
                                            {
                                                "example_id": "2b68a1f6-df87-43a5-9a8e-c2edcc550eda",
                                                "sense_id": "4dabba24-e794-3de6-ac77-25f44ad4e9ce",
                                                "text": "How the fug does a thug like you know about any preacher?"
                                            },
                                            {
                                                "example_id": "173ab5f2-9bfc-46d1-99fe-e4266a178000",
                                                "sense_id": "4dabba24-e794-3de6-ac77-25f44ad4e9ce",
                                                "text": "I mean, who the fug cares?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d55b2d5-c2d2-3749-a87d-e82da60395f1",
                                        "entry_id": "11f082d1-9ce6-346f-bc03-1329bfb28fec",
                                        "glosses": [
                                            "Euphemistic form of fuck.",
                                            "Something of little value."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "076678c0-cd44-4596-885c-f7d7e95e111b",
                                                "sense_id": "3d55b2d5-c2d2-3749-a87d-e82da60395f1",
                                                "text": "I didn't know what any of it meant and didn't give a fug either."
                                            },
                                            {
                                                "example_id": "17e89add-19c9-4ae8-924c-82fa1a314850",
                                                "sense_id": "3d55b2d5-c2d2-3749-a87d-e82da60395f1",
                                                "text": "After a short pause, Jay proclaimed, “I don't give a fug what you wave in fronna me. I'm sticking to my story.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe66c2f0-6add-3b2d-9afb-c27b7064ca05",
                                        "entry_id": "11f082d1-9ce6-346f-bc03-1329bfb28fec",
                                        "glosses": [
                                            "Euphemistic form of fuck.",
                                            "A contemptible person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d2691c7-588e-4514-b3fb-903c34980d6c",
                                                "sense_id": "fe66c2f0-6add-3b2d-9afb-c27b7064ca05",
                                                "text": "Look at those fugs!"
                                            },
                                            {
                                                "example_id": "9ee6b3a5-052f-431a-8ce6-be40fe87e299",
                                                "sense_id": "fe66c2f0-6add-3b2d-9afb-c27b7064ca05",
                                                "text": "'You bein' there an' him bein' there an' you such a fug of a loser an' him such a fug of a winner . . .'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
