        "fr-extract.jsonl": [
            {
                "entry_id": "d52113f1-2ef3-3c65-b606-04abcf1ace05",
                "word": "rugissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "29b51a31-ce84-4162-a30a-cd54c7015ee3",
                        "entry_id": "d52113f1-2ef3-3c65-b606-04abcf1ace05",
                        "tags": [
                            "plural"
                        ],
                        "form": "rugissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1b3844c-69d5-310d-974d-f963abb386f9",
                        "entry_id": "d52113f1-2ef3-3c65-b606-04abcf1ace05",
                        "glosses": [
                            "Action de rugir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe3c8ae-ce33-4ea4-9292-94244185ed9b",
                                "sense_id": "a1b3844c-69d5-310d-974d-f963abb386f9",
                                "text": "Le rugissement des lions, le hennissement des chevaux, le braiement des ânes, le bêlement des béliers, le mugissement des taureaux, le grognement des cochons, des sangliers et des verrats, le raîment des cerfs, la voix grêle des gazelles, le murmure amoureux des rongeurs, les cris inarticulés des singes, les hautes clameurs des alouettes, le triste hurlement des hyènes, le glapissement des renards, le gromellement des blaireaux, &c. ; enfin tous ces accens divers dont résonnent les forêts et les déserts sauvages, ne sont dans les animaux que l’expression des desirs^([sic]) d’amour."
                            },
                            {
                                "example_id": "1a0e1f2f-5d5d-4f01-aa0a-08dcfa744c92",
                                "sense_id": "a1b3844c-69d5-310d-974d-f963abb386f9",
                                "text": "Et je n'entendis plus qu'un murmure confus, semblable au murmure de la marée montante, ou au rugissement sauvage qui s'élève dans le bestiaire quand on vient d'ouvrir l’arène."
                            },
                            {
                                "example_id": "26e0df90-5906-4683-8d7e-522c63cc5beb",
                                "sense_id": "a1b3844c-69d5-310d-974d-f963abb386f9",
                                "text": "Le jour tirait à sa fin, le soleil n’allait pas tarder à disparaître et déjà les hôtes mystérieux de la forêt poussaient par intervalles de sourds rugissements."
                            },
                            {
                                "example_id": "9841504b-29a2-4199-9b9c-88417d948487",
                                "sense_id": "a1b3844c-69d5-310d-974d-f963abb386f9",
                                "text": "En voyant cela, le commandant de la région militaire du Småland péta un câble. Avec un rugissement, il tenta de soulever une vieille dame et de la foutre dehors, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67aad494-abfa-41a6-9992-165b0ab9c21b",
                        "source_entry_id": "d52113f1-2ef3-3c65-b606-04abcf1ace05",
                        "source_sense_id": "a1b3844c-69d5-310d-974d-f963abb386f9",
                        "target_lang_word": "roar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06d06d92-76fb-3550-b12d-46b3e7a813a6",
                                        "entry_id": "46d8a3c0-32b3-3b85-8acf-e7c210a83991",
                                        "glosses": [
                                            "To make a loud, deep cry, especially from pain, anger, or other strong emotion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc846e0-1a17-4935-bd77-85a5a82703cf",
                                                "sense_id": "06d06d92-76fb-3550-b12d-46b3e7a813a6",
                                                "text": "Sole on the barren ſands the ſuff'ring chief / Roar'd out for anguiſh, and indulg'd his grief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f7a2cc6-968c-3dc7-9031-558c33bae30f",
                                        "entry_id": "46d8a3c0-32b3-3b85-8acf-e7c210a83991",
                                        "glosses": [
                                            "To laugh in a particularly loud manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bbd3f9a-6d4c-416f-a843-342e217c2978",
                                                "sense_id": "5f7a2cc6-968c-3dc7-9031-558c33bae30f",
                                                "text": "The audience roared at his jokes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d65819e-5d69-3b0d-b910-bb3d8e2a4bb0",
                                        "entry_id": "46d8a3c0-32b3-3b85-8acf-e7c210a83991",
                                        "glosses": [
                                            "Of animals (especially a lion), to make a loud deep noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8938cb-a78e-4e74-a975-4e45342a328d",
                                                "sense_id": "5d65819e-5d69-3b0d-b910-bb3d8e2a4bb0",
                                                "text": "The lioness roared to scare off the hyenas."
                                            },
                                            {
                                                "example_id": "5b61712f-af97-4519-bff9-203791cbd86e",
                                                "sense_id": "5d65819e-5d69-3b0d-b910-bb3d8e2a4bb0",
                                                "text": "Roaring bulls he would him make to tame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a04ba4d2-45b6-3c8a-8cf6-7b1496005450",
                                        "entry_id": "46d8a3c0-32b3-3b85-8acf-e7c210a83991",
                                        "glosses": [
                                            "Generally, of inanimate objects etc., to make a loud resounding noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9a2054e-ae78-45e1-ae50-7d1d798daf7a",
                                                "sense_id": "a04ba4d2-45b6-3c8a-8cf6-7b1496005450",
                                                "text": "The brazen throat of war had ceased to roar."
                                            },
                                            {
                                                "example_id": "f4972ea3-ff8b-43d1-8a89-bc0b50e8b066",
                                                "sense_id": "a04ba4d2-45b6-3c8a-8cf6-7b1496005450",
                                                "text": "How oft I crossed where carts and coaches roar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63f7f567-9b55-38d2-a80c-c7d5971b8b98",
                                        "entry_id": "46d8a3c0-32b3-3b85-8acf-e7c210a83991",
                                        "glosses": [
                                            "To proceed vigorously."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735efbec-3c3f-4563-a0a6-98e96554ced4",
                                                "sense_id": "63f7f567-9b55-38d2-a80c-c7d5971b8b98",
                                                "text": "United's attempt to extend their unbeaten league sequence to 23 games this season looked to be in shreds as the Seasiders - managed by Ian Holloway - roared into a fully deserved two-goal lead at the interval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3232c6cc-503a-3582-afa2-3342d0cd2eb2",
                                        "entry_id": "46d8a3c0-32b3-3b85-8acf-e7c210a83991",
                                        "glosses": [
                                            "To cry aloud; to proclaim loudly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "687013cd-7475-49ab-98a3-f8558cebda87",
                                                "sense_id": "3232c6cc-503a-3582-afa2-3342d0cd2eb2",
                                                "text": "This last action will roar thy infamy."
                                            },
                                            {
                                                "example_id": "eea4576b-24ca-4d87-a036-3c80f1f48b84",
                                                "sense_id": "3232c6cc-503a-3582-afa2-3342d0cd2eb2",
                                                "text": "I made a speaking trumpet of my hands and commenced to whoop “Ahoy!” and “Hello!” at the top of my lungs. […] The Colonel woke up, and, after asking what in brimstone was the matter, opened his mouth and roared “Hi!” and “Hello!” like the bull of Bashan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7abe3108-b218-3ad4-9803-f72699c9d35c",
                                        "entry_id": "46d8a3c0-32b3-3b85-8acf-e7c210a83991",
                                        "glosses": [
                                            "To be boisterous; to be disorderly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1d749bc-fcd2-4568-a70c-9f8ef575cc75",
                                                "sense_id": "7abe3108-b218-3ad4-9803-f72699c9d35c",
                                                "text": "It was a mad, roaring time, full of extravagance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e31a4149-da70-3fac-aeb6-14039b3ccf19",
                                        "entry_id": "46d8a3c0-32b3-3b85-8acf-e7c210a83991",
                                        "glosses": [
                                            "To make a loud noise in breathing, as horses do when they have a certain disease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4e230b1-7f0c-3bdb-9be8-636cb65c9b8c",
                                        "entry_id": "46d8a3c0-32b3-3b85-8acf-e7c210a83991",
                                        "glosses": [
                                            "To cry."
                                        ],
                                        "tags": [
                                            "British",
                                            "Midlands",
                                            "North",
                                            "Yorkshire",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "749f29a1-d36f-4aa0-9ada-ba29824f66cd",
                                                "sense_id": "a4e230b1-7f0c-3bdb-9be8-636cb65c9b8c",
                                                "text": "Tom, Tom, the piper's son,\nStole a pig, and away he run!\nThe pig was eat, and Tom was beat,\nAnd Tom went roaring down the street."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7edc508-9b17-3e30-9177-02a40e7778fb",
                                        "entry_id": "96fa300a-dc85-3356-8e63-8fc56ed8cb05",
                                        "glosses": [
                                            "A long, loud, deep shout, as of rage or laughter, made with the mouth wide open."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2fa9df5-8b1e-310c-986a-9c71e2da88ef",
                                        "entry_id": "96fa300a-dc85-3356-8e63-8fc56ed8cb05",
                                        "glosses": [
                                            "The cry of the lion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d3b4935-1f49-4bd9-9c9f-40e84c33702f",
                                                "sense_id": "b2fa9df5-8b1e-310c-986a-9c71e2da88ef",
                                                "text": "The Winkies were not a brave people, but they had to do as they were told. So they marched away until they came near to Dorothy. Then the Lion gave a great roar and sprang towards them, and the poor Winkies were so frightened that they ran back as fast as they could."
                                            },
                                            {
                                                "example_id": "22039558-ccb3-4c60-9f1c-9d4f2533cff7",
                                                "sense_id": "b2fa9df5-8b1e-310c-986a-9c71e2da88ef",
                                                "text": "Tarzan could imagine how old Numa’s eyes were shining—how he was already sucking in his breath for the awful roar which would freeze his prey for the brief instant between the moment of the spring and the sinking of terrible fangs into splintering bones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7048d863-e47b-38e1-856c-bd40b8bb8dca",
                                        "entry_id": "96fa300a-dc85-3356-8e63-8fc56ed8cb05",
                                        "glosses": [
                                            "The deep cry of the bull."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cc7dc68-86a8-3c8d-af0a-9d68dcc90397",
                                        "entry_id": "96fa300a-dc85-3356-8e63-8fc56ed8cb05",
                                        "glosses": [
                                            "A loud resounding noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d922aa0-74fc-47ff-98fd-b7265e8eb96c",
                                                "sense_id": "9cc7dc68-86a8-3c8d-af0a-9d68dcc90397",
                                                "text": "the roar of a motorbike"
                                            },
                                            {
                                                "example_id": "c6b705ed-bf26-49c5-be73-9cf7f6d6eb1b",
                                                "sense_id": "9cc7dc68-86a8-3c8d-af0a-9d68dcc90397",
                                                "text": "I stand amid the roar / Of a surf-tormented shore, / And I hold within my hand / Grains of the golden sand—"
                                            },
                                            {
                                                "example_id": "123c19af-9ee9-4445-b6d2-f66b89b03a8b",
                                                "sense_id": "9cc7dc68-86a8-3c8d-af0a-9d68dcc90397",
                                                "text": "Those lovely valleys and mountains were filled throughout the day and night with the roar of heavy shooting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5927b0f9-637b-368e-9301-f1d39fe3a3c6",
                                        "entry_id": "96fa300a-dc85-3356-8e63-8fc56ed8cb05",
                                        "glosses": [
                                            "A show of strength or character."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
