                "senses": [
                    {
                        "sense_id": "30b06f53-b9ea-32b8-8a0f-c15b5ab7fb6d",
                        "entry_id": "70037312-d9a0-3583-b8a1-03f58934b9d4",
                        "glosses": [
                            "Dune dominante, plus ou moins pyramidale, formant un réseau étoilé de crêtes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c31bb67-c0f7-470c-a75a-7a7e7315c21f",
                                "sense_id": "30b06f53-b9ea-32b8-8a0f-c15b5ab7fb6d",
                                "text": "Aujourd’hui les cols sont faciles et les chaînes peu élevées, les plus hauts oghroud ont une cinquantaine de mètres et de très rares pics en comptent peut-être 70. Nous campons au pied du ghourd dit Ghourd Ed-Dar ou Ghourd Dar-Er-Ghoule."
                            },
                            {
                                "example_id": "facdb164-a404-4095-91d6-640933de09fb",
                                "sense_id": "30b06f53-b9ea-32b8-8a0f-c15b5ab7fb6d",
                                "text": "Forme dunaire la plus monumentale, les oghroud (pluriel de ghourd) sont en effet des sortes de pyramides au sommet desquelles convergent des siouf en étoile."
                            },
                            {
                                "example_id": "307e8ff6-29bf-455b-a8d0-273ec103b67b",
                                "sense_id": "30b06f53-b9ea-32b8-8a0f-c15b5ab7fb6d",
                                "text": "Les ghourds, qui sont les édifices d’accumulation les plus hauts de la planète (jusqu’à 400 mètres de hauteur) sont des dunes pyramidales à trois ou quatre bras d’une envergure de 500 à 3 000 mètres, façonnées par des vents dont le régime est pluridirectionnel."
                            }
                        ]
                    }
