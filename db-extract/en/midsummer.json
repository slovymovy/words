                    {
                        "translation_id": "744bea62-091e-4bbf-911e-361617216b33",
                        "source_entry_id": "651222cb-405c-3b72-97ff-5fcf0a985e3c",
                        "source_sense_description": "The middle of summer",
                        "target_lang_word": "Hochsommer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochsommer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54b33eaf-bcf9-300a-8c9a-663dc2347659",
                                        "entry_id": "2c71d25b-8984-3211-b50c-d8e4b3813046",
                                        "glosses": [
                                            "die Zeit in der Mitte des Sommers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06591622-961a-4e4d-b5c4-b1ed4ddba585",
                                                "sense_id": "54b33eaf-bcf9-300a-8c9a-663dc2347659",
                                                "text": "Viele Früchte reifen im Hochsommer."
                                            },
                                            {
                                                "example_id": "f0f3d0af-d322-4412-96a7-42873f83c107",
                                                "sense_id": "54b33eaf-bcf9-300a-8c9a-663dc2347659",
                                                "text": "„Eines Tages im Hochsommer trauten wir unseren Augen kaum.“"
                                            },
                                            {
                                                "example_id": "5a0e3750-d173-4e60-8abe-e5886224cab2",
                                                "sense_id": "54b33eaf-bcf9-300a-8c9a-663dc2347659",
                                                "text": "„Kostas war überrascht, wie grün und schattig es hier mitten im Hochsommer war, als Hans den Wagen nach einer halben Stunde im Innenhof einer Villa parkte.“"
                                            },
                                            {
                                                "example_id": "2b7f50db-7854-49ee-b118-f0c8173d1709",
                                                "sense_id": "54b33eaf-bcf9-300a-8c9a-663dc2347659",
                                                "text": "„Im Hochsommer wurde Prinzessin Marja durch einen Brief des Fürsten Andrej aus der Schweiz überrascht, in welchem er ihr eine seltsame und völlig unerwartete Neuigkeit mitteilte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
