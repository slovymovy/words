                    {
                        "translation_id": "2380e6bf-0869-41bc-ba3d-70b916909cf4",
                        "source_entry_id": "b9360983-453c-3f54-8d1e-00f7226b4bf8",
                        "source_sense_id": "d49ef4f5-7d25-3804-835b-2bfab7bd61f9",
                        "source_sense_description": "to free or deprive of illusion; to disenchant",
                        "target_lang_word": "desillusionieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desillusionieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86f56534-d8a3-3769-86a3-fafc415a73e8",
                                        "entry_id": "28f6c2d4-b7e3-3959-a235-9fa05abd5c17",
                                        "glosses": [
                                            "die positive Einschätzung, Hoffnung, Euphorie oder Illusion nehmen und in eine ernstere Stimmung versetzen, die mehr den Tatsachen entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e68c168-8b1e-49ec-afd4-da9e6085c8a1",
                                                "sense_id": "86f56534-d8a3-3769-86a3-fafc415a73e8",
                                                "text": "„Bist du so desillusioniert, dass du nicht glauben kannst, dass ein Mann an mehr als nur Sex interessiert ist?« »Ich bin überhaupt nicht desillusioniert, ich bin ...« Sie lachte und nippte am Wein. »Himmel, ja, ich bin desillusioniert.«“"
                                            },
                                            {
                                                "example_id": "9643fa18-1146-48f4-894b-0af8f2691302",
                                                "sense_id": "86f56534-d8a3-3769-86a3-fafc415a73e8",
                                                "text": "„»Das einförmige Soldatenleben« ohne anregende Gesellschaft desillusionierte den nationalliberalen Patrioten. »Ich kann gar nicht sagen, wie verhasst mir die ganze Militärgeschichte wird«, schrieb er Heinrich Brunn im August 1878.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
