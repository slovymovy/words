                    {
                        "translation_id": "bf4fc201-6a85-428b-b607-b88dc2bbcde6",
                        "source_entry_id": "3a31c408-d4ac-3a2b-8e20-8f41e90b6e30",
                        "source_sense_id": "271b492f-3a3c-37e2-9cd1-d7a2a7104035",
                        "target_lang_word": "Langobarde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Langobarde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "325749b5-e6e6-3c3d-baa0-31681b3cf983",
                                        "entry_id": "c76f3aee-b417-3e10-915c-5084b1991526",
                                        "glosses": [
                                            "Angehöriger des gleichnamigen, antiken elbgermanischen Stammes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc603e2-8df8-4fb2-a13e-6c47b1975041",
                                                "sense_id": "325749b5-e6e6-3c3d-baa0-31681b3cf983",
                                                "text": "„Der Nordteil der Landschaft lag vielleicht bereits zeitweise im Siedlungsgebiete der Langobarden.“"
                                            },
                                            {
                                                "example_id": "1621264a-2bff-499d-935d-88243cb575d8",
                                                "sense_id": "325749b5-e6e6-3c3d-baa0-31681b3cf983",
                                                "text": "„Anders als diese Völker, die in der Regel raubend und verwüstend durchs Land geschweift waren, wollten sich die Langobarden hier dauerhaft niederlassen.“"
                                            },
                                            {
                                                "example_id": "6c17a177-c533-4bfa-b270-aa377abafdd2",
                                                "sense_id": "325749b5-e6e6-3c3d-baa0-31681b3cf983",
                                                "text": "„569 eroberten die germanischen Langobarden Mailand, errichteten 572 ihren Königssitz in Pavia und teilten ihr Reich in Herzogtümer auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5de8d01-2f7b-4299-908b-96ea1002f424",
                        "source_entry_id": "3a31c408-d4ac-3a2b-8e20-8f41e90b6e30",
                        "source_sense_id": "271b492f-3a3c-37e2-9cd1-d7a2a7104035",
