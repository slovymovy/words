                ],
                "senses": [
                    {
                        "sense_id": "1e9e32e7-4821-3a13-a736-1ddfb9af53ad",
                        "entry_id": "90de2053-4ed5-3f99-b79c-802d20b22a56",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b25a7fc-5554-4b5f-a8e4-0122091f8fab",
                                "sense_id": "1e9e32e7-4821-3a13-a736-1ddfb9af53ad",
                                "text": "Frau Schweble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b0ba884c-7300-4a3b-a929-d1d53c978456",
                                "sense_id": "1e9e32e7-4821-3a13-a736-1ddfb9af53ad",
                                "text": "Herr Schweble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "929bb073-8276-4d41-9ea5-819a6d8262b0",
                                "sense_id": "1e9e32e7-4821-3a13-a736-1ddfb9af53ad",
                                "text": "Die Schwebles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "56f4e98a-9ed0-4159-a256-cc124668a074",
                                "sense_id": "1e9e32e7-4821-3a13-a736-1ddfb9af53ad",
                                "text": "Der Schweble trägt nie die Pullover, die die Schweble ihm strickt."
                            },
                            {
                                "example_id": "34d0ed6c-fc48-4735-bf53-63fa134f139e",
                                "sense_id": "1e9e32e7-4821-3a13-a736-1ddfb9af53ad",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schweble kommt, geht der Herr Schweble.“"
                            },
                            {
                                "example_id": "f962afb9-d5df-4b96-ba59-aec0e186989b",
                                "sense_id": "1e9e32e7-4821-3a13-a736-1ddfb9af53ad",
                                "text": "Schweble kommt und geht."
                            },
                            {
                                "example_id": "cf6c4c28-ddc7-46be-b3fe-fb32ed6ca529",
                                "sense_id": "1e9e32e7-4821-3a13-a736-1ddfb9af53ad",
                                "text": "Schwebles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
