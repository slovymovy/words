                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93971feb-50b2-46c9-86de-2892cd56bada",
                                                "sense_id": "b923b220-859e-35f6-bf82-449964a77f6e",
                                                "text": "Nobody has lived in it since the summer of 1879, and it is fast going to pieces. For some three years before the date mentioned above, it was occupied by the family of Charles May"
