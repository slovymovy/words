{
    "word_family": [
        "afwikkelen",
        "inwikkelen",
        "ontwikkelen",
        "verwikkelen",
        "wikkeling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a960ab6-a8e2-3e7d-988b-46de347d5846",
                    "sense_definition": "iets bedekken door er materiaal omheen te doen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verpakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>wikkelt</w> het cadeau voorzichtig in mooi papier.",
                            "target_lang_translations": {
                                "en": "She carefully <w>wraps</w> the gift in beautiful paper."
                            }
                        },
                        {
                            "text": "Je moet een warme sjaal om je nek <w>wikkelen</w> tegen de kou.",
                            "target_lang_translations": {
                                "en": "You should <w>wrap</w> a warm scarf around your neck against the cold."
                            }
                        }
                    ],
                    "synonyms": [
                        "inpakken",
                        "omhullen",
                        "omwikkelen"
                    ],
                    "antonyms": [
                        "uitpakken",
                        "ontrollen"
                    ],
                    "common_phrases": [
                        "in papier wikkelen",
                        "om de vinger wikkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cover something by putting material around it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wrap",
                                "target_lang_sense_clarification": "to enclose an object in paper or fabric"
                            },
                            {
                                "target_lang_word": "wrap around",
                                "target_lang_sense_clarification": "to coil something around a part of the body"
                            },
                            {
                                "target_lang_word": "envelop",
                                "target_lang_sense_clarification": "to wrap up, cover, or surround completely"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8abbf87-9a04-3fc1-a550-915a73a75543",
                    "sense_definition": "een buigzaam voorwerp herhaaldelijk rond een as of kern draaien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "draaien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser moet de lijn weer op de spoel <w>wikkelen</w>.",
                            "target_lang_translations": {
                                "en": "The fisherman has to <w>wind</w> the line back onto the reel."
                            }
                        },
                        {
                            "text": "Hij <w>wikkelde</w> de draad strak om de metalen staaf.",
                            "target_lang_translations": {
                                "en": "He <w>wound</w> the wire tightly around the metal rod."
                            }
                        }
                    ],
                    "synonyms": [
                        "winden",
                        "oprollen",
                        "draaien"
                    ],
                    "antonyms": [
                        "afwikkelen",
                        "afrollen"
                    ],
                    "common_phrases": [
                        "om een spoel wikkelen",
                        "strak wikkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn a flexible object repeatedly around an axis or core"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wind",
                                "target_lang_sense_clarification": "to turn coils of cord or thread around something"
                            },
                            {
                                "target_lang_word": "roll",
                                "target_lang_sense_clarification": "to wrap something round on itself"
                            },
                            {
                                "target_lang_word": "reel",
                                "target_lang_sense_clarification": "to wind something onto a spool or cylinder"
                            },
                            {
                                "target_lang_word": "coil",
                                "target_lang_sense_clarification": "to wind into a series of loops"
                            }
                        ]
                    }
                }
            ]
        }
    ]
