                "senses": [
                    {
                        "sense_id": "f0f8075b-f129-37da-8e2b-f743455e6169",
                        "entry_id": "3dc7fea9-ada8-3473-8386-8381d2b2de70",
                        "glosses": [
                            "Se présenter socialement comme une femme ; se dit d’une personne trans, qu’elle soit une femme ou homme."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bd15b6b3-e6fe-4f7f-bb55-e64abc7fd307",
                                "sense_id": "f0f8075b-f129-37da-8e2b-f743455e6169",
                                "text": "C’est telllllement mieux en vrai de girlmoder tout le temps même si a force [que] tu t’habitue ça reste mieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5750ed5c-7492-4197-86ec-948875cf13c4",
                        "source_entry_id": "3dc7fea9-ada8-3473-8386-8381d2b2de70",
                        "source_sense_id": "f0f8075b-f129-37da-8e2b-f743455e6169",
                        "target_lang_word": "girlmode",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "girlmode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c93c4cfb-eaf5-3098-94dd-fbec367cf5e1",
                                        "entry_id": "7ca277f0-c80b-3d93-821e-c544feda616b",
                                        "glosses": [
                                            "The state of presenting as a girl or woman, regardless of one's actual gender identity."
                                        ],
                                        "tags": [
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f7f61d1-a1a3-4b68-96f8-a83e86c231a5",
                                                "sense_id": "c93c4cfb-eaf5-3098-94dd-fbec367cf5e1",
                                                "text": "Coordinate term: boymode"
                                            },
                                            {
                                                "example_id": "676c9e01-b326-492b-8a1f-ce8379aeba10",
                                                "sense_id": "c93c4cfb-eaf5-3098-94dd-fbec367cf5e1",
                                                "text": "Saw another cow-orker at a local big hoity-toity benefit gala. Just went up and tapped him on the shoulder. Of course I told two others who were with me to follow me if they wanted to see a real goodie. He was very shocked, but cool about it. :) Took him a few seconds to realize just who I was, even though he had seen me in girlmode at the office H'ween party."
                                            },
                                            {
                                                "example_id": "9438b185-a45b-43fd-816a-11e91cb3bc81",
                                                "sense_id": "c93c4cfb-eaf5-3098-94dd-fbec367cf5e1",
                                                "text": "I was driving home late from seeing my friends in girlmode, and got stuck in a massive traffic jam. The guy in the car next to me gets out to check the traffic and stretch. In the process he saw me and gave me that look, and kept glancing my way for a while."
                                            },
                                            {
                                                "example_id": "96e7a1ab-1aa4-46ee-a6b8-a1459a7205ad",
                                                "sense_id": "c93c4cfb-eaf5-3098-94dd-fbec367cf5e1",
                                                "text": "This is so relatable, but also kinda good for me sometimes? Like the one time I got catcalled in girlmode and it was actually weirdly euphoric. Ewphoria, as it were."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "girlmode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d505bc71-b609-36c3-9160-017bb66741bb",
                                        "entry_id": "a1662c05-2da7-391a-8bca-a6cca0baa946",
                                        "glosses": [
                                            "To present as a girl or woman, regardless of one's actual gender identity."
                                        ],
                                        "tags": [
                                            "especially",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0c11cd4-14d4-47d1-8b6e-451b634de8c6",
                                                "sense_id": "d505bc71-b609-36c3-9160-017bb66741bb",
                                                "text": "Coordinate term: boymode"
                                            },
                                            {
                                                "example_id": "5ab82f92-b3f7-4e18-b71e-2329d62d316b",
                                                "sense_id": "d505bc71-b609-36c3-9160-017bb66741bb",
                                                "text": "lmao everyone think i'm girlmoding nah bitch i just wear plain white shirts and skinny jeans, that's called lazymoding"
                                            },
                                            {
                                                "example_id": "25edd40c-0591-4b8b-8bd6-6a331029591f",
                                                "sense_id": "d505bc71-b609-36c3-9160-017bb66741bb",
                                                "text": "I swear my mere presence, boymoding or girlmoding, has historically spread transness. Stumbled upon a friendship group I moved in when I was about 14 on twitter and half of them are trans now. I'm patient zero and nobody can tell me otherwise."
                                            },
                                            {
                                                "example_id": "d3f41650-b1ff-4566-a6e5-bc20a7e4f711",
                                                "sense_id": "d505bc71-b609-36c3-9160-017bb66741bb",
                                                "text": "My confidence has been doing a lot better since girlmoding more. I still need a lot more clothes, better makeup skills, and my eyebrows fixed for me to feel more comfortable but I’m trying at least."
                                            },
                                            {
                                                "example_id": "bae06334-167a-4082-9bb0-85a832dfb668",
                                                "sense_id": "d505bc71-b609-36c3-9160-017bb66741bb",
                                                "text": "hi. recently quit a job that felt more like an abusive relationship. […] right and right again, i have had about an interview every two weeks for the last two months but to no avail- they all ghost. i use a feminine name and dont pass well due to my long hair and how i talk. i am starting to wonder if i am not hearing back from anyone (even the ones who promise a second interview, which has been three times now, have ghosted!) because i am clearly trans. would it be better to girlmode and come out later??"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
