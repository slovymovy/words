                                        "entry_id": "aebb91ed-03ff-305c-84b3-e17fe7ee0803",
                                        "glosses": [
                                            "im engeren Sinn: das Land, das zwischen den beiden Flüssen Euphrat und Tigris in Nordost-Syrien und im Irak liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ca2e12-e345-4fa3-a749-c6cc514a89e7",
                                                "sense_id": "925207a3-b2fe-3047-86d6-78caeb4e4d23",
                                                "text": "Die Sumerer lebten in Mesopotamien."
                                            },
                                            {
                                                "example_id": "74514e17-7998-436a-a426-308ade8e6692",
                                                "sense_id": "925207a3-b2fe-3047-86d6-78caeb4e4d23",
                                                "text": "„So nahm der Knecht zehn Kamele von den Kamelen seines Herrn und zog hin und hatte mit sich allerlei Güter seines Herrn und machte sich auf und zog nach Mesopotamien, zu der Stadt Nahors.“"
                                            },
                                            {
                                                "example_id": "bf7eb711-4cad-4659-a7b8-422c0740b8e8",
                                                "sense_id": "925207a3-b2fe-3047-86d6-78caeb4e4d23",
                                                "text": "das Mesopotamien der Antike"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca05c237-2572-34f1-a1ff-fb18a32abaf9",
                                        "entry_id": "aebb91ed-03ff-305c-84b3-e17fe7ee0803",
                                        "glosses": [
                                            "im weiteren Sinn: das gesamte flache Steppenland zwischen der arabischen Wüste und den östliche Randlagen des Zagros- und Taurusgebirges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0542e739-fd22-49df-b779-213158638cdb",
                                                "sense_id": "ca05c237-2572-34f1-a1ff-fb18a32abaf9",
                                                "text": "Wenn man heute von Mesopotamien spricht, meint man den heutigen Irak."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
