                    "sense_definition": "pełniący rolę pomocniczą, podporządkowany czemuś lub związany ze służeniem komuś albo czemuś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "podporządkowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sztuka pełniła w tym okresie przede wszystkim rolę <w>służebną</w> wobec panującej ideologii.",
                            "target_lang_translations": {
                                "ru": "Искусство в этот период играло прежде всего <w>служебную</w> роль по отношению к господствующей идеологии."
                            }
                        },
                        {
                            "text": "Teoretyczne rozważania naukowe powinny mieć charakter <w>służebny</w> względem praktyki.",
                            "target_lang_translations": {
                                "ru": "Теоретические научные рассуждения должны носить <w>вспомогательный</w> характер по отношению к практике."
                            }
                        }
                    ],
                    "synonyms": [
                        "służbowy"
                    ],
                    "common_phrases": [
                        "rola służebna",
                        "charakter służebny",
                        "funkcja służebna"
                    ],
                    "target_lang_definitions": {
                        "ru": "играющий вспомогательную роль, подчинённый чему-либо или служащий кому-либо либо чему-либо"
