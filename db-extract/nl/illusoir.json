                "senses": [
                    {
                        "sense_id": "619e43c7-939e-39d4-b203-81369ce29cb3",
                        "entry_id": "c888124a-adab-3418-8b18-f4be8efe83ee",
                        "glosses": [
                            "alleen maar in de verbeelding bestaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74f475c-50a0-4a46-83b4-935944df9fed",
                                "sense_id": "619e43c7-939e-39d4-b203-81369ce29cb3",
                                "text": "Premier wordt Mark Rutte, dat kan niet anders. Alle pleidooien, ook hier gedaan, voor een nieuwe man of vrouw op deze plaats, zijn illusoir."
                            },
                            {
                                "example_id": "780cb338-dc30-492f-b2b5-10469a82856b",
                                "sense_id": "619e43c7-939e-39d4-b203-81369ce29cb3",
                                "text": "De door de Russische elite felbegeerde deal, waarbij Amerika de sancties tegen Rusland zou opheffen met als wisselgeld wellicht minder wederzijdse nucleaire bewapening, lijkt inmiddels illusoir."
                            },
                            {
                                "example_id": "5909f299-8ad5-4a5c-8686-64757a1ee20c",
                                "sense_id": "619e43c7-939e-39d4-b203-81369ce29cb3",
                                "text": "Volgens de hoogste bestuursrechter maakte de gemeentelijke verordening de mogelijkheden tot het belijden van godsdienst \"niet illusoir\"."
                            }
                        ]
                    }
