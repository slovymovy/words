                        "sense_id": "cc3bb963-b4cf-3c7c-9812-43912847c6e6",
                        "entry_id": "57f4a01f-d241-3a84-b6f8-6ea6c3a9ebbf",
                        "glosses": [
                            "Lohn nach Abzug von sonstigen Abgaben und Steuern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46173c97-2319-4b4f-9843-281c20c42123",
                                "sense_id": "cc3bb963-b4cf-3c7c-9812-43912847c6e6",
                                "text": "„Für die Berechnung der Abfertigung sei zugunsten des Klägers von diesem Nettolohn auf den Bruttolohn hochgerechnet worden.“"
                            },
                            {
                                "example_id": "7a0a1074-646c-4ae5-b54f-2db0f64dd84f",
                                "sense_id": "cc3bb963-b4cf-3c7c-9812-43912847c6e6",
                                "text": "Mit seinem Nettolohn kommt er gut über die Runden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
