                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e54a89d-2b36-4721-ac7f-0276861e2bb0",
                                                "sense_id": "2e267964-aafd-36e0-aeb5-055999ae33e7",
                                                "text": "Er war bewusstlos und daher nicht ansprechbar."
                                            },
                                            {
                                                "example_id": "959da7de-2c56-466f-be5c-818fbcc4c620",
                                                "sense_id": "2e267964-aafd-36e0-aeb5-055999ae33e7",
                                                "text": "Er war so beschäftigt, dass er den Abend über nicht ansprechbar war."
                                            },
                                            {
                                                "example_id": "0242b3d9-21bb-419d-9702-df387a0eb333",
                                                "sense_id": "2e267964-aafd-36e0-aeb5-055999ae33e7",
                                                "text": "Ich bin für meine Kunden von neun bis sechs Uhr ansprechbar."
                                            }
