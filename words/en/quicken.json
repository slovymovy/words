                    "frequency": "VeryLow",
                    "semantic_group_id": "plants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The path was lined with a thick <w>quicken</w> hedge that turned bright red in the autumn.",
                            "target_lang_translations": {
                                "ru": "Тропинка была обсажена густой изгородью из <w>рябины</w>, которая осенью становилась ярко-красной."
