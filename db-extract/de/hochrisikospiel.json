                ],
                "senses": [
                    {
                        "sense_id": "af561ee2-a6fa-3f41-9c52-d0047bfec2ca",
                        "entry_id": "1ab1deb8-b75f-3d83-a146-697a7b8729f2",
                        "glosses": [
                            "Spiel, das aus bestimmten Gründen, wie die Feindschaft unter Fangruppen, unter erhöhten Sicherheitsbedingungen stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e5df70-c2bc-4dee-adac-f902b7a909e9",
                                "sense_id": "af561ee2-a6fa-3f41-9c52-d0047bfec2ca",
                                "text": "„Dem Preußen-Fanklub ‚Curva Monasteria‘ war auf einer Zugfahrt die heilige Fahne abhanden gekommen, und in der Anhängerschar der Osnabrücker wurde gestreut, sie sei nun in deren Besitz und werde beim Derby gehisst. Eine Provokation, auf die die Ordnungskräfte vorbereitet waren. Das Spiel galt als Hochrisikospiel.“"
                            },
                            {
                                "example_id": "fcfaf3ac-c1f1-44e3-9763-e0888b85a562",
                                "sense_id": "af561ee2-a6fa-3f41-9c52-d0047bfec2ca",
                                "text": "„Die Begegnung Union gegen Dynamo gilt seit langem als Hochrisikospiel, so die offizielle Bezeichnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
