                        "sense_id": "a99139ee-82ff-3ae6-9751-d4fb52a9a1fa",
                        "entry_id": "919efa93-7154-3013-90f1-632d649cadf6",
                        "glosses": [
                            "Tente des nomades du nord-ouest de la Sibérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e91044f-fa88-450a-a614-f35ed35ab4f6",
                                "sense_id": "a99139ee-82ff-3ae6-9751-d4fb52a9a1fa",
                                "text": "Ils vivent dans des tchoums, qui sont de grandes tentes ressemblant à des tipis et fabriqués à partir de grands poteaux et de peaux de rennes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a8991a1-98fb-4c41-af27-c1c843a19d6e",
                        "source_entry_id": "919efa93-7154-3013-90f1-632d649cadf6",
