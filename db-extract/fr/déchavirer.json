                        "entry_id": "2fc28d98-96a2-353a-8cf3-3c5a6ed0b13d",
                        "glosses": [
                            "Faire perdre son caractère chaviré à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a13745c-55f5-4e56-952a-a05edeb20541",
                                "sense_id": "77f2b1ed-16f9-342c-98db-1a6dd9cf3b5b",
                                "text": "J’ai besoin de chavirer mon corps et de le déchavirer."
                            },
                            {
                                "example_id": "14a9fb14-ebd6-401d-b390-61d2e16da032",
                                "sense_id": "77f2b1ed-16f9-342c-98db-1a6dd9cf3b5b",
                                "text": "Après, on sent ses boyaux qui se déchirent, on sent son cœur qui chavire et déchavire."
                            },
                            {
                                "example_id": "1cd700a2-9854-4b47-957e-e95231179696",
                                "sense_id": "77f2b1ed-16f9-342c-98db-1a6dd9cf3b5b",
                                "text": "Un petit coup de tord-boyau pour vous « déchavirer » le cœur ?"
                            }
                        ]
                    }
