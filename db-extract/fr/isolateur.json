                                                "sense_id": "e171d99e-20a4-3bde-8456-3e63bb35814c",
                                                "text": "Porzellan ist ein guter Isolator."
                                            },
                                            {
                                                "example_id": "efae0c93-ad2e-4c5d-a2a1-c165be6d2b5e",
                                                "sense_id": "e171d99e-20a4-3bde-8456-3e63bb35814c",
                                                "text": "Quarzglas ist auch noch bei deutlich höheren Temperaturen ein Isolator."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d83a6bb-6ad9-317d-8822-2fcaf6109db7",
