{
    "word_family": [
        "barrow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a9706b15-c5b0-3a7f-9131-110de49b2250",
                    "sense_definition": "A mound of earth and stones raised over a grave or graves.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists carefully excavated the ancient <w>barrow</w> to learn about the burial customs of the tribe.",
                            "target_lang_translations": {
                                "tr": "Arkeologlar, kabilenin defin geleneklerini öğrenmek için antik <w>tümülüsü</w> dikkatlice kazdılar."
                            }
                        },
                        {
                            "text": "The king was laid to rest beneath a large <w>barrow</w> overlooking the valley.",
                            "target_lang_translations": {
                                "tr": "Kral, vadiye bakan büyük bir <w>tümülüsün</w> altına defnedildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "See burial mound § Synonyms"
                    ],
                    "target_lang_definitions": {
                        "tr": "Mezar veya mezarların üzerine yığılmış toprak ve taşlardan oluşan tümsek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tümülüs",
                                "target_lang_sense_clarification": "Arkeolojik terim olarak mezar tepesi."
                            },
                            {
                                "target_lang_word": "höyük",
                                "target_lang_sense_clarification": "Genel olarak toprak yığını veya eski yerleşim yeri tepesi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb84b3da-4f1d-3919-bae5-d7c9bb31eaf1",
                    "sense_definition": "A hill.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They climbed the grassy <w>barrow</w> to get a better view of the surrounding countryside.",
                            "target_lang_translations": {
                                "tr": "Çevredeki kırsalın daha iyi bir manzarasını görmek için çimenli <w>tepeye</w> tırmandılar."
                            }
                        },
                        {
                            "text": "The small <w>barrow</w> stood out against the flat horizon of the plains.",
                            "target_lang_translations": {
                                "tr": "Küçük <w>tepe</w>, ovaların düz ufuk çizgisine karşı belirgin bir şekilde duruyordu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir tepe."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tepe",
                                "target_lang_sense_clarification": "Genel coğrafi terim."
                            },
                            {
                                "target_lang_word": "yükselti",
                                "target_lang_sense_clarification": "Arazi üzerindeki herhangi bir kabarıklık."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1aa3dbc5-7401-38d1-9eff-66bc569d3cb5",
                    "sense_definition": "A mountain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers prepared for their ascent of the rocky <w>barrow</w> at dawn.",
                            "target_lang_translations": {
                                "tr": "Doğa yürüyüşçüleri, şafak vakti kayalık <w>dağa</w> tırmanışları için hazırlandılar."
                            }
                        },
                        {
                            "text": "Clouds often gathered around the peak of the <w>barrow</w> during the winter months.",
                            "target_lang_translations": {
                                "tr": "Kış aylarında <w>dağın</w> zirvesinde genellikle bulutlar toplanırdı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir dağ."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "dağ",
                                "target_lang_sense_clarification": "Yüksek yer şekli."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8edd1f58-90b6-3c52-b000-16be3304e0e3",
                    "sense_definition": "A heap of rubbish, attle, or other such refuse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners piled the waste rock into a large <w>barrow</w> near the entrance of the shaft.",
                            "target_lang_translations": {
                                "tr": "Madenciler atık kayaları maden girişinin yakınında büyük bir <w>moloz yığını</w> haline getirdiler."
                            }
                        },
                        {
                            "text": "Over many years, the <w>barrow</w> of discarded materials became overgrown with weeds.",
                            "target_lang_translations": {
                                "tr": "Yıllar geçtikçe, atık malzemelerden oluşan <w>çöp yığını</w> yabani otlarla kaplandı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çöp, atık veya benzeri döküntü yığını."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çöp yığını",
                                "target_lang_sense_clarification": "Atıkların oluşturduğu tepe."
                            },
                            {
                                "target_lang_word": "moloz yığını",
                                "target_lang_sense_clarification": "İnşaat veya maden atıkları için."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cbdd523-b159-30ad-b624-a7f09397fa31",
                    "sense_definition": "A small vehicle used to carry a load and pulled or pushed by hand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener loaded the heavy bags of soil onto his <w>barrow</w> to move them across the yard.",
                            "target_lang_translations": {
                                "tr": "Bahçıvan, ağır toprak torbalarını bahçenin diğer tarafına taşımak için <w>el arabasına</w> yükledi."
                            }
                        },
                        {
                            "text": "Market vendors pushed their <w>barrow</w> through the crowded streets to reach their stalls.",
                            "target_lang_translations": {
                                "tr": "Pazar satıcıları, tezgahlarına ulaşmak için <w>el arabalarını</w> kalabalık sokaklardan geçirdiler."
                            }
                        }
                    ],
                    "common_phrases": [
                        "push a barrow"
                    ],
                    "target_lang_definitions": {
                        "tr": "Elle itilen veya çekilen, yük taşımaya yarayan küçük araç."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "el arabası",
                                "target_lang_sense_clarification": "Genellikle bahçe veya inşaat işlerinde kullanılan tek tekerlekli araç."
                            },
                            {
                                "target_lang_word": "pazar arabası",
                                "target_lang_sense_clarification": "Pazarcıların yük taşımak için kullandığı araç."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "791bcb18-1dd7-31ee-afdb-339089265f7f",
                    "sense_definition": "A wicker case in which salt is put to drain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salt was placed in a <w>barrow</w> to allow the excess moisture to drain away.",
                            "target_lang_translations": {
                                "tr": "Fazla nemin süzülmesini sağlamak için tuz bir <w>süzme sepetine</w> konuldu."
                            }
                        },
                        {
                            "text": "Workers moved the heavy <w>barrow</w> filled with wet salt to the drying shed.",
                            "target_lang_translations": {
                                "tr": "İşçiler, ıslak tuzla dolu ağır <w>sepeti</w> kurutma barakasına taşıdılar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Tuzun süzülmesi için içine konulduğu hasır sepet veya kap."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "süzme sepeti",
                                "target_lang_sense_clarification": "Sıvıların süzülmesi için kullanılan kap."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "063f0ca9-a88d-303b-b04a-7cf29539e07a",
                    "sense_definition": "A castrated boar.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer raised a <w>barrow</w> specifically for the purpose of meat production.",
                            "target_lang_translations": {
                                "tr": "Çiftçi, et üretimi amacıyla özel olarak bir <w>iğdiş edilmiş domuz</w> yetiştirdi."
                            }
                        },
                        {
                            "text": "The <w>barrow</w> was kept in a separate pen from the breeding boars.",
                            "target_lang_translations": {
                                "tr": "<w>İğdiş edilmiş domuz</w>, damızlık erkek domuzlardan ayrı bir bölmede tutuldu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İğdiş edilmiş erkek domuz."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iğdiş edilmiş domuz",
                                "target_lang_sense_clarification": "Kısırlaştırılmış erkek domuz."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42b82e52-f3b9-3496-a6ff-42f05f01aab9",
                    "sense_definition": "A long sleeveless flannel garment for infants.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmother knitted a soft <w>barrow</w> to keep the newborn warm during the night.",
                            "target_lang_translations": {
                                "tr": "Büyükanne, yenidoğanı gece boyunca sıcak tutması için yumuşak bir <w>bebek kundak giysisi</w> ördü."
                            }
                        },
                        {
                            "text": "She wrapped the baby in a flannel <w>barrow</w> before placing him in the cradle.",
                            "target_lang_translations": {
                                "tr": "Bebeği beşiğe koymadan önce onu pazen bir <w>kundak giysisine</w> sardı."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bebekler için uzun, kolsuz pazen giysi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bebek kundak giysisi",
                                "target_lang_sense_clarification": "Bebekleri sıcak tutmak için kullanılan geleneksel giysi."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e29a36a1-cede-3ef3-b805-6a91edcdcf8e",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is named John <w>Barrow</w>.",
                            "target_lang_translations": {
                                "tr": "Kitabın yazarının adı John <w>Barrow</w>'dur."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Barrow</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "tr": "Dün konferansta Sarah <w>Barrow</w> adında bir kadınla tanıştım."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir soyadı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Barrow",
                                "target_lang_sense_clarification": "Özel isim (soyadı)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec522535-bbcd-390f-a394-37ea578ed7cd",
                    "sense_definition": "A river in eastern Ireland.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Barrow</w> is one of the longest rivers in Ireland.",
                            "target_lang_translations": {
                                "tr": "<w>Barrow</w> Nehri, İrlanda'daki en uzun nehirlerden biridir."
                            }
                        },
                        {
                            "text": "Many small towns are located along the banks of the <w>Barrow</w>.",
                            "target_lang_translations": {
                                "tr": "Birçok küçük kasaba <w>Barrow</w> Nehri'nin kıyısında yer almaktadır."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "İrlanda'nın doğusunda bir nehir."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Barrow Nehri",
                                "target_lang_sense_clarification": "Coğrafi isim."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbfe9c24-0629-39a3-9e42-28015dafc32f",
                    "sense_definition": "Former name of Utqiagvik, Alaska.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The town formerly known as <w>Barrow</w> is the northernmost city in the United States.",
                            "target_lang_translations": {
                                "tr": "Eskiden <w>Barrow</w> olarak bilinen kasaba, Amerika Birleşik Devletleri'nin en kuzeyindeki şehirdir."
                            }
                        },
                        {
                            "text": "Researchers often traveled to <w>Barrow</w> to study the Arctic climate.",
                            "target_lang_translations": {
                                "tr": "Araştırmacılar, Arktik iklimini incelemek için sık sık <w>Barrow</w>'a seyahat ederlerdi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Alaska'daki Utqiagvik şehrinin eski adı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "Barrow",
                                "target_lang_sense_clarification": "Yer ismi."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}