{
    "word_family": [
        "potable",
        "potation",
        "poison"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9e816e3-bf86-3942-b6b5-faf56cf43c4e",
                    "sense_definition": "A small dose of a liquid that is medicinal, poisonous, or magical.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid dose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wizard carefully prepared a magical <w>potion</w> to heal the knight's wounds.",
                            "target_lang_translations": {
                                "ru": "Волшебник тщательно приготовил магическое <w>зелье</w>, чтобы залечить раны рыцаря."
                            }
                        },
                        {
                            "text": "He hoped to win the princess's heart by mixing a love <w>potion</w> into her drink.",
                            "target_lang_translations": {
                                "ru": "Он надеялся завоевать сердце принцессы, подмешав любовное <w>снадобье</w> в её напиток."
                            }
                        }
                    ],
                    "synonyms": [
                        "lib"
                    ],
                    "common_phrases": [
                        "love potion",
                        "magic potion",
                        "healing potion",
                        "sleeping potion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая доза жидкости, обладающая лечебными, ядовитыми или магическими свойствами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зелье",
                                "target_lang_sense_clarification": "магический или колдовской напиток"
                            },
                            {
                                "target_lang_word": "снадобье",
                                "target_lang_sense_clarification": "лечебное или приготовленное по особому рецепту средство"
                            },
                            {
                                "target_lang_word": "напиток",
                                "target_lang_sense_clarification": "в контексте магических или целебных жидкостей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ccd2fcff-6946-32c4-8ca1-cc0e67eedd0e",
                    "sense_definition": "To administer a drug or a drugged drink to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "administer drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner escaped after <w>potioning</w> the guards with a sleepy drink.",
                            "target_lang_translations": {
                                "ru": "Заключенный сбежал, <w>опоив</w> охранников сонным напитком."
                            }
                        },
                        {
                            "text": "In the old story, the villain attempted to <w>potion</w> the king to steal the crown.",
                            "target_lang_translations": {
                                "ru": "В старой сказке злодей пытался <w>опоить</w> короля, чтобы украсть корону."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дать кому-либо лекарство или напиток с подмешанным в него снотворным или ядом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опоить",
                                "target_lang_sense_clarification": "дать выпить что-то одурманивающее или ядовитое"
                            },
                            {
                                "target_lang_word": "подпоить",
                                "target_lang_sense_clarification": "тайно добавить снотворное или наркотик в напиток"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}