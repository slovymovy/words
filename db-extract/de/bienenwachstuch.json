                "senses": [
                    {
                        "sense_id": "2d8cc91f-9a76-355f-99a7-a182162b8dc6",
                        "entry_id": "3b2dc109-c0db-30c0-9565-6f3634c8975e",
                        "glosses": [
                            "Stück Stoff, das mit Bienenwachs getränkt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d00ad019-2fb4-4211-8387-f0d0dee98060",
                                "sense_id": "2d8cc91f-9a76-355f-99a7-a182162b8dc6",
                                "text": "„Wir nehmen zum Einpacken von Lebensmitteln selbst gemachte Bienenwachstücher. Auch wenn wir etwas einfrieren, nehmen wir Bienenwachstücher statt Gefrierbeutel.“"
                            },
                            {
                                "example_id": "6e22f666-8247-4058-9b5e-f7160e29cf6a",
                                "sense_id": "2d8cc91f-9a76-355f-99a7-a182162b8dc6",
                                "text": "„Frischhaltefolie kannst du ganz leicht durch ein wiederverwendbares Bienenwachstuch ersetzen.“"
                            },
                            {
                                "example_id": "88f2fc64-8d96-4f56-8dac-e066f95bec80",
                                "sense_id": "2d8cc91f-9a76-355f-99a7-a182162b8dc6",
                                "text": "„In der letzten Zeit werden Bienenwachstücher in Zero Waste-Haushalten immer beliebter. Das sind in Bienenwachs getränkte Stofftücher, die anstelle von Frischhalte- oder Alufolie benutzt und immer wieder verwendet werden können.“"
                            },
                            {
                                "example_id": "ee6f295d-2bd6-416f-9111-f10f277595df",
                                "sense_id": "2d8cc91f-9a76-355f-99a7-a182162b8dc6",
                                "text": "„Bienenwachstücher sind Baumwolltücher, die mit Bienenwachs überzogen wurden.“"
                            },
                            {
                                "example_id": "439c2657-554c-47b4-b8a5-880d34ac2543",
                                "sense_id": "2d8cc91f-9a76-355f-99a7-a182162b8dc6",
                                "text": "„Eine Salatschüssel abdecken, ein Butterbrot einwickeln, – viele Umweltbewusste nutzen neuerdings Bienenwachstücher statt Frischhaltefolie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
