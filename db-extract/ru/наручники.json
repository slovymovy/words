                "senses": [
                    {
                        "sense_id": "41a94fc1-9d97-3130-816f-c84310d0721a",
                        "entry_id": "adfbc814-cf76-3a12-a10b-f29570a3e12f",
                        "glosses": [
                            "металлические кольца, соединённые цепочкой и надеваемые на руки преступникам или заключённым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a3c5c2a-ad7d-406d-8645-5166026ef455",
                                "sense_id": "41a94fc1-9d97-3130-816f-c84310d0721a",
                                "text": "Когда мой помощник подъехал, ему тут же надели на руки наручники, взломали дверь ломами и автогеном, завели в офис ― и начался обыск."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad1afb59-3372-415a-8f1e-9844a53591f0",
                        "source_entry_id": "adfbc814-cf76-3a12-a10b-f29570a3e12f",
                        "source_sense_id": "41a94fc1-9d97-3130-816f-c84310d0721a",
                        "target_lang_word": "handcuffs",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handcuffs",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "beb92c4a-5d4b-32fd-8826-da1e4ffee4be",
                                        "entry_id": "77030d80-69a7-38dc-805a-68f4d5c127cd",
                                        "glosses": [
                                            "A fastening consisting of two metal rings, designed to go around a person's wrists, and connected by a chain or hinge."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c332ad36-8948-4537-9552-8fcebd0e66dd",
                                                "sense_id": "beb92c4a-5d4b-32fd-8826-da1e4ffee4be",
                                                "text": "It was the sergeant who had spoken to me, and he was now looking round at the company, with his handcuffs invitingly extended towards them in his right hand, and his left on my shoulder."
                                            },
                                            {
                                                "example_id": "2f1ac73d-8ab2-4959-9f76-b33d86a83254",
                                                "sense_id": "beb92c4a-5d4b-32fd-8826-da1e4ffee4be",
                                                "text": "Security is tight inside and outside the building, guarded by a bewildering collection of soldiers, policemen and gendarmes. Relatives watch as prisoners in handcuffs and leg irons shuffle past."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "158c3f60-ab57-337f-af02-895b2763ff01",
                                        "entry_id": "77030d80-69a7-38dc-805a-68f4d5c127cd",
                                        "glosses": [
                                            "Any abstract constraint, such as rules, regulations, or lack of resources."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "736c034a-78ab-4e96-b8aa-2f7378cfb5e6",
                                                "sense_id": "158c3f60-ab57-337f-af02-895b2763ff01",
                                                "text": "They complained that their rules of engagement were handcuffs that guaranteed counterproductivity."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "handcuffs",
                                "target_lang_code": "en",
