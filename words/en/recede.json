{
    "word_family": [
        "recession",
        "recessive",
        "recess"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c2d0435-81f8-3854-94ad-a88a1a94facb",
                    "sense_definition": "To move back or away from a previous position",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flood waters began to <w>recede</w> after the heavy rain stopped.",
                            "target_lang_translations": {
                                "cs": "Povodňová voda začala <w>ustupovat</w> poté, co přestalo silně pršet."
                            }
                        },
                        {
                            "text": "His hairline started to <w>recede</w> when he was in his thirties.",
                            "target_lang_translations": {
                                "cs": "Vlasová linie mu začala <w>ustupovat</w>, když mu bylo třicet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waters recede",
                        "hairline recede"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybovat se zpět nebo pryč z původní pozice"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ustoupit",
                                "target_lang_sense_clarification": "obecný pohyb zpět nebo zmenšení intenzity"
                            },
                            {
                                "target_lang_word": "odstoupit",
                                "target_lang_sense_clarification": "vzdálit se z určitého místa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ba5325a-6894-3446-8002-12aeafefa8bf",
                    "sense_definition": "To give back or return something to a previous owner",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government agreed to <w>recede</w> the disputed territory to the neighboring country.",
                            "target_lang_translations": {
                                "cs": "Vláda souhlasila, že sporné území <w>vrátí</w> sousední zemi."
                            }
                        },
                        {
                            "text": "They were forced to <w>recede</w> the land that had been taken during the conflict.",
                            "target_lang_translations": {
                                "cs": "Byli nuceni <w>vrátit</w> půdu, která byla zabrána během konfliktu."
                            }
                        }
                    ],
                    "synonyms": [
                        "retrocede"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vrátit nebo předat něco zpět původnímu majiteli"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vrátit",
                                "target_lang_sense_clarification": "navrácení majetku nebo území"
                            },
                            {
                                "target_lang_word": "postoupit zpět",
                                "target_lang_sense_clarification": "právní termín pro navrácení území"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f8b8874-5df2-3d00-9925-9e869e39a889",
                    "sense_definition": "To withdraw or take back a statement or offer",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>recede</w> their previous offer due to new financial information.",
                            "target_lang_translations": {
                                "cs": "Společnost se rozhodla svou předchozí nabídku <w>vzít zpět</w> kvůli novým finančním informacím."
                            }
                        },
                        {
                            "text": "It is difficult to <w>recede</w> a promise once it has been made publicly.",
                            "target_lang_translations": {
                                "cs": "Je těžké <w>vzít zpět</w> slib, jakmile byl jednou veřejně učiněn."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vzít zpět prohlášení nebo nabídku"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vzít zpět",
                                "target_lang_sense_clarification": "odvolání nabídky nebo slibu"
                            },
                            {
                                "target_lang_word": "odvolat",
                                "target_lang_sense_clarification": "formální zrušení nabídky či tvrzení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}