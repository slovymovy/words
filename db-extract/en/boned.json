                        ],
                        "examples": [
                            {
                                "example_id": "7c37b2c8-1758-452e-b9a3-f4475bfbdcd0",
                                "sense_id": "2b302067-345b-3389-86ff-c6da1e642bf8",
                                "text": "hollow-boned;   thick-boned"
                            },
                            {
                                "example_id": "e3b83301-5e1f-43b0-95ee-a9b906e31469",
                                "sense_id": "2b302067-345b-3389-86ff-c6da1e642bf8",
                                "text": "Most of the words came straight through the girls’ neat little well-powdered noses, which didn’t flinch at all. Noses are boned, you know, at least half-way down, so they don’t show the results of ill-treatment very soon."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9617e6b-4da7-3139-a367-a9aa8485867b",
                        "entry_id": "013c6663-fd36-3ff8-8567-f2da2761a2c2",
                        "glosses": [
                            "Of computer-generated animations: based on models with simulated bones or joints."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "175083ed-c480-370e-a4e9-dcd90d275616",
                        "entry_id": "013c6663-fd36-3ff8-8567-f2da2761a2c2",
                        "glosses": [
                            "Beset with unfortunate circumstances that seem difficult or impossible to overcome; in imminent danger."
                        ],
                        "tags": [
                            "not-comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "da14d885-b42c-4779-bc85-5679e25cf25c",
                                "sense_id": "175083ed-c480-370e-a4e9-dcd90d275616",
                                "text": "O cruel fate, to be thusly boned. Ask not for whom the bone bones; it bones for thee."
                            }
                        ]
                    },
