                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4064813b-4042-4812-a8b0-eca3fc9c58dc",
                                                "sense_id": "f48c92fa-eb80-30b7-80ab-a362f3507c15",
                                                "text": "Herr Wecker hat seinen Bauantrag fristgerecht eingereicht."
                                            },
                                            {
                                                "example_id": "c601d977-bfd4-4eff-a2c9-049f2f503fc7",
                                                "sense_id": "f48c92fa-eb80-30b7-80ab-a362f3507c15",
                                                "text": "Frau Wecker hat vor Gericht erfolgreich gegen ihre Kündigung geklagt."
                                            },
                                            {
                                                "example_id": "d5e8585c-73b6-44ae-bc15-562324b0fec7",
                                                "sense_id": "f48c92fa-eb80-30b7-80ab-a362f3507c15",
                                                "text": "Bei den Weckers ist immer was los."
                                            }
