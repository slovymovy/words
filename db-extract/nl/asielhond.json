                        "glosses": [
                            "een hond die geen baasje heeft en (tijdelijk) in een dierenopvang leeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebdc5e72-7472-46eb-8355-ebdd66a1c9f1",
                                "sense_id": "edc280e1-4035-37ea-bbc9-91b4e868843b",
                                "text": "De Stichting KNGF Geleidehonden bestaat komend jaar tachtig jaar. De afgelopen acht decennia zijn duizenden honden opgeleid om blinde mensen te helpen. Vroeger waren het volwassen asielhonden, tegenwoordig worden puppy’s speciaal gefokt om geleidehond te worden."
                            },
                            {
                                "example_id": "f2b4be43-b8ce-45f5-94ff-014dc16e9be4",
                                "sense_id": "edc280e1-4035-37ea-bbc9-91b4e868843b",
                                "text": "Het besluit om een nieuw baasje te zoeken neemt ze met enorme pijn in haar hart, vertelt ze in haar woning. Haar hond, een asielhond uit het Spaanse Valencia, is haar alles. Haar trots. Haar kindje."
                            }
                        ]
                    }
