                        "glosses": [
                            "Nacht, die von starkem Wind geprägt ist, in der ein Sturm herrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db8d616-9175-4c21-8f4e-ca1219f59925",
                                "sense_id": "be4e5024-9eb7-314e-b3e1-7bf616bd3f2a",
                                "text": "„Die Stadt [Vineta] wurde in einer Sturmnacht, mitsamt ihren Bewohnern, von den Wogen verschlungen.“"
                            },
                            {
                                "example_id": "9c59b2d8-bcf5-406a-9ab8-53c275e89594",
                                "sense_id": "be4e5024-9eb7-314e-b3e1-7bf616bd3f2a",
                                "text": "„‚Eine Sturmnacht bei Südwest macht den Menschen hoffnungsloser als der Schatten des Hades. […]‘“"
                            }
                        ],
