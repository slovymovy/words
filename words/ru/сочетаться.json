                            "target_lang_translations": {
                                "en": "These two colors <w>go</w> great together in design."
                            }
                        },
                        {
                            "text": "В этом блюде гармонично <w>сочетаются</w> разные вкусы.text",
                            "target_lang_translations": {
                                "en": "Different flavors <w>blend</w> harmoniously in this dish."
                            }
                        }
