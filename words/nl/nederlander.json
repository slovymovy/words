    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d6f5b75-0603-3dc3-9360-79eaebe62f4d",
                    "sense_definition": "Een mannelijke inwoner van <w>Nederland</w> of iemand die de Nederlandse nationaliteit bezit",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn buurman is een <w>Nederlander</w> die al tien jaar in Duitsland woont.",
                            "target_lang_translations": {
                                "en": "My neighbor is a <w>Dutchman</w> who has lived in Germany for ten years.",
                                "ru": "Мой сосед — <w>голландец</w>, который уже десять лет живет в Германии."
                            }
                        },
                        {
                            "text": "Elke <w>Nederlander</w> kent de traditie van het eten van beschuit met muisjes bij een geboorte.",
                            "target_lang_translations": {
                                "en": "Every <w>Dutchman</w> knows the tradition of eating rusk with aniseed sprinkles at a birth.",
                                "ru": "Каждый <w>голландец</w> знает традицию есть сухари с анисовой посыпкой при рождении ребенка."
                            }
                        }
                    ],
                    "synonyms": [
                        "Hollander"
                    ],
                    "antonyms": [
                        "buitenlander",
                        "vreemdeling"
                    ],
                    "common_phrases": [
                        "bekende Nederlander",
                        "nuchtere Nederlander",
                        "gemiddelde Nederlander"
                    ],
                    "target_lang_definitions": {
                        "en": "A male inhabitant of the Netherlands or a person with Dutch nationality",
                        "ru": "Житель Нидерландов мужского пола или человек, имеющий нидерландское гражданство"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Dutchman",
                                "target_lang_sense_clarification": "male inhabitant"
                            },
                            {
                                "target_lang_word": "Netherlander",
                                "target_lang_sense_clarification": "formal or generic"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "голландец",
                                "target_lang_sense_clarification": "наиболее употребительное название"
                            },
                            {
                                "target_lang_word": "нидерландец",
                                "target_lang_sense_clarification": "официальное название жителя страны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d57ccbe2-b172-3678-b1a3-e1c0ee86d390",
                    "sense_definition": "Een inwoner van de historische Lage Landen (de Zeventien Provinciën)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude geschriften worden Vlamingen en Brabanders vaak ook als <w>Nederlanders</w> aangeduid.",
                            "target_lang_translations": {
                                "en": "In old writings, Flemings and Brabanters are often also referred to as <w>Netherlanders</w>.",
                                "ru": "В старинных писаниях фламандцев и брабантцев часто также называли <w>нидерландцами</w>."
                            }
                        },
                        {
                            "text": "Erasmus was een beroemde <w>Nederlander</w> uit de tijd van de Renaissance.",
                            "target_lang_translations": {
                                "en": "Erasmus was a famous <w>Netherlander</w> from the time of the Renaissance.",
                                "ru": "Эразм был знаменитым <w>нидерландцем</w> эпохи Возрождения."
                            }
                        }
                    ],
