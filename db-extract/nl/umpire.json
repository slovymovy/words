                        "examples": [
                            {
                                "example_id": "1ea900af-792c-410f-af35-f400fbab8371",
                                "sense_id": "8696edcb-7976-3cc6-90ad-f17e5cfb2efd",
                                "text": "De 71-jarige Roemen ging eind april in het barrageduel tegen Groot-Brittannië zwaar over de schreef. Hij beledigde de umpire, de Britse kapitein Anne Keothavong en speelster Johanna Konta. De scheldende Nastase werd daarop het stadion uitgezet."
                            },
                            {
                                "example_id": "ce031a28-29bf-40d3-903c-4a44f9cd51e0",
                                "sense_id": "8696edcb-7976-3cc6-90ad-f17e5cfb2efd",
                                "text": "Per set kunnen de tennissers en tennissters drie keer een beroep doen op Hawk-Eye. Bij de seizoensfinale van de 'Next Gen'wordt het systeem constant gebruikt, in plaats van het menselijk oog van de lijnrechters. Alleen de umpire op de stoel ter hoogte van het net blijft zitten."
                            }
                        ]
