                    {
                        "translation_id": "51a6ba62-a8e6-46f8-98e4-e77030b7f7aa",
                        "source_entry_id": "7a39cc4b-c9c4-3fea-97a9-10c650b02d24",
                        "source_sense_description": "any muscle having two heads",
                        "target_lang_word": "biceps",
