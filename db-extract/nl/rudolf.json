                                "sense_id": "235b21d8-1e5f-35b5-a3d4-28220a94c89a",
                                "text": "Regisseur Rudolf van den Berg (76) van Tirza overleden Regisseur Rudolf van den Berg is op 76-jarige leeftijd overleden aan een hartstilstand."
                            },
                            {
                                "example_id": "6cfca85f-5a1f-462d-83e2-998db709dcad",
                                "sense_id": "235b21d8-1e5f-35b5-a3d4-28220a94c89a",
                                "text": "Rudolf van den Berg was altijd bezig met de vraag hoe hij er zijn eigen film van kon maken."
                            }
                        ]
