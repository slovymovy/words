                        "translation_id": "dccf4fab-285b-45c5-a580-a2c9aedd61f5",
                        "source_entry_id": "162b4c26-e9af-3442-b137-422a36d58c77",
                        "source_sense_id": "b4236f82-1b64-39bb-8b8f-10570862d270",
