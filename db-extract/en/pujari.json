                        "glosses": [
                            "Someone who performs a puja, especially a priest in a Hindu temple."
                        ],
                        "tags": [
                            "Hinduism"
                        ],
                        "examples": [
                            {
                                "example_id": "26404202-1c64-4d4a-b55c-f539f8e7fa6d",
                                "sense_id": "adb883d7-8c6a-38ea-b083-6d68c28262e5",
                                "text": "The pujari at the Kalika Mata temple lightly tolls the bell and then in a voice that is as clear and crystalline as the sky this morning sings the Surya Stotra."
                            },
                            {
                                "example_id": "237ed1d0-a2b6-4675-87ff-2433b52ab03d",
                                "sense_id": "adb883d7-8c6a-38ea-b083-6d68c28262e5",
                                "text": "The pujari saw the headman's anger and said to Hiranbai, 'God bless you, child, for your good work for all these God's creatures.'"
                            }
                        ]
                    }
