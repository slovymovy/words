{
    "word_family": [
        "lam"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "61915091-8033-3064-b9f3-36de63d842a8",
                    "sense_definition": "Jongen ter wereld brengen (van schapen).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geboorte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schaap zal binnenkort <w>lammeren</w>.",
                            "target_lang_translations": {
                                "en": "The sheep will <w>lamb</w> soon.",
                                "ru": "Овца скоро <w>окотится</w>."
                            }
                        },
                        {
                            "text": "De boer houdt de schapen goed in de gaten wanneer ze gaan <w>lammeren</w>.",
                            "target_lang_translations": {
                                "en": "The farmer keeps a close eye on the sheep when they are about to <w>lamb</w>.",
                                "ru": "Фермер внимательно следит за овцами, когда они готовятся <w>окотиться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lammen"
                    ],
                    "target_lang_definitions": {
                        "en": "To give birth to lambs (said of sheep).",
                        "ru": "Рожать ягнят (об овцах)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lamb",
                                "target_lang_sense_clarification": "The standard verb used for sheep giving birth."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "окотиться",
                                "target_lang_sense_clarification": "о процессе рождения ягнят у овцы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5fb1f0f4-94f3-318b-85f3-430dd5e0d3f2",
                    "sense_definition": "Meervoud van <w>lam</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de lente rennen de <w>lammeren</w> vrolijk door de wei.",
                            "target_lang_translations": {
                                "en": "In the spring, the <w>lambs</w> run happily through the meadow.",
                                "ru": "Весной <w>ягнята</w> весело бегают по лугу."
                            }
                        },
                        {
                            "text": "De boer voert de jonge <w>lammeren</w> met de fles.",
                            "target_lang_translations": {
                                "en": "The farmer bottle-feeds the young <w>lambs</w>.",
                                "ru": "Фермер кормит маленьких <w>ягнят</w> из бутылочки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of lamb (young sheep).",
                        "ru": "Множественное число от слова «ягненок»."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lambs",
                                "target_lang_sense_clarification": "The plural form of the young of a sheep."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ягнята",
                                "target_lang_sense_clarification": "детеныши овцы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}