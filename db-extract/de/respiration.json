                        "sense_id": "594648ce-c803-3cba-a650-1c16b517d2cc",
                        "entry_id": "6b0f2c22-858d-3466-bf2a-fa5be1325437",
                        "glosses": [
                            "Einsaugen von Luft in die Atmungsorgane (sowie der An- und Abtransport der Gase über das Blut und die Luft)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76e29ae7-6838-4dd8-866b-484d202f3d7d",
                                "sense_id": "594648ce-c803-3cba-a650-1c16b517d2cc",
                                "text": "„Die Respiration ist in den wenigsten Fällen normal; meist ist sie kurz, mühsam, keuchend, und es tritt von Zeit zu Zeit Erstickungs-Gefahr ein.“"
                            },
                            {
                                "example_id": "8dea0882-95c8-4ccc-8c5e-c59c23747b77",
                                "sense_id": "594648ce-c803-3cba-a650-1c16b517d2cc",
                                "text": "„Ohne Respiration sind Phonation und Artikulation unmöglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
