                ],
                "translations": [
                    {
                        "translation_id": "d478e5d3-ac23-4964-bce2-7e43b6ea202b",
                        "source_entry_id": "8dbfab47-565f-35b4-bbd6-98f3fcb411dc",
                        "source_sense_id": "c247c0a1-7847-3b3d-b56a-9b4916cabd4f",
                        "source_sense_description": "the tissue structure of an organ",
                        "target_lang_word": "stroma",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stroma",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e94e9a26-fff5-3d18-be71-24bc58569523",
                                        "entry_id": "4920e84d-4b2a-31e4-9eef-a0f50ca736f0",
                                        "glosses": [
                                            "Réseau conjonctif de support d'une cellule, d'un tissu ou d'un organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "678c50d9-007b-4942-a16e-11970fa9adfc",
                                                "sense_id": "e94e9a26-fff5-3d18-be71-24bc58569523",
                                                "text": "La cellule sarcomateuse peut produire des fibres de collagène qui constituent le stroma sarcomateux."
                                            },
                                            {
                                                "example_id": "f8093f9a-3fd4-4300-9185-9a7d563196b9",
                                                "sense_id": "e94e9a26-fff5-3d18-be71-24bc58569523",
                                                "text": "Le stroma de l'endomètre utérin. Le stroma contient les follicules ( à différents stades de croissance) ainsi que le corps jaune ( qui sont le produit d'évolution des follicules après ovulation). Il se situe en dessous de l'albuginée ovarienne (Tissu Conjonctif Solide)."
                                            },
                                            {
                                                "example_id": "c91fa4ad-afd9-44d0-81f6-45199e9a3379",
                                                "sense_id": "e94e9a26-fff5-3d18-be71-24bc58569523",
                                                "text": "Chez l'homme, les globules rouges sont discoïdes ; leur dimension est de 7 à 8 μ ; ils sont constitués par une trame (stroma) de nature protéique, qui est imprégnée d'une matière colorante rouge : l'hémoglobine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f4a4a1b-8fcd-3913-ac33-96147f89c82c",
                                        "entry_id": "4920e84d-4b2a-31e4-9eef-a0f50ca736f0",
                                        "glosses": [
                                            "Zone du chloroplaste à l'extérieur des membranes thylacoïdes où les réactions indépendantes de la lumière (cycle de Calvin et fixation du carbone) de la photosynthèse se produisent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e49348-cbe3-404d-84e3-95b511cbe775",
                                                "sense_id": "8f4a4a1b-8fcd-3913-ac33-96147f89c82c",
                                                "text": "Les différentes étapes de la photosynthèse qui convertissent la lumière en énergie chimique se déroulent dans les thylakoïdes tandis que les étapes de conversion de l'énergie en glucide se déroulent dans le stroma du chloroplaste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
