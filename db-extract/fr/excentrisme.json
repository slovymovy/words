                    },
                    {
                        "sense_id": "fc44bb6c-c146-3a34-afc3-5e5548c979c3",
                        "entry_id": "70493882-5ae1-3f03-af2a-43d5ce9d0abd",
                        "glosses": [
                            "Excentricité."
