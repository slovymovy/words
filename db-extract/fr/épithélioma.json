                        "examples": [
                            {
                                "example_id": "de5fda27-6b68-40b8-90e1-dd9855829bbf",
                                "sense_id": "1e7dc0ba-ce2f-35ad-89a2-ff006d610745",
                                "text": "Certes, depuis la création du poste médical de Tamanrasset jusqu’en 1954, on n'a relevé que deux cas de cancer : un épithélioma glandulaire du sein opéré chez une merabta du Tidikelt, mariée depuis longtemps à un Touareg."
                            },
                            {
                                "example_id": "8a6735da-808f-40c2-aace-c6befaf31fcf",
                                "sense_id": "1e7dc0ba-ce2f-35ad-89a2-ff006d610745",
                                "text": "Il s’avéra que, à l’instar de Satan, le cancer avait plusieurs noms – dans le cas de Baba, épithélioma des bronches à petites cellules."
                            }
                        ]
                    }
