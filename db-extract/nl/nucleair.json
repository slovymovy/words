                                                "text": "a nuclear reactor"
                                            },
                                            {
                                                "example_id": "ac186d25-3b33-4a1d-8cbc-d12e141aa108",
                                                "sense_id": "5a595d3f-e2a5-3503-bc3c-a54001d66ae8",
                                                "text": "nuclear technology"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d69aa146-f954-3a63-bbb2-e349b873a7cd",
                                        "entry_id": "b3a31b5a-70b2-3ad2-b13f-ea8ee054c67a",
                                        "glosses": [
                                            "Relating to a weapon that derives its force from rapid release of energy through nuclear reactions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a4dcd3f-15f0-486c-b788-f00a833bace4",
                                                "sense_id": "d69aa146-f954-3a63-bbb2-e349b873a7cd",
                                                "text": "a nuclear explosion"
                                            },
                                            {
                                                "example_id": "bfe56931-545e-400c-88f5-b13ec5c18efe",
                                                "sense_id": "d69aa146-f954-3a63-bbb2-e349b873a7cd",
                                                "text": "a nuclear power"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a87ad744-acb9-3f8d-90f7-86741a782568",
                                        "entry_id": "b3a31b5a-70b2-3ad2-b13f-ea8ee054c67a",
                                        "glosses": [
                                            "Having nuclear weapons."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df2944c9-296b-4ad6-a56d-fd19f170bc9e",
                                                "sense_id": "a87ad744-acb9-3f8d-90f7-86741a782568",
                                                "text": "They will blame him for pursuing the ideological aim of destruction of Israel – something many Iranians don't support. They will blame him for what they perceive as a folly – his belief that achieving nuclear status would render his regime invincible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "804b1922-629e-30f5-9269-07d69e83ccef",
                                        "entry_id": "b3a31b5a-70b2-3ad2-b13f-ea8ee054c67a",
                                        "glosses": [
                                            "Involving an extreme course of action, or one with severe consequences."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d10be695-703b-488e-abf2-bbf2e9b18068",
                                                "sense_id": "804b1922-629e-30f5-9269-07d69e83ccef",
                                                "text": "nuclear option, nuclear solution"
                                            },
                                            {
                                                "example_id": "ef6cc6e9-eac3-4752-a849-853f8a484fa8",
                                                "sense_id": "804b1922-629e-30f5-9269-07d69e83ccef",
                                                "text": "The states begging for aid get turned away; and sharp cuts in government employment, spending, and, eventually, pension payments are the only alternative future, beyond the nuclear solution of defaulting on our debt."
                                            },
                                            {
                                                "example_id": "bab7fece-7d6c-4496-8a1c-581e295ab1aa",
                                                "sense_id": "804b1922-629e-30f5-9269-07d69e83ccef",
                                                "text": "The nuclear approach is the simpler of the two. When two constraints conflict, you can kill one of them."
                                            },
                                            {
                                                "example_id": "0b2021f5-977a-4c33-8b16-4434280f3d86",
                                                "sense_id": "804b1922-629e-30f5-9269-07d69e83ccef",
                                                "text": "We’ve now had 20 years of cautionary tales about replyallpocalypses. For the sake of workplace harmony: keep your pointer off the nuclear button."
                                            },
                                            {
                                                "example_id": "081d188f-e751-40c1-8c11-6895dfa95a14",
                                                "sense_id": "804b1922-629e-30f5-9269-07d69e83ccef",
                                                "text": "Republicans have taken the historic step of triggering the so-called \"nuclear option\" to change the rules of the Senate and push through Donald Trump's pick for the Supreme Court, after Democrats blocked the nomination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5664f944-de7f-396f-ae81-86f52da074c9",
                                        "entry_id": "b3a31b5a-70b2-3ad2-b13f-ea8ee054c67a",
                                        "glosses": [
                                            "Pertaining to the nucleus of a cell."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b4258a5-128b-499e-8cf5-6cfd89babb04",
                                                "sense_id": "5664f944-de7f-396f-ae81-86f52da074c9",
                                                "text": "However, the DNA in a bacterial cell is a single circular molecule and there is no separate nuclear compartment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "284ad3e0-ad2d-391d-918d-8267bdd9ca06",
                                        "entry_id": "b3a31b5a-70b2-3ad2-b13f-ea8ee054c67a",
                                        "glosses": [
                                            "Pertaining to a centre around which something is developed or organised; central, pivotal."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c15581aa-f566-4f82-a18b-35aef553fced",
                                                "sense_id": "284ad3e0-ad2d-391d-918d-8267bdd9ca06",
                                                "text": "Nuclear Polynesian languages include Hawaiian and Samoan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17c3e0c6-d9ba-3345-92a8-0ecc21291ed4",
                                        "entry_id": "b3a31b5a-70b2-3ad2-b13f-ea8ee054c67a",
                                        "glosses": [
                                            "Relating to, being of, or comprising the nuclear family."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97c3bf75-5857-4d88-84da-72826e673f9a",
                                                "sense_id": "17c3e0c6-d9ba-3345-92a8-0ecc21291ed4",
                                                "text": "Somehow it is much easier to convey the emotions of gayness — the feelings of outsideness —through anthropomorphism. Gay poet and limerist Edward lear uses animals and creatures perfectly this way […] Even the Muppets — as mainstream and heterosexual as some of them may be — are favorites among many gay men […] Look at Mr. Toad in The Wind in the Willows, such a silly, pompous queen, and even Randall Jarrell's The Animal Family has a lot to say about non-human and non-nuclear arrangements."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nuclear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7adfc34-e534-3caa-980b-624351e680d8",
                                        "entry_id": "4fd6929b-e7ea-30d8-b80a-ae338081599f",
                                        "glosses": [
                                            "Nuclear power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f71b8c1-29d0-4a19-bc7d-c9eb85c76f21",
                                                "sense_id": "e7adfc34-e534-3caa-980b-624351e680d8",
                                                "text": "The growth in wind capacity at first lagged behind the expansion of nuclear installations, but then it started to grow faster and is now outpacing nuclear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3197a91d-d12a-3168-9ff0-839575050542",
                                        "entry_id": "4fd6929b-e7ea-30d8-b80a-ae338081599f",
                                        "glosses": [
                                            "Nuclear weapon"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaa5f3e6-d834-40c0-92da-35ef8f029cdb",
                                                "sense_id": "3197a91d-d12a-3168-9ff0-839575050542",
                                                "text": "Admiral Burke believed that we would be able to beat off an amphibious attack, even if staged in conjunction with heavy aerial bombing, long enough to refer back to Washington and obtain authorization to use nuclears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7c060f6-626f-47a6-941d-e8a861925217",
                        "source_entry_id": "ccede2de-4165-37e9-8045-3a67c208603d",
                        "target_lang_word": "nucléaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nucléaire",
