                                    {
                                        "sense_id": "a5f0122b-3156-3c79-999b-c106fc96ee10",
                                        "entry_id": "f6863d8a-9d93-3548-a25a-0302a976444e",
                                        "glosses": [
                                            "The loss of the skin's normal pigmentation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
