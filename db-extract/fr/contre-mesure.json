                    {
                        "form_id": "f5339454-c242-4800-9ca0-d29a813914af",
                        "entry_id": "0e523597-c0a4-30f9-a1ec-94477e1c03e9",
                        "tags": [],
                        "form": "contremesure"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10463ec8-5f5d-3782-8fd1-b7d05b8e0b03",
                        "entry_id": "0e523597-c0a4-30f9-a1ec-94477e1c03e9",
                        "glosses": [
                            "Disposition prise pour s'opposer à une action, à un effet, à un événement, ou pour les prévenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db58aa8f-e557-47c5-8317-59b0953627d0",
                                "sense_id": "10463ec8-5f5d-3782-8fd1-b7d05b8e0b03",
                                "text": "Ni la milice ni la Gestapo ne sonnèrent la cloche du portail. Il est vrai que mon père, engagé tôt dans la Résistance — ce que j’ignorais alors —, avait pris d’autres contre-mesures après les grandes rafles de l’été 1942."
                            },
                            {
                                "example_id": "ce1ebe17-7a87-421a-9382-202533a54027",
                                "sense_id": "10463ec8-5f5d-3782-8fd1-b7d05b8e0b03",
                                "text": "Plusieurs contre-mesures ont aussi été intégrées contre des failles de sécurité, notamment Retpoline de Google contre les attaques utilisant Spectre V2 (processeurs Intel)."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e54966e-7056-35b6-be4d-8953d8582e40",
                        "entry_id": "0e523597-c0a4-30f9-a1ec-94477e1c03e9",
                        "glosses": [
                            "Mesure préventive"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e6929a8-37ef-4e24-b80b-176a32c1b9e9",
                        "source_entry_id": "0e523597-c0a4-30f9-a1ec-94477e1c03e9",
                        "target_lang_word": "countermeasure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "countermeasure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6eff0ff-7277-39cf-a4f9-c4ea93217588",
                                        "entry_id": "4c858964-2bbc-3413-a058-571e47c39310",
                                        "glosses": [
                                            "Any action taken to counteract or correct another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc7beec-01e7-449d-9886-745196505864",
                                                "sense_id": "a6eff0ff-7277-39cf-a4f9-c4ea93217588",
                                                "text": "We fear that this will be the beginning of a negative development of measures and countermeasures, at the end of which there will be no winner"
                                            },
                                            {
                                                "example_id": "c4b1cba5-0075-4554-b5c2-788b9f951979",
                                                "sense_id": "a6eff0ff-7277-39cf-a4f9-c4ea93217588",
                                                "text": "Adopting a computerlike countermeasure for a problem enabled by computer algorithms is admittedly an unnatural practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35743b4f-8955-3866-9639-17e27cba36f3",
                                        "entry_id": "4c858964-2bbc-3413-a058-571e47c39310",
                                        "glosses": [
                                            "Any of the devices and techniques used to impair the operational effectiveness of an enemy."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
