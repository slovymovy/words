                        "examples": [
                            {
                                "example_id": "03516245-eed2-4334-8a03-a51b5b9fad1e",
                                "sense_id": "fa4b66cb-4ae1-3d0f-ad81-dddb65daea55",
                                "text": "Depuis juin 1986, la Bourse de Paris est complètement informatisée grâce à la mise en place du système CAC (Cotation Assistée en Continu), remplacé en juin 1995 par la technologie NSC (Nouveau Système de Cotation) ou SUPER CAC."
                            },
                            {
                                "example_id": "f9cb4e0e-a706-40ca-bf56-2ad6611126af",
                                "sense_id": "fa4b66cb-4ae1-3d0f-ad81-dddb65daea55",
                                "text": "Mis en place en juin 1986, le CAC a été progressivement étendu à l'ensemble des valeurs à Paris et en province."
                            },
                            {
                                "example_id": "c6a30b57-9e7c-4a27-af47-f9286b275bf1",
                                "sense_id": "fa4b66cb-4ae1-3d0f-ad81-dddb65daea55",
                                "text": "2014, R.-J. Berg and Heather McCoy, Parlons affaires!: Initiation au français economique et commercial (Troisième Edition), Heinle Cengage Learning, page 8",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            }
                        ]
                    },
                    {
                        "sense_id": "397f4c97-8e74-3bbd-9c0b-71cf2c59dd89",
                        "entry_id": "a477be7c-e2e1-32dc-9b4d-aa11ed3c3b04",
                        "glosses": [
                            "the main stock market index code for the French stock market, the Paris Bourse"
