                            },
                            {
                                "target_lang_word": "спятивший",
                                "target_lang_sense_clarification": "потерявший рассудок или ведущий себя странно"
                            },
                            {
                                "target_lang_word": "помешанный",
                                "target_lang_sense_clarification": "одержимый или безумный"
                            },
                            {
                                "target_lang_word": "безумный",
