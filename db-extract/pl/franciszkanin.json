                                    }
                                ]
                            },
                            {
                                "target_word": "franciscain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f18c17b-3ed8-3287-9205-ac629bf6c22b",
                                        "entry_id": "91f55273-c2c5-3c2f-ac15-89992945b9a4",
                                        "glosses": [
                                            "Religieux de l’ordre de François d’Assise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23553a80-c600-444d-b68f-190eb0603fbf",
                                                "sense_id": "2f18c17b-3ed8-3287-9205-ac629bf6c22b",
                                                "text": "Le nominalisme qui s’était éclipsé après ces condamnations refit son apparition au XIIᵉ siècle avec le dominicain Durand de Saint-Pourçain et avec le franciscain Pierre Auriol."
                                            },
                                            {
                                                "example_id": "aa1b07e0-5fce-42b5-a1e9-84fd6c6e8814",
                                                "sense_id": "2f18c17b-3ed8-3287-9205-ac629bf6c22b",
                                                "text": "« Les Italiens m'assimilent souvent à un franciscain ! », s'amuse Angelo Branduardi. De fait, en 2000, sort en Italie Linfinitamente piccolo, qui met en musique la vie de saint François d'Assise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
