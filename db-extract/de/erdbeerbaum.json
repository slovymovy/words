                        "source_entry_id": "2b53ec78-2d88-3390-8ef9-1de926faaeca",
                        "source_sense_id": "191cdfc7-1fb6-3641-89b5-5fb56ab73417",
                        "source_sense_description": "Vertreter der Gattung der Erdbeerbäume (wissenschaftlich: Arbutus)",
                        "target_lang_word": "земляничник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "земляничник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5d7a645c-640c-3cf4-b96f-1413512faa2b",
                                        "entry_id": "852eeaa1-c634-3b8a-b847-1c4436274b96",
                                        "glosses": [
                                            "заросли земляники"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d176dba-babc-4fe0-89db-a79732f69599",
                                                "sense_id": "5d7a645c-640c-3cf4-b96f-1413512faa2b",
                                                "text": "Сегодня мы первый раз ходили за земляникой и принесли целую тарелку. Недалеко от нашего имения есть гора, вся усеянная земляничником, и там на солнцепёке рано поспевают ягоды."
                                            },
                                            {
                                                "example_id": "2e993f77-0574-4cca-9336-6bcd24ce087a",
                                                "sense_id": "5d7a645c-640c-3cf4-b96f-1413512faa2b",
                                                "text": "Вчера Леонид Петрович с женщинами пробился в Аксёново и нашли земляничник — пятачками, но с исключительно крупной ягодой."
                                            },
                                            {
                                                "example_id": "ab0771b4-c588-4417-b581-8fa8b262b5d6",
                                                "sense_id": "5d7a645c-640c-3cf4-b96f-1413512faa2b",
                                                "text": "Пошли домой. Зовёт меня: «Давай-ко, милой сын, вон там, я знаю, земляничник есть, давай ягодками полакомимся!»"
                                            },
                                            {
                                                "example_id": "f3435cee-f790-4f07-b56b-a17a00c3c90e",
                                                "sense_id": "5d7a645c-640c-3cf4-b96f-1413512faa2b",
                                                "text": "— Устала я, чуть с ног не падала и наткнулась вдруг на пригорок, поросший земляничником. А где листья, там и ягоды."
                                            },
                                            {
                                                "example_id": "182db2cf-5bc9-4bbd-bd67-52fa738eba51",
                                                "sense_id": "5d7a645c-640c-3cf4-b96f-1413512faa2b",
                                                "text": "В подножьях, по земле, устланной хвойными иглами с россыпью сухих шишек, там и здесь — .. земляничники с последними красными ягодами, уже потемневшими, но пахучими, сладкими .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
