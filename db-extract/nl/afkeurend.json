            {
                "entry_id": "8b8c1755-3ebb-3c47-b081-065928d32f3d",
                "word": "afkeurend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8a7e9aec-3ebd-3c61-951c-6f6e1a493ad8",
                        "entry_id": "8b8c1755-3ebb-3c47-b081-065928d32f3d",
                        "glosses": [
                            "een negatief oordeel uitdrukkend of bevattend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed063467-993d-4e26-9340-8bba3588ac4f",
                                "sense_id": "8a7e9aec-3ebd-3c61-951c-6f6e1a493ad8",
                                "text": "Tegen het afschotplan is fel gedemonstreerd. Op Facebook zorgt de verkoop van het vlees voor veel afkeurende reacties. Bij Staatsbosbeheer zijn dinsdag geen protesten binnengekomen, aldus een woordvoerder."
                            },
                            {
                                "example_id": "c0a5c8ad-b227-4bee-b498-0c0f933f21f3",
                                "sense_id": "8a7e9aec-3ebd-3c61-951c-6f6e1a493ad8",
                                "text": "De trainer van Paris Saint-Germain had de hele eerste helft volop afkeurende gebaren gemaakt richting zijn spelers, maar in deel twee waren de Fransen wel duidelijk de bovenliggende partij."
                            },
                            {
                                "example_id": "03da973b-bd89-4dcb-a955-2f3d8a4ff9a7",
                                "sense_id": "8a7e9aec-3ebd-3c61-951c-6f6e1a493ad8",
                                "text": "De orgie kan wat mij betreft beginnen. De afkeurende blik van zijn vrouw negerend, ging hij weer op zijn favoriete plek zitten."
                            },
                            {
                                "example_id": "d6b46e5d-8dc2-4e3b-9221-80f6a148cbc1",
                                "sense_id": "8a7e9aec-3ebd-3c61-951c-6f6e1a493ad8",
                                "text": "Haar oom 'Hij maakte een afkeurend geluidje."
                            }
                        ]
                    }
                ],
