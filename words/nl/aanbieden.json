{
    "word_family": [
        "aanbieding",
        "aanbieder",
        "bieding",
        "bieden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34536507-3383-38c7-86c0-6e8968790b99",
                    "sense_definition": "iets aanreiken of ter beschikking stellen, vaak als gebaar of beleefdheid",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "geven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mag ik u een kopje koffie <w>aanbieden</w>?",
                            "target_lang_translations": {
                                "en": "May I <w>offer</w> you a cup of coffee?"
                            }
                        },
                        {
                            "text": "Hij heeft gisteren zijn excuses <w>aangeboden</w> voor de fout.",
                            "target_lang_translations": {
                                "en": "He <w>offered</w> his apologies for the mistake yesterday."
                            }
                        }
                    ],
                    "common_phrases": [
                        "excuses aanbieden",
                        "hulp aanbieden"
                    ],
                    "target_lang_definitions": {
                        "en": "to hand something over or make it available, often as a gesture or courtesy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "offer",
                                "target_lang_sense_clarification": "to present something to be accepted or turned down"
                            },
                            {
                                "target_lang_word": "proffer",
                                "target_lang_sense_clarification": "to hold out something to someone for acceptance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f27a906-9cbf-39f8-9343-9b4d5080aa61",
                    "sense_definition": "iets te koop stellen of onder bepaalde voorwaarden beschikbaar maken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "handel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winkelier gaat zijn producten online <w>aanbieden</w>.",
                            "target_lang_translations": {
                                "en": "The shopkeeper is going to <w>offer</w> his products online."
                            }
                        },
                        {
                            "text": "Zij heeft haar huis te koop <w>aangeboden</w> op internet.",
                            "target_lang_translations": {
                                "en": "She has <w>offered</w> her house for sale on the internet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "te koop aanbieden",
                        "diensten aanbieden"
                    ],
                    "target_lang_definitions": {
                        "en": "to put something up for sale or make it available under certain conditions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "offer",
                                "target_lang_sense_clarification": "to present something for sale"
                            },
                            {
                                "target_lang_word": "provide",
                                "target_lang_sense_clarification": "to make a service or product available"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7495e14e-c81e-326e-9989-ab4213c6ed55",
                    "sense_definition": "zichzelf beschikbaar stellen voor een taak of functie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vrijwillig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zich als vrijwilliger <w>aangeboden</w> bij de sportclub.",
                            "target_lang_translations": {
                                "en": "He <w>volunteered</w> at the sports club."
                            }
                        },
                        {
                            "text": "Zij gaat zich als nieuwe directeur <w>aanbieden</w> bij het bedrijf.",
                            "target_lang_translations": {
                                "en": "She is going to <w>offer</w> herself as the new director at the company."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanmonsteren",
                        "solliciteren"
                    ],
                    "common_phrases": [
                        "zich aanbieden als"
                    ],
                    "target_lang_definitions": {
                        "en": "to make oneself available for a task or position"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "volunteer",
                                "target_lang_sense_clarification": "to offer oneself for a task without being forced"
                            },
                            {
                                "target_lang_word": "offer",
                                "target_lang_sense_clarification": "to express willingness to do something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2998e68-a71a-3146-9cdc-fa5e9d85fc47",
                    "sense_definition": "zich voordoen of zichtbaar worden (gezegd van zaken of kansen)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verschijnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra de kans zich <w>aanbiedt</w>, moet je die grijpen.",
                            "target_lang_translations": {
                                "en": "As soon as the opportunity <w>presents itself</w>, you must seize it."
                            }
                        },
                        {
                            "text": "Er zal zich spoedig een oplossing voor dit probleem <w>aanbieden</w>.",
                            "target_lang_translations": {
                                "en": "A solution to this problem will soon <w>arise</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de kans biedt zich aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to occur or become visible (said of things or opportunities)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "present itself",
                                "target_lang_sense_clarification": "when an opportunity or situation arises"
                            },
                            {
                                "target_lang_word": "offer",
                                "target_lang_sense_clarification": "to happen or present itself"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fcdb367-b747-3d8f-a092-b2a7e542486e",
                    "sense_definition": "zichzelf aanbieden voor seksuele diensten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seksualiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In die straat staan mensen die zich openlijk <w>aanbieden</w>.",
                            "target_lang_translations": {
                                "en": "In that street, there are people who openly <w>solicit</w>."
                            }
                        },
                        {
                            "text": "Het is verboden om zich op deze plek aan voorbijgangers <w>aan te bieden</w>.",
                            "target_lang_translations": {
                                "en": "It is forbidden to <w>solicit</w> passers-by at this location."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to offer oneself for sexual services"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "solicit",
                                "target_lang_sense_clarification": "to offer sexual services in public"
                            },
                            {
                                "target_lang_word": "prostitute oneself",
                                "target_lang_sense_clarification": "to offer oneself for sex for money"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}