                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jeugd gaat tegenwoordig graag naar het <w>zwembad</w> op een warme zomerse dag.",
                            "target_lang_translations": {
                                "ru": "Молодежь сегодня любит ходить в <w>бассейн</w> в жаркий летний день.",
                                "en": "Young people nowadays like to go to the <w>swimming pool</w> on a hot summer day.",
                                "pl": "Młodzież chętnie chodzi dziś na <w>basen</w> w upalny letni dzień.",
                                "de": "Die Jugend geht heutzutage an einem heißen Sommertag gerne ins <w>Schwimmbad</w>.",
                                "fr": "De nos jours, les jeunes aiment aller à la <w>piscine</w> par une chaude journée d'été.",
                                "it": "Oggi ai giovani piace andare in <w>piscina</w> in una calda giornata estiva.",
                                "cs": "Mládež dnes za teplého letního dne ráda chodí na <w>koupaliště</w>.",
                                "tr": "Gençler bugünlerde sıcak bir yaz gününde <w>havuza</w> gitmeyi çok seviyor.",
                                "es": "Hoy en día a los jóvenes les gusta ir a la <w>piscina</w> en un caluroso día de verano."
                            }
                        },
                        {
                            "text": "In onze stad is een nieuw <w>zwembad</w> geopend.",
                            "target_lang_translations": {
                                "ru": "В нашем городе открылся новый <w>бассейн</w>.",
                                "en": "A new <w>swimming pool</w> has opened in our city.",
                                "pl": "W naszym mieście otwarto nowy <w>basen</w>.",
                                "de": "In unserer Stadt wurde ein neues <w>Schwimmbad</w> eröffnet.",
                                "fr": "Une nouvelle <w>piscine</w> a ouvert dans notre ville.",
                                "it": "Nella nostra città è stata aperta una nuova <w>piscina</w>.",
                                "cs": "V našem městě byl otevřen nový <w>bazén</w>.",
                                "tr": "Şehrimizde yeni bir <w>yüzme havuzu</w> açıldı.",
                                "es": "Se ha abierto una nueva <w>piscina</w> en nuestra ciudad."
                            }
