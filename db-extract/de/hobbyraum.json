                        "sense_id": "81a680c8-9650-330f-bae4-cbfdacac0f2b",
                        "entry_id": "4eca46b7-4362-3dc1-b1ac-a7a2c9cce9fa",
                        "glosses": [
                            "Raum, der so eingerichtet ist, dass man darin seinem Hobby nachgehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d36b1d-a140-454d-abb3-28b47ffc34a0",
                                "sense_id": "81a680c8-9650-330f-bae4-cbfdacac0f2b",
                                "text": "„Jetzt würden wir bald in unser eigenes Haus ziehen, mit einem eigenen Zimmer für jeden und mit einem Hobbyraum, in dem wir Fußball spielen könnten.“"
                            },
                            {
                                "example_id": "fbae4bfe-9b6a-4670-a0c5-83413da51543",
                                "sense_id": "81a680c8-9650-330f-bae4-cbfdacac0f2b",
                                "text": "„Sie fand Rotermund dort, wo sie ihn vermutet hatte, in einem Hobbyraum, den er mit Freunden und Bekannten zur Herstellung schöngeistiger Dinge teilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
