                "senses": [
                    {
                        "sense_id": "f75bf766-9fb4-3337-97de-ea69c42b9b1f",
                        "entry_id": "60225de9-fe6f-3c1c-a0bf-277be470a7bb",
                        "glosses": [
                            "Action de débrider, c'est-à-dire d'enlever des matières nécrotiques, tissus dévitalisés, croûtes, tissus infectés, hyperkératose, pus, hématomes, corps étrangers, débris, fragments d'os ou de tout autre type de charge microbienne d'une blessure pour favoriser la cicatrisation de la plaie."
                        ],
                        "tags": [
                            "Arts et de Chirurgie"
                        ],
                        "examples": [
                            {
                                "example_id": "685bb9f1-af40-4d68-9f0a-c032e4990b13",
                                "sense_id": "f75bf766-9fb4-3337-97de-ea69c42b9b1f",
                                "text": "Le débridement d’une pierre."
                            },
                            {
                                "example_id": "eee15086-1517-4dfa-a743-3e1d822c9342",
                                "sense_id": "f75bf766-9fb4-3337-97de-ea69c42b9b1f",
                                "text": "Le débridement d’une plaie."
                            },
                            {
                                "example_id": "9c10bf0b-53c9-40d2-8018-e35c7586eb4b",
                                "sense_id": "f75bf766-9fb4-3337-97de-ea69c42b9b1f",
                                "text": "Le débridement comprend les gestes simples, non agressifs réalisés lors de l’arthroscopie : évacuation de débris cartilagineux, régularisation méniscale limitée, résections éventuelles d’ostéophytes et de lambeaux cartilagineux libres. Voir parage"
                            }
                        ]
                    }
