                        "examples": [
                            {
                                "example_id": "c4a6da8e-2528-433b-81ce-75c7621e48d9",
                                "sense_id": "72ae6f11-9f4b-37f4-90a7-b043bca44df4",
                                "text": "„Im Dezember 1987 unterzeichnete Nkomo nach jahrelangen Geheimverhandlungen, in denen der Verwandte Mugabes und ZAPU-Politiker Cephas Msipa die Vermittlung übernahm, einen Unity Accord, also ein Einheitsabkommen, das in Wirklichkeit eine Kapitulationserklärung war.“"
                            },
                            {
                                "example_id": "4cfed003-c6d3-4f20-b3cb-b6641d5f8a21",
                                "sense_id": "72ae6f11-9f4b-37f4-90a7-b043bca44df4",
                                "text": "„Förmlich teilte er den Soldaten mit, dass die Stadt Jerusalem die Armee Seiner Majestät willkommen heiße und er ihnen die Kapitulationserklärung des türkischen Gouverneurs auszuhändigen wünsche.“"
                            }
                        ],
