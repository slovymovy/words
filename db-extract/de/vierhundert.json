                    {
                        "sense_id": "6ebc4491-c004-3546-8e6e-32d8eb823a84",
                        "entry_id": "14fa40d5-5d91-311b-9685-567359c9a173",
                        "glosses": [
                            "die natürliche Zahl zwischen der Dreihundertneunundneunzig und der Vierhunderteins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d14c0e45-815b-4534-a2ae-2dc0953877a4",
                                "sense_id": "6ebc4491-c004-3546-8e6e-32d8eb823a84",
                                "text": "„Der Rat der Vierhundert (griechisch οἱ τετρακόσιοι, hoi tetrakósioi „die Vierhundert“) bezeichnet allgemein ein politisches Gremium im antiken Athen, das sich aus vierhundert Mitgliedern zusammensetzte.“"
                            },
                            {
                                "example_id": "c015b91c-6b15-488b-9aa8-918ea03cd5ae",
                                "sense_id": "6ebc4491-c004-3546-8e6e-32d8eb823a84",
                                "text": "„Einfache Wörter für große Zahlen gab es nicht für Hundert und Tausend, sondern für die Zwanzigerpotenzen Zwanzig, Vierhundert, Achttausend und so weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
