                    }
                ],
                "translations": [
                    {
                        "translation_id": "75c60cab-6fc9-4e12-a984-6ce856ed1b3e",
                        "source_entry_id": "6bf443d5-59f4-353f-a59a-a61b24f09b19",
                        "source_sense_id": "a0de6371-3ded-3836-bd40-7832283923ff",
                        "target_lang_word": "princezna",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "princezna",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "dfb4f661-c581-3516-88db-a27af75ded22",
                                        "entry_id": "61bf46ca-d2f4-3ec5-b3ff-9ff055885d65",
                                        "glosses": [
                                            "titul dcery vládce v některých zemích"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6b56346-c3ef-41d4-886b-f135685a363a",
                                                "sense_id": "dfb4f661-c581-3516-88db-a27af75ded22",
                                                "text": "Princezna nechtěla o polibku ani slyšet a s ošklivostí odvracela se od hada."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f29294ca-08b9-4335-be17-0a83bf069e80",
                        "source_entry_id": "6bf443d5-59f4-353f-a59a-a61b24f09b19",
                        "source_sense_id": "a0de6371-3ded-3836-bd40-7832283923ff",
                        "target_lang_word": "королевна",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "королевна",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "45e85091-4569-3376-a00f-a7af250e1ed5",
                                        "entry_id": "97fc6b1f-da88-3209-b206-b0c5c7513367",
                                        "glosses": [
                                            "устар. и нар.-поэт. дочь короля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "753c7e04-df5e-4220-8cce-33d7b25a2e4c",
                                                "sense_id": "45e85091-4569-3376-a00f-a7af250e1ed5",
                                                "text": "В третье лето вздумал он жениться // На Любусе, чешской королевне."
                                            },
                                            {
                                                "example_id": "031c5446-3abd-44cb-9bee-ba749118bd89",
                                                "sense_id": "45e85091-4569-3376-a00f-a7af250e1ed5",
                                                "text": "…И объявил: что, кто вепря погубит, // Тому счастливцу даст он дочь свою // В замужество — королевну Илию, // Кто б ни был он, а зятя сам полюбит, // Как сына."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc265d7-1a44-3e13-945a-205e4d8dfb6d",
                                        "entry_id": "97fc6b1f-da88-3209-b206-b0c5c7513367",
                                        "glosses": [
                                            "устар. то же, что королева"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922731a6-1ff4-4c04-9a10-bd6de00867f4",
                                                "sense_id": "7bc265d7-1a44-3e13-945a-205e4d8dfb6d",
                                                "text": "А после того учинилося нам ведомо, что сестры твоей Марьи королевны не стало, а Филипа короля ишпанского аглинские люди с королевства сослали, а тебя учинили на королевстве."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
