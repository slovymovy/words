                "senses": [
                    {
                        "sense_id": "6c32d8cd-1fbc-3e3c-8723-6fc684fa503d",
                        "entry_id": "ed950bce-ae2f-3318-9322-96e8cb09e37d",
                        "glosses": [
                            "bestimmtes Makromolekül, das eines von cirka 100 Proteinen (Eiweißen) darstellt, die im Blut/Blutplasma zu finden sind (und auch zum Teil um Zellen herum, interstitiell)"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "1fbe7012-18d3-4bbe-8779-58747e2cf056",
                                "sense_id": "6c32d8cd-1fbc-3e3c-8723-6fc684fa503d",
                                "text": "Das bekannteste und wichtigste Bluteiweiß ist das in der Leber gebildete Albumin."
                            },
                            {
                                "example_id": "87e8e2ed-26d3-4e4b-970b-7b27167e2a9e",
                                "sense_id": "6c32d8cd-1fbc-3e3c-8723-6fc684fa503d",
                                "text": "„Die Bluteiweiße transportieren im Blutsystem eine Reihe von Substanzen. Dazu zählen Hormone, Fettsäuren, Phospholipide, Metallionen, Aminosäuren und Bilirubin. Zudem sind die Proteine für die Flüssigkeitsverteilung im Körper zuständig (kolloidosmotischer Druck) und haben wichtige Funktionen bei der Körperabwehr (Immunglobuline) und der Aufrechterhaltung des Blut-pH-Wertes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
