                "senses": [
                    {
                        "sense_id": "c99468de-ef93-346b-92f7-5cb59310ef12",
                        "entry_id": "4bbb96ba-aa6b-38df-b6d3-27fd4b41774b",
                        "glosses": [
                            "Relatif à Anvers en Belgique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b647fc-9985-4836-94f4-e545226b76ef",
                                "sense_id": "c99468de-ef93-346b-92f7-5cb59310ef12",
                                "text": "Bien plus, la statue commandée au sculpteur anversois Slodtz, le Roi ne la vit jamais: […]."
                            },
                            {
                                "example_id": "381e9ba5-eb42-4a9d-9988-c582fbf46fbe",
                                "sense_id": "c99468de-ef93-346b-92f7-5cb59310ef12",
                                "text": "Trois de ces films sont des comédies populaires et anversoises qui font de Vanderheyden – comme l’a écrit un critique de l’époque – un « Pagnol des bords de l’Escaut »."
                            },
                            {
                                "example_id": "3ea32523-6cd2-43e3-8fd6-da3262171103",
                                "sense_id": "c99468de-ef93-346b-92f7-5cb59310ef12",
                                "text": "Face à une opposition anversoise en plein doute, les Anderlechtois ont assuré l’essentiel grâce à un but de Kanu marqué peu avant l’heure de jeu."
                            },
                            {
                                "example_id": "622af82d-e564-4a55-9aec-3774a119a030",
                                "sense_id": "c99468de-ef93-346b-92f7-5cb59310ef12",
                                "text": "D’après ce que m’ont dit des amis qui sont passés le voir dans sa maison anversoise, il avait en permanence le sourire aux lèvres et semblait enfin heureux."
                            }
                        ]
                    },
