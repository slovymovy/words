                },
                {
                    "sense_id": "1e26a0ae-a126-3e1a-b2cf-ded7bed646dc",
                    "sense_definition": "Défaire ou ôter un lien, une attache, une ceinture ou une boucle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
