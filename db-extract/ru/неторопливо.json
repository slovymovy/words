        "ru-extract.jsonl": [
            {
                "entry_id": "813d6e74-41db-3f0d-aa0b-89a0b00be161",
                "word": "неторопливо",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a8f86612-522d-354a-ba10-114f90b77252",
                        "entry_id": "813d6e74-41db-3f0d-aa0b-89a0b00be161",
                        "glosses": [
                            "наречие к неторопливый; медленно, не торопясь"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "f8b12f2f-e012-49b7-ae47-10e21e88339c",
                                "sense_id": "a8f86612-522d-354a-ba10-114f90b77252",
                                "text": "Отрыгивая густой солярочный дым, машина на базе малого бронированного тягача неторопливо подползла к погрузочной рампе трофейного челнока."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a9c5198-ca96-4db3-b55d-f25181dde99c",
                        "source_entry_id": "813d6e74-41db-3f0d-aa0b-89a0b00be161",
                        "source_sense_id": "a8f86612-522d-354a-ba10-114f90b77252",
                        "target_lang_word": "posément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "posément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f162b926-461b-39ad-a438-70bb2154bd1e",
                                        "entry_id": "d9d5d6cf-2a4a-3ae6-85b5-9c2528f13034",
                                        "glosses": [
                                            "Doucement ; modérément ; sans se presser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e416b4ed-cd37-43b3-bf55-327142bd988e",
                                                "sense_id": "f162b926-461b-39ad-a438-70bb2154bd1e",
                                                "text": "Posément le uhlan avait replié sa carte, ressanglé, puis enfourché sa bête. Il disparut."
                                            },
                                            {
                                                "example_id": "1c3584e7-c58f-40f7-8a0b-4dbf827efb76",
                                                "sense_id": "f162b926-461b-39ad-a438-70bb2154bd1e",
                                                "text": "Ce qu’il faut, c’est marcher posément, comme un homme posé, en regardant où on marche, pour ne pas mettre le pied dans une bouse de vache."
                                            },
                                            {
                                                "example_id": "e7715ebb-6d98-4be1-b3f3-9d32ad0fc628",
                                                "sense_id": "f162b926-461b-39ad-a438-70bb2154bd1e",
                                                "text": "Il reporta sur son carnet les éléments qu'il avait mémorisés, il y penserait chez lui, posément… Lorsqu'il serait plus calme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0adbc3ce-08e9-4fac-a466-bce6185f1cee",
                        "source_entry_id": "813d6e74-41db-3f0d-aa0b-89a0b00be161",
                        "source_sense_id": "a8f86612-522d-354a-ba10-114f90b77252",
                        "target_lang_word": "tranquillement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tranquillement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                        "entry_id": "96d18160-d28a-3321-b61c-ea4d179c5d20",
                                        "glosses": [
                                            "D’une manière tranquille ; avec tranquillité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79689f8d-350a-49a0-bbf8-bf8bb1f5ce6b",
                                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                                "text": "Le uhlan mettait pied à terre, ouvrait tranquillement une carte ou un calepin, prenait des notes."
                                            },
                                            {
                                                "example_id": "8e64e10c-4c66-4f99-83a0-eb6e7ac0a587",
                                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                                "text": "Le départ du défenseur devrait au moins permettre à John Textor de passer plus tranquillement son grand oral devant la DNCG, ce mercredi."
                                            },
                                            {
                                                "example_id": "dca1ada4-7d30-459a-9e89-f8970b055786",
                                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                                "text": "Mais, saperlotte ! tâchons donc que tout ça se passe tranquillement; ça vaudrait beaucoup mieux. Puisque nous avons le suffrage universel, il n’y a plus besoin de coups de fusil."
                                            },
                                            {
                                                "example_id": "b67a8ead-6809-488d-b89d-ed78bc6c2d6e",
                                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                                "text": "Et Charles IX se remit à siffler tranquillement et plus juste que jamais son air favori."
                                            },
                                            {
                                                "example_id": "19a396ed-e9ab-4fd2-9e24-5d1ffae916eb",
                                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                                "text": "Préviens ta femme de ton arrivée. Ça me laissera le temps de passer tranquillement mon froc et de ne pas enfiler, dans la précipitation, mon slip à l'envers."
                                            },
                                            {
                                                "example_id": "52cd3a1b-af4b-4f65-bdd7-ac3fbcd35916",
                                                "sense_id": "de2633a2-0d7e-3d04-acbb-77c9a4459c32",
                                                "text": "Si jamais le prince de Condé parut un homme extraordinaire, s’il parut voir tranquillement toutes choses, c’est dans ces rapides moments d’où dépendent les victoires,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33365b43-f5f4-41b7-b4ae-4b6f47200500",
                        "source_entry_id": "813d6e74-41db-3f0d-aa0b-89a0b00be161",
                        "source_sense_id": "a8f86612-522d-354a-ba10-114f90b77252",
