                        "entry_id": "a760923a-0aa9-3cdc-bbe0-a931db9d7f48",
                        "glosses": [
                            "als Sport- oder Spielgerät dienender, an zwei Punkten befestigter Gurt, auf dem man balanciert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f6817a-659e-4858-bd85-4274f8a62614",
                                "sense_id": "baf422f9-4e1a-3eb1-a6a4-316f74029164",
                                "text": "„Im Gegensatz zu einem straff gespannten Drahtseil gibt die Slackline der Last des Sportlers nach.“"
                            },
                            {
                                "example_id": "a690f3ee-77a7-4e0d-a3d6-b253ff017b60",
                                "sense_id": "baf422f9-4e1a-3eb1-a6a4-316f74029164",
                                "text": "Slacklines, die zwischen Bäumen gespannt werden, können das Kambium verletzen und schlimmstenfalls zum Absterben des Baumes führen."
                            }
                        ],
                        "sense_index_json": "\"1\""
