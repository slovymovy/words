                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "84085521-0427-481c-a8d0-9dd7b9a73e13",
                                "sense_id": "b9dbdc1d-cacb-3dbe-913e-4f352d676490",
                                "text": "Yet he slow in the slade of men of armys mo than syxty with his hondys."
                            },
                            {
                                "example_id": "4734073e-77d3-46cc-bc1c-e48bef7de4a3",
                                "sense_id": "b9dbdc1d-cacb-3dbe-913e-4f352d676490",
                                "text": "The thick and well-growne fogge doth matt my smoother slades,\nAnd on the lower Leas, as on the higher Hades\nThe daintie Clover growes (of grasse the onely silke)\nThat makes each Udder strout abundantly with milke."
                            }
                        ]
