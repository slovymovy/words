                "senses": [
                    {
                        "sense_id": "52210e93-4d02-3a3b-9ca2-b764e08d2e2f",
                        "entry_id": "93a27d6e-de5d-36ab-9063-101a1baadf97",
                        "glosses": [
                            "met een goed verstand of daarvan blijk gevend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25cacdac-5d99-4299-83f9-6e6778b72f34",
                                "sense_id": "52210e93-4d02-3a3b-9ca2-b764e08d2e2f",
                                "text": "Hij is een zeer intelligente jongeman."
                            },
                            {
                                "example_id": "6372c75d-9ea6-4049-8fb0-67bad211bf1e",
                                "sense_id": "52210e93-4d02-3a3b-9ca2-b764e08d2e2f",
                                "text": "Men is tegenwoordig in staat alle mogelijke (kunstmatig) intelligente apparaten te maken, alleen het fabriceren van een intelligente president van de Verenigde Staten is dit keer niet gelukt"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c14b2e47-366e-411d-a763-514a18201fea",
                        "source_entry_id": "93a27d6e-de5d-36ab-9063-101a1baadf97",
                        "source_sense_id": "52210e93-4d02-3a3b-9ca2-b764e08d2e2f",
                        "source_sense_description": "met een goed verstand of daarvan blijk gevend",
                        "target_lang_word": "intelligent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intelligent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96810e52-ce57-321c-9b69-95eb9028d4c8",
                                        "entry_id": "37b9d736-21fe-33ac-a1fd-e3968a907e8e",
                                        "glosses": [
                                            "geistig begabt, von guter Auffassungsgabe, einsichtig, klug, Beziehungen kennend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e503c21-de42-489c-abb5-23332da8640a",
                                                "sense_id": "96810e52-ce57-321c-9b69-95eb9028d4c8",
                                                "text": "Das Wikikonzept ist eine intelligente Lösung."
                                            },
                                            {
                                                "example_id": "58a1dce1-0963-4896-b98c-9255fdcc1e12",
                                                "sense_id": "96810e52-ce57-321c-9b69-95eb9028d4c8",
                                                "text": "„In der Regel sind Menschen mit Asperger ausserordentlich intelligent, vielfach verfügen sie über eine ausgeprägte Inselbegabung.“"
                                            },
                                            {
                                                "example_id": "2893ac58-34dc-48b3-b48e-bd4f4f65965e",
                                                "sense_id": "96810e52-ce57-321c-9b69-95eb9028d4c8",
                                                "text": "„Skorzeny war nicht nur ein Draufgänger, sondern auch sehr intelligent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6a26673-c061-4f00-a66e-2676fa61a607",
                        "source_entry_id": "93a27d6e-de5d-36ab-9063-101a1baadf97",
                        "source_sense_id": "52210e93-4d02-3a3b-9ca2-b764e08d2e2f",
                        "source_sense_description": "met een goed verstand of daarvan blijk gevend",
                        "target_lang_word": "intelligent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intelligent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb50114c-249e-3991-8e78-b0c4b08660b8",
                                        "entry_id": "15d66414-1566-32e9-8a1d-5c5386805339",
                                        "glosses": [
                                            "Of high or especially quick cognitive capacity, bright."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a10aced9-3e51-439f-baf9-cd4e82cee44d",
                                                "sense_id": "eb50114c-249e-3991-8e78-b0c4b08660b8",
                                                "text": "Anstruther laughed good-naturedly. “[…] I shall take out half a dozen intelligent maistries from our Press and get them to give our villagers instruction when they begin work and when they are in the fields.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6473343-2ce2-32ec-82f4-8ac04ac79491",
                                        "entry_id": "15d66414-1566-32e9-8a1d-5c5386805339",
                                        "glosses": [
                                            "Well thought-out, well considered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10fb7f3d-ee27-496b-9ddf-3defeed224bd",
                                                "sense_id": "d6473343-2ce2-32ec-82f4-8ac04ac79491",
                                                "text": "The engineer had a very intelligent design proposal for the new car."
                                            },
                                            {
                                                "example_id": "bad4b484-6c41-49ca-bb5a-0c5020831840",
                                                "sense_id": "d6473343-2ce2-32ec-82f4-8ac04ac79491",
                                                "text": "The general devised an intelligent strategy for the southern campaign."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1d549ba-1936-3311-82a1-aa8e32d4a60e",
                                        "entry_id": "15d66414-1566-32e9-8a1d-5c5386805339",
                                        "glosses": [
                                            "Characterized by thoughtful interaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1a85d03-69a1-4843-9d20-88e6a5546f1a",
                                                "sense_id": "e1d549ba-1936-3311-82a1-aa8e32d4a60e",
                                                "text": "My girlfriend and I had an intelligent conversation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2174b6e0-1a55-3ca1-91b3-03f5b040fc05",
                                        "entry_id": "15d66414-1566-32e9-8a1d-5c5386805339",
                                        "glosses": [
                                            "Having at least a similar level of brain power to humankind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f80d283-8a57-4f6d-bf58-d33116aeed6e",
                                                "sense_id": "2174b6e0-1a55-3ca1-91b3-03f5b040fc05",
                                                "text": "The hunt for extraterrestrial intelligent life continues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b1cf7d-fae3-3c43-921d-a531b79b2271",
                                        "entry_id": "15d66414-1566-32e9-8a1d-5c5386805339",
                                        "glosses": [
                                            "Having an environment-sensing automatically-invoked built-in computer capability."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2aef6cc5-66e1-4244-a055-4282d7903a0c",
                                                "sense_id": "69b1cf7d-fae3-3c43-921d-a531b79b2271",
                                                "text": "an intelligent network or keyboard"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intelligent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c708614-9be7-3ca7-bbd1-375135b0f779",
                                        "entry_id": "f6d046f3-16b7-3808-a1e4-8388cb77219b",
                                        "glosses": [
                                            "A member of the intelligentsia; an intelligent person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c12ee73c-f09c-409c-b08b-ec1136074668",
                                                "sense_id": "8c708614-9be7-3ca7-bbd1-375135b0f779",
                                                "text": "Now, as all intelligents are doomed to pass probationary states, it is highly probable that many intelligents, long antecedent to the foundation of our world, may have tarnished their innocence; or worse, many may have by disobedience fallen."
                                            },
                                            {
                                                "example_id": "b58b98f2-670d-498c-be17-dff703151732",
                                                "sense_id": "8c708614-9be7-3ca7-bbd1-375135b0f779",
                                                "text": "Like many Russian intelligents, the Merežkovskijs, together with Filosofov and the young student Vladimir Zlobin, fled from Russia in 1919."
                                            },
                                            {
                                                "example_id": "a2428a3d-7112-4344-8e6a-977cbae48a50",
                                                "sense_id": "8c708614-9be7-3ca7-bbd1-375135b0f779",
                                                "text": "But if you fall away from your faith, as many intelligents have fallen away, then you will no longer be Russia or Holy Rus’, but a rabble of all kinds of other faiths who wish to destroy one another."
                                            },
                                            {
                                                "example_id": "83b53e6c-fee6-421b-b1b6-6914def245fe",
                                                "sense_id": "8c708614-9be7-3ca7-bbd1-375135b0f779",
                                                "text": "Many Russian intelligents, in particular scientists, that already in tsarist times were “infected” by liberal and even socialist ideas found in the revolution and the societal structure that followed, with all its horrible features, positive sides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cabf34f-6152-4dd7-89c2-6299d3e2fbcf",
                        "source_entry_id": "93a27d6e-de5d-36ab-9063-101a1baadf97",
                        "source_sense_id": "52210e93-4d02-3a3b-9ca2-b764e08d2e2f",
                        "source_sense_description": "met een goed verstand of daarvan blijk gevend",
                        "target_lang_word": "intelligent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intelligent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de59bf10-2351-3ad3-b5fa-65f799e299fd",
                                        "entry_id": "bc96e041-1010-31e3-b933-878c11d6438f",
                                        "glosses": [
                                            "Qui est pourvu de la faculté de comprendre, qui est capable de concevoir et de raisonner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94078c6b-24cd-43b8-917c-d394de50e449",
                                                "sense_id": "de59bf10-2351-3ad3-b5fa-65f799e299fd",
                                                "text": "L'humain est l'être le plus intelligent sur Terre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a207047-0207-3c7f-b63e-ad5d40311e67",
                                        "entry_id": "bc96e041-1010-31e3-b933-878c11d6438f",
                                        "glosses": [
                                            "Qui a beaucoup d’intelligence ; qui conçoit facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61715b17-1d9f-4acf-941e-9743a9a4f612",
                                                "sense_id": "8a207047-0207-3c7f-b63e-ad5d40311e67",
                                                "text": "Le vulgaire confond toujours l’instruction et l’intelligence : il y a des illettrés fort intelligents ; seulement leur intelligence ne s’exerce que sur un petit nombre de notions usuelles. Ils ne peuvent lutter, sur le terrain civilisé, avec l’imbécile instruit : ils ne disposent que d’un bâton et l’imbécile est armé d’une carabine à répétition."
                                            },
                                            {
                                                "example_id": "ec1e218f-4e1e-4ff0-9231-461d54a3d0f4",
                                                "sense_id": "8a207047-0207-3c7f-b63e-ad5d40311e67",
                                                "text": "Homme intelligent et sympathique, d’un commerce agréable, musulman convaincu mais tolérant, c’est un des rares Marocains qui ont tiré un profit réel de leur séjour en Europe."
                                            },
                                            {
                                                "example_id": "9c673467-392c-4bce-9758-7d8b934746d1",
                                                "sense_id": "8a207047-0207-3c7f-b63e-ad5d40311e67",
                                                "text": "Et une deuxième erreur a été faite, dont nous portons tous la responsabilité, moi y compris, je ne me pose pas en censeur : c’est le fait d’avoir probablement été trop intelligents, trop subtils, trop techniques dans les mesures de pouvoir d’achat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "899278d4-8f52-3c70-a6d7-bd01d3f286ad",
                                        "entry_id": "bc96e041-1010-31e3-b933-878c11d6438f",
                                        "glosses": [
                                            "Qui exprime de l’intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b3fa1d5-6140-4abd-8015-30e606e07ffd",
                                                "sense_id": "899278d4-8f52-3c70-a6d7-bd01d3f286ad",
                                                "text": "La jeune marque propose deux modèles de VAE (vélo à assistance électrique) intelligents, innovants, à des prix très compétitifs (entre 1700 et 2300 €)."
                                            },
                                            {
                                                "example_id": "a31d950f-e72b-4135-a33f-1417707cf9d4",
                                                "sense_id": "899278d4-8f52-3c70-a6d7-bd01d3f286ad",
                                                "text": "Les indigènes se montraient très sympathiques, aimables et complaisants ; leurs figures du type mongol caractérisé, souriaient, intelligentes et franches."
                                            },
                                            {
                                                "example_id": "f1a70056-30ea-4fd8-948a-0cde718cb2ed",
                                                "sense_id": "899278d4-8f52-3c70-a6d7-bd01d3f286ad",
                                                "text": "Pour le dire sans ambages, une personne brillante fait plus souvent des choses stupides qu’une personne stupide ne fait de choses intelligentes (Reeder & Brewer, 1979)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5f06794-79d2-3bd6-bd9f-019592325455",
                                        "entry_id": "bc96e041-1010-31e3-b933-878c11d6438f",
                                        "glosses": [
                                            "Qui a beaucoup d’habileté, d’adresse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2517ff9d-50bb-4370-af10-06ae8aaaa768",
                                                "sense_id": "d5f06794-79d2-3bd6-bd9f-019592325455",
                                                "text": "Grâce aux soins intelligents qui lui furent prodigués par doña Jesusita et ses femmes, le juge ne tarda pas à revenir à lui ; […]."
                                            },
                                            {
                                                "example_id": "361bbcb0-16f9-4f09-98b3-3725297429f6",
                                                "sense_id": "d5f06794-79d2-3bd6-bd9f-019592325455",
                                                "text": "Et l’avarice, considérée comme un péché par l’Église catholique, est devenue le signe d’une défense intelligente contre la surconsommation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76aa7c7b-6d40-396c-8e07-c82a4beebdbd",
                                        "entry_id": "bc96e041-1010-31e3-b933-878c11d6438f",
                                        "glosses": [
                                            "Connecté."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b8e1c3b-6f26-4a00-9cf2-8e4408078ac8",
                                                "sense_id": "76aa7c7b-6d40-396c-8e07-c82a4beebdbd",
                                                "text": "En fin de compte, l’évolution vers un environnement de plus en plus intelligent, ou du moins connecté, nécessite une réflexion approfondie sur la manière dont nous interagissons avec la technologie et comment celle-ci affecte nos processus cognitifs et nos comportements."
                                            }
                                        ]
                                    }
                                ]
                            },
