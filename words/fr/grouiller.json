{
    "word_family": [
        "grouillement",
        "dégrouiller"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "465ee28d-9368-3cee-8ccd-604344fe77a7",
                    "sense_definition": "Se dépêcher, agir avec une grande rapidité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons nous <w>grouiller</w> si nous ne voulons pas rater le début du concert."
                        },
                        {
                            "text": "Tu ferais bien de te <w>grouiller</w> car les invités vont arriver d'une minute à l'autre."
                        }
                    ],
                    "synonyms": [
                        "magner"
                    ],
                    "common_phrases": [
                        "avoir intérêt à se grouiller",
                        "se grouiller pour partir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "42ffc499-28b4-3fd3-a31c-11202f4e4bed",
                    "sense_definition": "Être plein d'une multitude d'êtres vivants en mouvement continuel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les vacances d'été, les rues du centre historique <w>grouillent</w> de touristes venus du monde entier."
                        },
                        {
                            "text": "Après la pluie, le sol du potager <w>grouille</w> de vers de terre."
                        }
                    ],
                    "common_phrases": [
                        "grouiller de monde",
                        "grouiller d'insectes"
                    ]
                },
                {
                    "sense_id": "b8f63ec8-11cb-33b8-8b87-dcd510f1fcaa",
                    "sense_definition": "S'agiter ou remuer en masse confuse, pulluler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des milliers de petites fourmis <w>grouillaient</w> au pied du grand chêne centenaire."
                        },
                        {
                            "text": "Dans ce marché très animé, une foule compacte <w>grouille</w> entre les étals colorés."
                        }
                    ],
                    "common_phrases": [
                        "grouiller dans l'ombre",
                        "grouiller en tous sens"
                    ]
                },
                {
                    "sense_id": "343870b4-e2c6-3fbf-91a7-d0015b908342",
                    "sense_definition": "Faire des bruits intestinaux, gargouiller, en parlant du ventre ou de l'estomac.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Comme je n'ai rien mangé depuis ce matin, mon ventre <w>grouille</w> sans arrêt."
                        },
                        {
                            "text": "Pendant le silence de l'examen, son estomac s'est mis à <w>grouiller</w> bruyamment."
                        }
                    ],
                    "common_phrases": [
                        "avoir le ventre qui grouille"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "4a986593-bbe4-3c99-bfcc-457ec4941bdf",
                    "sense_definition": "Bouger légèrement ou remuer, changer de position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le froid était si intense qu'il pouvait à peine <w>grouiller</w> ses doigts engourdis."
                        },
                        {
                            "text": "L'animal blessé restait allongé dans l'herbe et ne <w>grouillait</w> plus du tout."
                        }
                    ],
                    "common_phrases": [
                        "ne pas pouvoir grouiller"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                }
            ]
        }
    ]
}