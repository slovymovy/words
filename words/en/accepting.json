{
    "word_family": [
        "acceptance",
        "acceptable",
        "acceptability",
        "acceptably",
        "acceptor"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "171e8833-e050-31a7-9b42-d97b919c9804",
                    "sense_definition": "Willing to tolerate or receive something or someone without protest or judgment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had an <w>accepting</w> attitude toward different cultures.",
                            "target_lang_translations": {
                                "ru": "У нее было <w>принимающее</w> отношение к разным культурам."
                            }
                        },
                        {
                            "text": "His family was warm and <w>accepting</w> of his new friends.",
                            "target_lang_translations": {
                                "ru": "Его семья была теплой и <w>принимающей</w> по отношению к его новым друзьям."
                            }
                        }
                    ],
                    "synonyms": [
                        "tolerant",
                        "open-minded",
                        "understanding"
                    ],
                    "antonyms": [
                        "intolerant",
                        "judgmental"
                    ],
                    "common_phrases": [
                        "warm and accepting",
                        "open and accepting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовый мириться с чем-либо или принимать кого-либо без протеста или осуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимающий",
                                "target_lang_sense_clarification": "в значении открытого, непредвзятого отношения"
                            },
                            {
                                "target_lang_word": "терпимый",
                                "target_lang_sense_clarification": "в значении толерантного отношения к другим"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b3222d5b-576a-3525-a6ed-2a8853ba940d",
                    "sense_definition": "Present participle and gerund of <w>accept</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>accepting</w> the award on behalf of his team.",
                            "target_lang_translations": {
                                "ru": "Он <w>принимает</w> награду от имени своей команды."
                            }
                        },
                        {
                            "text": "She is <w>accepting</w> the fact that she cannot change the past.",
                            "target_lang_translations": {
                                "ru": "Она <w>принимает</w> тот факт, что не может изменить прошлое."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb accept."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий глагола «принимать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимающий",
                                "target_lang_sense_clarification": "в значении процесса получения или согласия"
                            },
                            {
                                "target_lang_word": "принятие",
                                "target_lang_sense_clarification": "в значении процесса смирения с фактом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}