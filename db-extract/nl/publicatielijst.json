                            {
                                "example_id": "2cb8cc1a-af21-4e4a-bb40-89198eec6564",
                                "sense_id": "a52e665a-f1d0-3c7f-8d0e-3bb714030d19",
                                "text": "Uit een onderzoeksrapport blijkt dat Bax zich zeker twintig jaar lang heeft schuldig gemaakt aan wetenschappelijk wangedrag. Zo zoog hij prijzen en nevenfuncties uit zijn duim en bleek een groot deel van zijn publicatielijst uit verzonnen artikelen te bestaan."
                            }
                        ]
                    },
