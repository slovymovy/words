                {
                    "sense_id": "44276837-20b3-3294-9b6d-0e10eb87fe09",
                    "sense_definition": "Zustand der Unabhängigkeit, frei von Zwang und Bevormundung entscheiden und handeln zu können",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "selbstbestimmung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Menschen demonstrieren weltweit für ihre persönliche <w>Freiheit</w> und Demokratie."
                        },
                        {
                            "text": "In einer offenen Gesellschaft bedeutet <w>Freiheit</w> auch Verantwortung für das eigene Handeln."
                        }
                    ],
                    "synonyms": [
                        "Unabhängigkeit",
                        "Selbstständigkeit",
                        "Ungebundenheit"
                    ],
                    "antonyms": [
                        "Unfreiheit",
                        "Abhängigkeit",
                        "Fremdbestimmung"
                    ],
                    "common_phrases": [
                        "Freiheit des Menschen",
                        "Kampf um die Freiheit"
                    ]
                },
                {
                    "sense_id": "f91b22e4-7bc8-3253-b4de-bc7c60b0f858",
                    "sense_definition": "Zustand, sich ungehindert bewegen zu können und nicht eingesperrt oder gefangen zu sein",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ungefangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach vielen Jahren Haft kam der Mann endlich wieder in <w>Freiheit</w>."
                        },
                        {
                            "text": "Wilde Tiere sollten nicht in kleinen Käfigen eingesperrt sein, sondern in <w>Freiheit</w> leben."
                        }
                    ],
                    "antonyms": [
                        "Gefangenschaft",
                        "Sklaverei"
                    ],
                    "common_phrases": [
                        "in Freiheit leben",
                        "in Freiheit setzen"
                    ]
                },
                {
                    "sense_id": "ee6dd9a6-2657-31f0-b5da-9d787fbe2bbf",
                    "sense_definition": "Recht oder gewährter Handlungsspielraum, etwas nach eigenem Ermessen zu tun",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spielraum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die neue Chefin lässt ihren Mitarbeitern bei Projekten erstaunlich viele <w>Freiheiten</w>."
                        },
                        {
                            "text": "Als Jugendlicher wünscht man sich oft mehr persönliche <w>Freiheiten</w> von den Eltern."
                        }
                    ],
                    "common_phrases": [
                        "sich Freiheiten herausnehmen",
                        "große Freiheiten genießen"
                    ]
                }
            ]
