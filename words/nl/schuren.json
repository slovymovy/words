    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df1c0cfd-502e-312c-911a-675bd9332ff6",
                    "sense_definition": "een oppervlak glad maken door wrijving met een ruw materiaal zoals <w>schuurpapier</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "oppervlaktebewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voordat je de houten tafel gaat lakken, moet je het oppervlak eerst grondig <w>schuren</w>.",
                            "target_lang_translations": {
                                "en": "Before you varnish the wooden table, you must first <w>sand</w> the surface thoroughly."
                            }
                        },
                        {
                            "text": "Je moet het hout <w>schuren</w> om alle oude verfresten volledig te verwijderen.",
                            "target_lang_translations": {
                                "en": "You need to <w>sand</w> the wood to completely remove all old paint residue."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hout schuren",
                        "glad schuren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a surface smooth by rubbing it with a rough material such as sandpaper"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sand",
                                "target_lang_sense_clarification": "using sandpaper or an abrasive"
                            },
                            {
                                "target_lang_word": "scour",
                                "target_lang_sense_clarification": "cleaning or polishing by rubbing vigorously"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3c8ca5d-4bbe-3019-b6cb-51ef8b2b974e",
                    "sense_definition": "langs iets heen wrijven op een manier die irritatie of slijtage veroorzaakt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wrijving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn nieuwe schoenen <w>schuren</w> vreselijk tegen mijn hielen tijdens het lopen.",
                            "target_lang_translations": {
                                "en": "My new shoes <w>chafe</w> terribly against my heels while walking."
                            }
                        },
                        {
                            "text": "De strakke boord van zijn overhemd begon na een paar uur pijnlijk te <w>schuren</w>.",
                            "target_lang_translations": {
                                "en": "The tight collar of his shirt started to <w>rub</w> painfully after a few hours."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pijnlijk schuren"
                    ],
                    "target_lang_definitions": {
                        "en": "to rub against something in a way that causes irritation, soreness, or wear"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chafe",
                                "target_lang_sense_clarification": "causing soreness by rubbing"
                            },
                            {
                                "target_lang_word": "rub",
                                "target_lang_sense_clarification": "general friction against a surface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d26a1ca-8c76-3e85-b787-222ce41f9560",
                    "sense_definition": "figuurlijk gebruikt voor situaties die spanning, ongemak of disharmonie veroorzaken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De samenwerking tussen de twee afdelingen begon na de reorganisatie behoorlijk te <w>schuren</w>.",
                            "target_lang_translations": {
                                "en": "The collaboration between the two departments started to <w>clash</w> considerably after the reorganization."
                            }
                        },
                        {
                            "text": "Het <w>schuurt</w> wanneer de idealen van de partij niet overeenkomen met de harde werkelijkheid.",
                            "target_lang_translations": {
                                "en": "It <w>grates</w> when the party's ideals do not match the harsh reality."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het schuurt"
                    ],
                    "target_lang_definitions": {
                        "en": "used figuratively for situations that cause tension, discomfort, or lack of harmony"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clash",
                                "target_lang_sense_clarification": "conflict or disharmony"
                            },
                            {
                                "target_lang_word": "grate",
                                "target_lang_sense_clarification": "causing irritation or friction in a situation"
                            },
                            {
                                "target_lang_word": "jar",
                                "target_lang_sense_clarification": "to have a harsh or disagreeable effect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "816a5842-2676-3936-812a-c8c12d00246e",
                    "sense_definition": "op een intieme of seksueel getinte manier heel dicht tegen elkaar aan dansen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dans",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de donkere hoek van de club stonden verschillende stelletjes innig te <w>schuren</w>.",
                            "target_lang_translations": {
                                "en": "In the dark corner of the club, several couples were <w>grinding</w> intimately."
                            }
                        },
                        {
                            "text": "Ze wilden de hele nacht <w>schuren</w> op de ritmische muziek van de dj.",
                            "target_lang_translations": {
                                "en": "They wanted to <w>grind</w> all night to the rhythmic music of the DJ."
                            }
                        }
                    ],
                    "common_phrases": [
                        "innig schuren"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in de context van uitgaan en uitdagend dansen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to dance very closely against each other in an intimate or sexually suggestive manner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "dancing closely and suggestively"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0327b1e2-817d-3692-8d65-7a6e359973e5",
                    "sense_definition": "het binnenhalen van de oogst in een <w>schuur</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boeren werkten tot laat in de avond om het graan tijdig te <w>schuren</w>.",
                            "target_lang_translations": {
                                "en": "The farmers worked until late in the evening to <w>garner</w> the grain in time."
                            }
                        },
                        {
                            "text": "Na een succesvolle oogst was het tijd om alle gewassen veilig te <w>schuren</w>.",
                            "target_lang_translations": {
                                "en": "After a successful harvest, it was time to safely <w>barn</w> all the crops."
                            }
                        }
                    ],
                    "synonyms": [
