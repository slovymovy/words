                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1530b4eb-e66c-4cf7-8ed5-351c47a4d597",
                        "entry_id": "56a78f78-04ac-3819-8c37-b42314a07163",
