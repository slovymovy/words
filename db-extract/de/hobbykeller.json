                "senses": [
                    {
                        "sense_id": "c3cd3b6e-59c0-3fab-8f9f-4e4ab14c4523",
                        "entry_id": "1ff62e52-605f-308f-a717-4333d0c394e6",
                        "glosses": [
                            "Kellerraum, der so eingerichtet ist, dass man darin seinem Hobby nachgehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec444017-ee91-4b46-a879-30f512348986",
                                "sense_id": "c3cd3b6e-59c0-3fab-8f9f-4e4ab14c4523",
                                "text": "„Wie zuvor 3D-Drucker befinden sich damit auch CNC-Fräsen vom gewerblichen Betrieb auf dem Weg in die Hobbykeller.“"
                            },
                            {
                                "example_id": "90554132-1983-4049-be7c-152018e1d790",
                                "sense_id": "c3cd3b6e-59c0-3fab-8f9f-4e4ab14c4523",
                                "text": "„In unserer Studie zu dem \"typisch Deutschen\" haben wir herausgefunden, dass das produktive Werkeln oft im Hobbykeller oder im Verein stattfindet, also in berechenbaren Formen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
