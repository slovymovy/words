                "senses": [
                    {
                        "sense_id": "2948ad4f-2446-3dd8-8adb-6446553a5df5",
                        "entry_id": "53948720-1d7f-33db-b3e6-8fde662c6ac7",
                        "glosses": [
                            "материя, вещество"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f73393e-2907-456d-8d18-0280f5eb34b6",
                        "source_entry_id": "53948720-1d7f-33db-b3e6-8fde662c6ac7",
                        "source_sense_id": "2948ad4f-2446-3dd8-8adb-6446553a5df5",
                        "target_lang_word": "substance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "substance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81e3ffca-5ed3-3634-873d-3baa2c803e86",
                                        "entry_id": "b894fb25-f0f7-342f-8eeb-ce9801fb88a2",
                                        "glosses": [
                                            "Physical matter; material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "049d75ac-cb0f-4fe2-8777-3d56ebf7efff",
                                                "sense_id": "81e3ffca-5ed3-3634-873d-3baa2c803e86",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            },
                                            {
                                                "example_id": "85093227-6b1e-49d8-a340-65aa84fdbca1",
                                                "sense_id": "81e3ffca-5ed3-3634-873d-3baa2c803e86",
                                                "text": "His wasted hands were stretched out, and worked with a quick and convulsive motion, as if catching some small substances which kept eluding their grasp;..."
                                            },
                                            {
                                                "example_id": "ace21748-34c6-499f-a7f0-8b13e758e962",
                                                "sense_id": "81e3ffca-5ed3-3634-873d-3baa2c803e86",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b0e67f-1a10-386c-b42f-d2759ade87cf",
                                        "entry_id": "b894fb25-f0f7-342f-8eeb-ce9801fb88a2",
                                        "glosses": [
                                            "Physical matter; material.",
                                            "A form of matter that has constant chemical composition and characteristic properties."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57c19de6-2b6d-33f7-859d-91143dc1b73c",
                                        "entry_id": "b894fb25-f0f7-342f-8eeb-ce9801fb88a2",
                                        "glosses": [
                                            "The essential part of anything; the most vital part."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af920da5-3d14-4ac5-b58c-d05631817547",
                                                "sense_id": "57c19de6-2b6d-33f7-859d-91143dc1b73c",
                                                "text": "Heroic virtue did his actions guide, / And he the substance, not the appearance, chose."
                                            },
                                            {
                                                "example_id": "d80ef5bb-ad4e-49f2-a1f4-5f8332b7899b",
                                                "sense_id": "57c19de6-2b6d-33f7-859d-91143dc1b73c",
                                                "text": "1684-1690, Thomas Burnet, Sacred Theory of the Earth\nThis edition is the same in substance with the Latin."
                                            },
                                            {
                                                "example_id": "94a71032-b3fd-43ce-8c01-e0e6607fa2d1",
                                                "sense_id": "57c19de6-2b6d-33f7-859d-91143dc1b73c",
                                                "text": "It is insolent in words, in manner; but in substance it is not only insulting, but alarming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "022c1f61-37cf-3cdc-8d79-33addfbef79a",
                                        "entry_id": "b894fb25-f0f7-342f-8eeb-ce9801fb88a2",
                                        "glosses": [
                                            "Substantiality; solidity; firmness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89e2071f-ffe2-412b-a221-92bea188b354",
                                                "sense_id": "022c1f61-37cf-3cdc-8d79-33addfbef79a",
                                                "text": "Some textile fabrics have little substance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f2ff5c1-db90-30b8-bbf8-ce6822b7bf6d",
                                        "entry_id": "b894fb25-f0f7-342f-8eeb-ce9801fb88a2",
                                        "glosses": [
                                            "Material possessions; estate; property; resources."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f7564f1-e435-4023-9648-7ce777261caf",
                                                "sense_id": "3f2ff5c1-db90-30b8-bbf8-ce6822b7bf6d",
                                                "text": "a man of substance"
                                            },
                                            {
                                                "example_id": "3ca03204-6ddd-488c-8fc7-555d6cd12d47",
                                                "sense_id": "3f2ff5c1-db90-30b8-bbf8-ce6822b7bf6d",
                                                "text": "And there wasted his substance with riotous living."
                                            },
                                            {
                                                "example_id": "97880470-21e8-498b-93b8-d15a7580db3e",
                                                "sense_id": "3f2ff5c1-db90-30b8-bbf8-ce6822b7bf6d",
                                                "text": "Thy substance, valued at the highest rate, / Cannot amount unto a hundred marks."
                                            },
                                            {
                                                "example_id": "fa2880a1-0e66-43b2-82af-2373ebe74691",
                                                "sense_id": "3f2ff5c1-db90-30b8-bbf8-ce6822b7bf6d",
                                                "text": "And as we have waſted our Strength and vital Subſtance in this profuſe manner, ſo we have ſhamefully miſapplied it to Ends at leaſt very different from thoſe for which we undertook the War, and often to effect others which after a Peace we may ſeverely repent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "327bbf96-5468-34d6-bd91-2b99a50b9daa",
                                        "entry_id": "b894fb25-f0f7-342f-8eeb-ce9801fb88a2",
                                        "glosses": [
                                            "Drugs (illegal narcotics)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f36f8e11-ec4a-4b4b-9528-92bc982070d2",
                                                "sense_id": "327bbf96-5468-34d6-bd91-2b99a50b9daa",
                                                "text": "substance abuse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c5d5981-62a8-3ba1-b11c-9a414b31827b",
                                        "entry_id": "b894fb25-f0f7-342f-8eeb-ce9801fb88a2",
                                        "glosses": [
                                            "Ousia, essence; underlying reality or hypostasis in the philosophical sense."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "substance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29262bf2-2ef5-3c1c-b193-25f36544877c",
                                        "entry_id": "9149bd69-95d3-3c11-93e6-85e66b0d63ab",
                                        "glosses": [
                                            "To give substance to; to make real or substantial."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39451e03-5af6-4fd1-a089-02ab3197c26e",
                                                "sense_id": "29262bf2-2ef5-3c1c-b193-25f36544877c",
                                                "text": "If life were nothing but what gets phrased and substanced, the world might as well be rolled up and laid away again in darkness."
                                            },
                                            {
                                                "example_id": "866b8a04-7b02-4ab0-9c7e-60b28aae9344",
                                                "sense_id": "29262bf2-2ef5-3c1c-b193-25f36544877c",
                                                "text": "The calm ruminating / Reverie, substancing / Intellect into emotion, / Is shelter enough for love / Unhumiliated by faith."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
