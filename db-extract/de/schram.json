                        "entry_id": "105816d5-b35e-3215-b868-ab38d1414316",
                        "glosses": [
                            "Schlitz, Einschnitt in ein abzubauendes Gestein"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "822c3daf-ff72-4fa5-bfd5-73be4a2c1dbe",
                                "sense_id": "3dd8cba4-2d25-30f4-b6cc-621947e6a24e",
                                "text": "Wir haben schon weiter oben gezeigt, dass auf den Flötzen ohne Schram es vortheilhaft sei, die Höhe der Strossen auf 1,80 Meter zu vermindern."
                            },
                            {
                                "example_id": "fb56b4b6-e4ef-474e-b7ef-ac2a77d4700a",
                                "sense_id": "3dd8cba4-2d25-30f4-b6cc-621947e6a24e",
                                "text": "Die Maschinen von Neuerburg und Norris bohren mit dicht nebeneinander liegenden drehenden Bohrern Löcher in die Kohle, so daß auch dadurch ein Schram, resp. Schlitz hergestellt wird."
                            }
                        ],
