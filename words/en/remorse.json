{
    "word_family": [
        "remorseful",
        "remorseless",
        "remorsefully",
        "remorselessly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d88fa4b-782f-3de8-9c22-d489eb9965fd",
                    "sense_definition": "A feeling of deep regret or guilt for a wrong one has committed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "guilt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal showed no <w>remorse</w> for his actions during the entire trial.",
                            "target_lang_translations": {
                                "ru": "Преступник не проявил никакого <w>раскаяния</w> в своих действиях на протяжении всего судебного процесса."
                            }
                        },
                        {
                            "text": "After lying to her best friend, she felt a deep sense of <w>remorse</w> that kept her awake at night.",
                            "target_lang_translations": {
                                "ru": "После того как она солгала лучшей подруге, она почувствовала глубокое <w>угрызение совести</w>, которое не давало ей уснуть всю ночь."
                            }
                        }
                    ],
                    "synonyms": [
                        "contrition",
                        "penitence",
                        "repentance",
                        "self-reproach",
                        "guilt",
                        "regret"
                    ],
                    "antonyms": [
                        "irrepentance",
                        "unrepentance",
                        "unremorsefulness"
                    ],
                    "common_phrases": [
                        "sense of remorse",
                        "feel remorse",
                        "show remorse",
                        "deep remorse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство глубокого сожаления или вины за совершенный проступок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскаяние",
                                "target_lang_sense_clarification": "признание своей вины и сожаление о содеянном"
                            },
                            {
                                "target_lang_word": "угрызения совести",
                                "target_lang_sense_clarification": "мучительное чувство вины"
                            },
                            {
                                "target_lang_word": "сожаление",
                                "target_lang_sense_clarification": "чувство печали из-за совершенного поступка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c6b6773-1201-3138-a788-f3e53fdc1bcd",
                    "sense_definition": "A feeling of sorrow, pity, or compassion for the suffering of others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compassion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic story of the refugees filled the audience with a soft <w>remorse</w> and desire to help.",
                            "target_lang_translations": {
                                "ru": "Трагическая история беженцев наполнила аудиторию тихим <w>состраданием</w> и желанием помочь."
                            }
                        },
                        {
                            "text": "In older literature, the word often describes a <w>remorse</w> that is closer to pity than to guilt.",
                            "target_lang_translations": {
                                "ru": "В старой литературе это слово часто описывает <w>жалость</w>, которая ближе к состраданию, чем к вине."
                            }
                        }
                    ],
                    "synonyms": [
                        "pity",
                        "compassion",
                        "commiseration",
                        "sympathy"
                    ],
                    "antonyms": [
                        "apathy"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is primarily found in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство печали, жалости или сострадания к страданиям других (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сострадание",
                                "target_lang_sense_clarification": "жалость и сочувствие к другим"
                            },
                            {
                                "target_lang_word": "жалость",
                                "target_lang_sense_clarification": "чувство сострадания при виде чужой беды"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc37f572-7862-3039-af51-af951338bb36",
                    "sense_definition": "To feel or experience regret or guilt for one's actions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "guilt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>remorse</w> over the missed opportunities of his youth.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>сожалеть</w> об упущенных возможностях своей юности."
                            }
                        },
                        {
                            "text": "It is rare to see someone <w>remorse</w> so openly after making a mistake.",
                            "target_lang_translations": {
                                "ru": "Редко можно увидеть, чтобы кто-то так открыто <w>раскаивался</w> после совершения ошибки."
                            }
                        }
                    ],
                    "synonyms": [
                        "regret",
                        "repent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The verbal form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствовать или испытывать сожаление или вину за свои действия (архаичная форма глагола)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскаиваться",
                                "target_lang_sense_clarification": "испытывать чувство вины за свои поступки"
                            },
                            {
                                "target_lang_word": "сожалеть",
                                "target_lang_sense_clarification": "испытывать печаль о содеянном"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}