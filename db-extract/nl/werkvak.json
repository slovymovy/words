                    {
                        "sense_id": "458820c7-8b4f-383d-b250-2d3c6645d3da",
                        "entry_id": "251a6af2-2485-38c7-93df-16fdfdd2daec",
                        "glosses": [
                            "deel van een weg dat in verband met wegwerkzaamheden helemaal of gedeeltelijk is afgesloten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "266ed484-d717-450a-aac8-688aba811a77",
                                "sense_id": "458820c7-8b4f-383d-b250-2d3c6645d3da",
                                "text": "Rijkswaterstaat verlengt donderdag het werkvak langs de Twenteroute (N18) tussen Haaksbergen en Enschede. Tot woensdag was over 'slechts' een afstand van vier kilometer 50 km/u toegestaan. Vanaf vandaag geldt die snelheid voor 9 kilometer."
                            },
                            {
                                "example_id": "37030736-fc90-4109-a557-9159c1d9d129",
                                "sense_id": "458820c7-8b4f-383d-b250-2d3c6645d3da",
                                "text": "Op de A27 wordt ook aan de weg gewerkt, maar daar heeft het beton niets mee te maken, meldt de VID. Omdat de auto's nu in het werkvak staan, leveren ze voor het overige verkeer niet of nauwelijks hinder op."
                            },
                            {
                                "example_id": "0f57d5d7-bbc1-45f3-bbad-5fa5085a94b0",
                                "sense_id": "458820c7-8b4f-383d-b250-2d3c6645d3da",
                                "text": "Sommige weggebruikers hebben geprobeerd te keren in het werkvak. Tenminste een bestuurder reed tegen het verkeer in over het werkvak terug richting Utrecht. Hij werd ter hoogte van Rijnsweerd aangehouden."
                            }
                        ]
                    }
