                    {
                        "sense_id": "9aea5c59-328b-3ade-9fb0-810ea8af09f1",
                        "entry_id": "0a6c19fb-64a8-3c43-b0bc-1f328b212b10",
                        "glosses": [
                            "Camion équipé d’une pompe à eau et éventuellement d’une réserve d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3825844d-230c-4404-b695-45c749052147",
                                "sense_id": "9aea5c59-328b-3ade-9fb0-810ea8af09f1",
                                "text": "Tandis que l’Espagnol Fernando Sanchez Castillo a filmé un incroyable ballet, un « opéra » superbe avec comme acteur sur un grand parking une autopompe antimanifestation."
                            }
                        ]
                    },
                    {
                        "sense_id": "32ea545a-576b-3fc8-bbd9-118b292a8061",
                        "entry_id": "0a6c19fb-64a8-3c43-b0bc-1f328b212b10",
                        "glosses": [
                            "Camion de pompier équipé d’une pompe d’incendie et éventuellement d’une réserve d’eau."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2596e6b5-bee9-4b60-bf26-7995131438c6",
                                "sense_id": "32ea545a-576b-3fc8-bbd9-118b292a8061",
                                "text": "Les pompiers de Beauraing se sont rendus sur les lieux avec un véhicule de balisage, une autopompe et deux citernes."
                            },
                            {
                                "example_id": "f8db106e-ad9f-43ba-91d8-02d93a94ecfc",
                                "sense_id": "32ea545a-576b-3fc8-bbd9-118b292a8061",
                                "text": "Une autopompe, deux camions citernes, une auto-échelle, un véhicule de commandement et une quinzaine d’hommes ont été dépêchés sur les lieux."
                            }
                        ]
                    }
                ],
