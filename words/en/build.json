    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "622861d5-7c87-3a17-900e-50c2d3cb7211",
                    "sense_definition": "To form something by combining materials or parts; to construct.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They plan to <w>build</w> a new school in the village next year.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>построить</w> новую школу в деревне в следующем году.",
                                "pl": "Planują <w>zbudować</w> nową szkołę w wiosce w przyszłym roku."
                            }
                        },
                        {
                            "text": "Birds <w>build</w> their nests using twigs and leaves.",
                            "target_lang_translations": {
                                "ru": "Птицы <w>строят</w> свои гнезда, используя ветки и листья.",
                                "pl": "Ptaki <w>budują</w> swoje gniazda, używając gałązek i liści."
                            }
                        }
                    ],
                    "synonyms": [
                        "construct",
                        "erect",
                        "assemble",
                        "put together",
                        "make"
                    ],
                    "antonyms": [
                        "demolish",
                        "destroy",
                        "tear down",
                        "dismantle",
                        "knock down",
                        "raze"
                    ],
                    "common_phrases": [
                        "build a house",
                        "build a bridge",
                        "build from scratch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать что-либо, соединяя материалы или части; конструировать.",
                        "pl": "Tworzyć coś poprzez łączenie materiałów lub części; konstruować."
                    },
                    "translations": {
                        "ru": [
                            {
