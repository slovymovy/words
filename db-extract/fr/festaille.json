                "senses": [
                    {
                        "sense_id": "381cdf01-e1e2-3f6d-ab32-dc66a188f13e",
                        "entry_id": "7104136a-91ce-30ae-8142-e53a0629ee93",
                        "glosses": [
                            "Festoiement (sout.), banquet."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5c387363-3b85-4ad6-8a7a-7e53514f55ae",
                                "sense_id": "381cdf01-e1e2-3f6d-ab32-dc66a188f13e",
                                "text": "Oh ! oui, quitter enfin ce rôle de parent pauvre relégué à l’office pendant que, de toutes parts, bruissaient les prémices de la grande festaille."
                            }
                        ]
                    },
                    {
                        "sense_id": "5df53c4d-6b9d-3950-8c1d-da2e6a074ca4",
                        "entry_id": "7104136a-91ce-30ae-8142-e53a0629ee93",
                        "glosses": [
                            "Grande chère, débauche de table, ripaille (fam.), gueuleton (fam.), bombance (fam), ou agapes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adbf14e1-3869-4e85-ba33-218b9cf96809",
                        "source_entry_id": "7104136a-91ce-30ae-8142-e53a0629ee93",
                        "target_lang_word": "feast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4499a9e-6638-3f42-8810-0f76c6c16aa6",
                                        "entry_id": "04753c9f-92ca-3e48-8427-b321ccd14482",
                                        "glosses": [
                                            "A holiday, festival, especially a religious one"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2877a9f-ed1b-43f7-ba49-220865df89b6",
                                                "sense_id": "d4499a9e-6638-3f42-8810-0f76c6c16aa6",
                                                "text": "The seventh day shall be a feast to the Lord."
                                            },
                                            {
                                                "example_id": "0b05dcf1-561f-4e23-814c-425be5303c4b",
                                                "sense_id": "d4499a9e-6638-3f42-8810-0f76c6c16aa6",
                                                "text": "Now his parents went to Jerusalem every year at the feast of the passover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ae85136-2876-32b0-96f1-7abb30dfbc3a",
                                        "entry_id": "04753c9f-92ca-3e48-8427-b321ccd14482",
                                        "glosses": [
                                            "A very large meal, often of a ceremonial nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec09425-9087-4fd9-9eff-1b89f3f49d20",
                                                "sense_id": "5ae85136-2876-32b0-96f1-7abb30dfbc3a",
                                                "text": "We had a feast to celebrate the harvest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9863f69-0d43-3c03-97b2-d78f2675a438",
                                        "entry_id": "04753c9f-92ca-3e48-8427-b321ccd14482",
                                        "glosses": [
                                            "Something delightful"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bebc70b9-6ff3-4843-917f-18e7ec695d06",
                                                "sense_id": "b9863f69-0d43-3c03-97b2-d78f2675a438",
                                                "text": "It was a feast for the eyes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f457f9d-fbda-3daf-90a9-7f8ce13fc79e",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To partake in a feast, or large meal."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b748fbd4-6ebe-45dd-b8e4-b3599661b0ab",
                                                "sense_id": "1f457f9d-fbda-3daf-90a9-7f8ce13fc79e",
                                                "text": "I feasted on turkey and dumplings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7161a144-b64c-3114-8b4d-510e0403bce6",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To dwell upon (something) with delight."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d4fa5d-1560-488e-986a-1f1561493273",
                                                "sense_id": "7161a144-b64c-3114-8b4d-510e0403bce6",
                                                "text": "With my love's picture then my eye doth feast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To hold a feast in honor of (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59c9db80-1d4d-4c6c-8e7e-1076bc731421",
                                                "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                                "text": "He that shall see this day, and live old age,\nWill yearly on the vigil feast his neighbors\nAnd say “Tomorrow is Saint Crispian.”"
                                            },
                                            {
                                                "example_id": "0a8e348b-1309-44d1-847f-d2a516e7031e",
                                                "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                                "text": "His ancestor, he said, had been feasted there, when he went forward with the then Lord Ravenswood to the fatal battle of Flodden, in which they both fell."
                                            },
                                            {
                                                "example_id": "d7f69121-5aac-4c4d-a817-34343b80a094",
                                                "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                                "text": "We feasted them after the victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ef318b-4929-31d9-8364-59810c446f91",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To serve as a feast for; to feed sumptuously."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e454e0d-b62d-4ee5-95fb-e24067140212",
                                                "sense_id": "15ef318b-4929-31d9-8364-59810c446f91",
                                                "text": "1597–1598, Joseph Hall, Virgidemiarum\nOr once a week, perhaps, for novelty / Reez'd bacon-soords shall feast his family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78918dcc-7793-4554-a55a-3256a8d341f3",
                        "source_entry_id": "7104136a-91ce-30ae-8142-e53a0629ee93",
