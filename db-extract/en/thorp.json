                                                "sense_id": "398152c3-ae69-3a4c-a027-0fec835eb811",
                                                "text": "nel villaggio i bambini crescono felici per poi scoprirne un'importante città"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "847ae1d0-fb36-33a8-9a82-313f64b4963d",
                                        "entry_id": "b9b270f0-c2ad-3458-8fe0-8d7c2c7c4d5f",
                                        "glosses": [
                                            "villaggio turistico: in genere di prima categoria, è il sito di un albergo con spettacoli, intrattenimento, servizi per i clienti"
                                        ],
