        "nl-extract.jsonl": [
            {
                "entry_id": "76a46ab6-e92f-35c2-8c8f-fc54f0afa175",
                "word": "make-up",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6fc263e2-2712-3881-b4b6-82e5f31c7134",
                        "entry_id": "76a46ab6-e92f-35c2-8c8f-fc54f0afa175",
                        "glosses": [
                            "schoonheidsproducten die worden gebruikt voor het in orde maken van het gezicht, ogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "471c3df1-ad43-491a-bfdc-2d29fbdb3ba3",
                                "sense_id": "6fc263e2-2712-3881-b4b6-82e5f31c7134",
                                "text": "Ze gaat nooit de deur uit zonder een flinke laag make-up."
                            },
                            {
                                "example_id": "d931a0a4-aa8a-4367-bd21-b5edfca8e3dd",
                                "sense_id": "6fc263e2-2712-3881-b4b6-82e5f31c7134",
                                "text": "Een overdaad aan parfums, flacons, flesjes, schoonheidscrèmes, make-up en badspullen."
                            },
                            {
                                "example_id": "7f398947-f1e9-49c5-8cc0-d48064636ecc",
                                "sense_id": "6fc263e2-2712-3881-b4b6-82e5f31c7134",
                                "text": "Haar huid, voorzien van make-up, was fris en glad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "461c520a-b887-4fd7-ac28-794659d22510",
                        "source_entry_id": "76a46ab6-e92f-35c2-8c8f-fc54f0afa175",
                        "source_sense_id": "6fc263e2-2712-3881-b4b6-82e5f31c7134",
                        "source_sense_description": "schoonheidsproducten",
                        "target_lang_word": "Make-up",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Make-up",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "029258e9-71ad-3707-b265-c410c7af6327",
                                        "entry_id": "1180bcc8-505e-3716-acf6-dd5e33f4005e",
                                        "glosses": [
                                            "Anwendung kosmetischer Mittel, um das Gesicht zu verschönern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc7322a5-93c7-444a-89fc-8a9de786c901",
                                                "sense_id": "029258e9-71ad-3707-b265-c410c7af6327",
                                                "text": "„Sie trägt ein sehr durchsichtiges rosa Kleid, rosa Dessous, eine rosa Brille, ihr Gesicht bedeckt rosa Make-up, und sie benutzt rosa Kleenex-Tücher, um sich vorsichtig damit die rosa Haut abzutupfen.“"
                                            },
                                            {
                                                "example_id": "a2e9f346-da83-4253-8475-bd0db9de25b7",
                                                "sense_id": "029258e9-71ad-3707-b265-c410c7af6327",
                                                "text": "„Harriet wusch ihr Gesicht mit kaltem Wasser und legte dann vor dem Spiegel etwas Make-up auf.“."
                                            },
                                            {
                                                "example_id": "d6fd26c8-42cc-49c0-8f12-8ab2ab43df43",
                                                "sense_id": "029258e9-71ad-3707-b265-c410c7af6327",
                                                "text": "„Ihr Make-up ist dezent, die Kleidung stets so, daß sie unerwarteten Besuchern die Tür öffnen könnte, ohne daß es ihr peinlich sein müßte.“"
                                            },
                                            {
                                                "example_id": "6819c819-be0f-4361-b248-91ef6e785fde",
                                                "sense_id": "029258e9-71ad-3707-b265-c410c7af6327",
                                                "text": "„Sie beschreibt ausführlich, wie Sisi sie um den Kajal gebeten hatte, weil sie ihren eigenen nicht finden konnte und nicht ohne Make-up zur Arbeit gehen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ffb4c88-1076-3625-b187-46ddc421a95a",
                                        "entry_id": "1180bcc8-505e-3716-acf6-dd5e33f4005e",
                                        "glosses": [
                                            "kosmetische Mittel für ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1769973f-05fb-4b9a-bc02-fd4ab81edbb4",
                                                "sense_id": "9ffb4c88-1076-3625-b187-46ddc421a95a",
                                                "text": "„Sein Gesicht war mit klumpigem Make-up verschmiert und er bewegte sich so gewandt wie ein rostiger Zinnsoldat.“"
                                            },
                                            {
                                                "example_id": "469f454b-eee9-4bbf-88dc-21d9ea6a3c73",
                                                "sense_id": "9ffb4c88-1076-3625-b187-46ddc421a95a",
                                                "text": "„Alan hatte ihr Bedürfnis nie verstanden, sofort ein Bad zu nehmen, die Kleider zu wechseln und das Make-up abzuwaschen.“"
                                            },
                                            {
                                                "example_id": "8472c274-8987-4bbb-bfa4-8e1134aad0e9",
                                                "sense_id": "9ffb4c88-1076-3625-b187-46ddc421a95a",
                                                "text": "„Die Wimpern waren so lang, daß es aussah, als hätte er Make-up benutzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34c9d347-ca30-4c6a-bcb1-c3f22710df2e",
                        "source_entry_id": "76a46ab6-e92f-35c2-8c8f-fc54f0afa175",
