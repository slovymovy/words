                "senses": [
                    {
                        "sense_id": "96364038-cbdb-3f36-b991-ff6aba24b68e",
                        "entry_id": "077771c4-1d7c-3568-b713-eb6017b0669f",
                        "glosses": [
                            "a sort of wine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9e87fe-f084-4358-8d69-aaec1045cab4",
                                "sense_id": "96364038-cbdb-3f36-b991-ff6aba24b68e",
                                "text": "Он с наслажде́нием вы́пил не́сколько рю́мок лафи́та, пото́м укры́лся с голово́й; созна́ние его́ затума́нилось, и он усну́л.",
                                "translation": "He drank several glasses of Lafitte, then wrapped himself up, head and all; his consciousness grew clouded and he fell asleep.",
                                "english": "He drank several glasses of Lafitte, then wrapped himself up, head and all; his consciousness grew clouded and he fell asleep."
                            }
                        ]
                    }
                ],
