                "senses": [
                    {
                        "sense_id": "bb2f0b48-6b62-31ca-8820-f0d300515736",
                        "entry_id": "c35e9e6c-4945-36a3-8ccf-fdf1415bc398",
                        "glosses": [
                            "bestimmte, chemisch zu spezifizierende Art eines Kunststoffs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92cc0bee-41c1-4b50-8299-1c6ffe1f42f5",
                                "sense_id": "bb2f0b48-6b62-31ca-8820-f0d300515736",
                                "text": "„Dieser neue Bayblend® Kunststofftyp erweitert Bayers bestehende Familie aus Bayblend® PC/ABS-Medizintypen – Bayblend® M850, Bayblend® M850XF und Bayblend® M301FR.“"
                            },
                            {
                                "example_id": "5b606135-86f5-4348-9d3d-c6e2b0fb4ede",
                                "sense_id": "bb2f0b48-6b62-31ca-8820-f0d300515736",
                                "text": "„GE Advanced Materials stellt mit Lexan EXL 1414H einen neuen Kunststofftyp aus der Lexan-Polycarbonat-Familie vor, der speziell für den Einsatz in Automobilanwendungen entwickelt wurde.“"
                            },
                            {
                                "example_id": "54c509b4-51b8-47c6-b81a-29bbdba13e01",
                                "sense_id": "bb2f0b48-6b62-31ca-8820-f0d300515736",
                                "text": "„Daher berichtet KI neben monatlichen Kontraktpreisen ab sofort auch wöchentlich über die wichtigsten Kunststofftypen im Spothandel.“"
                            },
                            {
                                "example_id": "4d99248a-4116-4248-a92f-16a9f454e595",
                                "sense_id": "bb2f0b48-6b62-31ca-8820-f0d300515736",
                                "text": "„Der Polycarbonat-Kunststoff Lexan bedeutet für den Anwender besondere Kerbschlagzähigkeit und eine herausragende Ästhetik (Oberflächenvergütung). Er gehört zum umfangreichen, stetig wachsenden Portfolio von Sabic, das über 50 Kunststofftypen für den Gesundheitsbereich vorzuweisen hat.“"
                            },
                            {
                                "example_id": "41f79ea5-7e44-429d-ba51-64e14c37ea5f",
                                "sense_id": "bb2f0b48-6b62-31ca-8820-f0d300515736",
                                "text": "„Diese Kunststofftypen werden in einer Material-Datenbank verwaltet, in der sie durch über 70 Eigenschaften beschrieben sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
