                    },
                    {
                        "translation_id": "e4e0616e-c2fc-4a34-8b86-db53ab9a9a6d",
                        "source_entry_id": "03c07c4c-458f-368a-80b1-6b4006316b64",
                        "source_sense_id": "4efd7963-9c77-3ccb-aa93-ec81045c22d5",
                        "source_sense_description": "death of cells",
                        "target_lang_word": "apoptose",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apoptose",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e8af61d5-ea71-3ec2-a220-eb9539bc58ad",
                                        "entry_id": "8a52e214-11fb-32ea-bf05-85d6859125d9",
                                        "glosses": [
                                            "geprogrammeerde celdood"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc5ac2bc-92e7-4e08-bdd3-43d9d48c49e3",
                                                "sense_id": "e8af61d5-ea71-3ec2-a220-eb9539bc58ad",
                                                "text": "Apoptose, ofwel geprogrammeerde celdood, is het voornaamste begrip in het werk van de onderscheiden onderzoekers. Daarmee wordt het natuurlijke proces van cellen bedoeld om zichzelf te vernietigen."
                                            },
                                            {
                                                "example_id": "6cd36e13-3990-4702-a0d9-cadcf93f46d0",
                                                "sense_id": "e8af61d5-ea71-3ec2-a220-eb9539bc58ad",
                                                "text": "Een cel die door veroudering veel DNA-schade heeft opgelopen, gaat in het gunstigste geval dood. Dit is een natuurlijk proces, dat gecontroleerd verloopt. Het wordt apoptose genoemd. Het is echter schadelijk als zo’n cel niet doodgaat, omdat deze dan ontstekingen kan veroorzaken en omliggende cellen kan beschadigen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0d348ea-e4a4-4278-9645-474e62b6a9c4",
                        "source_entry_id": "03c07c4c-458f-368a-80b1-6b4006316b64",
                        "source_sense_id": "4efd7963-9c77-3ccb-aa93-ec81045c22d5",
                        "source_sense_description": "death of cells",
                        "target_lang_word": "apoptose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apoptose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "023d7a86-4ec1-34d2-978c-9e4a4faf9b27",
                                        "entry_id": "0965d126-a0fd-3618-9750-2d7f90d4a635",
                                        "glosses": [
                                            "Mort cellulaire programmée."
                                        ],
                                        "tags": [
                                            "Biologie cellulaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2fe808b-d8eb-43e8-a822-0c8cea74b104",
                                                "sense_id": "023d7a86-4ec1-34d2-978c-9e4a4faf9b27",
                                                "text": "Dans certaines espèces, la mort de l’individu est quasi programmée, ou du moins prédéterminée (apoptose des feuilles d’un arbre)."
                                            },
                                            {
                                                "example_id": "3ad9bbbc-bf14-4b6d-a4a8-3d6518e24a52",
                                                "sense_id": "023d7a86-4ec1-34d2-978c-9e4a4faf9b27",
                                                "text": "En tout cas, c’est bien l’environnement de la cellule qui détermine sa forme, la forme même des êtres visibles et, à l’image d'une statue qui prend sa forme sous les coups de burin du sculpteur, l’embryon est sculpté par la destruction des cellules par un phénomène qui s’appelle l’apoptose, ou mort programmée des cellules."
                                            },
                                            {
                                                "example_id": "c1bc843e-bf3c-44af-a290-d65cd89c8276",
                                                "sense_id": "023d7a86-4ec1-34d2-978c-9e4a4faf9b27",
                                                "text": "La recherche d’inhibiteurs de protéines anti-apoptotiques afin de rétablir l’apoptose constitue une piste sérieuse pour le traitement de certains cancers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
