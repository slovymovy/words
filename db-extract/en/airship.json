                "senses": [
                    {
                        "sense_id": "003bec8d-d1fb-347c-a040-4ca4f709988d",
                        "entry_id": "81dec70b-d392-3907-a10c-5eb94402d85e",
                        "glosses": [
                            "Balafireke ji hewayê siviktir e ku tê birêvebirin û dikare di hewayê re ber bi pêş ve bê birin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6583dfc-31fb-46bc-8df7-0eddb7b3e45d",
                                "sense_id": "003bec8d-d1fb-347c-a040-4ca4f709988d",
                                "text": "Airships are posited to be cheaper to operate over time than fixed-wing aircraft, but as there are no large fleets, this is hard to prove in practice.",
                                "translation": "Tê pêşbînîkirin ku keştiyên hewayê bi demê re erzantir bin ji balafirên bi perên sabît, lê ji ber ku fîloyên mezin tune ne, ev di pratîkê de dijwar e ku were îsbatkirin."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddcb2a2f-33a8-3f57-b394-63cbfceff8ef",
                        "entry_id": "81dec70b-d392-3907-a10c-5eb94402d85e",
                        "glosses": [
                            "Yekeyeke polîsan ya hewayî, helîkoptera polîsan."
                        ],
                        "tags": [
