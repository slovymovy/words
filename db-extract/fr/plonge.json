                        "entry_id": "bf4ad43a-afca-3b19-9b42-ec26aeda1f07",
                        "glosses": [
                            "Première personne du singulier de l’indicatif présent du verbe plonger."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "bb845ac6-a6a7-4949-a464-6ca982b83981",
                                "sense_id": "334a5e25-ebe8-3e53-824c-b2b421e72e08",
                                "text": "Je me plonge dans Parsifal, Lohengrin et quelques nanans schumannesques pour me désenfieller l’oreille. # Troisième personne du singulier de l’indicatif présent du verbe plonger."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ec1296e-3d3d-32de-9697-dc8a95adff76",
                        "entry_id": "bf4ad43a-afca-3b19-9b42-ec26aeda1f07",
                        "glosses": [
                            "Première personne du singulier du subjonctif présent du verbe plonger."
