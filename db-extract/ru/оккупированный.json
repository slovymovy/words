                                    },
                                    {
                                        "sense_id": "f3832117-aa5e-30e9-ad22-0d01d6d9aa65",
                                        "entry_id": "812ff498-9eca-30e5-a045-806b2819f259",
                                        "glosses": [
                                            "Subjugated; under the control of a foreign (usually military) presence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c0b15a-624a-438c-a22a-2b773a45406b",
                                                "sense_id": "f3832117-aa5e-30e9-ad22-0d01d6d9aa65",
                                                "text": "My father travelled to occupied Japan in December 1945."
                                            },
                                            {
                                                "example_id": "e74c81f5-541d-4f5d-8efb-2fb0fe8fd036",
                                                "sense_id": "f3832117-aa5e-30e9-ad22-0d01d6d9aa65",
                                                "text": "As he creeps towards the main road, someone, another occupied former human, pokes their head around the corner, then calls to others in the strange language, pointing him out. Wheeler stops in his tracks. In another moment, ten or eleven non-people are advancing on him from the road. Two of them are carrying something with them, a limp, badly broken human— a normal human, Wheeler realises with some shock, like him."
                                            }
                                        ]
                                    }
