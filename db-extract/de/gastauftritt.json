                "senses": [
                    {
                        "sense_id": "4df253de-e449-392e-8934-bb9fe2684231",
                        "entry_id": "b1920deb-8a8e-3a18-ac38-ca78b6c6ccf0",
                        "glosses": [
                            "Auftreten eines Künstlers, der eingeladen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb8a850-158e-4ab3-af74-c0954bda820a",
                                "sense_id": "4df253de-e449-392e-8934-bb9fe2684231",
                                "text": "„Lady Gaga wird wahrscheinlich einen Gastauftritt bei Beyoncés \"Mrs. Carter World Tour\" haben!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37c8b0ae-cdc8-3419-8e3f-01eeba86b64d",
                        "entry_id": "b1920deb-8a8e-3a18-ac38-ca78b6c6ccf0",
                        "glosses": [
                            "Auftreten einer Person bei der Veranstaltung einer Partei, Organisation oder Ähnlichem, zu der sie nicht gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0a14299-c66d-4576-a8f2-a1fb14f0c0bf",
                                "sense_id": "37c8b0ae-cdc8-3419-8e3f-01eeba86b64d",
                                "text": "„Beim Grünen-Parteitag 2016 sorgte Resch fast für einen Eklat, weil er bei einem Gastauftritt von Daimler-Chef Dieter Zetsche auf einer Gegenrede bestand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f99e25d0-6b1a-336e-ab61-15c418344b22",
                        "entry_id": "b1920deb-8a8e-3a18-ac38-ca78b6c6ccf0",
                        "glosses": [
                            "Rolle im Fernsehen, Filmen, Büchern, die auf sehr kurze Zeit beschränkt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e75b7bc4-1c72-455a-8658-9e0702ac2e4b",
                                "sense_id": "f99e25d0-6b1a-336e-ab61-15c418344b22",
                                "text": "„Gastauftritte hatte er unter anderem in den Krimiserien ‚Inspector Barnaby‘ und ‚Inspector Lewis‘.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
