                                        "entry_id": "80342467-db98-3cec-901f-7217395528fe",
                                        "glosses": [
                                            "ausführlich, viel zu sehr ins Detail gehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a1e640e-e2ec-4233-889e-fb7b12d82088",
                                                "sense_id": "bad86fa7-44dd-3d13-a6eb-db072b8acf6e",
                                                "text": "Seine langatmigen Ausführungen langweilen alle."
                                            }
