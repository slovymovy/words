                        "target_lang_word": "push",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "push",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4cb934f-06c4-31bf-88b9-67dec7578d15",
                                        "entry_id": "8656e271-8e35-3b17-a602-fa28df75ddf0",
                                        "glosses": [
                                            "To apply a force to (an object) such that it moves away from the person or thing applying the force."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f506906f-690a-4e39-8438-0d55e1d67f02",
                                                "sense_id": "e4cb934f-06c4-31bf-88b9-67dec7578d15",
                                                "text": "In his anger he pushed me against the wall and threatened me."
                                            },
                                            {
                                                "example_id": "c44617f0-057a-48c9-b5a4-1b6cfef0da39",
                                                "sense_id": "e4cb934f-06c4-31bf-88b9-67dec7578d15",
                                                "text": "You need to push quite hard to get this door open."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a7b833-94ed-3c5a-bf66-8dacfd607fdf",
                                        "entry_id": "8656e271-8e35-3b17-a602-fa28df75ddf0",
                                        "glosses": [
                                            "To continually attempt to persuade (a person) into a particular course of action."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013f00b1-786d-4588-8c8d-211e1c4162fb",
                                                "sense_id": "b7a7b833-94ed-3c5a-bf66-8dacfd607fdf",
                                                "text": "We are pushed for an answer."
                                            },
                                            {
                                                "example_id": "9af742cf-1da5-46bf-84f0-79741a5b058c",
                                                "sense_id": "b7a7b833-94ed-3c5a-bf66-8dacfd607fdf",
                                                "text": "December 22, 1711, letter to The Spectator\nAmbition […] pushes the soul to such actions as are apt to procure honour and reputation to the actor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f90b6c16-65ae-377e-a499-d57c22f4144b",
                                        "entry_id": "8656e271-8e35-3b17-a602-fa28df75ddf0",
                                        "glosses": [
                                            "To press or urge forward; to drive."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3ce6db-13d6-4ce0-81f3-6502c94c646e",
                                                "sense_id": "f90b6c16-65ae-377e-a499-d57c22f4144b",
                                                "text": "to push an objection too far; to push one's luck"
                                            },
                                            {
                                                "example_id": "0bbd5ba3-0f4e-44f6-b569-38007965870e",
                                                "sense_id": "f90b6c16-65ae-377e-a499-d57c22f4144b",
                                                "text": "to push his fortune"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8356d089-4d00-33cc-a194-eeeef8b73b4d",
                                        "entry_id": "8656e271-8e35-3b17-a602-fa28df75ddf0",
                                        "glosses": [
                                            "To continually promote (a point of view, a product for sale, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91a02f3a-e14f-49d7-a01e-a3c2d201eb59",
                                                "sense_id": "8356d089-4d00-33cc-a194-eeeef8b73b4d",
                                                "text": "Stop pushing the issue — I'm not interested."
                                            },
                                            {
                                                "example_id": "637cdf94-24c8-4ae0-afa8-f9023e104663",
                                                "sense_id": "8356d089-4d00-33cc-a194-eeeef8b73b4d",
                                                "text": "They're pushing that perfume again."
                                            },
                                            {
                                                "example_id": "9c5c8c9a-4bd3-4a01-83a8-e3ccffdcd4b7",
                                                "sense_id": "8356d089-4d00-33cc-a194-eeeef8b73b4d",
                                                "text": "There were two men hanging around the school gates today, pushing drugs."
                                            },
                                            {
                                                "example_id": "1fd3d689-00f5-49a1-aa29-5530022e204b",
                                                "sense_id": "8356d089-4d00-33cc-a194-eeeef8b73b4d",
                                                "text": "Earlier the premier had rejected outright suggestions, apparently being pushed by up to a third of the government’s 33-member caucus, that the government forget the deficit and launch a major public initiative to stimulate the economy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a593b69-b65a-3c14-b402-a592f53057bd",
                                        "entry_id": "8656e271-8e35-3b17-a602-fa28df75ddf0",
                                        "glosses": [
                                            "To continually exert oneself in order to achieve a goal."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91b273a5-31ff-47b1-a249-8a265e14964c",
                                                "sense_id": "4a593b69-b65a-3c14-b402-a592f53057bd",
                                                "text": "Don't think that if you keep pushing harder and harder, it will make you succeed faster or earn more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd882b5-8f14-3f66-aadd-eb28f12f812a",
                                        "entry_id": "8656e271-8e35-3b17-a602-fa28df75ddf0",
                                        "glosses": [
                                            "To approach; to come close to."
                                        ],
                                        "tags": [
                                            "informal",
                                            "participle",
                                            "present",
                                            "regional",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7c98f0e-d894-4773-9dd6-54950e8fb961",
                                                "sense_id": "5dd882b5-8f14-3f66-aadd-eb28f12f812a",
                                                "text": "My old car is pushing 250,000 miles."
                                            },
                                            {
                                                "example_id": "83c2cd6b-02c8-47d2-9fd4-2ddb464b9411",
                                                "sense_id": "5dd882b5-8f14-3f66-aadd-eb28f12f812a",
                                                "text": "He's pushing sixty.",
                                                "translation": "He's nearly sixty years old.",
                                                "english": "He's nearly sixty years old."
                                            },
                                            {
                                                "example_id": "861ab883-51e1-44a2-9a96-69f7ecf15090",
                                                "sense_id": "5dd882b5-8f14-3f66-aadd-eb28f12f812a",
                                                "text": "Don't be mad at me 'cause you're pushing thirty / And your old tricks no longer work"
                                            },
                                            {
                                                "example_id": "d3fd6264-e1ae-4f0d-ad63-fbbda3a0d2dc",
                                                "sense_id": "5dd882b5-8f14-3f66-aadd-eb28f12f812a",
                                                "text": "“I'm pushing 40 and on TikTok,” he says. “I feel old every day.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6b81ffb-5a08-3b93-9836-d63210593fc3",
                                        "entry_id": "8656e271-8e35-3b17-a602-fa28df75ddf0",
                                        "glosses": [
                                            "To tense the muscles in the abdomen in order to give birth or defecate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bab204-57f3-4dbf-926b-82847b57ec49",
                                                "sense_id": "f6b81ffb-5a08-3b93-9836-d63210593fc3",
                                                "text": "During childbirth, there are times when the obstetrician advises the woman not to push."
                                            }
                                        ]
