                "senses": [
                    {
                        "sense_id": "82df3d0d-993b-3228-815a-5f63a0f95649",
                        "entry_id": "a5b8f4b0-6ebd-3293-8787-f29e4059769c",
                        "glosses": [
                            "leeres Gerede, Nichtssagendes"
