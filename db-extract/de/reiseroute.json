                ],
                "senses": [
                    {
                        "sense_id": "e34acb24-1327-3ad6-a9c1-64f4ca59aace",
                        "entry_id": "aeff8d29-bdb1-3198-be3b-bb2ee86774e7",
                        "glosses": [
                            "Gesamtheit der Wegstrecken einer Reise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46de0b09-2258-40f4-a967-2ae23679463b",
                                "sense_id": "e34acb24-1327-3ad6-a9c1-64f4ca59aace",
                                "text": "„Man braucht keine Kursbücher, Atlanten und Baedeker zu wälzen und eine Reiseroute auszutüfteln, die nachher doch nicht stimmt oder enttäuscht;…“"
                            },
                            {
                                "example_id": "8f1ea1a3-9e06-44db-9827-d79e8ead1b11",
                                "sense_id": "e34acb24-1327-3ad6-a9c1-64f4ca59aace",
                                "text": "„Manch einer hatte vorgeschlagen, unsere Reiserouten zusammenzulegen, sowohl zur Zerstreuung als auch zur Sicherheit.“"
                            },
                            {
                                "example_id": "558fc766-5c3d-48b8-b5be-5c7886ecedfc",
                                "sense_id": "e34acb24-1327-3ad6-a9c1-64f4ca59aace",
                                "text": "„Heines Reiseroute läßt sich nachvollziehen.“"
                            },
                            {
                                "example_id": "137f74af-241c-4a63-9bd1-e2c27c8ad986",
                                "sense_id": "e34acb24-1327-3ad6-a9c1-64f4ca59aace",
                                "text": "„Als meine Abreise vor einigen Monaten unaufhaltsam näher gerückt war, hatte ich dann doch einige Überlegungen zur Reiseroute angestellt.“"
                            },
                            {
                                "example_id": "8190aa6f-fef2-4d9d-9233-f20661896791",
                                "sense_id": "e34acb24-1327-3ad6-a9c1-64f4ca59aace",
                                "text": "„Die Stadt lag an den Reiserouten der Jesuiten zu ihren Missionsgebieten in den Anden und an den Quellflüssen des Amazonas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
