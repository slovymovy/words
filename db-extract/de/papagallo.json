                "senses": [
                    {
                        "sense_id": "db5d336c-be32-37ab-b9a7-c97633a07e20",
                        "entry_id": "8922169d-7559-34de-867b-b48e7a4c6cf3",
                        "glosses": [
                            "Südländer (insbesondere Italiener), der ständig Frauen umwirbt und auf sexuelle Abenteuer aus ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7f46cb1-1ae4-4bea-a9f4-84d1de4a7518",
                                "sense_id": "db5d336c-be32-37ab-b9a7-c97633a07e20",
                                "text": "„Er hat die kurze Hose noch aufgekrempelt, so dass sie kürzer als kurz ist, Baros sieht aus wie ein italienischer Papagallo, der prüfend den Strand abschreitet.“"
                            },
                            {
                                "example_id": "f5c9fb66-b0ed-4db4-bdea-23a768d95456",
                                "sense_id": "db5d336c-be32-37ab-b9a7-c97633a07e20",
                                "text": "„Beide sind in die Jahre gekommene, mit etwas zu viel Goldketten behängte, das Hemd zu weit offen tragende Papagalli."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
