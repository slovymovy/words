                "senses": [
                    {
                        "sense_id": "500c2b36-ba8b-34c9-ac12-49ab590a76a4",
                        "entry_id": "d6245f60-6b2c-369a-8e34-5c53cbd139df",
                        "glosses": [
                            "Wörterbuch, Nachschlagewerk für die Sachbegriffe einer Wissenschaft. Im Vordergrund stehen nicht wie bei Sprachwörterbüchern die sprachlichen, sondern stattdessen die sachlichen/ fachlichen Informationen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e80afe9-c76c-4232-ad25-611c402178b3",
                                "sense_id": "500c2b36-ba8b-34c9-ac12-49ab590a76a4",
                                "text": "Das \"Sachwörterbuch der Literatur\" von Gero von Wilpert (Kröner, Stuttgart, viele Auflagen) enthält viele Fachbegriffe der Literaturwissenschaft."
                            },
                            {
                                "example_id": "a0ba67a9-3e88-4f0a-88b7-4e97d495a57a",
                                "sense_id": "500c2b36-ba8b-34c9-ac12-49ab590a76a4",
                                "text": "„Bei Wörtern wie Idiot, Engel oder tierisch wird uns ein Sachwörterbuch die interessantesten Aspekte des Wortgebrauchs, die man bildungssprachlich Konnotationen nennt, verschweigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
