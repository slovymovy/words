                },
                {
                    "sense_id": "2e34bee9-e4c7-3f3a-b6ad-8396fe44eab3",
                    "sense_definition": "Qui exprime ou dénote la fatigue extrême ou la tristesse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son visage <w>abattu</w> montrait clairement qu'il n'avait pas dormi depuis deux nuits.",
                            "target_lang_translations": {
                                "en": "His <w>haggard</w> face clearly showed that he had not slept for two nights.",
                                "ru": "Его <w>осунувшееся</w> лицо ясно показывало, что он не спал уже две ночи.",
                                "de": "Sein <w>übernächtigtes</w> Gesicht zeigte deutlich, dass er seit zwei Nächten nicht geschlafen hatte.",
                                "es": "Su rostro <w>ojeroso</w> dejaba claro que no había dormido en dos noches.",
                                "zh": "他那张<w>憔悴</w>的脸清楚地表明，他已经两个晚上没有睡觉了。"
                            }
                        },
                        {
                            "text": "Elle affichait une mine <w>abattue</w> en rentrant de sa difficile journée.",
                            "target_lang_translations": {
                                "en": "She had a <w>drawn</w> expression when she came home from her difficult day.",
                                "ru": "Возвращаясь домой после тяжёлого дня, она выглядела <w>унылой</w>.",
                                "de": "Als sie von ihrem schwierigen Tag heimkam, zeigte sie eine <w>müde</w> Miene.",
                                "es": "Al volver de su difícil jornada, mostraba un semblante <w>mustio</w>.",
                                "zh": "结束了艰难的一天回到家时，她的神情显得很<w>疲倦</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fatigué"
                    ],
                    "antonyms": [
                        "vif"
                    ],
                    "common_phrases": [
                        "mine abattue",
                        "regard abattu",
                        "visage abattu"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing extreme tiredness or sadness, especially in the face or expression.",
                        "ru": "Выражающий крайнюю усталость или печаль, особенно на лице.",
                        "de": "Mit einem Gesicht oder Ausdruck, der extreme Müdigkeit oder Traurigkeit zeigt.",
                        "es": "Que muestra un cansancio extremo o tristeza, sobre todo en el rostro o la expresión.",
                        "zh": "形容面容或神情显得极度疲惫或悲伤。"
                    },
