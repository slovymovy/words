                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "263fb643-631f-47a6-9941-ded7dd0b00fe",
                                "sense_id": "2e0eb4e4-6bb6-3745-b5f4-0a50ce813cef",
                                "text": "„Feldkurat Otto Katz, der vollendetste Kriegspriester, war Jude.“"
                            },
                            {
                                "example_id": "199df399-2625-4f9e-8cb0-69d787e7b889",
                                "sense_id": "2e0eb4e4-6bb6-3745-b5f4-0a50ce813cef",
                                "text": "„Zur Ehre des Herrn Feldkuraten sei gesagt, dass er nicht in die Kaserne telefoniert hatte, da er gar kein Telefon besaß, sondern in die Stehlampe gesprochen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
