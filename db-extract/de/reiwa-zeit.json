                        "sense_id": "6704e93d-6f12-38a4-87dc-c076be22fc6a",
                        "entry_id": "dbce7c7e-156a-3b55-9c71-5409f0317b81",
                        "glosses": [
                            "in der japanischen Zeitrechnung Zeitraum seit dem 1. Mai 2019, der die Heisei-Zeit vorausgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17272397-a22e-4d8f-800b-1d3463be8436",
                                "sense_id": "6704e93d-6f12-38a4-87dc-c076be22fc6a",
                                "text": "„Mindestens ebenso wichtig wie das neue Kaiserpaar ist für viele Japaner der Übergang ins neue Reiwa-Zeitalter.“"
                            },
                            {
                                "example_id": "a1f837c1-fa97-43b7-9dfd-1824c741d270",
                                "sense_id": "6704e93d-6f12-38a4-87dc-c076be22fc6a",
                                "text": "„Aber mindestens ebenso wichtig wie das neue Kaiserpaar ist für viele Japaner der Übergang ins neue Reiwa-Zeitalter.“"
                            },
                            {
                                "example_id": "e783c0c5-8903-4c9a-9af6-043b8953f087",
                                "sense_id": "6704e93d-6f12-38a4-87dc-c076be22fc6a",
                                "text": "„Dann endet die Heisei-Zeit (etwa ‚Frieden überall‘), die Regentschaft Akihitos, und es beginnt das Reiwa-Zeitalter (‚schöne Harmonie‘).“"
                            }
                        ],
