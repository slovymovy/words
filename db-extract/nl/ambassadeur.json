                                        "entry_id": "c0712b08-5a49-3e20-a927-4a7f594cf325",
                                        "glosses": [
                                            "Représentant envoyé en ambassade par un État ou par un prince à un autre État ou un autre prince pour des arrangements politiques et économiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c239ffe4-d597-4bb9-b8df-44e33ae4bd3b",
                                                "sense_id": "010cb610-49b3-3308-9cd6-f6a4ed344cf2",
                                                "text": "En vain l’ambassadeur de France tenta de fléchir les négociateurs américains. Ils se montrèrent implacables. Il fallait se soumettre ou faire banqueroute."
                                            },
                                            {
                                                "example_id": "2407ccba-1992-4553-aa60-969600dbb67b",
                                                "sense_id": "010cb610-49b3-3308-9cd6-f6a4ed344cf2",
                                                "text": "L’ambassadeur tient le rang le plus élevé dans la représentation diplomatique des états."
                                            },
                                            {
                                                "example_id": "b0649e78-0ccb-417e-95f3-ecebdc20d967",
                                                "sense_id": "010cb610-49b3-3308-9cd6-f6a4ed344cf2",
                                                "text": "Madame l’ambassadrice, Madame l’ambassadeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "308f00b3-82d5-3af2-b7fa-bc800a5589a4",
                                        "entry_id": "c0712b08-5a49-3e20-a927-4a7f594cf325",
                                        "glosses": [
                                            "Personne qui fait partie d’une mission auprès d’un État étranger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b41ddde6-4b33-457e-879a-becd9f355ca1",
                                                "sense_id": "308f00b3-82d5-3af2-b7fa-bc800a5589a4",
                                                "text": "Les ambassadeurs que les Scythes envoyèrent à Darius."
                                            },
                                            {
                                                "example_id": "c5aeddbd-c506-4785-9b48-e254458caf63",
                                                "sense_id": "308f00b3-82d5-3af2-b7fa-bc800a5589a4",
                                                "text": "Les ambassadeurs revinrent sans avoir rien pu obtenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e52a07b-8580-3143-bbdf-9ea4e93ef7a2",
                                        "entry_id": "c0712b08-5a49-3e20-a927-4a7f594cf325",
                                        "glosses": [
                                            "Messager, personne que l’on emploie à transmettre quelque message."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc8120da-4955-4398-ad01-ddca1c66cf44",
                                                "sense_id": "9e52a07b-8580-3143-bbdf-9ea4e93ef7a2",
                                                "text": "Vous ne pouviez envoyer un plus habile ambassadeur."
                                            },
                                            {
                                                "example_id": "22d8c47d-b96f-4516-9f01-081a9a21a29c",
                                                "sense_id": "9e52a07b-8580-3143-bbdf-9ea4e93ef7a2",
                                                "text": "Il embrassa avec emportement la bienheureuse ambassadrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef69330f-2490-3a48-8a39-f2f1f9ea86ba",
                                        "entry_id": "c0712b08-5a49-3e20-a927-4a7f594cf325",
