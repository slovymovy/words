                        "translation_id": "f30c2ca9-e497-4ab0-bb03-f5059e162b4d",
                        "source_entry_id": "d582151d-4760-301b-b92b-f44bba1c83d6",
                        "source_sense_id": "0bc0a185-bf53-35f4-a4b1-02cc22b13337",
                        "target_lang_word": "menshevism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menshevism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "527bb771-43ba-3d7d-9746-d986c08d3a04",
                                        "entry_id": "c0876a84-75ea-3847-a252-c6ff569b329c",
                                        "glosses": [
                                            "Alternative letter-case form of Menshevism."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24702df3-055d-474f-a697-6399b7b9ede7",
                                                "sense_id": "527bb771-43ba-3d7d-9746-d986c08d3a04",
                                                "text": "The subdivisions of socialism (populism, menshevism, bolshevism) are of course very well known: there is an enormous and valuable literature, both in the Soviet Union and the West."
                                            },
                                            {
                                                "example_id": "8eb88a59-61c7-42d6-84b1-e5c63a3d6e90",
                                                "sense_id": "527bb771-43ba-3d7d-9746-d986c08d3a04",
                                                "text": "While unknown men of the masses inside Russia were leading strike waves, peasant insurrections, mutinies in the armed forces, in closest cooperation between adherents of menshevism, bolshevism and the Social Revolutionary Party, the leaders in exile continued their battle of factions."
                                            },
                                            {
                                                "example_id": "29b0b84c-8f93-41e2-99db-cc85d0a990df",
                                                "sense_id": "527bb771-43ba-3d7d-9746-d986c08d3a04",
                                                "text": "Little was known about that curious outfit, which had been devised by Lenin to keep control of a small bolshevik conspiratorial group in the Caucasian fortress of menshevism."
                                            }
                                        ]
                                    }
                                ]
                            }
