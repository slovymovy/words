                        "entry_id": "003bb275-8222-36c8-8e43-1ee33706bbde",
                        "glosses": [
                            "Showing contempt or scorn; having a pronounced lack of concern for others viewed as unworthy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e6fcf04-7342-42d1-a9e1-93f211daf6cc",
                                "sense_id": "60549e5c-a47c-3458-95aa-a1d78173d704",
                                "text": "He was disdainful of those he thought of as the little people. He openly sneered at them. They mocked him behind his back."
                            },
                            {
                                "example_id": "1e10a6ff-8b7e-4f70-87a4-243df1c7d3c7",
                                "sense_id": "60549e5c-a47c-3458-95aa-a1d78173d704",
                                "text": "She glimpsed at the people whom she had left behind, and smirked in the most disdainful manner towards them."
                            }
                        ]
                    }
                ],
