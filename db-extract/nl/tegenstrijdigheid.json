                "senses": [
                    {
                        "sense_id": "80de25c9-44a3-344b-a30b-6420ef976206",
                        "entry_id": "7d6780bd-86e5-366e-8a52-b3ea5d5b1d5c",
                        "glosses": [
                            "iets tegenstrijdigs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05be1820-9bec-48aa-bfa2-07bae03b449b",
                                "sense_id": "80de25c9-44a3-344b-a30b-6420ef976206",
                                "text": "Ze zat vol tegenstrijdigheden, was ontwapenend lief maar kon ook onverwacht fel uit de hoek komen zodra iemand te dichtbij kwam of te veel van haar verwachtte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d95753d7-2fb8-4eb5-b057-166c55da1f17",
                        "source_entry_id": "7d6780bd-86e5-366e-8a52-b3ea5d5b1d5c",
                        "source_sense_id": "80de25c9-44a3-344b-a30b-6420ef976206",
                        "source_sense_description": "iets tegenstrijdigs",
                        "target_lang_word": "Widerspruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widerspruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fe5a396-bd0f-3593-b7b9-b5d23f4d5a3c",
                                        "entry_id": "d6b53ad5-5e18-32ca-bae5-16e4aa5e85aa",
                                        "glosses": [
                                            "logische Unvereinbarkeit mehrerer gegensätzlicher Informationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "145b87c4-3f9c-499a-b163-cf560c9ea70f",
                                                "sense_id": "3fe5a396-bd0f-3593-b7b9-b5d23f4d5a3c",
                                                "text": "Der Artikel hat im dritten Absatz einen Widerspruch."
                                            },
                                            {
                                                "example_id": "e9bc31af-432c-40cf-a3b4-23f522fdf1ac",
                                                "sense_id": "3fe5a396-bd0f-3593-b7b9-b5d23f4d5a3c",
                                                "text": "Ein dreistimmiges Quintett scheint freilich wohl ein Widerspruch in sich."
                                            },
                                            {
                                                "example_id": "cf9c7c0c-aba0-444a-a410-0f0bc0c1d646",
                                                "sense_id": "3fe5a396-bd0f-3593-b7b9-b5d23f4d5a3c",
                                                "text": "Die Angeklagte verwickelte sich bei der zweiten Befragung in Widersprüche."
                                            },
                                            {
                                                "example_id": "27503291-4e02-4273-a464-992d5fad1c54",
                                                "sense_id": "3fe5a396-bd0f-3593-b7b9-b5d23f4d5a3c",
                                                "text": "„Die Widersprüche innerhalb der Regierung bleiben nicht verborgen.“"
                                            },
                                            {
                                                "example_id": "04a9bfa0-412a-4ca2-b8e2-75e736753680",
                                                "sense_id": "3fe5a396-bd0f-3593-b7b9-b5d23f4d5a3c",
                                                "text": "„Dieser Widerspruch rührt daher, dass die Kriegswissenschaft die Kampfkraft einer Partei für identisch mit ihrer zahlenmässigen Stärke hält.“"
                                            },
                                            {
                                                "example_id": "909b965e-ae54-4e7b-a3bd-4c8ac3939e18",
                                                "sense_id": "3fe5a396-bd0f-3593-b7b9-b5d23f4d5a3c",
                                                "text": "„Denn er sah keinen Widerspruch zwischen diesen beiden Religionen, die sich so ähnlich seien in ihrem klaren Monotheismus, ohne Erweiterung um einen Gottessohn, auch ohne die Macht der Kirche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c678e74-02bf-3c1f-8e74-d57047b8580f",
                                        "entry_id": "d6b53ad5-5e18-32ca-bae5-16e4aa5e85aa",
                                        "glosses": [
                                            "Äußerung einer gegensätzlichen Meinung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2017b83d-3c2b-4f08-941a-f686ad6cd882",
                                                "sense_id": "7c678e74-02bf-3c1f-8e74-d57047b8580f",
                                                "text": "Mein Vater duldet keinen Widerspruch."
                                            },
                                            {
                                                "example_id": "8858e950-a892-4595-a8dc-1481d0fbca53",
                                                "sense_id": "7c678e74-02bf-3c1f-8e74-d57047b8580f",
                                                "text": "Wenn du den Vorschlag wirklich machst, musst du dich auf harten Widerspruch gefasst machen."
                                            },
                                            {
                                                "example_id": "4778002c-c83e-4ed9-b513-dd0daf0115e9",
                                                "sense_id": "7c678e74-02bf-3c1f-8e74-d57047b8580f",
                                                "text": "„Es muß nicht immer Lessing sein. Obwohl natürlich, wie Sie schon gelesen haben (…), eine Berufung auf die klangvollen Namen unserer Geistesgeschichte sich in hervorragender Weise dazu eignet, jeden Widerspruch oder auch nur den Anflug eines Zweifels von vornherein zu unterbinden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8838cf27-e466-361e-96dc-b0d9aabd6a12",
                                        "entry_id": "d6b53ad5-5e18-32ca-bae5-16e4aa5e85aa",
                                        "glosses": [
                                            "Einspruch, [offizielle] Beschwerde, im in vielen Bundesländern vorgesehener Rechtsbehelf, mit dem der durch einen Verwaltungsakt Beschwerte die Überprüfung der Recht- und Zweckmäßigkeit des Verwaltungsakts durch die Ausgangsbehörde und gegebenenfalls durch die Widerspruchsbehörde überprüfen lässt"
                                        ],
                                        "tags": [
                                            "deutschen Verwaltungsrecht so definiert"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7459001-6327-41cc-8433-0cc81e8bf9fe",
                                                "sense_id": "8838cf27-e466-361e-96dc-b0d9aabd6a12",
                                                "text": "Gegen diesen Bescheid können die Betroffenen Widerspruch einlegen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec97cb13-362c-45ac-8c4d-533c04b73045",
                        "source_entry_id": "7d6780bd-86e5-366e-8a52-b3ea5d5b1d5c",
                        "source_sense_id": "80de25c9-44a3-344b-a30b-6420ef976206",
                        "source_sense_description": "iets tegenstrijdigs",
                        "target_lang_word": "contradiction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contradiction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34abfc46-558f-3641-befc-1847ef00d4b3",
                                        "entry_id": "4d944233-6cae-3933-a904-8113b089cdb6",
                                        "glosses": [
                                            "The act of contradicting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4b298af-8fa7-4ca9-8ff4-00c2b05fbdaf",
                                                "sense_id": "34abfc46-558f-3641-befc-1847ef00d4b3",
                                                "text": "His contradiction of the proposal was very interesting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b32e89b-f168-3622-a4d8-e5bb396917d2",
                                        "entry_id": "4d944233-6cae-3933-a904-8113b089cdb6",
                                        "glosses": [
                                            "A statement that contradicts itself, i.e., a statement that claims that the same thing is true and that it is false at the same time and in the same senses of the terms."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70faaf4b-d597-4e44-b13a-634d0b058895",
                                                "sense_id": "3b32e89b-f168-3622-a4d8-e5bb396917d2",
                                                "text": "There is a contradiction in Clarence Page's statement that a woman should have the right to choose and decide for herself whether to have an abortion and at the same time she should not have that right."
                                            },
                                            {
                                                "example_id": "4a55e7a6-a594-48a3-81ca-d7fbe9104072",
                                                "sense_id": "3b32e89b-f168-3622-a4d8-e5bb396917d2",
                                                "text": "There is a contradiction in what you say: she can't be both married and single."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f58a3754-16dd-31c2-8cd2-5cc699f46a88",
                                        "entry_id": "4d944233-6cae-3933-a904-8113b089cdb6",
                                        "glosses": [
                                            "A logical inconsistency among two or more elements or propositions."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f36b779-98bd-461d-bdd4-15518efec8b9",
                                                "sense_id": "f58a3754-16dd-31c2-8cd2-5cc699f46a88",
                                                "text": "Marx believed that the contradictions of capitalism would lead to socialism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ee86b40-f424-3f6f-8f9a-e1bd02055dc3",
                                        "entry_id": "4d944233-6cae-3933-a904-8113b089cdb6",
                                        "glosses": [
                                            "A proposition that is false for all values of its propositional variables or Boolean atoms."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "812b8e5e-2437-45fa-9e95-3fae6e88b0aa",
                        "source_entry_id": "7d6780bd-86e5-366e-8a52-b3ea5d5b1d5c",
                        "source_sense_id": "80de25c9-44a3-344b-a30b-6420ef976206",
                        "source_sense_description": "iets tegenstrijdigs",
                        "target_lang_word": "contradiction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contradiction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08990887-acf9-3b75-a9a7-a290d539cd12",
                                        "entry_id": "6c277625-adfc-319f-b8c8-faa500361b59",
                                        "glosses": [
                                            "Action de contredire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb51083-292b-4585-a573-6eb455f3fb03",
                                                "sense_id": "08990887-acf9-3b75-a9a7-a290d539cd12",
                                                "text": "Il a l’esprit de contradiction."
                                            },
                                            {
                                                "example_id": "661894c0-d2e6-40fb-a182-bda844c6e6e1",
                                                "sense_id": "08990887-acf9-3b75-a9a7-a290d539cd12",
                                                "text": "Il se rend insupportable par son esprit de contradiction."
                                            },
                                            {
                                                "example_id": "53417c64-65ae-4ede-b322-08e2d6db1279",
                                                "sense_id": "08990887-acf9-3b75-a9a7-a290d539cd12",
                                                "text": "La contradiction doit éveiller l'attention, et non pas la colère. Il faut écouter, et non fuir celuy qui contredit. Nostre cause doit toûjours être celle de la vérité, de quelque façon qu'elle nous soit montrée."
                                            },
                                            {
                                                "example_id": "989982ec-e8e8-4e53-be28-312a58d91942",
                                                "sense_id": "08990887-acf9-3b75-a9a7-a290d539cd12",
                                                "text": "Mon cousin finit par expliquer d’un ton conciliant qu’à mon âge on avait l’esprit de contradiction et mon supplice prit fin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77d24e75-5837-331d-9ae0-5bbdb49c496b",
                                        "entry_id": "6c277625-adfc-319f-b8c8-faa500361b59",
                                        "glosses": [
                                            "Opposition vive à quelqu’un, à quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33488dec-b947-4d96-b724-6581c7b5e6ef",
                                                "sense_id": "77d24e75-5837-331d-9ae0-5bbdb49c496b",
                                                "text": "Cette proposition a été acceptée sans contradiction."
                                            },
                                            {
                                                "example_id": "57d572cc-1c1d-4345-aed6-43b69be71c99",
                                                "sense_id": "77d24e75-5837-331d-9ae0-5bbdb49c496b",
                                                "text": "Les contradictions ne l’ont point rebuté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc9bd98-db92-39ae-a755-4fc0b7c9b850",
                                        "entry_id": "6c277625-adfc-319f-b8c8-faa500361b59",
                                        "glosses": [
                                            "Opposition, incompatibilité entre deux ou plusieurs choses, ou entre les éléments d’une même chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dbcc7ea-19f2-4908-b434-969644cf02bc",
                                                "sense_id": "cbc9bd98-db92-39ae-a755-4fc0b7c9b850",
                                                "text": "Dans un livre divin, en effet, tout est vrai, et, deux contradictoires ne pouvant être vraies à la fois, il ne doit s’y trouver aucune contradiction."
                                            },
                                            {
                                                "example_id": "796c4446-90a5-487d-ae76-b76525392461",
                                                "sense_id": "cbc9bd98-db92-39ae-a755-4fc0b7c9b850",
                                                "text": "[Dans cet ouvrage], je pourrai donc parler sans ordre et sans suite, tomber même dans beaucoup de contradictions. La nature humaine n'est qu'un tissu d'inconséquences, et je ne crois point du tout (mais du tout !) à ceux qui prétendent s'être trouvés d'accord avec le moi de la veille."
                                            },
                                            {
                                                "example_id": "2640536a-4919-4ce3-8429-d3e7239debdd",
                                                "sense_id": "cbc9bd98-db92-39ae-a755-4fc0b7c9b850",
                                                "text": "Cette norme européenne devra recevoir le statut de norme nationale soit par publication d’un texte identique, soit par entérinement au plus tard en décembre 1999, et toutes les normes nationales en contradiction devront être retirées au plus tard en décembre 1999."
                                            },
                                            {
                                                "example_id": "24fdb2a6-4564-42d7-b4c3-14653343fb16",
                                                "sense_id": "cbc9bd98-db92-39ae-a755-4fc0b7c9b850",
                                                "text": "Il est intéressant de noter au bénéfice de nos modernes souverainistes que des romantiques comme Mazzini, Michelet, Lamartine ou Hugo ne voyaient aucune contradiction entre nationalité et européanité."
                                            },
                                            {
                                                "example_id": "5fd44887-aeca-45a9-a098-6e0dbdcdeb06",
                                                "sense_id": "cbc9bd98-db92-39ae-a755-4fc0b7c9b850",
                                                "text": "Le statut d’entrepreneur individuel spécialisé dans la chnouf semble en contradiction avec une vocation de pédagogue se destinant à enseigner les valeurs du sport. À moins de se spécialiser dans le cyclisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bebe675-dddf-3480-9701-132a1af9c67c",
                                        "entry_id": "6c277625-adfc-319f-b8c8-faa500361b59",
                                        "glosses": [
                                            "Connecteur logique, relation existant entre deux ou plusieurs termes ou deux ou plusieurs propositions dont l’un(e) affirme ce que l’autre nie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
