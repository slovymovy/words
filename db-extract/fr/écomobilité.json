                    {
                        "sense_id": "f2219ef7-6661-3ff2-b4db-0bae75011b79",
                        "entry_id": "bfbcc2c7-f950-3263-bf49-2863373b0902",
                        "glosses": [
                            "Ensemble de structures et de moyens de transport ayant un moindre impact en termes de pollution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05349f36-0725-447a-b37c-69293727ac05",
                                "sense_id": "f2219ef7-6661-3ff2-b4db-0bae75011b79",
                                "text": "Le potentiel d’écomobilité est simplement évalué à partir des distances de déplacement, des pourcentages de chaque mode de transport utilisé (voiture, transport en commun, modes doux…) et de la consommation d’énergie liée à chaque mode."
                            },
                            {
                                "example_id": "ddd905ac-b768-48ee-9cbb-6900050a284c",
                                "sense_id": "f2219ef7-6661-3ff2-b4db-0bae75011b79",
                                "text": "Pour sa 2ème édition, le challenge de l’écomobilité scolaire, créé en Nord Pas de Calais, porté par Centre Ressource en Ecomobilité, soutenu par l’ADEME et la région, s’est ouvert à l’ensemble des Hauts de France."
                            }
                        ]
                    }
