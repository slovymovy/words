                    "frequency": "Middle",
                    "semantic_group_id": "cities",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The ancient city of <w>Tyre</w> was famous throughout the Mediterranean for its production of purple dye.",
                            "target_lang_translations": {
                                "ru": "Древний город <w>Тир</w> был знаменит во всем Средиземноморье производством пурпурной краски."
                            }
