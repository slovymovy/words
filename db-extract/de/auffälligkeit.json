                "senses": [
                    {
                        "sense_id": "5d660254-4986-3f5c-adef-bcd1d9832432",
                        "entry_id": "10fb27ab-70e1-3490-82e7-22f0476511ce",
                        "glosses": [
                            "etwas, das sich durch seine Eigenschaften von anderem abhebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99fd34f6-af84-488e-adb6-6db89e1d7d7f",
                                "sense_id": "5d660254-4986-3f5c-adef-bcd1d9832432",
                                "text": "Die Forscher konnten in ihren Messergebnissen keine Auffälligkeiten feststellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "541c6c03-4dbf-3135-8bdc-0e9fd3b25d52",
                        "entry_id": "10fb27ab-70e1-3490-82e7-22f0476511ce",
                        "glosses": [
                            "die Eigenschaft, auffällig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4558cc6-a07c-49e8-a6e6-34fe34e42296",
                                "sense_id": "541c6c03-4dbf-3135-8bdc-0e9fd3b25d52",
                                "text": "Auf der Flucht sollte man Auffälligkeit vermeiden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ca46dae-181f-4a45-a091-83a14cb5dd50",
                        "source_entry_id": "10fb27ab-70e1-3490-82e7-22f0476511ce",
                        "source_sense_id": "5d660254-4986-3f5c-adef-bcd1d9832432",
                        "source_sense_description": "etwas, das sich durch seine Eigenschaften von anderem abhebt",
                        "target_lang_word": "abnormality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnormality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa83e66e-b633-369b-953b-28b56fd3ba04",
                                        "entry_id": "dd8cb471-944d-3d40-8259-e3f163eb8c4f",
                                        "glosses": [
                                            "The state or quality of being abnormal; variation; irregularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c8c773d-1a68-45cd-b85e-6fcb1f2336de",
                                                "sense_id": "aa83e66e-b633-369b-953b-28b56fd3ba04",
                                                "text": "Taylor said that her fame makes her \"sometimes\" miss the normality of being able to hang out with friends but that she's had to get used to \"the abnormality of my life\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                        "entry_id": "dd8cb471-944d-3d40-8259-e3f163eb8c4f",
                                        "glosses": [
                                            "Something abnormal; an aberration; an abnormal occurrence or feature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1105f1de-6ba5-46b3-a72a-ad1184d2815a",
                                                "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                                "text": "I want a full genetic analysis. We're going to examine any abnormality we find no matter how insignificant it seems."
                                            },
                                            {
                                                "example_id": "7284ac2f-3efa-4a79-bc17-2dbf7c46a283",
                                                "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                                "text": "The factors that filter out who “gets through” from conception to birth include chromosomal or genetic abnormalities of the fetus or the mother’s stress response to changes in her environment, Catalano said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "079b6f5e-59ed-4e99-8463-5d52f3b1f8fb",
                        "source_entry_id": "10fb27ab-70e1-3490-82e7-22f0476511ce",
                        "source_sense_id": "5d660254-4986-3f5c-adef-bcd1d9832432",
                        "source_sense_description": "etwas, das sich durch seine Eigenschaften von anderem abhebt",
                        "target_lang_word": "singularité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "singularité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63dcd13a-09d8-39e6-a842-a0f7ff32f967",
                                        "entry_id": "6ed22cbe-b513-38de-a723-1a9ce06a5356",
                                        "glosses": [
                                            "Caractère singulier ; ce qui rend une chose ou une personne singulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dab34c84-b242-485c-a5cf-0ffbc9ab3073",
                                                "sense_id": "63dcd13a-09d8-39e6-a842-a0f7ff32f967",
                                                "text": "Plus j'ai réfléchi à une singularité si frappante dans l'histoire de l'espèce humaine, & plus je me suis convaincu que les misogynes & les misanthropes de l'Attique étoient réellement atteints d'une maladie qui avoit beaucoup de rapport avec celle qu'on nommoit la Nympholepsie."
                                            },
                                            {
                                                "example_id": "346f2d31-ee1f-4cd5-828d-108f98ef66f7",
                                                "sense_id": "63dcd13a-09d8-39e6-a842-a0f7ff32f967",
                                                "text": "Une figure l'étonna par sa singularité : c'était celle d'un homme de moyen âge, qui avait les cheveux courts et sans poudre, une paire de moustaches relevées en barbe de chat, et une épée dont la longueur était peu ordinaire en France."
                                            },
                                            {
                                                "example_id": "3cfad29d-747b-4746-a2ba-cb93c9f27184",
                                                "sense_id": "63dcd13a-09d8-39e6-a842-a0f7ff32f967",
                                                "text": "On eût voulu que madame de Chasteller portât des diamants ; la robe modeste et peu chère qu’elle avait choisie était un acte de singularité qui fut blâmé avec affectation de douleur profonde par M. de Pontlevé, et désapprouvé, en secret, même par le timide M. de Blancet, qui lui donnait le bras avec une dignité plaisante."
                                            },
                                            {
                                                "example_id": "7f662f82-9ce5-4093-8e9f-1e971ca18b33",
                                                "sense_id": "63dcd13a-09d8-39e6-a842-a0f7ff32f967",
                                                "text": "Si le Coq de Java diffère des autres Coqs par sa crête et par son fanon sous-mandibulaire, le Coq de Sonnerat ne s'en écarte pas moins par une singularité très curieuse des plumes de son camail."
                                            },
                                            {
                                                "example_id": "2786b787-2011-4ba4-bace-5cbd8f3b3f36",
                                                "sense_id": "63dcd13a-09d8-39e6-a842-a0f7ff32f967",
                                                "text": "Avec une merveilleuse netteté, il voyait en lui, à l’exception du sens de l’argent dont il n’avait pas besoin, toute les capacités et toutes les qualités en faveur à son époque, mais la possibilité de les appliquer lui avait échappé ; et puisque en fin de compte, si les footballeurs et les chevaux eux-mêmes ont du génie, seul l’usage qu’on en fait peut encore vous permettre de sauver votre singularité, il résolut de prendre congé de sa vie pendant un an pour chercher le bon usage de ses capacités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e964fb9-ce81-349a-b209-2f13af79e361",
                                        "entry_id": "6ed22cbe-b513-38de-a723-1a9ce06a5356",
                                        "glosses": [
                                            "Manière d’agir, de penser, de parler, etc., hors de l’ordinaire, différente de celle de tous les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d744afae-955f-44bf-9e5d-2d965e40b4c0",
                                                "sense_id": "5e964fb9-ce81-349a-b209-2f13af79e361",
                                                "text": "Ses singularités le rendent ridicule. - La singularité de son costume. - La singularité de ses sentiments choque beaucoup de gens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adcd3328-638c-32e2-8698-cc574f4362c3",
                                        "entry_id": "6ed22cbe-b513-38de-a723-1a9ce06a5356",
                                        "glosses": [
                                            "Point où des valeurs infinies sont constatées"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eceb6dc-2a31-4c6a-aaac-fc4d74404e4a",
                                                "sense_id": "adcd3328-638c-32e2-8698-cc574f4362c3",
                                                "text": "Je pus mener à bien (comme analyste, programmeur, perforateur et opérateur) trois gros programmes : tabulation de fonction pour l’astrolabe Danjon (sans problème mathématique réel), résolution numérique d’un problème plus complexe de cheminées d’équilibre (équation différentielle non linéaire avec singularité à l’origine) posé par le professeur Aldo Ghizetti, et, enfin, un essai sur une méthode de calculs des zéros d’un polynôme proposée par le professeur Derwidué."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c4f1616-2e10-373b-a1c4-964e1023c010",
                                        "entry_id": "6ed22cbe-b513-38de-a723-1a9ce06a5356",
                                        "glosses": [
                                            "Point où les dérivées n’existent pas"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f48f172b-b89a-3e71-831f-a4bb28fe69cb",
                                        "entry_id": "6ed22cbe-b513-38de-a723-1a9ce06a5356",
                                        "glosses": [
                                            "Point où les conditions physiques de pression et de densité de la matière sont extrêmes."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfa71f4c-c2b1-4f95-9289-19c9fa9ecb72",
                                                "sense_id": "f48f172b-b89a-3e71-831f-a4bb28fe69cb",
                                                "text": "Peu après, M. J.-P. Vigier a signalé une analogie profonde entre mes idées sur les ondes à singularités et les tentatives de M. Einstein pour représenter les particules matérielles comme des singularités du champ dans le cadre de la Relativité généralisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c61755c-fdcd-37f3-906e-d0586ccf853f",
                                        "entry_id": "6ed22cbe-b513-38de-a723-1a9ce06a5356",
                                        "glosses": [
                                            "Lieu où les lois de la physique connue ne sont pas respectées."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6939430-c981-4a75-9072-4f80c618ad63",
                                                "sense_id": "1c61755c-fdcd-37f3-906e-d0586ccf853f",
                                                "text": "Un trou noir est une singularité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10838f9a-8c50-41d4-8204-ce975e1e4650",
                        "source_entry_id": "10fb27ab-70e1-3490-82e7-22f0476511ce",
                        "source_sense_id": "5d660254-4986-3f5c-adef-bcd1d9832432",
                        "source_sense_description": "etwas, das sich durch seine Eigenschaften von anderem abhebt",
                        "target_lang_word": "étrangeté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étrangeté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0966dd34-3eb7-3fc1-9ea6-fb094e2d9d39",
                                        "entry_id": "0d0000ab-c8af-3ae0-9b8b-0ed7858f748b",
                                        "glosses": [
                                            "Caractère de ce qui est étrange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e754bbed-bc5f-49c2-b588-d7080858b48c",
                                                "sense_id": "0966dd34-3eb7-3fc1-9ea6-fb094e2d9d39",
                                                "text": "L’île dépassait encore en sauvagerie et en étrangeté les autres Marquises."
                                            },
                                            {
                                                "example_id": "e0196b4d-bbe5-4245-aa90-3d985f9b1020",
                                                "sense_id": "0966dd34-3eb7-3fc1-9ea6-fb094e2d9d39",
                                                "text": "Mais c’était l’irrégularité de la couleur de ses iris, l’un bleu pâle et l’autre jaune, qui achevait de conférer à son visage une étrangeté indéfinissable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498fd439-b520-3a5c-aa54-95dc38d4213d",
                                        "entry_id": "0d0000ab-c8af-3ae0-9b8b-0ed7858f748b",
                                        "glosses": [
                                            "Chose étrange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe2fb48-e2ae-474e-9160-f18b857234f1",
                                                "sense_id": "498fd439-b520-3a5c-aa54-95dc38d4213d",
                                                "text": "Bizarrement, l’ombre portée sur la Lune ne devait pas être noire mais rouge profond. Une étrangeté qui pourtant s'explique par un simple cours de physique. Dans une telle situation, l'atmosphère terrestre qui englobe notre planète joue en effet le rôle de lentille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851508f5-bbf5-392e-b562-6c33b93de17d",
                                        "entry_id": "0d0000ab-c8af-3ae0-9b8b-0ed7858f748b",
                                        "glosses": [
                                            "Chose anormale, inusitée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ec6445-e1c5-4ba3-afe6-72fee181feee",
                                                "sense_id": "851508f5-bbf5-392e-b562-6c33b93de17d",
                                                "text": "Une étrangeté : l'emprunteur était rémunéré par le prêteur. Le monde à l'envers!."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc183bb-2b02-3638-95fb-c4acce7a5069",
                                        "entry_id": "0d0000ab-c8af-3ae0-9b8b-0ed7858f748b",
                                        "glosses": [
                                            "Nombre quantique de certaines particules, telles que les baryons, défini comme la différence entre le nombre d’antiquarks étranges et de quarks étranges."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c8cc8ed-1ec5-45a6-8445-6993c8a84327",
                        "source_entry_id": "10fb27ab-70e1-3490-82e7-22f0476511ce",
                        "source_sense_id": "5d660254-4986-3f5c-adef-bcd1d9832432",
                        "source_sense_description": "etwas, das sich durch seine Eigenschaften von anderem abhebt",
                        "target_lang_word": "anomalie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anomalie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90515296-7e72-3236-8b94-debb5182e5b0",
                                        "entry_id": "d74f439c-9df5-314e-b2bb-ae49b392bf1e",
                                        "glosses": [
                                            "État de ce qui est anormal ou anomal."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8561602d-8225-4075-a550-e242916bdbc1",
                                                "sense_id": "90515296-7e72-3236-8b94-debb5182e5b0",
                                                "text": "Parmi les peintres et graveurs avec qui il travaille, Wiener me voit comme une anomalie artistique, un des rares lithographes à s’intéresser d’aussi près et avec autant de curiosité au rendu des couleurs."
                                            },
                                            {
                                                "example_id": "b8e30d46-b7e1-4d0c-9768-d4d075df79ed",
                                                "sense_id": "90515296-7e72-3236-8b94-debb5182e5b0",
                                                "text": "M. Lemot a dépensé des sommes énormes pour faire du pittoresque, et il n’a réussi qu’à faire de l’anomalie : elle était plus sensible encore par la présence du drapeau tricolore sur cette ruine du onzième siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3da92170-887f-3716-b709-1dd8afb5d501",
                                        "entry_id": "d74f439c-9df5-314e-b2bb-ae49b392bf1e",
                                        "glosses": [
                                            "Irrégularité des mouvements planétaires."
                                        ],
                                        "tags": [
                                            "Mécanique céleste"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4efac22e-f633-4dce-976c-c8a9aefa8e00",
                                                "sense_id": "3da92170-887f-3716-b709-1dd8afb5d501",
                                                "text": "S’il y a une différence appréciable, ce sera donc pour Mercure qu’elle sera la plus grande, Mercure ayant de toutes les planètes la plus grande vitesse. Or il arrive justement que Mercure présente une anomalie non encore expliquée : le mouvement de son périhélie est plus rapide que le mouvement calculé par la théorie classique. Sa vitesse angulaire est de 38\" plus grande qu’elle ne devrait être. Le Verrier attribua cette anomalie à une planète non encore découverte et un astronome amateur crut observer son passage sur le Soleil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fc05a53-5aff-39b1-92c7-ab3d39b6277a",
                                        "entry_id": "d74f439c-9df5-314e-b2bb-ae49b392bf1e",
                                        "glosses": [
                                            "Angle qui mesure cette irrégularité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
