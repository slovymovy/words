                ],
                "senses": [
                    {
                        "sense_id": "a948da02-ed86-3f12-ab54-798b7a9f6a83",
                        "entry_id": "454278a6-c98f-3f6d-8c31-fe0d39c9fbd8",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad0fa7c-71d5-44e9-a154-8c4c203a9a5a",
                                "sense_id": "a948da02-ed86-3f12-ab54-798b7a9f6a83",
                                "text": "Frau Kälble ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "47843f2b-6b37-4d65-899b-5336cee913c6",
                                "sense_id": "a948da02-ed86-3f12-ab54-798b7a9f6a83",
                                "text": "Herr Kälble wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ef07abc4-5cec-47b1-9837-d694f099d18e",
                                "sense_id": "a948da02-ed86-3f12-ab54-798b7a9f6a83",
                                "text": "Die Kälbles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "4a59c178-f98c-4b98-9f5f-7f9b3aef1907",
                                "sense_id": "a948da02-ed86-3f12-ab54-798b7a9f6a83",
                                "text": "Der Kälble trägt nie die Pullover, die die Kälble ihm strickt."
                            },
                            {
                                "example_id": "21eefd5d-8588-4fea-8538-cea965bd7dfb",
                                "sense_id": "a948da02-ed86-3f12-ab54-798b7a9f6a83",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kälble kommt, geht der Herr Kälble.“"
                            },
                            {
                                "example_id": "744df675-7bf7-4b9b-b18d-d38d95704e5d",
                                "sense_id": "a948da02-ed86-3f12-ab54-798b7a9f6a83",
                                "text": "Kälble kommt und geht."
                            },
                            {
                                "example_id": "5884129d-8dfe-4207-8fa0-657655a44c2e",
                                "sense_id": "a948da02-ed86-3f12-ab54-798b7a9f6a83",
                                "text": "Kälbles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
