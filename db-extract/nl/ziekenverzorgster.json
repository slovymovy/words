                        "glosses": [
                            "vrouw die zorgt voor zieke mensen, iemand die een verpleegkundige helpt bij de verpleging"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "a9486577-6a1c-4e6d-acbf-9a1d5dcd60e0",
                                "sense_id": "ae13d577-50d2-323a-a0e2-27105d926417",
                                "text": "De ziekenverzorgster wil graag in contact komen met de gevallen vrouw of eventuele andere getuigen. Met een getuigenverklaring kan ze bewijzen dat er sprake was van een dringende reden om de auto op de invalidenparkeerplaats te zetten."
                            },
                            {
                                "example_id": "8cff3aef-2ebe-4ec1-bed5-1d085da10c75",
                                "sense_id": "ae13d577-50d2-323a-a0e2-27105d926417",
                                "text": "Twintig kinderen zitten er in zijn klas, van zeer verschillend niveau. De een heeft het in zich om professor te worden, de ander ziekenverzorgster of buschauffeur."
                            }
                        ]
                    }
