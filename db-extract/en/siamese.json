                ],
                "senses": [
                    {
                        "sense_id": "78675767-6b9f-309b-9343-0e451840cdeb",
                        "entry_id": "00d27316-4063-373b-a7a4-60fca4bc6b13",
                        "glosses": [
                            "Of or relating to Siam; Thai."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d4b274a-0e31-4bfc-98a4-a62eaa424d13",
                                "sense_id": "78675767-6b9f-309b-9343-0e451840cdeb",
                                "text": "I remember one such occasion when a Siamese pupil had fired the train from Lime Street, and so complimentary were the Chief's remarks on the condition of the fire that we found our young Siamese friend difficult to live with for about a week afterwards!"
                            }
                        ]
                    },
                    {
                        "sense_id": "1e1125df-4ec5-3ddb-b17d-1db46c2630d7",
                        "entry_id": "00d27316-4063-373b-a7a4-60fca4bc6b13",
                        "glosses": [
                            "Of a connection of tubes or hoses: shaped like the letter Y."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c134f42-be10-4b21-96bc-b336406d5aee",
