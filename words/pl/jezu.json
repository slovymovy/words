                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Jezu</w>, jak ty mnie wystraszyłeś!",
                            "target_lang_translations": {
                                "ru": "<w>Боже</w>, как ты меня напугал!",
                                "en": "<w>Jeez</w>, you scared me!",
                                "nl": "<w>Jezus</w>, wat liet je me schrikken!",
                                "de": "<w>Gott</w>, wie du mich erschreckt hast!",
                                "fr": "<w>Mon Dieu</w>, comme tu m'as fait peur !",
                                "it": "<w>Gesù</w>, come mi hai fatto spaventare!",
                                "cs": "<w>Ježíši</w>, jak jsi mě vylekal!",
                                "tr": "<w>Tanrım</w>, beni nasıl korkuttun!",
                                "es": "¡<w>Dios mío</w>, qué susto me has dado!",
                                "zh": "<w>天哪</w>，你吓死我了！"
                            }
                        },
                        {
                            "text": "O <w>Jezu</w>, zapomniałem zamknąć drzwi na klucz.",
                            "target_lang_translations": {
                                "ru": "О <w>Господи</w>, я забыл запереть дверь на ключ.",
                                "en": "Oh <w>God</w>, I forgot to lock the door.",
                                "nl": "O <w>Jezus</w>, ik ben vergeten de deur op slot te doen.",
                                "de": "O <w>Gott</w>, ich habe vergessen, die Tür abzuschließen.",
                                "fr": "Oh <w>mon Dieu</w>, j'ai oublié de fermer la porte à clé.",
                                "it": "Oh <w>Gesù</w>, ho dimenticato di chiudere la porta a chiave.",
                                "cs": "O <w>Panebože</w>, zapomněl jsem zamknout dveře na klíč.",
                                "tr": "Aman <w>Tanrım</w>, kapıyı kilitlemeyi unutmuşum.",
                                "es": "Oh <w>Dios</w>, olvidé cerrar la puerta con llave.",
                                "zh": "<w>我的天</w>，我忘了锁门了。"
