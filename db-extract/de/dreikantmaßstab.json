                "senses": [
                    {
                        "sense_id": "f2954dea-4707-3d45-b937-71991aec259e",
                        "entry_id": "e171bcde-3cfd-335a-bc1f-aff14677c91d",
                        "glosses": [
                            "ein Lineal mit sechs verschiedenen Maßstabsskalen"
                        ],
                        "tags": [
                            "Messgerät"
                        ],
                        "examples": [
                            {
                                "example_id": "0822dc6e-cc2e-412b-b558-59ea526c0496",
                                "sense_id": "f2954dea-4707-3d45-b937-71991aec259e",
                                "text": "Es werden Dreikantmaßstäbe mit unterschiedlichen Maßstabskombinationen je nach Anwendungsbereich angeboten."
                            },
                            {
                                "example_id": "8c6bf60a-199a-4a58-bafe-aab87e7fa0ba",
                                "sense_id": "f2954dea-4707-3d45-b937-71991aec259e",
                                "text": "Ein Dreikantmaßstab ist ein unentbehrliches Hilfsmittel für technische Zeichner und Architekten."
                            },
                            {
                                "example_id": "dc50a40d-7224-4a4d-be6f-4ce03f088cc9",
                                "sense_id": "f2954dea-4707-3d45-b937-71991aec259e",
                                "text": "„„Das waren die normalen Messgeräte, die man damals verwendete, was den Zeichentisch anbelangt: ein Dreikantmaßstab, ein großes Geodreieck, daneben die Maßbänder, die langen Maßbänder, mit denen sie vermessen hat, geometrisch vermessen hat, ja, und dann auch Papierbänder, mit denen sie Maße genommen hat, und diese Zeichnungen, Skizzen, hat sie dann mit ins Büro genommen und dort Stück für Stück die Bereiche der Pampa von Nasca, gezeichnet, rekonstruiert, die sie interessiert haben.““"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
