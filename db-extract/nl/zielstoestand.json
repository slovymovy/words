                        "examples": [
                            {
                                "example_id": "57f08aca-df07-4999-9c56-df6f018b951c",
                                "sense_id": "ff466a91-ccd1-37fd-8141-f3e772846703",
                                "text": "In de tijd als er een milde uitstorting van de Geest zal zijn, zullen zij zeker hun overvloedig deel ontvangen. Als die tijd eenmaal gekomen is, dan geloof ik dat degenen die dan zullen leven een ander soort preken zullen horen dan u nu gewoon bent. De mensen zullen dan ongetwijfeld in een andere zielstoestand zijn."
                            },
                            {
                                "example_id": "9f98db42-dc0d-4114-8cc1-e1d18ffe3682",
                                "sense_id": "ff466a91-ccd1-37fd-8141-f3e772846703",
                                "text": "Er zijn echter ook passages waarin Sara uitgebreid haar zielstoestand analyseert, zonder dat daarbij het Woord aan het woord komt."
                            }
                        ]
                    }
