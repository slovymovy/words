                "senses": [
                    {
                        "sense_id": "92cab929-b212-318a-86c2-0db19c27fc0b",
                        "entry_id": "177b8f79-65ac-31b5-b72e-3888deab6758",
                        "glosses": [
                            "iemand die als een vuur de gemoederen of onrust aanwakkert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "999922c7-96a3-4bb2-9b32-e8436ff5cfe3",
                                "sense_id": "92cab929-b212-318a-86c2-0db19c27fc0b",
                                "text": "Ineens was hij verdwenen van televisie, voetbalanalist, 'meninkjesman' en stokebrand Hugo Borst. Het zelfverkozen leven in de schaduw bevalt prima. 'Ik was gemakzuchtig geworden.'"
                            },
                            {
                                "example_id": "ef9d4b9e-098c-45b5-a3f1-4bba7f6bbe86",
                                "sense_id": "92cab929-b212-318a-86c2-0db19c27fc0b",
                                "text": "Een kanttekening bij de klinkende zege voor de pro-Europese regering is de winst van de anti-Europese SRS. De partij van de ultranationalistische stokebrand Vojislav Seselj, die vorige maand werd vrijgesproken door het Joegoslaviëtribunaal, verdween in 2012 uit het parlement maar lijkt als grootste oppositiepartij weer helemaal terug."
                            }
                        ]
                    },
                    {
                        "sense_id": "f436a01a-8290-37d4-b20e-adb161f3682d",
                        "entry_id": "177b8f79-65ac-31b5-b72e-3888deab6758",
                        "glosses": [
                            "#:▸ Paphus groote Koningin,\\nMet uw stokebrand de Min,\\nNeemt voor lief de groetenis\\nVan haer die u vyand is."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "51f5260a-9570-3724-b217-57f324de86ad",
                        "entry_id": "177b8f79-65ac-31b5-b72e-3888deab6758",
                        "glosses": [
                            "#:▸ Gifmengster, stokebrand, die strick en stroppen draeyt:\\nBloedvrienden ophist, krijgh en vyandschappen saeyt,\\nOnnoosle brandmerckt, en verheerlijckt den verrader."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1827755f-63fd-4b26-8ddb-b9e8f5a8b914",
                        "source_entry_id": "177b8f79-65ac-31b5-b72e-3888deab6758",
                        "source_sense_id": "92cab929-b212-318a-86c2-0db19c27fc0b",
                        "source_sense_description": "iemand die als een vuur de gemoederen of onrust aanwakkert",
