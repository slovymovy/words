                            {
                                "example_id": "1e6c0756-0a70-461e-a4aa-0fc793594463",
                                "sense_id": "43eefc08-9a14-3529-8c8d-ccdcd9c9f003",
                                "text": "Cryptobin antedona nov. sp. est un zooflagellé endosymbiotique du coelome d’Antedon bifida."
