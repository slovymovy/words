                ],
                "senses": [
                    {
                        "sense_id": "833d48d2-7897-377e-b19a-1cb683acbe05",
                        "entry_id": "adea8007-80a0-3b7d-ab7a-06c2e2201203",
                        "glosses": [
                            "Any structure made from earth, especially an embankment used for fortification or flood control."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee55a32-fafb-414a-b2bc-e5869d191830",
                                "sense_id": "833d48d2-7897-377e-b19a-1cb683acbe05",
                                "text": "At the moment only some 35 miles of earthwork have been completed from Qum, and no permanent way has been laid."
                            },
                            {
                                "example_id": "e2980612-c6b5-4a50-98a8-18ab90bec3d5",
                                "sense_id": "833d48d2-7897-377e-b19a-1cb683acbe05",
                                "text": "The line was built by navvies using little more than wheelbarrows and shovels, with whatever material was close at hand, and the railway suffered from earthworks problems right from the start."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74d84eab-296c-4a49-9183-02d1b340f039",
                        "source_entry_id": "adea8007-80a0-3b7d-ab7a-06c2e2201203",
                        "source_sense_id": "833d48d2-7897-377e-b19a-1cb683acbe05",
                        "source_sense_description": "structure made from earth",
                        "target_lang_word": "Erdarbeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdarbeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40cc5ef5-cd79-3bcf-ac39-cbc19460dd05",
                                        "entry_id": "b84773f9-e8bb-3b03-88d0-3ea41782f011",
                                        "glosses": [
                                            "Gestaltung/Umgestaltung des Erdbodens oder seines Untergrunds"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72c04579-0b5c-43ea-b9d0-bb8243d7252c",
                                                "sense_id": "40cc5ef5-cd79-3bcf-ac39-cbc19460dd05",
                                                "text": "„Gerade wird er im großen Stil saniert: ein Glücksfall für die Archäologen, die bei Erdarbeiten nicht nur auf Azelins Grundmauern, sondern auch auf alte Fußböden, Gräber und Reste der ersten Kapelle stießen, die hier um 815 nach Christus stand.“"
                                            },
                                            {
                                                "example_id": "7440d2e5-768e-45dc-89fd-ab5c65923735",
                                                "sense_id": "40cc5ef5-cd79-3bcf-ac39-cbc19460dd05",
                                                "text": "„Die Stadtwerke selbst teilten gestern mit, dass ein beauftragtes Unternehmen in der kommenden Woche mit den Erdarbeiten beginnen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
