                "senses": [
                    {
                        "sense_id": "8723806b-221f-3adb-90c4-f10ab0fc4bdc",
                        "entry_id": "6341d9a7-120b-3e08-b480-f8e16cf2b25d",
                        "glosses": [
                            "A person who aids or assists."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9efe2d4-5a84-45c7-899d-acca66a50d8e",
                                "sense_id": "8723806b-221f-3adb-90c4-f10ab0fc4bdc",
                                "text": "The capitaines of the toune seyng theire pillers borken, and their chief ayders discomfited, rendered the toune to the duke of Somerset,"
                            },
                            {
                                "example_id": "f5c3ae13-a798-4978-93bf-b3d322be4be8",
                                "sense_id": "8723806b-221f-3adb-90c4-f10ab0fc4bdc",
                                "text": "[…] arte is neither an aider nor a surmounter, but onely a bare immitatour of natures works, following and counterfeyting her actions and effects […]"
                            },
                            {
                                "example_id": "01b91581-924f-4d8d-ad91-4427732e71f8",
                                "sense_id": "8723806b-221f-3adb-90c4-f10ab0fc4bdc",
                                "text": "[…] being there as an assistant, he actually seemed—[…]—to be the aider and abettor of a system which filled him with honest disgust and indignation, […]"
                            },
                            {
                                "example_id": "414fa2e6-11e0-458d-9c7a-4927dbcaec2c",
                                "sense_id": "8723806b-221f-3adb-90c4-f10ab0fc4bdc",
                                "text": "The woman in question had, as she said, been a close friend of Margaret’s, and, as such, an aider in her habits of intemperance."
                            }
                        ]
                    },
                    {
                        "sense_id": "d061e9b1-bb49-3a6a-b455-fb3a60199ef7",
                        "entry_id": "6341d9a7-120b-3e08-b480-f8e16cf2b25d",
                        "glosses": [
                            "A mountaineer's stirrup or étrier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46b3a59b-02fe-4568-ad59-e734fb78f141",
                                "sense_id": "d061e9b1-bb49-3a6a-b455-fb3a60199ef7",
                                "text": "As I was switching my feet in my aiders, the hook popped."
                            }
                        ]
                    }
