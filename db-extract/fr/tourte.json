        "fr-extract.jsonl": [
            {
                "entry_id": "7d786509-69e1-321e-94d0-3684628b61c4",
                "word": "tourte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "79e715ed-a2e5-4ba9-ba28-06ada07dcb7c",
                        "entry_id": "7d786509-69e1-321e-94d0-3684628b61c4",
                        "tags": [
                            "plural"
                        ],
                        "form": "tourtes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd000b81-9730-3fb6-ba1d-54dbb076514d",
                        "entry_id": "7d786509-69e1-321e-94d0-3684628b61c4",
                        "glosses": [
                            "Pâtisserie généralement salée contenant des viandes, des quenelles, etc."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "9884639a-2082-442b-b645-845b4e229482",
                                "sense_id": "dd000b81-9730-3fb6-ba1d-54dbb076514d",
                                "text": "Chaque fois que madame Bergeret faisait à l’improviste une invitation à dîner, elle commandait une tourte chez le pâtissier Magloire, et de préférence une tourte maigre, comme plus délicate. M. Bergeret se représenta donc, sans convoitise et par un pur effet de son intelligence, une tourte aux œufs ou au poisson, fumant dans un plat à filets bleus, sur la nappe damassée."
                            },
                            {
                                "example_id": "1ebf0f59-8162-4131-b483-d9bc80a12cc0",
                                "sense_id": "dd000b81-9730-3fb6-ba1d-54dbb076514d",
                                "text": "Il invitait le voyageur las des routes solitaires à entrer et à se réconforter avec du café fumant et des gâteaux chauds, du quatre-quart et de délicieuses tourtes faites avec les produits d'un sol gras; […]."
                            },
                            {
                                "example_id": "7135aafd-84b4-4bc5-af63-e28fe8d828fa",
                                "sense_id": "dd000b81-9730-3fb6-ba1d-54dbb076514d",
                                "text": "– Avant de mourir, dit-il, je veux manger encore une fois de la tourte à la viande, comme ma petite sœur Gabrielle seule sait la faire.\nGabrielle (c’était ma grand-mère maternelle qui avait alors dix-huit ans), tout en larmes, se mit à la pâte, coupa menue la chair, l’arrosa de cognac et après la cuisson enveloppa le tout bien précieusement de quatre linges pour empêcher que son chef-d’œuvre ne se refroidît, pendant le trajet, dans la voiture à âne qu’elle menait elle-même et qui la conduisit bride abattue auprès de son frère bien-aimé."
                            },
                            {
                                "example_id": "7d499174-224d-4cac-9c5a-fb4617fa1d0f",
                                "sense_id": "dd000b81-9730-3fb6-ba1d-54dbb076514d",
                                "text": "François trouvait qu’il y avait trop de tourtes et pas assez de plats de poisson au troisième service."
                            }
                        ]
                    },
                    {
                        "sense_id": "2642b602-5d4c-3339-9796-776ca1e5518e",
                        "entry_id": "7d786509-69e1-321e-94d0-3684628b61c4",
                        "glosses": [
                            "Masse issue du broyage en poudre du minerai d'argent."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "d9736f98-19ce-4f9c-abc0-d993d27a41e2",
                                "sense_id": "2642b602-5d4c-3339-9796-776ca1e5518e",
                                "text": "Une trop faible quantité de magistral fait perdre de l'argent, un excès fait perdre du mercure transformé en chlorure. On ajoute ensuite du mercure en pluie fine sur toute la surface de la tourte."
                            }
                        ]
                    },
                    {
                        "sense_id": "111f6017-e9c1-372c-a364-56eb35d533d1",
                        "entry_id": "7d786509-69e1-321e-94d0-3684628b61c4",
                        "glosses": [
                            "Plaque d'argile sur laquelle est posé le creuset des verriers et des fondeurs de métaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21abb206-6fe5-4b5d-89c3-557cab2b745b",
                                "sense_id": "111f6017-e9c1-372c-a364-56eb35d533d1",
                                "text": "Le mélange fut tassé pour environner de toute part les rognures de clous, et le creuset placé sur sa tourte au milieu de la forge,…."
                            }
                        ]
                    },
                    {
                        "sense_id": "6446d02b-d7ca-3764-a0bb-8283454f62cf",
                        "entry_id": "7d786509-69e1-321e-94d0-3684628b61c4",
                        "glosses": [
                            "Idiot, en particulier s’agissant d’une femme."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "550168a6-e2b0-4863-b7ba-5508da360a08",
                                "sense_id": "6446d02b-d7ca-3764-a0bb-8283454f62cf",
                                "text": "– Une tourte comme Hermine, si elle changeait d’homme, ça se verrait sur sa figure.."
                            },
                            {
                                "example_id": "4771b496-932d-4cff-8e71-f1ef4be6b5c9",
                                "sense_id": "6446d02b-d7ca-3764-a0bb-8283454f62cf",
                                "text": "« Allons, venez, maintenant, espèce de vieille tourte ! Et tâchez de prendre garde où vous posez vos pieds !... »"
                            },
                            {
                                "example_id": "28e660f9-04a7-4878-bb06-f91211b351b7",
                                "sense_id": "6446d02b-d7ca-3764-a0bb-8283454f62cf",
                                "text": "« On ne peut pas toujours suivre le conseil de ce vieux grigou de Benjamin Franklin.\n– Benjamin Franklin ? répéta son interlocuteur.\n– Mais oui, tourte : « Ça ne coûte rien ; c’est sans danger ; c’est agréable. »"
                            },
                            {
                                "example_id": "22c6f0b1-ae1b-414d-9d69-e9c95d49ecd3",
                                "sense_id": "6446d02b-d7ca-3764-a0bb-8283454f62cf",
                                "text": "Quelle tourte ! Quelle tourte ! se désola Krùhl. Ne dirait-on pas que je suis cet être repoussant dont parle l’Apocalypse ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93996f12-7ce9-4237-97a3-a61d691c95fe",
                        "source_entry_id": "7d786509-69e1-321e-94d0-3684628b61c4",
                        "target_lang_word": "meat pie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meat pie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27ae47ec-3882-3b59-b3b2-e20fd5da6476",
                                        "entry_id": "b54ec037-b832-3503-9b0b-982b500a484b",
                                        "glosses": [
                                            "A pie containing meat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "683d2f19-65e8-4606-be0e-1b3d0ff91d78",
                                                "sense_id": "27ae47ec-3882-3b59-b3b2-e20fd5da6476",
                                                "text": "My sister-in-law from Corsica makes the best quiche and the best meat pie in the world."
                                            },
                                            {
                                                "example_id": "71f5148d-baed-4016-b316-677fd0b5f8bf",
                                                "sense_id": "27ae47ec-3882-3b59-b3b2-e20fd5da6476",
                                                "text": "If flour ran short we can be certain it was saved for gravies, dumplings, cakes and gingerbread, and pie crust, and most particularly for meat pie."
                                            },
                                            {
                                                "example_id": "7cb970f2-b58c-4b13-85fb-df7f4a3f79a3",
                                                "sense_id": "27ae47ec-3882-3b59-b3b2-e20fd5da6476",
                                                "text": "She averted her eyes, looking toward Crispin, who ate meat pie and a large slice of roasted ox with healthy relish and without seeming to notice her discomfort."
                                            },
                                            {
                                                "example_id": "1897f800-815b-4f15-ab6c-105cbe11dc44",
                                                "sense_id": "27ae47ec-3882-3b59-b3b2-e20fd5da6476",
                                                "text": "In the case of meat pies that have a jelly or stock added after cooking, the stock and meat should be sampled separately as well as together in a combined sample."
                                            },
                                            {
                                                "example_id": "d6b4b743-a747-40fb-b0a4-539640eefc51",
                                                "sense_id": "27ae47ec-3882-3b59-b3b2-e20fd5da6476",
                                                "text": "Meat pies, which used to be a traditional Acadian Christmastime treat, are one of Louisiana′s least-touted specialties."
                                            },
                                            {
                                                "example_id": "56608be9-9081-4dd3-9e93-61b13f69eaac",
                                                "sense_id": "27ae47ec-3882-3b59-b3b2-e20fd5da6476",
                                                "text": "It was to Liubotyn station that I and my best mate Sasha once ventured on our lives' first (meaning without the adults) train ride. […] We got off at Liubotyn, then sleepy and unmistakeably rural, bought a couple of wrinkled meat pies at a station kiosk, and got back on the train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08e615cf-b2f8-354d-a11d-8a87008308ed",
                                        "entry_id": "b54ec037-b832-3503-9b0b-982b500a484b",
                                        "glosses": [
                                            "A hand-sized pot pie containing largely minced meat and gravy and typically consumed as a takeaway food snack."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdde22c0-22fb-44ea-90e2-09c538d0c9ba",
                                                "sense_id": "08e615cf-b2f8-354d-a11d-8a87008308ed",
                                                "text": "(a) Meat pie is cooked meat with or without cereal, condiments seasoning and water, enclosed in a case of pastry.\n(b) Meat pie shall contain not less than twenty-five parts per centum of meat when determined by the prescribed method."
                                            },
                                            {
                                                "example_id": "83a59b3a-8bb3-4ed9-9fee-ae3df56d9fa6",
                                                "sense_id": "08e615cf-b2f8-354d-a11d-8a87008308ed",
                                                "text": "Meat pies are an Australian favourite and are sold in cake and sandwich shops from one end of the land to the other. The classic version is simple – an individual, 2-crust pie full of chopped beef in a rich gravy."
                                            },
                                            {
                                                "example_id": "079a4ea2-122e-4d03-aa5e-4c584733836f",
                                                "sense_id": "08e615cf-b2f8-354d-a11d-8a87008308ed",
                                                "text": "If you think the major ingredient in most meat pies is meat you’re in for a disappointment. But some brands are meatier than others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "213bc53e-2634-4ef8-a0b6-b72cb57bde95",
                        "source_entry_id": "7d786509-69e1-321e-94d0-3684628b61c4",
