                ],
                "senses": [
                    {
                        "sense_id": "237060c4-546d-3fef-8c3f-22532f9c371f",
                        "entry_id": "d0933770-e0eb-3894-ba7d-9e80af777658",
                        "glosses": [
                            "Donner un caractère de capucin à."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5b638de0-f2a3-4375-aa79-7c4583bd8cfe",
                                "sense_id": "237060c4-546d-3fef-8c3f-22532f9c371f",
                                "text": "II est sûr, ajoutait l'Empereur, qu’ils vont faire « tout leur possible pour encapuciner cette pauvre France ;"
                            },
                            {
                                "example_id": "1f1beb97-a700-4742-8bba-129d02fc8a59",
                                "sense_id": "237060c4-546d-3fef-8c3f-22532f9c371f",
                                "text": "Les bons pères le retirèrent dans leurs couvens, où il acheva de s’encapuciner."
                            },
                            {
                                "example_id": "c3f201c6-e0c7-45e4-a7b5-219869c4226c",
                                "sense_id": "237060c4-546d-3fef-8c3f-22532f9c371f",
                                "text": "(…)? ou bien vont-ils au régiment pour être livrés par des chefs impuissants ou encapucinés à la pieuse férule de la propagande?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0b979c65-2164-3cc1-9773-b2404c999a87",
                        "entry_id": "d0933770-e0eb-3894-ba7d-9e80af777658",
                        "glosses": [
                            "Faire ressembler à un capucin (les capucins portent un capuchon sombre)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "617556d5-f0a1-4f1b-9188-53e669af9c86",
                                "sense_id": "0b979c65-2164-3cc1-9773-b2404c999a87",
                                "text": "Toi que la barbe encapucine."
                            }
                        ]
                    },
                    {
                        "sense_id": "203049bf-c7f3-32fa-94c4-f439e8cad6f7",
                        "entry_id": "d0933770-e0eb-3894-ba7d-9e80af777658",
                        "glosses": [
                            "Enflammer d’amour."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "47b74e05-52d0-4fc2-969f-6ac01850d453",
                                "sense_id": "203049bf-c7f3-32fa-94c4-f439e8cad6f7",
                                "text": "Préférablement de quelle furieuse façon elle vous a encendré et encapuciné le cœur."
                            },
                            {
                                "example_id": "50e9dbbf-7357-4b8f-806a-a38f5377238e",
                                "sense_id": "203049bf-c7f3-32fa-94c4-f439e8cad6f7",
                                "text": "Il faut que je lui fasse connaître qu'elle encapucine l'âme et qu'elle me cendre le Cœur (r : Qu'elle m'enflamme)."
                            }
                        ]
                    }
                ],
