                ],
                "senses": [
                    {
                        "sense_id": "51d45d9c-5c45-340d-afda-48e9464f631e",
                        "entry_id": "c458738f-82f7-38be-8234-35d282361a3e",
                        "glosses": [
                            "waaraan geen einde komt of althans schijnt te komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb56ab61-9782-45c0-8b7b-a194d33943d9",
                                "sense_id": "51d45d9c-5c45-340d-afda-48e9464f631e",
                                "text": "Die eindeloze oorlog is een bron van veel ellende."
                            },
                            {
                                "example_id": "a7cb7469-e5fb-4397-984a-37c108644956",
                                "sense_id": "51d45d9c-5c45-340d-afda-48e9464f631e",
                                "text": "Wat een dag en wat een eindeloos groot, leeg land. Ik was de hele dag geen weg of mens tegengekomen."
                            },
                            {
                                "example_id": "2acf348f-1d40-48eb-9c52-62da2bf9f853",
                                "sense_id": "51d45d9c-5c45-340d-afda-48e9464f631e",
                                "text": "Alleen Lena had me eindeloos wakker kunnen houden. We hadden nu vaste verkering."
                            }
                        ]
                    },
                    {
                        "sense_id": "42b73bb3-335a-3752-a0b5-6e874180c634",
                        "entry_id": "c458738f-82f7-38be-8234-35d282361a3e",
                        "glosses": [
                            "heel fijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c99e91-53dd-43fa-a05a-5bc10a154b3c",
                                "sense_id": "42b73bb3-335a-3752-a0b5-6e874180c634",
                                "text": "Het was een eindeloze vakantie mooi weer, geen wind, lekker zonnetje en toch niet te warm."
                            }
                        ]
                    }
                ],
