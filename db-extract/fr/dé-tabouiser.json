                ],
                "senses": [
                    {
                        "sense_id": "99ce9289-f4b1-388f-909c-30596d8042f2",
                        "entry_id": "61100bec-a9bd-3909-a1a2-6f986faa8000",
                        "glosses": [
                            "Enlever son caractère tabou à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c406c70a-76f1-4276-8017-9b5a1c8ed091",
                                "sense_id": "99ce9289-f4b1-388f-909c-30596d8042f2",
                                "text": "Le président Buyoya commence vers la fin des années 1980 à «dé-tabouiser» la question ethnique (suite à de graves tueries à caractère ethnique en 1988) et à engager le pays dans une véritable ouverture politique."
                            },
                            {
                                "example_id": "08e5e781-cdd8-4929-aa1c-549599ac69da",
                                "sense_id": "99ce9289-f4b1-388f-909c-30596d8042f2",
                                "text": "Aujourd’hui, elles s’affichent publiquement comme étant un soutien aux mères célibataires pour qu’elles puissent garder leur enfant, ce qui a contribué à « dé-tabouiser » la question."
                            }
                        ]
                    }
