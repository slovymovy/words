                ],
                "translations": [
                    {
                        "translation_id": "8593b34f-af11-4c82-b187-981852b6458f",
                        "source_entry_id": "0bee6115-8cd4-3c16-8bd1-bf7d95bc63c3",
                        "source_sense_id": "e5d72fab-4dbb-3a2b-8034-3dbfd1b1f1a2",
                        "target_lang_word": "pay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7da7a95-dba2-3bba-a415-a61663f6775b",
                                        "entry_id": "e6eba2fb-afde-36af-acbb-fb66d5ac22dd",
                                        "glosses": [
                                            "To give money or other compensation to in exchange for goods or services."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d89e202-21ff-428b-93b4-dae8db6086a0",
                                                "sense_id": "a7da7a95-dba2-3bba-a415-a61663f6775b",
                                                "text": "How much will the job pay?"
                                            },
                                            {
                                                "example_id": "3935c23a-ee2e-4f62-b6e6-528b979a4645",
                                                "sense_id": "a7da7a95-dba2-3bba-a415-a61663f6775b",
                                                "text": "he paid him to clean the place up"
                                            },
                                            {
                                                "example_id": "18a5f3df-3730-4e27-8236-6ffdacb558d6",
                                                "sense_id": "a7da7a95-dba2-3bba-a415-a61663f6775b",
                                                "text": "he paid her off the books and in kind where possible"
                                            },
                                            {
                                                "example_id": "cd3503c4-cd4b-420b-b619-9a9ed2ad9109",
                                                "sense_id": "a7da7a95-dba2-3bba-a415-a61663f6775b",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything."
                                            },
                                            {
                                                "example_id": "bac3f8f2-ca0c-41ab-a124-1021a56eed5d",
                                                "sense_id": "a7da7a95-dba2-3bba-a415-a61663f6775b",
                                                "text": "Admiral Hackett: You can pay a soldier to fire a gun. You can pay him to charge the enemy. But you can't pay him to believe."
                                            },
                                            {
                                                "example_id": "81d21a35-d0b1-4ab5-848a-70576c26ef1f",
                                                "sense_id": "a7da7a95-dba2-3bba-a415-a61663f6775b",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable. Web companies like to boast about[…]and so on. But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention. Partly, this is a result of how online advertising has traditionally worked: advertisers pay for clicks, and a click is a click, however it's obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb100040-b96c-3d7b-81c4-641f4db7153d",
                                        "entry_id": "e6eba2fb-afde-36af-acbb-fb66d5ac22dd",
                                        "glosses": [
                                            "To discharge, as a debt or other obligation, by giving or doing what is due or required."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba933eab-438b-4486-8d9a-e0f59155b661",
                                                "sense_id": "bb100040-b96c-3d7b-81c4-641f4db7153d",
                                                "text": "she offered to pay the bill"
                                            },
                                            {
                                                "example_id": "d0fe6c6e-9cc4-4d99-b7dc-78e17e0390b3",
                                                "sense_id": "bb100040-b96c-3d7b-81c4-641f4db7153d",
                                                "text": "he has paid his debt to society"
                                            },
                                            {
                                                "example_id": "ab78dd63-75dc-4cf3-80ee-546035fc2cdd",
                                                "sense_id": "bb100040-b96c-3d7b-81c4-641f4db7153d",
                                                "text": "The wicked borroweth, and payeth not again."
                                            },
                                            {
                                                "example_id": "7dbc7bea-1a89-4c3b-a3f6-d4fe5dc509b1",
                                                "sense_id": "bb100040-b96c-3d7b-81c4-641f4db7153d",
                                                "text": "The petty ſtreames that paie a dailie det / To their ſalt ſoveraigne with their freſh fals haſt, / Adde to his flowe, but alter not his taſt."
                                            },
                                            {
                                                "example_id": "a05f3935-5e89-4126-9010-22dece279d6c",
                                                "sense_id": "bb100040-b96c-3d7b-81c4-641f4db7153d",
                                                "text": "Yet in “Through a Latte, Darkly”, a new study of how Starbucks has largely avoided paying tax in Britain, Edward Kleinbard […] shows that current tax rules make it easy for all sorts of firms to generate what he calls “stateless income”: […]. In Starbucks’s case, the firm has in effect turned the process of making an expensive cup of coffee into intellectual property."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d691ec0-c5e6-3bd3-a41e-2832e41153de",
                                        "entry_id": "e6eba2fb-afde-36af-acbb-fb66d5ac22dd",
                                        "glosses": [
                                            "To be profitable for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a61642-b50b-4bc2-a89c-17f41d43ab3b",
                                                "sense_id": "9d691ec0-c5e6-3bd3-a41e-2832e41153de",
                                                "text": "It didn't pay him to keep the store open any more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a62e786-2e71-3ae1-a3ba-267a569b22d3",
                                        "entry_id": "e6eba2fb-afde-36af-acbb-fb66d5ac22dd",
                                        "glosses": [
                                            "To give (something else than money)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8dedd19-c747-44b5-9bb6-1c762323a205",
                                                "sense_id": "6a62e786-2e71-3ae1-a3ba-267a569b22d3",
                                                "text": "to pay attention"
                                            },
                                            {
                                                "example_id": "29b57c0a-c3ca-4a18-824f-c1e430c95d5c",
                                                "sense_id": "6a62e786-2e71-3ae1-a3ba-267a569b22d3",
                                                "text": "not paying me a welcome"
                                            },
                                            {
                                                "example_id": "7eccc4f1-a4d1-4180-9b2c-a5e3f8a62665",
                                                "sense_id": "6a62e786-2e71-3ae1-a3ba-267a569b22d3",
                                                "text": "They stayed together during three dances, went out on to the terrace, explored wherever they were permitted to explore, paid two visits to the buffet, and enjoyed themselves much in the same way as if they had been school-children surreptitiously breaking loose from an assembly of grown-ups."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abc6f9b2-8883-3dca-a851-1130f5b9c468",
                                        "entry_id": "e6eba2fb-afde-36af-acbb-fb66d5ac22dd",
                                        "glosses": [
                                            "To be profitable or worth the effort."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca778939-db21-4945-9a30-fac6d9631804",
                                                "sense_id": "abc6f9b2-8883-3dca-a851-1130f5b9c468",
                                                "text": "crime doesn’t pay"
                                            },
                                            {
                                                "example_id": "caa1025c-bed6-4bb7-8340-304095ad9225",
                                                "sense_id": "abc6f9b2-8883-3dca-a851-1130f5b9c468",
                                                "text": "it will pay to wait"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7aff4a98-04ff-3df8-b14d-def2e9c5dcd5",
                                        "entry_id": "e6eba2fb-afde-36af-acbb-fb66d5ac22dd",
                                        "glosses": [
                                            "To discharge an obligation or debt."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8af26586-e8f4-4fa4-8ab0-f0f69189278f",
                                                "sense_id": "7aff4a98-04ff-3df8-b14d-def2e9c5dcd5",
                                                "text": "He was allowed to go as soon as he paid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c4386d5-dd59-3abc-b695-0fabd0af3148",
                                        "entry_id": "e6eba2fb-afde-36af-acbb-fb66d5ac22dd",
                                        "glosses": [
                                            "To suffer consequences."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6091363d-6366-4beb-8ffa-5d228875c7cf",
                                                "sense_id": "8c4386d5-dd59-3abc-b695-0fabd0af3148",
                                                "text": "He paid for his fun in the sun with a terrible sunburn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb179535-edf4-34da-94a9-dab2618f9fc4",
                                        "entry_id": "e6eba2fb-afde-36af-acbb-fb66d5ac22dd",
                                        "glosses": [
                                            "To admit that a joke, punchline, etc., was funny."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "621d5d36-eaee-4f8f-89ed-5d41af494c0d",
                                                "sense_id": "bb179535-edf4-34da-94a9-dab2618f9fc4",
                                                "text": "Sutho took a pull at his Johnny Walker and Coke and laughed that trademark laugh of his and said: `Okay. I'll pay that all right.'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05287055-806a-36b2-9998-f4d704a3595e",
                                        "entry_id": "f3cdb017-a6c1-37dc-a394-03d643e6a349",
                                        "glosses": [
                                            "Money given in return for work; salary or wages."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b349e317-40ae-4862-8ed4-745543131622",
                                                "sense_id": "05287055-806a-36b2-9998-f4d704a3595e",
                                                "text": "Many employers have rules designed to keep employees from comparing their pays."
                                            },
                                            {
                                                "example_id": "a16416a5-44ba-45fc-a7b6-d521b659a2ef",
                                                "sense_id": "05287055-806a-36b2-9998-f4d704a3595e",
                                                "text": "The skipper Mr. Cooke had hired at Far Harbor was a God-fearing man with a luke warm interest in his new billet and employer, and had only been prevailed upon to take charge of the yacht after the offer of an emolument equal to half a year's sea pay of an ensign in the navy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a85eff6-c0cd-3da2-8efe-8802e19f50a0",
                                        "entry_id": "f3cdb017-a6c1-37dc-a394-03d643e6a349",
                                        "glosses": [
                                            "A paying job; a paying concern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7deda1c-5879-48a4-a246-56f3c43ad177",
                                                "sense_id": "8a85eff6-c0cd-3da2-8efe-8802e19f50a0",
                                                "text": "\"You can if you like. I'll drop in each day to see how she gets on.\" \"Oh, will you? That's a relief. All the same, I wouldn't say she was a very good pay, if you spend too much time on her.\" \"Oh, bad pays make up half a doctor's job.\""
                                            }
                                        ]
                                    }
                                ]
                            },
