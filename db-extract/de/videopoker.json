                        "sense_id": "d1fec5ea-3044-3763-88cb-aee4981e6ee7",
                        "entry_id": "b6b2b1a8-73dd-32bb-8fe6-741789bd620c",
                        "glosses": [
                            "Pokervariante, die an Spielautomaten gespielt und in vielen Casinos und Spielhallen angeboten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d954afad-6b89-4b39-95d9-e24d7232dd08",
                                "sense_id": "d1fec5ea-3044-3763-88cb-aee4981e6ee7",
                                "text": "„Sie kannte ein paar Leute, die in die Stadt gezogen waren und später nach Hause zurückkehren mussten, weil sie ihre Gehaltsschecks an Automaten oder beim Videopoker verzockt hatten.“"
                            },
                            {
                                "example_id": "d03067c1-6cb6-43da-85b9-84f78a3319f2",
                                "sense_id": "d1fec5ea-3044-3763-88cb-aee4981e6ee7",
                                "text": "„Neal nahm seinen Drink, ließ sich zehn Dollar in Vierteldollarmünzen geben und zockte eine Weile erfolglos Videopoker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
