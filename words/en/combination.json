{
    "word_family": [
        "combine",
        "combinable",
        "combinatorial",
        "combinatorics"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b95e21b6-eab8-3701-b6ed-f22e7334127d",
                    "sense_definition": "The act of joining two or more things together, or the result of doing so.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>combination</w> of hard work and talent led to her success.",
                            "target_lang_translations": {
                                "ru": "<w>Сочетание</w> упорного труда и таланта привело её к успеху.",
                                "zh": "努力与天赋的<w>结合</w>促成了她的成功。"
                            }
                        },
                        {
                            "text": "This dish is a delicious <w>combination</w> of sweet and sour flavors.",
                            "target_lang_translations": {
                                "ru": "Это блюдо представляет собой восхитительное <w>сочетание</w> кислого и сладкого вкусов.",
                                "zh": "这道菜是酸甜口味的美味<w>组合</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fusion",
                        "merger"
                    ],
                    "antonyms": [
                        "separation",
                        "division"
                    ],
                    "common_phrases": [
                        "in combination with",
                        "combination of",
                        "winning combination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по соединению двух или более вещей вместе, или результат этого действия",
                        "zh": "将两个或多个事物结合在一起的行为，或其结合的结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочетание",
                                "target_lang_sense_clarification": "гармоничное соединение свойств, качеств или вкусов"
                            },
                            {
                                "target_lang_word": "комбинация",
                                "target_lang_sense_clarification": "соединение разнородных элементов"
                            },
                            {
                                "target_lang_word": "соединение",
                                "target_lang_sense_clarification": "связь, скрепление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结合",
                                "target_lang_sense_clarification": "事物间的融合或联系"
                            },
                            {
                                "target_lang_word": "组合",
                                "target_lang_sense_clarification": "不同元素的集合或搭配"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1106d68f-9016-3cfb-9546-ade19ec3ff0b",
                    "sense_definition": "A specific sequence of numbers or letters used to open a lock.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He memorized the <w>combination</w> so he could open the safe quickly.",
                            "target_lang_translations": {
                                "ru": "Он запомнил <w>комбинацию</w>, чтобы быстро открыть сейф.",
                                "zh": "他记住了<w>密码</w>，以便能快速打开保险柜。"
                            }
                        },
                        {
                            "text": "If you forget the <w>combination</w>, you will need a locksmith.",
                            "target_lang_translations": {
                                "ru": "Если вы забудете <w>код</w>, вам понадобится слесарь.",
                                "zh": "如果你忘了<w>密码</w>，就需要找锁匠了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "combination lock",
                        "safe combination"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная последовательность цифр или букв, используемая для открытия замка",
                        "zh": "用于打开锁的一组特定数字或字母序列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "код",
                                "target_lang_sense_clarification": "для замка или сейфа"
                            },
                            {
                                "target_lang_word": "комбинация",
                                "target_lang_sense_clarification": "последовательность символов"
                            },
                            {
                                "target_lang_word": "шифр",
                                "target_lang_sense_clarification": "секретный код"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "密码",
                                "target_lang_sense_clarification": "用于开启锁具的数字或字符序列"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99030578-1c45-3917-8c56-d9ae04bb7d51",
                    "sense_definition": "A selection of items from a set where the order does not matter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Calculating the correct <w>combination</w> is essential in probability problems.",
                            "target_lang_translations": {
                                "ru": "Вычисление правильного <w>сочетания</w> важно в задачах по теории вероятностей.",
                                "zh": "在概率问题中，计算正确的<w>组合</w>至关重要。"
                            }
                        },
                        {
                            "text": "The teacher explained the difference between a permutation and a <w>combination</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил разницу между перестановкой и <w>сочетанием</w>.",
                                "zh": "老师解释了排列与<w>组合</w>之间的区别。"
                            }
