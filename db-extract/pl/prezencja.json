                        ]
                    },
                    {
                        "translation_id": "c1dd0975-a0cc-4143-9bb8-38297fdf0723",
                        "source_entry_id": "3503923f-5817-3b7f-a6f4-994175773ff0",
                        "source_sense_id": "5e5e2048-df19-361a-979a-2b5852579a1d",
                        "target_lang_word": "Präsenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Präsenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7f806dd-3dea-3487-896d-9d6b76ef2584",
                                        "entry_id": "1a126f91-3300-3f27-b945-db3fb151d024",
                                        "glosses": [
                                            "die Tatsache, (örtlich) zugegen oder gegenwärtig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bfced22-cc37-4bd9-823c-2e9421a4acea",
                                                "sense_id": "d7f806dd-3dea-3487-896d-9d6b76ef2584",
                                                "text": "Die persönliche Präsenz des Prüflings ist unbedingt notwendig."
                                            },
                                            {
                                                "example_id": "50458880-a9ad-41c8-97f8-41c01d287cb9",
                                                "sense_id": "d7f806dd-3dea-3487-896d-9d6b76ef2584",
                                                "text": "Die bloße Präsenz dieser Person widert mich an."
                                            },
                                            {
                                                "example_id": "31ba123d-1f52-47bc-b16f-f7d7a317a3dc",
                                                "sense_id": "d7f806dd-3dea-3487-896d-9d6b76ef2584",
                                                "text": "„Mit da Gamas Ankunft beginnt die Präsenz der Portugiesen an der Küste Ostafrikas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "13e65d64-0695-3396-a9c5-7a28287ede01",
                                        "entry_id": "1a126f91-3300-3f27-b945-db3fb151d024",
                                        "glosses": [
                                            "Ausstrahlung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395f3700-09c9-481d-b3aa-c968360d670f",
                                                "sense_id": "13e65d64-0695-3396-a9c5-7a28287ede01",
                                                "text": "Auf der Bühne zeigt dieser Schauspieler eine Präsenz wie kein zweiter."
                                            },
                                            {
                                                "example_id": "5a08c2fd-a373-4950-a769-ca0316591532",
                                                "sense_id": "13e65d64-0695-3396-a9c5-7a28287ede01",
                                                "text": "„Die Inhaber vermieteten ihren Gasthof seit vielen Jahren an Vereine, die nicht unbedingt große öffentliche Präsenz anstrebten.“"
                                            },
                                            {
                                                "example_id": "1e34ff01-f90f-444d-86b6-ab53fc5ff9c9",
                                                "sense_id": "13e65d64-0695-3396-a9c5-7a28287ede01",
                                                "text": "„Bens gleichmäßige Schritte neben mir, seine ruhige Präsenz, seine Pausen, bevor er auf eine Frage antwortete, in denen er sich seine Antwort ganz genau zu überlegen schien, waren wie Balsam für meine aufgewühlten Nerven.“"
                                            },
                                            {
                                                "example_id": "2101e16c-60cb-49ea-b1c8-946bc2dbc249",
                                                "sense_id": "13e65d64-0695-3396-a9c5-7a28287ede01",
                                                "text": "„Er hatte eine starke Präsenz und würde sicher einen guten Lehrer oder Politiker abgeben, dachte Ari.“"
                                            },
                                            {
                                                "example_id": "34b6d23e-7ce6-4a5b-a397-a92773649cdd",
                                                "sense_id": "13e65d64-0695-3396-a9c5-7a28287ede01",
                                                "text": "„Kristín füllte das ganze Zimmer mit ihrer Präsenz und dem Elan, den sie ausstrahlte, und sie redete so viel, dass Guđriđur kaum etwas zu sagen brauchte, im Grunde nichts, nur zuhören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
