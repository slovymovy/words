                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar heeft veel <w>kennis</w> van geschiedenis.",
                            "target_lang_translations": {
                                "en": "The teacher has a lot of <w>knowledge</w> of history.",
                                "ru": "У учителя глубокие <w>знания</w> истории.",
