                "senses": [
                    {
                        "sense_id": "4a115890-141a-314e-912e-96cb0ead59c3",
                        "entry_id": "750b7c78-5a69-3070-b3cd-da8fe897a5d0",
                        "glosses": [
                            "минер. группа горных пород вулканического, осадочного и другого происхождения, используемых как строительный материал"
                        ],
                        "tags": [],
