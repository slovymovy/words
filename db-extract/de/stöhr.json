                ],
                "senses": [
                    {
                        "sense_id": "ffe865b5-c734-3b74-a453-2345a45d50e2",
                        "entry_id": "f5efcd44-5ee5-305b-a54a-ade0e5b3b26e",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b296176c-8cbf-4ffc-a55f-28e6c187e08f",
                                "sense_id": "ffe865b5-c734-3b74-a453-2345a45d50e2",
                                "text": "Frau Stöhr ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ad058b1f-dff9-4f8f-8c09-34243689995f",
                                "sense_id": "ffe865b5-c734-3b74-a453-2345a45d50e2",
                                "text": "Herr Stöhr wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "237c1440-ddb0-4b88-aed2-78065f73bd99",
                                "sense_id": "ffe865b5-c734-3b74-a453-2345a45d50e2",
                                "text": "Die Stöhrs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0371a44a-8f51-4fe4-9e38-df523ff67718",
                                "sense_id": "ffe865b5-c734-3b74-a453-2345a45d50e2",
                                "text": "Der Stöhr trägt nie die Schals, die die Stöhr ihm strickt."
                            },
                            {
                                "example_id": "71880cba-52f0-4823-9556-be9e09dd3309",
                                "sense_id": "ffe865b5-c734-3b74-a453-2345a45d50e2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stöhr kommt, geht der Herr Stöhr.“"
                            },
                            {
                                "example_id": "c49d08b4-8345-4863-b5ab-7dd0c1db5c0e",
                                "sense_id": "ffe865b5-c734-3b74-a453-2345a45d50e2",
                                "text": "Stöhr kommt und geht."
                            },
                            {
                                "example_id": "5fd484f7-faf2-4f25-867a-5fa3ad300fc1",
                                "sense_id": "ffe865b5-c734-3b74-a453-2345a45d50e2",
                                "text": "Stöhrs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
