                                                "sense_id": "a69e27c4-02ac-3d71-b7f5-00fd29bc8b65",
                                                "text": "Die Imago schlüpfte schon nach drei Tagen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3593a72-9f90-31db-bf12-ff030af6740f",
