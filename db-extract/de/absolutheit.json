                "senses": [
                    {
                        "sense_id": "40889b90-83d9-3451-8a60-55e3fd469dba",
                        "entry_id": "9f07bb41-8dca-3f94-8da6-5bb490731529",
                        "glosses": [
                            "die absolute Beschaffenheit einer Sache, das Absolutsein einer Sache"
                        ],
                        "tags": [
                            "Plural selten",
                            "meist Philosophie"
                        ],
                        "examples": [
                            {
                                "example_id": "91ac225e-1376-46f2-bd32-a5cb41deff3f",
                                "sense_id": "40889b90-83d9-3451-8a60-55e3fd469dba",
                                "text": "„Der Wertrelativismus erkennt eine Absolutheit der Werte nicht an, sondern knüpft deren Gültigkeit an bestimmte Menschen, Gemeinschaften, Kulturen (Kulturrelativismus) oder Epochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "810b629d-ccb4-4012-913b-7191e4d39568",
                        "source_entry_id": "9f07bb41-8dca-3f94-8da6-5bb490731529",
                        "source_sense_id": "40889b90-83d9-3451-8a60-55e3fd469dba",
                        "source_sense_description": "absolute Beschaffenheit einer Sache, das Absolutsein einer Sache",
                        "target_lang_word": "absoluteness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absoluteness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bce03098-16b2-3b30-8438-d4b726f8f4ab",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "The fact of being finished or perfected; completeness."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6536ff1a-dabf-3db8-ad47-dfcf1d4087c0",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "The characteristic of being absolute in nature or scope."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87f69207-a042-447c-b9d6-bcd5c7d2c88f",
                                                "sense_id": "6536ff1a-dabf-3db8-ad47-dfcf1d4087c0",
                                                "text": "the absoluteness of his sovereignty, the absoluteness of his convictions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d48d33c1-0c28-3e45-ae47-e71d4e822f15",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "Absolute authority, unlimited power; absolutism, despotism."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a7d1f66-e821-4544-b55c-9aaf8f485c0d",
                                                "sense_id": "d48d33c1-0c28-3e45-ae47-e71d4e822f15",
                                                "text": "I know no man that could produce more parts, both naturall and artificiall, fit to preserve his masterie, and to maintaine his absolutenesse, than he doth; yet is hee cleane falne from them like a childe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a76717-ff90-39e1-9382-2da24bd37376",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "The fact of being without qualifications or conditions; certainty, unconditionality."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "516859fd-3799-3b72-95ae-b73ea14f3282",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "Independent autonomy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68a4cd5a-240d-4444-891d-768feac66994",
                        "source_entry_id": "9f07bb41-8dca-3f94-8da6-5bb490731529",
                        "source_sense_id": "40889b90-83d9-3451-8a60-55e3fd469dba",
                        "source_sense_description": "absolute Beschaffenheit einer Sache, das Absolutsein einer Sache",
                        "target_lang_word": "absoluité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absoluité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44a92d3a-7d3a-3ea4-8b56-0f22ba008877",
                                        "entry_id": "6a2c72aa-8e2a-3f1a-b24e-0c248a18e047",
                                        "glosses": [
                                            "Caractère de ce qui est absolu, donc ni relatif, ni contingent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4e3bdcb-eda8-4e2c-be9d-dfb5174d9eb0",
                                                "sense_id": "44a92d3a-7d3a-3ea4-8b56-0f22ba008877",
                                                "text": "Il se demandait si cette notion très restreinte de l'absoluité, conséquence nécessaire de la réflexion historique selon lui suffisait à nourrir les besoins religieux des humains."
                                            },
                                            {
                                                "example_id": "30396248-a870-4bcf-922a-654b447fb105",
                                                "sense_id": "44a92d3a-7d3a-3ea4-8b56-0f22ba008877",
                                                "text": "Décrétant réactivement leur absoluité comme l’esclave nietzschéen décrète réactivement sa bonté, elles cherchent frénétiquement à discréditer toutes les autres idées comme « méchantes », parce que susceptibles d’être l’index de leur propre accidentalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a950d239-1d28-30b7-a7c8-37987e64dbed",
                                        "entry_id": "6a2c72aa-8e2a-3f1a-b24e-0c248a18e047",
                                        "glosses": [
                                            "Propriété de ce qui est absolu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dced96e-f956-41d4-8b66-a9dcf6f00c71",
                                                "sense_id": "a950d239-1d28-30b7-a7c8-37987e64dbed",
                                                "text": "On commence par une condition suffisante d’absoluité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
