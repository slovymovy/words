                "senses": [
                    {
                        "sense_id": "91af64a5-4808-3301-a2a5-d2e40e012515",
                        "entry_id": "dee0b970-91d1-396f-a03e-07f13b236246",
                        "glosses": [
                            "Lastkraftwagen, der mit Holzgas betrieben wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "03599483-c4f9-43ea-9f7b-3816bc8f2f82",
                                "sense_id": "91af64a5-4808-3301-a2a5-d2e40e012515",
                                "text": "„Zeitgenössische Fotos zeigen aber auch Rudel von Kohleplünderern, die mit Harken und Schaufeln das schwarze Gold von den langsam fahrenden Holzgaslastern kratzten.“"
                            },
                            {
                                "example_id": "2c227b01-ba9f-45c8-b69f-5d3c1793e7ab",
                                "sense_id": "91af64a5-4808-3301-a2a5-d2e40e012515",
                                "text": "„Kurz nach dem Zweiten Weltkrieg, als Benzin knapp war, fuhren viele Holzgaslaster durch Deutschland.“"
                            },
                            {
                                "example_id": "fed68c51-c3ef-4de1-a7e9-6f61c63724b4",
                                "sense_id": "91af64a5-4808-3301-a2a5-d2e40e012515",
                                "text": "„Ein alter Holzgaslaster brachte Bücherkisten, den ganzen Tag.“"
                            },
                            {
                                "example_id": "59b24b27-1c9e-4dd3-bd8a-b31455eb45f0",
                                "sense_id": "91af64a5-4808-3301-a2a5-d2e40e012515",
                                "text": "„Dann kam aus Stadtkyll der Fuhrunternehmer Michel Schröder mit einem Holzgaslaster, um uns in die Heimat zu bringen. “"
                            },
                            {
                                "example_id": "9d4b4663-94ea-4a90-ab05-2a0ffaa1262e",
                                "sense_id": "91af64a5-4808-3301-a2a5-d2e40e012515",
                                "text": "„Wir fuhren in Unkenntnis, was in Oranienburg passieren sollte, mit unserem altersschwachen Holzgaslaster (und dem dazu gehörigen Holz als Brenn- und Betriebsstoff) in die Kreisstadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
