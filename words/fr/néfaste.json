                {
                    "sense_id": "9ba67581-397b-3686-ba3e-71bbe07f296e",
                    "sense_definition": "Qui apporte le malheur, la désolation ou qui annonce une catastrophe ; funeste.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "funeste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette crise politique a ouvert une période <w>néfaste</w> pour l'avenir du royaume."
