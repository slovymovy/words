                "senses": [
                    {
                        "sense_id": "51733bd5-1b28-3968-8fa7-844a372e12d8",
                        "entry_id": "54007256-f1dd-31d8-b43d-9eb58f2f5d1d",
                        "glosses": [
                            "Se chuchoter mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "036bc8ad-926e-4da2-bfb1-6af9010de5fe",
                                "sense_id": "51733bd5-1b28-3968-8fa7-844a372e12d8",
                                "text": "Ils profitaient de l’occasion pour s’entrechuchoter des nouvelles vraies ou fausses, ramassées on ne sait où"
                            },
                            {
                                "example_id": "badb0132-a7a6-4b3c-a736-0cf7e48362f1",
                                "sense_id": "51733bd5-1b28-3968-8fa7-844a372e12d8",
                                "text": "Alors il pérore d’une voix douce en regardant ses braves gens s’entrechuchoter en essayant de ne rien perdre de sa péroraison."
                            }
                        ]
                    }
