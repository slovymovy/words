                                        "entry_id": "28bfd7b1-81ad-3d88-b80b-f87c8f9ae161",
                                        "glosses": [
                                            "Qui produit de la putréfaction, qui est corrompu, infecté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22558576-7d00-4a60-b032-4144414cf6e1",
                                                "sense_id": "fe2cdc72-64b7-33de-89b6-4e77003c320b",
                                                "text": "Plaie septique."
                                            },
                                            {
                                                "example_id": "a2a0b653-e2bd-4774-8e9b-9efcd50f13d5",
                                                "sense_id": "fe2cdc72-64b7-33de-89b6-4e77003c320b",
                                                "text": "Circonstance plus avantageuse encore, le gaz acide carbonique restant très longtemps dans les couches inférieures de l’atmosphère, en raison de son poids qui est supérieur à celui de l’air, la zone dangereuse conserve ses propriétés septiques plusieurs heures après l’explosion, et tout être qui tente d’y pénétrer périt infailliblement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fdb0728-363a-32aa-8bfa-30286075d835",
                                        "entry_id": "28bfd7b1-81ad-3d88-b80b-f87c8f9ae161",
                                        "glosses": [
                                            "Du septième degré, en parlant de polynôme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00ac6b16-6df8-434e-91da-193ada119ae8",
                        "source_entry_id": "0a007c72-8789-3be1-9e5d-96bdb5533bf9",
