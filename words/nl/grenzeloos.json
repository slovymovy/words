{
    "word_family": [
        "grens",
        "grenzen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "edb81e40-7dc4-3089-afc5-1a6745fd369e",
                    "sense_definition": "Zonder grenzen, beperkingen of oneindig groot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oneindig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mogelijkheden voor deze nieuwe technologie zijn <w>grenzeloos</w>.",
                            "target_lang_translations": {
                                "en": "The possibilities for this new technology are <w>boundless</w>."
                            }
                        },
                        {
                            "text": "Hij had een <w>grenzeloos</w> vertrouwen in zijn beste vriend.",
                            "target_lang_translations": {
                                "en": "He had <w>limitless</w> trust in his best friend."
                            }
                        }
                    ],
                    "synonyms": [
                        "grensloos"
                    ],
                    "common_phrases": [
                        "grenzeloos vertrouwen",
                        "grenzeloze mogelijkheden"
                    ],
                    "target_lang_definitions": {
                        "en": "Without limits, restrictions, or infinitely large."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "boundless",
                                "target_lang_sense_clarification": "Used for abstract concepts like potential or trust."
                            },
                            {
                                "target_lang_word": "limitless",
                                "target_lang_sense_clarification": "Used for possibilities or capacity."
                            },
                            {
                                "target_lang_word": "endless",
                                "target_lang_sense_clarification": "Used for things that seem to have no end."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "027735b3-b47d-3827-be1d-01eeca52ae85",
                    "sense_definition": "Zonder fysieke landsgrenzen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geografisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij leven tegenwoordig in een <w>grenzeloos</w> Europa.",
                            "target_lang_translations": {
                                "en": "We live in a <w>borderless</w> Europe nowadays."
                            }
                        },
                        {
                            "text": "Reizen door een <w>grenzeloos</w> gebied is erg makkelijk.",
                            "target_lang_translations": {
                                "en": "Traveling through a <w>borderless</w> region is very easy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grenzeloos Europa"
                    ],
                    "target_lang_definitions": {
                        "en": "Without physical national borders."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "borderless",
                                "target_lang_sense_clarification": "Specifically referring to the absence of political or physical borders."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be8863ed-2f20-3d71-858c-cf5fc94f0163",
                    "sense_definition": "Niet beperkt door landsgrenzen, internationaal of universeel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geografisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Goede kunst is tijd- en <w>grenzeloos</w>.",
                            "target_lang_translations": {
                                "en": "Good art is timeless and <w>borderless</w>."
                            }
                        },
                        {
                            "text": "De <w>grenzeloze</w> invloed van muziek verbindt mensen wereldwijd.",
                            "target_lang_translations": {
                                "en": "The <w>boundless</w> influence of music connects people worldwide."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Not restricted by national borders; international or universal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "borderless",
                                "target_lang_sense_clarification": "Used in the context of international or universal reach."
                            },
                            {
                                "target_lang_word": "universal",
                                "target_lang_sense_clarification": "Used when something applies to everyone everywhere."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}