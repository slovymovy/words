                        ],
                        "form": "die Missionarsstellung"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad78f10e-974e-3e05-86b8-14d1fc8ca363",
                        "entry_id": "73ee934a-02aa-3de9-9531-7c0a0e17aa36",
                        "glosses": [
                            "Stellung beim Geschlechtsverkehr, bei der der Mann auf der Frau liegt und ihr das Gesicht zuwendet. Die Frau liegt dabei auf dem Rücken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceaf074b-d5ff-4a9a-9128-f187794c8ce2",
                                "sense_id": "ad78f10e-974e-3e05-86b8-14d1fc8ca363",
                                "text": "„Sie verhalf den Einwohnern von Stadtland zu spektakulären Funden, wenn sie im Gegenzug mit ihr in der Missionarsstellung verkehrten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e692589e-02f7-4041-99c1-938421a623c7",
                        "source_entry_id": "73ee934a-02aa-3de9-9531-7c0a0e17aa36",
                        "source_sense_id": "ad78f10e-974e-3e05-86b8-14d1fc8ca363",
                        "target_lang_word": "missionary position",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "missionary position",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd5539e-9c6b-36ef-b159-2a2123763b7d",
                                        "entry_id": "3e603b22-531c-396b-90f1-c25373dae97e",
                                        "glosses": [
                                            "A position for sexual intercourse in which the man and woman face each other, with the man on top."
                                        ],
                                        "tags": [],
