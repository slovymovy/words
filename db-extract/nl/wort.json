                                        "sense_id": "a053bd64-1f8e-30fa-9051-e4f54b3ad6d3",
                                        "entry_id": "4357a744-810e-3db9-9980-7618677255af",
                                        "glosses": [
                                            "Jus de raisin qui n’a pas encore fermenté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d787034f-f7b8-45d7-bff0-aeb8ec33941f",
                                                "sense_id": "a053bd64-1f8e-30fa-9051-e4f54b3ad6d3",
                                                "text": "À combien de degrés titre le moût ?"
                                            },
                                            {
                                                "example_id": "37fbc719-dd83-442b-9023-128b77533311",
                                                "sense_id": "a053bd64-1f8e-30fa-9051-e4f54b3ad6d3",
                                                "text": "Il gardait en mémoire ces imposants pressoirs en bois dans leur cuvage, la macération du moût, son odeur âcre et vinaigrée, la cave humide à laquelle on accédait par un large escalier en pierre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bab2f2f-b2ca-32f4-b9b8-c688f309a64d",
                                        "entry_id": "4357a744-810e-3db9-9980-7618677255af",
                                        "glosses": [
                                            "Liquide sucré extrait des divers végétaux et destiné ordinairement à la fermentation alcoolique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b67d7ff8-b569-432e-9d35-32d93d6db994",
                                                "sense_id": "6bab2f2f-b2ca-32f4-b9b8-c688f309a64d",
                                                "text": "Du moût de bière."
                                            },
                                            {
                                                "example_id": "70a0019b-0370-4518-a966-5c98af7a0a85",
                                                "sense_id": "6bab2f2f-b2ca-32f4-b9b8-c688f309a64d",
                                                "text": "Dans la station d’épuration, on décante et on purifie selon des procédés que le simple mortel ignore. À peine peut-il voir au travers du grillage […] les boues qui remuent comme s’il s’agissait de moûts en fermentation […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
