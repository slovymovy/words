                "translations": [
                    {
                        "translation_id": "bde4a75f-6ff8-4eeb-b0d5-bc1979c74a45",
                        "source_entry_id": "05b48e2f-c2aa-33e2-a9f7-e0919222194a",
                        "source_sense_id": "0bc071e8-0f65-3ac7-88f7-84ab37c5364b",
                        "source_sense_description": "een persoon die dingen bouwt",
                        "target_lang_word": "Bauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "jemand, der Ackerbau oder Viehhaltung betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5c81e3-40d1-4bf0-a864-8abadd06b0ae",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "Mein Vater war Bauer, er hat nun aber seinen Hof verkauft."
                                            },
                                            {
                                                "example_id": "102c1961-6dd5-4adb-ad78-c7193316c0ed",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Eine Million Tonnen Äpfel ernten deutsche Bauern pro Jahr.“"
                                            },
                                            {
                                                "example_id": "5af08d67-fd70-48d9-b727-6dac37a0e33e",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Besonders unsere Gutsleute, aber auch manche Bauern sind um uns bemüht, als wollten sie gegen die neuen Machthaber demonstrieren.“"
                                            },
                                            {
                                                "example_id": "3ba1cac4-2fe2-49ad-91f1-0d2b5a356696",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Der Bauer stand mit seiner Familie allein und bedrückt in einer Ecke, da er keine Schmeichler hatte, weder Freunde noch versteckte Feinde.“"
                                            },
                                            {
                                                "example_id": "6593f0af-8c0d-4b9c-b210-2fccf3ff2664",
                                                "sense_id": "007bab78-5675-3081-9745-5b09ba213ad8",
                                                "text": "„Wie der Bauer nicht ohne sein Ackergerät oder Vertreter anderer Berufe ohne ihr spezielles Handwerkszeug, so kommen Wissenschaftler wie Techniker und überhaupt Fachleute aller Disziplinen nicht ohne eine genau definierte Begrifflichkeit aus: eben ihre von Fach zu Fach verschiedene Terminologie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbfbbdd0-0c93-3a0d-8d54-372e1c2fbf2d",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "in Ständegesellschaften Angehöriger des Bauernstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1810c0c8-5ea0-4762-a180-66067fd9de08",
                                                "sense_id": "bbfbbdd0-0c93-3a0d-8d54-372e1c2fbf2d",
                                                "text": "Die Bauern probten den Aufstand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c0bcc91b-89b0-3d07-84a2-f644965940bc",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "Mensch mit schlechten Manieren"
                                        ],
                                        "tags": [
                                            "Schimpfwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07474465-d49b-42f7-8f6e-8689896b4210",
                                                "sense_id": "c0bcc91b-89b0-3d07-84a2-f644965940bc",
                                                "text": "Bedank' dich mal, du Bauer!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f2b02869-effd-3224-bef6-f78a843fde03",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "schwächste der Schachfiguren"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33ede86a-206a-428b-a155-1804e421e74c",
                                                "sense_id": "f2b02869-effd-3224-bef6-f78a843fde03",
                                                "text": "„Eine kleines Land hatte gegenüber einer Großmacht die Initiative ergriffen und die Welt wissen lassen, daß es sich im Schachspiel der europäischen Machtpolitik nicht als bloßer Bauer mißbrauchen lassen wollte.“"
                                            },
                                            {
                                                "example_id": "0051bd2d-e5d0-4f75-b2b7-3498fef46ec1",
                                                "sense_id": "f2b02869-effd-3224-bef6-f78a843fde03",
                                                "text": "Weiß zieht seinen Bauern von e2 nach e4."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fea17f1d-97ab-3306-8b7d-53bec16a9e00",
                                        "entry_id": "c18475f1-9fa4-3a4c-82f6-673473763031",
                                        "glosses": [
                                            "der Bube oder Unter in verschiedenen Kartenspielen"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1388b76-df2b-4826-978d-280964468a6b",
                                                "sense_id": "fea17f1d-97ab-3306-8b7d-53bec16a9e00",
                                                "text": "Sieben, Neune, Bauer, steht wie eine Mauer."
                                            },
                                            {
                                                "example_id": "e2d67c29-1172-4700-a323-512d0a5345f5",
                                                "sense_id": "fea17f1d-97ab-3306-8b7d-53bec16a9e00",
                                                "text": "Holger sollte jetzt den Bauern abwerfen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab84904e-7cf1-36bd-b086-09b383c7e0f8",
                                        "entry_id": "120c5ada-ad8a-34e5-8fc9-4d252421a58f",
                                        "glosses": [
                                            "Person, die etwas errichtet/baut/herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e540264c-878a-4ad9-b4af-316bd4362371",
                                                "sense_id": "ab84904e-7cf1-36bd-b086-09b383c7e0f8",
                                                "text": "Der Bauer dieser schönen Orgel ist seit Jahren gestorben, aber sein Werk überlebt ihn."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                        "entry_id": "4291ea82-2fc0-3ca4-b7d5-d6bcb501c151",
                                        "glosses": [
                                            "Vogelkäfig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e4ca59-2cf7-40df-baa1-34d4c9c3e66a",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "Der Vogel sitzt im Bauer."
                                            },
                                            {
                                                "example_id": "00b4dcd0-3fe6-4363-9126-82951af3b0bd",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "„Unter zärtlichen Beschwichtigungen brachte sie den aufgebrachten Papagei in ihre Wohnung, verschloß sorgfältig alle Fenster und ließ den Exoten aus dem Bauer schlüpfen.“"
                                            },
                                            {
                                                "example_id": "1903e22a-6a86-44df-96dd-ca68b63e9ce4",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "„Dann aber verschwanden die Frauen plötzlich und sprangen hinauf in ihren gewohnten Bauer mit den vergitterten Fenstern.“"
                                            },
                                            {
                                                "example_id": "171eadd2-c66d-4160-950e-cef802bbe97b",
                                                "sense_id": "9e334f0b-2886-31ae-9249-b7d596a665cb",
                                                "text": "„Eine Frau in einem karierten Umhängetuch trug vorsichtig einen Bauer mit einem Papageien weit ausgestreckt vor sich her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                        "entry_id": "b8e7cb82-caf1-39ce-9013-7255ef9c0c26",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0828783f-6695-4904-873a-05248f14d8e3",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Ich möchte Frau Bauer bitten, nach vorne zu kommen."
                                            },
                                            {
                                                "example_id": "ee6cfd33-d119-4d4d-a4b3-69582439f635",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Frau Bauer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "f308b5f4-ad7c-4a20-a3e3-64a7bc95b7a2",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Herr Bauer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "f46ff882-685e-4941-a547-05951c61a3a8",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Die Bauers fahren heute ins Sauerland."
                                            },
                                            {
                                                "example_id": "f6e6fb1c-d5af-4a0c-bd4e-647dfc612037",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Der Bauer trägt nie die Schals, die die Bauer ihm strickt."
                                            },
                                            {
                                                "example_id": "27294cd5-3c58-40bc-b0a2-dba258bb81c4",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bauer kommt, geht der Herr Bauer.“"
                                            },
                                            {
                                                "example_id": "db73c510-e9b8-45df-846b-25610a5e6298",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Bauer kommt und geht."
                                            },
                                            {
                                                "example_id": "d6bafc85-ca51-48c3-b5ac-5ddf5a78228c",
                                                "sense_id": "c8481dda-3b36-3d37-b4b0-3ff84c5325a9",
                                                "text": "Bauers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28108258-089e-4406-ba47-bebe2502a0c9",
                        "source_entry_id": "05b48e2f-c2aa-33e2-a9f7-e0919222194a",
                        "source_sense_id": "0bc071e8-0f65-3ac7-88f7-84ab37c5364b",
                        "source_sense_description": "een persoon die dingen bouwt",
                        "target_lang_word": "builder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "builder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f05f69e-736f-3711-9ca1-fb034cc5907f",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "One who builds or constructs things."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7865ca8-e777-3293-a867-20ecf089d7a4",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "Master artisan, who receives his instructions from the architect, and employs workers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "Software that allows the user to create a certain kind of (often automated) output."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d267eb9-1e8f-439f-8eb3-b1fd556a5b25",
                                                "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                                "text": "To cut coding time and to insure maintainability of the algorithms, an \"algorithm builder tool\" was constructed."
                                            },
                                            {
                                                "example_id": "47571c3b-a2f4-4974-bafe-5751df544be8",
                                                "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                                "text": "A map builder uses map layers from several sources and adds data to make a custom map."
                                            },
                                            {
                                                "example_id": "8e858f5a-9124-4693-9d33-192843b7cd8d",
                                                "sense_id": "8ce0e7f2-4d53-3ff5-932c-91c6b36b7fdc",
                                                "text": "Many users may find this easier to use as each field is clearly displayed and the user interface provides a formula builder and a Check formula function."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3735f86a-9971-37fd-a2d8-19a591ebb208",
                                        "entry_id": "7f2627f0-d83c-3e56-825b-c84ba4d55bfc",
                                        "glosses": [
                                            "Clipping of bodybuilder."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "513f63e5-e3a6-410d-a092-2caa37268f9d",
                                                "sense_id": "3735f86a-9971-37fd-a2d8-19a591ebb208",
                                                "text": "In the competitions, bodybuilders go through \"mandatories\"—a set of mandatory poses—in the morning, where the judges compare the body parts of the builders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "847c5efe-2b30-4c93-ad26-02875894903f",
                        "source_entry_id": "05b48e2f-c2aa-33e2-a9f7-e0919222194a",
                        "source_sense_id": "0bc071e8-0f65-3ac7-88f7-84ab37c5364b",
                        "source_sense_description": "een persoon die dingen bouwt",
                        "target_lang_word": "constructeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constructeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58ef78ed-24b1-3a38-bd17-d5671fcb0fae",
                                        "entry_id": "e373bd1a-56dd-3019-86b5-a12e71da3b0e",
                                        "glosses": [
                                            "Celui (homme, entreprise, ou animal) qui construit, qui sait et qui pratique l’art de construire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d8dd18-0434-45bf-9e81-011ae895adfa",
                                                "sense_id": "58ef78ed-24b1-3a38-bd17-d5671fcb0fae",
                                                "text": "Il serait toutefois désirable que le constructeur étalonnât chaque instrument avec un pyrhéliomètre donnant des valeurs absolues."
                                            },
                                            {
                                                "example_id": "1683888b-f80e-4159-ba4c-967521a2cd8a",
                                                "sense_id": "58ef78ed-24b1-3a38-bd17-d5671fcb0fae",
                                                "text": "Pourquoi deux poids, deux mesures ? Pourquoi certains contrôles techniques sont-ils imposés tyranniquement à certains constructeurs et non à d'autres ?"
                                            },
                                            {
                                                "example_id": "74422d65-ef0b-4d1a-8fca-1374121448f6",
                                                "sense_id": "58ef78ed-24b1-3a38-bd17-d5671fcb0fae",
                                                "text": "La longueur de la barre de 3ᵉ point détermine l’horizontalité de l’appareil. Suivre les recommandations du constructeur pour la régler."
                                            },
                                            {
                                                "example_id": "6c085de5-3526-451d-acda-b8f769f14da0",
                                                "sense_id": "58ef78ed-24b1-3a38-bd17-d5671fcb0fae",
                                                "text": "Sans doute étonné par l'absence de nouvelles de Ned, George Brough, le constructeur de motocyclettes, lui a proposé, il y a quelques semaines, la dernière-née de ses ateliers : une nouvelle version du modèle Brough SS 100."
                                            },
                                            {
                                                "example_id": "0f0c81aa-09e5-45f3-8b07-b3a2d7ce2211",
                                                "sense_id": "58ef78ed-24b1-3a38-bd17-d5671fcb0fae",
                                                "text": "Le nid d’un mâle de Crenilabrus pavo, établi non loin de celui du Crénilabre à cinq tâches observé, fut dévalisé en quelques minutes, probablement par des Blennies, après la capture du constructeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca583fc5-a8b1-3ffe-81c3-7e9fc7c47890",
                                        "entry_id": "e373bd1a-56dd-3019-86b5-a12e71da3b0e",
                                        "glosses": [
                                            "Méthode de classe utilisée pour créer et initialiser les instances."
                                        ],
                                        "tags": [
                                            "Au masculin",
                                            "Programmation orientée objet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f04162c-4968-42cd-a7ad-a9bb8623e539",
                                                "sense_id": "ca583fc5-a8b1-3ffe-81c3-7e9fc7c47890",
                                                "text": "Toutes les classes possèdent au minimum deux méthodes : le constructeur et le destructeur."
                                            },
                                            {
                                                "example_id": "bf69055a-578c-4480-83ee-cda394f000c6",
                                                "sense_id": "ca583fc5-a8b1-3ffe-81c3-7e9fc7c47890",
                                                "text": "C++ offre un mécanisme très performant pour traiter ces problèmes : le constructeur. Il s’agit d’une fonction membre […] qui sera appelée automatiquement à chaque création d’un objet. […]\nPar convention, le constructeur se reconnaît à ce qu’il porte le même nom que la classe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "constructeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95524ca7-4aa6-3c44-b87e-dfe486783603",
                                        "entry_id": "4515ffd0-262d-3443-bd14-9fef3337876b",
                                        "glosses": [
                                            "Qui construit, qui sait et qui pratique l’art de construire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b5687bd-69f9-4ac5-a4f1-5c2b1a07be3d",
                                                "sense_id": "95524ca7-4aa6-3c44-b87e-dfe486783603",
                                                "text": "Evincé d'Apple en 1985, il crée ensuite NeXT, société constructrice d'ordinateurs pour le secteur éducatif, et rachète à George Lucas un obscur studio d'animation spécialisé dans la technologie balbutiante des images de synthèse."
                                            },
                                            {
                                                "example_id": "4b7c4f71-9a95-4a57-9377-56e211a24ca6",
                                                "sense_id": "95524ca7-4aa6-3c44-b87e-dfe486783603",
                                                "text": "Rencontre d’une famille touareg ou mieux touareguisée, car les habitants sont fortement métissés de Soudanais, pêche de poissons dans les gueltas ou sources naturelles, poissons aujourd’hui déposés au Musée d’histoire naturelle, activités artisanales dans l’oasis de Djanet, centre administratif de cette région, au milieu d’une oasis d’un million de dattiers et où le génie constructeur de l’officier commandant le cercle a donné une impulsion à l’urbanisme du meilleur type européen, voies larges et alignements d’arbres, toutes ces scènes adoucirent l’aspect dur du paysage où les aiguilles et pitons, anciens bouchons de volcans détruits émergent de plaines de sable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
