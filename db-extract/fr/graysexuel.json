                "senses": [
                    {
                        "sense_id": "bd5d59e7-77fa-36a1-84db-fbdfb75963d4",
                        "entry_id": "21b2085b-7d90-36a8-b0ea-927579843d00",
                        "glosses": [
                            "Qualifie un état intermédiaire entre sexuel et asexuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb1dda5-82a2-4d8a-b9de-bf9fa1023f97",
                                "sense_id": "bd5d59e7-77fa-36a1-84db-fbdfb75963d4",
                                "text": "— Je devrais leur mentir et dire que je suis lesbienne, vu qu'ils n'ont sans doute aucune idée de ce que graysexuel veut dire, a-t-elle marmonné."
                            },
                            {
                                "example_id": "b93209fa-f37e-4a16-acc3-177559f70df0",
                                "sense_id": "bd5d59e7-77fa-36a1-84db-fbdfb75963d4",
                                "text": "Une personne graysexuelle se situe entre l'asexualité et la sexualité. Elle peut aussi se dire en même temps gay, hétéro ou toute autre identité sexuelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33ae9a81-7aef-44c6-84a8-79d5c96628a8",
                        "source_entry_id": "21b2085b-7d90-36a8-b0ea-927579843d00",
                        "source_sense_id": "bd5d59e7-77fa-36a1-84db-fbdfb75963d4",
                        "target_lang_word": "graysexual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graysexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86880442-fc5c-399c-af26-4ece9afa8fea",
                                        "entry_id": "ada204bc-6011-3ab1-9b71-4bf8d19924a9",
                                        "glosses": [
                                            "Intermediate between sexual and asexual; sometimes, but not usually, experiencing sexual attraction and desire."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30a6bbf4-3b6e-4165-a8ca-2b9198bc6cb4",
                                                "sense_id": "86880442-fc5c-399c-af26-4ece9afa8fea",
                                                "text": "But then I remember: the whole ethos of sex-positivity is predicated on a belief that everyone—sexual, asexual, or gray-sexual; monogamous, polyamorous, or something in-between; LGBTQ or as hetero as the Romneys—is entitled to pleasurable and safe sex."
                                            },
                                            {
                                                "example_id": "10cec084-1beb-4b7c-aec5-da83ccf16ebc",
                                                "sense_id": "86880442-fc5c-399c-af26-4ece9afa8fea",
                                                "text": "Some aces are gray-sexual (or gray-A), meaning that they fall somewhere on a spectrum between asexual and sexual."
                                            },
                                            {
                                                "example_id": "6e02c934-9c3d-4bac-a9a9-cfcf67a387a1",
                                                "sense_id": "86880442-fc5c-399c-af26-4ece9afa8fea",
                                                "text": "Do you feel sexual attraction sometimes, but only rarely? You may be graysexual,* and you’ll have a lot in common with asexual people if you are."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
