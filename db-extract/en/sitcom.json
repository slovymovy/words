                "senses": [
                    {
                        "sense_id": "c5a1c806-0ad6-3a13-96dc-b773d25e1713",
                        "entry_id": "6af45f25-8d13-31f4-a397-01117adeef4d",
                        "glosses": [
                            "Acronym of single income, two children, oppressive/outrageous mortgage."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3881ddf6-2a0a-4e38-9416-1601d82a40d4",
                                "sense_id": "c5a1c806-0ad6-3a13-96dc-b773d25e1713",
                                "text": "\"Today we have Grumps (grim, ruthless, upwardly mobile professionals), Dinks (those with dual-income, no kids), Sitcoms (those with single-income, two children, outrageous mortgages); and, just to recognize the graying populace in this country, Opals (older people with active lifestyles).\""
                            },
                            {
                                "example_id": "b68778e0-00ec-4fd2-82e2-f050e33f337a",
                                "sense_id": "c5a1c806-0ad6-3a13-96dc-b773d25e1713",
                                "text": "\"There are MINKs (multiple income, no kids) and what may be the acronym of the '90s, SITCOMs (single income, two children, outrageous mortgage).\""
                            },
                            {
                                "example_id": "886c6de0-abf0-40c5-814a-dcc1511f4af1",
                                "sense_id": "c5a1c806-0ad6-3a13-96dc-b773d25e1713",
                                "text": "\"By the end of the 1990s, in some circles, parents had become SITCOMS (single income, two children, oppressive mortgage) and those without children were THINKERS (two healthy incomes, no kids, early retirement).\""
                            }
                        ]
                    }
                ],
