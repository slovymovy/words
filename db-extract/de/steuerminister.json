                "senses": [
                    {
                        "sense_id": "4723428b-1c17-3b9f-8a64-75962070ade9",
                        "entry_id": "e5001ff4-1809-370d-b9cc-f36b5f7f88d2",
                        "glosses": [
                            "Minister für Steuern und Abgaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b541557-0b93-4eee-9d4e-34bd0f3b82bf",
                                "sense_id": "4723428b-1c17-3b9f-8a64-75962070ade9",
                                "text": "„Kopenhagen (Reuter) - Der dänische Steuerminister Ole Stavad ist am Dienstag zurückgetreten.“"
                            },
                            {
                                "example_id": "fdf51143-4f7f-4d5c-b7de-4333849de706",
                                "sense_id": "4723428b-1c17-3b9f-8a64-75962070ade9",
                                "text": "„Steuerminister Peter Christensen kündigte am Freitag an, seine Regierung werde ihre Pläne nicht auf Eis legen.“"
                            },
                            {
                                "example_id": "a0a252bc-d306-4484-acd1-b160e479b250",
                                "sense_id": "4723428b-1c17-3b9f-8a64-75962070ade9",
                                "text": "„ Zch (sic) habe die Meinung auch heute noch, und ich bin persönlich der Ansicht, -- über die Gründe, die zum Scheitern nach der Richtung führten, im einzelnen mag man sich streiten, wie man will, in der Hauptsache triff das, was ich gesagt habe, die Sache, -- es ist auf weiter nichts angekommen, als einen Steuerminister zu erhalten für neue Steuern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
