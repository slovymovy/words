    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                "word": "cosmology",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fb64353e-6948-44b8-90ab-ba34d296b438",
                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                        "tags": [
                            "plural"
                        ],
                        "form": "cosmologies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2899fca-fcfb-3aa0-90da-522501541222",
                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                        "glosses": [
                            "The study of the physical universe, its structure, dynamics, origin and evolution, and fate."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "295dca74-bc2f-49e2-8cdf-584135bbe2a1",
                                "sense_id": "e2899fca-fcfb-3aa0-90da-522501541222",
                                "text": "We live our lives in three dimensions for our threescore and ten allotted years. Yet every branch of contemporary science, from statistics to cosmology, alludes to processes that operate on scales outside of human experience: the millisecond and the nanometer, the eon and the light-year."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bf8f996-0490-3eb0-9880-f8188d1c3cdc",
                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                        "glosses": [
                            "A metaphysical study into the origin and nature of the universe."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "254f0cd1-592c-3d64-8275-e3719af6a3b5",
                        "entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
                        "glosses": [
                            "A particular view (cultural or religious) of the structure and origin of the universe."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ebcea706-3471-48e0-b984-bbc4da7fd87f",
                                "sense_id": "254f0cd1-592c-3d64-8275-e3719af6a3b5",
                                "text": "Near-synonyms: cosmovision, worldview"
                            },
                            {
                                "example_id": "7245a640-a420-4b6f-bf74-e13b37d08dad",
                                "sense_id": "254f0cd1-592c-3d64-8275-e3719af6a3b5",
                                "text": "But the work of Marshack and Leroi-Gourhan enable us to see that these later religions of the civilized period are elaborations of the cosmologies from the universal religion of the Upper Paleolithic."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77c4078d-9e12-4126-812e-fbe1a9f47bcd",
                        "source_entry_id": "9f974fdc-ea43-3953-8609-e99b0798a355",
