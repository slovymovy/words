                                "sense_id": "9fa3f3b3-fc6e-3be7-9289-6bc0515d8b8c",
                                "text": "Ginekologia, jedna z dziedzin medycyny, jest nierozerwalnie związana z położnictwem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
