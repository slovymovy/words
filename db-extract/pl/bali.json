                                            {
                                                "example_id": "08429b48-e451-4639-b422-6fa97378a717",
                                                "sense_id": "75ecde6a-0ae3-345d-b1e6-f3c966422491",
                                                "text": "Riding along the busy, narrow roads of Bali on her scooter with the sun illuminating her face, Victoria Kjos has a clear destination in sight — the beach."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
