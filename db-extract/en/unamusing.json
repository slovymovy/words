                                        "entry_id": "979252f8-da97-36f4-808c-d93e4594143c",
                                        "glosses": [
                                            "Ennuyeux ; inintéressant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2cdf84d-e81e-4f78-a824-1acae54a1f5f",
                                                "sense_id": "31a088c9-0bcb-3b4f-93fa-13b4e33cba0b",
                                                "text": "Je n’ai pas dépassé les trente premières pages, je trouve ça barbant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cb45d2f-25b7-3d10-852d-c412718adb0b",
                                        "entry_id": "979252f8-da97-36f4-808c-d93e4594143c",
                                        "glosses": [
                                            "Gênant ; irritant ; casse-pied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a34f6ab3-04dc-415d-aa41-f0bb6e01b192",
                                                "sense_id": "1cb45d2f-25b7-3d10-852d-c412718adb0b",
                                                "text": "L'a remplacée un petit bonhomme sans un poil sur le caillou, qui m'a bombardée de questions carrément barbantes, comme mes rêves, ma vie sexuelle et j’en passe."
                                            },
                                            {
                                                "example_id": "0d1e29ee-bc30-41d5-a1bf-d4e5bfa43ba9",
                                                "sense_id": "1cb45d2f-25b7-3d10-852d-c412718adb0b",
                                                "text": "Elle veut tout savoir, tout régenter, c’est barbant !"
                                            }
                                        ]
                                    }
                                ]
