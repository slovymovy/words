                "senses": [
                    {
                        "sense_id": "5a06d6fb-d7bc-3c1f-a318-0625a6632dc4",
                        "entry_id": "c3ab7fe8-46aa-3d33-9648-bc44abac549d",
                        "glosses": [
                            "техн., комп. перевод информации в другую форму с помощью кода — особого свода правил"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6662eedc-af6a-4e49-95f0-903803e90b4b",
                                "sense_id": "5a06d6fb-d7bc-3c1f-a318-0625a6632dc4",
                                "text": "Суть даже не в том, что обычный рядовой пользователь не понимает принципы кодирования."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbd073db-844f-3bfa-a2c1-e6d27557ac97",
                        "entry_id": "c3ab7fe8-46aa-3d33-9648-bc44abac549d",
                        "glosses": [
                            "мед. психотерапевтическая методика, эффективно работающая с подверженными гипнозу пациентами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6ba0e5a-d984-4eff-b845-76b261c6d89f",
                                "sense_id": "bbd073db-844f-3bfa-a2c1-e6d27557ac97",
                                "text": "Надо понять, что психотерапевтическое кодирование — это не лечение алкоголизма, а прерывание запоя на установленный срок."
                            }
                        ]
                    }
