    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66d58746-4b2d-3b4b-b7f0-e9f3d31bc605",
                    "sense_definition": "Partie qui se trouve au dedans d'un lieu, d'un objet ou d'un espace ; le dedans.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "partie du dedans",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il pleut dehors, alors nous restons à l'<w>intérieur</w> de la maison."
                        },
                        {
                            "text": "L'<w>intérieur</w> de la boîte est tapissé de velours rouge."
                        }
                    ],
                    "antonyms": [
                        "extérieur",
                        "dehors"
                    ],
                    "common_phrases": [
                        "à l'intérieur",
                        "à l'intérieur de"
                    ]
                },
                {
                    "sense_id": "d3c0d94b-dd0a-36eb-a10b-0fabba1be51c",
                    "sense_definition": "Partie interne d'une construction ou d'un véhicule, en particulier son aménagement et sa décoration.",
