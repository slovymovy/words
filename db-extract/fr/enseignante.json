                "senses": [
                    {
                        "sense_id": "23bb9dcd-36fa-37cc-95a3-f7b5b889b22f",
                        "entry_id": "85348725-a329-33aa-bdc0-1fea842742a0",
                        "glosses": [
                            "Celle qui est chargée d’enseigner aux autres."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "b1ca8013-3802-4c89-aeba-cafec77edc52",
                                "sense_id": "23bb9dcd-36fa-37cc-95a3-f7b5b889b22f",
                                "text": "On peut remarquer, à ce sujet, que la voix féminine de l’enseignante est généralement considérée comme moins « efficace » que la voix masculine parce que porteuse de moins de « puissance virile »."
                            },
                            {
                                "example_id": "0a7dabd0-60bc-4623-894a-50a67b4d170a",
                                "sense_id": "23bb9dcd-36fa-37cc-95a3-f7b5b889b22f",
                                "text": "Les enseignantes ont également participé à ces remises."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f9749df-95e3-431e-a696-7f957b3c1530",
                        "source_entry_id": "85348725-a329-33aa-bdc0-1fea842742a0",
                        "source_sense_id": "23bb9dcd-36fa-37cc-95a3-f7b5b889b22f",
                        "target_lang_word": "Lehrerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lehrerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                        "entry_id": "a4980a55-6d47-3309-aef8-2c34003bf9ca",
                                        "glosses": [
                                            "Vermittlerin von Wissen, die im Allgemeinen auch mit einem Erziehungsauftrag ausgestattet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d7fb83-d550-4497-90ac-bddf10ba550e",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "Die Lehrerin erklärt mir die Grundrechenarten."
                                            },
                                            {
                                                "example_id": "48b9274f-400d-4fc7-9b05-558e848ba3e7",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Ihre jungen Lehrerinnen mit ihren Kopftüchern und fußlangen Mänteln versuchten kichernd, die Lage zu beruhigen, halb gerührt, halb verschämt, halb stolz auf ihre Schüler, halb entschuldigend.“"
                                            },
                                            {
                                                "example_id": "df4a19c1-c098-480a-898b-76058037951e",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Lehrerin war sie, im Osten Deutschlands.“"
                                            },
                                            {
                                                "example_id": "3cb55f61-32bb-427e-b4b1-a93f047a0e94",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Die Lehrerinnen schauten ihre neue Kollegin nur an – resigniert und ein bisschen mitleidig.“"
                                            },
                                            {
                                                "example_id": "eafbf4fd-0f89-48cd-ae0b-2ab270beef39",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Das fand meine Lehrerin weniger lustig.“"
                                            },
                                            {
                                                "example_id": "9711f425-2aab-427c-8772-3d752df2d7f7",
                                                "sense_id": "67424440-85f4-3c45-b852-9f9a8c4c77e6",
                                                "text": "„Die Kirche sei unser Verein, unsere Lehrerin und Lenkerin[.]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
