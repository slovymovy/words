                "senses": [
                    {
                        "sense_id": "5c62dc4e-d98f-334e-850d-f8ba3cfe1b88",
                        "entry_id": "9cebb1c1-7a73-37c8-80f2-37fc5b808fb9",
                        "glosses": [
                            "militärische Unternehmung, Aktion mit militärischen Mitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b70f47c3-319c-4a20-9ce4-a55caeadef1e",
                                "sense_id": "5c62dc4e-d98f-334e-850d-f8ba3cfe1b88",
                                "text": "„Nur wenige Stunden, nachdem sein Vater in der Zeitung von der Militäroperation gelesen hatte, wurde er nach Haifa ins Krankenhaus gerufen.“"
                            },
                            {
                                "example_id": "cbe72865-99e0-4a8f-846f-14ec1011b130",
                                "sense_id": "5c62dc4e-d98f-334e-850d-f8ba3cfe1b88",
                                "text": "„Caro Quintero konnte es nicht fassen, dass ihm bei all dem Geld, das er investiert hatte, um die Maschinerie zu ölen und Polizei und Armee zu bestechen, eine derartige Militäroperation entgangen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
