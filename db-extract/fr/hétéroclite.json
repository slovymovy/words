                        "target_lang_word": "verschiedenartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschiedenartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d79fa5b8-22fa-32db-bbe3-56358a0431de",
                                        "entry_id": "222e86f9-158c-352c-8c4e-da036d5ca39a",
                                        "glosses": [
                                            "von verschiedener Beschaffenheit; Merkmale unterschiedlicher Art aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9770e87-e9a7-43eb-a930-1afd083dec3c",
                                                "sense_id": "d79fa5b8-22fa-32db-bbe3-56358a0431de",
                                                "text": "Zwar hatte er in seinem Werkzeugkoffer eine gewisse Anzahl verschiedenartiger Geräte, doch just das passende war nicht dabei."
                                            },
                                            {
                                                "example_id": "5cd9e80e-9c9e-4769-95ca-1dae4d760b4e",
                                                "sense_id": "d79fa5b8-22fa-32db-bbe3-56358a0431de",
                                                "text": "„Das Schöne ist ein Urphänomen, das zwar nie selber zur Erscheinung kommt, dessen Abglanz aber in tausend verschiedenen Äußerungen des schaffenden Geistes sichtbar wird, und so mannigfaltig und so verschiedenartig ist als die Natur selber.“"
                                            },
                                            {
                                                "example_id": "33965ede-fb6f-42ce-837c-95eed581ba02",
                                                "sense_id": "d79fa5b8-22fa-32db-bbe3-56358a0431de",
                                                "text": "„Die meisten glauben jedoch, dass sich das Leben auf der Erde mit der Zunahme immer verschiedenartigerer und komplexerer, Kohlenstoff enthaltender chemischer Stoffe langsam in geschützten Umgebungen entwickelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
