                ],
                "senses": [
                    {
                        "sense_id": "64c8f212-82ff-3263-b349-f4613349c0f6",
                        "entry_id": "8c216cb1-8f58-3124-9ebc-1abbe7dacc6e",
                        "glosses": [
                            "Adapter des images d’une certaine résolution pour être vues à une plus haute résolution."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a5863f98-65f6-4e82-a581-e30a0b976144",
                                "sense_id": "64c8f212-82ff-3263-b349-f4613349c0f6",
                                "text": "Un lecteur Blue-Ray, meilleur pour upscaler des DVD ?"
                            },
                            {
                                "example_id": "cde950a3-49fd-4bcf-abb8-5a8f23785a0c",
                                "sense_id": "64c8f212-82ff-3263-b349-f4613349c0f6",
                                "text": "Dépaysement garanti d’autant plus que les paysages sont superbes et que sur Xbox One S, le jeu est « upscalé » pour un meilleur rendu sur les téléviseurs compatibles 4K (s’ajoute à cela une optimisation HDR)."
                            },
                            {
                                "example_id": "a25e3c51-c552-400b-a4e8-7b99cac124dd",
                                "sense_id": "64c8f212-82ff-3263-b349-f4613349c0f6",
                                "text": "Smillaenlarger: logiciel pour upscaler une partie de photo"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d0240e8-82c0-4de7-b389-0ddf53036040",
                        "source_entry_id": "8c216cb1-8f58-3124-9ebc-1abbe7dacc6e",
                        "source_sense_id": "64c8f212-82ff-3263-b349-f4613349c0f6",
                        "target_lang_word": "upscale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "upscale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9393884d-7b30-333a-be2a-d22af04249e3",
                                        "entry_id": "825e6564-3c50-3901-95b4-a2da8ef602bf",
                                        "glosses": [
                                            "Expensive and designed to appeal to affluent consumers."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3738bfd7-b9e8-43fe-84c0-9b1011b84f32",
                                                "sense_id": "9393884d-7b30-333a-be2a-d22af04249e3",
                                                "text": "For example, a good location for resale, such as an upscale suburb of new homes, will cost more money than a piece of land in an established neighborhood of small, postwar houses."
                                            },
                                            {
                                                "example_id": "3aa9acc0-c93e-4f7e-b1d8-7418e615f695",
                                                "sense_id": "9393884d-7b30-333a-be2a-d22af04249e3",
                                                "text": "In Rio de Janeiro, thousands protested in a gritty area far from the city’s upscale seaside districts. In other cities, demonstrators blocked roads, barged into City Council meetings or interrupted sessions of local lawmakers, clapping loudly and sometimes taking over the microphone."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "upscale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e884aa21-ee0c-3b5e-8f87-78c5a00d7da4",
                                        "entry_id": "9df33329-e08c-3e8a-ac23-8b943fd4272d",
                                        "glosses": [
                                            "To increase in size, to scale up."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
