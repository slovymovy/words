                        "entry_id": "394aed81-a04d-3838-b956-cf6381ea43e5",
                        "glosses": [
                            "marynowana wołowina naszpikowana słoniną, następnie pieczona lub duszona"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e32d32d-76dc-449b-9a7b-87c9baa1f618",
                                "sense_id": "370103e0-71d8-3dde-92b3-ccb82d835c9a",
                                "text": "Czy jadłeś dziś sztufadę z makaronem"
                            },
                            {
                                "example_id": "d35e460d-8b2a-480b-ab67-01a6ffc374b0",
                                "sense_id": "370103e0-71d8-3dde-92b3-ccb82d835c9a",
                                "text": "Probuję sztufady… Ależ ja podobnego mięsa nie kosztowałem jak żyję"
                            },
                            {
                                "example_id": "3e872802-63c2-48c0-bcd2-dc2f837dc72a",
                                "sense_id": "370103e0-71d8-3dde-92b3-ccb82d835c9a",
                                "text": "Był to spory kawałek chleba, grubo posmarowany masłem, a z wierzchu nakryty płatem sztufady"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
