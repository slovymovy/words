                    {
                        "sense_id": "1d34f6ff-296e-3204-bfa1-018726d06823",
                        "entry_id": "ce13e622-bdc8-33ce-9741-c766b720caef",
                        "glosses": [
                            "brief waarin staat dat men aan een verplichting dient te voldoen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf3352b4-2452-4436-ad8d-d0cecc453679",
                                "sense_id": "1d34f6ff-296e-3204-bfa1-018726d06823",
                                "text": "De tegenprestatie die Nederland verlangt van buitenlandse bedrijven waarbij het defensiematerieel inkoopt, is onwettig. Dat schrijft de Europese Commissie in een aanmaningsbrief aan Den Haag. De minister van Defensie heeft twee maanden de tijd om te reageren."
                            },
                            {
                                "example_id": "954806a1-417f-4c1b-8906-f0023b866c4a",
                                "sense_id": "1d34f6ff-296e-3204-bfa1-018726d06823",
                                "text": "De stap die de Europese Commissie nu neemt is de eerste stap. Het betekent dat er een soort aanmaningsbrief wordt gestuurd waarin de lidstaat wordt gevraagd om informatie over de stand van zaken te verstrekken."
                            }
                        ]
                    }
