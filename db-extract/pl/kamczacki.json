                                        "examples": [
                                            {
                                                "example_id": "5b53ffd6-42a8-4820-b541-90333c119f00",
                                                "sense_id": "bb1bf34d-f301-316a-8f10-8d00408a0707",
                                                "text": "В церковном отношении Сахалин составляет часть епархии епископа камчатского, курильского и благовещенского."
                                            },
                                            {
                                                "example_id": "5793b40b-5eb4-4122-bc6a-57a1ca3f2c1f",
                                                "sense_id": "bb1bf34d-f301-316a-8f10-8d00408a0707",
                                                "text": "Сейчас же остановимся на прологе к Великой Северной экспедиции — первой камчатской экспедиции Беринга."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffca4ef9-fca0-3ef0-98e8-0d846679973e",
                                        "entry_id": "280dab0c-872e-3cf5-8544-fd1834f71ee6",
                                        "glosses": [
                                            "расположенный, произрастающий, обитающий на Камчатке (полуострове в Восточной Сибири)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfa4053b-a531-46aa-86af-7d19ead41e26",
                                                "sense_id": "ffca4ef9-fca0-3ef0-98e8-0d846679973e",
                                                "text": "Чукотские собаки менее ростом и слабее колымских и камчатских."
                                            },
                                            {
                                                "example_id": "7a8941ff-113a-4f89-b65d-905e6b3a7e21",
                                                "sense_id": "ffca4ef9-fca0-3ef0-98e8-0d846679973e",
                                                "text": "Потом я заметил камчатскую чёрную трясогузку — грациозную и наивную птичку."
                                            },
                                            {
                                                "example_id": "ac0a394c-5f78-4813-afda-6295233de86b",
                                                "sense_id": "ffca4ef9-fca0-3ef0-98e8-0d846679973e",
                                                "text": "А без таких лыж в камчатскую тундру лучше не соваться."
                                            }
                                        ]
                                    }
