                                "target_senses": [
                                    {
                                        "sense_id": "ae77eadd-4be1-3972-aa28-1d04b4aae2ae",
                                        "entry_id": "860fe176-fa79-3e88-9ee6-8703d264fbc5",
                                        "glosses": [
                                            "světová strana ležící mezi jihem a východem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd1396a-97a8-47e6-bfdf-86c889aa98d8",
                                                "sense_id": "ae77eadd-4be1-3972-aa28-1d04b4aae2ae",
                                                "text": "Na jihovýchod vybíhá nejživější ulice Ferdinandova s četnými závody obchodními s farním kostelem sv. Maří Magdaleny při býv. klášteře františkánském z r. 1451, a finanční zemské ředitelství."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "600f7809-102b-42a0-9775-94aa8a9322ab",
                        "source_entry_id": "015d2f64-bfa4-3648-8569-73bf9d4ec7a6",
                        "source_sense_id": "46c147a8-61a3-304b-918f-4e1d3c8f7045",
