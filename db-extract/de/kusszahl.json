                "senses": [
                    {
                        "sense_id": "4d71c795-f4e6-3793-8558-8fa97b8865c1",
                        "entry_id": "42a8dd9e-bfb7-3723-8c42-2f21ef582b53",
                        "glosses": [
                            "die maximale Anzahl an n-dimensionalen Kugeln mit gleichem Radius, die gleichzeitig eine weitere Kugel (mit demselben Radius) im euklidischen Raum berühren können, ohne dass Überschneidungen auftreten"
                        ],
                        "tags": [
                            "Mathematik; n-te Kusszahl"
                        ],
                        "examples": [
                            {
                                "example_id": "814a036e-fde6-4ad3-b49f-582a25017295",
                                "sense_id": "4d71c795-f4e6-3793-8558-8fa97b8865c1",
                                "text": "Bisher sind nur wenige Kusszahlen bekannt."
                            },
                            {
                                "example_id": "81feb1a3-3c35-46a6-a15c-3c1740aadf22",
                                "sense_id": "4d71c795-f4e6-3793-8558-8fa97b8865c1",
                                "text": "Die 24. Kusszahl – d. h. die Kusszahl für die Dimension 24 – ist 196.560."
                            },
                            {
                                "example_id": "e647ab67-84ec-4fd2-9bc5-371263e33705",
                                "sense_id": "4d71c795-f4e6-3793-8558-8fa97b8865c1",
                                "text": "Für manche Kusszahlen sind eine obere und untere Schranke bekannt."
                            },
                            {
                                "example_id": "0befc119-eee8-4dee-8a40-a1da7b5ccd67",
                                "sense_id": "4d71c795-f4e6-3793-8558-8fa97b8865c1",
                                "text": "Es wird stark vermutet, dass das Wachstum der Kusszahlen exponentiell ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
