            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d7e4d68-cab8-3b79-9b44-09cace289365",
                    "sense_definition": "État d'une personne ou d'un peuple privé de liberté, réduit en esclavage ou soumis à une domination totale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soumission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce peuple a lutté pendant des décennies pour échapper à la <w>servitude</w> coloniale."
                        },
                        {
                            "text": "Les prisonniers ont été réduits en <w>servitude</w> après la défaite de leur armée."
                        }
                    ],
                    "synonyms": [
                        "esclavage",
                        "asservissement",
                        "captivité"
                    ],
                    "antonyms": [
                        "liberté",
                        "émancipation",
                        "indépendance"
                    ],
                    "common_phrases": [
                        "réduire en servitude",
                        "joug de la servitude"
                    ]
                },
                {
                    "sense_id": "a338a6bc-47e7-30bc-aa26-a55de44e2431",
                    "sense_definition": "Charge ou obligation imposée sur un bien immobilier pour l'usage ou l'utilité d'un autre bien.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'acte de vente mentionne une <w>servitude</w> de passage autorisant le voisin à traverser le jardin."
                        },
                        {
                            "text": "Il a demandé au tribunal la suppression de cette ancienne <w>servitude</w> devenue inutile."
                        }
                    ],
                    "common_phrases": [
                        "servitude de passage"
                    ]
                },
                {
                    "sense_id": "77f935c7-cec4-31d0-9b35-119ddb1ce05f",
                    "sense_definition": "Contrainte, obligation stricte ou dépendance imposée par une charge, un métier ou les circonstances.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contrainte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a accepté toutes les charges et les <w>servitudes</w> liées à son nouveau travail."
                        },
                        {
                            "text": "Ce métier passionnant comporte néanmoins certaines <w>servitudes</w> comme les horaires de nuit."
                        }
                    ],
                    "synonyms": [
                        "contrainte",
                        "sujétion",
                        "obligation"
                    ],
                    "common_phrases": [
                        "servitude militaire"
                    ]
                },
                {
                    "sense_id": "bbc863d1-11be-3e04-b300-1b157e856fab",
                    "sense_definition": "État d'une personne dominée ou aliénée par ses passions, ses désirs ou ses pulsions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "soumission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe décrit la difficile lutte de l'esprit contre la <w>servitude</w> des passions."
                        },
                        {
                            "text": "Son addiction au jeu le maintenait dans une douloureuse <w>servitude</w> morale."
                        }
                    ],
                    "synonyms": [
                        "aliénation",
                        "dépendance"
                    ]
                },
                {
                    "sense_id": "e4c71777-98fe-3c9a-b5bf-06ad1a8557bf",
                    "sense_definition": "Ensemble des réseaux ou équipements auxiliaires indispensables au fonctionnement normal d'un appareil ou d'un véhicule.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les techniciens vérifient le bon raccordement des <w>servitudes</w> électriques dans la cabine de l'avion."
                        },
                        {
                            "text": "Une défaillance des circuits de <w>servitude</w> a provoqué l'arrêt immédiat des machines du laboratoire."
                        }
                    ]
                }
            ]
        }
