                    "frequency": "Middle",
                    "semantic_group_id": "fuite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a finalement retrouvé le <w>fugitif</w> caché dans une vieille grange abandonnée."
                        },
                        {
                            "text": "Les autorités recherchent activement un dangereux <w>fugitif</w> échappé de prison hier soir."
                        }
                    ],
                    "synonyms": [
                        "fuyard"
                    ],
                    "common_phrases": [
                        "fugitif recherché",
                        "traque d'un fugitif"
