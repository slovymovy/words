                "senses": [
                    {
                        "sense_id": "cae52b22-2b31-3fbd-a2a8-22e8088789ad",
                        "entry_id": "e81fcb5a-ba72-3953-9ccc-c96cbc855fa5",
                        "glosses": [
                            "Donner des coups de poing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54320fe4-4e78-44ed-838e-fbfa7c3b7ea5",
                                "sense_id": "cae52b22-2b31-3fbd-a2a8-22e8088789ad",
                                "text": "ils se pugilent plus, ils réfléchissent…"
                            },
                            {
                                "example_id": "9e9d09e3-48ed-41e1-891b-b430ad1049cb",
                                "sense_id": "cae52b22-2b31-3fbd-a2a8-22e8088789ad",
                                "text": "Mes camarades sont imprudents ; ils causent et se pugilent sur les chemins, à plaisir."
                            },
                            {
                                "example_id": "ddf2abec-bb3e-4ab9-9dea-77a17f2fdf60",
                                "sense_id": "cae52b22-2b31-3fbd-a2a8-22e8088789ad",
                                "text": "Je suis devenu presque aussi malgache que ceux qu’on fait défiler, boire et pugiler."
                            },
                            {
                                "example_id": "9afdd639-aae4-4a3f-bc01-832837dd7bb5",
                                "sense_id": "cae52b22-2b31-3fbd-a2a8-22e8088789ad",
                                "text": "Hier, j’étais dans le RER et un grand noir assis à côté de moi a lancé à son copain : « Le frère de David, je l’ai pugilé grave ! » C’est pas beau, ça, pugiler ?"
                            }
                        ]
                    }
