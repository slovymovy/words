                "senses": [
                    {
                        "sense_id": "25d7c8b3-21a3-3f30-93bf-5c1087bf2512",
                        "entry_id": "b9a04d17-2d5e-34f0-a489-318244b7ddab",
                        "glosses": [
                            "Tier, das zum Tragen von Lasten und Transportgut (in unebenem Gelände) genutzt wird bzw. abgerichtet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a00a898-fe10-45a3-b377-48246517d34a",
                                "sense_id": "25d7c8b3-21a3-3f30-93bf-5c1087bf2512",
                                "text": "„Das Saumtier schreitet über Felsen und Steingetrümmer, durch Thäler und Schluchten, ohne eine Spur, aus welcher ein wirklich ausgetretener Weg entstehen könnte, zu hinterlassen.“"
                            },
                            {
                                "example_id": "d93d8be3-5347-41c6-865b-1f5887e080f9",
                                "sense_id": "25d7c8b3-21a3-3f30-93bf-5c1087bf2512",
                                "text": "„An den Ufern der Bachläufe grasten Saumtiere aus entlegenen Gegenden, an den Vorderbeinen gebunden, wie auch Rudel von ungezähmten Pferden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1af7cbd9-c417-4ff3-9b4e-e2aadac8730d",
                        "source_entry_id": "b9a04d17-2d5e-34f0-a489-318244b7ddab",
                        "source_sense_id": "25d7c8b3-21a3-3f30-93bf-5c1087bf2512",
                        "source_sense_description": "Tier, das Lasten trägt oder dazu abgerichtet ist",
                        "target_lang_word": "sumpter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sumpter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48d7af6b-d519-3dde-9470-5d9bca840800",
                                        "entry_id": "cfffa245-8116-3490-b95a-d0dacbc7e410",
                                        "glosses": [
                                            "The driver of a packhorse."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27060a33-d6ff-4ada-bbf0-c9dd9c7592b9",
                                                "sense_id": "48d7af6b-d519-3dde-9470-5d9bca840800",
                                                "text": "Persuade me rather to be slave and sumpter / To this detested groom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d12e532-2ba6-3bbd-88e2-3150388afd8e",
                                        "entry_id": "cfffa245-8116-3490-b95a-d0dacbc7e410",
                                        "glosses": [
                                            "A packhorse; a beast of burden."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bcfb383-3dc9-4ba4-8236-ca0aa14b8466",
                                                "sense_id": "2d12e532-2ba6-3bbd-88e2-3150388afd8e",
                                                "text": "the ancient vse of somers and sumpter horsses is in maner vtterlie relinquished"
                                            },
                                            {
                                                "example_id": "7897ce40-eadb-4e56-abbf-f3d2fcb39097",
                                                "sense_id": "2d12e532-2ba6-3bbd-88e2-3150388afd8e",
                                                "text": "The Bishop of Orange was watching carefully as men stored his papers in a cart, the King's steward and Despenser's bottler were stalking about among the wagons and sumpter horses ensuring that all was packed, while clerks of the various departments of state were hurrying about, squeaking at men who looked as though they might drop a chest or misstore a box in the wrong wagon, and generally getting in the way of everyone else while making themselves thoroughly miserable at the same time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e5687c-8aa2-30f6-9375-fb7b5299fabd",
                                        "entry_id": "cfffa245-8116-3490-b95a-d0dacbc7e410",
                                        "glosses": [
                                            "A pack; a burden."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e2ea666-d860-403a-977d-dcef907b1384",
                                                "sense_id": "30e5687c-8aa2-30f6-9375-fb7b5299fabd",
                                                "text": "You should have had a Sumpter , tho' 'thad cost me\nThe laying on myself"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a28bf34-a5e4-479e-89e1-564acb950e95",
