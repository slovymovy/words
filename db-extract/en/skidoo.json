            {
                "entry_id": "19f5c538-f5ac-355a-8b23-e8e6ba3dcfa2",
                "word": "skidoo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75911c3c-4da1-375c-9005-8385f6bad4de",
                        "entry_id": "19f5c538-f5ac-355a-8b23-e8e6ba3dcfa2",
                        "glosses": [
                            "A light that flashes on and off to make it more eye-catching."
                        ],
                        "tags": [
                            "attributive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0297db67-1a1d-43fa-a461-e99f81db7ed1",
                                "sense_id": "75911c3c-4da1-375c-9005-8385f6bad4de",
                                "text": "More than 1,000 winking or \"skidoo\" lamps will be hung in the vines and shrubbery on cither side of the Flirtation Path and they will wink and blink from 7 o'clock in the evening until midnight."
                            },
                            {
                                "example_id": "0bec5ea7-ada6-4c5c-a146-83baf2fa3d2f",
                                "sense_id": "75911c3c-4da1-375c-9005-8385f6bad4de",
                                "text": "Important among the devices which utilize these differences in expansion are the automatic fire alarm, the thermostat and the mechanism for operating the \"skidoo\" lamp used in signs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "428705af-30eb-3bcc-867b-9c49e9da5066",
                "word": "skidoo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4f96a582-beb0-4ae7-8061-c07a39cc3328",
                        "entry_id": "428705af-30eb-3bcc-867b-9c49e9da5066",
                        "tags": [
                            "plural"
