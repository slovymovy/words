                        "entry_id": "7a6d48fa-12da-37a4-b594-c1f2d8c14981",
                        "glosses": [
                            "Fine stalactite formée d’un tube naturel de concrétion de calcite au sein duquel circule l’eau d’infiltration."
                        ],
                        "tags": [
                            "Spéléologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0b520e4d-5494-4fe7-83a1-0dcff197a4c1",
                                "sense_id": "a0d97f7c-70ff-33e8-acb6-a64ba405ab78",
                                "text": "L’emboîtement de ces manchons successifs forme un tube de quelques millimètres de diamètre, la fistuleuse."
                            },
                            {
                                "example_id": "273fff08-e500-407e-b14e-7c8f225157b2",
                                "sense_id": "a0d97f7c-70ff-33e8-acb6-a64ba405ab78",
                                "text": "Le faisceau des torches dessine les contours de fastueuses formations géologiques: stalactites et stalagmites larges comme des colonnes, fistuleuses translucides, scintillants drapés de calcites…"
                            }
                        ]
                    }
                ],
