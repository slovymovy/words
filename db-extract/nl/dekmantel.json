                        ]
                    },
                    {
                        "translation_id": "fd2a2859-bdba-4d8c-a532-b699f62afd04",
                        "source_entry_id": "55d7369a-8d36-3dcf-ad18-f0d72e3d7665",
                        "source_sense_id": "368a3fb1-8e70-3a71-bef6-9c5de4056b3d",
                        "source_sense_description": "dat wat de ware aard van iets verhullen moet",
                        "target_lang_word": "facade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76b2759b-c2c7-332c-b931-e21c7e8344ce",
                                        "entry_id": "f576e1ef-b1d5-3e65-aa9c-0d844b1205f7",
                                        "glosses": [
                                            "The face of a building, especially the front view or elevation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "935296d6-980e-404c-98ad-c1d68ac7c274",
                                                "sense_id": "76b2759b-c2c7-332c-b931-e21c7e8344ce",
                                                "text": "In Egypt the façades of their rock-cut tombs were[…]ornamented so simply and unobtrusively as rather to belie than to announce their internal magnificence."
                                            },
                                            {
                                                "example_id": "49319bce-3bc4-464f-92cc-6bdd6c3a6bf2",
                                                "sense_id": "76b2759b-c2c7-332c-b931-e21c7e8344ce",
                                                "text": "Like so many of the finest churches, [the cathedral of Siena] was furnished with a plain substantial front wall, intended to serve as the backing and support of an ornamental façade."
                                            },
                                            {
                                                "example_id": "ba676097-8266-4287-865f-da37de8aee27",
                                                "sense_id": "76b2759b-c2c7-332c-b931-e21c7e8344ce",
                                                "text": "The house of Ruthven was a small but ultra-modern limestone affair, between Madison and Fifth ;[…]. As a matter of fact its narrow ornate façade presented not a single quiet space that the eyes might rest on after a tiring attempt to follow and codify the arabesques, foliations, and intricate vermiculations of what some disrespectfully dubbed as “near-aissance.”"
                                            },
                                            {
                                                "example_id": "594f5951-6c80-44f1-a893-120be11751f7",
                                                "sense_id": "76b2759b-c2c7-332c-b931-e21c7e8344ce",
                                                "text": "Eight or so gunmen stood shoulder to shoulder in the gray-white trail before the barn, firing into the saloon's burning, bullet-pocked facade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f5b5b3-3ecf-3a42-84f4-1ef152bfd989",
                                        "entry_id": "f576e1ef-b1d5-3e65-aa9c-0d844b1205f7",
                                        "glosses": [
                                            "The face or front (most visible side) of any other thing, such as the prospect of an organ."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c53d9c5-cd0a-3c2e-a49f-d5307fdf32b4",
                                        "entry_id": "f576e1ef-b1d5-3e65-aa9c-0d844b1205f7",
                                        "glosses": [
                                            "A deceptive or insincere outward appearance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e8cae8b-e12d-3360-8bc1-a7eaf24bb04f",
                                        "entry_id": "f576e1ef-b1d5-3e65-aa9c-0d844b1205f7",
                                        "glosses": [
                                            "An object serving as a simplified interface to a larger body of code, as in the facade pattern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12393103-0224-40d1-8aa1-3e0236530f51",
                                                "sense_id": "3e8cae8b-e12d-3360-8bc1-a7eaf24bb04f",
                                                "text": "Facades are widely used for tasks like simplifying complex APIs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be7be963-b264-4f02-85ba-b9c97dac1fa5",
                        "source_entry_id": "55d7369a-8d36-3dcf-ad18-f0d72e3d7665",
                        "source_sense_id": "6d9d19d5-4e45-31d6-a83b-ba19b36e4293",
                        "source_sense_description": "een smoesje om iets anders te laten lijken dan het is",
                        "target_lang_word": "pretext",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pretext",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ed0f507-2a81-30ad-b2a2-45c9f33036da",
                                        "entry_id": "bac5e07d-1e6b-3597-bfc8-eda524e74c9b",
                                        "glosses": [
                                            "A false, contrived, or assumed purpose or reason; a pretense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ead4c209-d965-4063-b279-f95691b14050",
                                                "sense_id": "2ed0f507-2a81-30ad-b2a2-45c9f33036da",
                                                "text": "The reporter called the company on the pretext of trying to resolve a consumer complaint."
                                            },
                                            {
                                                "example_id": "454b4dd5-8f7a-4efc-812f-1bece3b2a723",
                                                "sense_id": "2ed0f507-2a81-30ad-b2a2-45c9f33036da",
                                                "text": "[T]hey would ſay [...] that I had quarrell'd / My brother purpoſely, thereby to finde / An apt pretext, to baniſh them my houſe."
                                            },
                                            {
                                                "example_id": "185736b7-67d8-4b88-9487-bf88b36d69b8",
                                                "sense_id": "2ed0f507-2a81-30ad-b2a2-45c9f33036da",
                                                "text": "\"After all,\" said the Chevalier, \"these portraits—Madame de I'Hôpital's fortune-telling—the pleasure we take in a lover or a physician—may all be referred to the same cause,—we do so enjoy talking about ourselves; and yet we feel some sort of excuse necessary. It must be admitted, that we are ready in pretexts.\""
                                            },
                                            {
                                                "example_id": "903f9b8c-b4a8-40d7-b949-935d47cf0278",
                                                "sense_id": "2ed0f507-2a81-30ad-b2a2-45c9f33036da",
                                                "text": "On every kind of pretext she would run away from work [...]"
                                            },
                                            {
                                                "example_id": "7ac71977-efdc-423d-af1f-9b17a3cbc4d2",
                                                "sense_id": "2ed0f507-2a81-30ad-b2a2-45c9f33036da",
                                                "text": "The smallest incidents were to serve as pretexts for demonstrations of force and for demands for indemnities and reparations which increased China's subjection."
                                            },
                                            {
                                                "example_id": "698a3c42-4c07-4858-b520-303c071f1c21",
                                                "sense_id": "2ed0f507-2a81-30ad-b2a2-45c9f33036da",
                                                "text": "When that metaphor proves untenable, he switches to insisting that women are like beer but that’s mainly as a pretext to drink until he passes out in a father-son bonding haze."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pretext",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe3f968a-cbdf-3203-92ba-e7b4a53d7575",
                                        "entry_id": "d2cbba53-beed-3d6c-838f-27ba1a09dbf8",
                                        "glosses": [
                                            "To employ a pretext, which involves using a false or contrived purpose for soliciting the gain of something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8173aa26-23f5-4af7-a678-5270736425b4",
                                                "sense_id": "fe3f968a-cbdf-3203-92ba-e7b4a53d7575",
                                                "text": "The spy obtained his phone records using possibly-illegal pretexting methods."
                                            },
                                            {
                                                "example_id": "a0065143-ee83-4396-97c6-ca3ed79676fa",
                                                "sense_id": "fe3f968a-cbdf-3203-92ba-e7b4a53d7575",
                                                "text": "[…] the something in the air of these establishments; the vibration of the vast, strange life of the town; the influence of the types, the performers, concocting their messages; the little prompt Paris women arranging, pretexting goodness knew what, driving the dreadful needle-pointed public pen at the dreadful sand-strewn public table[…]"
                                            },
                                            {
                                                "example_id": "99d41e72-8a42-4b56-bb2c-133d22ca9586",
                                                "sense_id": "fe3f968a-cbdf-3203-92ba-e7b4a53d7575",
                                                "text": "Not all the surviving veteran chiefs would actually fight. Some remained nominally in the resistance but in practice delayed at their bases, pretexting a lack of ammunition for their uncertain inertia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
