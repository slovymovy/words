                ],
                "senses": [
                    {
                        "sense_id": "c335d3c1-94e9-396b-9967-8ab3b4276206",
                        "entry_id": "1331aeb6-3396-36f9-958e-0923ac44b9ce",
                        "glosses": [
                            "орнитол. крупная северная водоплавающая птица с густым оперением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d06c53-16da-46b2-afd8-3020df7f5e6c",
                                "sense_id": "c335d3c1-94e9-396b-9967-8ab3b4276206",
                                "text": "Гагары вполне утки-рыбалки и так пахнут рыбой, что есть их почти невозможно, а потому охотники не стреляют гагар, разве для того, чтоб разрядить ружьё, или для пуху, который не уступает гоголиному."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41c7105a-5c74-435c-bed5-a9f85ad8769f",
                        "source_entry_id": "1331aeb6-3396-36f9-958e-0923ac44b9ce",
                        "source_sense_id": "c335d3c1-94e9-396b-9967-8ab3b4276206",
                        "target_lang_word": "loon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92d3032e-b6cd-355a-bc48-7da916eb8f2f",
                                        "entry_id": "bc68cf31-9eb9-37af-8c1a-6dff1e0f33e1",
                                        "glosses": [
                                            "A crazy or deranged person; a lunatic."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "402a3cf9-7ca0-4fdf-b40c-8a888f68c5aa",
                                                "sense_id": "92d3032e-b6cd-355a-bc48-7da916eb8f2f",
                                                "text": "An electric fire came next, followed by an umbrella and then a colander. \"This bowl will carry no water,\" he muttered. \"Some loon hath pierced it with holes.\""
                                            },
                                            {
                                                "example_id": "6d8c35d9-2f4d-44eb-b260-c8687bf4b477",
                                                "sense_id": "92d3032e-b6cd-355a-bc48-7da916eb8f2f",
                                                "text": "What's it like to be a loon? / I liken it to a balloon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30f5219e-aa9c-3344-a159-81131bc1c99c",
                                        "entry_id": "bc68cf31-9eb9-37af-8c1a-6dff1e0f33e1",
                                        "glosses": [
                                            "An idler, a lout."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f79721d-c2e0-435d-9d8e-c933fb02092c",
                                                "sense_id": "30f5219e-aa9c-3344-a159-81131bc1c99c",
                                                "text": "The diuell damne thee blacke, thou cream-fac'd Loone: Where got'ſt thou that Gooſe-looke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f05bdd00-799e-35c0-a056-816083759567",
                                        "entry_id": "bc68cf31-9eb9-37af-8c1a-6dff1e0f33e1",
                                        "glosses": [
                                            "A boy, a lad."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "Ulster"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "461abab5-6a1e-3017-a274-f5305790e2bc",
                                        "entry_id": "bc68cf31-9eb9-37af-8c1a-6dff1e0f33e1",
                                        "glosses": [
                                            "A harlot; mistress."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5f73a66-0821-319a-a487-92c409e04cf0",
                                        "entry_id": "bc68cf31-9eb9-37af-8c1a-6dff1e0f33e1",
                                        "glosses": [
                                            "A simpleton."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7048135e-163f-3849-b6ff-3b62f5b389dc",
                                        "entry_id": "bc68cf31-9eb9-37af-8c1a-6dff1e0f33e1",
                                        "glosses": [
                                            "An English soldier of an expeditionary army in Ireland."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fccec3a-2f30-3f61-91ed-f522fb1660ba",
                                        "entry_id": "bc68cf31-9eb9-37af-8c1a-6dff1e0f33e1",
                                        "glosses": [
                                            "A round area of pavement that protrudes from one side of a road to accommodate turning vehicles with a wide turning circle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "loon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c54ec6c-5322-37dd-89d1-1f01fa144c06",
                                        "entry_id": "a654a706-2985-3c93-8e7c-b57445b250bb",
                                        "glosses": [
                                            "Any of various birds, of the order Gaviiformes, of North America and Europe that dive for fish and have a short tail, webbed feet and a yodeling cry."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc329db-ca27-4d92-a669-339d863a57c5",
                                                "sense_id": "5c54ec6c-5322-37dd-89d1-1f01fa144c06",
                                                "text": "The Loone is an ill ſhap'd thing like a Cormorant; but that he can neyther goe nor flye; he maketh a noiſe ſometimes like a Sovvgelders horne."
                                            },
                                            {
                                                "example_id": "8c728dd0-a030-4bc2-98f3-2b158ba01ca7",
                                                "sense_id": "5c54ec6c-5322-37dd-89d1-1f01fa144c06",
                                                "text": "[O]h, yes! the loon does shriek dreadfully - particularly when there's fine rain […]"
                                            },
                                            {
                                                "example_id": "4f7fb9f2-4d73-47b3-88eb-960cb6a6e2f9",
                                                "sense_id": "5c54ec6c-5322-37dd-89d1-1f01fa144c06",
                                                "text": "He came again to her and she said: ‘Run swifter than the deer, be more cunning than the beaver, dive deeper than the loon.’"
                                            },
                                            {
                                                "example_id": "f4663c7d-d2af-4c4f-a290-bcd57a1163b7",
                                                "sense_id": "5c54ec6c-5322-37dd-89d1-1f01fa144c06",
                                                "text": "And I listened for a voice;— / But my heart was all I heard; / Not a screech-owl, not a loon, / Not a tree-toad said a word."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
