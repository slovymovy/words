                    "frequency": "Low",
                    "semantic_group_id": "card_game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He played the <w>ten</w> of hearts to win the trick.",
                            "target_lang_translations": {
                                "ru": "Он пошел с червовой <w>десятки</w>, чтобы выиграть взятку.",
                                "zh": "他打出红桃<w>十点</w>赢了这一轮。"
                            }
