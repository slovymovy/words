                                "target_senses": [
                                    {
                                        "sense_id": "6cf5d3e5-f635-3f84-a616-d126aa63d888",
                                        "entry_id": "5497f140-cda2-3116-bb9a-a9626b74df57",
                                        "glosses": [
                                            "voll von, an Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6192a1f7-4d69-4a2b-8306-7fece239a256",
                                                "sense_id": "6cf5d3e5-f635-3f84-a616-d126aa63d888",
                                                "text": "Nach einem kraftvollen Stoß landete die Kugel bei über 20 Metern."
                                            },
                                            {
                                                "example_id": "88d07106-e82a-40d2-a1f8-13defd8cf1db",
                                                "sense_id": "6cf5d3e5-f635-3f84-a616-d126aa63d888",
                                                "text": "„Vögel sind die kraftvolleren Flugtiere, doch zahlenmäßig sind ihnen die Insekten um ein Vielfaches überlegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28f58c1e-7c2a-43bf-aa91-5e2c4185d496",
                        "source_entry_id": "962ca67f-7a93-3202-a5d4-1a1eb9cd5f30",
                        "source_sense_description": "loud or clear",
                        "target_lang_word": "klar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                        "entry_id": "98cc1090-27e8-37e0-8b39-6875a091584a",
                                        "glosses": [
                                            "frei von Unreinheiten oder generell Störendem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff7bc19-fbb5-4eb9-8aaf-be3cb239fabc",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "Heute soll es klares Wetter geben."
                                            },
                                            {
                                                "example_id": "e077a3f4-6da0-4007-8a15-af2ed82202f4",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "Heute ist das Wasser ganz klar, man kann den Grund sehen."
                                            },
                                            {
                                                "example_id": "b3125141-da1f-4c2a-b0ee-1cc95ccfb159",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "Sie antwortete mit klarer Stimme."
                                            },
                                            {
                                                "example_id": "9e58f043-b3ae-491b-b7b2-4c6a218442e6",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "Dieses klare Rot gefällt mir besser als das abgetönte."
                                            },
                                            {
                                                "example_id": "7995ab28-f1a8-449c-8bd0-aac2c35d16a4",
                                                "sense_id": "f5532fbd-e3d1-3e98-841f-571a91c65deb",
                                                "text": "„In klaren Nächten kann man [die Raumstation ISS] von der Erde aus sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c18b3c7a-eaa4-3da6-89d0-a7c595eba47d",
                                        "entry_id": "98cc1090-27e8-37e0-8b39-6875a091584a",
                                        "glosses": [
                                            "leicht nachzuvollziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b01647a3-ef74-400f-9d92-5d78213123ca",
                                                "sense_id": "c18b3c7a-eaa4-3da6-89d0-a7c595eba47d",
                                                "text": "Das Problem ist schon klar geworden."
                                            },
                                            {
                                                "example_id": "b1bf9404-ab03-43a4-8335-57e694d34ecc",
                                                "sense_id": "c18b3c7a-eaa4-3da6-89d0-a7c595eba47d",
                                                "text": "Es war eine sehr klare Botschaft, die da aus Rom kam."
                                            },
                                            {
                                                "example_id": "eb0ccd0b-4ab8-4f91-b361-e36ac237c1de",
                                                "sense_id": "c18b3c7a-eaa4-3da6-89d0-a7c595eba47d",
                                                "text": "Die Bundesregierung hat ihren Armuts- und Reichtumsbericht in einigen entscheidenden Passagen deutlich entschärft. Klare Aussagen, ob Menschen mit mehr Geld einen stärkeren Einfluss auf politische Entscheidungen haben als Einkommensschwache, sind in der überarbeiteten Fassung des Berichts gestrichen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a91dea14-dd2e-3e1f-a9f8-7c41a3fe1e59",
                                        "entry_id": "98cc1090-27e8-37e0-8b39-6875a091584a",
                                        "glosses": [
                                            "für etwas vorbereitet, bereit"
                                        ],
                                        "tags": [
                                            "Seemannssprache",
                                            "Fliegersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b71b6b3d-4e2f-492f-a4b5-8bcb72b6acae",
                                                "sense_id": "a91dea14-dd2e-3e1f-a9f8-7c41a3fe1e59",
                                                "text": "Das Beiboot ist klar zum Einsatz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "klar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aed84400-52cf-3b34-957e-f4ef0d09a2ed",
                                        "entry_id": "6fedb33d-03c2-329f-b754-b99e9e69c0d5",
