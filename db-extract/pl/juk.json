                    {
                        "translation_id": "d99e2ead-2a26-49b7-817a-01ac24ebe709",
                        "source_entry_id": "a7c9db4d-fd60-3c49-9622-7ec3be70941f",
                        "source_sense_id": "fea829c7-7b87-3f7c-b26b-2d4a373eaa39",
                        "target_lang_word": "Satteltasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Satteltasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                        "entry_id": "d01e5179-6c33-3f8c-9dae-99bdc866f7b7",
                                        "glosses": [
                                            "Tasche, die man am Sattel eines Fahrrades/Motorrades oder Reittiers befestigen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9bde212-7b45-48f6-8c5a-b54cf21147ce",
                                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                                "text": "„Aber ebenso wie ich den Mini-Sprachführer für Portugiesisch ganz unten in meinen Satteltaschen vergraben hatte, verdrängte ich diese Gedanken, ich würde mich später darum kümmern.“"
                                            },
                                            {
                                                "example_id": "d47efdc0-a392-4598-98f6-157dc800bde6",
                                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                                "text": "„Er wollte bei Einbruch der Nacht ganz allein und was das Pferd laufen könne die Stadt verlassen und sich nach Livorno begeben, ohne mehr als das Allernötigste in einer Satteltasche mitzunehmen, insbesondere sein liebes blaues Band.“"
                                            },
                                            {
                                                "example_id": "0365e699-cf2c-4979-b071-aa8aaa7c58ae",
                                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                                "text": "„Mit diesen Worten zahlte er an der Bar seine Rechnung, ließ sich die Satteltasche geben, legte sie über den Sattel seines ungeduldig scharrenden Braunen, stieg auf und trabte die Elmstreet hinab in den das Städtchen begrenzenden Wald.“"
                                            },
                                            {
                                                "example_id": "d508ef63-26d6-4e0c-b29a-f1b3aff94809",
                                                "sense_id": "321065ed-198d-38b1-ae66-ab813e2f8ec0",
                                                "text": "„Als am Nachmittag des 26. Januars der Reiter mit dem ungeöffneten Brief in der Satteltasche nach Götzlack zurückkehrte, wähnte Else ihren Schwiegervater und die Schwägerin mit dem Treck auf dem Weg gen Westen und konzentrierte sich nun auf die eigene Flucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
