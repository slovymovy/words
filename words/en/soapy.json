{
    "word_family": [
        "soap",
        "soaping",
        "soapiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "be44b906-ac97-373b-ae10-ded39f2b28fd",
                    "sense_definition": "Containing or covered in soap.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "soap_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dishwasher uses hot <w>soapy</w> water to clean the dishes and silverware.",
                            "target_lang_translations": {
                                "zh": "洗碗机使用热的<w>肥皂水</w>来清洗餐具和银器。"
                            }
                        },
                        {
                            "text": "His skin was still <w>soapy</w> after he finished his shower.",
                            "target_lang_translations": {
                                "zh": "他洗完澡后，皮肤上还留有<w>肥皂沫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soaped up"
                    ],
                    "common_phrases": [
                        "soapy water"
                    ],
                    "target_lang_definitions": {
                        "zh": "含有肥皂或被肥皂覆盖的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "肥皂的",
                                "target_lang_sense_clarification": "指含有肥皂成分或沾有肥皂。"
                            },
                            {
                                "target_lang_word": "有肥皂的",
                                "target_lang_sense_clarification": "描述物体表面覆盖着肥皂。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40dc9024-6126-3fda-9e01-3511036eca26",
                    "sense_definition": "Having the texture or slippery quality of soap.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "soap_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bases dissolve skin oils and have a <w>soapy</w> feel to them.",
                            "target_lang_translations": {
                                "zh": "碱能溶解皮肤油脂，摸起来有一种<w>滑腻感</w>。"
                            }
                        },
                        {
                            "text": "The chemical left a <w>soapy</w> residue on the surface of the glass.",
                            "target_lang_translations": {
                                "zh": "这种化学物质在玻璃表面留下了一层<w>滑腻的</w>残留物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soaplike"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有肥皂般的质地或滑腻感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "滑腻的",
                                "target_lang_sense_clarification": "形容像肥皂一样滑溜的触感。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1ad050e-282f-3545-aeb1-34991918fce0",
                    "sense_definition": "Resembling a soap opera in being overly dramatic or emotional.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dramatic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The show is a <w>soapy</w> drama filled with secret affairs and sudden betrayals.",
                            "target_lang_translations": {
                                "zh": "这部剧是一部充满秘密恋情和突发背叛的<w>狗血</w>剧。"
                            }
                        },
                        {
                            "text": "Critics disliked the <w>soapy</w> plot twists that felt unrealistic and forced.",
                            "target_lang_translations": {
                                "zh": "评论家们不喜欢那些感觉不切实际且生硬的<w>狗血</w>剧情反转。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指像肥皂剧一样情节夸张或情感过度的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狗血的",
                                "target_lang_sense_clarification": "形容剧情极其夸张、煽情或不切实际。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d274c1df-2261-316d-b066-bed031c20276",
                    "sense_definition": "Characterized by excessive or insincere flattery.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dramatic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used <w>soapy</w> words to try and win the favor of his boss.",
                            "target_lang_translations": {
                                "zh": "他用<w>油嘴滑舌</w>的话试图博取老板的欢心。"
                            }
                        },
                        {
                            "text": "The politician gave a <w>soapy</w> speech full of empty promises and praise.",
                            "target_lang_translations": {
                                "zh": "这位政客发表了一场充满空头支票和虚伪赞美的<w>油嘴滑舌的</w>演讲。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指过分或虚伪的奉承。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "油嘴滑舌的",
                                "target_lang_sense_clarification": "形容说话虚伪、爱拍马屁。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87f2be88-0f8f-339b-801c-8a361af4ce95",
                    "sense_definition": "An erotic massage involving soap and body contact.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "massage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spa menu included a <w>soapy</w> as a specialized service.",
                            "target_lang_translations": {
                                "zh": "水疗中心的菜单里包含一项名为<w>肥皂按摩</w>的特色服务。"
                            }
                        },
                        {
                            "text": "He booked a <w>soapy</w> at the local massage parlor.",
                            "target_lang_translations": {
                                "zh": "他在当地的按摩院预订了一次<w>肥皂按摩</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in specific adult contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种涉及肥皂和身体接触的特殊按摩服务。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "肥皂按摩",
                                "target_lang_sense_clarification": "一种色情按摩服务"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}