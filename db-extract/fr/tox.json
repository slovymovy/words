                        "examples": [
                            {
                                "example_id": "6c0b4a87-799d-44d6-801e-720a14768ba1",
                                "sense_id": "a9b87fac-c3cb-379e-b214-3be02c7bb287",
                                "text": "Je te connais, toi l’épouse de l’alcoolique, la mère du tox, secouée de pleurs, tremblée d’angoisses, je vous connais tous proches, amis, parents de nous autres amputés, toutes vos vies dévastées."
                            },
                            {
                                "example_id": "e63fec83-866c-4295-b633-979dcb093be5",
                                "sense_id": "a9b87fac-c3cb-379e-b214-3be02c7bb287",
                                "text": "Tu as besoin de picoler dès huit heures du matin… tu es pathétique… c’est toi qui as rompu notre accord… tu devais laisser tomber la dope… les tox, c’est pas fiable…"
                            }
                        ]
                    }
