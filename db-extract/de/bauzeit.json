                "senses": [
                    {
                        "sense_id": "59dca684-27d6-301a-88bf-cd89ecd8a427",
                        "entry_id": "46317f65-f1e9-3962-8e8c-b58b8c45e02b",
                        "glosses": [
                            "zum Bauen benötigte Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "275c5b8f-b459-4bf8-ab97-588e42e7a3c5",
                                "sense_id": "59dca684-27d6-301a-88bf-cd89ecd8a427",
                                "text": "„Nach zweijähriger Bauzeit wird in Berlin das Denkmal für die ermordeten Juden Europas eröffnet.“"
                            },
                            {
                                "example_id": "699d92f4-674b-4956-8f9a-53430602119a",
                                "sense_id": "59dca684-27d6-301a-88bf-cd89ecd8a427",
                                "text": "„Nach siebenjähriger Bauzeit erfolgt der Durchstich für den Sankt-Gotthard-Tunnel, mit 15 km der längste Tunnel der Welt.“"
                            },
                            {
                                "example_id": "33c44a4c-15f7-4f1c-8e35-a2f28e283ddb",
                                "sense_id": "59dca684-27d6-301a-88bf-cd89ecd8a427",
                                "text": "„Nach achtjähriger Bauzeit ist der Bau der Eisenbahnstrecke für die Transsibirische Eisenbahn vollendet.“"
                            },
                            {
                                "example_id": "75ca4153-0752-4ed0-b91b-48a4b8ee31f9",
                                "sense_id": "59dca684-27d6-301a-88bf-cd89ecd8a427",
                                "text": "„Die Bauzeiten verlängern sich, die Kosten steigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
