                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled the <w>clothes</w> up to his chin to keep warm.",
                            "target_lang_translations": {
                                "ru": "Он натянул <w>одеяло</w> до подбородка, чтобы согреться.",
                                "nl": "Hij trok het <w>beddengoed</w> op tot zijn kin om warm te blijven.",
                                "pl": "Naciągnął <w>pościel</w> pod sam podbródek, żeby było mu ciepło.",
                                "de": "Er zog das <w>Bettzeug</w> bis zum Kinn hoch, um sich warm zu halten.",
                                "fr": "Il a tiré les <w>couvertures</w> jusqu'à son menton pour rester au chaud.",
                                "it": "Si tirò le <w>coperte</w> fino al mento per stare al caldo.",
                                "cs": "Natáhl si <w>peřinu</w> až k bradě, aby se zahřál.",
                                "tr": "Isınmak için <w>yorganı</w> çenesine kadar çekti.",
                                "es": "Se subió las <w>mantas</w> hasta la barbilla para mantenerse caliente."
                            }
                        },
                        {
                            "text": "She sat up and threw back the <w>clothes</w> before getting out of bed.",
                            "target_lang_translations": {
                                "ru": "Она села и откинула <w>одеяло</w>, прежде чем встать с постели.",
