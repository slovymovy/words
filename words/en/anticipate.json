{
    "word_family": [
        "anticipation",
        "anticipatory",
        "unanticipated"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7318a712-4d3a-3b5f-a2ad-fbc1a166d769",
                    "sense_definition": "To expect that something will happen and often prepare for it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expectation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company did not <w>anticipate</w> such a high demand for their new product.",
                            "target_lang_translations": {
                                "ru": "Компания не <w>предвидела</w> такого высокого спроса на свой новый продукт."
                            }
                        },
                        {
                            "text": "We should <w>anticipate</w> problems and have a backup plan ready just in case.",
                            "target_lang_translations": {
                                "ru": "Нам следует <w>предусмотреть</w> возможные проблемы и подготовить запасной план на всякий случай."
                            }
                        }
                    ],
                    "synonyms": [
                        "expect",
                        "foresee"
                    ],
                    "common_phrases": [
                        "anticipate problems",
                        "anticipate needs",
                        "anticipate changes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ожидать наступления чего-либо и часто заранее готовиться к этому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвидеть",
                                "target_lang_sense_clarification": "заранее догадаться о событии"
                            },
                            {
                                "target_lang_word": "ожидать",
                                "target_lang_sense_clarification": "рассчитывать на что-либо"
                            },
                            {
                                "target_lang_word": "предусматривать",
                                "target_lang_sense_clarification": "учитывать возможность чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02ecf9d3-b048-358c-ba6d-3012b752efb3",
                    "sense_definition": "To look forward to something with pleasure or excitement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "expectation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children <w>anticipate</w> the arrival of the holidays with great excitement.",
                            "target_lang_translations": {
                                "ru": "Дети с большим волнением <w>предвкушают</w> наступление каникул."
                            }
                        },
                        {
                            "text": "I <w>anticipate</w> meeting you next week to discuss our future collaboration.",
                            "target_lang_translations": {
                                "ru": "Я <w>с нетерпением жду</w> встречи с вами на следующей неделе, чтобы обсудить наше будущее сотрудничество."
                            }
                        }
                    ],
                    "synonyms": [
                        "look forward to",
                        "foretaste"
                    ],
                    "common_phrases": [
                        "eagerly anticipate",
                        "anticipate with pleasure"
                    ],
                    "target_lang_definitions": {
                        "ru": "С нетерпением или удовольствием ждать наступления какого-либо события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвкушать",
                                "target_lang_sense_clarification": "заранее испытывать удовольствие"
                            },
                            {
                                "target_lang_word": "с нетерпением ждать",
                                "target_lang_sense_clarification": "ожидать с волнением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d47f616-b4db-3c53-bc4c-b3ea794ce511",
                    "sense_definition": "To act before someone else does, especially to prevent their action or to gain an advantage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prevention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chess player managed to <w>anticipate</w> his opponent's move and blocked the attack.",
                            "target_lang_translations": {
                                "ru": "Шахматисту удалось <w>предугадать</w> ход противника и заблокировать атаку."
                            }
                        },
                        {
                            "text": "By launching the product early, they were able to <w>anticipate</w> their competitors.",
                            "target_lang_translations": {
                                "ru": "Выпустив продукт раньше, они смогли <w>опередить</w> своих конкурентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "preempt",
                        "preclude"
                    ],
                    "common_phrases": [
                        "anticipate a move",
                        "anticipate an objection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действовать раньше других, чтобы предотвратить их действия или получить преимущество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опередить",
                                "target_lang_sense_clarification": "совершить действие раньше другого"
                            },
                            {
                                "target_lang_word": "предугадать",
                                "target_lang_sense_clarification": "понять чужой замысел заранее"
                            },
                            {
                                "target_lang_word": "предупредить",
                                "target_lang_sense_clarification": "сработать на опережение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0772c5bb-cc21-3c89-bfe2-a08ff11c3c8d",
                    "sense_definition": "To deal with or use something before the usual or proper time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "timing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer decided to <w>anticipate</w> a part of her closing argument during the opening statement.",
                            "target_lang_translations": {
                                "ru": "Адвокат решила <w>предвосхитить</w> часть своей заключительной речи во время вступительного заявления."
                            }
                        },
                        {
                            "text": "He had to <w>anticipate</w> his inheritance to pay off his immediate debts.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>использовать заранее</w> свое наследство, чтобы выплатить срочные долги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "anticipate an argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассматривать или использовать что-либо раньше положенного или обычного времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвосхитить",
                                "target_lang_sense_clarification": "сделать или применить что-либо раньше времени"
                            },
                            {
                                "target_lang_word": "забегать вперед",
                                "target_lang_sense_clarification": "касаться темы преждевременно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}