                                        "glosses": [
                                            "enkel waarde of betekenis hebbend in vergelijking met iets anders, relatief"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff42c830-9936-4078-820f-754013f7d844",
                                                "sense_id": "ddd31355-198a-3cd3-8dbe-e494eba2a203",
                                                "text": "Dat vind ik een betrekkelijk begrip."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "betrekkelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4d9789c6-5d69-3093-b72d-e38fcd0de0e3",
                                        "entry_id": "a8462564-85a3-3d8d-964f-15ef6058ee9e",
                                        "glosses": [
                                            "tamelijk, nogal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a6c722-f1e4-4b00-b663-68b972f29a9e",
                                                "sense_id": "4d9789c6-5d69-3093-b72d-e38fcd0de0e3",
                                                "text": "In die winkel zijn de artikelen betrekkelijk goedkoop."
                                            },
                                            {
                                                "example_id": "41504b60-19db-4a19-9d95-2b957e00827f",
                                                "sense_id": "4d9789c6-5d69-3093-b72d-e38fcd0de0e3",
                                                "text": "De betrekkelijke stilte die er heerste was een oase van rust vergeleken bij de afgelopen uren waarin de tweeling als vanouds voor kabaal had gezorgd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f13bc87-2dba-43d3-929b-bd01ba256e44",
                        "source_entry_id": "adee291e-9ec6-3f93-ac63-632829d11d51",
                        "source_sense_description": "in a comparative manner",
                        "target_lang_word": "vergleichsweise",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vergleichsweise",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                        "entry_id": "9ea7f430-8904-3e3a-a86f-94b0a04f0cf4",
                                        "glosses": [
                                            "im Verhältnis, im Vergleich (zu etwas oder jemand anderem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49fcf6d6-3189-4efc-b416-d9fb5cd2673b",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„Eine Kompaktkamera ist ein kleiner und unter Betrachtung seiner Bauform vergleichsweise leichter Fotoapparat.“"
                                            },
                                            {
                                                "example_id": "a3138683-d2a1-48d2-962b-2d150e5456d7",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„In einem Land, in dem beispielsweise Arbeitskräfte knapp sind, werden die Löhne vergleichsweise höher sein als in einem Land, in dem ein Überangebot an Arbeitskräften besteht.“"
                                            },
                                            {
                                                "example_id": "4d6aab51-6f76-40ef-b758-c92355331e33",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„Beitragsstabilität klingt zwar vergleichsweise harmlos. Es bedeutet aber, dass die Finanzkraft der Sender durch die Inflation von Jahr zu Jahr immer weiter sänke.“"
                                            },
                                            {
                                                "example_id": "336c876f-6e6f-45ca-afdb-d6899706f7a4",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„Diese Untersuchung greift auf eine vergleichsweise breite Literaturauswahl sowie auf bislang unveröffentlichtes Archivmaterial zurück.“"
                                            },
                                            {
                                                "example_id": "efde95f7-06fd-481c-a8c2-f71059812a15",
                                                "sense_id": "cf5acf5d-06a5-39e8-b864-f4bb91db1340",
                                                "text": "„Ein vergleichsweise milder Winter sorgt dafür, dass die Vögel nicht in die Gärten kommen, so lange sie in Wäldern, auf Wiesen und Feldern noch Nahrung finden […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6c709bb-3a0c-481a-94c7-2380ea7e151f",
                        "source_entry_id": "adee291e-9ec6-3f93-ac63-632829d11d51",
                        "source_sense_description": "in a comparative manner",
                        "target_lang_word": "verhältnismäßig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verhältnismäßig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb66dcbd-8178-3b46-a3b3-79399ee50ab4",
                                        "entry_id": "169bd2ca-9e58-3578-8e65-f06f78b4fe7c",
                                        "glosses": [
                                            "in einem angemessenen Verhältnis zueinander stehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be86b537-9851-4811-bd7d-31a8a2882bf1",
                                                "sense_id": "cb66dcbd-8178-3b46-a3b3-79399ee50ab4",
                                                "text": "Wenn man bedenkt, dass er aus einer Zwangslage handelte, erscheint die Strafe nicht verhältnismäßig."
                                            },
                                            {
                                                "example_id": "cc977073-71a4-48aa-9ed2-7f695cf022e9",
                                                "sense_id": "cb66dcbd-8178-3b46-a3b3-79399ee50ab4",
                                                "text": "Eine Verwarnung ist hier verhältnismäßig."
                                            },
                                            {
                                                "example_id": "eeed79eb-36d3-4974-a56d-2742a695e8cc",
                                                "sense_id": "cb66dcbd-8178-3b46-a3b3-79399ee50ab4",
                                                "text": "Die Schöffen diskutieren die verhältnismäßigste Strafe."
                                            },
                                            {
                                                "example_id": "af7180e6-b9c5-4c26-84ff-623a41b28953",
                                                "sense_id": "cb66dcbd-8178-3b46-a3b3-79399ee50ab4",
                                                "text": "Verkäufer und Käufer waren an einer verhältnismäßigen Teilung des Transportrisikos interessiert."
                                            },
                                            {
                                                "example_id": "3c6c281f-f91e-47b2-9fb3-e02f4fa73ae3",
                                                "sense_id": "cb66dcbd-8178-3b46-a3b3-79399ee50ab4",
                                                "text": "Der unzufriedene Kunde meldete Anspruch auf einen verhältnismäßigen Preisnachlass an."
                                            },
                                            {
                                                "example_id": "c4960873-de3a-442c-b16e-bc60f4c91711",
                                                "sense_id": "cb66dcbd-8178-3b46-a3b3-79399ee50ab4",
                                                "text": "Es besteht die Möglichkeit, die entstandenen Kosten gegeneinander aufzuheben oder verhältnismäßig zu teilen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "def96f56-9cfc-3499-b938-905b74080ef9",
                                        "entry_id": "169bd2ca-9e58-3578-8e65-f06f78b4fe7c",
                                        "glosses": [
                                            "im Verhältnis gesehen; vergleichend betrachtet; relativ"
                                        ],
                                        "tags": [
                                            "adverbiell verwendet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bda19b6b-b6a5-42b7-9e9c-3694c9d97f0a",
                                                "sense_id": "def96f56-9cfc-3499-b938-905b74080ef9",
                                                "text": "In Japan gibt es verhältnismäßig wenig gemeldete Verbrechen."
                                            },
                                            {
                                                "example_id": "9a945ee3-feba-4720-9c24-3de6bd93e86d",
                                                "sense_id": "def96f56-9cfc-3499-b938-905b74080ef9",
                                                "text": "„Der Schweizer Erziehungsforscher hat Schulwegzeichnungen verglichen und festgestellt, dass chauffierte Schüler von der Strecke verhältnismäßig wenig wahrnehmen.“"
                                            },
                                            {
                                                "example_id": "2b458db8-ac71-4083-93e6-3581bbbc862e",
                                                "sense_id": "def96f56-9cfc-3499-b938-905b74080ef9",
                                                "text": "Es ist mir verhältnismäßig egal, was du jetzt tust. Du kannst auch gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
