                    "sense_definition": "langer werken dan de normale of afgesproken werktijd",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "arbeid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet vanavond een paar uur <w>overwerken</w> om het rapport op tijd af te krijgen.",
                            "target_lang_translations": {
                                "en": "I have to <w>work overtime</w> for a few hours tonight to finish the report on time."
                            }
                        },
                        {
                            "text": "Als je veel moet <w>overwerken</w>, krijg je daar meestal extra voor betaald.",
                            "target_lang_translations": {
                                "en": "If you have to <w>work overtime</w> a lot, you usually get paid extra for it."
                            }
                        }
                    ],
                    "common_phrases": [
                        "moeten overwerken",
                        "veel overwerken"
                    ],
                    "target_lang_definitions": {
                        "en": "to work longer than the normal or agreed working hours"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to work overtime",
                                "target_lang_sense_clarification": "working beyond regular hours"
                            },
                            {
                                "target_lang_word": "to do overtime",
                                "target_lang_sense_clarification": "performing extra hours at work"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48998606-bf06-3617-a68e-68ca8bf07ffa",
                    "sense_definition": "zichzelf uitputten door te veel of te hard te werken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gezondheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet jezelf niet zo <w>overwerken</w>, want dan krijg je last van stress.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>overwork yourself</w> so much, because then you'll suffer from stress."
                            }
                        },
                        {
                            "text": "Hij heeft zich de afgelopen maanden volledig <w>overwerkt</w> en zit nu ziek thuis.",
                            "target_lang_translations": {
                                "en": "He has completely <w>overworked himself</w> over the past few months and is now at home sick."
                            }
                        }
                    ],
                    "synonyms": [
                        "zich afmatten",
                        "zich overbelasten",
                        "zich forceren"
                    ],
                    "antonyms": [
                        "uitrusten",
                        "ontspannen"
                    ],
                    "common_phrases": [
                        "zich overwerken"
                    ],
                    "target_lang_definitions": {
                        "en": "to exhaust oneself by working too much or too hard"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to overwork oneself",
                                "target_lang_sense_clarification": "pushing oneself too hard at work"
                            },
                            {
                                "target_lang_word": "to overexert oneself",
                                "target_lang_sense_clarification": "straining oneself physically or mentally"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e2fc853-516e-3b5b-a434-80fe3f5c5ee5",
                    "sense_definition": "iets wat al gedaan is opnieuw bewerken of verbeteren",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aanpassing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schrijver besloot het eerste hoofdstuk van zijn boek volledig te <w>overwerken</w>.",
                            "target_lang_translations": {
                                "en": "The writer decided to completely <w>rework</w> the first chapter of his book."
                            }
                        },
                        {
                            "text": "Na de feedback van de klant moesten we het hele ontwerp <w>overwerken</w>.",
                            "target_lang_translations": {
