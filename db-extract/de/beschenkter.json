                                    {
                                        "sense_id": "dbe1eb79-1bc0-3fee-bad4-1eaf130310fc",
                                        "entry_id": "06edb6cd-4ce7-30f7-8b34-01df00fa73c8",
                                        "glosses": [
                                            "Someone who receives a gift from a donor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5a3b36-dfb2-4711-ade5-2382aa206246",
                                                "sense_id": "dbe1eb79-1bc0-3fee-bad4-1eaf130310fc",
                                                "text": "But this donee or this purchasoure shall take to their profyte all the vesture standyng vpon or beyng with in the sayd groūde"
                                            },
                                            {
                                                "example_id": "5c8022ba-c8e6-4f42-8e6b-009313d5b6e8",
                                                "sense_id": "dbe1eb79-1bc0-3fee-bad4-1eaf130310fc",
                                                "text": "John became the donee of the bone marrow donated by his brother."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f05888e6-5a2b-4982-af16-6f44fc14f89c",
                        "source_entry_id": "edbe1060-1b34-367d-880e-9e3b038d2bf4",
                        "source_sense_id": "396af2ed-add1-3cd8-ad4c-bae58e8b1ff5",
