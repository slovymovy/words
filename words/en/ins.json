    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59764606-8ceb-367a-b83d-fe3b4a9ff1ab",
                    "sense_definition": "Plural of <w>in</w>; often used to refer to those in office or power, or details.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He knows all the <w>ins</w> and outs of the new computer system.",
                            "target_lang_translations": {
                                "ru": "Он знает все <w>тонкости</w> и детали новой компьютерной системы.",
                                "tr": "Yeni bilgisayar sisteminin tüm <w>inceliklerini</w> ve ayrıntılarını biliyor."
                            }
                        },
                        {
                            "text": "The political <w>ins</w> were celebrating their victory while the opposition regrouped.",
                            "target_lang_translations": {
                                "ru": "Политические <w>силы, находящиеся у власти</w>, праздновали победу, пока оппозиция перегруппировывалась.",
                                "tr": "Muhalefet yeniden toparlanırken, <w>iktidardakiler</w> zaferlerini kutluyordu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ins and outs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от \"in\"; часто используется для обозначения тех, кто находится у власти, или деталей (в выражении \"ins and outs\").",
                        "tr": "\"in\" sözcüğünün çoğul hali; genellikle iktidarda veya yönetimde olan kişileri ya da detayları (özellikle \"ins and outs\" ifadesinde) belirtmek için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подробности",
                                "target_lang_sense_clarification": "в выражении \"ins and outs\""
                            },
                            {
                                "target_lang_word": "находящиеся у власти",
                                "target_lang_sense_clarification": "о политиках"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ayrıntı",
                                "target_lang_sense_clarification": "\"ins and outs\" deyiminde"
                            },
                            {
                                "target_lang_word": "iktidardakiler",
                                "target_lang_sense_clarification": "siyasette güç sahibi olanlar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55bbc4e7-0b7f-3b4e-bb6b-9c1ed7c0ba1e",
                    "sense_definition": "Abbreviation of <w>Insert</w>, typically referring to a key on a computer keyboard.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "abbreviations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Press the <w>Ins</w> key to toggle between insert and overwrite modes.",
                            "target_lang_translations": {
                                "ru": "Нажмите клавишу <w>Ins</w>, чтобы переключиться между режимами вставки и замены.",
                                "tr": "Araya ekleme ve üzerine yazma modları arasında geçiş yapmak için <w>Ins</w> tuşuna basın."
                            }
                        },
                        {
                            "text": "I accidentally hit <w>Ins</w> and started deleting my text as I typed.",
                            "target_lang_translations": {
                                "ru": "Я случайно нажал <w>Ins</w> и начал удалять текст по мере ввода.",
                                "tr": "Yanlışlıkla <w>Ins</w> tuşuna bastım ve yazdıkça metnimi silmeye başladı."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от Insert, обычно обозначающее клавишу на клавиатуре компьютера.",
                        "tr": "\"Insert\" sözcüğünün kısaltması, genellikle bilgisayar klavyesindeki bir tuşu ifade eder."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ins",
                                "target_lang_sense_clarification": "клавиша"
                            },
                            {
                                "target_lang_word": "Insert",
                                "target_lang_sense_clarification": "клавиша"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Ins",
                                "target_lang_sense_clarification": "klavye tuşu"
                            },
                            {
                                "target_lang_word": "Insert",
                                "target_lang_sense_clarification": "klavye tuşu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58cb184a-622b-3d7b-9348-882c2ae9cf22",
                    "sense_definition": "Initialism of inertial navigation system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_acronyms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aircraft's <w>INS</w> provided accurate location data without relying on GPS.",
                            "target_lang_translations": {
                                "ru": "<w>ИНС</w> самолета обеспечивала точные данные о местоположении, не полагаясь на GPS.",
                                "tr": "Uçağın <w>ataletsel seyrüsefer sistemi</w>, GPS'e ihtiyaç duymadan doğru konum verileri sağladı."
                            }
                        },
                        {
                            "text": "Engineers calibrated the <w>INS</w> before the submarine left the port.",
                            "target_lang_translations": {
                                "ru": "Инженеры откалибровали <w>ИНС</w> перед выходом подводной лодки из порта.",
                                "tr": "Mühendisler denizaltı limandan ayrılmadan önce <w>INS</w> sistemini kalibre etti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"inertial navigation system\" (инерциальная навигационная система).",
                        "tr": "Ataletsel seyrüsefer sistemi anlamına gelen \"inertial navigation system\" teriminin kısaltması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ИНС",
                                "target_lang_sense_clarification": "навигация"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ataletsel seyrüsefer sistemi",
                                "target_lang_sense_clarification": "navigasyon sistemi"
                            },
                            {
                                "target_lang_word": "INS",
                                "target_lang_sense_clarification": "navigasyon kısaltması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65c6cdbd-679c-324d-9b59-c2df682a9b91",
                    "sense_definition": "Initialism of isolated neutron star.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_acronyms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers identified a new <w>INS</w> by detecting its thermal X-ray emission.",
                            "target_lang_translations": {
                                "ru": "Астрономы идентифицировали новую <w>изолированную нейтронную звезду</w>, обнаружив её тепловое рентгеновское излучение.",
                                "tr": "Gökbilimciler, termal X-ışını emisyonunu tespit ederek yeni bir <w>yalıtılmış nötron yıldızı</w> keşfetti."
                            }
                        },
                        {
                            "text": "Studying an <w>INS</w> helps scientists understand the cooling of stellar remnants.",
                            "target_lang_translations": {
                                "ru": "Изучение <w>изолированной нейтронной звезды</w> помогает ученым понять процесс остывания звездных остатков.",
                                "tr": "Bir <w>yalıtılmış nötron yıldızını</w> incelemek, bilim insanlarının yıldız kalıntılarının soğumasını anlamalarına yardımcı olur."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от \"isolated neutron star\" (изолированная нейтронная звезда).",
                        "tr": "Yalıtılmış nötron yıldızı anlamına gelen \"isolated neutron star\" teriminin kısaltması."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изолированная нейтронная звезда",
                                "target_lang_sense_clarification": "астрономия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yalıtılmış nötron yıldızı",
                                "target_lang_sense_clarification": "astronomi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
