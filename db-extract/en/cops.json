                    {
                        "sense_id": "cfc19232-ee75-303a-8f15-1b4f2b6057e0",
                        "entry_id": "b5fab741-7e7b-3b83-8337-30fc1b763093",
                        "glosses": [
                            "The police, considered as a group entity."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c63259d1-d927-4d78-8091-1ec5bc9430b2",
                                "sense_id": "cfc19232-ee75-303a-8f15-1b4f2b6057e0",
                                "text": "\"Maybe he'll git the cops after you, Jack.\" \"I'll watch out fer dat, Nick, an' you must watch out too,\" answered Jack Sagger."
                            },
                            {
                                "example_id": "91771dd0-e9ed-4e5e-a417-cb694009bd68",
                                "sense_id": "cfc19232-ee75-303a-8f15-1b4f2b6057e0",
                                "text": "I saw them leaving,” he says, and he stops / “One of us had better call up the cops” / And so Patty calls the cops / And they arrive on the scene"
                            }
                        ]
                    }
                ],
