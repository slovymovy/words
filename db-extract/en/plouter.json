                "senses": [
                    {
                        "sense_id": "24d5be37-1ed8-33c2-a10d-b1332b56149b",
                        "entry_id": "6594686d-409c-3727-a55b-40cf6384a2a6",
                        "glosses": [
                            "To splash around in something wet; to dabble."
                        ],
                        "tags": [
                            "Ireland",
                            "Northern-England",
                            "Scotland",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "a4b2771d-a432-4509-8ab7-f85da061c2b7",
                                "sense_id": "24d5be37-1ed8-33c2-a10d-b1332b56149b",
                                "text": "As I did not want to plowter about any more in the drizzle and the dark, I put my waterproof over the muzzle of one gun, and made a sort of wigwam with two or three rammers that I found, and lay along the tail of another gun, wondering where Vixen had got to, and where I might be."
                            }
                        ]
                    },
                    {
                        "sense_id": "635c2071-fc03-374d-99d3-00b0b055d128",
                        "entry_id": "6594686d-409c-3727-a55b-40cf6384a2a6",
                        "glosses": [
                            "To potter."
                        ],
                        "tags": [
                            "Ireland",
                            "Northern-England",
                            "Scotland",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "08c52899-fa14-41a4-9e28-ebcbd98e12fc",
                                "sense_id": "635c2071-fc03-374d-99d3-00b0b055d128",
                                "text": "He's left th' yate ut t' full swing, and miss's pony has trodden dahn two rigs uh corn, un plottered through, raight o'er intuh t' meadow!"
                            },
                            {
                                "example_id": "aad5be0c-32bc-45d1-bd1a-2a5af57aaa4d",
                                "sense_id": "635c2071-fc03-374d-99d3-00b0b055d128",
                                "text": "[O]f course he prefers plottering about the house [...]"
                            },
                            {
                                "example_id": "946e1715-2a1a-4a17-a1fd-937a754ee41c",
                                "sense_id": "635c2071-fc03-374d-99d3-00b0b055d128",
                                "text": "So one night after they had all had supper in the kitchen and old Sinclair had gone pleitering out to the byres, old Mistress Sinclair had up and nodded to Kirsty […]."
                            },
                            {
                                "example_id": "39cc099d-3ed2-4472-939b-6b5cebcc4ca7",
                                "sense_id": "635c2071-fc03-374d-99d3-00b0b055d128",
                                "text": "There's certainly a small boat that people plouter about in."
                            }
                        ]
                    }
