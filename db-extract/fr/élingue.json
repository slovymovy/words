                                                "sense_id": "a6daa2e6-b007-3abd-b728-49067f9072a3",
                                                "text": "Noch weicher wird ein Gewebe, wenn man die Fäden der Schlingen aufschneidet."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "db1f3e95-a991-3459-961c-d5bc834bec22",
