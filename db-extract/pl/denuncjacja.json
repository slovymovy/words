                        "source_sense_id": "4c4248ae-ba81-3dde-975d-50b8f894a8b0",
                        "target_lang_word": "Denunziation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Denunziation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af7dfa3d-b227-36bd-846c-f908c54ef295",
                                        "entry_id": "a542600a-bca2-3e96-8457-ad7c0f7a9f29",
                                        "glosses": [
                                            "(oft anonyme und/oder falsche) Anzeige"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43bdefef-ee4e-45dc-9bc0-75c56e4b3955",
                                                "sense_id": "af7dfa3d-b227-36bd-846c-f908c54ef295",
                                                "text": "„Da lädt zum Beispiel ein Schreiben der Hausverwaltung offen zur Denunziation ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "068e2bbb-ffda-3923-ac28-6402fde9048f",
                                        "entry_id": "a542600a-bca2-3e96-8457-ad7c0f7a9f29",
                                        "glosses": [
                                            "öffentliche Bloßstellung/Brandmarkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3dca102-de7a-44da-9438-e6d1312f5059",
                                                "sense_id": "068e2bbb-ffda-3923-ac28-6402fde9048f",
                                                "text": "„Nach Erscheinen des Artikels trafen körbeweise Denunziationen bei der Zeitung ein.“"
                                            },
                                            {
                                                "example_id": "2b4ea41a-8cf3-4cbf-8c2c-3dafa8d58d6d",
                                                "sense_id": "068e2bbb-ffda-3923-ac28-6402fde9048f",
                                                "text": "„Was die »Sympathien« besonders fatal macht, ist, dass sie in einer veritablen Denunziation enden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
