                "senses": [
                    {
                        "sense_id": "e3e6940a-063b-3ec5-b47b-c7254732b55f",
                        "entry_id": "f2899858-d700-30bb-99e0-2cbac7b96f21",
                        "glosses": [
                            "Tiges de roseau fendues en deux et assemblées côte à côte au moyen de fil de fer, pour faire des pare-soleil, des cloisons de jardins, des panneaux décoratifs, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3345125e-47b6-43ca-8e36-1ba74c16c9b8",
                                "sense_id": "e3e6940a-063b-3ec5-b47b-c7254732b55f",
                                "text": "Avant les cannisses étaient utilisées dans le sud de la France en tant que claie pour le séchage des figues, ou l'élevage des vers à soie."
                            },
                            {
                                "example_id": "382d2015-c391-4044-a587-b07c6aa2906e",
                                "sense_id": "e3e6940a-063b-3ec5-b47b-c7254732b55f",
                                "text": "Les autres évitaient le dallage brûlant ou les rochers surchauffés et s’abritaient à l’ombre des cannisses du bar-restaurant, attablés devant des rafraîchissements illusoires."
                            },
                            {
                                "example_id": "19e9f3cc-a5c4-4f6e-bb29-9b52d9a13026",
                                "sense_id": "e3e6940a-063b-3ec5-b47b-c7254732b55f",
                                "text": "Le matin derrière ses cannisses,\nAlors qu'elle est moitié nue,\nSur les murs, devant chez Mélissa,\nY a tout plein d'inconnus."
                            }
                        ]
                    }
                ],
