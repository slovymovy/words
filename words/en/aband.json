    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c25890c7-4029-3990-a739-849de2a0059f",
                    "sense_definition": "To desert or forsake someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "desertion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fallen ruler was forced to <w>aband</w> his kingdom and flee across the sea.",
                            "target_lang_translations": {
                                "de": "Der gestürzte Herrscher war gezwungen, sein Königreich zu <w>verlassen</w> und über das Meer zu fliehen."
                            }
                        },
                        {
                            "text": "Fearing imminent ruin, the guards chose to <w>aband</w> their posts in the fortress.",
                            "target_lang_translations": {
                                "de": "Aus Angst vor dem drohenden Untergang entschieden sich die Wachen dazu, ihre Posten in der Festung <w>aufzugeben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "forsake",
                        "desert",
                        "abandon"
                    ],
                    "antonyms": [
                        "claim",
                        "retain"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "no longer in modern use"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "superseded by abandon"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden oder etwas im Stich lassen, verlassen oder preisgeben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verlassen",
                                "target_lang_sense_clarification": "einen Ort oder eine Person hinter sich lassen"
                            },
                            {
                                "target_lang_word": "im Stich lassen",
                                "target_lang_sense_clarification": "jemanden oder etwas hilflos zurücklassen"
                            },
                            {
                                "target_lang_word": "aufgeben",
                                "target_lang_sense_clarification": "eine Position oder einen Posten räumen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82dd7f63-a2be-3473-84d6-5ba02400538f",
                    "sense_definition": "To desist from practicing, using, or doing something; to renounce.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "renunciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose to <w>aband</w> worldly pleasures and enter the quiet life of the monastery.",
                            "target_lang_translations": {
                                "de": "Er entschied sich, den weltlichen Freuden zu <w>entsagen</w> und in das ruhige Klosterleben einzutreten."
                            }
                        },
                        {
                            "text": "Under extreme pressure from council elders, the knight had to <w>aband</w> his claim.",
                            "target_lang_translations": {
                                "de": "Unter dem extremen Druck der Ratsältesten musste der Ritter seinen Anspruch <w>aufgeben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "renounce",
                        "relinquish",
                        "abjure"
                    ],
                    "antonyms": [
                        "adopt",
                        "pursue",
                        "maintain"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "no longer in modern use"
                        },
                        {
                            "trait_type": "obsolete",
                            "comment": "superseded by abandon"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Aufhören, etwas zu tun, zu praktizieren oder zu nutzen; auf etwas förmlich verzichten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufgeben",
                                "target_lang_sense_clarification": "eine Gewohnheit, Praxis oder einen Anspruch beenden"
                            },
                            {
                                "target_lang_word": "verzichten auf",
                                "target_lang_sense_clarification": "freiwillig oder gezwungenermaßen ablassen von"
                            },
                            {
                                "target_lang_word": "entsagen",
                                "target_lang_sense_clarification": "gehoben: weltlichen Dingen oder Ansprüchen abschwören"
                            }
                        ]
                    }
                }
            ]
        }
    ]
