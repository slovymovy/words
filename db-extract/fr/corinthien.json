                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3797bec-66de-455c-bafa-ef0b69f6fb55",
                                                "sense_id": "d7cb4bd6-355f-320d-b11d-8705b0b3cbd4",
                                                "text": "Van elk land had hij een met uitsterven bedreigd of net gered product bij zich. Kalakukko, brood gevuld met in spek gerolde vis uit de Finse meren; Corinthisch spek van varkens die vrij grazen in de weilanden; Portugese ananas; Letse boerenkaas, gemaakt van rauwe melk, komijn, zout en eieren; en gedroogde gerookte bot gevangen in de zee voor Estland."
                                            }
                                        ]
