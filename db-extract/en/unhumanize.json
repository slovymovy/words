                        "glosses": [
                            "To strip of humanity; to dehumanize."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8f287d21-d469-4889-9abf-cd76de153c13",
                                "sense_id": "ac3633aa-d6de-3852-b68a-760b9b83eaed",
                                "text": "Further, in making him a slave, he does not merely unhumanize one individual, but UNIVERSAL MAN. He destroys the foundations."
                            },
                            {
                                "example_id": "5f84f260-ebb5-4b47-bcae-7b3a8dd551fd",
                                "sense_id": "ac3633aa-d6de-3852-b68a-760b9b83eaed",
                                "text": "If you will have that precision out of them, and make their fingers measure degrees like cog-wheels, and their arms strike curves like compasses, you must unhumanize them."
                            }
                        ]
                    }
