                                    },
                                    {
                                        "sense_id": "65893ac9-9a4d-3525-bfe0-14f9538f5bee",
                                        "entry_id": "17d8bd62-dc50-34da-bd66-0e06b4f15472",
                                        "glosses": [
                                            "To kill or destroy using high heat or fire; to cook; to burn."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1dec31-ec43-4a7a-84f8-72b8f10da2a0",
                                                "sense_id": "65893ac9-9a4d-3525-bfe0-14f9538f5bee",
                                                "text": "Then he picked up a flamethrower and he barbecued Blitzen\nAnd he took a big bite and said, \"It tastes just like chicken\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d4b5eca-a187-497b-a47e-222e0ef91fcb",
