                                "target_senses": [
                                    {
                                        "sense_id": "13fdb0a3-0769-3555-839d-04b7b4a25d70",
                                        "entry_id": "00a971b8-70a6-3c63-9220-74c745fd26c1",
                                        "glosses": [
                                            "A hard round black felt hat with a narrow brim, formerly worn by men."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ffa85e-945f-407a-94e7-9585121349eb",
                                                "sense_id": "13fdb0a3-0769-3555-839d-04b7b4a25d70",
                                                "text": "It takes a special arrogance to snort at an oral report on the origins (and proper tipping) of the bowler hat, but there’s Nathanial, giggling his way through the presentation before offering up his report on the more rarefied 14th-century Norwegian derby."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bowler hat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffd8187e-f40d-35b2-8d96-cb9d4c32c8d8",
                                        "entry_id": "47490793-b427-3837-afda-9bccdbd096aa",
                                        "glosses": [
                                            "Synonym of bowler hat out (“eject someone from an organization”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a546382-fda4-4661-ad85-40cb2a8f1a36",
                        "source_entry_id": "4d6f9d02-90ef-3189-886d-600341746015",
                        "source_sense_id": "b7d4fe32-a645-3f12-afc6-c963fbaf36e2",
                        "target_lang_word": "Melone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Melone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1cfbea5-3cc2-345f-8e97-f80e2b2fb30e",
                                        "entry_id": "f9671d40-6c36-3929-9239-50eb6a706c82",
                                        "glosses": [
                                            "ein in den Tropen vorkommendes Gewächs und seine große süße Frucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54390294-bc50-449c-b9a0-80ef0760a7b1",
                                                "sense_id": "f1cfbea5-3cc2-345f-8e97-f80e2b2fb30e",
                                                "text": "Als Vorspeise gibt es Parmaschinken mit Melone."
                                            },
                                            {
                                                "example_id": "b207c541-3c97-4e69-ae43-7dbd42be438e",
                                                "sense_id": "f1cfbea5-3cc2-345f-8e97-f80e2b2fb30e",
                                                "text": "„Früher, so erzählte mir Onkel Joe, gab es Melonen sogar ganz umsonst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "144215bd-1920-388c-8832-bef9d3ecb25e",
                                        "entry_id": "f9671d40-6c36-3929-9239-50eb6a706c82",
                                        "glosses": [
                                            "ein in den Tropen vorkommendes Gewächs und seine große süße Frucht",
                                            "Cucumis melo aus der Gattung der Gurken"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "e4bff6f2-2078-363f-935e-4c5f579610ae",
                                        "entry_id": "f9671d40-6c36-3929-9239-50eb6a706c82",
                                        "glosses": [
                                            "ein in den Tropen vorkommendes Gewächs und seine große süße Frucht",
                                            "die Wassermelone, Citrullus"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "a793d536-66e3-3f4d-90e3-d7e55a3c5e29",
                                        "entry_id": "f9671d40-6c36-3929-9239-50eb6a706c82",
                                        "glosses": [
                                            "ein Hut, der oben die Form einer Halbkugel hat"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "jocular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11d0c57-c528-42aa-b32c-aaad80da1a89",
                                                "sense_id": "a793d536-66e3-3f4d-90e3-d7e55a3c5e29",
                                                "text": "„Einer schrie am Telefon herum, ein anderer rannte mit Zetteln in den Händen hin und her, und der dritte stand, eine Melone weit auf den Hinterkopf geschoben, eine dicke, schwarze, zerkaute Brasil zwischen den Zähnen rollend, ohne Rock, mit aufgekrempelten Hemdsärmeln hinter einem der Pulte und notierte die Einsätze.“"
                                            },
                                            {
                                                "example_id": "b8d36e20-7094-476e-816e-f9b28ac4b9a9",
                                                "sense_id": "a793d536-66e3-3f4d-90e3-d7e55a3c5e29",
                                                "text": "„Einige junge Männer hatten Melonen auf, andere trugen Strohhüte.“"
                                            },
                                            {
                                                "example_id": "80d1feb3-58d1-4f79-93bb-538f3497ee7e",
                                                "sense_id": "a793d536-66e3-3f4d-90e3-d7e55a3c5e29",
                                                "text": "„Mancher ältere Deutsche dürfte sich bei dem Wort »Pan« sofort an »Pan Tau« erinnert fühlen, den eleganten, stummen Gentleman aus der tschechischen Kinderserie, der die Fähigkeit besaß, sich durch ein Tippen an die Krempe seiner Melone in eine westentaschengroße Puppe zu verwandeln.“"
                                            },
                                            {
                                                "example_id": "3ef3f992-6224-4436-abaf-7cc11617743b",
                                                "sense_id": "a793d536-66e3-3f4d-90e3-d7e55a3c5e29",
                                                "text": "„Er trug eine Melone und einen schwarzen, vor der Brust zugeknöpften Mantel.“"
                                            },
                                            {
                                                "example_id": "80af74cb-a452-4c45-986a-6fc4af871e6b",
                                                "sense_id": "a793d536-66e3-3f4d-90e3-d7e55a3c5e29",
                                                "text": "„Kurt sah sich um. Männer mit einfachen Joppen und Schiebermützen neben Herren mit gestärktem Kragen und Melone.“"
                                            },
                                            {
                                                "example_id": "6c5e255f-3285-4450-a5da-5f544bd61f55",
                                                "sense_id": "a793d536-66e3-3f4d-90e3-d7e55a3c5e29",
                                                "text": "„Über die Jahre hatte sie sich an die schwarze Melone, die stets leicht zur Seite auf dem Kopf balancierte, gewöhnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f7237ead-2d73-3f2c-a960-c562a541c82b",
                                        "entry_id": "f9671d40-6c36-3929-9239-50eb6a706c82",
                                        "glosses": [
                                            "über dem Oberkiefer gelegenes Organ bei Zahnwalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680a0475-1692-4b2f-a320-53a1dd0a9be6",
                                                "sense_id": "f7237ead-2d73-3f2c-a960-c562a541c82b",
                                                "text": "Aus der Melone des Pottwals stammte der Walrat."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
