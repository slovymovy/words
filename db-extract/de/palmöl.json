                "senses": [
                    {
                        "sense_id": "29fa8665-0c36-30d4-8e20-7a8764d68750",
                        "entry_id": "4e58f9bd-12df-3a91-b320-735906a7939e",
                        "glosses": [
                            "Öl, das aus der Palmfrucht gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f3ad80-ccbe-4a4a-9e02-fbfd7bee7948",
                                "sense_id": "29fa8665-0c36-30d4-8e20-7a8764d68750",
                                "text": "„Die Spur des Verbrechens führt auch zu uns, nach Europa, wo der Bedarf an Palmöl stetig steigt.“"
                            },
                            {
                                "example_id": "076fee17-9f76-42a6-9696-77c19aa921e9",
                                "sense_id": "29fa8665-0c36-30d4-8e20-7a8764d68750",
                                "text": "„Sie bereute es beinahe, den Kürbis weggeworfen zu haben, stellte sich das orangefarbene Fruchtfleisch vor, gekocht und in Palmöl getunkt.“"
                            },
                            {
                                "example_id": "331b3359-f295-47c6-b0b5-ca16ba103fee",
                                "sense_id": "29fa8665-0c36-30d4-8e20-7a8764d68750",
                                "text": "„Die Produktion von Biokraftstoff, der aus Palmöl, Weizen, Mais oder Zuckerrüben hergestellt wird, führt zu massiven Entwaldungen in Südostasien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
