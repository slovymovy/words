{
    "word_family": [
        "queasy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97665136-960d-3772-ba93-ffffab2a2943",
                    "sense_definition": "The state of feeling sick to one's stomach; nausea.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rough sea caused a sudden <w>queasiness</w> in many of the passengers.",
                            "target_lang_translations": {
                                "zh": "波涛汹涌的大海让许多乘客突然感到一阵<w>恶心</w>。"
                            }
                        },
                        {
                            "text": "She tried to ignore the <w>queasiness</w> after eating the spoiled food.",
                            "target_lang_translations": {
                                "zh": "她吃了变质的食物后，试图忽略那种<w>反胃</w>的感觉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nausea",
                        "nauseousness"
                    ],
                    "common_phrases": [
                        "sudden queasiness",
                        "feeling queasiness"
                    ],
                    "target_lang_definitions": {
                        "zh": "感到胃部不适或想呕吐的状态；恶心。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "恶心",
                                "target_lang_sense_clarification": "指生理上的反胃感。"
                            },
                            {
                                "target_lang_word": "反胃",
                                "target_lang_sense_clarification": "指胃部不适，有呕吐感。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62858a3a-d72a-31dd-8427-dc2e755c1366",
                    "sense_definition": "A feeling of mental discomfort or moral unease; squeamishness.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mental_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a deep <w>queasiness</w> about the unethical nature of the business deal.",
                            "target_lang_translations": {
                                "zh": "他对这笔交易的不道德性质感到深深的<w>不安</w>。"
                            }
                        },
                        {
                            "text": "The graphic violence in the film left the audience with a sense of <w>queasiness</w>.",
                            "target_lang_translations": {
                                "zh": "电影中血腥暴力的画面让观众感到一阵<w>反感</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "squeamishness",
                        "unease"
                    ],
                    "common_phrases": [
                        "moral queasiness"
                    ],
                    "target_lang_definitions": {
                        "zh": "心理上的不安或道德上的不适感；易受惊吓或反感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不安",
                                "target_lang_sense_clarification": "指心理上的不适或忧虑。"
                            },
                            {
                                "target_lang_word": "反感",
                                "target_lang_sense_clarification": "指对某事感到厌恶或不适。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}