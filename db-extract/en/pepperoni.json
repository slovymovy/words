                                        "entry_id": "467e54fa-8900-36f5-9a72-9ca5ad5cfce8",
                                        "glosses": [
                                            "Salami épicé d'origine italo-américaine, fait à base de viande de porc et de bœuf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b333c2fc-fb1e-4b96-b1e0-d417245c5abf",
                                                "sense_id": "4921ee7b-a9d1-313a-850a-f19a7a8c58c7",
                                                "text": "Étalez la sauce tomate, répartissez la mozzarella, les rondelles de pepperoni et les olives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce8b6d8e-6b92-3d6c-849c-ff869e781829",
                                        "entry_id": "467e54fa-8900-36f5-9a72-9ca5ad5cfce8",
                                        "glosses": [
                                            "Pizza aux pepperoni, généralement avec poivrons verts et champignons."
                                        ],
                                        "tags": [
                                            "Au féminin"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81aed18f-7f44-4bf6-a570-154cc98ee251",
                        "source_entry_id": "0edeaa4b-827d-315c-a2c0-503dc598b8c3",
                        "source_sense_description": "sausage",
                        "target_lang_word": "Salami",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "196db82e-4af9-30d8-849c-bca5703a410d",
                                        "entry_id": "a5bf2a86-38fc-3f6d-9412-20aa1a8fa048",
                                        "glosses": [
                                            "eine ursprünglich in Italien produzierte, stark gewürzte, luftgetrockene Dauerwurst aus Rind- oder Schweinefleisch - in früheren Zeiten auch aus Esels- oder Maultierfleisch -, deren Haut traditionell durch den Trocknungsprozess an der Luft mit einem Naturschimmelbelag überzogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6558510-78b7-49c0-8b19-6f8dd7e96bbe",
                                                "sense_id": "196db82e-4af9-30d8-849c-bca5703a410d",
                                                "text": "Salami gehört zu den beliebtesten Wurstwaren Deutschlands."
                                            },
                                            {
                                                "example_id": "248b97a7-03e4-4933-b890-8d96f6ebf1eb",
                                                "sense_id": "196db82e-4af9-30d8-849c-bca5703a410d",
                                                "text": "Antipasti besteht oft aus dünn geschnittener Salami, eingelegtem Gemüse und Früchten."
                                            },
                                            {
                                                "example_id": "7b09f257-523d-4d88-b8df-60d5f0cad67a",
                                                "sense_id": "196db82e-4af9-30d8-849c-bca5703a410d",
                                                "text": "„Ich will noch nicht die einzige Salami anbrechen, weil sie mir inmitten der Büchsenwurst, dem Dosenfisch und dem Schmelzkäse wie ein Heiligtum vorkommt, das ich nicht verschwenden darf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
