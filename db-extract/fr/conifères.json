                "word": "conifères",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0cabac91-03fb-3f62-9de0-ee71c42d170a",
                        "entry_id": "fb1a29da-f168-3e34-8716-1922c8327ab8",
                        "glosses": [
                            "Embranchement de plantes vasculaires, en grande majorité des arbres, comprenant entre autres le cèdre, le cyprès, le douglas, le sapin, le genévrier, l’agathis, le mélèze, le pin, le séquoia, l’épicéa et l’if. Son nom scientifique est Pinophyta."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "716460b4-e9b3-4d51-91b7-ae581331df69",
                                "sense_id": "0cabac91-03fb-3f62-9de0-ee71c42d170a",
                                "text": "Les espèces de conifères peuvent pousser naturellement presque partout dans le monde, et sont fréquemment les plantes dominantes dans leur habitat."
                            },
                            {
                                "example_id": "9f94269f-34d9-4354-a741-043d8dd708f9",
                                "sense_id": "0cabac91-03fb-3f62-9de0-ee71c42d170a",
                                "text": "Les grands Ptéridophytes disparaissent, et des Conifères rappelant les types actuels font leur apparition."
                            }
                        ]
                    }
                ],
