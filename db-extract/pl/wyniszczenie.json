                "senses": [
                    {
                        "sense_id": "e04ec3dc-af16-3d90-a039-ea0fa389d4dd",
                        "entry_id": "edd51ac8-7d9f-334b-9eee-5831b4303a1d",
                        "glosses": [
                            "doprowadzić do utraty możliwości funkcjonowania a nawet całkowitego unicestwienia"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "78442413-bcc0-4196-8836-993163bc16f3",
                                "sense_id": "e04ec3dc-af16-3d90-a039-ea0fa389d4dd",
                                "text": "Wysłałem w jej ślady gońca zaufanego, któremu kazałem oddać królowej wiązankę rzadkiej trawy górskiej — najlepszy środek na wyniszczenie włosów na ciele..."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "af795f05-0be8-394f-af2b-982cf68e4b9e",
                        "entry_id": "edd51ac8-7d9f-334b-9eee-5831b4303a1d",
                        "glosses": [
                            "spowodować upadek ekonomiczny"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f3f45f93-d2ad-4cb5-8f01-e4d6e88ff8c8",
                                "sense_id": "af795f05-0be8-394f-af2b-982cf68e4b9e",
                                "text": "Co rząd zrobi, by zapobiec wyniszczeniu gospodarki?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "cf72eb30-c113-32c9-8423-04383f292e88",
                        "entry_id": "edd51ac8-7d9f-334b-9eee-5831b4303a1d",
                        "glosses": [
                            "poważnie osłabić organizm"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "c3ff26d9-01f5-4094-a2ea-8ce4b1d238b9",
                                "sense_id": "cf72eb30-c113-32c9-8423-04383f292e88",
                                "text": "— Tak samo jak pan, leczył się tajemniczo za pomocą trucizn, które, jak mu się zdawało, przynosiły mu ulgę, lecz które sprowadziły zupełne wyniszczenie... W chwili gdy mniemał że jest wyleczony, zakończył życie..."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "1e577f2b-bd5d-3150-bbbc-bf7225c9821a",
                        "entry_id": "edd51ac8-7d9f-334b-9eee-5831b4303a1d",
                        "glosses": [
                            "zabicie grupy ludzi"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "1884db8e-297a-43bd-bbca-818a1d5143bc",
                                "sense_id": "1e577f2b-bd5d-3150-bbbc-bf7225c9821a",
                                "text": "Niemcom i Rosjanom zależało na wyniszczeniu narodu polskiego."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
