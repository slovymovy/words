                "translations": [
                    {
                        "translation_id": "bca5b199-29eb-4117-beeb-0753dcdc9655",
                        "source_entry_id": "55eacb19-4f32-3990-8bf8-de299867ddbf",
                        "source_sense_id": "6f84a652-09a7-304f-bba3-512c07d28127",
                        "target_lang_word": "embracing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embracing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd82ec2c-109c-3901-a7e7-1efdee3db0a9",
                                        "entry_id": "ce4524d6-78ad-38c8-bb01-b7a9727eb4a9",
                                        "glosses": [
                                            "present participle and gerund of embrace"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
