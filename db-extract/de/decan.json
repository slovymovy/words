                        "entry_id": "7e29f086-8e99-33e6-87db-e7f71bda5971",
                        "glosses": [
                            "Stoffgruppe von isomeren Verbindungen mit der Summenformel C₁₀H₂₂"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "90487d7a-9741-4e94-866d-6698b57b1107",
                                "sense_id": "793f048e-e4b9-3aba-a075-5aaccd4f1c4e",
                                "text": "Die Decane sind eine Stoffgruppe aus der Gruppe der Alkane."
