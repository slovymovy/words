                                        "sense_id": "3a2cc5e0-be03-38d7-b2da-f2d1f6e02fb7",
                                        "entry_id": "6a1aef72-829f-3766-943f-3200d39d798e",
                                        "glosses": [
                                            "By accident; without the intention to do so."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad58c04e-14a3-4f8d-accc-d41bf0ea35fe",
                                                "sense_id": "3a2cc5e0-be03-38d7-b2da-f2d1f6e02fb7",
                                                "text": "Today I took your packed lunch to work by mistake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "82064e60-20d8-4a1f-99a0-3e90f4792972",
