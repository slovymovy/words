                "senses": [
                    {
                        "sense_id": "72ec3bc3-7f38-3cd6-92f0-cd3c22d915e8",
                        "entry_id": "ed2b6d38-2d68-3a2f-9545-7efc94e82b61",
                        "glosses": [
                            "von heftigem Regen betroffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01af81b4-7eea-43ba-ae95-c7d64bf3f86b",
                                "sense_id": "72ec3bc3-7f38-3cd6-92f0-cd3c22d915e8",
                                "text": "„Das Kind, von seinem Vater, der sich den Naturwissenschaften verschrieben hatte, Lionel genannt, kam an einem regengepeitschten Novembertag zur Welt, an dem unablässig Blitze den Himmel zerrissen.“"
                            },
                            {
                                "example_id": "5211300e-eb90-43cb-a705-6b52a4a3c3b1",
                                "sense_id": "72ec3bc3-7f38-3cd6-92f0-cd3c22d915e8",
                                "text": "„Als ich mit dem Strahl den regengepeitschten Musikpavillon ableuchtete, witterte ich einen Moment lang beinahe wieder den Hauch eines Schattens, also rannte ich über die Ocean Avenue und suchte alles ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
