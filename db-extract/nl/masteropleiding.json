                "senses": [
                    {
                        "sense_id": "03361965-5012-34e3-9b2a-f0ddb4fc101c",
                        "entry_id": "a2b13297-f6ef-3f7d-838a-74fce1479ae5",
                        "glosses": [
                            "studie die volgt op de bacheloropleiding en waarbij de student een mastertitel krijgt na het voltooien van deze opleiding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36040e5b-418a-40f3-a5f2-30aed73884db",
                                "sense_id": "03361965-5012-34e3-9b2a-f0ddb4fc101c",
                                "text": "\"Die 200 euro extra zou al lucht geven\", zegt Talbot die in Wassenaar woont en bezig is met haar tweede masteropleiding. Zij vindt de manier waarop de regeling telkens wordt doorgeschoven erg vervelend."
                            },
                            {
                                "example_id": "b3035a1b-18ba-413c-aef0-c3f1223781bc",
                                "sense_id": "03361965-5012-34e3-9b2a-f0ddb4fc101c",
                                "text": "Ook op andere manieren wordt het lerarentekort aangepakt. Zo beginnen vier universiteiten in 2022 een masteropleiding tot leraar basisonderwijs, meldt AD vandaag."
                            },
                            {
                                "example_id": "bf41c73f-84b8-4bbe-85c8-22e4d6454e8d",
                                "sense_id": "03361965-5012-34e3-9b2a-f0ddb4fc101c",
                                "text": "Ook het leven van de Afghaanse Sarah verandert door het verbod ingrijpend. Zij rondt haar masteropleiding in het strafrecht af, als de Taliban aan de macht komen. \"Inmiddels hoor ik iedere dag op televisie dat vrouwen thuis horen te zijn\", zegt Sarah. \"Vrouwen moeten zich alleen maar met religie bezighouden\", vertelt ze in een e-mail."
                            }
                        ]
                    }
