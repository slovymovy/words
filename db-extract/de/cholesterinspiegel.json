                "senses": [
                    {
                        "sense_id": "b692b57e-ad2c-3832-9556-57863b221e0f",
                        "entry_id": "0a79911a-8962-3f63-adda-3171481be3e2",
                        "glosses": [
                            "Maß für die Menge an Cholesterin, die sich im Blut befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0016ad30-abe6-46af-bbb8-eb3bdd87eca9",
                                "sense_id": "b692b57e-ad2c-3832-9556-57863b221e0f",
                                "text": "„Das Vorurteil, dass Eier und Butter den Cholesterinspiegel in die Höhe schießen lassen, ist immer noch weit verbreitet.“"
                            },
                            {
                                "example_id": "95be3648-7e96-4394-8067-2a69aa52f55b",
                                "sense_id": "b692b57e-ad2c-3832-9556-57863b221e0f",
                                "text": "Gallensteinsäureaustauschharze waren das erste Gegenmittel zur Senkung des Cholesterinspiegels."
                            },
                            {
                                "example_id": "151a0849-2dd1-485b-8215-090db5d2d454",
                                "sense_id": "b692b57e-ad2c-3832-9556-57863b221e0f",
                                "text": "„Der Mann nahm weiter zu, und sein Cholesterinspiegel boomte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
