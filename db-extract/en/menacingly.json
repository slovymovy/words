                        "entry_id": "f2e93316-46c6-3db8-af93-b51b0e1cc83b",
                        "glosses": [
                            "In a menacing manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c423fe1f-0d4a-4935-bf7b-bf7dff84573e",
                                "sense_id": "6a1d15be-b69d-38eb-bc97-50c8b23f0be9",
                                "text": "Food, more and better, was placed near her - but, dumb and motionless, she lay with her face turned to the wall, and her dog growled menacingly at the stranger."
                            },
                            {
                                "example_id": "321d1db2-8f0d-470c-93be-5e9d8b6499e6",
                                "sense_id": "6a1d15be-b69d-38eb-bc97-50c8b23f0be9",
                                "text": "Thor glared at him [...] what little light there was in the place mustered its forces briefly to glint menacingly off the horns of his helmet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77da54a3-f5da-4b8d-ba41-905b64d2d6d0",
                        "source_entry_id": "f2e93316-46c6-3db8-af93-b51b0e1cc83b",
                        "source_sense_id": "6a1d15be-b69d-38eb-bc97-50c8b23f0be9",
