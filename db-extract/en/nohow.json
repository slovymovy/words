                        "sense_id": "1bbdad53-c1cb-31f0-9fa1-d2de370d6cf3",
                        "entry_id": "a30ace9f-64d2-3dc6-bca7-5a1e5b482c35",
                        "glosses": [
                            "In no way; not at all; by no available means."
                        ],
                        "tags": [
                            "not-comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3f69733e-9af1-4ce2-a94d-5c11987d2e6d",
                                "sense_id": "1bbdad53-c1cb-31f0-9fa1-d2de370d6cf3",
                                "text": "\"We don't see it here nohow,\" returned the man."
                            },
                            {
                                "example_id": "4f8193f0-aeae-48b9-a286-0ac5fb9dbd39",
                                "sense_id": "1bbdad53-c1cb-31f0-9fa1-d2de370d6cf3",
                                "text": "Don't take life so serious, son. It ain't nohow permanent."
                            },
                            {
                                "example_id": "59b6e8ec-18e6-4b6d-baf1-d82e50c818ee",
                                "sense_id": "1bbdad53-c1cb-31f0-9fa1-d2de370d6cf3",
                                "text": "\"You'd start bidding before you knew what you was doing. I won't permit it nohow.\""
                            },
                            {
                                "example_id": "8f79f49b-6bdf-4e33-9ecb-b6533c5d6239",
                                "sense_id": "1bbdad53-c1cb-31f0-9fa1-d2de370d6cf3",
                                "text": "And his face clouded. “I don't know. I got to find out. Looks like I can't get my mind straight nohow.”"
                            }
                        ]
                    }
                ],
