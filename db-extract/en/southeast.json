                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b687e2a9-4341-300d-a0b8-d9a2ecb18932",
                                        "entry_id": "59cccc4a-4927-39dc-96ab-d5359ebe98d1",
                                        "glosses": [
                                            "de windstreek die 45° ten oosten van het zuiden ligt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21587e42-fe9d-4ea7-a9e3-8d5c11dbce28",
                                                "sense_id": "b687e2a9-4341-300d-a0b8-d9a2ecb18932",
                                                "text": "En ook na de duur betaalde vrede, die de dappere Finnen Karelië en grote gebieden in het zuidoosten hadden gekost, was er niet veel om over te discussiëren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "514ce3d8-81c4-4205-a4d9-0bf26c599258",
                        "source_entry_id": "015d2f64-bfa4-3648-8569-73bf9d4ec7a6",
                        "source_sense_id": "46c147a8-61a3-304b-918f-4e1d3c8f7045",
                        "source_sense_description": "compass point",
                        "target_lang_word": "sud-est",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sud-est",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c0e7f68-d4eb-3f64-a876-d382ab4c04be",
                                        "entry_id": "c07f8bc1-a370-3ba7-bd64-1b65d939bd63",
                                        "glosses": [
                                            "Point de l’horizon qui est entre le sud et l’est. Il correspond à l'azimut 135°."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba718a8-d665-4ddf-8b12-e2150524878e",
                                                "sense_id": "3c0e7f68-d4eb-3f64-a876-d382ab4c04be",
                                                "text": "À Sétif (300 km au sud-est d’Alger), deux personnes ont été mortellement asphyxiées dans leur domicile par les fumées provenant d’un incendie qui s’est déclenché à proximité de leur village."
                                            },
                                            {
                                                "example_id": "b626792d-f080-4550-83cd-6c473f5869ee",
                                                "sense_id": "3c0e7f68-d4eb-3f64-a876-d382ab4c04be",
                                                "text": "Le lendemain, au petit jour, je n'aperçois plus la terre et mes observations me montrent que j'ai été déporté à trente milles au Sud-Est."
                                            },
                                            {
                                                "example_id": "74107a7a-0e9b-40b7-804f-8b8cd98d39db",
                                                "sense_id": "3c0e7f68-d4eb-3f64-a876-d382ab4c04be",
                                                "text": "La commune de La Chapelle-Heulin se situe au cœur du vignoble nantais, au sud-est du département de la Loire-Atlantique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e712e390-9f76-3334-9a19-8a6cc9c86940",
                                        "entry_id": "c07f8bc1-a370-3ba7-bd64-1b65d939bd63",
                                        "glosses": [
                                            "Vent qui souffle entre le sud et l’est."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sud-est",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61631489-6a52-307f-b692-48763add53bd",
                                        "entry_id": "0f37f508-dcfa-3c74-bd06-75878f31ac14",
                                        "glosses": [
                                            "Qui vient du sud-est."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c9c109b-5a8c-4177-92be-664193a71ab6",
                                                "sense_id": "61631489-6a52-307f-b692-48763add53bd",
                                                "text": "Le vent est sud-est."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba5fa394-ccac-499a-834b-abcbf6492f2c",
                        "source_entry_id": "015d2f64-bfa4-3648-8569-73bf9d4ec7a6",
                        "source_sense_id": "46c147a8-61a3-304b-918f-4e1d3c8f7045",
                        "source_sense_description": "compass point",
                        "target_lang_word": "Südosten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Südosten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a276b4be-8ee6-359b-93ce-e05534ec903e",
                                        "entry_id": "fd71d94d-c03c-3280-a472-e4059829fa85",
                                        "glosses": [
                                            "die Nebenhimmelsrichtung, die dem Nordwesten gegenüber und zwischen Süden und Osten liegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6321b6e-8b74-4751-96fd-a1539ca50e43",
                                                "sense_id": "a276b4be-8ee6-359b-93ce-e05534ec903e",
                                                "text": "Der Weg biegt nach Südosten ab."
                                            },
                                            {
                                                "example_id": "c80412ea-7d22-41f5-84a7-b03197d99cb3",
                                                "sense_id": "a276b4be-8ee6-359b-93ce-e05534ec903e",
                                                "text": "„Während sie so beim Weine saßen, waren Wolken heraufgezogen und bildeten im Südosten eine Nebelwand.“"
                                            },
                                            {
                                                "example_id": "d77875d6-b7de-47f6-8bb9-edea601c1ee1",
                                                "sense_id": "a276b4be-8ee6-359b-93ce-e05534ec903e",
                                                "text": "„Das Wetter zeigte sich veränderlich, der Wind hatte auf Südosten gedreht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "10888f29-506e-36f2-bfd9-442b5dd64ef8",
                                        "entry_id": "fd71d94d-c03c-3280-a472-e4059829fa85",
                                        "glosses": [
                                            "der von der Mitte aus in dieser Richtung liegende Teil eines Gebiets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "840a5f3c-a36e-4f26-b1eb-b4a7dea7ef14",
                                                "sense_id": "10888f29-506e-36f2-bfd9-442b5dd64ef8",
                                                "text": "Seine Familie stammte aus dem Südosten."
                                            },
                                            {
                                                "example_id": "9615b075-9c6e-4bc7-8ae0-ae1b21003f8b",
                                                "sense_id": "10888f29-506e-36f2-bfd9-442b5dd64ef8",
                                                "text": "„Es ist der erste Sieg, den Portugal in diesem Eroberungskrieg im Südosten Afrikas erringt.“"
                                            },
                                            {
                                                "example_id": "2cf805f2-4521-4b46-8de9-68f29788bc85",
                                                "sense_id": "10888f29-506e-36f2-bfd9-442b5dd64ef8",
                                                "text": "„Delhi nutzte die pakistanische Führungsschwäche, um am Tag nach Jinnahs Begräbnis kurzerhand in das Fürstentum Hyderabad im Südosten Indiens einzumarschieren und dieses zu annektieren.“"
                                            },
                                            {
                                                "example_id": "9fed3672-09ba-41f0-9768-d0aae1df2cfe",
                                                "sense_id": "10888f29-506e-36f2-bfd9-442b5dd64ef8",
                                                "text": "„Am Donnerstagmorgen sind noch immer 13.700 Kunden im Berliner Südosten von der Stromversorgung abgeschnitten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
