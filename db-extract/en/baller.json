                        ]
                    },
                    {
                        "sense_id": "022801f9-f5c7-3484-bd81-0333f29224f7",
                        "entry_id": "42c0df23-d581-37d7-aaa6-c3a59ded2220",
                        "glosses": [
                            "A person employed to divide molten metal into separate balls before it is hammered out."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "51185f17-2961-3a5e-aabc-a971869750b5",
                        "entry_id": "42c0df23-d581-37d7-aaa6-c3a59ded2220",
                        "glosses": [
                            "One who plays basketball (US) or association football (UK)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6da8a217-b1c8-4173-afcf-1ce7cffe125b",
                                "sense_id": "51185f17-2961-3a5e-aabc-a971869750b5",
                                "text": "I wish I was a little bit taller, I wish I was a baller."
                            },
                            {
                                "example_id": "c9dbaaa6-da01-4466-97bd-5bf3ec8b02d2",
                                "sense_id": "51185f17-2961-3a5e-aabc-a971869750b5",
                                "text": "I want them aspiring to be scientists and engineers, doctors and teachers, not just ballers and rappers."
                            }
                        ]
                    },
                    {
                        "sense_id": "c00e2457-db93-3a0f-b499-a2f392378e7c",
                        "entry_id": "42c0df23-d581-37d7-aaa6-c3a59ded2220",
                        "glosses": [
                            "One who has swag and lives an extravagant lifestyle."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a74f5a3a-f853-4b1b-9e5c-5ec569d840ec",
                                "sense_id": "c00e2457-db93-3a0f-b499-a2f392378e7c",
                                "text": "Did you see that car? He’s such a baller."
                            },
                            {
                                "example_id": "8fe65b66-cb60-49e5-b59b-a69e06dd122a",
                                "sense_id": "c00e2457-db93-3a0f-b499-a2f392378e7c",
                                "text": "Now… what y'all wanna do? / Wanna be ballers? Shot-callers? Brawlers?"
                            },
                            {
                                "example_id": "a78ed785-770c-44dc-950f-6c920b9400f6",
                                "sense_id": "c00e2457-db93-3a0f-b499-a2f392378e7c",
                                "text": "But you really wouldn't mind a millionaire / All them big ballers / Don't do nothing for ya / But you'd love a rich man six-foot-two or taller"
                            }
                        ]
                    },
                    {
                        "sense_id": "c49cbe2f-ff08-3690-b8ad-1d162175e27b",
                        "entry_id": "42c0df23-d581-37d7-aaa6-c3a59ded2220",
                        "glosses": [
                            "A person having sex."
