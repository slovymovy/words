                "senses": [
                    {
                        "sense_id": "6bcb9fb4-8da2-34f7-9d5d-a873e163af22",
                        "entry_id": "116ec24d-aea0-3ea3-8af5-0eab6e3a6a17",
                        "glosses": [
                            "Krankenhaus des österreichischen Bundesheeres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc7b4126-3fa3-49d1-99ae-7159fe4b9d4f",
                                "sense_id": "6bcb9fb4-8da2-34f7-9d5d-a873e163af22",
                                "text": "„Das Bundesheer übernahm anschließend das 20 Hektar große Gelände samt allen Gebäuden und baute es in den Jahren 1960-1964 als Heeresspital mit vier Operationssälen und einer Kapazität von 177 Betten aus.“"
                            },
                            {
                                "example_id": "14b622fb-060d-4711-bb82-3e766e499034",
                                "sense_id": "6bcb9fb4-8da2-34f7-9d5d-a873e163af22",
                                "text": "„Und um sie beim Heeresspital in Floridsdorf zum Umzug zu animieren, werden nun sechs Hektar Ausgleichsflächen zieselgerecht umgestaltet.“"
                            },
                            {
                                "example_id": "03f94a81-ea3a-4ebb-98a1-0bbd8e0251bb",
                                "sense_id": "6bcb9fb4-8da2-34f7-9d5d-a873e163af22",
                                "text": "„Ob die Heeresspitäler in Wien, Graz und Innsbruck geschlossen, verkleinert oder in Sanitätseinrichtungen umgewandelt werden, steht noch nicht fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
