                    {
                        "translation_id": "9a4628ab-075a-4019-9b9a-3ad5439a5f96",
                        "source_entry_id": "eb6b2c87-1764-3ec3-a231-b4b0a5dbcd56",
                        "source_sense_id": "b14ac26d-4de2-352e-8723-ac93169e699b",
                        "target_lang_word": "magnetize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetize",
