                                    {
                                        "sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                                        "entry_id": "d3312869-84d9-3bfe-bdd8-079f3cda90bd",
                                        "glosses": [
                                            "Cancer des cellules de la moelle osseuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53351500-a682-4492-a9a3-e5d0006ae102",
                                                "sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                                                "text": "Ces diagnostics de leucémie font passer l’équipe médicale par des moments particulièrement difficiles."
                                            },
                                            {
                                                "example_id": "cce1a25d-10fd-497e-b3e7-38672a6c5c9d",
                                                "sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                                                "text": "Le don de sang permet de soigner de nombreuses maladies et de nombreux cancers tels que leucémies, lymphomes, myélomes…"
                                            },
                                            {
                                                "example_id": "6aa2ae51-531f-4786-97bd-f4a3aa258971",
                                                "sense_id": "cd6c494f-28cc-3afe-9811-a0cc5027b0b6",
                                                "text": "Eux qui ont cru au progrès de la science et à ses mots (produits « phytosanitaires », « glyphosate »), découvrent dans leur chambre d’hôpital l’autre nom du projet productiviste : leucémie, tumeur cérébrale, cancer du sang, mélanome, blastes, troubles cognitifs, moelle osseuse détruite…"
                                            }
                                        ]
                                    }
                                ]
                            }
