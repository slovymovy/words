                                    {
                                        "sense_id": "d3ee8c79-f105-38ae-a222-6b7603ade7c3",
                                        "entry_id": "d0de6c4f-5e55-360f-ae80-a844f7d13f2f",
                                        "glosses": [
                                            "modern maken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3f56b1f-8898-438a-92ca-ff1803c241c7",
                                                "sense_id": "d3ee8c79-f105-38ae-a222-6b7603ade7c3",
                                                "text": "Dat zit zo: jarenlang historisch onderzoek, onder andere van de Wereldbank, laat zien dat de economische ontwikkeling van een land bijna zonder uitzondering begint bij het moderniseren van de landbouw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cc92e2d-3f83-4af1-ad31-5dc549a79fa9",
                        "source_entry_id": "432455e9-a44c-3f62-890c-101dec08f5bd",
                        "source_sense_description": "bring something up to date",
                        "target_lang_word": "moderniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moderniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59ee2a0a-a3b5-3945-a491-92d7b3395a7d",
                                        "entry_id": "008f848a-a2d8-3ced-8b83-4e53d13b39e6",
                                        "glosses": [
                                            "Organiser d’une façon moderne ; adapter aux goûts ou aux besoins modernes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a447073e-c759-4aa2-b015-4aa26be68e83",
                                                "sense_id": "59ee2a0a-a3b5-3945-a491-92d7b3395a7d",
                                                "text": "— De toutes les villes du département du Nord, Douai est, hélas ! celle qui se modernise le plus, où le sentiment innovateur a fait les plus rapides conquêtes, où l’amour du progrès social est le plus répandu."
                                            },
                                            {
                                                "example_id": "662e9780-4615-4730-b3ba-523d978a64f6",
                                                "sense_id": "59ee2a0a-a3b5-3945-a491-92d7b3395a7d",
                                                "text": "— Tout s'est modernisé, et il y a de tout, sauf des gendarmes et des prisons, car le crime est encore inconnu."
                                            },
                                            {
                                                "example_id": "eebb8c4b-6a93-4978-bb04-0246117d9858",
                                                "sense_id": "59ee2a0a-a3b5-3945-a491-92d7b3395a7d",
                                                "text": "L'utilisation des pesticides a beaucoup augmenté dans les pays en développement à la fin des années 60 et pendant les années 70, à mesure que l'agriculture se modernisait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "190b0690-7ffe-4446-b294-92547ce853c9",
                        "source_entry_id": "432455e9-a44c-3f62-890c-101dec08f5bd",
                        "source_sense_description": "bring something up to date",
                        "target_lang_word": "modernisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modernisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbd46636-3840-3dc9-9d59-dd52a3d193b9",
                                        "entry_id": "5e089364-4bce-3871-b501-4815198cb133",
                                        "glosses": [
                                            "von einem bestehenden Standard auf ein Niveau bringen, das besser, moderner, neuer, geeigneter ist"
                                        ],
                                        "tags": [
                                            "meist über Maschinen und technische Verfahren"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23ffe673-9c6f-4268-8145-a673511cb9b3",
                                                "sense_id": "bbd46636-3840-3dc9-9d59-dd52a3d193b9",
                                                "text": "„Österreich dagegen hatte es verpasst, seine Armee zu modernisieren.“"
                                            },
                                            {
                                                "example_id": "b2e17571-dca5-4f98-a1d6-0b26f44df5b0",
                                                "sense_id": "bbd46636-3840-3dc9-9d59-dd52a3d193b9",
                                                "text": "„Friedrich Wilhelm I. war es auch, der das Land durch Verwaltungs- und Militärreformen modernisierte.“"
                                            },
                                            {
                                                "example_id": "54c99c37-88d2-46d9-87da-b75a7ce49e65",
                                                "sense_id": "bbd46636-3840-3dc9-9d59-dd52a3d193b9",
                                                "text": "„Der Norden, der inzwischen erfolgreich Fabriken mit Wasserkraft und Dampfmaschinen betrieb, hatte sich auch gesellschaftlich modernisiert und forderte die Abschaffung der Sklaverei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c71600e9-d196-3035-8b01-e8550594a2eb",
                                        "entry_id": "5e089364-4bce-3871-b501-4815198cb133",
                                        "glosses": [
                                            "aus seinem alten Zusammenhang nehmen und in einen aktuelleren setzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6a255b5-19ce-4bde-ba50-c1f73039f0ba",
                                                "sense_id": "c71600e9-d196-3035-8b01-e8550594a2eb",
                                                "text": "„Mit seinem ersten Trauerspiel Miss Sara Sampson modernisiert er die Medea des Euripides und damit eine attische Tragödie, von der man schon in der Antike gesagt hatte, der Dramatiker sei hier »ins Weinerliche verfallen«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
