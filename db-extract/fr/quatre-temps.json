                        "sense_id": "d720ffbe-2856-34cf-a5ee-36cb800b3fdf",
                        "entry_id": "fe4da219-63f6-3a17-957a-6c64aebfc327",
                        "glosses": [
                            "Moteur à explosion à quatre temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b1f156c-4249-4857-96ca-3a91c0ae84ff",
                                "sense_id": "d720ffbe-2856-34cf-a5ee-36cb800b3fdf",
                                "text": "Au niveau du fonctionnement, il n’existe pas de distinction fondamentale entre un deux-temps et un quatre-temps puisqu'on y retrouve les quatre phases classiques (admission, compression, détente, échappement), mais agencées de façon différente."
                            }
                        ]
                    }
                ],
