                        "entry_id": "98ac059e-17e2-3fdd-be0b-c6daa0969edb",
                        "glosses": [
                            "dym papierosowy złośliwie wypuszczony komuś w twarz"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2734e596-f7f3-43f8-a5fc-cd12d61934b0",
                                "sense_id": "e67e71aa-6a4a-3194-a0ee-fccf3b92760a",
                                "text": "Bo szewc Marek, był to lew. / Lecz umiał finfą zakurzyć, / W głowę mierzyć, w brzuch uderzyć, / Zażyć z mańki, zwalić z nóg"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "295e1c0b-16d2-37be-b63e-ccce366debbd",
                        "entry_id": "98ac059e-17e2-3fdd-be0b-c6daa0969edb",
                        "glosses": [
                            "złośliwy żart zrobiony komuś"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "da333942-d9e8-482b-a620-2d524a740f77",
                                "sense_id": "295e1c0b-16d2-37be-b63e-ccce366debbd",
                                "text": "Ku uciesze współtowarzyszy frant puścił stróżowi taką finfę, że ów długo się po niej pozbierać nie mógł."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
