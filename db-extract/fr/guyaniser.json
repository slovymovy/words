                "senses": [
                    {
                        "sense_id": "8c427aa7-62e4-3ac6-b333-1a160971a17c",
                        "entry_id": "3a0e226e-02d1-38ed-b9c3-4cfd6c835a99",
                        "glosses": [
                            "Donner un caractère guyanais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2924f20-39be-4e54-8ae4-45a867fd64ef",
                                "sense_id": "8c427aa7-62e4-3ac6-b333-1a160971a17c",
                                "text": "Concernant les normes justement, le document Guyane2040 du Medef propose de “guyaniser” le foncier (au profit des collectivités et des entreprises), la fiscalité (clarifier l’octroi de mer), les contributions sociales des entreprises (régime spécial de 10 ans minimum)."
                            },
                            {
                                "example_id": "e9e544e7-0c21-4d50-92c4-944e2e2f1e1f",
                                "sense_id": "8c427aa7-62e4-3ac6-b333-1a160971a17c",
                                "text": "Désormais, elles veulent « guyaniser » la profession en offrant de réelles opportunités à des jeunes motivés."
                            },
                            {
                                "example_id": "3dcdedbc-0dfa-423a-989d-6f211587ae6d",
                                "sense_id": "8c427aa7-62e4-3ac6-b333-1a160971a17c",
                                "text": "Certains restent à demeure à Kourou, d'autres font des allers-retours, et tous finissent immanquablement par se “guyaniser”."
                            }
                        ]
                    }
                ],
