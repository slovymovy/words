                    }
                ],
                "senses": [
                    {
                        "sense_id": "92ec2f55-799b-36d5-90e6-811da3d5e2b8",
                        "entry_id": "d680e245-e683-386c-b5db-dc9eb53029a9",
                        "glosses": [
                            "Race de pigeons dont les taches du plumage, sur la gorge, ont l'aspect d'une cravate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c59ffbb1-ba76-43aa-aeed-28545cfa6009",
                                "sense_id": "92ec2f55-799b-36d5-90e6-811da3d5e2b8",
                                "text": "Lorsque le cravaté enfle son jabot comme tous les pigeons, sa fraise de plumes s'agite en tous sens."
                            },
                            {
                                "example_id": "78001ec0-5e90-490a-9d10-7c9e4a1bfe3b",
                                "sense_id": "92ec2f55-799b-36d5-90e6-811da3d5e2b8",
                                "text": "Les spécialistes ont remarqué que tandis que la généralité des pigeons frappe du bec à coups répétés, le cravaté pince avec le bec et ne lâche plus, […]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "53eaea79-93e2-3db8-9951-81a1533bafce",
                "word": "cravaté",
