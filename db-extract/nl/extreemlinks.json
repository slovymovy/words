                    },
                    {
                        "translation_id": "a991da6f-eee0-47d2-b862-7c4e4a6e4f5a",
                        "source_entry_id": "b14aaf55-d3d0-3f8e-ae51-be09b4d67300",
                        "source_sense_id": "9e80d689-2156-3a0f-a46f-15a96cc55aa6",
                        "target_lang_word": "extrême-gauche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrême-gauche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40dc7d43-65c5-39b8-9b29-a7b935fa5f29",
                                        "entry_id": "63799036-1b15-37f4-80ef-db0cdc7ec925",
                                        "glosses": [
                                            "Variante orthographique de extrême gauche."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "793afa72-c847-4422-ab0f-de0da848709c",
                                                "sense_id": "40dc7d43-65c5-39b8-9b29-a7b935fa5f29",
                                                "text": "Quand à l’extrême-gauche japonaise, après la flambée des années soixante, elle s’est effondrée, son style demeurant d’ailleurs plus proche du « bushido » (code d’honneur des samouraï) que de celui du « marxisme-léninisme » traditionnel."
                                            },
                                            {
                                                "example_id": "7fb14b9b-f36b-4932-ac0e-29239f12a529",
                                                "sense_id": "40dc7d43-65c5-39b8-9b29-a7b935fa5f29",
                                                "text": "Ce désastre avait eu son contre-coup à la Chambre des députés : le leader de l’extrême-gauche avait, pour ainsi dire, — bondi sur le cabinet, enveloppant dans la même réprobation tous les services, y compris la Guerre, la Marine et les Travaux publics."
                                            },
                                            {
                                                "example_id": "c2c18264-2e65-4585-8a39-f5fc93344228",
                                                "sense_id": "40dc7d43-65c5-39b8-9b29-a7b935fa5f29",
                                                "text": "Les applaudissements furent vifs à l’extrême-gauche et dans les tribunes."
                                            },
                                            {
                                                "example_id": "eb636c55-cade-408e-b0c3-61137e6b16d5",
                                                "sense_id": "40dc7d43-65c5-39b8-9b29-a7b935fa5f29",
                                                "text": "Cela signerait alors la fin du Front de gauche tel qu’il existe depuis 2009 et la fin des illusions d’une extrême-gauche unie."
                                            },
                                            {
                                                "example_id": "3fe9e167-15f5-4e71-b930-4f5f481eccec",
                                                "sense_id": "40dc7d43-65c5-39b8-9b29-a7b935fa5f29",
                                                "text": "Des militants d'extrême-gauche avaient amené des banderoles revendicatives devant le palais de justice de Rennes pour la tenue d'un procès dont le prévenu est un jeune homme d'extrême-droite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
