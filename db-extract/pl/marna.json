                "senses": [
                    {
                        "sense_id": "f85b5884-3547-357b-b377-db6d9fa090c3",
                        "entry_id": "d60f0bf4-9b43-3c00-8216-c5ce7fd50471",
                        "glosses": [
                            "rzeka we Francji, prawy dopływ Sekwany"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b869b8a1-5c9e-4656-b934-9ba1a28b4783",
                                "sense_id": "f85b5884-3547-357b-b377-db6d9fa090c3",
                                "text": "Miało to zresztą miejsce we Francji, gdzie nieco starsza faza (L_B) znana była pod nazwą kultury marneńskiej — od grobów wozowych, szczególnie licznych nad Marną"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4b8c7326-9099-3de0-b759-1519e4b7f9ca",
                        "entry_id": "d60f0bf4-9b43-3c00-8216-c5ce7fd50471",
                        "glosses": [
                            "francuski departament położony w regionie Grand Est"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99d46d9f-bc28-435c-b05f-08299e48be38",
                        "source_entry_id": "d60f0bf4-9b43-3c00-8216-c5ce7fd50471",
                        "source_sense_id": "f85b5884-3547-357b-b377-db6d9fa090c3",
                        "target_lang_word": "Marna",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c4efedee-7a4f-4ba0-928d-9a657b36ee42",
                        "source_entry_id": "d60f0bf4-9b43-3c00-8216-c5ce7fd50471",
                        "source_sense_id": "f85b5884-3547-357b-b377-db6d9fa090c3",
                        "target_lang_word": "Marne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "035dc2f1-f72a-3682-bfee-1fca00aa65a8",
                                        "entry_id": "4ece473c-31a7-38d9-9828-9a65791b1e3f",
                                        "glosses": [
                                            "Rivière française, principal affluent de la Seine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca5c0477-9006-4098-93db-f7e520d04b3f",
                                                "sense_id": "035dc2f1-f72a-3682-bfee-1fca00aa65a8",
                                                "text": "Un autre dimanche, ils allèrent à Joinville-le-Pont et ils y allèrent à pied en traversant le bois de Vincennes. Là, ils canotèrent encore sur la Marne, en compagnie de tous les Parisiens venus dans l'île pour manger des barbillons."
                                            },
                                            {
                                                "example_id": "a870f020-efc2-4e21-97a7-5e747d458378",
                                                "sense_id": "035dc2f1-f72a-3682-bfee-1fca00aa65a8",
                                                "text": "Après, il y a la Marne, la large, la douce, la belle grosse feignasse qui se traîne tout le long de chez nous en tortillant des fesses, pas pressée d’arriver à Charenton."
                                            },
                                            {
                                                "example_id": "2369557f-5d76-4edb-a090-54a58c3763bb",
                                                "sense_id": "035dc2f1-f72a-3682-bfee-1fca00aa65a8",
                                                "text": "La Marne, déni français. Tout est fait pour la déconsidérer. Le souvenir frivole des guinguettes et des canotiers contribue à la dévaluer. La seule fois dans son histoire où elle acquiert la notoriété, c’est de façon illégitime. Pour les Français, la Marne est avant tout le nom d’une bataille."
                                            },
                                            {
                                                "example_id": "36cd9485-d4b9-4518-9a84-414dc5b052e7",
                                                "sense_id": "035dc2f1-f72a-3682-bfee-1fca00aa65a8",
                                                "text": "Certains produits comme la terbuthylazine, l’alachlore et le métolachlore ne semblent pas être utilisés de façon uniforme sur le bassin-versant de la Marne (Paris, Coulommiers et Éclaron)."
                                            },
                                            {
                                                "example_id": "66cdc6b6-e00f-4b73-89b9-99b1081a06a0",
                                                "sense_id": "035dc2f1-f72a-3682-bfee-1fca00aa65a8",
                                                "text": "Voici une étape aussi sauvage qu'inédite entre l'intemporel village de Condé-Sainte-Libiaire et la fameuse ancienne chocolaterie de Noisiel. Cet itinéraire offre de magnifiques passages au plus près la Marne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7649a95a-1659-367a-b1f0-a66d25de39ce",
                                        "entry_id": "4ece473c-31a7-38d9-9828-9a65791b1e3f",
                                        "glosses": [
                                            "Département français de la région Grand Est. Ce département porte le numéro 51."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "391205d7-26b5-40c9-804c-6c70afa1720b",
                                                "sense_id": "7649a95a-1659-367a-b1f0-a66d25de39ce",
                                                "text": "On avait commis l'erreur de séparer Grandham, Autry, Condé-lès-Autry et Binarville qui avaient des intérêts forestiers communs. Les deux premières communes avaient été incluses dans les Ardennes et les deux autres dans la Marne."
                                            },
                                            {
                                                "example_id": "de1185e4-4c5c-40ae-b810-01a89b6c1b53",
                                                "sense_id": "7649a95a-1659-367a-b1f0-a66d25de39ce",
                                                "text": "Plus ridicule encore, certaines communes comptent plus de conseillers municipaux que d'habitants : c'est en particulier le cas d'une commune du département de la Marne, Rouvroy-Ripont, qui à l'époque où j'exerçais mes fonctions de préfet dans ce département comptait 7 habitants et 9 conseillers municipaux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Marne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2983a59-6b1a-3ed2-b8fc-f46c8fe06a29",
                                        "entry_id": "3e97eedf-4440-3814-8500-e771440b1658",
                                        "glosses": [
                                            "Ville et commune d’Allemagne, située dans le Schleswig-Holstein."
                                        ],
