                        "examples": [
                            {
                                "example_id": "59f8fbeb-3879-4ec3-ac11-f23265967f7d",
                                "sense_id": "09fc8576-483c-34b1-a2d9-9693d474d554",
                                "text": "'De grootsheid van mensen zoals Clara Sarragon? Van mijn werkgevers bij de WIC? Van de koopmansvrouwen bij de gilden, die jou uiteindelijk links lieten liggen? Ik heb in mijn leven heel wat Clara Sarragons gekend, Nella'."
                            },
                            {
                                "example_id": "bd800dab-91a5-421e-9320-f6be72de899b",
                                "sense_id": "09fc8576-483c-34b1-a2d9-9693d474d554",
                                "text": "Als ze terugdenkt aan haar vaders beschrijving van haar moeders blozende wangen, en de geprevelde bewondering die over de tegels in de gang naar hem toe dreef, vraagt Thea zich af of ze dat met Walter heeft gekend."
                            }
                        ]
                    }
