                                        "sense_id": "69fe7dac-0b92-302e-8b92-4cba75e6f596",
                                        "entry_id": "d7080171-bb25-3bca-a193-188641b1a1fc",
                                        "glosses": [
                                            "A portion.",
                                            "A straight path between two points that is the shortest distance between them; a line segment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b53c6a06-3718-3e8b-8d9d-ee8f4c6cc7d9",
