                "senses": [
                    {
                        "sense_id": "ddb60263-a018-3294-8e68-025708d800d8",
                        "entry_id": "93e79d59-139f-3722-9e87-cee913cb94d2",
                        "glosses": [
                            "Kampfhandlung zwischen Seestreitkräften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922ea8c9-af5b-4ed0-adc8-bfd50ce39fee",
                                "sense_id": "ddb60263-a018-3294-8e68-025708d800d8",
                                "text": "„Perikles' Beschränkung auf den Seekrieg hatte Athen zwar schwere Niederlagen erspart, andererseits brachte das Taktieren der Gegner kaum Erfolge.“"
                            },
                            {
                                "example_id": "0fa513fb-2e2f-4cbb-b2d2-dcf537c8ee61",
                                "sense_id": "ddb60263-a018-3294-8e68-025708d800d8",
                                "text": "„Viele wollte eben nicht wahrhaben, dass sie ihre Jugend einem sinnlosen Seekrieg geopfert hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
