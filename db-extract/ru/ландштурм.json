                                    {
                                        "sense_id": "71b58858-9002-3cd5-99ff-54e0e63f07db",
                                        "entry_id": "9de277c9-61bd-3d0f-a9ce-eabce5d209c3",
                                        "glosses": [
                                            "Reserveeinheit des Militärs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a422952-af57-42aa-bba6-ed7d14ac5284",
                                                "sense_id": "71b58858-9002-3cd5-99ff-54e0e63f07db",
                                                "text": "Im Landsturm kämpfen auch Männer, die zu alt für den regulären Dienst sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34026319-da9c-324e-87a0-24b7c6614a47",
                                        "entry_id": "9de277c9-61bd-3d0f-a9ce-eabce5d209c3",
                                        "glosses": [
                                            "Gesamtheit der zum Wehrdienst herangezogenen Männer älterer Jahrgänge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "858e4e32-2bf0-4f5f-80cc-710d9fe76077",
                                                "sense_id": "34026319-da9c-324e-87a0-24b7c6614a47",
                                                "text": "„Da »der Feind im Land« stand, ordnete Wilhelm II. nun laut gültigem Wehrpflichtgesetz die Einberufung des Landsturms an, also der ehemaligen Wehrpflichtigen, die von der regulären Mobilisierung nicht erfasst worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
