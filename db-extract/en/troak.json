                                        "entry_id": "c091e3ee-c411-347f-b274-81aea414d547",
                                        "glosses": [
                                            "overeenkomen bezit tegen dat van een ander uit te wisselen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d7ffd6-e7bb-4318-a66c-45974643be83",
                                                "sense_id": "82dcd407-4261-382f-90a2-95edb549ec63",
                                                "text": "Met uitgestreken gezicht probeerde ik nog van kamer te ruilen, maar het motel zat dat hele weekend vol."
                                            }
