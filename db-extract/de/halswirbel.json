                "senses": [
                    {
                        "sense_id": "2f834c0f-34f0-305a-b3df-7e347b3bd4dd",
                        "entry_id": "cdc319dc-b2bd-30a9-b1ae-e755971f6611",
                        "glosses": [
                            "oberes Ende der Wirbelsäule von Wirbeltieren, bewegliche Wirbel zwischen der Brustwirbelsäule und dem Kopf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50eae99a-843d-4293-a15d-4ba5f341c233",
                                "sense_id": "2f834c0f-34f0-305a-b3df-7e347b3bd4dd",
                                "text": "„Der Bruch des Halswirbels klang schauderhaft.“"
                            },
                            {
                                "example_id": "2eddb6ee-f9b1-420e-a36a-316f83eaaaaa",
                                "sense_id": "2f834c0f-34f0-305a-b3df-7e347b3bd4dd",
                                "text": "„Ihr Kopf wabbelte locker am Hals, der so zerhackt und aufgeschlitzt war, dass die Halswirbel durch die Haut stachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
