                    {
                        "translation_id": "c6dfdfa7-8011-464a-8734-f4a4ca37aa96",
                        "source_entry_id": "8bb5cfca-451d-33fb-9327-b4a2eceedfa9",
                        "source_sense_id": "483567ba-007c-3dbf-bad2-e1ff0279fead",
