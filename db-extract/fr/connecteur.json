            {
                "entry_id": "75130234-a7de-3acb-a481-d56a57c85516",
                "word": "connecteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "749afde2-a521-47f7-a1c4-bff7cd112bf8",
                        "entry_id": "75130234-a7de-3acb-a481-d56a57c85516",
                        "tags": [
                            "plural"
