                "senses": [
                    {
                        "sense_id": "01af1e86-9949-309b-9561-52ea618d9cf4",
                        "entry_id": "ce20a295-384f-3b3c-82ae-8982e534cda4",
                        "glosses": [
                            "Vermännlichung einer Frau im äußeren Erscheinungsbild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b85687-d4f8-45f3-a27b-22f216b03731",
                                "sense_id": "01af1e86-9949-309b-9561-52ea618d9cf4",
                                "text": "Auch bei Frauen wird in geringen Mengen Testosteron in den Eierstöcken und in der Nebennierenrinde produziert. Es steigert die Libido der Frau, führt aber bei einem Hormonüberschuss zu Zeichen einer allgemeinen Vermännlichung (Virilisierung)."
                            },
                            {
                                "example_id": "31c27244-3352-4d62-b892-dd0c07e7435d",
                                "sense_id": "01af1e86-9949-309b-9561-52ea618d9cf4",
                                "text": "Unbehandelt führt ein AGS unter anderem zur Virilisierung bei Mädchen sowie bei Mädchen und Jungen zu einer Pubertas praecox mit akzeleriertem Knochenalter und resultierendem Kleinwuchs."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "17de164a-f581-3da5-a9ab-ada6869b6e09",
                        "entry_id": "ce20a295-384f-3b3c-82ae-8982e534cda4",
                        "glosses": [
                            "vorzeitige Geschlechtsreife eines männlichen Jugendlichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4dd791d-fc87-46a1-8236-8a35d9a785ca",
                                "sense_id": "17de164a-f581-3da5-a9ab-ada6869b6e09",
                                "text": "Virilisierung als vorzeitige Geschlechtsentwicklung bei Knaben wird durch männliche Geschlechtshormone (Androgene) hervorgerufen, die in zu hoher Konzentration im Körper auftreten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
