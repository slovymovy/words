{
    "word_family": [
        "speculation",
        "speculative",
        "speculator",
        "speculativeness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dcb98933-bea9-3dab-b94d-a84b366a6740",
                    "sense_definition": "To form a theory or opinion about something without having all the facts or certain proof.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists continue to <w>speculate</w> about the possibility of life on other planets in our galaxy.",
                            "target_lang_translations": {
                                "ru": "Ученые продолжают <w>строить предположения</w> о возможности жизни на других планетах в нашей галактике."
                            }
                        },
                        {
                            "text": "It is useless to <w>speculate</w> on the cause of the accident until the investigation is complete.",
                            "target_lang_translations": {
                                "ru": "Бесполезно <w>гадать</w> о причинах аварии, пока расследование не будет завершено."
                            }
                        }
                    ],
                    "synonyms": [
                        "conjecture",
                        "surmise",
                        "guess",
                        "hypothesize"
                    ],
                    "antonyms": [
                        "know",
                        "prove",
                        "verify"
                    ],
                    "common_phrases": [
                        "speculate on the cause",
                        "speculate about the future",
                        "tempting to speculate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Строить теории или высказывать мнения о чем-либо, не имея всех фактов или определенных доказательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предполагать",
                                "target_lang_sense_clarification": "допускать возможность чего-либо"
                            },
                            {
                                "target_lang_word": "делать предположения",
                                "target_lang_sense_clarification": "высказывать догадки"
                            },
                            {
                                "target_lang_word": "строить гипотезы",
                                "target_lang_sense_clarification": "выдвигать научные или логические теории"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3902ec04-4760-3afb-84df-cfbbbdbd2519",
                    "sense_definition": "To buy or sell assets, such as stocks or property, in the hope of making a profit but with the risk of loss.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many investors began to <w>speculate</w> in the housing market, hoping for a quick return on their money.",
                            "target_lang_translations": {
                                "ru": "Многие инвесторы начали <w>спекулировать</w> на рынке жилья, надеясь на быструю окупаемость своих денег."
                            }
                        },
                        {
                            "text": "He lost a significant portion of his savings when he decided to <w>speculate</w> on the stock market.",
                            "target_lang_translations": {
                                "ru": "Он потерял значительную часть своих сбережений, когда решил <w>играть</w> на фондовом рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "gamble",
                        "venture"
                    ],
                    "antonyms": [
                        "invest"
                    ],
                    "common_phrases": [
                        "speculate on the market",
                        "speculate in property",
                        "speculate with funds"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покупать или продавать активы, такие как акции или недвижимость, в надежде на получение прибыли, но с риском убытков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спекулировать",
                                "target_lang_sense_clarification": "играть на бирже или рынке"
                            },
                            {
                                "target_lang_word": "играть",
                                "target_lang_sense_clarification": "на бирже или рынке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6398b342-0986-337d-b544-ef3ddec13bad",
                    "sense_definition": "To think deeply or reflect on a subject; to meditate or deliberate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher would often <w>speculate</w> on the nature of human existence during his long walks.",
                            "target_lang_translations": {
                                "ru": "Философ часто <w>размышлял</w> о природе человеческого существования во время своих долгих прогулок."
                            }
                        },
                        {
                            "text": "It is interesting to <w>speculate</w> boldly on how society might evolve over the next century.",
                            "target_lang_translations": {
                                "ru": "Интересно смело <w>пофантазировать</w> о том, как может развиться общество в следующем столетии."
                            }
                        }
                    ],
                    "synonyms": [
                        "meditate",
                        "reflect",
                        "cogitate",
                        "deliberate"
                    ],
                    "antonyms": [
                        "ignore",
                        "disregard"
                    ],
                    "common_phrases": [
                        "speculate boldly",
                        "speculate on a subject"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоко задумываться или размышлять над предметом; медитировать или обдумывать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размышлять",
                                "target_lang_sense_clarification": "всесторонне взвешивать в мыслях"
                            },
                            {
                                "target_lang_word": "предаваться раздумьям",
                                "target_lang_sense_clarification": "глубоко задумываться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7abfe0af-2738-3ca8-ac02-930feb3d29da",
                    "sense_definition": "To predict which path a computer program will take and perform those operations in advance to save time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern processors are designed to <w>speculate</w> which branch of code will be executed next.",
                            "target_lang_translations": {
                                "ru": "Современные процессоры спроектированы так, чтобы <w>предугадывать</w>, какая ветвь кода будет выполнена следующей."
                            }
                        },
                        {
                            "text": "The system will <w>speculate</w> on the next instruction to improve overall processing speed.",
                            "target_lang_translations": {
                                "ru": "Система будет <w>прогнозировать</w> следующую инструкцию, чтобы повысить общую скорость обработки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "speculate on branches"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предсказывать, по какому пути пойдет компьютерная программа, и выполнять эти операции заранее для экономии времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спекулятивно выполнять",
                                "target_lang_sense_clarification": "в архитектуре процессоров"
                            },
                            {
                                "target_lang_word": "прогнозировать",
                                "target_lang_sense_clarification": "ветвления в коде"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}