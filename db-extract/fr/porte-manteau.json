        "fr-extract.jsonl": [
            {
                "entry_id": "b1c13aed-560b-3b58-8db8-01fafeae9377",
                "word": "porte-manteau",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c482ebe4-c7af-46e7-b989-792bf9419451",
                        "entry_id": "b1c13aed-560b-3b58-8db8-01fafeae9377",
                        "tags": [
                            "plural"
                        ],
                        "form": "porte-manteaux"
                    },
                    {
                        "form_id": "625e55d0-7426-4f92-ae5b-7ec189e4a0c4",
                        "entry_id": "b1c13aed-560b-3b58-8db8-01fafeae9377",
                        "tags": [],
                        "form": "portemanteau"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cda6a25-8da6-359c-8484-aedfa704f8b2",
                        "entry_id": "b1c13aed-560b-3b58-8db8-01fafeae9377",
                        "glosses": [
                            "Structure sur pied ou accrochée au mur garnie de patères auxquelles on suspend des manteaux et d’autres vêtements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d7d57f2-853b-4328-970e-437bde50a211",
                                "sense_id": "7cda6a25-8da6-359c-8484-aedfa704f8b2",
                                "text": "Cependant, Pétrouchka emporta le pantalon et l’habit zinzolin moucheté, les étendit sur un porte-manteau et se prit à les brosser et vergeter si furieusement que le corridor fut bientôt rempli de poussières."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e240484-5c6a-3ec2-901a-fd52675ac87c",
                        "entry_id": "b1c13aed-560b-3b58-8db8-01fafeae9377",
                        "glosses": [
                            "Sac contenant les vêtements d'une personne qui voyage."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0d7d0548-d111-444b-816a-7ad668f60a31",
                                "sense_id": "5e240484-5c6a-3ec2-901a-fd52675ac87c",
                                "text": "Arlequin.— Ah, te voilà, Bourguignon ! Mon porte-manteau et toi, avez-vous été bien reçus ?"
                            },
                            {
                                "example_id": "291e609d-1676-401c-acdb-5bfcb77cab84",
                                "sense_id": "5e240484-5c6a-3ec2-901a-fd52675ac87c",
                                "text": "Des annéees auparavant, M. l’abbé de Frilair était arrivé à Besançon avec un porte-manteau des plus exigus, lequel, suivant la chronique, contenait toute sa fortune."
                            },
                            {
                                "example_id": "4355ba2c-78b7-42eb-b273-053adaac3085",
                                "sense_id": "5e240484-5c6a-3ec2-901a-fd52675ac87c",
                                "text": "Ce haut-de-chausses et ce pourpoint, quoique neufs, paraissaient froissés comme des habits de voyage longtemps renfermés dans un porte-manteau."
                            },
                            {
                                "example_id": "8e9f56c2-0338-494e-b862-7d601173d911",
                                "sense_id": "5e240484-5c6a-3ec2-901a-fd52675ac87c",
                                "text": "Il avait sorti d’une armoire une vieille valise en forme de porte-manteau, qui datait de Louis XV ou de Louis XIV, et il avait tâché d’y entasser les objets qu’il voulait emporter."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb355fb0-cc79-3406-8a9e-873bd185b165",
                        "entry_id": "b1c13aed-560b-3b58-8db8-01fafeae9377",
                        "glosses": [
                            "Étui cylindrique en drap que les cavaliers attachent à la selle et qui peut contenir un manteau et des effets de petit équipement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f771a1c9-ad9a-43fb-a7dc-10f8466b2db1",
                                "sense_id": "bb355fb0-cc79-3406-8a9e-873bd185b165",
                                "text": "En regardant mon habit usé aux coudes et mon mince bagage, je regrette d’avoir manqué ces messieurs. Le plaisir de les voir n’était pas payé trop cher par la perte d’un léger porte-manteau."
                            },
                            {
                                "example_id": "9c48c449-ac80-4179-a8a0-87d0266f0ffb",
                                "sense_id": "bb355fb0-cc79-3406-8a9e-873bd185b165",
                                "text": "Il s’enfonçait dans les montagnes, monté sur un joli cheval anglais, et muni d’un léger porte-manteau qui annonçait des projets de voyage pour deux ou trois journées."
                            },
                            {
                                "example_id": "e78f2a97-2bb3-4ce3-b91e-46f7b40c58c7",
                                "sense_id": "bb355fb0-cc79-3406-8a9e-873bd185b165",
                                "text": "Il bouchonna son cheval avec une poignée de bruyère et roula son porte-manteau."
                            }
                        ]
                    }
                ],
