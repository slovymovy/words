                "senses": [
                    {
                        "sense_id": "17a752d1-c28d-3418-b124-4e17fbb0a6b4",
                        "entry_id": "fa298fde-b433-386b-a817-0f4c4d109704",
                        "glosses": [
                            "Person, die mit einem Snowboard auf Schnee gleitet/die Snowboard fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e9df781-9a9b-46e2-9284-8efce5fbb84a",
                                "sense_id": "17a752d1-c28d-3418-b124-4e17fbb0a6b4",
                                "text": "„Jeden Winter kommen im Alpenraum einige Dutzend Menschen durch Lawinen zu Tode. Oftmals trifft es Ski- oder Snowboardfahrer, die abseits der präparierten Pisten ihrem Freizeitvergnügen nachgehen.“"
                            },
                            {
                                "example_id": "0eaf9298-46cd-41bc-b4ac-8c8faf1e26af",
                                "sense_id": "17a752d1-c28d-3418-b124-4e17fbb0a6b4",
                                "text": "„Die von Ski- und Snowboardfahrern verursachten Lawinen gehen zumeist nicht von einem Punkt aus, sondern reißen entlang einer Linie an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a3fd8fa-6b32-4a2d-b3f5-fb42ccdb6b15",
                        "source_entry_id": "fa298fde-b433-386b-a817-0f4c4d109704",
                        "source_sense_id": "17a752d1-c28d-3418-b124-4e17fbb0a6b4",
                        "source_sense_description": "Person, die mit einem Snowboard auf Schnee gleitet/die Snowboard fährt",
                        "target_lang_word": "snowboarder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowboarder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                                        "entry_id": "7338a73b-bc8e-38a9-a697-edc6efc771a6",
                                        "glosses": [
                                            "Someone who snowboards."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f90a057-c7b3-49de-86b2-fbaa215f1cf8",
                                                "sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                                                "text": "The same is true in freeskiing, in which skiers pull tricks on some of the same terrain as snowboarders."
                                            },
                                            {
                                                "example_id": "9fffc99f-aae2-45a9-b32a-697c539df0f9",
                                                "sense_id": "126a6876-437f-3a6b-a5fa-89896348b52e",
                                                "text": "To Enni Rukajarvi, a Finnish snowboarder, the temperatures were not a problem — it was warmer than it often is at home, she pointed out — but the wind was tricky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
