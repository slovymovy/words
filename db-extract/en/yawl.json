                                "target_senses": [
                                    {
                                        "sense_id": "1089e410-86e7-37c4-8bfb-d7304d0a34e0",
                                        "entry_id": "79ebdcde-8cd4-3285-b61a-78a9716ca133",
                                        "glosses": [
                                            "eineinhalbmastiges Segelboot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c82481-c23a-4a0a-a9eb-6131b05abaa0",
                                                "sense_id": "1089e410-86e7-37c4-8bfb-d7304d0a34e0",
                                                "text": "Meine Yawl ist kuttergetakelt."
                                            },
                                            {
                                                "example_id": "edf0c3ca-7b49-45d7-b159-a1107231434d",
                                                "sense_id": "1089e410-86e7-37c4-8bfb-d7304d0a34e0",
                                                "text": "Die Bedienung des Besansegels ist bei einer Yawl immer ein bisschen schwierig."
                                            }
