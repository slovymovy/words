                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>montons</w> l'escalier jusqu'au troisième étage sans prendre l'ascenseur."
                        },
                        {
                            "text": "Les randonneurs <w>montent</w> vers le sommet de la montagne depuis ce matin."
                        }
                    ],
                    "synonyms": [
