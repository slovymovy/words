                        "entry_id": "d48133dc-ba50-36d2-bfe0-215596023672",
                        "glosses": [
                            "eine die Atemwege und Augen stark reizende, farblose und erstickend riechende Flüssigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c5193ce-c7ca-4b36-8fad-76d31d1158aa",
                                "sense_id": "67fb6b65-cc1e-3f9b-848d-c7aff02a08f9",
                                "text": "„Die Ester der Essigsäure können durch Umsetzung der entsprechenden Alkohole mit Essigsäure, Acetylchlorid oder Keten hergestellt werden.“"
                            },
                            {
                                "example_id": "661686a9-64cd-4cd1-a176-63d9c1cf8f96",
                                "sense_id": "67fb6b65-cc1e-3f9b-848d-c7aff02a08f9",
                                "text": "„Praktische Bedeutung hat besonders das Anfangsglied der Reihe, das Keten H2C=C=O, u. a. zur Herstellung von Acetanhydrid, Essigester, Acetylchlorid und Acetamid.“"
                            }
                        ],
