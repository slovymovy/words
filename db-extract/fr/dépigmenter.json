                ],
                "senses": [
                    {
                        "sense_id": "3f9a98aa-01c2-3241-afec-9f43d866d920",
                        "entry_id": "491ee359-948c-302b-ae61-5315310576bc",
                        "glosses": [
                            "Faire perdre ses pigments à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c2fb19-f8c9-4961-ba40-2c0ec740ff05",
                                "sense_id": "3f9a98aa-01c2-3241-afec-9f43d866d920",
                                "text": "On place les objets à dépigmenter dans un flacon renfermant de l’alcool à 80ᵒ et on remplit le fond du flacon avec des cristaux de chlorate de potasse."
                            },
                            {
                                "example_id": "6c6a094f-a199-4887-9abe-ec7ec8081b89",
                                "sense_id": "3f9a98aa-01c2-3241-afec-9f43d866d920",
                                "text": "Cette préparation totale consiste à dépigmenter le thorax des abeilles et à l’éclaircir ensuite pour le rendre transparent."
                            },
                            {
                                "example_id": "31a5952e-534c-4a56-b298-0e697bdb5324",
                                "sense_id": "3f9a98aa-01c2-3241-afec-9f43d866d920",
                                "text": "L’étude des motifs qui poussent les gens à se dépigmenter suggère que l’on ne se contente pas seulement de campagnes d’information. Tel que nous l’avons vu dans ce chapitre, le fait de se dépigmenter la peau est associé à des « gains » qu’espère obtenir l’individu qui s’adonne à cette pratique."
                            }
                        ]
                    }
