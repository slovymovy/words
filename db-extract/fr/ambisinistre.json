                            {
                                "example_id": "0ca1989b-0799-410e-832d-ee4ccf3d63b3",
                                "sense_id": "11d7bdc3-4f8b-3eea-b976-902c7bcf5f5e",
                                "text": "Homme ambisinistre."
                            },
                            {
                                "example_id": "d56b4fe1-391d-4ac1-a08f-10381e26b125",
                                "sense_id": "11d7bdc3-4f8b-3eea-b976-902c7bcf5f5e",
                                "text": "Femme ambisinistre."
                            },
                            {
                                "example_id": "514490ad-a750-44ce-beb1-a43bc78ab083",
                                "sense_id": "11d7bdc3-4f8b-3eea-b976-902c7bcf5f5e",
                                "text": "Ambisinistre ? — Quoi ? — Il veut dire malhabile des deux mains, expliqua Om."
