                "senses": [
                    {
                        "sense_id": "d4503313-f8a6-3ad8-b25e-73c2e9bb7974",
                        "entry_id": "15ac0aac-a683-3ea6-a61e-a3c36b8ea93f",
                        "glosses": [
                            "Saloir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5afed2-051d-4e1d-9c28-fd195c925ee2",
                                "sense_id": "d4503313-f8a6-3ad8-b25e-73c2e9bb7974",
                                "text": "Pendant cette journée du 6 novembre, on rencontra plusieurs estancias, et aussi un ou deux saladeros. C’est là que le bétail, après avoir été engraissé au milieu de succulents pâturages, vient tendre la gorge au couteau du boucher. Le saladero, ainsi que son nom l’indique, est l’endroit où se salent les viandes. (Jules Verne, Les Enfants du capitaine Grant, chapitre XX)"
                            },
                            {
                                "example_id": "bb0cc753-c66b-4100-9a71-39da7cf88684",
                                "sense_id": "d4503313-f8a6-3ad8-b25e-73c2e9bb7974",
                                "text": "Les cheminées des saladeros et des frigorifiques constituent de véritables amers pour les navigateurs du Bas-Uruguay."
                            }
                        ]
                    },
                    {
                        "sense_id": "35196973-b8c4-3fe6-bd77-ccf4148bd1b5",
                        "entry_id": "15ac0aac-a683-3ea6-a61e-a3c36b8ea93f",
                        "glosses": [
                            "Saleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f021fac-cdf6-42f0-be77-1e8f217d2a9e",
                                "sense_id": "35196973-b8c4-3fe6-bd77-ccf4148bd1b5",
                                "text": "Les \" saladeros \" vont alors chercher les animaux au corral ; ils les saisissent avec le lazo, qu’ils manient habilement, et les conduisent au saladero ; là, bœufs, taureaux, vaches, moutons sont abattus par centaines. (Jules Verne, Les Enfants du capitaine Grant, chapitre XX)"
                            }
                        ]
                    },
                    {
                        "sense_id": "28da6aed-df25-366a-a749-a7ecb999721c",
                        "entry_id": "15ac0aac-a683-3ea6-a61e-a3c36b8ea93f",
                        "glosses": [
                            "Cuir salé de bovin adulte, provenant d'Amérique du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44004594-fcde-436b-88a0-7012ba9233f8",
                                "sense_id": "28da6aed-df25-366a-a749-a7ecb999721c",
                                "text": "Les cuirs salés verts Saladeros se vendent, les bœufs soixante francs et les vaches quarante-huit."
                            }
                        ]
                    }
