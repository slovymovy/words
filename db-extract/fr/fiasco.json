                        "target_lang_word": "Reinfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reinfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a3e7f8-a393-3435-a271-f81c1ee941d0",
                                        "entry_id": "4786f66e-f683-3c91-b1f1-2037b2d487ec",
                                        "glosses": [
                                            "ein schlechter Ausgang, Verfehlen eines gesteckten Ziels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a6509cb-9425-4590-adcb-cdc47f507053",
                                                "sense_id": "c3a3e7f8-a393-3435-a271-f81c1ee941d0",
                                                "text": "Das ist ein Reinfall! Der Campingplatz liegt 4 km vom Strand."
                                            },
                                            {
                                                "example_id": "33e0563e-9a1a-466d-a020-e8a3025ad960",
                                                "sense_id": "c3a3e7f8-a393-3435-a271-f81c1ee941d0",
                                                "text": "„Mein Experiment war ein Reinfall.“"
                                            },
                                            {
                                                "example_id": "8db65e14-b690-4034-b92f-6b9862a1d175",
                                                "sense_id": "c3a3e7f8-a393-3435-a271-f81c1ee941d0",
                                                "text": "„Am 14. Dezember 1999 wurde mir mitten am Nachmittag auf einmal klar, dass mein Weihnachtsfest wahrscheinlich ein Reinfall sein würde – wie üblich.“"
                                            },
                                            {
                                                "example_id": "4dd3154e-999e-4100-baea-eb3ecbb852b6",
                                                "sense_id": "c3a3e7f8-a393-3435-a271-f81c1ee941d0",
                                                "text": "„Ich unterbrach sie und erzählte ihr von dem Reinfall, den ich im Varieté erlebt hatte, dem ersten seit drei Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c195e60b-2fe2-4247-82b5-f675c0df8694",
                        "source_entry_id": "3e9f7f68-7c54-3baf-9abd-0027d4caedc3",
