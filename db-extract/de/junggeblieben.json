                "senses": [
                    {
                        "sense_id": "596a4e09-8cf1-328b-93cd-7e9baa2ec0c5",
                        "entry_id": "3f1bc811-f344-3207-9ef7-d36f55a1223d",
                        "glosses": [
                            "jung aussehend; wenig oder gar nicht älter geworden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff33f325-2880-483a-a945-110f6deb0c1c",
                                "sense_id": "596a4e09-8cf1-328b-93cd-7e9baa2ec0c5",
                                "text": "„Ein Gesicht, welches durchaus als junggeblieben bezeichnet werden konnte, trotz seines erreichten Alters von fünfundvierzig Jahren.“"
                            },
                            {
                                "example_id": "536f76fb-12fb-4f9c-96bb-5e025b0b21a7",
                                "sense_id": "596a4e09-8cf1-328b-93cd-7e9baa2ec0c5",
                                "text": "„Für einen Mann, der kurz vor seiner Pensionierung stand, sah er wahrlich junggeblieben aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
