{
    "word_family": [
        "uwielbienie",
        "wielbiciel",
        "wielbicielka"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b56ad92c-5b6c-3576-839a-a25d688f41f8",
                    "sense_definition": "darzyć kogoś lub coś wielkim uczuciem, podziwem lub szacunkiem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uwielbienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fani <w>wielbią</w> swojego idola za jego niezwykły talent muzyczny.",
                            "target_lang_translations": {
                                "ru": "Фанаты <w>обожают</w> своего кумира за его необыкновенный музыкальный талант."
                            }
                        },
                        {
                            "text": "Wielu ludzi <w>wielbi</w> naturę i spędza w niej każdą wolną chwilę.",
                            "target_lang_translations": {
                                "ru": "Многие люди <w>обожают</w> природу и проводят на ней каждую свободную минуту."
                            }
                        }
                    ],
                    "synonyms": [
                        "uwielbiać",
                        "adorować",
                        "ubóstwiać"
                    ],
                    "common_phrases": [
                        "wielbić idola",
                        "wielbić naturę"
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывать к кому-либо или чему-либо сильное чувство любви, восхищения или глубокого уважения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обожать",
                                "target_lang_sense_clarification": "сильно любить, испытывать восторг"
                            },
                            {
                                "target_lang_word": "боготворить",
                                "target_lang_sense_clarification": "относиться с чрезмерным восхищением, как к божеству"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "350561ca-8963-3bcd-882a-9c39bbe1f9f5",
                    "sense_definition": "okazywać komuś lub czemuś najwyższy szacunek, często w kontekście religijnym",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "czczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierni <w>wielbią</w> bóstwo podczas uroczystych ceremonii w świątyni.",
                            "target_lang_translations": {
                                "ru": "Верующие <w>поклоняются</w> божеству во время торжественных церемоний в храме."
                            }
                        },
                        {
                            "text": "Dawne cywilizacje <w>wielbiły</w> słońce jako źródło wszelkiego życia.",
                            "target_lang_translations": {
                                "ru": "Древние цивилизации <w>поклонялись</w> солнцу как источнику всей жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "czcić",
                        "oddawać cześć"
                    ],
                    "common_phrases": [
                        "wielbić bóstwo"
                    ],
                    "target_lang_definitions": {
                        "ru": "оказывать кому-либо или чему-либо высшее почтение, часто в религиозном контексте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почитать",
                                "target_lang_sense_clarification": "относиться с глубоким уважением, благоговением"
                            },
                            {
                                "target_lang_word": "поклоняться",
                                "target_lang_sense_clarification": "оказывать религиозное почтение, признавать божеством"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}