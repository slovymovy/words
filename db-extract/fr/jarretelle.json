        "fr-extract.jsonl": [
            {
                "entry_id": "80b04fda-431d-3523-8b31-6964ceed157d",
                "word": "jarretelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5148aaa3-2e38-4221-a666-273b5f219d8d",
                        "entry_id": "80b04fda-431d-3523-8b31-6964ceed157d",
                        "tags": [
                            "plural"
                        ],
                        "form": "jarretelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b8525a2-53c2-3820-8955-57875db14cc8",
                        "entry_id": "80b04fda-431d-3523-8b31-6964ceed157d",
                        "glosses": [
                            "Sorte de jarretière terminée par une pince en caoutchouc, cousue ou accrochée au corset, à une gaine, ou à une ceinture, (le porte-jarretelle), et servant à retenir les bas des femmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45cb18bb-c9af-4a5a-a6fd-6424a4722e80",
                                "sense_id": "3b8525a2-53c2-3820-8955-57875db14cc8",
                                "text": "Elle met son corset, ses jarretelles, son pantalon, son jupon."
                            },
                            {
                                "example_id": "45b4afbe-8cc7-4b5e-8f19-10cfdfe6da40",
                                "sense_id": "3b8525a2-53c2-3820-8955-57875db14cc8",
                                "text": "Innocemment, je me place en face d’elle parce que c’est une position clé qui permet une vue imprenable sur la lisière de ses bas. Ayant constaté que ses jarretelles sont blanches et sa peau ambrée, je m’efforce de hausser mon regard noyé jusqu’à son visage."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a4347ec-2a1e-35ab-86a0-71f8d60d6a82",
                        "entry_id": "80b04fda-431d-3523-8b31-6964ceed157d",
                        "glosses": [
                            "Ruban en caoutchouc fixé au-dessus du mollet et maintenant tendues les chaussettes des hommes. Fixe-chaussette."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b71c2840-4080-3bd7-8d28-e6a2c96374b3",
                        "entry_id": "80b04fda-431d-3523-8b31-6964ceed157d",
                        "glosses": [
                            "Dispositif destiné à écouter, à espionner, une ligne téléphonique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37cb05f2-783f-4de9-8613-b21c29586f61",
                                "sense_id": "b71c2840-4080-3bd7-8d28-e6a2c96374b3",
                                "text": "On lui a posé une jarretelle ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f800f69-4780-45e9-997a-c13dd74db6f9",
                        "source_entry_id": "80b04fda-431d-3523-8b31-6964ceed157d",
                        "target_lang_word": "Strumpfband",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strumpfband",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6316ea94-797f-34f3-9520-29dbb9722cbf",
                                        "entry_id": "939838ff-58e3-313f-bde7-4ade701f6013",
                                        "glosses": [
                                            "Gummiband, früher: um das Bein gebundener Stoffstreifen oder Ähnliches, was verhindert, dass Strümpfe nach unten rutschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "115115d1-f50c-4e5b-adbb-deb414eb6caf",
                                                "sense_id": "6316ea94-797f-34f3-9520-29dbb9722cbf",
                                                "text": "„Mit dem Verschwinden der langen Strümpfe aus der Herrenmode im 19. Jahrhundert wurde das Strumpfband zu einem rein weiblichen Kleidungsbestandteil.“"
                                            },
                                            {
                                                "example_id": "55320495-3016-461d-839b-e2ac530e3237",
                                                "sense_id": "6316ea94-797f-34f3-9520-29dbb9722cbf",
                                                "text": "„Ich ging auf den Markt, kaufte zwölf Paar weiße Handschuhe, zwölf Paar Seidenstrümpfe und bestickte Strumpfbänder mit goldenen Schließen, die ich gleich an meinen eigenen Strümpfen festmachte.“"
                                            },
                                            {
                                                "example_id": "47adc086-12dc-47ed-95b1-84596627d116",
                                                "sense_id": "6316ea94-797f-34f3-9520-29dbb9722cbf",
                                                "text": "„Seine knallbunten seidenen Strumpfbänder trug er, da die Strümpfe trotz ihrer herunterzurutschen pflegten, meist um die nackten Knie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c62c24cd-7f9d-3382-8adc-3c8b2dca5da8",
                                        "entry_id": "939838ff-58e3-313f-bde7-4ade701f6013",
                                        "glosses": [
                                            "Band an einem Gürtel/Halter mit einer Klammer, die an Strümpfen befestigt wird, so dass diese nicht nach unten rutschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfe64dd7-737b-4361-80bb-acd292e4f03c",
                                                "sense_id": "c62c24cd-7f9d-3382-8adc-3c8b2dca5da8",
                                                "text": "„Sie entwirft ein Kleid, das den Oberkörper nackt lässt, mit Trägern, die wie Strumpfbänder schmerzlich in die Brustwarzen eingehängt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "243aa658-73e2-40b5-bb8c-6bcdb5a1f994",
                        "source_entry_id": "80b04fda-431d-3523-8b31-6964ceed157d",
                        "target_lang_word": "Strumpfhalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strumpfhalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f53cdea-1044-3014-b820-53d8617aa4f7",
                                        "entry_id": "501d58c3-0df8-3a69-9b81-67752faec2b5",
                                        "glosses": [
                                            "elastisches Band mit einer Befestigungsmöglichkeit, an dem man einen Strumpf befestigen kann, damit er nicht rutscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7441593b-b052-4164-a3d0-974b98adb72e",
                                                "sense_id": "8f53cdea-1044-3014-b820-53d8617aa4f7",
                                                "text": "„Den Strumpfhalter läßt er an, um ihre Nacktheit zu unterstreichen.“"
                                            },
                                            {
                                                "example_id": "d4f2a74e-c050-49fb-abbf-94368cf0b53e",
                                                "sense_id": "8f53cdea-1044-3014-b820-53d8617aa4f7",
                                                "text": "„Sie setzte sich auf die linke Kante des Bettes, öffnete die Riemchen der Stöckelschuhe und löste die Nylons von den Strumpfhaltern.“"
                                            },
                                            {
                                                "example_id": "75954d5f-9f14-4888-bcbc-7951245b3e49",
                                                "sense_id": "8f53cdea-1044-3014-b820-53d8617aa4f7",
                                                "text": "„Robert entfernte die Schuhe, ohne die Bänder zu lösen, rasch von Annas Fuß, zog ungestüm an den Strumpfhaltern, deren Klammern sie stumm selber freigab, und beugte sich tiefer, um das dünne Strumpfgewebe abzustreifen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3940f965-6489-4937-8cc8-b206a29062ad",
