                        "sense_id": "0104d360-cffd-3ae1-8f96-bb9686f10282",
                        "entry_id": "dbc268ea-12eb-30dd-b4ef-cfc44eaacc81",
                        "glosses": [
                            "Émettre leur sonnerie en parlant des cloches."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4f020f23-067d-45d9-8298-550dec007b34",
                                "sense_id": "0104d360-cffd-3ae1-8f96-bb9686f10282",
                                "text": "Aussitôt toutes les cloches de la ville de tocsiner..., toutes les cloches de la campagne drelindinent pareillement..."
                            },
                            {
                                "example_id": "c4d3da00-5279-4aa9-a174-3080d6fa29c0",
                                "sense_id": "0104d360-cffd-3ae1-8f96-bb9686f10282",
                                "text": "La vérité est que le monument est agrémenté de quatre clochetons et qu'il possède trois cloches, qui ne drelindinent pas plus faux que d'autres."
                            }
                        ]
                    }
