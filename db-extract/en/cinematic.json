                ],
                "translations": [
                    {
                        "translation_id": "b8a7054d-f4bd-4383-b19a-4c52b0949400",
                        "source_entry_id": "8bb60e43-434c-3736-9411-8ab4b615f3c4",
                        "source_sense_description": "relating to the cinema",
                        "target_lang_word": "cinématographique",
