        "fr-extract.jsonl": [
            {
                "entry_id": "a589fde7-40b0-38f2-b33e-5694a0a89a52",
                "word": "arrachement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ea7c4fc-e19d-4a81-ab38-6c0f082b770d",
                        "entry_id": "a589fde7-40b0-38f2-b33e-5694a0a89a52",
                        "tags": [
                            "plural"
                        ],
                        "form": "arrachements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "205aa0dd-91f1-3136-8db5-93866e195b2d",
                        "entry_id": "a589fde7-40b0-38f2-b33e-5694a0a89a52",
                        "glosses": [
                            "Action d’arracher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0465026-be83-4311-9ce0-dfda5994cd59",
                                "sense_id": "205aa0dd-91f1-3136-8db5-93866e195b2d",
                                "text": "[…] : il y a plus, c’est que les sarclages et l’arrachement ont nettoyé le sol de toutes les plantes étrangères, […]."
                            },
                            {
                                "example_id": "41f9d441-27ef-42ec-89b6-14a5764773e6",
                                "sense_id": "205aa0dd-91f1-3136-8db5-93866e195b2d",
                                "text": "Pendant que dans la grande cour de l'hôtel de la Poste on attelait les chevaux de la lourde diligence et qu'on chargeait les colis, les adieux vingt fois répétés étaient de part et d'autre comme une série d’arrachements."
                            },
                            {
                                "example_id": "33c20ce2-bee7-4730-ba58-7b57ba70642b",
                                "sense_id": "205aa0dd-91f1-3136-8db5-93866e195b2d",
                                "text": "Après elle, jamais plus il n’aimerait ; et ce dont criait son être, c’était de cet arrachement de la femme et de l’amour."
                            },
                            {
                                "example_id": "680d07b8-d9a7-4362-8c68-7fdfb7c6507c",
                                "sense_id": "205aa0dd-91f1-3136-8db5-93866e195b2d",
                                "text": "La vitesse ne se marque pas tant, à mes yeux, par la distance parcourue en un laps de temps défini que par le pouvoir d’arrachement."
                            },
                            {
                                "example_id": "e5503573-f1ec-4528-94f2-352de0a5e32f",
                                "sense_id": "205aa0dd-91f1-3136-8db5-93866e195b2d",
                                "text": "L'exploitation comporte trois phases successives (ou parfois simultanées) : la découverture, ou enlèvement des morts-terrains, l’extraction proprement dite, qui consiste en l’arrachement des blocs hors de la masse et, enfin, le halage et l’ébauchage de ces blocs."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e2134da-f1b1-32e2-a9a7-7fe77cd535ed",
                        "entry_id": "a589fde7-40b0-38f2-b33e-5694a0a89a52",
                        "glosses": [
                            "Pierres enlevées à un mur, ou à l'inverse laissées en saillie pour emboîter dans les vides les pierres d’une construction nouvelle."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
