                                "target_senses": [
                                    {
                                        "sense_id": "c16645c4-21b3-3ef6-b3b9-8404c005327e",
                                        "entry_id": "c575e896-be71-3aa9-88b8-69e613342749",
                                        "glosses": [
                                            "тот, кто занимается топкой печей, отопительных котлов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00334973-565f-45d8-aff9-584b95b4497f",
                                                "sense_id": "c16645c4-21b3-3ef6-b3b9-8404c005327e",
                                                "text": "Дача съедала много дров и угля, топил дом тогда ещё истопник ― ему платили пятьсот рублей в месяц, он же чистил от снега дорогу к дому и гаражу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ad2d82d-7731-4d17-a427-102a8b41f55a",
                        "source_entry_id": "d6a51730-424a-33b8-99fa-799ed18f6d9e",
                        "source_sense_id": "2b5a487e-e10c-3971-82b4-e88ae00d35b6",
                        "source_sense_description": "Person, die heizt",
                        "target_lang_word": "кочегар",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кочегар",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "57359df5-d5c6-3564-8478-73c5f7bbc378",
                                        "entry_id": "8ca8c50b-8253-38b9-b54b-45539db00e71",
                                        "glosses": [
                                            "рабочий, обслуживающий топки паровых котлов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc3af163-689f-4f4e-b309-09280616518f",
                                                "sense_id": "57359df5-d5c6-3564-8478-73c5f7bbc378",
                                                "text": "Кочегары опустились в свою кочегарку, зашевелились матросы — сейчас сниматься в море."
                                            },
                                            {
                                                "example_id": "5cf8d1c7-0b5c-4695-baf7-2ee6ca221cae",
                                                "sense_id": "57359df5-d5c6-3564-8478-73c5f7bbc378",
                                                "text": "Кочегары, орудуя в топках, так старались, что на «Храбром» дымовая труба, накалившись докрасна, прогорела."
                                            },
                                            {
                                                "example_id": "86bc720b-1d83-4425-aa93-3e3e8a164f2a",
                                                "sense_id": "57359df5-d5c6-3564-8478-73c5f7bbc378",
                                                "text": "Возникли также рок-профессии (например, дворники, сторожа, кочегары, которыми становятся люди с высшим образованием, но не от склонности к этой профессии, а для того, чтобы зарабатывать деньги и иметь жильё)."
                                            },
                                            {
                                                "example_id": "e332d9d1-b92e-44e5-baf8-f614fc89174e",
                                                "sense_id": "57359df5-d5c6-3564-8478-73c5f7bbc378",
                                                "text": "Машинист (кочегар, оператор) должен знать устройство и работу обслуживаемых им котлов и всего вспомогательного оборудования котельной (питательные насосы, вентиляторы, дымососы, воздушные компрессоры и т. п.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cbb4494-a7d5-3c8c-867a-dd62a38d74d9",
                                        "entry_id": "8ca8c50b-8253-38b9-b54b-45539db00e71",
                                        "glosses": [
                                            "крим. жарг. активный гомосексуалист"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
