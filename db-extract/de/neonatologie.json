                        "entry_id": "cb1d9cf7-7fd7-3dad-8158-f0e296b8aee3",
                        "glosses": [
                            "Lehre der Pathologie und Physiologie (menschlicher) Neugeborener"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42230913-7f2c-496b-af1d-f01add2c9e75",
                                "sense_id": "a9c3e488-2c79-39eb-93a6-33f719aa270d",
                                "text": "„In den letzten Jahrzehnten hat die Medizin im Bereich der Neonatologie immense Fortschritte gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29c48deb-61bc-38b1-aa47-873505da2662",
                        "entry_id": "cb1d9cf7-7fd7-3dad-8158-f0e296b8aee3",
                        "glosses": [
                            "Teilgebiet der Pädiatrie (= Kinderheilkunde), der sich mit Neugeborenenmedizin (häufig auch Frühgeborenenmedizin) und Neugeborenenvorsorge befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12c398de-0d1e-42d5-acad-23aaaa784a09",
                                "sense_id": "29c48deb-61bc-38b1-aa47-873505da2662",
                                "text": "„In den letzten Jahrzehnten hat die Medizin im Bereich der Neonatologie immense Fortschritte gemacht.“"
                            },
                            {
                                "example_id": "e12520f0-0c35-439f-9fce-1ac04a27fc67",
                                "sense_id": "29c48deb-61bc-38b1-aa47-873505da2662",
                                "text": "„Die Neonatologie und Perinatologie sind ganz besondere Fächer der Humanmedizin, werden doch hier Menschen am Übergang vom fetalen zum neonatalen Leben betreut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
