                                        "sense_id": "c5532e2f-e87f-39ac-81ce-ff00e1288bf3",
                                        "entry_id": "0cd1bee6-92e8-3c89-9cdd-838fdc6360f8",
                                        "glosses": [
                                            "The act of uniformizing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e5aa873-21f3-434b-b9f6-f4fe5f2b1efa",
                                                "sense_id": "c5532e2f-e87f-39ac-81ce-ff00e1288bf3",
                                                "text": "[…] who in vivid contrast to Kabin pursued a deliberate policy of Russification and uniformization with the rest of the Soviet Union."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b99c04e-53a9-48c0-b764-f4efcfd74b40",
                        "source_entry_id": "42d60596-21ee-3b93-bb17-a62748ce2b76",
                        "source_sense_id": "cfbe7f94-2f65-3da1-9b09-ba06b8b4b357",
                        "target_lang_word": "uniformisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uniformisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c245809-090d-300e-b1a1-b7ff0e1bc98a",
                                        "entry_id": "f2b025cc-31d9-33c7-913b-df768f70584a",
                                        "glosses": [
                                            "Action d’uniformiser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e937c0b4-629c-4669-b8a1-83fb6b3e3237",
                                                "sense_id": "5c245809-090d-300e-b1a1-b7ff0e1bc98a",
                                                "text": "Pendant la période maoïste, l’uniformisation des vêtements avait mis fin à toute distinction vestimentaire."
                                            },
                                            {
                                                "example_id": "4cf46100-91ca-434f-8c72-e916904975cc",
                                                "sense_id": "5c245809-090d-300e-b1a1-b7ff0e1bc98a",
                                                "text": "À date, il n’y a pas de standards de développement donc aucune uniformisation entre les métavers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f7a4cf0-53f7-45fd-9250-393add72351e",
