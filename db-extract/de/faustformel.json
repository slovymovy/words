                        ],
                        "form": "die Faustformel"
                    },
                    {
                        "form_id": "c4aecbd4-9c4c-4c46-8108-1b250445d728",
                        "entry_id": "65c6afd5-98bd-36d3-94e4-da1dca59b5c5",
                        "tags": [
                            "accusative",
