                "senses": [
                    {
                        "sense_id": "90605566-ac7b-3e08-a6d3-10d026c7e4cb",
                        "entry_id": "faa89056-e0fd-3e3f-9d07-22645d3602ae",
                        "glosses": [
                            "ein kleines Boot"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "11a6def2-c412-484c-885b-584c801f1fb4",
                                "sense_id": "90605566-ac7b-3e08-a6d3-10d026c7e4cb",
                                "text": "„Das von unterirdischen Maschinen angetriebene Blech des „Eisernes Sees“ ist blau bemalt, und wenn du im Schinakel sitzt und dich krampfhaft bemühst, es so zu führen, daß du nicht anprallst oder umkippst, dann kannst du dir einbilden, tatsächlich auf See zu fahren, ohne die salzige Seeluft atmen zu müssen oder naß zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bdbf43d7-cb6b-3d85-9e88-c48b44612346",
                        "entry_id": "faa89056-e0fd-3e3f-9d07-22645d3602ae",
                        "glosses": [
                            "weit ausgetretene Schuhe"
                        ],
                        "tags": [
                            "figurative",
                            "humorous",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1ae124e6-8739-4d3d-9d45-66a6535b7a4d",
                                "sense_id": "bdbf43d7-cb6b-3d85-9e88-c48b44612346",
                                "text": "Diese alten Schinakel wirfst du besser weg!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
