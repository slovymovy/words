                        "glosses": [
                            "Nom usuel de Ocotea odorifera, arbre bolivien de la famille des Lauraceae (Lauracées), dont le bois possède une odeur camphrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2ecadd-f124-497d-96a6-7d4e438909fc",
                                "sense_id": "9c370317-afd9-353f-8dc1-978cfd5cad12",
                                "text": "La cotoïne et la paracotoïne sont extraites de l'écorce de coto."
                            },
                            {
                                "example_id": "bfea75aa-4c38-4c6f-aa3f-910a88b2f26a",
                                "sense_id": "9c370317-afd9-353f-8dc1-978cfd5cad12",
                                "text": "L’écorce de coto et de paracoto n’est plus employée - on l’a remplacée par la cotoïne et la paracotoïne que vante Burkart."
                            }
                        ]
                    }
