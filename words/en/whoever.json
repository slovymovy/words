{
    "word_family": [
        "whosoever",
        "whatever",
        "whichever",
        "whenever",
        "wherever",
        "however"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "07d93568-070b-3965-a689-e1ab048ba31a",
                    "sense_definition": "Any person who; the person who.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "indefinite_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are free to invite <w>whoever</w> you want to the dinner party.",
                            "target_lang_translations": {
                                "ru": "Ты можешь пригласить на ужин <w>кого угодно</w>.",
                                "nl": "Het staat je vrij om <w>wie je ook maar</w> wilt uit te nodigen voor het etentje.",
                                "zh": "你可以随意邀请<w>任何</w>你想邀请的人来参加晚宴。"
                            }
                        },
                        {
                            "text": "<w>Whoever</w> broke the vase should be honest and admit it immediately.",
                            "target_lang_translations": {
                                "ru": "<w>Тот, кто</w> разбил вазу, должен честно признаться в этом немедленно.",
                                "nl": "<w>Degene die</w> de vaas heeft gebroken, moet eerlijk zijn en het onmiddellijk toegeven.",
                                "zh": "<w>那个</w>打碎花瓶的人应该诚实，立即承认。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anyone who",
                        "no matter who"
                    ],
                    "common_phrases": [
                        "whoever it is",
                        "whoever wants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой человек, который; тот, кто.",
                        "nl": "Iedere persoon die; degene die.",
                        "zh": "指代任何一个人；那个人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тот, кто",
                                "target_lang_sense_clarification": "указание на конкретное лицо"
                            },
                            {
                                "target_lang_word": "любой, кто",
                                "target_lang_sense_clarification": "всякий, кто"
                            },
                            {
                                "target_lang_word": "кто угодно",
                                "target_lang_sense_clarification": "без ограничений в выборе"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "wie ook maar",
                                "target_lang_sense_clarification": "elke willekeurige persoon"
                            },
                            {
                                "target_lang_word": "degene die",
                                "target_lang_sense_clarification": "de specifieke persoon die iets doet"
                            },
                            {
                                "target_lang_word": "iedereen die",
                                "target_lang_sense_clarification": "alle personen die"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "任何……的人",
                                "target_lang_sense_clarification": "指代不特定的人"
                            },
                            {
                                "target_lang_word": "那个人",
                                "target_lang_sense_clarification": "指代特定的某人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d57deaa0-79c8-323e-a908-1debfb5c5a84",
                    "sense_definition": "No matter who; regardless of the identity of the person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indefinite_pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whoever</w> calls while I am out, tell them I will call back later.",
                            "target_lang_translations": {
                                "ru": "<w>Кто бы ни</w> позвонил, пока меня нет, скажи им, что я перезвоню позже.",
                                "nl": "<w>Wie er ook</w> belt terwijl ik weg ben, zeg hen dat ik later terugbel.",
                                "zh": "<w>无论谁</w>在我外出时打电话来，都告诉他们我会稍后回电。"
                            }
                        },
                        {
                            "text": "We must uphold the rules, <w>whoever</w> the offender might be.",
                            "target_lang_translations": {
                                "ru": "Мы должны соблюдать правила, <w>кем бы ни</w> был нарушитель.",
                                "nl": "We moeten ons aan de regels houden, <w>wie</w> de overtreder <w>ook</w> mag zijn.",
                                "zh": "我们必须维护规则，<w>不管</w>违规者是谁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "no matter who"
                    ],
                    "common_phrases": [
                        "whoever they are",
                        "or whoever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неважно кто; независимо от того, кто это.",
                        "nl": "Het maakt niet uit wie; ongeacht de identiteit van de persoon.",
                        "zh": "无论谁；不管是谁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кто бы ни",
                                "target_lang_sense_clarification": "в уступительных оборотах"
                            },
                            {
                                "target_lang_word": "кто бы то ни был",
                                "target_lang_sense_clarification": "усиленная форма"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "wie dan ook",
                                "target_lang_sense_clarification": "ongeacht de persoon"
                            },
                            {
                                "target_lang_word": "wie het ook is",
                                "target_lang_sense_clarification": "ongeacht de identiteit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无论谁",
                                "target_lang_sense_clarification": "表示不考虑身份"
                            },
                            {
                                "target_lang_word": "不管是谁",
                                "target_lang_sense_clarification": "强调身份不重要"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc01ebdd-bcdb-388a-b987-e32846fe63ed",
                    "sense_definition": "Used as an emphatic form of 'who' in questions to express surprise, confusion, or annoyance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whoever</w> told you that strange story about the old house?",
                            "target_lang_translations": {
                                "ru": "<w>Кто же</w> рассказал тебе эту странную историю о старом доме?",
                                "nl": "<w>Wie toch</w> heeft je dat vreemde verhaal over het oude huis verteld?",
                                "zh": "<w>到底是谁</w>告诉你那个关于老房子的奇怪故事的？"
                            }
                        },
                        {
                            "text": "<w>Whoever</w> could have left the front door wide open?",
                            "target_lang_translations": {
                                "ru": "<w>Кто же</w> мог оставить входную дверь нараспашку?",
                                "nl": "<w>Wie in hemelsnaam</w> zou de voordeur wagenwijd open hebben laten staan?",
                                "zh": "<w>究竟是谁</w>把前门大敞着没关？"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often written as two words 'who ever' in formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления вопросительного слова «кто», выражая удивление или раздражение.",
                        "nl": "Gebruikt als een nadrukkelijke vorm van 'wie' in vragen om verbazing, verwarring of irritatie uit te drukken.",
                        "zh": "用于疑问句中加强语气，表示惊讶、困惑或恼火。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кто же",
                                "target_lang_sense_clarification": "эмоциональное усиление вопроса"
                            },
                            {
                                "target_lang_word": "кто вообще",
                                "target_lang_sense_clarification": "разговорное усиление"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "wie toch",
                                "target_lang_sense_clarification": "nadrukkelijke vraag met verbazing"
                            },
                            {
                                "target_lang_word": "wie in hemelsnaam",
                                "target_lang_sense_clarification": "sterke verbazing of irritatie"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "到底是谁",
                                "target_lang_sense_clarification": "加强疑问语气"
                            },
                            {
                                "target_lang_word": "究竟是谁",
                                "target_lang_sense_clarification": "表示强烈的好奇或惊讶"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}