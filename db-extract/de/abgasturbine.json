                "senses": [
                    {
                        "sense_id": "38a6a5d3-3616-3d70-97ae-bac83283dc92",
                        "entry_id": "8d9ce0ae-08f8-38b2-8215-3d806d021b83",
                        "glosses": [
                            "mit Abgas betriebene Turbine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eedf891e-34f8-4a67-86ea-2af6298b2fdb",
                                "sense_id": "38a6a5d3-3616-3d70-97ae-bac83283dc92",
                                "text": "„Da die Leistung in größeren Höhen infolge abnehmenden Luftdrucks gemindert wird, wurden Kreiselverdichter als Aufladegebläse (Lader) verwendet, die heute durch Abgasturbinen (Abgasturbolader) angetrieben werden.“"
                            },
                            {
                                "example_id": "ece40be8-1a3a-4260-ba39-d47748437ac2",
                                "sense_id": "38a6a5d3-3616-3d70-97ae-bac83283dc92",
                                "text": "„Beim Verbundtriebwerk wird die restliche Abgasenergie durch Abgasturbinen ausgenutzt und auf die Propellerwelle übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
