                                "sense_id": "4e7c7c61-e3b2-3df5-99e2-3072136a5a5e",
                                "text": "De kerstgedachte is om liefde en vriendelijkheid te verspreiden.",
                                "translation": "The Christmas spirit is to spread love and kindness.",
                                "english": "The Christmas spirit is to spread love and kindness."
                            },
