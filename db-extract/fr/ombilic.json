        "fr-extract.jsonl": [
            {
                "entry_id": "2f85de10-3d66-3743-94e9-d92e549d64a8",
                "word": "ombilic",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1d1b1c51-66ec-4533-af22-5e1800cd521e",
                        "entry_id": "2f85de10-3d66-3743-94e9-d92e549d64a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "ombilics"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0875617d-17bb-3934-949a-143fc9eb506a",
                        "entry_id": "2f85de10-3d66-3743-94e9-d92e549d64a8",
                        "glosses": [
                            "Nombril."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50df60f-332d-453f-a973-58b961eebbc6",
                                "sense_id": "0875617d-17bb-3934-949a-143fc9eb506a",
                                "text": "Il m’a forcé à boire un grand verre de vin, je me suis trouvé mieux, sauf une douleur violente à la hauteur de l’ombilic, et qui s’est apaisée peu à peu."
                            },
                            {
                                "example_id": "c36e16e8-eca0-4970-a4a6-ad03d439c94d",
                                "sense_id": "0875617d-17bb-3934-949a-143fc9eb506a",
                                "text": "Dans une lettre adressée lors de votre voyage, vous parliez de Marie, compagne de Lydia, dont les poils pubiques formaient une colonne se rendant jusqu’à l’ombilic. C’est formidable!"
                            },
                            {
                                "example_id": "11f4f2a7-368f-4871-bb44-0cb8e049c0c5",
                                "sense_id": "0875617d-17bb-3934-949a-143fc9eb506a",
                                "text": "Ce qui me blesse les yeux, quant à moi, vocifère Coselli, ce qui me blesse les yeux, c’est votre louche nombril, votre ombilic obscène, la peau de tambour moisie de votre bedaine, votre exhibitionnisme sénile, Géronte de la galonnaille, Ratapoil de fête nationale, bubon du chancre militaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "e78057c3-bf07-3ad5-8fc3-9bb87f10c1bc",
                        "entry_id": "2f85de10-3d66-3743-94e9-d92e549d64a8",
                        "glosses": [
                            "Orifice central à la face inférieure de la coquille des gastéropodes formé par l’émergence à l’extérieur de l’ouverture de l’axe d’enroulement (columelle) de la coquille."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "af2c838c-c322-3b8f-ba5f-5738c2a95eba",
                        "entry_id": "2f85de10-3d66-3743-94e9-d92e549d64a8",
                        "glosses": [
                            "Petite cicatrice qu’on voit sur les graines des plantes et qui s’appelle aussi hile."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "970ff9fc-eb26-37db-8f75-94b379a99c9a",
                        "entry_id": "2f85de10-3d66-3743-94e9-d92e549d64a8",
                        "glosses": [
                            "enfoncement qui se trouve à l’une ou à l’autre extrémité de certains fruits."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "89d8c72d-a0dd-3019-aa79-5a5731daa350",
                        "entry_id": "2f85de10-3d66-3743-94e9-d92e549d64a8",
                        "glosses": [
                            "Renflement central de certains objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d404ae06-8f22-44bd-ba4e-56a05e03a5fd",
                                "sense_id": "89d8c72d-a0dd-3019-aa79-5a5731daa350",
                                "text": "L’ombilic d’un bouclier."
                            },
                            {
                                "example_id": "094b1315-2ba1-46c7-b26d-24b0254530be",
                                "sense_id": "89d8c72d-a0dd-3019-aa79-5a5731daa350",
                                "text": "L’ombilic d’un plat de faïence."
                            }
                        ]
                    },
                    {
                        "sense_id": "66d02c2d-251f-3fad-9e6d-e856e3e46a4a",
                        "entry_id": "2f85de10-3d66-3743-94e9-d92e549d64a8",
                        "glosses": [
                            "Surcreusement dans le lit d’un glacier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a780975-2215-4704-a9e1-68cc61345748",
                                "sense_id": "66d02c2d-251f-3fad-9e6d-e856e3e46a4a",
                                "text": "En 1987, Wetter étudie les moraines du Fayet et s’attarde sur la moraine du village de Gravin. Il reconnaît alors trois stades de stationnement du glacier dans l’ombilic de Sallanches."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a88673d-8364-34ee-b8b7-aa2f2e231004",
                        "entry_id": "2f85de10-3d66-3743-94e9-d92e549d64a8",
                        "glosses": [
                            "Plante à fleur du genre Umbilicus, de la famille des Crassulaceae."
                        ],
                        "tags": [],
                        "examples": []
                    }
