                "senses": [
                    {
                        "sense_id": "4e801a9a-ebe5-38d3-b3c9-c4109dca7c7c",
                        "entry_id": "fe51e142-f9b9-3809-ac45-283ddd4060ec",
                        "glosses": [
                            "To engrave incorrectly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b745e9a0-bc02-43c2-b315-4620553bb8c9",
                                "sense_id": "4e801a9a-ebe5-38d3-b3c9-c4109dca7c7c",
                                "text": "The star is also misengraved or tampered with, appearing in Rud., Sup. ii. 13, 12 1 regular fleur-de-lis."
                            },
                            {
                                "example_id": "a4b5da0b-451c-421c-8841-35273cefc259",
                                "sense_id": "4e801a9a-ebe5-38d3-b3c9-c4109dca7c7c",
                                "text": "Not only was the theory incorrect, but the fossil was misengraved, having received additions which were not warranted, and illustrated by sections which in his opinion were impossible."
                            },
                            {
                                "example_id": "e323403d-bafd-42f7-92f0-73061be16ba2",
                                "sense_id": "4e801a9a-ebe5-38d3-b3c9-c4109dca7c7c",
                                "text": "Speaking from our own experience, we should say that, while the triangulation is perfect, the heights are not unfrequently misengraved, and the topography is here and there very imperfect; but it marks a vast advance on the maps of Bourcet and Cassini."
                            },
                            {
                                "example_id": "83e3a588-f354-4e53-b33d-4b9fe9b7190c",
                                "sense_id": "4e801a9a-ebe5-38d3-b3c9-c4109dca7c7c",
                                "text": "It didn't matter in the least that our trophy was misengraved “Montana Review of Brooks.\""
                            },
                            {
                                "example_id": "5d74caac-659b-4c72-a79c-7cca93183483",
                                "sense_id": "4e801a9a-ebe5-38d3-b3c9-c4109dca7c7c",
                                "text": "This would show that neither we have erred in reading the date nor the engraver has misengraved it."
                            }
                        ]
                    }
                ],
