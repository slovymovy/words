                "senses": [
                    {
                        "sense_id": "580a884f-9afe-36f0-a266-15e3606621c0",
                        "entry_id": "6c5578c4-82f8-3025-8799-fcb133f11997",
                        "glosses": [
                            "Pratiquer le vol plané."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3743f23-9ddd-416b-aaca-e2e83b287944",
                                "sense_id": "580a884f-9afe-36f0-a266-15e3606621c0",
                                "text": "Aujourd’hui, toute personne qui se respecte passe une partie de l’automne à la Côte d’azur, l’hiver dans les Alpes, le printemps à Paris, l’été à la mer, deux mois dans ses terres (c’est bien assez, juste pour les chasses) et le reste du temps..... à voyager ou volplaner."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bb4d5c9-140e-37f3-bd48-b02eb8426714",
                        "entry_id": "6c5578c4-82f8-3025-8799-fcb133f11997",
                        "glosses": [
                            "Faire un vol plané."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "970b0787-5323-4b5c-8ffe-701e433f698a",
                                "sense_id": "0bb4d5c9-140e-37f3-bd48-b02eb8426714",
                                "text": "Il n’aurait plus manqué que le cambrioleur vienne volplaner pour terminer la nuit avec Farid dans la tombe paléochrétienne."
                            },
                            {
                                "example_id": "24ed21f4-d4ce-4958-b148-973b858b465e",
                                "sense_id": "0bb4d5c9-140e-37f3-bd48-b02eb8426714",
                                "text": "Y a la mort qui se met à volplaner sur la scène, tu comprends ?"
                            },
                            {
                                "example_id": "5123181b-901e-442a-ae94-c8a32451087d",
                                "sense_id": "0bb4d5c9-140e-37f3-bd48-b02eb8426714",
                                "text": "C’est à ce moment précis que la vitre vola en éclats, sous l’impact d’un lourd projectile. Qui n’avait pas encore touché terre lorsque je volplanai, moi-même, à destination de nulle part."
                            }
                        ]
                    }
                ],
