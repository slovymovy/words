            "senses": [
                {
                    "sense_id": "2b922d3c-172f-3d04-ac69-33070964b85f",
                    "sense_definition": "To set fire to something; to cause something to start burning.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spark from the engine was enough to <w>ignite</w> the fuel.",
                            "target_lang_translations": {
                                "ru": "Искры от двигателя было достаточно, чтобы <w>воспламенить</w> топливо."
                            }
                        },
                        {
                            "text": "Be careful not to <w>ignite</w> the dry leaves with your campfire.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>поджечь</w> сухие листья костром."
                            }
                        }
                    ],
                    "synonyms": [
                        "kindle",
                        "light",
                        "set on fire"
                    ],
                    "antonyms": [
                        "extinguish",
                        "quench"
                    ],
                    "common_phrases": [
                        "ignite the fuel",
                        "ignite a fire"
                    ],
                    "target_lang_definitions": {
