                "senses": [
                    {
                        "sense_id": "af0b8e85-9038-3b54-848c-423cc8eecbbd",
                        "entry_id": "78470aa3-cdee-31d6-86a9-a66f309aa61e",
                        "glosses": [
                            "свойство по значению прилагательного фанатичный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4227c5ab-7e28-465d-8c89-f34ec33a8253",
                                "sense_id": "af0b8e85-9038-3b54-848c-423cc8eecbbd",
                                "text": "Мне понравились вы фанатичностью вашего положения ― вот чем!"
                            },
                            {
                                "example_id": "a398469d-11ec-48ac-a7fb-81deaef2da9f",
                                "sense_id": "af0b8e85-9038-3b54-848c-423cc8eecbbd",
                                "text": "Справедливость требует, однако же, признать и в нас склонность к фанатичности в наших убеждениях или, правильнее, верованиях."
                            }
                        ]
                    }
