            "senses": [
                {
                    "sense_id": "71e53ca9-9638-352c-9b10-8e22a0a5ae71",
                    "sense_definition": "Present participle and gerund of <w>mingle</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She spent the evening <w>mingling</w> with the guests at the party.",
                            "target_lang_translations": {
                                "fr": "Elle a passé la soirée à <w>socialiser</w> avec les invités à la fête."
                            }
                        },
                        {
                            "text": "The smell of flowers was <w>mingling</w> with the fresh sea air.",
                            "target_lang_translations": {
                                "fr": "L'odeur des fleurs se <w>mélangeait</w> à l'air frais de la mer."
                            }
                        }
                    ],
                    "synonyms": [
                        "socializing",
                        "mixing",
                        "blending"
                    ],
                    "common_phrases": [
                        "mingling with guests",
                        "mingling with crowd"
                    ],
                    "target_lang_definitions": {
                        "fr": "Participe présent et gérondif du verbe mélanger ou socialiser."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "socialiser",
                                "target_lang_sense_clarification": "Se dit d'une personne qui interagit avec d'autres lors d'un événement."
                            },
                            {
                                "target_lang_word": "se mélanger",
                                "target_lang_sense_clarification": "Se dit de choses ou de personnes qui s'entremêlent."
                            }
                        ]
                    }
                }
            ]
        },
        {
