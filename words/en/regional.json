{
    "word_family": [
        "region",
        "regionally",
        "regionalism",
        "regionalize",
        "regionalization",
        "interregional",
        "subregional"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d48b93de-7e0a-376c-b9d5-5f69d370638b",
                    "sense_definition": "Of, or pertaining to, a specific region or district.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government has announced new funding for <w>regional</w> development projects.",
                            "target_lang_translations": {
                                "ru": "Правительство объявило о новом финансировании проектов <w>регионального</w> развития.",
                                "zh": "政府宣布为<w>区域性</w>发展项目提供新的资金。"
                            }
                        },
                        {
                            "text": "There are distinct <w>regional</w> variations in the way people speak the language.",
                            "target_lang_translations": {
                                "ru": "Существуют отчетливые <w>региональные</w> различия в том, как люди говорят на этом языке.",
                                "zh": "人们说话的方式存在明显的<w>区域性</w>差异。"
                            }
                        }
                    ],
                    "synonyms": [
                        "local",
                        "provincial"
                    ],
                    "common_phrases": [
                        "regional development",
                        "regional office",
                        "regional government",
                        "regional variation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к определённому региону, области или району.",
                        "zh": "指属于或关于特定地区、区域或行政区的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "региональный",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "областной",
                                "target_lang_sense_clarification": "относящийся к административной области"
                            },
                            {
                                "target_lang_word": "местный",
                                "target_lang_sense_clarification": "локальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "区域性的",
                                "target_lang_sense_clarification": "指范围限于特定区域的"
                            },
                            {
                                "target_lang_word": "地方性的",
                                "target_lang_sense_clarification": "指属于当地或地方的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d2730b6-223b-3be6-83da-7f785141652f",
                    "sense_definition": "Of, or pertaining to, one part of the body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended <w>regional</w> anesthesia for the minor surgery on his hand.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал <w>регионарную</w> анестезию для небольшой операции на руке.",
                                "zh": "医生建议为他的手部小手术进行<w>局部</w>麻醉。"
                            }
                        },
                        {
                            "text": "Complex <w>regional</w> pain syndrome can be difficult to diagnose and treat effectively.",
                            "target_lang_translations": {
                                "ru": "Комплексный <w>регионарный</w> болевой синдром бывает трудно диагностировать и эффективно лечить.",
                                "zh": "复杂性<w>局部</w>疼痛综合征可能难以有效诊断和治疗。"
                            }
                        }
                    ],
                    "antonyms": [
                        "systemic",
                        "bodywide"
                    ],
                    "common_phrases": [
                        "regional anesthesia",
                        "regional nerve block"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к определённой части тела (медицинский термин).",
                        "zh": "指身体特定部位的（医学术语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регионарный",
                                "target_lang_sense_clarification": "медицинский термин (анестезия, лимфоузлы)"
                            },
                            {
                                "target_lang_word": "местный",
                                "target_lang_sense_clarification": "ограниченный определенным местом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "局部",
                                "target_lang_sense_clarification": "指身体特定部位的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5cfa50e-35ab-343b-bdb8-9ec075d89186",
                    "sense_definition": "An entity or event with scope limited to a single region.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our high school basketball team played well enough to qualify for the <w>regionals</w>.",
                            "target_lang_translations": {
                                "ru": "Наша школьная баскетбольная команда играла достаточно хорошо, чтобы пройти на <w>региональные соревнования</w>.",
                                "zh": "我们高中的篮球队表现出色，有资格参加<w>区域性比赛</w>。"
                            }
                        },
                        {
                            "text": "Many small <w>regionals</w> have been bought out by large national corporations.",
                            "target_lang_translations": {
                                "ru": "Многие небольшие <w>региональные компании</w> были выкуплены крупными национальными корпорациями.",
                                "zh": "许多小型<w>区域性公司</w>已被大型全国性企业收购。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "qualify for regionals",
                        "win the regionals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие (обычно спортивное) или организация, масштаб которых ограничен одним регионом.",
                        "zh": "指范围仅限于单一区域的实体或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "региональные соревнования",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "региональная компания",
                                "target_lang_sense_clarification": "бизнес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "区域性比赛",
                                "target_lang_sense_clarification": "体育赛事"
                            },
                            {
                                "target_lang_word": "区域性公司",
                                "target_lang_sense_clarification": "商业实体"
                            }
                        ]
                    }
                }
            ]
        }
    ]
