                ],
                "senses": [
                    {
                        "sense_id": "516f3571-365a-327f-8c97-54947aa03c46",
                        "entry_id": "57b5eee0-5a2e-387c-9974-e5db49fc7e02",
                        "glosses": [
                            "высок. построить, соорудить что-либо высокое; возвести"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f33df6d5-5fbf-4a9b-9962-6f9d12baf76b",
                                "sense_id": "516f3571-365a-327f-8c97-54947aa03c46",
                                "text": "Я памятник себе воздвиг нерукотворный, / К нему не зарастёт народная тропа, / Вознёсся выше он главою непокорной / Александрийского столпа."
                            },
                            {
                                "example_id": "453f6b24-885d-4477-8dc9-2289e80689eb",
                                "sense_id": "516f3571-365a-327f-8c97-54947aa03c46",
                                "text": "Сотворите же достойные плоды покаяния и не думайте говорить в себе: «отец у нас Авраам», ибо говорю вам, что Бог может из камней сих воздвигнуть детей Аврааму."
                            }
                        ]
                    }
                ],
