                        ],
                        "examples": [
                            {
                                "example_id": "8ad954a9-b91f-4b3c-9640-eaaa8a52547f",
                                "sense_id": "c82461a5-5627-3bcb-8544-2470d0b902d7",
                                "text": "Naturellement, la religion d’Apollon, exerçant son action modératrice, s’efforça d’atténuer les exubérances du nouveau culte."
                            }
                        ]
                    }
                ],
                "translations": [],
