                "senses": [
                    {
                        "sense_id": "db06b0c5-4882-375a-abd8-1fc40077f250",
                        "entry_id": "1656c247-5e42-35ee-995f-54e01d1656f6",
                        "glosses": [
                            "D’une manière dolente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ba3c55e-7991-4b6e-a287-378b87e0898f",
                                "sense_id": "db06b0c5-4882-375a-abd8-1fc40077f250",
                                "text": "Le maréchal [de Noailles] s’écrie dolemment qu’il a une migraine à mourir."
                            },
                            {
                                "example_id": "30248174-e8b8-4db4-988c-55725a116773",
                                "sense_id": "db06b0c5-4882-375a-abd8-1fc40077f250",
                                "text": "Je vois déjà le ministre des finances venir dolemment vous présenter un nouveau certificat de notre ruine."
                            },
                            {
                                "example_id": "fafbece8-0f4e-4fa3-bd9a-d44e6b490606",
                                "sense_id": "db06b0c5-4882-375a-abd8-1fc40077f250",
                                "text": "– Je n’ai jamais trahi la confiance de personne, dit dolemment Arnica, à qui personne encore n’avait jamais confié aucun secret."
                            },
                            {
                                "example_id": "d9a82b3f-830e-4b66-b2ea-c361e66304cf",
                                "sense_id": "db06b0c5-4882-375a-abd8-1fc40077f250",
                                "text": "— Ah ! si j’avais encore quatre autres sous, insinua dolemment Camus."
                            }
                        ]
                    }
                ],
