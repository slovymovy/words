                                "sense_id": "ce004efc-9177-34fb-a6cc-dd4ac0da6df8",
                                "text": "De diepte van het meer is onbekend.",
                                "translation": "The depth of the lake is unknown.",
                                "english": "The depth of the lake is unknown."
