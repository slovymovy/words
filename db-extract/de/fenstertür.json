                "translations": [
                    {
                        "translation_id": "2553d019-633c-4faa-8aca-f2fdeebb44c5",
                        "source_entry_id": "a92f3fe6-5e50-303d-a1a8-35b8d92fb628",
                        "source_sense_id": "d00b4eb4-4654-3f6a-b591-c3629f73f0e9",
                        "source_sense_description": "Tür, die als Fenster gestaltet ist",
                        "target_lang_word": "porte-fenêtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porte-fenêtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ceb9835-6673-3170-8047-a4c2ed8713c9",
                                        "entry_id": "4470ee89-17cf-3d79-96e1-fb7c26abf27c",
                                        "glosses": [
                                            "Fenêtre qui descend jusqu’au niveau du sol et qui donne accès sur un balcon, une terrasse, un jardin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb8fa1f-b38c-4432-84db-9d4d178b66b8",
                                                "sense_id": "3ceb9835-6673-3170-8047-a4c2ed8713c9",
                                                "text": "Une porte-fenêtre est généralement conçue comme une fenêtre à petit-bois, avec un panneau d’allège plein en partie basse."
                                            },
                                            {
                                                "example_id": "6f7ae231-0d93-4c56-b78b-5c334b84094e",
                                                "sense_id": "3ceb9835-6673-3170-8047-a4c2ed8713c9",
                                                "text": "Enfin, il vit la porte-fenêtre s’ouvrir avec des précautions infinies, sans qu’il eût entendu le moindre bruit de pas."
                                            },
                                            {
                                                "example_id": "f20fc269-8767-4164-bfce-da0e7a70a141",
                                                "sense_id": "3ceb9835-6673-3170-8047-a4c2ed8713c9",
                                                "text": "Grande entrée en dalles de comblanchien, expliqua Letroc avec un geste simple. Et quatre portes-fenêtres doubles sur la pelouse."
                                            },
                                            {
                                                "example_id": "02b3916e-c392-4184-9919-11541738aa95",
                                                "sense_id": "3ceb9835-6673-3170-8047-a4c2ed8713c9",
                                                "text": "Sandra Sélam est seule, elle se tient debout près de la porte-fenêtre, un verre de champagne à la main et regarde les calopsittes se poursuivre dans la volière adossée à la maison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
