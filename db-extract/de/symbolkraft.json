                        "examples": [
                            {
                                "example_id": "3991c43a-b503-4d07-9c22-3a663de2f546",
                                "sense_id": "85a693a0-b9c0-3a6e-bfa1-b46157ec8ced",
                                "text": "„Meine Eltern waren der Ansicht, ich solle vor dem Militärdienst meinen Horizont erweitern, also flog ich zu den Olympischen Spielen 1972 nach München. Dieser Besuch wurde auf eine Weise brutal abgekürzt, die für mich unvergessliche Symbolkraft besaß.“"
                            },
                            {
                                "example_id": "1756bb76-d712-4b4b-b92d-3a314d9129f8",
                                "sense_id": "85a693a0-b9c0-3a6e-bfa1-b46157ec8ced",
                                "text": "„Vielleicht ist diese Geschichte eine Legende, aber ich bin überzeugt, dass nur solche Legenden die Symbolkraft besitzen, um einen echten Gründungsmythos zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
