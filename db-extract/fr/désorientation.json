                        ],
                        "form": "désorientations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "161985a9-ca35-3046-816f-b3d86199ca01",
                        "entry_id": "c5a8ce47-b652-3eeb-b5b6-0643645b4146",
                        "glosses": [
                            "Action de désorienter, fait d’être désorienté, de perdre le sens de l’orientation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc383de2-1e0b-4a2b-9ea0-2faae20d3ef5",
                                "sense_id": "161985a9-ca35-3046-816f-b3d86199ca01",
                                "text": "Elle traduit cependant l'émiettement et la désorientation des trotskistes. Trotskistes français durant la Seconde Guerre mondiale sur Wikipédia."
                            },
                            {
                                "example_id": "d895dd27-e29a-44b9-b2fc-a0ac88ac73a6",
                                "sense_id": "161985a9-ca35-3046-816f-b3d86199ca01",
                                "text": "Si l’urbaniste travaille à favoriser l’orientation à travers l’élaboration de plans et de cartes, l’errant recherche activement la désorientation."
                            }
                        ]
                    },
                    {
                        "sense_id": "60cd9eef-8d03-3519-b1bc-1bc923d9f4b3",
                        "entry_id": "c5a8ce47-b652-3eeb-b5b6-0643645b4146",
                        "glosses": [
                            "Confusion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94d70cc9-dbb2-4d57-ad98-74ed037e7bca",
                                "sense_id": "60cd9eef-8d03-3519-b1bc-1bc923d9f4b3",
                                "text": "Désorientation spatio-temporelle ou désorientation temporospatiale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dec71b7d-2033-4992-9265-ff6dd120a3bd",
                        "source_entry_id": "c5a8ce47-b652-3eeb-b5b6-0643645b4146",
                        "target_lang_word": "Orientierungslosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orientierungslosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bf06c7ff-398c-36e0-ad06-76483c332681",
                                        "entry_id": "edff38d6-102a-3829-a9bb-714accd53216",
                                        "glosses": [
                                            "fehlende Orientierung, orientierungsloser Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd5c1054-1a4d-4a6c-9dc7-29e04e5f2c42",
                                                "sense_id": "bf06c7ff-398c-36e0-ad06-76483c332681",
                                                "text": "„Ich reiße die Augen auf. Ein Moment der Orientierungslosigkeit, aber dann fällt mir alles wieder ein.“"
                                            },
                                            {
                                                "example_id": "ea8ae883-4f03-4b8c-b153-c95b02a8205c",
                                                "sense_id": "bf06c7ff-398c-36e0-ad06-76483c332681",
                                                "text": "„Ohne Kompass und visuelle Anhaltspunkte ist Orientierungslosigkeit unvermeidlich.“"
                                            },
                                            {
                                                "example_id": "2a18d823-c086-42e4-b655-74a24f5026e7",
                                                "sense_id": "bf06c7ff-398c-36e0-ad06-76483c332681",
                                                "text": "„Nach einem Moment der Orientierungslosigkeit schüttelte ich die Benommenheit ab und hastete zur Tür.“"
                                            },
                                            {
                                                "example_id": "bd6c970b-eb7f-400d-90e0-9406a18439f4",
                                                "sense_id": "bf06c7ff-398c-36e0-ad06-76483c332681",
                                                "text": "„Sie diente dem Zweck, mit irrsinnigen Licht- und Geräuscheffekten eine sowohl physische als auch psychische Orientierungslosigkeit zu verursachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8c4f63e-260b-4239-b95c-5c8fb8992498",
                        "source_entry_id": "c5a8ce47-b652-3eeb-b5b6-0643645b4146",
