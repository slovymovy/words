                                            {
                                                "example_id": "8e34054f-3ffd-4c7d-b3b6-bac70ca54869",
                                                "sense_id": "dc347333-3820-318f-bc17-8847edc3f1bc",
                                                "text": "Elle sert, avec une autre pointure placée au bord de la gorge du rouleau imprimeur, à déterminer la position des feuilles d’une manière précise, […]."
                                            },
                                            {
                                                "example_id": "58a342ad-1dc8-4393-9209-c087bcd7f8d5",
                                                "sense_id": "dc347333-3820-318f-bc17-8847edc3f1bc",
                                                "text": "Le cliquet oscillant k2 est muni d’une dent pour chaque roue imprimeuse ; la plus grande dent p est à l’intérieur de la roue des unités ; la suivante en hauteur p est intérieure à la roue des dizaines ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imprimeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3bb782ff-6bc1-3c42-b43f-fb66f4d1d016",
                                        "entry_id": "1bbeb62e-ce0a-3152-bef2-2b810c28785c",
                                        "glosses": [
                                            "Celui qui imprime des livres, des circulaires, des affiches, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03215906-a4a4-4c35-b168-53e97d272352",
                                                "sense_id": "3bb782ff-6bc1-3c42-b43f-fb66f4d1d016",
                                                "text": "Il était le gendre de l’imprimeur Plantin qu’il remplaça à Anvers avant de diriger, à partir de 1585, une imprimerie à Leyde."
                                            },
                                            {
                                                "example_id": "8cb8b549-d0f8-4dfe-a96f-718dd274a166",
                                                "sense_id": "3bb782ff-6bc1-3c42-b43f-fb66f4d1d016",
                                                "text": "Envoyer une feuille à l’imprimeur."
                                            },
                                            {
                                                "example_id": "c27713b2-ebd7-4741-83ea-69a5feafb832",
                                                "sense_id": "3bb782ff-6bc1-3c42-b43f-fb66f4d1d016",
                                                "text": "Un ouvrage publié sans nom d’auteur ni d’imprimeur."
                                            },
                                            {
                                                "example_id": "85be2b58-d47b-44b3-82e9-5a0cff9e31a5",
                                                "sense_id": "3bb782ff-6bc1-3c42-b43f-fb66f4d1d016",
                                                "text": "Imprimeur-libraire."
                                            },
                                            {
                                                "example_id": "46d59a23-968f-4f4e-b7b3-13e3f20b06b0",
                                                "sense_id": "3bb782ff-6bc1-3c42-b43f-fb66f4d1d016",
                                                "text": "Elle a appris ses belles lettres chez un imprimeur quand elle était jeune, à Rouen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d26ad35b-9df5-3aca-a1d4-0c3379265689",
                                        "entry_id": "1bbeb62e-ce0a-3152-bef2-2b810c28785c",
                                        "glosses": [
                                            "Tout ouvrier qui travaille dans une imprimerie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da2cd5cd-21f7-4aab-9dcd-89d7f33f9109",
                                                "sense_id": "d26ad35b-9df5-3aca-a1d4-0c3379265689",
                                                "text": "Imprimeur en douce, imprimeur lithographe, imprimeur sur étoffes, celui qui a un établissement dans lequel on imprime des gravures, des lithographies, des étoffes."
                                            },
                                            {
                                                "example_id": "62556ad3-ab46-4af6-87a7-3ba5e7588ad9",
                                                "sense_id": "d26ad35b-9df5-3aca-a1d4-0c3379265689",
                                                "text": "Il y a vingt imprimeurs dans cette imprimerie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
