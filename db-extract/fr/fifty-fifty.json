                        "entry_id": "4ce93a1e-9f69-3c30-a061-61d2ad665f20",
                        "glosses": [
                            "À parts égales, cinquante-cinquante."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f9e6d3-5aef-49a9-a9dd-a96df7c61c0b",
                                "sense_id": "a24ab464-d173-330d-a8b2-43380a04d1ed",
                                "text": "Pour l’addition, on fait fifty-fifty."
                            },
                            {
                                "example_id": "7227f005-9431-4cd7-9b16-1f1d60762429",
                                "sense_id": "a24ab464-d173-330d-a8b2-43380a04d1ed",
                                "text": "— Au début, j’ai essayé de garder Angélique pour moi, pas pour moi tout seul, bien sûr,– je n’aurais pas pu, mais au moins un partage à fifty-fifty."
                            },
                            {
                                "example_id": "6910274e-99a6-41b9-b783-5ae1d41af4be",
                                "sense_id": "a24ab464-d173-330d-a8b2-43380a04d1ed",
                                "text": "L'ex-pédégé de Lafarge a touché un énorme chèque de 8,4 millions d'euros pour avoir été à l'origine du prétendu mariage, fifty-fifty, de sa société avec le suisse Holcim, qui a conduit à déplacer le siège du nouvel ensemble à Zurich."
                            }
                        ]
                    }
