                "senses": [
                    {
                        "sense_id": "3d99d6c5-a7d6-3951-a037-72ec0cd6c651",
                        "entry_id": "98d2a2a0-07ae-3a17-8ded-c972a5270d97",
                        "glosses": [
                            "Gerichtsverfahren zur Klärung der Rechtslage, das als Beispiel für ähnliche, künftige Fälle durchgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0b7d148-5020-4f30-9de1-5b6300e4e112",
                                "sense_id": "3d99d6c5-a7d6-3951-a037-72ec0cd6c651",
                                "text": "„In Braunschweig wird in dieser Woche der milliardenschwere Musterprozess von Anlegern fortgesetzt.“"
                            },
                            {
                                "example_id": "25a6f867-9ab9-4146-bbd8-a8cc12dc57c8",
                                "sense_id": "3d99d6c5-a7d6-3951-a037-72ec0cd6c651",
                                "text": "„Zudem wollen die Tilp-Anwälte im Betrugsfall Wirecard einen Musterprozess in München erwirken.“"
                            },
                            {
                                "example_id": "b88c2ac9-9ee4-4fb5-a7a2-88c584731a4f",
                                "sense_id": "3d99d6c5-a7d6-3951-a037-72ec0cd6c651",
                                "text": "„Fünf Jahre danach wartet die Offenbacher Familie, noch immer ohne Schadenersatz, auf die zweite Runde eines Musterprozesses gegen die ‚Bundesrepublik Deutschland, vertreten durch den Herrn Bundesminister für Wirtschaft‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
