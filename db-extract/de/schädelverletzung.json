                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eabadec-1073-49aa-9b3f-ee84f66f0388",
                                "sense_id": "080b6f57-8585-32f1-bd5c-c910e1a960b5",
                                "text": "„Schädelverletzungen lassen sich nach einem Unfall häufig nur vermuten.“"
                            },
                            {
                                "example_id": "18e10d02-f98a-40d5-a97f-99ea31818e16",
                                "sense_id": "080b6f57-8585-32f1-bd5c-c910e1a960b5",
                                "text": "„Brandspuren zeichen ihre sterblichen Überreste ebenso wie die Spuren von stumpfen Schädelverletzungen, Pfeilspitzen finden sich zudem unter den Knochen.“"
                            },
                            {
                                "example_id": "84a46b79-92cc-4c51-8fb2-ea9e480ffc4e",
                                "sense_id": "080b6f57-8585-32f1-bd5c-c910e1a960b5",
                                "text": "„Das aber machte sie nur noch wütender, weshalb sie ihn immer fester schlugen, bis er schließlich an zu hohem Blutverlust und schweren Schädelverletzungen starb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
