                            }
                        ]
                    },
                    {
                        "translation_id": "e1a9fef9-fb63-42f9-8f21-8be8e4a944b3",
                        "source_entry_id": "917a740c-7de0-35b7-93db-31ccb8dcfc5c",
                        "source_sense_id": "84b426e2-d0c4-3ba6-827b-2a3d22238652",
                        "source_sense_description": "kreisförmiges oder quadratisches symbolisches Gebilde mit einem Zentrum zur Anregung der Meditation",
                        "target_lang_word": "mandala",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandala",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "954bb8f3-1547-3feb-b75b-77ab90395718",
                                        "entry_id": "3a252d02-48ef-3218-ab9a-a1c257829638",
                                        "glosses": [
                                            "Représentation symbolique et circulaire de l’univers qui sert de support à la méditation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "084beaeb-71e4-481f-9f6f-b8b757246c2e",
                                                "sense_id": "954bb8f3-1547-3feb-b75b-77ab90395718",
                                                "text": "Pour se débarrasser du trouble, il faut inviter un Atchareia et disposer un mandala (cercle magique) de cinq couleurs (fine), chaque côté de ce mandala doit avoir quatre coudées, il doit avoir quatre portes, et au milieu l'on met l'autel."
                                            },
                                            {
                                                "example_id": "e68b7168-7877-4b05-bf35-2c5936dc197f",
                                                "sense_id": "954bb8f3-1547-3feb-b75b-77ab90395718",
                                                "text": "Des malades qu'il [le docteur Jung] soigne et à qui il a demandé de faire des dessins, ont reproduit, sans le savoir, des signes symboliques extrêmement anciens […]. Par exemple les mandalas ou cercles magiques ornés de croix et de serpents."
                                            },
                                            {
                                                "example_id": "23231fef-26dc-4bb8-a54c-c653ea601d10",
                                                "sense_id": "954bb8f3-1547-3feb-b75b-77ab90395718",
                                                "text": "Des mandalas à colorier sont parfois utilisés pour leur vertu thérapeutique, pour lutter contre la dépression par exemple. Cette activité favorise en particulier la méditation et une paix intérieure."
                                            },
                                            {
                                                "example_id": "b4279030-4bf9-4103-8ac7-d3ba9f306610",
                                                "sense_id": "954bb8f3-1547-3feb-b75b-77ab90395718",
                                                "text": "Mais elle aime aussi colorier des mandalas, ces motifs en forme de cercles, organisés en figures multiples autour d'un centre et dont les vertus apaisantes sont largement vantées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9069e92-924c-3d62-9b78-eb5791ceb201",
                                        "entry_id": "3a252d02-48ef-3218-ab9a-a1c257829638",
                                        "glosses": [
                                            "Chapitre du Rig-Véda."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24b5a8d2-6b27-4e72-b8ce-5a8245d26ee4",
                                                "sense_id": "d9069e92-924c-3d62-9b78-eb5791ceb201",
                                                "text": "Un mandala tout entier, le troisième, est rempli des hymnes attribuées à Viçvâmitra et à sa famille, tandis que le septième est plein des hymnes de Vasishtha et de ses descendants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fabe765b-3d32-46b7-a304-08d9d35ee773",
                        "source_entry_id": "917a740c-7de0-35b7-93db-31ccb8dcfc5c",
                        "source_sense_id": "84b426e2-d0c4-3ba6-827b-2a3d22238652",
                        "source_sense_description": "kreisförmiges oder quadratisches symbolisches Gebilde mit einem Zentrum zur Anregung der Meditation",
                        "target_lang_word": "mandala",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mandala",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0d62ba11-7d84-3b9d-90b9-097b0f548203",
                                        "entry_id": "9516fb6f-aa2f-30d8-8658-394bc71d62b2",
                                        "glosses": [
                                            "een plan, kaart of geometrisch patroon dat metafysisch of symbolisch de kosmos uitbeeldt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e26ed2a0-3406-4e25-80b9-f209ca1c3745",
                                                "sense_id": "0d62ba11-7d84-3b9d-90b9-097b0f548203",
                                                "text": "Vanuit Oostenrijk zijn ze naar Enschede gekomen. Om geld in te zamelen voor hun Indiase klooster en om de cultuur en historie van de Tibetanen te verbreiden. Ze stralen een en al rust uit. Met uiterste concentratie creëren ze dezer dagen tussen studie en gebed door hun mandala. Een kleurrijke schildering op een blauwe vierkante plaat van 2,5 bij 2,5 meter."
                                            },
                                            {
                                                "example_id": "6530b1d6-bf78-47d8-bbf9-5f6166f49fec",
                                                "sense_id": "0d62ba11-7d84-3b9d-90b9-097b0f548203",
                                                "text": "De Eibergse kunstenaar werkt als tekentherapeut en geeft cursussen mandala tekenen."
                                            },
                                            {
                                                "example_id": "b6498f59-08fb-4a68-a926-0ebcfe319565",
                                                "sense_id": "0d62ba11-7d84-3b9d-90b9-097b0f548203",
                                                "text": "Een paar jaar geleden ontdekte ik tot mijn schrik dat de hele hobbyboekenkast van mijn boekwinkel was opgeofferd aan dé hit van dat moment: het kleurboek voor volwassenen. Van mandala’s en ansichtkaarten tot intrigerende doedels en spirituele – daar is-ie weer! – boeddha’s en alles daar tussenin. En kleurpotloden en stiften en etuitjes en god weet wat nog meer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
