                                "example_id": "f0afc5ef-9a42-4855-ac24-cb8fade8e885",
                                "sense_id": "2240524b-81c2-3249-bdd1-56c241f87c0d",
                                "text": "The outlandishness of the capers in this first season might surprise viewers who remember “Hawaii Five-0” as “Dragnet” with lehua blossoms."
                            },
                            {
                                "example_id": "b586d9bd-f472-4448-9cb5-2f949f434a8c",
                                "sense_id": "2240524b-81c2-3249-bdd1-56c241f87c0d",
                                "text": "After breakfast, she looked forward to the bouquet of red lehua blossoms and other flowers brought to her every day."
                            },
                            {
                                "example_id": "6e01a1dd-0b65-454d-aeed-0bc06bcff22d",
                                "sense_id": "2240524b-81c2-3249-bdd1-56c241f87c0d",
                                "text": "Here were the three tents overshadowed by the great lehuas, still brilliant with their cardinal blossoms."
                            }
