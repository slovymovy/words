                "senses": [
                    {
                        "sense_id": "a35ac855-af53-31e7-8f6c-9b38435485ca",
                        "entry_id": "639cbbea-fdf4-3422-818f-6d4645a914b4",
                        "glosses": [
                            "ein in Europa lebender Schwanzlurch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1878185a-b045-4a05-8792-8e272aa239d4",
                                "sense_id": "a35ac855-af53-31e7-8f6c-9b38435485ca",
                                "text": "„Doch mit der Herrlichkeit ist es jetzt vorbei, der Bergmolch muss ausziehen.“"
                            },
                            {
                                "example_id": "7af2a391-2cd8-4aa8-b165-8eb5023bcbfc",
                                "sense_id": "a35ac855-af53-31e7-8f6c-9b38435485ca",
                                "text": "„Der Bergmolch oder Alpenmolch gehört zu den Salamandern, hat aber einen seitlich abgeflachten Schwanz.“"
                            },
                            {
                                "example_id": "3947abf2-5433-4a93-b2ae-bd0bcd767905",
                                "sense_id": "a35ac855-af53-31e7-8f6c-9b38435485ca",
                                "text": "„Einmal sah ich dort, wie eine Forelle einen adulten Bergmolch ohne Schwierigkeiten glatt verschluckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
