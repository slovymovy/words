                                "target_senses": [
                                    {
                                        "sense_id": "5fbc661b-e3af-38ef-83fa-0bbb29ff6b87",
                                        "entry_id": "6ae75c34-22d4-3fe1-b3ec-dd97708e7385",
                                        "glosses": [
                                            "rechter Nebenfluss der Rhône in Ostfrankreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
