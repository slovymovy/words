                    },
                    {
                        "translation_id": "72b792dc-db5d-407c-acae-18a624a1ad44",
                        "source_entry_id": "b6294e47-2ea8-31d9-bb43-53db51d5cfb2",
                        "target_lang_word": "ecological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ecological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88b122d2-943e-3c88-8064-c884e10b19f7",
                                        "entry_id": "f78b03e7-8d04-3709-921f-e68e5f058c43",
                                        "glosses": [
                                            "Relating to ecology, the interrelationships of organisms and their environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea8fcfc-d5e2-4697-8fc4-e6b6626cfb26",
                                                "sense_id": "88b122d2-943e-3c88-8064-c884e10b19f7",
                                                "text": "Bats host many high-profile viruses that can infect humans, including severe acute respiratory syndrome and Ebola. A recent study explored the ecological variables that may contribute to bats’ propensity to harbor such zoonotic diseases by comparing them with another order of common reservoir hosts: rodents."
                                            },
                                            {
                                                "example_id": "cbeb536d-ae5b-451a-b584-e7f9f8d9a80f",
                                                "sense_id": "88b122d2-943e-3c88-8064-c884e10b19f7",
                                                "text": "To get doomier still, there’s also the pertinent question of whether, given current ecological speculation, the human race will even survive beyond the next century or so – an uncertainty which makes applying one’s imagination to a 22nd or 23rd Century rather academic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe0d937-96d9-3fa6-9503-668b24c314fd",
                                        "entry_id": "f78b03e7-8d04-3709-921f-e68e5f058c43",
                                        "glosses": [
                                            "Not harmful to the environment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3f630fb-3cd1-46a1-8d5a-8bf0fac3d18c",
                        "source_entry_id": "b6294e47-2ea8-31d9-bb43-53db51d5cfb2",
                        "target_lang_word": "écologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a4421a3-51ab-3f87-9476-cbadb829dd27",
                                        "entry_id": "ec88d0d5-9411-3e51-b9c2-8bef72337156",
                                        "glosses": [
                                            "Qui concerne l’écologie ou qui appartient à cette discipline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ea930ee-86c3-4a84-a08f-cc2081ea9fe5",
                                                "sense_id": "7a4421a3-51ab-3f87-9476-cbadb829dd27",
                                                "text": "Dès lors, l’association à Limnanthemum s’appauvrit au profit d’Hélophytes pourvues d’organes de multiplication végétative […] et de certaines espèces amphibies […] dont la plasticité écologique s’accommode des conditions nouvelles."
                                            },
                                            {
                                                "example_id": "85ad8dd6-9bea-4864-a4c6-7a54c8e0639c",
                                                "sense_id": "7a4421a3-51ab-3f87-9476-cbadb829dd27",
                                                "text": "La Grande-Bretagne, qui s’est isolée tout récemment, et a des conditions écologiques relativement uniformes, a un endémisme presque nul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c3a6895-9138-3029-9734-38af92d26060",
                                        "entry_id": "ec88d0d5-9411-3e51-b9c2-8bef72337156",
                                        "glosses": [
                                            "Qui concerne l’environnement naturel ; environnemental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d8e80ca-d247-43c2-89bd-fb66d0e83a8c",
                                                "sense_id": "1c3a6895-9138-3029-9734-38af92d26060",
                                                "text": "La mondialisation concrète, c’est d’abord une forme nouvelle du règne agressif de la marchandise et de l’argent, qui mène le monde à de profondes impasses économiques, sociales, écologiques et politiques."
                                            },
                                            {
                                                "example_id": "39e9d9db-35c0-4ce6-9aac-a74f635294f0",
                                                "sense_id": "1c3a6895-9138-3029-9734-38af92d26060",
                                                "text": "Cette marée noire est une véritable catastrophe écologique pour la faune de cette région."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e415dc99-a9cb-3ac0-a076-bf298986a2e3",
                                        "entry_id": "ec88d0d5-9411-3e51-b9c2-8bef72337156",
                                        "glosses": [
                                            "Qui est respectueux de l’environnement, qui ne lui nuit pas."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "624d0c7f-85f7-40d3-a6e7-4ad23fc3c5e8",
                                                "sense_id": "e415dc99-a9cb-3ac0-a076-bf298986a2e3",
                                                "text": "Ce que vous faites là n’est pas très écologique !"
                                            },
                                            {
                                                "example_id": "e8f77379-e54d-4733-9425-66da32b08842",
                                                "sense_id": "e415dc99-a9cb-3ac0-a076-bf298986a2e3",
                                                "text": "Les constructeurs automobiles tentent de développer des véhicules écologiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
