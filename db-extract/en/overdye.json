                    {
                        "sense_id": "e255b7bc-811e-3d74-a66f-f3f65cb1ba56",
                        "entry_id": "938b1ebf-01b5-39ed-8790-2df30d0d3c97",
                        "glosses": [
                            "To dye (something already coloured) with another colour."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "92381b3a-a3ec-427a-8fd5-3184fb245349",
                                "sense_id": "e255b7bc-811e-3d74-a66f-f3f65cb1ba56",
                                "text": "To last more than a few days in the sunshine, the crushed logwood needed to be over-dyed on woad- or indigo-coloured fabric."
                            },
                            {
                                "example_id": "95b0d1fe-83c8-4d9a-b7d4-b6c319964739",
                                "sense_id": "e255b7bc-811e-3d74-a66f-f3f65cb1ba56",
                                "text": "There was a sweater dress in almost the same shade of blue as one shown at Doo.Ri; overdyed plaid shirts with contrasting plaid cuffs and collars for men like those at Duckie Brown; and lots of chunky knit gray cardigans like the ones popping up all over the place — just not at the same prices."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2f4bf23-602f-3c0e-8dd5-d26f0e85d376",
                        "entry_id": "938b1ebf-01b5-39ed-8790-2df30d0d3c97",
                        "glosses": [
                            "To dye too much."
