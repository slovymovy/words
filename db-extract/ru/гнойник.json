                        "source_entry_id": "28ef27bd-4651-3dfd-a133-b621843419ef",
                        "source_sense_id": "d68423b2-8137-3b86-b2af-98bbe30681b0",
                        "target_lang_word": "abcès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abcès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c52d7b1-4800-39b5-bb39-d1843490f168",
                                        "entry_id": "0a381d58-33ed-33e5-99c7-f64cc83b9966",
                                        "glosses": [
                                            "Poche de pus dans une cavité formée aux dépens des tissus environnants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eea8d3c-0688-48e7-af84-e0ab4bb3564c",
                                                "sense_id": "5c52d7b1-4800-39b5-bb39-d1843490f168",
                                                "text": "Pour guérir le dernier-né de la Reine, qui souffrait d'un abcès à la gorge et qu’Hadès semblait encore une fois attirer dans ses ténèbres, le médecin Olympos avait jugé qu'il fallait prendre les grands moyens : une incubation, et à Canope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce92304e-f582-367d-a2c4-fe4ba8733ce0",
                                        "entry_id": "0a381d58-33ed-33e5-99c7-f64cc83b9966",
                                        "glosses": [
                                            "Amas d'urine et de matière stercorale"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dbf3353-3e89-31e3-9f8c-771413eecc21",
                                        "entry_id": "0a381d58-33ed-33e5-99c7-f64cc83b9966",
                                        "glosses": [
                                            "Endroit où l'on laisse se cristalliser une situation mauvaise pour éviter son extension."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f3f1dd9-7939-4c44-861b-2945640359c7",
                                                "sense_id": "9dbf3353-3e89-31e3-9f8c-771413eecc21",
                                                "text": "Les abcès peuvent affecter tous les animaux. Ils se développent généralement sur la peau à la faveur d’une lésion mais ils peuvent être dus à une maladie et se développer sous la peau ou dans les tissus profonds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
