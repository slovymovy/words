                        "sense_id": "be0fbf5e-bbdf-356b-b5e8-7a6d951c7a1f",
                        "entry_id": "588c6d9b-e11e-3ce4-a0a0-c48636503777",
                        "glosses": [
                            "Synonym für Deutsches Eck in Koblenz"
