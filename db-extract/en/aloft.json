                        "entry_id": "adc333fb-bde3-3cf2-a9b6-19acaf612628",
                        "glosses": [
                            "At, to, or in the air or sky."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8f297f-94a0-4eb8-8284-16067fab060f",
                                "sense_id": "f75b1285-c38d-3049-93bb-b8d196ab73a2",
                                "text": "high winds aloft"
                            }
                        ]
                    },
                    {
                        "sense_id": "2d92a34e-1633-314e-a849-becb77810bbc",
                        "entry_id": "adc333fb-bde3-3cf2-a9b6-19acaf612628",
                        "glosses": [
                            "Above, overhead, in a high place; up."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c324801d-8e80-49fa-85d9-1f0165d0e509",
                                "sense_id": "2d92a34e-1633-314e-a849-becb77810bbc",
                                "text": "Someone's turned the chest out alow and aloft."
                            },
                            {
                                "example_id": "0f7591da-dece-48d7-8793-184844dc7928",
                                "sense_id": "2d92a34e-1633-314e-a849-becb77810bbc",
                                "text": "He noticed that he still held the knife aloft and brought his arm down, replacing the blade in the sheath."
                            },
                            {
                                "example_id": "657553a0-99e9-46ba-b609-d0e005c12839",
                                "sense_id": "2d92a34e-1633-314e-a849-becb77810bbc",
                                "text": "Lewis Cook held the trophy aloft after becoming the first England captain to lead his country to victory in a major global final since Sir Bobby Moore. A white sea of confetti slowly filled the pitch, with each England player taking hold of the trophy on the stage swiftly erected in Suwon to kick-start the celebrations."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a6b155c-da71-3423-a376-6039496ab8dd",
                        "entry_id": "adc333fb-bde3-3cf2-a9b6-19acaf612628",
                        "glosses": [
                            "In the top, at the masthead, or on the higher yards or rigging."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda71975-42b4-44a8-adfc-88b46d6c8409",
                                "sense_id": "2a6b155c-da71-3423-a376-6039496ab8dd",
                                "text": "I think you said something concerning the manner in which yonder ship has anchored, and of the condition they keep things alow and aloft?"
                            }
                        ]
                    }
                ],
