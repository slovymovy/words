                "senses": [
                    {
                        "sense_id": "217acbca-0f0d-3ae0-8e4f-cfadca2d71d3",
                        "entry_id": "a818b44c-1f35-3c9a-82e7-1aa506e9905b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "371a6acc-9f4e-4489-8142-3b84207ec73e",
                                "sense_id": "217acbca-0f0d-3ae0-8e4f-cfadca2d71d3",
                                "text": "Frau Schirmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "53c5b304-393f-4249-846e-9af64830b86e",
                                "sense_id": "217acbca-0f0d-3ae0-8e4f-cfadca2d71d3",
                                "text": "Herr Schirmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f1aef622-ba9e-4a6e-abbe-51ea6d70b756",
                                "sense_id": "217acbca-0f0d-3ae0-8e4f-cfadca2d71d3",
                                "text": "Die Schirmanns fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "9f5904a5-9727-41f8-bc8a-f1231d0cc6a4",
                                "sense_id": "217acbca-0f0d-3ae0-8e4f-cfadca2d71d3",
                                "text": "Der Schirmann trägt nie die Pullover, die die Schirmann ihm strickt."
                            },
                            {
                                "example_id": "447f8abe-86a8-4570-aca0-9a2236df1810",
                                "sense_id": "217acbca-0f0d-3ae0-8e4f-cfadca2d71d3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schirmann kommt, geht der Herr Schirmann.“"
                            },
                            {
                                "example_id": "067aef00-1f2a-4127-b3a7-573ed674ee97",
                                "sense_id": "217acbca-0f0d-3ae0-8e4f-cfadca2d71d3",
                                "text": "Schirmann kommt und geht."
                            },
                            {
                                "example_id": "e6d4d3e4-ccf8-46e6-a7c1-ca8228522a66",
                                "sense_id": "217acbca-0f0d-3ae0-8e4f-cfadca2d71d3",
                                "text": "Schirmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
