                "senses": [
                    {
                        "sense_id": "f82eb144-b71a-39aa-b04c-e86fd14f88c6",
                        "entry_id": "a86c5d4c-d1b0-3e89-87fb-5abff03e6abe",
                        "glosses": [
                            "Substance chimique, de formule chimique C₆H₁₂O₃N₂, qui contrôle la croissance de la plante, surtout en floriculture."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "e43a5fde-b6a7-42d9-baa3-072d7e660afb",
                                "sense_id": "f82eb144-b71a-39aa-b04c-e86fd14f88c6",
                                "text": "Lorsque le daminozide est administré par voie orale, il est rapidement excrété par les rats et le porc de Guinée."
                            },
                            {
                                "example_id": "6a77e019-e173-4015-912f-1ae981777c3c",
                                "sense_id": "f82eb144-b71a-39aa-b04c-e86fd14f88c6",
                                "text": "La lutte est en revanche intensifiée contre l’utilisation de certains produits non agréés (entre autres daminozide et chlorméquat dans les pommes)."
                            },
                            {
                                "example_id": "fc14548d-a5a7-4e8a-b36a-ea3476c4283b",
                                "sense_id": "f82eb144-b71a-39aa-b04c-e86fd14f88c6",
                                "text": "Le contenu en sucres augmente avec un traitement avec des substances auxiniques sur les solanacées, avec l’aide giberellique (GA 3) sur les tomates, avec le chlormequat sur les piments et les fraises, avec les daminozides sur la carotte, les piments, les concombres."
                            }
                        ]
                    }
