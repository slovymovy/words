                ],
                "senses": [
                    {
                        "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                        "entry_id": "3a76cf1a-5146-325f-80f0-3a8730403c26",
                        "glosses": [
                            "Lauf, bei dem eine Person unter Überwindung von Hindernissen eine festgelegte Strecke laufen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad9bf155-612a-4ef5-b694-e59fec9b4475",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "[Moses Kiptanui:] „Bekannt wurde er für seine Erfolge im Hindernislauf über 3000 Meter.“"
                            },
                            {
                                "example_id": "884702e4-25e2-499f-a3e5-666ad310066f",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "„Maorikinder steigen gern auf knorrige Äste des Manukabaumes und machen Wettrennen oder Hindernisläufe.“"
                            },
                            {
                                "example_id": "c2d43aed-2c9b-4a65-9198-b3ffb79c97ca",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "[Mud Masters in Wassertrüdingen:] „Nach der erfolgreichen Premiere im Vorjahr lockte der Hindernislauf erneut mehrere Tausend Sport- und Schlammwillige in die rund 6.000-Einwohner-Stadt im Landkreis Ansbach.“"
                            },
                            {
                                "example_id": "5e9b657c-77dc-46d4-86c2-39d58315c446",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "„Die Idee für den Hindernislauf im Matsch komme aus dem Militär, heißt es von den Organisatoren.“"
                            },
                            {
                                "example_id": "e0227f59-de62-44ba-bcef-5449d02a1540",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "„Schlechte Nachrichten für alle Fans des Braveheart Battle: Der Hindernislauf in Bischofsheim wird am 10. März definitiv nicht stattfinden.“"
                            },
                            {
                                "example_id": "55e29e2b-0972-4287-8370-533c127c8102",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "„Bei diesem Hindernislauf bleibt die Laufkleidung nicht sauber.“"
                            },
                            {
                                "example_id": "269ababe-f366-4260-a466-806eeae7ee18",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "„Beim extremen Hindernislauf Strongman-Run geht es über Autoreifen, durch den Schlamm und ins eiskalte Wasser. Untrainierte scheitern kläglich.“"
                            },
                            {
                                "example_id": "1c6bc656-58aa-44aa-9169-cd1dcc7be155",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "[Spartan Race/Sydney:] „Bei der Mischung aus Hindernislauf, militärischer Grundausbildung und \"American Gladiators\" darf jeder ungeniert das Urvieh in sich rauslassen.“"
                            },
                            {
                                "example_id": "a40e80de-95d3-4157-ac1d-bc38c4fc3b1a",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "„Fechten, Schwimmen, Laser-Run und nun der Hindernislauf – so setzt sich der neue Moderne Fünfkampf zusammen.“"
                            },
                            {
                                "example_id": "4ec0867e-ac4b-43fe-b151-dc769cab8122",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "[Moderner Fünfkampf:] „Der Weltverband selbst schlug einen „obstacle run“ vor, ein Hindernislauf, den man auch aus militärischen Läufen kennt.“"
                            },
                            {
                                "example_id": "2444b7b5-9dfd-4c75-a81e-d06333a382c9",
                                "sense_id": "abca32e7-7c2e-3c6c-9e13-8464ae6b4acd",
                                "text": "[Moderner Fünfkampf:] „Das Internationale Olympische Komittee IOC hatte selbst nicht gefordert, dass ein Hindernislauf das Springreiten ersetzen muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea599725-2334-386f-b018-8ed8eaf91d32",
                        "entry_id": "3a76cf1a-5146-325f-80f0-3a8730403c26",
                        "glosses": [
                            "mit (großen) Schwierigkeiten behafteter Prozess"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d1afe1fa-e62b-4843-bf85-c5f5338e13d6",
                                "sense_id": "ea599725-2334-386f-b018-8ed8eaf91d32",
                                "text": "„Einbürgerungen in Deutschland geht oftmals ein langjähriger Hindernislauf voraus“"
                            },
                            {
                                "example_id": "87689dbf-c177-48e3-a937-2f680342c357",
                                "sense_id": "ea599725-2334-386f-b018-8ed8eaf91d32",
                                "text": "„In seinem Roman „Eine Formalie in Kiew“ erzählt er vom bürokratischen Hindernislauf, der nötig wird, um einen deutschen Pass zu erhalten.“"
                            },
                            {
                                "example_id": "205e6bc9-0a25-43a7-bb68-54da382e44e7",
                                "sense_id": "ea599725-2334-386f-b018-8ed8eaf91d32",
                                "text": "„Von den Referenten ausgearbeitete Vorlagen, die den behördeninternen Hindernislauf überstanden haben, werden von der politischen Leitung der Ministerien lediglich im Hinblick auf ihre Vorgaben überprüft, doch eine Auswahl unter Alternativen erfolgt selten.“"
                            },
                            {
                                "example_id": "345ba012-7b48-4030-911e-a965268b563a",
                                "sense_id": "ea599725-2334-386f-b018-8ed8eaf91d32",
                                "text": "[Schlagzeile:] „Gefühlt illegal – Abtreibung als Hindernislauf“"
                            },
                            {
                                "example_id": "febcb100-bd87-4d71-ac53-69d04054a0d6",
                                "sense_id": "ea599725-2334-386f-b018-8ed8eaf91d32",
                                "text": "„Doch wenn wir weitere Verspätungen und Rückschritte im Hindernislauf weiblicher Emanzipationsbewegungen vermeiden wollen, sollten wir speziell in Deutschland dem Geschichts- und Gedächtnisverlust entgegenwirken, aber auch das bereits erworbene Wissen und die Einsichten in die gesellschaftliche Zusammenhänge und das wechselseitige aufeinander Angewiesensein bewahren.“"
                            },
                            {
                                "example_id": "c9085345-76af-42c1-bd47-8709cc15e688",
                                "sense_id": "ea599725-2334-386f-b018-8ed8eaf91d32",
                                "text": "„Auch die Suche nach dem passenden Restaurant zur Mittagsstärkung gleicht einem Hindernislauf. Es muss vegetarische, vegane, laktosefreie Kost anbieten, die zudem auf naturidentische Aromastoffe verzichtet.“"
                            },
                            {
                                "example_id": "b555b711-9b2a-4321-bf3a-75558c3f3906",
                                "sense_id": "ea599725-2334-386f-b018-8ed8eaf91d32",
                                "text": "„Vor Hochzeit, Taufe und Beerdigung nicht erst bürokratischer Hindernislauf – […] »Wir sind für euch da und wir sind für euch so da, dass ihr nicht erst mal einen Hindernislauf machen müsst.«“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
