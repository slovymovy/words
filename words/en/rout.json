{
    "word_family": [
        "router",
        "routing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04a8d1cd-cec0-351b-9ab7-d9b2d34f0406",
                    "sense_definition": "A decisive and overwhelming defeat of an opponent in a battle, game, or competition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rout</w> of the enemy army was complete after the surprise attack.",
                            "target_lang_translations": {
                                "ru": "<w>Разгром</w> вражеской армии был полным после внезапной атаки."
                            }
                        },
                        {
                            "text": "The home team suffered a humiliating <w>rout</w> in the championship final.",
                            "target_lang_translations": {
                                "ru": "Хозяева поля потерпели унизительный <w>разгром</w> в финале чемпионата."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Решительное и полное поражение противника в битве, игре или соревновании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгром",
                                "target_lang_sense_clarification": "полное поражение, уничтожение сил противника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b150990a-3615-3c33-aff4-327771977085",
                    "sense_definition": "A large, fashionable evening party or social gathering.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duchess hosted one of the most elegant <w>routs</w> of the season.",
                            "target_lang_translations": {
                                "ru": "Герцогиня устроила один из самых элегантных <w>раутов</w> сезона."
                            }
                        },
                        {
                            "text": "He felt uncomfortable attending such formal <w>routs</w> among the aristocracy.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя неловко, посещая такие официальные <w>рауты</w> среди аристократии."
                            }
                        }
                    ],
                    "synonyms": [
                        "company",
                        "gathering"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to 18th and 19th-century social customs."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой, модный вечерний прием или светское собрание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раут",
                                "target_lang_sense_clarification": "торжественный светский прием"
                            },
                            {
                                "target_lang_word": "светский прием",
                                "target_lang_sense_clarification": "официальное или торжественное собрание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52d8b316-34de-3fce-9a69-d5bd5c260f7f",
                    "sense_definition": "A type of small goose, specifically the brant goose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rout</w> migrates long distances to reach its northern breeding grounds.",
                            "target_lang_translations": {
                                "ru": "<w>Черная казарка</w> мигрирует на большие расстояния, чтобы добраться до своих северных мест гнездования."
                            }
                        },
                        {
                            "text": "Birdwatchers gathered at the coast to spot the rare <w>rout</w>.",
                            "target_lang_translations": {
                                "ru": "Орнитологи собрались на побережье, чтобы увидеть редкую <w>черную казарку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "brant goose",
                        "road-goose",
                        "rood goose",
                        "rot-goose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид небольшого гуся, в частности черная казарка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черная казарка",
                                "target_lang_sense_clarification": "вид водоплавающей птицы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20ae0a15-b1f2-3e08-8309-84a76bdda3c6",
                    "sense_definition": "To defeat an opponent completely and force them to retreat in disorder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general managed to <w>rout</w> the opposing forces in a single day.",
                            "target_lang_translations": {
                                "ru": "Генералу удалось <w>разгромить</w> силы противника за один день."
                            }
                        },
                        {
                            "text": "Our team managed to <w>rout</w> their rivals in the second half of the game.",
                            "target_lang_translations": {
                                "ru": "Наша команда сумела <w>разгромить</w> соперников во второй половине игры."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью победить противника и заставить его отступить в беспорядке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "нанести сокрушительное поражение"
                            },
                            {
                                "target_lang_word": "разбить наголову",
                                "target_lang_sense_clarification": "полностью уничтожить силы противника"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ce39068-721c-3b51-ac66-2a6d99cf173b",
                    "sense_definition": "To force someone to leave a place, especially to get out of bed.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "force_out",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The alarm clock managed to <w>rout</w> him out of bed at dawn.",
                            "target_lang_translations": {
                                "ru": "Будильник сумел <w>поднять</w> его с постели на рассвете."
                            }
                        },
                        {
                            "text": "She had to <w>rout</w> the teenagers out of the living room to clean up.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>выгнать</w> подростков из гостиной, чтобы сделать уборку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rout out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо покинуть место, особенно выгнать из постели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгнать",
                                "target_lang_sense_clarification": "заставить уйти"
                            },
                            {
                                "target_lang_word": "поднять",
                                "target_lang_sense_clarification": "заставить встать с постели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "814ea0f6-d8cd-34d2-873b-bb89af9e6ad3",
                    "sense_definition": "To search through belongings or a place in a disorganized way.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "search",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to <w>rout</w> through all the boxes to find my old passport.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>перерыть</w> все коробки, чтобы найти свой старый паспорт."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>routing</w> through the attic for his childhood toys.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день, <w>рывшись</w> на чердаке в поисках своих детских игрушек."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искать что-либо среди вещей или в каком-то месте беспорядочно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыться",
                                "target_lang_sense_clarification": "искать, перебирая вещи"
                            },
                            {
                                "target_lang_word": "перерыть",
                                "target_lang_sense_clarification": "тщательно искать, перебирая все содержимое"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}