{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c8b7d82-f401-3342-ba9b-70c252463533",
                    "sense_definition": "To send an email or other electronic message to someone, often to get their attention or a quick response.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "communication_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>ping</w> me when you arrive at the station so I can pick you up.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>напиши</w> мне, когда приедешь на станцию, чтобы я мог тебя забрать.",
                                "zh": "你到车站时请<w>发消息</w>给我，这样我好去接你。"
                            }
                        },
                        {
                            "text": "I will <w>ping</w> the team to remind them about the deadline.",
                            "target_lang_translations": {
                                "ru": "Я <w>напишу</w> команде, чтобы напомнить им о дедлайне.",
                                "zh": "我会<w>联系</w>团队提醒他们截止日期。"
                            }
                        }
                    ],
                    "synonyms": [
                        "message",
                        "contact",
                        "email",
                        "text"
                    ],
                    "common_phrases": [
                        "ping me",
                        "ping you later"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in business and technology contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить короткое электронное сообщение кому-либо, часто чтобы привлечь внимание или получить быстрый ответ.",
                        "zh": "向某人发送电子邮件或其他电子消息，通常是为了引起注意或获得快速回复。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "написать",
                                "target_lang_sense_clarification": "отправить сообщение"
                            },
                            {
                                "target_lang_word": "пингануть",
                                "target_lang_sense_clarification": "сленг: быстро связаться"
                            },
                            {
                                "target_lang_word": "маякнуть",
                                "target_lang_sense_clarification": "разговорное: дать знать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发消息",
                                "target_lang_sense_clarification": "发送简短信息"
                            },
                            {
                                "target_lang_word": "联系",
                                "target_lang_sense_clarification": "与某人取得联系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a3a42b0-a9f5-33b6-a368-f9c42163e721",
                    "sense_definition": "To make a short, high-pitched, metallic sound.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The microwave <w>pinged</w> to let us know that dinner was ready.",
                            "target_lang_translations": {
                                "ru": "Микроволновка <w>дзынькнула</w>, давая знать, что ужин готов.",
                                "zh": "微波炉<w>叮</w>的一声，提示晚餐准备好了。"
                            }
                        },
                        {
                            "text": "Small stones <w>pinged</w> against the metal roof during the storm.",
                            "target_lang_translations": {
                                "ru": "Мелкие камни <w>звякали</w> о металлическую крышу во время шторма.",
                                "zh": "暴风雨中，小石子<w>叮当</w>地敲打在金属屋顶上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clink",
                        "ding",
                        "ring"
                    ],
                    "common_phrases": [
                        "ping loudly",
                        "ping off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать короткий, высокий металлический звук.",
                        "zh": "发出短促、尖锐的金属声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звякнуть",
                                "target_lang_sense_clarification": "издать короткий звонкий звук"
                            },
                            {
                                "target_lang_word": "дзынькнуть",
                                "target_lang_sense_clarification": "звукоподражание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叮当响",
                                "target_lang_sense_clarification": "发出金属碰撞声"
                            },
                            {
                                "target_lang_word": "发出叮的一声",
                                "target_lang_sense_clarification": "模拟电子设备提示音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "337d1c3c-b94e-365b-bfd2-2d192cc08143",
                    "sense_definition": "To send a network signal to a computer or server to check if it is reachable and active.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "network_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician tried to <w>ping</w> the server to test the connection.",
                            "target_lang_translations": {
                                "ru": "Техник попытался <w>пропинговать</w> сервер, чтобы проверить соединение.",
                                "zh": "技术员尝试<w>ping</w>服务器以测试连接。"
                            }
                        },
                        {
                            "text": "If you cannot <w>ping</w> the website, your internet might be down.",
                            "target_lang_translations": {
                                "ru": "Если вы не можете <w>пропинговать</w> веб-сайт, возможно, у вас не работает интернет.",
                                "zh": "如果你无法<w>ping</w>通该网站，可能是你的网络断了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ping the server",
                        "ping an IP"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context (computing)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить сетевой сигнал на компьютер или сервер для проверки его доступности.",
                        "zh": "向计算机或服务器发送网络信号，以检查其是否可达且处于活动状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пинговать",
                                "target_lang_sense_clarification": "проверять доступность узла сети"
                            },
                            {
                                "target_lang_word": "проверить связь",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "ping",
                                "target_lang_sense_clarification": "计算机术语，测试网络连通性"
                            },
                            {
                                "target_lang_word": "测试连接",
                                "target_lang_sense_clarification": "检查网络是否通畅"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f664d55c-b0b6-3d48-9a13-de04e9753494",
                    "sense_definition": "To emit a sound signal and listen for its echo to detect objects underwater.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sonar_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The submarine <w>pinged</w> the water to locate nearby vessels.",
                            "target_lang_translations": {
                                "ru": "Подводная лодка <w>посылала импульсы</w> в воду, чтобы обнаружить ближайшие суда.",
                                "zh": "潜艇向水中<w>发射声呐脉冲</w>以定位附近的船只。"
                            }
                        },
                        {
                            "text": "They <w>pinged</w> the ocean floor to map the terrain.",
                            "target_lang_translations": {
                                "ru": "Они <w>сканировали</w> дно океана, чтобы составить карту рельефа.",
                                "zh": "他们对海底进行<w>探测</w>以绘制地形图。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context (nautical/sonar)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Излучать звуковой сигнал и слушать эхо для обнаружения объектов под водой.",
                        "zh": "发出声音信号并监听回声，以探测水下物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посылать импульс",
                                "target_lang_sense_clarification": "гидролокация"
                            },
                            {
                                "target_lang_word": "зондировать",
                                "target_lang_sense_clarification": "исследовать с помощью приборов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发射声呐脉冲",
                                "target_lang_sense_clarification": "水下探测"
                            },
                            {
                                "target_lang_word": "探测",
                                "target_lang_sense_clarification": "使用仪器进行搜索"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0481475-670a-3947-a31c-1b40733abf41",
                    "sense_definition": "To flick something with a finger, causing it to move quickly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pinged</w> the rubber band across the classroom.",
                            "target_lang_translations": {
                                "ru": "Он <w>запустил</w> резинку через весь класс.",
                                "zh": "他把橡皮筋<w>弹</w>到了教室对面。"
                            }
                        },
                        {
                            "text": "She <w>pinged</w> a crumb off the table.",
                            "target_lang_translations": {
                                "ru": "Она <w>сщелкнула</w> крошку со стола.",
                                "zh": "她用手指把桌上的面包屑<w>弹</w>掉了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flick",
                        "snap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Щелкнуть по чему-либо пальцем, заставляя предмет быстро отлететь.",
                        "zh": "用手指弹某物，使其快速移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щелкнуть",
                                "target_lang_sense_clarification": "резко ударить пальцем"
                            },
                            {
                                "target_lang_word": "запустить щелчком",
                                "target_lang_sense_clarification": "отправить предмет в полет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弹",
                                "target_lang_sense_clarification": "用手指拨动"
                            },
                            {
                                "target_lang_word": "弹射",
                                "target_lang_sense_clarification": "使物体飞出"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2198487-71ad-35de-90d6-40ae751c41f0",
                    "sense_definition": "A short, high-pitched, somewhat sharp sound, like metal being struck.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We heard a loud <w>ping</w> from the engine before the car stopped.",
                            "target_lang_translations": {
                                "ru": "Мы услышали громкий <w>звон</w> из двигателя, прежде чем машина остановилась.",
                                "zh": "车停下前，我们听到引擎发出了一声巨大的<w>金属撞击声</w>。"
                            }
                        },
                        {
                            "text": "The elevator arrived with a soft <w>ping</w>.",
                            "target_lang_translations": {
                                "ru": "Лифт приехал с тихим <w>звяканьем</w>.",
                                "zh": "电梯到达时发出了一声轻柔的<w>提示音</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clink",
                        "ding"
                    ],
                    "common_phrases": [
                        "loud ping",
                        "metallic ping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий, высокий, резкий звук, похожий на удар по металлу.",
                        "zh": "一种短促、尖锐、类似金属撞击的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звон",
                                "target_lang_sense_clarification": "металлический звук"
                            },
                            {
                                "target_lang_word": "звяканье",
                                "target_lang_sense_clarification": "короткий звук удара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叮当声",
                                "target_lang_sense_clarification": "金属碰撞声"
                            },
                            {
                                "target_lang_word": "提示音",
                                "target_lang_sense_clarification": "电子设备发出的短促声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e3cd0c9-e150-3735-8307-18cdc6b55ec4",
                    "sense_definition": "A brief electronic message or notification sent to someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I sent a quick <w>ping</w> to my colleague to ask for help.",
                            "target_lang_translations": {
                                "ru": "Я отправил быстрое <w>сообщение</w> коллеге с просьбой о помощи.",
                                "zh": "我给同事发了一条简短的<w>消息</w>请求帮助。"
                            }
                        },
                        {
                            "text": "Did you receive my <w>ping</w> about the meeting time?",
                            "target_lang_translations": {
                                "ru": "Ты получил мое <w>сообщение</w> о времени встречи?",
                                "zh": "你收到我关于会议时间的<w>通知</w>了吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "message",
                        "notification"
                    ],
                    "common_phrases": [
                        "send a ping"
                    ],
                    "traits": [
