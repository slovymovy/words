                "senses": [
                    {
                        "sense_id": "fa9d429c-4b5c-33bd-8586-e42a50bdb2ef",
                        "entry_id": "3a773ee8-60ec-30a8-8a96-df847ac1c23f",
                        "glosses": [
                            "Wissenschaftlerin mit dem Forschungsschwerpunkt Politik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edbdf8db-0034-4d1d-8cc8-ebf60f565c84",
                                "sense_id": "fa9d429c-4b5c-33bd-8586-e42a50bdb2ef",
                                "text": "Als Politikwissenschaftlerin würde sie gerne in einem Forschungsinstitut arbeiten, aber derartige Stellen sind rar und setzen in der Regel Berufserfahrung voraus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b90680d3-22a7-456c-a259-9b587a53333a",
                        "source_entry_id": "3a773ee8-60ec-30a8-8a96-df847ac1c23f",
                        "source_sense_id": "fa9d429c-4b5c-33bd-8586-e42a50bdb2ef",
                        "source_sense_description": "Wissenschaftlerin mit dem Forschungsschwerpunkt Politik",
                        "target_lang_word": "politologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd33b4c-4352-386d-a31b-4a780f659143",
                                        "entry_id": "a571265e-3c4d-33d9-9448-41291a77ba33",
                                        "glosses": [
                                            "Spécialiste de la science politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf1c6166-cb3c-4e12-8407-a7d7dc17f8b7",
                                                "sense_id": "ebd33b4c-4352-386d-a31b-4a780f659143",
                                                "text": "vu les formats proposés par la plupart des médias, lorsque un politiste répond à la presse, le résultat est souvent un propos de politologue, c’est-à-dire qu’il dit (ou semble dire) des banalités, sans doute pas fausses, mais pas non plus folichonnes à lire ou à entendre."
                                            },
                                            {
                                                "example_id": "168ecd12-d343-4289-9f92-49679ccc8cc7",
                                                "sense_id": "ebd33b4c-4352-386d-a31b-4a780f659143",
                                                "text": "En remettant en tête des priorités américaines la défense des libertés mise de côté par son prédécesseur, le président Joe Biden est en train de réussir son pari de ressouder les démocraties face au défi chinois, souligne à Pékin le politologue indépendant Hua Po."
                                            },
                                            {
                                                "example_id": "48bc9506-6499-4aa9-b129-2f4ddec0d09b",
                                                "sense_id": "ebd33b4c-4352-386d-a31b-4a780f659143",
                                                "text": "Ingouvernable, en chute, voué à la décadence, voici que le vieux pays recru d’épreuves autrefois décrit par le général de Gaulle en affronte une nouvelle. Attentive au son de cloche d’un plumitif désengagé, la rédaction du Figaro Magazine veut bien solliciter l’auteur de ces lignes, non pour son inexistante expertise de politologue, mais en l’incitant à centrer son propos sur le caractère romanesque des principaux acteurs de cette tragi-comédie."
                                            },
                                            {
                                                "example_id": "5455a107-71fb-4dbd-9976-6f05fe8229fc",
                                                "sense_id": "ebd33b4c-4352-386d-a31b-4a780f659143",
                                                "text": "J’avoue que la politologue en moi s’en trouve réjouie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2b4e481-7863-41af-bacd-d90e1b834dcd",
                        "source_entry_id": "3a773ee8-60ec-30a8-8a96-df847ac1c23f",
                        "source_sense_id": "fa9d429c-4b5c-33bd-8586-e42a50bdb2ef",
                        "source_sense_description": "Wissenschaftlerin mit dem Forschungsschwerpunkt Politik",
                        "target_lang_word": "politiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7609cae6-b172-34ab-af42-2ff93c1bdc31",
                                        "entry_id": "b99ac653-2e08-319c-b36c-f19ea6181905",
                                        "glosses": [
                                            "Spécialiste de la science politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b73604a7-806a-487c-b823-bfa6c5b2bd53",
                                                "sense_id": "7609cae6-b172-34ab-af42-2ff93c1bdc31",
                                                "text": "vu les formats proposés par la plupart des médias, lorsque un politiste répond à la presse, le résultat est souvent un propos de politologue, c’est-à-dire qu’il dit (ou semble dire) des banalités, sans doute pas fausses, mais pas non plus folichonnes à lire ou à entendre."
                                            },
                                            {
                                                "example_id": "d34f6fcc-4c6e-44dd-951d-0a016d01804d",
                                                "sense_id": "7609cae6-b172-34ab-af42-2ff93c1bdc31",
                                                "text": "Évoquant un véritable « matraquage médiatique pour vendre la marque Macron à l'électorat », le politiste Thomas Guénolé pointe un traitement de faveur et une surmédiatisation artificielle."
                                            },
                                            {
                                                "example_id": "118443b3-c40b-44c3-a66e-b805504794ed",
                                                "sense_id": "7609cae6-b172-34ab-af42-2ff93c1bdc31",
                                                "text": "En France toutefois, le substantif « politiste » tend à être préféré à celui de « politologue ». L'usage du mot « politiste » vise à distinguer le spécialiste « authentique » de science politique, qui fait avant tout de la recherche « fondamentale », du « politologue », expert que ce soit dans l'interprétation sur le vif de l'actualité politique dans les médias (« commentateur politique ») ou dans l'élaboration de recommandations opérationnelles au monde politique (« conseiller du prince »)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
