            {
                "entry_id": "0040ee1b-8a79-391e-b7ce-b3e9126b096c",
                "word": "pagination",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2461635a-0e6c-4f4e-b427-713c4ba1a080",
                        "entry_id": "0040ee1b-8a79-391e-b7ce-b3e9126b096c",
                        "tags": [
