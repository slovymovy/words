                                        "sense_id": "4a822333-980f-3994-87ed-b1034e13f8d8",
                                        "entry_id": "5a53241a-cd5a-38fc-bf15-ac6e2f8d5daf",
                                        "glosses": [
                                            "So as to disparage or belittle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7c0ae11-8f36-496c-8dd6-430a65698451",
                                                "sense_id": "4a822333-980f-3994-87ed-b1034e13f8d8",
                                                "text": "June 18, 1827, Thomas Moore, Diary\nNever heard him speak of any one otherwise than depreciatingly, but the next moment after abusing a man, he would go any length to serve him."
                                            }
                                        ]
                                    }
                                ]
