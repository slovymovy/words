                        "examples": [
                            {
                                "example_id": "32cf0e8b-df0a-4562-8394-7327238fc4c8",
                                "sense_id": "dc447c53-bcff-34ec-ac46-92f36b6b76e4",
                                "text": "„Da beginnt man mit den Unliebsamkeiten am unteren Ende.“"
                            },
                            {
                                "example_id": "6c933cb3-35e1-4cb1-8b3b-5c0e14e68136",
                                "sense_id": "dc447c53-bcff-34ec-ac46-92f36b6b76e4",
                                "text": "„In jedem Einzelfalle bedarf es gründlichster Ingenieurarbeit, die allen solchen Möglichkeiten vorbaut, soll der Bauherr und Unternehmer nicht in Unliebsamkeiten hereingerissen werden.“"
                            },
                            {
                                "example_id": "634f1c49-67da-4f72-81cb-011e4eac6019",
                                "sense_id": "dc447c53-bcff-34ec-ac46-92f36b6b76e4",
                                "text": "„Wie wäre das, wenn Sie jeden Tag eine Unliebsamkeit weglassen würden?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
