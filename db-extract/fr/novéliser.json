                ],
                "senses": [
                    {
                        "sense_id": "920c6c9c-8111-32f1-918b-c00d8c03492a",
                        "entry_id": "72e63f73-fbd1-3546-812c-363aef5ea4f4",
                        "glosses": [
                            "Adapter pour en faire un roman."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "52447e88-d30b-482e-81a9-3bf6632d1dab",
                                "sense_id": "920c6c9c-8111-32f1-918b-c00d8c03492a",
                                "text": "On connaît aussi la tentation de novéliser, parfois de manière maladroite et sans style, des films pour en tirer de petits profits complémentaires et augmenter surtout la visibilité du titre étendue au rayon livres."
                            },
                            {
                                "example_id": "597123c1-8f03-4fe8-9ebf-ecf7746c60c9",
                                "sense_id": "920c6c9c-8111-32f1-918b-c00d8c03492a",
                                "text": "Portrait inachevé, qui paraît en 1934, est un roman qui contient beaucoup d’éléments autobiographiques, comme si Agatha avait voulu « novéliser » une partie de sa vie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1c0dc63-d8ac-49af-a328-95b1bb12ef28",
                        "source_entry_id": "72e63f73-fbd1-3546-812c-363aef5ea4f4",
                        "source_sense_id": "920c6c9c-8111-32f1-918b-c00d8c03492a",
                        "target_lang_word": "novelize",
