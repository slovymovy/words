{
    "word_family": [
        "air",
        "airiness",
        "airily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7e5b142f-5914-3688-9344-0d4d554c1a78",
                    "sense_definition": "Spacious, well-ventilated, and allowing fresh air to move around freely.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bedroom has large windows that make it bright and <w>airy</w> throughout the day.",
                            "target_lang_translations": {
                                "zh": "卧室有几扇大窗户，使得整天都明亮而<w>通风</w>。"
                            }
                        },
                        {
                            "text": "They chose an <w>airy</w> room at the top of the house to use as a study.",
                            "target_lang_translations": {
                                "zh": "他们挑选了屋顶上一间<w>通风良好</w>的房间作为书房。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bright and airy",
                        "airy room"
                    ],
                    "target_lang_definitions": {
                        "zh": "（房间或空间）宽敞且通风良好的，空气流通的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "通风良好的",
                                "target_lang_sense_clarification": "空气流通好"
                            },
                            {
                                "target_lang_word": "通风的",
                                "target_lang_sense_clarification": "空气流通"
                            },
                            {
                                "target_lang_word": "宽敞通气的",
                                "target_lang_sense_clarification": "宽敞且空气清新"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c48d2d91-eb12-3312-9f40-3487a54791a2",
                    "sense_definition": "Lighthearted, cheerful, and unbothered by serious concerns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She dismissed all their warnings with an <w>airy</w> wave of her hand.",
                            "target_lang_translations": {
                                "zh": "她<w>漫不经心</w>地一挥手，对他们所有的警告都不屑一顾。"
                            }
                        },
                        {
                            "text": "His <w>airy</w> disregard for the rules annoyed his coworkers.",
                            "target_lang_translations": {
                                "zh": "他那种对规则<w>轻率</w>无视的态度惹恼了同事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "carefree",
                        "sprightly"
                    ],
                    "common_phrases": [
                        "airy disregard"
                    ],
                    "target_lang_definitions": {
                        "zh": "轻松随意的，漫不经心的，无忧无虑的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "漫不经心的",
                                "target_lang_sense_clarification": "不在意、不放在心上"
                            },
                            {
                                "target_lang_word": "轻率的",
                                "target_lang_sense_clarification": "态度轻佻、不以为意"
                            },
                            {
                                "target_lang_word": "轻松随意的",
                                "target_lang_sense_clarification": "神态从容轻快"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec44c22c-4cb6-3e98-8550-f633d804d524",
                    "sense_definition": "Lacking substance, realism, or a solid foundation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His business proposal was criticized for relying on <w>airy</w> promises rather than hard data.",
                            "target_lang_translations": {
                                "zh": "他的商业计划书因依赖<w>空洞</w>的承诺而非确凿的数据而受到批评。"
                            }
                        },
                        {
                            "text": "The candidate made several <w>airy</w> statements without detailing how she would achieve them.",
                            "target_lang_translations": {
                                "zh": "这位候选人发表了几番<w>虚无缥缈</w>的声明，却没有详细说明她将如何实现这些目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "empty",
                        "visionary"
                    ],
                    "common_phrases": [
                        "airy promises"
                    ],
                    "target_lang_definitions": {
                        "zh": "虚幻的，空洞的，缺乏实际根据或实据的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "空洞的",
                                "target_lang_sense_clarification": "没有实质内容的"
                            },
                            {
                                "target_lang_word": "虚无缥缈的",
                                "target_lang_sense_clarification": "脱离实际、不切实际的"
                            },
                            {
                                "target_lang_word": "虚妄的",
                                "target_lang_sense_clarification": "没有根据的空想"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f17d64e1-b82e-3258-a937-c8d77cfd345d",
                    "sense_definition": "Delicate, light, or gracefully intangible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ballerina moved across the stage with an <w>airy</w> grace that captivated the audience.",
                            "target_lang_translations": {
                                "zh": "芭蕾舞演员以一种迷倒观众的<w>轻盈</w>优雅在舞台上穿行。"
                            }
                        },
                        {
                            "text": "A gentle and <w>airy</w> melody drifted through the quiet garden.",
                            "target_lang_translations": {
                                "zh": "一曲温柔而<w>空灵</w>的旋律在宁静的花园中飘荡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ethereal"
                    ],
                    "target_lang_definitions": {
                        "zh": "轻盈的，优雅微妙的，空灵轻柔的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻盈的",
                                "target_lang_sense_clarification": "动作姿态轻巧灵敏"
                            },
                            {
                                "target_lang_word": "空灵的",
                                "target_lang_sense_clarification": "优美飘逸、无拘无束"
                            },
                            {
                                "target_lang_word": "轻柔的",
                                "target_lang_sense_clarification": "声音或感觉柔和飘逸"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4500ab3-947f-32f5-b6fe-0bf1211692c6",
                    "sense_definition": "Consisting of or resembling air; gaseous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient philosophers believed that certain spirits were composed of an <w>airy</w> substance.",
                            "target_lang_translations": {
                                "zh": "古代哲学家认为某些灵体是由一种<w>空气般</w>的物质构成的。"
                            }
                        },
                        {
                            "text": "The chemist observed an <w>airy</w> mist rising from the cooling liquid.",
                            "target_lang_translations": {
                                "zh": "化学家观察到冷却中的液体上方升起一层<w>气体</w>薄雾。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aereous",
                        "gaseous"
                    ],
                    "target_lang_definitions": {
                        "zh": "由空气构成的；像空气般的，气体的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "气体的",
                                "target_lang_sense_clarification": "气态的"
                            },
                            {
                                "target_lang_word": "空气般的",
                                "target_lang_sense_clarification": "似空气般无形质的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9d2557c-8e5b-39cb-a81f-0f0bed37a126",
                    "sense_definition": "Relating to the air; high up in the sky.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagle began its <w>airy</w> ascent into the mountain clouds.",
                            "target_lang_translations": {
                                "zh": "雄鹰开始向山间的云层进行<w>高空</w>盘旋上升。"
                            }
                        },
                        {
                            "text": "From their <w>airy</w> perch on the cliff, they watched the ships below.",
                            "target_lang_translations": {
                                "zh": "从悬崖上那处<w>凌空</w>的高地上，他们眺望着下方的船只。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used chiefly in literary or poetic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "高空中的，悬在空中的（古旧或诗意用法）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "高空的",
                                "target_lang_sense_clarification": "位于空中的"
                            },
                            {
                                "target_lang_word": "凌空的",
                                "target_lang_sense_clarification": "高耸悬于空中的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9eebe919-299a-3db2-ae53-bbc5b7055101",
                    "sense_definition": "Affectedly grand or pretentious in manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He entered the room with an <w>airy</w> attitude, expecting everyone to admire him.",
                            "target_lang_translations": {
                                "zh": "他带着一种<w>傲慢</w>的神态走进房间，指望着人人都钦佩他。"
                            }
                        },
                        {
                            "text": "Her <w>airy</w> tone suggested that she thought herself far above the rest of the company.",
                            "target_lang_translations": {
                                "zh": "她那<w>装模作样</w>的语调表明，她觉得自己远高出在场的其他人一等。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "装腔作势的，傲慢自负的（旧式用法）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "傲慢的",
                                "target_lang_sense_clarification": "自命不凡的"
                            },
                            {
                                "target_lang_word": "装模作样的",
                                "target_lang_sense_clarification": "摆架子的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "038952cc-ca40-37f8-8725-7834288e6ba2",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Sir George Biddell <w>Airy</w> was a famous English mathematician and astronomer.",
                            "target_lang_translations": {
                                "zh": "乔治·比德尔·<w>艾里</w>爵士是英国著名的数学家和天文学家。"
                            }
                        },
                        {
                            "text": "Several scientific concepts are named after the British astronomer Royal, George <w>Airy</w>.",
                            "target_lang_translations": {
                                "zh": "有若干科学概念是以英国皇家天文学家乔治·<w>艾里</w>的名字命名的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "艾里（英国姓氏）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "艾里",
                                "target_lang_sense_clarification": "英语姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}