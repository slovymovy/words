                            {
                                "example_id": "5962b11c-00fd-432f-bd4d-b1d3e56b9fe2",
                                "sense_id": "e3ed9c78-5bbc-39d1-be85-f3931309d7af",
                                "text": "Powstał oryginalny hotel tuż obok plaży. Przed nim postawiono pierwszą w mieście minifontannę ze zdrojową wodą"
                            },
                            {
                                "example_id": "fe50656a-b44f-4591-b895-07b2dbb460d5",
                                "sense_id": "e3ed9c78-5bbc-39d1-be85-f3931309d7af",
                                "text": "Dużo radości z zabawy wodą w środku upalnego dnia sprawi dzieciom także plastikowa minifontanna podłączana do kranu i ogrodowy basen kąpielowy"
                            }
                        ],
