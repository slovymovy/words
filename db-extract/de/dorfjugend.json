                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2400eda1-bad8-43a1-ab6e-6c34107c0187",
                                "sense_id": "105142db-c293-3668-87f2-e7423e319518",
                                "text": "„Abends versammelt sich dort die Dorfjugend, um sich über verschiedenen Blödsinn, den sie anstellt, köstlich zu amüsieren.“"
                            },
                            {
                                "example_id": "2a9681c3-0ae5-43d4-87a3-452d637ad017",
                                "sense_id": "105142db-c293-3668-87f2-e7423e319518",
                                "text": "„Drei Jahre lang war Wilhelm Busch in seinem Geburtsort Wiedensahl mit der Dorfjugend zusammen in die Schule gegangen.“"
                            },
                            {
                                "example_id": "9af0091d-e525-498d-bdb7-67576c4b88db",
                                "sense_id": "105142db-c293-3668-87f2-e7423e319518",
                                "text": "„Dem Leuchtturm war anzusehen, dass die Dorfjugend sich gerne dort aufhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
