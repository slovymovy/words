                "senses": [
                    {
                        "sense_id": "28b23434-402b-3169-98e1-937b5ba00aff",
                        "entry_id": "f2da3acf-69dc-36a0-aae0-843f03a1c91f",
                        "glosses": [
                            "Soldat des transmissions chargé de l’émission de signaux sur le champ de bataille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a09cb9f-ccaa-47cc-88a6-9e567a7c7684",
                                "sense_id": "28b23434-402b-3169-98e1-937b5ba00aff",
                                "text": "En outre, dans chaque unité (compagnie, escadron, sotnia et batterie), il doit y avoir en tout temps au moins huit excellents signaleurs (deux par section), pris de préférence parmi les hommes de troupe de classes différentes."
                            },
                            {
                                "example_id": "5eb65876-ecb9-487e-8c92-cae767caa528",
                                "sense_id": "28b23434-402b-3169-98e1-937b5ba00aff",
                                "text": "J’eus le plaisir de former très vite une demi-douzaine d’artistes véritables, qui brillèrent dans la T.S.F. sans compter une vingtaine de signaleurs impertur­bables, qui savaient aussi envoyer et recevoir les lettres par signaux lumineux."
                            },
                            {
                                "example_id": "ba5b6ffe-e2b5-4f4a-9e00-460672539f13",
                                "sense_id": "28b23434-402b-3169-98e1-937b5ba00aff",
                                "text": "Comme nous étions accroupis dans l’escalier, las et moroses, à la lueur d’une chandelle, le chef de mes signaleurs, dont la station avait été fracassée ce même après-midi, avec ses précieuses lampes de signalisation, arriva hors d’haleine et m’annonça : « Mon lieutenant, la cave nᵒ 11 a reçu un coup au but, il y a encore des hommes sous les décombres ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "a1a8041a-38f0-3e6d-932e-2edb8bc39fbd",
                        "entry_id": "f2da3acf-69dc-36a0-aae0-843f03a1c91f",
                        "glosses": [
                            "Celui qui est en charge de transmettre des signaux sur un chantier, un parcours sportif, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e71f5407-f6ad-3425-9b33-2a7ed10da465",
                        "entry_id": "f2da3acf-69dc-36a0-aae0-843f03a1c91f",
                        "glosses": [
                            "Individu dont le rôle est d’émettre des signaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e9ece5-8af1-431c-b95d-dbba85a645d0",
                                "sense_id": "e71f5407-f6ad-3425-9b33-2a7ed10da465",
                                "text": "(…) les appels concordants sont le reflet des expériences sociales du signaleur. Ils permettent alors à un individu d’identifier rapidement les membres de son groupe (…)"
                            }
                        ]
                    },
                    {
                        "sense_id": "b231f0c9-b910-3cb5-a38b-56f813f7341a",
                        "entry_id": "f2da3acf-69dc-36a0-aae0-843f03a1c91f",
                        "glosses": [
                            "Désignation du grade d’un membre du Corps des transmissions royal du Canada détenant le grade de soldat."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
