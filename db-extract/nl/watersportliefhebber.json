                        "examples": [
                            {
                                "example_id": "6408d526-589d-40c8-998e-c07d8ea1e0d6",
                                "sense_id": "121c52ae-2e38-3d5f-8785-6e712d6a274f",
                                "text": "Voor Stewart is het al de derde keer dat hij met wilde orka's zwemt. De watersportliefhebber, die ook surft en duikt, was aan het kajakken in Army Bay in Auckland toen hij twee orka's zag zwemmen."
                            },
                            {
                                "example_id": "a1f9ffd7-fdee-4e56-9f47-c7366ec11151",
                                "sense_id": "121c52ae-2e38-3d5f-8785-6e712d6a274f",
                                "text": "Ik had al 12 dagen niet gedoucht en kwam moe maar voldaan aan in de stad South Lake Tahoe om eindelijk weer eens uit te rusten. Een geliefde vakantiestad voor skiërs in de winter en watersportliefhebbers in de zomer."
                            },
                            {
                                "example_id": "94c2a9aa-396e-4b0a-b173-8744ed3812f1",
                                "sense_id": "121c52ae-2e38-3d5f-8785-6e712d6a274f",
                                "text": "Tijdens het Havenfestival kun je als watersportliefhebber meedoen aan de zeilwedstrijd 'Rondje Ierst', kinderen kunnen gratis zeillessen volgen en daarnaast is het mogelijk om te 'suppen' (stand up paddling)."
                            }
                        ]
