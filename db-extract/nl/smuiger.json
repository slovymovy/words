                        ],
                        "examples": [
                            {
                                "example_id": "381435ea-6047-4803-a6e4-5cf493652f82",
                                "sense_id": "b4450266-c8b7-37e8-b844-db64f1d3d8cb",
                                "text": "Brassinga's vertaling bestrijkt alle registers tussen (kunstig gefantaseerd) bargoens en statig archaïsch Nederlands, en weet ook de ironie en de meanderende stijl - van Melvilles alwetende verteller goed te treffen. En passant stofte ze tal van mooie vergeten woorden af, variërend van smuiger (gluiperd) en ontheisterd (ontredderd) tot dallesdekker (overjas) en gezelzen (bij elkaar zijn)."
                            }
                        ]
                    },
                    {
                        "sense_id": "8db0c2aa-9984-3883-abfc-7bd203d44fc0",
                        "entry_id": "fe877e83-6706-301d-8912-ba9a7cd43b67",
                        "glosses": [
                            "onderdeel van een gebouw om de rook van een haard af te voeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32894b05-c540-4a5e-ac77-22862a8cc0de",
                                "sense_id": "8db0c2aa-9984-3883-abfc-7bd203d44fc0",
                                "text": "In Textielmuseum in Tilburg taxeert expert Kitty Laméris twee grote tegels die in de achttiende eeuw in de Zaanstreek werden gebruikt om een zogenaamde smuiger (een overhangende schoorsteen) mee te betegelen."
                            }
                        ]
                    }
