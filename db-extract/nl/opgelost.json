        "nl-extract.jsonl": [
            {
                "entry_id": "6ac757ed-9cb1-3acd-a32f-7cd4c3b12e0c",
                "word": "opgelost",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3e72dbe0-85e7-3b20-95ef-1a35d482d85d",
                        "entry_id": "6ac757ed-9cb1-3acd-a32f-7cd4c3b12e0c",
                        "glosses": [
                            "tot een goed einde gebracht, van een correcte uitkomst voorzien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01957e26-cf2f-456f-8b4f-fd8074b65de8",
                                "sense_id": "3e72dbe0-85e7-3b20-95ef-1a35d482d85d",
                                "text": "Maar uit de intercom galmde al de boodschap dat we Parijs-Austerlitz naderden, het eindstation van deze trein, waarop ik besloot dat ik niet tijdens een reis richting moest geven aan mijn toekomst, maar na een periode van rust, wanneer de blubber in mijn hoofd was opgelost en ik weer de contouren van mijn emoties kon overzien."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6e59082-f267-34d3-828c-8982c4e81060",
                        "entry_id": "6ac757ed-9cb1-3acd-a32f-7cd4c3b12e0c",
                        "glosses": [
                            "in een vloeistof overgegaan en daardoor niet meer zichtbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b190ed2-2a93-48bd-8f1a-98adfba0591c",
                                "sense_id": "d6e59082-f267-34d3-828c-8982c4e81060",
                                "text": "Kleine hoeveelheden opgelost water veranderen het gedrag van gesteente en veroorzaken de 'stroperigheid' van de asthenosfeer (de gesteentelaag waarop de continentale platen 'drijven')."
                            }
                        ]
                    },
                    {
                        "sense_id": "64e9a4e0-ae2d-3058-bfff-19e18a1cdaa2",
                        "entry_id": "6ac757ed-9cb1-3acd-a32f-7cd4c3b12e0c",
                        "glosses": [
                            "niet meer waarneembaar"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6cdf3655-7bab-46d9-bc38-4a66d121327b",
                                "sense_id": "64e9a4e0-ae2d-3058-bfff-19e18a1cdaa2",
                                "text": "De schoorstenen brokkelen af boven de kamer waar Geert Oortman is gestorven, voor eeuwig opgelost in zijn drank."
                            },
                            {
                                "example_id": "66daf1ce-b716-457e-9f70-7b58daa85d12",
                                "sense_id": "64e9a4e0-ae2d-3058-bfff-19e18a1cdaa2",
                                "text": "Thea is opgelost als de vroege ochtendmist."
                            },
                            {
                                "example_id": "d25d170e-5317-43a1-b262-1aa6a2e2ab44",
                                "sense_id": "64e9a4e0-ae2d-3058-bfff-19e18a1cdaa2",
                                "text": "Toch durft ze niet om te kijken, alsof het pad achter haar dan opgelost blijkt te zijn en een terugkeer onmogelijk is geworden."
                            }
                        ]
                    }
                ],
