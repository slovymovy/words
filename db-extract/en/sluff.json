                                "example_id": "17118a97-29d6-4e6f-876d-737656fac7cd",
                                "sense_id": "2d7b805c-77bd-38e3-9563-3e5fa4c71492",
                                "text": "He's sluffing off somewhere."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1c0928a-e808-3b66-8b34-f2eff3d4329f",
                        "entry_id": "a682d4fd-3311-3c48-abc2-99c5d278cbe6",
                        "glosses": [
                            "To play truant from (school)."
                        ],
                        "tags": [
