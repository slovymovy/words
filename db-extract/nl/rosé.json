                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "badee1b9-665a-465e-b4b8-5c5a5a1d22a3",
                        "source_entry_id": "a2fb3a4c-b923-3e24-8439-bcc9d0a5b798",
                        "source_sense_id": "4ed71697-3312-399f-a87a-d3a937772630",
                        "source_sense_description": "wijn met een lichtrode kleur",
                        "target_lang_word": "rosado",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rosado",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4b82dd37-86df-3265-883b-bff2e0797e35",
                                        "entry_id": "8750c961-58d5-3a5e-b661-a3415d2e9ed7",
                                        "glosses": [
                                            "Hecho o infusionado con rosas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca41f0b-cf04-4c5e-bf8d-a66a47795393",
                                                "sense_id": "4b82dd37-86df-3265-883b-bff2e0797e35",
                                                "text": "da al paciente gargarismo: fecho con miel rosado: & rop de moras: & vinagre: & agua rossada: & agua de plantayna. & esto es para gargarizar."
                                            },
                                            {
                                                "example_id": "8427aa3c-3d3d-4ff5-abb9-1e457b872c84",
                                                "sense_id": "4b82dd37-86df-3265-883b-bff2e0797e35",
                                                "text": "Es necesario corregir los accidentes, el dolor de cabeza y la alienación con frotamientos y lavatorios bajos para distraer; en la cabeza con aceite rosado, agua rosada, de cada uno seis onzas y dos onzas de vinagre."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60ab596d-396e-341e-9c22-f14fea08e352",
                                        "entry_id": "8750c961-58d5-3a5e-b661-a3415d2e9ed7",
                                        "glosses": [
                                            "De color que recuerda al de las rosas, un rojo pálido\\n:*\\nColor:\\n."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2dd8ea-da44-45ee-af99-b47b2585a091",
                                                "sense_id": "60ab596d-396e-341e-9c22-f14fea08e352",
                                                "text": "A Mari Tellez, criada de su Altesa, para se vestir, lo siguiente: Quatro varas e media de paño rosado, para vna faldrilla, a 30 sueldos la vara, que monta 2.352 mrs."
                                            },
                                            {
                                                "example_id": "f5c14e8e-3b46-4654-8cc2-92d40fdd4966",
                                                "sense_id": "60ab596d-396e-341e-9c22-f14fea08e352",
                                                "text": "De lo de mas que se mezcla baxa algo a ste color, y ansi queda el color rosado o encarnado, algo subido: y esto tal arguye buena templança, y salud en las enzias, de mas de tener el mejor parescer."
                                            },
                                            {
                                                "example_id": "f1019996-9752-4b58-8758-dab72ab4a55e",
                                                "sense_id": "60ab596d-396e-341e-9c22-f14fea08e352",
                                                "text": "Su lengua tenía el rosado brioso de un perro de aguas."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "23ba19c5-081e-37e9-ad99-ab67048d58c3",
                                        "entry_id": "8750c961-58d5-3a5e-b661-a3415d2e9ed7",
                                        "glosses": [
                                            "En particular, dicho del pelaje del yeguarizo, de pelo mezclado de rojo y blanco."
                                        ],
                                        "tags": [
                                            "Colombia",
                                            "Río-de-la-Plata",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3a3af5f-853f-43df-8d5b-184f04cc63ea",
                                                "sense_id": "23ba19c5-081e-37e9-ad99-ab67048d58c3",
                                                "text": "Tengo una buena manaa\nde caallos asiados\ny ligeros como un viento:\nun corredor gateado;\nsobre todos, un rosillo\nun castaño y un rosado,\nun morillo y un tordillo,\nun bello alazán tostado."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "41340d92-6ac0-31d9-bf4d-ad3f15b743c8",
                                        "entry_id": "8750c961-58d5-3a5e-b661-a3415d2e9ed7",
                                        "glosses": [
                                            "Dicho del vino, de color rosado₁ a naranja, producido por la fermentación de uvas tintas cuyo hollejo se deja solo brevemente en contacto con el mosto."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eb25ded-7ad7-4bb9-bb3e-12a7bb4104e8",
                                                "sense_id": "41340d92-6ac0-31d9-bf4d-ad3f15b743c8",
                                                "text": "Pablo ordenó a Bert que no desenvolviese los bocadillos y que, si era inevitable su ayuda, comprobase el estado de las botellas de rosado, puestas a enfriar en el arroyo."
                                            },
                                            {
                                                "example_id": "3a569a0e-69be-4de1-b398-156cf5c3786f",
                                                "sense_id": "41340d92-6ac0-31d9-bf4d-ad3f15b743c8",
                                                "text": "Deseaba alcanzar, beber sus recuerdos, tragarme su tristeza (‘gracias, gracias por tu tristeza’), refugiarme en ella para huir, como él, hundida para siempre en la gran copa de vino rosado de su nostalgia, que me invadía mágicamente."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
