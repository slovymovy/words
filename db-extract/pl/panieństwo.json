                        "examples": [
                            {
                                "example_id": "34dc1dd3-c074-423e-af8d-1e4c7d8aaee6",
                                "sense_id": "a665c5ac-ae27-3357-b92d-05694adb2969",
                                "text": "Porodziła Go w radości, w panieństwa Swego całości: / Wydała kwiat z Siebie, którego początek jest w niebie."
