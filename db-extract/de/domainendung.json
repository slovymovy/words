                "senses": [
                    {
                        "sense_id": "51edeaf5-ad2a-3467-b41d-6c62c606576c",
                        "entry_id": "8b461bba-ed14-3454-9420-234f7a958af3",
                        "glosses": [
                            "Buchstaben oder Wörter, die einen Namensbereich/Wirtschaftsbereich kennzeichnen, der dazu dient, Computer im Internet zu identifizieren; diese sind unter anderem Bestandteil der URL einer Webseite / (Domain) und der E-Mail-Adresse"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "7e347e71-5532-4b63-a1eb-5980260efc25",
                                "sense_id": "51edeaf5-ad2a-3467-b41d-6c62c606576c",
                                "text": "Die Domainendung .de wird durch die Deutsche Registratur, www.denic.de, verwaltet und mit der beantragten (freien) Subdomain vergeben."
                            },
                            {
                                "example_id": "ab2cb58d-7679-4515-b5ec-7026689dcc36",
                                "sense_id": "51edeaf5-ad2a-3467-b41d-6c62c606576c",
                                "text": "Keine Sub-Domain wird, mit gleich lautender Domainendung, zweimal vergeben."
                            },
                            {
                                "example_id": "c253cd00-2cb8-4915-8262-4e140b61ef35",
                                "sense_id": "51edeaf5-ad2a-3467-b41d-6c62c606576c",
                                "text": "Alle Domainendungen helfen den Machern des Internets dabei, eine Strukturierung und klare Identifizierung / Rückverfolgbarkeit herzustellen."
                            },
                            {
                                "example_id": "e46bcc40-b96d-4efd-9669-adb77421984c",
                                "sense_id": "51edeaf5-ad2a-3467-b41d-6c62c606576c",
                                "text": "Die Registrierung einer Domain erfolgt grundsätzlich mit einer frei wählbaren Domainendung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
