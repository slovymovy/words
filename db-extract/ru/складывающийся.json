                                "target_senses": [
                                    {
                                        "sense_id": "8c00caca-80bc-361f-a4c9-c2093a8ea6ee",
                                        "entry_id": "3cb13086-b3f1-30ab-9670-bdab009ad92f",
                                        "glosses": [
                                            "Something that can be folded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ffbbae-5dea-45d5-8ebd-6d8df6ed04d4",
                                                "sense_id": "8c00caca-80bc-361f-a4c9-c2093a8ea6ee",
                                                "text": "This should speed up assembly, although many traditionally assembled foldables can be put together in 20 minutes or less; they can be knocked down faster."
                                            },
                                            {
                                                "example_id": "1b9d25d2-cc31-438d-9097-7ab49cf075c0",
                                                "sense_id": "8c00caca-80bc-361f-a4c9-c2093a8ea6ee",
                                                "text": "Then on the right side of the page, students glue their class notes, often taken as foldables. The foldables serve as interactive graphic organizers and allow students to create flaps that reveal their notes about a specific topic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30aa8a3c-1ff1-3ec7-ad60-5d2df311a2eb",
                                        "entry_id": "3cb13086-b3f1-30ab-9670-bdab009ad92f",
                                        "glosses": [
                                            "Something that can be folded.",
                                            "A mobile phone that can be folded up when not in use."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
