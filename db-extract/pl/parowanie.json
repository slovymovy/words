                    {
                        "translation_id": "661d512d-0fcd-4a9b-8640-1b74744d1f33",
                        "source_entry_id": "6bd2f6c5-a4a7-3197-86e9-057d97b84cb7",
                        "source_sense_id": "ca5f91d9-0eb5-3b24-acfd-9202472365e1",
                        "target_lang_word": "Verdunstung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdunstung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a09f2583-4206-364b-b486-5eb7bd2633d7",
                                        "entry_id": "dfc725d8-a8b0-3663-9d28-93c30ebffccc",
                                        "glosses": [
                                            "Übergang eines Stoffes vom flüssigen oder festen in den gasförmigen Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688170a7-decb-4bf5-9e8c-b88c3ca664d1",
                                                "sense_id": "a09f2583-4206-364b-b486-5eb7bd2633d7",
                                                "text": "Verdunstung tritt immer dann auf, wenn die Luft nicht mit Wasser gesättigt ist, was in der Regel der Fall ist."
                                            },
                                            {
                                                "example_id": "b48fc078-3a1a-4c5f-9c0c-c5582f8d483e",
                                                "sense_id": "a09f2583-4206-364b-b486-5eb7bd2633d7",
                                                "text": "In nördlichen Regionen steigen Verdunstung und Niederschlag tatsächlich an, im Süden kann man diesen Effekt noch nicht nachweisen."
                                            },
                                            {
                                                "example_id": "facb98fa-c4e5-413c-8698-cdc87ec3cbfa",
                                                "sense_id": "a09f2583-4206-364b-b486-5eb7bd2633d7",
                                                "text": "Die wichtigsten Faktoren für die Stärke der Verdunstung sind Temperatur und Feuchtigkeit der Luft, Sonneneinstrahlung und Wind sowie Beschaffenheit und Feuchteangebot der verdunstenden Oberfläche."
                                            },
                                            {
                                                "example_id": "6080a517-0060-497e-a1d4-90b77a0b7eee",
                                                "sense_id": "a09f2583-4206-364b-b486-5eb7bd2633d7",
                                                "text": "Hitze beschleunigt die Verdunstung. Dadurch trocknet der Boden schneller aus. Sobald der Kühleffekt durch die Verdunstung wegfällt, steigt die Temperatur noch stärker."
                                            },
                                            {
                                                "example_id": "368e93df-e38d-4f06-9287-993dec6ef45a",
                                                "sense_id": "a09f2583-4206-364b-b486-5eb7bd2633d7",
                                                "text": "Beides bestätigt die Vermutung eines Niederschlagkreislaufs von Methan, ähnlich dem Wasserkreislauf auf der Erde – mit Verdunstung, Wolkenbildung und erneutem Niederschlag (Methan ist nur im Temperaturbereich von −182 °C bis −162 °C flüssig, bei höheren Temperaturen gasförmig)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
