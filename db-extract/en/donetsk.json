                        "sense_id": "3a4eb095-fbf7-33ab-b4c3-fe695578137f",
                        "entry_id": "48238a81-ff3b-335f-9315-dba4d8ae541b",
                        "glosses": [
                            "A town in Rostov Oblast, Russia, on the Donets river."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
