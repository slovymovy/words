                        "entry_id": "059bb4d7-3fa1-3d50-b408-f07a44893140",
                        "glosses": [
                            "Qui protège la plante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef061e9-871c-41f4-b312-17d5f44d12f6",
                                "sense_id": "56971fea-9f2c-30ab-8b58-aac0eb112060",
                                "text": "Les espèces végétales ont développé des centaines de milliers de substances naturellement phytoprotectrices qui les aident à se protéger des infections fongiques et des infections bactériennes, et à survivre aux agressions et aux tensions imposées par leur environnement local."
                            }
                        ]
                    },
                    {
                        "sense_id": "39201914-44a4-3ec4-bfaa-abe11368b1fa",
                        "entry_id": "059bb4d7-3fa1-3d50-b408-f07a44893140",
                        "glosses": [
                            "Qui protège la plante de la phytotoxicité."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5a331a9e-ceba-443e-8e80-db4ac8008da2",
                                "sense_id": "39201914-44a4-3ec4-bfaa-abe11368b1fa",
                                "text": "Cet agent phytoprotecteur agit en augmentant l'activité de la glutathion-S-transférase et le niveau de glutathion dans la plante."
                            }
                        ]
                    }
                ],
