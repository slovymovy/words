    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c0d1bf35-e1c2-38c7-b959-1c497d1f6d53",
                    "sense_definition": "Au commencement, en premier lieu dans le temps ou dans un ordre déterminé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordre_temporel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>D'abord</w>, nous allons visiter le musée, puis nous irons déjeuner ensemble."
                        },
                        {
                            "text": "Il faut <w>d'abord</w> laver les légumes avant de commencer la préparation du repas."
                        }
                    ],
                    "synonyms": [
                        "premièrement",
                        "au début"
                    ],
                    "antonyms": [
                        "ensuite",
                        "enfin",
                        "finalement"
                    ],
                    "common_phrases": [
                        "tout d'abord"
                    ]
                },
                {
                    "sense_id": "8e447aa1-8059-3b3c-bb43-52008b6490d4",
                    "sense_definition": "Par priorité, avant toute autre personne ou chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "priorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette situation de crise, la santé et la sécurité des habitants passent <w>d'abord</w>."
                        },
                        {
                            "text": "Lors de l'évacuation du navire, l'équipage a fait monter les enfants <w>d'abord</w>."
                        }
                    ],
                    "synonyms": [
                        "prioritairement",
                        "avant tout"
                    ],
                    "common_phrases": [
                        "les femmes et les enfants d'abord"
                    ]
                },
                {
                    "sense_id": "9ec4ccfd-7de6-37fb-aa67-24df994d2993",
                    "sense_definition": "Sert à introduire un premier argument ou une justification dans le discours.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu ne devrais pas te fâcher, <w>d'abord</w> parce que tu n'as pas écouté mes explications."
                        },
                        {
                            "text": "<w>D'abord</w>, je n'ai jamais signé ce contrat, et ensuite, personne ne m'a prévenu."
                        }
                    ],
                    "synonyms": [
                        "déjà",
                        "pour commencer"
                    ]
                },
                {
                    "sense_id": "29a9cd48-9769-31b2-868b-38cc0aa05171",
                    "sense_definition": "Exprime une marque d'entêtement, de refus catégorique ou de défi.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu ne décideras pas pour moi, je ne viendrai pas avec vous <w>d'abord</w> !"
                        },
                        {
                            "text": "Ce n'est pas moi qui ai cassé la tasse, je ne la rangerai pas <w>d'abord</w> !"
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé par les enfants"
                        }
                    ]
                }
            ]
        }
    ]
