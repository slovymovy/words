                                "target_senses": [
                                    {
                                        "sense_id": "a8bd6ca9-aead-316d-a159-a7dfc87dfa48",
                                        "entry_id": "66c55fba-4b3c-3016-8a10-14d9c495a5cd",
                                        "glosses": [
                                            "Propagandiste du volapük."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce704730-02de-465d-b51f-ae44ca120494",
                                                "sense_id": "a8bd6ca9-aead-316d-a159-a7dfc87dfa48",
                                                "text": "Admettre, ainsi que le veulent certains volapükistes, qu'il y a des principes d’euphonie ou d’harmonie, qui doivent guider l'élèves dans le choix des tournures ou dans la construction des phrases, ce serait oublier qu’Orientaux et Occidentaux établissent l’euphonie grammaticale sur des bases complètement différentes, et confier les destinées de la langue aux caprices des esprits irréfléchis."
                                            },
                                            {
                                                "example_id": "83c2b04a-79a3-450a-9ea0-7f78a0853ce9",
                                                "sense_id": "a8bd6ca9-aead-316d-a159-a7dfc87dfa48",
                                                "text": "Comme l'écrivait en 1889 Léopold Eistein, un volapükiste allemand passé à l’Esperanto dès l'apparition de cette langue, le progrès de l'humanité est jalonné par sept inventions qui devraient être considérées comme les sept merveilles du Monde, et qui sont : écrire, imprimer, sténographier, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f92262f9-f797-4dbe-8347-dd8f90f27bd0",
                        "source_entry_id": "bce88086-130e-364c-a95c-a1624c7b37c6",
                        "source_sense_id": "0125334a-9092-3b76-9767-60d94b829b3e",
                        "source_sense_description": "specialist or speaker of Volapük",
                        "target_lang_word": "Volapükist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Volapükist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e991a16b-e6d9-3200-bc88-69884681d6d7",
                                        "entry_id": "12d12863-8900-34b3-861b-e14a638307f4",
                                        "glosses": [
                                            "Person, die die Kunstsprache Volapük beherrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c07a177-c754-487e-bf8b-807cc2bda04f",
                                                "sense_id": "e991a16b-e6d9-3200-bc88-69884681d6d7",
                                                "text": "„Besonders stolz sind die Volapükisten auf ihr Verbum; es hat eine einzige Konjugation und ist absolut regelmäßig gebildet.“"
                                            },
                                            {
                                                "example_id": "88e625f9-6640-49d7-91d4-72b857eec99b",
                                                "sense_id": "e991a16b-e6d9-3200-bc88-69884681d6d7",
                                                "text": "„Wie etwa der bekannte deutsche Volapükist Rupert Kniele berichtete, weckte der Import von Volapük-Literatur bei den zaristischen Behörden den Verdacht, dass es sich um Propaganda für revolutionäre Ideen handeln könnte.“"
                                            },
                                            {
                                                "example_id": "f0538822-6f0b-4148-bee3-6a366cc8f42e",
                                                "sense_id": "e991a16b-e6d9-3200-bc88-69884681d6d7",
                                                "text": "„Ein deutscher Volapükist wird also das Wort tiä (Lehre) tit sprechen und damit seinem englischen oder italienischen Kollegen sofort unverständlich werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
