                    },
                    {
                        "translation_id": "ef01c848-d8de-48f5-9de2-f43b9474811a",
                        "source_entry_id": "884992d1-d7e8-3f83-bc55-a4a9b28bb322",
                        "source_sense_id": "508417d0-4588-36e5-a08d-6963f6ef24e1",
                        "source_sense_description": "het onderhouden en fokken van vee.",
                        "target_lang_word": "Viehzucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Viehzucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92acee65-10ca-31b0-bf11-3f9b6021da0c",
                                        "entry_id": "27446adb-5412-31fa-b9a7-c837be7beaa1",
                                        "glosses": [
                                            "die kontrollierte Vermehrung und Aufzucht von Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7fc950c-ff24-45f0-9c45-65306216b6e8",
                                                "sense_id": "92acee65-10ca-31b0-bf11-3f9b6021da0c",
                                                "text": "„Die aufgrund von Ackerbau und Viehzucht agrarisch geprägte Gesellschaft der Kelten war streng hierarchisch gegliedert.“"
                                            },
                                            {
                                                "example_id": "1c15882d-0066-4c83-9ef8-16dc7c0d09fa",
                                                "sense_id": "92acee65-10ca-31b0-bf11-3f9b6021da0c",
                                                "text": "„Agrarökosysteme sind Landschaften, die vom Menschen urbar gemacht wurden, um Ackerbau und Viehzucht zu betreiben“"
                                            },
                                            {
                                                "example_id": "28560f6d-e38b-4a46-b28c-352885ffbd3f",
                                                "sense_id": "92acee65-10ca-31b0-bf11-3f9b6021da0c",
                                                "text": "„Viehzucht ist wegen der hohen Temperaturen und der Feuchtigkeit nicht mehr möglich.“"
                                            },
                                            {
                                                "example_id": "3892207f-1633-44f3-a78e-3911554d4db2",
                                                "sense_id": "92acee65-10ca-31b0-bf11-3f9b6021da0c",
                                                "text": "„Hauptsächlich trieb er Viehzucht und bebaute nur ein sehr kleines Stück Land, etwa fünf Acker, um Mais für sich und die Seinen zu ziehen; auch hatte er mehrere Pferde, doch nicht viele.“"
                                            },
                                            {
                                                "example_id": "3caf6be2-00eb-4726-b9b1-ae5be3d290d1",
                                                "sense_id": "92acee65-10ca-31b0-bf11-3f9b6021da0c",
                                                "text": "„Otgo ist das jüngste Kind einer nomadischen Familie, die von Viehzucht in der Wüste Gobi lebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76136b35-595e-4550-adc8-e88f98ce84eb",
                        "source_entry_id": "884992d1-d7e8-3f83-bc55-a4a9b28bb322",
                        "source_sense_id": "508417d0-4588-36e5-a08d-6963f6ef24e1",
