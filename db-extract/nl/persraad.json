                        "examples": [
                            {
                                "example_id": "04e34bd1-0c63-4c19-8510-1b12042a8a32",
                                "sense_id": "66788173-790f-3541-9d85-2e78ff1c2545",
                                "text": "Bij de Duitse Persraad, de tegenhanger van de Nederlandse Raad voor de Journalistiek, zijn al 50 klachten binnengekomen over de publicatie door Bild van screenshots van de appjes van het zoontje dat het gezinsdrama overleefde en diens niet geblurde foto."
                            },
                            {
                                "example_id": "50307f78-6651-4477-90b7-8fee0a9532ed",
                                "sense_id": "66788173-790f-3541-9d85-2e78ff1c2545",
                                "text": "'Dit is een onverholen aanval op de media', zei Dario Novalic, het hoofd van de Persraad in Bosnië, een interne waakhond voor geprinte en online media. Volgens Novalic betichtten de autoriteiten Klix.ba ervan telefoons te hebben afgetapt."
                            }
                        ]
