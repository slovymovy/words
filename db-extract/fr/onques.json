                        "examples": [
                            {
                                "example_id": "7f3de70e-a892-4ae2-a529-cbf661a3b82e",
                                "sense_id": "106dfc20-63ca-3f3f-8762-037abe875c7d",
                                "text": "On ne vit onques un si méchant homme."
                            },
                            {
                                "example_id": "d04b1286-ded7-44fc-aaae-f8483a925852",
                                "sense_id": "106dfc20-63ca-3f3f-8762-037abe875c7d",
                                "text": "Il n’en fut onques de plus maladroit."
                            },
                            {
                                "example_id": "80f262c5-4358-4610-8d56-31b7ec6e1689",
                                "sense_id": "106dfc20-63ca-3f3f-8762-037abe875c7d",
                                "text": "Onques ne vit-on indien s’esbaudir."
                            },
                            {
                                "example_id": "72443910-d79d-4cdb-abf9-619ff35aa36a",
                                "sense_id": "106dfc20-63ca-3f3f-8762-037abe875c7d",
                                "text": "Elle a fait son devoir ! C’est-à-dire que oncque\nElle n’eut de souhait impossible, elle n’eut\nAucun rêve de lune, aucun désir de jonque\nL’emportant sans rameurs sur un fleuve inconnu."
                            }
                        ]
                    }
