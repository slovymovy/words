                            {
                                "example_id": "8d0ed5cb-dfdf-4563-8326-ed092e5ed41d",
                                "sense_id": "b817c9d3-8134-3686-b1bb-b6d17eabdb59",
                                "text": "La voûte est un mode de couvrement courant dans les églises."
                            },
