                    {
                        "translation_id": "fd522ae7-b834-4c28-86e5-4bc253c72e4c",
                        "source_entry_id": "6ec36156-36db-381d-bb4e-c716d507dde1",
                        "source_sense_id": "3b16b2f6-543c-33bf-8423-0a2baf310000",
                        "source_sense_description": "one who donates",
                        "target_lang_word": "schenker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schenker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "09e0c274-a6f8-39d4-b9dc-ae75c1a2812a",
                                        "entry_id": "0f442d7a-fbc9-363b-a448-7dadc2434d81",
                                        "glosses": [
                                            "iemand die iets cadeau geeft aan een ander"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b09b6538-18eb-479f-9e16-9a0def3b9451",
                                                "sense_id": "09e0c274-a6f8-39d4-b9dc-ae75c1a2812a",
                                                "text": "Schenkers zijn blij, omdat ze iets kunnen schenken, klanten zijn blij met hun aankoop en wij kunnen de opbrengst gebruiken voor onze projecten. Op het eind van de dag zijn er alleen maar winnaars."
                                            },
                                            {
                                                "example_id": "1ce03525-558c-4c92-b058-4e2abaf54532",
                                                "sense_id": "09e0c274-a6f8-39d4-b9dc-ae75c1a2812a",
                                                "text": "Dankzij giften van plaatselijke bedrijven, scholen en andere organisaties is het afgelopen jaar veel tot stand gekomen op de kinderboerderij. Alle schenkers waren vrijdagmiddag uitgenodigd om de resultaten te bewonderen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de33676b-7cfd-3ac0-bc13-3ac7a459847c",
                                        "entry_id": "0f442d7a-fbc9-363b-a448-7dadc2434d81",
                                        "glosses": [
                                            "iemand die drank inschenkt"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfb5fbae-90e2-4b12-8730-5622a66598e1",
                        "source_entry_id": "6ec36156-36db-381d-bb4e-c716d507dde1",
                        "source_sense_id": "3b16b2f6-543c-33bf-8423-0a2baf310000",
                        "source_sense_description": "one who donates",
                        "target_lang_word": "donateur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donateur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0069b1cc-3f73-34cd-875a-1b184cec6730",
                                        "entry_id": "3d4a60ef-a991-35eb-ae27-d2ad6bb813d4",
                                        "glosses": [
                                            "iemand die een (financiële) bijdrage levert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40754dd3-4de6-42d6-af77-bfa9cc1a6c35",
                                                "sense_id": "0069b1cc-3f73-34cd-875a-1b184cec6730",
                                                "text": "Ondanks de enorme bezoekersaantallen kon het museum toch niet zonder de donaties van de gulle donateurs"
                                            },
                                            {
                                                "example_id": "f480291a-57fc-4ceb-87a9-566ac34c3294",
                                                "sense_id": "0069b1cc-3f73-34cd-875a-1b184cec6730",
                                                "text": "Binnen een uur had ik de Gofundme-website opgezet en vroeg ik mijn vrienden thuis via Facebook om wat geld te doneren. 1 dollar voor elke kilometer die ik liep leek me een mooi streven, in de hoop zo 4.286 dollar op te halen. Ook beloofde ik voor elke donateur een persoonlijk schilderij te maken."
                                            },
                                            {
                                                "example_id": "065cb65d-a5dc-490f-8fd2-6d795592530a",
                                                "sense_id": "0069b1cc-3f73-34cd-875a-1b184cec6730",
                                                "text": "Het werd een feestelijke bijeenkomst, waarbij inwoners van Pieterburen, donateurs en oud-medewerkers waren uitgenodigd, meldt RTV Noord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07fd6ef5-ecac-480b-8a3e-f5f99c0d0336",
                        "source_entry_id": "6ec36156-36db-381d-bb4e-c716d507dde1",
                        "source_sense_id": "3b16b2f6-543c-33bf-8423-0a2baf310000",
                        "source_sense_description": "one who donates",
                        "target_lang_word": "begunstiger",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begunstiger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "195648e1-8cd7-32c1-8f5f-d20e1978c5ff",
                                        "entry_id": "5cf3068f-9da8-37bd-be87-b4d1c59f706c",
                                        "glosses": [
                                            "iemand die iets of iemand ondersteunt o.a. door die persoon of organisatie geld te geven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200b8356-e62e-4136-b075-6919bc49642f",
                                                "sense_id": "195648e1-8cd7-32c1-8f5f-d20e1978c5ff",
                                                "text": "De huidige eigenaar is de Noorse zakenman Petter Olsen. Zijn vader was een vriend, buurman en begunstiger van Munch. Olsen heeft aangekondigd dat hij de opbrengst wil investeren in een museum, kunstcentrum en hotel in Hvitsten, ooit de kleinste zelfstandige gemeente van Noorwegen. Munch maakte er enkele van zijn bekendste werken."
                                            },
                                            {
                                                "example_id": "59ad85aa-7c0f-4c89-9900-e7b220be8133",
                                                "sense_id": "195648e1-8cd7-32c1-8f5f-d20e1978c5ff",
                                                "text": "Tijdens de dag werden naar schatting meer dan 700 nieuwe donateurs geworven. Mede door een initiatief van ondernemers kwamen er alleen al in Texel 150 begunstigers bij."
                                            },
                                            {
                                                "example_id": "9f0ca3a4-f138-4a43-9a88-c122623c6173",
                                                "sense_id": "195648e1-8cd7-32c1-8f5f-d20e1978c5ff",
                                                "text": "Macha's wil bij voorkeur zelf een seksboot exploiteren. De coöperatie zegt enkele begunstigers te hebben die willen betalen voor het bouwen van een nieuwe boot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56d22b38-6553-4fec-8732-682e62e97bcb",
                        "source_entry_id": "6ec36156-36db-381d-bb4e-c716d507dde1",
                        "source_sense_id": "3b16b2f6-543c-33bf-8423-0a2baf310000",
                        "source_sense_description": "one who donates",
                        "target_lang_word": "begiftiger",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0dc345aa-9e83-42c7-867a-de0c086e2683",
                        "source_entry_id": "6ec36156-36db-381d-bb4e-c716d507dde1",
                        "source_sense_id": "3b16b2f6-543c-33bf-8423-0a2baf310000",
                        "source_sense_description": "one who donates",
                        "target_lang_word": "donateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0f5cb1-028c-3110-bd75-83fb6b9dec34",
                                        "entry_id": "32ffa88a-4667-3e5a-8e19-a27039131d79",
                                        "glosses": [
                                            "Celui qui donne quelque chose, donneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1867fab9-88c0-4826-84e8-1597fee2c83e",
                                                "sense_id": "1d0f5cb1-028c-3110-bd75-83fb6b9dec34",
                                                "text": "Elle collectionne aussi toutes les plaques officielles des rues, et à chaque instant un généreux donateur arrive, apportant des panonceaux ou des affiches."
                                            },
                                            {
                                                "example_id": "c5b64d19-e699-46f1-9f43-e8269de53f0f",
                                                "sense_id": "1d0f5cb1-028c-3110-bd75-83fb6b9dec34",
                                                "text": "Ces ateliers, où l’on déballe ses soucis, permettent à l’association de fabriquer des tote bags colorés, utilisés pour remercier les donateurs et donatrices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c98a5f3-67be-3927-9f6f-2f6592349e9f",
                                        "entry_id": "32ffa88a-4667-3e5a-8e19-a27039131d79",
                                        "glosses": [
                                            "Personne qui a fait une donation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94dca0ab-8cf6-4c6e-b6b7-a1633d3cf450",
                                                "sense_id": "6c98a5f3-67be-3927-9f6f-2f6592349e9f",
                                                "text": "[…], par conséquent, il y a eu concours des volontés et réalisation de la donation le jour où la chose, offerte par le donateur (en la personne de son mandataire), a été acceptée par le donataire en personne."
                                            },
                                            {
                                                "example_id": "4c9bd02c-844c-4b04-9908-90119f3376fa",
                                                "sense_id": "6c98a5f3-67be-3927-9f6f-2f6592349e9f",
                                                "text": "La donation entre vifs est un acte par lequel le donateur se dépouille actuellement et irrévocablement de la chose donnée en faveur du donataire qui l'accepte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "donateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56a95ba6-62c6-3c8a-b1af-c3c24f03e338",
                                        "entry_id": "2ce38a70-4c7d-3e92-8529-6596460ba7d7",
                                        "glosses": [
                                            "Qui donne quelque chose."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0140fc-c180-49e0-9332-d7a8980a751f",
                                                "sense_id": "56a95ba6-62c6-3c8a-b1af-c3c24f03e338",
                                                "text": "Ta méditation peut donc avoir la vocation de la lampe donatrice de lumière; ou bien celle d'une musique à écouter entre deux silences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1c6718c-be20-4245-82c6-06c21c0af9db",
                        "source_entry_id": "6ec36156-36db-381d-bb4e-c716d507dde1",
                        "source_sense_id": "3b16b2f6-543c-33bf-8423-0a2baf310000",
