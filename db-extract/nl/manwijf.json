                "senses": [
                    {
                        "sense_id": "1d826e81-f5dd-3a2b-8a0a-122a37326253",
                        "entry_id": "16e9e915-5fcb-35fc-be82-ab192b0d2686",
                        "glosses": [
                            "forse, ruwe, bazige vrouw"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "fe2ab55b-bc3e-4eb9-9969-fc38a464c1aa",
                                "sense_id": "1d826e81-f5dd-3a2b-8a0a-122a37326253",
                                "text": "Het keerpunt, waarop ze besliste opnieuw een meisje te zijn, kwam in het eerste middelbaar: een nieuwe school, met allemaal nieuwe gezichten. Anuna kwam terecht in een klas met vrij veel jongens. ‘Op de speelplaats kwamen steeds meer jongens vragen hoe het zat: ze zeggen dat jij een meisje bent, is dat echt waar? En daarna kwamen de scheldwoorden: manwijf! Mijn vriendje werd uitgemaakt voor homo. Niet leuk voor hem, maar hij zag mij toch graag.’"
                            },
                            {
                                "example_id": "50472e4c-70ff-47e5-8f38-dc364b1bb268",
                                "sense_id": "1d826e81-f5dd-3a2b-8a0a-122a37326253",
                                "text": "Uit de bronnen komt Kenau Hasselaar naar voren als een eigenzinnige, doortastende vrouw, maar niet per se als een onaangenaam manwijf. Weliswaar noemt een prentbijschrift haar ‘bolle Truy’ (dikke trien) en spreekt een rechtbankverslag niet erg lovend over een „tovenaarster”."
                            }
                        ]
                    },
                    {
                        "sense_id": "93e51070-1f88-36c0-98c5-11012b77307e",
                        "entry_id": "16e9e915-5fcb-35fc-be82-ab192b0d2686",
                        "glosses": [
                            "vrouw die er uitziet en zich gedraagt als een man"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30e61d20-bf72-4585-9e0d-6718dd7524d7",
                        "source_entry_id": "16e9e915-5fcb-35fc-be82-ab192b0d2686",
                        "source_sense_id": "1d826e81-f5dd-3a2b-8a0a-122a37326253",
                        "source_sense_description": "(pejoratief) forse, ruwe, bazige vrouw",
                        "target_lang_word": "Mannweib",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mannweib",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "987e5e47-0d30-35be-be3b-46063fb0677a",
                                        "entry_id": "7fd8aaad-4ea3-36fe-a681-2d3bff3eb05a",
                                        "glosses": [
                                            "Frau, die sich wie ein Mann verhält oder so aussieht"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e2c33b1-090a-436e-92ff-862426cf4ffa",
                                                "sense_id": "987e5e47-0d30-35be-be3b-46063fb0677a",
                                                "text": "Heute scheint es so, als würde es die „Mannweiber“ von gestern nicht mehr geben, weil ja heute die „schönen“ Frauen Fußball spielen, es gibt sogar eine schlanke, langhaarige, blonde Barbie, die angeblich Fußball spielen kann."
                                            },
                                            {
                                                "example_id": "0c102d80-c2bf-4073-a6ae-ced9046aecb9",
                                                "sense_id": "987e5e47-0d30-35be-be3b-46063fb0677a",
                                                "text": "Die Töchter [von Meerschweinchen] werden aggressive Mannweiber, die Männchen bleiben sehr lange kindliche Mamasöhnchen."
                                            },
                                            {
                                                "example_id": "ba48e52c-0e79-4fb3-9afc-b3d3509af6b6",
                                                "sense_id": "987e5e47-0d30-35be-be3b-46063fb0677a",
                                                "text": "„Das Gemächte müßt man ihm wegmetzeln, grollt Mannweib Pauline.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f35a5a31-c8a1-4eac-8e92-bf342229736e",
                        "source_entry_id": "16e9e915-5fcb-35fc-be82-ab192b0d2686",
                        "source_sense_id": "1d826e81-f5dd-3a2b-8a0a-122a37326253",
                        "source_sense_description": "(pejoratief) forse, ruwe, bazige vrouw",
                        "target_lang_word": "mannish woman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "30374f15-0d73-43e9-887e-e752a74aed85",
                        "source_entry_id": "16e9e915-5fcb-35fc-be82-ab192b0d2686",
                        "source_sense_id": "1d826e81-f5dd-3a2b-8a0a-122a37326253",
                        "source_sense_description": "(pejoratief) forse, ruwe, bazige vrouw",
                        "target_lang_word": "butch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "butch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d89eb5cb-fa0d-38ea-a6a4-cdf2e5254ee1",
                                        "entry_id": "8448612e-0570-3510-9f82-03b7b8de1022",
                                        "glosses": [
                                            "Very masculine, with a masculine appearance or attitude."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91d0f98b-e0b3-4274-91e9-d6f9abba662a",
                                                "sense_id": "d89eb5cb-fa0d-38ea-a6a4-cdf2e5254ee1",
                                                "text": "There, look, Mr. Horne! Vada that great butch lucoddy!"
                                            },
                                            {
                                                "example_id": "7bbf761b-87aa-45dc-a043-a88cfe61bb58",
                                                "sense_id": "d89eb5cb-fa0d-38ea-a6a4-cdf2e5254ee1",
                                                "text": "Nor can I credit that a — to put it crudely — proud bisexual butch Italian — albeit one lonely, poor, emotional and without strong will — which Giovanni is shown to be in the earlier part of the book, should become, in a mere matter of months, and as the result of any happening, the venal hysterical fairy that he does."
                                            },
                                            {
                                                "example_id": "6a0a22c3-8304-47a9-ad35-3067d5ca928d",
                                                "sense_id": "d89eb5cb-fa0d-38ea-a6a4-cdf2e5254ee1",
                                                "text": "Then I started going out with different kinds of women, and I started feeling more like I wanted to be more butch. […] I feel much more butch than I feel femme."
                                            },
                                            {
                                                "example_id": "9c8dce6c-6ed6-4ab2-8d2e-220e5567839c",
                                                "sense_id": "d89eb5cb-fa0d-38ea-a6a4-cdf2e5254ee1",
                                                "text": "The process of appreciating a butch aesthetic may be even more complex for bisexual butch women. In contrast to lesbian butches who may date only within a butch-femme community, bisexual butch women may be more likely to […] In comparison to butch bisexual women, it may be easier for femme bisexual women to locate male and female dating partners […]"
                                            },
                                            {
                                                "example_id": "1770517b-c6aa-4fc0-9af2-11ac1c37893d",
                                                "sense_id": "d89eb5cb-fa0d-38ea-a6a4-cdf2e5254ee1",
                                                "text": "More of the rotten responses I receive about being a bisexual butch woman come from other bisexuals, particularly men, who don't want to deal with any woman who is not some Barbie doll standard of femininity."
                                            },
                                            {
                                                "example_id": "9b27b8dc-6a7d-449c-9598-3b1d99276e9d",
                                                "sense_id": "d89eb5cb-fa0d-38ea-a6a4-cdf2e5254ee1",
                                                "text": "\"Faye got wicked buff and has a super butch haircut and it is hot as shit.\" \"It's okay, babe. We can ogle her together.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "butch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a164048-4971-386c-b72f-028ab0e739b7",
                                        "entry_id": "e97f1b88-c1ac-3f9a-93af-6dd2dfb724ce",
                                        "glosses": [
                                            "A lesbian who appears masculine or acts in a masculine manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8868780-0a7b-455f-b8aa-d60ca560a4d9",
                                                "sense_id": "6a164048-4971-386c-b72f-028ab0e739b7",
                                                "text": "Coming out appeals to the narcissistic pleasure of presenting to another a finished image of ourselves, which they return to us in exactly the same form: [someone tells] you [they are] a bisexual butch, and you confirm it. But instead, it seems all too likely – especially, perhaps, for bisexuals, whose claims to identity always need that much more proof – that no such mirror-image will be returned."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "butch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ccc53b-6027-347d-b42a-ab3e00e01f7c",
                                        "entry_id": "a9b4c169-2143-3121-a762-a864a3efa10c",
                                        "glosses": [
                                            "To work as a butcher."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d09e9109-6776-4a97-b158-40e7f093fff0",
                                                "sense_id": "c8ccc53b-6027-347d-b42a-ab3e00e01f7c",
                                                "text": "Sax thouſand years are near hand fled, / Sin’ I was to the butching bred, / And mony a ſcheme in vain’s been laid, / To ſtap or ſcar me; / Till ane Hornbook’s ta’en up the trade, / And faith, he’ll waur me."
                                            },
                                            {
                                                "example_id": "544f1045-2162-4b5d-8042-8b3ee4b824ac",
                                                "sense_id": "c8ccc53b-6027-347d-b42a-ab3e00e01f7c",
                                                "text": "Butch, to practice the trade of a butcher, to kill."
                                            },
                                            {
                                                "example_id": "ec808ef0-7535-4a0e-a8fc-9d2594a301db",
                                                "sense_id": "c8ccc53b-6027-347d-b42a-ab3e00e01f7c",
                                                "text": "And sometimes he also displayed by the side of his brooms, some spare-ribs after the killing of a neighbour’s pig—but there was no one in Black Moss who was a regular purveyor of any sort of meat. Certain there were indeed who “butched a bit noo an’ then,” but they looked for their meat to a butcher who journeyed to them from afar twice a week in the winter, and three times in the season."
                                            },
                                            {
                                                "example_id": "7018a574-1bd8-417f-9d90-3ff6b1f7128c",
                                                "sense_id": "c8ccc53b-6027-347d-b42a-ab3e00e01f7c",
                                                "text": "BUTCH, v. to kill animals for food. as a butcher does. / Coll. Use. 1875. He use’t to be a farmer, but he butches neaw."
                                            },
                                            {
                                                "example_id": "718543ea-f504-4cb0-8473-59c7447b570b",
                                                "sense_id": "c8ccc53b-6027-347d-b42a-ab3e00e01f7c",
                                                "text": "From out his red and sawdust shop / This butcher, born to chepe and chop, / Surveys without a trace of grief / Perambulating tombs of beef. / […] / It’s probable we never shall / Convince him that an animal / Is not mere layers of lean and fat; / He may have butched too much for that."
                                            },
                                            {
                                                "example_id": "b663a672-ed37-46c4-969f-02747bf6f926",
                                                "sense_id": "c8ccc53b-6027-347d-b42a-ab3e00e01f7c",
                                                "text": "A butcher who butched in Des Moines, / As his customers passed him des coines, / Said: “What will you take / In the way of a steak? / Here’s a very nice piece off des loines.”"
                                            },
                                            {
                                                "example_id": "3f366996-17ce-4990-b480-2e9a22e820a9",
                                                "sense_id": "c8ccc53b-6027-347d-b42a-ab3e00e01f7c",
                                                "text": "I expect to retire after that fashion—by changing work. The most serious weakness in our present social system is that everyone has to stick at the same thing all the time. It would be much more exciting if the butcher, having butched until his spirit is a bit weary, might become a Senator."
                                            },
                                            {
                                                "example_id": "105a8bb9-3f9a-405e-bad4-2ac085074d60",
                                                "sense_id": "c8ccc53b-6027-347d-b42a-ab3e00e01f7c",
                                                "text": "I never wanted to be a politician. In my home universe, I was a butcher. Meat was my life. I butched."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2a2fe53-ae80-301f-80aa-ad7db14de3a6",
                                        "entry_id": "a9b4c169-2143-3121-a762-a864a3efa10c",
                                        "glosses": [
                                            "To slaughter (animals) and prepare (meat) for market."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89dd45c0-4a73-4338-b785-b61b16b6cb7b",
                                                "sense_id": "a2a2fe53-ae80-301f-80aa-ad7db14de3a6",
                                                "text": "Take thy huge offal and white liver hence, / Or in a twinkling of this true-blue steel / I shall be butching thee from nape to rump."
                                            },
                                            {
                                                "example_id": "2debb66f-c92c-407f-943b-76348c45b3ff",
                                                "sense_id": "a2a2fe53-ae80-301f-80aa-ad7db14de3a6",
                                                "text": "“Couldn’t Ali butch the cow, please?” said Bill, whose ears were ever open when the question of food was raised."
                                            },
                                            {
                                                "example_id": "e26f4b22-e4f2-4cce-9c69-dc8d55d99c7c",
                                                "sense_id": "a2a2fe53-ae80-301f-80aa-ad7db14de3a6",
                                                "text": "I can vouch that it is in regular use in Clitheroe and the neighbouring district, where such expressions as “I butched three sheep yesterday,” or “He used to be a farmer, but has now gone into the butching business,” are very frequently heard."
                                            },
                                            {
                                                "example_id": "240794b4-f416-4575-84f7-6ad3f9ae7e47",
                                                "sense_id": "a2a2fe53-ae80-301f-80aa-ad7db14de3a6",
                                                "text": "However, the idea of horse meat for animal food is thoroughly established, and this industry has grown up in California because there seem to be more dogs and cats per capita than elsewhere; because horse meat sold in special pet food shops always has been economical, costing less than half as much as butcher’s meat. Even before the meat was freely sold in fresh form, it was butched regularly for dog food canners."
                                            },
                                            {
                                                "example_id": "e8dec03b-65e8-4c41-aa4d-f5ac34a822a3",
                                                "sense_id": "a2a2fe53-ae80-301f-80aa-ad7db14de3a6",
                                                "text": "Growing every pig takes between 8 and 12 months, and once they are ready to be butched, he sells them for 1500 to 2000 pesos (150-200 USD)."
                                            },
                                            {
                                                "example_id": "beff6ba6-6ec2-4d1c-b9fc-ee03691573d7",
                                                "sense_id": "a2a2fe53-ae80-301f-80aa-ad7db14de3a6",
                                                "text": "She turned to the butcher and said, “butcher butcher butch the cow[…]”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b31f6d31-56ae-4251-98c5-2e617edd0e7e",
                        "source_entry_id": "16e9e915-5fcb-35fc-be82-ab192b0d2686",
                        "source_sense_id": "1d826e81-f5dd-3a2b-8a0a-122a37326253",
