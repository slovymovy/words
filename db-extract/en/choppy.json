                                "sense_id": "8314be66-6c10-375e-9ecb-54d2656dccb1",
                                "text": "Commander Birch was a trifle uneasy when he found there was more than a popple on the sea; it was, in fact, distinctly choppy."
                            },
                            {
                                "example_id": "67160f66-2c04-4e2b-8af6-929af81e259a",
                                "sense_id": "8314be66-6c10-375e-9ecb-54d2656dccb1",
                                "text": "Safely navigating choppy waters has allowed FirstGroup to pay its first interim dividend for almost a decade, and only its second since payments restarted in August."
                            },
                            {
                                "example_id": "9e81a9b8-a71b-4084-9d80-9da059c686e5",
                                "sense_id": "8314be66-6c10-375e-9ecb-54d2656dccb1",
                                "text": "“Huh, this lazy river seems like it's getting pretty choppy.”"
                            }
                        ]
