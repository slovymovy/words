                                    {
                                        "sense_id": "7dc7c7f3-c2e8-39f8-8ebc-8693f6c3cefc",
                                        "entry_id": "1099353a-1f77-3cf9-9303-1d01910f90bf",
                                        "glosses": [
                                            "To have saliva drip from the mouth."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c459164-91a2-3265-9bbf-3866bae61408",
                                        "entry_id": "1099353a-1f77-3cf9-9303-1d01910f90bf",
                                        "glosses": [
                                            "To be weak or foolish; to dote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ff8b6b7-9d78-4413-86b6-1836b32d5994",
                                                "sense_id": "4c459164-91a2-3265-9bbf-3866bae61408",
                                                "text": "This drivelling love is like a great natural, that runs lolling up and down to hide his bauble in a hole."
                                            },
                                            {
                                                "example_id": "336a55fb-4cae-4b5d-8fa8-71787b3ffb46",
                                                "sense_id": "4c459164-91a2-3265-9bbf-3866bae61408",
                                                "text": "driveling dotard"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drivel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aec005ce-7924-35f3-be0d-8d6361d03c38",
                                        "entry_id": "d7a823fa-5bb7-3b19-bf7c-f18fc8ff156d",
                                        "glosses": [
                                            "A servant; a drudge."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97cf3ca3-bd9f-4c53-97a8-2e6863be49d2",
                                                "sense_id": "aec005ce-7924-35f3-be0d-8d6361d03c38",
                                                "text": "that foul aged drivel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a52f13dd-af1f-31fa-9e7e-68df40157cae",
                                        "entry_id": "d7a823fa-5bb7-3b19-bf7c-f18fc8ff156d",
                                        "glosses": [
                                            "A fool; an idiot."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07b0107e-9ebe-442a-a6b7-864cd13f986c",
                                                "sense_id": "a52f13dd-af1f-31fa-9e7e-68df40157cae",
                                                "text": "if thou didst know what a life I lead with that drivel, it would make thee even of pity receive me into thy only comfort",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drivel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e60a8142-d6ed-3a6e-9a84-72610a0c133b",
                                        "entry_id": "e4978932-425e-38bb-91b4-771f758f2f87",
                                        "glosses": [
                                            "To move or travel slowly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e94afe1f-bd5e-46fc-b343-f936e1406563",
                                                "sense_id": "e60a8142-d6ed-3a6e-9a84-72610a0c133b",
                                                "text": "But that is a state of things, which must in time work its own cure. We cannot always go dribbling and drivelling along, government and people alike being the scoff of all onlookers."
                                            },
                                            {
                                                "example_id": "50a90116-f6ef-47b1-ae7b-4a1fe8701a97",
                                                "sense_id": "e60a8142-d6ed-3a6e-9a84-72610a0c133b",
                                                "text": "There was a good deal of bustle and life at the inn; but three or four inebriates drivelling about the premises were 'suffering a recovery,' from the excitement of the previous night's entertainment."
                                            },
                                            {
                                                "example_id": "dd7763e2-e57d-4fbe-86f6-7fcf95a93a85",
                                                "sense_id": "e60a8142-d6ed-3a6e-9a84-72610a0c133b",
                                                "text": "Walter was as silly as most men are when in love. He went drivelling off in pursuit of her \"dear little work-worn hands\"[.]"
                                            },
                                            {
                                                "example_id": "55e1a6a8-09c2-4b82-ac71-2e0370efe74d",
                                                "sense_id": "e60a8142-d6ed-3a6e-9a84-72610a0c133b",
                                                "text": "Drivelling back to the shanty at midday presented him with a distracting gamble over lunch."
                                            },
                                            {
                                                "example_id": "76722502-0c1f-421b-b58d-9e48b75a20c0",
                                                "sense_id": "e60a8142-d6ed-3a6e-9a84-72610a0c133b",
                                                "text": "\"I am amazed to think we are in the second week of war and this country is still drivelling along with a small volunteer force,\" he added."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92c59fe7-6793-3784-9777-ca241c392e10",
                                        "entry_id": "e4978932-425e-38bb-91b4-771f758f2f87",
                                        "glosses": [
                                            "To use up or to be used up."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cf4fbda-713f-4fd4-b215-852fe6cc9f06",
                                                "sense_id": "92c59fe7-6793-3784-9777-ca241c392e10",
                                                "text": "Instead of drivelling away the precious initiative season of life in the vain labour of teaching tuneable voices to sing[.]"
                                            },
                                            {
                                                "example_id": "98f476f1-f04b-4109-8349-4356061c1b03",
                                                "sense_id": "92c59fe7-6793-3784-9777-ca241c392e10",
                                                "text": "It is for the country to say whether we are to keep on in this backward course, whether we are to go on getting deeper and deeper into debt, whether we are to have increased taxation year after year. The bone and sinew of the land is drivelling away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0272dff2-3ccf-43f9-806c-3347844e2a9e",
                        "source_entry_id": "ef7d5692-cdd7-3ac2-ae7c-fdcf3a10ae1b",
                        "source_sense_description": "Bagatelle,chose frivole",
                        "target_lang_word": "onnozelheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onnozelheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "737a115b-213a-32f0-87f0-a8b43bcc1114",
                                        "entry_id": "cf8a98b1-85d1-32cd-9053-dc422b95fc81",
                                        "glosses": [
                                            "iets dat ontstaat door domheid en onnadenkendheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab5eef61-2ce9-4136-97b3-37ba3779ac88",
                                                "sense_id": "737a115b-213a-32f0-87f0-a8b43bcc1114",
                                                "text": "De zaterdag vóór palmzondag is normaal een dag die veel Denekampers gebruiken om snoeihout aan te voeren. Nu is dat niet mogelijk en wordt er wederom een stukje traditie de das omgedaan. Herman Oude Elferink is uitermate verbolgen over zoveel onnozelheid bij de betrokken bestuurders."
                                            },
                                            {
                                                "example_id": "79e3f69a-8d41-4bbe-a740-0ef34be53d85",
                                                "sense_id": "737a115b-213a-32f0-87f0-a8b43bcc1114",
                                                "text": "Voor Harry Oude Weernink is de kous inmiddels af, zo schrijft hij aan Eddy Schepers. „Ik ben erg geschrokken en teleurgesteld over de omtrekkende bewegingen en de onnozelheid van uw bestuur inzake deze kwestie, daarom sluit ik van mijn kant de discussie.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
