                        "examples": [
                            {
                                "example_id": "384739cc-3054-4819-b174-dc1df7943af2",
                                "sense_id": "8fd9198a-0fcb-35ab-a74a-4b33a6ab6328",
                                "text": "Grote bewegingen in de koers van het Britse pond, dinsdag: eerst een duikeling nadat bekend werd dat de premier met een belangrijke mededeling zou komen. Daarna ging het pond in een steile klim omhoog. Aan het einde van de middag was het pond meer dan 1,192 euro waard, ongeveer een cent meer dan voordat May sprak. Woensdagochtend noteerde het pond zelfs 1,197 euro."
                            }
                        ]
                    },
                    {
                        "sense_id": "6dedc4e2-741a-3df9-a25a-c9631d467e22",
