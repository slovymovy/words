    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "70d1dc87-7c26-32de-906f-3f985eb6a338",
                    "sense_definition": "gebrek aan zelfvertrouwen hebben of twijfelen aan jezelf",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "persoonlijke_staat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij voelt zich erg <w>onzeker</w> over haar nieuwe baan en haar capaciteiten.",
                            "target_lang_translations": {
                                "en": "She feels very <w>insecure</w> about her new job and her abilities.",
                                "ru": "Она чувствует себя очень <w>неуверенно</w> из-за новой работы и своих способностей."
                            }
                        },
                        {
                            "text": "Veel tieners zijn een beetje <w>onzeker</w> over hun uiterlijk tijdens de puberteit.",
                            "target_lang_translations": {
                                "en": "Many teenagers are a bit <w>insecure</w> about their appearance during puberty.",
                                "ru": "Многие подростки немного <w>неуверенны</w> в своей внешности в период полового созревания."
                            }
                        }
                    ],
                    "antonyms": [
                        "zeker"
                    ],
                    "common_phrases": [
                        "zich onzeker voelen",
                        "onzeker over jezelf"
                    ],
                    "target_lang_definitions": {
                        "en": "lacking self-confidence or doubting oneself",
                        "ru": "отсутствие уверенности в себе или сомнение в собственных силах"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insecure",
                                "target_lang_sense_clarification": "lacking confidence in oneself"
                            },
                            {
                                "target_lang_word": "uncertain",
                                "target_lang_sense_clarification": "not sure about oneself"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неуверенный",
                                "target_lang_sense_clarification": "о человеке, сомневающемся в себе"
                            },
                            {
                                "target_lang_word": "закомплексованный",
                                "target_lang_sense_clarification": "имеющий внутренние барьеры и неуверенность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e9048ae-14a1-3336-bb31-808183d47350",
                    "sense_definition": "waarvan de afloop of de feiten niet vaststaan of twijfelachtig zijn",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "situatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De toekomst van het bedrijf is momenteel erg <w>onzeker</w> door de crisis.",
                            "target_lang_translations": {
                                "en": "The future of the company is currently very <w>uncertain</w> due to the crisis.",
                                "ru": "Будущее компании в настоящее время очень <w>неопределенно</w> из-за кризиса."
                            }
                        },
                        {
                            "text": "Het is nog een <w>onzekere</w> toekomst voor de werknemers van de fabriek.",
                            "target_lang_translations": {
                                "en": "It is still an <w>uncertain</w> future for the factory workers.",
                                "ru": "Для работников фабрики это все еще <w>неясное</w> будущее."
                            }
                        }
                    ],
                    "synonyms": [
                        "onwis"
                    ],
                    "antonyms": [
                        "gewis",
                        "zeker"
                    ],
                    "common_phrases": [
                        "een onzekere toekomst",
                        "een onzekere factor"
                    ],
                    "target_lang_definitions": {
                        "en": "where the outcome or facts are not fixed or are doubtful",
                        "ru": "ситуация, исход или факты которой не определены или вызывают сомнения"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uncertain",
                                "target_lang_sense_clarification": "not known or definite"
                            },
                            {
                                "target_lang_word": "precarious",
                                "target_lang_sense_clarification": "not securely held or in position; dangerously likely to fall or collapse"
                            },
                            {
                                "target_lang_word": "unstable",
                                "target_lang_sense_clarification": "prone to change or fail"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неопределенный",
                                "target_lang_sense_clarification": "о ситуации или будущем"
                            },
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "о фактах или исходе"
                            },
                            {
                                "target_lang_word": "шаткий",
                                "target_lang_sense_clarification": "о положении или статусе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6978f93c-299f-3ece-9194-ae81140c88ca",
                    "sense_definition": "niet duidelijk of niet met precisie vastgesteld",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "duidelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De getuige gaf een <w>onzeker</w> antwoord op de vraag van de rechter.",
                            "target_lang_translations": {
                                "en": "The witness gave a <w>hesitant</w> answer to the judge's question.",
                                "ru": "Свидетель дал <w>неуверенный</w> ответ на вопрос судьи."
                            }
                        },
                        {
                            "text": "Met een <w>onzekere</w> stem probeerde hij de situatie uit te leggen.",
                            "target_lang_translations": {
                                "en": "With a <w>shaky</w> voice, he tried to explain the situation.",
                                "ru": "<w>Неуверенным</w> голосом он попытался объяснить ситуацию."
                            }
                        }
                    ],
                    "antonyms": [
                        "zeker"
                    ],
                    "common_phrases": [
                        "een onzekere stem",
                        "onzeker antwoord"
                    ],
                    "target_lang_definitions": {
                        "en": "not clear or not established with precision",
                        "ru": "нечеткий, неясный или установленный без точности"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hesitant",
                                "target_lang_sense_clarification": "tentative or unsure in speech or action"
                            },
                            {
                                "target_lang_word": "shaky",
                                "target_lang_sense_clarification": "unsteady or trembling"
                            },
                            {
                                "target_lang_word": "vague",
                                "target_lang_sense_clarification": "not clearly expressed or defined"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неуверенный",
                                "target_lang_sense_clarification": "о голосе или ответе"
                            },
                            {
                                "target_lang_word": "колеблющийся",
                                "target_lang_sense_clarification": "выражающий нерешительность"
                            },
                            {
