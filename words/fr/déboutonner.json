                    "sense_definition": "Ouvrir un vêtement en faisant sortir les boutons des boutonnières.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait chaud dans la pièce, alors il commence à <w>déboutonner</w> sa veste."
                        },
                        {
                            "text": "Elle a du mal à <w>déboutonner</w> son manteau avec ses gants épais."
                        }
                    ],
