                ],
                "senses": [
                    {
                        "sense_id": "d976ee9c-5aca-3923-abbc-7b49cdbbaf9c",
                        "entry_id": "8a372547-df20-3c95-b21e-a3005a124206",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfff0e49-ce61-4401-a1ee-0a194b0ba436",
                                "sense_id": "d976ee9c-5aca-3923-abbc-7b49cdbbaf9c",
                                "text": "Der Habedank trägt nie die Schals, die die Habedank ihm strickt."
                            },
                            {
                                "example_id": "9e28ff0b-88fb-4d02-906d-8204263cb8ab",
                                "sense_id": "d976ee9c-5aca-3923-abbc-7b49cdbbaf9c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Habedank kommt, geht der Herr Habedank.“"
                            },
                            {
                                "example_id": "39d58557-9aa0-4f88-a50d-178da10c323d",
                                "sense_id": "d976ee9c-5aca-3923-abbc-7b49cdbbaf9c",
                                "text": "Habedank kommt und geht."
                            },
                            {
                                "example_id": "35062214-7cda-43b9-b84b-ff06b3afafdd",
                                "sense_id": "d976ee9c-5aca-3923-abbc-7b49cdbbaf9c",
                                "text": "Habedanks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "33b7e17c-0b07-4d3f-b861-249d22633b7e",
                                "sense_id": "d976ee9c-5aca-3923-abbc-7b49cdbbaf9c",
                                "text": "Die Habedanks fahren heute nach Kiel."
                            },
                            {
                                "example_id": "ae41ba6b-ac14-4103-a144-82d20e24c6f7",
                                "sense_id": "d976ee9c-5aca-3923-abbc-7b49cdbbaf9c",
                                "text": "Frau Habedank ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fdd8bdb0-2dd4-4f90-9793-fdb15599d293",
                                "sense_id": "d976ee9c-5aca-3923-abbc-7b49cdbbaf9c",
                                "text": "Herr Habedank wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
