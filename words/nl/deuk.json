                },
                {
                    "sense_id": "0d9bc2e2-dc3d-37b3-9f00-c8e5ba4c9cc5",
                    "sense_definition": "De tweede persoon enkelvoud tegenwoordige tijd in inversie van het werkwoord <w>deuken</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>deuk</w> je die metalen doos zo wild in?",
                            "target_lang_translations": {
                                "en": "Why are you <w>denting</w> that metal box so wildly?"
                            }
                        },
                        {
                            "text": "Als je daar hard op drukt, <w>deuk</w> je het materiaal onherstelbaar.",
                            "target_lang_translations": {
                                "en": "If you press hard on that, you will <w>dent</w> the material irreparably."
                            }
                        }
                    ],
                    "traits": [
