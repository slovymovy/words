                    {
                        "translation_id": "93a223db-56d8-4309-a9e1-b523f2b6402e",
                        "source_entry_id": "a60b8679-4076-3cfc-9b3a-f6d71a1d4138",
                        "target_lang_word": "Гамбург",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Гамбург",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "efbfd4ed-1b79-31a1-a3e4-2ebe9a59d33c",
                                        "entry_id": "ef7c521e-f485-31c6-af40-90abfd96ab8f",
                                        "glosses": [
                                            "город на севере Германии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "209f64a9-eb21-4779-9a3b-c9e17d02cd87",
                                                "sense_id": "efbfd4ed-1b79-31a1-a3e4-2ebe9a59d33c",
                                                "text": "В январе 1997 года во время концертной поездки по Германии я впервые попал в Гамбург, который сразу же поразил меня сходством с моим родным Питером."
                                            },
                                            {
                                                "example_id": "9c822977-a49d-49fd-a640-59f51a7b3252",
                                                "sense_id": "efbfd4ed-1b79-31a1-a3e4-2ebe9a59d33c",
                                                "text": "Мои родители вообще были домоседами и не любили больших передвижений, но тут их соблазнило приглашение дяди Кости принять участие в небольшой поездке по северу Европы, и в течение трех недель мы побывали в Стокгольме, Копенгагене, Гамбурге и в Берлине."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
