                                        "sense_id": "8ab087ab-e6e9-31be-a090-9079e10fb125",
                                        "entry_id": "3471edc3-8efd-3142-b3ef-49a583863b83",
                                        "glosses": [
                                            "To inflict trouble or harm on another in return, typically the same as that inflicted on oneself."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34bbb24c-f9d0-47a2-8930-8d634c200aad",
                                                "sense_id": "8ab087ab-e6e9-31be-a090-9079e10fb125",
                                                "text": "But I warn you, Anita, we're through. I'm through with all of you! I'll get even. Just wait! You'll be sorry! You fools! You...YOU IDIOTS!"
                                            },
                                            {
                                                "example_id": "3b624c7a-0e6c-46ff-b18e-356e692bc78e",
                                                "sense_id": "8ab087ab-e6e9-31be-a090-9079e10fb125",
                                                "text": "Pinkerton man, murdering bastard / I’m gonna get even, get even with you"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
