                                "target_senses": [
                                    {
                                        "sense_id": "f38d36df-7906-3da4-982a-9b5c43e9e1c8",
                                        "entry_id": "8b401a66-138b-3efd-b4a3-e9e4c6a3ffdb",
                                        "glosses": [
                                            "Celui qui vient consulter ou qui demande un conseil dans une consultation."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b7e98a4-62e6-447a-b9f6-b76f6136e4d5",
                                                "sense_id": "f38d36df-7906-3da4-982a-9b5c43e9e1c8",
                                                "text": "L'assistance médicale était organisée ; les infirmeries indigènes, créées dans chacun de nos postes, voyaient affluer, chaque jour, des centaines de consultants dont certains venaient se faire panser les blessures reçues en nous combattant ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c333aa-fbe7-3abd-a99d-ad6ffb7bdeb3",
                                        "entry_id": "8b401a66-138b-3efd-b4a3-e9e4c6a3ffdb",
                                        "glosses": [
                                            "Celui qui fait profession de donner avis et conseil, en particulier auprès d’une entreprise, pour la gestion de celle-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed873ba-d799-4e2c-ab7e-4deb35250a54",
                                                "sense_id": "26c333aa-fbe7-3abd-a99d-ad6ffb7bdeb3",
                                                "text": "J’ai cru comprendre qu’il était « expert ». À présent, tout le monde est expert ou consultant."
                                            },
                                            {
                                                "example_id": "845b8039-a5b0-4bc1-be5f-4c9138114eed",
                                                "sense_id": "26c333aa-fbe7-3abd-a99d-ad6ffb7bdeb3",
                                                "text": "On dirait que plus les politiciens parlent pour ne rien dire, plus ils ont besoin d’experts en communication.\n C’est même, dirait-on, l’unique rôle de ces consultants : s’assurer que leurs clients disent le minimum de choses dans un maximum de mots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71a7afb2-6976-3419-9a8c-cd77ab9b1a01",
                                        "entry_id": "8b401a66-138b-3efd-b4a3-e9e4c6a3ffdb",
                                        "glosses": [
                                            "Ancien sportif invité pour commenter un match ou l'actualité sportive. → voir joueurnaliste"
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": []
                                    }
                                ]
