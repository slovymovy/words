                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "091b89a8-22f8-47c2-9c8b-da055b7aa6a9",
                                "sense_id": "b63b1e10-75aa-3785-b44e-c915664ecc79",
                                "text": "Et sa beauté, n’étant pas d’expression et de grâce, mais une vraie beauté sterling et pittoresque, ne perdait presque rien à l’état d’évanouissement."
                            }
                        ]
                    }
                ],
