                ],
                "senses": [
                    {
                        "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                        "entry_id": "cf5c5370-1592-332a-b61d-c80c0b07c0f2",
                        "glosses": [
                            "übertriebene (krankhafte) Selbstliebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a24827c-ad59-4477-9cad-943b844bca85",
                                "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                                "text": "Narzissmus ist nicht nur Selbstliebe, denn er geht Hand in Hand mit mangelndem Mitgefühl für und fehlender Solidarität mit anderen."
                            },
                            {
                                "example_id": "3c49c4f9-9af3-471d-8534-2f93bfc73d70",
                                "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                                "text": "„Auffällig erschien dem Gutachter der Narzissmus des Angeklagten.“"
                            },
                            {
                                "example_id": "c330a0bb-64ec-4a50-a087-37175d7db3a5",
                                "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                                "text": "„Bis dahin war alles beherrscht gewesen von Narzissmus und Exhibitionismus, seltsam leblos, trotz der Kühnheit und der Zurschaustellung von Energie.“"
                            },
                            {
                                "example_id": "12b10f27-6f53-4a94-b0df-550fed36644d",
                                "sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                                "text": "„Weiterhin zeichnet solche Personen ein hoher Grad an Verantwortungslosigkeit, Angst, Schuldgefühlen, Perfektionismus und Narzissmus aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc9ff5d0-b38d-4f82-b80b-f464be7ab591",
                        "source_entry_id": "cf5c5370-1592-332a-b61d-c80c0b07c0f2",
                        "source_sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                        "source_sense_description": "Psychologie: übertriebene (krankhafte) Selbstliebe",
                        "target_lang_word": "narcissism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "narcissism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "834efcbc-5cd9-3c3d-bca5-222d06ab46c0",
                                        "entry_id": "3be2e899-bf2d-303e-80c4-5f548cc2ec31",
                                        "glosses": [
                                            "Excessive love of oneself."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87ce80f0-810f-4167-9f09-ca7882ee2c6b",
                                                "sense_id": "834efcbc-5cd9-3c3d-bca5-222d06ab46c0",
                                                "text": "Although the researchers found that, on average, narcissism gradually declined as people aged, “the results show that this decline is not as large as one might hope,” said Ulrich Orth, the lead author of the paper and a professor of developmental psychology at the University of Bern in Switzerland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a330ce4-10c8-3900-ae0e-e7e1ef6c04e8",
                                        "entry_id": "3be2e899-bf2d-303e-80c4-5f548cc2ec31",
                                        "glosses": [
                                            "Sexual desire for one's own body."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01119a91-03d1-4c14-ad67-5597a5d744dc",
                        "source_entry_id": "cf5c5370-1592-332a-b61d-c80c0b07c0f2",
                        "source_sense_id": "fcb7716c-b08e-3075-b7aa-d75438bc7e9d",
                        "source_sense_description": "Psychologie: übertriebene (krankhafte) Selbstliebe",
