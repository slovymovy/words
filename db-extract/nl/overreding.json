                "senses": [
                    {
                        "sense_id": "3d126218-346a-308b-94ef-5c40889b1737",
                        "entry_id": "bea93e40-1472-3cbc-9daa-7c015cd10e9b",
                        "glosses": [
                            "het vermogen om iemand te overtuigen van je gelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c952467a-d07d-455a-8733-a596ddb43bf9",
                                "sense_id": "3d126218-346a-308b-94ef-5c40889b1737",
                                "text": "'Alleen door overreding hebben wij voetje voor voetje terrein gewonnen, totdat eindelijk de angst voor het nieuwe zich heeft moeten overgeven', citeerde de koning haar."
                            },
                            {
                                "example_id": "8b7f36d5-e2ef-41dd-a6c4-6aa884e19e20",
                                "sense_id": "3d126218-346a-308b-94ef-5c40889b1737",
                                "text": "De onderzoekers vinden dat Al Fitrah haar visie op autoritaire wijze aan de kinderen leert, maar dat dit wordt gedaan door middel van overreding, en niet door dwang."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f12dedb8-85e0-476f-8f2f-c394ab230235",
                        "source_entry_id": "bea93e40-1472-3cbc-9daa-7c015cd10e9b",
                        "source_sense_id": "3d126218-346a-308b-94ef-5c40889b1737",
                        "target_lang_word": "persuasion",
