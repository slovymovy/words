                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4470dc6-7b60-46ce-8f06-66735a2c141f",
                                                "sense_id": "85eca821-814d-3c24-8d12-1fe952110a99",
                                                "text": "ci sono alcuni aspetti di questa storia che non mi sono chiari"
                                            },
                                            {
                                                "example_id": "14f80763-4eea-49cf-9025-6db798e18e98",
                                                "sense_id": "85eca821-814d-3c24-8d12-1fe952110a99",
                                                "text": "l'ascesa alla montagna, vista come superamento delle difficoltà della vita, è un altro aspetto dell'escursionismo alpino"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "351c6a86-c5df-34bb-a5e8-e16ca6a067bb",
                                        "entry_id": "f0517f9a-49a7-377d-a823-bc699cbaf0a1",
