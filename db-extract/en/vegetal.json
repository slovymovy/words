                "senses": [
                    {
                        "sense_id": "b8bb691a-a818-3024-a04a-3652a0899cab",
                        "entry_id": "9e2de049-3801-371c-a98b-af51a28c8944",
                        "glosses": [
                            "Capable of growth and reproduction, but not feeling or reason (often opposed to sensible and rational)."
                        ],
                        "tags": [
                            "archaic",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ec80430c-e7e9-492c-a5f9-fb0f67c1cfd0",
                                "sense_id": "b8bb691a-a818-3024-a04a-3652a0899cab",
                                "text": "Which although it be denominated from men, and most evident in them, yet it extends and shows itself in vegetal and sensible creatures […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "eee5311e-5a30-3bfd-8287-c824c715bf26",
                        "entry_id": "9e2de049-3801-371c-a98b-af51a28c8944",
                        "glosses": [
                            "Pertaining to vegetables or plants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f18c2157-368a-4d9d-a2eb-ddd34ade415d",
                                "sense_id": "eee5311e-5a30-3bfd-8287-c824c715bf26",
                                "text": "The landscape of vegetal life is weird—no forests, no meadows, no green hills, no foliage, but clublike stems of plants armed with stilettos."
                            },
                            {
                                "example_id": "5f02db33-b0f3-40b1-b947-58f5f2ddac1b",
                                "sense_id": "eee5311e-5a30-3bfd-8287-c824c715bf26",
                                "text": "The Computer Center is muffled and dim, warm with whiffs of sourness, of body odor, and of the vegetal smells of dirt embedded in clothes that were advancing in the direction of compost."
                            }
                        ]
                    },
                    {
                        "sense_id": "a780300f-bcad-329e-b656-10106ebe07ef",
                        "entry_id": "9e2de049-3801-371c-a98b-af51a28c8944",
                        "glosses": [
                            "Having a grassy, herbaceous taste."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e0b9319-8503-4acf-b590-1f1c49098cf5",
