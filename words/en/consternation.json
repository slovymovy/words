                    "sense_id": "0bfb025a-8b7b-3283-a5dd-26c765ee34b4",
                    "sense_definition": "A feeling of anxiety, shock, or confusion caused by something unexpected.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of the sudden resignation was met with <w>consternation</w> by the entire staff.",
                            "target_lang_translations": {
                                "ru": "Новость о внезапной отставке была встречена всем коллективом с глубоким <w>замешательством</w>."
                            }
                        },
                        {
                            "text": "To the <w>consternation</w> of his parents, he decided to drop out of university.",
                            "target_lang_translations": {
                                "ru": "К великому <w>ужасу</w> своих родителей, он решил бросить университет."
                            }
                        }
                    ],
                    "synonyms": [
                        "dismay",
                        "alarm",
                        "bewilderment"
                    ],
                    "antonyms": [
                        "composure",
                        "calm"
                    ],
                    "common_phrases": [
                        "much to the consternation"
                    ],
                    "target_lang_definitions": {
