                        "fr": "Avoir subitement peur à la suite d'un événement inattendu"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be startled",
                                "target_lang_sense_clarification": "to be suddenly surprised or shocked"
                            },
                            {
                                "target_lang_word": "get a fright",
                                "target_lang_sense_clarification": "to experience a sudden feeling of fear"
                            },
                            {
                                "target_lang_word": "be frightened",
                                "target_lang_sense_clarification": "to become afraid"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sursauter",
