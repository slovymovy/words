                                    {
                                        "sense_id": "a020a452-67a9-3706-bcd7-a063c1b9c8fd",
                                        "entry_id": "d125865e-3d5b-3882-9c09-03abd20f93da",
                                        "glosses": [
                                            "knobbelachtige zwelling van aders in het onderste deel van de endeldarm en in de anus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2cc8799-28a5-43d9-a566-07b5d7059437",
                                                "sense_id": "a020a452-67a9-3706-bcd7-a063c1b9c8fd",
                                                "text": "Een aambei kan pijn doen bij zitten of bij het naar de wc gaan."
                                            },
                                            {
                                                "example_id": "6e51f990-090b-49f3-9e6c-0dd6962ec306",
                                                "sense_id": "a020a452-67a9-3706-bcd7-a063c1b9c8fd",
                                                "text": "Een aambei kan bloeden."
                                            },
                                            {
                                                "example_id": "2730807e-7d89-49fc-b9bb-bc4c679aa3d0",
                                                "sense_id": "a020a452-67a9-3706-bcd7-a063c1b9c8fd",
                                                "text": "Een aambei kan ontstaan door hard persen bij het naar de wc gaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61a42714-48db-493d-8dfa-bcd4f5a44976",
                        "source_entry_id": "1dc55cd1-914d-3fda-9915-24911f248477",
                        "source_sense_id": "33e14f2d-bc50-361a-9e9a-cd1f9003cd68",
                        "source_sense_description": "perianal varicosity",
                        "target_lang_word": "hémorroïde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hémorroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45d32347-57a7-3ddd-aada-68ee1146713a",
                                        "entry_id": "756b4aae-9721-34a1-b6fd-4a78805d1bbd",
                                        "glosses": [
                                            "Complexe vasculaire au niveau de l’anus et présent dès la naissance, constitué d’un lac sanguin associé à de petits vaisseaux veineux et artériels."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbd51ba0-d21a-310e-b34e-12cbb989918a",
                                        "entry_id": "756b4aae-9721-34a1-b6fd-4a78805d1bbd",
                                        "glosses": [
                                            "Maladie touchant les hémorroïdes, constituée d’une varice arrondie et douloureuse qui se forme au pourtour de l’anus, et qui peut laisser échapper de temps à autre une certaine quantité de sang."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e63f2aa-1540-4652-938e-92c0270cf5b7",
                                                "sense_id": "fbd51ba0-d21a-310e-b34e-12cbb989918a",
                                                "text": "Une hémorroïde interne."
                                            },
                                            {
                                                "example_id": "8d8c3d69-b7f5-439e-b529-cb4c076159c5",
                                                "sense_id": "fbd51ba0-d21a-310e-b34e-12cbb989918a",
                                                "text": "Ses hémorroïdes se sont ouvertes et il perd beaucoup de sang."
                                            },
                                            {
                                                "example_id": "076aaa49-88b5-4b59-90fb-a22c892d786f",
                                                "sense_id": "fbd51ba0-d21a-310e-b34e-12cbb989918a",
                                                "text": "Avoir des hémorroïdes."
                                            },
                                            {
                                                "example_id": "dbdfd99c-070a-4467-ae49-a72365cecd65",
                                                "sense_id": "fbd51ba0-d21a-310e-b34e-12cbb989918a",
                                                "text": "On discernait sur la photo la veine gonflée de son hémorroïde."
                                            },
                                            {
                                                "example_id": "a6a91630-532a-4875-a9eb-e37b50edbbbe",
                                                "sense_id": "fbd51ba0-d21a-310e-b34e-12cbb989918a",
                                                "text": "Et Pompidou mourait brusquement, qu’on ne croyait atteint que d’hémorrhoïdes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a494868-1b22-405f-9be2-b415024b858c",
                        "source_entry_id": "1dc55cd1-914d-3fda-9915-24911f248477",
                        "source_sense_id": "33e14f2d-bc50-361a-9e9a-cd1f9003cd68",
                        "source_sense_description": "perianal varicosity",
                        "target_lang_word": "Hämorrhoide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hämorrhoide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73908ac2-95b1-3e06-be3c-05f1729d4a2e",
                                        "entry_id": "47caef05-ff89-325c-b09a-5ec649d7c654",
                                        "glosses": [
                                            "„knotenförmig hervortretende Erweiterung der Mastdarmvenen um den After herum“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "677f2af4-ad84-4fe8-9293-f39259a20b7e",
                                                "sense_id": "73908ac2-95b1-3e06-be3c-05f1729d4a2e",
                                                "text": "„Wenn eine Hämorrhoide durchhängt, lassen sich die Symptome manchmal durch einfaches zurückschieben hinter den Anus beheben.“"
                                            },
                                            {
                                                "example_id": "c93d46fa-8990-4557-84c7-f44340866476",
                                                "sense_id": "73908ac2-95b1-3e06-be3c-05f1729d4a2e",
                                                "text": "„Nach zwei bis drei Tagen trieben diese Luft und der Hunger die Menschen wieder nach oben, obwohl es kaum leicht war, sich in diesem Zustand anzukleiden, seine Hämorrhoiden in Ordnung zu bringen und die Stiegen emporzutaumeln, emporzuwanken.“"
                                            },
                                            {
                                                "example_id": "bf9ed2ca-2ccb-4280-9d14-d6ac35e02453",
                                                "sense_id": "73908ac2-95b1-3e06-be3c-05f1729d4a2e",
                                                "text": "„Zweimal hatte er dem Mann im vergangenen Jahr die Hämorrhoiden weggeschnitten, und seine untere wie seine obere Öffnung waren gleichermaßen unappetitlich.“"
                                            },
                                            {
                                                "example_id": "888437f2-bae5-4912-a621-6670dbc5b53c",
                                                "sense_id": "73908ac2-95b1-3e06-be3c-05f1729d4a2e",
                                                "text": "„Seit meiner Haft unter den Bleidächern litt ich unter inneren Hämorrhoiden, die mir drei- oder viermal jedes Jahr Beschwerden machten; doch in Petersburg wurden sie ernsthaft.“"
                                            },
                                            {
                                                "example_id": "b887c6fc-d587-4efc-a256-3052bf28762f",
                                                "sense_id": "73908ac2-95b1-3e06-be3c-05f1729d4a2e",
                                                "text": "„Foureau beschwerte sich über die Aloëpillen , die ihm Hämorrhoiden verursachten, Bouvard bekam Magendrücken und Pécuchet furchtbare Kopfschmerzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
