{
    "word_family": [
        "cloth",
        "clothe",
        "clothier",
        "clothes",
        "unclothed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "314a0c97-c132-3df0-a0cc-3dd6e5253507",
                    "sense_definition": "Items worn to cover the body, such as shirts, pants, and coats.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should wear warm <w>clothing</w> when it is cold outside.",
                            "target_lang_translations": {
                                "ru": "Тебе следует носить теплую <w>одежду</w>, когда на улице холодно.",
                                "zh": "外面冷的时候，你应该穿暖和的<w>衣服</w>。"
                            }
                        },
                        {
                            "text": "A shirt is an article of <w>clothing</w> that covers the torso and arms.",
                            "target_lang_translations": {
                                "ru": "Рубашка — это предмет <w>одежды</w>, который закрывает туловище и руки.",
                                "zh": "衬衫是一种覆盖躯干和手臂的<w>服装</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clothes",
                        "attire",
                        "apparel",
                        "garment"
                    ],
                    "common_phrases": [
                        "warm clothing",
                        "article of clothing",
                        "clothing brand",
                        "protective clothing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предметы, надеваемые на тело, такие как рубашки, брюки и пальто.",
                        "zh": "穿在身上遮盖身体的物品，如衬衫、裤子和外套。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одежда",
                                "target_lang_sense_clarification": "предметы гардероба"
                            },
                            {
                                "target_lang_word": "вещи",
                                "target_lang_sense_clarification": "разговорное, предметы одежды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衣服",
                                "target_lang_sense_clarification": "通称，指穿在身上的各种物品"
                            },
                            {
                                "target_lang_word": "服装",
                                "target_lang_sense_clarification": "较正式的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0068d63-04b0-3035-8d67-a16b39c52ed7",
                    "sense_definition": "The act of putting clothes on someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>clothing</w> of the actors took place backstage before the show.",
                            "target_lang_translations": {
                                "ru": "<w>Одевание</w> актеров происходило за кулисами перед представлением.",
                                "zh": "演员们在演出前在后台进行<w>穿衣</w>准备。"
                            }
                        },
                        {
                            "text": "Ritual <w>clothing</w> of the statues is a traditional ceremony in this region.",
                            "target_lang_translations": {
                                "ru": "Ритуальное <w>облачение</w> статуй — традиционная церемония в этом регионе.",
                                "zh": "为雕像进行仪式性的<w>装扮</w>是该地区的一种传统仪式。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clothing and unclothing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по надеванию одежды на кого-либо или что-либо.",
                        "zh": "给某人或某物穿上衣服的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одевание",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "облачение",
                                "target_lang_sense_clarification": "торжественное или ритуальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿衣",
                                "target_lang_sense_clarification": "动作过程"
                            },
                            {
                                "target_lang_word": "装扮",
                                "target_lang_sense_clarification": "指为某人或某物进行穿戴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3b504bd-0443-3dfc-a62a-55fa99b16a93",
                    "sense_definition": "A covering of non-conducting material on a boiler or steam chamber to prevent heat loss.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing_technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boiler requires new <w>clothing</w> to maintain its thermal efficiency.",
                            "target_lang_translations": {
                                "ru": "Котлу требуется новая <w>обшивка</w> для поддержания тепловой эффективности.",
                                "zh": "锅炉需要新的<w>外壳</w>来保持其热效率。"
                            }
                        },
                        {
                            "text": "Inspect the thermal <w>clothing</w> on the pipes for any signs of wear.",
                            "target_lang_translations": {
                                "ru": "Осмотрите тепловую <w>изоляцию</w> на трубах на наличие признаков износа.",
                                "zh": "检查管道上的<w>保温层</w>是否有磨损迹象。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытие из непроводящего материала на котле или паровой камере для предотвращения потери тепла.",
                        "zh": "锅炉或蒸汽室上覆盖的非导电材料，用于防止热量散失。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обшивка",
                                "target_lang_sense_clarification": "техническое покрытие"
                            },
                            {
                                "target_lang_word": "изоляция",
                                "target_lang_sense_clarification": "теплоизоляция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外壳",
                                "target_lang_sense_clarification": "技术上的覆盖层"
                            },
                            {
                                "target_lang_word": "保温层",
                                "target_lang_sense_clarification": "指防止热量散失的材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db2f2cb2-478d-382a-8805-de1ba37d3be5",
                    "sense_definition": "The art or process of making cloth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient guild controlled the trade and <w>clothing</w> of wool in the city.",
                            "target_lang_translations": {
                                "ru": "Древняя гильдия контролировала торговлю и <w>выделку</w> шерсти в городе.",
                                "zh": "古代行会控制着城里的羊毛贸易和<w>纺织</w>。"
                            }
                        },
                        {
                            "text": "He studied the mechanics of <w>clothing</w> in the old textile mill.",
                            "target_lang_translations": {
                                "ru": "Он изучал механику <w>производства ткани</w> на старой текстильной фабрике.",
                                "zh": "他在旧纺织厂研究<w>纺织</w>机械。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical usage referring to manufacturing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство или процесс изготовления ткани.",
                        "zh": "制造布料的艺术或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сукноделие",
                                "target_lang_sense_clarification": "устаревшее, изготовление сукна"
                            },
                            {
                                "target_lang_word": "выделка ткани",
                                "target_lang_sense_clarification": "процесс производства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纺织",
                                "target_lang_sense_clarification": "制造布料的工艺"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a3a8b4d-6747-349b-bf54-7a018dd1e0f7",
                    "sense_definition": "Present participle of <w>clothe</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothe_verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity is dedicated to feeding and <w>clothing</w> the poor in our community.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация занимается кормлением и <w>одеванием</w> бедных в нашем сообществе.",
                                "zh": "这家慈善机构致力于为我们社区的穷人提供食物和<w>衣物</w>。"
                            }
                        },
                        {
                            "text": "She is <w>clothing</w> the baby in a soft cotton onesie for the night.",
                            "target_lang_translations": {
                                "ru": "Она <w>одевает</w> ребенка в мягкий хлопковый комбинезон на ночь.",
                                "zh": "她正在给婴儿<w>穿上</w>一件柔软的棉质连体衣准备过夜。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола clothe (одевать).",
                        "zh": "动词 clothe（给……穿衣）的现在分词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одевать",
                                "target_lang_sense_clarification": "глагол"
                            },
                            {
                                "target_lang_word": "одевание",
                                "target_lang_sense_clarification": "отглагольное существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "给……穿衣",
                                "target_lang_sense_clarification": "动词短语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}