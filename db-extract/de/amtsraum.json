                        "glosses": [
                            "Raum, in dem jemand seinen Dienst verrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67191a70-bd3d-453f-92ed-d113c9d5cebf",
                                "sense_id": "697348a4-465a-3f52-a80c-5f40b65cf5f7",
                                "text": "„Zu dieser Zeit konnte man ihn in seinen Amtsräumen noch nicht erwarten, so daß er den Antritt seines Dienstes darüber nicht versäumte.“"
                            },
                            {
                                "example_id": "3344ed39-206c-4c52-b921-660a2cb9fbde",
                                "sense_id": "697348a4-465a-3f52-a80c-5f40b65cf5f7",
                                "text": "„Miss Brown führte ihn in ein Arbeitszimmer, das fast wie ein Amtsraum aussah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
