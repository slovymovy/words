                    {
                        "sense_id": "75d5d1cd-338c-3ece-81ba-3a49ae0f7131",
                        "entry_id": "3c65efcd-c725-39d0-b027-4aeb8866bb34",
                        "glosses": [
                            "Zustand/Möglichkeit, sich berichtigen zu lassen, vom Falschen zum Richtigen veränderbar zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8351099-c194-4013-b28e-0a9a6eede84b",
                                "sense_id": "75d5d1cd-338c-3ece-81ba-3a49ae0f7131",
                                "text": "„Dieser Unterschied ist nämlich für die Korrigierbarkeit geldpolitischer Auswirkungen schuldenpolitischer Entscheidungen von großer Bedeutung.“"
                            },
                            {
                                "example_id": "e2efa5ff-bc3f-42a7-9457-77749b2efe13",
                                "sense_id": "75d5d1cd-338c-3ece-81ba-3a49ae0f7131",
                                "text": "„Denn in diesen Fällen besteht doch gerade die Einspruchsmöglichkeit und damit die Korrigierbarkeit einer unrichtigen Entscheidung, womit letztlich das rechtsstaatliche Verfahren wieder gewährleistet erscheint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
