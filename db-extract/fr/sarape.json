                "senses": [
                    {
                        "sense_id": "ba186e0f-46cd-3118-84f1-3e236797f89c",
                        "entry_id": "38f8a567-1b82-3df1-b803-217b3a47919a",
                        "glosses": [
                            "Grande pièce de tissu multicolore, originellement en laine, qui fait partie du costume traditionnel de certaines populations d’Amérique du Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d44e2fad-71f9-4e6c-a4a1-98a3820cb8e4",
                                "sense_id": "ba186e0f-46cd-3118-84f1-3e236797f89c",
                                "text": "Bien plus tard, au cœur de la nuit, il retrouva Ahiga, pelotonné dans un sarape de laine."
                            },
                            {
                                "example_id": "8eaa803a-368b-452c-b7c2-1b4a61bc8299",
                                "sense_id": "ba186e0f-46cd-3118-84f1-3e236797f89c",
                                "text": "Ils allaient au bal, enveloppés dans des sarapes, après avoir bu du mezcal."
                            },
                            {
                                "example_id": "02929953-cf8a-4870-abfd-9135cd5b44f7",
                                "sense_id": "ba186e0f-46cd-3118-84f1-3e236797f89c",
                                "text": "Les petits descendants d’Incas vivent en très modernes salopettes bleues baptisées “overols”, au rebours des petits descendants d’Aztèques fidèles au sarape sur l’épaule."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4add83bb-e831-456e-a1fd-87399450e08c",
                        "source_entry_id": "38f8a567-1b82-3df1-b803-217b3a47919a",
                        "source_sense_id": "ba186e0f-46cd-3118-84f1-3e236797f89c",
                        "target_lang_word": "serape",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "serape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59d1edb7-8771-3c02-ad13-f4ff4cbbcc15",
                                        "entry_id": "fbebd373-f8e6-37bc-ab84-7a912be76ec5",
                                        "glosses": [
                                            "A type of blanket worn as a cloak, especially by Spanish-Americans, or used as a saddle blanket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b921423c-d1da-4422-a3fd-cb5df5f9124c",
                                                "sense_id": "59d1edb7-8771-3c02-ad13-f4ff4cbbcc15",
                                                "text": "R. C. Gorman's painting depicts a tall woman wrapped in a serape in Joanie's beloved Southwest, standing in a canyon at night."
                                            },
                                            {
                                                "example_id": "2bb1d542-20de-4185-b0f3-f8972f424009",
                                                "sense_id": "59d1edb7-8771-3c02-ad13-f4ff4cbbcc15",
                                                "text": "Could be, said John Grady. He took off his hat and lay back and pulled the serape over him."
                                            },
                                            {
                                                "example_id": "1084bdd1-d0b0-4a02-801c-446e0a7182f1",
                                                "sense_id": "59d1edb7-8771-3c02-ad13-f4ff4cbbcc15",
                                                "text": "The serape was an item of Mexican dress that was worn by almost all classes. Made of wool dyed in bright colors and woven either in geometric patterns or plain with borders, a serape was a blanket used as a wrap, and due to the fabric's texture and tight weave, it was almost waterproof.[…]A serape was also used as a pillow, mattress, or cover, as well as a saddle blanket. Another body covering, the poncho, was similar to the serape but more rounded and not necessarily woven of wool."
                                            },
                                            {
                                                "example_id": "fc7e5d0b-05e2-412d-9fac-1aab7977b8a8",
                                                "sense_id": "59d1edb7-8771-3c02-ad13-f4ff4cbbcc15",
                                                "text": "“Diego, my son, fill your serape with the red roses growing at your feet and take them to the bishop,” she told him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
