    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8fff97fd-a5ce-35a5-aff4-f82da075a046",
                    "sense_definition": "Discuter les conditions d'un accord, d'un contrat ou d'une affaire pour parvenir à une entente.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise tente de <w>négocier</w> un accord avantageux avec ses nouveaux partenaires commerciaux."
                        },
                        {
                            "text": "Il refuse d'acheter cette voiture sans <w>négocier</w> un prix plus raisonnable avec le vendeur."
                        }
                    ],
                    "synonyms": [
                        "débattre",
                        "marchander",
                        "traiter"
                    ],
                    "common_phrases": [
                        "négocier un accord",
                        "négocier un contrat",
                        "négocier un prix"
                    ]
                },
                {
                    "sense_id": "b5210652-de75-3039-922c-d56211b0596d",
                    "sense_definition": "Franchir ou aborder avec adresse un obstacle, un virage ou une situation délicate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a ralenti prudemment pour <w>négocier</w> un virage particulièrement serré dans la montagne."
                        },
                        {
                            "text": "Le guide de haute montagne a su <w>négocier</w> un passage difficile sur la paroi rocheuse."
                        }
                    ],
                    "synonyms": [
                        "aborder",
                        "franchir"
                    ],
                    "common_phrases": [
                        "négocier un virage",
                        "négocier un passage difficile"
                    ]
                },
                {
                    "sense_id": "a39cb60f-263f-3e29-8e94-9df1e42a756a",
                    "sense_definition": "Vendre, acheter ou échanger des titres, des effets de commerce ou des valeurs sur un marché.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'investisseur souhaite <w>négocier</w> des actions en bourse pour diversifier son portefeuille financier."
                        },
                        {
                            "text": "Cette banque d'affaires a pu <w>négocier</w> des titres souverains sur les marchés internationaux."
                        }
                    ],
                    "synonyms": [
                        "échanger",
                        "vendre"
                    ],
                    "common_phrases": [
                        "négocier des actions",
                        "négocier des titres"
                    ]
                }
            ]
        }
    ]
