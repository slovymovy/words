{
    "word_family": [
        "incline",
        "inclination",
        "disinclined",
        "disinclination"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf35ccca-f85c-3815-8231-bb7e5345dfb4",
                    "sense_definition": "Having a natural tendency, preference, or likelihood to do or be something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hearing both sides of the story, I am <w>inclined</w> to believe your version of events.",
                            "target_lang_translations": {
                                "ru": "Выслушав обе стороны истории, я <w>склонен</w> верить вашей версии событий."
                            }
                        },
                        {
                            "text": "She is <w>inclined</w> to lose her temper when she is under a lot of stress at work.",
                            "target_lang_translations": {
                                "ru": "Она <w>склонна</w> выходить из себя, когда испытывает сильный стресс на работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "disposed",
                        "prone",
                        "predisposed",
                        "apt",
                        "liable",
                        "likely",
                        "tending"
                    ],
                    "antonyms": [
                        "disinclined"
                    ],
                    "common_phrases": [
                        "inclined to believe",
                        "inclined to think",
                        "naturally inclined"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий естественную склонность, предпочтение или вероятность что-либо сделать или чем-либо быть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонный",
                                "target_lang_sense_clarification": "имеющий предрасположенность к чему-либо"
                            },
                            {
                                "target_lang_word": "предрасположенный",
                                "target_lang_sense_clarification": "имеющий внутреннюю склонность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ede4ffb-6aad-31b6-878e-bc10c60352fa",
                    "sense_definition": "Positioned at an angle relative to a horizontal or vertical surface; slanted or sloping.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional take-off ramp was <w>inclined</w> at twenty degrees to help the skaters gain speed.",
                            "target_lang_translations": {
                                "ru": "Профессиональная рампа для взлета была <w>наклонена</w> под углом двадцать градусов, чтобы помочь скейтбордистам набрать скорость."
                            }
                        },
                        {
                            "text": "The architect designed an <w>inclined</w> plane to make the building accessible for wheelchair users.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал <w>наклонную</w> плоскость, чтобы сделать здание доступным для людей на инвалидных колясках."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inclined plane",
                        "inclined surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный под углом к горизонтальной или вертикальной поверхности; скошенный или наклонный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонный",
                                "target_lang_sense_clarification": "расположенный под углом"
                            },
                            {
                                "target_lang_word": "покатый",
                                "target_lang_sense_clarification": "имеющий уклон"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "815f55cf-3d45-337e-8a83-2ea1e4b79b85",
                    "sense_definition": "The simple past and past participle of <w>incline</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>inclined</w> his head slightly to show that he was listening to the speaker.",
                            "target_lang_translations": {
                                "ru": "Он слегка <w>наклонил</w> голову, чтобы показать, что слушает оратора."
                            }
                        },
                        {
                            "text": "The heavy rain had <w>inclined</w> the soil toward the bottom of the valley.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь <w>смыл</w> почву (создал уклон) к дну долины."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени глагола «incline» (наклонять, склонять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклонил",
                                "target_lang_sense_clarification": "о движении головы или тела"
                            },
                            {
                                "target_lang_word": "склонил",
                                "target_lang_sense_clarification": "побудил к чему-либо или наклонил"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}