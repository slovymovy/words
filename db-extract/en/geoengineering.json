                                        "sense_id": "a0b03ec9-8b91-3491-ba3d-097b2e41dd7c",
                                        "entry_id": "76a5e4c4-62f6-339e-b21d-580154b4917a",
                                        "glosses": [
                                            "opzettelijk grootschalig ingrijpen in de natuurlijke systemen van de aarde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "311cc950-c95a-4548-a855-05decf176f7d",
                                                "sense_id": "a0b03ec9-8b91-3491-ba3d-097b2e41dd7c",
                                                "text": "Geo-engineering, het bewust en grootscheeps ingrijpen in het klimaatsysteem van de aarde, bijvoorbeeld door zwavel in hogere luchtlagen te pompen, ijzer op oceanen om algengroei te stimuleren of spiegels in woestijnen om zonlicht terug te kaatsen, zou een matigende uitwerking op het klimaat kunnen hebben."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
