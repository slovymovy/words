                                                "sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                                                "text": "Die Raffinerie bekommt in den nächsten Wochen zwei Anbauten."
                                            },
                                            {
                                                "example_id": "0e20d56f-ab84-4dd7-a019-63ff12305deb",
                                                "sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                                                "text": "„Die ersten Raffinerien entstanden schon zum Beginn der Mineralöl-Ära, also Mitte des 19. Jahrhunderts.“"
                                            },
                                            {
                                                "example_id": "b557c681-3ff8-48e2-8276-2acc5dc0c219",
                                                "sense_id": "5813c800-67bb-333d-975f-32b314e41b08",
                                                "text": "„Kaum war das Hafengebiet mit den vielen Autoabgasen, dem Fabriksmog und den zahlreichen Motorrädern überstanden, kam ich an dem Gelände einer riesigen Raffinerie vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
