                        "quincaille"
                    ]
                },
                {
                    "sense_id": "3f8c4a0c-dee7-3614-abcb-2e381f17785d",
                    "sense_definition": "Ensemble hétéroclite de petits objets, de bibelots ou de bijoux sans grande valeur.",
