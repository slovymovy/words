                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "952bbf6a-6f4e-43bc-86ac-1e06cc6128cf",
                                                "sense_id": "6224f5ff-956b-3826-8e35-d79a7c1f6e15",
                                                "text": "Currently, the Palestinian territories are being featured, and the menu boasts treats like maftoul (a garlicky chicken and couscous dish) and tamar Hindi (chilled tamarind juice with rose water)."
                                            },
                                            {
                                                "example_id": "f4d32359-9c38-4103-a832-6de6a975491b",
                                                "sense_id": "6224f5ff-956b-3826-8e35-d79a7c1f6e15",
                                                "text": "He began to crack tamarinds, pulling out the pod flesh, adding sugar and black pepper from his palms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29325288-77ca-3d43-82f7-6975f2423eda",
                                        "entry_id": "80171455-6d20-38bd-985b-05b78abaf5f5",
                                        "glosses": [
                                            "Other similar species:",
                                            "Diploglottis australis, native tamarind, a rainforest tree of Eastern Australia."
                                        ],
