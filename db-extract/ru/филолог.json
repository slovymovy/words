                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3fc858d-8d71-33a5-8e65-93ec2d21c9f4",
                        "entry_id": "b38e39d5-2f77-3949-bfda-d209bdf2795c",
                        "glosses": [
                            "специалист в области филологии; тот, кто изучает духовную культуру народа, выраженную в языке и закреплённую в литературном творчестве, в письменных текстах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e210fefd-6947-431d-be39-3e38772f7dc8",
                                "sense_id": "a3fc858d-8d71-33a5-8e65-93ec2d21c9f4",
                                "text": "Прежде всего, филолог должен непременно иметь перед собой текст этого сообщения в подлиннике: любой перевод — не только литературный, но даже буквальный — в силу разницы в структуре языков неизбежно вносит в смысл текста некоторые малозаметные модификации, какая-нибудь из которых может впоследствии оказаться причиной ложного истолкования."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51aeea30-a8cf-4edd-a8fc-57658762a247",
                        "source_entry_id": "b38e39d5-2f77-3949-bfda-d209bdf2795c",
                        "source_sense_id": "a3fc858d-8d71-33a5-8e65-93ec2d21c9f4",
                        "target_lang_word": "philologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "philologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ac267bd-cefc-32b1-b034-610ce6206508",
                                        "entry_id": "09b50a2d-a5f5-3bac-8db3-39f9ec6e71f9",
                                        "glosses": [
                                            "A person who engages in philology (historical linguistics), especially as a profession; a collector of words and their etymologies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef312ff6-ce4d-4409-8c9f-30e6c88bca79",
                                                "sense_id": "4ac267bd-cefc-32b1-b034-610ce6206508",
                                                "text": "Foucault's incisive scrutiny and consistent analysis of antique culture has opened the eyes of many a philosopher, philologist or anthropologist who considered himself an expert on the very texts and issues that Foucault addresses. In the years following the publication of Foucault's works an intense debate arose on the subject of sexuality in antiquity, perhaps primarily in feminist and homosexual circles, although by no means exclusively."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4d47281-8fef-3876-814f-c57e89c9764c",
                                        "entry_id": "09b50a2d-a5f5-3bac-8db3-39f9ec6e71f9",
                                        "glosses": [
                                            "A person devoted to general learning and literature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "049200e6-6196-424a-ae29-0552548526f1",
                                                "sense_id": "a4d47281-8fef-3876-814f-c57e89c9764c",
                                                "text": "Like Johnson, in Herculean might,\nBid some philologist arise,—\nSome Milton, with seraphic flight,\nOr Newton, pupil of the skies."
                                            },
                                            {
                                                "example_id": "e15856d8-0e94-448a-a46d-110c4a4c6461",
                                                "sense_id": "a4d47281-8fef-3876-814f-c57e89c9764c",
                                                "text": "2015, Franssen, Maarten, Lokhorst, Gert-Jan and van de Poel, Ibo, \"Philosophy of Technology\", The Stanford Encyclopedia of Philosophy (Fall 2015 Edition), Edward N. Zalta (ed.), https://plato.stanford.edu/archives/fall2015/entries/technology/\nThe author of the first text in which the term ‘philosophy of technology’ occurred, Ernst Kapp’s Eine Philosophie der Technik, was a philologist and historian. Most of the authors who wrote critically about technology and its socio-cultural role during the twentieth century were philosophers of a general outlook ... or had a background in one of the other humanities or in social science, like literary criticism and social research..., law..., political science... or literary studies... The form of philosophy of technology constituted by the writings of these and others has been called... ‘humanities philosophy of technology’, because it takes its point of departure in the social sciences and the humanities rather than in the practice of technology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f0510f-54e0-3527-b3b1-95f738480e65",
                                        "entry_id": "09b50a2d-a5f5-3bac-8db3-39f9ec6e71f9",
                                        "glosses": [
                                            "A person devoted to classical scholarship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5df2edba-5392-40b0-8f72-f2a78475d6c8",
                                                "sense_id": "88f0510f-54e0-3527-b3b1-95f738480e65",
                                                "text": "2015, Van Norden, Bryan, \"Wang Yangming\", The Stanford Encyclopedia of Philosophy (Fall 2014 Edition), Edward N. Zalta (ed.), https://plato.stanford.edu/archives/fall2014/entries/wang-yangming\nFor Zhu Xi's explanation of the phrase “ge wu,” see his commentary on Great Learning... For Wang's interpretation, see his “Questions on the Great Learning”... Unfortunately, the key word “ge” is highly ambiguous, so both interpretations ... are completely defensible... Nivison... described the phrase as “a philologist's delight,” because of the endless speculation it could provoke, and argued that “[n]o one will ever know what it really meant in its locus classicus.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
