                "senses": [
                    {
                        "sense_id": "0ec0b558-1da2-38f2-bcb3-5a7f4ca06cdf",
                        "entry_id": "1c7533ec-e273-3d02-b243-77e1a26ca347",
                        "glosses": [
                            "Terminal fictif d’ordinateur portable conçu par Frederik Pohl dans son roman L’Ère du satisfacteur, qui combine plusieurs fonctions différentes."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "5e1e5394-a56f-4d74-9e10-a6703a1ad159",
                                "sense_id": "0ec0b558-1da2-38f2-bcb3-5a7f4ca06cdf",
                                "text": "Presque instantanément, le satisfacteur qu’il tenait dans sa main émit un sifflement et vaporisa sur lui quelque chose qui lui parut humide sur l’instant mais s’évapora très vile."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8a27d8a-17d8-36de-bf02-83e0f91ccce1",
                        "entry_id": "1c7533ec-e273-3d02-b243-77e1a26ca347",
                        "glosses": [
                            "Qui procure une satisfaction."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "74460598-3f92-4e6d-88cb-0e2ac30e4765",
                                "sense_id": "c8a27d8a-17d8-36de-bf02-83e0f91ccce1",
                                "text": "Le bon climat social et la bonne implication du personnel sont également de puissants « satisfacteurs »."
                            },
                            {
                                "example_id": "dd8c80a8-b847-48ef-8a2b-41eee74d5528",
                                "sense_id": "c8a27d8a-17d8-36de-bf02-83e0f91ccce1",
                                "text": "Sur la base de ces témoignages, nous avons identifié les événements jugés positifs qui revenaient le plus souvent afin de dresser la liste des 28 \"satisfacteurs\" par opposition aux \"stresseurs\" déjà recensés\", explique Olivier Torrès, professeur à l'université de Montpellier et au sein de Montpellier Business School."
                            }
                        ]
                    }
