                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec6979f7-31fc-4650-83e3-9e6fa04cbf56",
                        "source_entry_id": "a212c815-ed8f-3a81-82c1-5f657b3e43cc",
                        "source_sense_id": "30bc4c20-9f81-3423-a2b7-669f3fae15a4",
                        "target_lang_word": "Mensur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mensur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63d1b402-bb23-3d74-b132-169715c7fd24",
                                        "entry_id": "7cb4e210-0c89-32d0-8e10-9bbb2e918f16",
                                        "glosses": [
                                            "der Abstand zwischen zwei Fechtern"
                                        ],
                                        "tags": [
                                            "Fechtsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "277faf7f-8887-4ccd-887b-bede37066b6d",
                                                "sense_id": "63d1b402-bb23-3d74-b132-169715c7fd24",
                                                "text": "Heute zeigten sie eine Fechtweise mit fester, enger Mensur."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef075432-6551-3d17-a47c-bf25a333f7a5",
                                        "entry_id": "7cb4e210-0c89-32d0-8e10-9bbb2e918f16",
                                        "glosses": [
                                            "traditioneller Fechtkampf zwischen Mitgliedern verschiedener schlagender Studentenverbindungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a154b9-0090-4d64-a77e-9ca9dd5c441e",
                                                "sense_id": "ef075432-6551-3d17-a47c-bf25a333f7a5",
                                                "text": "Eine Mensur kostet nach wie vor Überwindung und ist damit eine Mutprobe."
                                            },
                                            {
                                                "example_id": "cc7466d8-769b-459b-be90-2f76811cfdd3",
                                                "sense_id": "ef075432-6551-3d17-a47c-bf25a333f7a5",
                                                "text": "„Die dürften sich nicht mucksen, sonst wär die Mensur ungültig, so, ohne Betäubung die Schmisse zunähen.“"
                                            },
                                            {
                                                "example_id": "6c5c7e6e-a0ce-4c85-a602-2a3bc569669e",
                                                "sense_id": "ef075432-6551-3d17-a47c-bf25a333f7a5",
                                                "text": "„Das war keine Operationsnarbe, nein, diese Narbe hatte eine Mensur zurückgelassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dae58897-dc0b-3fb5-81f2-830bdeffde58",
                                        "entry_id": "7cb4e210-0c89-32d0-8e10-9bbb2e918f16",
                                        "glosses": [
                                            "die Abmessungen, Maße von Musikinstrumenten oder Teilen davon, insbesondere bei Saiteninstrumenten die frei schwingende Länge der Saiten, bei Blasinstrumenten die Steigung der Weite des Rohrs im Verhältnis zur Länge sowie alle Maße der Orgelpfeifen"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "Musikinstrumentenbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8bd0f93-e72f-4f3a-a687-b7f48d9da0d4",
                                                "sense_id": "dae58897-dc0b-3fb5-81f2-830bdeffde58",
                                                "text": "Es gibt »halbe Gitarren«, also kleinere Instrumente, als die gewöhnlichen. Ihre Mensur liegt zwischen 52 und 62 cm."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dcb18cd5-524e-355d-a128-a2808438249d",
                                        "entry_id": "7cb4e210-0c89-32d0-8e10-9bbb2e918f16",
                                        "glosses": [
                                            "ein Maß, das die Geltungsdauer der einzelnen Notenwerte untereinander bestimmt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66dec8dc-4e44-439d-9173-0078f1ce6836",
                                                "sense_id": "dcb18cd5-524e-355d-a128-a2808438249d",
                                                "text": "Das System der Mensuren ist vergleichbar, aber nicht identisch mit den heutigen Takten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d5e8e15b-f966-31fa-bd51-9492be77a219",
                                        "entry_id": "7cb4e210-0c89-32d0-8e10-9bbb2e918f16",
                                        "glosses": [
                                            "ein Messzylinder bis 1 Liter Volumen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf53b256-500e-454a-8ff7-ec6a833dacdb",
                                                "sense_id": "d5e8e15b-f966-31fa-bd51-9492be77a219",
                                                "text": "Eine qualitativ hochwertige Mensur mit einem Fassungsvermögen von 10 ml."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
