                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3224eb89-00fc-4bea-8464-312d81280e90",
                                "sense_id": "632da45c-08e1-3726-bb53-fda932605438",
                                "text": "Najbardziej do propagowania idei reinkarnacji przyczynili się gnostycy i manichejczycy, którzy przejęli pewne teorie z Indii czy Egiptu […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d009c653-02fd-4de3-8c9e-2c8bbd47270d",
                        "source_entry_id": "807d76eb-79be-389c-bc19-d236784b74eb",
                        "source_sense_id": "632da45c-08e1-3726-bb53-fda932605438",
                        "target_lang_word": "Manichaean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manichaean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95554746-8e0a-38b1-94d5-1252b43610d7",
                                        "entry_id": "ad8a9bce-a73d-3062-85b3-5c249d96d380",
                                        "glosses": [
                                            "A follower of Manichaeism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Manichaean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71618498-f545-325a-bcd5-32b84d0a89f4",
                                        "entry_id": "a6a9d002-fe18-3a99-b351-723abe2addab",
                                        "glosses": [
                                            "Of or relating to Manichaeism."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d6bad81-5c5e-427a-8ce3-e3d1e89d3e8c",
                                                "sense_id": "71618498-f545-325a-bcd5-32b84d0a89f4",
                                                "text": "Through them passed not only the traders of the Silk Route[…] but also lone Buddhist monks carrying precious cargoes of scrolls in their backpacks, white-robed Manichean sages from Iran and austere Nestorian clerics who founded Christian monasteries even in remote Tibet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17b35ae5-7ee8-3f6c-82d6-ed47507b1813",
                                        "entry_id": "a6a9d002-fe18-3a99-b351-723abe2addab",
                                        "glosses": [
                                            "Of or concerning a Manichaean."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "435a9f01-3ef4-3c8a-95e7-269a9c6a16c1",
                                        "entry_id": "a6a9d002-fe18-3a99-b351-723abe2addab",
                                        "glosses": [
                                            "Of or relating to a worldview of distinct good and evil, especially to the exclusion of other possible categories."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db801ee4-f9e5-4643-982c-d8b5cf95c598",
                                                "sense_id": "435a9f01-3ef4-3c8a-95e7-269a9c6a16c1",
                                                "text": "Detractors of Mr. Nixon will decry the book's [1999: Victory Without War] obsession with potency and winning[…] as well as with a Manichaean view of a world that he sees as divided between the bad Soviet Union and the good United States."
                                            },
                                            {
                                                "example_id": "86348c28-1394-4069-8796-bf0b4ee97f56",
                                                "sense_id": "435a9f01-3ef4-3c8a-95e7-269a9c6a16c1",
                                                "text": "Barack Obama spoke of a world without these Manichean dualities. He dismissed the notion of “red” and “blue” America."
                                            },
                                            {
                                                "example_id": "f980db67-e8f8-4bf8-9e6e-434010027d5b",
                                                "sense_id": "435a9f01-3ef4-3c8a-95e7-269a9c6a16c1",
                                                "text": "Once again, we see a Manichean world not unlike that of conspiracists: you can be good or you can be evil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03fa6699-1190-39af-a84b-a9bb0dc2e920",
                                        "entry_id": "a6a9d002-fe18-3a99-b351-723abe2addab",
                                        "glosses": [
                                            "Using light and dark to represent good and evil."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
