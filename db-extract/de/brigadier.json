                                    },
                                    {
                                        "sense_id": "f96989ce-9673-3dbc-a6b1-fece71c65f40",
                                        "entry_id": "ec9ca07d-af05-3155-ab4b-291c42e0edca",
                                        "glosses": [
                                            "The head of a workforce in the Soviet Union."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73369c5c-4a1f-4b29-9abe-dc96805e0cad",
                                                "sense_id": "f96989ce-9673-3dbc-a6b1-fece71c65f40",
                                                "text": "The supervisory staff of the farm did their work well, according to the source. All the brigadiers were old, experienced workers who knew their business."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a6ce042-822e-40dd-94c6-00008cd13093",
                        "source_entry_id": "854629d9-e4b6-3a71-80c1-d3945ceb022d",
                        "source_sense_id": "800197cf-bfe4-3da9-9a27-74896c5e0b6c",
                        "source_sense_description": "ein militärischer Rang",
                        "target_lang_word": "brigadier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brigadier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "894b1cf0-5d53-30bd-b0f1-4350da020e0f",
                                        "entry_id": "07e03ced-bca7-3bc0-8f42-1e1e7cd4f130",
                                        "glosses": [
                                            "Militaire avec un grade correspondant à celui de caporal dans certaines armes (les armes montées), notamment dans la gendarmerie, la cavalerie ou l'artillerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "634baff7-ee14-4e13-b7bb-e236d3e53909",
                                                "sense_id": "894b1cf0-5d53-30bd-b0f1-4350da020e0f",
                                                "text": "Un brigadier indigène de spahis, qui avait connu Abd-el-Kader ben Smaïl, et qui avait vu Yasmina, la reconnut."
                                            },
                                            {
                                                "example_id": "38466d4a-5445-4418-b605-c3bd42c9f103",
                                                "sense_id": "894b1cf0-5d53-30bd-b0f1-4350da020e0f",
                                                "text": "Au bout d’une demi-heure environ, les deux gendarmes arrivèrent. Le brigadier Sénateur était très haut et maigre, le gendarme Lenient, gros et court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d70d346-47d8-3fef-a678-2fde5d78d941",
                                        "entry_id": "07e03ced-bca7-3bc0-8f42-1e1e7cd4f130",
                                        "glosses": [
                                            "Sous-officier, dans la police."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10c97bc-5cea-4bf9-a9eb-3aeac7441d09",
                                                "sense_id": "9d70d346-47d8-3fef-a678-2fde5d78d941",
                                                "text": "Au milieu de ces hôtes habituels, deux individus, assis ce soir-là à l’écart, s’entretenaient à voix basse, dévisageant les buveurs. C’étaient le brigadier de police Eck et l’un de ses agents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "203e80c7-0a2f-3f09-9896-ba902cf529bc",
                                        "entry_id": "07e03ced-bca7-3bc0-8f42-1e1e7cd4f130",
                                        "glosses": [
                                            "Matelot à l’avant d’une embarcation dont le rôle est de guider l’accostage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "111d526f-390d-39be-9e67-29fbfa108206",
                                        "entry_id": "07e03ced-bca7-3bc0-8f42-1e1e7cd4f130",
                                        "glosses": [
                                            "Bâton que le régisseur utilise pour frapper les trois coups ^([1]) annonçant le début de la représentation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79ab5385-280a-301a-8bcc-57ad9079dfce",
                                        "entry_id": "07e03ced-bca7-3bc0-8f42-1e1e7cd4f130",
                                        "glosses": [
                                            "Membre d'une brigade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abf0482e-04e4-440c-a94c-60e5e76fc99c",
                                                "sense_id": "79ab5385-280a-301a-8bcc-57ad9079dfce",
                                                "text": "Les brigadiers visitaient désormais les chambres du premier étage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d220d187-9a1e-364c-9ee7-268482febe48",
                                        "entry_id": "07e03ced-bca7-3bc0-8f42-1e1e7cd4f130",
                                        "glosses": [
                                            "Membre d'une ancienne brigade de postiers remplaçants"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e66e977-54fb-40d3-9744-b7ab9bf09597",
                                                "sense_id": "d220d187-9a1e-364c-9ee7-268482febe48",
                                                "text": "Son statut social n'a alors pas grand chose à voir avec celui d'un facteur ou d'un chargeur qui de 1100Frs en début de carrière, perçoivent entre 1 800 et 2 000 Frs en fin de parcours, dans le meilleur des cas, celui où ils accrochent les grades de facteur-chef ou de brigadier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brigadier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a8d8c01-63d9-382c-b4ca-09ac4fd21836",
                                        "entry_id": "16210942-74fc-3c55-a59e-cbdceeee84d1",
                                        "glosses": [
                                            "Relatif à la brigade ou au brigadier."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "183d4773-1ee0-4d13-92f2-a5421d453b4a",
                                                "sense_id": "9a8d8c01-63d9-382c-b4ca-09ac4fd21836",
                                                "text": "Ça devait être le tour de la 104 : le sous-brigadier de devant a quitté le guichet après avoir reçu double louchée, ce qu’on appelle la portion brigadière."
                                            }
                                        ]
                                    }
                                ]
