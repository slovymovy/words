                                "target_senses": [
                                    {
                                        "sense_id": "3c6bea83-d852-32a2-8b20-ab80c42bfd4c",
                                        "entry_id": "dad48706-bc7a-33af-9472-90b538ce5bf1",
                                        "glosses": [
                                            "osoba występująca przeciwko władzy i z tego powodu represjonowana"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ede34a-a382-4f22-b624-f3ac7d1ca92a",
                                                "sense_id": "3c6bea83-d852-32a2-8b20-ab80c42bfd4c",
                                                "text": "Widząc skutki dokonywanych prób, odmówił dalszych badań, stając się dysydentem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "459edbdf-4c54-33de-807e-3eb4a2f635ea",
                                        "entry_id": "dad48706-bc7a-33af-9472-90b538ce5bf1",
                                        "glosses": [
                                            "osoba, która odsunęła się od grupy, do której należała"
                                        ],
                                        "tags": [],
