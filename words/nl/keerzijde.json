        "achterzijde"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3b92c7c-a81a-355b-b592-06e828bd7904",
                    "sense_definition": "de minder prettige of negatieve kant van een op het eerste gezicht positieve situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijke_kant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>keerzijde</w> van de medaille is dat de kampioen geen tijd meer had voor zijn gezin.",
                            "target_lang_translations": {
                                "en": "The <w>flip side</w> of the coin is that the champion no longer had time for his family."
                            }
                        },
                        {
                            "text": "Succes heeft vaak een <w>keerzijde</w> waar de meeste mensen niet direct bij stilstaan.",
                            "target_lang_translations": {
                                "en": "Success often has a <w>downside</w> that most people do not immediately consider."
                            }
                        }
                    ],
                    "synonyms": [
                        "schaduwzijde"
                    ],
                    "common_phrases": [
                        "keerzijde van de medaille"
                    ],
                    "target_lang_definitions": {
                        "en": "the less pleasant or negative side of a situation that at first glance seems positive"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "downside",
                                "target_lang_sense_clarification": "a negative aspect of something otherwise good"
                            },
                            {
                                "target_lang_word": "flip side",
                                "target_lang_sense_clarification": "the opposite, often negative, aspect of a situation"
                            },
                            {
                                "target_lang_word": "reverse",
                                "target_lang_sense_clarification": "the opposite or contrary side of a situation"
                            },
                            {
                                "target_lang_word": "dark side",
                                "target_lang_sense_clarification": "the negative or hidden part of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2babe54a-124a-3c2d-a974-adde993c7879",
                    "sense_definition": "de achterkant of de andere zijde van een plat voorwerp zoals een munt of papier",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke_kant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de <w>keerzijde</w> van dit document vindt u de algemene voorwaarden.",
                            "target_lang_translations": {
                                "en": "On the <w>reverse</w> of this document, you will find the general terms and conditions."
                            }
                        },
                        {
                            "text": "De <w>keerzijde</w> van de munt toont een afbeelding van een historische koning.",
                            "target_lang_translations": {
                                "en": "The <w>reverse</w> of the coin shows an image of a historical king."
                            }
                        }
                    ],
                    "synonyms": [
                        "achterkant",
                        "achterzijde",
                        "rugzijde"
                    ],
                    "antonyms": [
                        "voorzijde"
                    ],
                    "common_phrases": [
                        "keerzijde van de munt"
                    ],
                    "target_lang_definitions": {
                        "en": "the back or the other side of a flat object such as a coin or paper"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reverse",
                                "target_lang_sense_clarification": "the back side of a coin, medal, or document"
                            },
                            {
                                "target_lang_word": "back",
                                "target_lang_sense_clarification": "the side of an object that is opposite the front"
                            },
                            {
                                "target_lang_word": "other side",
                                "target_lang_sense_clarification": "the side facing away or the opposite surface"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}