            {
                "entry_id": "05653f69-aa0d-3d46-aa2a-ba07abf913ec",
                "word": "HSI",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "821a80d2-f8cc-3e7a-849d-1a65056e8c0a",
                        "entry_id": "05653f69-aa0d-3d46-aa2a-ba07abf913ec",
                        "glosses": [
                            "Initialism of Homeland Security Investigations."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "852c882f-bcde-4dcd-aaad-991479330c55",
                                "sense_id": "821a80d2-f8cc-3e7a-849d-1a65056e8c0a",
                                "text": "He said he recently asked HSI to audit how much of their time is spent on work site enforcement, and said he has ordered that to increase “by four to five times.”"
                            },
                            {
                                "example_id": "359531e9-8be0-40a7-bb84-46b206af8794",
                                "sense_id": "821a80d2-f8cc-3e7a-849d-1a65056e8c0a",
                                "text": "During worksite enforcement actions, HSI officials typically request to see people’s identification to confirm they are authorized to work."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2539576d-5f97-387d-a99b-a816228d5023",
                "word": "HSI",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "977b7115-e25c-40c1-9886-a5b80b0e54df",
                        "entry_id": "2539576d-5f97-387d-a99b-a816228d5023",
                        "tags": [
                            "plural"
                        ],
                        "form": "HSIs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ddbb2811-e533-3c9e-955c-23f68640a481",
                        "entry_id": "2539576d-5f97-387d-a99b-a816228d5023",
                        "glosses": [
                            "Initialism of Hispanic-serving institution."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "d0b18308-9029-4b70-9feb-623a13b9ece7",
                                "sense_id": "ddbb2811-e533-3c9e-955c-23f68640a481",
                                "text": "More than half of America’s Latino undergraduates attend an HSI – that is, a public or private nonprofit college or university with a student body that is at least 25 percent Latino. HSIs, Historically Black Colleges and Universities (HBCUs) and other Minority-Serving Institutions (MSIs) serve a higher proportion of low- and middle-income students than their peer institutions, and together they enroll nearly sixty percent of the Nation’s 4.7 million minority undergraduate students. […] Enhancing education opportunities for Hispanics will be vital to achieving this objective, and we will need the continued leadership of HSIs to increase the enrollment, retention and graduation rates of our Hispanic students."
                            }
                        ]
                    }
                ],
