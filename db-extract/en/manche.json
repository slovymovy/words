                ],
                "translations": [
                    {
                        "translation_id": "e462f49a-2255-422c-b45a-fc74cca2e959",
                        "source_entry_id": "030eeb99-873b-3a94-ac77-8c6d795ae218",
                        "source_sense_id": "e2347b57-086d-368b-8f6d-1bc3eb2c690c",
                        "source_sense_description": "department of Normandy, France",
                        "target_lang_word": "Manche",
