                "senses": [
                    {
                        "sense_id": "b188efa8-de6a-3211-95f4-93ee4b3fd19d",
                        "entry_id": "8a2298f7-44ad-369f-85ef-84eacbd473ec",
                        "glosses": [
                            "Reichstag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adb6ad8a-6cc4-4b36-9f62-be7a9d5f3f1e",
                                "sense_id": "b188efa8-de6a-3211-95f4-93ee4b3fd19d",
                                "text": "Дире́ктор произнёс коро́тенькую речь о прихо́де к вла́сти фаши́стов, о поджо́ге рейхста́га в Герма́нии и уе́хал на своём «фо́рде».",
                                "translation": "The director made a short speech about the rise to power of the German fascists and the burning of the reichstag in Germany and then drove away in his Ford.",
                                "english": "The director made a short speech about the rise to power of the German fascists and the burning of the reichstag in Germany and then drove away in his Ford."
                            }
                        ]
                    }
                ],
