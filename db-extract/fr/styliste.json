                            "feminine"
                        ],
                        "form": "stylistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92bc4260-352a-32e0-98b4-77ee24cbbe60",
                        "entry_id": "dce50127-7b7d-3235-a413-78e12ecf94bb",
                        "glosses": [
                            "Professionnel chargé du stylisme."
                        ],
                        "tags": [
                            "Tous domaines"
                        ],
                        "examples": [
                            {
                                "example_id": "9e2d77b1-42ae-416f-955a-a4edfc316de5",
                                "sense_id": "92bc4260-352a-32e0-98b4-77ee24cbbe60",
                                "text": "Dans l'insolite quartier de 12th Ave S, une ancienne styliste des drag-queens de New-York vend des perruques crépues, des santiags et des bolos (la cravate du cow-boy) artisanaux chez Katy K's Ranch Dressing (2407 12th Ave S)."
                            },
                            {
                                "example_id": "f9d1b071-1f07-42d9-9612-bc04332395e9",
                                "sense_id": "92bc4260-352a-32e0-98b4-77ee24cbbe60",
                                "text": "« On sait que les influenceuses d’aujourd’hui peuvent devenir les stars du cinéma de demain, même si elles rejoindront alors des marques plus connues que la mienne », précise le styliste Christophe Guillarmé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ed1a4c2-f459-41d3-ac9b-6372cfbdfec1",
                        "source_entry_id": "dce50127-7b7d-3235-a413-78e12ecf94bb",
                        "source_sense_id": "92bc4260-352a-32e0-98b4-77ee24cbbe60",
                        "target_lang_word": "Designer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Designer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "348112b5-8b2d-3cae-a16d-7d407b2595cd",
                                        "entry_id": "ec7eec5e-5428-3b1d-865f-8493b82d7df5",
                                        "glosses": [
                                            "Person, die das Design von Ge- und Verbrauchsgegenständen wie etwa der Bekleidung, Möbel, Haushaltsgegenstände, Automobile, Schmuck, Werkzeuge und Ähnliches entwirft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa3fdbc-9098-4328-b2ef-e2198215502e",
                                                "sense_id": "348112b5-8b2d-3cae-a16d-7d407b2595cd",
                                                "text": "„Ich habe dort einen einheimischen Designer getroffen, der interessante Kolliers aus Leder herstellt, die sogar schon von Model Gisele Bündchen auf dem Catwalk präsentiert wurden!“"
                                            },
                                            {
                                                "example_id": "0890f045-bf82-41df-a80e-c45401d8edc7",
                                                "sense_id": "348112b5-8b2d-3cae-a16d-7d407b2595cd",
                                                "text": "„Modeschöpfer mal ganz privat: Ein neues Kochbuch offenbart die Lieblingsrezepte von renommierten Designern.“"
                                            },
                                            {
                                                "example_id": "425bda8c-f3d1-4c3f-ae9d-42f73d7e4f39",
                                                "sense_id": "348112b5-8b2d-3cae-a16d-7d407b2595cd",
                                                "text": "„Auf Initiative der Stiftung Niedersachsen in Verbindung mit dem örtlichen Verkehrsbetrieb Üstra (»Überlandwerke und Straßenbahnen Hannover AG«) wurden neun bekannte Designer damit beauftragt, Bushaltestellen mit Dach zu gestalten.“"
                                            },
                                            {
                                                "example_id": "6818323d-4e1f-4859-9d56-0c709e0965c2",
                                                "sense_id": "348112b5-8b2d-3cae-a16d-7d407b2595cd",
                                                "text": "„Es ist, was der Designer Martin Solomon ein »Ganzkörper«-Zeichen nennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c1e2b06-0f53-4d67-94b7-48ff1f2dcfc9",
                        "source_entry_id": "dce50127-7b7d-3235-a413-78e12ecf94bb",
                        "source_sense_id": "92bc4260-352a-32e0-98b4-77ee24cbbe60",
