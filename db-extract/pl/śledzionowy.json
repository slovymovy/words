                        "cross_references": [
                            {
                                "target_word": "splenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6829da74-a3f1-3ddb-8df9-af82b449d98d",
                                        "entry_id": "7999338c-4d19-307c-90a6-a00eb1fe5a8a",
                                        "glosses": [
                                            "Of, related to, or located near the spleen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "625bb30c-72e8-491f-8d91-905a14ce0813",
                                                "sense_id": "6829da74-a3f1-3ddb-8df9-af82b449d98d",
                                                "text": "The Liuer by the splenike branch, transferreth them to the Serjeant of the scullery the Splene."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a6c3c51-31fe-4403-94d9-a4620346d48e",
                        "source_entry_id": "409def84-b376-3ccc-a0a1-8cefbd18ea6b",
                        "source_sense_id": "c7d70da4-a5cc-3b87-a662-50da81d44474",
                        "target_lang_word": "splenetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "splenetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43d0bb7e-2fbb-3c7c-aa17-0a48d284fa85",
                                        "entry_id": "7cd9f63f-eac1-3dcc-8097-d85bb0e6323f",
                                        "glosses": [
                                            "Bad-tempered, irritable, peevish, spiteful, habitually angry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e30ba6c-2f61-478f-ab54-3563812cb02e",
                                                "sense_id": "43d0bb7e-2fbb-3c7c-aa17-0a48d284fa85",
                                                "text": "A sect, whose chief devotion lies / In odd perverse antipathies; / […] / More peevish, cross, and splenetick, / Than dog distract, or monkey sick."
                                            },
                                            {
                                                "example_id": "eaab55bb-431b-43e9-9862-2c16062ce24a",
                                                "sense_id": "43d0bb7e-2fbb-3c7c-aa17-0a48d284fa85",
                                                "text": "Horace seems to have purg'd himself from those Splenetick Reflections in those Odes and Epodes, before he undertook the Noble Work of Satires; which were properly so call'd."
                                            },
                                            {
                                                "example_id": "1858849b-9c01-4414-aea7-9ef6e8e5a6ff",
                                                "sense_id": "43d0bb7e-2fbb-3c7c-aa17-0a48d284fa85",
                                                "text": "[…] here were no Gibers, Cenſurers, Backbiters, Pick-pockets, Highwaymen, Houſebreakers, Attorneys, Bawds, Buffoons, Gameſters, Politicians, Wits, ſplenetick tedious Talkers, Controvertiſts, Raviſhers, Murderers, Robbers, Virtuoſo's; […]"
                                            },
                                            {
                                                "example_id": "ff091d64-1895-45b8-92fd-e4afd4910a49",
                                                "sense_id": "43d0bb7e-2fbb-3c7c-aa17-0a48d284fa85",
                                                "text": "Laura was at a loss to account for her cousin’s sulky behaviour, and ignorant in what she had offended him; however, she was not angry in her turn at Pen’s splenetic mood, for she was the most good-natured and forgiving of women, and besides, an exhibition of jealousy on a man’s part is not always disagreeable to a lady."
                                            },
                                            {
                                                "example_id": "d6cfea61-7b35-44ee-a2a7-973c0ed9eb2d",
                                                "sense_id": "43d0bb7e-2fbb-3c7c-aa17-0a48d284fa85",
                                                "text": "In fact, Gwendolen, not intending it, but intending the contrary, had offended her hostess, who, though not a splenetic or vindictive woman, had her susceptibilities."
                                            },
                                            {
                                                "example_id": "ecab21c5-28b4-486f-baf3-86499c2fe62c",
                                                "sense_id": "43d0bb7e-2fbb-3c7c-aa17-0a48d284fa85",
                                                "text": "In 1979 he published Contre le cinéma situationniste, néo-nazi (Against Neo-Nazi Situationist Cinema), a pamphlet on Hurlements and Debord's later films so splenetic that Isou was unable to bring himself to mention Debord by name; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5825233b-dab9-3b60-8d5b-45f4d258b06a",
                                        "entry_id": "7cd9f63f-eac1-3dcc-8097-d85bb0e6323f",
                                        "glosses": [
                                            "Related to the spleen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6ba8f75-1061-4f6d-a758-25b2fcea2b66",
                                                "sense_id": "5825233b-dab9-3b60-8d5b-45f4d258b06a",
                                                "text": "I have already described the general protuberance of the abdomen among the children throughout the Messaria and the Carpas districts, all of whom are more or less affected by splenetic diseases."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "splenetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a835079-52dd-36e0-a137-26d98afcdf85",
                                        "entry_id": "5d50bcc7-ac77-340e-8058-9d8a6fc2fa54",
                                        "glosses": [
                                            "A person affected with spleen."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71060b32-de09-40d4-91f3-2d1ce8b41276",
                        "source_entry_id": "409def84-b376-3ccc-a0a1-8cefbd18ea6b",
                        "source_sense_id": "c7d70da4-a5cc-3b87-a662-50da81d44474",
