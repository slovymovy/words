                ],
                "senses": [
                    {
                        "sense_id": "98e8a6ce-cd51-3e34-b766-638f750e71da",
                        "entry_id": "21de5bc6-60e1-35f2-8ccc-8406ed0270a3",
                        "glosses": [
                            "fliegendes künstliches Objekt (zum Beispiel Rakete oder Raumschiff)"
                        ],
                        "tags": [
                            "Raumfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "b52129a8-bb3f-40c7-887a-64feac25f242",
                                "sense_id": "98e8a6ce-cd51-3e34-b766-638f750e71da",
                                "text": "„Flugkörper bestehen mindestens aus einem Triebwerk und einem Gefechtskopf, in dem die Wirkladung und der (An-)Zünder untergebracht sind.“"
                            },
                            {
                                "example_id": "e82fba7f-237d-4a14-b5cb-b027205edd05",
                                "sense_id": "98e8a6ce-cd51-3e34-b766-638f750e71da",
                                "text": "„Dieses Manöver wird durch aerodynamische Kräfte verursacht, die auf den Flugkörper wirken.“"
                            },
                            {
                                "example_id": "510b5172-9822-4a08-95fd-984b92b43d9e",
                                "sense_id": "98e8a6ce-cd51-3e34-b766-638f750e71da",
                                "text": "„Über dem Westsibirischen Tiefland hatte der außerirdische Flugkörper immer noch eine Höhe von fünf Kilometern.“"
                            },
                            {
                                "example_id": "e5d15357-fd09-4a8a-9c20-aa22964b12d2",
                                "sense_id": "98e8a6ce-cd51-3e34-b766-638f750e71da",
                                "text": "„Drohnen sind unbemannte Flugkörper, die, vom Radar unentdeckt, in großen Höhen operieren.“"
                            },
                            {
                                "example_id": "6b810799-e448-4d5e-be8d-595df39650c3",
                                "sense_id": "98e8a6ce-cd51-3e34-b766-638f750e71da",
                                "text": "„Der Flugkörper kehrt entweder nach einer gewissen Zeit zur Erde zurück oder wird zum Satelliten, oder er verläßt die Erde für immer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdccfe75-3b74-466d-a673-1929966a7e1b",
                        "source_entry_id": "21de5bc6-60e1-35f2-8ccc-8406ed0270a3",
                        "source_sense_id": "98e8a6ce-cd51-3e34-b766-638f750e71da",
                        "source_sense_description": "Militär, Raumfahrt: fliegendes künstliches Objekt",
                        "target_lang_word": "flying object",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "68d55a64-29fd-411b-b85c-3cc0f4131ee3",
                        "source_entry_id": "21de5bc6-60e1-35f2-8ccc-8406ed0270a3",
                        "source_sense_id": "98e8a6ce-cd51-3e34-b766-638f750e71da",
                        "source_sense_description": "Militär, Raumfahrt: fliegendes künstliches Objekt",
                        "target_lang_word": "missile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "missile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "203f960d-9f10-3b2d-b701-ad3210c3aaaa",
                                        "entry_id": "2a8818ec-d3ba-3442-949f-429c82cbf3c9",
                                        "glosses": [
                                            "Any object used as a weapon by being thrown or fired through the air, such as stone, arrow or bullet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a696134a-edf7-42b1-9abf-0f288856e067",
                                                "sense_id": "203f960d-9f10-3b2d-b701-ad3210c3aaaa",
                                                "text": "The Rhodians, who used leaden bullets, were able to project their missiles twice as far as the Persian slingers, who used large stones."
                                            },
                                            {
                                                "example_id": "90d8aa43-59fa-4f5e-a298-3ad16b374a72",
                                                "sense_id": "203f960d-9f10-3b2d-b701-ad3210c3aaaa",
                                                "text": "And I saw askant the armies, / I saw as in noiseless dreams hundreds of battle-flags, / Borne through the smoke of the battles and pierc’d with missiles I saw them, / And carried hither and yon through the smoke, and torn and bloody, / And at last but a few shreds left on the staffs, (and all in silence,) / And the staffs all splinter’d and broken."
                                            },
                                            {
                                                "example_id": "66d4b16d-63f8-46b3-8d09-1f9b0b426e93",
                                                "sense_id": "203f960d-9f10-3b2d-b701-ad3210c3aaaa",
                                                "text": "Riot officers and police on horseback were deployed to disperse the crowns, but they came under attack from bottles, fireworks and other missiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea59a07-3feb-3478-b466-f4bedd3c42bf",
                                        "entry_id": "2a8818ec-d3ba-3442-949f-429c82cbf3c9",
                                        "glosses": [
                                            "A self-propelled projectile whose trajectory can be adjusted after it is launched."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debab24c-7fc4-46ae-8cd6-20ecbb51c057",
                                                "sense_id": "0ea59a07-3feb-3478-b466-f4bedd3c42bf",
                                                "text": "That missile is explosive enough to kill hundreds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
