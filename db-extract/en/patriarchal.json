                    {
                        "translation_id": "7807de07-8c9e-40e0-b2e1-2288f6fdb391",
                        "source_entry_id": "88fad36e-714f-3bc0-a794-3efccfc3db24",
                        "source_sense_description": "relating to patriarchy",
                        "target_lang_word": "patriarchal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriarchal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf796c77-7eaf-32a6-8d25-eb5b6af66df0",
                                        "entry_id": "47689045-e9a8-3c4c-ae6d-d3c0a1264c1a",
                                        "glosses": [
                                            "wie ein Patriarch; das Patriarchat betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6516c09-1564-4752-aa1d-8c8eace8e197",
                                                "sense_id": "cf796c77-7eaf-32a6-8d25-eb5b6af66df0",
                                                "text": "„In manchen migrantischen Milieus hierzulande herrschen immer noch patriarchale Strukturen. Dazu gehört die Macht der Älteren über die Jüngeren und die Macht der Männer über die Frauen.“"
                                            },
                                            {
                                                "example_id": "59e63b6d-e750-4550-ae7d-2dcceb837ff1",
                                                "sense_id": "cf796c77-7eaf-32a6-8d25-eb5b6af66df0",
                                                "text": "„›Wir Frauen gebären nicht nur Kinder, wir managen das Leben im Dorf‹, sagt Isabel. Es ist laut Experten kein reines Matriarchat, aber doch ein Gegenentwurf zu den patriarchalen Machtstrukturen anderswo auf der Welt.“"
                                            },
                                            {
                                                "example_id": "e9b1c8cf-30fc-4bfc-a186-58f93b562d39",
                                                "sense_id": "cf796c77-7eaf-32a6-8d25-eb5b6af66df0",
                                                "text": "„Doch abgesehen von der Frage, wie sehr das Wahlgeheimnis in den eigenen vier Wänden wirklich gesichert ist – es soll ja auch noch Familien mit patriarchaleren Strukturen geben –, bleibt ein gewisses Unbehagen, dass die Ausnahme zur Regel gemacht wird.“"
                                            },
                                            {
                                                "example_id": "b4191e3e-f9be-484d-9433-add200a19055",
                                                "sense_id": "cf796c77-7eaf-32a6-8d25-eb5b6af66df0",
                                                "text": "„Die Ehe ist die wichtigste Institution, über die sich Familien und patriarchale Netzwerke reproduzieren, ihren Zusammenhalt sowie Einfluss und Stärke nach außen demonstrieren.“"
                                            },
                                            {
                                                "example_id": "1e4e7bc3-ff02-411c-aeac-30eb62467a4f",
                                                "sense_id": "cf796c77-7eaf-32a6-8d25-eb5b6af66df0",
                                                "text": "„Obert Mpofu, der mehrfach Ministerämter bekleidete, kniete an dessen 89. Geburtstag vor seinem Präsidenten nieder, was in der patriarchalen Shona-Kultur ein Verhalten ist, das viele Männer von ihren Ehefrauen erwarten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
