                ],
                "senses": [
                    {
                        "sense_id": "de18a1f5-5dfe-38d8-9461-7ee94d772515",
                        "entry_id": "07fad334-d2a7-3991-931d-8eeb3fa74a49",
                        "glosses": [
                            "имеющий две головы, с двумя головами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0894546-8aa5-4d26-a8e7-45d3a6d539cd",
                                "sense_id": "de18a1f5-5dfe-38d8-9461-7ee94d772515",
                                "text": "Вот на улице стоит чудовище, веселое, двухголовое чудовище."
                            },
                            {
                                "example_id": "44784120-5de6-4487-a8c1-f0a9f9d5dba9",
                                "sense_id": "de18a1f5-5dfe-38d8-9461-7ee94d772515",
                                "text": "Чичи с гордостью ввела в комнату двухголового зверя."
                            }
                        ]
                    },
                    {
                        "sense_id": "f91b8df8-28ee-3b54-9172-ef07e31b74c1",
                        "entry_id": "07fad334-d2a7-3991-931d-8eeb3fa74a49",
                        "glosses": [
                            "субстантивир. тот, у кого две головы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c44d627-231f-474c-964b-9b033066774c",
                                "sense_id": "f91b8df8-28ee-3b54-9172-ef07e31b74c1",
                                "text": "И двухголовый обмакнул одно ухо в блюдце с чаем."
                            },
                            {
                                "example_id": "7129f517-8453-4e4d-a038-998344547221",
                                "sense_id": "f91b8df8-28ee-3b54-9172-ef07e31b74c1",
                                "text": "Горожане вытолкнули вперед двухголового. Головы были одинаковые."
                            }
                        ]
                    },
                    {
                        "sense_id": "58919e63-18b1-3586-aa6f-051168010f5f",
                        "entry_id": "07fad334-d2a7-3991-931d-8eeb3fa74a49",
                        "glosses": [
                            "комп. жарг. (о видеоадаптере) с поддержкой двух мониторов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5776e172-08c5-4158-a519-b0a3e8971254",
                                "sense_id": "58919e63-18b1-3586-aa6f-051168010f5f",
                                "text": "Новая двухголовая топовая видеокарта серии Radeon HD 6900 от компании AMD."
                            }
                        ]
                    }
                ],
