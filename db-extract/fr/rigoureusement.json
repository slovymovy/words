        "fr-extract.jsonl": [
            {
                "entry_id": "39b85576-1050-33ac-9fef-16f5efe66433",
                "word": "rigoureusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cf0ec68f-a7c3-314c-b057-1ebe45ac244d",
                        "entry_id": "39b85576-1050-33ac-9fef-16f5efe66433",
                        "glosses": [
                            "Avec rigueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5d3878-a36a-4101-a43a-304e608d7445",
                                "sense_id": "cf0ec68f-a7c3-314c-b057-1ebe45ac244d",
                                "text": "Toutes mes allées sont nettes rigoureusement,"
                            },
                            {
                                "example_id": "b2fb3607-3a87-4b11-a1cf-04c862f0f00f",
                                "sense_id": "cf0ec68f-a7c3-314c-b057-1ebe45ac244d",
                                "text": "Elle parut les yeux baissés, couverte d’un grand voile ; et elle ne parla que pour modérer la colère d’Idoménée, qui voulait faire punir rigoureusement un de ses esclaves,"
                            },
                            {
                                "example_id": "6eb58713-e891-4058-99dc-202702e64d8a",
                                "sense_id": "cf0ec68f-a7c3-314c-b057-1ebe45ac244d",
                                "text": "Dans un poème, on n'est obligé de se conformer rigoureusement à la vérité historique, ni pour l’ordre et les détails des faits, ni même pour le caractère des personnages,"
                            },
                            {
                                "example_id": "9f828449-3017-4bea-b83b-8480b5f31cf4",
                                "sense_id": "cf0ec68f-a7c3-314c-b057-1ebe45ac244d",
                                "text": "Cette décision est confirmée par Clotaire II. Malgré l'approbation royale, elle ne fut sans doute pas rigoureusement appliquée, car le concile de Reims (615) dut la renouveler."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5ce854d-908d-3a3c-b938-68d2498236e6",
                        "entry_id": "39b85576-1050-33ac-9fef-16f5efe66433",
                        "glosses": [
                            "À la rigueur, avec une exactitude parfaite, inflexible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8870f4a0-0157-4ebb-99af-87d72a2aa76e",
                                "sense_id": "f5ce854d-908d-3a3c-b938-68d2498236e6",
                                "text": "Ces résultats étant fondés sur le développement des quantités en séries infinies, on pourrait les regarder comme n’étant point rigoureusement prouvés,"
                            },
                            {
                                "example_id": "1f5c6015-4431-4aec-9ec0-42f74dab9f73",
                                "sense_id": "f5ce854d-908d-3a3c-b938-68d2498236e6",
                                "text": "Pour le coup me voilà complètement dégentlemanisé, ayant déjà dû reconnaître, il y a long-temps, que l’épithète gentleman ne m’était pas rigoureusement applicable."
                            },
                            {
                                "example_id": "629c2aaa-a7fc-4ed6-bc2e-60fe96491877",
                                "sense_id": "f5ce854d-908d-3a3c-b938-68d2498236e6",
                                "text": "À parler rigoureusement, Jésus-Christ ne fut point un philosophe, ce fut un Dieu,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90cc81be-b63a-49e4-9541-d012562aae0a",
                        "source_entry_id": "39b85576-1050-33ac-9fef-16f5efe66433",
                        "target_lang_word": "absolutely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absolutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47da8542-fd0e-34ac-b563-c913654db3dd",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "In an absolute or unconditional manner; utterly, positively, wholly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "Independently; viewed without relation to other things or factors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c81a4da-f091-4ce0-a15a-9077506450cf",
                                                "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                                "text": "Another characteristic of numbers, which does not concern their mutual relations so much as themselves absolutely, is their ability, according to the ideas of Nicomachus, to conform to geometrical arrangements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "As an intensive: extremely, very, indeed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ebdec5-29be-4c20-868f-3073a912b06b",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "But when it came to posing for publicity pictures they proved absolutely brilliant doing just what came naturally."
                                            },
                                            {
                                                "example_id": "c38bfa8f-c587-4bcb-acca-4ede84befecf",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The strength of the mouse is absolutely spectacular for various kinds of issues, until you find out that the mouse has absolutely no extracellular matrix to speak of in his optic nerve head."
                                            },
                                            {
                                                "example_id": "a29e99e0-44ab-4143-98bb-d8995ba39d0f",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The most absolutely terrifying creature lifted her head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absolutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                        "entry_id": "dafa4a83-cdd1-3e27-bd0c-eb0b7ac7b9bc",
                                        "glosses": [
                                            "Yes, certainly; expression indicating strong agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ac9752-fa44-4cd8-b952-dca657402b56",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Is Bob a good teacher?\nAbsolutely!"
                                            },
                                            {
                                                "example_id": "cd181f96-9d79-4997-b6f4-98a9933b0ae2",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Do you want a free cookie with that coffee?\nAbsolutely!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "351d8c91-aef7-400e-a8ec-0f8eb8eae06e",
                        "source_entry_id": "39b85576-1050-33ac-9fef-16f5efe66433",
                        "target_lang_word": "exactly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exactly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                        "entry_id": "e63ba750-1fa2-31ab-be23-e76f7c64915d",
                                        "glosses": [
                                            "Without approximation; precisely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb3aa7e7-df42-45f5-b059-2a99993db50c",
                                                "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                                "text": "Measure exactly so we can be sure it is right."
                                            },
                                            {
                                                "example_id": "fd9431ac-877b-4ae7-a7ea-9975c26cc96f",
                                                "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                                "text": "The edge is not exactly straight."
                                            },
                                            {
                                                "example_id": "ba46e162-9da7-4fad-a11f-ee373a350aaf",
                                                "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                                "text": "He divided the coins exactly in half."
                                            },
                                            {
                                                "example_id": "1cde011d-c64d-48ef-84af-7cc7e5c036f8",
                                                "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                                "text": "He, that would write exactly, muſt avoid a Barbarous Pronunciation, and conſider for facility, or thorow miſtake, many words are not ſounded after the beſt dialect. Such as […] Wun, one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bd494a2-fc2f-3c83-997d-4eafa08e43d7",
                                        "entry_id": "e63ba750-1fa2-31ab-be23-e76f7c64915d",
                                        "glosses": [
                                            "Precisely, used to provide emphasis."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f707da7-8f99-49c4-8ced-b39b01533d8f",
                                                "sense_id": "3bd494a2-fc2f-3c83-997d-4eafa08e43d7",
                                                "text": "He did it that way exactly to prove the point."
                                            },
                                            {
                                                "example_id": "d767fe21-8c4e-44f2-a10f-bc0e1d522c03",
                                                "sense_id": "3bd494a2-fc2f-3c83-997d-4eafa08e43d7",
                                                "text": "His hair is a semilong dull red and pulled back in a sloppy pony at the base of his neck, and his face is riddled with small freckles and grease, but out here I can see personal hygiene isn't exactly at the top of the priority list."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exactly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e72e46a5-9266-3dbb-8770-3088be7bba45",
                                        "entry_id": "36c50201-c169-3c2e-9bd0-4af6bcc43a9b",
                                        "glosses": [
                                            "Signifies agreement or recognition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "634a4e07-0813-498e-86cf-4d0fc268d462",
                                                "sense_id": "e72e46a5-9266-3dbb-8770-3088be7bba45",
                                                "text": "So you're saying that we have only three days left? — Yes, exactly!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6860e2e0-0141-4f2a-b0e3-10f00fc11e30",
                        "source_entry_id": "39b85576-1050-33ac-9fef-16f5efe66433",
