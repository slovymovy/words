{
    "word": "grifter",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f4cdc8e0-39cb-3334-aa49-6445c08fccf9",
                "word": "grifter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ee5795f4-2927-483f-a1cd-4817b0d2d76d",
                        "entry_id": "f4cdc8e0-39cb-3334-aa49-6445c08fccf9",
                        "tags": [
                            "plural"
                        ],
                        "form": "grifters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6b453db-3376-3e96-b1e3-0883f2c77450",
                        "entry_id": "f4cdc8e0-39cb-3334-aa49-6445c08fccf9",
                        "glosses": [
                            "A con artist; someone who pulls confidence games; a swindler, scammer, huckster, hustler, and/or charlatan."
                        ],
                        "tags": [
                            "US",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "4bf8f5eb-d079-4b7e-a9c8-c257894763a9",
                                "sense_id": "c6b453db-3376-3e96-b1e3-0883f2c77450",
                                "text": "We're all grifters. So we sell each other out for a nickel."
                            },
                            {
                                "example_id": "7538a2c5-3063-4a6e-98ae-647ae481e99e",
                                "sense_id": "c6b453db-3376-3e96-b1e3-0883f2c77450",
                                "text": "That was the train the drunks and the sinners rode—the gambling men and the grifters, the big-time spenders, the skirt-chasers, and all the jolly crew."
                            },
                            {
                                "example_id": "1a479adf-282a-4a74-9197-782b0b7f8536",
                                "sense_id": "c6b453db-3376-3e96-b1e3-0883f2c77450",
                                "text": "From the small-time grifters like Anna Sorokin, who adopted the last name Delvey to masquerade in downtown New York circles as a European heiress for four years before she was convicted of second-degree grand larceny in 2019, […] all impostors come equipped with a tall tale and a look to match."
                            }
                        ]
                    },
                    {
                        "sense_id": "8203d788-17a1-3562-9408-111e118d96a9",
                        "entry_id": "f4cdc8e0-39cb-3334-aa49-6445c08fccf9",
                        "glosses": [
                            "A manipulator or otherwise generally corrupt person who \\\"games\\\" a system, group of people, or other entity for selfish gains; especially of a political \\\"sell-out\\\" perceived as lacking integrity."
                        ],
                        "tags": [
                            "Internet",
                            "colloquial",
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ce69a2c-5257-4739-9176-f25a042afc51",
                        "source_entry_id": "f4cdc8e0-39cb-3334-aa49-6445c08fccf9",
                        "source_sense_description": "Political \"sell-out\" perceived as lacking integrity",
                        "target_lang_word": "naciągacz",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "05babd65-4838-43d9-ae6b-d7ad5ac3d556",
                        "source_entry_id": "f4cdc8e0-39cb-3334-aa49-6445c08fccf9",
                        "source_sense_description": "Political \"sell-out\" perceived as lacking integrity",
                        "target_lang_word": "naciągaczka",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naciągaczka",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "66e7cbe8-2600-3037-ac67-9b234ffd5a27",
                                        "entry_id": "1f0ac45e-0fbe-33d7-a1a8-f179842865fc",
                                        "glosses": [
                                            "kobieta, która naciąga, wykorzystuje (zazwyczaj finansowo); wyzyskiwaczka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ff81677-537e-4868-aa59-193bf137544e",
                                                "sense_id": "66e7cbe8-2600-3037-ac67-9b234ffd5a27",
                                                "text": "A co przyniesie przyszłość? Czego się spodziewać? Co mnie czeka za rogiem ulicy? Nigdy nie starałam się zgadywać przyszłości. Nigdy nie poszłam do wróżki. Uważałam je za naciągaczki"
                                            },
                                            {
                                                "example_id": "494931de-c57e-48fe-8e28-6f6ba5e99edb",
                                                "sense_id": "66e7cbe8-2600-3037-ac67-9b234ffd5a27",
                                                "text": "Niektóre kobiety to naciągaczki. Pragną cię wyłącznie dla pieniędzy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "611c3221-03b8-4fee-8156-3202ec7cbfa2",
                        "source_entry_id": "f4cdc8e0-39cb-3334-aa49-6445c08fccf9",
                        "source_sense_description": "Political \"sell-out\" perceived as lacking integrity",
                        "target_lang_word": "hochsztapler",
