                                "target_senses": [
                                    {
                                        "sense_id": "f1e0d31e-bc60-3e20-87a8-7caeffddedb4",
                                        "entry_id": "0e7dc543-6904-3415-a32c-eb1469b7ce0e",
                                        "glosses": [
                                            "das gleiche Geschlecht habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f514a20c-8476-4368-9564-28d7741575d6",
                                                "sense_id": "f1e0d31e-bc60-3e20-87a8-7caeffddedb4",
                                                "text": "Für diese Studie werden gleichgeschlechtliche Geschwister gesucht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e20b600f-1056-301c-abd4-3dc618c7626b",
                                        "entry_id": "0e7dc543-6904-3415-a32c-eb1469b7ce0e",
                                        "glosses": [
                                            "auf das gleiche Geschlecht bezogen, sich von einer Person des gleichen Geschlechts angezogen fühlend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87133851-de89-4b12-9225-a95b80279384",
                                                "sense_id": "e20b600f-1056-301c-abd4-3dc618c7626b",
                                                "text": "In einigen Ländern können gleichgeschlechtliche Paare heiraten."
                                            },
                                            {
                                                "example_id": "346906ea-c51f-4c2a-b99c-1dfc49d1dc9c",
                                                "sense_id": "e20b600f-1056-301c-abd4-3dc618c7626b",
                                                "text": "Seine Schwester ist gleichgeschlechtlich veranlagt."
                                            },
                                            {
                                                "example_id": "48f28c6a-020a-4433-9d10-ca9457166c53",
                                                "sense_id": "e20b600f-1056-301c-abd4-3dc618c7626b",
                                                "text": "„Als Merkel gleichgeschlechtliche Partnerschaften und den Ausbau der Kinderbetreuung ins Programm der CDU aufnahm, holte sie nur einen Wandel nach, der an der Basis schon vollzogen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "865e4f9c-3db8-4d5d-94bf-dfdd7270fcf4",
                        "source_entry_id": "257f1da7-4c71-390c-83ef-5a77519fea4f",
                        "source_sense_id": "98231a05-d92f-3cad-a6b6-ed1ce45a9ac6",
                        "target_lang_word": "Elternschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elternschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95b8ddda-0485-37f6-b228-48cb04036900",
                                        "entry_id": "1eef35f5-4ecf-34a4-90e4-46cb367f0c39",
                                        "glosses": [
                                            "Beziehung zu den eigenen Kindern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d166ac95-c00e-4d90-909f-34eb6751750d",
                                                "sense_id": "95b8ddda-0485-37f6-b228-48cb04036900",
                                                "text": "„Weil die bestehenden gesetzlichen Regelungen aber die Adoption durch Einzelpersonen unabhängig von ihrer sexuellen Orientierung und die durch eine Adoption begründete gleichzeitige Elternschaft gleichgeschlechtlicher Partner gegenüber einem Kind bei der Stiefkindadoption zulassen, fallen auch bezüglich dieser Personen (und von ihnen zu adoptierender Kinder) die gesetzlichen Regelungen über die Adoption in den Anwendungsbereich des Art8 EMRK, womit sie den Anforderungen des Art14 EMRK entsprechen müssen.“"
                                            },
                                            {
                                                "example_id": "2b4579c4-9d0d-4e4f-8f88-48681bcceb34",
                                                "sense_id": "95b8ddda-0485-37f6-b228-48cb04036900",
                                                "text": "„§ 144. (2) Ist an der Mutter innerhalb von nicht mehr als 300 und nicht weniger als 180 Tagen vor der Geburt eine medizinisch unterstützte Fortpflanzung durchgeführt worden, so ist die Frau Elternteil, 1. die mit der Mutter im Zeitpunkt der Geburt des Kindes in eingetragener Partnerschaft verbunden ist oder als eingetragene Partnerin der Mutter nicht früher als 300 Tage vor der Geburt des Kindes verstorben ist oder 2. die die Elternschaft anerkannt hat oder 3. deren Elternschaft gerichtlich festgestellt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3300d2da-c577-3286-855c-975b628884c5",
                                        "entry_id": "1eef35f5-4ecf-34a4-90e4-46cb367f0c39",
                                        "glosses": [
                                            "Gemeinschaft der Eltern gemeinsam betreuter Kinder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc45f7d7-12bd-42bd-bcc2-1fb5d049c66d",
                                                "sense_id": "3300d2da-c577-3286-855c-975b628884c5",
                                                "text": "„Der Wunsch der Elternschaft zielte auf eine möglichst weitgehende Entfernung bzw. Rückschnitt aller Sträucher und Büsche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
