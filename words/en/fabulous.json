                {
                    "sense_id": "0a37f994-5c28-30ad-b00b-4ad263dfcad3",
                    "sense_definition": "Invented or made up; not based on reality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fictional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness provided a <w>fabulous</w> account of the events that no one believed.",
                            "target_lang_translations": {
                                "ru": "Свидетель изложил <w>невероятную</w> версию событий, в которую никто не поверил.",
                                "nl": "De getuige gaf een <w>verzonnen</w> verslag van de gebeurtenissen dat niemand geloofde.",
                                "tr": "Tanık, olaylar hakkında kimsenin inanmadığı <w>uydurma</w> bir anlatımda bulundu.",
                                "zh": "证人对事件提供了一个没人相信的<w>虚构</w>陈述。"
                            }
                        },
                        {
                            "text": "His claims of being a secret agent were entirely <w>fabulous</w> inventions.",
                            "target_lang_translations": {
                                "ru": "Его утверждения о том, что он секретный агент, были чистым <w>вымыслом</w>.",
                                "nl": "Zijn beweringen dat hij een geheim agent was, waren volkomen <w>verzonnen</w> verzinsels.",
                                "tr": "Gizli ajan olduğuna dair iddiaları tamamen <w>uydurma</w> hikayelerden ibaretti.",
                                "zh": "他声称自己是特工，这完全是<w>编造的</w>谎言。"
                            }
                        }
                    ],
