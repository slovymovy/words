                "senses": [
                    {
                        "sense_id": "ee7a5b13-1151-382d-84f7-d68c43222c28",
                        "entry_id": "5633164d-194f-3e94-9af3-f5da35deeab5",
                        "glosses": [
                            "A way of thinking; an attitude or opinion, especially a habitual one."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a288f562-d210-41ec-9d8d-b4c38329beb5",
                                "sense_id": "ee7a5b13-1151-382d-84f7-d68c43222c28",
                                "text": "Earth Day is a way of propagating and celebrating the environmentalist mindset."
                            },
                            {
                                "example_id": "72d96c38-388e-41d0-8593-b35dd42b8bfb",
                                "sense_id": "ee7a5b13-1151-382d-84f7-d68c43222c28",
                                "text": "You've got to use your weekend / Go nuts if you can / 'Cause you're back out until Monday, back out until Tuesday, Wednesday, Thursday, Friday / It's the English mindset"
                            },
                            {
                                "example_id": "69543545-31ae-45ac-ae95-c6ad31f2d781",
                                "sense_id": "ee7a5b13-1151-382d-84f7-d68c43222c28",
                                "text": "These behaviors and mindsets contrast with mindful eating, which means using all your physical and emotional senses to experience and enjoy the food choices you make without judgment, said Lilian Cheung, a lecturer and director of health promotion and communication in the nutrition department at Harvard T.H. Chan School of Public Health, via email. […] Once you have been mindfully eating for a while, the mindset can apply to other areas of your life."
                            },
                            {
                                "example_id": "b57f5da1-1450-470f-9717-a7ad5bc5a6ac",
                                "sense_id": "ee7a5b13-1151-382d-84f7-d68c43222c28",
                                "text": "Some 46% of those polled agreed that the office environment puts them in a better mindset for work, with this figure rising to 55% of 18-34-year-olds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbe4d952-1214-46ed-a70b-363fd41641a5",
                        "source_entry_id": "5633164d-194f-3e94-9af3-f5da35deeab5",
                        "source_sense_id": "ee7a5b13-1151-382d-84f7-d68c43222c28",
