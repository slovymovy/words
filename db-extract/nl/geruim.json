                                        "glosses": [
                                            "Fairly large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1934e7ba-5bbe-4c86-9136-1f97fbf8e0cb",
                                                "sense_id": "f613fdf8-f8f0-3866-8742-fecdd0d0eabe",
                                                "text": "He gave a sizable cash donation, sizable enough that the IRS wondered where all that money came from."
                                            },
                                            {
                                                "example_id": "3caf5382-81a5-419c-82ee-710b0cf46bab",
                                                "sense_id": "f613fdf8-f8f0-3866-8742-fecdd0d0eabe",
                                                "text": "A vulture can wolf more than two pounds of meat in a minute; a sizable crowd can strip a zebra—nose to tail—in 30 minutes."
                                            }
                                        ]
                                    }
                                ]
