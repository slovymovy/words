                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes nos photos de vacances sont désormais sauvegardées automatiquement dans le <w>nuage</w>."
