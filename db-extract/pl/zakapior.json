                    {
                        "translation_id": "73ad1b73-3328-4a97-9d84-b9cd66d7189b",
                        "source_entry_id": "90045031-034f-3c3f-b14d-5668ed0ee1eb",
                        "source_sense_id": "f9190fb9-6837-39ef-b1d5-db32d99a588f",
