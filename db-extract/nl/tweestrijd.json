                ],
                "translations": [
                    {
                        "translation_id": "4602d3d4-6628-492c-93d7-3c10108725f4",
                        "source_entry_id": "e6543fa6-f3e2-37ec-945e-d705f9077877",
                        "source_sense_id": "795b8f40-a48e-3436-a690-d8ec9a444a5c",
                        "source_sense_description": "conflict tussen twee mensen",
                        "target_lang_word": "Zweikampf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zweikampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a64b6dee-4006-3d0d-8c75-0ee9c871d246",
                                        "entry_id": "f6e00fbe-5b32-37ab-9db2-2c8817bab337",
                                        "glosses": [
                                            "Auseinandersetzung zwischen zwei Personen/Parteien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19dd40d3-f936-4acc-8fb8-ac9ce10d548a",
                                                "sense_id": "a64b6dee-4006-3d0d-8c75-0ee9c871d246",
                                                "text": "Beim heutigen Spiel gab es viele tolle Zweikämpfe."
                                            },
                                            {
                                                "example_id": "dbe13009-9234-43f4-bbc2-131d941d9bf3",
                                                "sense_id": "a64b6dee-4006-3d0d-8c75-0ee9c871d246",
                                                "text": "„Beim Stierkampf (Corrida), dem in südlichen Ländern häufig noch Kultcharakter zukommt und der dort als hohe Kunst betrieben wird, stehen sich Mensch und Tier in einem gefährlichen Zweikampf gegenüber.“"
                                            },
                                            {
                                                "example_id": "1ad21437-bfc7-48eb-b3ce-85067a5dc24a",
                                                "sense_id": "a64b6dee-4006-3d0d-8c75-0ee9c871d246",
                                                "text": "„Fasziniert und bestürzt erlebten die Siedler den Zweikampf der Elemente.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "001124f9-7c7a-39a1-88b8-35ca04ba0c67",
                                        "entry_id": "f6e00fbe-5b32-37ab-9db2-2c8817bab337",
                                        "glosses": [
                                            "Auseinandersetzung mit Fäusten/Waffen zwischen zwei Personen/Parteien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2d4a0c3-4c82-46d8-bc7f-5965c9053f14",
                                                "sense_id": "001124f9-7c7a-39a1-88b8-35ca04ba0c67",
                                                "text": "„Hier sollte der Zweikampf ausgetragen werden.“"
                                            },
                                            {
                                                "example_id": "c581ea1b-1d36-4a85-a884-7d7a422a125f",
                                                "sense_id": "001124f9-7c7a-39a1-88b8-35ca04ba0c67",
                                                "text": "„Es lässt sich denken, was für ein Durcheinander und was für eine Unklarheit sich aus einer solchen Darstellung des vorgefallenen Zweikampfes ergeben müsste.“"
                                            },
                                            {
                                                "example_id": "f6f9b7b6-58d7-47b3-839d-e15b21775655",
                                                "sense_id": "001124f9-7c7a-39a1-88b8-35ca04ba0c67",
                                                "text": "„Der öffentliche Zweikampf auf Leben und Tod, der Holmgang sollte entscheiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5533bc19-07d0-4fbd-8a1f-e891f0530547",
                        "source_entry_id": "e6543fa6-f3e2-37ec-945e-d705f9077877",
                        "source_sense_id": "795b8f40-a48e-3436-a690-d8ec9a444a5c",
                        "source_sense_description": "conflict tussen twee mensen",
                        "target_lang_word": "Duell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Duell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f790a6b-e7ee-36ae-a547-9bed3c42d8fb",
                                        "entry_id": "a726f293-17ae-32ed-be7a-6c1112639b4a",
                                        "glosses": [
                                            "ein meist nach zuvor festgelegten Regeln ausgetragener Zweikampf mit Waffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4357dc8-8026-43e4-a2dd-359015a5a4fa",
                                                "sense_id": "2f790a6b-e7ee-36ae-a547-9bed3c42d8fb",
                                                "text": "Er hat ihn zum Duell gefordert."
                                            },
                                            {
                                                "example_id": "9217c9cb-de1f-4363-ba36-4d981caf7c59",
                                                "sense_id": "2f790a6b-e7ee-36ae-a547-9bed3c42d8fb",
                                                "text": "Er ist im Duell gefallen."
                                            },
                                            {
                                                "example_id": "d2932555-e15a-4495-9a93-daddd68bc297",
                                                "sense_id": "2f790a6b-e7ee-36ae-a547-9bed3c42d8fb",
                                                "text": "„Eine andere, sehr beliebte, aber eher gefährliche Form der Ehrrettung stellten lange Zeit Duelle dar.“"
                                            },
                                            {
                                                "example_id": "e3b99220-2cc9-46d9-8f08-ea9d4a7df761",
                                                "sense_id": "2f790a6b-e7ee-36ae-a547-9bed3c42d8fb",
                                                "text": "„Am achten Tag kam Mr. Goodman zurück und fand sechs Forderungen zum Duell vor - meine Sottisen hatten Folgen gezeitigt.“"
                                            },
                                            {
                                                "example_id": "e903eabe-a0e4-45ae-a0dc-effa10d38e5e",
                                                "sense_id": "2f790a6b-e7ee-36ae-a547-9bed3c42d8fb",
                                                "text": "„Auch kann Kretschmer kaum an dem ersten Duell schuld sein, das sein Schüler führt.“"
                                            },
                                            {
                                                "example_id": "8e71be0d-c1d3-4579-bc6d-f827787ff823",
                                                "sense_id": "2f790a6b-e7ee-36ae-a547-9bed3c42d8fb",
                                                "text": "„Nichts verkörperte den südlichen Ehrbegriff besser als das Duell.“"
                                            },
                                            {
                                                "example_id": "7b4c00da-a10e-4bbd-b2aa-acb0210d2349",
                                                "sense_id": "2f790a6b-e7ee-36ae-a547-9bed3c42d8fb",
                                                "text": "„Darüber hinaus führte mein Vater ein großes Buch, in das er die Geschichte eines jeden Duells mit allen Einzelheiten eintrug, was ihm wirklich den großen Vorteil verschaffte, in allen verworrenen Fällen gerecht urteilen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ead942d3-b434-42f9-9b1c-9841191d3aa6",
                        "source_entry_id": "e6543fa6-f3e2-37ec-945e-d705f9077877",
