{
    "word_family": [
        "tarpaulin"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9db6be7-f582-34f2-a003-5693a2c28d1c",
                    "sense_definition": "A large sheet of waterproof material used to protect objects from rain or dirt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a good thing I had this <w>tarp</w> handy to keep the wood dry.",
                            "target_lang_translations": {
                                "zh": "幸好我手头有这块<w>防水布</w>，能让木头保持干燥。"
                            }
                        },
                        {
                            "text": "We used a heavy <w>tarp</w> to cover the boat during the winter storm.",
                            "target_lang_translations": {
                                "zh": "在冬季风暴期间，我们用一块厚实的<w>防水布</w>盖住了船。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tarpaulin"
                    ],
                    "common_phrases": [
                        "blue tarp",
                        "heavy-duty tarp"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于遮盖物品以防雨水或灰尘的大块防水布。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "防水布",
                                "target_lang_sense_clarification": "指用于遮盖和保护物品的防水材料。"
                            },
                            {
                                "target_lang_word": "油布",
                                "target_lang_sense_clarification": "指涂有防水材料的布，常用于户外遮盖。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5d8c43c2-6395-3412-ab58-a347d210ae55",
                    "sense_definition": "To cover or protect an object using a tarpaulin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>tarp</w> the equipment before the rain starts tonight.",
                            "target_lang_translations": {
                                "zh": "你应该在今晚下雨前把设备<w>用防水布遮盖</w>好。"
                            }
                        },
                        {
                            "text": "The workers <w>tarped</w> the construction materials to keep them clean.",
                            "target_lang_translations": {
                                "zh": "工人们把建筑材料<w>用防水布遮盖</w>起来以保持清洁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cover"
                    ],
                    "common_phrases": [
                        "tarp down"
                    ],
                    "target_lang_definitions": {
                        "zh": "用防水布遮盖或保护某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用防水布遮盖",
                                "target_lang_sense_clarification": "指使用防水布进行覆盖保护的动作。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d845263f-74d5-3f09-9a20-7898307ca2f9",
                    "sense_definition": "A United States government program created to purchase toxic assets and equity from financial institutions to strengthen the financial sector.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The government introduced <w>TARP</w> to prevent a total collapse of the banking system.",
                            "target_lang_translations": {
                                "zh": "政府推出了<w>不良资产救助计划</w>，以防止银行系统全面崩溃。"
                            }
                        },
                        {
                            "text": "Many banks eventually repaid the funds they received through <w>TARP</w>.",
                            "target_lang_translations": {
                                "zh": "许多银行最终偿还了他们通过<w>不良资产救助计划</w>获得的资金。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "美国政府为购买金融机构的不良资产和股权以加强金融部门而设立的救助计划。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不良资产救助计划",
                                "target_lang_sense_clarification": "指美国政府的金融救助项目。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}