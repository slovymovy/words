                                    },
                                    {
                                        "sense_id": "dcb3e11f-0857-3627-aa9d-9ca9bb7e79d5",
                                        "entry_id": "9865b0fd-a879-3c2b-a44f-7a9be30269e5",
                                        "glosses": [
                                            "Having a particular crown (top part of the head)"
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "499b324f-9cb8-37de-9fa4-b3cbe38a33f2",
                                        "entry_id": "9865b0fd-a879-3c2b-a44f-7a9be30269e5",
                                        "glosses": [
                                            "Great, supreme; completed; excessive."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e96ca9-97dd-4f8c-bfad-72525f59658f",
                                                "sense_id": "499b324f-9cb8-37de-9fa4-b3cbe38a33f2",
                                                "text": "Put case, he saith, all other medicines faile, by the helpe of God this alone will doe it, and tis a crowned medicine which must be kept in secret"
                                            },
                                            {
                                                "example_id": "0f77ad09-13f9-4aa5-b20c-bd453726aad1",
                                                "sense_id": "499b324f-9cb8-37de-9fa4-b3cbe38a33f2",
                                                "text": "After having cloy'd his puny stomach, he sneaks away privily, in a Stage-Coach, to his house in the Country; there he murders the Vertuous Womb of his Dear Lady, and darts into the Royal Arch, his contagious, loathsome Sperm, which is innocently receiv'd, and hugg'd in the crown'd Act of Conception."
                                            },
                                            {
                                                "example_id": "9402e19a-e5cd-47f2-a13f-0f0f6943ab6a",
                                                "sense_id": "499b324f-9cb8-37de-9fa4-b3cbe38a33f2",
                                                "text": "More truly delightful to me the seduction-progress than the crowned act: for that's a vapour, a bubble!"
                                            },
                                            {
                                                "example_id": "61fd8cef-e56d-4e28-943c-ff3e42127e78",
                                                "sense_id": "499b324f-9cb8-37de-9fa4-b3cbe38a33f2",
                                                "text": "Their crowned truths"
                                            },
                                            {
                                                "example_id": "30c85fad-ff5d-4e79-bb82-3221fc287c27",
                                                "sense_id": "499b324f-9cb8-37de-9fa4-b3cbe38a33f2",
                                                "text": "That the crownèd truth advances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
