                    {
                        "sense_id": "d54a504b-f5b6-3c14-939e-c59cf8b12fe9",
                        "entry_id": "f425c83c-371b-3182-af19-aa1e9b7c9119",
                        "glosses": [
                            "een touw met twee handvatten waarmee iemand door wurgen vermoord kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10042721-d1d5-4505-9026-47ce2660e96f",
                                "sense_id": "d54a504b-f5b6-3c14-939e-c59cf8b12fe9",
                                "text": "In de auto van de man werd een arsenaal aan wapens gevonden. Zo troffen agenten onder meer een samoeraizwaard, een wurgkoord en diverse messen aan. Er zaten bloedsporen op het zwaard en op een van de messen. Ook lagen er met bloed doorweekte kleren in het voertuig."
                            }
                        ]
                    },
                    {
                        "sense_id": "56131c26-bf7f-3f31-8b74-3237ad94aa65",
                        "entry_id": "f425c83c-371b-3182-af19-aa1e9b7c9119",
                        "glosses": [
                            "iets wat heel hinderlijk en vervelend is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ab936f6e-e263-4381-8547-dc1b07787aa1",
                                "sense_id": "56131c26-bf7f-3f31-8b74-3237ad94aa65",
                                "text": "Het geliefde multitalent Zwagerman, die al jaren depressief was, pleegde op 8 september zelfmoord in zijn woonplaats Haarlem. Zwagerman was ervan overtuigd dat zijn depressie erfelijk was. ,,Ik heb de chromosomen en de genetische predispositie van mijn vader, zei hij eerder. ,,De gedachte aan zelfmoord werd een wurgkoord om mijn nek, in plaats van een troost."
                            },
                            {
                                "example_id": "59c2975e-6386-4f2e-8e49-81ec7e6b2532",
                                "sense_id": "56131c26-bf7f-3f31-8b74-3237ad94aa65",
                                "text": "Wie de menselijke maat door een onmenselijke interpretatie van de wet een wurgkoord omlegt, begaat een moord op het vertrouwen in de rechtsstaat."
                            }
                        ]
                    }
