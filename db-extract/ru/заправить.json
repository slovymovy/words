                                "sense_id": "d606399c-b35d-3c3a-9315-2546007fe1aa",
                                "text": "запра́вить ле́нту/плёнку",
                                "translation": "to thread a tape/film",
                                "english": "to thread a tape/film"
                            },
                            {
                                "example_id": "796999e4-2411-45ce-aa00-8e712b11ce78",
                                "sense_id": "d606399c-b35d-3c3a-9315-2546007fe1aa",
                                "text": "запра́вить шве́йную маши́ну (ни́ткой)",
                                "translation": "to thread in a sewing machine",
                                "english": "to thread in a sewing machine"
                            }
                        ]
                    },
                    {
                        "sense_id": "3fae158e-37b1-325f-a504-0bd4a17d5a31",
