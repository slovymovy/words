                "senses": [
                    {
                        "sense_id": "245b41f1-bc72-31a8-ad2d-c700f591b349",
                        "entry_id": "49575ca9-6536-3fad-8d99-0fd52c8049ab",
                        "glosses": [
                            "Éditer soi-même, ce qu'on a écrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f373e0a8-a758-4881-b764-b2ae78a56da6",
                                "sense_id": "245b41f1-bc72-31a8-ad2d-c700f591b349",
                                "text": "L’autoritativité peut donc être définie comme une attitude consistant à produire et à rendre public des textes, à s’auto-éditer ou à publier sur le WWW, sans passer par l’assentiment d’institutions de référence référées à l’ordre imprimé."
                            },
                            {
                                "example_id": "7b324b6e-073a-4a6f-a9c0-d54481532c95",
                                "sense_id": "245b41f1-bc72-31a8-ad2d-c700f591b349",
                                "text": "Auto-éditer un livre ce n'est pas se condamner à l'anonymat..."
                            },
                            {
                                "example_id": "2280cd2e-44d7-4c2b-8251-186436fc732d",
                                "sense_id": "245b41f1-bc72-31a8-ad2d-c700f591b349",
                                "text": "Comment s'auto-éditer sur internet ?"
                            },
                            {
                                "example_id": "a22e799a-7609-4c43-a297-b23e168c3623",
                                "sense_id": "245b41f1-bc72-31a8-ad2d-c700f591b349",
                                "text": "S'auto-éditer, est-ce la panacée ?"
                            }
                        ]
                    }
