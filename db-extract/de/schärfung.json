                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "19e9ae2f-ec06-3bac-9405-35f28ed35de6",
                        "entry_id": "772391fc-2fdc-3a96-998d-985a78840c74",
                        "glosses": [
                            "Verdopplung eines Konsonanten, wenn es für ein Wort eine Form mit Silbengelenk gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a74da2d-279c-4707-81f8-49dc5d99ff8f",
                                "sense_id": "19e9ae2f-ec06-3bac-9405-35f28ed35de6",
                                "text": "„Dehnung und Schärfung bilden einen Kernbereich bei den Rechtschreibschwierigkeiten im Deutschen.“"
                            },
                            {
                                "example_id": "ffc6246c-fc3f-4630-a2e0-492169435f53",
                                "sense_id": "19e9ae2f-ec06-3bac-9405-35f28ed35de6",
                                "text": "„Das Schriftsystem des Deutschen stellt allerdings einige Mittel bereit, um zu einer relativen Eindeutigkeit der Wortrekodierung zu gelangen. Diese Mittel werden traditionellerweise mit den Termini Dehnung und Schärfung belegt.“"
                            },
                            {
                                "example_id": "109500ee-1eaf-4deb-acf3-b910e6335181",
                                "sense_id": "19e9ae2f-ec06-3bac-9405-35f28ed35de6",
                                "text": "„Im Bereich Schärfung/Dehnung ist die einzige wirklich ausnahmslose Erscheinung der deutschen Orthographie die Konsonantenverdopplung im Zweisilber betont/ unbetont.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
