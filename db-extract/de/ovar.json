                                        "glosses": [
                                            "A female reproductive organ, often paired, that produces ova in most animals, and in mammals, secretes the hormones estrogen and progesterone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8826c85d-55b6-4754-9bec-bfc6c27da999",
                                                "sense_id": "2652f834-b991-3adc-b264-080609830da1",
                                                "text": "The male testicles are homologous to the female ovaries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "188a66f5-4cc8-3842-ac01-c5179dc9dc55",
                                        "entry_id": "3ada1f9a-0c55-3189-ac4f-98f5960dfb7e",
                                        "glosses": [
                                            "The lower part of a pistil or carpel that bears ovules and ripens into fruit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
