                        "entry_id": "3121b38e-b1fc-3ec4-88d2-b1c04998f56a",
                        "glosses": [
                            "ondergrondse ruimte waarin men wijn gekoeld en op constante temperatuur kan bewaren om te laten rijpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb9ed135-7bfe-450d-bb23-cb85b46de327",
                                "sense_id": "03e6b428-6ee5-31a5-a370-8fb0a7208b5b",
                                "text": "Wij gebruiken onze kruipruimte als wijnkelder."
                            },
                            {
                                "example_id": "35a6e963-3dbb-4e61-a85a-cbc164b6f03b",
                                "sense_id": "03e6b428-6ee5-31a5-a370-8fb0a7208b5b",
                                "text": "En ze had tenslotte een levenslange opleiding gehad als het ging om alle gerechten die in betere restaurants werden geserveerd (en daarbij nog heel wat Noorse, voegde ze er lachend aan toe) en hetzelfde gold voor de wijnen, de wijnkelder in Villa Bellevue was altijd meer dan goed voorzien geweest."
                            }
                        ]
                    }
