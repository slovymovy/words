                                        "examples": [
                                            {
                                                "example_id": "b3d07f87-24d0-45c6-a516-b89a3778c2d8",
                                                "sense_id": "c703d955-b189-38bb-9cfe-a93deb00f1e7",
                                                "text": "Школа официально без уклонов, хотя класс вроде бы как математический (я так понимаю, просто математик очень сильный)."
                                            }
                                        ]
                                    }
