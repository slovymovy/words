                                                "sense_id": "01b53779-fa1c-3e54-9bde-56ea5ae55a61",
                                                "text": "Haven't you seen his website? I'll link you to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aa8f61e-b883-3ac7-a7cd-b639f3e4e345",
                                        "entry_id": "098bb669-81e8-3253-acd4-4113771134fd",
                                        "glosses": [
                                            "To post a hyperlink to."
                                        ],
                                        "tags": [
