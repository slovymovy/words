                            "prepositional"
                        ],
                        "form": "пе́пси-ко́лах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1bc31f92-1a2b-36a2-8eda-4f72c1d56200",
                        "entry_id": "3c7d9877-e9b7-39cf-96da-0fce6eba05d3",
                        "glosses": [
                            "безалкогольный тонизирующий газированный прохладительный напиток"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62388bfb-85dc-4dca-9d22-468757a5e617",
                                "sense_id": "1bc31f92-1a2b-36a2-8eda-4f72c1d56200",
                                "text": "Он изъявил желание выпить рома с пепси-колой."
                            },
                            {
                                "example_id": "4aa5949b-394c-4f45-8c73-553720972f60",
                                "sense_id": "1bc31f92-1a2b-36a2-8eda-4f72c1d56200",
                                "text": "Из напитков не рекомендуются все газированные, особенно пепси-кола, фанта и даже пиво."
                            },
                            {
                                "example_id": "209824c6-215b-4c6a-9129-985c60a43b50",
                                "sense_id": "1bc31f92-1a2b-36a2-8eda-4f72c1d56200",
                                "text": "Сновали девушки из буфета, убирали тарелки, раскидывали новые, расставляли бутылки пепси-колы."
                            },
                            {
                                "example_id": "2b93eb00-2322-4fb0-98a4-d2cb4de2c065",
                                "sense_id": "1bc31f92-1a2b-36a2-8eda-4f72c1d56200",
                                "text": "Впрочем, другие научные исследования показали, что всё же в кока-коле и пепси-коле кофеина меньше, чем, например, в стакане чая, а тем более кофе."
                            }
                        ]
                    }
                ],
