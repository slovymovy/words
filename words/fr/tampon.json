                        "tampon périodique"
                    ]
                },
                {
                    "sense_id": "3b624ef1-e3bb-33fb-909f-d922692e0206",
                    "sense_definition": "Élément, personne ou pays qui sert d'intermédiaire pour amortir un choc ou prévenir un conflit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce petit pays neutre joue un rôle de <w>tampon</w> entre deux puissances rivales."
                        },
                        {
                            "text": "Le directeur des ressources humaines tente de faire <w>tampon</w> entre la direction et les salariés."
                        }
