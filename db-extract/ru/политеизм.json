                                        "sense_id": "0d1cb68f-bcfe-3a0b-a6fb-fad952429a67",
                                        "entry_id": "8b41df89-4161-37ac-be47-7b63193a99c2",
                                        "glosses": [
                                            "Glaube an mehrere Götter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b02131-afa8-45bf-9746-e4f3bbe0387e",
                                                "sense_id": "0d1cb68f-bcfe-3a0b-a6fb-fad952429a67",
                                                "text": "Jupiter, Mars und Venus waren Götter des antiken römischen Polytheismus."
                                            },
                                            {
                                                "example_id": "c9b19ee6-7663-4f09-ab08-10ef43836e64",
                                                "sense_id": "0d1cb68f-bcfe-3a0b-a6fb-fad952429a67",
                                                "text": "Eine Form des Polytheismus ist beispielsweise die Vergöttlichung verschiedener Natur- oder Wetterphänomene."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e35f78c-3289-43ea-9793-37f291cd9146",
                        "source_entry_id": "e0ee2713-8d57-31b4-9f48-e8309c7ab2f6",
                        "source_sense_id": "f7a7a4ca-1eef-3d2e-9bc0-b6c2b9bff6d1",
                        "target_lang_word": "polytheïsme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polytheïsme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "40b72e52-b897-334a-aedb-4a607afa189f",
                                        "entry_id": "469f9633-87bb-3131-b5eb-653c4ae4ad5a",
                                        "glosses": [
                                            "godsdienst met meer dan één god"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "748d628a-f433-4ad6-bb5c-5fcd7d47e433",
                                                "sense_id": "40b72e52-b897-334a-aedb-4a607afa189f",
                                                "text": "Het polytheïsme van de oudheid is genereus en tolerant. Lokale goden krijgen hun plaats naast die van de overheerser; ze worden ermee geassocieerd, zelfs geïdentificeerd. In Palmyra was alles hybride. Niet dat ik IS verdenk van veel historisch inzicht, maar hun ideologie die monolithische zekerheid en van elke nuance losgezongen zuiverheid nastreeft, kon niet anders dan Palmyra afwijzen en vernietigen."
                                            },
                                            {
                                                "example_id": "9cb687f6-0188-4f36-bfa7-4026fc0b5438",
                                                "sense_id": "40b72e52-b897-334a-aedb-4a607afa189f",
                                                "text": "In dat opzicht valt er iets te zeggen over algemene factoren die gewelddadigheid eerder bevorderen dan wel afremmen. Monotheïsme is gevaarlijker dan polytheïsme - voor de God van de ander is geen plaats. Het leidt snel tot rechtlijnige almacht, terwijl een Olympus vol goden veeleer in een verdeling der machten, en dus een machtsevenwicht resulteert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
