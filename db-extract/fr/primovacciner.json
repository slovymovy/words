                        "examples": [
                            {
                                "example_id": "736228ba-dddb-4cba-8ab2-d7654b821cb3",
                                "sense_id": "47b3d2a1-03aa-3bfe-b16e-1b6050fd9517",
                                "text": "La cinétique de décroissance des anticorps séroneutralisants d’origine maternelle ayant été effectuée, les animaux ont été primovaccinés à l’âge de 11 semaines soit avec le vaccin en adjuvant aqueux, soit avec le vaccin en adjuvant huileux."
                            },
                            {
                                "example_id": "0b2973d5-c6f0-477f-b89a-5e15226d5d72",
                                "sense_id": "47b3d2a1-03aa-3bfe-b16e-1b6050fd9517",
                                "text": "Leur organisme étant alors grandement vulnérable aux pathologies en tous genres, il est préférable de les primovacciner sans attendre."
                            },
                            {
                                "example_id": "c2484db4-f65e-4e0b-be06-f4717419564d",
                                "sense_id": "47b3d2a1-03aa-3bfe-b16e-1b6050fd9517",
                                "text": "Le vétérinaire en a profité pour le primovacciner, il en a l’âge maintenant."
                            }
                        ]
