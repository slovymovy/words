                    {
                        "translation_id": "65ae24ad-2d94-4faf-8514-668da78070d4",
                        "source_entry_id": "bc743e9d-09d6-3dd4-8882-d21ce95dda7d",
                        "source_sense_description": "артиллерийский снаряд",
                        "target_lang_word": "mitraille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitraille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20e01741-7da3-34db-865d-ee4b99aeaf7b",
                                        "entry_id": "4cbb5a47-2f71-3004-bb6f-58ac3c4cb857",
                                        "glosses": [
                                            "Ferraille dont on chargeait le canon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "711ee212-43de-412a-9c95-44c676482737",
                                                "sense_id": "20e01741-7da3-34db-865d-ee4b99aeaf7b",
                                                "text": "Ces paroles inouïes entrèrent dans l’âme du vieux Courtemanche, comme de la mitraille dans un caisson."
                                            },
                                            {
                                                "example_id": "1b41f0a5-d570-426a-bf91-3afe1153814d",
                                                "sense_id": "20e01741-7da3-34db-865d-ee4b99aeaf7b",
                                                "text": "Parfois ils couraient jusqu’à en perdre haleine, ne s’arrêtant qu’à bout de souffle, se comprimant les flancs avec leurs poings serrés pour réduire un point de côté, et ils se laissaient tomber dans le veld, comme deux morts fauchés par une mitraille imaginaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8054d30e-f8d0-34a6-beb6-77edb74b48fb",
                                        "entry_id": "4cbb5a47-2f71-3004-bb6f-58ac3c4cb857",
                                        "glosses": [
                                            "Les balles de fer ou biscaïens, ordinairement mêlés de ferraille, dont on faisait les cartouches pour l’artillerie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c251b87e-af4a-43a7-9265-3263d6c06403",
                                                "sense_id": "8054d30e-f8d0-34a6-beb6-77edb74b48fb",
                                                "text": "Charger sous la mitraille."
                                            },
                                            {
                                                "example_id": "bf152413-dfae-4d8f-925f-9f7fba4df437",
                                                "sense_id": "8054d30e-f8d0-34a6-beb6-77edb74b48fb",
                                                "text": "Résister, tenir sous la mitraille."
                                            },
                                            {
                                                "example_id": "a2f2d978-0535-49e4-8a3e-bdc1ec7aa764",
                                                "sense_id": "8054d30e-f8d0-34a6-beb6-77edb74b48fb",
                                                "text": "Leur surprise fut grande, en arrivant, d’être reçus à coups de mitraille, et ils repartirent plus vite qu’ils n’étaient venus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e0be2a9-2697-3b7a-aa22-2c7bab2b47da",
                                        "entry_id": "4cbb5a47-2f71-3004-bb6f-58ac3c4cb857",
                                        "glosses": [
                                            "Décharge collective d’artillerie."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b0048b-737c-4e51-a6cf-394aebf79617",
                                                "sense_id": "3e0be2a9-2697-3b7a-aa22-2c7bab2b47da",
                                                "text": "Malgré une décharge à mitraille des deux plus grosses pièces, tous arrivèrent pêle-mêle sur un petit terrain de gazon, au pied des remparts à demi-ruinés."
                                            },
                                            {
                                                "example_id": "3ed54cd5-70c0-42b5-a863-41a766c8a218",
                                                "sense_id": "3e0be2a9-2697-3b7a-aa22-2c7bab2b47da",
                                                "text": "J’ai conté […] le miracle de cette résistance inouïe, à un contre six, […], dans la vase, les trous perfides des arroyos, sous un ciel qui crachait des tonnes de mitraille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e95d6d5-db43-3244-a4af-7bd00bfc6fff",
                                        "entry_id": "4cbb5a47-2f71-3004-bb6f-58ac3c4cb857",
                                        "glosses": [
                                            "Beaucoup de petite monnaie."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "159a5910-c1ca-47a4-a295-f94c11c7dae1",
                                                "sense_id": "9e95d6d5-db43-3244-a4af-7bd00bfc6fff",
                                                "text": "Après avoir farfouillé dans son sac elle pose sa mitraille sur le ramasse-monnaie du comptoir, comme ça, naïvement."
                                            },
                                            {
                                                "example_id": "9417b8aa-aec5-4cee-aad6-a79118959df2",
                                                "sense_id": "9e95d6d5-db43-3244-a4af-7bd00bfc6fff",
                                                "text": "Il était d’ailleurs debout, dans son costume élégant, à déposer sa mitraille sur la table tout en commandant d’autres verres et promettant d’un regard au patron qu’il allait parler moins fort."
                                            }
                                        ]
                                    }
                                ]
                            },
