                                    {
                                        "sense_id": "be8ffce4-e6d7-333a-9893-dde14e778989",
                                        "entry_id": "6fcd43fa-74c1-3138-8a8d-2ce94199de34",
                                        "glosses": [
                                            "A person authorized to act as representative for another; a deputy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02eaa0fa-560e-319a-8f35-77ab5ceec46f",
                                        "entry_id": "6fcd43fa-74c1-3138-8a8d-2ce94199de34",
                                        "glosses": [
                                            "A representative at a conference, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3ca7ae6-975e-3fb7-b7c5-81d8b2b3a0ed",
                                        "entry_id": "6fcd43fa-74c1-3138-8a8d-2ce94199de34",
                                        "glosses": [
                                            "An appointed representative in some legislative bodies."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e160978-0c1c-3fcb-8ff1-282122888b1f",
                                        "entry_id": "6fcd43fa-74c1-3138-8a8d-2ce94199de34",
                                        "glosses": [
                                            "A type of variable storing a reference to a method with a particular signature, analogous to a function pointer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c6b805e-7f13-46ed-8192-182ac38952e7",
                                                "sense_id": "1e160978-0c1c-3fcb-8ff1-282122888b1f",
                                                "text": "Historically, all viable frameworks have always provided a mechanism to implement callbacks. C# goes one step further and encapsulates callbacks into callable objects called delegates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1adf0a69-b90c-3c54-990d-6e51ebf26e11",
                                        "entry_id": "6fcd43fa-74c1-3138-8a8d-2ce94199de34",
                                        "glosses": [
                                            "A member of a governmental legislature who lacks voting power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c72a33bc-d5c3-4340-85d7-bc7adc2bc06a",
                                                "sense_id": "1adf0a69-b90c-3c54-990d-6e51ebf26e11",
                                                "text": "The house of delegates in apartheid-era South Africa lacked any real voting power."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "delegate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bb0583a-e44d-389e-9ac7-81754d8720f2",
                                        "entry_id": "a4cb3c00-681f-38a3-ae54-3146b6804836",
                                        "glosses": [
                                            "To commit tasks and responsibilities to others, especially subordinates."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d16a3409-58ee-48a9-95f2-cf0da44a77a3",
                                                "sense_id": "5bb0583a-e44d-389e-9ac7-81754d8720f2",
                                                "text": "New Zealand Prime Minister John Key was perceived to delegate effectively. Wayne Mapp, a minister under Key observed he had 'a different style than the traditional style of New Zealand political management. He delegates in the manner of a chief executive, and lets ministers get on with their jobs' (Mapp 2014)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd85c34f-af7f-379d-b93a-e692a8109abe",
                                        "entry_id": "a4cb3c00-681f-38a3-ae54-3146b6804836",
                                        "glosses": [
                                            "To commit (a task or responsibility) to someone, especially a subordinate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "776c64f2-c2c5-4c43-828e-c5abed0c714d",
                                                "sense_id": "cd85c34f-af7f-379d-b93a-e692a8109abe",
                                                "text": "The war on Covid-19 was delegated to the health secretary, Matt Hancock, a paralysed NHS and scientists publicly feuding over dud data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af5769d7-8cf5-3edd-9d8f-16b7bd44e2a6",
                                        "entry_id": "a4cb3c00-681f-38a3-ae54-3146b6804836",
                                        "glosses": [
                                            "(of a subdomain) To give away authority over a subdomain; to allow someone else to create sub-subdomains of a subdomain of one's own."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
