{
    "word_family": [
        "work",
        "shop",
        "workman",
        "workplace",
        "shopkeeper",
        "shopping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2596f3c8-348a-3909-8ff7-a9d11e212cee",
                    "sense_definition": "A brief, intensive course or meeting for a small group that emphasizes interaction and practical problem solving.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "educational_meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company organized a training <w>workshop</w> to help employees improve their communication skills.",
                            "target_lang_translations": {
                                "ru": "Компания организовала обучающий <w>семинар</w>, чтобы помочь сотрудникам улучшить навыки общения."
                            }
                        },
                        {
                            "text": "I am planning to attend a photography <w>workshop</w> this weekend to learn about lighting.",
                            "target_lang_translations": {
                                "ru": "В эти выходные я планирую посетить <w>мастер-класс</w> по фотографии, чтобы узнать о работе со светом."
                            }
                        }
                    ],
                    "synonyms": [
                        "seminar",
                        "class",
                        "tutorial"
                    ],
                    "common_phrases": [
                        "training workshop",
                        "attend a workshop",
                        "interactive workshop",
                        "writing workshop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткий интенсивный курс или встреча для небольшой группы, ориентированная на взаимодействие и решение практических задач."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воркшоп",
                                "target_lang_sense_clarification": "современный термин для практического семинара"
                            },
                            {
                                "target_lang_word": "семинар",
                                "target_lang_sense_clarification": "учебно-практическое занятие"
                            },
                            {
                                "target_lang_word": "мастер-класс",
                                "target_lang_sense_clarification": "занятие под руководством эксперта"
                            },
                            {
                                "target_lang_word": "практикум",
                                "target_lang_sense_clarification": "занятие, посвященное отработке навыков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c78124f5-fb0b-3f11-bedf-b30bf5c8b7b5",
                    "sense_definition": "A room or building where tools and machines are used for making or repairing things.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spends every Saturday in his <w>workshop</w> building wooden furniture for his friends.",
                            "target_lang_translations": {
                                "ru": "Каждую субботу он проводит в своей <w>мастерской</w>, изготавливая деревянную мебель для друзей."
                            }
                        },
                        {
                            "text": "The artist kept all of her paints and canvases in a small <w>workshop</w> behind the house.",
                            "target_lang_translations": {
                                "ru": "Художница держала все свои краски и холсты в небольшой <w>мастерской</w> за домом."
                            }
                        }
                    ],
                    "synonyms": [
                        "studio",
                        "garage",
                        "workroom"
                    ],
                    "common_phrases": [
                        "artist workshop",
                        "carpentry workshop",
                        "small workshop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещение или здание, где используются инструменты и станки для изготовления или ремонта вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастерская",
                                "target_lang_sense_clarification": "помещение для ремесленных или творческих работ"
                            },
                            {
                                "target_lang_word": "цех",
                                "target_lang_sense_clarification": "производственное подразделение на заводе"
                            },
                            {
                                "target_lang_word": "ателье",
                                "target_lang_sense_clarification": "мастерская художника или фотографа"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1577e373-782d-3d9d-94ae-d45291036045",
                    "sense_definition": "To develop or improve a piece of work, such as a script or a project, through collaborative discussion and practice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "collaborative_improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors spent the afternoon <w>workshopping</w> the new script to see which jokes landed best.",
                            "target_lang_translations": {
                                "ru": "Актеры провели вторую половину дня, <w>прорабатывая</w> новый сценарий, чтобы понять, какие шутки воспринимаются лучше всего."
                            }
                        },
                        {
                            "text": "We need to <w>workshop</w> these ideas before we present the final proposal to the board.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>обсудить</w> эти идеи, прежде чем представлять окончательное предложение совету директоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "develop",
                        "refine",
                        "rehearse"
                    ],
                    "common_phrases": [
                        "workshop a script",
                        "workshop an idea",
                        "workshop a project"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрабатывать или улучшать проект, сценарий или идею в ходе совместного обсуждения и практики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прорабатывать",
                                "target_lang_sense_clarification": "детально обсуждать и улучшать"
                            },
                            {
                                "target_lang_word": "обкатывать",
                                "target_lang_sense_clarification": "проверять идею или сценарий на практике"
                            },
                            {
                                "target_lang_word": "дорабатывать",
                                "target_lang_sense_clarification": "вносить изменения в ходе обсуждения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}