                "senses": [
                    {
                        "sense_id": "a919872b-8ebb-37d5-b0d5-ffb39ed9ecd9",
                        "entry_id": "dc219436-e4b6-3b94-bd38-a5758b1bcdb9",
                        "glosses": [
                            "środowisko zacofane; zob. też Ciemnogród w Encyklopedii staropolskiej"
                        ],
                        "tags": [
                            "colloquial",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "aec2b85a-b90e-44e3-a1af-cc78d815bc83",
                                "sense_id": "a919872b-8ebb-37d5-b0d5-ffb39ed9ecd9",
                                "text": "Po studiach zostaję w mieście, nie zamierzam wracać do tego ciemnogrodu, gdzie panna z dzieckiem to obiekt oburzenia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2477b810-7ad2-45ac-bffc-80b7e4bc6ed1",
                        "source_entry_id": "dc219436-e4b6-3b94-bd38-a5758b1bcdb9",
                        "source_sense_id": "a919872b-8ebb-37d5-b0d5-ffb39ed9ecd9",
                        "target_lang_word": "мракобе́сие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мракобе́сие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4f7af0ca-2b5d-3945-bfb3-f13b36cc8147",
                                        "entry_id": "e9acb67f-26e5-3d58-a3b9-f7e10be4dfe0",
                                        "glosses": [
                                            "презр. взгляды и образ действий мракобесов; обскурантизм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c3fd5fb-f487-40f3-b4f4-0b9651e83294",
                                                "sense_id": "4f7af0ca-2b5d-3945-bfb3-f13b36cc8147",
                                                "text": "Проповедник кнута, апостол невежества, поборник обскурантизма и мракобесия, панегирист татарских нравов — что Вы делаете?.. Взгляните себе под ноги: ведь Вы стоите над бездною."
                                            },
                                            {
                                                "example_id": "1af44259-b6a9-485f-aa05-6bed3d28b665",
                                                "sense_id": "4f7af0ca-2b5d-3945-bfb3-f13b36cc8147",
                                                "text": "…В то время, как одни обвиняют меня в оскорблении молодого поколения, в отсталости, в мракобесии… — другие, напротив, с негодованием упрекают меня в низкопоклонстве перед самым этим молодым поколением"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
