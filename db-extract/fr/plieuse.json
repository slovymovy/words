                                "example_id": "735e12d6-c533-4951-996e-60556b28eaf0",
                                "sense_id": "bab03642-6a02-3b4c-995e-aa5153b5c51c",
                                "text": "Mais Jacquotte était une infatigable plieuse de linge, par caractère frotteuse de meubles, amoureuse d’une propreté tout ecclésiastique, la plus minutieuse, la plus reluisante, la plus douce des propretés."
                            },
                            {
                                "example_id": "ba21d2db-f47f-4474-a966-cdf9df002321",
                                "sense_id": "bab03642-6a02-3b4c-995e-aa5153b5c51c",
                                "text": "Tous les matins elle allait à une imprimerie rue du Sabot, nᵒ 3, où elle était plieuse et brocheuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "f49dfb44-e9b0-3bd8-a109-960ff0cbf310",
                        "entry_id": "71dc9efb-7aa0-3780-a39b-a51d71b3e2c3",
                        "glosses": [
                            "Machine qui sert à plier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a25aa4d8-d964-425c-a113-193b0f19ca6d",
                                "sense_id": "f49dfb44-e9b0-3bd8-a109-960ff0cbf310",
                                "text": "Plieuse de livres, de brochures, de journaux."
                            },
                            {
                                "example_id": "537a9864-fa18-4f0b-839d-1a3982b56797",
                                "sense_id": "f49dfb44-e9b0-3bd8-a109-960ff0cbf310",
                                "text": "Plieuses de soie."
                            },
                            {
                                "example_id": "d2a3fd3a-fb5f-4e23-8ed5-651112d3c8fc",
                                "sense_id": "f49dfb44-e9b0-3bd8-a109-960ff0cbf310",
                                "text": "Plieuse à tôle."
                            }
                        ]
