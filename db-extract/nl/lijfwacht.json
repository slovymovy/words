                        "source_entry_id": "36c0d29a-af35-3da8-baad-78e97ac9a632",
                        "source_sense_id": "2355b3fa-a91d-3658-8abd-a68d52cebd60",
                        "source_sense_description": "de wacht die met de bewaking van een vorst of aanzienlijk persoon belast is",
                        "target_lang_word": "garde rapprochée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garde rapprochée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a472aeb-6f75-3105-ae85-7b2a3536b68b",
                                        "entry_id": "620a9c97-407c-3cff-af94-381404645579",
                                        "glosses": [
                                            "Entourage proche et personnes de confiance d'une personnalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08286a5a-332c-4bfb-82ba-7a0d225ca3bd",
                                                "sense_id": "5a472aeb-6f75-3105-ae85-7b2a3536b68b",
                                                "text": "Ex-membre de la garde rapprochée du maire François Cuillandre, le Landernéen, élu socialiste depuis 1989, aura occupé des postes clés : adjoint aux finances, à la cohésion sociale, vice-président de l’agglomération en charge des services à la population…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c2a2ce0-4a4f-47a8-83b8-c40716108895",
                        "source_entry_id": "36c0d29a-af35-3da8-baad-78e97ac9a632",
                        "source_sense_id": "e4d0e14c-789c-36dc-834f-cd7482e81396",
                        "source_sense_description": "een lid van een lijfwacht",
                        "target_lang_word": "Leibwächter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leibwächter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                        "entry_id": "06125b45-8f52-3461-8b42-14f3823607c8",
                                        "glosses": [
                                            "jemand, der die (gewerbsmäßige) Aufgabe hat, eine oder mehrere andere Personen zu beschützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f261746-bc08-4bf6-9aaa-e6e767a6e5b9",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "Die Leibwächter konnten den Angriff auf den Präsidenten verhindern und ihn in Sicherheit bringen."
                                            },
                                            {
                                                "example_id": "c9792866-0e7c-43a2-8c88-e48debdd310c",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "„Er war der Leibwächter eines wichtigen Mannes mit »schweren Hoden«, wie Hamid jemanden bezeichnet, der Macht innehat.“"
                                            },
                                            {
                                                "example_id": "f8ec6bfd-aa86-480a-9650-7baf2c4ebba3",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "„In Kleinasien waren, wie erwähnt, die Galater als Söldner tätig, in Jerusalem dienten sie als Leibwächter für Herodes den Großen.“"
                                            },
                                            {
                                                "example_id": "1aa4157b-fdb2-4d5d-8eaa-d843461dd3ec",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "„Im Jahr 1994 wurde Dr. John Britton samt seinem Leibwächter ermordet.“"
                                            },
                                            {
                                                "example_id": "f9a3478a-6744-47f0-aac3-d931cc4f3b1d",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "„Und ich erfuhr, dass es ihn nicht gab, er nur als eine Art virtueller Leibwächter diente.“"
                                            },
                                            {
                                                "example_id": "f6a08538-f097-4a1d-ab11-a4ebfde565a9",
                                                "sense_id": "a3a51ee1-c8b3-3ed6-8db7-122b5ea8769a",
                                                "text": "„Anfang Januar 2011 wurde Salman Taseer, der Gouverneur der Provinz Punjab, von seinem eigenen Leibwächter erschossen, weil er sich für eine Reform des Gesetzes stark gemacht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcc0b557-128f-44e6-9bb0-af2d732e9089",
