                ],
                "senses": [
                    {
                        "sense_id": "fa31bd99-ce4d-3b98-9aa4-edd902abd38d",
                        "entry_id": "01c6f832-2280-39d4-8409-304d97b0bafe",
                        "glosses": [
                            "Dach aus Glas in Gebäuden oder Fahrzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5574bf36-dd71-4a38-996d-799fb073e0ca",
                                "sense_id": "fa31bd99-ce4d-3b98-9aa4-edd902abd38d",
                                "text": "Die Sonne grinste uns durch das Glasdach an und entgegen."
                            },
                            {
                                "example_id": "508cc00c-2e9c-4f7d-99c8-bab1f76d61cd",
                                "sense_id": "fa31bd99-ce4d-3b98-9aa4-edd902abd38d",
                                "text": "„Unter dem Glasdach der Passage hängt Wäsche.“"
                            },
                            {
                                "example_id": "bca32934-ee66-486d-b2cf-3e2a6e4b34be",
                                "sense_id": "fa31bd99-ce4d-3b98-9aa4-edd902abd38d",
                                "text": "„Konrad und seine Schwester erwarteten mich auf der Treppe unter dem Glasdach, dessen Scheiben im letzten Sommer kurz und klein geschossen worden waren, so daß die Eisenstangen wie die Rippen eines welken und zerzausten Blattes aussahen.“"
                            },
                            {
                                "example_id": "d6841193-829c-40b1-bf72-f42c1f9ecae2",
                                "sense_id": "fa31bd99-ce4d-3b98-9aa4-edd902abd38d",
                                "text": "„Über dem gewölbten Glasdach leuchtete ein klarer blauer Himmel.“"
                            },
                            {
                                "example_id": "465ac42c-ad1a-4c35-bbd9-2f042cbe82b5",
                                "sense_id": "fa31bd99-ce4d-3b98-9aa4-edd902abd38d",
                                "text": "„Die Sonne brach durch das Glasdach und rückte die Menschen in der Ausstellungshalle in Licht und Schatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "446f9de6-762c-4906-b271-25c4ce62b945",
                        "source_entry_id": "01c6f832-2280-39d4-8409-304d97b0bafe",
                        "source_sense_id": "fa31bd99-ce4d-3b98-9aa4-edd902abd38d",
                        "source_sense_description": "Dach aus Glas in Gebäuden oder Fahrzeugen",
                        "target_lang_word": "verrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68c6562b-f26d-3ead-9042-614189747a24",
                                        "entry_id": "0d12c378-7dd3-3983-93f1-ff4564a21eff",
                                        "glosses": [
                                            "Baie vitrée située soit en toiture, soit en façade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c00a062-f0f7-4692-9149-3bcb08e28793",
                                                "sense_id": "68c6562b-f26d-3ead-9042-614189747a24",
                                                "text": "Il pleuvait. Par instants, on entendait l’averse s’écraser contre la verrière du haut, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8552da33-0d0c-3c70-a31b-693960c5daaf",
                                        "entry_id": "0d12c378-7dd3-3983-93f1-ff4564a21eff",
                                        "glosses": [
                                            "Vitrail de grande dimension."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "483ac2d1-86d7-4350-89f6-91f9e5067aa1",
                                                "sense_id": "8552da33-0d0c-3c70-a31b-693960c5daaf",
                                                "text": "C’est une verrière diaprée, une filigrane gigantesque, une parure de fête, aussi ouvragées que celles d’une reine et d’une fiancée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85dc9f97-0b90-3d6e-b2b6-3225c7fee62f",
                                        "entry_id": "0d12c378-7dd3-3983-93f1-ff4564a21eff",
                                        "glosses": [
                                            "Grande fenêtre ornée de vitraux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7a02d9d-495c-41d5-b30f-4004861f9984",
                                                "sense_id": "85dc9f97-0b90-3d6e-b2b6-3225c7fee62f",
                                                "text": "Les verrières, immenses et nombreuses (car ce chevet et ce transept semblent une véritable lanterne), sont de la plus grande magnificence comme composition et couleur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf78d688-f68d-3e10-9cea-cef827c09cba",
                                        "entry_id": "0d12c378-7dd3-3983-93f1-ff4564a21eff",
                                        "glosses": [
                                            "Partie vitrée du poste de pilotage, de l’habitacle d’un aéronef."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79893471-13c3-3d38-86e8-ccbdf84f22a4",
                                        "entry_id": "0d12c378-7dd3-3983-93f1-ff4564a21eff",
                                        "glosses": [
                                            "Cuvette à bordure crénelée dans laquelle on place des verres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b3dd7cd-cb39-3d20-bcf6-5acd53e73e8c",
                                        "entry_id": "0d12c378-7dd3-3983-93f1-ff4564a21eff",
                                        "glosses": [
                                            "Artisane qui fait du verre et des ouvrages de verre."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "273ef346-eaac-4387-b0be-8ad2bfe4a149",
                                                "sense_id": "1b3dd7cd-cb39-3d20-bcf6-5acd53e73e8c",
                                                "text": "Lundi 28 mars, Corinne Allard-Jumel, verrière d’art et gérante de l’atelier Corinne créations situé au 10, rue du Ravelin à Limalonges et installée sur la commune depuis septembre 2021, recevait Sébastien Kugler, le président de la chambre de métiers et de l’artisanat Nouvelle-Aquitaine – Deux-Sèvres, à l’occasion du lancement des Journées européennes des métiers d’art."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "verrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa1d0616-8f21-3ee9-bb60-f0da0be11995",
                                        "entry_id": "fb765f71-1b71-3444-9261-b3f782426378",
                                        "glosses": [
                                            "Féminin singulier de verrier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e924872f-d3cc-4566-ab7c-142e448c265e",
                                                "sense_id": "fa1d0616-8f21-3ee9-bb60-f0da0be11995",
                                                "text": "Suivant Carlo Marin et le comte Filiasi, auteurs italiens, la naissance de l’industrie verrière vénitienne serait presque contemporaine de la fondation de la ville, attribuée, comme on sait, à l’émigration de quelques familles d’Aquilée et de Padoue qui, fuyant les armées d’Attila, vinrent chercher un refuge dans les îles des lagunes vers l’an 420."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
