{
    "word_family": [
        "humorous",
        "humorist",
        "humorless",
        "humorously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7a88d03f-1e07-3c51-90d0-9e6fd4f46d55",
                    "sense_definition": "The quality of being amusing or comic, or the ability to appreciate jokes and funny situations.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a wonderful sense of <w>humor</w> that makes everyone laugh.",
                            "target_lang_translations": {
                                "ru": "У нее прекрасное чувство <w>юмора</w>, которое заставляет всех смеяться.",
                                "zh": "她有一种极好的<w>幽默</w>感，总能把大家逗笑。"
                            }
                        },
                        {
                            "text": "The movie was full of <w>humor</w> and exciting action scenes.",
                            "target_lang_translations": {
                                "ru": "Фильм был полон <w>юмора</w> и захватывающих экшн-сцен.",
                                "zh": "这部电影充满了<w>幽默</w>和激动人心的动作场面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comedy",
                        "amusement",
                        "wit",
                        "funniness"
                    ],
                    "antonyms": [
                        "seriousness",
                        "solemnity"
                    ],
                    "common_phrases": [
                        "sense of humor",
                        "dark humor",
                        "dry humor",
                        "good humor"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество быть забавным или комичным, или способность ценить шутки и смешные ситуации.",
                        "zh": "指事物有趣或滑稽的特质，或者欣赏笑话和滑稽情境的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юмор",
                                "target_lang_sense_clarification": "способность видеть смешное"
                            },
                            {
                                "target_lang_word": "комизм",
                                "target_lang_sense_clarification": "смешная сторона ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幽默",
                                "target_lang_sense_clarification": "指风趣、滑稽的特质或能力"
                            },
                            {
                                "target_lang_word": "诙谐",
                                "target_lang_sense_clarification": "指言谈举止风趣幽默"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8488d68f-5e56-309e-8b84-6c996c0fb4b1",
                    "sense_definition": "To agree with someone's wishes or mood, often to keep them happy or avoid conflict.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I know you disagree, but please <w>humor</w> me for a moment and listen.",
                            "target_lang_translations": {
                                "ru": "Я знаю, что ты не согласен, но, пожалуйста, <w>подыграй</w> мне на минутку и выслушай.",
                                "zh": "我知道你不同意，但请暂时<w>迁就</w>我一下，听我说完。"
                            }
                        },
                        {
                            "text": "He decided to <w>humor</w> his boss by laughing at the bad joke.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>угодить</w> начальнику, посмеявшись над плохой шуткой.",
                                "zh": "他决定<w>迎合</w>老板，对那个烂笑话笑了笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "indulge",
                        "gratify",
                        "pamper"
                    ],
                    "antonyms": [
                        "oppose",
                        "resist"
                    ],
                    "common_phrases": [
                        "humor someone",
                        "humor me"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соглашаться с чьими-либо желаниями или настроением, часто чтобы сохранить спокойствие или избежать конфликта.",
                        "zh": "为了让某人高兴或避免冲突，而顺从某人的意愿或情绪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потакать",
                                "target_lang_sense_clarification": "снисходительно соглашаться"
                            },
                            {
                                "target_lang_word": "ублажать",
                                "target_lang_sense_clarification": "выполнять прихоти"
                            },
                            {
                                "target_lang_word": "подыгрывать",
                                "target_lang_sense_clarification": "притворно соглашаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迁就",
                                "target_lang_sense_clarification": "为了照顾对方而改变自己的态度或做法"
                            },
                            {
                                "target_lang_word": "顺着",
                                "target_lang_sense_clarification": "顺从某人的意愿或想法"
                            },
                            {
                                "target_lang_word": "迎合",
                                "target_lang_sense_clarification": "为了讨好而附和对方"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}