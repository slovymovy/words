                "senses": [
                    {
                        "sense_id": "2fe855b1-0980-3f50-bef0-c69432b780f4",
                        "entry_id": "53ac3d55-114f-3f91-996d-145fbe9b85f0",
                        "glosses": [
                            "eine den Magen betreffende Krebserkrankung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ef5a63-2eed-437a-b977-e89055af270a",
                                "sense_id": "2fe855b1-0980-3f50-bef0-c69432b780f4",
                                "text": "„Eine Enterostomie wird z. B. bei einem inoperablen Magenkarzinom durchgeführt, um die künstliche Ernährung von außen zu gewährleisten.“"
                            },
                            {
                                "example_id": "1a751d0e-3732-4cb8-9eb1-de2dbd28fe46",
                                "sense_id": "2fe855b1-0980-3f50-bef0-c69432b780f4",
                                "text": "„Besondere Bedeutung hat die Gastroskopie bei der Früherkennung von Magenkarzinomen und der Verlaufskontrolle von Magengeschwüren.“"
                            },
                            {
                                "example_id": "f1f24493-bc58-4191-a11f-05cefb421e4b",
                                "sense_id": "2fe855b1-0980-3f50-bef0-c69432b780f4",
                                "text": "„Als die Ärzte von einem Magenkarzinom sprachen, willigte er in alles ein, er machte alles mit, schluckte alle Tabletten, ließ sich jede Nadel setzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
