        "ru-extract.jsonl": [
            {
                "entry_id": "b4fc09d8-c5d3-3d35-8abe-727328bd2c12",
                "word": "вскоре",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fb5a5e70-bc04-37ed-86cd-2592b6d1a3be",
                        "entry_id": "b4fc09d8-c5d3-3d35-8abe-727328bd2c12",
                        "glosses": [
                            "в недалёком будущем, через небольшой промежуток времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113c8117-cbb9-4ec7-9a47-7a0a5758268e",
                                "sense_id": "fb5a5e70-bc04-37ed-86cd-2592b6d1a3be",
                                "text": "Вскоре за научные заслуги он получит от британского правительства титул лорда Нельсона."
                            }
                        ]
                    },
                    {
                        "sense_id": "d69b643c-e82f-372a-b20e-00ae1df107d4",
                        "entry_id": "b4fc09d8-c5d3-3d35-8abe-727328bd2c12",
                        "glosses": [
                            "спустя совсем немного времени после чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7641a6ec-774d-4263-b439-ae35085bb125",
                                "sense_id": "d69b643c-e82f-372a-b20e-00ae1df107d4",
                                "text": "Выкормив лошадей, мы вскоре после полдён, часу во втором, пустились в путь."
                            },
                            {
                                "example_id": "3180a18b-8a61-47f3-a92d-73f4fa63af22",
                                "sense_id": "d69b643c-e82f-372a-b20e-00ae1df107d4",
                                "text": "Вскоре после обеда гости уехали, чтоб успеть переодеться к свадьбе."
                            },
                            {
                                "example_id": "e2f40558-e8bd-48cb-a08b-6df734cd0910",
                                "sense_id": "d69b643c-e82f-372a-b20e-00ae1df107d4",
                                "text": "Потом он совсем замолчал, и вскоре послышалось из-под пледа его всхрапывание."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e08fd17b-c76d-4caa-b793-949887231465",
                        "source_entry_id": "b4fc09d8-c5d3-3d35-8abe-727328bd2c12",
                        "target_lang_word": "soon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b7eb68-e050-39c6-b3f8-9cf17a74f364",
                                        "entry_id": "7e2f33f8-1630-3b54-8efc-d1b3502d08c9",
                                        "glosses": [
                                            "Short in length of time from the present."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3173a0e7-5e22-4ea5-911a-bd539f8bd51d",
                                                "sense_id": "d7b7eb68-e050-39c6-b3f8-9cf17a74f364",
                                                "text": "I need the soonest date you have available."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                        "entry_id": "7e2f33f8-1630-3b54-8efc-d1b3502d08c9",
                                        "glosses": [
                                            "Early."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f4dae0-cab4-4340-a865-86ec92591542",
                                                "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                                "text": "Late in the evening we arrived at Quincy where we bivouacked for the night and taken a soon start the next morning to march to the arsenal."
                                            },
                                            {
                                                "example_id": "de10cacb-480f-4fe5-84fa-692fc6ea0bd5",
                                                "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                                "text": "Got up pretty early, ate a soon breakfast, had the sulky and was about to start to Newtown when it commenced raining.."
                                            },
                                            {
                                                "example_id": "3f156422-1ac6-436a-a9a6-b13ef6bdcca3",
                                                "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                                "text": "They were different from colored folks who had to be out to get a soon start."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8335078-0ca3-36fa-94b7-368247768676",
                                        "entry_id": "7e2f33f8-1630-3b54-8efc-d1b3502d08c9",
                                        "glosses": [
                                            "Used as an alternative to express 'to be going to' in the form 'to be soon to'."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eec91b3-3572-4fc7-9fc0-33cdeb5e75ff",
                                                "sense_id": "b8335078-0ca3-36fa-94b7-368247768676",
                                                "text": "Hurry up, the wedding is soon to start!"
                                            },
                                            {
                                                "example_id": "96e6da7d-c537-4b32-b1c9-71414e58b574",
                                                "sense_id": "b8335078-0ca3-36fa-94b7-368247768676",
                                                "text": "A new shop is soon to be opened in this street."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64920a44-afc2-371a-a23b-21428d4c888f",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Immediately, instantly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Within a short time; quickly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "555d5a98-8f4e-4e10-836c-f8b7d11041ee",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "His wife is likely to come too after him, but we just do not know how soon after."
                                            },
                                            {
                                                "example_id": "f2669e72-cf69-4a66-8240-b2d56ba10d59",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                                            },
                                            {
                                                "example_id": "fb1399c9-d019-47de-a189-5f2d81e92d7b",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly,[…], down the nave to the western door.[…]At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            },
                                            {
                                                "example_id": "1dbfb7b6-6a4e-4005-8caa-86e72479b0bb",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese[…]began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f852e2c8-c2a6-3a36-bea3-11f8e5346b87",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Early."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b5e7563-0256-4adc-a899-17a9c5b43978",
                                                "sense_id": "f852e2c8-c2a6-3a36-bea3-11f8e5346b87",
                                                "text": "How is it that ye are come so soon to day?"
                                            },
                                            {
                                                "example_id": "bd10ade2-b7b4-42b4-9d0c-308e53e73d1e",
                                                "sense_id": "f852e2c8-c2a6-3a36-bea3-11f8e5346b87",
                                                "text": "“Been huntin’ fuh mah mule. Anybody seen ’im?” he asked.\n“Seen ’im soon dis mornin’ over behind de school-house,” Lum said. “’’Bout ten o’clock or so. He musta been out all night tuh be way over dere dat early.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c6f0278-1a57-3172-9a1f-4163191adc56",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Readily; willingly; used with would, or some other word expressing will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06526372-cf03-4d8d-b562-8d279ecd6668",
                                                "sense_id": "4c6f0278-1a57-3172-9a1f-4163191adc56",
                                                "text": "I would as soon see a river winding through woods or in meadows, as when it is tossed up in so many whimsical figures at Versailles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b650db4-1887-4285-a754-e51d1f298153",
                        "source_entry_id": "b4fc09d8-c5d3-3d35-8abe-727328bd2c12",
                        "target_lang_word": "shortly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shortly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58e96d1b-d2ac-3f52-98b2-2bfce69f0755",
                                        "entry_id": "309aabbf-7b96-3ee2-a610-737f95513877",
                                        "glosses": [
                                            "In a short or brief time or manner; quickly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3216b52-6d55-3594-bba5-c7294d70698d",
                                        "entry_id": "309aabbf-7b96-3ee2-a610-737f95513877",
                                        "glosses": [
                                            "In or after a short time; soon."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74cdfde1-a1fe-401c-8a76-a1876744cacb",
                                                "sense_id": "f3216b52-6d55-3594-bba5-c7294d70698d",
                                                "text": "The past perfect progressive is used for actions and situations which had continued up to a past moment or shortly before it."
                                            },
                                            {
                                                "example_id": "0a843fd0-d092-486c-9f48-9c39095db029",
                                                "sense_id": "f3216b52-6d55-3594-bba5-c7294d70698d",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "fa4e208a-c49a-4a39-b055-7da4dc69dffc",
                                                "sense_id": "f3216b52-6d55-3594-bba5-c7294d70698d",
                                                "text": "Kaplan-Miller said she first joined the Sisterhood of Salaam Shalom, an interfaith organization that was founded by a Muslim and a Jewish woman in suburban New Jersey, shortly after the 2016 election."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d2be974-36c7-3a31-901f-85c8fc83ddc5",
                                        "entry_id": "309aabbf-7b96-3ee2-a610-737f95513877",
                                        "glosses": [
                                            "In few words."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5044cfa5-c7f0-4f1d-b328-f9f5433c678e",
                                                "sense_id": "2d2be974-36c7-3a31-901f-85c8fc83ddc5",
                                                "text": "Ideas are generally expressed more shortly in verse than in prose"
                                            },
                                            {
                                                "example_id": "d285901c-b604-429c-b7ca-3a8752ef65ec",
                                                "sense_id": "2d2be974-36c7-3a31-901f-85c8fc83ddc5",
                                                "text": "We shall not describe this tragical scene too fully; but we thought ourselves obliged, by that historic integrity which we profess, shortly to hint a matter which we would otherwise have been glad to have spared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986ede6f-1f20-3973-b55e-6fe8d7bd205a",
                                        "entry_id": "309aabbf-7b96-3ee2-a610-737f95513877",
                                        "glosses": [
                                            "In an irritable (\\\"short\\\") manner."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3262c24d-6606-4a33-abbd-d791ece6979e",
                                                "sense_id": "986ede6f-1f20-3973-b55e-6fe8d7bd205a",
                                                "text": "\"Stop interrupting me, will ya?\" she said shortly."
                                            },
                                            {
                                                "example_id": "e71ae46d-341c-463a-9e39-7167292de008",
                                                "sense_id": "986ede6f-1f20-3973-b55e-6fe8d7bd205a",
                                                "text": "'Well, I still think it was a rather off-hand way for you—for anyone—to behave,' he said shortly.\nSuddenly Melody felt trapped—and annoyed. And she didn't like being spoken to like a child, either."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c5348c9-43ef-4dd1-a104-400071ab45a4",
                        "source_entry_id": "b4fc09d8-c5d3-3d35-8abe-727328bd2c12",
                        "target_lang_word": "before long",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "before long",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0476635c-d864-366a-aaf1-6ac47039acb6",
                                        "entry_id": "2318f689-4425-3acf-881c-7f45e53ce6bc",
                                        "glosses": [
                                            "soon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ad81c36-7d17-4f0f-a90c-1a2263c38443",
                                                "sense_id": "0476635c-d864-366a-aaf1-6ac47039acb6",
                                                "text": "They left before long."
                                            },
                                            {
                                                "example_id": "7de3bca4-1a4a-4720-9df3-372f2a9c730b",
                                                "sense_id": "0476635c-d864-366a-aaf1-6ac47039acb6",
                                                "text": "I knew they'd arrive before long."
                                            },
                                            {
                                                "example_id": "915ecaba-c5ec-468b-8238-a3e368a04527",
                                                "sense_id": "0476635c-d864-366a-aaf1-6ac47039acb6",
                                                "text": "It is to be hoped that some corresponding smartening up of these other schedules may be expected before long."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
