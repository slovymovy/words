                "senses": [
                    {
                        "sense_id": "fb03859c-d7f0-39a7-b159-50b9dd5e5f22",
                        "entry_id": "4234ec39-c211-3526-a042-ae46977f7398",
                        "glosses": [
                            "Donner un caractère léthargique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6d1290-9bf2-4163-a2d7-0fe7e2b6100a",
                                "sense_id": "fb03859c-d7f0-39a7-b159-50b9dd5e5f22",
                                "text": "Philistin, qui se laisse charmer par un Rossini, stupéfier par un Meyerbeer, étonner par un Berlioz, « léthargiser » par un Schumann !"
                            },
                            {
                                "example_id": "5c0a175f-4d7f-45b1-9bc2-d0b4b814e210",
                                "sense_id": "fb03859c-d7f0-39a7-b159-50b9dd5e5f22",
                                "text": "Et la pluie, la pluie, je n’ai plus le soleil pour oublier, léthargiser l’après-midi dans le jardin."
                            }
                        ]
                    }
