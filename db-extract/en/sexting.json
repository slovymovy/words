                        "entry_id": "5d6910b2-34e9-3c47-a812-752228cb829e",
                        "glosses": [
                            "The act of transmitting and/or receiving sexually suggestive text messages and/or photographs between cell phones equipped with text messaging."
                        ],
                        "tags": [
                            "slang",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8335c60f-f586-42ef-b441-ede78fb639da",
                                "sense_id": "6ed9ede0-17a2-3e9e-90f3-a2e049d9e271",
                                "text": "There are already concerns that young people are unaware of the serious legal implications that sexting can have."
                            },
                            {
                                "example_id": "a2d34861-5671-4e00-b157-1ea472c9d34a",
                                "sense_id": "6ed9ede0-17a2-3e9e-90f3-a2e049d9e271",
                                "text": "But perhaps the most critical question in this area of research concerns the effect of sexting on relationship quality. Does sexting benefit or harm relationships?"
                            }
                        ]
                    }
