                        "entry_id": "c08e966c-19fd-35f1-a292-dd75a5b944af",
                        "glosses": [
                            "to whirl, to churn"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f9e0b1bb-4785-3912-bfc8-44c0475ea06e",
                        "entry_id": "c08e966c-19fd-35f1-a292-dd75a5b944af",
                        "glosses": [
                            "to rise or descend in a whirl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84393e1f-e30f-4cd3-b599-7453691e0870",
                                "sense_id": "f9e0b1bb-4785-3912-bfc8-44c0475ea06e",
                                "text": "Er was al een gat in de dijk gekolkt.",
                                "translation": "The whirling waters had already breached the dyke",
                                "english": "The whirling waters had already breached the dyke"
                            }
                        ]
                    },
                    {
                        "sense_id": "e3d32f5b-db9e-3eb3-9a3b-4929e9b93da0",
                        "entry_id": "c08e966c-19fd-35f1-a292-dd75a5b944af",
                        "glosses": [
                            "to experience strong emotions, to seethe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8f9baea-070b-4341-830b-fad2e7c2a89c",
                                "sense_id": "e3d32f5b-db9e-3eb3-9a3b-4929e9b93da0",
                                "text": "Hij kolkte inwendig van woede, maar bleef kalm",
                                "translation": "Inwardly he was seething for anger, but he stayed calm.",
                                "english": "Inwardly he was seething for anger, but he stayed calm."
                            }
                        ]
                    }
