                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce qui semblait être une remarque <w>anodine</w> a provoqué une vive dispute lors du dîner."
                        },
                        {
                            "text": "Son absence répétée aux réunions de direction n'est vraiment pas un acte <w>anodin</w>."
