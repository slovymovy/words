                "senses": [
                    {
                        "sense_id": "957051a6-71bb-3f88-98ab-447aa568ff86",
                        "entry_id": "dcd4f6d7-41c8-3f26-8c80-571e46f9251c",
                        "glosses": [
                            "provisorische Unterkunft für eine Menschengruppe, bestehend aus mehreren Zelten im Freien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84fa2ffa-4ad0-4aae-81b8-f7e17be7e1cc",
                                "sense_id": "957051a6-71bb-3f88-98ab-447aa568ff86",
                                "text": "Ich schicke meine Kinder jeden Sommer für zwei Wochen in ein Zeltlager an die Ostsee."
                            },
                            {
                                "example_id": "5b9e4265-06bf-47ce-8d48-f5a38b4065fc",
                                "sense_id": "957051a6-71bb-3f88-98ab-447aa568ff86",
                                "text": "Nach der Evakuierung des Erdbebengebiets wurden die Bewohner in einem eilig errichteten Zeltlager des Roten Halbmondes untergebracht."
                            },
                            {
                                "example_id": "ccb49ac8-8840-437f-b592-c154a5549a6e",
                                "sense_id": "957051a6-71bb-3f88-98ab-447aa568ff86",
                                "text": "„Diese Tage im Zeltlager waren die unangenehmsten, die ich je irgendwo verbracht habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
