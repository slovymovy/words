                                        "entry_id": "d4d1fba6-f670-3246-834b-22c4d9854e70",
                                        "glosses": [
                                            "weiches Papier zur Reinigung der Ausscheidungsorgane nach dem Stuhlgang oder nach dem Harnlassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a89e075-2576-49db-a1ff-b602c33c0896",
                                                "sense_id": "61fa83f1-333c-3dcd-9859-3cc53f8d5100",
                                                "text": "Ich benutze ausschließlich weiches Toilettenpapier."
                                            },
                                            {
                                                "example_id": "44603d18-6fb6-4798-b46f-471b688e7baa",
                                                "sense_id": "61fa83f1-333c-3dcd-9859-3cc53f8d5100",
                                                "text": "„Ich griff nach Toilettenpapier und Taschenlampe und eilte über den Hof.“"
                                            },
                                            {
                                                "example_id": "96f22552-9f0b-4f00-acde-d3c5dd9d1167",
                                                "sense_id": "61fa83f1-333c-3dcd-9859-3cc53f8d5100",
                                                "text": "„Oft wandten sich die Gespräche dem Schicksal von Frankreich in einem sich nahezu täglich wandelnden Europa zu, mit einem Krieg in Spanien und einem Diktator in Deutschland, dessen Versprechungen nicht mehr wert waren als Toilettenpapier, wie Gide sich ausdrückte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
