                    {
                        "sense_id": "e3f685ca-25c4-3ffd-9f27-c6ed82095d68",
                        "entry_id": "a237e9a0-77ec-3402-9676-d709ba0805a6",
                        "glosses": [
                            "Appellation hypocoristique d'un objet personnifié, souvent une voiture."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "73a44af0-e7c5-4c83-b977-179cb609066a",
                                "sense_id": "e3f685ca-25c4-3ffd-9f27-c6ed82095d68",
                                "text": "8 mois et demi après un accident de la route, je retrouve enfin ma titine que je ramène à la maison."
                            },
                            {
                                "example_id": "c2d207c4-174a-42a2-8037-e2c7ec9ee909",
                                "sense_id": "e3f685ca-25c4-3ffd-9f27-c6ed82095d68",
                                "text": "Parmi les souvenirs de titines de nos lecteurs et de nos lectrices, on trouve l’Aston Martin de James Bond et la Batmobile, bien sûr, mais aussi le corbillard recyclé en voiture d’intervention dans SOS Fantômes."
                            },
                            {
                                "example_id": "888c73cf-5042-495b-8cfc-f1652c01338c",
                                "sense_id": "e3f685ca-25c4-3ffd-9f27-c6ed82095d68",
                                "text": "Vendre ma titine ?"
                            }
                        ]
