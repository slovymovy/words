                "senses": [
                    {
                        "sense_id": "eb8eb299-7e2e-3298-9324-d4d1919b9610",
                        "entry_id": "8cca738c-e17c-34d7-90a9-237cecec75ef",
                        "glosses": [
                            "ausgestorbene Art aus der Gattung der Nashörner, die in Steppen des nördlichen Eurasiens lebte und zwei Hörner besaß"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1445f3ba-3a15-44e5-9570-6491b110c828",
                                "sense_id": "eb8eb299-7e2e-3298-9324-d4d1919b9610",
                                "text": "„Das Ende der Eiszeiten brachte leider auch das Ende für Mammuts und Wollnashörner.“"
                            },
                            {
                                "example_id": "46db3846-cdd7-4e63-8ad9-a4f083dcc5b4",
                                "sense_id": "eb8eb299-7e2e-3298-9324-d4d1919b9610",
                                "text": "„Vor 35000 Jahren schnitzten begabte Künstler aus Mammutelfenbein ein Wildpferdchen mit langem, gebogenem Hals, Schneeleopard und Wollnashorn sowie eine bleistiftgroße Flöte aus Schwanenknochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a936380-caa9-45b9-89e5-ffce4c7a0d31",
                        "source_entry_id": "8cca738c-e17c-34d7-90a9-237cecec75ef",
                        "source_sense_id": "eb8eb299-7e2e-3298-9324-d4d1919b9610",
                        "target_lang_word": "woolly rhinoceros",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
