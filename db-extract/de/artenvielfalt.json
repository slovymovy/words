                ],
                "senses": [
                    {
                        "sense_id": "e43021e0-1309-322b-a8a5-c3c1e6facdff",
                        "entry_id": "40827022-74ad-39a4-9c83-8c11262ad658",
                        "glosses": [
                            "die Mannigfaltigkeit der in einem bestimmten Lebensraum zusammenlebenden Tier-, Pflanzen-, Pilz-, Protisten- und Bakterienarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cdf11c2-5b80-4b16-b31c-fc62b0e2f0a4",
                                "sense_id": "e43021e0-1309-322b-a8a5-c3c1e6facdff",
                                "text": "Naturschutzgebiete dienen der Erhaltung der Artenvielfalt."
                            },
                            {
                                "example_id": "32ede141-6362-4973-b7e6-e71c42fefeb4",
                                "sense_id": "e43021e0-1309-322b-a8a5-c3c1e6facdff",
                                "text": "„Risiken beim Einsatz gentechnisch veränderter Pflanzen sind neben einer Bedrohung der Artenvielfalt auch Nebeneffekte wie das Auftreten neuer unerwünschter Eigenschaften bei den Pflanzen, aber auch allergische Reaktionen bei den Verbrauchern.“"
                            },
                            {
                                "example_id": "cfa83fa3-3bb9-431c-80c2-e92c52ead263",
                                "sense_id": "e43021e0-1309-322b-a8a5-c3c1e6facdff",
                                "text": "„Eine Spezies der großen europäischen Artenvielfalt ist am Aussterben.“"
                            },
                            {
                                "example_id": "0c751b7a-0f0d-4995-bd38-d7f2830ed8e9",
                                "sense_id": "e43021e0-1309-322b-a8a5-c3c1e6facdff",
                                "text": "„Die Artenvielfalt soll hier auf einem Hektar höher sein als in ganz Europa.“"
                            },
                            {
                                "example_id": "e158310f-4dbc-440c-a1f9-1fa484f683a8",
                                "sense_id": "e43021e0-1309-322b-a8a5-c3c1e6facdff",
                                "text": "„Die Artenvielfalt leidet, wenn der Rasen [durch Mähroboter] beständig gemäht wird. Gänseblümchen oder eine Blumenwiese können sich nicht entwickeln, wo täglich gemäht wird.“"
                            },
                            {
                                "example_id": "a4073489-a801-4a38-9e35-17b62e9be0b3",
                                "sense_id": "e43021e0-1309-322b-a8a5-c3c1e6facdff",
                                "text": "„Der Verzicht aufs Rasenmähen stärkt die Artenvielfalt bei Pflanzen und hilft vielen Insekten zu überleben.“"
                            },
                            {
                                "example_id": "0ae271db-1977-460a-a812-2a7f54fcf05f",
                                "sense_id": "e43021e0-1309-322b-a8a5-c3c1e6facdff",
                                "text": "„Ein konventionell bewirtschafteter Acker weist eine wesentlich geringere Artenvielfalt auf als einer im Biolandbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
