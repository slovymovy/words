                ],
                "senses": [
                    {
                        "sense_id": "682d43d2-6ad7-3485-93fc-737f86bdbc5f",
                        "entry_id": "136dfd22-7518-3621-8998-4fdea1b6a2e9",
                        "glosses": [
                            "im tropischen Flachwasser, meist in Kolonien lebender, ein verzweigtes Kalkskelett aus Kalziumkarbonat bildender Polyp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f08a7e65-695b-42d3-9a07-606076661cf5",
                                "sense_id": "682d43d2-6ad7-3485-93fc-737f86bdbc5f",
                                "text": "Schon lange bevor Menschen auf der Erde lebten, siedelten sich kleine Korallenpolypen vor allem in der Nähe tropischer Küsten an."
                            },
                            {
                                "example_id": "916088da-50d4-47e5-8ae4-897e83c43eda",
                                "sense_id": "682d43d2-6ad7-3485-93fc-737f86bdbc5f",
                                "text": "Das in Wasser gelöste CO2, das auch aus der Luft oder Atmung der Korallenpolypen stammt, reagiert sauer und würde das gebildete Calciumcarbonat wieder auflösen."
                            },
                            {
                                "example_id": "034eea59-c184-4b29-8c42-786cccaf96e1",
                                "sense_id": "682d43d2-6ad7-3485-93fc-737f86bdbc5f",
                                "text": "Im tropischen Flachwasser lebenden Korallen hilft hierbei die Symbiose mit den Zooxanthellen, einzelligen Algen, die in der Haut der Korallenpolypen leben."
                            },
                            {
                                "example_id": "d4249e76-312e-4781-a497-c36df6f124c3",
                                "sense_id": "682d43d2-6ad7-3485-93fc-737f86bdbc5f",
                                "text": "Diese so genannten Zooxanthellen leben als symbiontische Untermieter in den meist durchsichtigen Zellen der Korallenpolypen."
                            },
                            {
                                "example_id": "45dde232-ffa2-40be-8284-a5447ac26460",
                                "sense_id": "682d43d2-6ad7-3485-93fc-737f86bdbc5f",
                                "text": "Beide Partner profitieren: Die Algen liefern Sauerstoff und Zucker und ernähren so den Korallenpolypen mit."
                            },
                            {
                                "example_id": "e52295b6-3dd5-46f1-920f-f37ab0c6186f",
                                "sense_id": "682d43d2-6ad7-3485-93fc-737f86bdbc5f",
                                "text": "Mit einem neuen Unterwasser-Mikroskop haben Forscher Korallenpolypen beim „Küssen“ beobachtet. Sie vermuten in dem entdeckten Phänomen einen Austausch von Nährstoffen zwischen den kleinen Polypen."
                            },
                            {
                                "example_id": "9f53a5ac-d5ee-47f8-a95e-7ed52a21fc56",
                                "sense_id": "682d43d2-6ad7-3485-93fc-737f86bdbc5f",
                                "text": "„Das Wasser war schon bei 30 Grad, jetzt sind es noch 29. Bei solchen Temperaturen funktioniert die Symbiose der Korallenpolypen mit den Algen nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
