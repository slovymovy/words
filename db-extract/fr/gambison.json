                        ],
                        "examples": [
                            {
                                "example_id": "040b6f45-569f-4968-b2dc-f66861dbf65d",
                                "sense_id": "006ca7c0-8898-3d6e-ab0d-1c20b8bb6bb3",
                                "text": "Jusqu’à ce que je le trouve enfin, et, m’agenouillant à côté de mon mort, je commence à le dévêtir : je lui ôte ses jambières, ses chausses, sa cotte de mailles, son gambison, son casque et…"
                            },
                            {
                                "example_id": "c84bac9c-ab1f-4102-b07e-3cb503b445d2",
                                "sense_id": "006ca7c0-8898-3d6e-ab0d-1c20b8bb6bb3",
                                "text": "Le premier cavalier portait un gambison, un pourpoint d’étoffe rembourrée qui arrêtait les coups indirects."
                            }
                        ]
                    }
                ],
