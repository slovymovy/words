    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2da2f1e5-931f-3068-951f-4219ac36b809",
                    "sense_definition": "Annoncer à l'avance ce qui doit arriver en se fondant sur des conjectures ou un raisonnement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prevision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est souvent très difficile de <w>prédire</w> les conséquences réelles de nos choix quotidiens."
                        },
                        {
                            "text": "Les analystes politiques tentent de <w>prédire</w> l'issue du prochain scrutin avec beaucoup de prudence."
                        }
                    ],
                    "synonyms": [
                        "pronostiquer",
                        "prévoir"
                    ],
                    "common_phrases": [
                        "prédire l'avenir",
                        "difficile à prédire"
                    ]
                },
                {
                    "sense_id": "20c8f47b-51f6-3ead-940c-bcc584108e04",
                    "sense_definition": "Annoncer à l'avance un phénomène selon des lois scientifiques ou des règles précises.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prevision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les astronomes sont désormais capables de <w>prédire</w> une éclipse solaire avec une très grande précision."
                        },
                        {
                            "text": "Les météorologues utilisent des modèles informatiques avancés afin de <w>prédire</w> le temps pour le week-end."
                        }
                    ],
                    "synonyms": [
                        "calculer",
                        "déterminer"
                    ],
                    "common_phrases": [
                        "prédire une éclipse",
                        "prédire le temps"
                    ]
                },
                {
                    "sense_id": "b74f4f3e-feea-36bf-a1a5-0e875a4afb9d",
                    "sense_definition": "Affirmer connaître l'avenir par des pratiques divinatoires ou magiques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette voyante prétend pouvoir <w>prédire</w> l'avenir simplement en observant les lignes de la main."
                        },
                        {
                            "text": "L'astrologue a <w>prédit</w> que ce jeune homme ferait fortune avant la fin de l'année."
                        }
                    ],
                    "synonyms": [
                        "deviner"
                    ],
                    "common_phrases": [
                        "prédire le destin"
                    ]
                },
                {
                    "sense_id": "7e3ab120-5d18-3c48-b652-1d0100b1fc20",
                    "sense_definition": "Être le signe avant-coureur de quelque chose ; donner lieu d'attendre tel dénouement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces nuages sombres et menaçants à l'horizon ne <w>prédisent</w> rien de bon pour notre voyage."
                        },
                        {
                            "text": "Les premiers bourgeons apparus dès février <w>prédisaient</w> un printemps particulièrement précoce."
                        }
                    ],
                    "synonyms": [
                        "annoncer",
                        "présager"
                    ],
                    "common_phrases": [
                        "prédire le pire",
                        "prédire un bel avenir"
                    ]
                },
                {
                    "sense_id": "31580483-7995-31fe-b62c-d0c7926f9774",
                    "sense_definition": "Annoncer des événements futurs sous l'effet d'une inspiration surnaturelle ou divine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "divination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon les écrits bibliques, plusieurs prophètes avaient <w>prédit</w> la venue d'un nouveau souverain."
                        },
                        {
                            "text": "Ce prédicateur affirmait pouvoir <w>prédire</w> la fin du monde d'après une révélation mystique."
                        }
                    ],
                    "synonyms": [
                        "prophétiser"
                    ],
                    "common_phrases": [
                        "prédire la fin du monde"
                    ]
                }
            ]
        }
    ]
}