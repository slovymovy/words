                                "target_senses": [
                                    {
                                        "sense_id": "afbfbf51-8ad3-3183-986a-b3a8230af88b",
                                        "entry_id": "413f0b2f-fd29-3639-b883-fa9b25bb1d7b",
                                        "glosses": [
                                            "Martyre des premiers temps du christianisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37878ec-b34f-4c29-be2d-9e1ae9d28c90",
                                                "sense_id": "afbfbf51-8ad3-3183-986a-b3a8230af88b",
                                                "text": "Basile de Séleucie a consacré un autre livre à nous raconter les prodiges de tout genre qui s'accomplissent sur la tombe de la protomartyre et ne contribuent pas peu à y attirer tant de pèlerins."
                                            },
                                            {
                                                "example_id": "ed6f8b78-166a-4cb6-9775-8ef38c571de1",
                                                "sense_id": "afbfbf51-8ad3-3183-986a-b3a8230af88b",
                                                "text": "Or, la « vierge Valérie », « protomartyre de cette région », est, pour ses mérites, ses reliques, le culte qui lui est rendu, plusieurs fois citée dans sa chronique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
