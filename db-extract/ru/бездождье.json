                                        "glosses": [
                                            "długotrwały okres bez opadów atmosferycznych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c723f788-ca2c-4206-b8a2-3941c269afdf",
                                                "sense_id": "71d16769-e093-3295-b452-b3ae4856d6be",
                                                "text": "Susza spowodowała nieurodzaj, a w konsekwencji klęskę głodu."
                                            }
                                        ],
