                "senses": [
                    {
                        "sense_id": "4c8dc9a1-b11c-30d9-b85f-a2638e7eb5e3",
                        "entry_id": "4f995476-4317-33bf-9ea6-ac832e1ff9b9",
                        "glosses": [
                            "To go away, to disappear."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "06c93bfb-b7bb-446d-bef6-d8f992906964",
                                "sense_id": "4c8dc9a1-b11c-30d9-b85f-a2638e7eb5e3",
                                "text": "He bewent speedily, and as he vanished I heard him again calling, \" Not she, not she ! Ha, ha ! \""
                            },
                            {
                                "example_id": "a584b6a9-3dc2-4b22-b2b5-8954a8ca5ee5",
                                "sense_id": "4c8dc9a1-b11c-30d9-b85f-a2638e7eb5e3",
                                "text": "“Begone!” I shouted. They bewent, asmirking,\n And I, awakening, fell straight aworking."
                            }
                        ]
                    }
                ],
