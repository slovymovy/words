{
    "word_family": [
        "imperviously",
        "imperviousness",
        "pervious"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e9f81642-344e-3269-94cb-b72ac84a5eed",
                    "sense_definition": "Not allowing fluid or other substances to pass through; impenetrable or impermeable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The durable rubber coating made the boots completely <w>impervious</w> to water and mud.",
                            "target_lang_translations": {
                                "ru": "Прочное резиновое покрытие сделало сапоги совершенно <w>непроницаемыми</w> для воды и грязи."
                            }
                        },
                        {
                            "text": "Although patchworked and sagging, the old roof proved <w>impervious</w> to the weather.",
                            "target_lang_translations": {
                                "ru": "Хотя старая крыша была вся в заплатках и провисала, она оказалась <w>непроницаемой</w> для непогоды."
                            }
                        }
                    ],
                    "synonyms": [
                        "impenetrable",
                        "impermeable",
                        "waterproof"
                    ],
                    "antonyms": [
                        "pervious"
                    ],
                    "common_phrases": [
                        "impervious to water",
                        "impervious to moisture",
                        "impervious layer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не пропускающий жидкости или другие вещества; непроницаемый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непроницаемый",
                                "target_lang_sense_clarification": "для жидкостей, газов, света или физического проникновения"
                            },
                            {
                                "target_lang_word": "водонепроницаемый",
                                "target_lang_sense_clarification": "не пропускающий воду или влагу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6262f597-4674-39ae-a1cf-78357ff39970",
                    "sense_definition": "Not affected, influenced, or disturbed by something such as criticism, emotion, or external pressure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He remained remarkably calm throughout the debate, seemingly <w>impervious</w> to harsh criticism.",
                            "target_lang_translations": {
                                "ru": "На протяжении всех дебатов он оставался удивительно спокоен, казавшись совершенно <w>невосприимчивым</w> к резкой критике."
                            }
                        },
                        {
                            "text": "The seasoned politician appeared completely <w>impervious</w> to pain or public disapproval.",
                            "target_lang_translations": {
                                "ru": "Опытный политик казался абсолютно <w>неуязвимым</w> для боли или общественного неодобрения."
                            }
                        }
                    ],
                    "synonyms": [
                        "immune",
                        "unaffected",
                        "invulnerable"
                    ],
                    "common_phrases": [
                        "impervious to criticism",
                        "impervious to pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не поддающийся воздействию, критике или эмоциям; невосприимчивый или глухой к внешнему давлению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невосприимчивый",
                                "target_lang_sense_clarification": "к критике, влиянию, чужим словам"
                            },
                            {
                                "target_lang_word": "неуязвимый",
                                "target_lang_sense_clarification": "для нападок, критики или боли"
                            },
                            {
                                "target_lang_word": "непроницаемый",
                                "target_lang_sense_clarification": "не поддающийся внешнему эмоциональному воздействию"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}