                    {
                        "sense_id": "60a47f2b-76b4-3a45-bd5a-deca225b6777",
                        "entry_id": "16f79aa2-6277-34c4-a144-9210354b8354",
                        "glosses": [
                            "Dentelure faite en créneaux, découpure en dents arrondies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b399dcc-d5bb-416b-83a6-2151110716ba",
                                "sense_id": "60a47f2b-76b4-3a45-bd5a-deca225b6777",
                                "text": "Il y a des feuilles de plantes, des dentelles qui sont à crénelure."
                            },
                            {
                                "example_id": "05f79bb5-fe81-4ac1-9a96-6fca58136136",
                                "sense_id": "60a47f2b-76b4-3a45-bd5a-deca225b6777",
                                "text": "Tout au long de celle-ci, les rochers sortaient de terre, nus et froids, mais éclatés en une grossière crénelure naturelle."
                            },
                            {
                                "example_id": "c484a146-48e2-4c74-8b85-9e75e9b9b6da",
                                "sense_id": "60a47f2b-76b4-3a45-bd5a-deca225b6777",
                                "text": "Je pensais à la lueur des gazinières de ma grand-mère, faible, inextinguible. Et pendant que le vent arrachait les crénelures des corniches, je cherchais la gazinière."
                            }
                        ]
                    },
                    {
                        "sense_id": "293fed59-6654-3f41-95a3-9b4584974b74",
                        "entry_id": "16f79aa2-6277-34c4-a144-9210354b8354",
                        "glosses": [
                            "Petites dents qui forment cette découpure."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f3088f44-a0dc-4577-80c1-3b70d51fbe05",
                                "sense_id": "293fed59-6654-3f41-95a3-9b4584974b74",
                                "text": "Les feuilles de la bétoine sont bordées de crénelures."
                            }
                        ]
                    }
