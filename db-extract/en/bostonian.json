                                        "sense_id": "d6891a4d-d150-3fa3-a70a-aa3505d3e715",
                                        "entry_id": "5584b736-8be3-3d47-a3d4-7b3fbb536ed7",
                                        "glosses": [
                                            "Originario, nativo o habitante de Boston, en los Estados Unidos."
                                        ],
                                        "tags": [
                                            "también se utiliza como sustantivo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8c6c123-8f2b-4fcd-9cbc-cc0583862230",
                                                "sense_id": "d6891a4d-d150-3fa3-a70a-aa3505d3e715",
                                                "text": "Nadie mejor dispuesto que este bostoniano cosmopolita para tener una visión global de la historia y del poder. Vivió hasta los ochenta años, siempre como observador y nunca como actor político."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
