    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "30e15afb-69c3-36d4-b8ff-2fc1aa4dec08",
                    "sense_definition": "mający nieograniczoną moc i siłę; zdolny do zrobienia wszystkiego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omnipotence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W wielu religiach wierzy się, że stwórca świata jest <w>wszechmogący</w> i sprawiedliwy.",
                            "target_lang_translations": {
                                "en": "In many religions, it is believed that the creator of the world is <w>almighty</w> and just."
                            }
                        },
                        {
                            "text": "Król chciał uchodzić za władcę <w>wszechmogącego</w>, ale w rzeczywistości zależał od swoich doradców.",
                            "target_lang_translations": {
                                "en": "The king wanted to be seen as an <w>all-powerful</w> ruler, but in reality, he depended on his advisers."
                            }
                        }
                    ],
                    "synonyms": [
                        "wszechmocny",
                        "omnipotentny",
                        "wszechpotężny",
                        "wszechwładny"
                    ],
                    "common_phrases": [
                        "Bóg wszechmogący"
                    ],
                    "target_lang_definitions": {
                        "en": "having unlimited power and strength; capable of doing anything"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "almighty",
                                "target_lang_sense_clarification": "unlimited in might"
                            },
                            {
                                "target_lang_word": "all-powerful",
                                "target_lang_sense_clarification": "having unlimited power"
                            },
                            {
                                "target_lang_word": "omnipotent",
                                "target_lang_sense_clarification": "all-powerful"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f75444b4-63ec-3cfc-a0a7-ded0d4f13724",
                    "sense_definition": "Bóg w religiach monoteistycznych jako istota o nieograniczonej mocy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omnipotence",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "O <w>Wszechmogący</w>, przyjdź nam z pomocą w tych trudnych chwilach!",
                            "target_lang_translations": {
                                "en": "O <w>Almighty</w>, come to our aid in these difficult moments!"
                            }
                        },
                        {
                            "text": "Wierni modlili się żarliwie, prosząc <w>Wszechmogącego</w> o pokój na świecie.",
                            "target_lang_translations": {
                                "en": "The faithful prayed fervently, asking <w>the Almighty</w> for peace in the world."
                            }
                        }
                    ],
                    "synonyms": [
                        "Bóg"
                    ],
                    "target_lang_definitions": {
                        "en": "God in monotheistic religions as a being of unlimited power"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "the Almighty",
                                "target_lang_sense_clarification": "God"
                            }
                        ]
                    }
                }
            ]
        }
    ]
