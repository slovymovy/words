                        "glosses": [
                            "Sticky and foul; dirty, filthy, muddy."
                        ],
                        "tags": [
                            "British",
                            "Northern-England",
                            "Scotland",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "1e1873f2-f086-4eab-b8e6-2d5f6f2cf04b",
                                "sense_id": "c49a7d8c-83af-39b6-87f3-208ebbee94eb",
                                "text": "CLART. To spread, smear, or daub. A flake of snow, when it is large and sticks to the clothes, is called a clart. So we have clarts, mud; clarty, muddy, sticky. Clarty-paps, a dirty sloven of a wife."
                            }
                        ]
                    }
