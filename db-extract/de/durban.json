                "senses": [
                    {
                        "sense_id": "098d698a-f47a-33d0-9181-5c946edf91b5",
                        "entry_id": "c93ac0ae-14a3-33ea-ace4-635b68aa9e52",
                        "glosses": [
                            "Großstadt an der Ostküste Südafrikas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd5f2f51-1a95-4817-9637-2d4d434ab479",
                                "sense_id": "098d698a-f47a-33d0-9181-5c946edf91b5",
                                "text": "„Ich bin jetzt länger in der Hölle, als ich jemals in irgendeinem meiner irdischen Häuser in Durban, London oder Manila gewesen bin.“"
                            },
                            {
                                "example_id": "1ff80d1c-65fa-44c3-bd87-12d9b99df3c9",
                                "sense_id": "098d698a-f47a-33d0-9181-5c946edf91b5",
                                "text": "„Sie verbrachten ihre Flitterwochen in Durban.“"
                            },
                            {
                                "example_id": "4e6134ac-c4cb-4ae5-b87b-ef7b8eb53926",
                                "sense_id": "098d698a-f47a-33d0-9181-5c946edf91b5",
                                "text": "„Die Papiere wurden sodann von Mr. Paget Morrison in Durban, Südafrika, dem nächsten unter den noch lebenden Verwandten des Verfassers, als Eigentum beansprucht.“"
                            },
                            {
                                "example_id": "c5fb79be-1a59-43d6-ab73-af33aa758bf6",
                                "sense_id": "098d698a-f47a-33d0-9181-5c946edf91b5",
                                "text": "„Transvaal sollte eine dritte Eisenbahnverbindung mit dem Ausland bekommen, nun nach Durban im Südosten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
