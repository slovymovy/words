                "senses": [
                    {
                        "sense_id": "58c42f3a-5340-36fb-bfb3-8d910ebec03b",
                        "entry_id": "6127a4a4-3cfd-3230-8c63-7d5b4500e1b1",
                        "glosses": [
                            "Liebesbeziehung zwischen zwei Menschen"
                        ],
                        "tags": [
                            "bayrisch",
                            "österreichisch umgangssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "cffb7e89-6b56-417d-9642-fe2bf314bfbe",
                                "sense_id": "58c42f3a-5340-36fb-bfb3-8d910ebec03b",
                                "text": "Kaum zu glauben, aber unser Nachbar hat ein Gspusi mit der Schuldirektorin."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1bd9ffc-6837-3abb-8111-8bcf4f21bc2d",
                        "entry_id": "6127a4a4-3cfd-3230-8c63-7d5b4500e1b1",
                        "glosses": [
                            "Partner in einer Liebesbeziehung"
                        ],
                        "tags": [
                            "bayrisch",
                            "österreichisch umgangssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "f7bfaa4b-4002-4f86-974f-f341925fed57",
                                "sense_id": "a1bd9ffc-6837-3abb-8111-8bcf4f21bc2d",
                                "text": "Sandra hat derzeit gleich zwei Gspusis."
                            },
                            {
                                "example_id": "53430586-3b28-409d-82c6-93a58003f398",
                                "sense_id": "a1bd9ffc-6837-3abb-8111-8bcf4f21bc2d",
                                "text": "Peter legt sich für sein neues Gspusi ja mächtig ins Zeug."
                            },
                            {
                                "example_id": "c9cce277-9325-4e34-8a13-03402f227ace",
                                "sense_id": "a1bd9ffc-6837-3abb-8111-8bcf4f21bc2d",
                                "text": "„Hier versuchen Demi Moores Gspusi Ashton Kutcher und Woody Allens jüngste Entdeckung Amanda Peet, Billy Crystal und Meg Ryan vergessen zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
