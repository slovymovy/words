                ],
                "senses": [
                    {
                        "sense_id": "1b551d53-29ed-35f4-a402-742ecd9d0480",
                        "entry_id": "82dec488-ca9d-3cbc-beb8-9d5f6658b840",
                        "glosses": [
                            "an obelisk or upright stone pillar, usually as a primitive commemoration or gravestone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18419808-27d4-4d05-b985-0764c360c998",
                                "sense_id": "1b551d53-29ed-35f4-a402-742ecd9d0480",
                                "text": "In the courts of the houses lie many round stelæ, or pillars, once placed on the graves of the Athenians."
                            },
                            {
                                "example_id": "bf7605ea-ce56-4875-a578-7d15957f5dae",
                                "sense_id": "1b551d53-29ed-35f4-a402-742ecd9d0480",
                                "text": "He erected a stela, with an inscription in the sacred character, to commemorate his successes."
                            },
                            {
                                "example_id": "6621727b-f276-45ac-bad5-3845c87e7179",
                                "sense_id": "1b551d53-29ed-35f4-a402-742ecd9d0480",
                                "text": "The upright blocks or stelas are among the most curious parts of the present ruin."
                            },
                            {
                                "example_id": "373a9292-70ed-48cd-900c-4763fe480195",
                                "sense_id": "1b551d53-29ed-35f4-a402-742ecd9d0480",
                                "text": "Thothmes I. set up two stelæ near the Euphrates."
                            },
                            {
                                "example_id": "11569da8-a90c-459e-87da-692a6bdfbb81",
                                "sense_id": "1b551d53-29ed-35f4-a402-742ecd9d0480",
                                "text": "A shore excursion had been arranged for the passengers who were interested in visiting the stelae of San Ignacio."
                            }
                        ]
                    }
                ],
