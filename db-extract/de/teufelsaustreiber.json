                        "glosses": [
                            "Person, die versucht, den Teufel auszutreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5ca42f8-f13e-4d5e-b91d-b9bffe66a6e4",
                                "sense_id": "196b0c73-d91c-3d62-abcb-a3ea8cc5b0a4",
                                "text": "„Auch auf dem Entoto, dem heiligen Hausberg Addis Abebas, sprudelt es und lockt viele zwielichtige Gestalten der Professionen Aidsheiler und Teufelsaustreiber an.“"
                            }
