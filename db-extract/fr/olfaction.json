                    {
                        "sense_id": "18c37b11-7378-39a4-bd37-3bc17eeea3ad",
                        "entry_id": "af0d2801-2e6e-3294-8ca0-20959b1c839d",
                        "glosses": [
                            "Action de sentir, odorat, flair. Flair, capacité à détecter les molécules aromatiques en suspension dans l'air."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "512a87e1-0f1e-4afd-ba93-3439f7a770b4",
                                "sense_id": "18c37b11-7378-39a4-bd37-3bc17eeea3ad",
                                "text": "Le chien a une olfaction très développée."
                            },
                            {
                                "example_id": "6e79d9f3-00b1-44a1-8d70-a46b322adb11",
                                "sense_id": "18c37b11-7378-39a4-bd37-3bc17eeea3ad",
                                "text": "L’olfaction se démarque des autres systèmes sensoriels par les caractéristiques uniques de son circuit neuro-anatomique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
