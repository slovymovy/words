{
    "word_family": [
        "thriller",
        "thrilling",
        "thrilled",
        "thrillingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7fe83132-3f06-3978-abf1-58e1f73d58a4",
                    "sense_definition": "To suddenly excite someone, or to give someone great pleasure; to experience a sudden wave of intense emotion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "excitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of her promotion will <w>thrill</w> the entire family when they hear it tonight.",
                            "target_lang_translations": {
                                "ru": "Новости о её повышении <w>приведут в восторг</w> всю семью, когда они услышат их сегодня вечером."
                            }
                        },
                        {
                            "text": "The singer's powerful voice managed to <w>thrill</w> the audience throughout the entire performance.",
                            "target_lang_translations": {
                                "ru": "Мощный голос певца <w>взволновал</w> публику на протяжении всего выступления."
                            }
                        }
                    ],
                    "synonyms": [
                        "electrify",
                        "excite",
                        "exhilarate",
                        "galvanize",
                        "rouse",
                        "delight",
                        "stir"
                    ],
                    "antonyms": [
                        "calm down",
                        "soothe"
                    ],
                    "common_phrases": [
                        "thrill the audience",
                        "thrill the reader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно вызвать у кого-то сильное волнение или доставить огромное удовольствие; испытать внезапную волну сильных эмоций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взволновать",
                                "target_lang_sense_clarification": "привести в состояние душевного подъема"
                            },
                            {
                                "target_lang_word": "привести в восторг",
                                "target_lang_sense_clarification": "вызвать сильное восхищение"
                            },
                            {
                                "target_lang_word": "захватывать",
                                "target_lang_sense_clarification": "о сильных эмоциях или интересе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0de9106e-d3cd-3478-84cf-0509baa28cb8",
                    "sense_definition": "To cause something to tremble or quiver, or to vibrate with a low sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vibration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The low notes of the organ began to <w>thrill</w> through the floor of the old cathedral.",
                            "target_lang_translations": {
                                "ru": "Низкие ноты органа начали <w>вибрировать</w> под полом старого собора."
                            }
                        },
                        {
                            "text": "A strange, cold sensation seemed to <w>thrill</w> her nerves as she entered the dark room.",
                            "target_lang_translations": {
                                "ru": "Странное холодное чувство, казалось, <w>вызвало дрожь</w> в её нервах, когда она вошла в темную комнату."
                            }
                        }
                    ],
                    "synonyms": [
                        "quiver",
                        "tremble",
                        "vibrate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо дрожать или трепетать, либо вибрировать с низким звуком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожать",
                                "target_lang_sense_clarification": "совершать мелкие колебательные движения"
                            },
                            {
                                "target_lang_word": "вибрировать",
                                "target_lang_sense_clarification": "издавать низкий гул"
                            },
                            {
                                "target_lang_word": "вызвать дрожь",
                                "target_lang_sense_clarification": "заставить что-то затрепетать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b223d429-9dee-3ae4-a55f-400f199af34a",
                    "sense_definition": "To pierce or penetrate something with a sharp point; to <w>drill</w> through.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "piercing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight's spear was able to <w>thrill</w> through the thick shield of his opponent.",
                            "target_lang_translations": {
                                "ru": "Копье рыцаря смогло <w>пронзить</w> толстый щит его противника."
                            }
                        },
                        {
                            "text": "In the ancient poem, the arrow is described as being able to <w>thrill</w> the heart of the beast.",
                            "target_lang_translations": {
                                "ru": "В древней поэме стрела описывается как способная <w>пробить</w> сердце зверя."
                            }
                        }
                    ],
                    "synonyms": [
                        "bore",
                        "drill",
                        "perforate",
                        "pierce"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical or poetic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пронзить или проткнуть что-либо острым предметом; просверлить насквозь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пронзать",
                                "target_lang_sense_clarification": "протыкать насквозь"
                            },
                            {
                                "target_lang_word": "пробивать",
                                "target_lang_sense_clarification": "проходить сквозь препятствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7391ab92-e369-3f9c-971d-bfe94f72679a",
                    "sense_definition": "To hurl, throw, or cast something with force.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "throwing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warrior prepared to <w>thrill</w> his javelin across the battlefield at the advancing enemy.",
                            "target_lang_translations": {
                                "ru": "Воин приготовился <w>метнуть</w> свое копье через поле боя в наступающего врага."
                            }
                        },
                        {
                            "text": "He watched the athlete <w>thrill</w> the heavy stone during the traditional highland games.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как атлет <w>швыряет</w> тяжелый камень во время традиционных горских игр."
                            }
                        }
                    ],
                    "synonyms": [
                        "cast",
                        "fling",
                        "hurl",
                        "throw",
                        "toss"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Швырять, бросать или метать что-либо с силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "метать",
                                "target_lang_sense_clarification": "бросать с силой"
                            },
                            {
                                "target_lang_word": "швырять",
                                "target_lang_sense_clarification": "резко бросать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d71ee3a-6c4b-3304-bb6b-2d8e7b079e59",
                    "sense_definition": "To drill and thread a hole in a single operation using a specialized computer-controlled tool bit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "machining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician used the CNC machine to <w>thrill</w> the aluminum casing for the new prototype.",
                            "target_lang_translations": {
                                "ru": "Техник использовал станок с ЧПУ, чтобы <w>просверлить и нарезать резьбу</w> в алюминиевом корпусе для нового прототипа."
                            }
                        },
                        {
                            "text": "Modern manufacturing allows us to <w>thrill</w> components much faster than using separate drilling and tapping steps.",
                            "target_lang_translations": {
                                "ru": "Современное производство позволяет <w>обрабатывать отверстия</w> в деталях гораздо быстрее, чем при использовании раздельных этапов сверления и нарезания резьбы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical engineering term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сверлить и нарезать резьбу в отверстии за одну операцию с помощью специализированного инструмента с ЧПУ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверлить-нарезать",
                                "target_lang_sense_clarification": "комбинированная обработка отверстия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "880b9ade-f67e-35b6-9ddd-1179bd3c6fd3",
                    "sense_definition": "A sudden feeling of excitement and pleasure, or the event that causes it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "excitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Riding the roller coaster for the first time gave the young boy a huge <w>thrill</w>.",
                            "target_lang_translations": {
                                "ru": "Первая поездка на американских горках подарила мальчику огромный <w>трепет</w>."
                            }
                        },
                        {
                            "text": "She gets a real <w>thrill</w> out of skydiving and other extreme sports every summer.",
                            "target_lang_translations": {
                                "ru": "Каждое лето она получает настоящий <w>кайф</w> от прыжков с парашютом и других экстремальных видов спорта."
                            }
                        }
                    ],
                    "synonyms": [
                        "kick",
                        "rush",
                        "excitement"
                    ],
                    "common_phrases": [
                        "get a thrill",
                        "cheap thrill",
                        "thrill of the chase"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное чувство волнения и удовольствия, или событие, которое его вызывает."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "сильное волнение от удовольствия"
                            },
                            {
                                "target_lang_word": "кайф",
                                "target_lang_sense_clarification": "разг., сильное удовольствие"
                            },
                            {
                                "target_lang_word": "острые ощущения",
                                "target_lang_sense_clarification": "сильное эмоциональное возбуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c397976-8e6a-3a62-82e7-8dd246ef28cb",
                    "sense_definition": "A physical trembling or quivering sensation, often caused by strong emotion or cold.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vibration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>thrill</w> of fear ran down his spine as he heard the floorboards creak.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>дрожь</w> страха пробежала по его спине, когда он услышал скрип половиц."
                            }
                        },
                        {
                            "text": "She felt an inexpressible <w>thrill</w> when the orchestra began to play her favorite symphony.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала невыразимый <w>трепет</w>, когда оркестр начал играть её любимую симфонию."
                            }
                        }
                    ],
                    "synonyms": [
                        "frisson",
                        "quiver",
                        "shiver",
                        "tremor"
                    ],
                    "common_phrases": [
                        "thrill of fear",
                        "thrill of pleasure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое ощущение дрожи или трепета, часто вызванное сильными эмоциями или холодом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "легкое дрожание"
                            },
                            {
                                "target_lang_word": "дрожь",
                                "target_lang_sense_clarification": "физическое ощущение вибрации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a52bb773-9d1a-3054-8d58-3b91a45b4f7e",
                    "sense_definition": "A vibration felt by the hand when placed over the heart, indicating a cardiac murmur.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noted a palpable <w>thrill</w> over the patient's chest during the physical examination.",
                            "target_lang_translations": {
                                "ru": "Врач отметил ощутимое <w>дрожание</w> в области груди пациента во время физического осмотра."
                            }
                        },
                        {
                            "text": "A systolic <w>thrill</w> is often associated with significant heart valve disease in clinical diagnosis.",
                            "target_lang_translations": {
                                "ru": "Систолическое <w>дрожание</w> часто связано с серьезным заболеванием сердечных клапанов при клинической диагностике."
                            }
                        }
                    ],
                    "common_phrases": [
                        "systolic thrill",
                        "palpable thrill"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вибрация, ощущаемая рукой при прикладывании к области сердца, указывающая на сердечный шум."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожание",
                                "target_lang_sense_clarification": "пальпируемая вибрация в медицине"
                            },
                            {
                                "target_lang_word": "кошачье мурлыканье",
                                "target_lang_sense_clarification": "мед., специфический термин для вибрации сердца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ef19533-16b9-32b1-901a-6f208099d8fc",
                    "sense_definition": "A breathing hole or nostril, particularly in birds.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist examined the <w>thrill</w> of the hawk to check for any signs of respiratory infection.",
                            "target_lang_translations": {
                                "ru": "Биолог осмотрел <w>ноздрю</w> ястреба, чтобы проверить наличие признаков респираторной инфекции."
                            }
                        },
                        {
                            "text": "In some older texts, the word <w>thrill</w> is used to describe the nasal passages of avian species.",
                            "target_lang_translations": {
                                "ru": "В некоторых старых текстах слово «thrill» используется для описания носовых <w>проходов</w> птиц."
                            }
                        }
                    ],
                    "synonyms": [
                        "nostril"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дыхательное отверстие или ноздря, особенно у птиц."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ноздря",
                                "target_lang_sense_clarification": "дыхательное отверстие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}