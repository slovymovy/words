                        "target_lang_word": "Mithraismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mithraismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbe6e42e-8252-3327-aadd-c81f3890821e",
                                        "entry_id": "770e898a-6cb2-3287-a099-cc35acb5744f",
                                        "glosses": [
                                            "seit dem 1. Jahrhundert n. Chr. im ganzen Römischen Reich verbreiteter Mysterienkult, in dessen Zentrum sich die Gestalt des Mithras befand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87b5e5c4-2239-43c0-a61c-d7cb0cd11838",
                                                "sense_id": "fbe6e42e-8252-3327-aadd-c81f3890821e",
                                                "text": "„Mit der Durchsetzung des Christentums im Römischen Reich verschwand der Mithraismus jedoch innerhalb weniger Generationen und geriet in fast vollständige Vergessenheit, bis er in der Neuzeit durch archäologische Funde wiederentdeckt wurde.“"
                                            },
                                            {
                                                "example_id": "1092355a-1ce6-466c-944d-aa9597485c37",
                                                "sense_id": "fbe6e42e-8252-3327-aadd-c81f3890821e",
                                                "text": "„Astrologische Symbole weisen darauf hin, dass der Mithraismus Sternkunde mit Religion verknüpfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
