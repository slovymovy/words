                        "examples": [
                            {
                                "example_id": "f095b5b4-de3f-4e51-908a-da8fd592aa19",
                                "sense_id": "5be6a833-6a17-3b7a-8b91-bfbdf81b8b6a",
                                "text": "To this extenuated spectre, perhaps, a crumb is not thrown once a year; but when ahungered and athirst to famine—when all humanity has forgotten the dying tenant of a decaying house—Divine Mercy remembers the mourner, […]"
                            },
                            {
                                "example_id": "f79dafab-0acc-4c6f-a81b-ceb1255f1035",
                                "sense_id": "5be6a833-6a17-3b7a-8b91-bfbdf81b8b6a",
                                "text": "May be my strength on which they lean; / My voice! Oh, may each wanderer heed; / My table those ahungered feed."
                            }
                        ]
                    }
