                                                "example_id": "fbf3714f-f1b2-479f-aa9a-40cbdc55efa9",
                                                "sense_id": "9dd50547-3ab4-33be-a0fe-00baf736c260",
                                                "text": "We now come to the so-called aspirate [h], which must be also classified as a fricative consonant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6806c2e5-03ce-3bf0-9a72-6fa86dddefd5",
                                        "entry_id": "e3f04044-c070-3605-be74-e7868fdf4dc3",
                                        "glosses": [
                                            "A mark of aspiration (ʽ) used in Greek; the asper, or rough breathing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e698812a-eff7-4db8-8788-96a67d7ad76e",
                                                "sense_id": "6806c2e5-03ce-3bf0-9a72-6fa86dddefd5",
                                                "text": "a. 1742, Richard Bentley, letter to Dr. Mead\nBut we must correct then twenty authors who have it in the compound ἀπηθεῖν and ἀπήθημα ; and not (as the aspirate would require it) ἀφηθεῖν and αφήθημα"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f2de144-4e7c-3f9a-9b6d-8c7ccca506ed",
                                        "entry_id": "e3f04044-c070-3605-be74-e7868fdf4dc3",
                                        "glosses": [
                                            "A sample of fluid, tissue, or other substance that is withdrawn via aspiration (usually through a hollow needle) from a body cavity, cyst, or tumor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
