                "senses": [
                    {
                        "sense_id": "dc5a5493-5f37-3900-b53d-2b38af28e353",
                        "entry_id": "d70fd7cb-71d1-3e33-bc1e-5d9334ea4427",
                        "glosses": [
                            "het jagen op vermeende heksen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7592281-44c4-4aff-a471-a15142fc75a8",
                                "sense_id": "dc5a5493-5f37-3900-b53d-2b38af28e353",
                                "text": "In Afrika komen heksenjachten nog steeds voor."
                            }
                        ]
                    },
                    {
                        "sense_id": "76c3d49e-b05c-3963-91e1-70d593b6b4b8",
                        "entry_id": "d70fd7cb-71d1-3e33-bc1e-5d9334ea4427",
                        "glosses": [
                            "het proberen te achterhalen en vernietigen van iets of het systematisch vervolgen van bepaalde groepen mensen"
                        ],
                        "tags": [
                            "bij uitbreiding"
                        ],
                        "examples": [
                            {
                                "example_id": "981b813b-6e56-47f9-ac25-ac748d6c6567",
                                "sense_id": "76c3d49e-b05c-3963-91e1-70d593b6b4b8",
                                "text": "De heksenjacht op illegalen is geopend."
                            },
                            {
                                "example_id": "aae0956a-bd2b-4a3d-b181-fb365fa1edd2",
                                "sense_id": "76c3d49e-b05c-3963-91e1-70d593b6b4b8",
                                "text": "Begin jaren vijftig was senator Joseph McCarthy de instigator van de heksenjacht op communisten en andere progressieven in de Verenigde Staten"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1475ca3-06bd-4e7c-a126-dc7fd5ab8dcc",
                        "source_entry_id": "d70fd7cb-71d1-3e33-bc1e-5d9334ea4427",
                        "source_sense_id": "dc5a5493-5f37-3900-b53d-2b38af28e353",
                        "source_sense_description": "het jagen op vermeende heksen",
                        "target_lang_word": "Hexenjagd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hexenjagd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76800447-7675-3ebe-a7d6-46a2fe3865b7",
                                        "entry_id": "2e7b01d1-7bea-3489-bed6-9659ff164989",
                                        "glosses": [
                                            "grausame Verfolgung von Personen, die der Hexerei bezichtigt werden"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a7868ce-a61d-4aec-a9fd-c30bb5219ddf",
                                                "sense_id": "76800447-7675-3ebe-a7d6-46a2fe3865b7",
                                                "text": "„Schweden fand nach zögerndem Beginn (König Gustav Adolf war an Verfolgungen großen Stils nicht interessiert, seine Tochter Christine verbot 1649 die Fortführung laufender Prozesse und gebot die Entlassung aller inhaftierten Zauberinnen) in der 2. Hälfte des 17. Jahrhunderts den Anschluß an die in Deutschland ungebrochene Hexenjagd.“"
                                            },
                                            {
                                                "example_id": "6b43694f-57c9-475c-b25a-d9a65164f378",
                                                "sense_id": "76800447-7675-3ebe-a7d6-46a2fe3865b7",
                                                "text": "„Wie viele andere Epidemien, die Europa damals heimsuchten, verschärfte die Pest soziale Spannungen und trug zur Erzeugung von Stimmungslagen bei, die Hexenjagden begünstigten, aber selten löste sie unmittelbare Anschuldigungen aus.“"
                                            },
                                            {
                                                "example_id": "e2cc5bce-5b35-41e9-bab7-c4ef5a9bacd5",
                                                "sense_id": "76800447-7675-3ebe-a7d6-46a2fe3865b7",
                                                "text": "„Es loderten die Scheiterhaufen, und die größte Hexenjagd der abendländischen Geschichte stand erst noch bevor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hexenjagd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6f47677-e63d-3b0f-970f-b00adf1c2ecc",
                                        "entry_id": "3f06757c-cf11-3fec-a8b0-f2ee4338847b",
                                        "glosses": [
                                            "öffentlich geführte, verleumdende Kampagne gegen eine Person"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdc8e41d-1dbf-451d-8a61-3122d2a2b892",
                                                "sense_id": "a6f47677-e63d-3b0f-970f-b00adf1c2ecc",
                                                "text": "„In ihren eigenen Reihen eröffneten sie wahnwitzige Hexenjagden.“"
                                            },
                                            {
                                                "example_id": "ced28ff8-ece5-4b4c-8b4b-23989a967b93",
                                                "sense_id": "a6f47677-e63d-3b0f-970f-b00adf1c2ecc",
                                                "text": "„Die Partei, die stets das Ideal der Gleichberechtigung verkündet hatte, entfachte nun selbst eine antijüdische Hexenjagd.“"
                                            },
                                            {
                                                "example_id": "61c6c353-895b-4f91-a685-9f6f304e5425",
                                                "sense_id": "a6f47677-e63d-3b0f-970f-b00adf1c2ecc",
                                                "text": "„Seine manichäische Sprache erinnert eher an eine Hexenjagd als an den revolutionären Umsturz eines kolonialen Systems.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
