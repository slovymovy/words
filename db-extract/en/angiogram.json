                                "target_senses": [
                                    {
                                        "sense_id": "da415259-e940-322d-8ed4-0a22d1e6ac1a",
                                        "entry_id": "4ff5fbd2-ea91-3be5-968e-cb464fb5ce75",
                                        "glosses": [
                                            "η ζωγραφική πάνω στην επιφάνεια κεραμικών αγγείων"
                                        ],
                                        "tags": [
                                            "αρχαιολογία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c521d9-6c11-45fa-9b72-47567f26eaa8",
                                                "sense_id": "da415259-e940-322d-8ed4-0a22d1e6ac1a",
                                                "text": "※ Πλοία εμφανίζονται επίσης στην αρχαία ελληνική αγγειογραφία, ειδικά όταν σχετίζονται με αφηγηματικό πλαίσιο, καθώς και σε νομίσματα.",
                                                "translation": "Γιώργος Φωκιανός, Οταν η θάλασσα και η ναυτιλία γοητεύουν τους καλλιτέχνες, Το Βήμα, 26 Μαΐου 2024"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e1ead3-2087-3ef7-9e54-526d79a90ae6",
                                        "entry_id": "4ff5fbd2-ea91-3be5-968e-cb464fb5ce75",
                                        "glosses": [
                                            "η αγγειολογία"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "651fe159-e0c5-39ac-9b59-1ae6f2f6b543",
                                        "entry_id": "4ff5fbd2-ea91-3be5-968e-cb464fb5ce75",
                                        "glosses": [
                                            "η ακτινοσκοπική απεικόνιση της κατάστασης των αγγείων του ανθρώπινου σώματος"
                                        ],
                                        "tags": [
                                            "ιατρική"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "659737c7-6b51-466f-a3f6-492c460cc481",
                                                "sense_id": "651fe159-e0c5-39ac-9b59-1ae6f2f6b543",
                                                "text": "※ Η διάγνωση τίθεται από την υπερηχογραφία ροής, που αποτελεί την εξέταση εκλογής, με υψηλή ευαισθησία και ειδικότητα για τη διάγνωση της νόσου. Συμπληρωματικά χρησιμοποιούνται η αξονική και η μαγνητική αγγειογραφία, ιδίως στην περίπτωση που απαιτείται επιβεβαίωση της διάγνωσης ή σχεδιασμός επαναγγείωσης.",
                                                "translation": "Κώστας Τσιούφης, Πώς αντιμετωπίζεται η στένωση νεφρικών αρτηριών, Τα Νέα, 23 Μαΐου 2024"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
