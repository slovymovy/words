                        "glosses": [
                            "extrem lächerliche, unsinnige Sache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef30883-ad8f-4358-8425-4ca776612f70",
                                "sense_id": "e0b074b1-e999-3f4d-9e52-e087b904b3ec",
                                "text": "„›Superkurze Haare hatte der und trug einen Zweireiher mit T-Shirt! Der hat's echt drauf gehabt mit dem Geld und dem Dope, als wär das alles nur ein Riesenwitz, als würde er Hot Dogs verkaufen oder so.‹“"
                            },
                            {
                                "example_id": "38bc5917-5b97-4f0c-9ed3-46ec36d261fb",
                                "sense_id": "e0b074b1-e999-3f4d-9e52-e087b904b3ec",
                                "text": "„Aber Scheiße, er brauchte da drüben keine drei Monate, um zu merken, dass das alles ein Riesenwitz war.“"
                            },
                            {
                                "example_id": "7c095349-280f-48da-82ad-d344ca0d0a3b",
                                "sense_id": "e0b074b1-e999-3f4d-9e52-e087b904b3ec",
                                "text": "„›Erzähl mir nicht, dass du wirklich glaubst, wir wären eine Familie. Wer ist denn da verwandt? Du und Old Raccoon? Ich und Old Raccoon? Fuck, das ist doch ein Riesenwitz.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
