                        "sense_id": "6845a072-7a1d-367f-8bd9-c00f014bf3a4",
                        "entry_id": "8d9452a2-d1c3-3e52-9d9f-0a6e561f5b9a",
                        "glosses": [
                            "Straße, die auf eine Autobahn führt"
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "e97c04d3-749e-4f6c-b868-8c43b44428ac",
                                "sense_id": "6845a072-7a1d-367f-8bd9-c00f014bf3a4",
                                "text": "„Eine 60-jährige Autofahrerin hat in Rheinland-Pfalz die falsche Autobahnzufahrt genommen und einen schweren Verkehrsunfall verursacht.“"
                            },
                            {
                                "example_id": "52dbba1a-9f39-4cd6-a15a-ce37efdded69",
                                "sense_id": "6845a072-7a1d-367f-8bd9-c00f014bf3a4",
                                "text": "„Unter anderem soll die heutige, lang gestreckte Autobahnzufahrt aufgeteilt werden in die zwei Anschlüsse Altstetten und Schlieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
