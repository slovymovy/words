                        "form": "den Palatschinken"
                    },
                    {
                        "form_id": "b66aabc1-eced-465b-8ddd-a7481f65b3ed",
                        "entry_id": "ffcb2e59-2682-310c-b574-8e4b1aa0879c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Palatschinken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "988c7ac2-6d3b-3408-91e4-d4c13c48544d",
                        "entry_id": "ffcb2e59-2682-310c-b574-8e4b1aa0879c",
                        "glosses": [
                            "regionale Form der Palatschinke, einer gefüllten Teigspeise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51347aa7-9c26-48a5-8cca-d01c2e316a80",
                                "sense_id": "988c7ac2-6d3b-3408-91e4-d4c13c48544d",
                                "text": "„Für den Palatschinken die Eier mit der Milch verquirlen, Salz dazu und das Mehl in die Masse sieben, rund 20 Minuten quellen lassen und den gehackten Rucola unter den Teig untermischen.“"
                            },
                            {
                                "example_id": "4b67236e-8c72-4d40-86a4-a697caebbd7b",
                                "sense_id": "988c7ac2-6d3b-3408-91e4-d4c13c48544d",
                                "text": "„Dann den Palatschinken vorsichtig wenden und auch die zweite Seite goldbraun backen.“"
                            },
                            {
                                "example_id": "bf92fe89-ff2f-4a1c-8b94-6994fd86d287",
                                "sense_id": "988c7ac2-6d3b-3408-91e4-d4c13c48544d",
                                "text": "„Sobald die Unterseite braune Ränder bekommt, den Palatschinken wenden und fertig backen.“"
                            },
                            {
                                "example_id": "45ef67bd-1d9f-425b-9bce-fb7bb26d9476",
                                "sense_id": "988c7ac2-6d3b-3408-91e4-d4c13c48544d",
                                "text": "„Zum Abschluss konnten wir uns einem mit Preiselbeeren und Vanilleeis gefüllten Palatschinken (6,90) nicht erwehren, der die Runde ein weiteres Mal ins Schwelgen brachte.“"
                            },
                            {
                                "example_id": "fd6a3336-f791-4f0e-b718-1c7885583742",
                                "sense_id": "988c7ac2-6d3b-3408-91e4-d4c13c48544d",
                                "text": "„Den Tag in der Tiefebene und den Weinbergen lassen viele Urlauber in gemütlichen Lokalen ausklingen, in denen neben ungarischem Wein echter Palatschinken serviert wird – eine wahre Kalorienbombe.“"
                            },
                            {
                                "example_id": "0eada3eb-dcdb-41f8-923e-45a5784f7b2f",
                                "sense_id": "988c7ac2-6d3b-3408-91e4-d4c13c48544d",
                                "text": "„Den Palatschinken von beiden Seiten goldbraun backen.“"
                            },
                            {
                                "example_id": "4c9af277-5e21-43c3-8f57-604f5b7eb50e",
                                "sense_id": "988c7ac2-6d3b-3408-91e4-d4c13c48544d",
                                "text": "„Ich esse den Palatschinken am liebsten als fingerdicken Pfannkuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
