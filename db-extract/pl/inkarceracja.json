                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "d42f3a3b-729b-493c-9505-b45231c2b37b",
                                "sense_id": "8fde5c7d-8257-3321-afdc-a36ec40e8a89",
                                "text": "Badania wskazują, że czynnikiem nasilającym zaburzenia behawioralne i emocjonalne dzieci jest inkarceracja rodzica, która dotyka bardziej dziewczęta, niż chłopców."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
