                "senses": [
                    {
                        "sense_id": "8ba94851-cdbc-30d6-b5d3-52ea690a9e0d",
                        "entry_id": "659fb8dd-cae5-3d74-bfd1-c37b128f1be8",
                        "glosses": [
                            "Of or pertaining to, characteristic of, associated with, or suggestive of H. G. Wells, an English writer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3b799b-8c25-4183-a223-ffbbdd2b93f3",
                                "sense_id": "8ba94851-cdbc-30d6-b5d3-52ea690a9e0d",
                                "text": "The extension of such a rigid word as morality, until it includes its own contradictions, is typically Wellsean."
                            },
                            {
                                "example_id": "13be3844-e73b-4e97-82af-eda6b6dc1e95",
                                "sense_id": "8ba94851-cdbc-30d6-b5d3-52ea690a9e0d",
                                "text": "In this way, Wilde develops a Wellsean utopian scheme to “better the interplay”: a scheme to recover the connection between the self and others, allowing individuals to counter aestheticism’s drive to wholeness and to grow and change as art does."
                            }
                        ]
                    }
                ],
