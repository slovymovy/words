    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01b3c98f-ed15-3a5c-825f-960c9d467b8e",
                    "sense_definition": "wydać z siebie krótki, gardłowy dźwięk charakterystyczny dla żaby",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dźwięki zwierząt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wieczorem nad stawem nagle <w>zarechotała</w> żaba.",
                            "target_lang_translations": {
                                "ru": "Вечером у пруда внезапно <w>заквакала</w> лягушка."
                            }
                        },
                        {
                            "text": "W zaroślach coś głośno <w>zarechotało</w>.",
                            "target_lang_translations": {
                                "ru": "В зарослях что-то громко <w>заквакало</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "издать короткий, гортанный звук, характерный для лягушки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заквакать",
                                "target_lang_sense_clarification": "о лягушке, издающей звук"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "060cbb86-cf30-3ca9-8ce9-68d02a44e20c",
                    "sense_definition": "zaśmiać się głośno, chrapliwie i w sposób nieprzyjemny",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "śmiech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy usłyszał ten żart, głośno <w>zarechotał</w>.",
                            "target_lang_translations": {
                                "ru": "Услышав эту шутку, он громко <w>загоготал</w>."
                            }
                        },
                        {
                            "text": "Tłum <w>zarechotał</w> na widok niezdarnego klauna.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>заржала</w> при виде неуклюжего клоуна."
                            }
                        }
                    ],
                    "synonyms": [
                        "zachichotać"
                    ],
                    "target_lang_definitions": {
                        "ru": "громко, хрипло и неприятно засмеяться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загоготать",
                                "target_lang_sense_clarification": "громкий, резкий, неприятный смех"
                            },
                            {
                                "target_lang_word": "заржать",
                                "target_lang_sense_clarification": "грубый, громкий смех"
                            }
                        ]
                    }
                }
            ]
        }
    ]
