                "translations": [
                    {
                        "translation_id": "9c542b1c-6c0c-40c5-9655-0ed5a19328e8",
                        "source_entry_id": "f19281eb-ec83-39c3-b1be-b0689689a2d7",
                        "target_lang_word": "explicitly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicitly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                                        "entry_id": "affb9cac-0619-38df-a2f4-206c8ed896a0",
                                        "glosses": [
                                            "In an explicit manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c506f583-18da-4dae-b92a-bdde5f1f9dab",
                                                "sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                                                "text": "The fifth amendment to the United States constitution provides explicitly for the protection of private property."
                                            },
                                            {
                                                "example_id": "44c3c3c5-429b-4639-a616-fcc30e068e7a",
                                                "sense_id": "56327d5c-42a9-3061-a65c-b2efa48a1e57",
                                                "text": "Descartes's methodism with its regulative criterion leads him to explicitly deny that accidentally true belief qualifies as knowledge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ed8a951-156d-423e-8857-bb673bcd08b5",
                        "source_entry_id": "f19281eb-ec83-39c3-b1be-b0689689a2d7",
                        "target_lang_word": "offensichtlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offensichtlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "dem Anschein nach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05e60d1e-ad13-4f2c-81fe-edec92866d25",
                                                "sense_id": "3a4ec5be-1705-3e54-bbe5-95b13a30eb2b",
                                                "text": "Den Wolken nach zu urteilen, wird es offensichtlich regnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                        "entry_id": "564020c4-c709-3d7c-a286-b83dc6d02c2b",
                                        "glosses": [
                                            "für jeden erkennbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ab0e9c-a524-4a5e-bf78-47a736cd6f2a",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "Es war offensichtlich, dass er gelogen hatte."
                                            },
                                            {
                                                "example_id": "f3761dd4-c271-4717-a207-45ed4e44513b",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Die offensichtlichen Mängel der Expertisen, so die Behörde heute, wären ganz sicher schon damals »in einem ‚Obergutachten‘ und/oder anderem Klageverfahren festgestellt worden«.“"
                                            },
                                            {
                                                "example_id": "36473f8d-c9a5-48b5-80d0-e0d958f80517",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Denn offensichtlich ist Schokolade für Frauen DER Glücklichmacher schlechthin, der in allen Variationen stets zuverlässig funktioniert.“"
                                            },
                                            {
                                                "example_id": "a6529f20-b446-4a31-82cd-7b7758b7593c",
                                                "sense_id": "a7581c56-7f1c-38b9-a7f6-8949fc5a747b",
                                                "text": "„Wenn im Weißpigment eines alten Gemäldes Titanweiß nachgewiesen wird, handelt es sich offensichtlich um eine Fälschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e87c5b2d-8093-4dc1-a5e5-e89d3feaa794",
                        "source_entry_id": "f19281eb-ec83-39c3-b1be-b0689689a2d7",
                        "target_lang_word": "évidemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évidemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                        "entry_id": "fc7e787a-9bd1-3a6d-9d9f-460fe8f6df17",
                                        "glosses": [
                                            "D’une manière évidente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7542dfaf-8dbc-4715-a197-de21750b07f1",
                                                "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                                "text": "Et il s’abîma en des recherches mentales, évidemment compliquées et très pénibles, s’il fallait en juger par les diverses grimaces qui se succédèrent sur son visage, […]."
                                            },
                                            {
                                                "example_id": "983f1358-f846-4882-a295-d98200f0489e",
                                                "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                                "text": "L'abondante littérature idyllique des professeurs de rhétorique est évidem­ment une pure vanité."
                                            },
                                            {
                                                "example_id": "a9f6a998-cb59-43f3-8188-d3ec3418c60a",
                                                "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                                "text": "De cela même que je pensais à douter de la vérité des autres choses, il suivait très évidemment et très certainement que j’étais."
                                            },
                                            {
                                                "example_id": "70786bc1-4541-4e73-8223-6a52097a4048",
                                                "sense_id": "86a100c1-06d8-3eb7-ac3f-398e2c56a4ac",
                                                "text": "Les uns veulent toujours croire aveuglément, les autres veulent toujours voir évidemment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a9c2024-e2bc-3959-9346-29ab7a244819",
                                        "entry_id": "fc7e787a-9bd1-3a6d-9d9f-460fe8f6df17",
                                        "glosses": [
                                            "Il est certain que… ; indiscutablement."
                                        ],
                                        "tags": [],
                                        "note": "Dans cette acception, il se met au commencement de la phrase",
                                        "examples": [
                                            {
                                                "example_id": "edb89f9f-f9cd-44f2-9170-d0b99d707b51",
                                                "sense_id": "9a9c2024-e2bc-3959-9346-29ab7a244819",
                                                "text": "Évidemment il a prouvé ce qu’il voulait démontrer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32c502f3-3860-4c64-82bc-f62577756eae",
                        "source_entry_id": "f19281eb-ec83-39c3-b1be-b0689689a2d7",
                        "target_lang_word": "manifestement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manifestement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                        "entry_id": "c5c200b5-0da8-3081-ac49-d2450c5a6774",
                                        "glosses": [
                                            "D’une manière manifeste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e57bfa3-9a31-477c-b260-912ff04bb101",
                                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                                "text": "La vertu de Dieu s’étant fait connaître manifestement."
                                            },
                                            {
                                                "example_id": "2dd82efc-bd4c-40dd-a631-7bbf5b73d425",
                                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                                "text": "Cette présence immuable de l’éternité, toujours fixe, toujours permanente, enfermant en l’infinité de son étendue toutes les différences des temps, il s’ensuit manifestement que le temps peut être en quelque sorte dans l’éternité."
                                            },
                                            {
                                                "example_id": "c7a2c994-381b-458b-8b77-b437bc51dd28",
                                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                                "text": "Qui ne sait que la loi si quis canis, Digeste De vi paragrapho, messieurs, caponibus, Est manifestement contraire à cet abus ?"
                                            },
                                            {
                                                "example_id": "fe62e8d4-478c-45e9-872b-f2b350e3eabe",
                                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                                "text": "Une option manifestement irréaliste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cd6e13e-5693-4d57-bf00-0d75a9a54765",
                        "source_entry_id": "f19281eb-ec83-39c3-b1be-b0689689a2d7",
                        "target_lang_word": "visiblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visiblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                                        "entry_id": "320dad6f-111f-37ad-ad6c-8a6bfd7c0a7d",
                                        "glosses": [
                                            "D’une manière visible ou appréciable à la vue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aee60620-8ebc-41d6-a5de-3ca65ac7e887",
                                                "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                                                "text": "Elizabeth II était visiblement accro à Twin Peaks. C’est ce qu’avait confié le compositeur de la série, Angelo Badalamenti, au New Musical Express."
                                            },
                                            {
                                                "example_id": "db3603e7-6fbd-40f3-8938-9ff3f19e5d3a",
                                                "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                                                "text": "Visiblement, en dépit de ses constantes fanfaronnades, le docteur était, à tout le moins, aussi poltron que ses compatriotes de Werst."
                                            },
                                            {
                                                "example_id": "1dbccae2-6b08-4643-8485-1439b9fae430",
                                                "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                                                "text": "Visiblement, son ex-mari avait laissé ses livres en partant."
                                            },
                                            {
                                                "example_id": "6086e63f-8a5d-4c7e-879e-851412234373",
                                                "sense_id": "ed812964-6b86-3515-9d48-8a76750b9083",
                                                "text": "Son visage portait les marques de la plus profonde perplexité et, visiblement, il se demandait si Tacherot ne se moquait pas un peu de lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                        "entry_id": "320dad6f-111f-37ad-ad6c-8a6bfd7c0a7d",
                                        "glosses": [
                                            "Manifestement ; évidemment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27c17f1c-0761-40c6-88d5-c54c72ad8a24",
                                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                                "text": "L'étendue visible du monde nous surpasse visiblement,"
                                            },
                                            {
                                                "example_id": "2cb8e9f7-0697-4b86-81ae-92a496ba0038",
                                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                                "text": "Madame me fit des merveilles d’abord ; mais, quand l’abbé de Chavigny fut entré, mon étoile pâlit visiblement,"
                                            },
                                            {
                                                "example_id": "d8d5cb7b-07a7-418d-9fa0-6b1c0ba9fc7f",
                                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                                "text": "Depuis ce malheureux moment tout alla visiblement en décadence, et les affaires furent sans retour,"
                                            },
                                            {
                                                "example_id": "3bd47b3a-45d4-4803-9d79-9d0d0ca0684c",
                                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                                "text": "Puisqu'enfin, quand on aurait multiplié les années au delà de tous les nombres connus, visiblement ce ne sera rien, quand nous serons arrivés au terme fatal,"
                                            },
                                            {
                                                "example_id": "babdaa3a-beef-4db4-b740-ed407067aded",
                                                "sense_id": "3660a38a-c4e9-3dea-a381-88ae14053f45",
                                                "text": "Saturne, qui dévore ses enfants, est visiblement le temps qui détruit ses propres ouvrages,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
