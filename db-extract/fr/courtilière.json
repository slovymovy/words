                    },
                    {
                        "translation_id": "1ff0f9ae-f669-4948-879f-d3988e0be9eb",
                        "source_entry_id": "9935fa3a-7724-3294-a45d-5ac1ddfe7a75",
                        "source_sense_id": "9acf7af6-e86e-39c1-96fd-8926e3a45339",
                        "target_lang_word": "veenmol",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veenmol",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2faf79d6-8525-3ff4-ac29-1205398ef882",
                                        "entry_id": "c9126122-76a1-30e7-be28-1a8cb9bda4f3",
                                        "glosses": [
                                            "Gryllotalpa gryllotalpa insect dat wel wat lijkt op een mol"
                                        ],
                                        "tags": [
                                            "rechtvleugeligen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5667d8d4-cc21-4520-bc6c-e87ca4a0bcad",
                                                "sense_id": "2faf79d6-8525-3ff4-ac29-1205398ef882",
                                                "text": "Stel je bent geen naaktslak maar een veenmol. Het leven is één groot feest. Een nieuwe zomer met nieuwe schranspartijen. Samen met wat vrienden richt je je vandaag op de radijs. Gisteren had je in deze moestuin de aardappeloogst op de korrel. Prima jaar. Complimenten aan de tuinier. Ze waren voortreffelijk. Zo te ruiken is de radijs van vergelijkbare kwaliteit. Kom op boys, here we go."
                                            },
                                            {
                                                "example_id": "4f23ad27-6755-4f05-9d8b-75fce15f9cb1",
                                                "sense_id": "2faf79d6-8525-3ff4-ac29-1205398ef882",
                                                "text": "Als jij het gesprek op een vreemd insect als de veenmol brengt, dan is iemand als Maarten van Rossem een en al oor, maar een hoogleraar scheikunde of economie haakt af. Anders was hij of zij wel bioloog geworden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
