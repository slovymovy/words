                                        "glosses": [
                                            "Person, deren Geschlechtsidentität nicht oder nicht vollständig mit dem nach der Geburt anhand der äußeren Merkmale eingetragenen Geschlecht übereinstimmt"
                                        ],
                                        "tags": [],
