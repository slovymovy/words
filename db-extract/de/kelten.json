                "senses": [
                    {
                        "sense_id": "41a1b5ea-d161-3210-bd41-7fb804c3d403",
                        "entry_id": "9ae6f4ba-262d-3d21-a24d-7e01026409f7",
                        "glosses": [
                            "eine Volksgruppe der europäischen Antike bis zur Eisenzeit"
                        ],
                        "tags": [
                            "Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "914e5921-94e5-4eaf-8a66-be739bcf78ca",
                                "sense_id": "41a1b5ea-d161-3210-bd41-7fb804c3d403",
                                "text": "Die Kunststile der La-Tène-Zeit sind auf die historisch belegten Kelten zurückzuführen."
                            },
                            {
                                "example_id": "5ea7315a-275c-4196-8d39-3437e606cf2b",
                                "sense_id": "41a1b5ea-d161-3210-bd41-7fb804c3d403",
                                "text": "„Die Kelten mußten für ihren Angriff schwer büßen.“"
                            },
                            {
                                "example_id": "485540be-1076-4c5d-ad9b-83dc18ff1f57",
                                "sense_id": "41a1b5ea-d161-3210-bd41-7fb804c3d403",
                                "text": "„Was wir über die Kelten wissen, verdanken wir zum einen griechischen und römischen Schriftstellern, zum anderen zahlreichen Ausgrabungsfunden und sprachwissenschaftlichen Untersuchungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "967a84cb-3386-3cf9-acca-a5e480eff0d2",
                        "entry_id": "9ae6f4ba-262d-3d21-a24d-7e01026409f7",
                        "glosses": [
                            "mittel- und westeuropäische Sprachengemeinschaft der Eisenzeit"
                        ],
                        "tags": [
                            "Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "02c444f2-3523-4aae-8b7a-efe50fcfe727",
                                "sense_id": "967a84cb-3386-3cf9-acca-a5e480eff0d2",
                                "text": "Die Sprache der Kelten bildet einen Zweig der indogermanischen Sprachfamilie und wird in Teilen von Irland, Schottland und Wales sowie in der Bretagne noch heute gesprochen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
