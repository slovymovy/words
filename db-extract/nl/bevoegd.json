                                "sense_id": "acab6530-c2c7-31de-a87d-4b9628179b75",
                                "text": "bevoegd verklaren : habiliter, autoriser."
                            },
                            {
                                "example_id": "c50ce586-e0e8-46f0-ba55-6c170b160dee",
                                "sense_id": "acab6530-c2c7-31de-a87d-4b9628179b75",
                                "text": "zich bevoegd verklaren : se déclarer compétent."
                            },
