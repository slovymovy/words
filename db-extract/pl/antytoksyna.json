                "senses": [
                    {
                        "sense_id": "47cdc323-ad0a-326c-b131-5fedc9869d1e",
                        "entry_id": "c8c22ec8-b007-3ab7-96cf-b430f6774713",
                        "glosses": [
                            "biologiczna substancja, zazwyczaj przeciwciało, która neutralizuje działanie toksyn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fcf30ad-afc0-4b68-86b7-c3347c529965",
                                "sense_id": "47cdc323-ad0a-326c-b131-5fedc9869d1e",
                                "text": "Surowica zawierająca antytoksyny może uratować życie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b559893c-78a6-4c05-bb37-7a12fdcf092c",
                        "source_entry_id": "c8c22ec8-b007-3ab7-96cf-b430f6774713",
                        "source_sense_id": "47cdc323-ad0a-326c-b131-5fedc9869d1e",
                        "target_lang_word": "antitoxin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antitoxin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35972eb3-0f2b-308e-b61c-d3e5bd11b163",
                                        "entry_id": "d540925b-9937-31e5-983b-891a71123416",
                                        "glosses": [
                                            "A medicine able to neutralize a toxin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e9b362-2bb4-402d-aa6d-598251ecf9ef",
                                                "sense_id": "35972eb3-0f2b-308e-b61c-d3e5bd11b163",
                                                "text": "Through the needle-hole thus stained with dye it was possible to \"superinject\" antitoxin, using a slightly wider needle avoid back leak along the old needle track, and thus to ensure a distribution of both toxin and antitoxin solutions from the same point the skin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb48aa82-e0c0-3c32-a76d-609f2847a6c2",
                                        "entry_id": "d540925b-9937-31e5-983b-891a71123416",
                                        "glosses": [
                                            "An antibody capable of neutralizing specific toxins."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2fef3a7-11c7-49d0-bf31-12f6a2d26a28",
                                                "sense_id": "eb48aa82-e0c0-3c32-a76d-609f2847a6c2",
                                                "text": "These albuminous substances, whether found as normal products or created artificially in the blood, are distinguished as antitoxins, protective proteïds, vaccines, or alexines; physiologically they have been divided into sozines, those found in animals naturally immune, and phylaxines, those found in animals which by subcutaneous injections have artificially been made immune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40e8bc40-158e-461c-a320-caf3b583b94a",
                        "source_entry_id": "c8c22ec8-b007-3ab7-96cf-b430f6774713",
                        "source_sense_id": "47cdc323-ad0a-326c-b131-5fedc9869d1e",
                        "target_lang_word": "抗毒素",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "抗毒素",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "d6560bbc-8175-33f2-aed2-c9992844df0b",
                                        "entry_id": "cadaa19d-ec99-3c6f-87b7-fb7c468b79dc",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2525f1a-1251-4d9f-9347-1da767790cb7",
                        "source_entry_id": "c8c22ec8-b007-3ab7-96cf-b430f6774713",
                        "source_sense_id": "47cdc323-ad0a-326c-b131-5fedc9869d1e",
                        "target_lang_word": "antitoxine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antitoxine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "027cee3f-db2a-38a8-9ab6-170bb0bb362e",
                                        "entry_id": "52379748-2228-3c8c-85a0-d6351c7c3c01",
                                        "glosses": [
                                            "Substance sécrétée par l’organisme, dont l’effet est de détruire une toxine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6919c6ff-2533-4e4b-8e4c-a485522c23dc",
                                                "sense_id": "027cee3f-db2a-38a8-9ab6-170bb0bb362e",
                                                "text": "On admet une antitoxine antagoniste de la toxine, et un antivenin antagoniste du venin."
                                            },
                                            {
                                                "example_id": "f33f1edd-3f2a-4aab-9708-d8fc9d582f8a",
                                                "sense_id": "027cee3f-db2a-38a8-9ab6-170bb0bb362e",
                                                "text": "N'attendez pas, car l’antitoxine perdra toute efficacité dès le moment où le consensus symptomatique se sera déjà produit. De même que vous ne pouvez, par le traitement de Pasteur, arrêter la rage après son éclosion, de même vous ne pouvez sérothérapiquement guérir le tétanos déclaré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53c6b367-fa29-4411-abc2-93b384b00886",
                        "source_entry_id": "c8c22ec8-b007-3ab7-96cf-b430f6774713",
                        "source_sense_id": "47cdc323-ad0a-326c-b131-5fedc9869d1e",
                        "target_lang_word": "antitoxina",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antitoxina",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "88f75238-b541-3123-abf8-39cb9a78f172",
                                        "entry_id": "91a681f8-92e6-37fc-9e5f-20d60adf93bc",
                                        "glosses": [
                                            "Anticuerpo que es generado por el sistema inmunológico de un organismo ante la introducción de una toxina y sirve para neutralizar posteriors ataques de esta."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f59d7a84-fd4a-4ea5-b6fe-2ca33aef950d",
                        "source_entry_id": "c8c22ec8-b007-3ab7-96cf-b430f6774713",
                        "source_sense_id": "47cdc323-ad0a-326c-b131-5fedc9869d1e",
                        "target_lang_word": "Antitoxin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antitoxin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f0b6073-afb5-3607-8c25-da66aba619ba",
                                        "entry_id": "4f9cce12-29d9-309a-bef9-5dc04f536503",
                                        "glosses": [
                                            "Stoff, der giftige Substanzen im Körper (mikrobielle, pflanzliche oder tierische Gifte) neutralisiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58143c9f-fcb9-4501-9e64-85e930d0f3db",
                                                "sense_id": "1f0b6073-afb5-3607-8c25-da66aba619ba",
                                                "text": "„Für die Therapie der Erkrankung steht ein spezielles Antitoxin zur Verfügung.“"
                                            },
                                            {
                                                "example_id": "765a1ca9-1dc1-4b61-8969-1f283dd025ad",
                                                "sense_id": "1f0b6073-afb5-3607-8c25-da66aba619ba",
                                                "text": "„Sobald das Tetanustoxin an die Nervenzellen gebunden ist, kann es nicht mehr mit Antitoxin neutralisiert werden.“"
                                            },
                                            {
                                                "example_id": "a51f9356-70c6-458e-9025-557069630205",
                                                "sense_id": "1f0b6073-afb5-3607-8c25-da66aba619ba",
                                                "text": "„Die Antitoxine gelangen auch kaum ins Zentralnervensystem: zu spät verabreichtes Tetanus-Antitoxin ist daher wirkungslos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
