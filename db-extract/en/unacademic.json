                            {
                                "example_id": "8e861a14-c707-47b7-bf53-1fe14d5d26e9",
                                "sense_id": "749239a5-2e50-36a5-937b-69b589a094c3",
                                "text": "Some unacademic enthusiastic upright soul called it a pear because it happened to remind him of a pear, though it is really a cactus-berry."
                            },
                            {
                                "example_id": "39639683-e22f-40d0-a0ff-2b4240c30b3d",
                                "sense_id": "749239a5-2e50-36a5-937b-69b589a094c3",
                                "text": "They have to cope with the unacademic behaviour of faculty and administration..."
                            },
                            {
                                "example_id": "f9cb411f-80e3-4fa5-871d-a89b356fae02",
                                "sense_id": "749239a5-2e50-36a5-937b-69b589a094c3",
                                "text": "But today a quiet educator entering for the first time this world of radio will be alarmed by its unacademic atmosphere. Brisk technicians will elbow him..."
                            }
                        ]
                    }
