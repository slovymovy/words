                    {
                        "sense_id": "fb970eee-830a-3c44-a6c5-fa1ec136dafb",
                        "entry_id": "c772c628-ec85-39d3-ab84-38166fbb71e2",
                        "glosses": [
                            "de mate waarin iemand simpel en eenvoudig is zonder overbodige poespas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc3cd80-c04a-43b9-b261-0c413cd037fe",
                                "sense_id": "fb970eee-830a-3c44-a6c5-fa1ec136dafb",
                                "text": "Zijn valse ongekunsteldheid is een literaire façade, een onnatuurlijk maniërisme, een boekerig verschijnsel, dat niet uit het dorp is meegenomen, maar van de planken van academische boekenmagazijnen is gehaald."
                            },
                            {
                                "example_id": "22d91590-6e6d-479c-b547-b000d66f8f0b",
                                "sense_id": "fb970eee-830a-3c44-a6c5-fa1ec136dafb",
                                "text": "Hij ziet dan die diepe sporterspijn en alleen Mart heeft de ongekunsteldheid en oprechtheid om met ze mee te beleven. Daar gaat het om, beste mensen."
                            }
                        ]
                    },
