                        ],
                        "examples": [
                            {
                                "example_id": "a5a6081e-d10a-43ef-b636-ee399b79db69",
                                "sense_id": "6d01fec6-56ce-315a-9581-02b62a52d532",
                                "text": "Mein Home-Office habe ich mir im Keller eingerichtet, da habe ich meine Ruhe."
                            },
                            {
                                "example_id": "06df6264-18f2-4ea7-ac35-6848da5bb400",
                                "sense_id": "6d01fec6-56ce-315a-9581-02b62a52d532",
                                "text": "„Im Durchschnitt spart sich der Deutsche 65 Minuten Pendelei pro Arbeitstag, den er im Home-Office verbringt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
