                                                "sense_id": "48feb163-b1d2-30ea-8f4f-8655f2843935",
                                                "text": "A bit is an atomic item of data."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0143d9-9db5-3ae6-9ce4-8f88d54e16cd",
                                        "entry_id": "833dcf67-ac03-373f-9952-c5ccfee96842",
                                        "glosses": [
                                            "Unable to be split or made any smaller.",
                                            "Containing a single change, as opposed to involving numerous unrelated changes."
