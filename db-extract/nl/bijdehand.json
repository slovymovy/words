                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21268887-f684-3569-a3d6-151e3d212574",
                                        "entry_id": "84ecd8fe-54c2-3a14-8830-93798b9daad3",
                                        "glosses": [
                                            "Que tiene disponibilidad para obrar o responder de manera inmediata."
                                        ],
                                        "tags": [
                                            "se emplea generalmente con el verbo \\\"estar\\"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "863943fb-8f6f-4a8e-aeda-bc0f7995d33e",
                                                "sense_id": "21268887-f684-3569-a3d6-151e3d212574",
                                                "text": "El jefe de Servicios Agrícolas está listo a entregar a quien le pida las semillas necesarias."
                                            }
