                "senses": [
                    {
                        "sense_id": "ad771710-0b77-33fd-bb73-c969c05d2a2e",
                        "entry_id": "c6604440-597c-3415-abc4-66a9380636b2",
                        "glosses": [
                            "Ouvrage permettant, à partir d’une idée, de trouver des mots qui sont en rapport avec celle-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28a1f7fb-3d8c-4d72-92a0-98666e28f48a",
                                "sense_id": "ad771710-0b77-33fd-bb73-c969c05d2a2e",
                                "text": "Les dictionnaires analogiques offrent de nombreuses nomenclatures, cependant que le Thésaurus Larousse (1991) adopte un classement méthodique inspiré de son modèle anglais (le Thésaurus de Roget, dont la première édition remonte à 1852."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1dbb3b2-8c50-3b13-8339-f84c936bafe1",
                        "entry_id": "c6604440-597c-3415-abc4-66a9380636b2",
                        "glosses": [
                            "Vocabulaire normalisé sur la base de termes génériques et de termes spécifiques à un domaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab8042ae-2c21-4214-b337-92dddcf9e3f8",
                                "sense_id": "c1dbb3b2-8c50-3b13-8339-f84c936bafe1",
                                "text": "Pour une compréhension rapide de la structure du document nous listons ci-dessous les principales significations des éléments formels des conventions SKOS : - chaque descripteur (concept) du thésaurus est délimité par une balise , […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cd51ecd-6ae8-46a8-9261-bba46019dc6a",
                        "source_entry_id": "c6604440-597c-3415-abc4-66a9380636b2",
                        "target_lang_word": "Thesaurus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thesaurus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba889b87-b18f-3cc1-8576-85de46fc4e9f",
                                        "entry_id": "b2a40248-c325-322e-9c7e-47df09303c20",
                                        "glosses": [
                                            "eine einsprachige, meist umfangreiche und nach Themen sortierte Wörtersammlung mit Vokabular, dessen Begriffe durch Relationen miteinander verbunden sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe02b451-1b5b-4093-b0c2-a4d64868646d",
                                                "sense_id": "ba889b87-b18f-3cc1-8576-85de46fc4e9f",
                                                "text": "Als Thesaurus werden Wörterbücher bezeichnet, mit denen versucht wird, den gesamten Wortschatz einer Sprache, einer Epoche oder eines Autors darzustellen."
                                            },
                                            {
                                                "example_id": "b4be7cb9-618c-4c5e-b835-f5efbc3e2588",
                                                "sense_id": "ba889b87-b18f-3cc1-8576-85de46fc4e9f",
                                                "text": "Ein Thesaurus einer Sprache ordnet deren Wörter nach Themen und Wortfeldern, dient vor allem zum Auffinden besser passender Wörter beim Schreiben und enthält dafür in der Regel einen alphabetischen Index."
                                            },
                                            {
                                                "example_id": "99e60a51-c494-410b-90a9-392f4cad634c",
                                                "sense_id": "ba889b87-b18f-3cc1-8576-85de46fc4e9f",
                                                "text": "Die häufigsten Relationen in einem Thesaurus sind Äquivalenz-, Assoziations- und hierarchische Relationen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a8110f2-4678-35ec-a763-3bfa33b5153d",
                                        "entry_id": "b2a40248-c325-322e-9c7e-47df09303c20",
                                        "glosses": [
                                            "in ein Textverarbeitungsprogramm integriertes Synonymwörterbuch"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "499c970c-7bb2-4dc4-9e11-505fdfa0f0d5",
                                                "sense_id": "1a8110f2-4678-35ec-a763-3bfa33b5153d",
                                                "text": "Dieses Textverarbeitungsprogramm stellt strukturierte Information in Form eines problemorientierten Thesaurus bereit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c4b4b566-4068-382c-a3ef-7226e65deb18",
                                        "entry_id": "b2a40248-c325-322e-9c7e-47df09303c20",
                                        "glosses": [
                                            "Gebäude, in dem Schätze verwahrt wurden"
                                        ],
                                        "tags": [
                                            "Antike"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
