                "translations": [
                    {
                        "translation_id": "4dcd9dd6-a7a0-4a04-a5ee-a5026aec4b37",
                        "source_entry_id": "3457e4b6-4547-3646-ab99-664543e1ac77",
                        "source_sense_description": "that restores or stimulates health",
                        "target_lang_word": "analeptique",
