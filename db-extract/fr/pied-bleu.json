                "senses": [
                    {
                        "sense_id": "766b33a6-526f-3736-8e28-d129a4699ace",
                        "entry_id": "9af4191a-9cbf-3fb7-a3e9-f8076c9e5329",
                        "glosses": [
                            "Espèce de champignons à lames serrées, au chapeau convexe puis plan, lisse, lilas à bleu-violacé, et au pied sans anneau, robuste, lilas clair ou violet clair à lilas gris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "702dfbb8-a18c-4982-af0e-1caa917d673c",
                                "sense_id": "766b33a6-526f-3736-8e28-d129a4699ace",
                                "text": "Le pied-bleu est indigeste cru."
                            },
                            {
                                "example_id": "f1af081b-3c88-4a73-a857-49cd6682632c",
                                "sense_id": "766b33a6-526f-3736-8e28-d129a4699ace",
                                "text": "Cependant, on l’emploie parfois pour atténuer le goût très accentué (pieds-bleus, tricholomes de la Saint-Georges…) ou très épicé (certains lactaires à goût poivré, par exemple) de certaines espèces."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd498995-453a-4005-8100-523d7712d6d5",
                        "source_entry_id": "9af4191a-9cbf-3fb7-a3e9-f8076c9e5329",
                        "source_sense_id": "766b33a6-526f-3736-8e28-d129a4699ace",
                        "target_lang_word": "Violetter Rötelritterling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Violetter Rötelritterling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "343f6cfe-b04f-3b66-8698-a3c378af9640",
                                        "entry_id": "23d0c04d-1f66-32b6-a691-0654b1652e95",
                                        "glosses": [
                                            "essbarer Pilz, der anfänglich vollständig violett gefärbt ist, mit zunehmendem Alter eine bräunliche Farbe annimmt"
                                        ],
                                        "tags": [
                                            "Mykologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bb0e6f3-f787-467a-8dc6-023e8b01b048",
                                                "sense_id": "343f6cfe-b04f-3b66-8698-a3c378af9640",
                                                "text": "Jung besitzt der Violette Rötelritterling einen fast halbkugelförmig wirkenden Hut, der später stark abflacht und einen Durchmesser von 12 cm erreichen kann."
                                            },
                                            {
                                                "example_id": "51ab6785-07c1-442c-907c-3f3d7b322d7c",
                                                "sense_id": "343f6cfe-b04f-3b66-8698-a3c378af9640",
                                                "text": "Weil der Violette Rötelritterling spät im Herbst erscheint, wird er selten von Maden befallen und man muss beim Feinsäubern nur selten etwas entfernen."
                                            },
                                            {
                                                "example_id": "299e65f9-1020-401b-b457-72d2e6ae4ace",
                                                "sense_id": "343f6cfe-b04f-3b66-8698-a3c378af9640",
                                                "text": "Getrockneter Violetter Rötelritterling wird wie die meisten Ritterlinge ein wenig hart und muss ziemlich lange eingeweicht werden, mindestens ein paar Stunden."
                                            },
                                            {
                                                "example_id": "7e8fde60-6ace-47d2-bf5e-21dcd9bead8d",
                                                "sense_id": "343f6cfe-b04f-3b66-8698-a3c378af9640",
                                                "text": "Der Violette Rötelritterling ist eine Pilzsorte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
