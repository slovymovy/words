                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "611e95af-20f3-4c00-aee2-59d03bd75573",
                        "source_entry_id": "7fb0acee-cba0-3e5e-acd8-6f3819d2f987",
                        "source_sense_id": "b42e0b1f-c185-31ab-8a97-5455556d7073",
                        "target_lang_word": "apathiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apathiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd24e61-2f53-393d-b7e1-5883184ab01c",
                                        "entry_id": "7a187eb6-b170-378a-84ef-45c6ad032de8",
                                        "glosses": [
                                            "D’une manière apathique, nonchalante, amorphe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f04dfb72-96d0-46c7-b170-6e935842e663",
                                                "sense_id": "2fd24e61-2f53-393d-b7e1-5883184ab01c",
                                                "text": "On y est apathiquement soumis à des formes, à une doctrine dont on ne songe pas à examiner le vice ou la sagesse."
                                            },
                                            {
                                                "example_id": "50a1ac03-e79e-4a6c-b504-2b943de6195a",
                                                "sense_id": "2fd24e61-2f53-393d-b7e1-5883184ab01c",
                                                "text": "Mais il y a trop de tems qu’ils vivent en paix pour combattre sur la brêche. Je les vois marcher apathiquement sur les débris de toutes les vertus & sur les torches de tous les crimes."
                                            },
                                            {
                                                "example_id": "ce905fa9-cd60-4ad4-a3f1-c562ba81f456",
                                                "sense_id": "2fd24e61-2f53-393d-b7e1-5883184ab01c",
                                                "text": "Les prolétaires russes supportent le martyre, non pas apathiquement, comme on vous le raconte (ce sont des légendes) mais dʼune manière voulue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc5504de-a4f9-4933-a457-cd9250ff2050",
                        "source_entry_id": "7fb0acee-cba0-3e5e-acd8-6f3819d2f987",
