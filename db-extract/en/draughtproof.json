                    {
                        "translation_id": "645089ae-5255-42d4-b20d-61e2728de193",
                        "source_entry_id": "2e7d4ca0-a1fc-3564-b712-1539f88d3182",
                        "source_sense_id": "2c69a76b-5c7a-37f4-928a-d5ce3bac5767",
                        "source_sense_description": "to seal an opening to prevent draughts",
                        "target_lang_word": "calfeutrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calfeutrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79290af0-69e4-3e7f-af42-978fb5be36b4",
                                        "entry_id": "dfda3174-8625-3fa4-a528-8e4997a6033f",
                                        "glosses": [
                                            "Boucher les interstices d’une porte, d’une fenêtre, avec du papier, du parchemin collé ou des lisières, etc., pour empêcher que le vent n’entre dans une pièce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dab51754-76c0-48ca-be23-888a3ae5ccc6",
                                                "sense_id": "79290af0-69e4-3e7f-af42-978fb5be36b4",
                                                "text": "Il faut calfeutrer cette porte, cette fenêtre."
                                            },
                                            {
                                                "example_id": "8cc74e1e-916a-48e8-ac01-3fda96ec559c",
                                                "sense_id": "79290af0-69e4-3e7f-af42-978fb5be36b4",
                                                "text": "Cette case était un assemblage de pieux calfeutrés d’un entrelacement de branches."
                                            },
                                            {
                                                "example_id": "ef7b8616-1d19-4649-a304-e47bbae34227",
                                                "sense_id": "79290af0-69e4-3e7f-af42-978fb5be36b4",
                                                "text": "Les longs étés à Nollet, et les lectures dans la fraîcheur du salon, sur le canapé de Guerre et Paix, les lectures aussi de l’automne devant un grand feu, et les nuits tôt venues de l’hiver où dans un lit calfeutré on n’en finit plus de lire, tandis que le vent passe et tourne autour de la maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "240f8112-a4db-3e09-96e4-168efff1bb7a",
                                        "entry_id": "dfda3174-8625-3fa4-a528-8e4997a6033f",
                                        "glosses": [
                                            "S’enfermer bien chaudement."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ef08878-ef30-4d28-89ba-2d6a934a4115",
                                                "sense_id": "240f8112-a4db-3e09-96e4-168efff1bb7a",
                                                "text": "On voyait maintenant des compositeurs, et jusqu'à des virtuoses, qui connaissaient l'œuvre de Bach! − Surtout on avait fait un grand effort pour combattre l'esprit casanier des Français. Ces gens-là se calfeutrent chez eux ; ils ont peine à sortir."
                                            },
                                            {
                                                "example_id": "ca686e08-26fd-4135-82ce-401476ca1356",
                                                "sense_id": "240f8112-a4db-3e09-96e4-168efff1bb7a",
                                                "text": "Je jette avec grâce mon feutre,\nJe fais lentement l’abandon\nDu grand manteau qui me calfeutre,\nEt je tire mon espadon ;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "922ecbfe-fa1b-3cb2-811d-5278f3083383",
                                        "entry_id": "dfda3174-8625-3fa4-a528-8e4997a6033f",
                                        "glosses": [
                                            "Se replier sur soi-même."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5660f32d-9db3-4133-afd1-2bd5adf353a8",
                                                "sense_id": "922ecbfe-fa1b-3cb2-811d-5278f3083383",
                                                "text": "Élisabeth bouda, se calfeutra dans un mutisme dédaigneux. Ce mutisme l'ennuyant, elle passa de l'emploi de la mégère à celui de nourrice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
