                ],
                "senses": [
                    {
                        "sense_id": "6fec676c-1ab0-3786-9616-8e679d4982c7",
                        "entry_id": "4c4eca48-bb2b-33e0-afa6-87556f80ebbd",
                        "glosses": [
                            "vorderer oder hinterer Teil eines festen Bucheinbandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbbc576c-d2e4-421d-9f70-5cfc055754c0",
                                "sense_id": "6fec676c-1ab0-3786-9616-8e679d4982c7",
                                "text": "„Er hatte so viel Papier aus dem Fenster geworfen, dass der Physikband auf seinem Schoß nur noch aus den Buchdeckeln bestand.“"
                            },
                            {
                                "example_id": "c184b806-dc14-4e49-90df-c1ea2d951744",
                                "sense_id": "6fec676c-1ab0-3786-9616-8e679d4982c7",
                                "text": "„Doch dann habe ich die Buchstaben auf dem leicht angehobenen Buchdeckel gesehen.“"
                            },
                            {
                                "example_id": "3ea48af2-77ff-4667-add9-0ab613afe2cc",
                                "sense_id": "6fec676c-1ab0-3786-9616-8e679d4982c7",
                                "text": "„Unterzeichnet war die Karte, in deutscher Kurrentschrift und mit kleinem Anfangsbuchstaben, mit jenem charakteristischen Namenszug ›brecht‹, der heute auf Buchdeckeln zu finden ist.“"
                            },
                            {
                                "example_id": "748d57d6-43e2-4c39-a816-258adeebf5c9",
                                "sense_id": "6fec676c-1ab0-3786-9616-8e679d4982c7",
                                "text": "„Ich stöhnte und ließ meinen Kopf auf meinen Buchdeckel fallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
