                        "examples": [
                            {
                                "example_id": "73e0c1c6-fe5a-4767-b411-85a6232f6ef1",
                                "sense_id": "3cd688d8-07f6-3536-97bc-7fba40bc998f",
                                "text": "Satan, Sphinge, Vampire, Bouche d’ombre, annexons à cette cohorte la noire Isis, pourvoyeuse et égareuse de phallus dont nous sommes tous, hommes et femmes, les Osiris en attente de réfection, éternellement […]."
                            },
                            {
