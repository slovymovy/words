                        "target_lang_word": "roller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fef15b92-8645-3d17-a302-3b4ea2e79c9b",
                                        "entry_id": "414cb7f3-091a-3fc5-bbb7-27c790d1e330",
                                        "glosses": [
                                            "Patin à roulettes dont les roues sont alignées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c79c0d-65d6-47c2-ac56-bf48a50be073",
                                                "sense_id": "fef15b92-8645-3d17-a302-3b4ea2e79c9b",
                                                "text": "Plus tard, il a essayé les rollers..."
                                            },
                                            {
                                                "example_id": "3905432d-4657-4e2f-8e58-cec2a73b5559",
                                                "sense_id": "fef15b92-8645-3d17-a302-3b4ea2e79c9b",
                                                "text": "Je vends des planches, des boards, des rollers, des surfs et des tout-terrains."
                                            },
                                            {
                                                "example_id": "1860d9d4-3e97-4d59-b44c-c5149c0382af",
                                                "sense_id": "fef15b92-8645-3d17-a302-3b4ea2e79c9b",
                                                "text": "Mon père m’a offert une paire de rollers toute neuve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d6a0b6f-50a1-3287-9447-26b3fedf83e0",
                                        "entry_id": "414cb7f3-091a-3fc5-bbb7-27c790d1e330",
                                        "glosses": [
                                            "Sport pratiqué avec ces patins."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e063793-1f57-457a-a0a3-117013529747",
                                                "sense_id": "9d6a0b6f-50a1-3287-9447-26b3fedf83e0",
                                                "text": "Sais-tu faire du roller ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "597be5a2-a356-3abf-86f9-65728dca9733",
                                        "entry_id": "414cb7f3-091a-3fc5-bbb7-27c790d1e330",
                                        "glosses": [
                                            "Sorte de stylo bille utilisant une encre fluide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4ae75d8-6024-4d16-b4d8-911143979e42",
                                                "sense_id": "597be5a2-a356-3abf-86f9-65728dca9733",
                                                "text": "Elle n'a pas été écrite au stylo à bille car l'encre des stylos à bille est à base d'huile ; l'eau ne l'aurait pas fait couler. Mais plutôt avec un roller, dont l'encre est à base d'eau, et dont l'épaisseur du trait ne varie pas."
                                            },
                                            {
                                                "example_id": "6a4f96bc-87a3-401e-b0c3-d03c1c671d7a",
                                                "sense_id": "597be5a2-a356-3abf-86f9-65728dca9733",
                                                "text": "Rosaleen posa la carte à plat et prit son stylo d'un grand geste du bras – un roller à encre gel spécial qu'elle avait acheté au nouveau supermarché."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25ff2a01-5c39-35cb-8066-1c5b022d3b5a",
                                        "entry_id": "414cb7f3-091a-3fc5-bbb7-27c790d1e330",
                                        "glosses": [
                                            "Applicateur de produits pour le corps terminé par une boule qui peut rouler sur elle-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eb69825-a7f6-4aad-9a04-22faef71213d",
                                                "sense_id": "25ff2a01-5c39-35cb-8066-1c5b022d3b5a",
                                                "text": "Avec sa bille automassante, ce roller aux huiles essentielles permet de récupérer plus vite en soulageant les douleurs musculaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "roller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11eeb6e3-c961-39e6-824f-256280a84c36",
                                        "entry_id": "b37b4b6f-6b59-326c-9c9d-fb3dc64d7d0f",
                                        "glosses": [
                                            "Faire du rock and roll, du rock, avoir un caractère rock and roll, rock."
                                        ],
                                        "tags": [
                                            "Rock"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0066039e-bd63-4803-998e-58719899f9b2",
                                                "sense_id": "11eeb6e3-c961-39e6-824f-256280a84c36",
                                                "text": "Sammy chante à toute allure, il rocke, il rolle, il rugit, et ressuscite sa négritude innée."
                                            },
                                            {
                                                "example_id": "8792f7d5-dac8-41fd-ab94-da49ee8a6e86",
                                                "sense_id": "11eeb6e3-c961-39e6-824f-256280a84c36",
                                                "text": "Il rocke et il rolle à jets discontinus de toutes ses baguettes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
