                                    },
                                    {
                                        "sense_id": "04accaef-5b08-3a53-8d65-2dc9e3f535d9",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The property of a propagated wave being thrown back from a surface (such as a mirror)."
                                        ],
