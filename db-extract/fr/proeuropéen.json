                "senses": [
                    {
                        "sense_id": "3dccba7d-dee0-3170-bced-5449d377ad18",
                        "entry_id": "f200a4ac-07b3-3579-ad88-a3ffed8c3b18",
                        "glosses": [
                            "Favorable à l’entrée dans l’Union européenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd086d8-fc90-4168-ada0-0838060a258b",
                                "sense_id": "3dccba7d-dee0-3170-bced-5449d377ad18",
                                "text": "Le chef de l’État sortant, Milo Djukanovic, 61 ans et vétéran de la scène politique monténégrine, affrontera aujourd’hui au second tour de la présidentielle Jakov Milatovic, économiste proeuropéen de 36 ans, favori du scrutin."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ab9c9fd-c79a-3022-ad30-f0501f2af84a",
                        "entry_id": "f200a4ac-07b3-3579-ad88-a3ffed8c3b18",
                        "glosses": [
                            "Favorable à une intégration plus poussée de l’Union européenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129f27ce-93de-44b3-80bb-8b7b4432bd2d",
                                "sense_id": "9ab9c9fd-c79a-3022-ad30-f0501f2af84a",
                                "text": "Je respecte les souverainistes, mais je ne respecte pas les défenseurs du non qui se prétendent pro-européens."
                            },
                            {
                                "example_id": "1155dc38-fbd2-4fe1-ab23-0597d76dd4d3",
                                "sense_id": "9ab9c9fd-c79a-3022-ad30-f0501f2af84a",
                                "text": "Il aura de difficiles compromis à réaliser au sein de son cabinet entre celui qu'il a choisi pour être ministre du commerce, Ken Clarke, proeuropéen, et celui qui sera le patron du Foreign Office, William Hague, fréquemment sujet à des crises d'europhobie aiguës."
                            }
                        ]
                    }
