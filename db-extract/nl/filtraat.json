                    {
                        "sense_id": "23a89cf0-d8fa-3fb0-8586-62a13282c275",
                        "entry_id": "aa79f08c-71ba-3e75-a578-6d82ad8b8e30",
                        "glosses": [
                            "vocht dat resultaat is van filtreren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdd5b1ce-7ff6-4a6b-824a-1fdfccfcc6ec",
                                "sense_id": "23a89cf0-d8fa-3fb0-8586-62a13282c275",
                                "text": "Vorig jaar heb ik een eigen creatie met rood fruit gemaakt. Koffie uit Kenia mengde ik met een filtraat van cranberry, kersen en aalbessen. Dat heeft het verschil gemaakt.\""
                            },
                            {
                                "example_id": "1110c643-2d0b-4c94-8d1b-0bbfcf7fd1d7",
                                "sense_id": "23a89cf0-d8fa-3fb0-8586-62a13282c275",
                                "text": "(Retentaat is de melkfractie die door het membraan wordt tegengehouden, wat er door gaat heet permeaat of filtraat.) Wordt nu het retentaat (waarin zich bacterien en in mindere mate vet en eiwitten ophopen) gesteriliseerd en vermengd met het permeaat dan is het mengsel na pasteurisatie 50 procent langer houdbaar dan gewone gepasteuriseerde melk zonder dat de vieze kooksmaak optreedt."
                            },
                            {
                                "example_id": "8e07233f-9c53-4d66-bb5d-61c68c6bda1f",
                                "sense_id": "23a89cf0-d8fa-3fb0-8586-62a13282c275",
                                "text": "Bovendien, vond Elsschot, 'het gaat immers niet aan voor iemand die vrouw en kinderen ten laste heeft, zich telkens af te zonderen om de leden van zijn eigen gezin en zijn eigen binnenste vanuit een hoek te gaan bespieden en ze een voor een onder het mes te nemen om uit hun bloed voor vreemden een filtraat te bereiden.'"
                            }
                        ]
                    }
