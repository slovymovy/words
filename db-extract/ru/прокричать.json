                        "entry_id": "b5ecf986-5f69-3d38-857f-c5cf6662698c",
                        "glosses": [
                            "to shout, to cry out, to yell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83e7a80b-fe92-4f2e-95de-4cce21b9ad30",
                                "sense_id": "2513d54f-28ea-334a-9630-f7beb064b217",
                                "text": "прокрича́ть у́ши кому́-либо о чём-либо",
                                "translation": "to din something into someone's ears",
                                "english": "to din something into someone's ears"
                            }
                        ]
                    },
                    {
                        "sense_id": "6f2891a5-2d22-3d9a-8df0-8fb99da47fab",
                        "entry_id": "b5ecf986-5f69-3d38-857f-c5cf6662698c",
                        "glosses": [
                            "to shout (for a certain time), to scream"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccb90dbe-b629-462b-8c6b-7b1888fa1fc6",
                                "sense_id": "6f2891a5-2d22-3d9a-8df0-8fb99da47fab",
                                "text": "она́ прокрича́ла це́лый час",
                                "translation": "she screamed for a whole hour",
                                "english": "she screamed for a whole hour"
                            }
                        ]
                    },
                    {
                        "sense_id": "203a5168-ef2d-3040-80a5-99246809aa02",
                        "entry_id": "b5ecf986-5f69-3d38-857f-c5cf6662698c",
                        "glosses": [
                            "to trumpet, to tout"
                        ],
