                                        "sense_id": "40cce546-f45a-397a-b6ce-c4c1fa8ac351",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "A connection between places, people, events, things, or ideas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4123f670-bc4e-4b42-aaa6-22e1d7852f8f",
                                                "sense_id": "40cce546-f45a-397a-b6ce-c4c1fa8ac351",
                                                "text": "The mayor’s assistant serves as the link to the media."
                                            },
                                            {
                                                "example_id": "71f45cbf-110c-43bc-84ff-1722fd56638e",
                                                "sense_id": "40cce546-f45a-397a-b6ce-c4c1fa8ac351",
                                                "text": "The link of brotherhood, by which / One common Maker bound me to the kind."
                                            },
                                            {
                                                "example_id": "9b88be50-7801-40dc-a8d4-4f6e70d086ac",
                                                "sense_id": "40cce546-f45a-397a-b6ce-c4c1fa8ac351",
                                                "text": "And so by double lynkes enchaynde themselues in louers life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe6888d-3510-39ec-89ec-59ab8c11a02f",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "One element of a chain or other connected series."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42ee489-8c5a-4907-bae3-88dc7dc7be70",
                                                "sense_id": "ebe6888d-3510-39ec-89ec-59ab8c11a02f",
                                                "text": "The third link of the silver chain needs to be resoldered."
                                            },
                                            {
                                                "example_id": "155f7c43-e26e-4c9d-bb33-d4cc53264eae",
                                                "sense_id": "ebe6888d-3510-39ec-89ec-59ab8c11a02f",
                                                "text": "The weakest link."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "315e50fb-4c81-3bf2-96f4-3d1a44e81aa3",
                                        "entry_id": "646d8601-6b63-34a2-b8f2-93664478e8f3",
                                        "glosses": [
                                            "Abbreviation of hyperlink."
                                        ],
                                        "tags": [
