                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette façade sculptée présente un style <w>antique</w> inspiré des temples romains."
                        },
                        {
                            "text": "Le peintre a donné à cette composition une majesté <w>antique</w> très impressionnante."
