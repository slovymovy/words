                                "target_senses": [
                                    {
                                        "sense_id": "50cbea0c-ea8c-331a-81dc-6eaf75fa723f",
                                        "entry_id": "68e68db6-2ba3-30e2-be8b-5ca4ffa3faa6",
                                        "glosses": [
                                            "Abundant in hills; having many hills."
                                        ],
                                        "tags": [
                                            "of a landscape"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db7f2c7d-babf-4a31-84aa-8cf2bb718366",
                                                "sense_id": "50cbea0c-ea8c-331a-81dc-6eaf75fa723f",
                                                "text": "The intermediate station seen here, Llanbister Road, is 5 hilly miles by road from the town it purports to serve."
                                            },
                                            {
                                                "example_id": "e930382c-7d9c-48ee-84ec-161b34ccc23f",
                                                "sense_id": "50cbea0c-ea8c-331a-81dc-6eaf75fa723f",
                                                "text": "Our first stop is in Antu County, Kirin Province, a rugged and hilly extension of the Changpai foothills. The temperature in midsummer lingers around 20° C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
