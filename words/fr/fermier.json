    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40a030c5-6640-3813-adff-2db6311f01e3",
                    "sense_definition": "Personne qui cultive la terre et élève des animaux sur une exploitation agricole.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>fermier</w> se lève très tôt chaque matin pour nourrir ses bêtes."
                        },
                        {
                            "text": "Ce <w>fermier</w> vend ses fruits et ses légumes directement sur le marché du village."
                        }
                    ],
                    "synonyms": [
                        "agriculteur"
                    ]
                },
                {
                    "sense_id": "5f1b7c3b-642e-39b4-beab-0469021eddd0",
                    "sense_definition": "Personne qui exploite un domaine agricole loué à un propriétaire moyennant une redevance annuelle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "droit_rural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>fermier</w> doit verser un loyer fixe chaque année au propriétaire du domaine."
                        },
                        {
                            "text": "En qualité de <w>fermier</w>, il a signé un bail rural renouvelable tous les neuf ans."
                        }
                    ],
                    "common_phrases": [
                        "statut du fermier"
                    ]
                },
                {
                    "sense_id": "ba4fed9f-08cd-35d7-8ad8-05a91ebe7631",
                    "sense_definition": "Sous l'Ancien Régime, financier chargé par le pouvoir royal de percevoir les impôts indirects.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>fermiers</w> généraux constituaient une compagnie puissante et impopulaire avant la Révolution."
                        },
                        {
                            "text": "Le jeune homme espérait faire fortune en devenant adjoint auprès d'un riche <w>fermier</w> du roi."
                        }
                    ],
                    "common_phrases": [
                        "fermiers généraux"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Ancien Régime"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d9f03fc4-fe6d-35b6-8805-a2c6e6e34b13",
                    "sense_definition": "Fabriqué sur place à la ferme selon des méthodes traditionnelles, à partir du lait ou des produits de l'exploitation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous achetons souvent un fromage <w>fermier</w> au goût délicieux chez le producteur local."
                        },
                        {
                            "text": "Ce restaurant met en avant du poulet <w>fermier</w> élevé en plein air."
                        }
                    ],
                    "common_phrases": [
                        "fromage fermier",
                        "poulet fermier"
                    ]
                },
                {
                    "sense_id": "18def60d-27bb-34e1-89a7-42248f857ef7",
                    "sense_definition": "Qui a rapport à l'exploitation d'une ferme, à sa gestion ou au système du fermage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La famille a constitué une petite société <w>fermière</w> pour administrer les terres agricoles."
                        },
                        {
                            "text": "Cette nouvelle loi modifie en profondeur le régime <w>fermier</w> dans notre région."
                        }
                    ],
                    "common_phrases": [
                        "société fermière"
                    ]
                }
            ]
        }
    ]
