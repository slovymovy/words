                "senses": [
                    {
                        "sense_id": "f783ac95-02af-37bb-aab8-2a207dc7b51e",
                        "entry_id": "70a58cf6-2b42-3788-a029-9bbb76cdde79",
                        "glosses": [
                            "orientiertes, symbolisches Opfer (Gegenstand), das ein Votant darbringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1045de0-4c8c-4d2b-954b-1dbc0ad508de",
                                "sense_id": "f783ac95-02af-37bb-aab8-2a207dc7b51e",
                                "text": "Einige Votigaben werden mit dem schriftlichen Hinweis \"ex voto\" (lat. ‚wegen eines Gelübdes‘) gekennzeichnet."
                            },
                            {
                                "example_id": "4a2f48b3-e6d4-4743-ada3-43cc83fe6b9e",
                                "sense_id": "f783ac95-02af-37bb-aab8-2a207dc7b51e",
                                "text": "„Das verleiht der am Salzburg Museum erhalten gebliebenen Sammlung an Votivgaben - die von den Eingeweide- und Organvotiven aus Holz und Wachs bis zum \"Mann im Stock\", jener in der Literatur wiederholt zitierten eisernen Votivgabe an den Hl. Leonhard, reicht - einen sehr hohen Stellenwert.“"
                            },
                            {
                                "example_id": "b050a806-203e-4bdf-b3c4-be94cd361901",
                                "sense_id": "f783ac95-02af-37bb-aab8-2a207dc7b51e",
                                "text": "„Im Zuge dieser aufgeklärten Kirchenreform waren schon Ende des 18. und Anfang des 19. Jahrhunderts zahlreiche Wallfahrtsstätten ihrer Votivtafeln und Votivgaben entledigt worden, und vieles von dem, was die Aufklärung übrigliess, fiel jüngeren Kirchenrestaurierungen zum Opfer - ganz zu schweigen von den häufigen Diebstählen.“"
                            },
                            {
                                "example_id": "ae0fe94b-a2ca-417b-953b-ce0cfb62a380",
                                "sense_id": "f783ac95-02af-37bb-aab8-2a207dc7b51e",
                                "text": "„Handelte es sich bei den Waffen wohl meist um Beutestücke, die nach einer gewonnenen Schlacht den Göttern geopfert wurden, so deuten die anderen Opfergaben mehr auf Bitt- oder Dankgeschenke, ähnlich unseren heutigen Votivgaben an Wallfahrtsorten, hin.“"
                            },
                            {
                                "example_id": "fa285981-e19f-4dc1-87f5-fab24079d155",
                                "sense_id": "f783ac95-02af-37bb-aab8-2a207dc7b51e",
                                "text": "„Die Archäologen jedenfalls fanden zahllose Votivgaben, die belegen, dass vier Jahrhunderte lang an den Ort gepilgert wurde, darunter waren 700 Münzen aus 450 Jahren, Statuen für Apollo und die Sirona sowie den Merkur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
