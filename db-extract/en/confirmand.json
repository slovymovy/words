            {
                "entry_id": "cea34800-2624-3034-a094-8e2a48193500",
                "word": "confirmand",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "981864ca-dc80-4d8a-aa73-d966e5a3eef1",
                        "entry_id": "cea34800-2624-3034-a094-8e2a48193500",
