                "senses": [
                    {
                        "sense_id": "776ccbd3-cb69-36cd-8949-9a4d066a8229",
                        "entry_id": "43e0a182-7109-32a9-b710-8811189a632a",
                        "glosses": [
                            "wissenschaftliche Untersuchung, wie Menschen eine Sprache erlernen, sowie die Forschungsdisziplin, die solche Untersuchungen durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fca6704-2931-413c-a7c1-a706a71ae6a4",
                                "sense_id": "776ccbd3-cb69-36cd-8949-9a4d066a8229",
                                "text": "„Solche Mischformen, die während der Erwerbs zweier Sprachen auftreten, nennt man in der Spracherwerbsforschung Interferenzen.“"
                            },
                            {
                                "example_id": "67ff4cd3-9b51-448c-b738-5c9f1f789468",
                                "sense_id": "776ccbd3-cb69-36cd-8949-9a4d066a8229",
                                "text": "„Die Spracherwerbsforschung ist ein Gebiet, das Wissenschaftler/innen aus ganz verschiedenen Disziplinen bearbeiten.“"
                            },
                            {
                                "example_id": "9052b8f9-1b54-47d4-aa6b-8dcf51194838",
                                "sense_id": "776ccbd3-cb69-36cd-8949-9a4d066a8229",
                                "text": "„Als Bezugspunkt der Gliederung dieser Periode steht Roman Jakobsons Beitrag zur Spracherwerbsforschung aus dem Jahre 1941.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
