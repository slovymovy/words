                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>noordwaartse</w> route is tijdens de wintermaanden vaak onbegaanbaar door de sneeuw.",
                            "target_lang_translations": {
                                "en": "The <w>northward</w> route is often impassable during the winter months due to snow.",
                                "ru": "<w>Северный</w> маршрут в зимние месяцы часто непроходим из-за снега."
                            }
                        },
                        {
                            "text": "Er is een sterke <w>noordwaartse</w> stroming in dit deel van de oceaan.",
                            "target_lang_translations": {
                                "en": "There is a strong <w>northward</w> current in this part of the ocean.",
                                "ru": "В этой части океана наблюдается сильное <w>северное</w> течение."
                            }
