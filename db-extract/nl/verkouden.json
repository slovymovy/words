                "senses": [
                    {
                        "sense_id": "fcec4ec2-234c-3f6a-8696-52e19a0d78b2",
                        "entry_id": "e02e0f74-9912-31ef-b031-9b046efc7441",
                        "glosses": [
                            "last hebbend van een ongevaarlijke virusinfectie aan de bovenste luchtwegen, een kou gevat hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9df5d0-c526-4cea-aa9e-ba5abbe0f079",
                                "sense_id": "fcec4ec2-234c-3f6a-8696-52e19a0d78b2",
                                "text": "`Sarah! Alweer jij. Ben jij toevallig verkouden? Het is wel toevallig dat jij altijd verkouden bent. Vind je dat niet erg toevallig?'"
                            },
                            {
                                "example_id": "04bd71a6-f013-426f-ad16-adc2e8638488",
                                "sense_id": "fcec4ec2-234c-3f6a-8696-52e19a0d78b2",
                                "text": "‘Ik was zo vaak mogelijk mijn handen. Een cliënt die snottert, sturen we naar huis. Maar in de praktijk is dat moeilijk. Wanneer is iemand verkouden genoeg om naar huis te sturen? Voor veel van onze cliënten is de dagbesteding een belangrijke plek, ze kunnen niet altijd lang thuis blijven."
                            }
                        ]
                    }
                ],
