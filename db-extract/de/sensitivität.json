                ],
                "senses": [
                    {
                        "sense_id": "73540c27-3bb7-3042-9199-4b28b9ef4428",
                        "entry_id": "2bc3669d-7b15-3bd3-a595-bdf8364c882b",
                        "glosses": [
                            "Empfindlichkeit von Menschen, Tieren, Pflanzen, Nervenzellen, Systemen für Umweltreize"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "e2334bba-d8c2-4636-aca8-77b5cb35acc6",
                                "sense_id": "73540c27-3bb7-3042-9199-4b28b9ef4428",
                                "text": "Die Sensitivität aller Beteiligten ist von entscheidender Bedeutung für das Funktionieren innerbetrieblicher Zusammenarbeit."
                            },
                            {
                                "example_id": "6c50d9b0-6522-4e82-be61-64f9623ec3bb",
                                "sense_id": "73540c27-3bb7-3042-9199-4b28b9ef4428",
                                "text": "Eine hohe Sensitivität neuronaler Aktivitäten macht Menschen stressanfälliger."
                            },
                            {
                                "example_id": "3781bebb-7bd9-4400-8bb8-8d0e81cd2d66",
                                "sense_id": "73540c27-3bb7-3042-9199-4b28b9ef4428",
                                "text": "Im Treiber habe ich die Sensitivität des Tableaus auf leicht gestellt."
                            },
                            {
                                "example_id": "e015f915-f04b-4271-b085-0965ab5a1d38",
                                "sense_id": "73540c27-3bb7-3042-9199-4b28b9ef4428",
                                "text": "Die Sensitivität des Lichtsensors ist zu hoch. Der Sensor reagiert auf schwächste Schatten."
                            },
                            {
                                "example_id": "0f28d3b9-5a8b-4e06-bd9d-5e8b382e295e",
                                "sense_id": "73540c27-3bb7-3042-9199-4b28b9ef4428",
                                "text": "Die untersuchten Buchen zeigten eine hohe Sensitivität bei relativ kurzen Trockenperioden."
                            },
                            {
                                "example_id": "4373b887-035a-44a8-8db1-2c0ed434f5ee",
                                "sense_id": "73540c27-3bb7-3042-9199-4b28b9ef4428",
                                "text": "„Wie gut ein Lebewesen riechen kann, hängt von der Sensitivität der Geruchsrezeptoren und der Anzahl der Riechzellen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c2c45864-4666-3a03-8d7c-fb70e66e5824",
                        "entry_id": "2bc3669d-7b15-3bd3-a595-bdf8364c882b",
                        "glosses": [
                            "Tauglichkeit diagnostischer Tests, eine bestimmte Erkrankung zu erkennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6ba47a-60b5-4a49-9319-1a84239997a0",
                                "sense_id": "c2c45864-4666-3a03-8d7c-fb70e66e5824",
                                "text": "Daher bieten wir unsere Schwangerschaftstest ebenfalls in einer hohen Sensitivität an."
                            },
                            {
                                "example_id": "c326c4e4-fd77-4e2e-a4dc-cf00e3d5d57d",
                                "sense_id": "c2c45864-4666-3a03-8d7c-fb70e66e5824",
                                "text": "Ein negatives Resultat bei einem Test von hoher Sensitivität kann die gesuchte Erkrankung mit hoher Wahrscheinlichkeit ausschließen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1e606f9d-0aa0-39f5-b492-c081638a6e8d",
                        "entry_id": "2bc3669d-7b15-3bd3-a595-bdf8364c882b",
                        "glosses": [
                            "Fähigkeit eines Tests, einen Sachverhalt zu erkennen"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "1cd50312-7d45-4b25-bcb0-9c8ffb266560",
                                "sense_id": "1e606f9d-0aa0-39f5-b492-c081638a6e8d",
                                "text": "Sensitivität und Spezifität wiederum hängen konkurrierend voneinander ab. Je höher die Sensitivität, desto schlechter wird die Spezifität und umgekehrt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99797db0-2cd3-4235-b508-f3ea268554a7",
                        "source_entry_id": "2bc3669d-7b15-3bd3-a595-bdf8364c882b",
