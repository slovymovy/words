                    {
                        "sense_id": "e582e7de-805b-3d5b-8797-fafaf9462995",
                        "entry_id": "571fd29f-96e9-3ce8-937a-f849566c4289",
                        "glosses": [
                            "Schriftstück, mit dem jemand zu etwas eingeladen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f26dd0ba-c676-4597-ba4b-70ec8ca1e480",
                                "sense_id": "e582e7de-805b-3d5b-8797-fafaf9462995",
                                "text": "„Wenn das Informationsschreiben, das dem Einladungsschreiben zur Darmkrebsvorsorge beiliegt, in einer Sprache abgefasst würde, die von der durchschnittlichen Bevölkerung auch verstanden wird, würden wir viel mehr Menschen erreichen.“"
                            },
                            {
                                "example_id": "1f0260df-053b-400f-9137-df544d9a000c",
                                "sense_id": "e582e7de-805b-3d5b-8797-fafaf9462995",
                                "text": "„Es dauerte einige Wochen, bis sie die nötigen Unterlagen zusammenhatte, darunter ein Einladungsschreiben, dann saß sie im Zug nach Allenstein, das nun Olsztyn hieß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
