                        ],
                        "form": "mémentos"
                    },
                    {
                        "form_id": "417efa81-39ba-436c-acbf-c601fb0850aa",
                        "entry_id": "df36facd-5953-3d71-b9ae-9b8306ab5c05",
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "form": "memento"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b994f12e-8541-3896-ab49-92412de3b104",
                        "entry_id": "df36facd-5953-3d71-b9ae-9b8306ab5c05",
                        "glosses": [
                            "Note, notice, résumé destiné à rappeler le souvenir de quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b06661-51be-436c-aa93-5610ab19645c",
                                "sense_id": "b994f12e-8541-3896-ab49-92412de3b104",
                                "text": "Non seulement je lui ai exposé l’affaire, mais je lui en ai laissé un mémento."
                            }
                        ]
                    },
                    {
                        "sense_id": "9228dc45-bd5a-34fc-ae69-4e9212e49ba7",
                        "entry_id": "df36facd-5953-3d71-b9ae-9b8306ab5c05",
                        "glosses": [
                            "Ouvrage élémentaire et technique destiné à rappeler les notions essentielles d’une science, d'un art, d'un outil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26af8149-f806-42d0-80d7-2c93d13815fe",
                                "sense_id": "9228dc45-bd5a-34fc-ae69-4e9212e49ba7",
                                "text": "Mémento sur la gratuité des transports en commun."
                            }
                        ]
                    },
                    {
                        "sense_id": "59e76dd7-a11e-34f2-b49c-1ab33c4ad601",
                        "entry_id": "df36facd-5953-3d71-b9ae-9b8306ab5c05",
                        "glosses": [
                            "Prière du canon de la messe, l’une pour les vivants, l’autre pour les morts, dans la liturgie catholique."
                        ],
                        "tags": [
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "1f9519ad-c8e8-4712-84dd-0d11fb3991ae",
                                "sense_id": "59e76dd7-a11e-34f2-b49c-1ab33c4ad601",
                                "text": "Le mémento des vivants. Le mémento des morts."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b6e83a0-4e2b-342c-b0c6-1a5d54b7da23",
                        "entry_id": "df36facd-5953-3d71-b9ae-9b8306ab5c05",
                        "glosses": [
                            "Image mortuaire destinée à perpétuer le souvenir d’un défunt."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6fb70b57-4e2e-4264-beab-903d31dd2542",
                                "sense_id": "2b6e83a0-4e2b-342c-b0c6-1a5d54b7da23",
                                "text": "On met généralement dans les mémentos le portrait du défunt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3adf39cd-977b-42e7-bcde-ffd202675250",
                        "source_entry_id": "df36facd-5953-3d71-b9ae-9b8306ab5c05",
                        "source_sense_id": "b994f12e-8541-3896-ab49-92412de3b104",
                        "source_sense_description": "Note, notice",
                        "target_lang_word": "memento",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "memento",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "137124e7-966f-3318-84ec-13c5c58423a6",
                                        "entry_id": "6ac0cfc3-e4cd-3d99-a234-018f30a4a30b",
                                        "glosses": [
                                            "A keepsake; an object kept as a reminder of a place or event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b741b763-c3ee-4189-80f5-6b0de03ac79f",
                                                "sense_id": "137124e7-966f-3318-84ec-13c5c58423a6",
                                                "text": "I kept the shell as a memento of my visit to the seashore."
                                            },
                                            {
                                                "example_id": "1e6ed166-68fa-4ab8-be3e-e6ca55db7b07",
                                                "sense_id": "137124e7-966f-3318-84ec-13c5c58423a6",
                                                "text": "In conclusion, I would remark that the great railway stations of London deserve to be visited every whit as much as St. Paul's Cathedral, the Abbey, or the Tower, and they are as worthy a memento of this century as those buildings are of the days that are gone."
                                            },
                                            {
                                                "example_id": "49e30c4c-6388-4ece-b6b1-545d003fda99",
                                                "sense_id": "137124e7-966f-3318-84ec-13c5c58423a6",
                                                "text": "Many hospitals have not taken simple steps to lessen the distress and confusion which dementia sufferers' often feel on being somewhere so unfamiliar – such as making signs large and easy to read, using colour schemes to help patients find their way around unfamiliar wards and not putting family mementoes such as photographs nearby."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dc8fde4-f81f-4ac2-9c4e-d5180b69d5b2",
                        "source_entry_id": "df36facd-5953-3d71-b9ae-9b8306ab5c05",
                        "source_sense_id": "b994f12e-8541-3896-ab49-92412de3b104",
                        "source_sense_description": "Note, notice",
                        "target_lang_word": "pamiątka",
