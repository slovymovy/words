                "senses": [
                    {
                        "sense_id": "c8ace7de-feb6-36ff-b5be-79a6a6c401c5",
                        "entry_id": "4ec9f985-ea92-3598-8276-e304b2f77d0d",
                        "glosses": [
                            "Atemstillstand mit konsekutivem Kreislaufstillstand als Folge des Sauerstoffmangels im Organismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e47b8513-e0da-41f6-a290-b4ac736af6a3",
                                "sense_id": "c8ace7de-feb6-36ff-b5be-79a6a6c401c5",
                                "text": "Asphyxie kann durch Rauchgasvergiftung oder Ertrinken verursacht werden."
                            },
                            {
                                "example_id": "7751715f-b498-46fc-bc42-df2cce87c6c2",
                                "sense_id": "c8ace7de-feb6-36ff-b5be-79a6a6c401c5",
                                "text": "Die Asphyxie des Neugeborenen ist eine der häufigsten Todesursachen in der Neonatalperiode."
                            },
                            {
                                "example_id": "04ecb433-ec67-4fd5-91a3-1b268578097c",
                                "sense_id": "c8ace7de-feb6-36ff-b5be-79a6a6c401c5",
                                "text": "Eine gefürchtete Folge der Asphyxie ist eine hypoxisch-ischämische Enzephalopathie (HIE)."
                            },
                            {
                                "example_id": "bfcff1d3-9204-46eb-9983-87dccacbbdec",
                                "sense_id": "c8ace7de-feb6-36ff-b5be-79a6a6c401c5",
                                "text": "Aus Zeugenaussagen ergab sich, dass diesen der lagebedingte Erstickungstod, die so genannte fixationsbedingte Asphyxie kein Begriff gewesen sein dürfte."
                            },
                            {
                                "example_id": "fb2581ab-56a0-48bc-9592-3d032a05c7e8",
                                "sense_id": "c8ace7de-feb6-36ff-b5be-79a6a6c401c5",
                                "text": "Die Begriffe Asphyxie und Hypoxie-Ischämie werden häufig synonym verwendet, um einen perinatalen Sauerstoffmangel zu beschreiben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07ac2991-d94e-42b2-872a-81ca7ba2e0f4",
                        "source_entry_id": "4ec9f985-ea92-3598-8276-e304b2f77d0d",
                        "source_sense_id": "c8ace7de-feb6-36ff-b5be-79a6a6c401c5",
                        "source_sense_description": "Atemstillstand mit konsekutivem Kreislaufstillstand",
                        "target_lang_word": "asphyxia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asphyxia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d3ad3ff-0873-3119-b523-f5e777a7bb33",
                                        "entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                                        "glosses": [
                                            "Loss of consciousness due to the interruption of breathing and consequent anoxia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f3597e-ab37-41f4-aaf7-a60d254b8429",
                                                "sense_id": "5d3ad3ff-0873-3119-b523-f5e777a7bb33",
                                                "text": "Asphyxia may result from choking, drowning, electric shock, or injury."
                                            },
                                            {
                                                "example_id": "3a155983-0567-4f44-950a-52f0a62753e3",
                                                "sense_id": "5d3ad3ff-0873-3119-b523-f5e777a7bb33",
                                                "text": "The mattress platform on Davey’s bed fell unexpectedly, “trapping her neck against the upper surface of the side panel of the bed’s base,” Chipperfield explained. “Unable to free herself, she died of positional asphyxia. One of the two gas-lift pistons was defective.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8daca4fa-20d9-3c09-b52b-07e4bd1f2009",
                                        "entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                                        "glosses": [
                                            "Loss of consciousness due to the body's inability to deliver oxygen to its tissues, either by the breathing of air lacking oxygen or by the inability of the blood to carry oxygen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a3967b9-5b27-37b7-81c4-1f3c34f53489",
                                        "entry_id": "81f5d134-63c4-37fa-9ce7-0eb0fb7fd27a",
                                        "glosses": [
                                            "A condition in which an extreme decrease in the concentration of oxygen in the body leads to loss of consciousness or death. Replaced in the mid-20th century by the more specific terms anoxia, hypoxia, hypoxemia and hypercapnia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e9f757-a7ef-4514-9009-9d4054b282f5",
                                                "sense_id": "1a3967b9-5b27-37b7-81c4-1f3c34f53489",
                                                "text": "Hypoxaemia [...is] a deficient oxygenation of the blood; asphyxia from defective oxygenation of the blood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
