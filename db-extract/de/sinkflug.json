                        "form": "die Sinkflüge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5390a6c5-0380-3b70-92d0-0c5377c9e547",
                        "entry_id": "bea2b8ae-bd33-361e-9a2e-a2b6a92574dc",
                        "glosses": [
                            "Flugmanöver, bei dem ein Luftfahrzeug seine Flughöhe verringert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bddde826-c328-4929-ae08-0da547973679",
                                "sense_id": "5390a6c5-0380-3b70-92d0-0c5377c9e547",
                                "text": "„Auch der Autopilot, der die Boeing offenbar gesteuert hatte, wäre dann ausgefallen und die Maschine vermutlich in einem spiralförmigen Sinkflug ins Meer gestürzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "107cddae-4c6b-3abf-84fc-f9d01ee98245",
                        "entry_id": "bea2b8ae-bd33-361e-9a2e-a2b6a92574dc",
                        "glosses": [
                            "rapider Niedergang, schnelles Absinken"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "dbd65dee-f87d-40ad-b642-b07ffddde984",
                                "sense_id": "107cddae-4c6b-3abf-84fc-f9d01ee98245",
                                "text": "„Der Sinkflug der Rupie setzt sich trotz Gegensteuern der indischen Zentralbank fort.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e9c6370-7dc2-48be-9fe3-0966fd43f4ee",
                        "source_entry_id": "bea2b8ae-bd33-361e-9a2e-a2b6a92574dc",
                        "source_sense_id": "5390a6c5-0380-3b70-92d0-0c5377c9e547",
                        "source_sense_description": "Flugmanöver, bei dem ein Luftfahrzeug seine Flughöhe verringert",
                        "target_lang_word": "descent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "descent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "An instance of descending; act of coming down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0b4cc0a-6cab-4545-a191-9a387ff1739b",
                                                "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                                "text": "We climbed the mountain with difficulty, but the descent was easier."
                                            },
                                            {
                                                "example_id": "6c80635c-41d9-4f08-aed2-d6fc2b6e1b70",
                                                "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                                "text": "The descent continues, still more steeply to Dundee (Tay Bridge), and approaching from the bridge itself this sharp descent gives the curious appearance that the station is below the level of the firth."
                                            },
                                            {
                                                "example_id": "6a90f9ca-4480-4fad-9ad5-c117f33598e8",
                                                "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                                "text": "To the north the towering scree-strewn slopes of Saddleback begin to draw nearer as we start the abrupt descent towards Keswick."
                                            },
                                            {
                                                "example_id": "91491b62-2b7c-4f91-bed8-74454de909c4",
                                                "sense_id": "5fbb2155-a792-3129-a4a4-40e9b9a789b9",
                                                "text": "The next one surrendered his bike, only for that, too, to give him a second flat as he started the descent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4d2a925-c435-3652-9c61-b7797beb993f",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "A way down."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19dfc6a4-7ff5-4312-b995-84ed762e136d",
                                                "sense_id": "a4d2a925-c435-3652-9c61-b7797beb993f",
                                                "text": "We had difficulty in finding the correct descent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d1eeb8-4b2e-3769-b94a-43670236bb96",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "A sloping passage or incline."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1f3252e-be02-45d3-8a79-ae0f0a637e02",
                                                "sense_id": "84d1eeb8-4b2e-3769-b94a-43670236bb96",
                                                "text": "The descent into the cavern was wet and slippery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c27906a-3745-3fe8-a8ce-b72308be3131",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "Lineage or hereditary derivation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7459909-1cae-4095-82fe-69a96a0a753f",
                                                "sense_id": "3c27906a-3745-3fe8-a8ce-b72308be3131",
                                                "text": "Our guide was of Welsh descent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b629242b-5d9c-3e36-9090-b6051c0eb1c8",
                                        "entry_id": "5ed03f30-c12c-3ce0-8e21-73b2e00c1f7a",
                                        "glosses": [
                                            "A drop to a lower status or condition; decline."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11bb423d-8e30-4b23-bdfe-b41a6c2e7b39",
                                                "sense_id": "b629242b-5d9c-3e36-9090-b6051c0eb1c8",
                                                "text": "After that, the holiday went into a steep descent."
