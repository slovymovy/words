                ],
                "senses": [
                    {
                        "sense_id": "d8017b94-73b8-3405-8566-0026b6d1b2b8",
                        "entry_id": "76bb1151-8ed9-32fd-8490-e4a7a42233e5",
                        "glosses": [
                            "Donner un caractère administratif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc0b8a93-2ce8-4d9c-af8e-e3ae717c9b0f",
                                "sense_id": "d8017b94-73b8-3405-8566-0026b6d1b2b8",
                                "text": "En essayant « d’administratiser » plutôt que de « politiser », le préfet joue en coulisse ;"
                            },
                            {
                                "example_id": "188e179d-4d21-4ab6-a167-7ad7d27f0092",
                                "sense_id": "d8017b94-73b8-3405-8566-0026b6d1b2b8",
                                "text": "Très rapidement, elles ont été utilisées pour techniciser, administratiser, gérer, se rapprocher de la culture dominante de l’économique."
                            },
                            {
                                "example_id": "966a72e4-e8ba-46bd-aae1-8e0bda75d460",
                                "sense_id": "d8017b94-73b8-3405-8566-0026b6d1b2b8",
                                "text": "Identifier comment le fédéralisme canadien tend de plus en plus à « s’administratiser »."
                            }
                        ]
                    }
                ],
