{
    "word_family": [
        "pertinence",
        "pertinency"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b7be7827-4317-31ea-a56b-cb30c46903b3",
                    "sense_definition": "Important with regard to a specific subject or matter; relevant.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer asked a <w>pertinent</w> question that changed the direction of the trial.",
                            "target_lang_translations": {
                                "ru": "Адвокат задал <w>уместный</w> вопрос, изменивший ход судебного процесса."
                            }
                        },
                        {
                            "text": "Please provide only the <w>pertinent</w> information so we can make a quick decision.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, предоставьте только информацию, <w>относящуюся к делу</w>, чтобы мы могли быстро принять решение."
                            }
                        }
                    ],
                    "synonyms": [
                        "applicable",
                        "apposite",
                        "apt",
                        "felicitous",
                        "germane",
                        "in point",
                        "material",
                        "on point",
                        "on-topic",
                        "relevant",
                        "salient",
                        "to the point"
                    ],
                    "antonyms": [
                        "nonpertinent",
                        "irrelevant"
                    ],
                    "common_phrases": [
                        "pertinent information",
                        "pertinent question",
                        "pertinent facts",
                        "pertinent details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий прямое отношение к рассматриваемому вопросу; уместный, актуальный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уместный",
                                "target_lang_sense_clarification": "соответствующий ситуации или теме"
                            },
                            {
                                "target_lang_word": "относящийся к делу",
                                "target_lang_sense_clarification": "имеющий прямое отношение к обсуждаемому вопросу"
                            },
                            {
                                "target_lang_word": "подходящий",
                                "target_lang_sense_clarification": "соответствующий контексту"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "11a00caf-8cbf-3b81-ab81-73de7af19f50",
                    "sense_definition": "A right that attaches to land, in Scots law.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The property deed clearly outlines every <w>pertinent</w> associated with the estate.",
                            "target_lang_translations": {
                                "ru": "В документе о праве собственности четко указана каждая <w>принадлежность</w>, связанная с поместьем."
                            }
                        },
                        {
                            "text": "In Scottish property law, the <w>pertinents</w> include all rights and privileges connected to the land.",
                            "target_lang_translations": {
                                "ru": "В шотландском праве собственности <w>сопутствующие права</w> включают все права и привилегии, связанные с земельным участком."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in Scots law."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В праве Шотландии: право или принадлежность, неразрывно связанная с земельным владением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принадлежность",
                                "target_lang_sense_clarification": "принадлежность недвижимости или земельного участка"
                            },
                            {
                                "target_lang_word": "сервитут или сопутствующее право",
                                "target_lang_sense_clarification": "право, связанное с земельной собственностью"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}