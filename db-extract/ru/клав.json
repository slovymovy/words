                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af5efea1-3fe8-4721-9e39-8f6cbab95949",
                                                "sense_id": "0cab2f43-5c67-3cb9-bf0a-fd97367c99a7",
                                                "text": "The clavus, or ergot of grain, consists in the enlargement and elongation of the seeds […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30fc4f2b-7125-454f-a72f-6ec88a30f273",
                        "source_entry_id": "cfef979d-943e-3ca0-ae38-ff7ad5f38086",
                        "source_sense_id": "dbe191d0-4b46-366b-badf-092d46ad9d7c",
                        "target_lang_word": "laticlave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laticlave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3343048-20f9-3b12-a00c-7097a86a92a0",
                                        "entry_id": "bf54d6cb-7e76-3f55-8e3e-aaba288e5942",
                                        "glosses": [
                                            "Large bande de tissus de couleur pourpre portée sur le devant de la tunique dans le sens vertical, du cou jusqu'en bas du vêtement."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28bb0663-b31f-34cf-9d5f-2d630efa7332",
                                        "entry_id": "bf54d6cb-7e76-3f55-8e3e-aaba288e5942",
                                        "glosses": [
                                            "Tunique bordée d’une large bande de pourpre que portaient les sénateurs, les hauts magistrats."
                                        ],
                                        "tags": [
                                            "Ancient",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74fbd54b-a418-4df3-bbcc-6a7c7bded4e2",
                                                "sense_id": "28bb0663-b31f-34cf-9d5f-2d630efa7332",
                                                "text": "Les remparts étaient couverts de monde quand Vitellius entra dans la cour. Il s’appuyait sur le bras de son interprète, suivi d’une grande litière rouge ornée de panaches et de miroirs, ayant la toge, le laticlave, les brodequins d’un consul et des licteurs autour de sa personne."
                                            },
                                            {
                                                "example_id": "e54d8680-ea39-4444-a98d-f20b00ee1933",
                                                "sense_id": "28bb0663-b31f-34cf-9d5f-2d630efa7332",
                                                "text": "Il y a le oui des grands propriétaires brûlant d'échanger leur nom celte pour la triple appellation des citoyens de Rome, rêvant pour leurs enfants, sinon pour eux-mêmes, du Sénat et du laticlave."
                                            },
                                            {
                                                "example_id": "c9207f5c-a9cc-4b4e-bea4-983afc8530e5",
                                                "sense_id": "28bb0663-b31f-34cf-9d5f-2d630efa7332",
                                                "text": "Il faut donc imaginer lʼimpressionnant spectacle des trois cents sénateurs en laticlave, massés en haut des marches de la curie, faisant face, avec des gesticulations et des palabres, à une foule qui, en tout état de cause, ne devait pase excéder six mille personnes, le Comitium ne permettant pas d’en accueillir plus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
