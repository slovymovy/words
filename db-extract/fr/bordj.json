                            {
                                "example_id": "b5b20a58-b889-45d8-b74e-1406166c65f7",
                                "sense_id": "66ea918b-f3e0-31b2-b08c-c1fcc3ec4bdd",
                                "text": "Arrivés à El Djem, pas d'auberge ; un affreux bordj en tenait lieu. Que faire ? La diligence repartait."
                            }
                        ]
                    },
                    {
                        "sense_id": "6352995b-4aeb-3fb3-8e39-29c39f10f401",
                        "entry_id": "3930eae0-7235-3b0d-8b23-669a92229c5f",
                        "glosses": [
                            "Fortin ; place forte et isolée à usages divers (résidence d’un administrateur de commune mixte, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fea4d31-a7ba-495a-adfc-c15e2f1d401b",
                                "sense_id": "6352995b-4aeb-3fb3-8e39-29c39f10f401",
                                "text": "Quatre heures du matin. — Bientôt, l’aurore va mettre sur le hamada son incendie rose. Autour de moi le bordj sommeille. Par la porte de sa chambre entr’ouverte, j’entends la respiration calme, si calme, d’André de Saint-Avit."
                            }
                        ]
                    }
