                                        "sense_id": "0b49bad7-4c66-3306-9746-baed139f674e",
                                        "entry_id": "bdf4ae08-e3ba-32ca-9d08-80d4b7c0bb76",
                                        "glosses": [
                                            "Provoquer la coagulation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eed86dd9-e21e-41f4-ba40-5e317ca22c17",
                                                "sense_id": "0b49bad7-4c66-3306-9746-baed139f674e",
                                                "text": "On utilise de la présure pour cailler le lait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20997010-66d0-373a-a13c-6a5f3264fe02",
                                        "entry_id": "bdf4ae08-e3ba-32ca-9d08-80d4b7c0bb76",
                                        "glosses": [
                                            "Faire froid."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "157add59-a036-4ec2-b571-4701e28703c0",
                                                "sense_id": "20997010-66d0-373a-a13c-6a5f3264fe02",
                                                "text": "Ça caille en ce moment. Moi, j’étais en vacances dans les Caraïbes, 30°C à l’ombre… C’est toujours agréable quand on a très chaud de savoir que les autres se les pèlent… On profite mieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "388f1c70-0221-31d6-bf1b-3094307673d4",
                                        "entry_id": "bdf4ae08-e3ba-32ca-9d08-80d4b7c0bb76",
                                        "glosses": [
                                            "Avoir froid."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746802cc-645e-4105-b61f-a02a93f8ae57",
                                                "sense_id": "388f1c70-0221-31d6-bf1b-3094307673d4",
                                                "text": "Par contre on gèle, on caille, on a l’onglée, les balloches ratatinées, les pieds glacés."
                                            },
                                            {
                                                "example_id": "ca821185-f553-4415-82f1-5f5e20015221",
                                                "sense_id": "388f1c70-0221-31d6-bf1b-3094307673d4",
                                                "text": "Cesse de rêver à Mulligan et ferme la porte, on caille!"
                                            },
                                            {
                                                "example_id": "ca831548-e327-4c5c-9ebd-472fc0e4dc5e",
                                                "sense_id": "388f1c70-0221-31d6-bf1b-3094307673d4",
                                                "text": "J’aurais dû mettre mon manteau, je caille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5691772-aa47-379e-b2ba-acbcb04981b0",
                                        "entry_id": "bdf4ae08-e3ba-32ca-9d08-80d4b7c0bb76",
                                        "glosses": [
                                            "Produire des crottes (volatiles)."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa8bec23-68cb-4c7a-b5bd-540d62b34b63",
                                                "sense_id": "d5691772-aa47-379e-b2ba-acbcb04981b0",
                                                "text": "Je dois nettoyer la table, les moineaux ont caillé partout."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cailler",
                                "target_lang_code": "fr",
