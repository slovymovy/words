                ],
                "senses": [
                    {
                        "sense_id": "3015dd19-c404-32d9-8cfc-f1138d36742e",
                        "entry_id": "f8201af4-f46a-340e-b594-b29e95920c45",
                        "glosses": [
                            "Celui qui raconte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81f1349-edd1-44eb-b589-ed85ce777f46",
                                "sense_id": "3015dd19-c404-32d9-8cfc-f1138d36742e",
                                "text": "Le raconteur, il raconte, mais il veut que tu mettes les morceaux ensemble avec lui."
                            },
                            {
                                "example_id": "6ff34b9b-3f3a-4259-9e03-638ec12baaa7",
                                "sense_id": "3015dd19-c404-32d9-8cfc-f1138d36742e",
                                "text": "Or j’étais – et je reste – convaincu que ce sont les raconteurs d’histoires, alors relégués au rang de vieilles barbes, qui nourrissent au mieux le goût de lire, cet appétit de lecture auquel nous pouvons apprendre et apprendre encore."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cb33f50-f3ef-44b9-98e7-65ef3c3cf23e",
                        "source_entry_id": "f8201af4-f46a-340e-b594-b29e95920c45",
                        "source_sense_id": "3015dd19-c404-32d9-8cfc-f1138d36742e",
                        "target_lang_word": "storyteller",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storyteller",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "068c57c2-df82-3884-9954-d3d64c081c9f",
                                        "entry_id": "dc181607-390b-3e9d-b775-071822746f02",
                                        "glosses": [
                                            "A person who relates stories through one medium or another to an audience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0c57f2e-2fe4-488d-8fcc-33db0d6a8e14",
                                                "sense_id": "068c57c2-df82-3884-9954-d3d64c081c9f",
                                                "text": "\"Charlotte is the best storyteller I ever heard,\" said Fern, poking her dish towel into a cereal bowl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1c1321-ba6c-3a26-b3ae-7b8ddce1d736",
                                        "entry_id": "dc181607-390b-3e9d-b775-071822746f02",
                                        "glosses": [
                                            "A liar; a fibber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6299eda-b799-45e5-bfe8-278ecde3fcf4",
                                                "sense_id": "2a1c1321-ba6c-3a26-b3ae-7b8ddce1d736",
                                                "text": "There was once upon a time a king, who had a daughter, and she was such an awful story-teller, that you couldn't find a greater anywhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da794001-4a9f-353f-879f-b7ea9ef347e0",
                                        "entry_id": "dc181607-390b-3e9d-b775-071822746f02",
                                        "glosses": [
                                            "A game master, particularly in games focused on collaborative storytelling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5fd5d00-5f95-42a7-b948-c66b5a9af68f",
                        "source_entry_id": "f8201af4-f46a-340e-b594-b29e95920c45",
                        "source_sense_id": "3015dd19-c404-32d9-8cfc-f1138d36742e",
                        "target_lang_word": "raconteur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raconteur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97b13e08-f5be-3fc6-be3f-519a9a90a5df",
                                        "entry_id": "a9ed691d-32e6-3c4a-890f-786403b56efb",
                                        "glosses": [
                                            "A storyteller, especially a person noted for telling stories with skill and wit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0158857-4ac0-448e-9946-1150dae33896",
                                                "sense_id": "97b13e08-f5be-3fc6-be3f-519a9a90a5df",
                                                "text": "He was tempted to try the last door—to look into the room of evil fame; but he reflected that this would be indiscreet, since Colonel Capadose handled the brush—as a raconteur—with such freedom. There might be a ghost and there might not; but the Colonel himself, he inclined to think, was the most mystifying figure in the house."
                                            },
                                            {
                                                "example_id": "c0cbdc01-eb66-4ce1-86dd-09c416898772",
                                                "sense_id": "97b13e08-f5be-3fc6-be3f-519a9a90a5df",
                                                "text": "It is notoriously possible for the author of a fictitious narrative to become, after a time, unable to distinguish it from a statement of actual facts. There is a case on record in which a learned judge communicated to the Psychical Society in perfect good faith a ghost story, all the principal features of which were proved to be imaginary. They had their origin in his own talent as a distinguished raconteur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raconteur",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f49347e4-06ec-30bd-9391-3744d93f44e2",
                                        "entry_id": "722ee7a7-b38b-3a07-8ec8-e1124bc84565",
                                        "glosses": [
                                            "To make witty remarks or stories."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9b87ac4-6c21-4936-99c3-fbf41013d444",
                                                "sense_id": "f49347e4-06ec-30bd-9391-3744d93f44e2",
                                                "text": "The two of them turn to each other and raise an eyebrow each, their signal to slip into alternating raconteuring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a0f8148-e90d-4dfd-99c0-766fdf1744c3",
                        "source_entry_id": "f8201af4-f46a-340e-b594-b29e95920c45",
