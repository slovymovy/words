                                "target_senses": [
                                    {
                                        "sense_id": "7a0f361b-6dcd-3b10-80d2-ed4c59e5c32b",
                                        "entry_id": "265ce237-623f-3a26-ba14-40b3f4fb3ecf",
                                        "glosses": [
                                            "Qui couvre plusieurs aspects ou domaines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de637355-0e9b-4e2d-aa7f-e4ddc1cef237",
                                                "sense_id": "7a0f361b-6dcd-3b10-80d2-ed4c59e5c32b",
                                                "text": "Puis, sous l'effet combiné d'une reprise dans l’industrie sidérurgique et de la réduction des importations par l’imposition de droits compensateurs, tant aux États-Unis que dans la Communauté européenne, le marché du ferrosilicium s'est redressé au cours du dernier trimestre de 1994."
                                            },
                                            {
                                                "example_id": "37047f44-a2d0-4376-85ee-5954ecbce977",
                                                "sense_id": "7a0f361b-6dcd-3b10-80d2-ed4c59e5c32b",
                                                "text": "« Les résultats ont été répétés dans des contextes et pays si différents que je pense que les preuves combinées commencent à être fortes », estime Lauri Myllyvirta."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "combiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ddecbe9-3a16-347c-8a33-f80b8e77ebb3",
                                        "entry_id": "409b0309-5505-3a05-8444-3a0ed39b258c",
                                        "glosses": [
                                            "Tout corps qui est le résultat d’une combinaison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "438dd9a0-2475-4d35-ae78-9b374328560d",
                                                "sense_id": "4ddecbe9-3a16-347c-8a33-f80b8e77ebb3",
                                                "text": "Un combiné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c7341a7-0576-38dc-bd0a-3d881457fc0c",
                                        "entry_id": "409b0309-5505-3a05-8444-3a0ed39b258c",
                                        "glosses": [
                                            "Partie mobile d’un téléphone réunissant l’écouteur à mettre sur l’oreille et le microphone qui se place devant la bouche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cc06cc8-f362-4571-9789-b46faae2a3af",
                                                "sense_id": "1c7341a7-0576-38dc-bd0a-3d881457fc0c",
                                                "text": "L’après-midi Ghoul Malek me joint au bout du fil. Il est en rogne. Un moment, je me suis attendu à voir sa main surgir du combiné pour me prendre à la gorge."
                                            },
                                            {
                                                "example_id": "7a6ed57b-d865-4d9b-8dbc-d7294a3ef1e3",
                                                "sense_id": "1c7341a7-0576-38dc-bd0a-3d881457fc0c",
                                                "text": "J’attrapai un peignoir et décrochai le combiné fixé au mur, à côté des W-C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeac80d3-c8f8-3391-bd15-c6be7a5fa59f",
                                        "entry_id": "409b0309-5505-3a05-8444-3a0ed39b258c",
                                        "glosses": [
                                            "Par analogie de forme avec le précédent, douchette, pommeau de douche que l'on tient à la main."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a4e20ce-b6ca-32a0-9906-f49501329178",
                                        "entry_id": "409b0309-5505-3a05-8444-3a0ed39b258c",
                                        "glosses": [
                                            "Combiné nordique, discipline réunissant successivement une épreuve de saut à ski et une épreuve de ski de fond."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c7b1cd3-7688-3c54-a97b-f33b83130e62",
                                        "entry_id": "409b0309-5505-3a05-8444-3a0ed39b258c",
                                        "glosses": [
                                            "Combiné alpin, discipline réunissant successivement une épreuve de descente et une épreuve de slalom."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fc2b9a7-d631-34c4-9d77-30386a0a337a",
                                        "entry_id": "409b0309-5505-3a05-8444-3a0ed39b258c",
                                        "glosses": [
                                            "Giravion possédant une voilure tournante d’hélicoptère pour le vol vertical ou stationnaire en plus d’une voilure fixe et d’un propulseur d’avion pour le vol en translation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "combiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87aa9941-888e-3155-8ebb-d4e8fa26c165",
