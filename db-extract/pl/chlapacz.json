                        "glosses": [
                            "ktoś, kto chlapie językiem, mówi byle co"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "597a16a7-a21c-47b5-9b74-8a419ad150bd",
                                "sense_id": "cefd5bba-59cf-383b-a03e-80c9ed0c9054",
                                "text": "Hanka, ja wiem, że ze mnie taki chlapacz jest, że czasami ręce opadają, ale jakby świat był taki pod szyję zapięty, taki zasznurowany jak te twoje cudne usteczka, to ludzkość by się w ogóle nie posuwała"
                            }
