                    {
                        "sense_id": "8307910e-7ed8-3c3f-a0c6-81540483cc78",
                        "entry_id": "4d3661ff-52ec-3d18-8e45-c68c72aea1b7",
                        "glosses": [
                            "Dialecte de l’ancien français parlé par l’aristocratie anglaise à la suite de la conquête de ce pays par les troupes normandes de Guillaume le Conquérant, en 1066."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a1d57080-fbfd-37dd-8aa3-4c990ab5b4db",
                        "entry_id": "4d3661ff-52ec-3d18-8e45-c68c72aea1b7",
                        "glosses": [
                            "Langue ou groupes de dialectes parlés dans les îles Anglo-Normandes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51753f9c-2132-427f-9cbf-bc8ec9e57a70",
                                "sense_id": "a1d57080-fbfd-37dd-8aa3-4c990ab5b4db",
                                "text": "Les dialectologues distinguent habituellement quatre ou cinq zones, où ils tiennent compte des caractéristiques linguistiques et de la présence des superstrats […] 5. l’anglo-normand parlé encore par quelques milliers de personnes dans les îles anglo-normandes de Jersey, Guernesey et Sercq."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "959a10db-cc0b-4a99-b032-b9462380f02c",
                        "source_entry_id": "4d3661ff-52ec-3d18-8e45-c68c72aea1b7",
                        "source_sense_description": "dialecte de l’ancien français",
                        "target_lang_word": "Anglonormannisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anglonormannisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7034b379-3f8b-398a-a545-93000651d572",
                                        "entry_id": "7d719a9c-413e-3859-9b14-83453eb81eec",
                                        "glosses": [
                                            "Sprache, eine Form des Französischen, die seit 1066 in England (von der Oberschicht) gesprochen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0242e330-f7fe-4b40-b1a1-39db90ea43ce",
                                                "sense_id": "7034b379-3f8b-398a-a545-93000651d572",
                                                "text": "„Die in mancher Hinsicht besondere Stellung des Anglonormannischen innerhalb der afrz. Dialekte erfordert einige ergänzende Bemerkungen.“"
                                            },
                                            {
                                                "example_id": "e03a9073-5ea5-4a2b-9919-9c47b0d10cb7",
                                                "sense_id": "7034b379-3f8b-398a-a545-93000651d572",
                                                "text": "„In einer Handschrift des 13. Jhs. […] findet sich, zwischen englischen Statuten und Gesetzestexten, eine Definition der Liebe als manye oder mentis insania, in Latein, Englisch und Anglonormannisch, den drei Sprachen des mittelalterlichen England: […]“"
                                            },
                                            {
                                                "example_id": "7a9808ac-06b5-415a-b5bb-56fb2d207306",
                                                "sense_id": "7034b379-3f8b-398a-a545-93000651d572",
                                                "text": "„Erst die spâte und kurze Hosebonderie von Dunster zeigt jene Besonderheiten, die Anglonormannisch manchmal unzugânglich erscheinen lassen[…]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
