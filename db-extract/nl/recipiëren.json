                                        "sense_id": "f1788542-f659-3b89-8424-f2ec90c8a22c",
                                        "entry_id": "0dd3e362-ae72-3e59-8ef4-8dddf5a4c735",
                                        "glosses": [
                                            "To accept into the mind; to understand."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dfe5c7d-fa2c-484a-a2b3-19e68fc8c2fa",
                                                "sense_id": "f1788542-f659-3b89-8424-f2ec90c8a22c",
                                                "text": "I cannot receive [translating recevoir] that manner, whereby we establish the continuance of our life."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
