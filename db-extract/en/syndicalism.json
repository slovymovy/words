                ],
                "senses": [
                    {
                        "sense_id": "fc87ca04-9c5c-38d7-8ee2-f3643e151644",
                        "entry_id": "98201029-f5c4-3908-bfdc-f72cd032fb40",
                        "glosses": [
                            "Control of both industry and government by labor unions, especially as achieved through revolutionary direct action; advocacy for attempts to bring it about."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8bf4d75-e0e3-462b-8a42-0cfda6cf7185",
                        "source_entry_id": "98201029-f5c4-3908-bfdc-f72cd032fb40",
                        "source_sense_id": "fc87ca04-9c5c-38d7-8ee2-f3643e151644",
                        "source_sense_description": "the belief that capitalism should be replaced with labor unions",
                        "target_lang_word": "syndicalisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syndicalisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2497e540-9dab-35ba-bd02-255e9088e2e6",
                                        "entry_id": "2e4bc5f6-c755-3de4-b118-5da36f06948e",
                                        "glosses": [
                                            "een politieke en economische ideologie die er naar streeft om industrie en regering onder controle van de vakbonden te brengen. De milde versie van het syndicalisme werd in de vroege twintigste eeuw overschaduwd door het revolutionaire anarcho-syndicalisme. Dit was het krachtigst in Spanje maar kwam ook in andere delen van de wereld voor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "beffac1b-eb25-45a5-b891-4f9c3336d16f",
                        "source_entry_id": "98201029-f5c4-3908-bfdc-f72cd032fb40",
                        "source_sense_id": "fc87ca04-9c5c-38d7-8ee2-f3643e151644",
                        "source_sense_description": "the belief that capitalism should be replaced with labor unions",
                        "target_lang_word": "syndicalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syndicalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe389940-8079-3ddb-bcb4-dfc2b4cbe0a3",
                                        "entry_id": "fd7772ad-9d08-3cf7-afb2-5088a6891971",
                                        "glosses": [
                                            "Activisme des syndicats dans lequel des acteurs économiques s’unissent."
                                        ],
                                        "tags": [
                                            "Économie",
                                            "Syndicalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "815c2afc-6f10-410b-bf44-07ab8bf8cbd5",
                                                "sense_id": "fe389940-8079-3ddb-bcb4-dfc2b4cbe0a3",
                                                "text": "Ainsi pourvue d'un statut légal et de moyens financiers, la vulgarisation se développe rapidement, surtout dans la mouvance du syndicalisme, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470de8f8-1174-3e4e-80e1-a1fe054efd05",
                                        "entry_id": "fd7772ad-9d08-3cf7-afb2-5088a6891971",
                                        "glosses": [
                                            "Mouvement social qui vise à unifier les travailleurs dans des syndicats, pour défendre leurs intérêts communs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6e9fc79-acb0-40f7-be5c-0c674dccd49e",
                                                "sense_id": "470de8f8-1174-3e4e-80e1-a1fe054efd05",
                                                "text": "Ainsi on ne pourrait plus contester qu’il y ait une opposition absolue entre le syndicalisme révolutionnaire et l’État ; cette opposition prend en France la forme particulièrement âpre de l’antipatriotisme […]"
                                            },
                                            {
                                                "example_id": "b187746e-5197-4486-abb6-548be31f540c",
                                                "sense_id": "470de8f8-1174-3e4e-80e1-a1fe054efd05",
                                                "text": "Il se peut qu’à l’heure du péril de guerre, le syndicalisme souffrît d’un léger fléchissement."
                                            },
                                            {
                                                "example_id": "5f5bd251-947c-479e-9c91-fc19b94ca323",
                                                "sense_id": "470de8f8-1174-3e4e-80e1-a1fe054efd05",
                                                "text": "Il existait en 1914 trois principaux courants de pensée à la S.F.I.O. : le syndicalisme révolutionnaire, le jaurésisme et le guesdisme. Dans l'entre-deux-guerres, deux de ces courants connaissent une éclipse durable, au profit du troisième."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
