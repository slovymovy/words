                    {
                        "sense_id": "e13236e5-8755-3927-8c3c-a00c9c450bcb",
                        "entry_id": "f377d3b4-78a7-322e-8837-87fd0fb95774",
                        "glosses": [
                            "Règle graduée avec précision, permettant de lire directement les longueurs sur un plan ou une carte, grâce aux graduations correspondant à différentes échelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ca57bf-ff39-4a9e-9f73-52d07fb824a4",
                                "sense_id": "e13236e5-8755-3927-8c3c-a00c9c450bcb",
                                "text": "En posant le calque sur la feuille de papier blanc, il devient très lisible et aisé de faire toutes mesures nécessaires, à condition de connaître l'échelle du dessin et de posséder cette règle triangulaire graduée avec six échelles différentes qui s'appelle un kutch."
                            },
                            {
                                "example_id": "47d908d7-aba4-4790-9e2f-57cfdd1f1eb9",
                                "sense_id": "e13236e5-8755-3927-8c3c-a00c9c450bcb",
                                "text": "Le kutch ou règle d’architecte est une règle à échelle qui permet grâce aux graduations de différentes échelles une lecture et une réalisation rapide des plans en évitant de savants calculs de conversion."
                            }
                        ]
                    }
