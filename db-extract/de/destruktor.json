                    {
                        "translation_id": "91210e5b-dc01-45bd-935e-ea9a4a22e00b",
                        "source_entry_id": "bda3d51b-946d-325e-bc60-ebb1e0540f0d",
                        "source_sense_id": "2468fbd9-1b92-33c9-b80a-69e5dab834ef",
                        "source_sense_description": "Methode, die ein nicht mehr benötigtes Objekt zerstört und damit die Ressourcen wieder freigibt",
                        "target_lang_word": "destructeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "destructeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                        "entry_id": "89e0d0a1-a363-3b0e-9cb8-61b8c5f5b0d0",
                                        "glosses": [
                                            "Personne qui détruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0171db-3a8f-491a-8999-94e9353a06af",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Les grecs furent les destructeurs de Troie."
                                            },
                                            {
                                                "example_id": "9f79c577-f773-4280-aaa5-6576c17e6f39",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Les Huns étaient de grands destructeurs."
                                            },
                                            {
                                                "example_id": "64bf566d-dbac-467f-bfce-b94f32167fc6",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Louis XIV voulut être le destructeur de l’hérésie."
                                            },
                                            {
                                                "example_id": "3a869fb9-fea7-4eec-b7a8-00ba7d7b1897",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Le destructeur des abus."
                                            },
                                            {
                                                "example_id": "c228a671-96dc-406c-a112-d734f87df315",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Cet homme a été, par ses folles dépenses, le destructeur de sa maison."
                                            },
                                            {
                                                "example_id": "19ab33ad-8b96-4abc-b5fa-fe165f35c0be",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Un destructeur comme Luther a plus fondé, c’est-à-dire a jeté plus de formes durables, et a plus donné à la vie subséquente de l’humanité, qu’un fondateur comme Calvin."
                                            },
                                            {
                                                "example_id": "788cbbb8-520c-41e4-a3e5-410874d4c193",
                                                "sense_id": "fff6c1ee-2292-3626-8db6-87cea0b31e84",
                                                "text": "Cette réforme fut la destructrice des lois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2c0a2d-c078-3bae-8a42-83d11ca73924",
                                        "entry_id": "89e0d0a1-a363-3b0e-9cb8-61b8c5f5b0d0",
                                        "glosses": [
                                            "Partie d’un programme qui décrit les actions à exécuter lors de la destruction d’un objet."
                                        ],
                                        "tags": [
                                            "Programmation orientée objet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "840aa4df-e7ca-4792-bbd5-7df29086568f",
                                                "sense_id": "9e2c0a2d-c078-3bae-8a42-83d11ca73924",
                                                "text": "C++ offre un mécanisme très performant pour traiter ces problèmes : le constructeur. Il s’agit d’une fonction membre […] qui sera appelée automatiquement à chaque création d’un objet. […]\nUn objet pourra aussi posséder un destructeur, c’est-à-dire une fonction membre appelée automatiquement au moment de la destruction de l’objet. […]\nPar convention, le constructeur se reconnaît à ce qu’il porte le même nom que la classe.\nQuant au destructeur, il porte le même nom que la classe, précédé d’un tilde (~)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "destructeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                        "entry_id": "8aad2479-6626-3774-b727-c3902448348b",
                                        "glosses": [
                                            "Qui détruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd6122a4-cdef-4455-b635-01432ee231b5",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "Un animal destructeur."
                                            },
                                            {
                                                "example_id": "7810ecd1-f340-447d-924d-c3b16fd6a716",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "Fléau destructeur."
                                            },
                                            {
                                                "example_id": "9769524b-0b5c-4cc6-ba7f-4d39ea0ed376",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "Un système destructeur."
                                            },
                                            {
                                                "example_id": "f5d79d75-bad0-469a-9739-98d741b68495",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "Force destructrice."
                                            },
                                            {
                                                "example_id": "957a8132-4e31-48ce-828e-7e793ee0a896",
                                                "sense_id": "25961b6f-b2af-3ce6-b1a9-5282c2ad480e",
                                                "text": "– Vous êtes d’un naturel destructeur vous. Devriez faire attention, vous pourriez vous blesser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
