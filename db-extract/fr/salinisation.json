                ],
                "senses": [
                    {
                        "sense_id": "84a6f6e8-633f-3737-8649-4c56c3a644d9",
                        "entry_id": "be525045-8eaf-3784-9c40-eeab0ea683f9",
                        "glosses": [
                            "Action de saliniser un sol ou résultat (salinité) de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93633979-eb36-41db-b7cf-fa3aad2c89a1",
                                "sense_id": "84a6f6e8-633f-3737-8649-4c56c3a644d9",
                                "text": "Jugeant cette situation «consternante», cette scientifique déplore le fait que «des projets de développement immobilier sur une petite partie du bord des lacs se traduisent par des risques importants de salinisation de ces étendues d'eau» avec le salage des routes d'accès en hiver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "606b85b5-c62e-48b2-8f9d-15c724c4579a",
                        "source_entry_id": "be525045-8eaf-3784-9c40-eeab0ea683f9",
                        "source_sense_id": "84a6f6e8-633f-3737-8649-4c56c3a644d9",
                        "target_lang_word": "Versalzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Versalzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                                        "entry_id": "93e98db2-f694-3b98-9b30-5a4ec54c2ec0",
                                        "glosses": [
                                            "Erhöhung des Salzgehaltes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8db2d66-2d5d-4118-beaf-eab27bbd5673",
                                                "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                                                "text": "„Mit der Versalzung verlieren die Böden zahlreiche günstige Eigenschaften.“"
                                            },
                                            {
                                                "example_id": "0f04c5d6-9a81-4ec4-9076-95d5015d602b",
                                                "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                                                "text": "„In Australien, dem trockensten Kontinent der Erde, gilt die Versalzung landwirtschaftlicher Äcker bereits als großes Problem.“"
                                            },
                                            {
                                                "example_id": "e1c29f9e-8632-4534-aed8-7c936fb2214c",
                                                "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                                                "text": "„Zur Versalzung des Bodens kommt es in Wüsten- oder Halbwüsten, wo die schnelle Verdunstung des wenigen Grundwassers das gelöste Salz übrig lässt.“"
                                            },
                                            {
                                                "example_id": "bef22e1f-d183-491d-843b-043dd75277bb",
                                                "sense_id": "dbb8528a-26d9-3c8e-9ca4-17e9e5d9f8d0",
                                                "text": "„Weite Gebiete z. B. in Indien, Ägypten, im Irak, aber auch in den USA sind durch Versalzung unfruchtbar geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35a99374-194c-443b-a05b-bbd8feae592c",
                        "source_entry_id": "be525045-8eaf-3784-9c40-eeab0ea683f9",
