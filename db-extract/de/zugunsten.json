                "senses": [
                    {
                        "sense_id": "965e09b8-2be3-313a-9b60-157eef9fe1fe",
                        "entry_id": "b7f81999-b43e-3790-8cb4-5b58f5e7d55f",
                        "glosses": [
                            "En faveur de, au bénéfice de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23c52ed8-8c20-401e-a78f-6c9f736e5149",
                                "sense_id": "965e09b8-2be3-313a-9b60-157eef9fe1fe",
                                "text": "Nach vielen Jahren auf dem Thron dankte der König zugunsten seines Sohnes ab.",
                                "translation": "Après de nombreuses années sur le trône, le roi abdiqua en faveur de son fils."
                            },
                            {
                                "example_id": "92036bf0-5113-4c5f-a7fc-ff30e317e413",
                                "sense_id": "965e09b8-2be3-313a-9b60-157eef9fe1fe",
                                "text": "(...) die funktionierende digitale Vernetzung trägt erheblich zur ukrainischen Gegenwehr bei. Die Bilder und Videos aus den zerbombten Städten fachen die internationale Diskussion an, erhöhen zugunsten der Ukraine den Druck der Öffentlichkeit in den liberalen Demokratien Europas und sickern sogar ins zensierte Russland ein.",
                                "translation": "(...) le la mise en réseau qui fonctionne contribue largement à la résistance ukrainienne. Les images et les vidéos des villes détruites alimentent le débat international, augmentent la pression de l'opinion publique dans les démocraties libérales européennes en faveur de l'Ukraine et s'infiltrent même dans la Russie censurée."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "510919f0-c149-3217-9d79-f609f268a2d5",
                "word": "zugunsten",
                "pos": "prep",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d62ea44-73d5-329f-8f9e-9c9f54e18c45",
                        "entry_id": "510919f0-c149-3217-9d79-f609f268a2d5",
                        "glosses": [
                            "zum Vorteil oder Nutzen von jemandem oder etwas"
                        ],
                        "tags": [
                            "vorangestellt (Präposition) mit Genitiv oder mit von-Erweiterung und Dativ; seltener nachgestellt (Postposition) mit Dativ"
                        ],
                        "examples": [
                            {
                                "example_id": "3fabe0ff-1d8f-4922-99f5-8d07f2d80ada",
                                "sense_id": "6d62ea44-73d5-329f-8f9e-9c9f54e18c45",
                                "text": "Zugunsten meines Freundes habe ich diesmal verzichtet."
                            },
                            {
                                "example_id": "ceeef3a7-ee7f-43de-965b-a75276b1c782",
                                "sense_id": "6d62ea44-73d5-329f-8f9e-9c9f54e18c45",
                                "text": "„Jako aber, der sich bereits als Mann fühlte und ein echtes Jagdmesser am Gürtel trug, verzichtete zugunsten von Bruder und Schwester auf die Leckerei.“"
                            },
                            {
                                "example_id": "5f21732a-d0c5-4a67-ab15-f4bba5f64528",
                                "sense_id": "6d62ea44-73d5-329f-8f9e-9c9f54e18c45",
                                "text": "Meinem Freund zugunsten habe ich diesmal verzichtet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "495162b2-155c-4c9b-9ccd-fd49bfe16d27",
                        "source_entry_id": "510919f0-c149-3217-9d79-f609f268a2d5",
                        "source_sense_id": "6d62ea44-73d5-329f-8f9e-9c9f54e18c45",
                        "source_sense_description": "zum Vorteil oder Nutzen von jemandem oder etwas",
                        "target_lang_word": "in favour of",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in favour of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40915bd9-0882-3a8f-81b8-18f693a62e62",
                                        "entry_id": "10fa6b20-badf-3fe2-a2d5-b84202d736da",
                                        "glosses": [
                                            "Alternative spelling of in favor of."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ec6938c-39bf-4d8a-a888-a1348146df29",
                                                "sense_id": "40915bd9-0882-3a8f-81b8-18f693a62e62",
                                                "text": "With financial losses emerging in 1957, the BTC abandoned the diesel pilot scheme in favour of wholesale orders for untried designs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0c88e63-cd27-48cc-8a68-10d3d186451e",
                        "source_entry_id": "510919f0-c149-3217-9d79-f609f268a2d5",
                        "source_sense_id": "6d62ea44-73d5-329f-8f9e-9c9f54e18c45",
                        "source_sense_description": "zum Vorteil oder Nutzen von jemandem oder etwas",
                        "target_lang_word": "en faveur de",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en faveur de",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b7d8d18-4220-3d44-9cb1-8219fea872a5",
                                        "entry_id": "639b1784-ab46-3295-a8a8-8df50331d38d",
                                        "glosses": [
                                            "En considération d’une chose passée, en vue d’une chose à venir, en considération de quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28faa70e-7add-40d7-88a4-c36173d2364e",
                                                "sense_id": "3b7d8d18-4220-3d44-9cb1-8219fea872a5",
                                                "text": "On lui pardonna en faveur des belles actions qu’il avait faites."
                                            },
                                            {
                                                "example_id": "f57a7358-2de5-4f12-a099-2357fd5bef7e",
                                                "sense_id": "3b7d8d18-4220-3d44-9cb1-8219fea872a5",
                                                "text": "Il a déclaré un tel son héritier en faveur de ce mariage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc33d7f-7345-31e3-a2fe-9e25ece13370",
                                        "entry_id": "639b1784-ab46-3295-a8a8-8df50331d38d",
                                        "glosses": [
                                            "À l’avantage de, au profit de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afea0758-cf24-486f-9d60-7c42d44cc4dc",
                                                "sense_id": "3dc33d7f-7345-31e3-a2fe-9e25ece13370",
                                                "text": "Il s’allongea de nouveau, s’ingéniant à rédiger des clauses testamentaires en faveur d’Edna, pour la plupart, […] et à stipuler divers menus legs, avec des codicilles de plus en plus fantasques et extravagants…."
                                            },
                                            {
                                                "example_id": "96956deb-46ea-414f-a28e-344840c4678c",
                                                "sense_id": "3dc33d7f-7345-31e3-a2fe-9e25ece13370",
                                                "text": "Pour le moment, il y a un argument qui pèse lourd en faveur du monomoteur : les avions monomoteurs sont beaucoup plus rapides que tous les trimoteurs."
                                            },
                                            {
                                                "example_id": "b323eb52-2f7b-4169-8fc3-ea7aa35e1bfa",
                                                "sense_id": "3dc33d7f-7345-31e3-a2fe-9e25ece13370",
                                                "text": "Il a fait son testament en faveur d’untel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21d9816e-69af-3c49-a26e-ec5b11ed1c25",
                                        "entry_id": "639b1784-ab46-3295-a8a8-8df50331d38d",
                                        "glosses": [
                                            "De manière favorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f83e444-c46b-4d1e-a361-5a287daa7d2e",
                                                "sense_id": "21d9816e-69af-3c49-a26e-ec5b11ed1c25",
                                                "text": "Dès les années 1850, l’ingénieur A. Mille prêche inlassablement en faveur du tout-à-l’égout. S’agissant des immondices, il n’a qu'un évangile : il faut « nettoyer dans l’eau, les perdre à l’égout et les restituer à l’agriculture »."
                                            },
                                            {
                                                "example_id": "4b62a3fa-fcac-4afb-bfe2-0ed366edfad0",
                                                "sense_id": "21d9816e-69af-3c49-a26e-ec5b11ed1c25",
                                                "text": "Je voterai en faveur de ce projet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e65653ec-fa1b-3592-b577-2a3a12cc1e45",
                                        "entry_id": "639b1784-ab46-3295-a8a8-8df50331d38d",
                                        "glosses": [
                                            "« Prévenir en faveur de quelqu’un, de quelque chose », En donner d’avance une opinion avantageuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50eb1df-e2b4-493f-a431-eea7575eaaee",
                                                "sense_id": "e65653ec-fa1b-3592-b577-2a3a12cc1e45",
                                                "text": "Ce que vous dites me prévient en faveur de votre méthode."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "en faveur de",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "817e8673-5502-3d34-a9e6-88d806a4ff1d",
                                        "entry_id": "23f88b56-393e-35f0-80dc-95be582ef5f9",
                                        "glosses": [
                                            "Le jugement est en votre faveur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8116efcc-ebb9-3a56-a6ae-8b0c39a907a7",
                                        "entry_id": "23f88b56-393e-35f0-80dc-95be582ef5f9",
                                        "glosses": [
                                            "Je lui parlerai en votre faveur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35bbcd9c-b1e0-3107-9b3c-c4bf07ff6713",
                                        "entry_id": "23f88b56-393e-35f0-80dc-95be582ef5f9",
                                        "glosses": [
                                            "De manière favorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa2a2f1d-d9ba-4f1d-bfe6-9649c2d52be7",
                                                "sense_id": "35bbcd9c-b1e0-3107-9b3c-c4bf07ff6713",
                                                "text": "Cette conduite prévient en sa faveur."
                                            },
                                            {
                                                "example_id": "732f4c50-692b-477a-99f4-16aa7da9e759",
                                                "sense_id": "35bbcd9c-b1e0-3107-9b3c-c4bf07ff6713",
                                                "text": "Il a su les prévenir en ma faveur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1879baff-98e3-4fbb-a712-9cdaf3d5c54d",
                        "source_entry_id": "510919f0-c149-3217-9d79-f609f268a2d5",
                        "source_sense_id": "6d62ea44-73d5-329f-8f9e-9c9f54e18c45",
                        "source_sense_description": "zum Vorteil oder Nutzen von jemandem oder etwas",
                        "target_lang_word": "au profit de",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au profit de",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "124adbb1-e8eb-31d8-a43f-d8feec5b08fd",
                                        "entry_id": "a982e33c-55e6-3b86-879a-f8b2994fca78",
                                        "glosses": [
                                            "Au bénéfice de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a15e81c-c7b7-49df-b645-bd56a14bc9bb",
                                                "sense_id": "124adbb1-e8eb-31d8-a43f-d8feec5b08fd",
                                                "text": "La terre de Saint-Escobille était grevée hypothécairement d’une rente de 800 fr. au profit de l’Hôtel-Dieu de la ville de Dourdan."
                                            },
                                            {
                                                "example_id": "a799e010-042a-4243-a8be-4be5607d4cb5",
                                                "sense_id": "124adbb1-e8eb-31d8-a43f-d8feec5b08fd",
                                                "text": "Il existait en 1914 trois principaux courants de pensée à la S.F.I.O. : le syndicalisme révolutionnaire, le jaurésisme et le guesdisme. Dans l’entre-deux-guerres, deux de ces courants connaissent une éclipse durable, au profit du troisième."
                                            },
                                            {
                                                "example_id": "e337db3d-b475-49f6-a443-e629075e2302",
                                                "sense_id": "124adbb1-e8eb-31d8-a43f-d8feec5b08fd",
                                                "text": "La star internationale, hyperglamour sur les marches du Palais — le 20 mai, aux côtés des deux cinéastes belges et de Fabrizio Rongione — peut-elle encore s’effacer au profit de son personnage ?"
                                            },
                                            {
                                                "example_id": "64362795-cd59-41d8-beea-bef1105a0e43",
                                                "sense_id": "124adbb1-e8eb-31d8-a43f-d8feec5b08fd",
                                                "text": "Favoriser le chêne sessile commence lors des dégagements puis des dépressages et des premières éclaircies qui sont pratiqués le plus possible à son profit."
                                            },
                                            {
                                                "example_id": "98e72cb0-2323-4512-a510-084e106789d5",
                                                "sense_id": "124adbb1-e8eb-31d8-a43f-d8feec5b08fd",
                                                "text": "La seule chose qui avait changé depuis la déségrégation des bus, c’est que la population blanche les avait désertés au profit des voitures particulières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
