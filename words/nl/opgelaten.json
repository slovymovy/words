{
    "word_family": [
        "oplaten"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b22beb4e-62f7-3a5e-a1b8-8e98a87fabec",
                    "sense_definition": "zich ongemakkelijk of beschaamd voelen in een bepaalde situatie, vaak door verlegenheid",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gevoel van ongemak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik voelde me een beetje <w>opgelaten</w> toen iedereen naar me keek tijdens de presentatie.",
                            "target_lang_translations": {
                                "en": "I felt a bit <w>awkward</w> when everyone was looking at me during the presentation."
                            }
                        },
                        {
                            "text": "Er viel een <w>opgelaten</w> stilte nadat hij die ongepaste opmerking had gemaakt.",
                            "target_lang_translations": {
                                "en": "An <w>awkward</w> silence fell after he made that inappropriate remark."
                            }
                        }
                    ],
                    "synonyms": [
                        "beschaamd",
                        "ongemakkelijk",
                        "verlegen",
                        "gegeneerd"
                    ],
                    "common_phrases": [
                        "opgelaten stilte",
                        "zich opgelaten voelen"
                    ],
                    "target_lang_definitions": {
                        "en": "feeling uncomfortable or embarrassed in a certain situation, often due to shyness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "awkward",
                                "target_lang_sense_clarification": "feeling socially uncomfortable or embarrassed"
                            },
                            {
                                "target_lang_word": "self-conscious",
                                "target_lang_sense_clarification": "feeling uneasy because of being observed by others"
                            },
                            {
                                "target_lang_word": "embarrassed",
                                "target_lang_sense_clarification": "feeling shame or self-consciousness"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06df3486-89e7-3603-be14-29ca26027fcc",
                    "sense_definition": "voltooid deelwoord van <w>oplaten</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen hebben gisteren hun vliegers <w>opgelaten</w> op het strand.",
                            "target_lang_translations": {
                                "en": "The children <w>flew</w> their kites on the beach yesterday."
                            }
                        },
                        {
                            "text": "Er werden honderden ballonnen <w>opgelaten</w> tijdens de opening van het nieuwe park.",
                            "target_lang_translations": {
                                "en": "Hundreds of balloons were <w>released</w> during the opening of the new park."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'oplaten' (to let up, to fly, or to release into the air)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flown",
                                "target_lang_sense_clarification": "having sent something like a kite into the air"
                            },
                            {
                                "target_lang_word": "released",
                                "target_lang_sense_clarification": "having let something like a balloon go into the sky"
                            },
                            {
                                "target_lang_word": "launched",
                                "target_lang_sense_clarification": "having sent something up into the air"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}