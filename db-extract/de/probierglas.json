                                                "sense_id": "74759c33-b9fd-3fcb-aa9c-44bd2e16bfdb",
                                                "text": "Éprouvette pour connaître la force de la poudre."
                                            },
                                            {
                                                "example_id": "f1bf0660-789f-4ea5-b481-b0df052118a3",
                                                "sense_id": "74759c33-b9fd-3fcb-aa9c-44bd2e16bfdb",
                                                "text": "Éprouvette de savonnier, de potier."
                                            },
