    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "653f8f9c-5656-3b41-a6e0-a7040e4b4f84",
                "word": "ready-made",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f81468bd-8313-4c84-ab92-db5dfe0cccc9",
                        "entry_id": "653f8f9c-5656-3b41-a6e0-a7040e4b4f84",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more ready-made"
                    },
                    {
                        "form_id": "544edea4-0877-415c-906b-0ee49bfaf8b2",
                        "entry_id": "653f8f9c-5656-3b41-a6e0-a7040e4b4f84",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most ready-made"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08dc11fc-5261-3b60-b054-bbc4d82ef651",
                        "entry_id": "653f8f9c-5656-3b41-a6e0-a7040e4b4f84",
                        "glosses": [
                            "Preexisting or made previously and suitable for use without further preparation or modification; comparable with regard to the amount of preparation required."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8c39895-ba66-4777-ab1c-464b4f2fa40b",
                                "sense_id": "08dc11fc-5261-3b60-b054-bbc4d82ef651",
                                "text": "They used to take a big horse-blanket and sit on the grass a little to the left of the lower end, where there is a dip in the ground, and where the occupied graves stop short and the ready-made ones are not ready. Each well-regulated Indian Cemetery keeps half a dozen graves permanently open for contingencies and incidental wear and tear."
                            },
                            {
                                "example_id": "3f681cd0-6c10-4908-8bb6-033c96bfe2c1",
                                "sense_id": "08dc11fc-5261-3b60-b054-bbc4d82ef651",
                                "text": "Incidentally, they became mindful of the meaning of thrift and waste and learned to practice an economy of material and operations which was not elicited in the play with the more ready-made educational material."
                            },
                            {
                                "example_id": "63811e39-dae5-4fbd-b03f-3e6992be4199",
                                "sense_id": "08dc11fc-5261-3b60-b054-bbc4d82ef651",
                                "text": "1993, Leslie Howard Owens, Commentary to Bill C.Malone, Blacks and Whites and the Music of the Old South, Ted Ownby (editor), Black and White, page 185,\nThe periods of massive revivals, especially the Awakenings, and spiritual movements in Protestant America in general seem the most ready made to attract Africans to Christianity."
                            },
                            {
                                "example_id": "afa07bcf-caf2-4f5b-a660-6efaccc0bdb7",
                                "sense_id": "08dc11fc-5261-3b60-b054-bbc4d82ef651",
                                "text": "The potlatch was perhaps the most ready-made container for explaining the gospel and the kingdom of God, in all its counterintuitiveness, to native people."
                            }
                        ]
                    },
                    {
                        "sense_id": "067fe5d2-d2a8-3c84-8fbf-8734666a7104",
                        "entry_id": "653f8f9c-5656-3b41-a6e0-a7040e4b4f84",
                        "glosses": [
                            "Made in advance to a standard specification."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "700425be-f0ea-4fc1-8685-7d33337dd0e8",
                                "sense_id": "067fe5d2-d2a8-3c84-8fbf-8734666a7104",
                                "text": "During the 1830s and 1840s, ready-made standardized shoes and clothing increasingly challenged the custom-made products of small handicraft workshops."
                            },
                            {
                                "example_id": "bd02670b-386e-4630-9ff3-dc9622aea053",
                                "sense_id": "067fe5d2-d2a8-3c84-8fbf-8734666a7104",
                                "text": "Commercial use of these machines was enhanced by the development of a system of proportional measurements and subsequently of proportional sizes, making feasible ready-made clothing on a mass scale."
                            },
                            {
                                "example_id": "3114a8ec-2b2e-4d57-b2d0-77fa4170457b",
                                "sense_id": "067fe5d2-d2a8-3c84-8fbf-8734666a7104",
                                "text": "The Tees Valley already produces more than 50% of all the hydrogen in the UK so it makes sense to bring it [hydrogen fuelling] here because you've already got a ready-made supply."
                            }
                        ]
                    },
                    {
                        "sense_id": "84fa40a0-67cc-39c6-84e7-9f1a9af43e51",
                        "entry_id": "653f8f9c-5656-3b41-a6e0-a7040e4b4f84",
                        "glosses": [
                            "Made or prepared in advance and used regularly or habitually without original thought."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48b02e1-a2a0-4b3a-900b-ab8ad50faacc",
                                "sense_id": "84fa40a0-67cc-39c6-84e7-9f1a9af43e51",
                                "text": "[…]including both the most everyday and popular, the most ready-made or found objects, the most quotidian of performances."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f53e25cd-0b80-469e-80a7-784bf3031f18",
                        "source_entry_id": "653f8f9c-5656-3b41-a6e0-a7040e4b4f84",
                        "source_sense_description": "made in advance",
                        "target_lang_word": "kant en klaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "88f533e7-1ae7-4ebd-ac44-3b566cbe9f72",
                        "source_entry_id": "653f8f9c-5656-3b41-a6e0-a7040e4b4f84",
                        "source_sense_description": "made in advance",
                        "target_lang_word": "tout fait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tout fait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b838418d-7434-3144-8384-6569f37d669f",
                                        "entry_id": "4e5f38b5-d832-39f2-a52b-0103e8d5d198",
                                        "glosses": [
                                            "Préparé à l’avance ; déjà prêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66a62098-a02c-4518-b39f-282c942072d5",
                                                "sense_id": "b838418d-7434-3144-8384-6569f37d669f",
                                                "text": "Travail tout fait."
                                            },
                                            {
                                                "example_id": "83df60f2-21e1-46c2-a86b-b0a18573cf45",
                                                "sense_id": "b838418d-7434-3144-8384-6569f37d669f",
                                                "text": "La métaphysique ou la critique que le philosophe se réserve de faire, il va les recevoir toutes faites de la science positive, déjà contenues dans les descriptions et les analyses dont il a abandonné au savant tout le souci."
                                            },
                                            {
                                                "example_id": "abb3d0d7-49b9-440a-8c5f-2cc297bba2bc",
                                                "sense_id": "b838418d-7434-3144-8384-6569f37d669f",
                                                "text": "Ses enfants, bien entendu, il vaut mieux se les faire soi-même ; mais quand on attrape la cinquantaine, qu’on n’est pas bien sûr de réussir, et qu’on en trouve un tout fait, eh bien, on se le prend sans avertir les populations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2be7a2b1-295e-37df-b6c6-c7064bfb924b",
                                        "entry_id": "4e5f38b5-d832-39f2-a52b-0103e8d5d198",
                                        "glosses": [
                                            "Qualifie un vêtement de prêt-à-porter, par opposition à sur mesure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db50fd3-727c-40a4-adef-70c985ec6e0b",
                                                "sense_id": "2be7a2b1-295e-37df-b6c6-c7064bfb924b",
                                                "text": "En veston et en pantalon de fantaisie, achetés tout faits chez Lambourdieur."
                                            },
                                            {
                                                "example_id": "625167ac-2553-4633-8a09-5c852ccf2775",
                                                "sense_id": "2be7a2b1-295e-37df-b6c6-c7064bfb924b",
                                                "text": "Costume tout fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "070f5a26-8529-3f6f-acf3-f59d68d64ded",
                                        "entry_id": "4e5f38b5-d832-39f2-a52b-0103e8d5d198",
                                        "glosses": [
                                            "Banal ; commun ; qui est adopté sans examen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67384248-bd84-3034-95bd-ca78604f9643",
                                        "entry_id": "4e5f38b5-d832-39f2-a52b-0103e8d5d198",
                                        "glosses": [
                                            "D’une idée reçue, d’un lieu commun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79c8a545-b3e5-38cb-bafe-4b4e81c2b324",
                                        "entry_id": "4e5f38b5-d832-39f2-a52b-0103e8d5d198",
                                        "glosses": [
                                            "Figé, conventionnel, froid, cliché ou consacré par l’usage et devenu banal, en parlant d’une locution, d’une formule, d’une expression ou d’une formule de politesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034fffe7-522d-4790-8a73-bf1f0c0170d9",
                                                "sense_id": "79c8a545-b3e5-38cb-bafe-4b4e81c2b324",
                                                "text": "N’en pas parler du tout plutôt que d’en parler avec des phrases toutes faites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
