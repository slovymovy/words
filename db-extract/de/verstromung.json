                "senses": [
                    {
                        "sense_id": "d68a12ab-54c1-3946-86b0-fdd47d3a6477",
                        "entry_id": "d9c3e962-e556-391a-8568-317421732bf0",
                        "glosses": [
                            "Umwandlung eines Energieträgers (beispielsweise Kohle oder Biomasse) in Elektrizität"
                        ],
                        "tags": [
                            "Energiewirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "db5b3ae6-0db3-4cf9-a012-c57970db47c1",
                                "sense_id": "d68a12ab-54c1-3946-86b0-fdd47d3a6477",
                                "text": "In Brandenburg möchte eine Bürgerinitiative das verträgliche Ende der Verstromung der Kohle herbeiführen."
                            },
                            {
                                "example_id": "b940278b-8a6e-4acb-a19a-5ac82510baa0",
                                "sense_id": "d68a12ab-54c1-3946-86b0-fdd47d3a6477",
                                "text": "Die derzeitigen Einnahmen aus dem \"Kohlepfennig\" reichen nicht aus, um die Subventionierung der Verstromung deutscher Steinkohle zu decken."
                            },
                            {
                                "example_id": "e986043f-bc58-4ff4-b720-c6b5d439dd36",
                                "sense_id": "d68a12ab-54c1-3946-86b0-fdd47d3a6477",
                                "text": "„Ein wesentlicher Vorteil des Obusses gegenüber einer Umstellung auf Busse mit Verbrennungsmotor war - wie bei der Straßenbahn - die Energieversorgung aus der Verstromung heimischer Kohlevorkommen.“"
                            }
                        ],
