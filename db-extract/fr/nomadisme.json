        "fr-extract.jsonl": [
            {
                "entry_id": "a12152da-41c0-382c-b029-3fbb3fdad0db",
                "word": "nomadisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "94b80a6d-48dc-4d32-8b13-e5be6e9654d6",
                        "entry_id": "a12152da-41c0-382c-b029-3fbb3fdad0db",
                        "tags": [
