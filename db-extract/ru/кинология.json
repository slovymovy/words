                        "translation_id": "41e20a04-e547-4028-973d-9969265ddfee",
                        "source_entry_id": "ace20bde-fddc-3866-8670-aa6626d60736",
                        "source_sense_id": "428c3510-814a-34c1-995b-6384530b7e70",
