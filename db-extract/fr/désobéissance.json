                "senses": [
                    {
                        "sense_id": "e0fb3521-5bfd-32aa-a331-b078ad7f30f5",
                        "entry_id": "70bfe010-f7d0-3838-8598-1bda8ddf853e",
                        "glosses": [
                            "Action de désobéir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27a26039-188d-429e-9343-b43287ce2a91",
                                "sense_id": "e0fb3521-5bfd-32aa-a331-b078ad7f30f5",
                                "text": "Désobéissance à la loi."
                            },
                            {
                                "example_id": "9338a46e-e07b-46b4-977e-4459fb4c2664",
                                "sense_id": "e0fb3521-5bfd-32aa-a331-b078ad7f30f5",
                                "text": "Persister dans la désobéissance."
                            },
                            {
                                "example_id": "2f43cfb9-4317-43e6-b19e-1cf2ffba8a52",
                                "sense_id": "e0fb3521-5bfd-32aa-a331-b078ad7f30f5",
                                "text": "Acte de désobéissance."
                            },
                            {
                                "example_id": "ed0281e6-4727-4df8-87a9-8af6d86c3535",
                                "sense_id": "e0fb3521-5bfd-32aa-a331-b078ad7f30f5",
                                "text": "Tant que la désobéissance est couronnée de succès, je préfère la considérer comme de l'initiative."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9ef6d00-4c43-3bb0-97ad-9acba6a7e79f",
                        "entry_id": "70bfe010-f7d0-3838-8598-1bda8ddf853e",
                        "glosses": [
                            "Habitude de désobéir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dff36d5e-0167-42e0-bbae-8856152a2da9",
                                "sense_id": "e9ef6d00-4c43-3bb0-97ad-9acba6a7e79f",
                                "text": "La désobéissance est le défaut principal de cet enfant."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7f56225-6815-3e28-b158-915fefb0c9f9",
                        "entry_id": "70bfe010-f7d0-3838-8598-1bda8ddf853e",
                        "glosses": [
                            "Acte par lequel on désobéit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e47ccc6-19e9-4c71-862a-92a4663cc76b",
                                "sense_id": "a7f56225-6815-3e28-b158-915fefb0c9f9",
                                "text": "C’est pour une seule désobéissance qu’il a été puni."
                            },
                            {
                                "example_id": "6bd777a0-38d3-479c-aeaa-55d7597b4f03",
                                "sense_id": "a7f56225-6815-3e28-b158-915fefb0c9f9",
                                "text": "Les désobéissances de cet enfant lui attirent de fréquentes punitions."
                            },
                            {
                                "example_id": "c3eb79a2-a1ec-49f3-bb1c-7cfa88845d99",
                                "sense_id": "a7f56225-6815-3e28-b158-915fefb0c9f9",
                                "text": "Le péché est une désobéissance à la loi de Dieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5efd9c6-38a2-4a84-a69b-9cf81d17ce7d",
                        "source_entry_id": "70bfe010-f7d0-3838-8598-1bda8ddf853e",
                        "target_lang_word": "Ungehorsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungehorsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6a11dc0-4553-3cda-aa49-4a943636b419",
                                        "entry_id": "62714696-93d0-33a5-9bde-372a0f80732d",
                                        "glosses": [
                                            "Nichtbefolgung oder Weigerung, eine Verhaltensaufforderung einer Autorität auszuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caff0cd5-65e4-4713-8e3a-ebdf777af173",
                                                "sense_id": "e6a11dc0-4553-3cda-aa49-4a943636b419",
                                                "text": "Früher war es noch gang und gäbe, Kinder bei Ungehorsam zu prügeln."
                                            },
                                            {
                                                "example_id": "a422fa70-4e7d-4718-ade0-b8731c7d570c",
                                                "sense_id": "e6a11dc0-4553-3cda-aa49-4a943636b419",
                                                "text": "„Nach der Niederlage bei Frankenhausen wurden die Heiligenstädter für ihren Ungehorsam schwer bestraft.“"
                                            },
                                            {
                                                "example_id": "7deb83d8-be0d-4357-a65f-d8ee73b2e879",
                                                "sense_id": "e6a11dc0-4553-3cda-aa49-4a943636b419",
                                                "text": "„Aber sein Herz widerstritt, und so galt es denn für ihn, etwas ausfindig zu machen, was Gehorsam und Ungehorsam in sich vereinigte, was dem Befehle seines Königs und dem Befehle seiner eigenen Natur gleichmäßig entsprach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
