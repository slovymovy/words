                "senses": [
                    {
                        "sense_id": "91a87bb4-1b80-3ed4-8af6-db060dd86209",
                        "entry_id": "b9fcc5a4-f8cc-3949-b25e-877639ea3535",
                        "glosses": [
                            "een kamer die wat hoger is gelegen dan de andere vertrekken op dezelfde verdieping"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f6a41b1-795e-41ea-9ae6-fa0e11f31fdd",
                                "sense_id": "91a87bb4-1b80-3ed4-8af6-db060dd86209",
                                "text": "Een bijzondere vondst deden werklieden van bouwbedrijf Maarkel Bouw BV bij de restauratie van de boerderij op erve De Worse, aan de Worsinkweg in Markelo. Bij het slopen van de vloer boven de voormalige opkamer, achter het plafond, kregen zij onverwachts een ‘groet’ uit het verleden."
                            },
                            {
                                "example_id": "81416f10-7403-40a7-96b5-497842fc5692",
                                "sense_id": "91a87bb4-1b80-3ed4-8af6-db060dd86209",
                                "text": "In de opkamer van het J.W. Racerhuis aan de historische Marktstraat staat Hans Krakers even stil. Zijn gedachten dwalen af naar de achttiende eeuw. „Dit”, zegt de oud-voorzitter van de Stichting J.W. Racerhuis, „is de werkkamer geweest van Jan Willem Racer. Hier zat hij, met uitzicht op de tuin en hier werkte hij, waarschijnlijk vaak bij kaarslicht.”"
                            },
                            {
                                "example_id": "d28268b0-934b-4c28-a222-c176391a91b5",
                                "sense_id": "91a87bb4-1b80-3ed4-8af6-db060dd86209",
                                "text": "Het thee- en cadeauwinkeltje is gebouwd in de vroegere opkamer, een hoger gelegen kamer boven de kelder waar vaak de kinderen sliepen. \"Eerst hoorde het kamertje bij het horeca gedeelte. Er stond een tafeltje met twee stoelen,\" zegt Krabbe."
                            }
                        ]
                    }
