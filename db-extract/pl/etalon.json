                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d264391-c827-37a3-9098-e0421cabff3e",
                                        "entry_id": "988c7dec-b767-3544-ba1b-2c1e7802c2ac",
                                        "glosses": [
                                            "künstlich hergestelltes Vergleichsstück zur Definition der Einheit einer physikalischen Größe, indem es selbst diese Größe darstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d7abcc2-7738-4a40-8419-166b119971c5",
                                                "sense_id": "7d264391-c827-37a3-9098-e0421cabff3e",
                                                "text": "„Ursprünglich wurde das Wort im Sinne eines (Normal) Maßstabes benutzt. So ist zum Beispiel das Urmeter ein Etalon. Im übertragenen Sinne nimmt man den Begriff aber auch für andere physikalische Normale und Prototypen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ee31a2a-4834-3d15-ab55-ac43c06cdfdb",
                                        "entry_id": "988c7dec-b767-3544-ba1b-2c1e7802c2ac",
                                        "glosses": [
                                            "künstlich hergestelltes Vergleichsstück zur Definition der Einheit einer physikalischen Größe, indem es verwendet wird, um diese Größe zu produzieren (Messgerät)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0d2c80-adbf-4630-a32d-2a285170174a",
                                                "sense_id": "9ee31a2a-4834-3d15-ab55-ac43c06cdfdb",
                                                "text": "„Die Messung des internationalen Ampere und die Herstellung eines Etalons für das internationale Ohm sind schwierig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
