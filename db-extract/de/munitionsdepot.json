                "senses": [
                    {
                        "sense_id": "80458057-f83e-3fb8-bded-f4a77bc6fc74",
                        "entry_id": "f5c19b56-9aa6-31db-ac28-5004e0ee1c3d",
                        "glosses": [
                            "Lager für die Bevorratung von Munition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6559f60-2130-435d-96a1-c721e472005c",
                                "sense_id": "80458057-f83e-3fb8-bded-f4a77bc6fc74",
                                "text": "Die Terroristen planten einen Angriff auf das Munitionsdepot der Armee."
                            },
                            {
                                "example_id": "925651a6-059d-4ee6-abea-6d9bb0971858",
                                "sense_id": "80458057-f83e-3fb8-bded-f4a77bc6fc74",
                                "text": "„Unser zweites Munitionsdepot ist in die Luft geflogen.“"
                            },
                            {
                                "example_id": "51a3a656-23d8-4896-ba3f-34859bd943b2",
                                "sense_id": "80458057-f83e-3fb8-bded-f4a77bc6fc74",
                                "text": "„Letzterer wurde stärker, als bekannt wurde, dass Polen auf der Westerplatte, einer Halbinsel am Danziger Hafen, ein Munitionsdepot betrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
