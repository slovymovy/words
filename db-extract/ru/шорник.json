                        ]
                    },
                    {
                        "translation_id": "4be0ae12-87b6-4d95-a09c-7b7002583138",
                        "source_entry_id": "65cbffe8-9a12-3200-8059-78bdc3400137",
                        "target_lang_word": "bourrelier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bourrelier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b60852d-4725-3f50-911a-b0af65596b45",
                                        "entry_id": "e4ca9f70-c21e-3c46-b8b0-44c435fc7108",
                                        "glosses": [
                                            "Artisan qui fait les bâts et les harnais des chevaux et des bêtes de somme."
                                        ],
                                        "tags": [
                                            "Bourrellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a19ef29-d335-474b-9afb-2a8603211f1c",
                                                "sense_id": "0b60852d-4725-3f50-911a-b0af65596b45",
                                                "text": "Or. comme le père Rouault allait être forcé de vendre vingt-deux acres de son bien, qu’il devait beaucoup au maçon, beaucoup au bourrelier, que l’arbre du pressoir était à remettre ."
                                            },
                                            {
                                                "example_id": "fb191950-b92a-4151-a875-0b763bdb2e17",
                                                "sense_id": "0b60852d-4725-3f50-911a-b0af65596b45",
                                                "text": "De cette cour, je vois la rue en biais, et je puis dévorer des yeux la devanture du bourrelier, où il y a des tas de houppes et de grelots, des pompons bleus, de grands fouets couleur de cigare et des harnais qui brillent comme de l’or."
                                            },
                                            {
                                                "example_id": "f4b7a203-5d3c-43cf-bce4-ba20b6461dcf",
                                                "sense_id": "0b60852d-4725-3f50-911a-b0af65596b45",
                                                "text": "Le bourrelier Potie, qui tressait des fouets, nous arrêta."
                                            },
                                            {
                                                "example_id": "a65e3bed-7212-4863-9129-1877bb29e8d0",
                                                "sense_id": "0b60852d-4725-3f50-911a-b0af65596b45",
                                                "text": "Au cours d’une de ces chaudes matinées d’été, le bourrelier arriva, haletant, pour prévenir ma mère de l’arrestation d’enfants juifs dans une des écoles de la petite ville proche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "830bca00-bfa5-3378-8469-202c6af15092",
                                        "entry_id": "e4ca9f70-c21e-3c46-b8b0-44c435fc7108",
                                        "glosses": [
                                            "Celui qui tient un magasin ou un atelier de bourrellerie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
