                        ],
                        "form": "élimés"
                    },
                    {
                        "form_id": "d9abf522-2422-4def-a3af-2987f046bcf8",
                        "entry_id": "d3020f1d-5982-3be9-9c95-00bcd58a1dd8",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "élimée"
                    },
                    {
                        "form_id": "bfe91876-d026-4a16-8a3d-9a7d52f75576",
                        "entry_id": "d3020f1d-5982-3be9-9c95-00bcd58a1dd8",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "élimées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7728e11e-196c-3ddd-bea5-704bca3c1b00",
                        "entry_id": "d3020f1d-5982-3be9-9c95-00bcd58a1dd8",
                        "glosses": [
                            "Qualifie une étoffe ou un vêtement en tissu qui a été usé par frottement à force d'avoir été porté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10fc2555-812b-49bc-9a93-037edc85182d",
                                "sense_id": "7728e11e-196c-3ddd-bea5-704bca3c1b00",
                                "text": "Il repéra Decambrais à la table du fond, en cravate et costume sombre, chemise blanche élimée au col, devant deux pichets de vin rouge."
                            },
                            {
                                "example_id": "440a6340-6665-4ae9-9372-7275fbfe31f7",
                                "sense_id": "7728e11e-196c-3ddd-bea5-704bca3c1b00",
                                "text": "Se riant de la liche, il saisit une page du grimoire et la déchira, certain d'avoir découvert le secret. Une nouvelle déchirure apparut dans la cape élimée de la liche."
                            },
                            {
                                "example_id": "6e434dbc-5a6b-4d74-8a4a-80d5b5f71efe",
                                "sense_id": "7728e11e-196c-3ddd-bea5-704bca3c1b00",
                                "text": "On ne voyage pas pour se garnir d'exotisme et d'anecdotes comme un sapin de Noël, mais pour que la route vous plume, vous rince, vous essore, vous rende comme ces serviettes élimées par les lessives qu'on vous tend avec un éclat de savon dans les bordels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b549827-fee2-45fc-bcd8-0a6f00983142",
                        "source_entry_id": "d3020f1d-5982-3be9-9c95-00bcd58a1dd8",
                        "source_sense_id": "7728e11e-196c-3ddd-bea5-704bca3c1b00",
                        "target_lang_word": "threadbare",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "threadbare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0409130a-1d7e-3b59-8041-66062d988f4b",
                                        "entry_id": "cdbbb874-189f-3c57-b1c1-97ef5c3a8a08",
                                        "glosses": [
                                            "Of cloth, clothing, furnishings, etc.: frayed and worn to an extent that the nap is damaged and the warp and weft threads show; shabby, worn-out."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d5742f-bacf-4b16-b271-ce0cdcc9bc27",
                                                "sense_id": "0409130a-1d7e-3b59-8041-66062d988f4b",
                                                "text": "His life vvas nigh vnto deaths dore yplaſte, / And thred-bare cote, and cobled ſhoes hee vvare, […]"
                                            },
                                            {
                                                "example_id": "f921c21a-e37c-481d-89ed-c64ec9c7e06d",
                                                "sense_id": "0409130a-1d7e-3b59-8041-66062d988f4b",
                                                "text": "VVill any Freedom here from you be born, / VVhoſe Cloaths are thred-bare, and vvhoſe Cloaks are torn?"
                                            },
                                            {
                                                "example_id": "6df9cf1b-e006-43d2-9b1c-9cd84f3c13c8",
                                                "sense_id": "0409130a-1d7e-3b59-8041-66062d988f4b",
                                                "text": "We are told, that an ancient tragic poet, to move the pity of his audience for his exiled kings and distressed heroes, used to make the actors represent them in dresses and clothes that were thread-bare and decayed."
                                            },
                                            {
                                                "example_id": "6ca91172-d890-4d00-b1e2-dce45ac8178e",
                                                "sense_id": "0409130a-1d7e-3b59-8041-66062d988f4b",
                                                "text": "No one stops to question the coin of a rich man; but a poor devil cannot pass off either a joke or a guinea, without its being examined on both sides. Wit and coin are always doubted with a threadbare coat."
                                            },
                                            {
                                                "example_id": "baeb83f8-5f38-4a03-98df-636f4938d969",
                                                "sense_id": "0409130a-1d7e-3b59-8041-66062d988f4b",
                                                "text": "Ah! You may look through that shirt till your eyes ache; but you won't find a hole in it, nor a thread-bare place. It's the best he had, and a fine one too."
                                            },
                                            {
                                                "example_id": "7aa9ece5-2275-4e3a-b36e-7b384518f444",
                                                "sense_id": "0409130a-1d7e-3b59-8041-66062d988f4b",
                                                "text": "The shabbiness of these attendants upon shabbiness, the poverty of these insolvent waiters upon insolvency, was a sight to see. Such threadbare coats and trousers, such fusty gowns and shawls, such squashed hats and bonnets, such boots and shoes, such umbrellas and walking-sticks, never were seen in Rag Fair."
                                            },
                                            {
                                                "example_id": "1d74dcc1-bdb1-49e2-8c9e-87fb5f5042c7",
                                                "sense_id": "0409130a-1d7e-3b59-8041-66062d988f4b",
                                                "text": "Unkempt, in threadbare clothes, with holed shoes and sun-cured hide, my costume is permanent: the traveler, the man from far away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a76093a-fc0a-31e8-9449-cab659da957e",
                                        "entry_id": "cdbbb874-189f-3c57-b1c1-97ef5c3a8a08",
                                        "glosses": [
                                            "In poor condition; damaged, shabby; also, poorly equipped or provided for, inadequate, meagre, scanty."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a747fde7-98d7-40d3-be71-fc81a0433209",
                                                "sense_id": "5a76093a-fc0a-31e8-9449-cab659da957e",
                                                "text": "Welth and wyt, I say, be so threde bare worne, / That all is without measure, and fer beyonde the mone."
                                            },
                                            {
                                                "example_id": "0199dc85-b96a-42b5-be65-8a08e342365e",
                                                "sense_id": "5a76093a-fc0a-31e8-9449-cab659da957e",
                                                "text": "From an Underſtanding and a Conſcience, thread-bare and ragged vvith perpetual turning; […]"
                                            },
                                            {
                                                "example_id": "a8b81384-810d-4e1e-af13-19cd80fc89e8",
                                                "sense_id": "5a76093a-fc0a-31e8-9449-cab659da957e",
                                                "text": "Holy Virgin stood in the main Convent of Glatz, in rather a threadbare condition, when the Prussians first approached; the Jesuits, and ardently Orthodox of both sexes, flagitating Heaven and her with their prayers, that she would vouchsafe to keep the Prussians out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21e898cc-aafd-39c2-a31f-4e3953b8f44d",
                                        "entry_id": "cdbbb874-189f-3c57-b1c1-97ef5c3a8a08",
                                        "glosses": [
                                            "Of an argument, excuse, etc.: used so often that it is no longer effective or interesting; banal, clichéd, trite."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f918f6a9-06bd-3398-8869-49a11f4fdc42",
                                        "entry_id": "cdbbb874-189f-3c57-b1c1-97ef5c3a8a08",
                                        "glosses": [
                                            "An argument or assertion with little in the way of substance or supporting evidence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb4fec6-4b81-4ed2-8084-69187d48f4c4",
                                                "sense_id": "f918f6a9-06bd-3398-8869-49a11f4fdc42",
                                                "text": "But with so many tired, lazy callbacks to its own threadbare catalog (including “Love Is Not The Answer,” a watery echo of the epic “I Believe In A Thing Called Love” from 2003’s Permission To Land), Hot Cakes marks the point where The Darkness has stopped cannibalizing the golden age of stadium rock and simply started cannibalizing itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d8545bc-45f3-3a7c-a63d-210bf31d25a8",
                                        "entry_id": "cdbbb874-189f-3c57-b1c1-97ef5c3a8a08",
                                        "glosses": [
                                            "Of a person: wearing clothes of threadbare (sense 1) material; hence, impoverished, poor."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ced808c9-14d0-450b-8704-cb2a260f8317",
                                                "sense_id": "1d8545bc-45f3-3a7c-a63d-210bf31d25a8",
                                                "text": "Be gon, all Honeſty, / Thou fooliſh, ſlender, thredbare, ſtarving thing, be gon!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc498ac1-1407-4596-9203-7a6b4a6e5ab4",
                        "source_entry_id": "d3020f1d-5982-3be9-9c95-00bcd58a1dd8",
                        "source_sense_id": "7728e11e-196c-3ddd-bea5-704bca3c1b00",
                        "target_lang_word": "worn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ead58b5-d2f6-39d4-a6ff-6d0f2c81a4f9",
                                        "entry_id": "e53c4e93-c2e9-37f6-bf10-7210d24dba7e",
                                        "glosses": [
                                            "Damaged and shabby as a result of much use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016532cd-8776-43b0-888e-c00de8b02b1b",
                                                "sense_id": "0ead58b5-d2f6-39d4-a6ff-6d0f2c81a4f9",
                                                "text": "Upon this, an unhappy-looking woman, in a sort of mourning, neat, but sadly worn, hid her face behind a meagre bundle, and was heard to sob."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6f6b3b9-51f2-3f09-8727-e2fbe8d5ce64",
                                        "entry_id": "e53c4e93-c2e9-37f6-bf10-7210d24dba7e",
                                        "glosses": [
                                            "Worn out; exhausted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0d2449-c668-4e30-8738-001ca7e81f73",
                                                "sense_id": "a6f6b3b9-51f2-3f09-8727-e2fbe8d5ce64",
                                                "text": "Preëminently is the Lake District suited for the jaded and worn, who seek in solitude and amidst scenery unmoiled and unsullied by human artifice, refreshment alike of body and spirit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "worn",
                                "target_lang_code": "en",
                                "target_senses": [
