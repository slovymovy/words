                ],
                "senses": [
                    {
                        "sense_id": "99e58678-e7c7-300a-acfa-2df29c3a8a14",
                        "entry_id": "47f649f1-099d-3764-aea5-7a336e50e2e9",
                        "glosses": [
                            "een pessimist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b7d09ee-8273-4e5b-b07d-2eeeb6b2f58d",
                                "sense_id": "99e58678-e7c7-300a-acfa-2df29c3a8a14",
                                "text": "zwartkijkers staan vaak niet volop in het leven."
                            },
                            {
                                "example_id": "ea4a7af9-ecad-4a14-bb9f-44058669c441",
                                "sense_id": "99e58678-e7c7-300a-acfa-2df29c3a8a14",
                                "text": "In Tain l'Hermitage wordt elk jaar zo'n file nagebootst met klassieke voertuigen. Vaak dragen chauffeurs en passagiers kleding uit de jaren vijftig en zestig, terwijl ze begeleid worden door gendarmes in originele uniformen, op klassieke motorfietsen. Van levensader tot nostalgisch themapark, een zwartkijker zou in de Nationale 7 een metafoor voor Frankrijk kunnen zien."
                            }
                        ]
                    },
                    {
                        "sense_id": "349c1434-f3e1-3afe-a0ce-431105ee5415",
                        "entry_id": "47f649f1-099d-3764-aea5-7a336e50e2e9",
                        "glosses": [
                            "iemand die een televisietoestel in huis heeft zonder kijkgeld te betalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f70bda-8e08-478f-b461-6cc425d72daf",
                                "sense_id": "349c1434-f3e1-3afe-a0ce-431105ee5415",
                                "text": "Televisiemaatschappijen krijgen steeds meer te maken met zwartkijkers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be34bd5c-6f91-4203-8737-f8ad03086164",
                        "source_entry_id": "47f649f1-099d-3764-aea5-7a336e50e2e9",
                        "source_sense_id": "99e58678-e7c7-300a-acfa-2df29c3a8a14",
                        "source_sense_description": "pessimist",
                        "target_lang_word": "pessimist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pessimist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efbafcc5-0f9e-3356-b096-cf657be45949",
                                        "entry_id": "aa073281-4a76-3c5e-b068-8b15aa3a24d3",
                                        "glosses": [
                                            "Someone who habitually expects the worst outcome; one who looks on the dark side of things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b15ad7f7-1dd6-462d-a699-cccfbf1b230e",
                                                "sense_id": "efbafcc5-0f9e-3356-b096-cf657be45949",
                                                "text": "I will not marry a pessimist, a born loser, a fellow who has no fight in him."
                                            },
                                            {
                                                "example_id": "6731ccf5-a131-4a56-a759-2d2deae0c888",
                                                "sense_id": "efbafcc5-0f9e-3356-b096-cf657be45949",
                                                "text": "We are becoming as a nation, as a world, indeed, atom-conscious. Many of us are already afflicted with atomphobia, though so far it has manifested itself only in a mirage of autoaeromotive discs and a war of words between chronic optimists and empirical pessimists concerning civilization’s probable future."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
