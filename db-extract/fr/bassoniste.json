                                "target_senses": [
                                    {
                                        "sense_id": "2fbf1432-91ce-3c41-87ef-f72303604190",
                                        "entry_id": "7552c9e3-72a7-3077-84c0-7502694df321",
                                        "glosses": [
                                            "iemand die de fagot bespeelt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab880ca-b992-46bc-89d2-020e757a4346",
                                                "sense_id": "2fbf1432-91ce-3c41-87ef-f72303604190",
                                                "text": "De woedende fagottist gooide zijn blaasinstrument op de grond."
                                            },
                                            {
                                                "example_id": "f1fe03e0-77db-4de3-b856-8d28e644611e",
                                                "sense_id": "2fbf1432-91ce-3c41-87ef-f72303604190",
                                                "text": "De foto’s die Simon van Boxtel exposeert tijdens het Amsterdamse Grachtenfestival dwingen tot langer kijken dan normaal. En tot nadenken. Zoals over de foto van een keurig geklede fagottist met zijn instrument, buiten naast een woeste boomstam. De boom en de fagot zijn alle twee van hout. Het ene is grillige natuur, het andere is een ingenieus gebouwd instrument met veel techniek."
                                            },
                                            {
                                                "example_id": "3bd0cbce-b80a-4fcc-872f-abdd0da883b9",
                                                "sense_id": "2fbf1432-91ce-3c41-87ef-f72303604190",
                                                "text": "Inhoudelijk volgen de scholen onze redenering dat je moet kijken naar aantallen. Bijvoorbeeld: hoeveel fagottisten heb je op je opleiding?"
                                            },
                                            {
                                                "example_id": "7723846b-8e45-41ee-b6b5-c28a858a44bb",
                                                "sense_id": "2fbf1432-91ce-3c41-87ef-f72303604190",
                                                "text": "Dit instrument is voor de jonge aankomende fagottistjes een opstap naar een groter instrument."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "521c8fc2-1574-47e2-8786-5bb8216635ae",
                        "source_entry_id": "9bb55cf8-7433-3d9c-95a0-e683c9b16b50",
                        "source_sense_id": "c903d104-72dc-3e57-8a65-31376afc9a0b",
                        "target_lang_word": "фаготист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фаготист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "47a2ae7a-6dd8-3788-8845-405d4131d187",
                                        "entry_id": "1131ce53-be3c-30fa-8d0c-b0e1deddb348",
                                        "glosses": [
                                            "муз. музыкант, играющий на фаготе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "521f7221-0cc6-47dd-9409-5d0832358af7",
                                                "sense_id": "47a2ae7a-6dd8-3788-8845-405d4131d187",
                                                "text": "Кроме того, с предприимчивым директором театра прибыли балетная труппа и полный оркестр: .. известные музыканты: Миллер — первая скрипка, Зук — флейтраверсист, Паульсен и Венд — гобоисты, Феррандини и Климпе — контрабасисты, Дрейвер, Герке, Ратгебер, Шпринк — скрипачи; Герман и Рудольф — фаготисты, Фукс и Фишер — волторнисты; Блашке — виолончелист и, наконец, знаменитый кларнетист Дерфельд."
                                            },
                                            {
                                                "example_id": "adcd822e-9af6-415f-bc4a-9a204f4c09b4",
                                                "sense_id": "47a2ae7a-6dd8-3788-8845-405d4131d187",
                                                "text": "На конкурсе фаготистов лучше других играл еврей Хойпин и был признан комиссией достойным приёма в оркестр."
                                            },
                                            {
                                                "example_id": "67c5f4dc-8c90-4d86-b7d9-0a3ae6fa0b02",
                                                "sense_id": "47a2ae7a-6dd8-3788-8845-405d4131d187",
                                                "text": "Павел Савельев — фаготист и Пётр Ткаченко — тромбонист недавно приняты в оркестр Большого театра Союза ССР."
                                            },
                                            {
                                                "example_id": "1252836f-43e6-411c-89ac-5341463eea9c",
                                                "sense_id": "47a2ae7a-6dd8-3788-8845-405d4131d187",
                                                "text": "Московский оркестр филармонии играл очень стройно и чисто. Сильна ударная группа, великолепный фаготист и вообще духовые."
                                            },
                                            {
                                                "example_id": "ad06feff-a9a3-4d1f-baa8-6fa7df11fc06",
                                                "sense_id": "47a2ae7a-6dd8-3788-8845-405d4131d187",
                                                "text": "Вечером приезжал в школу ещё раз — слушать концерт двух учеников Свирского и фаготиста."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
