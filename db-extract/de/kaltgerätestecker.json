                "senses": [
                    {
                        "sense_id": "c74cf506-c242-3a1d-b939-086889845de8",
                        "entry_id": "9100d4a0-77db-3bb6-a369-979d65cf87ae",
                        "glosses": [
                            "Stecker für Geräte, die bei Benutzung nur wenig Wärme entwickeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77183739-1c6d-4c23-ab3a-89299f779ef8",
                                "sense_id": "c74cf506-c242-3a1d-b939-086889845de8",
                                "text": "„Auch locker sitzende Kaltgerätestecker am Monitor oder am Computer waren schon die Ursache für solche Fehler.“"
                            },
                            {
                                "example_id": "83cb13e9-2f64-454d-a0ac-8cddf70005b4",
                                "sense_id": "c74cf506-c242-3a1d-b939-086889845de8",
                                "text": "„Über dem Anschluss für den Kaltgerätestecker befindet sich der Hauptschalter.“"
                            },
                            {
                                "example_id": "24786b0e-271d-4c7d-9d29-1e0cec910896",
                                "sense_id": "c74cf506-c242-3a1d-b939-086889845de8",
                                "text": "„Der zweite Blick gilt dem Netzkabel, denn selbst erfahrene Anwender bringen es mitunter fertig, den Kaltgerätestecker am Netzteil nicht richtig einzustecken, was zuweilen auch etwas schwer geht, sodass der Stecker dann nur lose in der Buchse sitzt und sich kein richtiger Kontakt ergeben kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
