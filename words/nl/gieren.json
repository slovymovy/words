                                "target_lang_sense_clarification": "of the wind"
                            },
                            {
                                "target_lang_word": "roar",
                                "target_lang_sense_clarification": "of the wind"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "hurler",
                                "target_lang_sense_clarification": "en parlant du vent"
                            },
                            {
                                "target_lang_word": "siffler",
                                "target_lang_sense_clarification": "en parlant du vent"
                            },
                            {
                                "target_lang_word": "mugir",
                                "target_lang_sense_clarification": "en parlant du vent ou de la tempête"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f99f7da-413b-3d6c-9fae-10c959b5cba0",
                    "sense_definition": "heel hard en onbeheerst lachen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>giert</w> van het lachen om die grappige film.",
                            "target_lang_translations": {
