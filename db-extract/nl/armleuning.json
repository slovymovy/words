                "senses": [
                    {
                        "sense_id": "878459b9-45b2-3cc7-84b3-47574693c8b0",
                        "entry_id": "584eb67a-ccb7-3f0e-969f-90876fc578b5",
                        "glosses": [
                            "deel van een meubelstuk (vooral een stoel of een bank) waarop men de arm kan laten rusten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8366cb33-691c-4591-a5cc-db2b96788237",
                                "sense_id": "878459b9-45b2-3cc7-84b3-47574693c8b0",
                                "text": "Een stoel met armleuning."
                            },
                            {
                                "example_id": "fed92e55-7e68-40d2-a9e7-f59d86f0bb2f",
                                "sense_id": "878459b9-45b2-3cc7-84b3-47574693c8b0",
                                "text": "Koning Palet zweeg een ogenblik. Zijn handen lagen naast hem op de armleuningen van de Troon. 'Toch,' zei hij, 'willen wij hem een eind op weg helpen. Daarom vraag ik vrijwilligers om met hem mee te gaan naar de plaats die wij kennen als de Tweesprong.'"
                            },
                            {
                                "example_id": "dfbaa22e-1ff7-419a-bad7-83dfe8709020",
                                "sense_id": "878459b9-45b2-3cc7-84b3-47574693c8b0",
                                "text": "Irad pakte de fleecedeken die over de armleuning hing en legde die over haar heen."
                            },
                            {
                                "example_id": "0b833849-3d3d-475e-a62c-b52beb90b6d1",
                                "sense_id": "878459b9-45b2-3cc7-84b3-47574693c8b0",
                                "text": "'Well, daar zijn we dan,'constateerde hij een beetje overbodig terwijl hij plaatsnam in een van de rare bamboefauteuils en zijn ene been over de armleuning gooide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cd65b6a-f6ee-4b93-b652-23822d21e708",
                        "source_entry_id": "584eb67a-ccb7-3f0e-969f-90876fc578b5",
                        "source_sense_id": "878459b9-45b2-3cc7-84b3-47574693c8b0",
                        "target_lang_word": "Armlehne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armlehne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                        "entry_id": "f535a232-31c0-31dc-8b42-445dc2afb2b0",
                                        "glosses": [
                                            "Ablagefläche am linken und rechten Rand eines Stuhles, Sessels oder Ähnlichem, die zum Abstützen der Arme dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310164c1-1ca4-4949-950b-8eacb957e5b9",
                                                "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                                "text": "„Die Mittelkonsole wurde überarbeitet und eine elektrische Parkbremse schafft Platz für eine neue Armlehne mit Stauraum.“"
                                            },
                                            {
                                                "example_id": "16d96abe-b363-477d-b7bf-cc07f3ab4e9c",
                                                "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                                "text": "„Gabi setzt sich neben mich auf die Armlehne und schaut mich an.“"
                                            },
                                            {
                                                "example_id": "ef5a9368-009f-4454-9fb9-ab3a2b073e8a",
                                                "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                                "text": "„Er fegt meine Jacke vom benachbarten Stuhl, setzt sich hin und nimmt sofort die Armlehne in Beschlag.“"
                                            },
                                            {
                                                "example_id": "dbd41bfc-8ef1-44ee-abb4-37a853698c8a",
                                                "sense_id": "2f821057-317a-358d-9b3e-49a0e7c9c22a",
                                                "text": "„Seine Frau kam um die Sitzgruppe herum und setzte sich zu ihrem Mann auf die Armlehne seines Sessels.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f74e080-ef11-4ef0-86b1-f5e520400c06",
                        "source_entry_id": "584eb67a-ccb7-3f0e-969f-90876fc578b5",
