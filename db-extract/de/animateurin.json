                        "entry_id": "43b96fc7-9cd8-36a3-aed9-950a455322c6",
                        "glosses": [
                            "weibliche Person, die professionell Menschen zu unterhaltenden und entspannenden Aktivitäten ermuntert und anleitet, auch selber unterhält"
                        ],
                        "tags": [
                            "Beruf",
                            "Tourismus"
                        ],
                        "examples": [
                            {
                                "example_id": "ae062136-9b9c-497c-b6e4-6abeb00e5195",
                                "sense_id": "3931f974-2402-379a-b63f-bb8d09d35301",
                                "text": "Unsere Animateurin hat uns gezeigt, wie Strandsegeln funktioniert."
                            },
                            {
                                "example_id": "ad7073e6-3a84-42fb-9e92-2a5019e36a8e",
                                "sense_id": "3931f974-2402-379a-b63f-bb8d09d35301",
                                "text": "„Melanie H. war vor drei Jahren in der Hauptsaison von Juli bis November als Animateurin in einem Club in Tunesien und hatte dort, wo andere Urlaub machen, einen 15-Stunden-Arbeitstag.“"
                            }
                        ],
