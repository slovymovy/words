                "senses": [
                    {
                        "sense_id": "e1504b09-f7bb-3f0d-bd8f-55808fedc5b8",
                        "entry_id": "ff7aa9c8-2bbe-3292-a63c-472274558410",
                        "glosses": [
                            "Qui permet de laisser glisser les liquides au lieu de les absorber."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85ca74ed-7294-4d7f-9280-ad1966f19e56",
                                "sense_id": "e1504b09-f7bb-3f0d-bd8f-55808fedc5b8",
                                "text": "Des milliers de gouttes continuent de dégouliner sur les feuilles déperlantes pour terminer leur course folle au sol ou sur ma tête, pendant encore un long moment après l'accalmie."
                            },
                            {
                                "example_id": "6d853bf0-f2ba-47b5-93b4-7806a5b186b9",
                                "sense_id": "e1504b09-f7bb-3f0d-bd8f-55808fedc5b8",
                                "text": "Il faut du savoir-faire pour filer ses courtes fibres, mais c'est ensuite que ce matériau révèle toutes ses vertus : on peut en faire des tissus légers, résistants et perméables à l'air, naturellement déperlants qui plus est."
                            },
                            {
                                "example_id": "dc5245fa-726a-4f70-b6af-067113fd246d",
                                "sense_id": "e1504b09-f7bb-3f0d-bd8f-55808fedc5b8",
                                "text": "Et astuce ménagère, pour éviter les traces de calcaire sur les vitres, le transporteur utilise une eau adoucie et des produits déperlants."
                            }
                        ]
                    }
                ],
