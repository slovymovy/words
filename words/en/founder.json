{
    "word_family": [
        "found",
        "foundation",
        "foundational",
        "founding",
        "foundry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b2c287a6-3850-34bf-8b46-dbb17d649543",
                    "sense_definition": "A person who establishes or creates an organization, company, or institution.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>founder</w> of the company gave a speech at the anniversary party.",
                            "target_lang_translations": {
                                "ru": "<w>Основатель</w> компании выступил с речью на юбилейной вечеринке."
                            }
                        },
                        {
                            "text": "She is a startup <w>founder</w> who recently secured funding for her new app.",
                            "target_lang_translations": {
                                "ru": "Она — <w>основательница</w> стартапа, которая недавно получила финансирование для своего нового приложения."
                            }
                        }
                    ],
                    "synonyms": [
                        "creator",
                        "establisher",
                        "originator"
                    ],
                    "common_phrases": [
                        "startup founder",
                        "company founder",
                        "co-founder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который основывает или создает организацию, компанию или учреждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основатель",
                                "target_lang_sense_clarification": "тот, кто положил начало чему-либо"
                            },
                            {
                                "target_lang_word": "учредитель",
                                "target_lang_sense_clarification": "официальное лицо, создающее организацию"
                            },
                            {
                                "target_lang_word": "основоположник",
                                "target_lang_sense_clarification": "создатель учения или направления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbe8bb87-36b0-336b-8328-9fbba4b2f812",
                    "sense_definition": "One of the people who helped to establish the United States government.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creator",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Founders</w> debated the structure of the new government for many months.",
                            "target_lang_translations": {
                                "ru": "<w>Отцы-основатели</w> много месяцев обсуждали структуру нового правительства."
                            }
                        },
                        {
                            "text": "Many political arguments today refer back to the original intent of the <w>Founders</w>.",
                            "target_lang_translations": {
                                "ru": "Многие политические споры сегодня отсылают к первоначальным намерениям <w>отцов-основателей</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Founding Father"
                    ],
                    "common_phrases": [
                        "the Founders"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specifically used in the context of United States history"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из людей, участвовавших в создании правительства Соединенных Штатов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отцы-основатели",
                                "target_lang_sense_clarification": "политические деятели, создавшие США"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fed9319-089b-3d29-88cb-8146dff2cccb",
                    "sense_definition": "A common ancestor of a specific population, often used in genetics.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>founder</w> effect occurs when a small group starts a new population.",
                            "target_lang_translations": {
                                "ru": "Эффект <w>основателя</w> возникает, когда небольшая группа дает начало новой популяции."
                            }
                        },
                        {
                            "text": "Scientists traced the genetic mutation back to a single <w>founder</w> individual.",
                            "target_lang_translations": {
                                "ru": "Ученые проследили генетическую мутацию до одной особи-<w>основателя</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ancestor",
                        "progenitor"
                    ],
                    "common_phrases": [
                        "founder effect",
                        "founder population",
                        "founder mutation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Technical usage in biology and genetics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий предок конкретной популяции, часто используется в генетике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основатель",
                                "target_lang_sense_clarification": "предок популяции в генетике"
                            },
                            {
                                "target_lang_word": "родоначальник",
                                "target_lang_sense_clarification": "лицо, от которого ведет начало род"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8860939a-0903-30da-b8a2-d2ba3090428f",
                    "sense_definition": "A person who casts metal in a foundry.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metalwork",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master <w>founder</w> carefully poured the molten bronze into the mold.",
                            "target_lang_translations": {
                                "ru": "Мастер-<w>литейщик</w> осторожно разлил расплавленную бронзу по формам."
                            }
                        },
                        {
                            "text": "He worked as a <w>founder</w> of bells for over forty years.",
                            "target_lang_translations": {
                                "ru": "Он проработал <w>литейщиком</w> колоколов более сорока лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "caster",
                        "metalworker"
                    ],
                    "common_phrases": [
                        "bell founder",
                        "type founder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который занимается отливкой металла на литейном производстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "литейщик",
                                "target_lang_sense_clarification": "рабочий, занимающийся литьем"
                            },
                            {
                                "target_lang_word": "плавильщик",
                                "target_lang_sense_clarification": "специалист по плавке металла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "105910b9-744f-3fd6-939d-3f0473afb42c",
                    "sense_definition": "A serious condition in horses involving inflammation of the hooves.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "veterinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse developed <w>founder</w> after eating too much rich spring grass.",
                            "target_lang_translations": {
                                "ru": "У лошади развился <w>ламинит</w> после того, как она съела слишком много сочной весенней травы."
                            }
                        },
                        {
                            "text": "Severe <w>founder</w> can lead to permanent lameness in a pony.",
                            "target_lang_translations": {
                                "ru": "Тяжелое <w>воспаление копыта</w> может привести к постоянной хромоте у пони."
                            }
                        }
                    ],
                    "synonyms": [
                        "laminitis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезное заболевание лошадей, связанное с воспалением копыт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ламинит",
                                "target_lang_sense_clarification": "ветеринарный термин для воспаления копыта"
                            },
                            {
                                "target_lang_word": "опой",
                                "target_lang_sense_clarification": "народное название ревматического воспаления копыт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04ad69d5-5492-3b51-afd1-92ce2516f8f6",
                    "sense_definition": "To fail completely or break down.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peace talks began to <w>founder</w> over the issue of border control.",
                            "target_lang_translations": {
                                "ru": "Мирные переговоры начали <w>заходить в тупик</w> из-за вопроса о пограничном контроле."
                            }
                        },
                        {
                            "text": "Their marriage <w>foundered</w> after years of constant arguments.",
                            "target_lang_translations": {
                                "ru": "Их брак <w>распался</w> после многих лет постоянных ссор."
                            }
                        }
                    ],
                    "synonyms": [
                        "fail",
                        "collapse",
                        "miscarry"
                    ],
                    "antonyms": [
                        "ruiner"
                    ],
                    "common_phrases": [
                        "founder on",
                        "begin to founder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерпеть полную неудачу или разрушиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потерпеть неудачу",
                                "target_lang_sense_clarification": "провалиться, не увенчаться успехом"
                            },
                            {
                                "target_lang_word": "развалиться",
                                "target_lang_sense_clarification": "о планах или отношениях"
                            },
                            {
                                "target_lang_word": "рухнуть",
                                "target_lang_sense_clarification": "о надеждах или переговорах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa5f53a4-a1ad-3f2d-8f87-59f13fad9c42",
                    "sense_definition": "To fill with water and sink, usually referring to a ship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat began to <w>founder</w> in the heavy seas.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка начала <w>тонуть</w> в бурном море."
                            }
                        },
                        {
                            "text": "The crew abandoned the ship before it could <w>founder</w> completely.",
                            "target_lang_translations": {
                                "ru": "Экипаж покинул судно до того, как оно смогло полностью <w>затонуть</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sink",
                        "submerge"
                    ],
                    "common_phrases": [
                        "founder at sea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполниться водой и затонуть (обычно о судне)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затонуть",
                                "target_lang_sense_clarification": "пойти ко дну"
                            },
                            {
                                "target_lang_word": "идти ко дну",
                                "target_lang_sense_clarification": "начинать тонуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7147160-0737-3e1d-aee0-2cfbc6abfd0e",
                    "sense_definition": "To stumble, fall, or become lame.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse <w>foundered</w> on the rocky path and could not continue.",
                            "target_lang_translations": {
                                "ru": "Лошадь <w>споткнулась</w> на каменистой тропе и не смогла идти дальше."
                            }
                        },
                        {
                            "text": "He felt his legs <w>founder</w> under the weight of the heavy pack.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал, как его ноги <w>подкашиваются</w> под тяжестью тяжелого рюкзака."
                            }
                        }
                    ],
                    "synonyms": [
                        "stumble",
                        "trip",
                        "collapse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Споткнуться, упасть или охрометь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спотыкаться",
                                "target_lang_sense_clarification": "запинаться при движении"
                            },
                            {
                                "target_lang_word": "подкашиваться",
                                "target_lang_sense_clarification": "о ногах, теряющих опору"
                            },
                            {
                                "target_lang_word": "хромать",
                                "target_lang_sense_clarification": "становиться ламым"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}