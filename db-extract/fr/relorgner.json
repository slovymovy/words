                        "glosses": [
                            "Lorgner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8481c643-52f2-470f-a292-e7f6ab88dd21",
                                "sense_id": "7dee7f95-70af-36b7-8a70-886bae99f7e1",
                                "text": "Mais par la même occasion — le Dr Pardoner relorgnait du côté du plafond — le Dr Lambert et moi-même, nous nous sommes livrés à une petite enquête… policière(!) discrète…"
                            },
                            {
                                "example_id": "5a3bbcf4-8328-42a4-a092-8fa960fd583b",
                                "sense_id": "7dee7f95-70af-36b7-8a70-886bae99f7e1",
                                "text": "A la longue, un peu dépité je me suis mis à relorgner sans grande conviction vers les modèles récents…mais vraiment sans grande conviction."
                            }
                        ]
                    }
