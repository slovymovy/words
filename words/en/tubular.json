                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chair was made from lightweight <w>tubular</w> steel.",
                            "target_lang_translations": {
                                "nl": "De stoel was gemaakt van lichtgewicht <w>buisvormig</w> staal."
                            }
                        },
                        {
                            "text": "She bought a set of <w>tubular</w> bells to add sound effects to the music.",
                            "target_lang_translations": {
                                "nl": "Ze kocht een set <w>buisklokken</w> om geluidseffecten aan de muziek toe te voegen."
                            }
                        }
                    ],
                    "synonyms": [
