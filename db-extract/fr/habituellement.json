        "fr-extract.jsonl": [
            {
                "entry_id": "715c56e5-41a9-3024-8b13-312e53810a67",
                "word": "habituellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a51b826-f0f0-3795-98b6-93bb66507f6b",
                        "entry_id": "715c56e5-41a9-3024-8b13-312e53810a67",
                        "glosses": [
                            "D’habitude ; d’ordinaire ; d’une manière habituelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b2dd38-538e-4355-b8e7-6698587bc640",
                                "sense_id": "3a51b826-f0f0-3795-98b6-93bb66507f6b",
                                "text": "Les places et les rues attenantes, habituellement si solitaires dès que neuf heures sonnaient à Saint-Germain-l’Auxerrois, étaient, quoiqu’il fût minuit, encombrées de populaire."
                            },
                            {
                                "example_id": "0f9b4655-2ff3-4aed-b5d2-dae8d587e703",
                                "sense_id": "3a51b826-f0f0-3795-98b6-93bb66507f6b",
                                "text": "M. Berteaux. — Messieurs, cette année le 14 juillet tombe un dimanche, et cette coïncidence prive d'un jour de congé un grand nombre de personnes qui en bénéficiaient habituellement à l'occasion de la fête nationale."
                            },
                            {
                                "example_id": "94b5a5f9-9d43-43e2-8152-5c85bc8bb93a",
                                "sense_id": "3a51b826-f0f0-3795-98b6-93bb66507f6b",
                                "text": "De même, le cahier des charges a été ouvert pour intégrer la syrah, adoptée habituellement dans le sud de la France."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab253dd2-5a4b-4604-ab0a-bd5ea40758bc",
                        "source_entry_id": "715c56e5-41a9-3024-8b13-312e53810a67",
                        "source_sense_id": "3a51b826-f0f0-3795-98b6-93bb66507f6b",
                        "target_lang_word": "gewöhnlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gewöhnlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "so, wie unter diesen Umständen meist oder immer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73cc8492-2ee0-4285-b949-487c64a94afa",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Sie antwortete wie gewöhnlich."
                                            },
                                            {
                                                "example_id": "4b933060-adcc-45a2-9f3f-100af430f620",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Für gewöhnlich sind sie pünktlich."
                                            },
                                            {
                                                "example_id": "ff0e8436-8d02-4b12-b2a3-b4d4f45e846d",
                                                "sense_id": "d90e5ab9-0a36-35e1-973f-6ba68f210cf6",
                                                "text": "Das ist ein für eine Mutter ganz gewöhnliches Verhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "keine besonderen Merkmale aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d429e30e-a582-450e-8487-c0737079b56d",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "Wir alle sind gewöhnliche Sterbliche."
                                            },
                                            {
                                                "example_id": "1e2a1a3a-3c38-4563-a88d-a12abe3c3e0a",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "Wie kann aus einem ganz gewöhnlichen Menschen plötzlich ein Verbrecher werden?"
                                            },
                                            {
                                                "example_id": "ce71aafb-f960-437f-9e03-a8a53156196b",
                                                "sense_id": "4c1b6de5-e564-3994-bb36-33df2746ea3a",
                                                "text": "„Schließlich waren die Richter des Athener Gerichts, der Heliaia ebenso wie die Teilnehmer an der Volksversammlung keine Rechtsexperten, sondern gewöhnliche Bürger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                        "entry_id": "d64866d2-e272-357d-aea8-9062249b5f69",
                                        "glosses": [
                                            "von niederer Erziehung seiend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c3e45ea-74df-413e-b214-62f71fff0413",
                                                "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                                "text": "Das Benehmen dieses Kerls ist mir zu gewöhnlich (= zu unfein, grob)."
                                            },
                                            {
                                                "example_id": "860e7544-33e3-442d-a3ed-bf581b6eb6f4",
                                                "sense_id": "31287f72-57d0-3dfa-9237-a9cff7619999",
                                                "text": "Er hat gar zu gewöhnliche Manieren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a254878-09cf-400e-aa71-846afd78fd3d",
                        "source_entry_id": "715c56e5-41a9-3024-8b13-312e53810a67",
                        "source_sense_id": "3a51b826-f0f0-3795-98b6-93bb66507f6b",
                        "target_lang_word": "usually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb78c03-999e-3cff-ac69-65cdbe5f5d58",
                                        "entry_id": "bcf8a114-78df-30a5-aa3e-7e36dd637ce8",
                                        "glosses": [
                                            "Most of the time; less than always, but more than occasionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e958f07-9355-478e-a378-1ff94306a9e3",
                                                "sense_id": "6bb78c03-999e-3cff-ac69-65cdbe5f5d58",
                                                "text": "Except for one or two days a year, he usually walks to work."
                                            },
                                            {
                                                "example_id": "99b2aa89-3040-4c42-ab4e-38e00e966efb",
                                                "sense_id": "6bb78c03-999e-3cff-ac69-65cdbe5f5d58",
                                                "text": "He and Gerald usually challenged the rollers in a sponson canoe when Gerald was there for the weekend ; or, when Lansing came down, the two took long swims seaward or cruised about in Gerald's dory, clad in their swimming-suits; and Selwyn's youth became renewed in a manner almost ridiculous,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552ad584-410f-3d1a-8395-c0571badc9ed",
                                        "entry_id": "bcf8a114-78df-30a5-aa3e-7e36dd637ce8",
                                        "glosses": [
                                            "Under normal conditions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fb930a8-a946-487f-b84e-0b46f031d2c0",
                        "source_entry_id": "715c56e5-41a9-3024-8b13-312e53810a67",
                        "source_sense_id": "3a51b826-f0f0-3795-98b6-93bb66507f6b",
                        "target_lang_word": "typically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48b74561-9749-3e8a-9941-32c375ce82c1",
                                        "entry_id": "ae97d92e-2877-3e6d-9d9b-65465b99bd87",
                                        "glosses": [
                                            "In a typical or common manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "778a4eb1-606e-4b58-9c0b-cd2d31772733",
                                                "sense_id": "48b74561-9749-3e8a-9941-32c375ce82c1",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic[…]real kidneys[…]. But they are nothing like as efficient, and can cause bleeding, clotting and infection—not to mention inconvenience for patients, who typically need to be hooked up to one three times a week for hours at a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac8294e-e18a-3565-ba2a-ccf66de6e46c",
                                        "entry_id": "ae97d92e-2877-3e6d-9d9b-65465b99bd87",
                                        "glosses": [
                                            "In an expected or customary manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37acb021-f98b-4ec5-a5db-2160778b625b",
                                                "sense_id": "9ac8294e-e18a-3565-ba2a-ccf66de6e46c",
                                                "text": "And Netherlands, backed by a typically noisy and colourful travelling support, started the second period in blistering fashion and could have had four goals within 10 minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eb2a715-299d-4be8-920e-f49db6421615",
                        "source_entry_id": "715c56e5-41a9-3024-8b13-312e53810a67",
                        "source_sense_id": "3a51b826-f0f0-3795-98b6-93bb66507f6b",
