{
    "word_family": [
        "rejoinder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "64d08a4b-e162-379e-9ef6-fc0eb4dd6f6d",
                    "sense_definition": "To return to the company or presence of someone or a group.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "return_to_company",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a brief phone call outside and quickly returned to <w>rejoin</w> her friends.",
                            "target_lang_translations": {
                                "ru": "Она ненадолго вышла поговорить по телефону и быстро вернулась, чтобы <w>присоединиться к</w> друзьям."
                            }
                        },
                        {
                            "text": "After a quick break to wash his hands, he stepped into the dining room to <w>rejoin</w> the family.",
                            "target_lang_translations": {
                                "ru": "Быстро сполоснув руки, он вошёл в столовую, чтобы <w>вернуться к</w> семье."
                            }
                        }
                    ],
                    "synonyms": [
                        "return to"
                    ],
                    "common_phrases": [
                        "rejoin the group",
                        "rejoin the family",
                        "rejoin the party"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вернуться к кому-либо или снова присоединиться к группе людей после временного отсутствия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присоединиться вновь",
                                "target_lang_sense_clarification": "к людям или компании"
                            },
                            {
                                "target_lang_word": "вернуться к",
                                "target_lang_sense_clarification": "к друзьям, семье, группе"
                            },
                            {
                                "target_lang_word": "снова присоединиться",
                                "target_lang_sense_clarification": "к обществу людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "011b6e2f-b987-3f07-9ef6-4b3aa6695180",
                    "sense_definition": "To join together again, or connect back to a route, organization, or whole after separation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reconnect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Follow the narrow woodland path for two miles until it turns to <w>rejoin</w> the main road.",
                            "target_lang_translations": {
                                "ru": "Идите по узкой лесной тропинке две мили, пока она не повернёт и не <w>сольётся с</w> главной дорогой."
                            }
                        },
                        {
                            "text": "The country chose to <w>rejoin</w> the international trade alliance after years of negotiation.",
                            "target_lang_translations": {
                                "ru": "После долгих лет переговоров страна решила <w>снова вступить в</w> международный торговый альянс."
                            }
                        }
                    ],
                    "synonyms": [
                        "reunite",
                        "reconnect"
                    ],
                    "antonyms": [
                        "disjoin",
                        "unjoin"
                    ],
                    "common_phrases": [
                        "rejoin the main road",
                        "rejoin the team"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снова соединиться с чем-либо, вернуться в организацию или примкнуть обратно к маршруту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снова вступить",
                                "target_lang_sense_clarification": "в организацию, союз"
                            },
                            {
                                "target_lang_word": "воссоединиться",
                                "target_lang_sense_clarification": "с организацией или целым"
                            },
                            {
                                "target_lang_word": "сливаться",
                                "target_lang_sense_clarification": "о дороге, тропе"
                            },
                            {
                                "target_lang_word": "примкнуть обратно",
                                "target_lang_sense_clarification": "к маршруту или составу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d62c4890-ef11-35d2-9191-6eb439d11d2e",
                    "sense_definition": "To say something in reply; to retort or answer back.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"I never agreed to those terms,\" she <w>rejoined</w> firmly before leaving the meeting.",
                            "target_lang_translations": {
                                "ru": "«Я никогда не соглашалась на эти условия», — твёрдо <w>парировала</w> она перед тем, как покинуть собрание."
                            }
                        },
                        {
                            "text": "\"That makes no sense at all,\" he quickly <w>rejoined</w> when challenged by the audience.",
                            "target_lang_translations": {
                                "ru": "«В этом нет абсолютно никакого смысла», — быстро <w>возразил</w> он в ответ на реплику из зала."
                            }
                        }
                    ],
                    "synonyms": [
                        "retort",
                        "reply",
                        "counter"
                    ],
                    "common_phrases": [
                        "rejoined sharply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать что-либо в ответ; возразить или парировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парировать",
                                "target_lang_sense_clarification": "быстро возразить"
                            },
                            {
                                "target_lang_word": "возразить",
                                "target_lang_sense_clarification": "ответить на реплику"
                            },
                            {
                                "target_lang_word": "отпарировать",
                                "target_lang_sense_clarification": "дать меткий ответ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb8f25d0-1013-3d10-9943-f50026ef149b",
                    "sense_definition": "To answer formally, especially as a defendant in response to a plaintiff's replication.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reply",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defendant's attorney had only three days to <w>rejoin</w> following the latest replication filed by the plaintiff.",
                            "target_lang_translations": {
                                "ru": "У адвоката ответчика было всего три дня, чтобы <w>подать дуплику</w> после последней реплики истца."
                            }
                        },
                        {
                            "text": "Under traditional common law pleading, counsel was required to <w>rejoin</w> within a specific time limit.",
                            "target_lang_translations": {
                                "ru": "В рамках традиционного состязательного процесса общего права адвокат должен был <w>представить возражения ответчика</w> в установленный срок."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подать возражение ответчика в ответ на реплику истца (в судебном процессе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представить возражения ответчика",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "подать дуплику",
                                "target_lang_sense_clarification": "в процессуальном праве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63ec6276-c5e3-33d6-bcea-8b2a29c182b1",
                    "sense_definition": "To reinsert a patent claim that was previously withdrawn under a restriction requirement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patent examiner agreed to <w>rejoin</w> the withdrawn claims after the independent claim was allowed.",
                            "target_lang_translations": {
                                "ru": "Патентный эксперт согласился <w>повторно включить</w> отозванные пункты формулы после того, как независимый пункт был одобрен."
                            }
                        },
                        {
                            "text": "Applicants frequently petition to <w>rejoin</w> restricted claims once generic coverage is officially granted.",
                            "target_lang_translations": {
                                "ru": "Заявители часто ходатайствуют о том, чтобы <w>восстановить</w> ограниченные пункты формулы, как только официально предоставляется родовая охрана."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rejoin claims"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторно включить пункт патентной формулы, ранее отозванный по требованию об ограничении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторно включить",
                                "target_lang_sense_clarification": "пункт патентной формулы"
                            },
                            {
                                "target_lang_word": "восстановить",
                                "target_lang_sense_clarification": "отозванный пункт формулы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}