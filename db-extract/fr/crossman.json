                        ],
                        "examples": [
                            {
                                "example_id": "92e185f9-e11b-4af5-8a63-e9d43161e150",
                                "sense_id": "f5ed9fb4-9eee-3061-b3a4-932fc898330f",
                                "text": "Hier, c’est avec un autre jeune crossman, du nom de Rudhard, qu’il a remporté la première place dans la belle épreuve montrougienne."
                            },
                            {
                                "example_id": "b5d40481-ef82-420e-a8d7-6bfd8b963a33",
                                "sense_id": "f5ed9fb4-9eee-3061-b3a4-932fc898330f",
                                "text": "Félicitations à l’ensemble des crossmans qui a bien défendu ses chances lors des championnats de France de Cross-country au Mans le weekend du 06/03."
                            }
                        ]
                    },
                    {
                        "sense_id": "19091c0b-174a-3e7f-b50d-9d651a3d4607",
                        "entry_id": "bc6d7766-82ab-3fe3-a61c-8efda641a90e",
                        "glosses": [
                            "Pilote de motocross."
                        ],
