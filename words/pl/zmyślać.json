    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10ec07b4-c925-3658-b933-ae8b5a2967dc",
                    "sense_definition": "tworzyć nieprawdziwe historie lub fakty",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kłamstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko często <w>zmyśla</w> różne historie, żeby uniknąć kary za swoje zachowanie.",
                            "target_lang_translations": {
                                "ru": "Ребёнок часто <w>выдумывает</w> разные истории, чтобы избежать наказания за своё поведение."
                            }
                        },
                        {
                            "text": "Nie <w>zmyślaj</w> bajek, tylko powiedz mi szczerze, co się wczoraj wydarzyło.",
                            "target_lang_translations": {
                                "ru": "Не <w>выдумывай</w> сказки, а скажи мне честно, что вчера произошло."
                            }
                        }
                    ],
                    "synonyms": [
                        "konfabulować"
                    ],
                    "common_phrases": [
                        "zmyślać bajki",
                        "zmyślać historie"
                    ],
                    "target_lang_definitions": {
                        "ru": "создавать вымышленные истории или факты"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдумывать",
                                "target_lang_sense_clarification": "сочинять небылицы или фантазировать"
                            },
                            {
                                "target_lang_word": "сочинять",
                                "target_lang_sense_clarification": "придумывать что-то неправдоподобное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4add2238-9309-3ada-b582-00e0ad2fff77",
                    "sense_definition": "mówić nieprawdę, koloryzować",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kłamstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On ma tendencję, by <w>zmyślać</w> szczegóły swoich podróży, aby wydawały się ciekawsze.",
                            "target_lang_translations": {
                                "ru": "У него есть склонность <w>привирать</w> детали своих путешествий, чтобы они казались интереснее."
                            }
                        },
                        {
                            "text": "Przestań <w>zmyślać</w> i przyznaj się, że po prostu zapomniałeś o naszym spotkaniu.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>врать</w> и признайся, что ты просто забыл о нашей встрече."
                            }
                        }
                    ],
                    "synonyms": [
                        "robić z gęby cholewę"
                    ],
                    "common_phrases": [
                        "zmyślać fakty"
                    ],
                    "target_lang_definitions": {
                        "ru": "говорить неправду, приукрашивать действительность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врать",
                                "target_lang_sense_clarification": "говорить неправду, обманывать"
                            },
                            {
                                "target_lang_word": "привирать",
                                "target_lang_sense_clarification": "немного приукрашивать факты, добавляя вымышленные детали"
                            }
                        ]
                    }
                }
            ]
        }
    ]
