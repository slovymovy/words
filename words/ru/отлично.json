                },
                {
                    "sense_id": "daf3dffb-d750-306e-a7c7-390a6b2369e8",
                    "sense_definition": "Иначе, иным образом; не так, как другие.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это устройство работает <w>отлично</w> от предыдущей модели.",
                            "target_lang_translations": {
                                "en": "This device works <w>differently</w> from the previous model.",
                                "zh": "这个设备的工作方式与之前的型号<w>不同</w>。"
                            }
                        },
                        {
                            "text": "Он решил задачу <w>отлично</w> от того, как учили в школе.",
                            "target_lang_translations": {
                                "en": "He solved the problem <w>differently</w> from how they taught in school.",
                                "zh": "他解题的方法与学校教的<w>不同</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "иначе",
                        "по-другому"
                    ],
                    "antonyms": [
                        "одинаково",
                        "похоже"
                    ],
                    "common_phrases": [
                        "отлично от других"
                    ],
                    "target_lang_definitions": {
                        "en": "Differently, in a different way; not like others.",
                        "zh": "不同地，以不同的方式；与众不同。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "differently",
                                "target_lang_sense_clarification": "in a distinct manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不同",
                                "target_lang_sense_clarification": "表示有差异"
                            }
                        ]
                    }
                }
            ]
        },
