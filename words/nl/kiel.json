                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kiel</w> de boot voordat we hem definitief in het water laten.",
                            "target_lang_translations": {
                                "en": "I <w>keel</w> the boat before we finally lower it into the water."
                            }
