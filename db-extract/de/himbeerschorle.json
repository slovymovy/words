                "senses": [
                    {
                        "sense_id": "aa2dfa70-218e-3318-bde1-4d740d8c86c7",
                        "entry_id": "4c7fb127-5c32-3f8e-a2d5-2085b4906791",
                        "glosses": [
                            "Mischgetränk aus Himbeersaft und Mineralwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b8a6c8f-df0b-43cf-846a-832a0990458f",
                                "sense_id": "aa2dfa70-218e-3318-bde1-4d740d8c86c7",
                                "text": "„Zur Abkühlung gab es eiskalte Himbeerschorle.“"
                            },
                            {
                                "example_id": "36a88bbb-5c2b-49cb-a77a-86813c62fb8e",
                                "sense_id": "aa2dfa70-218e-3318-bde1-4d740d8c86c7",
                                "text": "„Paul hatte noch keinen rechten Appetit, so lange war das Frühstück noch nicht her, bestellte aber einen Bauerntoast mit Käse und Schinken und eine Himbeerschorle dazu.“"
                            },
                            {
                                "example_id": "08384065-4178-42db-87b5-a055be7d17c1",
                                "sense_id": "aa2dfa70-218e-3318-bde1-4d740d8c86c7",
                                "text": "„Sie entschieden sich für den Speckpfannkuchen mit Salat und Doro trank ein Glas frische Waldbeerschorle dazu, während Rainer sich für die Himbeerschorle entschied.“"
                            },
                            {
                                "example_id": "c42166d3-9ceb-4be8-82b4-594b1af87637",
                                "sense_id": "aa2dfa70-218e-3318-bde1-4d740d8c86c7",
                                "text": "„Sie hielten vor der einzigen Kneipe auf ein Bier, ein Radler für die Frau, Limonade oder Himbeerschorle für die gelangweilten Kinder.“"
                            },
                            {
                                "example_id": "ab9c1885-f059-4857-b963-ff26da08a9e2",
                                "sense_id": "aa2dfa70-218e-3318-bde1-4d740d8c86c7",
                                "text": "„Auch Luise Jäger, die neben ihm sitzt und die meiste Zeit an ihrer Himbeerschorle nippt, oder Matthias Porak, der Bruder der Gründerin, haben eine stärker oder schwächer ausgeprägte Form einer intellektuellen Behinderung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
