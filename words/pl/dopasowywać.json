    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c7b88e8-bdbe-31ac-b33a-8d50dbc6abb5",
                    "sense_definition": "dobierać lub układać elementy tak, aby pasowały do siebie pod względem wyglądu, funkcji lub stylu",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zestawianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdego ranka starannie <w>dopasowuję</w> koszulę do koloru spodni.",
                            "target_lang_translations": {
                                "ru": "Каждое утро я тщательно <w>подбираю</w> рубашку под цвет брюк."
                            }
                        },
                        {
                            "text": "Projektantka wnętrz bez trudu <w>dopasowuje</w> meble do nowoczesnego stylu mieszkania.",
                            "target_lang_translations": {
                                "ru": "Дизайнер интерьера без труда <w>подбирает</w> мебель под современный стиль квартиры."
                            }
                        }
                    ],
                    "synonyms": [
                        "dobierać",
                        "komponować",
                        "zestawiać"
                    ],
                    "common_phrases": [
                        "dopasowywać ubrania",
                        "dopasowywać kolory"
                    ],
                    "target_lang_definitions": {
                        "ru": "подбирать или сочетать элементы так, чтобы они гармонировали по внешнему виду, функции или стилю"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбирать",
                                "target_lang_sense_clarification": "по стилю или цвету"
                            },
                            {
                                "target_lang_word": "сочетать",
                                "target_lang_sense_clarification": "гармонично комбинировать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5077c8ec-228f-3eb6-8d45-d55f723950ab",
                    "sense_definition": "dobierać elementy tak, aby odpowiadały sobie pod względem kształtu lub rozmiaru",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zestawianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko z radością <w>dopasowuje</w> klocki o różnych kształtach do odpowiednich otworów.",
                            "target_lang_translations": {
                                "ru": "Ребёнок с радостью <w>подбирает</w> кубики разной формы к подходящим отверстиям."
                            }
                        },
                        {
                            "text": "Mechanik ostrożnie <w>dopasowywał</w> nową część do starego silnika samochodu.",
                            "target_lang_translations": {
                                "ru": "Механик осторожно <w>подгонял</w> новую деталь к старому двигателю автомобиля."
                            }
                        }
                    ],
                    "synonyms": [
                        "przypasowywać"
                    ],
                    "common_phrases": [
                        "dopasowywać części",
                        "dopasowywać rozmiar"
                    ],
                    "target_lang_definitions": {
                        "ru": "подбирать или соединять детали так, чтобы они подходили друг к другу по форме или размеру"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгонять",
                                "target_lang_sense_clarification": "детали по форме или размеру"
                            },
                            {
                                "target_lang_word": "припасовывать",
                                "target_lang_sense_clarification": "технические детали"
                            },
                            {
                                "target_lang_word": "подбирать",
                                "target_lang_sense_clarification": "по размеру или форме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "253b8bc8-ad30-3018-9472-fc796f56244e",
                    "sense_definition": "zmieniać swoje zachowanie lub poglądy, by spełnić cudze oczekiwania lub wtopić się w otoczenie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adaptacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W nowej pracy powoli <w>dopasowuję</w> się do panujących tam zasad.",
                            "target_lang_translations": {
                                "ru": "На новой работе я постепенно <w>приспосабливаюсь</w> к царящим там правилам."
                            }
                        },
                        {
                            "text": "Nie warto za wszelką cenę <w>dopasowywać</w> się do oczekiwań innych ludzi.",
                            "target_lang_translations": {
                                "ru": "Не стоит любой ценой <w>подстраиваться</w> под ожидания других людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "adaptować się",
                        "dostosowywać się",
                        "przystosowywać się",
                        "wpasowywać się"
                    ],
                    "common_phrases": [
                        "dopasowywać się do sytuacji",
                        "dopasowywać się do grupy"
                    ],
                    "target_lang_definitions": {
                        "ru": "изменять своё поведение или взгляды, чтобы соответствовать ожиданиям других или вписаться в окружение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приспосабливаться",
                                "target_lang_sense_clarification": "к окружению, людям или правилам"
                            },
                            {
                                "target_lang_word": "подстраиваться",
                                "target_lang_sense_clarification": "под чьи-либо ожидания"
                            },
                            {
                                "target_lang_word": "адаптироваться",
                                "target_lang_sense_clarification": "к новой обстановке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60bcf447-45d4-3a0e-b649-7f8dd0fd8fa8",
                    "sense_definition": "modyfikować coś, by odpowiadało konkretnym potrzebom, wymaganiom lub warunkom",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adaptacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Firma elastycznie <w>dopasowuje</w> ofertę do rosnących wymagań klientów.",
                            "target_lang_translations": {
                                "ru": "Компания гибко <w>адаптирует</w> предложение под растущие требования клиентов."
                            }
                        },
                        {
                            "text": "Rząd regularnie <w>dopasowuje</w> budżet do aktualnej sytuacji gospodarczej kraju.",
                            "target_lang_translations": {
                                "ru": "Правительство регулярно <w>корректирует</w> бюджет в соответствии с текущей экономической ситуацией в стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "dostosowywać"
                    ],
                    "common_phrases": [
                        "dopasowywać budżet",
                        "dopasowywać ofertę",
                        "dopasowywać do potrzeb"
                    ],
                    "target_lang_definitions": {
                        "ru": "видоизменять что-либо так, чтобы оно соответствовало конкретным потребностям, требованиям или условиям"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адаптировать",
                                "target_lang_sense_clarification": "под требования или условия"
                            },
                            {
                                "target_lang_word": "приспосабливать",
                                "target_lang_sense_clarification": "к конкретным потребностям"
                            },
                            {
                                "target_lang_word": "корректировать",
                                "target_lang_sense_clarification": "планы, бюджет под ситуацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03ac5f9b-7d78-3a41-99c5-ddfc88c27244",
                    "sense_definition": "przerabiać ubranie krawiecko, aby ściśle i poprawnie leżało na ciele",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "krawiectwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Krawcowa cierpliwie <w>dopasowuje</w> elegancką suknię ślubną do figury panny młodej.",
                            "target_lang_translations": {
                                "ru": "Портниха терпеливо <w>подгоняет</w> элегантное свадебное платье по фигуре невесты."
                            }
                        },
                        {
                            "text": "Przed ważną uroczystością muszę oddać garnitur do pracowni, aby krawiec idealnie go <w>dopasował</w>.",
                            "target_lang_translations": {
                                "ru": "Перед важным торжеством мне нужно отдать костюм в ателье, чтобы портной идеально его <w>подогнал</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dopasowywać suknię",
                        "dopasowywać garnitur",
                        "dopasowywać do figury"
                    ],
                    "target_lang_definitions": {
                        "ru": "перешивать или подгонять одежду так, чтобы она точно и правильно сидела по фигуре"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подгонять",
                                "target_lang_sense_clarification": "одежду по фигуре"
                            },
                            {
                                "target_lang_word": "усаживать",
                                "target_lang_sense_clarification": "одежду по фигуре"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}