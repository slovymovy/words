                    {
                        "translation_id": "e85854bd-86d0-4db2-92ae-e1ba96eb4b2b",
                        "source_entry_id": "d10d0746-d067-327b-9c43-26148e36e88f",
                        "source_sense_id": "3575c84c-53b9-3eca-a430-97e0cc0c3381",
                        "target_lang_word": "zoonoz",
