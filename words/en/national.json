            "senses": [
                {
                    "sense_id": "99094d60-8ce3-3dc0-a6c2-f594238e5a08",
                    "sense_definition": "The New Zealand National Party.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "politics_org",
                    "name_type": "organization_name",
                    "examples": [
