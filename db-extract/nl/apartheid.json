                "senses": [
                    {
                        "sense_id": "ab879b07-7211-3eaf-b550-e9b07d9d810d",
                        "entry_id": "5ad06ced-f2df-3dc6-bfcd-c1f071dbb223",
                        "glosses": [
                            "de in Zuid-Afrika door de blanke overheid in het verleden opgelegde scheiding tussen de verschillende rassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6781fb-6f7c-4801-b615-30aeeee41048",
                                "sense_id": "ab879b07-7211-3eaf-b550-e9b07d9d810d",
                                "text": "De kleine apartheid was het bekendst en omvatte de raciale segregatie binnen woongemeenschappen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b45a74c-8085-3e71-9d91-5d159708f46b",
                        "entry_id": "5ad06ced-f2df-3dc6-bfcd-c1f071dbb223",
                        "glosses": [
                            "het apart zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ce84ccf-bddc-41c3-9d9f-f918e7b7b1a1",
                                "sense_id": "8b45a74c-8085-3e71-9d91-5d159708f46b",
                                "text": "apartheid kan dus ook zijn: 'het heel bijzondere, het buitenissig mooie"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a9c30a0-c393-4b7d-a84d-1da489be21b5",
                        "source_entry_id": "5ad06ced-f2df-3dc6-bfcd-c1f071dbb223",
                        "target_lang_word": "apartheid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apartheid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a81a46ef-8744-3744-a6ca-527a3a6e6115",
                                        "entry_id": "f8eebb90-3e43-33b7-8099-596bf864d505",
                                        "glosses": [
                                            "The policy of racial segregation in South Africa from 1948 to 1994."
                                        ],
                                        "tags": [
                                            "South-Africa",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "058accfe-d0bb-4f28-b978-b4808213648e",
                                                "sense_id": "a81a46ef-8744-3744-a6ca-527a3a6e6115",
                                                "text": "She don't care about the rest at all / She's got a system they call apartheid / It keeps a brother in a subjection"
                                            },
                                            {
                                                "example_id": "2a959798-11fb-477d-8501-6f46fb1b6c76",
                                                "sense_id": "a81a46ef-8744-3744-a6ca-527a3a6e6115",
                                                "text": "The premise of apartheid was that whites were superior to Africans, Coloureds and Indians, and the function of it was to entrench white supremacy forever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "404217ec-f3db-3a39-84d3-ee69abf77eea",
                                        "entry_id": "f8eebb90-3e43-33b7-8099-596bf864d505",
                                        "glosses": [
                                            "Any similar policy of racial segregation or separation and discrimination, particularly when in favor of a minority rule."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8140f29c-47b6-4fa3-9f97-e221dbad47d3",
                                                "sense_id": "404217ec-f3db-3a39-84d3-ee69abf77eea",
                                                "text": "The 1973 Apartheid Convention conferred universal jurisdiction to the state signatories to prosecute those who commit apartheid."
                                            },
                                            {
                                                "example_id": "f1dd73d8-16ae-4785-a462-e2e7986f319a",
                                                "sense_id": "404217ec-f3db-3a39-84d3-ee69abf77eea",
                                                "text": "When the doors of a business are open to the public, they must be open to all regardless of race if apartheid is not to become engrained in our public […] ."
                                            },
                                            {
                                                "example_id": "79d9c2cc-19b1-4252-92c9-73accc98def9",
                                                "sense_id": "404217ec-f3db-3a39-84d3-ee69abf77eea",
                                                "text": "Jim Crow miscegenation laws enforced apartheid in marriage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3f7eb02-d604-3b33-b86a-fce79a0534b3",
                                        "entry_id": "f8eebb90-3e43-33b7-8099-596bf864d505",
                                        "glosses": [
                                            "A policy or situation of segregation based on some specified attribute."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe2b2e0-a85d-4b1e-a71a-4154072e5e97",
                                                "sense_id": "d3f7eb02-d604-3b33-b86a-fce79a0534b3",
                                                "text": "Fifteen minutes drive to the Brown Trout was guaranteed to satisfy my appetite because there, as with other clubs and hotel bars, a form of sex apartheid was practised. The males assembled in the region of the bar and the opposite gender either sat discreetly detached or strayed outside to gossip gaily among themselves."
                                            },
                                            {
                                                "example_id": "70fb043e-a867-4c9c-b045-92e8d62ecb8c",
                                                "sense_id": "d3f7eb02-d604-3b33-b86a-fce79a0534b3",
                                                "text": "In these annual reports, the religious apartheid practices in India are not mentioned at all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apartheid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a24c926-b5ce-3c34-a8f7-fb3f02a0647b",
                                        "entry_id": "4a276ac5-c7f5-39d8-98a1-31be69e7b34c",
                                        "glosses": [
                                            "To impose a policy of segregation of groups of people, especially one based on race."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63da573-6c27-486d-b40a-b33a0b633c22",
                                                "sense_id": "1a24c926-b5ce-3c34-a8f7-fb3f02a0647b",
                                                "text": "Yes, apartheiding the apartheiders, is what the rest of the world is doing."
                                            },
                                            {
                                                "example_id": "57690ff0-a26e-45a0-a611-1da6f85812b4",
                                                "sense_id": "1a24c926-b5ce-3c34-a8f7-fb3f02a0647b",
                                                "text": "Whatever the reason the blacks have for \"apartheiding\" Boston, whites should be all for it."
                                            },
                                            {
                                                "example_id": "2ed98c1e-cd74-4815-8e9e-b404120d0b96",
                                                "sense_id": "1a24c926-b5ce-3c34-a8f7-fb3f02a0647b",
                                                "text": "The most deadly of all ghosts are wandering over Britain and medicine, apartheiding people into superiors and nonentities."
                                            },
                                            {
                                                "example_id": "b215d904-76a7-49c6-bb17-195c74339a9d",
                                                "sense_id": "1a24c926-b5ce-3c34-a8f7-fb3f02a0647b",
                                                "text": "Speaking of the resulting apartheiding of British Columbia, Cole Harris observed, \"racism was built into the landscape of settlement.\""
                                            },
                                            {
                                                "example_id": "d84e81c5-5dbf-4b3a-b2f2-00ea0ed50f9a",
                                                "sense_id": "1a24c926-b5ce-3c34-a8f7-fb3f02a0647b",
                                                "text": "By 1922, the apartheiding of British Columbia was cemented into a public and private English-language discourse that took for granted how and where one racialized body was placed in relation to another, and in turn how each related to the state system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e344ea8-a1bb-43b1-bcbc-0eb63f729b7f",
                        "source_entry_id": "5ad06ced-f2df-3dc6-bfcd-c1f071dbb223",
                        "target_lang_word": "apartheid",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apartheid",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf0a571-d13a-32af-aa4a-c52fbdcfcf33",
                                        "entry_id": "5d266f45-67be-3d67-ba55-176cb51bbdf7",
                                        "glosses": [
                                            "En Afrique du Sud, régime politique de séparation des Blancs et des Noirs en tant que groupes raciaux distincts."
                                        ],
                                        "tags": [],
                                        "note": "L’apartheid fut aboli en 1994",
                                        "examples": [
                                            {
                                                "example_id": "a14a09a7-c2b4-407e-b3fa-1d6edee5bbe2",
                                                "sense_id": "2bf0a571-d13a-32af-aa4a-c52fbdcfcf33",
                                                "text": "L’Afrique du Sud, avec la fin de l’apartheid, a vu ainsi affluer des migrants venus du Mozambique, de Zambie ou d’Angola quand les Afrikaners partaient vers l’Australie ou l’Amérique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e239cb55-e092-3a5f-865c-41487bf03c3f",
                                        "entry_id": "5d266f45-67be-3d67-ba55-176cb51bbdf7",
                                        "glosses": [
                                            "Politique tendant à séparer deux groupes raciaux ou ethniques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22ba08d-1e02-4450-8dd6-368e73be1332",
                                                "sense_id": "e239cb55-e092-3a5f-865c-41487bf03c3f",
                                                "text": "On a même parlé d’apartheid pour qualifier les conditions qui sont imposées aux Palestiniens."
                                            },
                                            {
                                                "example_id": "36158f32-4102-48d6-ba19-c47b205507e9",
                                                "sense_id": "e239cb55-e092-3a5f-865c-41487bf03c3f",
                                                "text": "À Toronto, la ségrégation raciale de facto se compare à celle de grandes villes américaines. Les minorités visibles sont regroupées dans les quartiers pauvres, tandis que la minorité blanche domine les quartiers riches. Je reviens sur l’apartheid torontois plus loin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da876bf2-4396-3ea9-94d0-d31e41d4c8cc",
                                        "entry_id": "5d266f45-67be-3d67-ba55-176cb51bbdf7",
                                        "glosses": [
                                            "Discrimination, voire exclusion, d’une partie de la population qui ne dispose pas des mêmes droits, lieux d’habitation ou emplois que le reste de la collectivité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8a1ca85-5065-40d1-85f5-b77049c9684c",
                                                "sense_id": "da876bf2-4396-3ea9-94d0-d31e41d4c8cc",
                                                "text": "La discrimination institutionnalisée à l’encontre des femmes en Afghanistan et en Iran devrait-elle être reconnue comme un « apartheid des genres » ? Un terme lourd et chargé qui renvoie immanquablement à l’apartheid racial qui a sévi en Afrique du Sud pendant des décennies et qui a été activement combattu par la communauté internationale. Or, des voix de plus en plus fortes s’élèvent afin que cet « apartheid du XXIᵉ siècle » soit nommé comme tel et que la communauté internationale se saisisse d’outils juridiques pour lutter contre la ségrégation sexuelle érigée en projet politique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
