                "senses": [
                    {
                        "sense_id": "b26a4533-2fd2-30d1-bb97-8b7296718923",
                        "entry_id": "8c1483c9-709b-3ca0-9945-a77879935e20",
                        "glosses": [
                            "das Beurteilen, die Einschätzung von Geruch bei der subjektiven Wahrnehmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5fd56c-6704-4601-b71e-537c587f7a07",
                                "sense_id": "b26a4533-2fd2-30d1-bb97-8b7296718923",
                                "text": "„Vor diesem Hintergrund ist zu erwarten, dass die Ergebnisse des Projektes einen relevanten Beitrag zu einer wissenschaftlich fundierten Geruchsbeurteilung in der Landwirtschaft liefern.“"
                            },
                            {
                                "example_id": "f47e9cbf-a296-42d9-8d5f-5bf7cec5fb3c",
                                "sense_id": "b26a4533-2fd2-30d1-bb97-8b7296718923",
                                "text": "„Damit wurde bereits ein beachtlicher methodischer Fortschritt erreicht, da erstmalig der Versuch unternommen wurde, für die Geruchsbeurteilung Begriffe zu nehmen, die sich aus der Beurteilung ergeben und nicht, wie bisher, willkürlich vorgegeben wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
