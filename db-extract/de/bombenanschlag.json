                                "sense_id": "f5ee7858-b251-3b4c-94d0-db16d6b5c010",
                                "text": "Am 20. Juli 1944 versuchte Claus Schenk Graf von Stauffenberg, Hitler durch einen Bombenanschlag zu töten."
                            },
                            {
                                "example_id": "1f69b68f-bba7-4a7e-a634-4ce7f9f3fdbd",
                                "sense_id": "f5ee7858-b251-3b4c-94d0-db16d6b5c010",
                                "text": "„Weiße Rassisten verüben Bombenanschläge, um wahllos Tod und Verderben zu stiften.“"
                            }
                        ],
