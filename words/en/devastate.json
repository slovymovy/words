{
    "word_family": [
        "devastation",
        "devastating",
        "devastated",
        "devastator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50455a12-3a2a-3fff-8546-d2799ef7e9ee",
                    "sense_definition": "To cause someone to feel great shock, grief, or sadness.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of the sudden closure will <w>devastate</w> the local community.",
                            "target_lang_translations": {
                                "ru": "Новости о внезапном закрытии <w>потрясут</w> местное сообщество."
                            }
                        },
                        {
                            "text": "It would <w>devastate</w> her to lose her favorite job after so many years.",
                            "target_lang_translations": {
                                "ru": "Потеря любимой работы спустя столько лет просто <w>раздавит</w> её."
                            }
                        }
                    ],
                    "common_phrases": [
                        "devastate her",
                        "devastate the family"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызвать у кого-либо сильное потрясение, горе или печаль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустошить",
                                "target_lang_sense_clarification": "лишить душевных сил"
                            },
                            {
                                "target_lang_word": "потрясти",
                                "target_lang_sense_clarification": "вызвать сильный шок"
                            },
                            {
                                "target_lang_word": "раздавить",
                                "target_lang_sense_clarification": "морально уничтожить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96fc467f-7a7c-3eb8-8865-0d954c4904ae",
                    "sense_definition": "To cause great damage or destruction to a large area or a lot of things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hurricane managed to <w>devastate</w> the entire coastline within a few hours.",
                            "target_lang_translations": {
                                "ru": "Урагану удалось <w>опустошить</w> всё побережье всего за несколько часов."
                            }
                        },
                        {
                            "text": "A massive fire could <w>devastate</w> the forest and kill many animals.",
                            "target_lang_translations": {
                                "ru": "Масштабный пожар может <w>погубить</w> лес и привести к гибели многих животных."
                            }
                        }
                    ],
                    "synonyms": [
                        "destroy",
                        "ruin",
                        "raze"
                    ],
                    "common_phrases": [
                        "devastate the area",
                        "devastate the city",
                        "devastate the forest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанести огромный ущерб или разрушение большой территории или множеству объектов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустошить",
                                "target_lang_sense_clarification": "привести в запустение"
                            },
                            {
                                "target_lang_word": "разорить",
                                "target_lang_sense_clarification": "разрушить и разграбить"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "нанести серьезный урон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e605784-c355-3bab-a066-abf5baf3f613",
                    "sense_definition": "To completely destroy a set of beliefs, ideas, or opinions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intellectual destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New scientific evidence helped to <w>devastate</w> his long-held theories about the universe.",
                            "target_lang_translations": {
                                "ru": "Новые научные данные помогли <w>разрушить</w> его давние теории о вселенной."
                            }
                        },
                        {
                            "text": "The lawyer used facts to <w>devastate</w> the argument presented by the defense.",
                            "target_lang_translations": {
                                "ru": "Адвокат использовал факты, чтобы <w>разгромить</w> аргумент, представленный защитой."
                            }
                        }
                    ],
                    "synonyms": [
                        "destroy",
                        "ruin"
                    ],
                    "common_phrases": [
                        "devastate the argument",
                        "devastate his theory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью разрушить систему убеждений, идей или мнений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "опровергнуть аргументы"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "уничтожить теорию или веру"
                            },
                            {
                                "target_lang_word": "камня на камне не оставить",
                                "target_lang_sense_clarification": "полностью опровергнуть"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}