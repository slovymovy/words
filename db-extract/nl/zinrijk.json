                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0b00d85-3673-38c6-af78-d12fd7ae30fb",
                                        "entry_id": "bedfa94e-35ce-3aca-9e71-29ea4590b796",
                                        "glosses": [
                                            "pleasant;"
                                        ],
                                        "tags": [
                                            "of an action or thing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56d99dc5-010e-4547-b75b-f48120467302",
                                                "sense_id": "c0b00d85-3673-38c6-af78-d12fd7ae30fb",
                                                "text": "Rescuing animals is an appropriate thing to do."
                                            }
