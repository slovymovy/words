                        "glosses": [
                            "vertekening in het beeld als lichtbundels schuin invallen, waarbij punten een wat vagere, meer ovale vorm krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f90e1a8-899a-4804-a662-876b7740a2a7",
                                "sense_id": "e6da9f47-bb3d-3d49-86d6-dd4097bae8e1",
                                "text": "Omdat coma vooral optreedt in de uiterste hoeken van je beeld is er soms wel wat winst te behalen door je opname wat bij te snijden."
