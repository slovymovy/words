                        "glosses": [
                            "Petit beignet, généralement farci avec des poissons ou des légumes, servi en apéritif ou en entrée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02edbf55-15b7-4689-b96c-b4ab32ceea42",
                                "sense_id": "8e65cfd5-0668-3469-a2b1-eb2c6a20975a",
                                "text": "Elle prépare des choses simples, qui accommodent les poissons invendus : paella, soupes, poissons en sauce ou encore de délicieux accras, qu’elle aime faire avec du muge (mulet) –un poisson méconnu et pourtant savoureux."
                            }
                        ]
