                "senses": [
                    {
                        "sense_id": "a4729923-6962-3821-a7b1-2ae6c64a4e53",
                        "entry_id": "95879765-d278-3e0c-8e2b-efc2059f2c0d",
                        "glosses": [
                            "Legierung aus (anteilig viel) Kupfer und (anteilig wenig) Silber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4fba519-a61f-41ef-8a84-a95044ebce31",
                                "sense_id": "a4729923-6962-3821-a7b1-2ae6c64a4e53",
                                "text": "„Ein hervorstechendes Merkmal der Silberbronze ist, daß (wie auch bei Cu - Zr) die Dehnungswerte im Bereich um 550° C vergleichbar mit den Raumtemperaturwerten sind, also keine Versprödung zu bemerken ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4e98814-38a3-3260-b426-d2541205f237",
                        "entry_id": "95879765-d278-3e0c-8e2b-efc2059f2c0d",
                        "glosses": [
                            "aus Gummi und Silberpartikeln bestehende Malerfarbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0d964b3-09ca-4a99-b6a9-9b3d34774e3e",
                                "sense_id": "e4e98814-38a3-3260-b426-d2541205f237",
                                "text": "„Die Silberbronze ist ja etwas sehr Banales, was sehr Triviales – sieht immer wie Silber aus, ist aber kein Silber, ist auch keine graue Farbe, ist also wirklich bloß Silberbronze […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
