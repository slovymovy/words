        "de-extract.jsonl": [
            {
                "entry_id": "4fea2f33-059e-3c6b-9a6f-96ad690e24eb",
                "word": "meinerzeit",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c18527d-84ea-30ab-8802-0cff9ec39995",
                        "entry_id": "4fea2f33-059e-3c6b-9a6f-96ad690e24eb",
                        "glosses": [
                            "zu meiner Zeit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6a03fce5-7a06-41a0-b409-018ac9aa53e6",
                                "sense_id": "3c18527d-84ea-30ab-8802-0cff9ec39995",
                                "text": "Meinerzeit (= zu meiner Zeit als Student) war das Studium noch gebührenfrei."
                            },
                            {
                                "example_id": "cccc1796-91c1-473e-b863-b4bf093c4a4b",
                                "sense_id": "3c18527d-84ea-30ab-8802-0cff9ec39995",
                                "text": "„Würde ich meiner alten Mutter ihre Geschichte erzählen, käme todsicher auch heute noch eine Belehrung über die Gefahren der Welt heraus, in die man so ein junges Ding nie hätte ziehen lassen dürfen. Und Karriereratschläge, die meinerzeit auf die Beamtenlaufbahn zielten.“"
                            },
                            {
                                "example_id": "0ce93273-3ad8-4b5b-90fa-13b7a060341f",
                                "sense_id": "3c18527d-84ea-30ab-8802-0cff9ec39995",
                                "text": "„Du, Albrecht, bist immerdar ein Kind gewesen und bleibst eins; aber ich war meinerzeit ein Mann und ein Kerl, wenn ich auch jetzo hier liege und alle Viere von mir strecke.“"
                            },
                            {
                                "example_id": "0aa069bf-d7b0-40fb-ad23-e2e96c421396",
                                "sense_id": "3c18527d-84ea-30ab-8802-0cff9ec39995",
                                "text": "„Ich hatte meinerzeit weniger denn nichts, denn ich hatte meinerzeit noch eine verkrüppelte Schwester teilweise zu erhalten während meiner Studienzeit.“"
                            },
                            {
                                "example_id": "9d3ddb24-31bf-4aae-977e-0909498f987e",
                                "sense_id": "3c18527d-84ea-30ab-8802-0cff9ec39995",
                                "text": "„denn, Nachbarin, ich war meinerzeit ein wahrhaft guter Ehemann!“"
                            },
                            {
                                "example_id": "7c648277-e2a7-4843-b47b-6100c8c69c2b",
                                "sense_id": "3c18527d-84ea-30ab-8802-0cff9ec39995",
                                "text": "„Auch hier war einiges darum gewachsen, was meinerzeit nicht da gewesen war, allerlei kleinstädtische und augenfällig von kleinen Leuten bewohnte Häuschen, auch eine inzwischen verfallene Fabrikhalle in gelbem Klinkerziegel[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
