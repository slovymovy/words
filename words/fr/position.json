                    "frequency": "High",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il reste souvent dans une mauvaise <w>position</w> devant son écran d'ordinateur."
                        },
                        {
                            "text": "Le médecin lui conseille de dormir dans une <w>position</w> plus confortable pour son dos."
