                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9693f818-2e42-4248-98d3-aac747f279ca",
                                                "sense_id": "703e59c6-e547-3dbf-aef5-e45db4e66d65",
                                                "text": "De versterking van sommige dijken is hoogst noodzakelijk."
                                            },
                                            {
                                                "example_id": "c21749a3-3f87-42ac-8120-ae959862cc24",
                                                "sense_id": "703e59c6-e547-3dbf-aef5-e45db4e66d65",
                                                "text": "Maar hij was niet uitgenodigd om melancholisch te worden over het feit dat hij zich liet corrumperen met ossenhaas en Franse wijn, goede wijn overigens, een uitstekende versterking van het nieuwe grote rijk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67aaa110-5355-311a-8c8b-56ac3da8a6ad",
                                        "entry_id": "5214e17e-2a94-352f-96dd-d128c427680b",
                                        "glosses": [
                                            "extra hulp in probleemsituaties"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ee88c4-dae5-4288-b5ae-26160bd16ccc",
                                                "sense_id": "67aaa110-5355-311a-8c8b-56ac3da8a6ad",
                                                "text": "Gelukkig is de versterking onderweg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3deaf7c-6814-35a7-aedc-0e92ab84ac04",
                                        "entry_id": "5214e17e-2a94-352f-96dd-d128c427680b",
                                        "glosses": [
