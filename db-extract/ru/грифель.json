                                    },
                                    {
                                        "sense_id": "95281464-03dd-3a97-8b82-e4a34b9abeda",
                                        "entry_id": "0e95ff71-e59b-3d56-9a23-fc44d1f74f7b",
                                        "glosses": [
                                            "A hard, grey coloured, aniseed flavoured, sugar-based confectionery in the shape of a rod or stick."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76d38e4f-4a07-4c9f-ad5c-3c60d1c5d59b",
                        "source_entry_id": "62552083-f1fd-3572-9026-54bcffe3a27e",
                        "target_lang_word": "Griffel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Griffel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc854847-f075-37cd-955a-a5bfffdfa2c2",
                                        "entry_id": "5915a1ff-01bb-396b-b2f9-99aa6d8f7fd5",
                                        "glosses": [
                                            "Stift, der zum Beschreiben von Schiefer- oder Wachstafeln dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9920278f-994f-4927-bbec-aa922b3659f2",
                                                "sense_id": "dc854847-f075-37cd-955a-a5bfffdfa2c2",
                                                "text": "Als Opa zur Schule ging, musste er noch mit dem Griffel auf einer Schiefertafel schreiben."
                                            },
                                            {
                                                "example_id": "6fc6a20b-f5e3-48b5-96fe-0f65b2984cac",
                                                "sense_id": "dc854847-f075-37cd-955a-a5bfffdfa2c2",
                                                "text": "„Die Kinder nahmen Bonbons, Griffel, Radiergummis aus den Regalen und legten dem alten Derkum das Geld auf die Theke.“"
                                            },
                                            {
                                                "example_id": "f6bee8ee-ab11-41b8-acb7-94ee5ae0dc64",
                                                "sense_id": "dc854847-f075-37cd-955a-a5bfffdfa2c2",
                                                "text": "„Einer umschließt den Griffel wie einen Faustkeil, weil seine großen und ungelenken Finger sonst immer die Spitze abbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f59c0bed-a827-3e0a-9da2-8d431156dcc2",
                                        "entry_id": "5915a1ff-01bb-396b-b2f9-99aa6d8f7fd5",
                                        "glosses": [
                                            "derjenige Teil des Stempels in einer Blüte, der die Narbe trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "205b6dd3-22b5-483f-96c7-47ba22f1c4cd",
                                                "sense_id": "f59c0bed-a827-3e0a-9da2-8d431156dcc2",
                                                "text": "„Die zur Gewinnung hochwertigen Safrans ausgelesenen Griffel werden oft anderem Safran beigemengt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9b1ba942-53b7-3cd0-a93e-dcaad362bae4",
                                        "entry_id": "5915a1ff-01bb-396b-b2f9-99aa6d8f7fd5",
                                        "glosses": [
                                            "Finger"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "177de1d5-7340-4b5f-97fe-a038d1fe088a",
                                                "sense_id": "9b1ba942-53b7-3cd0-a93e-dcaad362bae4",
                                                "text": "Nimm deine Griffel weg von meinem Kirschkuchen!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5556a162-e8b2-39a7-be13-8e808d7f01aa",
                                        "entry_id": "5915a1ff-01bb-396b-b2f9-99aa6d8f7fd5",
                                        "glosses": [
                                            "Werkzeug, mit dem ein Zeichner oder ein Maler künstlerisch arbeitet"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42b8e8a5-36c0-4490-a382-0287cc8f66a2",
                                                "sense_id": "5556a162-e8b2-39a7-be13-8e808d7f01aa",
                                                "text": "Für ein wahres Kunstwerk braucht es mehr als Pinsel und Griffel."
                                            },
                                            {
                                                "example_id": "9e415745-7d13-4a4a-a7aa-256e7f4d4337",
                                                "sense_id": "5556a162-e8b2-39a7-be13-8e808d7f01aa",
                                                "text": "Der Künstler, der dieses Bild geschaffen hat, wusste den Griffel vortrefflich zu führen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "bf449727-73ff-3141-9991-8c990eb2db5b",
                                        "entry_id": "5915a1ff-01bb-396b-b2f9-99aa6d8f7fd5",
                                        "glosses": [
                                            "das Schreiben, das künstlerische Schaffen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41d04e19-291b-4e61-bd9f-5c36e8fa3d77",
                                                "sense_id": "bf449727-73ff-3141-9991-8c990eb2db5b",
                                                "text": "Hoffen wir, dass dieser begnadete Poet den Griffel nicht so bald niederlegen möge."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "fa32beec-92b4-39d0-8e37-2567dfcb9fd5",
                                        "entry_id": "5915a1ff-01bb-396b-b2f9-99aa6d8f7fd5",
                                        "glosses": [
