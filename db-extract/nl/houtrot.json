                "senses": [
                    {
                        "sense_id": "bfd00e82-6336-3b93-99fa-ba7b32c9af59",
                        "entry_id": "e7f891aa-5fe8-3fc9-9ac0-18869919bb85",
                        "glosses": [
                            "aantasting van hout door vocht, schimmels en bacteriën waardoor het geen dragende functie meer kan hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29813b39-4f32-41c0-b4fc-b8f3c646b906",
                                "sense_id": "bfd00e82-6336-3b93-99fa-ba7b32c9af59",
                                "text": "De renovatie is nodig omdat het huidige complex niet meer voldoet aan de eisen van brandveiligheid. Daken moeten worden vernieuwd, kelders lopen vol als het regent, er is houtrot en elektrische bedradingen en oude liften moeten worden vervangen."
                            },
                            {
                                "example_id": "6503701e-68d8-4575-b21a-175a9f3475df",
                                "sense_id": "bfd00e82-6336-3b93-99fa-ba7b32c9af59",
                                "text": "Met zestien tegendoelpunten is de defensie van Roda net zo standvastig als een door houtrot getroffen visserssloep."
                            },
                            {
                                "example_id": "c5911e99-bb01-4946-87f0-08d7b5ccd0ed",
                                "sense_id": "bfd00e82-6336-3b93-99fa-ba7b32c9af59",
                                "text": "Het instorten van een balkon met feestvierders tijdens Oud en Nieuw in Arnhem is te wijten aan houtrot. Dat is dinsdag geconstateerd bij onderzoek naar de oorzaak van het ongeval, meldt de gemeente Arnhem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dce4e3e7-699e-4af0-87e0-5b7ed3eb4487",
                        "source_entry_id": "e7f891aa-5fe8-3fc9-9ac0-18869919bb85",
                        "source_sense_id": "bfd00e82-6336-3b93-99fa-ba7b32c9af59",
                        "target_lang_word": "dry rot",
