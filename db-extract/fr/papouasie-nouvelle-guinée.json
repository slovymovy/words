        "fr-extract.jsonl": [
            {
                "entry_id": "7924814b-f9a4-359c-857c-4bb5bae49fe5",
                "word": "Papouasie-Nouvelle-Guinée",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "67fcbf3a-8dd5-3016-92ba-0235c741be8b",
                        "entry_id": "7924814b-f9a4-359c-857c-4bb5bae49fe5",
                        "glosses": [
                            "Pays d’Océanie, occupant la partie orientale de la Nouvelle-Guinée et les îles environnantes, dont la capitale est Port Moresby."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "fa574b20-d068-4328-ac03-8bbf6ae12e98",
                                "sense_id": "67fcbf3a-8dd5-3016-92ba-0235c741be8b",
                                "text": "Le marquis parviendra à expédier, entre 1878 et 1881, quatre navires et 600 colons qui débarquent à Port-Breton sur l’île de la Nouvelle-Irlande, actuellement en Papouasie-Nouvelle-Guinée."
                            },
                            {
                                "example_id": "aba2c039-f5c7-4984-a5d3-10d449077bcb",
                                "sense_id": "67fcbf3a-8dd5-3016-92ba-0235c741be8b",
                                "text": "Certains de ces demandeurs d’asile avaient auparavant été enfermés pendant six ans sur l’île de Manus, en Papouasie-Nouvelle-Guinée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de3b3619-9f63-443d-a4f0-ddc9c54160b6",
                        "source_entry_id": "7924814b-f9a4-359c-857c-4bb5bae49fe5",
                        "source_sense_id": "67fcbf3a-8dd5-3016-92ba-0235c741be8b",
                        "target_lang_word": "Papua-Neuguinea",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Papua-Neuguinea",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "042e757a-83ba-3e21-b629-8f029aef7717",
                                        "entry_id": "0e4ad251-53e7-3f20-b23b-d7b59968d0f2",
                                        "glosses": [
                                            "Inselstaat im Pazifik; drittgrößter Inselstaat der Welt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84cdf543-f2cc-49ce-81a4-beb7bc209312",
                                                "sense_id": "042e757a-83ba-3e21-b629-8f029aef7717",
                                                "text": "Die Landschaft Papua-Neuguineas ist vom Gebirge zum Küstenland sehr abwechslungsreich."
                                            },
                                            {
                                                "example_id": "ba8a3810-b1e6-44f7-bb1c-ec6f045ee7d2",
                                                "sense_id": "042e757a-83ba-3e21-b629-8f029aef7717",
                                                "text": "Port Moresby ist die Hauptstadt von Papua-Neuguinea."
                                            },
                                            {
                                                "example_id": "7eb5a1aa-0678-4fa5-a403-8bc24ab43a69",
                                                "sense_id": "042e757a-83ba-3e21-b629-8f029aef7717",
                                                "text": "In Papua-Neuguinea werden über 700 verschiedene Sprachen gesprochen."
                                            },
                                            {
                                                "example_id": "bfec6d92-d992-45a5-9880-fbc3beab7535",
                                                "sense_id": "042e757a-83ba-3e21-b629-8f029aef7717",
                                                "text": "„Die größte Sprachenvielfalt findet sich in Afrika und Asien – Spitzenreiter ist Papua-Neuguinea mit 820 Sprachen.“"
                                            },
                                            {
                                                "example_id": "01f608e4-87bb-4882-a5b7-1430a975ff0c",
                                                "sense_id": "042e757a-83ba-3e21-b629-8f029aef7717",
                                                "text": "„Das Territorium Neuguinea wurde 1949 mit dem ehemaligen Britisch-Neuguinea vereinigt und am 16. September 1975 als Papua-Neuguinea unabhängig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
