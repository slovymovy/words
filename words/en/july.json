                    "sense_id": "ca5d2975-c99c-3614-9ee2-161ef5f138a5",
                    "sense_definition": "The seventh month of the Gregorian calendar, following June and preceding August.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "months",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "We are planning to go on vacation in <w>July</w>.",
                            "target_lang_translations": {
                                "ru": "Мы планируем поехать в отпуск в <w>июле</w>.",
                                "nl": "We zijn van plan om in <w>juli</w> op vakantie te gaan.",
                                "pl": "Planujemy wyjechać na wakacje w <w>lipcu</w>.",
                                "de": "Wir planen, im <w>Juli</w> in den Urlaub zu fahren.",
                                "fr": "Nous prévoyons de partir en vacances en <w>juillet</w>.",
                                "it": "Stiamo programmando di andare in vacanza a <w>luglio</w>.",
                                "cs": "Plánujeme jet na dovolenou v <w>červenci</w>.",
                                "tr": "<w>Temmuz</w> ayında tatile çıkmayı planlıyoruz.",
                                "es": "Estamos planeando irnos de vacaciones en <w>julio</w>.",
                                "zh": "我们计划在<w>七月</w>去度假。"
                            }
                        },
                        {
                            "text": "The weather is usually very hot and sunny in <w>July</w>.",
                            "target_lang_translations": {
                                "ru": "Погода в <w>июле</w> обычно очень жаркая и солнечная.",
                                "nl": "Het weer is in <w>juli</w> meestal erg heet en zonnig.",
                                "pl": "Pogoda w <w>lipcu</w> jest zazwyczaj bardzo gorąca i słoneczna.",
                                "de": "Das Wetter ist im <w>Juli</w> normalerweise sehr heiß und sonnig.",
                                "fr": "Le temps est généralement très chaud et ensoleillé en <w>juillet</w>.",
                                "it": "Il tempo a <w>luglio</w> è solitamente molto caldo e soleggiato.",
                                "cs": "Počasí je v <w>červenci</w> obvykle velmi horké a slunečné.",
