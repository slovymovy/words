                "senses": [
                    {
                        "sense_id": "586abdb5-f7a9-36d2-a8bd-b61f7cb7b632",
                        "entry_id": "04095e45-46d1-3cdf-aaaf-e21f3d9b2e35",
                        "glosses": [
                            "спец. связанный, соотносящийся по значению с существительным флуктуация"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e6437c6-ff1d-4cc2-b928-2f5e2a9dd07c",
                                "sense_id": "586abdb5-f7a9-36d2-a8bd-b61f7cb7b632",
                                "text": "В рамках данной терминологии эволюция партийной системы России в 1990—2000-е — это постепенное превращение ее из флуктуационной через периферийную в псевдопартийную."
                            }
                        ]
                    }
                ],
