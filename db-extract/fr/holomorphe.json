                                    {
                                        "sense_id": "899391f3-4ba0-3516-ab05-4131c1de5bb8",
                                        "entry_id": "6cdb1d00-fa6d-36dc-94b9-ac38d11355a0",
                                        "glosses": [
                                            "Complex-differentiable on an open set around every point in its domain."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c73e830-336a-4c62-a899-1e4705fc5c3a",
                                                "sense_id": "899391f3-4ba0-3516-ab05-4131c1de5bb8",
                                                "text": "1998, Stefan-M. Heinemann, Julia Sets in Cⁿ, Hartje Kriete, Progress in Holomorphic Dynamics, Addison Wesley Longman, page 159,\nThe iteration of holomorphic maps of one variable is one of the most lively fields of current mathematical research. Since its beginning in the twenties of this century, the theory of holomorphic endomorphisms of the Riemann sphere (= rational functions) has become well developed."
                                            },
                                            {
                                                "example_id": "e1472c60-de01-43d1-94fd-a54fc348ee58",
                                                "sense_id": "899391f3-4ba0-3516-ab05-4131c1de5bb8",
                                                "text": "1998, Robert Friedman, Algebraic Surfaces and Holomorphic Vector Bundles, Springer, page 303,\nA holomorphic 1-form on X is closed, and so\n0=dη₁=df and η₂."
                                            },
                                            {
                                                "example_id": "4130d741-fbbf-431b-900d-1731caf87af6",
                                                "sense_id": "899391f3-4ba0-3516-ab05-4131c1de5bb8",
                                                "text": "The theory of holomorphic dynamical systems is a subject of increasing interest in mathematics, both for its challenging problems and for its connections with other branches of pure and applied mathematics. A holomorphic dynamical system is the datum of a complex variety and a holomorphic object (such as a self-map or a vector field) acting on it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "531457cf-203e-3e30-a64f-1b4258a33d4d",
                                        "entry_id": "6cdb1d00-fa6d-36dc-94b9-ac38d11355a0",
                                        "glosses": [
                                            "Having holohedral symmetry."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
