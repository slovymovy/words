                        "glosses": [
                            "Primat de l’Église éthiopienne orthodoxe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6937d095-771f-4b3c-8705-e719ab7c0281",
                                "sense_id": "e44a9814-d69f-38af-901b-79ce48d10ec8",
                                "text": "L’Éthiopie, qui a perdu en une semaine deux figures majeures, a enterré hier le patriarche de l’Église orthodoxe éthiopienne, l’« abuna » Paulos, en attendant les funérailles du puissant Premier ministre Meles Zenawi, fixées au 2 septembre."
                            },
                            {
                                "example_id": "41c2401c-9efa-43df-909b-5dd3dc9feb5d",
                                "sense_id": "e44a9814-d69f-38af-901b-79ce48d10ec8",
                                "text": "L’abuna Paulos était depuis 1992 le plus haut dignitaire de l’Église orthodoxe d’Éthiopie."
                            }
                        ]
                    }
