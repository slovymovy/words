                        "glosses": [
                            "The inclusion of the term ὁμοούσιος (homooúsios, “same essence”) in the Nicene Creed to describe the principle that the Son is ‘of one substance’ with the Father (as opposed to the term homo(I)ousion, like in essence)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "23011b3b-7b75-46da-97c4-57957ce83747",
                                "sense_id": "e307cebd-68eb-3dca-89dc-376742221a7b",
                                "text": "The campaign to get rid of the Homoousion from Christian credal statements split the Church in the empire for another half-century and more."
                            }
                        ]
                    }
                ],
