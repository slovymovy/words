                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e795313-8725-4970-a188-33b584440e55",
                                "sense_id": "099030dd-211e-3944-8e15-9528bf8878ad",
                                "text": "Archimedes zastosował praktycznie prawo nazwane jego imieniem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "6d70fc68-58ea-333c-a7e0-563996e58ae8",
                        "entry_id": "6c5cb593-725d-3ca8-b577-11176ad109d5",
                        "glosses": [
                            "mając na względzie praktykę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9078cdc4-87a3-4c7c-9ae9-cccddde6ea2d",
                                "sense_id": "6d70fc68-58ea-333c-a7e0-563996e58ae8",
                                "text": "Teoretycznie powinno się udać, ale praktycznie zbyt dużo może się zepsuć."
                            },
                            {
                                "example_id": "3683d056-b0fc-4d9f-be6d-e8f08c0eee01",
                                "sense_id": "6d70fc68-58ea-333c-a7e0-563996e58ae8",
                                "text": "Podszedł do rzeczy bardzo praktycznie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "247817a2-e942-362b-ae9e-7f02b7c1dbbe",
                        "entry_id": "6c5cb593-725d-3ca8-b577-11176ad109d5",
                        "glosses": [
                            "blisko stanu rzeczywistego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7feec535-bce0-46b7-ad92-0eba6fea1b99",
                                "sense_id": "247817a2-e942-362b-ae9e-7f02b7c1dbbe",
                                "text": "Praktycznie nic o nim nie wiemy."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6bd2926d-aa84-4132-9ac7-465bbff776b2",
                        "source_entry_id": "6c5cb593-725d-3ca8-b577-11176ad109d5",
                        "source_sense_id": "099030dd-211e-3944-8e15-9528bf8878ad",
                        "target_lang_word": "in practice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in practice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80d091ff-ac1e-3e19-bfb7-e54ca6b4f321",
                                        "entry_id": "2befa3dc-0886-38a3-8b5a-8448426566ca",
                                        "glosses": [
                                            "Really, in effect; not just hypothetically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6875d453-c627-4187-9a69-536a75757ab2",
                                                "sense_id": "80d091ff-ac1e-3e19-bfb7-e54ca6b4f321",
                                                "text": "The new tax should have helped the farming community. But in practice farmers generally appear to be worse off than before."
                                            },
                                            {
                                                "example_id": "f0892f0b-cfad-41f7-bcd5-2c43f3e43c77",
                                                "sense_id": "80d091ff-ac1e-3e19-bfb7-e54ca6b4f321",
                                                "text": "12 July 2012, Sam Adams, AV Club Ice Age: Continental Drift\nOn paper, Continental Drift boasts a jaw-dropping voice cast, including but not limited to Jennifer Lopez, Patrick Stewart, Wanda Sykes, Aziz Ansari, Simon Pegg, Nick Frost, Nicki Minaj, Drake, and Alan Tudyk. But in practice, the overstuffed ensemble leaves the cast no room to distinguish themselves, and directors Steve Martino and Michael Thurmeier don’t seem interested in coaxing performances that might render their money stars less identifiable."
                                            },
                                            {
                                                "example_id": "b17ddf9c-5206-42b0-a051-f0fcdb3f4f25",
                                                "sense_id": "80d091ff-ac1e-3e19-bfb7-e54ca6b4f321",
                                                "text": "The DfT has yet to announce how the regulations will work in practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c5350d-3107-3d46-92ed-edd5bb352882",
                                        "entry_id": "2befa3dc-0886-38a3-8b5a-8448426566ca",
                                        "glosses": [
                                            "Regularly practising an activity so as to remain skilled in it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e69a0f31-82f1-46c2-8861-b8362285c1e1",
                        "source_entry_id": "6c5cb593-725d-3ca8-b577-11176ad109d5",
                        "source_sense_id": "6d70fc68-58ea-333c-a7e0-563996e58ae8",
                        "target_lang_word": "pragmatically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pragmatically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce56ebf2-f97e-352e-bcaf-5a1e856096de",
                                        "entry_id": "5cf58fc0-a3f6-3072-ab24-d9c03b7ef02b",
                                        "glosses": [
                                            "In a pragmatic manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81b89f5f-642b-4a0e-8882-d06efb1b4f5e",
                                                "sense_id": "ce56ebf2-f97e-352e-bcaf-5a1e856096de",
                                                "text": "\"Well, there's no use crying over spilt milk,\" she said pragmatically."
                                            },
                                            {
                                                "example_id": "af95dcc7-2a77-4a3c-838f-261cc8ab56c4",
                                                "sense_id": "ce56ebf2-f97e-352e-bcaf-5a1e856096de",
                                                "text": "To be pragmatically determined, it must be the case that the expression does not contribute new information to the structure of the discourse except as an unremarkable scenesetter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a31dc96-03ce-3339-9164-2b755f8e694d",
                                        "entry_id": "5cf58fc0-a3f6-3072-ab24-d9c03b7ef02b",
                                        "glosses": [
                                            "In terms of pragmatics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb0864ba-d2ed-454f-974b-8a071f9c5089",
                                                "sense_id": "4a31dc96-03ce-3339-9164-2b755f8e694d",
                                                "text": "a pragmatically irrelevant proposition"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a196c43-df34-4fb1-9b5e-db0b0a76def6",
                        "source_entry_id": "6c5cb593-725d-3ca8-b577-11176ad109d5",
                        "source_sense_id": "6d70fc68-58ea-333c-a7e0-563996e58ae8",
                        "target_lang_word": "sensibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f03c9ca5-ce1f-3bc0-bba4-751b1717a2ff",
                                        "entry_id": "0d04ac0c-03b3-3aed-b58b-0654077d7767",
                                        "glosses": [
                                            "In a sensible manner; in a way that shows good sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16041be3-e7f3-40d0-bd68-3bbc7a55fc70",
                                                "sense_id": "f03c9ca5-ce1f-3bc0-bba4-751b1717a2ff",
                                                "text": "[...] but in the damp conditions prevailing the driver sensibly was unwilling to attempt the climb up through Combe Down tunnel without help, for fear of slipping to a standstill in the unventilated bore, [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                        "entry_id": "0d04ac0c-03b3-3aed-b58b-0654077d7767",
                                        "glosses": [
                                            "In a way that can be sensed or noticed; perceptibly."
                                        ],
                                        "tags": [
                                            "dated",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0535de8-566a-4ef8-9507-513557676fae",
                                                "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                                "text": "Time sensibly all things impairs."
                                            },
                                            {
                                                "example_id": "5d683efa-603e-400f-8e0d-c073cdabf9a6",
                                                "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                                "text": "This four months' lastingness would doubtless be sensibly reduced if the tent were subject to numerous transportations and repitchings."
                                            },
                                            {
                                                "example_id": "2c04e4d6-15fa-4162-83e6-4fd4e2b6752a",
                                                "sense_id": "ebbeb148-4161-3ff4-8ab5-96d5e791ec47",
                                                "text": "4. P. californicum n. sp.\nVery similar in color and sculpture to seriatum. The form is, however, sensibly narrower, averaging very nearly two and one half times as long as wide, while in seriatum the length is ahout two and three- tenths times the width."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d6a1ae6-8220-4911-b1be-1d91177bc993",
                        "source_entry_id": "6c5cb593-725d-3ca8-b577-11176ad109d5",
                        "source_sense_id": "247817a2-e942-362b-ae9e-7f02b7c1dbbe",
                        "target_lang_word": "virtually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virtually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8562c707-d227-3583-a389-518fd82ef695",
                                        "entry_id": "cae5358a-8de4-3009-8438-b5525657cf59",
                                        "glosses": [
                                            "Almost but not quite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b870e2-392f-47ed-8310-0260cd1e0b8d",
                                                "sense_id": "8562c707-d227-3583-a389-518fd82ef695",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            },
                                            {
                                                "example_id": "b8357bbb-f856-41f8-994d-1a58696684f0",
                                                "sense_id": "8562c707-d227-3583-a389-518fd82ef695",
                                                "text": "With our Medicare supplemental insurance plan, there are virtually no claim forms to fill out. (Advertisement)"
                                            },
                                            {
                                                "example_id": "7e0103a8-4243-46b2-a463-0571b5e1a83b",
                                                "sense_id": "8562c707-d227-3583-a389-518fd82ef695",
                                                "text": "By surviving the first six minutes Hargreaves matched the total amount of playing time he had managed previously in virtually three years - and by scoring his first goal since April 2008 he set the hosts on their way to a fifth win of the season in all competitions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ab215d8-141f-3641-b7ba-6cbf9b3955cb",
                                        "entry_id": "cae5358a-8de4-3009-8438-b5525657cf59",
                                        "glosses": [
                                            "In essence or functionally, but not in fact, formally, or technically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f89d1ec2-2a43-4655-955e-be4b7117748e",
                                                "sense_id": "4ab215d8-141f-3641-b7ba-6cbf9b3955cb",
                                                "text": "virtually a member of the family"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e31d97-1fde-3394-a19a-fe16171806a4",
                                        "entry_id": "cae5358a-8de4-3009-8438-b5525657cf59",
                                        "glosses": [
                                            "Of a subgroup of finite index."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573e399b-e0dd-4ca9-82dd-9bacb73f5a8e",
                                                "sense_id": "75e31d97-1fde-3394-a19a-fe16171806a4",
                                                "text": "In this case W has a diagram with 2 vertices and one edge labelled ∞, and is therefore the infinite dihedral group. Thus W is virtually ℤ."
                                            },
                                            {
                                                "example_id": "9252668c-1bb8-4b38-af40-2cc902859eba",
                                                "sense_id": "75e31d97-1fde-3394-a19a-fe16171806a4",
                                                "text": "In this paper, we are mainly concerned with homogeneity in the class of finitely generated virtually free groups, i.e. finitely generated groups with a free subgroup of finite index."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94d1625c-ae09-3d66-955d-20441961d9b5",
                                        "entry_id": "cae5358a-8de4-3009-8438-b5525657cf59",
                                        "glosses": [
                                            "Of a covering space of finite degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3288530f-1f0a-4482-81e5-43971c24e0c1",
                                                "sense_id": "94d1625c-ae09-3d66-955d-20441961d9b5",
                                                "text": "Another class of small manifolds consists of those that are not virtually Haken (a manifold is virtually Haken if it is finitely covered by a Haken manifold)."
                                            },
                                            {
                                                "example_id": "a312e733-2e8b-42d8-9c38-fdbc8c66d59c",
                                                "sense_id": "94d1625c-ae09-3d66-955d-20441961d9b5",
                                                "text": "We call a hyperplane Y in a VH-complex X virtually clean if there exists a finite-sheeted covering map p : X̂ → X and a connected component Y ⊆ p⁻¹Y such that the hyperplane Ŷ of X̂ is clean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bf5cbd7-bd88-33d6-90e0-2ea4a934c8c5",
                                        "entry_id": "cae5358a-8de4-3009-8438-b5525657cf59",
                                        "glosses": [
                                            "By computer or in cyberspace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "626ed192-0278-4004-8e2f-ea50433e4e85",
                        "source_entry_id": "6c5cb593-725d-3ca8-b577-11176ad109d5",
                        "source_sense_id": "247817a2-e942-362b-ae9e-7f02b7c1dbbe",
                        "target_lang_word": "practically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "practically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb121b7-b36a-3847-9096-12ef9bc6b9fc",
                                        "entry_id": "d985ef6b-1c98-3bed-b521-f7f1c4e48310",
                                        "glosses": [
                                            "In practice; in effect or in actuality, though possibly not officially, technically, or legally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58eedebc-1893-47b8-ba06-5ef4570ae4bf",
                                                "sense_id": "dcb121b7-b36a-3847-9096-12ef9bc6b9fc",
                                                "text": "Stalin was not technically or legally the head of state but was practically so."
                                            },
                                            {
                                                "example_id": "8f2e31a4-a707-482f-a60e-a2b1f5c5fa8e",
                                                "sense_id": "dcb121b7-b36a-3847-9096-12ef9bc6b9fc",
                                                "text": "It is true that the Articles of the [Argentine] Constitution promise fair conditions under which to live; but, unfortunately, the self-same Constitution, in the hands of unscrupulous administrators, becomes so elastic as to be practically a dead letter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84eb8cf-e158-3686-b8b1-0a082d5f3f15",
                                        "entry_id": "d985ef6b-1c98-3bed-b521-f7f1c4e48310",
                                        "glosses": [
                                            "Almost completely; almost entirely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98508d96-ce42-498c-b79d-0208494f2134",
                                                "sense_id": "c84eb8cf-e158-3686-b8b1-0a082d5f3f15",
                                                "text": "Near-synonyms: effectively, nearly, virtually"
                                            },
                                            {
                                                "example_id": "79761099-f465-4e4d-bb99-cd243a4c8616",
                                                "sense_id": "c84eb8cf-e158-3686-b8b1-0a082d5f3f15",
                                                "text": "He was practically uneducated, barely able to read and write a simple sentence."
                                            },
                                            {
                                                "example_id": "979bfadb-224a-487a-a649-27b262edbe5b",
                                                "sense_id": "c84eb8cf-e158-3686-b8b1-0a082d5f3f15",
                                                "text": "If the ranchero had practically all the water near him, he had also practically all the cattle, […]"
                                            },
                                            {
                                                "example_id": "514006b8-9ebd-43e9-87c9-f2877c542e73",
                                                "sense_id": "c84eb8cf-e158-3686-b8b1-0a082d5f3f15",
                                                "text": "The turnip is one of the lordliest vegetables in the world; its broth is practically a soup in itself."
                                            },
                                            {
                                                "example_id": "98c22593-8b3e-4b1e-8083-a35bfd71af66",
                                                "sense_id": "c84eb8cf-e158-3686-b8b1-0a082d5f3f15",
                                                "text": "The first summer on record that melts practically all of the Arctic’s floating sea ice could occur as early as the 2030s, according to a new scientific study — about a decade sooner than researchers previously predicted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a21beaf8-97be-3d95-9e4b-f4e072a08d1b",
                                        "entry_id": "d985ef6b-1c98-3bed-b521-f7f1c4e48310",
                                        "glosses": [
                                            "With respect to practices or a practice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72c79ada-ae65-43a8-ba56-a2a69e75039e",
                                                "sense_id": "a21beaf8-97be-3d95-9e4b-f4e072a08d1b",
                                                "text": "He wasn't very good with words or numbers; he was more of a practically minded person"
                                            },
                                            {
                                                "example_id": "e250f717-9749-4c73-a3e6-0c67a68e50b2",
                                                "sense_id": "a21beaf8-97be-3d95-9e4b-f4e072a08d1b",
                                                "text": "He was practically educated and lacked theoretical depth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c01b51d7-67a6-333f-b4f0-b0ba53c645b9",
                                        "entry_id": "d985ef6b-1c98-3bed-b521-f7f1c4e48310",
                                        "glosses": [
                                            "In a way that is practical: feasibly; unchallengingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d194d456-d6f5-4262-8322-37f859fc9fbb",
                                                "sense_id": "c01b51d7-67a6-333f-b4f0-b0ba53c645b9",
                                                "text": "practically achievable"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31a50796-f8ae-4bd4-83e8-699d65c62723",
                        "source_entry_id": "6c5cb593-725d-3ca8-b577-11176ad109d5",
                        "source_sense_id": "247817a2-e942-362b-ae9e-7f02b7c1dbbe",
                        "target_lang_word": "almost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "almost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                        "entry_id": "43234f26-4a18-3e53-b9b9-77fafb9171f4",
                                        "glosses": [
                                            "Very close to, but not quite."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d58d07f-6b30-4f31-8577-3d020494e3a7",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "Almost all people went there."
                                            },
                                            {
                                                "example_id": "b84d6eea-bdbc-4a6a-9054-4da7f3390568",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "We almost missed the train."
                                            },
                                            {
                                                "example_id": "20643536-7061-49b2-82cc-63f358b0fd42",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "Nobody, or almost, noticed anything unusual."
                                            },
                                            {
                                                "example_id": "935e3112-e8d4-4430-8f52-95e4a5165a32",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            },
                                            {
                                                "example_id": "31f647d4-aaee-47c1-a3f0-f5ee4c81503d",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything. In a moment she had dropped to the level of a casual labourer."
                                            },
                                            {
                                                "example_id": "241f62ba-1422-4343-97ee-975f405ec9bf",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "Eustace gaped at him in amazement. When his urbanity dropped away from him, as now, he had an innocence of expression which was almost infantile. It was as if the world had never touched him at all."
                                            },
                                            {
                                                "example_id": "d553541e-4db9-45c8-ab67-77b743d761f5",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "For some odd reason, Sherin has chosen to direct the play as a comedy — at times almost a farce."
                                            },
                                            {
                                                "example_id": "4949e741-6c56-4f13-a87e-08cc091a50d8",
                                                "sense_id": "197e37d5-b0ef-382f-a7eb-7ffe5584e158",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. […] The public realm is privatised, the regulations restraining the ultra-wealthy and the companies they control are abandoned, and Edwardian levels of inequality are almost fetishised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b60ea10-d68a-36c1-a569-6469c07ad6a2",
                                        "entry_id": "43234f26-4a18-3e53-b9b9-77fafb9171f4",
                                        "glosses": [
                                            "Up to, except for a negligible set (where negligible is not universally but contextually defined)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e36fe8c7-f16c-4a14-8db5-ac974072c0fb",
                                                "sense_id": "6b60ea10-d68a-36c1-a569-6469c07ad6a2",
                                                "text": "almost all"
                                            },
                                            {
                                                "example_id": "03656ee6-b498-4c25-aefd-fb1b9d51663d",
                                                "sense_id": "6b60ea10-d68a-36c1-a569-6469c07ad6a2",
                                                "text": "almost no"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                        "entry_id": "43234f26-4a18-3e53-b9b9-77fafb9171f4",
                                        "glosses": [
                                            "Up to, except for a negligible set (where negligible is not universally but contextually defined).",
                                            "Up to a null set; except for a set of measure 0."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606d69aa-15d8-42dc-8347-7729463808e9",
                                                "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                                "text": "almost everywhere"
                                            },
                                            {
                                                "example_id": "6f9ee126-fc5b-492f-aa07-74854cdac874",
                                                "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                                "text": "almost nowhere"
                                            },
                                            {
                                                "example_id": "f657da0d-b542-4694-8ea3-694050efc4b8",
                                                "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                                "text": "almost certain"
                                            },
                                            {
                                                "example_id": "c7b90752-4e78-464f-a44f-a13f49e3d24c",
                                                "sense_id": "55cffd57-7700-37fe-ad6b-4fab29491638",
                                                "text": "almost sure"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "almost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d90a62f8-953c-357e-8d92-1d180887c075",
                                        "entry_id": "8e9a092b-f7a4-3197-ab76-6b3b5d14390c",
                                        "glosses": [
                                            "Something or someone that doesn't quite make it."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c277477e-c93c-4eb5-bbdf-c61c72d42b21",
                                                "sense_id": "d90a62f8-953c-357e-8d92-1d180887c075",
                                                "text": "In all the submissions, they found four papers that were clearly worth publishing and another dozen almosts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
