{
    "word_family": [
        "chumpy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "100e3fd3-d56c-363c-be84-2c7e06090b97",
                    "sense_definition": "An incompetent or foolish person.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foolish_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That <w>chump</w> has no idea how to fix the broken machine.",
                            "target_lang_translations": {
                                "cs": "Ten <w>trouba</w> nemá ani tušení, jak opravit ten rozbitý stroj."
                            }
                        },
                        {
                            "text": "Do not listen to that <w>chump</w> because he does not know what he is talking about.",
                            "target_lang_translations": {
                                "cs": "Neposlouchej toho <w>troubu</w>, protože vůbec neví, o čem mluví."
                            }
                        }
                    ],
                    "synonyms": [
                        "blockhead",
                        "idiot",
                        "dope",
                        "dolt",
                        "dunce",
                        "dummy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a foolish person."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Neschopný nebo hloupý člověk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "trouba",
                                "target_lang_sense_clarification": "hovorové označení pro hloupého člověka"
                            },
                            {
                                "target_lang_word": "trdlo",
                                "target_lang_sense_clarification": "hovorové označení pro nešikovného nebo hloupého člověka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ffbe386-73e9-31e1-b702-726086e750d3",
                    "sense_definition": "A person who is easily tricked or taken advantage of.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foolish_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman thought he could trick the <w>chump</w> into buying the expensive car.",
                            "target_lang_translations": {
                                "cs": "Prodejce si myslel, že toho <w>naivu</w> snadno napálí, aby si koupil to drahé auto."
                            }
                        },
                        {
                            "text": "He felt like a total <w>chump</w> after realizing he had been cheated out of his money.",
                            "target_lang_translations": {
                                "cs": "Cítil se jako úplný <w>hlupák</w>, když si uvědomil, že ho připravili o peníze."
                            }
                        }
                    ],
                    "synonyms": [
                        "gull",
                        "sucker",
                        "dupe",
                        "sap",
                        "dummy",
                        "patsy",
                        "pigeon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a gullible person."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Člověk, kterého lze snadno oklamat nebo zneužít."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "naiva",
                                "target_lang_sense_clarification": "člověk, který se nechá snadno napálit"
                            },
                            {
                                "target_lang_word": "oběť",
                                "target_lang_sense_clarification": "osoba, která se stala terčem podvodu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "123aa881-46f2-374e-8044-16b928c4bce9",
                    "sense_definition": "The thick end of a piece of wood or meat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher cut a thick <w>chump</w> of meat for the stew.",
                            "target_lang_translations": {
                                "cs": "Řezník ukrojil tlustý <w>kus</w> masa na guláš."
                            }
                        },
                        {
                            "text": "He grabbed the <w>chump</w> end of the log to carry it to the fire.",
                            "target_lang_translations": {
                                "cs": "Popadl <w>špalek</w> za konec, aby ho odnesl k ohni."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Tlustý konec kusu dřeva nebo masa."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "špalek",
                                "target_lang_sense_clarification": "silný kus dřeva"
                            },
                            {
                                "target_lang_word": "kus",
                                "target_lang_sense_clarification": "obecné označení pro větší část masa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e9c2c3e-4a74-3c55-8524-7987c4e0b26c",
                    "sense_definition": "A person's head or face.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a hard hit right to the <w>chump</w> during the boxing match.",
                            "target_lang_translations": {
                                "cs": "Během boxerského zápasu dostal tvrdou ránu přímo do <w>palice</w>."
                            }
                        },
                        {
                            "text": "She wiped the dirt off her <w>chump</w> after falling in the garden.",
                            "target_lang_translations": {
                                "cs": "Poté, co upadla na zahradě, si otřela špínu z <w>obličeje</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Very informal or dated slang for head."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hlava nebo obličej člověka."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "palice",
                                "target_lang_sense_clarification": "slangové označení pro hlavu"
                            },
                            {
                                "target_lang_word": "ciferník",
                                "target_lang_sense_clarification": "slangové označení pro obličej"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d6ccb089-a880-36ca-ab2b-e885a663e8f2",
                    "sense_definition": "To trick or swindle someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They tried to <w>chump</w> the tourists by selling them fake tickets.",
                            "target_lang_translations": {
                                "cs": "Pokusili se <w>napálit</w> turisty tím, že jim prodali falešné lístky."
                            }
                        },
                        {
                            "text": "Do not let them <w>chump</w> you out of your hard-earned savings.",
                            "target_lang_translations": {
                                "cs": "Nenech se od nich <w>obrat</w> o své těžce vydělané úspory."
                            }
                        }
                    ],
                    "synonyms": [
                        "chump off"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal verb usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Někoho oklamat nebo podvést."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "napálit",
                                "target_lang_sense_clarification": "někoho podvést nebo oklamat"
                            },
                            {
                                "target_lang_word": "obrat",
                                "target_lang_sense_clarification": "někoho připravit o peníze podvodem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e2eceaa-39d4-3e92-b579-44f4f1883e3a",
                    "sense_definition": "To chew food noisily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry dog was <w>chumping</w> on a large bone in the yard.",
                            "target_lang_translations": {
                                "cs": "Hladový pes na dvoře hlasitě <w>žvýkal</w> velkou kost."
                            }
                        },
                        {
                            "text": "He sat there <w>chumping</w> his food loudly while watching television.",
                            "target_lang_translations": {
                                "cs": "Seděl tam a u televize hlasitě <w>žvýkal</w> jídlo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "An older form of the word chomp."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Hlučně žvýkat jídlo."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žvýkat",
                                "target_lang_sense_clarification": "pohybovat čelistmi při jídle"
                            },
                            {
                                "target_lang_word": "chroupat",
                                "target_lang_sense_clarification": "hlučně kousat tvrdé jídlo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}