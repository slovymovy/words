                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mayers"
                    },
                    {
                        "form_id": "910ac9bc-1e24-49df-916d-708c5ff18c4a",
                        "entry_id": "360cb9ea-1432-320a-acb6-e0a662535810",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mayer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                        "entry_id": "360cb9ea-1432-320a-acb6-e0a662535810",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname mit häufigem Vorkommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15206e72-b5c9-4acf-b8e8-e366998082a1",
                                "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                                "text": "Vorhin hat ein Herr Mayer mit A Y angerufen und bittet um Rückruf."
                            },
                            {
                                "example_id": "facc5f5c-728a-4f20-aa55-37f022d0eb90",
                                "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                                "text": "Abfahrts-Olympiasieger Matthias Mayer verzichtet auf den alpinen Saisonstart in Sölden."
                            },
                            {
                                "example_id": "86a7c4f2-5c51-488d-87c3-0e9d7f9ecacb",
                                "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                                "text": "Frau Mayer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "65ef29d5-b657-40c9-bc9d-9b7ee9945c3e",
                                "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                                "text": "Herr Mayer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "303dc917-af93-4451-a0b9-91d68b7a869d",
                                "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                                "text": "Die Mayers fahren heute ins Allgäu."
                            },
                            {
                                "example_id": "5d1eb41b-023e-4c97-8e94-8277eb032090",
                                "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                                "text": "Der Mayer trägt nie die Schals, die die Mayer ihm strickt."
                            },
                            {
                                "example_id": "6848ad2c-f835-4bb3-9d9a-f1c5d8cee957",
                                "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mayer kommt, geht der Herr Mayer.“"
                            },
                            {
                                "example_id": "ed386863-5de0-43cc-b1a2-d2eba37260a2",
                                "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                                "text": "Mayer kommt und geht."
                            },
                            {
                                "example_id": "c25790b9-08b2-431a-862d-a821042468d2",
                                "sense_id": "f9d7516b-27d1-3dfe-94da-3f970e42c8f5",
                                "text": "Mayers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
