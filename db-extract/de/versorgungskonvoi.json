                        "examples": [
                            {
                                "example_id": "dd69dacd-7ec9-4802-81ec-e40c089ce1ca",
                                "sense_id": "3e9bcfe6-48c7-3d3b-90eb-ff130659dfea",
                                "text": "„Hinter ihnen rumpelte ein amerikanischer Versorgungskonvoi heran, und Bassam ging wie alle Iraker vom Gas, um die schießfreudigen US-Soldaten vorbeizulassen.“"
                            },
                            {
                                "example_id": "9e84f42c-e79e-4e90-b46d-982ed13acd4b",
                                "sense_id": "3e9bcfe6-48c7-3d3b-90eb-ff130659dfea",
                                "text": "„Der Lastwagenfahrer Alex Morrison aus Liverpool war in einem Versorgungskonvoi von Haifa nach Safed unterwegs.“"
                            },
                            {
                                "example_id": "29a42e0f-70fb-4bb6-96fd-359ecc0e7b06",
                                "sense_id": "3e9bcfe6-48c7-3d3b-90eb-ff130659dfea",
                                "text": "„Wir halfen, Versorgungskonvois in die Luft zu jagen, und nahmen das gelegentliche Arschloch unter Beschuss, das sich zu weit aus der Deckung wagte.“"
                            }
                        ],
