                "senses": [
                    {
                        "sense_id": "cd13720a-6534-3efb-91c1-2f07121717a4",
                        "entry_id": "65472304-4150-3368-a91d-0faac788e1a6",
                        "glosses": [
                            "Déclarer inconstitutionnel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99bf23d7-955f-454f-81df-b8a986f8fd10",
                                "sense_id": "cd13720a-6534-3efb-91c1-2f07121717a4",
                                "text": "Et on sait comment, sur ce fondement, le Tribunal Constitutionnel de l’Allemagne Fédérale s’est considéré comme porteur de légitimité pour inconstitutionnaliser une loi qui permettait l’interruption de la grossesse d'après la solution dite des «délais»."
                            },
                            {
                                "example_id": "1799e669-a231-4921-95e3-30317d11cd03",
                                "sense_id": "cd13720a-6534-3efb-91c1-2f07121717a4",
                                "text": "Écoutez, M. le ministre, toutes les lois ont été étudiées, mais il y en a de temps en temps qui sont inconstitutionnalisées pareil."
                            }
                        ]
                    }
