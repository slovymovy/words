                    {
                        "translation_id": "f72e7d1e-67d6-46b6-9705-ee0c728ef64c",
                        "source_entry_id": "d25de0b6-cb76-3937-8b42-bbeb9184c974",
                        "source_sense_description": "intense muscular contraction",
                        "target_lang_word": "Krampf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad12d28-5ab7-31b3-95d5-f454de8f984f",
                                        "entry_id": "875641da-1c1c-3fa9-9fbd-d6f968e1180a",
                                        "glosses": [
                                            "ungewollte starke Muskelanspannung, die mit sehr großen Schmerzen verbunden sein kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "212a599e-1dbf-4c77-90ab-43d72e6ed6b9",
                                                "sense_id": "8ad12d28-5ab7-31b3-95d5-f454de8f984f",
                                                "text": "Bei einem Krampf hilft manchmal Massieren."
                                            },
                                            {
                                                "example_id": "6f9ec9e1-4ec3-4769-baf4-9e62bbc8a9d2",
                                                "sense_id": "8ad12d28-5ab7-31b3-95d5-f454de8f984f",
                                                "text": "„Ich glaubte, sie geheilt zu haben; doch am nächsten Tage befielen die Krämpfe ihr Gehirn.“"
                                            },
                                            {
                                                "example_id": "d043a3b2-a316-4c8d-ab47-e3c72d139d21",
                                                "sense_id": "8ad12d28-5ab7-31b3-95d5-f454de8f984f",
                                                "text": "„Ravic konnte sehen, wie die Wellen der Krämpfe durch sie gingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "912a9d14-e8c0-3050-878f-81ad65f406ff",
                                        "entry_id": "875641da-1c1c-3fa9-9fbd-d6f968e1180a",
                                        "glosses": [
                                            "erfolglose oder unverhältnismäßige Bemühung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "912084f1-8d56-448e-bbae-d4a7f30e4f03",
                                                "sense_id": "912a9d14-e8c0-3050-878f-81ad65f406ff",
                                                "text": "Das Spiel war ein einziger Krampf."
                                            },
                                            {
                                                "example_id": "1dd2d1ff-b1b8-4cf3-8124-810a5e7602ae",
                                                "sense_id": "912a9d14-e8c0-3050-878f-81ad65f406ff",
                                                "text": "„So ein Krampf passiert doch täglich.“"
                                            },
                                            {
                                                "example_id": "8ef69415-d43e-4b25-a194-15a870ff1f03",
                                                "sense_id": "912a9d14-e8c0-3050-878f-81ad65f406ff",
                                                "text": "„ERG [Ethik, Religionen, Gesellschaft]: Der grosse Krampf mit einem Schulfach."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e91bac23-b7d5-3910-b823-253d913ca76e",
                                        "entry_id": "875641da-1c1c-3fa9-9fbd-d6f968e1180a",
                                        "glosses": [
                                            "harte Arbeit, mühselige Anstrengung"
                                        ],
                                        "tags": [
                                            "Swiss Standard German",
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02255754-21fc-45f1-a5ba-b4390bb333a8",
                                                "sense_id": "e91bac23-b7d5-3910-b823-253d913ca76e",
                                                "text": "„Mit Krampf zum Sieg – GC gewinnt in Thun 2:0.“"
                                            },
                                            {
                                                "example_id": "a347c762-d437-4198-a922-fbceae154999",
                                                "sense_id": "e91bac23-b7d5-3910-b823-253d913ca76e",
                                                "text": "„Jeder Match, jedes Training war ein Krampf.“"
                                            },
                                            {
                                                "example_id": "dd445916-9018-48da-bd94-ebdeeb25f2c9",
                                                "sense_id": "e91bac23-b7d5-3910-b823-253d913ca76e",
                                                "text": "„Das Bschütte [= Ausführen von Gülle] ist ein Krampf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6a6b351-7e11-4fe6-82fc-57971c78c1c5",
