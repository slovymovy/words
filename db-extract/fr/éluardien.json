                        "glosses": [
                            "Propre ou relatif à Paul Éluard et à son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b481a8c7-1d3f-4d49-876b-d051a7c6715e",
                                "sense_id": "4b4b1efd-8af5-308c-aa2b-13c5fd75a01d",
                                "text": "Et nous commentions alors ainsi cette liberté de la poésie éluardienne, qui a pour principe un moment sans antériorité, purement discontinu, qui semble jaillir au centre isolé de toute poésie de l'auteur."
                            },
                            {
                                "example_id": "e52d465f-b9a8-4403-bf6e-54f855493a51",
                                "sense_id": "4b4b1efd-8af5-308c-aa2b-13c5fd75a01d",
                                "text": "Née en 1906, à Mulhouse, Nusch est figurante au Grand Guignol. Elle devient à son tour la compagne et l’inspiratrice du chant éluardien durant dix-sept années toujours plus claires."
                            },
                            {
                                "example_id": "37bd2e6d-08a2-4828-bdc0-43eeb56949d4",
                                "sense_id": "4b4b1efd-8af5-308c-aa2b-13c5fd75a01d",
                                "text": "J.-Ch. Gateau note le caractère « élémentaire », dans tous les sens du terme, du vocabulaire éluardien."
                            }
                        ]
                    }
