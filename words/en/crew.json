                },
                {
                    "sense_id": "a50c7bf0-77ea-3e3d-8d01-ec89669dd3d0",
                    "sense_definition": "A single member of a group operating a vessel or facility (often used as a plural count noun).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Three <w>crew</w> were injured during the storm.",
                            "target_lang_translations": {
                                "ru": "Трое <w>членов экипажа</w> пострадали во время шторма.",
                                "tr": "Fırtına sırasında üç <w>mürettebat üyesi</w> yaralandı.",
                                "zh": "风暴中有三名<w>船员</w>受伤。"
                            }
                        },
                        {
                            "text": "The captain and five <w>crew</w> abandoned the ship.",
                            "target_lang_translations": {
                                "ru": "Капитан и пятеро <w>членов команды</w> покинули корабль.",
                                "tr": "Kaptan ve beş <w>mürettebat</w> gemiyi terk etti.",
                                "zh": "船长和五名<w>船员</w>弃船逃生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crewmember",
                        "member"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельные члены группы, управляющей судном или объектом (часто используется как исчисляемое существительное во множественном числе).",
                        "tr": "Gemi, uçak vb. bir taşıtta veya tesiste görevli birey ya da kişiler.",
                        "zh": "指操作船只或设施的群体中的单个成员。"
                    },
