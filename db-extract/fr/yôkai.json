                "senses": [
                    {
                        "sense_id": "bccb2b71-474a-3486-ad78-fb1a1965da70",
                        "entry_id": "e9addf2b-a5f5-396b-86ed-2cc3e74c327a",
                        "glosses": [
                            "Entité surnaturelle transmise dans le folklore populaire, provoquant des phénomènes surpassant la rationalité humaine."
                        ],
                        "tags": [
                            "Mythologie japonaise"
                        ],
                        "examples": [
                            {
                                "example_id": "37c083a0-03ca-428f-b6c8-8d8797f92e9a",
                                "sense_id": "bccb2b71-474a-3486-ad78-fb1a1965da70",
                                "text": "Des représentations de yôkai visibles sur des estampes datant de l’époque Edo montrent bien à quel point cette culture des esprits, fantômes, monstres, démons, divinités mineures, etc. — autant de figures différentes du yôkai — est présente dans la culture japonaise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fad0375b-966a-4704-8b86-d1fac94dd99c",
                        "source_entry_id": "e9addf2b-a5f5-396b-86ed-2cc3e74c327a",
                        "source_sense_id": "bccb2b71-474a-3486-ad78-fb1a1965da70",
                        "target_lang_word": "yokai",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yokai",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64ab6836-5d39-3f4c-972a-16bcf3062e5b",
                                        "entry_id": "3885d643-fc12-38af-bb16-06451f36dde3",
                                        "glosses": [
                                            "Any of various supernatural monsters, sometimes shapeshifters, in Japanese folklore."
                                        ],
                                        "tags": [
                                            "Japanese"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4703b712-a246-4d55-8e99-ad14176a2100",
                                                "sense_id": "64ab6836-5d39-3f4c-972a-16bcf3062e5b",
                                                "text": "Earl didn’t know all the details about what that type of yokais’ powers were, her mother kept the family secrets close to the vest, and he knew even less about which of those powers had gotten passed onto her half-human offspring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c9df749-2cf2-4c29-ae07-7c9f134f20fd",
                        "source_entry_id": "e9addf2b-a5f5-396b-86ed-2cc3e74c327a",
                        "source_sense_id": "bccb2b71-474a-3486-ad78-fb1a1965da70",
                        "target_lang_word": "妖怪",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "妖怪",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "a158356d-ff29-39ae-9e3b-2e24b3b5e1ff",
                                        "entry_id": "4b0792d4-6783-3892-9894-483421cb6058",
                                        "glosses": [
                                            "超自然的存在；怪異而害人的精怪；植物或動物變化而成的精怪"
                                        ],
                                        "tags": [
                                            "常用在中國神話"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88cd5d07-b13d-4022-9d1a-18719ab005df",
                                                "sense_id": "a158356d-ff29-39ae-9e3b-2e24b3b5e1ff",
                                                "text": "久之，宮中數有妖怪，王以問遂，遂以為有大憂，宮室將空。"
                                            },
                                            {
                                                "example_id": "395e0bfe-b586-4af1-855a-d3a7d5031c47",
                                                "sense_id": "a158356d-ff29-39ae-9e3b-2e24b3b5e1ff",
                                                "text": "久之，宫中数有妖怪，王以问遂，遂以为有大忧，宫室将空。"
                                            },
                                            {
                                                "example_id": "25a9a073-c23a-4bed-acc0-483f72454c8b",
                                                "sense_id": "a158356d-ff29-39ae-9e3b-2e24b3b5e1ff",
                                                "text": "師父，你面前這個女子，莫當做個好人。他是一個妖怪，要來騙你哩。"
                                            },
                                            {
                                                "example_id": "5cafb3e0-e7d7-4af8-b8f6-e14d881d8a40",
                                                "sense_id": "a158356d-ff29-39ae-9e3b-2e24b3b5e1ff",
                                                "text": "师父，你面前这个女子，莫当做个好人。他是一个妖怪，要来骗你哩。"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
