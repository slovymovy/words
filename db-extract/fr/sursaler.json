                ],
                "senses": [
                    {
                        "sense_id": "7f08e7dc-2f0e-30ad-9a3d-fde4d239e674",
                        "entry_id": "9c92be78-0266-35ad-bbde-4dfb033b8dd5",
                        "glosses": [
                            "Saler de façon excessive, ou plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9332851c-6920-4306-92be-84b386c25445",
                                "sense_id": "7f08e7dc-2f0e-30ad-9a3d-fde4d239e674",
                                "text": "Les industriels ont souvent tendance à sursaler leurs plats cuisinés."
                            },
                            {
                                "example_id": "dcd28cc2-3c33-49fd-b3ee-cf22a874bb32",
                                "sense_id": "7f08e7dc-2f0e-30ad-9a3d-fde4d239e674",
                                "text": "Ne sait-on pas que l’on peut, jusqu’à un certain point, sursaler le bouillon en raison de la quantité de légumes qui y sont ajoutés et qui absorbent le sel en excès ?"
                            },
                            {
                                "example_id": "f8816423-5755-4331-827c-5983af2e8ecd",
                                "sense_id": "7f08e7dc-2f0e-30ad-9a3d-fde4d239e674",
                                "text": "Si l’on obtient que l’industrie agro-alimentaire cesse de “sursaler” et de “sursucrer” ses produits, il va bien falloir remplacer le sel et le sucre par autre chose."
                            },
                            {
                                "example_id": "18530c45-8baf-4176-a774-da887ed08be6",
                                "sense_id": "7f08e7dc-2f0e-30ad-9a3d-fde4d239e674",
                                "text": "Mais regardez, ne sursalez pas!"
                            }
                        ]
                    }
                ],
