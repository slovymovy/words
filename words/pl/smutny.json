    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "62714e34-88d2-3d5a-8e1d-31516416d615",
                    "sense_definition": "Odczuwający smutek, pogrążony w smutku.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "stan_smutku",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój brat jest dzisiaj bardzo <w>smutny</w>, ponieważ zgubił swoją ulubioną zabawkę.",
                            "target_lang_translations": {
                                "ru": "Мой брат сегодня очень <w>грустный</w>, потому что потерял свою любимую игрушку.",
                                "en": "My brother is very <w>sad</w> today because he lost his favorite toy."
                            }
                        },
                        {
                            "text": "Dlaczego jesteś taka <w>smutna</w> w ten piękny, słoneczny dzień?",
                            "target_lang_translations": {
                                "ru": "Почему ты такая <w>грустная</w> в этот прекрасный, солнечный день?",
                                "en": "Why are you so <w>sad</w> on this beautiful, sunny day?"
                            }
                        }
                    ],
                    "synonyms": [
                        "przygnębiony",
                        "zmartwiony",
                        "zasmucony",
                        "niewesoły"
                    ],
                    "antonyms": [
                        "wesoły",
                        "radosny",
                        "szczęśliwy",
                        "uśmiechnięty"
                    ],
                    "common_phrases": [
                        "smutny człowiek",
                        "być smutnym"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий грусть, погруженный в печаль.",
                        "en": "Feeling sadness, plunged in sadness."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грустный",
                                "target_lang_sense_clarification": "испытывающий грусть"
                            },
                            {
                                "target_lang_word": "печальный",
                                "target_lang_sense_clarification": "испытывающий печаль"
                            },
                            {
                                "target_lang_word": "тоскливый",
                                "target_lang_sense_clarification": "испытывающий тоску"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sad",
                                "target_lang_sense_clarification": "feeling sorrow or unhappiness"
                            },
                            {
                                "target_lang_word": "brokenhearted",
                                "target_lang_sense_clarification": "extremely sad and grieved, especially by loss"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76591741-2709-32a4-baca-741efb7b0204",
                    "sense_definition": "Wyrażający smutek, charakteryzujący się smutkiem, nacechowany smutkiem.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wyraz_smutku",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziewczynka ze <w>smutną</w> miną spoglądała przez okno i czekała na powrót rodziców.",
                            "target_lang_translations": {
                                "ru": "Девочка с <w>грустным</w> лицом смотрела в окно и ждала возвращения родителей.",
                                "en": "The girl with a <w>sad</w> face looked out the window and waited for her parents to return."
                            }
                        },
                        {
                            "text": "Z radia płynęła cicha, <w>smutna</w> piosenka, która idealnie pasowała do deszczowej pogody.",
                            "target_lang_translations": {
                                "ru": "Из радио лилась тихая, <w>грустная</w> песня, которая идеально подходила к дождливой погоде.",
                                "en": "A quiet, <w>sad</w> song was playing on the radio, which perfectly matched the rainy weather."
                            }
                        }
                    ],
                    "synonyms": [
                        "ponury",
                        "melancholijny",
                        "posępny",
                        "żałosny"
                    ],
                    "antonyms": [
                        "pogodny",
                        "promienny",
                        "wesoły"
                    ],
                    "common_phrases": [
                        "smutna mina",
                        "smutna piosenka",
                        "smutne spojrzenie"
                    ],
                    "target_lang_definitions": {
