{
    "word_family": [
        "observation",
        "observable",
        "observance",
        "observant",
        "observer",
        "observatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c908fd7c-27a6-3ee1-88bb-9646a8aaa653",
                    "sense_definition": "To notice or watch something carefully, especially with attention to detail.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "watch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists spent several months in the forest to <w>observe</w> the behavior of the local birds.",
                            "target_lang_translations": {
                                "ru": "Ученые провели несколько месяцев в лесу, чтобы <w>наблюдать</w> за поведением местных птиц."
                            }
                        },
                        {
                            "text": "From this high vantage point, we can <w>observe</w> the movement of the ships in the harbor.",
                            "target_lang_translations": {
                                "ru": "С этой высокой точки обзора мы можем <w>наблюдать</w> за движением судов в гавани."
                            }
                        }
                    ],
                    "synonyms": [
                        "celebrate"
                    ],
                    "common_phrases": [
                        "observe the behavior",
                        "observe the effects"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внимательно замечать или следить за чем-либо, особенно обращая внимание на детали."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наблюдать",
                                "target_lang_sense_clarification": "внимательно следить глазами"
                            },
                            {
                                "target_lang_word": "следить",
                                "target_lang_sense_clarification": "за развитием или движением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9a97e40-02cd-3de7-b615-ebd920e1452b",
                    "sense_definition": "To follow or obey a law, custom, rule, or religious practice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drivers are required to <w>observe</w> all posted speed limits for the safety of pedestrians.",
                            "target_lang_translations": {
                                "ru": "Водители обязаны <w>соблюдать</w> все установленные ограничения скорости для безопасности пешеходов."
                            }
                        },
                        {
                            "text": "The crowd <w>observed</w> a moment of silence to honor the victims of the tragedy.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>почтила</w> память жертв трагедии минутой молчания."
                            }
                        }
                    ],
                    "antonyms": [
                        "violate",
                        "disobey"
                    ],
                    "common_phrases": [
                        "observe the law",
                        "observe a silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Следовать закону, обычаю, правилу или религиозной практике или подчиняться им."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "правила, законы, тишину"
                            },
                            {
                                "target_lang_word": "придерживаться",
                                "target_lang_sense_clarification": "традиций или правил"
                            },
                            {
                                "target_lang_word": "почтить",
                                "target_lang_sense_clarification": "память минутой молчания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "963f8061-dd65-3174-b56e-0fc54657a931",
                    "sense_definition": "To make a remark or comment about something you have noticed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>observed</w> that the new policy had significantly improved office morale.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>отметил</w>, что новая политика значительно улучшила моральный дух в офисе."
                            }
                        },
                        {
                            "text": "She <w>observed</w> that the weather was much colder than it had been the previous year.",
                            "target_lang_translations": {
                                "ru": "Она <w>заметила</w>, что погода была намного холоднее, чем в предыдущем году."
                            }
                        }
                    ],
                    "synonyms": [
                        "celebrate"
                    ],
                    "common_phrases": [
                        "observe that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать замечание или комментарий о чем-то замеченном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметить",
                                "target_lang_sense_clarification": "сделать краткое замечание"
                            },
                            {
                                "target_lang_word": "отметить",
                                "target_lang_sense_clarification": "обратить внимание в речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aa33011-97de-3a32-9809-25ecb4b21230",
                    "sense_definition": "To acknowledge or celebrate a holiday, anniversary, or specific time system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "celebrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many countries <w>observe</w> daylight saving time to make better use of evening sunlight.",
                            "target_lang_translations": {
                                "ru": "Многие страны <w>переходят</w> на летнее время, чтобы лучше использовать вечерний солнечный свет."
                            }
                        },
                        {
                            "text": "The community will <w>observe</w> the feast of the harvest with a large public dinner.",
                            "target_lang_translations": {
                                "ru": "Община <w>отметит</w> праздник урожая большим общественным обедом."
                            }
                        }
                    ],
                    "synonyms": [
                        "celebrate"
                    ],
                    "common_phrases": [
                        "observe a holiday",
                        "observe daylight time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Признавать или праздновать праздник, годовщину или придерживаться определенной системы времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "праздновать событие"
                            },
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "пост или религиозный праздник"
                            },
                            {
                                "target_lang_word": "переходить",
                                "target_lang_sense_clarification": "на летнее/зимнее время"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6a7e559-c5ce-3726-a99e-459893b19c52",
                    "sense_definition": "A remark, comment, or judgment made based on what has been seen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "comment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a very clever <w>observe</w> regarding the political situation during the dinner party.",
                            "target_lang_translations": {
                                "ru": "Во время званого обеда он сделал очень умное <w>замечание</w> относительно политической ситуации."
                            }
                        },
                        {
                            "text": "It was a good <w>observe</w> that helped the team realize they were heading in the wrong direction.",
                            "target_lang_translations": {
                                "ru": "Это было хорошее <w>наблюдение</w>, которое помогло команде понять, что они движутся в неверном направлении."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Замечание, комментарий или суждение, сделанное на основе увиденного (архаичное использование в качестве существительного)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечание",
                                "target_lang_sense_clarification": "высказанное наблюдение"
                            },
                            {
                                "target_lang_word": "наблюдение",
                                "target_lang_sense_clarification": "результат внимательного изучения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}