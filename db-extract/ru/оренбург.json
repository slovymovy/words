                        "source_sense_id": "ec9d7f17-af50-384c-93bd-e2f31b06a863",
                        "target_lang_word": "Orenburg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orenburg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22f70cc1-8427-3b99-9df6-f02de97825a9",
                                        "entry_id": "c1e87662-7e16-3d3d-a591-11714df96d82",
                                        "glosses": [
                                            "Großstadt in Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e33fb16c-55a0-40e5-b359-5b912c8bb038",
                                                "sense_id": "22f70cc1-8427-3b99-9df6-f02de97825a9",
                                                "text": "„In Orenburg warteten drei kirgisische Sultane, die mit großem Gefolge angereist waren, um den Mann zu treffen, der alles wußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6d5e8cb-0492-4b33-b311-254439168cb0",
                        "source_entry_id": "1a83140a-776a-3841-ad2b-8a0d4fa9349f",
                        "source_sense_id": "ec9d7f17-af50-384c-93bd-e2f31b06a863",
                        "target_lang_word": "Orenbourg",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orenbourg",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a6f42eb-5d91-3a4b-892e-9fa4904da8d7",
                                        "entry_id": "31596e74-8be9-3cd6-884d-761df8ccb8f6",
                                        "glosses": [
                                            "Ville de Russie, située sur le fleuve Oural, à 370 km au sud-est de Samara et à 1 230 km au sud-est de Moscou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "888202c8-3b19-4aca-a477-146294a51334",
                                                "sense_id": "1a6f42eb-5d91-3a4b-892e-9fa4904da8d7",
                                                "text": "Afin d'établir la liaison avec Orsk et Orenbourg, demeurés aux mains des Russes blancs, sous les ordres de l’ataman Doutov, Novo-Petrovsk allait servir de base d'opérations à un régiment tchécoslovaque."
                                            },
                                            {
                                                "example_id": "52975c9e-4487-4a95-90f7-8a6b61d87784",
                                                "sense_id": "1a6f42eb-5d91-3a4b-892e-9fa4904da8d7",
                                                "text": "La concession qui nous avait été octroyée était située sur le versant asiatique de l'Oural, dans le gouvernement d'Orenbourg, district de Tcheliabinsk, à une demi-lieue environ d'une ville de six mille habitants, du nom de Novo-Petrovsk."
                                            },
                                            {
                                                "example_id": "d0049a70-f6a3-4b07-b820-4ac8dbe00333",
                                                "sense_id": "1a6f42eb-5d91-3a4b-892e-9fa4904da8d7",
                                                "text": "La République soviétique fédérative socialiste de Russie est composée des territoires de : Azov-mer Noire, Extrême-Orient, Sibérie occidentale, Krasnoïarsk, Caucase du Nord ; des régions de : Voronèje, Sibérie orientale, Gorki, Ouest, Ivanovo, Kalinine, Kirov, Kouïbychev, Koursk, Leningrad, Moscou, Omsk, Orenbourg, Saratov, Sverdlovsk, Nord Stalingrad, Tchéliabinsk, Yaroslave ; des Républiques soviétiques socialistes autonomes de : Tatarie, Bachkirie, Daghestan, Bouriato-Mongolie, Kabardino-Balkarie, Kalmykie, Carélie, des Komis, Crimée, des Mariis, des Mordves, des Allemands de la Volga, Ossétie du Nord, Oudmourtie, Tchétchéno-Ingouchie, Tchouvachie, Yakoutie; des régions autonomes des Adighés, Juifs, Karatchaïs, Oïrotes, Khakasses, Tcherkesses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
