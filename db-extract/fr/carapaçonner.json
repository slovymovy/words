                "senses": [
                    {
                        "sense_id": "06cd2209-bac8-37f7-bf69-b949105bf101",
                        "entry_id": "9bc994f6-7358-38fe-aabb-a567efcc44f3",
                        "glosses": [
                            "Variante de caparaçonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "011bb0d1-0680-4bbe-8bc9-ccb523f8cdfd",
                                "sense_id": "06cd2209-bac8-37f7-bf69-b949105bf101",
                                "text": "« Je suis sûr… si… si… que si j’ faisais un entretien avec vous… si vous étiez d'accord… j’ suis sûr… on pourrait obtenir de lui autre chose que… alors que vous êtes vraiment carapaçonné… qu’ vous êtes vraiment un personnage, comme tous les hommes politiques, avec une langue de bois… vous par exemple… »"
                            },
                            {
                                "example_id": "3a3a915d-5b3b-4179-a33f-cdd361ae6bd8",
                                "sense_id": "06cd2209-bac8-37f7-bf69-b949105bf101",
                                "text": "« Quand la cause de sa vie est en jeu, Beate Klarsfeld sait se carapaçonner, rester sourde à des objections de «détail». »"
                            }
                        ]
                    }
