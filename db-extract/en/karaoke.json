                "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                "word": "karaoke",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "194cef07-30cb-4d06-be34-c0ac0aa244db",
                        "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                        "tags": [
                            "plural"
                        ],
                        "form": "karaokes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f30774b0-809b-368d-9436-6803b5008811",
                        "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                        "glosses": [
                            "A form of entertainment popular in clubs, at parties, etc, in which individual members of the public sing along to pre-recorded instrumental versions of popular songs, the lyrics of which are displayed for the singer on a screen in time with the music."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "21b84ae3-9151-4d11-80b8-e986ad8372a7",
                                "sense_id": "f30774b0-809b-368d-9436-6803b5008811",
                                "text": "The karaoke has been well received by those who frequent the oriental cabaret scene and adopt its particular social behaviors such as conversation, companionship, being seen, and showing off."
                            },
                            {
                                "example_id": "99945542-6653-4a80-ac37-a1c8aad8fb4f",
                                "sense_id": "f30774b0-809b-368d-9436-6803b5008811",
                                "text": "American Idol will always have a place in my heart. It's where I met Clay. And what could be more exciting than televised karaoke?"
                            },
                            {
                                "example_id": "42ae3964-3572-4227-879e-6175853bf09c",
                                "sense_id": "f30774b0-809b-368d-9436-6803b5008811",
                                "text": "I was always split on Henley. Then I found out that he doesn’t want people to sing his songs at karaoke. In fact, Henley actually forbids karaoke companies from rerecording songs in his catalog."
                            }
                        ]
                    },
                    {
                        "sense_id": "d947a895-35cc-3ccb-8011-e571e0f85630",
                        "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                        "glosses": [
                            "A karaoke session."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e92326c6-bf13-3ca1-a84d-05f9c509d2d4",
                        "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                        "glosses": [
                            "A karaoke parlour."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "093d41a9-5f17-3e0f-b964-bc98b6d47ce3",
                        "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                        "glosses": [
                            "An exercise in which the feet are alternately placed in front of each other while walking sideways to stretch various parts of the lower body and core."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
