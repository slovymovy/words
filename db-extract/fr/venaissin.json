                        "glosses": [
                            "Qualifie la partie française des États pontificaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b0eebd-08fc-433c-bb2f-c6b0b69f4809",
                                "sense_id": "c9f72190-82cd-3e29-a144-873f3c30cfeb",
                                "text": "Le comtat Venaissin, la région venaissine."
                            },
                            {
                                "example_id": "8b2ab2d3-7572-4b41-b411-8c38cf19ac8b",
                                "sense_id": "c9f72190-82cd-3e29-a144-873f3c30cfeb",
                                "text": "En 1348, Jeanne première, Reine de Naples & Comtesse de Provence, vendit Avignon & le comté Venaissin au Pape Clément VI 30 000 écus d’or. Avignon a été la demeure des Papes depuis Clément V, jusqu’à Grégoire X, ou depuis 1305, jusqu’à 1376."
                            }
                        ]
                    }
