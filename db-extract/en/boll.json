                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "662a2bb6-550b-484d-8f2d-c6f437125bb1",
                        "entry_id": "95b27668-52b2-3545-ad60-e907d65138fd",
                        "tags": [
                            "plural"
                        ],
