{
    "word": "nevermind",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e1928cf8-48d3-3a5d-b40c-dd062d987f4d",
                "word": "nevermind",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d21e6f9d-224e-4b59-987d-58168edb1cb7",
                        "entry_id": "e1928cf8-48d3-3a5d-b40c-dd062d987f4d",
                        "tags": [
                            "plural"
                        ],
                        "form": "neverminds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d7810b5-7150-3f96-88e6-31d5e1bdb00e",
                        "entry_id": "e1928cf8-48d3-3a5d-b40c-dd062d987f4d",
                        "glosses": [
                            "Attention, heed."
                        ],
                        "tags": [
                            "US",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "4310eb4d-7ebc-405a-bbf0-72fc4794dfe4",
                                "sense_id": "5d7810b5-7150-3f96-88e6-31d5e1bdb00e",
                                "text": "Hell, they've got groundrules and guidelines comin' out the kazoo, but do they pay any nevermind to 'em?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ce31d412-abd7-3de3-adca-859b948b5b24",
                        "entry_id": "e1928cf8-48d3-3a5d-b40c-dd062d987f4d",
                        "glosses": [
                            "Concern, affair."
                        ],
                        "tags": [
                            "US",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "8a93390e-a205-4af3-8b24-f54ffae755e9",
                                "sense_id": "ce31d412-abd7-3de3-adca-859b948b5b24",
                                "text": "\"... buy what he wants. It's none of your nevermind.\""
                            },
                            {
                                "example_id": "1a4b6ed3-9d7e-4a6b-99dd-a033c1184c64",
                                "sense_id": "ce31d412-abd7-3de3-adca-859b948b5b24",
                                "text": "\"These is my brothers, Tom and Benjamin. We's from Missoura. Would you be Yankee or Secesh?\" / \"Neither one,\" Joe said. \"Not that it's any nevermind o' yours, Mr. Wickersham.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "5d246d22-858c-3142-88ed-2844ae89dd6c",
                        "entry_id": "e1928cf8-48d3-3a5d-b40c-dd062d987f4d",
                        "glosses": [
                            "Consequence; significant change in or effect on a situation or state; difference."
                        ],
                        "tags": [
                            "US",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "d4bfa046-150f-4273-bc0a-ccd841260694",
                                "sense_id": "5d246d22-858c-3142-88ed-2844ae89dd6c",
                                "text": "Let 'em say she was his mistress, that she was a witch. Wasn't true, but it didn't make any nevermind if they thought it was. Nice woman, quiet, could tell the cards."
                            },
                            {
                                "example_id": "0e290db2-6113-42fc-b246-f4411992c8ca",
                                "sense_id": "5d246d22-858c-3142-88ed-2844ae89dd6c",
                                "text": "Either way—doesn't mean no nevermind to me, you understand."
                            },
                            {
                                "example_id": "214b072e-b12f-42f1-b932-ab59d10ba5ab",
                                "sense_id": "5d246d22-858c-3142-88ed-2844ae89dd6c",
                                "text": "So it don't make a heap of nevermind to me which one you choose!"
                            },
                            {
                                "example_id": "41a1df5e-7593-4b01-ade8-402246ace3d7",
                                "sense_id": "5d246d22-858c-3142-88ed-2844ae89dd6c",
                                "text": "If'n it makes any nevermind, you'll be grubbin' alongside me."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7355bc6-8223-4fac-b72c-1dd2b75b5847",
                        "source_entry_id": "e1928cf8-48d3-3a5d-b40c-dd062d987f4d",
                        "source_sense_description": "concern, affair",
                        "target_lang_word": "де́ло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "де́ло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7197bf39-b5dc-3989-8e9b-c4c75bae07ce",
                                        "entry_id": "1f659b08-2459-3cb0-95f8-2d439c9e103e",
                                        "glosses": [
                                            "форма прошедшего времени среднего рода единственного числа изъявительного наклонения глагола деть"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "де́ло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "733c63ef-1f23-361a-bf65-532d22a3c7c6",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "работа, занятие, действие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0150fda3-3ac0-4d14-a74a-6d2c2dbde191",
                                                "sense_id": "733c63ef-1f23-361a-bf65-532d22a3c7c6",
                                                "text": "Хватит бездельничать, займись делом!"
                                            },
                                            {
                                                "example_id": "4104adb0-8ce9-4c4d-8f34-7f0782614e6f",
                                                "sense_id": "733c63ef-1f23-361a-bf65-532d22a3c7c6",
                                                "text": "― Много у вас дела? ― спросил Обломов. ― Да, довольно. Две статьи в газету каждую неделю, потом разборы беллетристов пишу, да вот написал рассказ."
                                            },
                                            {
                                                "example_id": "2e69d748-db31-40c3-8b21-face829b5091",
                                                "sense_id": "733c63ef-1f23-361a-bf65-532d22a3c7c6",
                                                "text": "Он ковал подкову за подковой, отбрасывая их одну за другой в кучу в углу балагана; он работал с мрачным, сосредоточенным видом, сильно торопясь; это было днём; проходя уже довольно поздно вечером, я подошёл к балагану и увидел старика за тем же делом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66c32e4d-a968-385c-a8d6-7058613f6abd",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "разг. бизнес, предприятие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "538bc4db-3210-47b6-bcf1-9b03ca89412c",
                                                "sense_id": "66c32e4d-a968-385c-a8d6-7058613f6abd",
                                                "text": "Для открытия собственного дела необходим капитал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd9543d6-8ca3-3ead-b12f-6cef4418ee57",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "офиц. досье; набор документов, связанных общей темой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b6b0f56-c3ca-4f1b-afe3-ce64d3d02c9c",
                                                "sense_id": "bd9543d6-8ca3-3ead-b12f-6cef4418ee57",
                                                "text": "Заведено дело на гражданина Иванова."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d133cd9-888e-36fd-98fc-a5e6488acb2a",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "суть, смысл явления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c7ebc42-22d5-4f58-9a32-8d2456dc13d8",
                                                "sense_id": "3d133cd9-888e-36fd-98fc-a5e6488acb2a",
                                                "text": "Дело в том, что всё делается совсем по-другому."
                                            },
                                            {
                                                "example_id": "ebb27e52-c8e8-460e-82c2-b844fd716067",
                                                "sense_id": "3d133cd9-888e-36fd-98fc-a5e6488acb2a",
                                                "text": "Всё дело сводится к следующему: мероприятие было ужасно организовано."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9760ee0-dd12-395c-8d9a-82f9fe681f43",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "деловая надобность, нужда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c0b3310-dd80-4d0f-a9fa-4c5103fd5cf0",
                                                "sense_id": "a9760ee0-dd12-395c-8d9a-82f9fe681f43",
                                                "text": "Без дела не входить."
                                            },
                                            {
                                                "example_id": "a3d7c4ef-bcae-4c6d-9a63-58efe926f1ff",
                                                "sense_id": "a9760ee0-dd12-395c-8d9a-82f9fe681f43",
                                                "text": "Я к Вам по делу."
                                            },
                                            {
                                                "example_id": "5a240147-6843-46cb-b759-4fd76813785c",
                                                "sense_id": "a9760ee0-dd12-395c-8d9a-82f9fe681f43",
                                                "text": "У меня к нему дело."
                                            },
                                            {
                                                "example_id": "a393baf7-67d4-49ab-a7a0-d328745b63e4",
                                                "sense_id": "a9760ee0-dd12-395c-8d9a-82f9fe681f43",
                                                "text": "Пошёл в город по делам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "093e9cef-7f5a-3e2f-9a30-03012de5b668",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "разг. полезное занятие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b05fb5-b204-4c46-af16-7c1ebd41ab9e",
                                                "sense_id": "093e9cef-7f5a-3e2f-9a30-03012de5b668",
                                                "text": "Он занят делом."
                                            },
                                            {
                                                "example_id": "30368d11-5340-4fe0-b45e-b4580cdb755e",
                                                "sense_id": "093e9cef-7f5a-3e2f-9a30-03012de5b668",
                                                "text": "Делу время, потехе час (посл.)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd79b78c-cfae-3e67-a300-e0d77d722caa",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "обязанность, круг ведения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b971703e-1107-4c9c-bb67-9da1a3dff994",
                                                "sense_id": "bd79b78c-cfae-3e67-a300-e0d77d722caa",
                                                "text": "Это дело полиции."
                                            },
                                            {
                                                "example_id": "1831403a-008f-4737-a173-c7196f896140",
                                                "sense_id": "bd79b78c-cfae-3e67-a300-e0d77d722caa",
                                                "text": "Это не моё дело."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1628b6a7-7dab-3c64-900f-457609b6924e",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "административно-судебное разбирательство по поводу какого-нибудь события, факта; судебный процесс"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f406d6-31b9-4dc2-861b-a4205e512c35",
                                                "sense_id": "1628b6a7-7dab-3c64-900f-457609b6924e",
                                                "text": "Уголовное дело."
                                            },
                                            {
                                                "example_id": "9c0f3ec7-c239-49f8-abad-50124fd0f627",
                                                "sense_id": "1628b6a7-7dab-3c64-900f-457609b6924e",
                                                "text": "На двадцать третье сентября в окружном суде назначено к слушанию дело по обвинению Веры Капитановой в краже."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c852e866-274e-32fe-883b-415a17f2caed",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "офиц. предмет ведения какой-нибудь отрасли государственного управления; ведомство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29455edf-c255-408b-b5eb-d92c6a6b35c1",
                                                "sense_id": "c852e866-274e-32fe-883b-415a17f2caed",
                                                "text": "Министерство иностранных дел."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68ac163a-6a70-37b2-a3ce-e15821425d0b",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "воен. устар. военное (боевое) действие: схватка с противником, бой, битва, сражение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7e82b5e-4465-40ae-a3da-4acea6f3b078",
                                                "sense_id": "68ac163a-6a70-37b2-a3ce-e15821425d0b",
                                                "text": "До сей поры мало приходилось Суворову принимать участия в делах против неприятеля. В Силезии он бывал в разных стычках, но они были так мелки, что в летопись кампании не вошли, и даже сам он про них не упоминает."
                                            },
                                            {
                                                "example_id": "7c735e41-bd66-4327-ae75-192f380b7bdb",
                                                "sense_id": "68ac163a-6a70-37b2-a3ce-e15821425d0b",
                                                "text": "― Когда он приехал на Линию, я был подпоручиком, ― прибавил он, ― и при нём получил два чина за дела против горцев."
                                            },
                                            {
                                                "example_id": "b2adf74b-9fb1-448e-bbe1-86db79f35dbf",
                                                "sense_id": "68ac163a-6a70-37b2-a3ce-e15821425d0b",
                                                "text": "Едва лишь выбрался обоз // В поляну, дело началось; // Чу! в арьергард орудья просят; // Вот ружья из кустов [вы]носят, // Вот тащат за ноги людей // И кличут громко лекарей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0e85382-5844-351b-890f-dad69e8dfa09",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "разг. обстоятельство, особенность предмета разговора"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "658041be-aae0-48f4-b6a1-c2a8f255a628",
                                                "sense_id": "d0e85382-5844-351b-890f-dad69e8dfa09",
                                                "text": "В чём дело?"
                                            },
                                            {
                                                "example_id": "7ca31007-dba6-4434-8cdd-d2e1f4d28374",
                                                "sense_id": "d0e85382-5844-351b-890f-dad69e8dfa09",
                                                "text": "Дело идёт к зиме."
                                            },
                                            {
                                                "example_id": "889b005c-f1fd-49be-ab1a-649d66356b22",
                                                "sense_id": "d0e85382-5844-351b-890f-dad69e8dfa09",
                                                "text": "Ну вот! Теперь совсем иное дело: в комнате чисто и убрано!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8905d1d-0d14-314e-81d6-b719b965d958",
                                        "entry_id": "9d0bf07f-2c9c-3b86-bbd7-81c23f5a9b73",
                                        "glosses": [
                                            "разг. специальность, профессия, круг занятий, область знаний или навыков кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a732293-b4d1-49f8-99bd-61c7bce272ee",
                                                "sense_id": "e8905d1d-0d14-314e-81d6-b719b965d958",
                                                "text": "Записки Бенвенуто Челлини совсем не потому занимательны, что он был отличный золотых дел мастер, а потому, что они сами по себе занимательны любой повестью."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e383ab7f-fa7b-4ffd-9ff4-dd089138973e",
                        "source_entry_id": "e1928cf8-48d3-3a5d-b40c-dd062d987f4d",
                        "source_sense_description": "concern, affair",
                        "target_lang_word": "забо́та",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "забо́та",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cd8495cf-89c0-3b48-b08f-5d1dabc085b5",
                                        "entry_id": "a6984691-54ae-3fe0-b2bf-8701ce6a1f47",
                                        "glosses": [
                                            "беспокойство, обременительное дело"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9f69fca-1eb1-4887-9a0b-3bd1550eb8bb",
                                                "sense_id": "cd8495cf-89c0-3b48-b08f-5d1dabc085b5",
                                                "text": "Для него, трудового человека, существует только одна, вечно повторяющаяся забота: сегодня надо думать о том, чтобы не голодать завтра."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "140660ce-2e23-37dc-b48b-8fbadaca0286",
                                        "entry_id": "a6984691-54ae-3fe0-b2bf-8701ce6a1f47",
                                        "glosses": [
                                            "внимание; попечение, опека; уход за кем-либо или чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8213e61c-1d90-41b9-adb5-4fc3db259c4f",
                                                "sense_id": "140660ce-2e23-37dc-b48b-8fbadaca0286",
                                                "text": "Любила она меня с какою-то страстной нежностью; в этой любви была нежная забота матери и страсть любовницы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d7a6a92-47ab-4415-80ef-0347261dbf6f",
                        "source_entry_id": "e1928cf8-48d3-3a5d-b40c-dd062d987f4d",
                        "source_sense_description": "concern, affair",
                        "target_lang_word": "пробле́ма",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пробле́ма",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d57a9063-c04e-30e8-9b84-288ca980196f",
                                        "entry_id": "68bf5e07-8e93-31d8-8e24-77c1074f4ce5",
                                        "glosses": [
                                            "сложный вопрос; задача, требующая разрешения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7af9aa-7d29-423f-a344-211624d1c998",
                                                "sense_id": "d57a9063-c04e-30e8-9b84-288ca980196f",
                                                "text": "В числе наиболее спорных проблем, когда-либо стоявших перед человечеством, и поныне остаётся проблема свободы воли и вытекающие из неё вопросы о мере ответственности человека за свои деяния, о соотношении социальных и биологических факторов в поведении индивидуума."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae10416-d193-3269-89dd-e21bac4d3977",
                                        "entry_id": "68bf5e07-8e93-31d8-8e24-77c1074f4ce5",
                                        "glosses": [
                                            "трудность, препятствие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c69ef42-75a7-427a-b0ed-ae42293c4f53",
                                                "sense_id": "0ae10416-d193-3269-89dd-e21bac4d3977",
                                                "text": "У россиян возникли проблемы с получением британских виз."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
