                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3054646b-3f34-4f46-b353-dfa49c602830",
                                "sense_id": "edac9f25-483f-3689-8cbf-df442a7eb57a",
                                "text": "„Scheinbar völlig aus dem Nichts krachte ein Eisbrocken auf ein Hausdach und richtet einen riesigen Schaden an.“"
                            },
                            {
                                "example_id": "a326961a-4c0d-422f-90ea-b322d7791a4d",
                                "sense_id": "edac9f25-483f-3689-8cbf-df442a7eb57a",
                                "text": "„Wenn ein Eisbrocken ins Wasser stürze, könne dies starke Wirbel auslösen.“"
                            },
                            {
                                "example_id": "a9504311-7ffe-41f6-b4fe-66e1d0f99645",
                                "sense_id": "edac9f25-483f-3689-8cbf-df442a7eb57a",
                                "text": "„Mittels eines Eisbrockens, der schrumpft, zu Wasser wird und so ins Erdreich sickert, lässt sich zum Beispiel auf die globale Erwärmung hinweisen, auf das Abschmelzen der Polkappen und das Ansteigen des Meeresspiegels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
