                "translations": [
                    {
                        "translation_id": "c409767b-fe9b-45b0-acd9-385b4c522239",
                        "source_entry_id": "8b4ec76e-7f4a-3d5f-a3a5-1c0a3d71a301",
                        "source_sense_description": "греческое божество",
                        "target_lang_word": "Nymphe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nymphe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fa07976-8854-3651-9ae8-7f455ad9ec96",
                                        "entry_id": "4ab2ecc6-2567-31ef-8da9-bd2ce6cb29ac",
                                        "glosses": [
                                            "weiblicher, meist anmutiger Naturgeist; Personifikation von Naturkräften; niedere Gottheit"
                                        ],
                                        "tags": [
                                            "griechisch-römische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29a9205b-7246-4b9b-9470-b01d12ababbf",
                                                "sense_id": "3fa07976-8854-3651-9ae8-7f455ad9ec96",
                                                "text": "Die bezaubernden Nymphen tanzten im Wald einen Reigen."
                                            },
                                            {
                                                "example_id": "13ccfe5e-d6fe-4001-abb6-fc0b52ed6d90",
                                                "sense_id": "3fa07976-8854-3651-9ae8-7f455ad9ec96",
                                                "text": "„Ich mag keine Nymphen, sie sind immer so quirlig, huschen mal hierhin, mal dorthin, sie jagen durch die Wälder, sie locken die bocksfüßigen Satyrn aus den Bergen oder erschrecken die Bauern und Hirten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "308d646d-da98-3374-a128-25c49076803e",
                                        "entry_id": "4ab2ecc6-2567-31ef-8da9-bd2ce6cb29ac",
                                        "glosses": [
                                            "Jungtiere einiger Insekten im zweiten Entwicklungsstadium zwischen Larve und Puppe, das bereits Anlagen zu Flügel aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "19604052-dd63-3cb9-a7fc-954c679f6f55",
                                        "entry_id": "4ab2ecc6-2567-31ef-8da9-bd2ce6cb29ac",
                                        "glosses": [
                                            "junges Mädchen oder Frau, das einerseits kindlich und unschuldig, andererseits erotisch verführerisch wirkt"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b3c10d-19a0-4c27-b27e-fcf2197f78af",
                                                "sense_id": "19604052-dd63-3cb9-a7fc-954c679f6f55",
                                                "text": "„In ein sehr gut gemachtes Korsett geschnürt, hatte er die Taille einer Nymphe und ließ eine Brust sehen, wie sie wenige Frauen fester und reizvoller haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "afcb9339-a8b1-3fb3-b791-df1a54a0c12f",
                                        "entry_id": "4ab2ecc6-2567-31ef-8da9-bd2ce6cb29ac",
