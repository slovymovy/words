                            {
                                "example_id": "d7da8cc3-08d4-4f8a-a59c-1451aaf9c52f",
                                "sense_id": "dd2a1912-2b60-3f24-9d67-ecc0a85d69ee",
                                "text": "Petit’ mendigote,\nje sens ta menotte\nqui cherche ma main ;\nJe sens ta poitrine\net ta taille fine,\nj’oublie mon chagrin."
                            },
                            {
                                "example_id": "3b6609cd-2cf8-4c79-95f5-c89cf914d723",
                                "sense_id": "dd2a1912-2b60-3f24-9d67-ecc0a85d69ee",
                                "text": "Cui-Cui était une figure populaire du pavé germanopratin. … Mendigote excentrique, elle … avait déjà perdu pas mal de plumes. Dans sa jeunesse, disait-on, elle avait exercé le plus vieux métier du monde."
                            }
                        ]
                    }
