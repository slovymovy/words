    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a16a6e3-871c-334e-952c-ead166f261a5",
                    "sense_definition": "A large wild ox with a shaggy mane, large head, and short horns, native to North America and Europe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bovids",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A herd of <w>bison</w> grazed peacefully across the open grasslands.",
                            "target_lang_translations": {
                                "pl": "Stado <w>bizonów</w> pasło się spokojnie na otwartych preriach."
                            }
                        },
                        {
                            "text": "The American <w>bison</w> was once central to the lives of indigenous peoples.",
                            "target_lang_translations": {
                                "pl": "<w>Bizon</w> amerykański miał niegdyś kluczowe znaczenie dla życia rdzennych mieszkańców."
                            }
                        }
                    ],
                    "synonyms": [
                        "buffalo"
                    ],
                    "common_phrases": [
                        "herd of bison",
                        "American bison"
                    ],
                    "target_lang_definitions": {
                        "pl": "Duży dziki ssak parzystokopytny o gęstej grzywie, dużej głowie i krótkich rogach, pochodzący z Ameryki Północnej i Europy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "bizon",
                                "target_lang_sense_clarification": "zwierzę pochodzące z Ameryki Północnej (Bison bison)"
                            },
                            {
                                "target_lang_word": "żubr",
                                "target_lang_sense_clarification": "zwierzę pochodzące z Europy (Bison bonasus)"
                            }
                        ]
                    }
                }
            ]
        },
        {
