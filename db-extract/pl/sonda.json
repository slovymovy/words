                                        "entry_id": "39d4a5d7-1622-366e-ad78-530362269c46",
                                        "glosses": [
                                            "ein stab-, röhren- oder schlauchförmiges Instrument zum Einführen in Körperhöhlen, um sie zu untersuchen und zu behandeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ee92328-8696-4e01-b372-c37bc566483c",
                                                "sense_id": "e6ef49d4-ef68-385a-980a-2bad489f54ce",
                                                "text": "Wir werden dann eine Sonde einführen, um eine Magenspiegelung zu machen."
                                            },
