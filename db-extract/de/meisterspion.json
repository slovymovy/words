                            {
                                "example_id": "127c7216-a23e-490f-b9c3-5e662a1c1dec",
                                "sense_id": "1e8e4668-b6f6-3b46-a341-37b3469df142",
                                "text": "„Donovan war Verteidiger des Meisterspions Abel in dem bevorstehenden Prozeß.“"
                            },
                            {
                                "example_id": "335f7db0-c82d-4bb2-b46e-0681ec2a756d",
                                "sense_id": "1e8e4668-b6f6-3b46-a341-37b3469df142",
                                "text": "„Links von Zia schleppt sich sein früherer Meisterspion und Kopf des Geheimdienstes General Akhtar vorwärts, vom Gewicht des halben Dutzends Orden an seiner Brust niedergedrückt, als wäre er der Einzige der Gruppe, dem klar ist, dass sie diese Maschine nicht besteigen sollten.“"
                            }
                        ],
