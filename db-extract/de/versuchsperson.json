                                        "sense_id": "7bb5f92f-c5be-3d4f-8d2c-a8115227b529",
                                        "entry_id": "34ebcf23-ee12-3ae4-b16e-e8435ae7a1ca",
                                        "glosses": [
                                            "Likely to be affected by or to experience something; liable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "156f1722-8c30-49fe-b9f4-5f2f7df6f189",
                                                "sense_id": "7bb5f92f-c5be-3d4f-8d2c-a8115227b529",
                                                "text": "a country subject to extreme heat"
                                            },
                                            {
                                                "example_id": "4febb16a-fd2b-4ef3-b0da-021a22a5db80",
                                                "sense_id": "7bb5f92f-c5be-3d4f-8d2c-a8115227b529",
                                                "text": "Menu listings and prices are subject to change."
                                            },
                                            {
                                                "example_id": "810e3c67-da23-4ad2-8e7a-384689901bce",
                                                "sense_id": "7bb5f92f-c5be-3d4f-8d2c-a8115227b529",
                                                "text": "He's subject to sneezing fits."
                                            },
                                            {
                                                "example_id": "c1efa9b2-c6ac-4322-99c6-7f170fed3a74",
                                                "sense_id": "7bb5f92f-c5be-3d4f-8d2c-a8115227b529",
                                                "text": "All human things are subject to decay."
                                            },
                                            {
                                                "example_id": "016bf73a-f4c7-4710-9277-dee351f02402",
                                                "sense_id": "7bb5f92f-c5be-3d4f-8d2c-a8115227b529",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them[…]is often assumed to be the preserve of high-tech companies.[…]current tax rules make it easy for all sorts of firms to generate[…]“stateless income”: profit subject to tax in a jurisdiction that is neither the location of the factors of production that generate the income nor where the parent firm is domiciled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c0fb07-5ea2-3c73-ab67-99066fb6233f",
                                        "entry_id": "34ebcf23-ee12-3ae4-b16e-e8435ae7a1ca",
                                        "glosses": [
                                            "Conditional upon something; used with to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c154fbb1-6d05-4868-9c69-0d41a440e8aa",
                                                "sense_id": "f1c0fb07-5ea2-3c73-ab67-99066fb6233f",
                                                "text": "The local board sets local policy, subject to approval from the State Board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de139c04-3383-3328-867c-394f44adc08c",
                                        "entry_id": "34ebcf23-ee12-3ae4-b16e-e8435ae7a1ca",
                                        "glosses": [
                                            "Placed or situated under; lying below, or in a lower situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06e3b8a8-bd95-4613-a9d7-cfe84bc6b346",
                                                "sense_id": "de139c04-3383-3328-867c-394f44adc08c",
                                                "text": "Long he them bore above the subject plain"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a41936-902a-3945-92d5-39b3390e9391",
                                        "entry_id": "34ebcf23-ee12-3ae4-b16e-e8435ae7a1ca",
                                        "glosses": [
                                            "Placed under the power of another; owing allegiance to a particular sovereign or state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db9a4549-5f68-4735-85be-1a67087c5f1c",
                                                "sense_id": "f7a41936-902a-3945-92d5-39b3390e9391",
                                                "text": ", Book I\nEsau was never subject to Jacob."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subject",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "981d3a97-5363-36a3-9d00-fe3461d47ab4",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "The noun, pronoun or noun phrase about whom the statement is made. In active clauses with verbs denoting an action, the subject is the actor. In clauses in the passive voice the subject is the target of the action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcf14529-a37c-4098-bedc-789493e65134",
                                                "sense_id": "981d3a97-5363-36a3-9d00-fe3461d47ab4",
                                                "text": "In the active sentence ‘The cat ate the mouse’, ‘the cat’ is the subject and ‘the mouse’ is the object."
                                            },
                                            {
                                                "example_id": "9b56424f-8750-4b04-aec4-571f1296ba8f",
                                                "sense_id": "981d3a97-5363-36a3-9d00-fe3461d47ab4",
                                                "text": "In the passive sentence ‘the mouse was eaten by the cat’, ‘the mouse’ is the subject even though it is the target (patient) of the action, and ‘the cat’ is the agent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b470c6ac-7859-3971-bd88-c076a782f5a6",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "By faulty generalisation from a clause's grammatical subject often being coinstantiated with one: an actor or agent; one who takes action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0a68e89-5d9c-445c-97e3-7b966f67e72e",
                                                "sense_id": "b470c6ac-7859-3971-bd88-c076a782f5a6",
                                                "text": "the subjects and objects of power"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a644e2e-5938-3491-928f-38a4c1f4142b",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "The main topic of a paper, work of art, discussion, field of study, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f70911b-0228-4632-8998-29d5d057edf9",
                                                "sense_id": "6a644e2e-5938-3491-928f-38a4c1f4142b",
                                                "text": "this subject for heroic song"
                                            },
                                            {
                                                "example_id": "0c303d7b-79ba-4cfe-b197-a4575d7c8f71",
                                                "sense_id": "6a644e2e-5938-3491-928f-38a4c1f4142b",
                                                "text": "Make choice of a subject beautifull and noble, which […] shall […]afford[…] an ample field of matter wherein to expatiate itself."
                                            },
                                            {
                                                "example_id": "ec9d864a-8d4a-4e48-b5b2-3e5d173df03e",
                                                "sense_id": "6a644e2e-5938-3491-928f-38a4c1f4142b",
                                                "text": "I am th' unhappy subject of these quarrels. All these quarrels are about me."
                                            },
                                            {
                                                "example_id": "71e5e68e-899e-4756-bcfb-8b7b34b98a0c",
                                                "sense_id": "6a644e2e-5938-3491-928f-38a4c1f4142b",
                                                "text": "Then I had a good think on the subject of the hocussing of Cigarette, and I was reluctantly bound to admit that once again the man in the corner had found the only possible solution to the mystery."
                                            },
                                            {
                                                "example_id": "e1728558-7dba-4657-8927-37bcbd17b5d2",
                                                "sense_id": "6a644e2e-5938-3491-928f-38a4c1f4142b",
                                                "text": "The departure was not unduly prolonged.[…]Within the door Mrs. Spoker hastily imparted to Mrs. Love a few final sentiments on the subject of Divine Intention in the disposition of buckets; farewells and last commiserations; a deep, guttural instigation to the horse; and the wheels of the waggonette crunched heavily away into obscurity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a38b889-e0ad-3216-b84d-0efa6b6f3a04",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "A particular area of study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7552a28-ea17-4c42-a3b4-33b881f69319",
                                                "sense_id": "6a38b889-e0ad-3216-b84d-0efa6b6f3a04",
                                                "text": "Her favorite subject is physics."
                                            },
                                            {
                                                "example_id": "79715998-1622-4e8d-adbe-3db597556a39",
                                                "sense_id": "6a38b889-e0ad-3216-b84d-0efa6b6f3a04",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains.[…]But out of sight is out of mind. And that, together with the inherent yuckiness of the subject, means that many old sewers have been neglected and are in dire need of repair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1961c85d-bba5-3750-aba7-9d367f8cb6fc",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "A citizen in a monarchy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4877b6bd-396c-4fef-8207-886962027022",
                                                "sense_id": "1961c85d-bba5-3750-aba7-9d367f8cb6fc",
                                                "text": "I am a British subject."
                                            },
                                            {
                                                "example_id": "63b27e4f-c4f6-47e8-a819-79fe1fcd4524",
                                                "sense_id": "1961c85d-bba5-3750-aba7-9d367f8cb6fc",
                                                "text": "Except as otherwise expressly provided in this Act, and without prejudice to section 39, this Act shall apply to proceedings by or against the Crown in like manner as it applies to proceedings between subjects."
                                            },
                                            {
                                                "example_id": "efafd39c-4c38-40c2-82ea-c7ddd8d0114d",
                                                "sense_id": "1961c85d-bba5-3750-aba7-9d367f8cb6fc",
                                                "text": "Ignat'ev refused to concede these points, but offered other concessions instead: Russia would not demand a consulate in Ch'i-ch'i-ha-erh or Chang-chia-k'ou (Kalgan); it would permit Chinese subjects to continue living along the Ussuri river as Chinese subjects; and it would limit to 200 the number of Russian traders in Peking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fc816ae-08e7-397a-a7f7-5acabf8d2ded",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "A person ruled over by another, especially a monarch or state authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ae955d5-9235-428d-9e18-3decd899c616",
                                                "sense_id": "3fc816ae-08e7-397a-a7f7-5acabf8d2ded",
                                                "text": "[…]the Grand Khan seemed to grasp the \"truth\" of the religion and might become a convert, thereby gaining for Christianity the souls of all his subjects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "365ef40b-4cd5-34c3-9499-431fc9b2e740",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "The main theme or melody, especially in a fugue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9e0a593-c4f3-4136-86dc-097a53499370",
                                                "sense_id": "365ef40b-4cd5-34c3-9499-431fc9b2e740",
                                                "text": "The earliest known form of subject is the ecclesiastical cantus firmus, or plain song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a527991-e3b6-3560-87db-e9334bbfc798",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "A human, animal, or an inanimate object that is being examined, treated, analysed, etc; especially, one being studied in a scientific experiment, such as a clinical trial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cff8fb36-9656-4e1b-96b2-3281c06f9e06",
                                                "sense_id": "9a527991-e3b6-3560-87db-e9334bbfc798",
                                                "text": "human subject research"
                                            },
                                            {
                                                "example_id": "fe61f136-b0e4-4a39-a2db-32c2f2d21952",
                                                "sense_id": "9a527991-e3b6-3560-87db-e9334bbfc798",
                                                "text": "animal subjects"
                                            },
                                            {
                                                "example_id": "dd9b7714-6f3d-4680-94f8-8b0c115ea826",
                                                "sense_id": "9a527991-e3b6-3560-87db-e9334bbfc798",
                                                "text": "Writers of particular lives[…]are apt to be prejudiced in favour of their subject."
                                            },
                                            {
                                                "example_id": "aa3107f2-38ac-4170-842f-40209c927f57",
                                                "sense_id": "9a527991-e3b6-3560-87db-e9334bbfc798",
                                                "text": "It is also essential for those who come to the subject 'fresh' to gain the insight that will bridge their knowledge from being a subject of hypnosis to a potential practitioner."
                                            },
                                            {
                                                "example_id": "c94b6283-d47c-44be-a801-7167f9ed4648",
                                                "sense_id": "9a527991-e3b6-3560-87db-e9334bbfc798",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus. That’s because the lenses that are excellent at magnifying tiny subjects produce a narrow depth of field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68b9c645-ad74-3b3c-975d-8905abeb1368",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "A being that has subjective experiences, subjective consciousness, or a relationship with another entity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5428e2b0-be0a-30dd-80a2-1fac910d4a2f",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "That of which something is stated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad334143-6f21-3581-99ec-776387804a43",
                                        "entry_id": "ae029ffb-1810-34da-971f-c3fd9a8b6bcd",
                                        "glosses": [
                                            "The variable in terms of which an expression is defined."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb16015-0f49-4a38-a001-5446ea5791a3",
                                                "sense_id": "ad334143-6f21-3581-99ec-776387804a43",
                                                "text": "Making x the subject of x² − 6x + 3y = 0, we have x = 3 ± √(9 − 3y)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subject",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e13ee30-a7c8-3008-b461-378494e03276",
                                        "entry_id": "7bfd0736-be46-3fdc-b230-32f06b77d130",
                                        "glosses": [
                                            "To cause (someone or something) to undergo a particular experience, especially one that is unpleasant or unwanted."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "845ab8d9-99ba-4628-a5a7-7d77308660db",
                                                "sense_id": "9e13ee30-a7c8-3008-b461-378494e03276",
                                                "text": "I came here to buy souvenirs, not to be subjected to a tirade of abuse!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc808508-c0c1-31fe-a36d-f06b33be0642",
                                        "entry_id": "7bfd0736-be46-3fdc-b230-32f06b77d130",
                                        "glosses": [
                                            "To make subordinate or subservient; to subdue or enslave."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
