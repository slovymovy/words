                                            {
                                                "example_id": "76e31096-614a-473c-ba31-40af3b539b00",
                                                "sense_id": "95e4b11c-d59a-3cfc-853a-d1c8260c4228",
                                                "text": "Je songeai que si j’adoptais durablement ce style de vie, je ne tarderais pas à devenir le gros chat préfiguré par Biscuit."
                                            },
                                            {
                                                "example_id": "a12a0df7-6209-483f-be63-b30b11dda406",
                                                "sense_id": "95e4b11c-d59a-3cfc-853a-d1c8260c4228",
                                                "text": "Le paranoïaque écoute l’autre d’une manière différente, distord la phrase, préfigure le sens, y découvre ce qu’il cherchait, à savoir qu’on l’accuse, lui, des fautes que l’accusateur a commises."
                                            }
                                        ]
                                    }
