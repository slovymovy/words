                    {
                        "sense_id": "2ffb101b-7306-3587-880f-d4a987df045c",
                        "entry_id": "87a5aa96-af1d-368c-9fee-e6a23165c7f7",
                        "glosses": [
                            "ein altsteinzeitliches, steinernes Spaltwerkzeug mit einer breiten Schneide und einem keilförmigen Längsschnitt"
                        ],
                        "tags": [
                            "Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7a808bb4-9413-4d90-952b-8e69d70b1c09",
                                "sense_id": "2ffb101b-7306-3587-880f-d4a987df045c",
                                "text": "Cleaver treten häufig zusammen mit Faustkeilen auf."
                            },
                            {
                                "example_id": "7338d50a-58a6-41e5-a78f-4b1be60e1263",
                                "sense_id": "2ffb101b-7306-3587-880f-d4a987df045c",
                                "text": "„Der Fundplatz San Quirce in Nordwestspanien ist wichtig, weil hier mehrere Konzentrationen von Artefakten mit Geröllgeräten, Cleavern und […] Abschlägen […] gefunden wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
