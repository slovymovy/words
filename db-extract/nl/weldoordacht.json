                                                "sense_id": "0a0d7575-111c-3580-b04f-5ceb9e6e7f5b",
                                                "text": "a deliberate attempt to cover up his crime"
                                            },
                                            {
                                                "example_id": "3f2c09e0-2082-4428-b168-d9318550f265",
                                                "sense_id": "0a0d7575-111c-3580-b04f-5ceb9e6e7f5b",
                                                "text": "The massacre of up to 8,000 Bosnian Muslims at Srebrenica in 1995 was an act of genocide in a deliberate attempt by the Bosnian Serb leadership to exterminate part of the Muslim community, appeal judges ruled in a crucial case at the international war crimes tribunal in The Hague yesterday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca3c0f87-94a9-3ebd-9ca4-d1e0c5c41307",
                                        "entry_id": "0ee78e32-0488-3cc7-a994-20c5ee2d3f1a",
                                        "glosses": [
                                            "Formed with deliberation; carefully considered; not sudden or rash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437658cb-a4cb-4cf5-beeb-43d995416552",
                                                "sense_id": "ca3c0f87-94a9-3ebd-9ca4-d1e0c5c41307",
                                                "text": "a deliberate opinion; a deliberate measure or result"
                                            },
                                            {
                                                "example_id": "851c2687-15df-42e5-95d7-1bcef3bb5c98",
                                                "sense_id": "ca3c0f87-94a9-3ebd-9ca4-d1e0c5c41307",
                                                "text": "settled visage and deliberate word"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8d5f1b5-700b-3baf-a578-806eaca47deb",
                                        "entry_id": "0ee78e32-0488-3cc7-a994-20c5ee2d3f1a",
                                        "glosses": [
                                            "Of a person, weighing facts and arguments with a view to a choice or decision; carefully considering the probable consequences of a step; slow in determining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5d91e05-eb56-4cb9-a4a8-4bcba391170e",
                                                "sense_id": "e8d5f1b5-700b-3baf-a578-806eaca47deb",
                                                "text": "The jury took eight hours to come to its deliberate verdict."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6726ddf5-de61-3cce-89ef-f822cdf2fd94",
                                        "entry_id": "0ee78e32-0488-3cc7-a994-20c5ee2d3f1a",
                                        "glosses": [
                                            "Not hasty or sudden; slow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
