                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5b85c75-6616-4e83-8f6a-9150e3be9b40",
                                "sense_id": "a1422f04-f439-3b1a-9861-5e1c4967031e",
                                "text": "„Damals wurde verkündet, dass der zwischenzeitlich zum Kommunalpolitikum mutierte Penny-Markt seine schon ausgesprochene Kündigung zurücknimmt und dank einer noch in diesem Jahr mit finanzieller Beteiligung der Vermieterin anstehenden Renovierung bleibt, wo er ist.“"
                            },
                            {
                                "example_id": "e2c09e19-96ae-468b-bde2-53c8e52c28be",
                                "sense_id": "a1422f04-f439-3b1a-9861-5e1c4967031e",
                                "text": "„Nach einer kurzen spöttischen Notiz in der sozialdemokratischen »Münchener Post« über den künftigen »Dr. hace!« wurde die geplante Ehrung zum Kommunalpolitikum und geriet in die Schlagzeilen.“"
                            },
                            {
                                "example_id": "26910584-aeae-44ef-a1c7-bfe85ed6a677",
                                "sense_id": "a1422f04-f439-3b1a-9861-5e1c4967031e",
                                "text": "„Tempo 30 in den Nachtstunden auf der Olgastraße? Das Thema weitet sich zum Kommunalpolitikum aus.“"
                            },
                            {
                                "example_id": "f457db98-dfe6-47ae-80f7-77976c08ddf2",
                                "sense_id": "a1422f04-f439-3b1a-9861-5e1c4967031e",
                                "text": "„Die Sache war längst kein Kommunalpolitikum mehr, selbst das Prager Parlament nahm sich nun der Sache an, auch OSZE und EU begannen sich für den Fall zu interessieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
