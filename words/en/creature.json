{
    "word_family": [
        "create",
        "creation",
        "creative",
        "creativity",
        "creator",
        "creaturely"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e2af704-18f0-388e-b12f-6e2f78fac2ef",
                    "sense_definition": "A living being, such as an animal, monster, or alien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "living beings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ocean is home to many strange <w>creatures</w> that live in the deep water.",
                            "target_lang_translations": {
                                "ru": "Океан является домом для многих странных <w>существ</w>, обитающих в глубоких водах."
                            }
                        },
                        {
                            "text": "In the forest, we saw small <w>creatures</w> like squirrels and birds moving through the trees.",
                            "target_lang_translations": {
                                "ru": "В лесу мы видели маленьких <w>существ</w>, таких как белки и птицы, перемещающихся по деревьям."
                            }
                        }
                    ],
                    "synonyms": [
                        "being",
                        "creature"
                    ],
                    "common_phrases": [
                        "living creature",
                        "sea creature",
                        "strange creature",
                        "small creature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живое существо, такое как животное, монстр или инопланетянин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "существо",
                                "target_lang_sense_clarification": "живой объект"
                            },
                            {
                                "target_lang_word": "создание",
                                "target_lang_sense_clarification": "живой организм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fe35de8-f435-3ad4-8c8d-abcaf9e144e1",
                    "sense_definition": "A human being, often characterized by specific behaviors or traits.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "human nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>creature</w> of habit and always eats breakfast at exactly seven o'clock.",
                            "target_lang_translations": {
                                "ru": "Он — <w>раб</w> своих привычек и всегда завтракает ровно в семь часов."
                            }
                        },
                        {
                            "text": "She is a social <w>creature</w> who loves attending parties and meeting new people.",
                            "target_lang_translations": {
                                "ru": "Она — общительная <w>натура</w>, которая обожает ходить на вечеринки и знакомиться с новыми людьми."
                            }
                        }
                    ],
                    "synonyms": [
                        "being"
                    ],
                    "common_phrases": [
                        "creature of habit",
                        "social creature",
                        "poor creature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, часто характеризующийся определенным поведением или чертами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "существо",
                                "target_lang_sense_clarification": "о человеке с определенными качествами"
                            },
                            {
                                "target_lang_word": "натура",
                                "target_lang_sense_clarification": "характер или привычки человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84192e55-5028-3c56-bbd0-fabf0d049d6f",
                    "sense_definition": "An unidentified, mysterious, and often monstrous animal or being.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "monsters",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers told stories of a mysterious <w>creature</w> that lived in the nearby cave.",
                            "target_lang_translations": {
                                "ru": "Деревенские жители рассказывали истории о таинственном <w>существе</w>, жившем в ближайшей пещере."
                            }
                        },
                        {
                            "text": "In the movie, a terrifying <w>creature</w> emerged from the shadows to scare the explorers.",
                            "target_lang_translations": {
                                "ru": "В фильме из тени появилось ужасающее <w>чудовище</w>, чтобы напугать исследователей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mysterious creature",
                        "mythical creature",
                        "monstrous creature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопознанное, таинственное и часто чудовищное животное или существо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "существо",
                                "target_lang_sense_clarification": "неопределенного или пугающего вида"
                            },
                            {
                                "target_lang_word": "тварь",
                                "target_lang_sense_clarification": "монстр или чудовище"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8013687c-7fa0-371d-a401-b0d34a7454ad",
                    "sense_definition": "A person who is subservient to or heavily dependent upon another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "subservience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician was seen as a mere <w>creature</w> of the powerful corporations that funded him.",
                            "target_lang_translations": {
                                "ru": "Политика считали всего лишь <w>марионеткой</w> могущественных корпораций, которые его финансировали."
                            }
                        },
                        {
                            "text": "He refused to be a <w>creature</w> of the state and fought for his independence.",
                            "target_lang_translations": {
                                "ru": "Он отказался быть <w>орудием</w> государства и боролся за свою независимость."
                            }
                        }
                    ],
                    "common_phrases": [
                        "creature of the state"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который находится в подчинении или сильно зависит от другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставленник",
                                "target_lang_sense_clarification": "лицо, продвинутое кем-то во власть"
                            },
                            {
                                "target_lang_word": "марионетка",
                                "target_lang_sense_clarification": "человек, действующий по чужой воле"
                            },
                            {
                                "target_lang_word": "орудие",
                                "target_lang_sense_clarification": "человек как средство в чьих-то руках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8b3277f-8cf3-3aa5-b4d7-3b91a8f1e0ab",
                    "sense_definition": "A created thing, whether animate or inanimate, especially in relation to a creator.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that every <w>creature</w> owes its existence to a higher power.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что каждое <w>творение</w> обязано своим существованием высшей силе."
                            }
                        },
                        {
                            "text": "In this theological text, the term <w>creature</w> refers to everything made by the divine.",
                            "target_lang_translations": {
                                "ru": "В этом теологическом тексте термин «<w>тварь</w>» относится ко всему, что создано божеством."
                            }
                        }
                    ],
                    "common_phrases": [
                        "creature and creator"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in religious or philosophical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Созданная вещь, одушевленная или неодушевленная, особенно по отношению к творцу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "творение",
                                "target_lang_sense_clarification": "результат созидания"
                            },
                            {
                                "target_lang_word": "создание",
                                "target_lang_sense_clarification": "то, что было сотворено"
                            },
                            {
                                "target_lang_word": "тварь",
                                "target_lang_sense_clarification": "устар., в религиозном смысле: всё живое, созданное Богом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}