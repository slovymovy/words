                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd19504b-5b12-315d-b300-ddc21f3a1b69",
                                        "entry_id": "d156e205-deb9-3e55-a092-7ab8202dfb94",
                                        "glosses": [
                                            "So as to cause terror or awe."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d1ba60-1fa5-43b4-8a9d-9e77b73529db",
                                                "sense_id": "cd19504b-5b12-315d-b300-ddc21f3a1b69",
                                                "text": "The lion roared terribly."
                                            },
                                            {
                                                "example_id": "9ed5cc78-a990-4ec5-9c52-7594ff64788f",
                                                "sense_id": "cd19504b-5b12-315d-b300-ddc21f3a1b69",
                                                "text": "The mere sensuous impact of trumpet or saxophone, whatever it happened to be playing, was an echo, even though a faint echo, of that excitement and abandon. He wanted to taste, smell, hear: his senses were terribly alive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02018c0-36cc-34bd-9ebb-c9412e89c01f",
                                        "entry_id": "d156e205-deb9-3e55-a092-7ab8202dfb94",
                                        "glosses": [
                                            "Very; extremely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56de0aca-3a08-4e3d-9e3a-b6853a38c093",
                                                "sense_id": "e02018c0-36cc-34bd-9ebb-c9412e89c01f",
                                                "text": "He's terribly busy and you really shouldn't bother him."
                                            },
                                            {
                                                "example_id": "b5ff6d43-98c3-4b61-a2f1-a39ccfbec0dc",
                                                "sense_id": "e02018c0-36cc-34bd-9ebb-c9412e89c01f",
                                                "text": "The parsnip, stilton and chestnut combination may taste good, but it's not terribly decorative. In fact, dull's the word, a lingering adjectival ghost of nut roasts past that I'm keen to banish from the table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1e30b7e-62a6-3d0a-99ca-bcb37abadf3c",
                                        "entry_id": "d156e205-deb9-3e55-a092-7ab8202dfb94",
                                        "glosses": [
                                            "Very badly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e690d9bc-08b6-4242-9f3b-a669ea84a063",
                                                "sense_id": "d1e30b7e-62a6-3d0a-99ca-bcb37abadf3c",
                                                "text": "She took part in the karaoke, but sang terribly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
