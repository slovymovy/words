                        {
                            "text": "Jedziemy z <w>ciocią</w> na wakacje!",
                            "target_lang_translations": {
                                "ru": "Мы едем с <w>тётей</w> в отпуск!",
                                "en": "We are going on vacation with our <w>aunt</w>!",
                                "nl": "We gaan met <w>tante</w> op vakantie!",
                                "de": "Wir fahren mit der <w>Tante</w> in den Urlaub!",
                                "fr": "Nous partons en vacances avec <w>tante</w> !",
                                "it": "Andiamo in vacanza con la <w>zia</w>!",
                                "cs": "Jedeme s <w>tetou</w> na dovolenou!",
                                "tr": "<w>Teyzemle</w> tatile gidiyoruz!",
                                "es": "¡Nos vamos de vacaciones con la <w>tía</w>!",
                                "zh": "我们要和<w>阿姨</w>一起去度假！"
                            }
                        },
                        {
                            "text": "Moja <w>ciocia</w> mieszka w Warszawie i często nas odwiedza.",
                            "target_lang_translations": {
                                "ru": "Моя <w>тётя</w> живёт в Варшаве и часто нас навещает.",
                                "en": "My <w>aunt</w> lives in Warsaw and visits us often.",
                                "nl": "Mijn <w>tante</w> woont in Warschau en bezoekt ons vaak.",
                                "de": "Meine <w>Tante</w> wohnt in Warschau und besucht uns oft.",
                                "fr": "Ma <w>tante</w> habite à Varsovie et nous rend souvent visite.",
                                "it": "Mia <w>zia</w> abita a Varsavia e ci viene spesso a trovare.",
                                "cs": "Moje <w>teta</w> bydlí ve Varšavě a často nás navštěvuje.",
                                "tr": "Benim <w>teyzem</w> Varşova'da yaşıyor ve bizi sık sık ziyaret ediyor.",
                                "es": "Mi <w>tía</w> vive en Varsovia y nos visita a menudo.",
                                "zh": "我的<w>阿姨</w>住在华沙，经常来看望我们。"
                            }
                        }
