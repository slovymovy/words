                        "entry_id": "6eb9b136-dfc2-316e-9a12-9cafdbc50d13",
                        "glosses": [
                            "Alternative letter-case form of Calabrese (“a particular type of sprouting broccoli”)."
                        ],
                        "tags": [
                            "alt-of",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "97349e09-1da3-4faa-a215-190589788ca5",
                                "sense_id": "76bffd80-1a8c-3bf8-b4ed-025afcaacf07",
                                "text": "Jean Bean was responsible for the twenty comical characters protecting transplanted cabbages, cauliflowers and calabreses."
                            },
                            {
                                "example_id": "4ccbde95-cd81-405e-8590-c77403e52c3f",
                                "sense_id": "76bffd80-1a8c-3bf8-b4ed-025afcaacf07",
                                "text": "Although most people don't make much distinction between calabrese and broccoli, gardeners need to know the difference. Calabrese is a quick-growing crop, usually maturing in three or four months, and the plants aren't frost hardy."
                            },
                            {
                                "example_id": "4ae5a1c5-a560-48c1-895a-2f764ad31e9d",
                                "sense_id": "76bffd80-1a8c-3bf8-b4ed-025afcaacf07",
                                "text": "Sow calabrese indoors."
                            },
                            {
                                "example_id": "799ca6de-ef06-49b1-86ae-cede7ac07a41",
                                "sense_id": "76bffd80-1a8c-3bf8-b4ed-025afcaacf07",
                                "text": "Some things I'm prepared to persevere with but my patience has an elastic limit and with calabrese it snapped."
                            }
                        ]
                    }
