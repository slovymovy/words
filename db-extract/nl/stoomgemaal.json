                        "examples": [
                            {
                                "example_id": "56239f91-aa2c-4907-8499-9ace74bbc662",
                                "sense_id": "0256acc7-a394-339c-9303-d386c09a16d0",
                                "text": "Het water kon vandaar via het Spaarne afgevoerd worden in de richting van Spaarndam, waar een stoomgemaal het boezemwater op het IJ bracht."
                            },
                            {
                                "example_id": "81fe1304-c1e1-4837-be54-1e7ed1f54e7a",
                                "sense_id": "0256acc7-a394-339c-9303-d386c09a16d0",
                                "text": "Het oude Woudagemaal in Lemmer werkt nog steeds. Afgelopen maanden en ook nu weer is het stoomgemaal hard nodig om het boezemwater uit Friesland te lozen op het IJsselmeer."
                            }
                        ]
