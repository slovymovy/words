                "senses": [
                    {
                        "sense_id": "765740f9-7f16-323d-a1ac-05eb4ef34cc9",
                        "entry_id": "1ce743aa-86ef-3d17-9e22-6ee829c62eea",
                        "glosses": [
                            "действие по значению гл. ругаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47eba453-8d31-4026-8d5f-3fb7745eef47",
                                "sense_id": "765740f9-7f16-323d-a1ac-05eb4ef34cc9",
                                "text": "— Прекратите ругань в эфире! — предупредил его строгий голос."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d7e247b-0341-3b3b-9b15-4b3361b1ee15",
                        "entry_id": "1ce743aa-86ef-3d17-9e22-6ee829c62eea",
                        "glosses": [
                            "грубые, бранные слова"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e56b107-4541-4a7a-b69b-6c38962128c1",
                                "sense_id": "1d7e247b-0341-3b3b-9b15-4b3361b1ee15",
                                "text": "Из открытых окон двухэтажного дома слышались ругань, смех, крики, гудение станков, грохот молотков."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16d8194a-5df4-4ad1-987c-604246056c9c",
                        "source_entry_id": "1ce743aa-86ef-3d17-9e22-6ee829c62eea",
                        "source_sense_description": "действие",
                        "target_lang_word": "swearing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swearing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78a93c95-3e94-37cb-a997-4e118b29251c",
                                        "entry_id": "bc23c0c9-2eec-3027-bf40-ad589d6906e2",
                                        "glosses": [
                                            "present participle and gerund of swear"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7264a7cb-4180-4c3a-a39f-64e2544479f7",
                                                "sense_id": "78a93c95-3e94-37cb-a997-4e118b29251c",
                                                "text": "Swearing doesn't just mean what we now understand by \"dirty words\". It is entwined, in social and linguistic history, with the other sort of swearing: vows and oaths. Consider for a moment the origins of almost any word we have for bad language – \"profanity\", \"curses\", \"oaths\" and \"swearing\" itself."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swearing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8955d33c-6516-3794-8ef4-1ec19fc1ebc8",
                                        "entry_id": "cd520233-2b2d-3556-9211-612a61c90dc7",
                                        "glosses": [
                                            "The act of swearing, or making an oath."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dd90209-2bde-4421-918b-faa4de9139e4",
                                                "sense_id": "8955d33c-6516-3794-8ef4-1ec19fc1ebc8",
                                                "text": "No man is believed a jot the more for all the asseverations, damnings, and swearings he makes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
