                "senses": [
                    {
                        "sense_id": "dcf8e207-33e4-3243-a199-6b013f95f50e",
                        "entry_id": "adfc98fb-d5ab-30ab-a521-f7cdf8cb8eab",
                        "glosses": [
                            "eine (lächerliche) Kleinigkeit, etwas Unbedeutendes"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5888ae09-ed81-4706-8e42-a4c5561ee05a",
                                "sense_id": "dcf8e207-33e4-3243-a199-6b013f95f50e",
                                "text": "Das ist doch Kinderkram!"
                            },
                            {
                                "example_id": "4709ab15-8e75-4b15-b028-2af65ec3b480",
                                "sense_id": "dcf8e207-33e4-3243-a199-6b013f95f50e",
                                "text": "„So ein Kinderkram gehört in die Grundschule, nicht in die siebte Klasse!“"
                            },
                            {
                                "example_id": "1c97cd6d-e610-475a-85f7-b4d6e54e7b32",
                                "sense_id": "dcf8e207-33e4-3243-a199-6b013f95f50e",
                                "text": "„Warum erzählt sie mir diesen Kinderkram immer noch? Ich bin schließlich nicht mehr acht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ad25155-804a-422e-b105-aa6b712b5566",
                        "source_entry_id": "adfc98fb-d5ab-30ab-a521-f7cdf8cb8eab",
                        "source_sense_id": "dcf8e207-33e4-3243-a199-6b013f95f50e",
                        "source_sense_description": "umgangssprachlich: eine (lächerliche) Kleinigkeit, etwas Unbedeutendes",
                        "target_lang_word": "child's play",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "child's play",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8c2864-0045-38fe-942c-46e0214e5440",
                                        "entry_id": "c281c560-b91f-3b0f-b19e-a8ca92d88a88",
                                        "glosses": [
                                            "Something particularly easy or simple."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25e4bda1-43e8-4d10-bc64-7f10352e31dd",
                                                "sense_id": "7c8c2864-0045-38fe-942c-46e0214e5440",
                                                "text": "Compared to my last job, this is child’s play."
                                            },
                                            {
                                                "example_id": "24fd7d17-1de5-4092-8d2c-3189286d143d",
                                                "sense_id": "7c8c2864-0045-38fe-942c-46e0214e5440",
                                                "text": "The brawny craftsman finds it no child's play to mould his unpliant rugged masses; neither is guidance of men a dilettantism: what it becomes when treated as a dilettantism, we may see!"
                                            },
                                            {
                                                "example_id": "a7be087f-6baa-4af7-984b-16f8487f6110",
                                                "sense_id": "7c8c2864-0045-38fe-942c-46e0214e5440",
                                                "text": "In every county there were elderly gentlemen who had seen service which was no child's play."
                                            },
                                            {
                                                "example_id": "4de604b9-3fc1-4b7e-a9ca-bb60a683e0d9",
                                                "sense_id": "7c8c2864-0045-38fe-942c-46e0214e5440",
                                                "text": "He'd pull his bars apart like bow and bow-string, / And let them go and make them twang until / His hands had worn them smooth as any ox-bow. / And then he'd crow as if he thought that child's play— / The only fun he had."
                                            },
                                            {
                                                "example_id": "ec382969-ea19-4d8b-8911-e32fd747f996",
                                                "sense_id": "7c8c2864-0045-38fe-942c-46e0214e5440",
                                                "text": "I knew something of the railway engineer's uncanny genius for finding a path through such barriers if any path existed; yet I also knew the path would be no child's play."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c52796ec-1ba6-4147-b409-525e19717f8f",
                        "source_entry_id": "adfc98fb-d5ab-30ab-a521-f7cdf8cb8eab",
                        "source_sense_id": "dcf8e207-33e4-3243-a199-6b013f95f50e",
                        "source_sense_description": "umgangssprachlich: eine (lächerliche) Kleinigkeit, etwas Unbedeutendes",
                        "target_lang_word": "kid stuff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kid stuff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61628d9d-ee4b-3084-9c28-5420f981eb3f",
                                        "entry_id": "ba1a4e49-0908-3be1-8d66-d0757a3c1a20",
                                        "glosses": [
                                            "Something done by, used by, or characteristic of immature people, especially children."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5257cab8-8da1-4d6c-ae16-3a8698e05ef0",
                                                "sense_id": "61628d9d-ee4b-3084-9c28-5420f981eb3f",
                                                "text": "The scene on television is of a boy's bedroom. The camera pans slowly across ageless kid stuff: baseball cards, posters, clumps of dirty laundry."
                                            },
                                            {
                                                "example_id": "304b135c-38ed-4cb8-8267-461aa47a5a32",
                                                "sense_id": "61628d9d-ee4b-3084-9c28-5420f981eb3f",
                                                "text": "If spitting is supposed to scare the opponent, it fails miserably. . . . It's not only unhealthy and silly, it's schoolyard kid stuff."
                                            },
                                            {
                                                "example_id": "ba273115-8a77-4e62-b50f-f3d6e7cda878",
                                                "sense_id": "61628d9d-ee4b-3084-9c28-5420f981eb3f",
                                                "text": "The kids know we are both there and committed to them, and they don’t live in a warzone. They seem happy, have friendships, do kid stuff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6466540-1c8d-3e02-8c05-87744574d0d7",
                                        "entry_id": "ba1a4e49-0908-3be1-8d66-d0757a3c1a20",
                                        "glosses": [
                                            "Something that is easy to do or easy to understand."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e90f0c55-42c2-45fb-b89b-73245e2d0d7a",
                                                "sense_id": "e6466540-1c8d-3e02-8c05-87744574d0d7",
                                                "text": "It's kid stuff to barrel along in a car like a big shot. I kept the needle right on fiftyfive."
                                            },
                                            {
                                                "example_id": "47402682-5551-4f91-a2f6-3bdbe33c34d4",
                                                "sense_id": "e6466540-1c8d-3e02-8c05-87744574d0d7",
                                                "text": "For our second Teton expedition, we decide, enough with the kid stuff. We settle on a six-mile hike up to Taggart and Bradley lakes"
                                            },
                                            {
                                                "example_id": "84390e16-5841-4015-99b8-3b52fcaac1ab",
                                                "sense_id": "e6466540-1c8d-3e02-8c05-87744574d0d7",
                                                "text": "If a skier just holds his body still, the rotational momentum will result in a triple flip in layout, or nontwisting, position. While it looks death-defying, that kind of jump is kid stuff to a judge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12e11b95-99b2-46c5-a776-63c35debdb3e",
                        "source_entry_id": "adfc98fb-d5ab-30ab-a521-f7cdf8cb8eab",
                        "source_sense_id": "dcf8e207-33e4-3243-a199-6b013f95f50e",
