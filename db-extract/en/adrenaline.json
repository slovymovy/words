                    },
                    {
                        "sense_id": "6bf9aa96-ae59-3248-bff6-25658c44d19f",
                        "entry_id": "2a5006bb-dc88-3940-a642-f8dc63609e0c",
                        "glosses": [
                            "興奮；激動"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec29c365-a006-4d2b-a4fe-6126d614a269",
                                "sense_id": "6bf9aa96-ae59-3248-bff6-25658c44d19f",
                                "text": "Some people bungee jump to feel alive through the surge of adrenaline.",
                                "translation": "有些人進行高空彈跳讓感興奮感激增，感受活著的感覺。"
                            },
                            {
                                "example_id": "4c4d2513-ceaf-407a-a7b3-7f4463dcc7bf",
                                "sense_id": "6bf9aa96-ae59-3248-bff6-25658c44d19f",
                                "text": "Despite the crisis, the adrenaline that must have been feeding his own alarm, Tim managed to maintain his control and spoke in a subdued tone, assuring the tenderman and all of us that things would be okay.",
                                "translation": "尽管危机四伏，激动也必然加剧了自己的恐慌，但蒂姆还是设法保持镇定，用低沉的语气，向投标人和我们所有人保证一切都会好起来。"
                            }
                        ]
                    }
                ],
