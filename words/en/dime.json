                },
                {
                    "sense_id": "df86e7e1-8ffa-30bb-92c8-5a726b97d717",
                    "sense_definition": "A prison sentence of ten years.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge gave him a <dime> for the robbery.",
                            "target_lang_translations": {
                                "ru": "Судья дал ему <w>червонец</w> за ограбление.",
                                "zh": "法官因抢劫判了他<w>十年刑期</w>。"
                            }
                        },
                        {
                            "text": "He served a <dime> in a minimum-security prison.",
                            "target_lang_translations": {
                                "ru": "Он отсидел <w>десятку</w> в колонии-поселении.",
                                "zh": "他在一所低戒备监狱里服满了<w>十年刑期</w>。"
                            }
                        }
