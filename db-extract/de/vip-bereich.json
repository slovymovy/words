                "senses": [
                    {
                        "sense_id": "0f027e73-1688-3c9b-99f5-43688304e522",
                        "entry_id": "a4eddf08-7f3d-36f8-9982-b2f562ffe8d8",
                        "glosses": [
                            "Bereich, zu dem nur Leute mit besonderen Privilegien Zugang haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80238fd7-7dd1-4130-9eca-5e46920a891d",
                                "sense_id": "0f027e73-1688-3c9b-99f5-43688304e522",
                                "text": "„Darauf hatte General Zia mehrmals an öffentlichen Veranstaltungen teilgenommen, aber sobald er den VIP-Bereich verließ, um sich unter sein Volk zu mischen, musste er feststellen, dass es sich um bestellte Claqueure handelte.“"
                            },
                            {
                                "example_id": "0b865e97-1f2e-4a13-ab37-70ad44328da2",
                                "sense_id": "0f027e73-1688-3c9b-99f5-43688304e522",
                                "text": "„Ein ISI-Konvoi würde sie zum militärischen Teil des Flughafens von Islamabad bringen, wo sie in einem speziell abgesicherten VIP-Bereich warten sollte, bis ein Panzerwagen sie unmittelbar vor dem Start zu dem Flugzeug der Emirates Airlines brachte.“"
                            },
                            {
                                "example_id": "c30b9eb9-d692-45d5-8759-983ffe21f613",
                                "sense_id": "0f027e73-1688-3c9b-99f5-43688304e522",
                                "text": "„Zuerst fuhr ich sie vom Flugzeug zu einer Pressekonferenz im VIP-Bereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
