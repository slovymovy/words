                                "sense_id": "7cd75b0a-73b7-385b-a486-c57eee30cf68",
                                "text": "Spotkajmy się punktualnie o ósmej."
                            },
                            {
                                "example_id": "98fa79af-ab6f-4f0f-ba8f-fb089f647e18",
                                "sense_id": "7cd75b0a-73b7-385b-a486-c57eee30cf68",
                                "text": "Ten autobus zwykle się spóźnia, ale dziś przyjechał punktualnie."
