        "cs-extract.jsonl": [
            {
                "entry_id": "f0c5591f-b52a-3482-a539-3102f5354d2f",
                "word": "consecration",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a4cbec3d-e895-48c0-b7ce-3c6f8691d64e",
                        "entry_id": "f0c5591f-b52a-3482-a539-3102f5354d2f",
                        "tags": [
                            "nominative",
                            "plural"
                        ],
                        "form": "consecrations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b4205b2-74bc-37f1-97d9-ac517e95b969",
                        "entry_id": "f0c5591f-b52a-3482-a539-3102f5354d2f",
                        "glosses": [
                            "svěcení, vysvěcení, posvěcení, zasvěcení"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "535f7fbc-6ffb-48bf-9f84-9bba76459729",
                                "sense_id": "6b4205b2-74bc-37f1-97d9-ac517e95b969",
                                "text": "He had never heard of the pagan ritual of the consecration of virgins.",
                                "translation": "Nikdy neslyšel o pohanském rituálu svěcení pannen."
                            },
                            {
                                "example_id": "1c867b6c-ad54-451c-84c7-a9747aef45f8",
                                "sense_id": "6b4205b2-74bc-37f1-97d9-ac517e95b969",
                                "text": "She was planning a special ceremony for the consecration of the new church.",
                                "translation": "Plánovala speciální ceremoniál na svěcení nového kostela."
                            },
                            {
                                "example_id": "b4bba07a-65c4-48c3-affc-3fc3090f7a20",
                                "sense_id": "6b4205b2-74bc-37f1-97d9-ac517e95b969",
                                "text": "The consecration of the new bishop was a grand event attended by many dignitaries.",
                                "translation": "Svěcení nového biskupa bylo velkolepou událostí, které se zúčastnilo mnoho hodnostářů."
                            },
                            {
                                "example_id": "ac66b792-940e-48b5-a877-58f873379d09",
                                "sense_id": "6b4205b2-74bc-37f1-97d9-ac517e95b969",
                                "text": "The young nun had dreamed of her consecration ceremony for years.",
                                "translation": "Mladá jeptiška roky snila o svém zasvěcení."
                            },
                            {
                                "example_id": "a79a7e32-5c6a-406e-90f0-4a4e42b2dbe6",
                                "sense_id": "6b4205b2-74bc-37f1-97d9-ac517e95b969",
                                "text": "The consecration of the holy water was performed by the bishop in a solemn ceremony.",
                                "translation": "Biskup ve slavnostním ceremoniálu posvětil vodu."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
