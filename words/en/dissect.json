{
    "word_family": [
        "dissection",
        "dissector"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e7c3e38-1476-3eb2-ab93-08539527be1d",
                    "sense_definition": "To analyze an idea, text, or situation in great detail by examining each of its parts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "analyze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor asked the students to <w>dissect</w> the central themes of the novel."
                        },
                        {
                            "text": "Journalists began to carefully <w>dissect</w> the speech to find hidden political messages."
                        }
                    ],
                    "synonyms": [
                        "analyze",
                        "examine",
                        "scrutinize"
                    ],
                    "common_phrases": [
                        "dissect the problem",
                        "dissect an argument"
                    ]
                },
                {
                    "sense_id": "afbf4d93-db3d-39f0-a02f-b5bf1c0d3bcc",
                    "sense_definition": "To cut open and examine the internal structure of a dead animal, plant, or human body for scientific study.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomical_cut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In biology class, we were required to <w>dissect</w> a preserved frog."
                        },
                        {
                            "text": "She was the first person in her class to properly <w>dissect</w> the sheep heart."
                        }
                    ],
                    "synonyms": [
                        "anatomize"
                    ],
                    "common_phrases": [
                        "dissect a specimen",
                        "dissect a frog"
                    ]
                },
                {
                    "sense_id": "8fb51b2c-2f3f-34d4-a172-e94c0254d4dd",
                    "sense_definition": "To carefully separate tissues, muscles, or organs during a surgical procedure without damaging them.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surgical_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon worked slowly to <w>dissect</w> the tumor from the surrounding healthy tissue."
                        },
                        {
                            "text": "Now <w>dissect</w> the triceps away from its attachment on the humerus."
                        }
                    ],
                    "common_phrases": [
                        "dissect tissue"
                    ]
                },
                {
                    "sense_id": "5f49cb9e-1d6a-3f60-afb9-08ad8b171e93",
                    "sense_definition": "To spread or extend along tissue planes, such as fascia between muscles or organs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pathology_spread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bacterial infection began to <w>dissect</w> through the deep fascial layers of the neck."
                        },
                        {
                            "text": "Extravasated blood can <w>dissect</w> along tissue planes and cause extensive swelling."
                        }
                    ]
                }
            ]
        }
    ]
