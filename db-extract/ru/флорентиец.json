                                    }
                                ]
                            },
                            {
                                "target_word": "Florentin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd6ed977-8b26-39b7-8b30-e42866d722ba",
                                        "entry_id": "a9f06cc7-5955-3788-8fea-b368f15716e9",
                                        "glosses": [
                                            "Habitant de Florence, en Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "674dabaf-81f5-48a0-bcf0-7c23d26b1de8",
                                                "sense_id": "cd6ed977-8b26-39b7-8b30-e42866d722ba",
                                                "text": "[…] Catherine de Médicis, craignant la révélation de ce secret, l’avait empoisonnée avec des gants de senteur qui avaient été confectionnés par un nomme Réné, Florentin fort habile dans ces sortes de matières."
                                            },
                                            {
                                                "example_id": "c3820291-ea1d-46ad-8272-0a79922fda97",
                                                "sense_id": "cd6ed977-8b26-39b7-8b30-e42866d722ba",
                                                "text": "Le dieu qui fit les collines de Florence était artiste. Oh ! il était joaillier, graveur en médailles, sculpteur, fondeur en bronze et peintre ; c’était un Florentin. Il n’a fait que cela au monde, darling ! Le reste est d’une main moins délicate, d’un travail moins parfait. Comment voulez-vous que cette colline violette de San Miniato, d’un relief si ferme et si pur, soit de l’auteur du Mont Blanc ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02158906-b94a-34e2-8635-b2cd67fd4029",
                                        "entry_id": "a9f06cc7-5955-3788-8fea-b368f15716e9",
                                        "glosses": [
                                            "Habitant de Florent-en-Argonne, commune française située dans le département de la Marne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
