                        "entry_id": "40c4f9d1-7598-3a37-b052-bc9c8ac11bc5",
                        "glosses": [
                            "Qui supplie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d8888d3-78cf-47d6-bdcc-8c5977200d42",
                                "sense_id": "6183e905-4059-3891-9cb2-5dccb9b5d029",
                                "text": "Il se jeta à ses pieds tout suppliant."
                            },
                            {
                                "example_id": "9c05aa47-c00f-47ec-b1ba-2e894d24c2a2",
                                "sense_id": "6183e905-4059-3891-9cb2-5dccb9b5d029",
                                "text": "Une posture suppliante."
                            },
                            {
                                "example_id": "33b83f64-85dd-45ac-bb35-07f3792e928e",
                                "sense_id": "6183e905-4059-3891-9cb2-5dccb9b5d029",
                                "text": "Il s’est adressé à moi en termes suppliants."
                            },
                            {
                                "example_id": "b1d69fa7-eef7-40ac-a3b5-3400eccf8f44",
                                "sense_id": "6183e905-4059-3891-9cb2-5dccb9b5d029",
                                "text": "Il faut vieillir. Ne pleure pas, ne joins pas des doigts suppliants, ne te révolte pas il faut vieillir. Répète-toi cette parole, non comme un cri de désespoir, mais comme le rappel d’un départ nécessaire."
                            }
                        ]
                    }
