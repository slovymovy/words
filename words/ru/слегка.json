                    "sense_definition": "Немного, в незначительной степени; чуть-чуть.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>слегка</w> устал после долгой дороги домой.",
                            "target_lang_translations": {
                                "en": "I was <w>slightly</w> tired after the long journey home.",
                                "nl": "Ik was <w>lichtjes</w> vermoeid na de lange reis naar huis.",
                                "pl": "Byłem <w>lekko</w> zmęczony po długiej drodze do domu.",
                                "de": "Ich bin nach der langen Heimreise <w>leicht</w> müde.",
                                "fr": "Je suis <w>légèrement</w> fatigué après le long trajet pour rentrer à la maison.",
                                "it": "Mi sono sentito <w>leggermente</w> stanco dopo il lungo viaggio verso casa.",
                                "cs": "Po dlouhé cestě domů jsem byl <w>trochu</w> unavený.",
                                "tr": "Eve giden uzun yoldan sonra <w>hafifçe</w> yoruldum.",
                                "es": "Estoy <w>ligeramente</w> cansado después del largo camino a casa.",
                                "zh": "长途跋涉回家后，我感到<w>稍微</w>有些累。"
                            }
                        },
                        {
                            "text": "Дверь в комнату была <w>слегка</w> приоткрыта.",
                            "target_lang_translations": {
                                "en": "The door to the room was <w>slightly</w> ajar.",
                                "nl": "De deur naar de kamer stond <w>op een kier</w>.",
                                "pl": "Drzwi do pokoju były <w>lekko</w> uchylone.",
                                "de": "Die Zimmertür stand <w>leicht</w> offen.",
                                "fr": "La porte de la chambre était <w>légèrement</w> entrouverte.",
                                "it": "La porta della stanza era <w>leggermente</w> socchiusa.",
                                "cs": "Dveře do pokoje byly <w>lehce</w> pootevřené.",
                                "tr": "Odanın kapısı <w>hafifçe</w> aralıktı.",
                                "es": "La puerta de la habitación estaba <w>ligeramente</w> entreabierta.",
                                "zh": "房间的门<w>稍微</w>开着一条缝。"
                            }
                        }
                    ],
                    "synonyms": [
                        "немного",
                        "чуть-чуть"
