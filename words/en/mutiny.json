{
    "word_family": [
        "mutineer",
        "mutinous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9623de2-a588-30c0-8c37-2e5aba003466",
                    "sense_definition": "An organized rebellion against a legally constituted authority, especially by soldiers or sailors against their superiors.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rebellion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors staged a <w>mutiny</w> against their captain due to the lack of food.",
                            "target_lang_translations": {
                                "ru": "Матросы подняли <w>бунт</w> против своего капитана из-за нехватки еды."
                            }
                        },
                        {
                            "text": "The soldiers were punished severely for their role in the <w>mutiny</w>.",
                            "target_lang_translations": {
                                "ru": "Солдаты были сурово наказаны за участие в <w>мятеже</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebellion",
                        "uprising",
                        "insurrection",
                        "revolt"
                    ],
                    "common_phrases": [
                        "stage a mutiny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организованное восстание против законной власти, особенно солдат или матросов против своих командиров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бунт",
                                "target_lang_sense_clarification": "стихийное или организованное выступление против власти"
                            },
                            {
                                "target_lang_word": "мятеж",
                                "target_lang_sense_clarification": "вооруженное выступление против государственной власти"
                            },
                            {
                                "target_lang_word": "восстание",
                                "target_lang_sense_clarification": "массовое вооруженное выступление против существующей власти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f2f4d5d-6c88-3d3a-8d17-5dde292a02c0",
                    "sense_definition": "A state of violent commotion, tumult, or strife.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rebellion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political debate descended into a <w>mutiny</w> of shouting and chaos.",
                            "target_lang_translations": {
                                "ru": "Политические дебаты превратились в <w>беспорядочный шум</w> и хаос."
                            }
                        },
                        {
                            "text": "He tried to calm the <w>mutiny</w> of angry voices in the crowded room.",
                            "target_lang_translations": {
                                "ru": "Он попытался успокоить <w>бурю</w> гневных голосов в переполненной комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "tumult",
                        "strife",
                        "commotion"
                    ],
                    "antonyms": [
                        "order",
                        "peace"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние бурного беспорядка, шума или раздора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспорядок",
                                "target_lang_sense_clarification": "отсутствие порядка, хаос"
                            },
                            {
                                "target_lang_word": "суматоха",
                                "target_lang_sense_clarification": "беспорядочная суета, шум"
                            },
                            {
                                "target_lang_word": "раздор",
                                "target_lang_sense_clarification": "состояние вражды и конфликта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e1b9d88-9e26-304d-97ad-09575b2baae9",
                    "sense_definition": "To participate in an organized rebellion against authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rebellion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers decided to <w>mutiny</w> rather than follow the dangerous orders.",
                            "target_lang_translations": {
                                "ru": "Солдаты решили <w>взбунтоваться</w>, вместо того чтобы выполнять опасные приказы."
                            }
                        },
                        {
                            "text": "The crew <w>mutinied</w> after weeks of harsh treatment by the officers.",
                            "target_lang_translations": {
                                "ru": "Экипаж <w>взбунтовался</w> после недель жестокого обращения со стороны офицеров."
                            }
                        }
                    ],
                    "synonyms": [
                        "rebel",
                        "revolt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в организованном восстании против власти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бунтовать",
                                "target_lang_sense_clarification": "поднимать бунт или участвовать в нем"
                            },
                            {
                                "target_lang_word": "взбунтоваться",
                                "target_lang_sense_clarification": "начать бунт, проявить неповиновение"
                            },
                            {
                                "target_lang_word": "восстать",
                                "target_lang_sense_clarification": "подняться на борьбу против кого-либо или чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}