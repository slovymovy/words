                                            {
                                                "example_id": "15ba2a7f-77be-4b15-a769-b7c16ec63b23",
                                                "sense_id": "6c535610-f5fb-3bb5-8de2-94a3b6f165a6",
                                                "text": "De dokter zette zijn stethoscoop op de borstkas van de patiënt en verzocht hem diep te zuchten."
                                            }
                                        ]
                                    }
                                ]
