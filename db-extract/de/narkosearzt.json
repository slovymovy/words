                "senses": [
                    {
                        "sense_id": "26a7a42f-e67c-37a7-bc55-729e04a675f9",
                        "entry_id": "5531fa18-4988-3907-94ac-3413f8e67a20",
                        "glosses": [
                            "Arzt, der bei Operationen die Betäubung (Narkose) des Patienten durchführt oder leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76226302-34b6-4ec6-bd7c-831bac2ab761",
                                "sense_id": "26a7a42f-e67c-37a7-bc55-729e04a675f9",
                                "text": "Bei dieser Operation waren mehrere Narkoseärzte zugegen."
                            },
                            {
                                "example_id": "0e347c01-25d1-4927-858d-65dc45b97f24",
                                "sense_id": "26a7a42f-e67c-37a7-bc55-729e04a675f9",
                                "text": "Vor dem Eingriff ist ein Gespräch mit Ihrem Narkosearzt geplant."
                            },
                            {
                                "example_id": "7a67e515-2f34-47e7-a00a-9d9f4abb98cf",
                                "sense_id": "26a7a42f-e67c-37a7-bc55-729e04a675f9",
                                "text": "„»Also wenn wir operieren machen wir das so, dass wir die Patienten hier hinsitzen lassen, da kommt ein Stühlchen hin. Dann kommt ein Aufklärungsgespräch mit dem Narkosearzt hier in dem Raum.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
