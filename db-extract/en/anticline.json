                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba46a569-bc10-4d75-8fa1-87146025a4d2",
                                                "sense_id": "1c60b1e7-7075-3cff-a919-800ac2acea55",
                                                "text": "Zamknięciem siodła jest peryklina."
                                            }
                                        ],
