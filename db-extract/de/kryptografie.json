                "senses": [
                    {
                        "sense_id": "28184cfc-358f-3387-83d0-4550d4324159",
                        "entry_id": "786b27c7-7db0-3232-ad2d-f9bbe3168e33",
                        "glosses": [
                            "Wissenschaft der Verschlüsselung von Informationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b8d26d9-a43e-496c-a448-04e2a36eab02",
                                "sense_id": "28184cfc-358f-3387-83d0-4550d4324159",
                                "text": "„Für Phil Zimmermann von Silent Circle sind sichere Software und Verschlüsselung aber nur der Anfang. \"Es reicht nicht, gute Kryptografie zu haben, wenn du auf dem Gerät Schadsoftware hast.\"“"
                            },
                            {
                                "example_id": "11779edd-5453-4e5f-83ec-1f0f5c296772",
                                "sense_id": "28184cfc-358f-3387-83d0-4550d4324159",
                                "text": "„ Ebenfalls ermöglicht das Tool einen hochwertigen Schutz sensibler Daten in Ländern, in denen es Einschränkungen oder Verbote in der Datenverschlüsselung (Kryptografie) gibt.“"
                            },
                            {
                                "example_id": "90823179-cb33-4edb-be76-cd5a52f10bb6",
                                "sense_id": "28184cfc-358f-3387-83d0-4550d4324159",
                                "text": "„Und so begann Amalia mir etwas über Kryptografie, die Wissenschaft von der Verschlüsselung von Informationen, zu erzählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f3d11ca9-2a1c-374b-b416-cf7826058389",
                        "entry_id": "786b27c7-7db0-3232-ad2d-f9bbe3168e33",
                        "glosses": [
                            "absichtslos entstandene Kritzelzeichnung eines Erwachsenen"
                        ],
