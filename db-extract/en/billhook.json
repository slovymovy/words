                                    {
                                        "sense_id": "7a9217ce-c150-3a79-88b9-6e9348e5fb24",
                                        "entry_id": "2d7eab6d-1384-3072-84a5-d3f632c61ad3",
                                        "glosses": [
                                            "juichkreet; deel van de juichkreet Hiep, hiep, Hoera!"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcbfe805-6076-430e-8e2d-ca2ad5b4048f",
                                                "sense_id": "7a9217ce-c150-3a79-88b9-6e9348e5fb24",
                                                "text": "Een feestelijke dag voor Kjeld Nuis. Op zijn Instagram is de schaatser te zien met zijn zoontje, die vandaag twee kaarsjes uit mag blazen. Hiep hiep. Hoera!"
                                            },
                                            {
                                                "example_id": "14ea0bec-1c05-4938-9764-7cd520a71937",
                                                "sense_id": "7a9217ce-c150-3a79-88b9-6e9348e5fb24",
                                                "text": "„Nu maar duimen dat ze muziek sturen waar ik iets mee kan”, aldus Buitenhuis. „En dat de stem die dag goed is. Hiep Hiep Hoera!!”"
                                            }
                                        ]
                                    }
                                ]
                            },
