                                "example_id": "0c939122-a19e-49a7-810f-f3385ccb736b",
                                "sense_id": "e6240625-28e7-3262-aaff-2e5f19f92332",
                                "text": "Hij had een paar vlaggenlijnen in zijn kamer hangen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b61e8a20-3e25-4e3c-868c-ae2744980bcc",
                        "source_entry_id": "68f74c50-23ca-3cc0-a546-47b247df3ce1",
                        "source_sense_id": "e6240625-28e7-3262-aaff-2e5f19f92332",
                        "source_sense_description": "een slinger van vlaggen",
                        "target_lang_word": "Flaggenleine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "027721d6-0f57-4e44-9535-7a7f82245dc3",
                        "source_entry_id": "68f74c50-23ca-3cc0-a546-47b247df3ce1",
                        "source_sense_id": "e6240625-28e7-3262-aaff-2e5f19f92332",
                        "source_sense_description": "een slinger van vlaggen",
                        "target_lang_word": "halyard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halyard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdabaf84-5762-36a0-a5bb-437aa9d3a8c2",
                                        "entry_id": "e9cd4a34-4db6-3c1b-9715-bffcef4bfe66",
                                        "glosses": [
                                            "A rope used to raise or lower a sail, flag, spar or yard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1e29ad-044a-46aa-86c7-b0eeb5c48d57",
                                                "sense_id": "bdabaf84-5762-36a0-a5bb-437aa9d3a8c2",
                                                "text": "At last I got my knife and cut the halyards. The peak dropped instantly, a great belly of loose canvas floated broad upon the water […]"
                                            },
                                            {
                                                "example_id": "5b3218f6-51a9-450b-9538-05445667d898",
                                                "sense_id": "bdabaf84-5762-36a0-a5bb-437aa9d3a8c2",
                                                "text": "[…]broad-shouldered men with hard red-beaked faces and huge hands coarsened by generations of straining on heavy oars and halyards,—men who feared only God and the sea-spirits of their strange mythology and were a law unto themselves, adventurers and bigots."
                                            },
                                            {
                                                "example_id": "9e4a17a5-1e8a-4a60-9446-003631f143bd",
                                                "sense_id": "bdabaf84-5762-36a0-a5bb-437aa9d3a8c2",
                                                "text": "Uncleat the black main halyard to lower and remove the jib cover; remove the main halyard from the jib cover."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a48ea88-8b7d-4747-8d0b-49e3e654b1e1",
                        "source_entry_id": "68f74c50-23ca-3cc0-a546-47b247df3ce1",
                        "source_sense_id": "e6240625-28e7-3262-aaff-2e5f19f92332",
                        "source_sense_description": "een slinger van vlaggen",
                        "target_lang_word": "drisse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "927bfd13-b5f6-3934-87a0-9d99925265ec",
                                        "entry_id": "8b24a410-1af4-3f98-9831-dca05b600295",
                                        "glosses": [
                                            "Cordage qui sert à élever, à hisser une voile, un pavillon, une flamme à la hauteur où ces objets doivent être placés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c783273c-46c6-4199-b577-8997b96643c6",
                                                "sense_id": "927bfd13-b5f6-3934-87a0-9d99925265ec",
                                                "text": "Norman, ne pouvant abandonner sa barre, et les drisses étant engagées à la tête du mât, la voile n'amenait pas."
                                            },
                                            {
                                                "example_id": "e118e227-c869-4fd2-82ae-10cc8c75c999",
                                                "sense_id": "927bfd13-b5f6-3934-87a0-9d99925265ec",
                                                "text": "La chaloupe démarrée, on hissa les voiles dont les drisses crièrent sinistrement au long des mâts, […]."
                                            },
                                            {
                                                "example_id": "dd6398ad-03fd-4c65-92f3-b72ba86d9adc",
                                                "sense_id": "927bfd13-b5f6-3934-87a0-9d99925265ec",
                                                "text": "Chacun allait prendre sa place, qui au cabestan, qui aux drisses, qui encore le long du bastingage."
                                            },
                                            {
                                                "example_id": "d61f2e88-2730-4f32-b139-e448c6b5ad28",
                                                "sense_id": "927bfd13-b5f6-3934-87a0-9d99925265ec",
                                                "text": "L’équipage était au travail, qui capelant les drisses, qui déployant les voiles ; on sentait flotter autour du Lhaiz cette atmosphère affairée, chargée d’électricité, qui règne sur un bateau en instance de départ."
                                            },
                                            {
                                                "example_id": "6046c83d-a8bd-4a82-94eb-bc1d09fe4b12",
                                                "sense_id": "927bfd13-b5f6-3934-87a0-9d99925265ec",
                                                "text": "La drisse de grand-voile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29e7ab28-bfa7-333d-ad64-6acf04143798",
                                        "entry_id": "7834d8e0-e03a-38c2-9874-538c6d0dc838",
                                        "glosses": [
                                            "Diarrhée."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "147b4daa-0804-452a-a43d-511aedcfbd69",
                                                "sense_id": "29e7ab28-bfa7-333d-ad64-6acf04143798",
                                                "text": "Adonis, t'as la drisse — Pharmacien, une petite médecine pour la fille du diable qui a mal à son ventre !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfa866e1-9b9a-3632-baca-eb06c3fc0bb0",
                                        "entry_id": "7834d8e0-e03a-38c2-9874-538c6d0dc838",
                                        "glosses": [
                                            "Avoir la drisse : avoir très peur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e923d88a-b1ec-44e9-a2d8-84f0a39be620",
                                                "sense_id": "bfa866e1-9b9a-3632-baca-eb06c3fc0bb0",
                                                "text": "… se moquaient volontiers d'eux en disant qu'à la guerre les Saint-Maurice avaient la drisse !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "drisse",
