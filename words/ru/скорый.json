    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2046406b-c9cc-30d8-bcc9-aca09ca93a52",
                    "sense_definition": "Действующий или перемещающийся быстро, совершающийся за короткий промежуток времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На вокзале нас ждал <w>скорый</w> поезд до Москвы."
                        },
                        {
                            "text": "Врачи <w>скорой</w> помощи приехали через десять минут."
                        }
                    ],
                    "synonyms": [
                        "быстрый",
                        "стремительный",
                        "скоростной"
                    ],
                    "antonyms": [
                        "медленный",
                        "неторопливый"
                    ],
                    "common_phrases": [
                        "скорый поезд",
                        "скорая помощь"
                    ]
                },
                {
                    "sense_id": "abe41eb3-7555-3061-9516-93ce31821d86",
                    "sense_definition": "Ожидаемый в недалёком будущем, тот что скоро наступит.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все с нетерпением ждали <w>скорого</w> прихода весны."
                        },
                        {
                            "text": "Он надеялся на <w>скорое</w> возвращение домой после долгой поездки."
                        }
                    ],
                    "synonyms": [
                        "близкий",
                        "грядущий",
                        "наступающий"
                    ],
                    "antonyms": [
                        "отдалённый"
                    ],
                    "common_phrases": [
                        "скорое возвращение",
                        "скорый приход"
                    ]
                },
                {
                    "sense_id": "f96ea6ff-c6fa-3a27-b326-19eaefe35a04",
                    "sense_definition": "Слишком быстрый, чересчур поспешный в действиях или решениях.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не будь таким <w>скорым</w> на выводы, сначала разберись в ситуации."
                        },
                        {
                            "text": "Он был очень <w>скор</w> на расправу с теми, кто ему не нравился."
