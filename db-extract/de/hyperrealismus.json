                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c573318-951d-48c7-97dd-b7c6c98d14ec",
                        "source_entry_id": "f136bb6d-28c9-30d1-a299-4c162239a7aa",
                        "source_sense_id": "a4092f53-5413-3e1b-b3fa-28e5f6980ffa",
