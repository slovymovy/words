                ],
                "senses": [
                    {
                        "sense_id": "bd77543d-b310-3efe-bffd-59f792f45ef6",
                        "entry_id": "7564ecfd-0856-3dcf-a2be-86cbb4d628cf",
                        "glosses": [
                            "разг. вдвигать, помещать что-либо куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdca04a0-d530-46c5-b1b2-7ab80fb46bff",
                                "sense_id": "bd77543d-b310-3efe-bffd-59f792f45ef6",
                                "text": "Это была Леночкина безалаберность, она вечно засовывала в холодильник пустые пакеты."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4d4663c-0a1c-3b28-bf8e-7b8dee78eb09",
                        "entry_id": "7564ecfd-0856-3dcf-a2be-86cbb4d628cf",
                        "glosses": [
                            "разг. помещать или прятать так, чтобы стало трудно найти или достать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d7e7289-a300-43af-8950-7f76b8369f3c",
                                "sense_id": "d4d4663c-0a1c-3b28-bf8e-7b8dee78eb09",
                                "text": "Про то, что начальник теряет ее работы, засовывает куда-то в бумаги, а потом не может найти."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a475fe1-3558-4044-85a9-cff50213f288",
                        "source_entry_id": "7564ecfd-0856-3dcf-a2be-86cbb4d628cf",
                        "target_lang_word": "shove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e969f958-add1-3c55-9e6b-f2ae7a0d5717",
                                        "entry_id": "bd1cb258-abdb-3fd4-93bc-4a9cb5cadf39",
                                        "glosses": [
                                            "To push, especially roughly or with force."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d0a7676-85ef-4a49-b263-dcbe48834c1d",
                                                "sense_id": "e969f958-add1-3c55-9e6b-f2ae7a0d5717",
                                                "text": "So, after a spell, he decided to make the best of it and shoved us into the front parlor. 'Twas a dismal sort of place, with hair wreaths, and wax fruit, and tin lambrekins, and land knows what all"
                                            },
                                            {
                                                "example_id": "de97a579-1341-45b6-8572-c96920325913",
                                                "sense_id": "e969f958-add1-3c55-9e6b-f2ae7a0d5717",
                                                "text": "The ship was anon shoven in the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "795a7cc4-1a7e-3eef-9ffd-99f95c29f710",
                                        "entry_id": "bd1cb258-abdb-3fd4-93bc-4a9cb5cadf39",
                                        "glosses": [
                                            "To move off or along by an act of pushing, as with an oar or pole used in a boat; sometimes with off."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c46a157b-7be1-4d94-86ee-23bd3506ff61",
                                                "sense_id": "795a7cc4-1a7e-3eef-9ffd-99f95c29f710",
                                                "text": "He grasped the oar, received his guests on board, and shoved from shore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91e4db45-d6b8-3f6c-831b-2365c28a24be",
                                        "entry_id": "bd1cb258-abdb-3fd4-93bc-4a9cb5cadf39",
                                        "glosses": [
                                            "To make an all-in bet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
