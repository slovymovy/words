                "senses": [
                    {
                        "sense_id": "8caef874-63a1-333b-bcf7-7b625fb61368",
                        "entry_id": "18ca5f72-2c3b-3564-b32a-dc3994fb4eba",
                        "glosses": [
                            "van iets of iemand dat er slijm uit de mond loopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e70ff1c7-df45-4c3c-ae27-04efbf69ebb4",
                                "sense_id": "8caef874-63a1-333b-bcf7-7b625fb61368",
                                "text": "Mochi's baasjes, Carla en Craig Ricket uit de Amerikaanse staat South Dakota, adopteerden de enorme, van oorsprong Zwitserse reddingshond, zes jaar geleden. Het stel, zo vertelt Carla in een filmpje over de aandoenlijke recordhouder, is superblij met hun voortdurend likkende en kwijlende viervoeter."
                            }
                        ]
                    },
                    {
                        "sense_id": "a90a851a-30e1-3431-a7ec-b2120f3c9c8f",
                        "entry_id": "18ca5f72-2c3b-3564-b32a-dc3994fb4eba",
                        "glosses": [
                            "al te verlekkerd kijkend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80f74d22-e2b9-4338-9b65-78783cbdfade",
                                "sense_id": "a90a851a-30e1-3431-a7ec-b2120f3c9c8f",
                                "text": "Wie ook op kwijlende volgers kon rekenen, was 24Kitchen-ster Miljuschka Witzenhausen. Voor een fotoshoot in de LINDA mocht ze in bikini over Bonaire dartelen. Menigeen zou graag wat tijd met de voedingsdeskundige doorbrengen op het tropische eiland."
                            }
                        ]
                    }
