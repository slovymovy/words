                "senses": [
                    {
                        "sense_id": "2910f7c9-20ca-3f8c-a024-ddf3675dd4ab",
                        "entry_id": "3ffe8d48-2e81-325b-afb5-96cd2e58ef6f",
                        "glosses": [
                            "Dans le cyclisme ou la moto, coureur qui roule principalement sur piste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7ef435e-954c-4736-9299-eac0fb2557a2",
                                "sense_id": "2910f7c9-20ca-3f8c-a024-ddf3675dd4ab",
                                "text": "Le pistard australien Jobie Dajka retrouvé mort à son domicile."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f142615-f9bb-34e3-baf0-3a3bc20d96fc",
                        "entry_id": "3ffe8d48-2e81-325b-afb5-96cd2e58ef6f",
                        "glosses": [
                            "En course à pied, coureur sur piste, par opposition au coureur sur route ou traileur. Peut comporter une nuance péjorative."
                        ],
                        "tags": [
                            "Course à pied"
                        ],
                        "examples": [
                            {
                                "example_id": "91e12c27-f78b-4a51-9cb1-2bfd97133c39",
                                "sense_id": "5f142615-f9bb-34e3-baf0-3a3bc20d96fc",
                                "text": "Ce pistard sprinteur, roi du tartan, s’est pris les pieds dans la première racine qu’il a croisée en forêt"
                            }
                        ]
                    },
                    {
                        "sense_id": "575a37f9-f3a3-3ec1-82ee-7516b901a574",
                        "entry_id": "3ffe8d48-2e81-325b-afb5-96cd2e58ef6f",
                        "glosses": [
                            "Individu qui est en piste."
                        ],
                        "tags": [
                            "Bretagne"
                        ],
                        "examples": [
                            {
                                "example_id": "11e4fb6d-3cf8-466a-80f7-b0d78f274a4f",
                                "sense_id": "575a37f9-f3a3-3ec1-82ee-7516b901a574",
                                "text": "Ces « pistards » impénitents ont érigé la piste en pratique « noble », salutaire, réfléchie et sensée."
                            }
                        ]
                    },
                    {
                        "sense_id": "611f3fa5-b801-3ab2-9c81-efe4e024db80",
                        "entry_id": "3ffe8d48-2e81-325b-afb5-96cd2e58ef6f",
                        "glosses": [
                            "Mécanicien aéronautique."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3e2390e8-b1ca-4b08-ac70-e33023bb6c8b",
                                "sense_id": "611f3fa5-b801-3ab2-9c81-efe4e024db80",
                                "text": "Il participe aujourd’hui avec son régiment à l’exercice RAMMSTEIN sur la base aérienne de Grostenquin, près de Metz. Mécanicien de piste, familièrement surnommé « pistard », il est plus particulièrement chargé de la mise en œuvre des Gazelle, c’est-à-dire de leur préparation au vol."
                            }
                        ]
                    },
                    {
                        "sense_id": "d79b266b-9b74-3201-b532-3311f8d3f8a1",
                        "entry_id": "3ffe8d48-2e81-325b-afb5-96cd2e58ef6f",
                        "glosses": [
                            "Dameur."
                        ],
