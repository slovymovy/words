{
    "word_family": [
        "peel",
        "peeling",
        "peeled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b46df234-a0be-34ad-b1ed-544d57aacad3",
                    "sense_definition": "A household utensil used for removing the skin from fruit or vegetables.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kitchen_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a sharp <w>peeler</w> to help me with these potatoes.",
                            "target_lang_translations": {
                                "ru": "Мне нужна острая <w>овощечистка</w>, чтобы почистить этот картофель."
                            }
                        },
                        {
                            "text": "The <w>potato</w> <w>peeler</w> is kept in the top drawer of the kitchen.",
                            "target_lang_translations": {
                                "ru": "<w>Картофелечистка</w> лежит в верхнем ящике на кухне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "potato peeler",
                        "vegetable peeler",
                        "swivel peeler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кухонный прибор, используемый для снятия кожуры с фруктов или овощей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овощечистка",
                                "target_lang_sense_clarification": "универсальный инструмент"
                            },
                            {
                                "target_lang_word": "картофелечистка",
                                "target_lang_sense_clarification": "специально для картофеля"
                            },
                            {
                                "target_lang_word": "нож для чистки овощей",
                                "target_lang_sense_clarification": "описание предмета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e550f390-62c6-3eeb-845e-17cfb32c47b9",
                    "sense_definition": "A person whose job or task is to remove the skin from produce.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "people_who_peel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory hired a new <w>peeler</w> to work on the tomato processing line.",
                            "target_lang_translations": {
                                "ru": "Завод нанял нового <w>чистильщика</w> для работы на линии по переработке томатов."
                            }
                        },
                        {
                            "text": "As a fast <w>peeler</w>, she could finish a basket of apples in minutes.",
                            "target_lang_translations": {
                                "ru": "Как быстрая <w>чистильщица</w>, она могла справиться с корзиной яблок за считанные минуты."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, чья работа или задача заключается в очистке продуктов от кожуры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чистильщик",
                                "target_lang_sense_clarification": "работник на производстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0916f977-d7f2-3d34-80ea-4e281292c775",
                    "sense_definition": "A slang term for a police officer, originally referring to those established by Sir Robert Peel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>peeler</w> walked his beat every evening at sunset.",
                            "target_lang_translations": {
                                "ru": "Местный <w>полицейский</w> обходил свой участок каждый вечер на закате."
                            }
                        },
                        {
                            "text": "They ran away as soon as they saw a <w>peeler</w> coming down the street.",
                            "target_lang_translations": {
                                "ru": "Они убежали, как только увидели <w>легавого</w>, идущего по улице."
                            }
                        }
                    ],
                    "synonyms": [
                        "police officer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British and Irish slang"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое название полицейского, первоначально относившееся к тем, кто служил в полиции, основанной сэром Робертом Пилем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пилер",
                                "target_lang_sense_clarification": "исторический британский сленг"
                            },
                            {
                                "target_lang_word": "полицейский",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60b11586-5ca8-3a57-aa8a-427971da9089",
                    "sense_definition": "A wave that breaks perfectly and evenly along its length, ideal for surfing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surfing_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surfers waited all morning for a perfect <w>peeler</w> to roll in.",
                            "target_lang_translations": {
                                "ru": "Серферы все утро ждали, когда придет идеальный <w>пилер</w>."
                            }
                        },
                        {
                            "text": "He caught a five-foot <w>peeler</w> and rode it all the way to the shore.",
                            "target_lang_translations": {
                                "ru": "Он поймал пятифутовую <w>волну</w> и проехал на ней до самого берега."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "surfing jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Волна, которая идеально и равномерно разбивается по всей своей длине, идеально подходящая для серфинга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пилер",
                                "target_lang_sense_clarification": "сленг серферов"
                            },
                            {
                                "target_lang_word": "идеальная волна",
                                "target_lang_sense_clarification": "описание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15ceb7cb-de02-3135-90cd-2a9069bf7424",
                    "sense_definition": "A crab, especially an edible one, that is about to shed its shell.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine_life",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fishermen often look for a <w>peeler</w> because they make excellent bait.",
                            "target_lang_translations": {
                                "ru": "Рыбаки часто ищут <w>линяющего краба</w>, потому что из него получается отличная наживка."
                            }
                        },
                        {
                            "text": "The blue crab was identified as a <w>peeler</w> just hours before molting.",
                            "target_lang_translations": {
                                "ru": "Голубой краб был определен как <w>готовящийся к линьке</w> всего за несколько часов до смены панциря."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "used by fishermen"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краб, особенно съедобный, который вот-вот сбросит панцирь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краб в период линьки",
                                "target_lang_sense_clarification": "описание состояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a918c6a-8bc2-35ea-9d2f-90ea407f59cf",
                    "sense_definition": "A person who breaks or trains wild horses.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horse_training",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes a brave <w>peeler</w> to handle a wild bronco for the first time.",
                            "target_lang_translations": {
                                "ru": "Нужен смелый <w>объездчик</w>, чтобы впервые справиться с диким мустангом."
                            }
                        },
                        {
                            "text": "The old <w>peeler</w> spent his life training horses on the ranch.",
                            "target_lang_translations": {
                                "ru": "Старый <w>объездчик</w> всю жизнь тренировал лошадей на ранчо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bronc peeler"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Western US/Cowboy slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который объезжает или тренирует диких лошадей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объездчик",
                                "target_lang_sense_clarification": "человек, тренирующий лошадей"
                            },
                            {
                                "target_lang_word": "укротитель",
                                "target_lang_sense_clarification": "диких животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "741b0876-a8d5-3d53-a786-b48ccf100e1f",
                    "sense_definition": "A person who performs a striptease for entertainment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The club featured a <w>peeler</w> who performed every Friday night.",
                            "target_lang_translations": {
                                "ru": "В клубе выступала <w>стриптизерша</w>, которая давала шоу каждую пятницу вечером."
                            }
                        },
                        {
                            "text": "In some regions, a stripper is colloquially referred to as a <w>peeler</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых регионах стриптизеров в просторечии называют <w>пилерами</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, исполняющий стриптиз для развлечения публики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стриптизер",
                                "target_lang_sense_clarification": "мужчина"
                            },
                            {
                                "target_lang_word": "стриптизерша",
                                "target_lang_sense_clarification": "женщина"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7b5d50ef-dc2f-317e-bb89-2e1026597589",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Peeler</w> was invited to speak at the historical society meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Пилер</w> был приглашен выступить на собрании исторического общества."
                            }
                        },
                        {
                            "text": "The <w>Peeler</w> family has lived in this county for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Пилер</w> живет в этом округе уже несколько поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пилер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
