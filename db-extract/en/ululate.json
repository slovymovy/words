                    {
                        "translation_id": "1fc0ebcb-dbb7-499f-a962-06c50af3f81d",
                        "source_entry_id": "5eeb7268-a2e0-3190-9826-7dac407fc83b",
                        "source_sense_description": "to howl loudly",
                        "target_lang_word": "ululer",
