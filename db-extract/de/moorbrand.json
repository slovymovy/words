                "senses": [
                    {
                        "sense_id": "2dac7f57-9c3c-30ab-a6c9-78eacb46c9e3",
                        "entry_id": "8b8fc81e-593f-3d6e-a4d4-81c316f8090d",
                        "glosses": [
                            "Torf, der großflächig unter der Erde brennt und schwelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab0cfa1-5cba-4907-bb14-b8607190aaf3",
                                "sense_id": "2dac7f57-9c3c-30ab-a6c9-78eacb46c9e3",
                                "text": "Vergangene Woche hieß es, so ein Moorband könne sich über Wochen hinziehen."
                            },
                            {
                                "example_id": "e9be6a7d-83d3-4ab8-8ca5-393385df3d73",
                                "sense_id": "2dac7f57-9c3c-30ab-a6c9-78eacb46c9e3",
                                "text": "Das Löschen eines Moorbrandes ist schwierig."
                            },
                            {
                                "example_id": "fce2cf9b-441f-46f3-90a6-111e53572b45",
                                "sense_id": "2dac7f57-9c3c-30ab-a6c9-78eacb46c9e3",
                                "text": "Die Löschung des Moorbrandes im niedersächsischen Meppen könne sich im schlimmsten Fall über Monate hinziehen, sagte der Moorforscher Jan Peters […]."
                            },
                            {
                                "example_id": "16c6518b-0416-4c68-a39d-061bc39456bb",
                                "sense_id": "2dac7f57-9c3c-30ab-a6c9-78eacb46c9e3",
                                "text": "Der großflächige Moorbrand war vor mehr als zwei Wochen infolge von Raketentests der Bundeswehr ausgebrochen. Rauch zog zeitweise zu Orten, die mehr als 100 Kilometer von dem Brand entfernt liegen."
                            },
                            {
                                "example_id": "6be343f5-18b1-4377-ab73-c8e4ae06712a",
                                "sense_id": "2dac7f57-9c3c-30ab-a6c9-78eacb46c9e3",
                                "text": "Der Moorbrand ist fast überall im Nordwesten zu riechen."
                            },
                            {
                                "example_id": "3b9a4415-0a3a-4f72-a95a-70a96e07cc21",
                                "sense_id": "2dac7f57-9c3c-30ab-a6c9-78eacb46c9e3",
                                "text": "[…] weil die Bundeswehr-Feuerwehr den Moorbrand allein nicht einmal ansatzweise unter Kontrolle bekommen hat, schien es zuletzt sogar nötig zu werden, ganze Dörfer in der Nähe zu evakuieren."
                            },
                            {
                                "example_id": "d5ebd2a3-e4fc-4d6e-99c0-7d3b76187680",
                                "sense_id": "2dac7f57-9c3c-30ab-a6c9-78eacb46c9e3",
                                "text": "Neben der [durch Entwässerung] begünstigten Torfzersetzung machen gewaltige Moorbrände, die regelmäßig auf dem trockenen Torf ausbrechen, Indonesien zum weltweit größten CO2-Verursacher durch Moordegradierung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
