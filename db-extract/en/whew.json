    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6a4eb7f0-4cd0-3882-bc16-5803c49ab487",
                "word": "whew",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f1bd8cba-b836-3ec8-9bf7-c06c761096f9",
                        "entry_id": "6a4eb7f0-4cd0-3882-bc16-5803c49ab487",
                        "glosses": [
                            "An expressive sound made indicating the release of one's inner tension; the release of breath; an expression of relief."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b31fc45-f3f0-4f06-b4f3-26e9cda9cf40",
                                "sense_id": "f1bd8cba-b836-3ec8-9bf7-c06c761096f9",
                                "text": "(from strenuous labour) Whew! That box weighs a ton!"
                            },
                            {
                                "example_id": "056f361a-ba51-43e5-95f0-af88b2900980",
                                "sense_id": "f1bd8cba-b836-3ec8-9bf7-c06c761096f9",
                                "text": "(from intense concern) Whew! Thank goodness youʼre safe! I thought something terrible had happened to you!"
                            },
                            {
                                "example_id": "f9e1d2e5-c440-4d8a-8f3d-060167360d3a",
                                "sense_id": "f1bd8cba-b836-3ec8-9bf7-c06c761096f9",
                                "text": "(from fear of being seen) Whew! That cop didnʼt see me! That was a close call!"
                            }
                        ]
                    },
                    {
                        "sense_id": "af4bf9ad-d3ed-3164-96c3-c023e35d1795",
                        "entry_id": "6a4eb7f0-4cd0-3882-bc16-5803c49ab487",
                        "glosses": [
                            "An expression of amazement or surprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9bfd6e7-d3d5-4d90-bd57-8d9329b8ad8b",
                                "sense_id": "af4bf9ad-d3ed-3164-96c3-c023e35d1795",
                                "text": "Now I must be off. Whew, it's as cold as the North Pole. Which way is the wind blowing?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aacf96d6-507b-4b43-9678-bc1b8b8a1e93",
                        "source_entry_id": "6a4eb7f0-4cd0-3882-bc16-5803c49ab487",
                        "source_sense_description": "an expressive sound made indicating the release of one's inner tension",
                        "target_lang_word": "uf",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f00c3217-8445-4bce-a8da-8f17a0e4eb9e",
                        "source_entry_id": "6a4eb7f0-4cd0-3882-bc16-5803c49ab487",
                        "source_sense_description": "an expressive sound made indicating the release of one's inner tension",
                        "target_lang_word": "ouf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                                        "entry_id": "736e1f4d-4734-3f51-ab37-940d23aa040f",
                                        "glosses": [
                                            "Marque le soulagement ou le sentiment de chaud, après avoir subi une épreuve difficile ou désagréable, ou la satisfaction d’être délivré d’un fardeau, d’un travail, d’un ennui, d’une charge quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c39b5529-4148-4315-be49-97fd8e6c05ec",
                                                "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                                                "text": "— Mes cinq ans finis, je m’tire. Avec un ouf comme ça !"
                                            },
                                            {
                                                "example_id": "bfb9e8a4-bf99-4c60-8a7c-6a137f67ac06",
                                                "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                                                "text": "Cette disparition était pour lui une délivrance. Je l’ai entendu faire « ouf ! » non pas une fois, mais vingt fois."
                                            },
                                            {
                                                "example_id": "ca058b14-871f-4ada-82e8-37f68893a238",
                                                "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                                                "text": "Et ouf ! Elle pousse un soupir énorme, les deux bras au ciel !"
                                            },
                                            {
                                                "example_id": "bbf9298f-89a4-4605-87d4-0a1abdf3eec4",
                                                "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                                                "text": "L’élection de Warnock fait toutefois de Joe Biden le premier président depuis Franklin D. Roosevelt à ne perdre aucun sénateur après deux ans en poste. Ouf! Sweet Georgia!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ouf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "022ca32d-6f95-3c9f-83e1-40e9a5b80ef0",
                                        "entry_id": "c7386a9d-2372-3ad2-b207-3bebf5709106",
                                        "glosses": [
                                            "Marque de soulagement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b404ac8-aebf-4d26-85af-fe5c8e2a0eb2",
                                                "sense_id": "022ca32d-6f95-3c9f-83e1-40e9a5b80ef0",
                                                "text": "— Si vous voulez que je vous aide à porter votre panier.\n— C’est pas de refus, y pèse rud’ment. »\nDisant cela elle le mit à terre en poussant un ouf de soulagement."
                                            },
                                            {
                                                "example_id": "15ddb05f-6aa5-401f-ba06-635168e3b28d",
                                                "sense_id": "022ca32d-6f95-3c9f-83e1-40e9a5b80ef0",
                                                "text": "Il revient et finalement , après des parlotes à Londres, à Paris, à Genève, l'affaire est classée et les Français peuvent pousser leur premier ouf ! de soulagement."
                                            },
                                            {
                                                "example_id": "ffd03188-8587-41e0-8765-d803150d304f",
                                                "sense_id": "022ca32d-6f95-3c9f-83e1-40e9a5b80ef0",
                                                "text": "C’est un ouf de soulagement qui a gagné le ministère de la justice à la lecture de l’arrêt de jeudi 12 décembre de la Cour de justice de l’Union européenne. Les mandats d’arrêt européens émis par la France ont été jugés conformes au droit européen, dans une décision très attendue."
                                            },
                                            {
                                                "example_id": "6490c27f-1099-4c60-8fe3-b37a84f054ed",
                                                "sense_id": "022ca32d-6f95-3c9f-83e1-40e9a5b80ef0",
                                                "text": "C’est un ouf de soulagement que pousse Claude Guillot, le président du FAR (Fonds audiovisuel de recherche) de La Rochelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ouf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "802226a0-f751-39dd-85b4-d7a96497b225",
                                        "entry_id": "a479a9cc-77a4-3928-934e-a069e9cc2cdf",
                                        "glosses": [
                                            "Fou."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b73a2c-3b3d-4907-a367-078f99fc7045",
                                                "sense_id": "802226a0-f751-39dd-85b4-d7a96497b225",
                                                "text": "T’es un ouf ! – Tu as perdu la raison."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ouf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                                        "entry_id": "94b4e470-e326-3879-b23d-bf29608fd4ba",
                                        "glosses": [
                                            "Fou."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83f831cb-f561-4400-ab42-75a1bd3a0c3f",
                                                "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                                                "text": "Ce type est trop ouf. – Ce type est complètement fou."
                                            },
                                            {
                                                "example_id": "2d7f17d2-ec11-4d5d-97e6-fb88916746b6",
                                                "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                                                "text": "Le concert était ouf ! – Le concert était génial !"
                                            },
                                            {
                                                "example_id": "22bac377-355c-4586-892b-09ca06bf755a",
                                                "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                                                "text": "Trop exposé au danger, je suis au bord du gouffre\nLes nerfs à vif, à cran, je pourrais devenir ouf."
                                            },
                                            {
                                                "example_id": "c82e8aa4-89d5-4fbe-97a9-1b46fa9c3cee",
                                                "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                                                "text": "C'est ouf !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
