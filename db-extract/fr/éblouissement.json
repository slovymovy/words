                    },
                    {
                        "translation_id": "c0e3ab72-7e3b-4ea6-a256-39601af80bb2",
                        "source_entry_id": "9a0f6f5c-2373-31b0-86e1-1485481ec071",
                        "target_lang_word": "dazzle",
