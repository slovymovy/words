                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ef08603-ff7c-4b16-831b-7c28c225e47b",
                                "sense_id": "d20a9591-68b8-344e-9b03-2520073c8463",
                                "text": "Das Kriegshandwerk ist kein Handwerk wie jedes andere."
                            },
                            {
                                "example_id": "d763667e-d154-4d5c-97ef-cc48a48446e0",
                                "sense_id": "d20a9591-68b8-344e-9b03-2520073c8463",
                                "text": "„Außer Rauben, Plündern und Brandschatzen verstehen sie nichts vom Kriegshandwerk, sagte Albrecht.“"
                            },
                            {
                                "example_id": "814fef39-74e7-4902-892d-c1a252e53969",
                                "sense_id": "d20a9591-68b8-344e-9b03-2520073c8463",
                                "text": "„Der 1542 geborene Akbar war äußerst wissbegierig, beherrschte das Kriegshandwerk, besaß Mut und eine rasche Auffassungsgabe.“"
                            }
                        ],
