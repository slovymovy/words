                                "example_id": "5f084642-ea80-46c6-940f-50cb4c1e571d",
                                "sense_id": "c2a25dd8-b08c-3b06-9aaf-aca721bd6211",
                                "text": "„Die Verhandlungen zwischen ANC und der Apartheidsregierung geraten ins Stocken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
