                "senses": [
                    {
                        "sense_id": "bddeb7f1-52f7-370f-b6f4-1b15b891cf95",
                        "entry_id": "3f19e321-3633-3df2-bc71-1682eff6e9e4",
                        "glosses": [
                            "Dinosaure."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0ab69921-de61-4830-9e90-68dab31c1cb3",
                                "sense_id": "bddeb7f1-52f7-370f-b6f4-1b15b891cf95",
                                "text": "Et puis, il y a les gastrolithes. Ces pierres, sortes de pastilles naturelles, ne permettaient pas aux dinos de garder un ventre plat, Mais peut-être de faciliter la digestion après les repas ?"
                            },
                            {
                                "example_id": "8fe6a859-096e-4e63-ac06-8bbaf58434d7",
                                "sense_id": "bddeb7f1-52f7-370f-b6f4-1b15b891cf95",
                                "text": "Faites nous signe dès qu'internet aura fait un montage en mettant des Yuki a la place des dinos !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c5ee5a0-7aa9-45bf-9da7-201f3db05004",
                        "source_entry_id": "3f19e321-3633-3df2-bc71-1682eff6e9e4",
                        "source_sense_id": "bddeb7f1-52f7-370f-b6f4-1b15b891cf95",
                        "target_lang_word": "dino",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62cefa03-e666-38f7-9540-10fe8cae2442",
                                        "entry_id": "09820323-38e1-3b5d-a2c9-cf877b104c39",
                                        "glosses": [
                                            "A dinosaur (type of animal)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d849297-a838-45b7-993a-1f5f0be7b84f",
                                                "sense_id": "62cefa03-e666-38f7-9540-10fe8cae2442",
                                                "text": "So whereas attempts to single out a dino killer may have failed, for now, they do point to a conspiracy of culprits."
                                            },
                                            {
                                                "example_id": "8ddf97df-d5d6-4f33-8e0a-88dc088c8886",
                                                "sense_id": "62cefa03-e666-38f7-9540-10fe8cae2442",
                                                "text": "So far, Druckenmiller and his team have dug up species from seven different dino families: from big duck-billed dinos, ceretopsians, and tyrannosaurs to smaller thescelosaurs, leptoceratops, dromaeosaurs, and troodontids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78dff2d0-ebcd-35da-91b7-9ca599199f50",
                                        "entry_id": "09820323-38e1-3b5d-a2c9-cf877b104c39",
                                        "glosses": [
                                            "A long-time participant in a multi-user dungeon."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
