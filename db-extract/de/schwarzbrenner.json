                "senses": [
                    {
                        "sense_id": "69cda33c-3154-356d-979c-a4fc17c73ee7",
                        "entry_id": "46fb8330-e5f0-31f6-ae71-99cc743c1e77",
                        "glosses": [
                            "Person, die ohne amtliche Erlaubnis Schnaps brennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53102386-0f6b-4b15-8bf1-d4727366b61d",
                                "sense_id": "69cda33c-3154-356d-979c-a4fc17c73ee7",
                                "text": "„Vor allem der Anisschnaps Raki wird in den Küchen der Schwarzbrenner gebraut.“"
                            },
                            {
                                "example_id": "4c990b70-1ba2-48e3-834c-b5a2981a9c8d",
                                "sense_id": "69cda33c-3154-356d-979c-a4fc17c73ee7",
                                "text": "„Der hochwertige Klare mit der leichten Melissenote wird nach der alten Schwarzbrenner-Rezeptur aus dem Val de Travers gebrannt, die der Firmengründer einst gegen eine prämierte Simmentaler Kuh eingetauscht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
