                ],
                "senses": [
                    {
                        "sense_id": "baa4014b-3ce8-32a1-98ad-b2a48f9f236c",
                        "entry_id": "53bc781a-c5d6-3b9c-87f6-7177aa74a96c",
                        "glosses": [
                            "ein massives, tragendes Bauteil (Träger) aus Stahl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bf622b-addb-4395-9fe6-b346399ed425",
                                "sense_id": "baa4014b-3ce8-32a1-98ad-b2a48f9f236c",
                                "text": "Stahlträger halten einem enormen Gewicht stand."
                            },
                            {
                                "example_id": "10516271-327f-4b15-8680-aee1a7824c10",
                                "sense_id": "baa4014b-3ce8-32a1-98ad-b2a48f9f236c",
                                "text": "„Im Moment sieht es allerdings noch etwas wild aus: Stahlträger stützen die Konstruktion, Säulen werden abgerissen, Kabelrollen liegen herum und große Ziegel werden in Scheibtruhen durch die Gegend geschoben.“"
                            },
                            {
                                "example_id": "8724cefb-a3c3-499a-b786-108c30a206ad",
                                "sense_id": "baa4014b-3ce8-32a1-98ad-b2a48f9f236c",
                                "text": "„Ein Piano hing oben zwischen den Stahlträgern eingeklemmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
