    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c1ab1d1f-8937-3af1-b486-af1065b55290",
                "word": "fetti",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8ab538bf-c2dc-3d93-83f9-7cd82e61c19b",
                        "entry_id": "c1ab1d1f-8937-3af1-b486-af1065b55290",
                        "glosses": [
                            "Money."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "984fb790-aa33-4aff-8e0d-a32ad368c569",
                                "sense_id": "8ab538bf-c2dc-3d93-83f9-7cd82e61c19b",
                                "text": "I can't get enough of that fetti for real / And now I'm hopin' that she's on the pill"
                            },
                            {
                                "example_id": "96c5f903-5ccb-42aa-b362-576d5d149937",
                                "sense_id": "8ab538bf-c2dc-3d93-83f9-7cd82e61c19b",
                                "text": "\"Nah, I doubt it,\" Smoke replies. \"He ain't gone budge.\" ¶ \"Anybody budge for that fetti. Especially at a time like this.\" ¶ \"I'm telling you,\" Smoke replies. \"The nigga ain't beat for paper like that. He rich already. He just doing me a favor.\""
                            },
                            {
                                "example_id": "ed9c529a-5e9c-4bcb-bef9-e843cf78fdb9",
                                "sense_id": "8ab538bf-c2dc-3d93-83f9-7cd82e61c19b",
                                "text": "I know I don't speak English bitch, all I speak is fetti / I ain't never lackin' bitch all I be is ready"
                            },
                            {
                                "example_id": "62a231a5-5ff9-4be7-93a3-f0b45d8cad7b",
                                "sense_id": "8ab538bf-c2dc-3d93-83f9-7cd82e61c19b",
                                "text": "She fumbled with her hands nervously because her loyalty is to her brother so basically it was her life or his. She knew about my lifestyle and how we didn't play in these streets, especially about that fetty."
                            },
                            {
                                "example_id": "74285c52-a750-4f06-8dcc-758202b41296",
                                "sense_id": "8ab538bf-c2dc-3d93-83f9-7cd82e61c19b",
                                "text": "\"Good, you can put them lil niggaz across da street on. Listen, I'on play 'bout my fetti.\" ¶ \"Spare me dat, Baby G, I already know how you livin'. I got 'chu, baby.\""
                            }
                        ]
                    }
                ],
