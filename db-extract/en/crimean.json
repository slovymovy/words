                        "entry_id": "9d8a651e-b2a6-36c2-8ada-17d5da7e01d6",
                        "glosses": [
                            "Denoting, of, or related to Crimea, a peninsula on the north of the Black Sea, separating it from the Sea of Azov."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6abfe46-d73e-4d47-a1d6-6d8bddbf3d28",
                                "sense_id": "41ab88d5-c3aa-332f-8186-ee0f115220c1",
                                "text": "He also thought nothing of laying down a railway in a war zone. For example, he was one of those behind the Grand Crimean Central Railway, built during the Crimean War [...]."
                            }
                        ]
                    }
                ],
                "translations": [
