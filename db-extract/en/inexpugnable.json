                                            {
                                                "example_id": "105dcb32-ac03-476f-83b9-e208bffef74d",
                                                "sense_id": "5a91ed2f-a0d0-3d01-abd0-0e09d84f6699",
                                                "text": "Hanou is weer ongenaakbaar bij het openwaterzwemmen"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90de829d-6770-349e-acb8-503da676c2f2",
                                        "entry_id": "99e014cc-fc3a-3705-a153-6c442a1174ba",
                                        "glosses": [
                                            "onmogelijk te betreden of te beklimmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "546a8060-3169-48cd-9245-14982cbc2c25",
                                                "sense_id": "90de829d-6770-349e-acb8-503da676c2f2",
                                                "text": "De rotsen zagen er steil en ongenaakbaar uit."
                                            }
