                {
                    "sense_id": "e1a92d38-b285-3da3-ad50-842e32adae65",
                    "sense_definition": "Clothing made from animal skin, especially a jacket and trousers worn by motorcycle riders.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The motorcyclist put on his black <w>leathers</w> before the race.",
                            "target_lang_translations": {
                                "ru": "Мотоциклист надел свой черный <w>кожаный костюм</w> перед гонкой.",
                                "nl": "De motorrijder trok zijn zwarte <w>leren pak</w> aan voor de race.",
                                "pl": "Motocyklista założył swoje czarne <w>skóry</w> przed wyścigiem.",
                                "de": "Der Motorradfahrer zog vor dem Rennen seine schwarze <w>Lederkombi</w> an.",
                                "fr": "Le motard a enfilé sa combinaison en <w>cuir</w> noir avant la course.",
                                "it": "Il motociclista ha indossato la sua <w>tuta di pelle</w> nera prima della gara.",
                                "cs": "Motocyklista si před závodem oblékl své černé <w>kožené oblečení</w>.",
                                "tr": "Motosikletçi yarıştan önce siyah <w>deri giysilerini</w> giydi.",
                                "es": "El motociclista se puso su <w>traje de cuero</w> negro antes de la carrera.",
                                "zh": "摩托车手在比赛前穿上了他的黑色<w>皮衣</w>。"
                            }
                        },
                        {
                            "text": "It is safer to ride in full <w>leathers</w> to protect your skin.",
                            "target_lang_translations": {
                                "ru": "Безопаснее ездить в полной <w>кожаной экипировке</w>, чтобы защитить кожу.",
                                "nl": "Het is veiliger om in een volledig <w>leren pak</w> te rijden om je huid te beschermen.",
                                "pl": "Bezpieczniej jest jeździć w pełnym <w>kombinezonie skórzanym</w>, aby chronić skórę.",
                                "de": "Es ist sicherer, in voller <w>Lederbekleidung</w> zu fahren, um die Haut zu schützen.",
                                "fr": "Il est plus sûr de rouler équipé tout en <w>cuir</w> pour protéger sa peau.",
                                "it": "È più sicuro guidare con una <w>tuta di pelle</w> completa per proteggere la pelle.",
                                "cs": "Bezpečnější je jezdit v kompletní <w>kožené kombinéze</w>, abyste si chránili kůži.",
                                "tr": "Cildinizi korumak için tam takım <w>deri kıyafetle</w> sürmek daha güvenlidir.",
                                "es": "Es más seguro conducir con un <w>mono de cuero</w> completo para proteger la piel.",
                                "zh": "穿着全套<w>皮衣</w>骑行更安全，可以保护你的皮肤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "motorcycle leathers",
                        "wear leathers"
                    ],
