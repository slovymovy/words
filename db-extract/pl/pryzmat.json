                "senses": [
                    {
                        "sense_id": "3d79d1a9-243a-3b22-8b63-f4f7f16c60ca",
                        "entry_id": "529b6c59-c5ce-3788-a49d-5073d7cafc73",
                        "glosses": [
                            "graniastosłup wykonany z przezroczystego materiału, często mający trójkątną podstawę, używany do załamywania, rozszczepiania i odbijania wiązek światła"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c93e7767-a989-43d1-bbf5-eea87cc1280e",
                                "sense_id": "3d79d1a9-243a-3b22-8b63-f4f7f16c60ca",
                                "text": "Z doświadczenia Newtona z pryzmatem wiemy, że promień białego światła ulega rozszczepieniu, dając widmo składające się z najróżniejszych barw, zmieszanych w ściśle określonej proporcji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91d1155e-28d6-4e9b-b86a-377c808d8509",
                        "source_entry_id": "529b6c59-c5ce-3788-a49d-5073d7cafc73",
                        "source_sense_id": "3d79d1a9-243a-3b22-8b63-f4f7f16c60ca",
                        "target_lang_word": "prism",
                        "target_lang_code": "en",
