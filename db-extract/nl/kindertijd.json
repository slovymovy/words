                "senses": [
                    {
                        "sense_id": "696e7188-e1a9-3bd1-ad98-af854ecf7e7a",
                        "entry_id": "638a48c2-013b-3ff5-bd3f-9d6fd3703f3f",
                        "glosses": [
                            "periode waarin men de leeftijd van een kind heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca7f5e54-f425-4833-95ea-e1dbc35729e6",
                                "sense_id": "696e7188-e1a9-3bd1-ad98-af854ecf7e7a",
                                "text": "Ze had haar kindertijd tenslotte in Dresden doorgebracht."
                            },
                            {
                                "example_id": "5a470bbc-b065-4c63-a59a-d9e26e405646",
                                "sense_id": "696e7188-e1a9-3bd1-ad98-af854ecf7e7a",
                                "text": "Beleefde ze vroeger, vóór haar achttiende, ook al zulke junimaanden? We overgieten onze kindertijd vaak met zonlicht, maar zo herinnert ze zich die jaren niet."
                            },
                            {
                                "example_id": "71398a39-7c20-468d-a22c-97e2442932fe",
                                "sense_id": "696e7188-e1a9-3bd1-ad98-af854ecf7e7a",
                                "text": "Jaloezie, meende hij, ging niet samen met echte liefde, en kon zelfs het aangaan van 'gewone' sociale relaties in de weg staan É Alle reden dus om die kwalijke toestand al in de kindertijd uit te roeien."
                            }
                        ]
                    }
                ],
