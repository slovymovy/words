                "translations": [
                    {
                        "translation_id": "29f43bf4-b1cf-4519-b459-b8b7e4769b5e",
                        "source_entry_id": "b316f980-e3f6-332c-81c4-26342aa3790b",
                        "source_sense_id": "215d8c91-a5cf-3920-8362-7661da153268",
                        "source_sense_description": "a pigment, dye etc added to something to change its colour or hue",
                        "target_lang_word": "colorant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colorant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "286a2a77-8545-3cd8-b09c-514160cc1d8c",
                                        "entry_id": "23f2f1ac-21f3-3f07-a9ef-546a9352df0c",
                                        "glosses": [
                                            "Qui colore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad6d3cf7-7f94-4dc0-b4fb-ca493bbc744d",
                                                "sense_id": "286a2a77-8545-3cd8-b09c-514160cc1d8c",
                                                "text": "D’après MM. Pelletier et Caventou, le carmin est un composé de la matière colorante de la cochenille, d’une matière animale qui y est également renfermée […]"
                                            },
                                            {
                                                "example_id": "662f3ee8-d6c3-4ee5-92af-81d52c051cdb",
                                                "sense_id": "286a2a77-8545-3cd8-b09c-514160cc1d8c",
                                                "text": "Ainsi le brun se retrouve avec tous ses éléments colorants, du rouge le plus vif au noir de velours, dans les taupins, les altises, les pyrochres, les coccinelles, et dans les papillons, les sphinx, les bombyx, les noctuelles, les sésies ; le gris végétal dans les couleurs jaunes, vertes, bleues, métalliques et brillantes des capricornes, des pucerons, des tettigones, des buprestes, des chrysomèles, des punaises, des orchestes, des stencores qui font leur séjour sur ces arbustes."
                                            },
                                            {
                                                "example_id": "816f6de8-c4fd-4251-8be2-2b4d5c8094e6",
                                                "sense_id": "286a2a77-8545-3cd8-b09c-514160cc1d8c",
                                                "text": "À l’acide azoteux AzO₂H correspondent les azotites utilisés (sels de sodium, de potassium) dans l’industrie des matières colorantes."
                                            },
                                            {
                                                "example_id": "091abb5f-4c76-4002-bf1c-ace926a14e9f",
                                                "sense_id": "286a2a77-8545-3cd8-b09c-514160cc1d8c",
                                                "text": "Les mouliniers, dans la région lyonnaise, emploient des produits colorants, bleu, vert, rouge, etc., qui sont destinés à distinguer les torsions, notamment pour les crêpes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "colorant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "886ab485-e12d-38e0-becb-bddda4587873",
                                        "entry_id": "6672116a-6e30-3082-81b2-cecef287e88c",
                                        "glosses": [
                                            "Substance qui colore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb5d6074-3dc4-4e89-a31e-f79af7f47759",
                                                "sense_id": "886ab485-e12d-38e0-becb-bddda4587873",
                                                "text": "Les pois égouttés doivent présenter la couleur normale caractéristique des pois secs trempés en conserve, compte tenu de toute adjonction de colorants artificiels."
                                            },
                                            {
                                                "example_id": "4ddc8037-e249-4c15-9ce1-9669755638f1",
                                                "sense_id": "886ab485-e12d-38e0-becb-bddda4587873",
                                                "text": "Le jaune Lucifer (Lucifer yellow = colorant fluorescent à base de luciférine) et la péroxydase (par exemple, la péroxydase du Raifort ou péroxydase du radis de cheval = la HRP pour horse radish peroxydase) qui est une enzyme pouvant être incorporée non spécifiquement par les cellules."
                                            },
                                            {
                                                "example_id": "6753f12f-c552-4873-ac93-4021f42c2139",
                                                "sense_id": "886ab485-e12d-38e0-becb-bddda4587873",
                                                "text": "Encore un truc made in China, avec des colorants polluants, importés en cargos, pour un événement climaticide complètement inutile en plein effondrement climatique, se désole Marie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "colorant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4edcbaa4-efc1-32af-95ac-42b00e28780c",
                                        "entry_id": "ced5f5b0-4301-3252-8178-cae3b6ba6a14",
                                        "glosses": [
                                            "Participe présent du verbe colorer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f39549c-c624-43fb-9825-51a1b7b487c3",
                                                "sense_id": "4edcbaa4-efc1-32af-95ac-42b00e28780c",
                                                "text": "La Twingo blanche était en effet sagement arrêtée à un feu. Ses lumières de frein colorant le panache de gaz d’échappement d’un rouge sang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
