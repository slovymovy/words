                "senses": [
                    {
                        "sense_id": "0fa89202-d473-3d41-9682-b5ab4a5fa44d",
                        "entry_id": "76064a9b-6855-3910-8149-24774886651c",
                        "glosses": [
                            "Reformbewegung innerhalb des Protestantismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22fa90df-6f7f-4e9e-aa5f-b8727bff02f1",
                                "sense_id": "0fa89202-d473-3d41-9682-b5ab4a5fa44d",
                                "text": "„Die geringe Rolle des Geschlechtlichen im schwäbischen Witz hängt mit Wirkungen des Pietismus zusammen.“"
                            },
                            {
                                "example_id": "ba7a51b6-fb9e-486e-a6e3-659352a5625e",
                                "sense_id": "0fa89202-d473-3d41-9682-b5ab4a5fa44d",
                                "text": "„Der Abstand des Pietismus von der Reformation wird wieder betont, der Pietismus wird theologisch von einer an Luther orientierten Position aus kritisiert.“"
                            },
                            {
                                "example_id": "17602918-aa8f-466c-b419-51ab9181b854",
                                "sense_id": "0fa89202-d473-3d41-9682-b5ab4a5fa44d",
                                "text": "„Seine Mutter hat sich langsam und mühevoll eine literarische Bildung angeeignet, die vor allem im zeitgenössischen Pietismus wurzelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
