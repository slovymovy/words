                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8c5071-e21b-4b54-a9fe-7f9b31acb674",
                                "sense_id": "57793235-6864-32b5-bf76-d12e56d5c685",
                                "text": "Узнав о существовании Ксаны, акционерка решила устранить однополую соперницу и завалилась к ней в гости."
                            }
                        ]
