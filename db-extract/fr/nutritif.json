                ],
                "senses": [
                    {
                        "sense_id": "12bee5e3-b7b1-3456-9cb3-8a9298d7e140",
                        "entry_id": "87652216-4531-3a48-92ee-600dff1a579a",
                        "glosses": [
                            "Relatif à la nutrition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16406ff1-7ca5-43b4-bf70-2050a9298594",
                                "sense_id": "12bee5e3-b7b1-3456-9cb3-8a9298d7e140",
                                "text": "Les fonctions nutritives."
                            }
                        ]
                    },
                    {
                        "sense_id": "8459203f-b010-32c6-8552-8eb3084f8294",
                        "entry_id": "87652216-4531-3a48-92ee-600dff1a579a",
                        "glosses": [
                            "Nourrissant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32a555b-8bad-42e5-a096-d5465ddfdd81",
                                "sense_id": "8459203f-b010-32c6-8552-8eb3084f8294",
                                "text": "Le mouillage est une véritable adultération du lait, car non seulement il diminue ses qualités nutritives, mais il introduit directement dans un aliment populaire les germes morbides que peuvent contenir les eaux de toute provenance employées par les falsificateurs."
                            },
                            {
                                "example_id": "93518464-3e2c-4468-ae2f-875f2439f82d",
                                "sense_id": "8459203f-b010-32c6-8552-8eb3084f8294",
                                "text": "Naturellement, de tout l'hiver, le crapaud ne prend aucune nourriture. Une abondante alimentation estivale a entreposé dans son organisme quantité de matériaux nutritifs."
                            },
                            {
                                "example_id": "4137e6bb-2548-46f0-bdb5-bc32fc795c87",
                                "sense_id": "8459203f-b010-32c6-8552-8eb3084f8294",
                                "text": "Si donc nous voulons examiner la nutrition végétale, il nous faut travailler sans sols (hydroponiques) ou en sols biologiquement neutres (semi-hydroponiques) en fournissant à la plante des liquides nutritifs de composition connue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cc897e2-bbd4-467e-94e2-49051561777a",
                        "source_entry_id": "87652216-4531-3a48-92ee-600dff1a579a",
                        "target_lang_word": "nutritive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nutritive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09145f8e-92c8-3174-956b-1865f5835a7e",
                                        "entry_id": "5f9da278-5ad1-3a7f-afbf-75d4444d83d4",
                                        "glosses": [
                                            "Of or pertaining to nutrition."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18dda796-028e-3a2e-a67a-1f8be851aa53",
                                        "entry_id": "5f9da278-5ad1-3a7f-afbf-75d4444d83d4",
                                        "glosses": [
                                            "Nourishing, providing nutrition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b76ed46c-d0db-408a-a7d8-cdc61d64604c",
                                                "sense_id": "18dda796-028e-3a2e-a67a-1f8be851aa53",
                                                "text": "The juice of the ripe grape is a nutritive and agreeable food, consisting chiefly of sugar and mucilage."
                                            },
                                            {
                                                "example_id": "53ab4eea-eede-4ae4-994d-9a4f33f4b106",
                                                "sense_id": "18dda796-028e-3a2e-a67a-1f8be851aa53",
                                                "text": "The percentage of nutritive elements contained in the parsnip is very small; so small, indeed, that one pound of parsnips affords hardly one fifth of an ounce of nitrogenous or muscle-forming material."
                                            },
                                            {
                                                "example_id": "ccaf01f0-326f-4ce0-9f46-0ef32e16c4bc",
                                                "sense_id": "18dda796-028e-3a2e-a67a-1f8be851aa53",
                                                "text": "D'Argenson reckoned that its consumption held up so well in times of high prices because the poor thought that it had nutritive value."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nutritive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cd9c974-67f4-3de4-af19-a1695001beca",
