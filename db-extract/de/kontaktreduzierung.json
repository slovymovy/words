                        "examples": [
                            {
                                "example_id": "5bc7676f-02de-4783-b551-e543fa9c993e",
                                "sense_id": "540400fd-8637-393c-ac9c-b9bf0e3fee49",
                                "text": "„Es würden erneut deutliche Kontaktreduzierungen benötigt. Die Lage in den Krankenhäusern spitze sich teilweise dramatisch zu.“"
                            },
                            {
                                "example_id": "410c8773-2ffd-47c4-9361-ac3327781532",
                                "sense_id": "540400fd-8637-393c-ac9c-b9bf0e3fee49",
                                "text": "„Homeoffice ist eine sinnvolle Maßnahme zur Kontaktreduzierung und damit auch zum Infektionsschutz in Betrieben.“"
                            },
                            {
                                "example_id": "7b95c22a-2e0b-437b-82fc-890dcd3c903c",
                                "sense_id": "540400fd-8637-393c-ac9c-b9bf0e3fee49",
                                "text": "„Viren sind klein und gemein. Hier erklärt der Mathematiker Hans-Karl Eder, wie die Kontaktreduzierung wirkt und warum sie im Kampf gegen das Coronavirus so wichtig ist.“"
                            }
                        ],
