                                    {
                                        "sense_id": "6efa9832-e394-3c3c-ba89-95214303e6f3",
                                        "entry_id": "d8ca109f-cb82-34e8-9bd1-994b06321c41",
                                        "glosses": [
                                            "eine Allegorie betreffend"
