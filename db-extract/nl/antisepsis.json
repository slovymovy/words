                                    },
                                    {
                                        "sense_id": "bc16d8ff-9473-3324-b8d5-bd924bd7058c",
                                        "entry_id": "4d0cd29c-5ef9-36db-bd62-8ade39af31a0",
                                        "glosses": [
                                            "Capable of preventing microbial infection."
                                        ],
                                        "tags": [],
