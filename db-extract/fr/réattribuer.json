                        "glosses": [
                            "Attribuer à nouveau, avec un possible changement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41fd011c-2f97-4e40-80b2-b4fa12841ce3",
                                "sense_id": "6f9ca995-e4fa-363c-8c7e-4673ca473f56",
                                "text": "Le CHMP recommande de réattribuer l'autorisation de mise sur le marché de Viracept, médicament anti-VIH de Roche."
                            },
                            {
                                "example_id": "eb37b05d-5c83-46a5-9ae8-b143095ea7f1",
                                "sense_id": "6f9ca995-e4fa-363c-8c7e-4673ca473f56",
                                "text": "12 fragments réattribués sont venus alors compléter le squelette de l’homme de Régourdou (Neandertal, - 70 000 ans) qui se trouve, ainsi depuis, au musée d’Archéologie du Périgord avec sa partie inférieure."
                            }
                        ]
                    }
