                    }
                ],
                "senses": [
                    {
                        "sense_id": "835eba36-0e2f-3c09-99cc-16b170e4ff5b",
                        "entry_id": "82ac2235-db0b-3acd-a07e-69e49c47d002",
                        "glosses": [
                            "A prickling, shivery sensation; frisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab677508-de0c-4f8e-b20c-46ecac63c949",
                                "sense_id": "835eba36-0e2f-3c09-99cc-16b170e4ff5b",
                                "text": "at the frickle of apprehension ( real or imaginary ) on any issue."
                            },
                            {
                                "example_id": "bec76af5-44fd-430c-8319-1b9f4224c826",
                                "sense_id": "835eba36-0e2f-3c09-99cc-16b170e4ff5b",
                                "text": "As I slowly open my eyes, I get that somefeeli's-watching-me frickle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4f93a128-a525-367b-9f21-a02b9e7409bf",
                "word": "frickle",
                "pos": "verb",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b2d52058-825d-49d0-8bd3-58da782c4992",
                        "entry_id": "4f93a128-a525-367b-9f21-a02b9e7409bf",
                        "tags": [
                            "present",
                            "singular",
