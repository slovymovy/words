                ],
                "senses": [
                    {
                        "sense_id": "00d54426-cf7f-3c1e-a370-66b8402c5d0e",
                        "entry_id": "436b1ab9-abdd-3786-8a55-11e2a4e7ff2f",
                        "glosses": [
                            "beim Hören (für gewöhnlich unabsichtlich) falsch verstandene Textteile, beispielsweise aus Liedern oder Gedichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a504e9-a7e3-4030-af2b-2f4a4301582d",
                                "sense_id": "00d54426-cf7f-3c1e-a370-66b8402c5d0e",
                                "text": "Udo Jürgens’ Lied „Griechischer Wein” wird durch Verhörer als Warnung „Kriech’ nicht da rein!” missverstanden."
                            },
                            {
                                "example_id": "42cf5690-ec78-45ee-93cd-c016c58f735c",
                                "sense_id": "00d54426-cf7f-3c1e-a370-66b8402c5d0e",
                                "text": "„Bestimmt finden Sie auch in Ihrem sprachlichen Umfeld unterhaltsame und interessante Verleser oder Verhörer.“"
                            },
                            {
                                "example_id": "0f2a822f-0a76-4e89-8a7b-066bb085a941",
                                "sense_id": "00d54426-cf7f-3c1e-a370-66b8402c5d0e",
                                "text": "„Insbesondere bei fremdsprachigen Liedtexten treten Verhörer sehr oft auf, auch für diesen Bereich präsentierte Busch-Lauer eine Reihe von Beispielen.“"
                            },
                            {
                                "example_id": "924cd259-6ba2-47c8-8072-13b112cc0800",
                                "sense_id": "00d54426-cf7f-3c1e-a370-66b8402c5d0e",
                                "text": "„Daher diese Verhörer.“"
                            },
                            {
                                "example_id": "39f4a3c1-7ed2-421c-bc59-50406528f06f",
                                "sense_id": "00d54426-cf7f-3c1e-a370-66b8402c5d0e",
                                "text": "„Inzwischen setzt sich immer mehr ein neuer Terminus durch für den (freudschen) Verhörer, der Mondegreen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c2dfe1a-4468-4d15-8326-c6fe56ce0a1b",
                        "source_entry_id": "436b1ab9-abdd-3786-8a55-11e2a4e7ff2f",
                        "source_sense_id": "00d54426-cf7f-3c1e-a370-66b8402c5d0e",
                        "target_lang_word": "mondegreen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mondegreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a131e5e9-e139-30e4-9184-7f5cb53270e5",
                                        "entry_id": "f6ee68f0-d029-3730-a56b-b6298dc3aa03",
                                        "glosses": [
                                            "A form of (possibly intentional) error arising from mishearing a spoken or sung phrase, possibly in a different language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e002745a-cc6d-49e3-9375-7b17977bfe0d",
                                                "sense_id": "a131e5e9-e139-30e4-9184-7f5cb53270e5",
                                                "text": "Our report of a relative who, as a child, thought the classic version of the Lord's Prayer began \"Our father, a chart in heaven, Harold be thy name\" stated that this type of mistake is known as an eggcorn. A number of readers have suggested that instances like this in which a whole phrase rather than just a word is misheard, should be called mondegreens rather than eggcorns."
                                            },
                                            {
                                                "example_id": "017413d5-f648-4138-9d53-66a446dbbdc7",
                                                "sense_id": "a131e5e9-e139-30e4-9184-7f5cb53270e5",
                                                "text": "The title lyric [\"Bei Mir Bistu Shein\"], the only part of the original Yiddish preserved by Cahn, was a mondegreen waiting to happen—“My Mere Bits of Shame” and “My Beer, Mr. Shane” were among the earliest recorded mishearings—but the language barrier didn't […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "249b4860-606c-386d-b292-50914594036b",
                                        "entry_id": "f6ee68f0-d029-3730-a56b-b6298dc3aa03",
                                        "glosses": [
                                            "A misunderstanding of a written or spoken phrase as a result of multiple definitions."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
