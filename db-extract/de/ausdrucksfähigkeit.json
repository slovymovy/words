                "senses": [
                    {
                        "sense_id": "c9207a7c-3fc1-36aa-a690-ddf7acb301c9",
                        "entry_id": "f3a14b4f-0e31-3875-bf17-93520d661583",
                        "glosses": [
                            "Fähigkeit oder Gabe, sich gewandt und geschickt verbal oder nonverbal auszudrücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dec2f24-93a5-4818-bc19-b560ba185127",
                                "sense_id": "c9207a7c-3fc1-36aa-a690-ddf7acb301c9",
                                "text": "„Das hellblaue Licht erzeugt in dir das Gefühl von Ausdrucksfähigkeit und Offenheit.“"
                            },
                            {
                                "example_id": "32a1e9d3-a4c2-4d57-b939-377d2bbd666c",
                                "sense_id": "c9207a7c-3fc1-36aa-a690-ddf7acb301c9",
                                "text": "„Durch das Erkunden, Erkennen, Beschreiben und Erklären von Zahlenmustern werden grundlegende mathematische Strukturen für die Schülerinnen und Schüler zugänglich, zudem wird die Ausdrucksfähigkeit in Wort und Schrift geschult.“"
                            },
                            {
                                "example_id": "c3aa47c0-2a44-4f96-bcb0-5b3da24c4681",
                                "sense_id": "c9207a7c-3fc1-36aa-a690-ddf7acb301c9",
                                "text": "„Sein Wesen und seine Bestrebungen waren von einem durch Gott legitimierten Monarchieverständnis, einer tiefen, inneren Religiosität und einer vielfältigen künstlerischen Ausdrucksfähigkeit durchdrungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
