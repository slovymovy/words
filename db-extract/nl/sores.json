                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tsuris",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46e23397-8e38-3d4d-81a0-c0253b50ce67",
                                        "entry_id": "efabfe03-cec8-3386-84eb-f25b0e91f87a",
                                        "glosses": [
                                            "Problems or troubles."
                                        ],
                                        "tags": [
                                            "English",
                                            "Jewish",
                                            "US",
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d049a00e-1e89-4c8c-a507-80ca8b999868",
                                                "sense_id": "46e23397-8e38-3d4d-81a0-c0253b50ce67",
                                                "text": "You think you got troubles? You should go down there and talk to some of those schnorrers. Still, what chutzbah^([sic]). It's like the Jewish moral sense, emerging from all that tsuris."
                                            },
                                            {
                                                "example_id": "94bf06c6-e9e3-468f-90e7-0b1007a64fb1",
                                                "sense_id": "46e23397-8e38-3d4d-81a0-c0253b50ce67",
                                                "text": "“Sounds to me, my friend, like you got some tsuris. Not full grown yet, not gehoketh tsuris, but tsuris.”"
                                            },
                                            {
                                                "example_id": "9e31e642-aa9d-427c-9d9f-dc1934c1704b",
                                                "sense_id": "46e23397-8e38-3d4d-81a0-c0253b50ce67",
                                                "text": "1997, Hilary Henkin and David Mamet, Wag the Dog, New Line Cinema\nStanley Moss: I don't need this gig, I don't need the money, I don't need the tsuris ... I don't need it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
