                                "target_senses": [
                                    {
                                        "sense_id": "b698a59a-ae72-33d4-a4f6-de551a3ebdf4",
                                        "entry_id": "9cd90706-7402-3c7f-aaa8-690e213f964b",
                                        "glosses": [
                                            "Action de ne laisser passer que certaines choses et pas les autres."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6d9c8f8-6378-33fe-b310-14b1d2ab8e27",
                                        "entry_id": "9cd90706-7402-3c7f-aaa8-690e213f964b",
                                        "glosses": [
                                            "Application d’un filtre à un signal pour atténuer certaines composantes (passe-bas, passe-haut, bande, adaptatif)."
                                        ],
                                        "tags": [
                                            "Traitement du signal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd7459e6-dda2-41f5-a7d1-a3d4cb1a847f",
                                                "sense_id": "c6d9c8f8-6378-33fe-b310-14b1d2ab8e27",
                                                "text": "Ainsi la radiodiffusion nous a familiarisés avec les opérations de modulation d’un signal radio, de changement de fréquence, de détection, de filtrage de fréquence (filtres passe-haut, passe-bas ou passe-bande)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a485d61e-c36f-3f72-8460-1800361e1fac",
                                        "entry_id": "9cd90706-7402-3c7f-aaa8-690e213f964b",
                                        "glosses": [
                                            "Règles ou algorithmes permettant d’autoriser ou de bloquer des flux ou des données (filtrage de paquets, filtrage DNS, anti-spam, filtrage parental)."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "323fb713-cbd2-3f6a-a402-3def91c680ef",
                                        "entry_id": "9cd90706-7402-3c7f-aaa8-690e213f964b",
                                        "glosses": [
                                            "Sélection éditoriale des informations (sujets, angles, sources) déterminant ce qui est retenu ou écarté dans la couverture médiatique, avec effets sur l’agenda et le cadrage."
                                        ],
                                        "tags": [
                                            "Critique des médias"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8205514b-7604-481a-9582-a153cd224b14",
                                                "sense_id": "323fb713-cbd2-3f6a-a402-3def91c680ef",
                                                "text": "Le CSA, en confiant aux médias le soin de répartir les temps de parole selon le principe flou d’« équité », octroie de facto aux rédactions un pouvoir de filtrage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cabcc29b-c1e7-3b9f-9cb4-38a37328196a",
                                        "entry_id": "9cd90706-7402-3c7f-aaa8-690e213f964b",
                                        "glosses": [
                                            "Restriction d’accès à certains contenus jugés indésirables (blocage DNS/IP, listes, modération algorithmique)."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58a16964-ffd8-4319-afad-11d33bcdd31d",
                                                "sense_id": "cabcc29b-c1e7-3b9f-9cb4-38a37328196a",
                                                "text": "Filtrage d’internet."
                                            },
                                            {
                                                "example_id": "5e8562c3-a03d-45d8-937b-9fc083f7fc82",
                                                "sense_id": "cabcc29b-c1e7-3b9f-9cb4-38a37328196a",
                                                "text": "Cette partie présente les modèles nationaux les plus courants de régulation du blocage, du filtrage et du retrait de contenus illégaux sur internet, avec une analyse de leurs conséquences en matière de liberté d’expression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0eb9f5-cc51-32ca-9d4c-1689f07f17ac",
                                        "entry_id": "9cd90706-7402-3c7f-aaa8-690e213f964b",
                                        "glosses": [
                                            "Pratique consistant à sélectionner des titres de portefeuille d’investissement en fonction de divers critères, notamment d’ordre social ou environnemental."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd5da90f-0912-342e-bc7d-b89eb6077ff1",
                                        "entry_id": "9cd90706-7402-3c7f-aaa8-690e213f964b",
                                        "glosses": [
                                            "Opération permettant de déterminer s’il y a lieu d’effectuer une évaluation environnementale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
