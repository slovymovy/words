{
    "word_family": [
        "sketchy",
        "sketcher",
        "sketchbook",
        "sketchpad",
        "sketchiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "091ed9a5-bea9-38b5-bc49-34121242f8f1",
                    "sense_definition": "A quick, rough drawing that is not intended to be a finished work, often made to capture the basic idea or shape of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist drew a quick <w>sketch</w> of the landscape before starting the painting.",
                            "target_lang_translations": {
                                "ru": "Художник сделал быстрый <w>набросок</w> пейзажа перед тем, как начать картину.",
                                "zh": "艺术家在开始作画前，先画了一幅风景<w>素描</w>。"
                            }
                        },
                        {
                            "text": "She made a pencil <w>sketch</w> of the flower on a napkin.",
                            "target_lang_translations": {
                                "ru": "Она сделала карандашный <w>набросок</w> цветка на салфетке.",
                                "zh": "她在餐巾纸上用铅笔画了一幅花朵的<w>草图</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drawing"
                    ],
                    "common_phrases": [
                        "pencil sketch",
                        "rough sketch",
                        "draw a sketch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрый, черновой рисунок, не предназначенный быть законченной работой, часто создаваемый для того, чтобы запечатлеть основную идею или форму чего-либо.",
                        "zh": "一种快速、粗略的绘画，不打算作为成品，通常用于捕捉事物的基本构思或形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набросок",
                                "target_lang_sense_clarification": "быстрый рисунок от руки"
                            },
                            {
                                "target_lang_word": "эскиз",
                                "target_lang_sense_clarification": "предварительный набросок"
                            },
                            {
                                "target_lang_word": "скетч",
                                "target_lang_sense_clarification": "современный термин для быстрого рисунка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "素描",
                                "target_lang_sense_clarification": "快速的绘画作品"
                            },
                            {
                                "target_lang_word": "草图",
                                "target_lang_sense_clarification": "初步的构思图"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "486d8a0f-2443-3ff6-8090-8298c34a8bb3",
                    "sense_definition": "A short, often funny scene or play, usually performed as part of a variety show or comedy program.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors performed a hilarious <w>sketch</w> about politicians during the show.",
                            "target_lang_translations": {
                                "ru": "Актёры разыграли уморительный <w>скетч</w> о политиках во время шоу.",
                                "zh": "演员们在节目中表演了一段关于政客的搞笑<w>短剧</w>。"
                            }
                        },
                        {
                            "text": "We watched a funny <w>sketch</w> show on television last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы смотрели по телевизору смешное <w>скетч</w>-шоу.",
                                "zh": "昨晚我们在电视上看了个有趣的<w>小品</w>节目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "skit"
                    ],
                    "common_phrases": [
                        "comedy sketch",
                        "sketch show"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая, часто смешная сценка или пьеса, обычно исполняемая как часть варьете или комедийной программы.",
                        "zh": "一种简短且通常带有幽默色彩的场景或短剧，常作为综艺节目或喜剧节目的一部分表演。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скетч",
                                "target_lang_sense_clarification": "комедийная сценка"
                            },
                            {
                                "target_lang_word": "сценка",
                                "target_lang_sense_clarification": "небольшое представление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短剧",
                                "target_lang_sense_clarification": "简短的表演片段"
                            },
                            {
                                "target_lang_word": "小品",
                                "target_lang_sense_clarification": "幽默的表演节目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8675266-8a1b-326a-a691-f5b35eed868a",
                    "sense_definition": "A rough design, plan, or draft of a project or idea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect showed us a preliminary <w>sketch</w> of the new building.",
                            "target_lang_translations": {
                                "ru": "Архитектор показал нам предварительный <w>эскиз</w> нового здания.",
                                "zh": "建筑师向我们展示了新大楼的初步<w>草案</w>。"
                            }
                        },
                        {
                            "text": "He drew a rough <w>sketch</w> of the seating plan for the wedding.",
                            "target_lang_translations": {
                                "ru": "Он нарисовал черновой <w>набросок</w> плана рассадки гостей на свадьбе.",
                                "zh": "他画了一份婚礼座位安排的粗略<w>草图</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "preliminary sketch",
                        "rough sketch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Черновой проект, план или набросок проекта или идеи.",
                        "zh": "项目或构思的粗略设计、计划或草案。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эскиз",
                                "target_lang_sense_clarification": "проект или план"
                            },
                            {
                                "target_lang_word": "набросок",
                                "target_lang_sense_clarification": "черновик"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草案",
                                "target_lang_sense_clarification": "初步的计划"
                            },
                            {
                                "target_lang_word": "蓝图",
                                "target_lang_sense_clarification": "初步的设计方案"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b9ad7e5-7d0b-30f8-9213-9b0f2b2e62d5",
                    "sense_definition": "A brief description of a person, incident, or situation that gives a general overview.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author provided a brief biographical <w>sketch</w> of the main character.",
                            "target_lang_translations": {
                                "ru": "Автор представил краткий биографический <w>очерк</w> главного героя.",
                                "zh": "作者为主角提供了一份简短的生平<w>概述</w>。"
                            }
                        },
                        {
                            "text": "I have to write a character <w>sketch</w> for my literature class.",
                            "target_lang_translations": {
                                "ru": "Мне нужно написать <w>характеристику</w> персонажа для урока литературы.",
                                "zh": "我得为文学课写一份人物<w>小传</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pen picture",
                        "pen portrait"
                    ],
                    "common_phrases": [
                        "character sketch",
                        "biographical sketch",
                        "brief sketch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое описание человека, происшествия или ситуации, дающее общее представление.",
                        "zh": "对人物、事件或情况的简要描述，提供总体概况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очерк",
                                "target_lang_sense_clarification": "литературное описание"
                            },
                            {
                                "target_lang_word": "краткая характеристика",
                                "target_lang_sense_clarification": "описание качеств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "概述",
                                "target_lang_sense_clarification": "简要的描述"
                            },
                            {
                                "target_lang_word": "小传",
                                "target_lang_sense_clarification": "简短的人物介绍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78a02fb0-33a0-3be5-917f-40d3becdde4d",
                    "sense_definition": "A humorous newspaper article that summarizes political events using satire and caricature.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "journalism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist wrote a daily <w>sketch</w> covering the debates in parliament.",
                            "target_lang_translations": {
                                "ru": "Журналист писал ежедневный <w>фельетон</w>, освещающий дебаты в парламенте.",
                                "zh": "记者写了一篇每日<w>讽刺小品</w>，报道议会辩论。"
                            }
                        },
                        {
                            "text": "Her political <w>sketch</w> was known for its sharp wit and criticism.",
                            "target_lang_translations": {
                                "ru": "Её политический <w>фельетон</w> был известен своим острым умом и критикой.",
                                "zh": "她的政治<w>讽刺小品</w>以尖锐的机智和批评而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юмористическая газетная статья, обозревающая политические события с использованием сатиры и карикатуры.",
                        "zh": "一种利用讽刺和漫画手法总结政治事件的幽默报刊文章。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фельетон",
                                "target_lang_sense_clarification": "сатирическая статья"
                            },
                            {
                                "target_lang_word": "сатирический очерк",
                                "target_lang_sense_clarification": "жанр журналистики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "讽刺小品",
                                "target_lang_sense_clarification": "政治评论文章"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7b0ce94-72d4-3081-8ceb-a3e6456b0970",
                    "sense_definition": "A formal specification of a mathematical structure described in terms of a graph and diagrams.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the concept of a <w>sketch</w> in category theory.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил понятие <w>эскиза</w> в теории категорий.",
                                "zh": "教授解释了范畴论中<w>草图</w>的概念。"
                            }
                        },
                        {
                            "text": "Students studied the formal <w>sketch</w> to understand the data type structure.",
                            "target_lang_translations": {
                                "ru": "Студенты изучали формальный <w>эскиз</w>, чтобы понять структуру типа данных.",
                                "zh": "学生们研究了正式的<w>草图</w>以理解数据类型结构。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальная спецификация математической структуры, описанная в терминах графа и диаграмм.",
                        "zh": "一种用图和图表描述的数学结构的正式规范。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эскиз",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草图",
                                "target_lang_sense_clarification": "数学中的形式化结构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65be32d8-daff-3219-87fe-8fe88cd34222",
                    "sense_definition": "To make a quick, rough drawing of something or someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I like to sit in the park and <w>sketch</w> the trees.",
                            "target_lang_translations": {
                                "ru": "Мне нравится сидеть в парке и <w>набрасывать</w> деревья.",
                                "zh": "我喜欢坐在公园里<w>画</w>树的<w>素描</w>。"
                            }
                        },
                        {
                            "text": "He quickly <w>sketched</w> a map to show us the way.",
                            "target_lang_translations": {
                                "ru": "Он быстро <w>набросал</w> карту, чтобы показать нам дорогу.",
                                "zh": "他快速<w>画</w>了一张地图给我们指路。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sketch out",
                        "sketch a design"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать быстрый, черновой рисунок чего-либо или кого-либо.",
                        "zh": "对某人或某物进行快速、粗略的绘画。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набрасывать",
                                "target_lang_sense_clarification": "делать набросок"
                            },
                            {
                                "target_lang_word": "делать эскиз",
                                "target_lang_sense_clarification": "рисовать предварительно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "画草图",
                                "target_lang_sense_clarification": "进行初步绘画"
                            },
                            {
                                "target_lang_word": "素描",
                                "target_lang_sense_clarification": "进行绘画创作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85f45a84-1964-3f9a-bb98-27a89be74cc5",
                    "sense_definition": "To describe something briefly without giving many details.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>sketched</w> out her plan for the new business venture.",
                            "target_lang_translations": {
                                "ru": "Она <w>обрисовала</w> свой план нового коммерческого предприятия.",
                                "zh": "她<w>勾勒</w>出了新商业项目的计划。"
                            }
                        },
                        {
                            "text": "The witness <w>sketched</w> the events of the accident for the police officer.",
                            "target_lang_translations": {
                                "ru": "Свидетель <w>обрисовал</w> события аварии полицейскому.",
                                "zh": "目击者向警官<w>概括</w>了事故经过。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sketch out",
                        "sketch the plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывать что-либо кратко, не вдаваясь в подробности.",
                        "zh": "简要描述某事，不提供过多细节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрисовывать",
                                "target_lang_sense_clarification": "описывать в общих чертах"
                            },
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "кратко рассказывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勾勒",
                                "target_lang_sense_clarification": "简要描述轮廓"
                            },
                            {
                                "target_lang_word": "概括",
                                "target_lang_sense_clarification": "简要说明"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "340a837d-b55d-33c2-ab15-e6756990c24e",
                    "sense_definition": "Suspicious, dangerous, or of questionable quality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would not go into that dark alley because it looks pretty <w>sketch</w>.",
                            "target_lang_translations": {
                                "ru": "Я бы не пошёл в тот тёмный переулок, потому что он выглядит довольно <w>подозрительно</w>.",
                                "zh": "我不会去那个黑巷子，因为看起来挺<w>可疑的</w>。"
                            }
                        },
                        {
                            "text": "Meeting a stranger in an abandoned building sounds very <w>sketch</w> to me.",
                            "target_lang_translations": {
                                "ru": "Встреча с незнакомцем в заброшенном здании кажется мне очень <w>мутной</w>.",
                                "zh": "在废弃建筑里见陌生人，我觉得非常<w>不靠谱</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "short for sketchy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подозрительный, опасный или сомнительного качества.",
                        "zh": "可疑的、危险的或质量存疑的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "вызывающий сомнения"
                            },
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "стрёмный",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可疑的",
                                "target_lang_sense_clarification": "令人怀疑的"
                            },
                            {
                                "target_lang_word": "不靠谱的",
                                "target_lang_sense_clarification": "口语，指质量差或危险"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}