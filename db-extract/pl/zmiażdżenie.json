                                                "text": "oilseed crushings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "534f7095-4056-3068-a762-726fd0c39fff",
                                        "entry_id": "020695bc-e3c5-3c4d-a49a-db8a141691cc",
                                        "glosses": [
                                            "The act of subjecting sugarcane to crushing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee75ab5-9f6d-4f3e-95b8-1a4fae7945d0",
                                                "sense_id": "534f7095-4056-3068-a762-726fd0c39fff",
                                                "text": "Mr. Holtze speaks with feeling upon this subject. His own experience had shown him the folly of planting sugar in dry soil, at a distance from water; the natural consequence was that, though the cane grew on the ironstone ridges of Palmerston, it would not throw up sufficient juice to make a good crushing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "752f43f9-eae0-45b7-a08c-0f4748146171",
                        "source_entry_id": "22718af2-4582-3f66-98b3-181c9383925a",
                        "source_sense_id": "bd4171d2-9083-3fa8-be62-3a29dc3e968b",
