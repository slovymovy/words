                        "sense_id": "e4adddc0-494b-3804-ac53-22b481dd4387",
                        "entry_id": "a5d8a3de-20b1-37f3-85fa-3a527c2b4ef3",
                        "glosses": [
                            "Action de décapitaliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a50b727-392e-41f1-9206-8599c26d2b03",
                                "sense_id": "e4adddc0-494b-3804-ac53-22b481dd4387",
                                "text": "Vous pouvez en être certains, la décapitalisation de Paris, c'est évidemment une diminution du pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "9af59af8-2de0-3b47-b419-748bf5d7216b",
                        "entry_id": "a5d8a3de-20b1-37f3-85fa-3a527c2b4ef3",
                        "glosses": [
                            "Caractère d’une gestion forestière aboutissant, à mesure des prélèvements, à une diminution des bois sur pied, en volume ou en surface terrière."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8db219f2-ab42-4e28-b7bd-4f6e93b29e0f",
                                "sense_id": "9af59af8-2de0-3b47-b419-748bf5d7216b",
                                "text": "En pratique, les consignes de martelage précisent si les sylviculteurs doivent plutôt s’orienter vers la capitalisation, la décapitalisation ou bien le maintien du capital sur pied à son niveau actuel (prélèvement de l’accroissement)."
                            },
                            {
                                "example_id": "681528c0-c602-4dd1-a28c-d464432c96f7",
                                "sense_id": "9af59af8-2de0-3b47-b419-748bf5d7216b",
                                "text": "Pour les peuplements qui auront été conduits selon les préconisations des paragraphes précédents, la surface terrière de l’étage dominant avant ensemencement devrait être comprise entre 28 et 32 m²/ha. Pour les peuplements qui se retrouveraient avec une surface terrière supérieure, une première coupe de décapitalisation doit être réalisée."
                            }
                        ]
                    }
