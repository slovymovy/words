                    {
                        "sense_id": "a767ed21-71d6-3e9c-aca7-9e0ecfad85f2",
                        "entry_id": "a2a72163-cc0e-3519-a81b-d96967b429f1",
                        "glosses": [
                            "een bot van de wervelkolom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00c6a365-e059-4acf-a237-b808484c3883",
                                "sense_id": "a767ed21-71d6-3e9c-aca7-9e0ecfad85f2",
                                "text": "De menselijke wervelkolom bestaat uit 33 of 34 wervels."
                            }
                        ]
                    },
                    {
                        "sense_id": "918c9063-a34b-3b5f-b417-dae2bbf4d189",
                        "entry_id": "a2a72163-cc0e-3519-a81b-d96967b429f1",
                        "glosses": [
                            "draaiende beweging in een gas of vloeistof"
                        ],
                        "tags": [],
