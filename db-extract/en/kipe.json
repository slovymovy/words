                        "entry_id": "f37d307c-9788-3ceb-b489-50374f1d105c",
                        "glosses": [
                            "An osier basket used for catching fish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f4b40b8-4165-4d5d-bfe1-c345b7207fd1",
                                "sense_id": "05bda7da-14ad-3760-9151-2998c11c309f",
                                "text": "The completed kipe looks like a crinoline made for a giantess; from the slender waist the skirts swell to a diameter of eight feet at the hem.\nThe kipe is only the mouth to the fisherman's elaborate trap and is fixed so that it faces up-river."
                            }
                        ]
                    }
                ],
