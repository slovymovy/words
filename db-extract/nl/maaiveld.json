                                "sense_id": "40f3d625-2c8c-3410-8e8b-05b4d24044e6",
                                "text": "Het maaiveld van deze locatie is ongeveer 100 meter boven zeeniveau.",
                                "translation": "The average height of this location is about 100 meters above sea level.",
                                "english": "The average height of this location is about 100 meters above sea level."
                            },
