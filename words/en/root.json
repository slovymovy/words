                            {
                                "target_lang_word": "方根",
                                "target_lang_sense_clarification": "平方根、立方根等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9700ad01-efb1-3a3c-9766-ace137cc4e5e",
                    "sense_definition": "The fundamental cause, source, or origin of something, especially a problem or feeling.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "origin_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to find the <w>root</w> cause of the error to fix it permanently.",
                            "target_lang_translations": {
                                "ru": "Нам нужно найти <w>первопричину</w> ошибки, чтобы исправить её навсегда.",
                                "zh": "我们需要找出这个错误的<w>根本原因</w>，才能彻底解决它。"
                            }
