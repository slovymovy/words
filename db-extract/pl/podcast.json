                        "sense_id": "9c3b5cbe-082d-354a-98cb-a0551c67cf7e",
                        "entry_id": "6ae7e0ca-c9c6-3410-9f39-0c41f0281481",
                        "glosses": [
                            "audycja dźwiękowa lub wideo dostarczana za pomocą RSS"
                        ],
                        "tags": [
                            "publ."
                        ],
                        "examples": [
                            {
                                "example_id": "35abe7da-8a38-4a08-b205-1c281167bf0a",
                                "sense_id": "9c3b5cbe-082d-354a-98cb-a0551c67cf7e",
                                "text": "Wentylator klimatyzatora szumi tak głośno, że nagrywanie podcastu w tym pomieszczeniu mija się z celem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
