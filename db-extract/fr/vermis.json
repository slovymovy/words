        "fr-extract.jsonl": [
            {
                "entry_id": "9560ea8e-b666-3db8-ad74-3c46ca27d741",
                "word": "vermis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ca00019-b6c2-3e5e-a5dc-06d0961eda09",
                        "entry_id": "9560ea8e-b666-3db8-ad74-3c46ca27d741",
                        "glosses": [
                            "Partie médiane du cervelet placée entre les deux hémisphères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde4acb2-48c9-4b22-9a9e-544d9a039f22",
                                "sense_id": "0ca00019-b6c2-3e5e-a5dc-06d0961eda09",
                                "text": "Le vermis et les deux hémisphères sont en effet décorés par des sillons transversaux concentriques qui délimitent des lobes ou lobules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "583044ae-dbdc-4b21-a385-e780c7ba26bc",
                        "source_entry_id": "9560ea8e-b666-3db8-ad74-3c46ca27d741",
                        "source_sense_id": "0ca00019-b6c2-3e5e-a5dc-06d0961eda09",
                        "target_lang_word": "Wurm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wurm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef10c286-ee1c-3ddf-b86b-f3cb77803a0b",
                                        "entry_id": "758e8b91-0020-32e6-bc12-55577b36bc6d",
                                        "glosses": [
                                            "wirbelloses, bilateral-symmetrisches, langgestrecktes Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46020e6-11e2-4703-bc86-316bb0ef98f9",
                                                "sense_id": "ef10c286-ee1c-3ddf-b86b-f3cb77803a0b",
                                                "text": "Der Regenwurm gehört zu den Würmern und ist ein zwittriger Ringelwurm."
                                            },
                                            {
                                                "example_id": "94589c8f-cddf-4438-945f-b4b7983d6b70",
                                                "sense_id": "ef10c286-ee1c-3ddf-b86b-f3cb77803a0b",
                                                "text": "„Es handelt sich hierbei um Einzeller (Protozoen) wie die Foraminiferen (mit Kalkschale) und die Radiolarien (Skelett aus Kieselsäure), um Coelenteraten wie Medusen und Quallen, um Rädertierchen, Würmer aus der Gruppe der Anneliden und der Chaetognathen sowie zahlreiche Krustentiere, unter den die Copepoden überwiegen.“"
                                            },
                                            {
                                                "example_id": "c140bdcd-9c8a-4d63-94b5-7b15b472ba9d",
                                                "sense_id": "ef10c286-ee1c-3ddf-b86b-f3cb77803a0b",
                                                "text": "„Der Flieger tauscht die Sicht eines Wurms mit der eines Adlers.\""
                                            },
                                            {
                                                "example_id": "cfe2c274-1af0-44dc-8f97-be764e869a89",
                                                "sense_id": "ef10c286-ee1c-3ddf-b86b-f3cb77803a0b",
                                                "text": "„Um die Gefährlichkeit des Alkohols zu demonstrieren, legt der Lehrer in der Biologiestunde einen Wurm in ein Glas mit Schnaps und einen in ein Glas mit Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "98cddbbb-9dce-37be-95a1-7da4dab9150f",
                                        "entry_id": "758e8b91-0020-32e6-bc12-55577b36bc6d",
                                        "glosses": [
                                            "volkstümliche Bezeichnung von Krankheiten, die man durch Ausschneiden eines Nervs, den man für den Wurm hielt, zu bessern suchte"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "712de7ab-16a7-40b8-bb9b-f4ebfdbf8603",
                                                "sense_id": "98cddbbb-9dce-37be-95a1-7da4dab9150f",
                                                "text": "Der Wurmsegen sollte früher den Wurm als Krankheitsdämon beschwören."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b6102f70-a7f2-3b77-bd4b-c6cd2b0f4773",
                                        "entry_id": "758e8b91-0020-32e6-bc12-55577b36bc6d",
                                        "glosses": [
                                            "ein Parasit der Haustiere oder der Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "252ff740-80b8-466f-9859-cb152edf7f16",
                                                "sense_id": "b6102f70-a7f2-3b77-bd4b-c6cd2b0f4773",
                                                "text": "Hunde können schnell mal Würmer kriegen. Bandwürmer, Spul- oder Hakenwürmer sind gar nicht so selten."
                                            },
                                            {
                                                "example_id": "4dae7bf1-ecbd-4d04-8812-7b523145fec0",
                                                "sense_id": "b6102f70-a7f2-3b77-bd4b-c6cd2b0f4773",
                                                "text": "Schon zum dritten Mal in diesem Quartal kam Herr Schulze mit Würmern in meine allgemeinmedizinische Praxis."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b34703dd-87bf-376d-9bc5-310f0b383482",
                                        "entry_id": "758e8b91-0020-32e6-bc12-55577b36bc6d",
                                        "glosses": [
                                            "armseliges, hilfloses Wesen"
                                        ],
                                        "tags": [
                                            "sinnbildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a570950e-f5d2-4f25-b938-ad1afc316ef7",
                                                "sense_id": "b34703dd-87bf-376d-9bc5-310f0b383482",
                                                "text": "Das junge Kätzchen lag da wie ein hilfloser Wurm."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d44dbc4d-1410-3b60-92fa-d28dd472447a",
                                        "entry_id": "758e8b91-0020-32e6-bc12-55577b36bc6d",
                                        "glosses": [
                                            "kurz für: Computerwurm (ein sich selbständig verbreitender Schadcode oder Spionagecode)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a20f67c-c849-4e61-ad3a-d4cc5d01111c",
                                                "sense_id": "d44dbc4d-1410-3b60-92fa-d28dd472447a",
                                                "text": "Der Wurm hatte eine Schwäche beim Netzwerkbetreiber ausgenutzt."
                                            },
                                            {
                                                "example_id": "6ed1f074-2a38-4c33-82f1-c135348ef59b",
                                                "sense_id": "d44dbc4d-1410-3b60-92fa-d28dd472447a",
                                                "text": "„Der besonders raffiniert programmierte Wurm lässt Experten rätseln.“"
                                            },
                                            {
                                                "example_id": "0c5f4101-bf99-489f-beec-b8eab88b76ed",
                                                "sense_id": "d44dbc4d-1410-3b60-92fa-d28dd472447a",
                                                "text": "„Der Wurm kann Schäden anrichten und die Sicherheit des Computers gefährden.“"
                                            },
                                            {
                                                "example_id": "6cb53451-0850-4bdc-8db3-702469161298",
                                                "sense_id": "d44dbc4d-1410-3b60-92fa-d28dd472447a",
                                                "text": "„Anders als ein Virus ist ein Wurm nicht darauf angewiesen, dass Wechseldatenträger verwendet werden, um sich auszubreiten.“"
                                            },
                                            {
                                                "example_id": "f4cabf92-8997-4384-8fd7-e440606ef09a",
                                                "sense_id": "d44dbc4d-1410-3b60-92fa-d28dd472447a",
                                                "text": "„Als normaler Anwender kann man einen Wurm ohne Virenscanner im Allgemeinen nicht erkennen.“"
                                            },
                                            {
                                                "example_id": "d1dd4b7c-aee3-462a-a467-403fe83f6ff9",
                                                "sense_id": "d44dbc4d-1410-3b60-92fa-d28dd472447a",
                                                "text": "„Im Glauben, die gefälschte E-Mail sei eine legitime E-Mail, öffnet der Empfänger diese und löst damit den Wurm aus, der dann nach weiteren Adressen sucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "87cc4865-008a-337b-88c5-0b5b475fe591",
                                        "entry_id": "758e8b91-0020-32e6-bc12-55577b36bc6d",
                                        "glosses": [
                                            "Kerngebiet des Kleinhirns"
                                        ],
                                        "tags": [
                                            "Neurochirurgie"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "f7f7145d-a6d2-32ba-b983-093b2a5c60b7",
                                        "entry_id": "758e8b91-0020-32e6-bc12-55577b36bc6d",
                                        "glosses": [
                                            "lange Ausführung eines Schalwagens"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "d45b8c4b-8228-3d8c-b88b-c730109d1697",
                                        "entry_id": "758e8b91-0020-32e6-bc12-55577b36bc6d",
                                        "glosses": [
                                            "kurz für: (1785) Wurm, ein Asteroid"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "052df953-99c6-365f-b1ec-2484f5845e22",
                                        "entry_id": "758e8b91-0020-32e6-bc12-55577b36bc6d",
                                        "glosses": [
                                            "Erdnussflips"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bff1af4-84e9-4dc1-80f9-24ab9b4e9f20",
                                                "sense_id": "052df953-99c6-365f-b1ec-2484f5845e22",
                                                "text": "Irgendein Silvester-Partygast hatte die ganzen Würmer auf den Boden geworfen – nun knisterte es bei jedem Schritt."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wurm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d438105-1df8-3814-a93b-ff36420c5237",
                                        "entry_id": "fdb388e3-dcc5-3e44-ac1d-330baa767d83",
                                        "glosses": [
                                            "kleines, hilfsbedürftiges; auch krankes, schwächliches Kind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "317ff852-4897-4fbc-8e07-70836847e68f",
                                                "sense_id": "7d438105-1df8-3814-a93b-ff36420c5237",
                                                "text": "Nimm das Wurm und lege es schlafen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wurm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                        "entry_id": "bbbbb996-638d-319e-b0e3-2c9e3f93efc6",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "437ee265-c746-496c-87ae-0d8152752022",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Frau Wurm ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "79228a14-22f9-430e-aac7-58ba6ec9478a",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Herr Wurm wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "77c1a589-a88c-4e98-bf43-3da0dfff0ca9",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Die Wurms fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "aaba25f0-59ca-4b2f-b07c-f61c10ac390c",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Der Wurm trägt nie die Schals, die die Wurm ihm strickt."
                                            },
                                            {
                                                "example_id": "c21cf382-280d-4839-8c26-85916e15c19c",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wurm kommt, geht der Herr Wurm.“"
                                            },
                                            {
                                                "example_id": "d800d9ab-b4e9-44a4-9466-3a5f2a9df1e4",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Wurm kommt und geht."
                                            },
                                            {
                                                "example_id": "5e9e540a-3db2-46b8-8abc-852bf3a77ac4",
                                                "sense_id": "e719b1de-1655-354f-9c56-a17c3c537ed0",
                                                "text": "Wurms kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wurm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d3694a7-4711-3746-a7e1-80886b0adf4c",
                                        "entry_id": "4d0b26b2-48e4-3656-99f0-772ee67d036b",
                                        "glosses": [
                                            "Fluss in Nordrhein-Westfalen, Deutschland, teilweise in den Niederlanden, durchfließt Aachen, teilweise Grenzfluss, linker Nebenfluss der Rur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeffa5ac-5269-4efb-8d9b-f3a5ccfab225",
                                                "sense_id": "4d3694a7-4711-3746-a7e1-80886b0adf4c",
                                                "text": "Wir überquerten die Wurm."
                                            },
                                            {
                                                "example_id": "74eca207-4744-478c-a38b-2e198e33bcc3",
                                                "sense_id": "4d3694a7-4711-3746-a7e1-80886b0adf4c",
                                                "text": "Die Kinder versuchten, in der Wurm zu baden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
