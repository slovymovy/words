                        ]
                    },
                    {
                        "sense_id": "b45c3b2d-aa38-3641-82d1-05d30d019303",
                        "entry_id": "b61bc17f-d73d-3e3d-b8f3-050cef7f00c4",
                        "glosses": [
                            "Temps d’épreuve qui précède le noviciat."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
