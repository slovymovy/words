                ],
                "senses": [
                    {
                        "sense_id": "2ca3e735-7efb-3549-a604-9a7438f03bd1",
                        "entry_id": "6832fe6e-3abb-3a87-ade3-0ee0c457fa58",
                        "glosses": [
                            "strumyk, potok, mały ciek"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "98622c7d-677e-46e4-8df1-c267a23eae11",
                                "sense_id": "2ca3e735-7efb-3549-a604-9a7438f03bd1",
                                "text": "Pani zabija pana; zabiwszy grzebie w gaju, na łączce przy ruczaju."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93560791-ee7d-4b6d-bfae-a34b4896003d",
                        "source_entry_id": "6832fe6e-3abb-3a87-ade3-0ee0c457fa58",
                        "source_sense_id": "2ca3e735-7efb-3549-a604-9a7438f03bd1",
                        "target_lang_word": "ručej",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "684acdf3-84ef-4872-b274-3452ee880feb",
                        "source_entry_id": "6832fe6e-3abb-3a87-ade3-0ee0c457fa58",
                        "source_sense_id": "2ca3e735-7efb-3549-a604-9a7438f03bd1",
                        "target_lang_word": "ручей",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ручей",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7546ce00-46b5-3ff7-8fb1-241cd858bf3e",
                                        "entry_id": "f201a03c-5e89-38b3-af2e-c64348f6350f",
                                        "glosses": [
                                            "небольшой водный поток, маленькая речка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818cf478-b8e7-4f47-a718-9b7f72be4af7",
                                                "sense_id": "7546ce00-46b5-3ff7-8fb1-241cd858bf3e",
                                                "text": "Ягнёнок в жаркий день зашёл к ручью напиться.."
                                            },
                                            {
                                                "example_id": "4fb382d5-6d56-482e-8e85-097c7329472a",
                                                "sense_id": "7546ce00-46b5-3ff7-8fb1-241cd858bf3e",
                                                "text": "Устроив запруду в русле мелкого ручья, они обеспечили себе вольготный и достаточно широкий водоём, с бережком, одетым в сплошной пояс тростников, камышей и рогозов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69c74cf2-55da-30b2-8aa5-494f396c51b5",
                                        "entry_id": "f201a03c-5e89-38b3-af2e-c64348f6350f",
                                        "glosses": [
                                            "перен. что-либо обильно текущее"
                                        ],
                                        "tags": [
                                            "употр. в сравнении с ручьём [1]"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07fcb517-4642-40f6-9870-590a9fedbf53",
                                                "sense_id": "69c74cf2-55da-30b2-8aa5-494f396c51b5",
                                                "text": "Бедняжка, она лежала неподвижно, и кровь лилась из раны ручьями…"
                                            },
                                            {
                                                "example_id": "b33239a7-0e07-435b-9e24-2da176e2bf8f",
                                                "sense_id": "69c74cf2-55da-30b2-8aa5-494f396c51b5",
                                                "text": "Он до такой степени забегался в лошадки с дворовыми мальчишками, что пот лил с его лица ручьями, и он едва переводил дыхание."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d84dee0-724f-3697-ac84-a9446c636c92",
                                        "entry_id": "f201a03c-5e89-38b3-af2e-c64348f6350f",
                                        "glosses": [
                                            "металл. углубление на поверхности валка прокатного стана для придания прокатываемому металлу нужной формы сечения"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c41cd3b-f3cd-3186-9d21-3239e1ccc691",
                                        "entry_id": "f201a03c-5e89-38b3-af2e-c64348f6350f",
                                        "glosses": [
                                            "мех. жёлоб, идущий вдоль обода блока, в который укладывается канат, проходящий через блок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee66d6f-8c81-4e7f-8adb-d357e3e17bc4",
                                                "sense_id": "6c41cd3b-f3cd-3186-9d21-3239e1ccc691",
                                                "text": "Осмотреть в доступных местах канаты и их крепление на барабане, стреле и в других местах, обращая внимание на правильность укладки канатов в ручьях блоков и барабанов, а в зимний период на отсутствие примерзания грузового и стрелового канатов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1070a1d1-73fa-30e6-b811-1f90d6f3f9ce",
                                        "entry_id": "f201a03c-5e89-38b3-af2e-c64348f6350f",
                                        "glosses": [
                                            "металл. полость в штампе, заполняемая металлом при штамповке"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
