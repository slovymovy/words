                        "examples": [
                            {
                                "example_id": "4e73a1c1-95b9-44c3-b5a7-5f4ecba653e2",
                                "sense_id": "d1213ae1-2fa7-33fa-ae49-02e3dc87a5ea",
                                "text": "St Ethelwold, King of the same Prouince and Martyr: who being wickedly slayne in the Ciuill warres among his owne subiects, and his body brought to the Church of Hexam... the same was with great solemnity & veneration honourably reconded in the said Church as beseemed so pretious a treasure."
                            },
                            {
                                "example_id": "e34522a1-4244-445f-8c94-84bd5e9ca795",
                                "sense_id": "d1213ae1-2fa7-33fa-ae49-02e3dc87a5ea",
                                "text": "A Ferment […] somewhere reconded out of the Road of the circulating Blood, and there gradually maturated."
                            }
                        ]
                    }
