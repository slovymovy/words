                ],
                "senses": [
                    {
                        "sense_id": "af7c1c52-fff8-3b58-b427-e615f03a4554",
                        "entry_id": "8067bfc9-fda2-3ac3-8ceb-10f87282ae73",
                        "glosses": [
                            "plötzliche Verbrennung von in der Luft fein verteilten, kleinen, festen Partikeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518ba42d-de0b-48db-88aa-ece3184aef06",
                                "sense_id": "af7c1c52-fff8-3b58-b427-e615f03a4554",
                                "text": "„Donnerstagfrüh geriet der Spänesilo einer Tischlerei in Lebing (Gemeinde Floing, Bezirk Weiz) nach einer Staubexplosion in Brand.“"
                            },
                            {
                                "example_id": "24b28d72-be6c-44c5-8349-5fd3c8d2fc10",
                                "sense_id": "af7c1c52-fff8-3b58-b427-e615f03a4554",
                                "text": "„In den Werken bestehe ebenfalls das Risiko einer Staubexplosion, meldete die Nachrichtenagentur Xinhua am Mittwoch.“"
                            },
                            {
                                "example_id": "8f8c6204-7ab4-4ade-b88d-0714a268f9d4",
                                "sense_id": "af7c1c52-fff8-3b58-b427-e615f03a4554",
                                "text": "„Wie die amtlichen Medien am Montag berichteten, könnte es sich bei dem Unglück in der Fabrik des weltgrößten Elektronikherstellers am Freitag um eine Staubexplosion gehandelt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
