                                    {
                                        "sense_id": "afb66cca-9b78-3dc8-bf0e-e52223e769d7",
                                        "entry_id": "7b1095cb-f367-338b-bd3c-e3855a8d5c00",
                                        "glosses": [
                                            "A major road in a town or village, or in a country area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6e77da-f4a2-4e46-8b46-4314b6be5817",
                                                "sense_id": "afb66cca-9b78-3dc8-bf0e-e52223e769d7",
                                                "text": "Until the main road from Hatfield to Hertford was diverted a few years ago, heavy lorries trundling through the village sometimes knocked chunks off corner buildings, but now the village has regained much of its former tranquillity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7336f2e6-d52c-38c1-86cd-b9e8d36c3e93",
                                        "entry_id": "7b1095cb-f367-338b-bd3c-e3855a8d5c00",
                                        "glosses": [
                                            "A major urban road, off which lead many smaller streets, many of them cul-de-sacs."
                                        ],
                                        "tags": [
                                            "Northeastern",
                                            "UK",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "533abdbb-05ac-4c17-ae86-ea66236f019c",
                                                "sense_id": "7336f2e6-d52c-38c1-86cd-b9e8d36c3e93",
                                                "text": "Living near the main road means you hear a lot of traffic noise."
                                            },
                                            {
                                                "example_id": "2f123f37-050e-4f44-99f2-5d0d0832d11e",
                                                "sense_id": "7336f2e6-d52c-38c1-86cd-b9e8d36c3e93",
                                                "text": "The highway to the East Coast which ran through the borough of Ebbfield had always been a main road and even now, despite the vast garages, the pylons and the gaily painted factory glasshouses which had sprung up beside it, there still remained an occasional trace of past cultures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "016c1b2d-ff08-35fd-a211-3a7214ebcce2",
                                        "entry_id": "7b1095cb-f367-338b-bd3c-e3855a8d5c00",
                                        "glosses": [
                                            "High Street; Main Street"
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdb78b63-96c3-30ce-87e0-4c025448ec6d",
                                        "entry_id": "7b1095cb-f367-338b-bd3c-e3855a8d5c00",
                                        "glosses": [
                                            "A priority road; a road where entering traffic must yield right of way."
                                        ],
                                        "tags": [
                                            "in some countries"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
