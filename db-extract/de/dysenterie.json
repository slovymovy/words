                                "target_senses": [
                                    {
                                        "sense_id": "1df64b2f-50c1-316c-b07e-05fe66d68826",
                                        "entry_id": "12b97786-b6ec-3f3b-a85a-ca10db396e4e",
                                        "glosses": [
                                            "A disease characterised by inflammation of the intestines, especially the colon (large intestine), accompanied by pus (white blood cells) in the feces, fever, pain in the abdomen, high-volume diarrhea, and possible blood in the feces."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b9442c9-dcc8-45bb-af98-e55621b16cc5",
                                                "sense_id": "1df64b2f-50c1-316c-b07e-05fe66d68826",
                                                "text": "We ate, we drank, and we were merry / and we got typhoid and dysentery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf132f72-d344-3a89-b541-56d4177da32f",
