                ],
                "senses": [
                    {
                        "sense_id": "b54adcb1-ed28-3dfb-994b-b44a786f5e63",
                        "entry_id": "aabf0ee7-aeab-322d-87da-ca202e32bd10",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2686efe0-9c79-4e48-be91-12368fb80e10",
                                "sense_id": "b54adcb1-ed28-3dfb-994b-b44a786f5e63",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zürn kommt, geht der Herr Zürn.“"
                            },
                            {
                                "example_id": "2b630b84-6986-4bcf-91c6-ff0d78d91142",
                                "sense_id": "b54adcb1-ed28-3dfb-994b-b44a786f5e63",
                                "text": "Zürn kommt und geht."
                            },
                            {
                                "example_id": "82b8ede4-9101-4937-b2f2-f1d63ea9ea27",
                                "sense_id": "b54adcb1-ed28-3dfb-994b-b44a786f5e63",
                                "text": "Zürns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b1e56747-385a-4557-bbe7-53b25947cfb3",
                                "sense_id": "b54adcb1-ed28-3dfb-994b-b44a786f5e63",
                                "text": "Die Zürns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0a95097a-e6fd-44bc-8d43-b296c07f19d8",
                                "sense_id": "b54adcb1-ed28-3dfb-994b-b44a786f5e63",
                                "text": "Der Zürn trägt nie die Schals, die die Zürn ihm strickt."
                            },
                            {
                                "example_id": "151a4f21-65ce-42a7-a903-bef00d08d389",
                                "sense_id": "b54adcb1-ed28-3dfb-994b-b44a786f5e63",
                                "text": "Frau Zürn ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d32ee6a0-ca9d-4fe1-8105-6bcb016fa182",
                                "sense_id": "b54adcb1-ed28-3dfb-994b-b44a786f5e63",
                                "text": "Herr Zürn wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
