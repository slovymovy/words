                "senses": [
                    {
                        "sense_id": "0d097c0d-bafa-3a24-96fe-f253dd897d77",
                        "entry_id": "0d44490a-e68b-3b9d-9a21-bbc3cd250117",
                        "glosses": [
                            "der Atmung dienendes Gefäßsystem von Insekten, Tausendfüßlern und diversen Spinnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89bca428-c3f9-444a-8347-e551a6259c7b",
                                "sense_id": "0d097c0d-bafa-3a24-96fe-f253dd897d77",
                                "text": "Weil Insekten über Tracheen atmen, wird ihre Körpergröße vom verfügbaren Sauerstoff limitiert."
                            },
                            {
                                "example_id": "484ce362-eb2b-4cd7-af69-de7b0ec117a9",
                                "sense_id": "0d097c0d-bafa-3a24-96fe-f253dd897d77",
                                "text": "Sie haben ein Röhrensystem (Tracheen), das die Luft direkt von der Haut bis in die Zellen bringt."
                            },
                            {
                                "example_id": "8eb7573c-7760-4cdc-b09f-c843cb9c54e5",
                                "sense_id": "0d097c0d-bafa-3a24-96fe-f253dd897d77",
                                "text": "… der Lunge. Dieses Organ ist mit seiner großen, feuchten Oberfläche bei der Aufnahme von Sauerstoff aus der Luft – und der Abgabe von CO2 in diese – deutlich effizienter als die Tracheen der Insekten, es hat sich unabhängig von den Kiemen der Fische entwickelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3cb2e8a9-0e0e-39a6-963e-6db6ef6a6e5d",
                        "entry_id": "0d44490a-e68b-3b9d-9a21-bbc3cd250117",
                        "glosses": [
                            "wasserführendes Gefäß im Gewebe höherer Pflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eabf9a5f-f542-409c-b0f0-341f7f782cf9",
                                "sense_id": "3cb2e8a9-0e0e-39a6-963e-6db6ef6a6e5d",
                                "text": "Tracheen und Tracheiden sind abgestorbene, verholzte Zellen."
                            },
                            {
                                "example_id": "6663411b-b0d9-45d6-b609-4945bdae4b1d",
                                "sense_id": "3cb2e8a9-0e0e-39a6-963e-6db6ef6a6e5d",
                                "text": "Wasser wird im Leitgewebe – bestehend aus Tracheen und Tracheïden - von unten nach oben transportiert."
                            },
                            {
                                "example_id": "6dc9b0c5-f1cd-4e8b-91c4-1bf920514c30",
                                "sense_id": "3cb2e8a9-0e0e-39a6-963e-6db6ef6a6e5d",
                                "text": "Bei Tracheen sind die Endwände der Zellen stark durchbrochen oder vollständig aufgelöst. Dadurch bilden sie Röhren ohne Zwischenwände."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
