                        "sense_id": "c2cccab6-07a2-3e36-8411-a2276b337f48",
                        "entry_id": "78767d76-671d-35fa-8427-e8543c70838a",
                        "glosses": [
                            "de manier waarop men iemand als gast ontvangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba396fe3-1192-4770-806e-4843e66357d1",
                                "sense_id": "c2cccab6-07a2-3e36-8411-a2276b337f48",
                                "text": "Hij kreeg een warm onthaal van zijn familieleden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d204d1c-4ba4-4963-afc5-6439eb4b0ea3",
                        "source_entry_id": "78767d76-671d-35fa-8427-e8543c70838a",
                        "source_sense_id": "c2cccab6-07a2-3e36-8411-a2276b337f48",
                        "source_sense_description": "de manier waarop men iemand als gast ontvangt",
                        "target_lang_word": "Empfang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empfang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ce10b8d-83ca-39c9-a3a7-5ee07c164d3c",
                                        "entry_id": "7adf35e7-c42d-3b6f-868f-a891d5124ecd",
                                        "glosses": [
                                            "das Empfangen einer Übertragung (zum Beispiel Rundfunk, Funk, Handy, …)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc083f2-d8e9-4e3a-a302-4efad9e0f481",
                                                "sense_id": "7ce10b8d-83ca-39c9-a3a7-5ee07c164d3c",
                                                "text": "In ländlichen Regionen lässt der Empfang von Fernsehsendungen oft zu wünschen übrig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2397984c-28f5-334c-837a-334ae3a24f08",
                                        "entry_id": "7adf35e7-c42d-3b6f-868f-a891d5124ecd",
                                        "glosses": [
                                            "Begrüßung (zum Beispiel von Gästen, Mitarbeitern, Freunden und Ähnlichen)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3fed0a6-a527-47fc-8e51-67593814e33f",
                                                "sense_id": "2397984c-28f5-334c-837a-334ae3a24f08",
                                                "text": "Die neuen Mitglieder wurden von allen herzlich in Empfang genommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8098cd75-a2fa-3c5f-ae40-0cc6c99874a3",
                                        "entry_id": "7adf35e7-c42d-3b6f-868f-a891d5124ecd",
                                        "glosses": [
                                            "ein Fest zur Begrüßung von Gästen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaaa0449-68aa-4e13-a09b-2e0cc968676f",
                                                "sense_id": "8098cd75-a2fa-3c5f-ae40-0cc6c99874a3",
                                                "text": "Der Empfang der Diva im Schloss Liechtenstein war pompös."
                                            },
                                            {
                                                "example_id": "ca2bf9eb-0a86-439f-bfcf-1dc6fbecf9e8",
                                                "sense_id": "8098cd75-a2fa-3c5f-ae40-0cc6c99874a3",
                                                "text": "„Nach seiner Heimkehr bereitet man Kolumbus in Spanien einen triumphalen Empfang.“"
                                            },
                                            {
                                                "example_id": "809b6afb-4a93-4de3-954e-0d2df6a888d4",
                                                "sense_id": "8098cd75-a2fa-3c5f-ae40-0cc6c99874a3",
                                                "text": "„Jeden Abend war bei Seiner Excellenz Empfang, und der höchste Adel Roms, Männer und Frauen, fand sich dazu ein; ich ging nie hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1b7d1948-c322-35fd-933b-dffc5a36df4a",
                                        "entry_id": "7adf35e7-c42d-3b6f-868f-a891d5124ecd",
                                        "glosses": [
                                            "eine Rezeption in einer Empfangshalle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42876d76-dc61-4e55-9468-6133ebe69a1b",
                                                "sense_id": "1b7d1948-c322-35fd-933b-dffc5a36df4a",
                                                "text": "Die Zimmerschlüssel können beim Empfang abgegeben werden."
                                            },
                                            {
                                                "example_id": "4e132403-c245-4dde-b685-4a6af4282f77",
                                                "sense_id": "1b7d1948-c322-35fd-933b-dffc5a36df4a",
                                                "text": "„Das Mädchen saß wie ein Häufchen Elend im Lehnstuhl hinter dem Empfang auf der Polizeiwache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "742b1cd8-62d4-3fe0-bed9-396b54d67f5b",
                                        "entry_id": "7adf35e7-c42d-3b6f-868f-a891d5124ecd",
                                        "glosses": [
                                            "das Bekommen, das Entgegennehmen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dccd7f2f-d737-431b-88d6-f217d0fe531e",
                                                "sense_id": "742b1cd8-62d4-3fe0-bed9-396b54d67f5b",
                                                "text": "Beim Empfang des Briefes wusste ich schon, was drinsteht."
                                            },
                                            {
                                                "example_id": "1d28c1b7-e3ce-4861-9de9-95cdd84f579f",
                                                "sense_id": "742b1cd8-62d4-3fe0-bed9-396b54d67f5b",
                                                "text": "„Nach Empfang der Sterbesakramente ging er still hinüber, und am nächsten Tage drängten sich in der Rostowschen Mietswohnung alle Bekannten der Familie, um dem Verschiedenen die letzte Ehre zu erweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4071463-ad48-4e85-a2a6-0a76059bff2d",
                        "source_entry_id": "78767d76-671d-35fa-8427-e8543c70838a",
