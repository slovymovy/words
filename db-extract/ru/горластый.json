                ],
                "senses": [
                    {
                        "sense_id": "fe24160a-6e51-39f8-95cb-3aa2db1e0b68",
                        "entry_id": "799f73d1-f6c5-3054-98c5-84e88c3df15f",
                        "glosses": [
                            "прост. обладающий громким голосом; крикливый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68a35d51-0f5d-44b5-b189-c0b187d3b37e",
                                "sense_id": "fe24160a-6e51-39f8-95cb-3aa2db1e0b68",
                                "text": "Всё в доме вдруг словно потемнело; все лица вытянулись, сделалась странная тишина; со двора унесли на деревню какого-то горластого петуха, который долго не мог понять, зачем с ним так поступают."
                            }
                        ]
                    }
                ],
