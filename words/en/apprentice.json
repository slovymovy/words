{
    "word_family": [
        "apprenticeship"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3dafdd5a-a2d8-31b5-981b-9c5c53f3f5d8",
                    "sense_definition": "A trainee, especially in a skilled trade, who is learning a profession from a skilled employer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trainee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>apprentice</w> spent his first week learning how to handle the tools safely.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>ученик</w> провёл свою первую неделю, обучаясь безопасному обращению с инструментами."
                            }
                        },
                        {
                            "text": "She decided to work as an <w>apprentice</w> plumber to gain practical experience.",
                            "target_lang_translations": {
                                "ru": "Она решила поработать <w>учеником</w> сантехника, чтобы получить практический опыт."
                            }
                        }
                    ],
                    "synonyms": [
                        "trainee",
                        "learner",
                        "novice"
                    ],
                    "antonyms": [
                        "master",
                        "expert"
                    ],
                    "common_phrases": [
                        "apprentice plumber",
                        "trade apprentice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ученик или стажёр, особенно в сфере ремесленного или практического дела, обучающийся профессии у квалифицированного мастера."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ученик",
                                "target_lang_sense_clarification": "обучающийся профессии у кого-либо"
                            },
                            {
                                "target_lang_word": "подмастерье",
                                "target_lang_sense_clarification": "помощник мастера-ремесленника"
                            },
                            {
                                "target_lang_word": "стажёр",
                                "target_lang_sense_clarification": "проходящий практику"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff7c1d29-c7ca-3a34-a9a8-b9d7f9ae87b5",
                    "sense_definition": "One who is not well versed in a subject; a beginner or novice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trainee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the world of professional chess, he is still a mere <w>apprentice</w> compared to the grandmasters.",
                            "target_lang_translations": {
                                "ru": "В мире профессиональных шахмат он всё ещё всего лишь <w>новичок</w> по сравнению с гроссмейстерами."
                            }
                        },
                        {
                            "text": "She approached the complex project not as an expert, but as an eager <w>apprentice</w> willing to learn.",
                            "target_lang_translations": {
                                "ru": "Она подошла к сложному проекту не как эксперт, а как усердный <w>ученик</w>, готовый учиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "novice",
                        "beginner",
                        "tyro",
                        "newbie"
                    ],
                    "antonyms": [
                        "veteran",
                        "expert"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который плохо разбирается в каком-либо предмете; новичок или начинающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новичок",
                                "target_lang_sense_clarification": "начинающий в каком-либо деле"
                            },
                            {
                                "target_lang_word": "ученик",
                                "target_lang_sense_clarification": "в переносном смысле, не достигший совершенства"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de2b2353-a2a7-3262-ac31-08513e1ac675",
                    "sense_definition": "To place someone under the care and supervision of a master or employer to learn a trade.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "employ_apprentice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His parents decided to <w>apprentice</w> him to a local carpenter so he could learn a useful trade.",
                            "target_lang_translations": {
                                "ru": "Его родители решили <w>отдать его в учение</w> к местному плотнику, чтобы он мог освоить полезное ремесло."
                            }
                        },
                        {
                            "text": "She was <w>apprenticed</w> to a famous chef at the age of sixteen.",
                            "target_lang_translations": {
                                "ru": "В возрасте шестнадцати лет её <w>отдали в учение</w> к известному шеф-повару."
                            }
                        }
                    ],
                    "common_phrases": [
                        "apprenticed to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдать кого-либо на обучение к мастеру или работодателю для освоения профессии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдать в учение",
                                "target_lang_sense_clarification": "направить на обучение к мастеру"
                            },
                            {
                                "target_lang_word": "отдать в подмастерья",
                                "target_lang_sense_clarification": "направить обучаться ремеслу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7d1e6a5-7b8b-3b32-bc6d-b6c212a4daaa",
                    "sense_definition": "To serve as an apprentice to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "employ_apprentice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>apprenticed</w> with a master tailor for five years before opening his own shop.",
                            "target_lang_translations": {
                                "ru": "Он пять лет <w>обучался</w> у мастера-портного, прежде чем открыть собственное ателье."
                            }
                        },
                        {
                            "text": "She wanted to <w>apprentice</w> under the best architect in the city.",
                            "target_lang_translations": {
                                "ru": "Она хотела <w>пройти обучение</w> под руководством лучшего архитектора в городе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "apprentice under",
                        "apprentice with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать или служить в качестве ученика у кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обучаться",
                                "target_lang_sense_clarification": "проходить обучение у мастера"
                            },
                            {
                                "target_lang_word": "быть учеником",
                                "target_lang_sense_clarification": "работать в качестве подмастерья"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}