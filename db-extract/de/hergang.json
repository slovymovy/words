                "senses": [
                    {
                        "sense_id": "8e3c1b23-002e-33fc-8a33-ec8c8e92fe67",
                        "entry_id": "b27220d0-8593-324d-9ef6-69d8b1cc2221",
                        "glosses": [
                            "genauer Ablauf eines Geschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37983ded-af99-45a6-8faa-3ddce19eea67",
                                "sense_id": "8e3c1b23-002e-33fc-8a33-ec8c8e92fe67",
                                "text": "Die Polizei konnte den Hergang der Tat rekonstruieren."
                            },
                            {
                                "example_id": "5828286d-8267-4937-be10-365dcdc501a8",
                                "sense_id": "8e3c1b23-002e-33fc-8a33-ec8c8e92fe67",
                                "text": "Die Versicherung bat Herrn Müller, den Hergang des Unfalls schriftlich zu schildern."
                            },
                            {
                                "example_id": "1e7e9fa1-8be8-4b3b-b38e-ced1fe15b2a0",
                                "sense_id": "8e3c1b23-002e-33fc-8a33-ec8c8e92fe67",
                                "text": "Es kamen Zweifel am Hergang des Vorfalls auf."
                            },
                            {
                                "example_id": "47c5dfd4-1e58-4c1f-a90c-a85aefe2cc69",
                                "sense_id": "8e3c1b23-002e-33fc-8a33-ec8c8e92fe67",
                                "text": "„Der Fabrikmeister, ein älterer Mann, der mürrischer wirkte, als er es seinem Wesen nach war, erklärte Robert in kurzen Stichworten den Hergang der Produktion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
