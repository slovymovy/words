{
    "word_family": [
        "stralen",
        "straling",
        "straal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5ee307e1-02e5-3870-ba8d-61e2121c39d5",
                    "sense_definition": "Zeer blij, gelukkig of opgewekt overkomend",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "blijdschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>stralende</w> bruidje was het middelpunt van het feest.",
                            "target_lang_translations": {
                                "en": "The <w>radiant</w> bride was the center of attention at the party."
                            }
                        },
                        {
                            "text": "Met een <w>stralende</w> glimlach nam zij de hoofdprijs in ontvangst.",
                            "target_lang_translations": {
                                "en": "With a <w>beaming</w> smile, she accepted the grand prize."
                            }
                        }
                    ],
                    "synonyms": [
                        "schitterend"
                    ],
                    "antonyms": [
                        "dof"
                    ],
                    "common_phrases": [
                        "stralende glimlach",
                        "stralende ogen"
                    ],
                    "target_lang_definitions": {
                        "en": "Appearing very happy, joyful, or cheerful"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "radiant",
                                "target_lang_sense_clarification": "expressing great joy, love, or health"
                            },
                            {
                                "target_lang_word": "beaming",
                                "target_lang_sense_clarification": "smiling broadly and warmly"
                            },
                            {
                                "target_lang_word": "glowing",
                                "target_lang_sense_clarification": "expressing pride or happiness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54c10cd5-3b21-3841-b92f-e37d9747d57a",
                    "sense_definition": "Helder verlicht door de zon; zonnig en onbewolkt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was een <w>stralende</w> zomerdag waarop iedereen naar het strand ging.",
                            "target_lang_translations": {
                                "en": "It was a <w>bright</w> summer day when everyone went to the beach."
                            }
                        },
                        {
                            "text": "We genoten van de <w>stralende</w> zon tijdens onze wandeling in de bergen.",
                            "target_lang_translations": {
                                "en": "We enjoyed the <w>radiant</w> sun during our hike in the mountains."
                            }
                        }
                    ],
                    "synonyms": [
                        "schitterend"
                    ],
                    "antonyms": [
                        "bewolkt"
                    ],
                    "common_phrases": [
                        "stralende zon",
                        "stralende zomerdag"
                    ],
                    "target_lang_definitions": {
                        "en": "Brightly lit by the sun; sunny and cloudless"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bright",
                                "target_lang_sense_clarification": "filled with light, sunny"
                            },
                            {
                                "target_lang_word": "radiant",
                                "target_lang_sense_clarification": "shining or glowing brightly"
                            },
                            {
                                "target_lang_word": "sunny",
                                "target_lang_sense_clarification": "bright with sunlight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d78f86fa-0f34-309b-9075-6327e99c5a3e",
                    "sense_definition": "Licht of andere straling uitzendend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterrenhemel was gevuld met talloze <w>stralende</w> hemellichamen.",
                            "target_lang_translations": {
                                "en": "The starry sky was filled with countless <w>shining</w> celestial bodies."
                            }
                        },
                        {
                            "text": "Het hete metaal gaf een <w>stralende</w> hitte af die in de hele ruimte voelbaar was.",
                            "target_lang_translations": {
                                "en": "The hot metal gave off a <w>radiant</w> heat that could be felt throughout the room."
                            }
                        }
                    ],
                    "synonyms": [
                        "glanzend"
                    ],
                    "antonyms": [
                        "dof"
                    ],
                    "common_phrases": [
                        "stralende warmte"
                    ],
                    "target_lang_definitions": {
                        "en": "Emitting light or other radiation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "radiant",
                                "target_lang_sense_clarification": "sending out light or heat"
                            },
                            {
                                "target_lang_word": "shining",
                                "target_lang_sense_clarification": "giving off or reflecting light"
                            },
                            {
                                "target_lang_word": "glowing",
                                "target_lang_sense_clarification": "emitting steady light and heat without flames"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60a3aca3-26e6-3d4c-957b-304bd1fa4b40",
                    "sense_definition": "onvoltooid deelwoord van <w>stralen</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deelwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zon, fel <w>stralend</w> aan de hemel, verwarmde de koude aarde.",
                            "target_lang_translations": {
                                "en": "The sun, <w>shining</w> brightly in the sky, warmed the cold earth."
                            }
                        },
                        {
                            "text": "Zij liep de kamer binnen, <w>stralend</w> van geluk na het goede nieuws.",
                            "target_lang_translations": {
                                "en": "She walked into the room, <w>beaming</w> with happiness after the good news."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "onvoltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of 'stralen' (to shine, beam, or radiate)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shining",
                                "target_lang_sense_clarification": "emitting or reflecting light"
                            },
                            {
                                "target_lang_word": "beaming",
                                "target_lang_sense_clarification": "smiling radiantly or emitting light"
                            },
                            {
                                "target_lang_word": "radiating",
                                "target_lang_sense_clarification": "emitting energy or a strong feeling"
                            }
                        ]
                    }
                }
            ]
        }
    ]
