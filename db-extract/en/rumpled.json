                        "examples": [
                            {
                                "example_id": "f35d39cc-e9d9-4f40-b96c-2eb17b60e6bd",
                                "sense_id": "402711e8-28d7-3e1e-885b-e28debfe7475",
                                "text": "A demure-looking woman, in a dress rather tawdry and rumpled, here drew her veil well down and rose; but, marking every eye upon her, thought it advisable, upon the whole, to sit down again."
                            },
                            {
                                "example_id": "031e4775-6c9b-4b41-850e-114df1705783",
                                "sense_id": "402711e8-28d7-3e1e-885b-e28debfe7475",
                                "text": "The rumpled octogenarian and two-time presidential candidate [Bernie Sanders] has no plans to seek the Oval Office again."
                            }
                        ]
                    }
