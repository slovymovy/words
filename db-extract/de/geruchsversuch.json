                "senses": [
                    {
                        "sense_id": "40cdcee0-d35c-3175-b76a-34bcffec62e4",
                        "entry_id": "9b9a6b33-b703-3b3d-88bd-d5feb9712b41",
                        "glosses": [
                            "Handlung des Ausprobierens von Geruchsstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48362a79-9f75-415f-abb2-8adc519e84c2",
                                "sense_id": "40cdcee0-d35c-3175-b76a-34bcffec62e4",
                                "text": "„Der vor Baubeginn durchgeführte Geruchsversuch bescheinigt dem COMPOair Belüftungssystem eine Reduktion der Emissionen von bis zu 80 %!“"
                            },
                            {
                                "example_id": "efcf0aa1-ce6a-4b4e-a382-f308acd191b9",
                                "sense_id": "40cdcee0-d35c-3175-b76a-34bcffec62e4",
                                "text": "„Man startet den Geruchsversuch mit der stärksten Verdünnung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8b5d2388-0ef6-3603-a0f8-59a0b7949919",
                        "entry_id": "9b9a6b33-b703-3b3d-88bd-d5feb9712b41",
                        "glosses": [
                            "absichtliche Herbeiführung einer Geruchserscheinung/Geruchsreaktion, um Systematiken erkennen zu können: Experiment"
                        ],
                        "tags": [
                            "Wissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "d91a104e-ef8f-4b5d-bb68-eb12e2c966e4",
                                "sense_id": "8b5d2388-0ef6-3603-a0f8-59a0b7949919",
                                "text": "„Man startet den Geruchsversuch mit der stärksten Verdünnung.“"
                            },
                            {
                                "example_id": "cab80e69-db8c-49c7-a8ad-7bcb99ecf0a2",
                                "sense_id": "8b5d2388-0ef6-3603-a0f8-59a0b7949919",
                                "text": "„Das legen jedenfalls Geruchsversuche sowohl mit Mäusen als auch mit Menschen nahe: Der Haupthistokompatibilitätskomplex (MHC von engl. Major Histocompatibility Complex) umfasst eine Gruppe von Genen bei Wirbeltieren, die Proteine codieren, welche für die Immunerkennung wichtig sind.“"
                            },
                            {
                                "example_id": "c7d5b07a-0457-4084-8078-7798ec0bc3d5",
                                "sense_id": "8b5d2388-0ef6-3603-a0f8-59a0b7949919",
                                "text": "„Natürlich ist bei solchen Geruchsversuchen stets zu bedenken, wie lange die erforderliche Konzentration des künstlichen Geruches gegenüber den vorhandenen Gerüchen des natürlichen Bereiches haftet und wirksam bleibt.“"
                            },
                            {
                                "example_id": "dc6004d8-12bc-4e61-9a62-a2d77108b359",
                                "sense_id": "8b5d2388-0ef6-3603-a0f8-59a0b7949919",
                                "text": "„Das haben Geruchsversuche mit Wespen gezeigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
