                "translations": [
                    {
                        "translation_id": "acdd3084-7169-4bee-9e0a-8469a4eaed8d",
                        "source_entry_id": "9b1ad9bc-60ae-35d0-b25e-7d4f9d060a19",
                        "source_sense_id": "4f9095e2-a480-3d0b-a3a2-b342c73d1952",
                        "target_lang_word": "passionné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passionné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7639588d-54e2-33c8-bbcf-c755deb2f883",
                                        "entry_id": "718284b1-b8b0-3403-a59e-04e416a0fc6c",
                                        "glosses": [
                                            "Qui est rempli de passion, d’affection pour une personne ou pour une chose ; qui a une disposition naturelle à la passion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfc92606-f27d-49e2-9657-277806726508",
                                                "sense_id": "7639588d-54e2-33c8-bbcf-c755deb2f883",
                                                "text": "J’aime ces plis profonds et passionnés que la volupté creuse à ta face changée, quand ta chair vit en moi, quand nous ne faisons qu’un."
                                            },
                                            {
                                                "example_id": "77eea8a2-75d9-464e-bf62-33d86a4b8eab",
                                                "sense_id": "7639588d-54e2-33c8-bbcf-c755deb2f883",
                                                "text": "Amant passionné. — Il joue, il fait le passionné. — Il est passionné pour la gloire."
                                            },
                                            {
                                                "example_id": "cd1212f9-0fd8-4d8b-95b7-f6124dd03ab6",
                                                "sense_id": "7639588d-54e2-33c8-bbcf-c755deb2f883",
                                                "text": "Il parle d’un air, d’un ton passionné. — Des regards passionnés."
                                            },
                                            {
                                                "example_id": "3be2f02e-1546-4ce2-ad0c-c3c56128af5c",
                                                "sense_id": "7639588d-54e2-33c8-bbcf-c755deb2f883",
                                                "text": "C’est un homme qui a naturellement l’âme tendre et passionnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02be3571-0db8-388a-836d-aebcb2f408e1",
                                        "entry_id": "718284b1-b8b0-3403-a59e-04e416a0fc6c",
                                        "glosses": [
                                            "Qui est rempli d’une forte prévention, d’une ardeur immodérée pour ou contre quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b1b9d5-12e0-46fa-829a-e1105e350775",
                                                "sense_id": "02be3571-0db8-388a-836d-aebcb2f408e1",
                                                "text": "Fort heureusement pour moi, il n’eut pas le temps de m'expliquer plus avant tout l'intérêt qu’offrait la manière dont il eût souhaité que je conjuguasse mes verbes. Quelqu'un, en effet, venait d'arriver, interrompant dans l’œuf un développement qui risquait d'être plus passionné que passionnant."
                                            },
                                            {
                                                "example_id": "694de94f-e60a-4993-a6a9-1cb34ed08c95",
                                                "sense_id": "02be3571-0db8-388a-836d-aebcb2f408e1",
                                                "text": "Pour eux trois, sans doute, Manolete était bien en train de tauréer sur cette table ; sans doute, dix mille spectateurs passionnés s’étaient-ils assis sur les deux chaises vides à côté d’eux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "passionné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2706ff97-30a8-3b74-840a-19ec927c5a8a",
                                        "entry_id": "ee2e6538-974f-327c-bccd-a2d22ef7367c",
                                        "glosses": [
                                            "Personne réagissant habituellement avec passion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bba45efa-7eec-3538-ae45-a1d44e652fb1",
                                        "entry_id": "ee2e6538-974f-327c-bccd-a2d22ef7367c",
                                        "glosses": [
                                            "Personne ayant un goût très vif pour quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01fa342-3529-48af-bd02-aa05f226178e",
                                                "sense_id": "bba45efa-7eec-3538-ae45-a1d44e652fb1",
                                                "text": "De mon côté, comme ma fille est gourmande et que je suis un passionné de cuisine, je me suis mis à réaliser des recettes différentes à chaque repas, en adaptant des plats traditionnels à ses besoins nutritionnels."
                                            },
                                            {
                                                "example_id": "eff61605-685c-4138-8dd6-5c79c4f65292",
                                                "sense_id": "bba45efa-7eec-3538-ae45-a1d44e652fb1",
                                                "text": "Certes des initiatives se développent — […] — mais elles nécessitent encore des réseaux autres que ceux du bouche à oreille des passionnés de l’électro."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "passionné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0940626-9ce6-3662-bd86-00fad28e248c",
                                        "entry_id": "eac560d1-9928-3b1b-befe-6031d69bc33f",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe passionner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01121a87-6a29-4a73-a00e-c33346466c03",
                                                "sense_id": "e0940626-9ce6-3662-bd86-00fad28e248c",
                                                "text": "Animée par Michèle François-Guivarch, la murder party, façon « cold case », a passionné une majorité de vacanciers qui se sont disséminés sur l’exploitation en quête d’indices."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
