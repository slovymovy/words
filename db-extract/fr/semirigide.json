                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30fa8c2-1f12-45e6-b48f-dba976f15705",
                                "sense_id": "38a0ee31-facb-3ec5-8279-6468a3f3891c",
                                "text": "Panneau roulé de laine de verre semirigide, revêtu sur une face d’un papier kraft quadrillé pare-vapeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "95fb44c2-c048-3465-bca5-9279334697ff",
                        "entry_id": "0c51c1e1-854e-3ffa-9333-6a6d1ab0be4f",
                        "glosses": [
                            "Désigne un bateau qui a une coque rigide mais des flotteurs gonflables."
