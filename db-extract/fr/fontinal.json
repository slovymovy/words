                "senses": [
                    {
                        "sense_id": "aff586b2-66b3-39ff-857e-5ef5d72f9b2d",
                        "entry_id": "5bde9e20-43bc-32e9-a11e-91558692c50f",
                        "glosses": [
                            "Qui vit, qui croît dans les fontaines ou au bord de leurs bassins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1910de7-aed5-4ad3-9002-2022ac1667d9",
                                "sense_id": "aff586b2-66b3-39ff-857e-5ef5d72f9b2d",
                                "text": "Cette base fruste donnait plus de fini à l’œuvre du ciseau et permettait de faire retomber l’eau des vasques en nappes brillantes dans les récipients inférieurs, garnis de plantes fontinales."
                            },
                            {
                                "example_id": "2a419544-4ecb-41ab-9552-d29f79d98c85",
                                "sense_id": "aff586b2-66b3-39ff-857e-5ef5d72f9b2d",
                                "text": "N’ayant pas traité dans notre thèse les groupements saxicoles, fontinaux et de tourbières de pente ou bombées, ainsi que les très curieuses buttes - microtourbières bombées de la Grande Crête Nord, probablement liées à l’action du gel (étudiées, mais non publiées devant les difficultés d’interprétation, ainsi que de détermination des Sphagnum), G. Lemée (1992) le rattrapera dans une lettre à l’auteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a2e9f0e-61bc-3abb-88ea-ee70eedb9484",
                        "entry_id": "5bde9e20-43bc-32e9-a11e-91558692c50f",
                        "glosses": [
                            "Relatif à des sources."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5705914-b6f1-4d6e-ba9e-77ec9d901b0c",
                                "sense_id": "1a2e9f0e-61bc-3abb-88ea-ee70eedb9484",
                                "text": "Formations fontinales, formations dues à des sources d'eaux chaudes ou froides, qui ont déposé les substances tenues en dissolution."
                            },
                            {
                                "example_id": "5976954b-e99a-4fec-ba79-180195064587",
                                "sense_id": "1a2e9f0e-61bc-3abb-88ea-ee70eedb9484",
                                "text": "De plus, les débits sont très forts dès le début, conformes à une origine fontinale à partir des calcaires turoniens, l’eau remaniant ensuite des sables empruntés au Sidérolithique et aux sables du Périgord qui couvrent la surface."
                            }
                        ]
                    }
