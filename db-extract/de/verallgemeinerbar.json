                "senses": [
                    {
                        "sense_id": "4fb4fc54-8ea9-3393-8344-380294446fe8",
                        "entry_id": "957b3af4-8184-3d58-9cad-e4501bfbd43f",
                        "glosses": [
                            "so, dass es verallgemeinert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4836c73e-264a-40b2-8189-050ad6d1711f",
                                "sense_id": "4fb4fc54-8ea9-3393-8344-380294446fe8",
                                "text": "„Aufgrund der Studienanlage sind die Befunde nicht verallgemeinerbar.“"
                            },
                            {
                                "example_id": "ec59a30a-dec4-4335-8772-765972366e79",
                                "sense_id": "4fb4fc54-8ea9-3393-8344-380294446fe8",
                                "text": "„Die Berichte sind Beispiele und als solche nicht verallgemeinerbar.“"
                            },
                            {
                                "example_id": "c0610f28-6a7c-447d-9da8-1aa51dfac861",
                                "sense_id": "4fb4fc54-8ea9-3393-8344-380294446fe8",
                                "text": "„Da das hiesige und derzeitige Niveau der Materialnutzung weder global verallgemeinerbar noch langfristig tragfähig ist, müsste die abiotische Materialnutzung Deutschlands (einschließlich der ungenutzten Entnahmen) um bis zu 80 Prozent bis 2050 reduziert werden“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
