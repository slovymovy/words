            {
                "entry_id": "b9d82227-0df2-31f2-9cc5-db933aa84b5f",
                "word": "Guyot",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc9b8eca-291c-3492-b25d-54c5dd9b2ecc",
                        "entry_id": "b9d82227-0df2-31f2-9cc5-db933aa84b5f",
                        "glosses": [
                            "Nom de famille français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2913b3f5-3a46-41ea-ac31-ceadc97535d3",
                                "sense_id": "fc9b8eca-291c-3492-b25d-54c5dd9b2ecc",
                                "text": "M. Michel Guyot, contrôleur général de la police nationale, devient directeur de la police judiciaire de la préfecture de police, en remplacement de M. Jean Ducret, qui exerçait ces fonctions depuis mars 1974."
                            },
                            {
                                "example_id": "9ff092cf-2f6f-46bb-9603-545f08a88271",
                                "sense_id": "fc9b8eca-291c-3492-b25d-54c5dd9b2ecc",
                                "text": "Toute l’équipe a adoré le projet, explique Victor Guyot, l’un des cinq membres de l’équipe gagnante, qui se compose de Mikaël Vallenet, d’Ahmed Abouelleil-Sayed, de Maxime Prémont et de Nolann Sabre."
                            },
                            {
                                "example_id": "5185668c-b650-4ee8-b017-cf0dbc2cba03",
                                "sense_id": "fc9b8eca-291c-3492-b25d-54c5dd9b2ecc",
                                "text": "Signé par l’architecte Pierre-Henri Argouarch (cabinet a3 à Brest), « le projet promet enfin d’être particulièrement soigné sur le volet paysager », assure encore Erwan Guyot."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f345516e-3ca0-3376-90cd-c71d4872d768",
