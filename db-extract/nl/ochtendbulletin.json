                                        "sense_id": "1a8be2ca-fc82-38f5-bb09-3d418a9e4d84",
                                        "entry_id": "0e3b9dba-8fca-3478-8b9d-0e6849c70a84",
                                        "glosses": [
                                            "Bericht, in dem die Ereignisse eines Tages festgehalten sind"
                                        ],
