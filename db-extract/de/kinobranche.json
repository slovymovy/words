                        "glosses": [
                            "Geschäftszweig, der sich vor allem damit beschäftigt, Kinofilme gegen Entgelt zu zeigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2ccb34e-58bf-4ea9-a20d-ed6e50161abc",
                                "sense_id": "b48006e4-0cda-3fc6-8714-f73b5efe81cd",
                                "text": "„Der Siegeszug des Fernsehens war trotz aller Anstrengungen der Kinobranche nicht aufzuhalten: In fast jedem Haushalt war bis zum Ende des Jahrzehnts die Couchgarnitur in Richtung Flimmerkiste ausgerichtet.“"
                            },
                            {
                                "example_id": "57a578c5-b7a4-4e7c-8a8a-c93fa135bd6c",
                                "sense_id": "b48006e4-0cda-3fc6-8714-f73b5efe81cd",
                                "text": "„Im Jahr 1973 stieg Cinemaxx-Unternehmensgründer Hans-Joachim Flebbe in die Kinobranche ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
