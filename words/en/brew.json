                            {
                                "target_lang_word": "варить",
                                "target_lang_sense_clarification": "пиво или эль (несовершенный вид)"
                            },
                            {
                                "target_lang_word": "сварить",
                                "target_lang_sense_clarification": "пиво или эль (совершенный вид)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f6486c3-ac07-3dd5-9f3d-12a29a1da7e0",
                    "sense_definition": "To develop or form gradually, especially of something dangerous, unpleasant, or threatening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "develop_threat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark clouds gathered in the sky, warning that a storm was <w>brewing</w>.",
                            "target_lang_translations": {
                                "ru": "В небе сгустились тёмные тучи, предупреждая о том, что <w>назревает</w> буря."
                            }
                        },
                        {
                            "text": "Trouble was <w>brewing</w> between the two rival groups long before the argument started.",
                            "target_lang_translations": {
                                "ru": "Неприятности между двумя соперничающими группами <w>назревали</w> задолго до начала ссоры."
                            }
