                {
                    "sense_id": "75ecd7b3-b09f-3af1-b2ea-3a6be13ef4ce",
                    "sense_definition": "Выражает предложение говорящего выполнить действие самостоятельно (помощь, инициатива).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "auxiliary_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Давайте</w> я помогу вам донести сумки.",
                            "target_lang_translations": {
                                "en": "<w>Let</w> me help you carry the bags.",
                                "zh": "<w>我来</w>帮你提包吧。",
                                "nl": "<w>Laat me</w> u helpen de tassen te dragen.",
                                "pl": "<w>Pozwólcie, że</w> pomogę wam zanieść torby.",
                                "de": "<w>Soll ich</w> Ihnen helfen, die Taschen zu tragen?",
                                "fr": "<w>Laissez-moi</w> vous aider à porter les sacs.",
                                "it": "<w>Lasci che</w> l'aiuti a portare le borse.",
                                "cs": "<w>Dovolte</w>, pomůžu vám odnést tašky.",
                                "tr": "Çantaları taşımanıza <w>yardım edeyim</w>.",
                                "es": "<w>Permítame</w> ayudarle a llevar las bolsas."
                            }
                        },
                        {
                            "text": "<w>Давайте</w> я объясню это правило ещё раз.",
                            "target_lang_translations": {
                                "en": "<w>Let</w> me explain this rule one more time.",
                                "zh": "<w>我来</w>再解释一遍这条规则。",
                                "nl": "<w>Laat me</w> deze regel nog een keer uitleggen.",
                                "pl": "<w>Niech</w> wyjaśnię tę zasadę jeszcze raz.",
                                "de": "<w>Ich werde</w> diese Regel noch einmal erklären.",
                                "fr": "<w>Je vais</w> expliquer cette règle encore une fois.",
                                "it": "<w>Lasci che</w> le spieghi di nuovo questa regola.",
                                "cs": "<w>Nechte</w> mě, vysvětlím toto pravidlo ještě jednou.",
                                "tr": "Bu kuralı bir kez daha <w>açıklayayım</w>.",
                                "es": "<w>Deje que</w> le explique esta regla una vez más."
                            }
                        }
                    ],
                    "synonyms": [
                        "разрешите",
                        "позвольте",
                        "предлагаю"
                    ],
                    "common_phrases": [
                        "давайте я сделаю",
                        "давайте я сам"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses an offer by the speaker to perform an action independently (help, initiative).",
                        "zh": "表示说话人主动提出帮助或承担某项行动。",
                        "nl": "Drukt een aanbod uit van de spreker om zelfstandig een actie uit te voeren (hulp of initiatief).",
                        "pl": "Wyraża propozycję mówiącego wykonania czynności samodzielnie (oferta pomocy, inicjatywa).",
                        "de": "Drückt das Angebot des Sprechers aus, eine Handlung selbstständig auszuführen (Hilfe, Initiative).",
                        "fr": "Exprime une offre du locuteur pour effectuer une action de manière autonome (aide, initiative).",
                        "it": "Esprime un'offerta da parte del parlante di compiere un'azione autonomamente (aiuto, iniziativa).",
                        "cs": "Vyjadřuje nabídku mluvčího, že danou činnost provede sám (pomoc, iniciativa).",
                        "tr": "Konuşmacının bir eylemi kendi başına yapma teklifini (yardım, inisiyatif) ifade eder.",
                        "es": "Expresa una oferta del hablante para realizar una acción por iniciativa propia (ayuda o propuesta)."
                    },
