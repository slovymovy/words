                ],
                "senses": [
                    {
                        "sense_id": "9a39997d-73b5-36dd-a227-e91b0cc8ab5c",
                        "entry_id": "ff921ac1-8b8f-39fc-8bf2-0afa63b9ab27",
                        "glosses": [
                            "Soldat mit der Spezialausbildung des Fallschirmspringens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f34063c8-45c7-4058-9076-0959c5aa0a9f",
                                "sense_id": "9a39997d-73b5-36dd-a227-e91b0cc8ab5c",
                                "text": "Die Fallschirmjäger sprangen aus dem Flugzeug und landeten zielsicher."
                            },
                            {
                                "example_id": "831b9816-e77c-422d-8708-699ec8942560",
                                "sense_id": "9a39997d-73b5-36dd-a227-e91b0cc8ab5c",
                                "text": "„Fallschirmjäger luden Proviant aus.“"
                            },
                            {
                                "example_id": "e1fa4906-73f4-4a2f-963d-9107eb12dd69",
                                "sense_id": "9a39997d-73b5-36dd-a227-e91b0cc8ab5c",
                                "text": "„Ein Zug Fallschirmjäger kreuzte den Weg der Pilger, das sachte Klackern, wenn die herabhängenden Sturmgewehre an ihre Beine schlugen.“"
                            },
                            {
                                "example_id": "77e95cf9-12de-4ddc-955a-f10f459ae5a3",
                                "sense_id": "9a39997d-73b5-36dd-a227-e91b0cc8ab5c",
                                "text": "„Für die deutschen Fallschirmjäger, die im Sommer 1940 durch die Schönwetterwolken nach unten schwebten, müssen die Kanalinseln wie eine Gruppe saftig grüner Graspolster inmitten eines blauen Meeres ausgesehen haben.“"
                            },
                            {
                                "example_id": "c3acb2f3-f30b-4fcb-aa59-6a83a55eb8c5",
                                "sense_id": "9a39997d-73b5-36dd-a227-e91b0cc8ab5c",
                                "text": "„Jenseits des Zaunes stand ein Fallschirmjäger und pfiff ihn heran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
