                "senses": [
                    {
                        "sense_id": "4bca61b0-0942-37bb-83b7-eef47c9e3f4e",
                        "entry_id": "83286086-f7a5-3de4-82ee-484bf3354bb8",
                        "glosses": [
                            "Abschleifen der obersten Hautschichten zu therapeutischen oder kosmetischen Zwecken, meist um Narben zu entfernen"
                        ],
                        "tags": [
                            "Kosmetik"
                        ],
                        "examples": [
                            {
                                "example_id": "36008ed1-b347-48f2-a836-b103e34de9fc",
                                "sense_id": "4bca61b0-0942-37bb-83b7-eef47c9e3f4e",
                                "text": "„Paul mit seinem Riesennävus, befand der Professor damals, brauche umgehend eine Dermabrasion. Dabei wird die schwarze Haut mittels eines rotierenden Schleifsteins großflächig abgeschliffen. Das Verfahren wurde vor Jahrzehnten von Dermatologen in Kassel perfektioniert und galt lange Zeit in Deutschland als Mittel der Wahl bei der Nävusbehandlung. Dermabrasion wird oft als Technik benutzt, um Tattoos zu entfernen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
