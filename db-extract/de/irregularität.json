                ],
                "senses": [
                    {
                        "sense_id": "d5c2984c-d72b-33fb-84e2-a0b12d89afd1",
                        "entry_id": "13ed39f6-3354-3edb-b373-cc82195dac5b",
                        "glosses": [
                            "Eigenschaft/Erscheinung, keiner Norm (Regel) zu entsprechen (der Zufälligkeit unterworfen zu sein)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec073ad3-cc2a-4229-b934-76cb9297e504",
                                "sense_id": "d5c2984c-d72b-33fb-84e2-a0b12d89afd1",
                                "text": "„Nachdem wir in den vergangenen Kapiteln gezeigt haben, dass Komplexität an der Grenze zwischen periodischem, und damit regulärem Verhalten auf der einen Seite, und Zufall, d. h. Irregularität auf der anderen liegt, betrachten wir in diesem Kapitel, wieso es Systeme immer wieder in gefährliche Nähe zum Chaos treibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a8361ca5-6766-3155-ad61-b96885e7f6f9",
                        "entry_id": "13ed39f6-3354-3edb-b373-cc82195dac5b",
                        "glosses": [
                            "Eigenschaft/Erscheinung, nicht der (erwarteten) Norm (Regel) zu entsprechen (Ausnahme zu sein)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f2bfe45-8f7c-4e7e-8a50-a86bdc2bcd0b",
                                "sense_id": "a8361ca5-6766-3155-ad61-b96885e7f6f9",
                                "text": "„In den Parlamentswahlen blieb der AKFM auf drei der 107 Parlamentssitze beschränkt, wenngleich noch einmal darauf hingewiesen werden muß, daß Irregularitäten bei Wahlen zur Tradition geworden waren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "eb1ab84e-d14a-34d0-995b-a009f5b65297",
                        "entry_id": "13ed39f6-3354-3edb-b373-cc82195dac5b",
                        "glosses": [
                            "Umstand, einen Mangel/Makel zu haben, der ein Hindernis darstellt, Weihen zu empfangen oder auszuüben"
                        ],
                        "tags": [
                            "Kirche",
                            "im Sinne des katholischen Kirchenrechts"
                        ],
                        "examples": [
                            {
                                "example_id": "25c6737c-9830-4691-b974-4d50765aead9",
                                "sense_id": "eb1ab84e-d14a-34d0-995b-a009f5b65297",
                                "text": "„Der Geistliche, der an einem solchen [Bluturteil] mitwirkte, verfiel der ‚Irregularität‘; er brauchte einen Dispens, bevor er sein Amt wieder ausführen oder eine Anstellung erhalten konnte.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
