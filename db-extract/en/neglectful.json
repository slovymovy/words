                                            {
                                                "example_id": "2ad5b325-128a-4a18-b7b7-17a4af5056e0",
                                                "sense_id": "7b7cd37d-7e24-380e-8f44-73cac3030e51",
                                                "text": "Mehrere seiner Werke waren doppelt vorhanden, z. T. in ziemlich nachlässigen Abschriften."
                                            }
