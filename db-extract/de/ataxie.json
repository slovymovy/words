                ],
                "senses": [
                    {
                        "sense_id": "976f1368-ad0d-362a-a131-032b59c8e992",
                        "entry_id": "245cef14-4c70-3a00-9b8d-8af8f7fa09fe",
                        "glosses": [
                            "Störung im Bereich der Bewegungskoordination, die häufig aus Schädigungen des Kleinhirns und des Labyrinths resultiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99da84de-bb48-4491-91b3-a8ac6455e24e",
                                "sense_id": "976f1368-ad0d-362a-a131-032b59c8e992",
                                "text": "„Ich finde einen Artikel, in dem von einem Heiler in Neuseeland berichtet wird, der große Erfolge in der Behandlung von Schädelhirntraumata und daraus resultierender Bewegungsstörung erzielt hat, die man Ataxie nennt.“"
                            },
                            {
                                "example_id": "7e5835fc-84b7-48c7-9d93-dba672110df4",
                                "sense_id": "976f1368-ad0d-362a-a131-032b59c8e992",
                                "text": "„Der Frührentner leidet seit den achtziger Jahren an einer Ataxie als Folge seiner MS-Erkrankung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "818a22d4-d616-4edc-839d-8cda3aeae94b",
                        "source_entry_id": "245cef14-4c70-3a00-9b8d-8af8f7fa09fe",
                        "source_sense_id": "976f1368-ad0d-362a-a131-032b59c8e992",
                        "source_sense_description": "Medizin: Störung im Bereich der Bewegungskoordination",
                        "target_lang_word": "ataxia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ataxia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f76f96-5895-34cf-baa1-ea20bdc90d10",
                                        "entry_id": "060732d9-2e54-3f36-a626-31f6f7d704d0",
                                        "glosses": [
                                            "Lack of coordination while performing voluntary movements, which may appear to be clumsiness, inaccuracy, or instability."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb5a2096-a206-4431-8caf-d93b70fa0cb8",
                                                "sense_id": "e8f76f96-5895-34cf-baa1-ea20bdc90d10",
                                                "text": "Cerebellar dysfunction is characterized by truncal ataxia, a broad-based stance, dysmetria in which the limbs either overstep (hypermetria) or understep (hypometria), and tremor that is most pronounced when the animal attempts a goal-orientated movement (intention tremor)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c29f33a-4433-3465-9aa5-852fc85eba9c",
                                        "entry_id": "060732d9-2e54-3f36-a626-31f6f7d704d0",
                                        "glosses": [
                                            "The condition of a polymer in which the orientation of the subunits is random"
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35341fbf-4b20-3e1d-9ee9-aed5991c3093",
                                        "entry_id": "060732d9-2e54-3f36-a626-31f6f7d704d0",
                                        "glosses": [
                                            "Disorder; irregularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c47dfcb2-28aa-4171-8794-2035a22119a0",
                                                "sense_id": "35341fbf-4b20-3e1d-9ee9-aed5991c3093",
                                                "text": "1569, John Leslie, A Defence of the Honour of the Right Highe, Mightye and Noble Princesse Marie Quene of Scotlande, Rheims, Book 3,\nYe frame an other argumente of inconueniences, as thowghe vnder the womans regimente, Ataxia, that ys to saye disorder moste commonlye creapethe in."
                                            },
                                            {
                                                "example_id": "83271d86-f890-42d9-9281-f9902afd2670",
                                                "sense_id": "35341fbf-4b20-3e1d-9ee9-aed5991c3093",
                                                "text": "1614, Thomas Adams, The Devills Banket, London: Ralph Mab, The Second Service, Sermon 2, p. 51,\nLet not Gods eutaxie, Order, by our friuolous scruples be brought to ataxie, Confusion."
                                            },
                                            {
                                                "example_id": "c458041c-dc47-49d5-b743-141aa41f5021",
                                                "sense_id": "35341fbf-4b20-3e1d-9ee9-aed5991c3093",
                                                "text": "Neither is there any Ataxie to bee feared in bringing in this distinction, betwixt Pastors and flock; It is an Eutaxie rather:"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4b7ccdd-141e-4447-b4f8-fe6e49143bb5",
                        "source_entry_id": "245cef14-4c70-3a00-9b8d-8af8f7fa09fe",
                        "source_sense_id": "976f1368-ad0d-362a-a131-032b59c8e992",
                        "source_sense_description": "Medizin: Störung im Bereich der Bewegungskoordination",
                        "target_lang_word": "ataxie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ataxie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ab429a1-da19-3294-911a-dd7fe5ae34a3",
                                        "entry_id": "118f8fe2-33a7-3370-b6bf-6e5d9f48f9e7",
                                        "glosses": [
                                            "Désordre morbide des fonctions nerveuses, caractérisé surtout par le manque de coordination des mouvements volontaires."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2b1e25f-5dec-404b-97b0-7034c57de96d",
                                                "sense_id": "6ab429a1-da19-3294-911a-dd7fe5ae34a3",
                                                "text": "Il était allé piquer Lafouasse, le cabaretier, dont l’ataxie avait fait brusquement de tels progrès, qu’il le jugeait perdu."
                                            },
                                            {
                                                "example_id": "727f94ab-56d6-4d01-867e-a8a93809dfc4",
                                                "sense_id": "6ab429a1-da19-3294-911a-dd7fe5ae34a3",
                                                "text": "Élégante, verte et safran, remorquant Maugis qui traîne la jambe, déjà touché par l’ataxie, — Marthe vient vers nous."
                                            },
                                            {
                                                "example_id": "0cc57066-59cd-4ba9-a055-b4fa5e061152",
                                                "sense_id": "6ab429a1-da19-3294-911a-dd7fe5ae34a3",
                                                "text": "J’ai vu des malades sinon guéris – on guérit de tout, même de l’ataxie –, tout au moins grandement améliorés dès les premiers bains de Lamalou."
                                            },
                                            {
                                                "example_id": "d8fc47b7-b55a-4239-a89e-916fc0872729",
                                                "sense_id": "6ab429a1-da19-3294-911a-dd7fe5ae34a3",
                                                "text": "Or, si déjà arrivant à Rivebelle, j’avais jeté loin de moi ces béquilles du raisonnement, du contrôle de soi-même qui aident notre infirmité à suivre le droit chemin, et me trouvais en proie à une sorte d’ataxie morale, l’alcool, en tendant exceptionnellement mes nerfs, avait donné aux minutes actuelles une qualité, un charme, qui n’avaient pas eu pour effet de me rendre plus apte ni même plus résolu à les défendre ; car en me les faisant préférer mille fois au reste de ma vie, mon exaltation les en isolait ;"
                                            },
                                            {
                                                "example_id": "d24a3697-ebb7-4a5e-98f3-b09e9b822415",
                                                "sense_id": "6ab429a1-da19-3294-911a-dd7fe5ae34a3",
                                                "text": "Leur garçon de 3 ans, Oliver, est atteint de deux maladies graves. Il souffre non seulement de l'ataxie de Charlevoix-Saguenay, mais également d'une forme sévère d'hémophilie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
