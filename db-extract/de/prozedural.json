                    }
                ],
                "senses": [
                    {
                        "sense_id": "b41f2f80-0b23-3cc2-86af-3d3904b63874",
                        "entry_id": "5f640bce-d487-38ce-ba66-167c973365e0",
                        "glosses": [
                            "auf einen Ablauf (eine Prozedur) bezogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ef30cf-3632-4e69-ae5f-6fcf77f7be43",
                                "sense_id": "b41f2f80-0b23-3cc2-86af-3d3904b63874",
                                "text": "Im prozeduralen Gedächtnis sind zum Beispiel die Fähigkeiten und Abläufe gespeichert, die es uns ermöglichen, eine Treppe hochzugehen."
                            },
                            {
                                "example_id": "d0231fac-30d6-4bc9-a3ec-d7fd9c14d17a",
                                "sense_id": "b41f2f80-0b23-3cc2-86af-3d3904b63874",
                                "text": "„Nicht nur Bewegungen, sondern auch Gefühle und die Art und Weise, wie man sich in emotional bedeutsamen Situationen verhält, beruhen auf solchen primär prozeduralen Regeln.“"
                            },
                            {
                                "example_id": "407d0804-c2e9-480f-b209-8826d9c9715d",
                                "sense_id": "b41f2f80-0b23-3cc2-86af-3d3904b63874",
                                "text": "„Dies liegt nicht zuletzt daran, daß die Operatoren prozedural gesehen Programmtransformationen darstellen, während sie deklarativ gesehen als Zusicherung von Wahrheitswerten aufzufassen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
