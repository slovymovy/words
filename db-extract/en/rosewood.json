                    {
                        "sense_id": "92ffda6d-2156-3ffd-ab7f-b31d4a79f16e",
                        "entry_id": "1d8037d0-8253-399f-9a96-ee1a4c2f8ec0",
                        "glosses": [
                            "Rosenholz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cce09e9-f89b-4522-9fb8-3cd0c0236643",
                                "sense_id": "92ffda6d-2156-3ffd-ab7f-b31d4a79f16e",
                                "text": "Rosewood is a very expensive kind of wood.",
                                "translation": "Rosenholz ist eine sehr teure Sorte Holz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39d94a28-71ab-47bf-bfc8-dda37feaafa5",
                        "source_entry_id": "1d8037d0-8253-399f-9a96-ee1a4c2f8ec0",
                        "source_sense_id": "92ffda6d-2156-3ffd-ab7f-b31d4a79f16e",
                        "source_sense_description": "Rosenholz",
                        "target_lang_word": "Rosenholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rosenholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f3355c9-d70d-379b-8dd6-42fe4a9c72b4",
                                        "entry_id": "92dcb694-03bf-3812-89c1-f69cb11c508a",
                                        "glosses": [
                                            "duftendes, rötliches, hartes Holz, das unter anderem für Möbelstücke Verwendung findet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "841f64e0-063c-48e5-92d7-66d586b27a89",
                                                "sense_id": "8f3355c9-d70d-379b-8dd6-42fe4a9c72b4",
                                                "text": "„Andere als Rosenhölzer im Handel vorkommende Sorten zeichnen sich durch rosenartigen Geruch aus.“"
                                            },
                                            {
                                                "example_id": "792bf618-236d-47b1-9ddc-a45322b65524",
                                                "sense_id": "8f3355c9-d70d-379b-8dd6-42fe4a9c72b4",
                                                "text": "„Meine Firma sollte diese Verpflichtung umsetzen, und wir betrauten die Niederlassung der französischen Forstbehörde Office national des forêts in Guayana damit, vier Hektar Rosenholz zu pflanzen.“"
                                            },
                                            {
                                                "example_id": "326b57d3-2e61-4b15-94d2-0f27487d0873",
                                                "sense_id": "8f3355c9-d70d-379b-8dd6-42fe4a9c72b4",
                                                "text": "„Ein aromatisches Keton verleiht dem Rosenholz den zarten, lilienartigen Duft – der auch ein wenig an Mimose und Weißdorn erinnert – und einen Hauch von Sinnlichkeit.“"
                                            },
                                            {
                                                "example_id": "34cecdc9-3323-4041-b062-6e00df64e077",
                                                "sense_id": "8f3355c9-d70d-379b-8dd6-42fe4a9c72b4",
                                                "text": "„Für arabeske Luxusbetten aus madagassischem Rosenholz gibt in China mancher schon bis zu einer Million Dollar aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
