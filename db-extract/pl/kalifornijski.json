                                                "example_id": "eb6fc1ee-63f4-49a0-9dbe-522b504cc497",
                                                "sense_id": "6a304c6f-3630-3f9f-9340-f2714359c7a1",
                                                "text": "In fact, it's often somewhat disparagingly called \"Boz Angeles\" for the many Californians and celebrities that have come to town, as well as its perceived \"fanciness\" in relation to the rest of the state."
                                            }
                                        ]
                                    }
