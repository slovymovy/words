                ],
                "senses": [
                    {
                        "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                        "entry_id": "0ab71a7f-8f8f-38d0-a8af-3557499701c6",
                        "glosses": [
                            "ganzes zusammenhängendes Gebilde als Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c39334-4c19-4142-9357-e089538b1f11",
                                "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                                "text": "„Ich verbiege mich da nicht - das Gesamtgefüge muss stimmen.“"
                            },
                            {
                                "example_id": "eda8d5a4-4360-4bab-8326-22beda86c36a",
                                "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                                "text": "„Der Papst behielt als Einziger den Überblick über das Gesamtgefüge.“"
                            },
                            {
                                "example_id": "0641bb8e-4052-494b-abb4-d87e79041f0e",
                                "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                                "text": "„Allerdings muss man diese Frage in das durchaus komplexe Gesamtgefüge einordnen.“"
                            },
                            {
                                "example_id": "0b3d7752-48d1-4d13-9be0-e6bd6b391bea",
                                "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                                "text": "„Doch unter großer Kraftanstrengung gerade der Grünen und des Ministerpräsidenten Reiner Haseloff hat das Gesamtgefüge gehalten.“"
                            },
                            {
                                "example_id": "cbc069f6-67df-45e8-9db7-f0d44c04fe75",
                                "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                                "text": "„Die Fähigkeiten dieser Mannschaft mit ihrem fragilen Gesamtgefüge reichen bei weitem nicht aus, um dem Spielplan von Headcoach Herbert annähernd gerecht werden zu können, vor allem nicht im Vergleich mit einem Spitzenklub.“"
                            },
                            {
                                "example_id": "34c3dcf1-2529-477c-aeae-e713e904da51",
                                "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                                "text": "„‚Dieser Fleischskandal und die vorhergehenden Skandale zeigen, daß das Gesamtgefüge der bayerischen Lebensmittelüberwachung nicht stimmt‘, sagte der SPD-Landtagsabgeordnete Ludwig Wörner.“"
                            },
                            {
                                "example_id": "ace9d56e-25be-4e36-9244-9286e34d8ca4",
                                "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                                "text": "„Doch weil bei der Eintracht das Gesamtgefüge stimmt, darf sich die Mannschaft von Trainer Adi Hütter weiterhin große Hoffnungen machen, vielleicht doch noch den größten Wurf der Vereinsgeschichte zu landen.“"
                            },
                            {
                                "example_id": "420a4fc6-7997-4730-8f0f-ef77ca201277",
                                "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                                "text": "„Dass in solchen Verhältnissen nicht nur das gesellschaftliche Gesamtgefüge erodiert, sondern auch die Zurichtung des Einzelnen immer entschiedenere Züge annimmt, ist nun keine neue These.“"
                            },
                            {
                                "example_id": "c63584e8-1519-4167-b332-8e3069ab727a",
                                "sense_id": "2e58a38c-4547-3742-a770-da4738d2a882",
                                "text": "„Befremdlich wirkt im Hinblick auf das Gesamtgefüge des Albums das mit der R&B-Sängerin Rihanna aufgenommene ‚Princess of China‘, das offenbar einer der Höhepunkte des Albums sein sollte - hatte Martin sich doch gerade diese Zusammenarbeit ausdrücklich gewünscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
