{
    "word_family": [
        "offshore",
        "onshore",
        "shoreline"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b05499b-0bcd-3383-aade-793c74d74f30",
                    "sense_definition": "Situated or occurring close to the shore.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small fishing boat navigated through the <w>inshore</w> waters. ",
                            "target_lang_translations": {
                                "tr": "Küçük balıkçı teknesi <w>kıyıya yakın</w> sularda seyretti."
                            }
                        },
                        {
                            "text": "Local fishermen prefer <w>inshore</w> fishing because it is safer during winter. ",
                            "target_lang_translations": {
                                "tr": "Yerel balıkçılar, kışın daha güvenli olduğu için <w>kıyı</w> balıkçılığını tercih ederler."
                            }
                        }
                    ],
                    "synonyms": [
                        "coastal",
                        "nearshore"
                    ],
                    "antonyms": [
                        "offshore"
                    ],
                    "common_phrases": [
                        "inshore waters",
                        "inshore fishing",
                        "inshore breeze"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kıyıya yakın yer alan veya meydana gelen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kıyıya yakın",
                                "target_lang_sense_clarification": "kıyı alanlarında bulunan"
                            },
                            {
                                "target_lang_word": "kıyı",
                                "target_lang_sense_clarification": "kıyı şeridinde yer alan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6c768d2-6c14-32a4-a89c-ba37a497df2b",
                    "sense_definition": "Blowing from the sea towards the land.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An <w>inshore</w> wind brought cool air to the beach. ",
                            "target_lang_translations": {
                                "tr": "<w>Karaya doğru esen</w> bir rüzgar plaja serin hava getirdi."
                            }
                        },
                        {
                            "text": "The <w>inshore</w> breeze helped push the sailboat back toward the coast. ",
                            "target_lang_translations": {
                                "tr": "<w>Kıyıya doğru esen</w> esinti, yelkenlinin kıyıya geri itilmesine yardımcı oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "onshore"
                    ],
                    "antonyms": [
                        "offshore"
                    ],
                    "common_phrases": [
                        "inshore wind",
                        "inshore breeze"
                    ],
                    "target_lang_definitions": {
                        "tr": "Denizden karaya doğru esen (rüzgar)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karaya doğru esen",
                                "target_lang_sense_clarification": "denizden karaya yönelen rüzgar"
                            },
                            {
                                "target_lang_word": "kıyıya doğru esen",
                                "target_lang_sense_clarification": "kıyı yönüne esen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7f4cd54b-deb6-3f46-b2ea-fb1146702667",
                    "sense_definition": "At or in a position close to the shore.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several sea birds were feeding <w>inshore</w> near the docks. ",
                            "target_lang_translations": {
                                "tr": "Birkaç deniz kuşu limanın yakınında, <w>kıyıya yakın</w> yerlerde besleniyordu."
                            }
                        },
                        {
                            "text": "We anchored the small boat <w>inshore</w> where the sea was calm. ",
                            "target_lang_translations": {
                                "tr": "Küçük tekneyi denizin durgun olduğu yerde, <w>kıyıya yakın</w> demirledik."
                            }
                        }
                    ],
                    "synonyms": [
                        "nearshore"
                    ],
                    "antonyms": [
                        "offshore"
                    ],
                    "common_phrases": [
                        "anchored inshore",
                        "located inshore"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kıyıya yakın bir konumda veya yerde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kıyıya yakın",
                                "target_lang_sense_clarification": "sahile yakın konumda"
                            },
                            {
                                "target_lang_word": "kıyıda",
                                "target_lang_sense_clarification": "kıyı bölgesinde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83cbb3fc-ba88-34fd-8a89-863bfb8eb9bf",
                    "sense_definition": "Moving or directed towards the shore.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tide began to move <w>inshore</w> early in the afternoon. ",
                            "target_lang_translations": {
                                "tr": "Öğleden sonra erken saatlerde gelgit <w>kıyıya doğru</w> ilerlemeye başladı."
                            }
                        },
                        {
                            "text": "Many species of fish travel <w>inshore</w> to feed during the night. ",
                            "target_lang_translations": {
                                "tr": "Birçok balık türü gece boyunca beslenmek için <w>kıyıya doğru</w> göç eder."
                            }
                        }
                    ],
                    "synonyms": [
                        "landward"
                    ],
                    "antonyms": [
                        "offshore",
                        "seaward"
                    ],
                    "common_phrases": [
                        "move inshore",
                        "travel inshore"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kıyıya doğru hareket eden veya yönelen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kıyıya doğru",
                                "target_lang_sense_clarification": "sahil yönüne doğru hareket ederek"
                            },
                            {
                                "target_lang_word": "karaya doğru",
                                "target_lang_sense_clarification": "denizden karaya yönelerek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}