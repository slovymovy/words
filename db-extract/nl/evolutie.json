                ],
                "translations": [
                    {
                        "translation_id": "047c2b6b-5011-4def-99b1-73772baad828",
                        "source_entry_id": "b1cf4d00-19d1-33b7-b48f-dd342f12e05e",
                        "source_sense_id": "35ab202b-60cb-3cc5-86b1-3f49270664bd",
                        "source_sense_description": "ontwikkeling, verandering",
                        "target_lang_word": "Evolution",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Evolution",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "489f99d5-b5d2-3380-8195-0cd0ecca65f0",
                                        "entry_id": "a6a082d4-0992-3f74-864e-c48f716a74e8",
                                        "glosses": [
                                            "eine im Gegensatz zur Revolution langsam und friedlich fortschreitende Entwicklung im Geschichtsablauf oder in anderen Abläufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de97fbd4-e6c2-4d33-896c-e6ad100ca121",
                                                "sense_id": "489f99d5-b5d2-3380-8195-0cd0ecca65f0",
                                                "text": "Seit der Französischen Revolution gilt \"Evolution\" als Begriff für eine langsam voranschreitende Entwicklung der begriffliche Gegensatz zu Revolution, eben einer schnellen politisch-kulturellen Umwälzung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e725c119-a7f8-3560-9045-49d7cfb7938a",
                                        "entry_id": "a6a082d4-0992-3f74-864e-c48f716a74e8",
                                        "glosses": [
                                            "die Entwicklung zu (meist) höher integrierten, komplexeren Formen im physikalisch-chemischen (Entwicklung des Weltalls und der Erde), im biologischen (Entwicklung der Lebewesen) und im kulturellen Bereich (Entwicklung der Kulturen)"
                                        ],
                                        "tags": [
                                            "Naturgeschichte",
                                            "und",
                                            "Kulturgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d16bd03-9c52-4169-82cb-1aeb255f05c9",
                                                "sense_id": "e725c119-a7f8-3560-9045-49d7cfb7938a",
                                                "text": "„Evolution ist der kosmische Gesamt-Prozeß, der immer wieder zuvor unabhängig existierende Bausteine zu Ganzheiten höherer Komplexität zusammenfaßt. Drei aufeinanderfolgende Phasen der Evolution sind dabei erkennbar: die materielle, die biologische und die intellektuelle Phase (Hylo-, Bio- und Noosphäre). Die von Biologen meist unter dem Begriff Evolution verstandene Stammesentwicklung der Pflanzen- und Tier-Arten im Laufe der Erdgeschichte ist nur ein Teilabschnitt des Gesamtprozesses von Komplexitätswachstum.“"
                                            },
                                            {
                                                "example_id": "57b64f4e-08a2-4735-a186-c1e45d82a4f6",
                                                "sense_id": "e725c119-a7f8-3560-9045-49d7cfb7938a",
                                                "text": "„Die Evolution kommt auch ohne mich zurecht.“"
                                            },
                                            {
                                                "example_id": "f615affd-d1ea-419b-8175-e336ba48dbc3",
                                                "sense_id": "e725c119-a7f8-3560-9045-49d7cfb7938a",
                                                "text": "„Sprache unterliegt wie alles andere im Universum der Evolution.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0675c67c-325e-3235-a12b-d3f0c7ffae2f",
                                        "entry_id": "a6a082d4-0992-3f74-864e-c48f716a74e8",
                                        "glosses": [
                                            "ein Prozess, bei dem durch Reproduktion oder Replikation von einem System Kopien hergestellt werden, die sich voneinander und von ihrem Ursprungssystem durch Variation unterscheiden und bei dem nur ein Teil dieser Kopien auf Grund von Selektion für einen weiteren Kopiervorgang zugelassen werden"
                                        ],
                                        "tags": [
                                            "Systemtheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8627860c-b906-45ec-b618-b60a183d7701",
                                                "sense_id": "0675c67c-325e-3235-a12b-d3f0c7ffae2f",
                                                "text": "„Evolution […] ist in der Systemtheorie ein Prozess, bei dem durch Reproduktion oder Replikation von einem System Kopien hergestellt werden, die sich voneinander und von ihrem Ursprungssystem durch Variation unterscheiden und bei dem nur ein Teil dieser Kopien auf Grund von Selektion für einen weiteren Kopiervorgang zugelassen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "caf4af7c-fe40-38b7-8307-4c39eef2eb17",
                                        "entry_id": "a6a082d4-0992-3f74-864e-c48f716a74e8",
                                        "glosses": [
                                            "eine Abbildung, welche zu einem Anfangswert die (zeitliche) Entwicklung angibt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13639546-4d17-4e1a-9515-dd946895403f",
                                                "sense_id": "caf4af7c-fe40-38b7-8307-4c39eef2eb17",
                                                "text": "Das Phasenvolumen bleibt unter der Evolution (der Funktion) konstant (Satz von Liouville)"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f32ce31e-e308-4889-9981-d954a723adc2",
                        "source_entry_id": "b1cf4d00-19d1-33b7-b48f-dd342f12e05e",
                        "source_sense_id": "35ab202b-60cb-3cc5-86b1-3f49270664bd",
                        "source_sense_description": "ontwikkeling, verandering",
                        "target_lang_word": "evolution",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evolution",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad9b2b25-78b1-328a-8559-b540221fabe8",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "A change of position.",
                                            "A manoeuvre of troops or ships."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc9a0d80-036a-44b3-8c51-188d45dc059a",
                                                "sense_id": "ad9b2b25-78b1-328a-8559-b540221fabe8",
                                                "text": "Mean while, he never failed to be present, when any regiment, or corps of men, were drawn out to be exercised and reviewed, and accompanied them in all their evolutions […]."
                                            },
                                            {
                                                "example_id": "af192240-be2b-41e9-86da-781bb7768440",
                                                "sense_id": "ad9b2b25-78b1-328a-8559-b540221fabe8",
                                                "text": "Major Holroyd, who acted as the General, was extremely polite, and attentive, and came to us between every evolution, to explain and talk over the manoeuvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "954bfecd-3bde-3f4b-8952-b9728d973634",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "A change of position.",
                                            "A turning movement, especially of the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd3e5a25-289a-4a51-a901-18375d176a01",
                                                "sense_id": "954bfecd-3bde-3f4b-8952-b9728d973634",
                                                "text": "Our necromancer […] taking up his wand, waved it around his head in a very mysterious motion, with a view of intimidating these forward visitants, who, far from being awed by this sort of evolution, became more and more obstreperous […]."
                                            },
                                            {
                                                "example_id": "ff1df3ef-9e6f-4622-bcdc-e0a8f92faafd",
                                                "sense_id": "954bfecd-3bde-3f4b-8952-b9728d973634",
                                                "text": "It was a critical instant: the pirouette -- it would fail, she feared. … the rapid whirl achieved in exact time, the whole evolution executed to perfection."
                                            },
                                            {
                                                "example_id": "5feef47a-ff68-49b5-afa7-11cc6a0f62f3",
                                                "sense_id": "954bfecd-3bde-3f4b-8952-b9728d973634",
                                                "text": "… as he beheld the tenfold pirouette of a lovely girl, which presented to the public eye the whole of her form and figure; … to praise the dexterity and ease with which the unfortunate and degraded creature had performed the ungraceful evolution, the only merit of which, is the gross exposition of person, at which modesty shudders […]"
                                            },
                                            {
                                                "example_id": "0b0168d4-2646-49a1-bf99-413e586f121c",
                                                "sense_id": "954bfecd-3bde-3f4b-8952-b9728d973634",
                                                "text": "\"Look now, that pirouette -- my stars! how Beauchamp would stare to see his darling perform such an evolution!\""
                                            },
                                            {
                                                "example_id": "929c0d8a-0c0f-4274-87f8-faf544d871ce",
                                                "sense_id": "954bfecd-3bde-3f4b-8952-b9728d973634",
                                                "text": "By this operation each foot will describe an arc or segment of a circle. … This evolution is performed sometimes on one foot, sometimes on the other …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c745ad4a-9c83-3363-8ace-2ad0fc22b87f",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "A change of position.",
                                            "A turned or twisted shape; an involution, a complex or intricate shape."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ce5b328-b16a-4ed4-93ab-7c977f7c3546",
                                                "sense_id": "c745ad4a-9c83-3363-8ace-2ad0fc22b87f",
                                                "text": "‘It is not in the showy evolutions of buildings, but in the multiplicity of human habitations which are crouded together, that the wonderful immensity of London consists.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49a08f28-9a37-3fca-bff1-8ccc72b6f003",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "An unfolding.",
                                            "The act or process of unfolding or opening out; the progression of events in regular succession."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8321ae01-a4e1-4138-a463-c684d03a8d9b",
                                                "sense_id": "49a08f28-9a37-3fca-bff1-8ccc72b6f003",
                                                "text": "The world […] might have been gradually produced from very small beginnings […] rather than by a sudden evolution of the whole by the Almighty fiat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22ad46f2-c7ed-3471-93ca-82e35ed566d8",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "An unfolding.",
                                            "The opening out of a curve; now more generally, the gradual transformation of a curve by a change of the conditions generating it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfb8fe14-a0f2-36eb-aae4-3602b55dbcd4",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "An unfolding.",
                                            "The extraction of a root from a given power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "808c4115-a4c4-374e-af36-5f80933042b7",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "An unfolding.",
                                            "The act or an instance of giving off gas; emission."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0d8ac74-20f4-3ecb-9b06-49d545d07415",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "Process of development.",
                                            "Development; the act or result of developing what was implicit in an idea, argument etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2304c83-cd10-4b66-99a0-0ec1905c87d9",
                                                "sense_id": "e0d8ac74-20f4-3ecb-9b06-49d545d07415",
                                                "text": "The ongoing evolution of Lolita subculture fashion includes, among other things, the ballet style."
                                            },
                                            {
                                                "example_id": "ef5b50cc-d7db-4acf-a8ee-2fc2344b68e5",
                                                "sense_id": "e0d8ac74-20f4-3ecb-9b06-49d545d07415",
                                                "text": "Suffering has a noble purpose: the evolution of consciousness and the burning up of the ego."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b456efb8-f2d5-3d6b-b849-01d96a8175d8",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "Process of development.",
                                            "A process of gradual change in a given system, subject, product etc., especially from simpler to more complex forms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a4f6dee-c83f-46f5-957c-6704faa6ecb7",
                                                "sense_id": "b456efb8-f2d5-3d6b-b849-01d96a8175d8",
                                                "text": "Among other forms of change, the evolution of transportation has involved modification, diversification, convergence, divergence, hybridization, differentiation, and naturally, selection."
                                            },
                                            {
                                                "example_id": "ee3fd54e-af80-4c40-a307-2a0adc1495fa",
                                                "sense_id": "b456efb8-f2d5-3d6b-b849-01d96a8175d8",
                                                "text": "By some paradoxical evolution rancour and intolerance have been established in the vanguard of primitive Christianity. Mrs. Spoker, in common with many of the stricter disciples of righteousness, was as inclement in demeanour as she was cadaverous in aspect."
                                            },
                                            {
                                                "example_id": "1612922c-7ec0-45b4-9857-e4e28ed086bc",
                                                "sense_id": "b456efb8-f2d5-3d6b-b849-01d96a8175d8",
                                                "text": "There are some examples of cultural evolution in birds and monkeys, but […] it is our own species that really shows what cultural evolution can do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78007393-428d-3522-8d46-72b64682fb14",
                                        "entry_id": "f708ea22-009e-379a-9775-ace6b9eda00f",
                                        "glosses": [
                                            "Process of development.",
                                            "The transformation of animals, plants and other living things into different forms (now understood as a change in genetic composition) by the accumulation of changes over successive generations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7420cc7-ccea-41a2-a3a2-dcc58c2f73e3",
                                                "sense_id": "78007393-428d-3522-8d46-72b64682fb14",
                                                "text": "[…]and thus he [Lamarck] was inclined to assert the priority of the types of marine animals to those of the terrestrial, and to fancy, for example, that the testacea of the ocean existed first, until some of them, by gradual evolution, were improved into those inhabiting the land."
                                            },
                                            {
                                                "example_id": "61ac76d1-e410-45d8-b5b1-0f3b243d72c2",
                                                "sense_id": "78007393-428d-3522-8d46-72b64682fb14",
                                                "text": "[Some books have] made the erroneous assumption that the important thing in evolution is the good of the species (or the group) rather than the good of the individual (or the gene)."
                                            },
                                            {
                                                "example_id": "3327c598-c66f-4e08-b8e5-30e0b990df6c",
                                                "sense_id": "78007393-428d-3522-8d46-72b64682fb14",
                                                "text": "Many genes with reproductive roles also have antibacterial and immune functions, which indicate that the threat of microbial attack on the sperm or egg may be a major influence on rapid evolution during reproduction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8be02be8-f93f-427c-ba20-30b50075e267",
                        "source_entry_id": "b1cf4d00-19d1-33b7-b48f-dd342f12e05e",
                        "source_sense_id": "35ab202b-60cb-3cc5-86b1-3f49270664bd",
                        "source_sense_description": "ontwikkeling, verandering",
                        "target_lang_word": "évolution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évolution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf6751a-b5c4-343f-8334-19502515703d",
                                        "entry_id": "4de522ec-fb50-34fd-b1f2-5cfe107fcb28",
                                        "glosses": [
                                            "Changement progressif ou graduel d'un être, d'une chose, d'un phénomène ou d'un système."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c4646b-2e33-4ff6-8df5-c73b1605077d",
                                                "sense_id": "ebf6751a-b5c4-343f-8334-19502515703d",
                                                "text": "Oh ! le participe, présent et passé, voilà un trésor ! En sentez-vous bien, au moins, toutes les beautés ? Avez-vous mesuré le rôle qu’elles jouent et la place qu’elles tiennent dans cette savante évolution de notre idiome national ?"
                                            },
                                            {
                                                "example_id": "8590c102-d2ac-4c8a-aeda-fc29d0c91a86",
                                                "sense_id": "ebf6751a-b5c4-343f-8334-19502515703d",
                                                "text": "La méthode récente des analyses polliniques a permis d’avoir une opinion sur l’évolution de la végétation au voisinage de nombreuses tourbières d’Europe : […]."
                                            },
                                            {
                                                "example_id": "820b83ee-f6ff-4147-ba1e-906f42b27d01",
                                                "sense_id": "ebf6751a-b5c4-343f-8334-19502515703d",
                                                "text": "Les sols formés sur la craie, par contre, ont peu retenu l'attention des pédologues. Ces sols sont considérés comme des exemples de rendzine vraie, où aucune évolution n'est possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b537ad-3181-3b46-8ad1-3cdc5af80d80",
                                        "entry_id": "4de522ec-fb50-34fd-b1f2-5cfe107fcb28",
                                        "glosses": [
                                            "Changements d’idées ou de conduite des personnes ou des collectivités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03edad9c-396d-4b75-9be3-5d454be5442b",
                                                "sense_id": "72b537ad-3181-3b46-8ad1-3cdc5af80d80",
                                                "text": "[…] ; le jour où ils ont suffisamment pénétré dans les sanctuaires de l’État, dans les salons, dans les lieux de plaisir, ils cessent généralement d’être révolutionnaires et parlent savamment de l’évolution."
                                            },
                                            {
                                                "example_id": "b7987dda-ae07-4d08-82ab-293580b646b4",
                                                "sense_id": "72b537ad-3181-3b46-8ad1-3cdc5af80d80",
                                                "text": "Les comptes nationaux sont une construction sociale, en perpétuelle évolution, reflétant toujours les préoccupations d’une époque. Les chiffres qui en sont issus ne doivent pas être fétichisés."
                                            },
                                            {
                                                "example_id": "698e7221-c347-4eb1-aa29-d361b33dae07",
                                                "sense_id": "72b537ad-3181-3b46-8ad1-3cdc5af80d80",
                                                "text": "L’évolution politique de cet homme a été rapide. — Il a fait faire à son parti une complète évolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f713e05-7fac-3884-8f71-70599a748b69",
                                        "entry_id": "4de522ec-fb50-34fd-b1f2-5cfe107fcb28",
                                        "glosses": [
                                            "Processus par lequel, au fil des générations, les caractères héréditaires des populations changent sous l’effet de mécanismes tels que la sélection naturelle, la dérive génétique, la mutation ou le flux de gènes. Ces changements peuvent conduire à l’adaptation, à la diversification, à la simplification ou à la disparition d’espèces."
                                        ],
                                        "tags": [
                                            "Sciences de la vie",
                                            "Biologie évolutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a2755fc-1624-4c9a-a0b7-8a4389583943",
                                                "sense_id": "4f713e05-7fac-3884-8f71-70599a748b69",
                                                "text": "René Jeannel est un cas de lamarckiste finaliste, partisan d’une thèse orthogénétique de l’évolution, par laquelle les organes se compliquent de plus en plus : les spécialisations progressives, par ajustement de plus en plus fin aux conditions de milieu, deviennent héréditaires […]."
                                            },
                                            {
                                                "example_id": "f27a6895-ba71-4771-8e78-cfee0861d5a9",
                                                "sense_id": "4f713e05-7fac-3884-8f71-70599a748b69",
                                                "text": "Si un animal plus modeste qu’une éponge se classait avec des animaux dotés d’un système nerveux, sa simplicité n’était sans doute pas ancestrale, mais résultait d’une évolution régressive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0f12176-7a9f-3461-b8ed-a63c5e9f765d",
                                        "entry_id": "4de522ec-fb50-34fd-b1f2-5cfe107fcb28",
                                        "glosses": [
                                            "Mouvement que font des troupes pour prendre une nouvelle disposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab97e93d-26df-408a-bd65-a5dd2458a730",
                                                "sense_id": "b0f12176-7a9f-3461-b8ed-a63c5e9f765d",
                                                "text": "Le public suivait avec intérêt les évolutions des avions."
                                            },
                                            {
                                                "example_id": "9fae0495-7cc7-434d-af85-6eba1270ee82",
                                                "sense_id": "b0f12176-7a9f-3461-b8ed-a63c5e9f765d",
                                                "text": "Il faut faire exécuter des évolutions à nos régiments d’infanterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4cacc96-c107-3222-bfce-e1163e744b9a",
                                        "entry_id": "4de522ec-fb50-34fd-b1f2-5cfe107fcb28",
                                        "glosses": [
                                            "Tout mouvement de personnes, de choses ou d’animaux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "657c5a2e-993a-438b-8e87-3a9573b36e31",
                                                "sense_id": "b4cacc96-c107-3222-bfce-e1163e744b9a",
                                                "text": "Dans la baie de Panama, j’avais été environné de nombreuses baleines (probablement baleœopteris musculus) et j’avais pu filmer leurs évolutions."
                                            },
                                            {
                                                "example_id": "d6331805-bfac-478b-a6a9-0b484bef5bc6",
                                                "sense_id": "b4cacc96-c107-3222-bfce-e1163e744b9a",
                                                "text": "Après une demi-heure d’évolutions, le valet était parvenu, sans exciter aucun soupçon, à s’isoler dans un couloir où Marion, qui le suivait comme une ombre, le rejoignit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f0980d1-131c-3efb-8b0e-9476bcf993cd",
                                        "entry_id": "4de522ec-fb50-34fd-b1f2-5cfe107fcb28",
                                        "glosses": [
                                            "Développement successif, intérieur et spontané de l’être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c93d3f6-3542-4804-b276-fa984cf61fc3",
                                                "sense_id": "7f0980d1-131c-3efb-8b0e-9476bcf993cd",
                                                "text": "Doctrine de l’évolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "739c314f-b89c-3bc5-8d93-292ede216162",
                                        "entry_id": "4de522ec-fb50-34fd-b1f2-5cfe107fcb28",
                                        "glosses": [
                                            "Modification du cours d’une maladie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0e98f43-a75b-3ef0-bce6-3a78858050bb",
                                        "entry_id": "4de522ec-fb50-34fd-b1f2-5cfe107fcb28",
                                        "glosses": [
                                            "Action de sortir en se déroulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a02614b-a74b-49ac-99e1-4a3947740923",
                                                "sense_id": "a0e98f43-a75b-3ef0-bce6-3a78858050bb",
                                                "text": "L’évolution des feuilles hors des bourgeons est parfois surprenante de beauté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
