                "senses": [
                    {
                        "sense_id": "34976af7-de66-3d5a-9a49-f4984b5051a3",
                        "entry_id": "430b7748-22b6-3102-a8e8-e884e78af3c4",
                        "glosses": [
                            "That contains people who together represent multiple ethnicities, especially such that they coexist and interact harmoniously."
                        ],
                        "tags": [
                            "of a group or society"
                        ],
                        "examples": [
                            {
                                "example_id": "538b4cb9-1267-43c0-bded-1c7cbdeaa0df",
                                "sense_id": "34976af7-de66-3d5a-9a49-f4984b5051a3",
                                "text": "In the last 20 years, the sharp increase in immigration has brought \"new faces in the crowd\" and a much more polyethnic and multicultural country."
                            },
                            {
                                "example_id": "ab9a8e2a-87a8-4fd7-aa92-3144ee859dcc",
                                "sense_id": "34976af7-de66-3d5a-9a49-f4984b5051a3",
                                "text": "In some European states, however, the reverse applies and the rights of national minorities (in Belgium and Switzerland, for example) have long been recognised but an accommodation of immigrants and a more polyethnic society has been far less forthcoming."
                            },
                            {
                                "example_id": "fc9d054c-d275-464c-a857-5928498ec43f",
                                "sense_id": "34976af7-de66-3d5a-9a49-f4984b5051a3",
                                "text": "And thus it is a very good bet that those societies that are becoming more and more polyethnic will experience increasing ethnic conflict. In fact, it is happening already."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe0852bc-e4d4-38b5-9358-fd5dd5175d93",
                        "entry_id": "430b7748-22b6-3102-a8e8-e884e78af3c4",
                        "glosses": [
                            "Who identifies as being of multiple ethnicities."
                        ],
