                                    {
                                        "sense_id": "f73f6c43-5a58-39b9-910a-3de0489dfb9c",
                                        "entry_id": "3036e045-6515-397b-8eae-76872910b8bc",
                                        "glosses": [
                                            "Projet ou idée utopique, idéaliste et irréalisable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c15f64ef-9fe9-42f5-8897-e40a385c079e",
                                                "sense_id": "f73f6c43-5a58-39b9-910a-3de0489dfb9c",
                                                "text": "Lenny Kravitz est un hippie magicien. Hippie, parce que ses disques sont toujours empreint d’un certain utopisme et pacifisme, et cela dès son premier album à la fin des années 80, Let Love Rule."
                                            },
                                            {
                                                "example_id": "8b9b9340-9519-4d86-a260-4649ba0d7c4c",
                                                "sense_id": "f73f6c43-5a58-39b9-910a-3de0489dfb9c",
                                                "text": "L’utopisme naît nécessairement de l’ignorance sociale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e536b46f-568e-4c8c-a609-bcfc0a4c9a80",
                        "source_entry_id": "31acb1ce-b173-3ba9-b6d8-00199de0a26c",
                        "source_sense_id": "a18eb02e-77f3-358d-97e7-3f7c06aca441",
