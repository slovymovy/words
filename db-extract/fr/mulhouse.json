        "fr-extract.jsonl": [
            {
                "entry_id": "58ff34d7-a1d1-39c0-86fa-36e712c7ca56",
                "word": "Mulhouse",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2b27810-10e0-3372-9e1c-a7408cccace7",
                        "entry_id": "58ff34d7-a1d1-39c0-86fa-36e712c7ca56",
                        "glosses": [
                            "Commune française, située dans le département du Haut-Rhin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44b5874d-58c8-4c2f-8ed0-231712dc13a5",
                                "sense_id": "a2b27810-10e0-3372-9e1c-a7408cccace7",
                                "text": "Sa seule course à Verrières fut causée par l’envie d’acheter de nouvelles robes d’été qu’on venait d’apporter de Mulhouse."
                            },
                            {
                                "example_id": "118b9ddc-fecd-43e2-9a8d-7fd259a4bab1",
                                "sense_id": "a2b27810-10e0-3372-9e1c-a7408cccace7",
                                "text": "Les produits viennent surtout naturellement des grandes régions de l’industrie textile : Mulhouse pour les tissus de coton et la mercerie, le Nord pour les lainages, Troyes pour la bonneterie."
                            },
                            {
                                "example_id": "a771fad9-cba3-4d68-bd62-3ca9e928d77c",
                                "sense_id": "a2b27810-10e0-3372-9e1c-a7408cccace7",
                                "text": "Les deux vagues d’industrialisation de Mulhouse provoquent l’hyper-densification de la ville historique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caea8f79-6e96-43e6-acef-d6a2b772f45c",
                        "source_entry_id": "58ff34d7-a1d1-39c0-86fa-36e712c7ca56",
                        "source_sense_id": "a2b27810-10e0-3372-9e1c-a7408cccace7",
                        "target_lang_word": "Mülhausen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mülhausen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43c30dfa-0d3c-35a0-adb1-f0c01f088de3",
                                        "entry_id": "eeeb67a3-377a-3b85-917e-467793847c18",
                                        "glosses": [
                                            "französische Stadt im Oberelsass"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8661d161-7a20-4761-a842-8204cf7e9fb2",
                                                "sense_id": "43c30dfa-0d3c-35a0-adb1-f0c01f088de3",
                                                "text": "Von 1870 bis 1919 gehörte Mülhausen zu Deutschland respektive dem Deutschen Kaiserreich."
                                            },
                                            {
                                                "example_id": "8b57d045-71f3-426f-91a8-a2fa265f3697",
                                                "sense_id": "43c30dfa-0d3c-35a0-adb1-f0c01f088de3",
                                                "text": "Durch die deutsche Besetzung Frankreichs im zweiten Weltkrieg gehörte Mühlhausen für wenige Jahre wieder zu Deutschland."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
