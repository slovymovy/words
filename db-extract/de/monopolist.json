                "senses": [
                    {
                        "sense_id": "0c06031f-f350-3aeb-a766-0bd5a3bed09c",
                        "entry_id": "a59fd27e-9a9f-358b-b267-28852a7a6cb8",
                        "glosses": [
                            "Inhaber eines Monopols (Person oder Unternehmen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31730b06-8da5-44fb-8a1b-1b26115b0e52",
                                "sense_id": "0c06031f-f350-3aeb-a766-0bd5a3bed09c",
                                "text": "Durch seine marktbeherrschende Stellung ist er zum Monopolisten geworden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7d1b0e2f-4f3a-3435-84e3-4a8f51c957f2",
                        "entry_id": "a59fd27e-9a9f-358b-b267-28852a7a6cb8",
                        "glosses": [
                            "nach einem Monopol strebender Akteur (Person oder Unternehmen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dc9ea65-b032-4e5e-ab5a-8aa6fb9695ad",
                                "sense_id": "7d1b0e2f-4f3a-3435-84e3-4a8f51c957f2",
                                "text": "Er versucht, die gesamte Konkurrenz auszuschalten, er ist ein Monopolist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27e2d4d7-0e1c-4195-a3f6-c9f38b65d73d",
                        "source_entry_id": "a59fd27e-9a9f-358b-b267-28852a7a6cb8",
                        "source_sense_id": "0c06031f-f350-3aeb-a766-0bd5a3bed09c",
                        "source_sense_description": "Inhaber einer marktbeherrschenden Stellung",
                        "target_lang_word": "monopolist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monopolist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4de679d6-a0aa-3d24-ad81-72fa65e515dd",
                                        "entry_id": "c21614bf-988d-38ba-ae26-9fc712532240",
                                        "glosses": [
                                            "One who has, or attempts to acquire, a monopoly on something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9607ba4-4203-43ab-b7cf-15a1f66a56d5",
                                                "sense_id": "4de679d6-a0aa-3d24-ad81-72fa65e515dd",
                                                "text": "\"Well, my love, that is all very true,\" replied Louisa, colouring with the consciousness of being a great monopolist; \"but I cannot help fearing more pain will arise to you eventually than the pleasure is worth;..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb962bfc-d4d2-4c77-9dab-b5554c645e3d",
                        "source_entry_id": "a59fd27e-9a9f-358b-b267-28852a7a6cb8",
                        "source_sense_id": "0c06031f-f350-3aeb-a766-0bd5a3bed09c",
                        "source_sense_description": "Inhaber einer marktbeherrschenden Stellung",
                        "target_lang_word": "monopoleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monopoleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0da806c8-fc4e-3357-b452-467f6b3179ed",
                                        "entry_id": "3f28f4c7-3114-3868-926f-fcf961622807",
                                        "glosses": [
                                            "Celui qui exerce un monopole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9a2d1df-28dc-4ff6-a37d-eef3e51f046d",
                                                "sense_id": "0da806c8-fc4e-3357-b452-467f6b3179ed",
                                                "text": "Un monopoleur, comme une entreprise en concurrence, cherche à maximiser ses profits."
                                            },
                                            {
                                                "example_id": "f8e697e1-1d0a-4a8e-b398-ec14b9c9b50d",
                                                "sense_id": "0da806c8-fc4e-3357-b452-467f6b3179ed",
                                                "text": "Tous les monopoleurs qui voulurent s’enrichir des ruines de l’État."
                                            },
                                            {
                                                "example_id": "544c1113-c550-488e-bd6f-e4d2aa69816c",
                                                "sense_id": "0da806c8-fc4e-3357-b452-467f6b3179ed",
                                                "text": "L'œuvre de l’Industriel français qui pousse à l’association des petits contre l’implacable et mortelle concurrence des monopoleurs n'en est pas moins fort encourageable."
                                            },
                                            {
                                                "example_id": "ee3d7920-cac2-4724-a212-43f4d2838da6",
                                                "sense_id": "0da806c8-fc4e-3357-b452-467f6b3179ed",
                                                "text": "Intendants, parlements, échevins ordonnaient de confisquer les blés des charrois, d'arrêter des bateliers, de surveiller les boulangers, de perquisitionner les greniers, de rechercher les « monopoleurs »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monopoleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5422f9f-c94f-33a8-8f37-f83dc9de7720",
                                        "entry_id": "b07b943f-570c-3ea1-bd7c-7c0de099aed0",
                                        "glosses": [
                                            "Qui exerce un monopole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6144077e-64bc-453a-b216-6f2b0b76752f",
                                                "sense_id": "d5422f9f-c94f-33a8-8f37-f83dc9de7720",
                                                "text": "c) Analogie entre les tendances à la \"planification\" inhérentes au capitalisme monopoleur et la planification soviétique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
