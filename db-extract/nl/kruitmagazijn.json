                            {
                                "example_id": "ca13aa92-ae3f-4cb6-a3cc-1fe446af099b",
                                "sense_id": "dd1b21bd-c428-35f3-ba2e-e3a87a5ba1d9",
                                "text": "Waarom was Judiths serene, maar nog steeds wat gelige voorhoofd niet allang uit elkaar gesprongen bij het terugdenken aan een verleden liefdeshandeling; het met aandacht aanraken van zo'n granaat waarvan zij er meer in haar schedel borg dan er bommen waren in 's lands Kruitmagazijn."
                            },
                            {
                                "example_id": "ec167bc8-de5d-4ab2-aca8-67f5620ec67b",
                                "sense_id": "dd1b21bd-c428-35f3-ba2e-e3a87a5ba1d9",
                                "text": "Een paar jaar later bleef het orgel gespaard bij een explosie van de Spaanse toren –het kruitmagazijn in Château-des-Ducs in het centrum van Nantes– dat de glas-in-loodramen van de kathedraal verwoestte."
                            }
                        ]
                    }
