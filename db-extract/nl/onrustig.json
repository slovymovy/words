                "senses": [
                    {
                        "sense_id": "0ba02c8e-fb1d-397e-bbd0-bedf05000952",
                        "entry_id": "ac698a53-b4e6-3b7b-9d95-da1e7e02eaf4",
                        "glosses": [
                            "niet rustig zijnde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9668ce41-7b9e-44a4-821c-37e194cf617f",
                                "sense_id": "0ba02c8e-fb1d-397e-bbd0-bedf05000952",
                                "text": "Nee, dat vind ik een té onrustige vogel."
                            },
                            {
                                "example_id": "4198f20d-5bd3-46bc-af5a-59df5e1b73c4",
                                "sense_id": "0ba02c8e-fb1d-397e-bbd0-bedf05000952",
                                "text": "Ik had verwacht dat ik me misschien eenzaam zou voelen, menselijk contact zou missen en onrustig zou worden."
                            },
                            {
                                "example_id": "5812aefb-ece2-4606-beac-f1dd48fd1f6d",
                                "sense_id": "0ba02c8e-fb1d-397e-bbd0-bedf05000952",
                                "text": "Het was een onrustige avond geweest in Mazama Village, een grote camping vlak voor het beroemde vulkaanmeer Crater Lake."
                            }
                        ]
                    }
                ],
