                                "example_id": "c06e186f-2bbb-42d1-a2e0-a9313121dab6",
                                "sense_id": "462648c0-972a-33cc-9963-466bba86da45",
                                "text": "„Auch das Entfernen von Steinen oder das Anlegen von Bewässerungsanlagen gehört zur Urbarmachung.“"
                            },
                            {
                                "example_id": "3a7b4e9e-1f38-4743-9bcf-90039b37ff58",
                                "sense_id": "462648c0-972a-33cc-9963-466bba86da45",
                                "text": "„In der damaligen Zeit muss diese Region recht dicht besiedelt und aufgrund eines dichten Netzes künstlicher Bewässerungsanlagen fruchtbar gewesen sein.“"
                            }
