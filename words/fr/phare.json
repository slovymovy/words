                    "synonyms": [
                        "guide",
                        "flambeau"
                    ]
                },
                {
                    "sense_id": "63c8fcdf-154f-34a9-b5d2-5f11f037563e",
                    "sense_definition": "Ensemble des voiles établies sur un même mât d'un grand voilier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "marine_voilure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipage a dû rapidement réduire le <w>phare</w> avant pour faire face aux violentes rafales de vent."
                        },
                        {
                            "text": "Le trois-mâts déployait fièrement tout son <w>phare</w> sous le soleil radieux du matin."
                        }
                    ]
                }
            ]
        },
