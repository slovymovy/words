                                "example_id": "3464cab4-a658-4b5c-b7ba-6579e26bc072",
                                "sense_id": "4568f92b-073a-302c-b584-1afa4a014aa3",
                                "text": "De senaat van Rome verloor zijn gezag grotendeels aan de keizer, maar bleef nog lang bestaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b45d98d-1dfc-395c-a6a8-0b998ae33b6c",
