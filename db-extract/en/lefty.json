                                "example_id": "b6191481-ed75-4bc6-b4d6-150f3f6d44c5",
                                "sense_id": "6889ad1d-62e0-3a1b-9e2e-93387ab53fa4",
                                "text": "The lefty scissors are the ones with the red plastic handles."
                            }
                        ]
                    },
                    {
                        "sense_id": "e52f1cf7-a393-3f17-9d87-0a6b44562d4b",
                        "entry_id": "a3ec8f68-ff89-31da-9c3a-9c0049e33cf4",
                        "glosses": [
                            "Left-wing."
                        ],
                        "tags": [
                            "UK",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "b309c178-33ed-42f6-b763-616737defd77",
                                "sense_id": "e52f1cf7-a393-3f17-9d87-0a6b44562d4b",
                                "text": "The prospect of an Argentinian amalgam of Bolsonaro and Trump taking power has horrified progressive voters and also, apparently, Pope Francis, whom Milei has bad-mouthed as a “lefty son of a bitch”."
                            }
                        ]
                    }
                ],
