                        ],
                        "examples": [
                            {
                                "example_id": "0e3f7caf-8145-468c-ba92-c36824ec103c",
                                "sense_id": "3f56a6dc-3fbf-30ed-a789-c8dbc7d359e5",
                                "text": "Une fille de Granville, âgée de 24 ans, ayant pris l’état de batelière pour faire subsister sa mère, âgée de 70 ans, alloit tous les jours avec son canot, du môle à terre , et de terre au môle."
                            },
                            {
                                "example_id": "5cb4e771-d231-46ef-b8bd-1eddda81b6ef",
                                "sense_id": "3f56a6dc-3fbf-30ed-a789-c8dbc7d359e5",
                                "text": "En attendant que ma batelière charge ses stocks, je me promène nonchalamment parmi les étals du marché tout proche du port."
                            }
                        ]
                    }
