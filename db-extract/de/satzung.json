                ],
                "senses": [
                    {
                        "sense_id": "98710c92-c173-303d-b42e-f958b7a53c8f",
                        "entry_id": "611de17c-7b14-3270-88fb-614911c9fddf",
                        "glosses": [
                            "schriftlich niedergelegte Grundordnung eines rechtlichen Zusammenschlusses (insbesondere eines Vereins oder einer Aktiengesellschaft)"
                        ],
                        "tags": [
                            "Gesellschaftsrecht",
                            "Privatrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "36630751-a8e3-4697-b952-c117d99c139b",
                                "sense_id": "98710c92-c173-303d-b42e-f958b7a53c8f",
                                "text": "„Die Schaffung einer körperschaftlichen Organisation verlangt vor allem die Aufstellung einer Satzung, die die innere Ordnung des Vereins im Rahmen der gesetzlichen Bestimmungen in einer für die Mitglieder verbindlichen Weise festlegt …“"
                            },
                            {
                                "example_id": "accc7c59-746a-4db7-800c-de1915c84a5c",
                                "sense_id": "98710c92-c173-303d-b42e-f958b7a53c8f",
                                "text": "„Binnen weniger Tage wurde aus dem Komitee ein Verein mit Satzung und allem Drum und Dran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "853b7816-8b2c-3a2a-80fe-1a2bf60d5819",
                        "entry_id": "611de17c-7b14-3270-88fb-614911c9fddf",
                        "glosses": [
                            "exekutive Rechtsnorm, die von einer Selbstverwaltungskörperschaft (insbesondere einer Gemeinde) im Rahmen der ihr eingeräumten Autonomie zur Regelung ihrer eigenen Angelegenheiten gesetzt wird"
                        ],
                        "tags": [
                            "öffentliches Recht"
                        ],
                        "examples": [
                            {
                                "example_id": "1184952c-f72a-4ebe-8067-7fc59b884338",
                                "sense_id": "853b7816-8b2c-3a2a-80fe-1a2bf60d5819",
                                "text": "„Satzungen sind Rechtsvorschriften, die von einer dem Staat eingeordneten juristischen Person des öffentlichen Rechts im Rahmen der ihr gesetzlich verliehenen Autonomie mit Wirksamkeit für die ihr angehörigen und unterworfenen Personen erlassen werden …“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bd45b1a-ceed-42e2-8192-8e8a4726e4a9",
                        "source_entry_id": "611de17c-7b14-3270-88fb-614911c9fddf",
                        "source_sense_id": "98710c92-c173-303d-b42e-f958b7a53c8f",
