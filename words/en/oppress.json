{
    "word_family": [
        "oppression",
        "oppressive",
        "oppressor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76546fa5-9397-3e4a-aa78-9beab1d63a4d",
                    "sense_definition": "To keep down by unjust force or authority.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rural poor were <w>oppressed</w> by the land-owners.",
                            "target_lang_translations": {
                                "zh": "农村贫民受到地主的<w>压迫</w>。"
                            }
                        },
                        {
                            "text": "Citizens often <w>oppress</w> minorities when they feel <w>oppressed</w> by their own government.",
                            "target_lang_translations": {
                                "zh": "当公民感到受到政府的<w>压迫</w>时，他们往往会去<w>欺压</w>少数群体。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suppress"
                    ],
                    "common_phrases": [
                        "oppress the people"
                    ],
                    "target_lang_definitions": {
                        "zh": "以不公正的武力或权威压迫、欺压他人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "压迫",
                                "target_lang_sense_clarification": "指利用权力或武力对人进行压制。"
                            },
                            {
                                "target_lang_word": "欺压",
                                "target_lang_sense_clarification": "指欺负并压迫他人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e964a455-9a76-3e70-bca7-7f741c4d36e5",
                    "sense_definition": "To make someone feel sad, gloomy, or burdened.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were <w>oppressed</w> by the constant grey skies.",
                            "target_lang_translations": {
                                "zh": "阴沉的天空让我们感到十分<w>压抑</w>。"
                            }
                        },
                        {
                            "text": "The heavy silence in the room began to <w>oppress</w> everyone present.",
                            "target_lang_translations": {
                                "zh": "房间里沉重的寂静开始让在场的每个人感到<w>压抑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "depress",
                        "sadden"
                    ],
                    "common_phrases": [
                        "oppressed by silence"
                    ],
                    "target_lang_definitions": {
                        "zh": "使人感到忧郁、沉重或压抑。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "压抑",
                                "target_lang_sense_clarification": "指情绪或气氛让人感到沉重、不舒畅。"
                            },
                            {
                                "target_lang_word": "使……感到沉重",
                                "target_lang_sense_clarification": "指心理上承受负担。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "748cba49-dffb-3274-af01-6d6cd0599f01",
                    "sense_definition": "To physically press down on someone with harmful effects.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy debris continued to <w>oppress</w> the victim trapped underneath.",
                            "target_lang_translations": {
                                "zh": "沉重的瓦砾持续<w>压</w>在被困的受害者身上。"
                            }
                        },
                        {
                            "text": "The weight of the falling wall <w>oppressed</w> the structure below.",
                            "target_lang_translations": {
                                "zh": "倒塌墙壁的重量<w>压</w>在下方的结构上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crush",
                        "squash"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or historical contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以物理力量向下挤压，造成伤害。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "压",
                                "target_lang_sense_clarification": "指物理上的重压。"
                            },
                            {
                                "target_lang_word": "挤压",
                                "target_lang_sense_clarification": "指从四周或上方施加压力。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}