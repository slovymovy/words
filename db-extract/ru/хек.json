                "translations": [
                    {
                        "translation_id": "ce3cbf87-a48f-48bf-96da-fdfc01f071e5",
                        "source_entry_id": "c54f0892-ea28-35e8-a0e2-269f566f10b2",
                        "source_sense_id": "1d349016-5a9b-3ed9-8839-aabca99913c9",
                        "target_lang_word": "merluche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merluche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91e630fd-5ca1-39ee-948b-a474017f9537",
                                        "entry_id": "87ec9994-4a61-3ecf-a79d-e2e3b6da4c28",
                                        "glosses": [
                                            "Merlus séché au soleil, morue sèche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee5796d-5294-40b4-b2b6-a637909f2155",
                                                "sense_id": "91e630fd-5ca1-39ee-948b-a474017f9537",
                                                "text": "Manière d’accommoder la merluche. Avant de la mettre tremper, battez-la avec un marteau pour l’attendrir."
                                            },
                                            {
                                                "example_id": "38fa8855-1828-4362-8f3e-460335a04ff8",
                                                "sense_id": "91e630fd-5ca1-39ee-948b-a474017f9537",
                                                "text": "La cuisine n’est pas le côté brillant de l’Espagne, et les hôtelleries n’ont pas été sensiblement améliorées depuis don Quichotte ; les peintures d’omelettes emplumées, de merluches coriaces, d’huile rance et de pois chiches pouvant servir de balles pour les fusils, sont encore de la plus exacte vérité."
                                            },
                                            {
                                                "example_id": "a507c181-cef8-448f-ae78-1fe2c0248bf7",
                                                "sense_id": "91e630fd-5ca1-39ee-948b-a474017f9537",
                                                "text": "Il a volé le premier prix de notre “pêche miraculeuse”! Une merluche de six livres!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f385ca4a-e117-30e4-8829-14f3b246f32f",
                                        "entry_id": "87ec9994-4a61-3ecf-a79d-e2e3b6da4c28",
                                        "glosses": [
                                            "Morue, en parlant d’une personne."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67de06d8-d807-4a0b-84d1-5c30798bf788",
                                                "sense_id": "f385ca4a-e117-30e4-8829-14f3b246f32f",
                                                "text": "L’index est sa femme, virago sèche comme une merluche, qui dès le matin soufflette sa servante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
