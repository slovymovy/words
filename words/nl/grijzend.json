                        "de": "grau werdend (von den Haaren), meist altersbedingt"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ergrauend",
                                "target_lang_sense_clarification": "von Haaren oder Personen"
                            },
                            {
                                "target_lang_word": "grau werdend",
                                "target_lang_sense_clarification": "allmählich grau werdend"
                            },
                            {
                                "target_lang_word": "meliet",
                                "target_lang_sense_clarification": "mit ersten grauen Haaren durchsetzt"
                            }
                        ]
                    }
                }
            ]
        },
