            "senses": [
                {
                    "sense_id": "da3e93c5-9d99-37ea-bafa-cd9a00ac4703",
                    "sense_definition": "Niet meer te vinden of niet meer in bezit; zoekgeraakt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "missing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zocht urenlang naar zijn <w>verloren</w> sleutels.",
                            "target_lang_translations": {
                                "en": "He searched for his <w>lost</w> keys for hours.",
                                "ru": "Он часами искал свои <w>потерянные</w> ключи.",
                                "fr": "Il a cherché ses clés <w>perdues</w> pendant des heures.",
                                "zh": "他找了好几个小时自己<w>丢失的</w>钥匙。"
                            }
                        },
                        {
                            "text": "De <w>verloren</w> tijd kunnen we helaas niet meer inhalen.",
                            "target_lang_translations": {
                                "en": "Unfortunately, we cannot make up for the <w>lost</w> time.",
                                "ru": "К сожалению, мы больше не можем наверстать <w>потерянное</w> время.",
                                "fr": "Nous ne pouvons malheureusement pas rattraper le temps <w>perdu</w>.",
                                "zh": "遗憾的是，我们再也无法补回<w>失去的</w>时间了。"
                            }
