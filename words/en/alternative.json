{
    "word_family": [
        "alternate",
        "alternation",
        "alternatively",
        "alternator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "17e7fdff-d82b-3b07-a250-8c7a080a6a2a",
                    "sense_definition": "Available as another possibility or different from the one first considered.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "choice_possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to take an <w>alternative</w> route to avoid the heavy traffic.",
                            "target_lang_translations": {
                                "ru": "Мы решили выбрать <w>альтернативный</w> маршрут, чтобы избежать пробок.",
                                "zh": "我们决定走一条<w>替代</w>路线以避开拥堵的交通。"
                            }
                        },
                        {
                            "text": "Solar power is becoming a popular <w>alternative</w> energy source for many homes.",
                            "target_lang_translations": {
                                "ru": "Солнечная энергия становится популярным <w>альтернативным</w> источником энергии для многих домов.",
                                "zh": "太阳能正成为许多家庭一种受欢迎的<w>替代</w>能源。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alternative energy",
                        "alternative route",
                        "alternative solution",
                        "alternative method"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доступный как другой вариант или отличный от того, что рассматривался вначале",
                        "zh": "作为另一种可能性提供，或与最初考虑的不同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альтернати́вный",
                                "target_lang_sense_clarification": "иной, запасной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "替代的",
                                "target_lang_sense_clarification": "作为替换方案的"
                            },
                            {
                                "target_lang_word": "另外的",
                                "target_lang_sense_clarification": "除此之外的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e8bc617-9302-34aa-aa16-3fe903554969",
                    "sense_definition": "Not traditional, outside the mainstream, or belonging to a counterculture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "non_traditional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people are turning to <w>alternative</w> medicine to treat chronic illnesses.",
                            "target_lang_translations": {
                                "ru": "Многие люди обращаются к <w>альтернативной</w> медицине для лечения хронических заболеваний.",
                                "zh": "许多人开始转向<w>非传统</w>医学来治疗慢性病。"
                            }
                        },
                        {
                            "text": "The radio station plays mostly <w>alternative</w> rock from the nineties.",
                            "target_lang_translations": {
                                "ru": "Эта радиостанция играет в основном <w>альтернативный</w> рок девяностых.",
                                "zh": "这家电台主要播放九十年代的<w>另类</w>摇滚乐。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alternative medicine",
                        "alternative lifestyle",
                        "alternative rock",
                        "alternative media"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нетрадиционный, выходящий за рамки мейнстрима или принадлежащий к контркультуре",
                        "zh": "非传统的，非主流的，或属于反主流文化的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альтернати́вный",
                                "target_lang_sense_clarification": "нетрадиционный"
                            },
                            {
                                "target_lang_word": "нетрадицио́нный",
                                "target_lang_sense_clarification": "о медицине, методах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "非传统的",
                                "target_lang_sense_clarification": "非主流的"
                            },
                            {
                                "target_lang_word": "另类的",
                                "target_lang_sense_clarification": "非主流文化或艺术"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "094bffe4-dacd-342b-a583-c07d0070672e",
                    "sense_definition": "Presenting two or more mutually exclusive choices in grammar.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grammar_choice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word \"or\" is an example of an <w>alternative</w> conjunction.",
                            "target_lang_translations": {
                                "ru": "Слово \"или\" — это пример <w>разделительного</w> союза.",
                                "zh": "“或者”一词是<w>选择性</w>连词的一个例子。"
                            }
                        },
                        {
                            "text": "In this sentence, the <w>alternative</w> structure forces the reader to choose one meaning.",
                            "target_lang_translations": {
                                "ru": "В этом предложении <w>альтернативная</w> структура заставляет читателя выбрать одно значение.",
                                "zh": "在这句话中，这种<w>选择性</w>结构迫使读者选择其中一种含义。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disjunctive"
                    ],
                    "common_phrases": [
                        "alternative conjunction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предлагающий два или более взаимоисключающих варианта (в грамматике)",
                        "zh": "在语法中表示两个或多个互斥的选择。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздели́тельный",
                                "target_lang_sense_clarification": "грамматический термин"
                            },
                            {
                                "target_lang_word": "альтернати́вный",
                                "target_lang_sense_clarification": "взаимоисключающий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选择性的",
                                "target_lang_sense_clarification": "语法术语"
                            },
                            {
                                "target_lang_word": "析取的",
                                "target_lang_sense_clarification": "逻辑或语法术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb135e53-ed6b-392a-a120-a7c252bbd554",
                    "sense_definition": "One of several mutually exclusive things which can be chosen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "choice_possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had no <w>alternative</w> but to ask my parents for help.",
                            "target_lang_translations": {
                                "ru": "У меня не было <w>альтернативы</w>, кроме как попросить родителей о помощи.",
                                "zh": "我别无<w>选择</w>，只能向父母求助。"
                            }
                        },
                        {
                            "text": "Walking is a healthy <w>alternative</w> to driving a car for short distances.",
                            "target_lang_translations": {
                                "ru": "Ходьба — это здоровая <w>альтернатива</w> поездкам на машине на короткие расстояния.",
                                "zh": "对于短距离出行，步行是开车的一种健康<w>替代方案</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "no alternative",
                        "viable alternative",
                        "good alternative",
                        "safe alternative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из нескольких взаимоисключающих возможностей, которые можно выбрать",
                        "zh": "可供选择的几种互斥事物中的一种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альтернати́ва",
                                "target_lang_sense_clarification": "выбор, вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "替代方案",
                                "target_lang_sense_clarification": "可供选择的方案"
                            },
                            {
                                "target_lang_word": "选择",
                                "target_lang_sense_clarification": "可供挑选的余地"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}