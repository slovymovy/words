                "translations": [
                    {
                        "translation_id": "a81dd5ca-bbab-40d7-9963-7a8dd96f8ed5",
                        "source_entry_id": "22b0b934-dee7-38f0-9139-ffd0866a4753",
                        "target_lang_word": "delay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "delay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                        "entry_id": "5503debd-64a1-3787-a5f1-e202716b6777",
                                        "glosses": [
                                            "A period of time before an event occurs; the act of delaying; procrastination; lingering inactivity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca59359-3671-43c4-bae9-f1227937be5d",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "the delay before the echo of a sound"
                                            },
                                            {
                                                "example_id": "fa0bae20-7abf-48d9-b727-cd9ae31bb543",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "Two twenty minutes' delays."
                                            },
                                            {
                                                "example_id": "57370198-f0a0-45d3-9d75-1768b0e5eff4",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "Without any delay, on the morrow I sat on the judgment seat."
                                            },
                                            {
                                                "example_id": "092f1a0d-5213-4133-a400-216351626c3e",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "The government ought to be settled without the delay of a day."
                                            },
                                            {
                                                "example_id": "d14bb36b-c1b4-4fc2-b592-01b4bf38ff32",
                                                "sense_id": "69da0820-6e4c-3536-9e3f-44d04d9289d3",
                                                "text": "In this article I'm thinking about the big delays, over two hours. While rare, they make the news and help to deter people from future rail travel, both travellers and news viewers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a58c50e7-e573-30ca-bc98-bbf9084990b3",
                                        "entry_id": "5503debd-64a1-3787-a5f1-e202716b6777",
                                        "glosses": [
                                            "An audio effects unit that introduces a controlled delay."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f9bb1a5-e7d6-4c91-995e-5a3a96b8925c",
                                                "sense_id": "a58c50e7-e573-30ca-bc98-bbf9084990b3",
                                                "text": "The 8-bit sound quality of many early delays did indeed leave a lot to be desired (compare this to the 16-bit digital technology of CDs)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a53387a4-8456-3dcf-ab6f-c826bd134a59",
                                        "entry_id": "5503debd-64a1-3787-a5f1-e202716b6777",
                                        "glosses": [
                                            "Synonym of promise (“object representing delayed result”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee3c1329-4b4e-34ee-89cb-8676eaa6c541",
                                        "entry_id": "5503debd-64a1-3787-a5f1-e202716b6777",
                                        "glosses": [
                                            "An amount of time provided on each move before one's clock starts to tick; a less common time control than increment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "delay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "171b90e1-0fb8-3018-8e38-8eb3640670cd",
                                        "entry_id": "976014b8-f786-3f2c-bf81-41ddcf3125cb",
                                        "glosses": [
                                            "To put off until a later time; to defer."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6f74b1b-3ef2-43ef-833a-e4256020e24c",
                                                "sense_id": "171b90e1-0fb8-3018-8e38-8eb3640670cd",
                                                "text": "My lord delayeth his coming."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa25dcf-a83b-34c6-b8c3-c2e381d402bd",
                                        "entry_id": "976014b8-f786-3f2c-bf81-41ddcf3125cb",
                                        "glosses": [
                                            "To retard; to temporarily stop, detain, or hinder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754800ef-2b9c-4007-a659-b5e07673a875",
                                                "sense_id": "afa25dcf-a83b-34c6-b8c3-c2e381d402bd",
                                                "text": "The mail is delayed by a heavy fall of snow."
                                            },
                                            {
                                                "example_id": "b0b22a4c-2a0e-44f8-b5ff-bb3662743bb6",
                                                "sense_id": "afa25dcf-a83b-34c6-b8c3-c2e381d402bd",
                                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered. […] The Maria had a cabin, which was finished in hard wood and yellow plush, and accommodations for keeping things cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5140184-60eb-3b6b-881e-d09074caa5d4",
                                        "entry_id": "976014b8-f786-3f2c-bf81-41ddcf3125cb",
                                        "glosses": [
                                            "To wait, hesitate, tarry."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "557c86ce-61ca-4e4d-bf84-0e30115c35e8",
                                                "sense_id": "d5140184-60eb-3b6b-881e-d09074caa5d4",
                                                "text": "Don't delay; this special offer ends at midnight!"
                                            },
                                            {
                                                "example_id": "799f89ac-3666-4e0d-9990-79766eb2f558",
                                                "sense_id": "d5140184-60eb-3b6b-881e-d09074caa5d4",
                                                "text": "Don't delay\nSomething tells me I gotta go away"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47cb27d5-1b13-3c65-91f1-f7f97b8bd34a",
                                        "entry_id": "976014b8-f786-3f2c-bf81-41ddcf3125cb",
                                        "glosses": [
                                            "To allay; to temper."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d878e74-7315-4e81-88c8-775ba2204889",
                                                "sense_id": "47cb27d5-1b13-3c65-91f1-f7f97b8bd34a",
                                                "text": "The watery showers delay the raging wind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "delay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6bfebca-7bd2-3d34-8137-bbfc8c7e06b9",
                                        "entry_id": "122e5ac5-6878-3cac-bd19-6a83bb9cc190",
                                        "glosses": [
                                            "To dilute, temper."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85d22e5f-0d9b-3054-bcab-14e634da7572",
                                        "entry_id": "122e5ac5-6878-3cac-bd19-6a83bb9cc190",
                                        "glosses": [
                                            "To assuage, quench, allay."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29041dc6-4e5b-4ba2-87e9-81f71b6d7cec",
                                                "sense_id": "85d22e5f-0d9b-3054-bcab-14e634da7572",
                                                "text": "Those dreadfull flames she also found delayd / And quenched quite like a consumed torch […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6bcb7a0-faa8-4b78-ac72-1a00902698c2",
                        "source_entry_id": "22b0b934-dee7-38f0-9139-ffd0866a4753",
                        "target_lang_word": "linger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acb35e56-700f-3eea-8dc8-62d7992cf93d",
                                        "entry_id": "8915a766-d1fc-3366-a036-6b4e36990ac7",
                                        "glosses": [
                                            "To stay or remain in a place or situation, especially as if unwilling to depart or not easily able to do so."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "892771d3-f02a-4bb8-9994-7a70afcb764a",
                                                "sense_id": "acb35e56-700f-3eea-8dc8-62d7992cf93d",
                                                "text": "Still more foole I ſhall appeare / By the time I linger here"
                                            },
                                            {
                                                "example_id": "8b674aa7-0d19-4136-8f7a-5a829e9a8e42",
                                                "sense_id": "acb35e56-700f-3eea-8dc8-62d7992cf93d",
                                                "text": "His tone lingered in the air, almost like the tone of a musical instrument."
                                            },
                                            {
                                                "example_id": "feb8ee81-1f15-4913-9c6f-9bb711c3d456",
                                                "sense_id": "acb35e56-700f-3eea-8dc8-62d7992cf93d",
                                                "text": "She lingered in the window until the windy sunset died in bat-colored dusk; then, going to bed, she lay sleepless all night."
                                            },
                                            {
                                                "example_id": "c3e1ccca-c97b-4af1-a6f6-16eebe777b2d",
                                                "sense_id": "acb35e56-700f-3eea-8dc8-62d7992cf93d",
                                                "text": "Stars fading but I linger on, dear / Still craving your kiss / I'm longin' to linger till dawn, dear / Just saying this"
                                            },
                                            {
                                                "example_id": "24aa96a6-f6cf-4132-bdb6-65ee8d5fd6cd",
                                                "sense_id": "acb35e56-700f-3eea-8dc8-62d7992cf93d",
                                                "text": "It takes into account […] predictions of how long radioactive contaminants will linger in the soil and water near the nuclear facility."
                                            },
                                            {
                                                "example_id": "0b3d585d-ffb2-4e3d-b80b-590ccde5dc0a",
                                                "sense_id": "acb35e56-700f-3eea-8dc8-62d7992cf93d",
                                                "text": "Mrs. Clinton’s main opponent, Senator Bernie Sanders, a self-described Democratic Socialist, has proved to be more formidable than most people, including Mrs. Clinton, anticipated. He has brought income inequality and the lingering pain of the middle class to center stage and pushed Mrs. Clinton a bit more to the left than she might have gone on economic issues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e46ef6b0-4b48-3c55-a606-2e621197ee48",
                                        "entry_id": "8915a766-d1fc-3366-a036-6b4e36990ac7",
                                        "glosses": [
                                            "To remain alive or existent although still proceeding toward death or extinction; to die gradually."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b5adb99-5184-449c-8fab-1d99114e08fe",
                                                "sense_id": "e46ef6b0-4b48-3c55-a606-2e621197ee48",
                                                "text": "He lingered through the day, and died that evening as the sun went down."
                                            },
                                            {
                                                "example_id": "1e08d573-4442-47a2-a58c-cba07fe32922",
                                                "sense_id": "e46ef6b0-4b48-3c55-a606-2e621197ee48",
                                                "text": "During his absence the queen fell ill, and after lingering for some time she died."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c807661b-11a6-3939-80e8-ba13a59827bb",
                                        "entry_id": "8915a766-d1fc-3366-a036-6b4e36990ac7",
                                        "glosses": [
                                            "To consider or contemplate for a period of time; to engage in analytic thinking or discussion."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d016517-b194-446e-82ae-7e8775843eed",
                                                "sense_id": "c807661b-11a6-3939-80e8-ba13a59827bb",
                                                "text": "Trump doesn't linger on the poll."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
