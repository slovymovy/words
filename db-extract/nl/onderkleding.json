                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691b1107-49b0-478f-a11d-344fc9647039",
                                                "sense_id": "2c55699e-b962-37bb-a02a-9d9ec11f6b30",
                                                "text": "Devant chaque porte se trouvait une botte de paille, pour empêcher le froid de passer dessous."
                                            },
                                            {
                                                "example_id": "381e6df1-15b4-4afe-8478-0311737a278e",
                                                "sense_id": "2c55699e-b962-37bb-a02a-9d9ec11f6b30",
                                                "text": "On le cherchait sur le lit, il était dessous."
                                            }
                                        ]
