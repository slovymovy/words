                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81a9fa1e-2ce4-4473-8b0c-eca53e831db5",
                                                "sense_id": "1f43d1cb-33fd-37eb-a39e-b90d8193be86",
                                                "text": "A bronze denier bearing the inscription CONRADUS around a central cross, was minted in Lugdunum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8e60b80-a03c-33af-8705-0967d5a51584",
                                        "entry_id": "bb9a5261-8c73-39f3-b38f-dbbbeacde3b6",
                                        "glosses": [
                                            "A unit of linear density which indicates the fineness of fiber or yarn, equal to one gram per 9000 meters, used especially to measure or indicate the fineness of hosiery. Originally equal to the weight of a denier coin per 9600 aunes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e8b1223-5132-4794-a704-347f4f854143",
                                                "sense_id": "f8e60b80-a03c-33af-8705-0967d5a51584",
                                                "text": "Upstairs she rummaged through her chest of drawers, finally unearthing an unopened pack of ten denier barely blacks."
                                            }
                                        ]
                                    }
                                ]
                            },
