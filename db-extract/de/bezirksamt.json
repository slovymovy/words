                        "examples": [
                            {
                                "example_id": "6148d86c-ff88-4790-85be-a1cd6eabcab2",
                                "sense_id": "835aea3d-d8e5-3868-b1dd-3caf0f64ec33",
                                "text": "„Berlin ist in 12 Bezirke gegliedert; ihre Organe sind die Bezirksverordnetenversammlungen und die Bezirksämter, geleitet von Bezirksbürgermeistern.“"
                            },
                            {
                                "example_id": "f15942e9-20ff-41aa-8a52-06fc1e20e683",
                                "sense_id": "835aea3d-d8e5-3868-b1dd-3caf0f64ec33",
                                "text": "„Halbherzig wurden die Spuren in die gehobenen Dienstzimmer des Bezirksamtes hinein verfolgt, wo sie sich dann irgendwie verloren.“"
                            }
                        ],
