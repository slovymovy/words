    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3efaf92b-3021-34ee-940a-a0d80d28bc5e",
                    "sense_definition": "Recevoir volontairement ce qui est proposé, offert ou convenu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "consentir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>accepte</w> votre invitation pour le dîner de samedi avec grand plaisir."
                        },
                        {
                            "text": "Il a finalement décidé d'<w>accepter</w> ce nouveau travail dans le sud de la France."
                        }
                    ],
                    "synonyms": [
                        "agréer"
                    ],
                    "antonyms": [
                        "décliner",
                        "refuser",
                        "repousser"
                    ],
                    "common_phrases": [
                        "accepter une invitation",
                        "accepter une offre",
                        "accepter un cadeau"
                    ]
                },
                {
                    "sense_id": "667b7498-bb91-3d71-8407-f2fec7602246",
                    "sense_definition": "Admettre une idée, une situation ou une décision, y consentir ou s'y résigner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "consentir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>accepter</w> la réalité avant de pouvoir trouver une solution durable."
                        },
                        {
                            "text": "Elle a encore du mal à <w>accepter</w> cette décision prise par la direction."
                        }
                    ],
                    "synonyms": [
                        "admettre",
                        "tolérer"
                    ],
                    "antonyms": [
                        "refuser",
                        "rejeter"
                    ],
                    "common_phrases": [
                        "accepter la réalité",
                        "accepter les conditions",
                        "accepter la situation"
                    ]
                },
                {
                    "sense_id": "5d187440-cd42-362e-98db-4f7d882b460d",
                    "sense_definition": "Admettre ou accueillir une personne au sein d'un groupe, d'un organisme ou d'un établissement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère a été <w>accepté</w> dans une prestigieuse université de la région."
                        },
                        {
                            "text": "Les membres du club ont rapidement décidé de l'<w>accepter</w> parmi eux."
                        }
                    ],
                    "synonyms": [
                        "admettre",
                        "intégrer"
                    ],
                    "antonyms": [
                        "récuser",
                        "refuser",
                        "rejeter"
                    ],
                    "common_phrases": [
                        "être accepté dans"
                    ]
                },
                {
                    "sense_id": "0929ae28-aa13-3040-829d-8a4947e81221",
                    "sense_definition": "S'engager par écrit à payer un effet de commerce à son échéance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tiré a promis d'<w>accepter</w> cette lettre de change dès sa présentation."
                        },
                        {
                            "text": "La banque refuse formellement d'<w>accepter</w> ce document financier sans garanties complémentaires."
                        }
                    ],
                    "antonyms": [
                        "refuser"
                    ],
                    "common_phrases": [
                        "accepter une lettre de change"
                    ]
                }
            ]
        }
