                ],
                "senses": [
                    {
                        "sense_id": "9ff27ce3-1284-3727-a3e4-e3a1b204864b",
                        "entry_id": "28e182f1-c6e2-312a-a989-0fb064ac1a15",
                        "glosses": [
                            "Trottiner, faire des petits pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a1ec28-83dc-4cdd-a1f6-12885b3ecb04",
                                "sense_id": "9ff27ce3-1284-3727-a3e4-e3a1b204864b",
                                "text": "La comtesse, s’apprêtant pour aller au Bois, petonnait de sa chambre à sa toilette."
                            },
                            {
                                "example_id": "f0d9e1d1-2ebc-48e7-982d-66a63307e027",
                                "sense_id": "9ff27ce3-1284-3727-a3e4-e3a1b204864b",
                                "text": "Il petonnait, les mains derrière le dos, le nez au sol, assez embarrassé de son personnage."
                            },
                            {
                                "example_id": "c2c9cdbf-edc8-40d8-8922-31844344338b",
                                "sense_id": "9ff27ce3-1284-3727-a3e4-e3a1b204864b",
                                "text": "Je l’avais mis avec Bijou au pâtis pour les désembrouiller, plutôt que de les laisser petonner dans l'écurie."
                            },
                            {
                                "example_id": "4f1221cb-0c50-4659-aea9-49b51721b6b0",
                                "sense_id": "9ff27ce3-1284-3727-a3e4-e3a1b204864b",
                                "text": "Mais sitôt qu’il l’avait vu, hop, sautait de la margelle du puits, vite remuait le pot aux crottes, dansait une gigue d’impatience, petonnait jusqu’à lui, entonnait invariablement la même litanie : (…)"
                            },
                            {
                                "example_id": "5ad1331b-382e-4a1d-afa5-3155ea80525e",
                                "sense_id": "9ff27ce3-1284-3727-a3e4-e3a1b204864b",
                                "text": "J'avais passé plusieurs heures debout dans le souterrain, à petonner, m'épuisant davantage que si j'avais suivi les pas d'inconnus dont je me contentais d'agripper certains détails fragmentaires, avortés en même temps que mon projet de consignation."
                            }
                        ]
                    }
                ],
