                "senses": [
                    {
                        "sense_id": "9a104664-ab31-3dc0-86ff-3311daae3743",
                        "entry_id": "db702a68-1b12-3da8-9a3b-8dfa367016cf",
                        "glosses": [
                            "Eigenschaft, sich über einen weiten Raum zu erstrecken, viel Raum zu beanspruchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9658d2ce-1098-4ca4-bab5-2311f4b09624",
                                "sense_id": "9a104664-ab31-3dc0-86ff-3311daae3743",
                                "text": "„So tendiert der Kapitalismus systemimmanent zur Ausweitung der Dimensionen, zur Großräumigkeit, zur Planierung und Zerstörung kleinerer, lokaler, demokratiefreundlicher Strukturen.“"
                            },
                            {
                                "example_id": "9a0bb15b-6dc0-4368-928c-dbfeb911b243",
                                "sense_id": "9a104664-ab31-3dc0-86ff-3311daae3743",
                                "text": "„Als ich lauftüchtig geworden war, entdeckte ich die Großräumigkeit der Welt – die Straße mit den Pferdefuhrwerken und den seltenen Autos, die Felder, die Kühe, den Wald.“"
                            },
                            {
                                "example_id": "2f593845-67ae-4e84-aa6d-03fbdb44a515",
                                "sense_id": "9a104664-ab31-3dc0-86ff-3311daae3743",
                                "text": "„Daher hier auch und von hier aus das lange Nachwirken römischer Großräumigkeit und monumentaler Wandgliederung in frühromanischer Zeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
