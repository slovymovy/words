                                "target_senses": [
                                    {
                                        "sense_id": "f9a481ec-5f7e-3859-86ed-34ee8d8402e9",
                                        "entry_id": "9e24ca23-1d38-374b-8d37-4fcea6494d70",
                                        "glosses": [
                                            "české mužské křestní jméno"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1841fbea-3508-443f-80ef-cc9c2fa8200d",
                                                "sense_id": "f9a481ec-5f7e-3859-86ed-34ee8d8402e9",
                                                "text": "Je pozdní večer — první máj — večerní máj — je lásky čas; hrdliččin zve ku lásce hlas: „Hynku! Viléme!! Jarmilo!!!“"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8adba45d-a1a4-4dc2-bec3-3ae5cd078f20",
                        "source_entry_id": "a6701fe0-e4e6-32b1-a272-aee54b19c5df",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Willem",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Willem",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "512843a1-75e3-3848-bac5-d04ee9d6d486",
                                        "entry_id": "14951358-bf00-355f-83c8-80e845b60fbd",
                                        "glosses": [
                                            "een jongensnaam"
                                        ],
                                        "tags": [
                                            "masculine",
                                            "name"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb6aaf5-e8b0-4c31-9f7a-5713cc172252",
                                                "sense_id": "512843a1-75e3-3848-bac5-d04ee9d6d486",
                                                "text": "Willem ging meestal met de motor naar zijn werk."
                                            },
                                            {
                                                "example_id": "781ce908-2277-4223-9960-96828d736d65",
                                                "sense_id": "512843a1-75e3-3848-bac5-d04ee9d6d486",
                                                "text": "Er stond steevast een stapel dozen: Willem II, Karel I, Washington, Ritmeester, Hofnar, Velasquez, Agio."
                                            },
                                            {
                                                "example_id": "cf4fc816-eeb9-452f-a269-ca6cd75dc2fd",
                                                "sense_id": "512843a1-75e3-3848-bac5-d04ee9d6d486",
                                                "text": "Die nadruk op fysieke ontwikkeling blijft een constante: of we nu de levensbeschrijving lezen van een twaalfde-eeuwse ridder als Willem de Maarschalk of de veertiende-eeuwse Jean le Meingre of Boucicaut, hun jonge jaren waren gevuld met een zwaar fysiek programma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f93047c8-bbb2-3fe5-b2e0-7b0df2943d6c",
                                        "entry_id": "14951358-bf00-355f-83c8-80e845b60fbd",
                                        "glosses": [
                                            "spelwoord van het Nederlandse spellingalfabet voor de letter w"
                                        ],
                                        "tags": [
                                            "spellingsalfabet"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
