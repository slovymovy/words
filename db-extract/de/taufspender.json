                "senses": [
                    {
                        "sense_id": "ae34e6d1-3ef7-3e7d-90a5-e0bf1cad3fbf",
                        "entry_id": "83fe8b29-4f55-363c-9865-87486c71e1cb",
                        "glosses": [
                            "jemand, der einen anderen tauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "902a55a5-7864-4ba4-afe3-ffda0073ae00",
                                "sense_id": "ae34e6d1-3ef7-3e7d-90a5-e0bf1cad3fbf",
                                "text": "„Die Eltern der Kinder sind diejenigen, welche die Taufe für die Kinder erbitten und Verantwortung für die religiöse Erziehung der Kinder übernehmen; die Taufspender sind diejenigen, welche für die Vorbereitung, Durchführung und eventuell auch Nachbegleitung der Taufe die Hauptverantwortung innehaben.“"
                            },
                            {
                                "example_id": "ff925034-c5fe-413f-8d12-37ac507674fe",
                                "sense_id": "ae34e6d1-3ef7-3e7d-90a5-e0bf1cad3fbf",
                                "text": "„Der Taufspender hat dafür Sorge zu tragen, dass wenigstens ein Zeuge bei der Taufe herangezogen wird, durch den die Spendung der Taufe bewiesen werden kann, wenn nicht schon ein Pate anwesend ist (c. 875).“"
                            },
                            {
                                "example_id": "cdcf9158-a868-43a7-8299-11d9c6b4b424",
                                "sense_id": "ae34e6d1-3ef7-3e7d-90a5-e0bf1cad3fbf",
                                "text": "„Von den neueren Autoren wird die Möglichkeit im allgemeinen bestritten, weil dadurch die Rechtmäßigkeit des nichtkatholischen Geistlichen als Taufspender anerkannt würde.“"
                            },
                            {
                                "example_id": "2b0db307-bbb1-4db7-a9b8-2010b71b893f",
                                "sense_id": "ae34e6d1-3ef7-3e7d-90a5-e0bf1cad3fbf",
                                "text": "„Die Taufspender übten ihre zunächst auf drei Jahre befristete Tätigkeit im Rahmen einer kirchenrechtlichen Ausnahmegenehmigung aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
