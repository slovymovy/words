                        "examples": [
                            {
                                "example_id": "266dfe20-26f4-4e0b-a5c4-1de17cf368d4",
                                "sense_id": "5d82cc51-3d96-3fe2-a74c-5c3d3a2d8c7b",
                                "text": "Il y a ce fait remarquable : si un utopiste rêvait d'une société dans laquelle chaque femme posséderait une rivière de diamants, eh bien, du moins jusqu'à ce que la physico-chimie ait fait de nouveaux progrès très considérables, il s'agirait vraiment d'un utopiste."
                            },
                            {
                                "example_id": "d9ba0322-ddac-431f-b6f4-f94add09856d",
                                "sense_id": "5d82cc51-3d96-3fe2-a74c-5c3d3a2d8c7b",
                                "text": "Le chef étoilé Thierry Marx et le chercheur en physico-chimie Raphaël Haumont se sont amusés à associer des produits qui partagent les mêmes molécules aromatiques."
                            },
                            {
                                "example_id": "8fe9a4bf-4972-45d0-813f-42311595ea8a",
                                "sense_id": "5d82cc51-3d96-3fe2-a74c-5c3d3a2d8c7b",
                                "text": "C’est ce que l’on a découvert en travaillant avec le chercheur en physico-chimie Raphaël Haumont, au Centre français d’innovation culinaire à l’Université Paris-Saclay."
                            }
                        ]
                    }
