                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12021791-e700-40ed-9d9a-32939c101e1b",
                                                "sense_id": "f9406957-4eb4-32a5-90fd-61d458736ce9",
                                                "text": "— Квас есть в литровых и двухлитровых бутылках, какие брать? — Бери большие."
                                            }
                                        ]
                                    }
                                ]
