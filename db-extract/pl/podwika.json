                "senses": [
                    {
                        "sense_id": "8f829e44-ec8f-301e-b63d-06d8b069ae56",
                        "entry_id": "55c29438-dd8d-3f93-894c-346c3e59c0b0",
                        "glosses": [
                            "element stroju kobiecego, duża chusta z białego płótna, zasłaniająca szyję i boki twarzy"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "edea0629-eca8-4ccb-9837-c0b9ec6c09c2",
                                "sense_id": "8f829e44-ec8f-301e-b63d-06d8b069ae56",
                                "text": "Po sukni znam żałobę, znam i po podwice."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e4d2fa32-1aa8-3b31-82c1-85f11c14f035",
                        "entry_id": "55c29438-dd8d-3f93-894c-346c3e59c0b0",
                        "glosses": [
                            "zamężna kobieta"
                        ],
                        "tags": [
                            "Old-Polish",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "94c3224c-2979-41d3-92c7-e8ad9363fd7b",
                                "sense_id": "e4d2fa32-1aa8-3b31-82c1-85f11c14f035",
                                "text": "Samson miał siłę potężną, ale że mu podobno oleju w głowie brakło, że się dał podwice za nos wodzić, że nie miał siły ducha, wyższości jego i niepodległości, musiał młyny obracać Filistynom…"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
