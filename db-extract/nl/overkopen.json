                        "glosses": [
                            "iets kopen van iemand die eigenaar is of koper was"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d201ff39-af62-4c2a-bd83-bab97a1ef9fe",
                                "sense_id": "efdd9690-4e96-3280-a998-80d1fdb540e3",
                                "text": "Het is niet bekend wie de tekening heeft gekocht. Mocht dat een buitenlander zijn, dan moet de Vlaamse regering toestemming geven dat het werk België verlaat of het zelf overkopen."
                            },
                            {
                                "example_id": "a352dbd6-c632-449b-90aa-6ba6fbcabae2",
                                "sense_id": "efdd9690-4e96-3280-a998-80d1fdb540e3",
                                "text": "Daarvoor is wel voor 1 juli 50.000 euro nodig. Met dat geld kan Stadsherstel het gebouwtje overkopen van de gemeente, het achterstallig onderhoud wegwerken en weer inrichten."
                            },
                            {
                                "example_id": "af77f556-06ec-4361-a4ed-77ec69354e5b",
                                "sense_id": "efdd9690-4e96-3280-a998-80d1fdb540e3",
                                "text": "Hondenbezitters in onder meer Nijkerk en het Noord-Brabantse Middelrode waarschuwen voor de opkopers. Er is afgelopen week in Middelrode zeker één persoon aangesproken door iemand die een hond wilde overkopen, mogelijk zijn er drie mensen benaderd door ronselaars."
                            }
                        ]
