                        "glosses": [
                            "Messgerät zur Bestimmung der aufgenommenen Menge an radioaktiver Strahlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91889a29-6ad5-409c-aed7-11ea57af846f",
                                "sense_id": "bffaec2c-0194-33e3-bc8e-1793bf7a242d",
                                "text": "Jeder Bedienstete in einem Atomkraftwerk muss ein Dosimeter verwenden."
