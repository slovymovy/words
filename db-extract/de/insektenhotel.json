                        "form": "das Insektenhotel"
                    },
                    {
                        "form_id": "6c384a74-9f08-4349-88f5-04863ac2ba9d",
                        "entry_id": "b3a961ff-2731-3e4b-ba4d-f39782ce5ff2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Insektenhotels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                        "entry_id": "b3a961ff-2731-3e4b-ba4d-f39782ce5ff2",
                        "glosses": [
                            "von Menschen geschaffener Nistplatz/Überwinterungsschutz/Unterschlupf für (gefährdete) Insekten"
                        ],
                        "tags": [
                            "Naturschutz"
                        ],
                        "examples": [
                            {
                                "example_id": "867b16a7-9854-4f10-bc46-f2b8488fdf83",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "„Solitär lebende Wildbienen nisten gerne in Bodenhöhlen und hohlen Stängeln, wie sie von Insektenhotels nachgeahmt werden“"
                            },
                            {
                                "example_id": "445bdf66-546d-4e33-8747-9818d3f1bc84",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "„In diesem kurzen Video erklärt Julian zwei einfache Arten, ein Insektenhotel zu bauen.“"
                            },
                            {
                                "example_id": "21cb4d7d-2f8d-4fb2-8c33-77c91dbf31e9",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "[…] „wer Lust auf noch mehr Nützlinge im Garten hat, baut vielleicht sein eigenes Insektenhotel.“"
                            },
                            {
                                "example_id": "3f20e58b-bdf0-4b40-87da-8665053cd13a",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "„Sie hat alte Schilfrohrmatten dabei, große und kleine Holzklötze und einen Eimer voller Lehm. Es sind Materialien, aus denen die 30-jährige Studentin ein Insektenhotel bauen möchte.“"
                            },
                            {
                                "example_id": "4b75056c-58f9-453d-bf69-33f04b1a4a0e",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "„Angebohrtes Holz und hohle Stängel eignen sich perfekt als Insektenhotel.“"
                            },
                            {
                                "example_id": "6a2ebe15-302e-44c6-b823-e3eb1190931b",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "„Um die Insekten vor Vögeln zu schützen, bespannen Sie Ihr Insektenhotel mit einem Drahtgitter.“"
                            },
                            {
                                "example_id": "a72fa207-9c47-4831-bdf8-dca75508b941",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "„Auch, wenn Buntspechte wirklich tolle Tiere sind, sind sie leider auch Räuber. Wenn Sie ein Insektenhotel im Garten stehen haben, dann kommt es nicht selten vor, dass Buntspechte sich ungeniert daraus bedienen.“"
                            },
                            {
                                "example_id": "f48832db-b12e-49a9-b477-86807fd40f1f",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "[…] „auch bienenfreundliche Pflanzen wie Lavendel und Löwenmäulchen oder ein Blechdosennistplatz und Insektenhotels für Wildbienen können zum Arterhalt beitragen.“"
                            },
                            {
                                "example_id": "10dcd7b8-ced2-4e16-96df-a254284d71ba",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "„Das schönste Insektenhotel nützt nichts, wenn nicht genug Nahrung vorhanden ist. Ein reichhaltiges Nektar- und Pollenangebot bieten Lavendel, Rosmarin, Klee, Scharfgabe, Natternkopf, Wilder Wein, Efeu, Kapuzinerkresse und viele wilde, heimische Wiesenblumen.“"
                            },
                            {
                                "example_id": "5b465c1f-0655-4c3c-9089-d0cb9e2a99e1",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "„Die Schülerinnen und Schüler haben ihre Schulanlage umgestaltet und einen Teich angelegt, ein Insektenhotel aufgestellt oder Stein- und Asthaufen zusammengetragen, um ein Zuhause für Tiere zu schaffen.“"
                            },
                            {
                                "example_id": "12f8e39b-f64c-463c-a8ee-e2cc689988ed",
                                "sense_id": "ae953f7a-fd1d-35c5-abc6-3e0c88123c96",
                                "text": "„Die Stadt Stuttgart begrünt graue Betonwände mit Pflanzen und Insektenhotels, wie hier an der Universität der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
