                        "target_lang_word": "Holm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Holm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0130d18d-31ce-3c30-83d7-8d43a987975a",
                                        "entry_id": "be4eb001-ffd9-34a2-b15a-587369d61bfd",
                                        "glosses": [
                                            "eine Stange, in der Regel aus Holz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e32c3a-0fe3-44ed-a541-36fd952488a9",
                                                "sense_id": "0130d18d-31ce-3c30-83d7-8d43a987975a",
                                                "text": "Die Stangen am Barren werden als Holme bezeichnet."
                                            },
                                            {
                                                "example_id": "5ff55c29-2d95-4e77-b555-a36d17dc0b9c",
                                                "sense_id": "0130d18d-31ce-3c30-83d7-8d43a987975a",
                                                "text": "Der Holm an seiner Axt war so morsch, dass er ihm beim nächsten Schlag durchbrach."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "653993e5-88ae-3e4f-9db4-9e215a8e80af",
                                        "entry_id": "be4eb001-ffd9-34a2-b15a-587369d61bfd",
                                        "glosses": [
                                            "eine kleine Insel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2673bbc3-2b23-48dc-ad44-241ad885a61b",
                                                "sense_id": "653993e5-88ae-3e4f-9db4-9e215a8e80af",
                                                "text": "Sie machten einen Ausflug zum Holm vor der Küste."
                                            },
                                            {
                                                "example_id": "2b4cadd7-4408-4154-acbc-425e1aaca817",
                                                "sense_id": "653993e5-88ae-3e4f-9db4-9e215a8e80af",
                                                "text": "„Auf der anderen Seite des Fjords südlich von der Landzunge blinkte das weiße Haus von Bessastadir in der Sonne, wo die Männer des Königs herrschten; auf der Nordseite der Landzunge lagen die langgestreckten Gebäude auf flachen Klippen draußen in der See und Handelsschiffe auf der Reede: die kleine Stadt auf dem Holm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e8956952-768b-3c5b-b1dd-16b225cb74a3",
                                        "entry_id": "be4eb001-ffd9-34a2-b15a-587369d61bfd",
                                        "glosses": [
                                            "ein querliegender Balken, der Stützen miteinander verbindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57d7b22-0a94-484a-901f-c69f242492ed",
                                                "sense_id": "e8956952-768b-3c5b-b1dd-16b225cb74a3",
                                                "text": "Die Holme müssen bestimmte Normen erfüllen, damit die Konstruktion den berechneten Belastungen standhält."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
