                    {
                        "sense_id": "8c195b56-3ab3-380a-a7e8-4bb8020348a8",
                        "entry_id": "eb7f758f-389b-3c0e-8f23-aced7d0e6f01",
                        "glosses": [
                            "boot (part of a carriage where the coachman sits)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2284f2-adf4-49ba-bb84-4ecf8d5663b4",
                                "sense_id": "8c195b56-3ab3-380a-a7e8-4bb8020348a8",
                                "text": "Бразды пушистые взрывая, Летит кибитка удалая, Ямщик сидит на облучке В тулупе, в красном кушаке.",
                                "translation": "A bold kibitka moves fast phoughing up fluffy furrows, The coachman in an overcoat and a red sash sits on the boot.",
                                "english": "A bold kibitka moves fast phoughing up fluffy furrows, The coachman in an overcoat and a red sash sits on the boot."
                            }
                        ]
                    }
                ],
