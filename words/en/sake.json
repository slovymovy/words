                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reason_benefit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let us assume, for the <w>sake</w> of argument, that your theory is correct.",
