                "forms": [],
                "senses": [
                    {
                        "sense_id": "72a4046e-b92c-320e-9b73-05178d54d82c",
                        "entry_id": "046fec18-cd36-336d-8196-7757b671a66b",
                        "glosses": [
                            "Situated under one's foot or feet."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9a50c270-35dd-35fa-b55e-c62f978df8a0",
                        "entry_id": "046fec18-cd36-336d-8196-7757b671a66b",
                        "glosses": [
                            "In the way; placed so as to obstruct or hinder."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b2b0cd53-492c-4240-9ed4-459320d561a1",
                                "sense_id": "9a50c270-35dd-35fa-b55e-c62f978df8a0",
                                "text": "We'd go to the Downbeat Club, on Fifty-second Street, and I'd be so underfoot that Billie couldn't miss me."
                            },
                            {
                                "example_id": "1f41d5f1-929e-410f-9eaf-a4852aac7d98",
                                "sense_id": "9a50c270-35dd-35fa-b55e-c62f978df8a0",
                                "text": "You ask a lot of questions, Morty. Not very charismatic. It makes you kind of an [belch] under [belch] underfoot figure."
                            }
                        ]
                    },
                    {
                        "sense_id": "58a33cc0-0071-3b59-8730-8fd9996c73bf",
                        "entry_id": "046fec18-cd36-336d-8196-7757b671a66b",
                        "glosses": [
                            "Downtrodden; abject."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [],
