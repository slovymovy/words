                    {
                        "form_id": "e62e56fb-f383-4363-bc26-18afa8dc03db",
                        "entry_id": "40b5a045-1a4f-3b55-8f84-03dffc41db99",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Privatschulen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27fe0bb5-31e1-30b9-9274-c39be3e7c703",
                        "entry_id": "40b5a045-1a4f-3b55-8f84-03dffc41db99",
                        "glosses": [
                            "Schule in freier, also nichtstaatlicher Trägerschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e334dd-0267-40e3-a7f1-02bccb6b8aa3",
                                "sense_id": "27fe0bb5-31e1-30b9-9274-c39be3e7c703",
                                "text": "Meine Eltern können sich das Schulgeld für eine Privatschule nicht leisten, also gehe ich auf eine staatliche Schule."
                            },
                            {
                                "example_id": "9ba5afeb-e695-4a4c-923f-c08c49d9124a",
                                "sense_id": "27fe0bb5-31e1-30b9-9274-c39be3e7c703",
                                "text": "„Wenn allerdings ein Trend entsteht, dass immer mehr Eltern ihre Kinder lieber auf Privatschulen schicken würden, weil es an den öffentlichen Schulen durchregnet, die Klassen überfüllt und die Kinder unglücklich sind, dann gefährden wir damit unser öffentliches Schulsystem.“"
                            },
                            {
                                "example_id": "8b63a813-a1a1-407a-a252-8480fc8d028b",
                                "sense_id": "27fe0bb5-31e1-30b9-9274-c39be3e7c703",
                                "text": "„Die Privatschule in Gulitzscha wird aufgelöst.“"
                            },
                            {
                                "example_id": "912246d5-6023-4df7-87d4-11ce216ff7e4",
                                "sense_id": "27fe0bb5-31e1-30b9-9274-c39be3e7c703",
                                "text": "„Das macht sich schon daran bemerkbar, dass Privatschulen regen Zulauf haben.“"
                            },
                            {
                                "example_id": "bbb4a93d-6e42-4e73-87d2-34eb4f1725f7",
                                "sense_id": "27fe0bb5-31e1-30b9-9274-c39be3e7c703",
                                "text": "SPD-Ministerpräsidentin Manuela Schwesig schickt ihren Sohn auf eine Privatschule. Dafür bekommt sie Kritik von links und rechts."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf68e0c0-f5d1-4549-b534-667f25dcf15a",
                        "source_entry_id": "40b5a045-1a4f-3b55-8f84-03dffc41db99",
                        "source_sense_id": "27fe0bb5-31e1-30b9-9274-c39be3e7c703",
                        "source_sense_description": "Schule in freier, also nichtstaatlicher Trägerschaft",
                        "target_lang_word": "public school",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "public school",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4812360f-15fb-3816-9054-cce4c2c9a866",
                                        "entry_id": "73ad6b2e-c765-39b7-a849-2d2cd56c572f",
                                        "glosses": [
                                            "Certain private schools, particularly (initially) any grammar school operated apart from the personal lands of its students or (from the 19th century) the feepaying secondary schools which developed from or were modelled upon them; a British boarding school"
                                        ],
                                        "tags": [
                                            "India",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d59b2b-2f70-407e-8674-d7539832be85",
                                                "sense_id": "4812360f-15fb-3816-9054-cce4c2c9a866",
                                                "text": "All such School-masters as have charge of Children and do instruct them either in Publick Schools, or Private Houses."
                                            },
                                            {
                                                "example_id": "1b2f994d-2dc5-4072-8eab-58943072c5f8",
                                                "sense_id": "4812360f-15fb-3816-9054-cce4c2c9a866",
                                                "text": "No person shall keepe any schoole... except it be in some publike or free Grammer Schoole, or in some such noblemans... or gentlemans... house as are not recusants."
                                            },
                                            {
                                                "example_id": "de8c91ff-5aec-41a1-a4e6-72cd7d98377f",
                                                "sense_id": "4812360f-15fb-3816-9054-cce4c2c9a866",
                                                "text": "This worthy Man having observed the imperfect Institution of our public Schools, and the many Vices which Boys were there liable to learn, had resolved to educate his Nephew... in his own House."
                                            },
                                            {
                                                "example_id": "6ad8429d-1327-4c58-aa01-87da660f8952",
                                                "sense_id": "4812360f-15fb-3816-9054-cce4c2c9a866",
                                                "text": "Our Public Schools... (by which phrase we never mean real public schools like the Board schools at all, but merely schools for the upper and middle classes) are in their existing stage primarily great gymnasiums."
                                            },
                                            {
                                                "example_id": "acbde8c9-4e1b-4c80-bcf6-268bd063b455",
                                                "sense_id": "4812360f-15fb-3816-9054-cce4c2c9a866",
                                                "text": "Who is there who has not jeered at the House of Lords, the military caste, the Royal Family, the public schools, the huntin′ and shootin′ people, the old ladies in Cheltenham boarding houses, the horrors of ‘county’ society and the social hierarchy generally?"
                                            },
                                            {
                                                "example_id": "fe901011-61c7-4163-86cb-f5e6b60189a2",
                                                "sense_id": "4812360f-15fb-3816-9054-cce4c2c9a866",
                                                "text": "It turned out she was posh, or posh-ish, having been to a public school somewhere in Hampshire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c16ee8-ba87-364f-aa2b-474eff13cf7b",
                                        "entry_id": "73ad6b2e-c765-39b7-a849-2d2cd56c572f",
                                        "glosses": [
                                            "A college or university"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61672449-451d-480a-a8be-aadce9584908",
                                                "sense_id": "03c16ee8-ba87-364f-aa2b-474eff13cf7b",
                                                "text": "Thither [to Douai] he went, where after a yeres great diligence and many excercises done booth in house and publike scholes, he proceded bachilier of diuinitie."
                                            },
                                            {
                                                "example_id": "3a4912d8-76f0-46d0-bd4e-5b8908ccde72",
                                                "sense_id": "03c16ee8-ba87-364f-aa2b-474eff13cf7b",
                                                "text": "ante''' 1593, Christopher Marlowe, Tragicall Hist. Faustus (1604), sig. A3v\nIle haue them fill the publike schooles with skill. Wherewith the students shal be brauely clad."
                                            },
                                            {
                                                "example_id": "4ecc799a-fe2e-41f5-8222-aa75ee0f44f8",
                                                "sense_id": "03c16ee8-ba87-364f-aa2b-474eff13cf7b",
                                                "text": "That which is now called an University, is a Joyning together, and an Incorporation under one Government of many Publique Schools, in one and the same Town or City."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                        "entry_id": "73ad6b2e-c765-39b7-a849-2d2cd56c572f",
                                        "glosses": [
                                            "A publicly funded and administered school; (UK, Ireland) such schools in the context of other countries"
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "New-Zealand",
                                            "Philippines",
                                            "South-Africa",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d0e80d-4ace-4626-a7e3-c7e68e38dbba",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "The Court voted for the erecting a Publick Schooll or Colledge in Cambridge."
                                            },
                                            {
                                                "example_id": "8ed3cea0-1620-4776-8969-b32b603f464b",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "The Governor and Provincial Council shall erect and order all public Schooles."
                                            },
                                            {
                                                "example_id": "d7b56769-8122-4941-9604-dd67aae62c2f",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "By Act of Parliament no school is to be kept within two miles of a publick school."
                                            },
                                            {
                                                "example_id": "6746ace8-0d60-4916-b322-03fb4596f4f0",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "A subscription... by a great part of the settlers and others to build a Public School at the Green Hills."
                                            },
                                            {
                                                "example_id": "a44aae3e-35c7-4816-a1dd-daf7e991f2cd",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "Hardly anywhere in France... can the private boys' schools, whether they be lay or congreganist, hold their own in the competition with the public schools."
                                            },
                                            {
                                                "example_id": "dfa9885d-9c8e-4cd4-af89-3f92ea8c9e26",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "Every school under the management of the school board of a parish shall be deemed a parish school, and every school under the management of the school board of a burgh shall be deemed a burgh school, and all such schools are hereby declared to be public schools within the meaning of this Act."
                                            },
                                            {
                                                "example_id": "ac436481-834c-4705-a975-b273f1a043f3",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "Public Schools... are distinguished from those which until recently were entitled Grammar Schools."
                                            },
                                            {
                                                "example_id": "9e6ed986-e68c-442e-8a54-b59d83961cf0",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "As to the two races involved in this question of public schools the difference is this: the negroes do not wish mixed schools; the white people will not have them."
                                            },
                                            {
                                                "example_id": "e1c3970d-7392-4187-8ece-bfb9d0db3da5",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "If our public schools fail to furnish an education fully as good as can be obtained in private schools, intelligent, conscientious, and well-to-do parents will withdraw their children."
                                            },
                                            {
                                                "example_id": "3e4ae39c-4441-4eb0-8f66-8848fda18c8c",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "Public Schools. Course of Instruction... Class III. To include at least reading, writing, arithmetic, outlines of history and geography, and lessons on natural objects."
                                            },
                                            {
                                                "example_id": "9f750df1-7c16-4efd-8792-3c1277f09eeb",
                                                "sense_id": "e784d36e-9be6-370a-bf19-79fbafc4dbf7",
                                                "text": "The term ‘public school’ has a different connotation in New Zealand. It implies the Borough or County school; the school provided by the State."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
