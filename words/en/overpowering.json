                            },
                            {
                                "target_lang_word": "irresistibile",
                                "target_lang_sense_clarification": "detto di un impulso o desiderio a cui non si può resistere"
                            },
                            {
                                "target_lang_word": "insopportabile",
                                "target_lang_sense_clarification": "detto di un odore o dolore intollerabile"
                            },
                            {
                                "target_lang_word": "sopraffacente",
                                "target_lang_sense_clarification": "che travolge o sovrasta completamente"
                            }
                        ]
                    }
                }
            ]
        },
        {
