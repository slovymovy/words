                    "sense_id": "c9687f46-1b56-36b9-86d5-ef9e91e8c79a",
                    "sense_definition": "Impossible to avoid or escape from.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unavoidable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is an <w>inescapable</w> fact that we must finish this project by tomorrow.",
                            "target_lang_translations": {
                                "nl": "Het is een <w>onontkoombaar</w> feit dat we dit project morgen af moeten hebben."
                            }
                        },
                        {
                            "text": "The <w>inescapable</w> conclusion is that the company will have to close down.",
                            "target_lang_translations": {
                                "nl": "De <w>onvermijdelijke</w> conclusie is dat het bedrijf zal moeten sluiten."
                            }
                        }
                    ],
                    "synonyms": [
                        "inevitable",
                        "unavoidable"
                    ],
                    "antonyms": [
                        "escapable",
                        "evitable"
                    ],
                    "common_phrases": [
                        "inescapable fact",
                        "inescapable conclusion"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets waaraan niet te ontsnappen valt of wat niet vermeden kan worden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onontkoombaar",
                                "target_lang_sense_clarification": "Iets waar je niet aan kunt ontkomen; vaak gebruikt voor feiten of conclusies."
                            },
                            {
                                "target_lang_word": "onvermijdelijk",
                                "target_lang_sense_clarification": "Iets dat zeker zal gebeuren en niet tegengehouden kan worden."
