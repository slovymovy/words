                "senses": [
                    {
                        "sense_id": "02e06f1d-fa6e-3812-9981-419f4e4977d4",
                        "entry_id": "90279a35-bb19-3a0e-b154-5f2ab278ba62",
                        "glosses": [
                            "Stunde, in der gearbeitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a237685-6936-4d80-8beb-447ce544e620",
                                "sense_id": "02e06f1d-fa6e-3812-9981-419f4e4977d4",
                                "text": "„Dabei sanken gleichzeitig sowohl die Zahl der bezahlten Arbeitsstunden insgesamt als auch die Stundensätze.“"
                            },
                            {
                                "example_id": "97942456-b553-4fb2-bf5f-77bdd324c4d7",
                                "sense_id": "02e06f1d-fa6e-3812-9981-419f4e4977d4",
                                "text": "„Er erläuterte. Entschuldigte sich dafür, daß von den vier täglichen Arbeitsstunden glatt zwei fürs Putzen draufgingen, eine Stunde etwa wäre Büroarbeit, na und die vierte Stunde?“"
                            },
                            {
                                "example_id": "e33b2d1f-676e-4912-9044-8a77104358da",
                                "sense_id": "02e06f1d-fa6e-3812-9981-419f4e4977d4",
                                "text": "„Ich verdrängte den Gedanken rasch, schließlich waren Bens und meine Stunden wortwörtlich gezählt, in Form von Arbeitsstunden, die ich seiner Bibliothek in Rechnung stellen würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
