                "senses": [
                    {
                        "sense_id": "7bf391ad-55fc-357e-842f-88e0936deb8d",
                        "entry_id": "d01c7915-170e-3867-9ae6-00626e5df1fd",
                        "glosses": [
                            "Dienstwagen der Polizei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25f7719-22cd-41a5-b679-e86719181aa6",
                                "sense_id": "7bf391ad-55fc-357e-842f-88e0936deb8d",
                                "text": "„In der Nacht auf Freitag ist ein 22-Jähriger in Wien-Neubau mit seinem Pkw mit 100 km/h und schwer betrunken in ein Polizeiauto gekracht.“"
                            },
                            {
                                "example_id": "a76fe0aa-ba79-454f-bd3a-e9ca88c835bf",
                                "sense_id": "7bf391ad-55fc-357e-842f-88e0936deb8d",
                                "text": "„Die Polizistin saß bei dem Unfall als Beifahrerin in einem Polizeiauto und erlitt unter anderem einen Beckenbruch.“"
                            },
                            {
                                "example_id": "3d3521ef-6297-43c2-b81c-a9e736edf280",
                                "sense_id": "7bf391ad-55fc-357e-842f-88e0936deb8d",
                                "text": "„Am selben Abend kurz vorm Schlafengehn kamen Leute von der Obrigkeit in Polizeiautos und holten die portugiesischen Sardinen und den Dänischen Lehm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
