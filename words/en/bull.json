    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48c0c6ff-d9ec-3598-8239-a24497ba376b",
                    "sense_definition": "An adult male of domesticated cattle, especially one that has not been castrated.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bovine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer kept a large <w>bull</w> in the field to breed with the cows.",
                            "target_lang_translations": {
                                "ru": "Фермер держал в поле большого <w>быка</w> для разведения с коровами."
                            }
                        },
                        {
                            "text": "A <w>bull</w> can be very aggressive if it feels its territory is threatened.",
                            "target_lang_translations": {
                                "ru": "<w>Бык</w> может быть очень агрессивным, если чувствует угрозу своей территории."
                            }
                        }
                    ],
                    "synonyms": [
                        "gentleman cow"
                    ],
                    "common_phrases": [
                        "angry bull",
                        "breeding bull"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрослый самец домашнего скота, особенно не кастрированный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бык",
                                "target_lang_sense_clarification": "самец коровы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9b16110-a951-3d79-b897-f1c0b3a70b09",
                    "sense_definition": "An adult male of certain other large mammals, such as elephants, whales, or seals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_males",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bull</w> elephant led the herd toward the watering hole.",
                            "target_lang_translations": {
                                "ru": "<w>Самец</w> слона вел стадо к водопою."
                            }
                        },
                        {
                            "text": "A large <w>bull</w> seal was seen guarding his harem on the beach.",
                            "target_lang_translations": {
                                "ru": "Видели, как крупный <w>самец</w> тюленя охранял свой гарем на пляже."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bull elephant",
                        "bull whale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрослый самец некоторых других крупных млекопитающих, таких как слоны, киты или тюлени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самец",
                                "target_lang_sense_clarification": "мужская особь животного"
                            },
                            {
                                "target_lang_word": "бык",
                                "target_lang_sense_clarification": "самец крупных животных, например, слона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a41c434-3da4-3ca7-987f-e134aaea82ae",
                    "sense_definition": "An investor who buys stocks or commodities because they expect prices to rise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bulls</w> are hoping the new economic policy will drive the market higher.",
                            "target_lang_translations": {
                                "ru": "<w>Быки</w> надеются, что новая экономическая политика подтолкнет рынок вверх."
                            }
                        },
                        {
                            "text": "In a rising market, every <w>bull</w> feels confident about their investments.",
                            "target_lang_translations": {
                                "ru": "На растущем рынке каждый <w>бык</w> чувствует уверенность в своих инвестициях."
                            }
                        }
                    ],
                    "antonyms": [
                        "bear"
                    ],
                    "common_phrases": [
                        "market bull"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инвестор, который покупает акции или товары в ожидании роста цен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бык",
                                "target_lang_sense_clarification": "биржевой игрок на повышение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d9ea663-407e-303b-bfba-58c1fcba86b2",
                    "sense_definition": "Nonsense or lies; often used as a shorter form of a more vulgar term.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to him; everything he says is just a load of <w>bull</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай его; всё, что он говорит — просто куча <w>чуши</w>."
                            }
                        },
                        {
                            "text": "I knew his excuse was pure <w>bull</w> the moment he started talking.",
                            "target_lang_translations": {
                                "ru": "Я понял, что его оправдание — чистая <w>брехня</w>, как только он начал говорить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "load of bull",
                        "pure bull"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often a euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чепуха или ложь; часто используется как сокращенная форма более грубого выражения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "ерунда, бред"
                            },
                            {
                                "target_lang_word": "брехня",
                                "target_lang_sense_clarification": "ложь, выдумки"
                            },
                            {
                                "target_lang_word": "туфта",
                                "target_lang_sense_clarification": "подделка, обман"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df6908a1-7c9b-33e1-b838-5730ea291c30",
                    "sense_definition": "An official document or edict issued by the Pope.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "documents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian studied the medieval papal <w>bull</w> to understand the church's decree.",
                            "target_lang_translations": {
                                "ru": "Историк изучал средневековую папскую <w>буллу</w>, чтобы понять церковный указ."
                            }
                        },
                        {
                            "text": "A new <w>bull</w> was issued to clarify the rules of the religious order.",
                            "target_lang_translations": {
                                "ru": "Была издана новая <w>булла</w>, разъясняющая правила религиозного ордена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "papal bull"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный документ или указ, изданный Папой Римским."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "булла",
                                "target_lang_sense_clarification": "папский указ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d64aff5-00be-39b4-9008-5e589792fa13",
                    "sense_definition": "A police officer or detective.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The railroad <w>bulls</w> were known for being tough on anyone hitching a ride.",
                            "target_lang_translations": {
                                "ru": "Железнодорожные <w>легавые</w> были известны своей суровостью к любителям ездить зайцем."
                            }
                        },
                        {
                            "text": "He kept a sharp eye out for any <w>bull</w> patrolling the docks.",
                            "target_lang_translations": {
                                "ru": "Он внимательно следил, не патрулирует ли доки какой-нибудь <w>мент</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cop",
                        "copper",
                        "pig"
                    ],
                    "common_phrases": [
                        "railroad bull"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полицейский или детектив."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мент",
                                "target_lang_sense_clarification": "жаргонное обозначение полицейского"
                            },
                            {
                                "target_lang_word": "лягавый",
                                "target_lang_sense_clarification": "презрительное название сыщика"
                            },
                            {
                                "target_lang_word": "фараон",
                                "target_lang_sense_clarification": "устаревший сленг для полиции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "db0433ab-faf5-3ed0-a116-c8b34edfe9ef",
                    "sense_definition": "Relating to a market in which share prices are rising, encouraging buying.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors are excited because we are currently in a <w>bull</w> market.",
                            "target_lang_translations": {
                                "ru": "Инвесторы воодушевлены, потому что сейчас мы находимся на <w>бычьем</w> рынке."
                            }
                        },
                        {
                            "text": "The <w>bull</w> run has lasted for several months, reaching record highs.",
                            "target_lang_translations": {
                                "ru": "<w>Бычий</w> тренд длится уже несколько месяцев, достигая рекордных максимумов."
                            }
                        }
                    ],
                    "antonyms": [
                        "bear"
                    ],
                    "common_phrases": [
                        "bull market",
                        "bull run"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к рынку, на котором цены на акции растут, что стимулирует покупки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бычий",
                                "target_lang_sense_clarification": "о рынке с растущими ценами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53a82e36-3f79-3a60-9060-b2ead406ed63",
                    "sense_definition": "Being an adult male of certain large animals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_males",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bull</w> elephant was much larger than the females in the group.",
                            "target_lang_translations": {
                                "ru": "<w>Самец</w> слона был намного крупнее самок в группе."
                            }
                        },
                        {
                            "text": "We spotted a <w>bull</w> moose standing near the edge of the forest.",
                            "target_lang_translations": {
                                "ru": "Мы заметили <w>самца</w> лося, стоящего у края леса."
                            }
                        }
                    ],
                    "synonyms": [
                        "male"
                    ],
                    "antonyms": [
                        "female"
                    ],
                    "common_phrases": [
                        "bull elephant",
                        "bull moose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Являющийся взрослым самцом определенных крупных животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самец",
                                "target_lang_sense_clarification": "мужского пола (о животном)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c70a39b8-e57a-3163-b55c-816ac337cc68",
                    "sense_definition": "Large and strong, resembling a bull in physical power.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>bull</w> neck and shoulders that made him look very intimidating.",
                            "target_lang_translations": {
                                "ru": "У него была <w>бычья</w> шея и плечи, которые придавали ему очень устрашающий вид."
                            }
                        },
                        {
                            "text": "The wrestler's <w>bull</w> strength allowed him to lift his opponent easily.",
                            "target_lang_translations": {
                                "ru": "<w>Бычья</w> сила борца позволяла ему легко поднимать противника."
                            }
                        }
                    ],
                    "synonyms": [
                        "beefy",
                        "robust"
                    ],
                    "antonyms": [
                        "weak",
                        "puny",
                        "feeble"
                    ],
                    "common_phrases": [
                        "bull neck"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный и сильный, напоминающий быка своей физической мощью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бычий",
                                "target_lang_sense_clarification": "мощный, как у быка"
                            },
                            {
                                "target_lang_word": "дюжий",
                                "target_lang_sense_clarification": "очень сильный"
                            },
                            {
                                "target_lang_word": "бычара",
                                "target_lang_sense_clarification": "физически крепкий человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "056a3dbd-9ca3-386a-aa15-fa97a49642f8",
                    "sense_definition": "To move or push forward in a determined or aggressive way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>bulled</w> his way through the crowd to get to the front.",
                            "target_lang_translations": {
                                "ru": "Он <w>пробился</w> сквозь толпу, чтобы выйти вперед."
                            }
                        },
                        {
                            "text": "The player <w>bulled</w> past the defenders to score a goal.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>пропер</w> мимо защитников, чтобы забить гол."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bull through",
                        "bull one's way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или проталкиваться вперед решительным или агрессивным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преть",
                                "target_lang_sense_clarification": "напролом, настойчиво двигаться"
                            },
                            {
                                "target_lang_word": "пробиваться",
                                "target_lang_sense_clarification": "с силой проходить сквозь что-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57b082ef-d0bd-36a2-8e47-cb474a3fd7bf",
                    "sense_definition": "To try to cause a rise in the price of a stock or market.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Speculators tried to <w>bull</w> the market by spreading positive rumors.",
                            "target_lang_translations": {
                                "ru": "Спекулянты пытались <w>играть на повышение</w> рынка, распространяя позитивные слухи."
                            }
                        },
                        {
                            "text": "The group attempted to <w>bull</w> the price of the tech stocks.",
                            "target_lang_translations": {
                                "ru": "Группа пыталась <w>поднять</w> цену на акции технологических компаний."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bull the market"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться вызвать рост цен на акции или на рынке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть на повышение",
                                "target_lang_sense_clarification": "стимулировать рост цен"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d167e12d-fa29-3504-bcd8-2dfd4c4ec295",
                    "sense_definition": "A surname derived from the animal's name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "John <w>Bull</w> is often used as a personification of the English nation.",
                            "target_lang_translations": {
                                "ru": "Джон <w>Булль</w> часто используется как олицетворение английской нации."
                            }
                        },
                        {
                            "text": "The local library was named after the philanthropist Sarah <w>Bull</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Сары <w>Булл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от названия животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Булл",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}