{
    "word_family": [
        "scorch",
        "scorcher",
        "scorchingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "056f0455-8e93-3e67-8026-46091ba90b46",
                    "sense_definition": "Extremely hot; burning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "heat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to stay indoors during the afternoon because of the <w>scorching</w> sun.",
                            "target_lang_translations": {
                                "zh": "因为下午<w>炽热的</w>阳光，我们决定待在室内。"
                            }
                        },
                        {
                            "text": "The athletes struggled to finish the marathon in the <w>scorching</w> heat.",
                            "target_lang_translations": {
                                "zh": "运动员们在<w>酷热的</w>高温中艰难完成了马拉松。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blistering",
                        "baking",
                        "roasting",
                        "sweltering"
                    ],
                    "antonyms": [
                        "freezing",
                        "frigid",
                        "chilly"
                    ],
                    "common_phrases": [
                        "scorching heat",
                        "scorching sun"
                    ],
                    "target_lang_definitions": {
                        "zh": "极热的；灼热的，酷热的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灼热的",
                                "target_lang_sense_clarification": "像火烧一样热"
                            },
                            {
                                "target_lang_word": "酷热的",
                                "target_lang_sense_clarification": "极度炎热的气候或温度"
                            },
                            {
                                "target_lang_word": "炽热的",
                                "target_lang_sense_clarification": "极热、温度极高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36ad1760-ea19-37ea-be83-81a1542d5281",
                    "sense_definition": "Very fast; blisteringly quick.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sprinter finished the race at a <w>scorching</w> pace.",
                            "target_lang_translations": {
                                "zh": "这位短跑运动员以<w>极快的</w>配速跑完了比赛。"
                            }
                        },
                        {
                            "text": "He set a new record by driving at a <w>scorching</w> speed on the track.",
                            "target_lang_translations": {
                                "zh": "他在赛道上以<w>疾速的</w>车速刷新了纪录。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blistering",
                        "breakneck"
                    ],
                    "antonyms": [
                        "sluggish"
                    ],
                    "common_phrases": [
                        "scorching pace",
                        "scorching speed"
                    ],
                    "target_lang_definitions": {
                        "zh": "极快的；疾速的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "极快的",
                                "target_lang_sense_clarification": "速度飞快"
                            },
                            {
                                "target_lang_word": "疾速的",
                                "target_lang_sense_clarification": "速度惊人"
                            },
                            {
                                "target_lang_word": "飞快的",
                                "target_lang_sense_clarification": "行动或节奏飞速"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7634f89e-22d9-33e9-af4b-662784936b73",
                    "sense_definition": "Harshly critical; bitterly sarcastic or withering.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reviewer published a <w>scorching</w> attack on the director's new movie.",
                            "target_lang_translations": {
                                "zh": "评论家发表了一篇对该导演新电影的<w>猛烈</w>抨击。"
                            }
                        },
                        {
                            "text": "She delivered a <w>scorching</w> critique that left the committee completely speechless.",
                            "target_lang_translations": {
                                "zh": "她发表了<w>严厉的</w>批评，让委员会哑口无言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scathing",
                        "withering",
                        "blistering",
                        "searing"
                    ],
                    "antonyms": [
                        "complimentary",
                        "praising"
                    ],
                    "common_phrases": [
                        "scorching attack",
                        "scorching critique"
                    ],
                    "target_lang_definitions": {
                        "zh": "尖锐猛烈的；严厉批评的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "严厉的",
                                "target_lang_sense_clarification": "批评非常尖锐刻薄"
                            },
                            {
                                "target_lang_word": "猛烈的",
                                "target_lang_sense_clarification": "抨击势头强劲"
                            },
                            {
                                "target_lang_word": "尖刻的",
                                "target_lang_sense_clarification": "言辞尖锐不留情面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f4b68ae-bc47-38c2-b09b-dea017a27022",
                    "sense_definition": "Extremely attractive; sexually appealing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attractiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors shared several <w>scorching</w> scenes throughout the romantic thriller.",
                            "target_lang_translations": {
                                "zh": "在这部浪漫惊悚片中，演员们共同出演了好几场<w>火辣的</w>戏份。"
                            }
                        },
                        {
                            "text": "Critics praised the couple for their <w>scorching</w> chemistry on screen.",
                            "target_lang_translations": {
                                "zh": "影评人称赞这对情侣在银幕上展现出<w>火辣的</w>化学反应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steamy",
                        "sizzling"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe sexual appeal or chemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "火辣的；极具性吸引力的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "火辣的",
                                "target_lang_sense_clarification": "形容激情、性感或富有性吸引力"
                            },
                            {
                                "target_lang_word": "热辣的",
                                "target_lang_sense_clarification": "充满激情和吸引力"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aef674ea-66e2-3266-aa6a-828a4c92d54a",
                    "sense_definition": "Present participle of <w>scorch</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flames were rapidly <w>scorching</w> the grass behind the old barn.",
                            "target_lang_translations": {
                                "zh": "火焰正在迅速<w>烧焦</w>旧谷仓后面的草地。"
                            }
                        },
                        {
                            "text": "She accidentally dropped the iron on the shirt, <w>scorching</w> the collar.",
                            "target_lang_translations": {
                                "zh": "她不小心把熨斗掉在衬衫上，<w>烫焦</w>了领子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "singeing",
                        "charring"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "烧焦，烤焦（scorch 的现在分词形式）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "烧焦",
                                "target_lang_sense_clarification": "使表面变焦"
                            },
                            {
                                "target_lang_word": "烫焦",
                                "target_lang_sense_clarification": "因受热而变焦"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de988cc6-a7eb-3cde-8a35-318766905cb6",
                    "sense_definition": "The act of superficial burning, or a superficial burn mark produced by heat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Careful inspection of the fabric revealed faint <w>scorchings</w> from the hot iron.",
                            "target_lang_translations": {
                                "zh": "仔细检查织物后，发现了热熨斗留下的淡淡<w>烫痕</w>。"
                            }
                        },
                        {
                            "text": "Repeated <w>scorchings</w> caused noticeable damage to the wooden surface.",
                            "target_lang_translations": {
                                "zh": "反复的<w>焦痕</w>对木质表面造成了明显的损伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "burns",
                        "singes"
                    ],
                    "target_lang_definitions": {
                        "zh": "烧焦的痕迹；焦痕"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "焦痕",
                                "target_lang_sense_clarification": "受热表面留下的烧焦印记"
                            },
                            {
                                "target_lang_word": "烫痕",
                                "target_lang_sense_clarification": "被高温烫出的痕迹"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}