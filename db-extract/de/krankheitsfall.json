                ],
                "senses": [
                    {
                        "sense_id": "a4d94782-b42b-3b83-9b48-864b72d33a7a",
                        "entry_id": "25bee852-6f03-3986-87bc-d110ed18daa9",
                        "glosses": [
                            "Situation (Fall), in der eine Erkrankung (Krankheit) festgestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ede4fb5-47ba-4c44-bc51-61df14bd9abe",
                                "sense_id": "a4d94782-b42b-3b83-9b48-864b72d33a7a",
                                "text": "„Die Zahl der Krankheitsfälle beim Menschen schwankt von Jahr zu Jahr, vermutlich je nachdem wie hoch der Bestand der Nager ist und wie viele Tiere das Virus in sich tragen.“"
                            },
                            {
                                "example_id": "3e3b6156-d389-4fb2-b718-d90c31122ce6",
                                "sense_id": "a4d94782-b42b-3b83-9b48-864b72d33a7a",
                                "text": "„Ein Anspruch auf Lohnfortzahlung (Entgeltfortzahlung) im Krankheitsfall besteht nur dann, wenn der Arbeitnehmer ausschließlich in Folge einer Krankheit arbeitsunfähig ist und wenn ihn hinsichtlich der Erkrankung kein Verschulden trifft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
