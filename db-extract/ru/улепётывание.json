                                    },
                                    {
                                        "sense_id": "b130525f-f557-3812-8163-9c907eaaf6b6",
                                        "entry_id": "1e733962-3b29-3ca0-aa08-6d6d44cb6a28",
                                        "glosses": [
                                            "A trip made by an aircraft, particularly one between two cities or countries, which is often planned or reserved in advance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2810d64b-8126-4307-8fb7-428245c22530",
                                                "sense_id": "b130525f-f557-3812-8163-9c907eaaf6b6",
                                                "text": "The flight to Paris leaves at 7 o'clock tonight."
                                            },
                                            {
                                                "example_id": "544ef24c-5d67-4e8d-8173-f7ca0e4debc1",
                                                "sense_id": "b130525f-f557-3812-8163-9c907eaaf6b6",
                                                "text": "Where is the departure gate for flight 747? / Go straight down and to the right."
                                            },
                                            {
                                                "example_id": "5e6ea6ae-78c6-4a36-98c7-a0ddf6f8d601",
                                                "sense_id": "b130525f-f557-3812-8163-9c907eaaf6b6",
                                                "text": "He is taking the 5 o' clock flight to London in the morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d813cf3d-9fa8-3afe-adcc-f98b5ceacae9",
                                        "entry_id": "1e733962-3b29-3ca0-aa08-6d6d44cb6a28",
                                        "glosses": [
                                            "A series of stairs between landings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b3eb282-952c-4ac7-a3bb-e934afc2a19c",
                                                "sense_id": "d813cf3d-9fa8-3afe-adcc-f98b5ceacae9",
                                                "text": "She crept up the stairs [...] On she went, across the landing, from which sprang the tall window, and up the next flight until she reached the top."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a95191c-f367-375c-b48e-e9c15ebfd14f",
                                        "entry_id": "1e733962-3b29-3ca0-aa08-6d6d44cb6a28",
                                        "glosses": [
                                            "A group of canal locks with a short distance between them"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25a43009-dc45-31f9-bb50-24e5b92f9430",
                                        "entry_id": "1e733962-3b29-3ca0-aa08-6d6d44cb6a28",
                                        "glosses": [
                                            "A floor which is reached by stairs or escalators."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01708d95-8791-49e8-b9c8-ef7d34a4d52e",
                                                "sense_id": "25a43009-dc45-31f9-bb50-24e5b92f9430",
                                                "text": "How many flights is it up?"
