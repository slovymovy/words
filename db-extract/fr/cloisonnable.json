                        "glosses": [
                            "Qui peut être divisé en plusieurs espaces, grâce à des cloisons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee56798c-ea11-4e95-b8bd-63076855bf0d",
                                "sense_id": "1a0fd61d-6507-3c38-b216-9e20d4815d70",
                                "text": "La conversion au christianisme a provoqué une sécularisation de la notion d’espace, désormais présentée comme homogène et donc cloisonnable, ce qui a provoqué une rupture fondamentale."
                            },
                            {
                                "example_id": "4f68e786-0de6-4ad9-9dba-9163051a2112",
                                "sense_id": "1a0fd61d-6507-3c38-b216-9e20d4815d70",
                                "text": "Cette même salle servira aux conseils municipaux et à d’autres réunions puisqu’elle est cloisonnable."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b36c005-b0c5-35af-93cb-c9ddaf0570fc",
                        "entry_id": "ad674107-37d5-36a8-8e47-ed4c236b1714",
                        "glosses": [
                            "Qui peut être séparé par une ou des cloisons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9fb8208-4015-4d90-b60f-a7d379ae0826",
                                "sense_id": "1b36c005-b0c5-35af-93cb-c9ddaf0570fc",
                                "text": "Le projet lauréat prévoit des services potentiellement cloisonnables et isolés par des entrées séparées."
                            },
                            {
                                "example_id": "3e2fdc27-4644-4e0d-9629-c7f233262420",
                                "sense_id": "1b36c005-b0c5-35af-93cb-c9ddaf0570fc",
                                "text": "De la même façon séparer le pitch de la vente, comme si c’était deux sujets cloisonnables, c’est juste affligeant."
                            }
                        ]
