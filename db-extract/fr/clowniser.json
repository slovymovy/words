                "senses": [
                    {
                        "sense_id": "fc558cdc-3bdd-3d39-b71b-17ddc8361472",
                        "entry_id": "2c996985-3a70-314a-834a-979122e0546e",
                        "glosses": [
                            "Donner un caractère de clown à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ce531fd-3c37-467a-bf03-267fe0fe8b60",
                                "sense_id": "fc558cdc-3bdd-3d39-b71b-17ddc8361472",
                                "text": "Il ne cherche pas à changer, à maquiller et clowniser l'Algérien pour le rendre meilleur."
                            },
                            {
                                "example_id": "a6bf3668-c85f-4c8f-a2a0-bb9fdfc90fca",
                                "sense_id": "fc558cdc-3bdd-3d39-b71b-17ddc8361472",
                                "text": "Ne les laissons pas clowniser le gouvernement d'Alexis Tsipras!"
                            },
                            {
                                "example_id": "8d4be32f-29a4-484b-9112-cee6a8af6ba6",
                                "sense_id": "fc558cdc-3bdd-3d39-b71b-17ddc8361472",
                                "text": "Aussi devons-nous nous vacciner en amont contre la catastrophe ; aussi devons-nous nous clowniser."
                            },
                            {
                                "example_id": "707d0058-66c5-4f4a-a493-e42672bd1a4a",
                                "sense_id": "fc558cdc-3bdd-3d39-b71b-17ddc8361472",
                                "text": "Donc, oui, Sarko est en train de se \"clowniser\"."
                            }
                        ]
                    }
