                                "sense_id": "e786dd4f-184e-3365-a13d-848839418565",
                                "text": "Deze kerk is gebouwd op de resten van een heidens heiligdom.",
                                "translation": "This church was built on top of the remains of a pagan place of worship.",
                                "english": "This church was built on top of the remains of a pagan place of worship."
                            },
                            {
                                "example_id": "b26039a3-029e-4e9d-aed7-534ffb7a05b9",
                                "sense_id": "e786dd4f-184e-3365-a13d-848839418565",
                                "text": "Ik mag niet in mijn moeders studeerkamer komen; dat is haar heiligdom.",
                                "translation": "I am not supposed to enter my mother's study; that's her sanctuary.",
                                "english": "I am not supposed to enter my mother's study; that's her sanctuary."
                            }
                        ]
                    }
