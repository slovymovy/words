                ],
                "senses": [
                    {
                        "sense_id": "8ff8ce83-4154-3225-b8c7-6d35c7d8cc3f",
                        "entry_id": "66be1080-f7ba-3f44-bd68-6a8886947483",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c4ddef7-c4f4-4746-84a3-19265e681355",
                                "sense_id": "8ff8ce83-4154-3225-b8c7-6d35c7d8cc3f",
                                "text": "Frau Manske ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fbf56be8-4728-490b-b3b3-d7471e669c1e",
                                "sense_id": "8ff8ce83-4154-3225-b8c7-6d35c7d8cc3f",
                                "text": "Herr Manske wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "93e5b76d-735d-46ef-819a-aaaef1d9cabf",
                                "sense_id": "8ff8ce83-4154-3225-b8c7-6d35c7d8cc3f",
                                "text": "Die Manskes fahren heute in den Teutoburger Wald."
                            },
                            {
                                "example_id": "d9656172-6d72-40e0-9d1c-aa24cf11a0cf",
                                "sense_id": "8ff8ce83-4154-3225-b8c7-6d35c7d8cc3f",
                                "text": "Der Manske trägt nie die Schals, die die Manske ihm strickt."
                            },
                            {
                                "example_id": "016addf2-14ab-470e-82f3-19a00a98dca5",
                                "sense_id": "8ff8ce83-4154-3225-b8c7-6d35c7d8cc3f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Manske kommt, geht der Herr Manske.“"
                            },
                            {
                                "example_id": "dcc0bcdb-6f3b-4102-a8a0-1ab73a302b23",
                                "sense_id": "8ff8ce83-4154-3225-b8c7-6d35c7d8cc3f",
                                "text": "Manske kommt und geht."
                            },
                            {
                                "example_id": "74cb6e11-dc5d-4d28-bca5-bb6de9ed605e",
                                "sense_id": "8ff8ce83-4154-3225-b8c7-6d35c7d8cc3f",
                                "text": "Manskes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
