                "senses": [
                    {
                        "sense_id": "93383c35-da34-3998-b564-46b2bbdedbc3",
                        "entry_id": "400129cd-76f3-3365-b5cc-7e9abae015c4",
                        "glosses": [
                            "zwischen zwei meist abgerichteten Hähnen ausgetragener Kampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc6103d8-b8b1-4806-a9a8-716ad383728b",
                                "sense_id": "93383c35-da34-3998-b564-46b2bbdedbc3",
                                "text": "Viele Zuschauer wohnten dem illegalen Hahnenkampf bei."
                            },
                            {
                                "example_id": "6f89934c-6a3b-44fc-82c6-98565787ecc3",
                                "sense_id": "93383c35-da34-3998-b564-46b2bbdedbc3",
                                "text": "„Wer die Spanier kennt, weiß, wie sehr sie den tödlichen Wettstreit lieben, von der Corrida bis zum Hahnenkampf.“"
                            },
                            {
                                "example_id": "b945ec8d-95a5-4e62-a9ba-0121c6ca6d1b",
                                "sense_id": "93383c35-da34-3998-b564-46b2bbdedbc3",
                                "text": "„Lieber beschäftigte er sich mit schönen Frauen, rauchte Opium und veranstaltete Hahnenkämpfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "70f0cb49-130c-3366-9302-1f602c8127be",
                        "entry_id": "400129cd-76f3-3365-b5cc-7e9abae015c4",
                        "glosses": [
                            "Streitigkeit zwischen Konkurrenten, meist Männern"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e04602fb-52d0-414b-ba5d-0d3f375df595",
                                "sense_id": "70f0cb49-130c-3366-9302-1f602c8127be",
                                "text": "„Nie in der Geschichte der Bundesrepublik gab es neben dem üblichen Hahnenkampf ein vergleichbares Hennenrennen aufs Kanzleramt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "167222bc-f668-4c75-b067-0b47932cb5c6",
                        "source_entry_id": "400129cd-76f3-3365-b5cc-7e9abae015c4",
