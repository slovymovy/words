                "senses": [
                    {
                        "sense_id": "e9871dc2-439e-3001-9fb9-badfb7df9930",
                        "entry_id": "518e3d00-ee44-39bf-ba81-a3175ab478d9",
                        "glosses": [
                            "weibliche Person, die eine bestimmte Sprache als Muttersprache erlernt hat und beherrscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea0b03ac-db2f-4427-838f-1361acef67ca",
                                "sense_id": "e9871dc2-439e-3001-9fb9-badfb7df9930",
                                "text": "„Als sie als junge Erwachsene zum ersten Mal in Deutschland war, kam ihr daher das Deutsche ganz geläufig, sie wurde für eine Muttersprachlerin gehalten.“"
                            },
                            {
                                "example_id": "06d2ed7f-fc03-43d1-82a3-0a1848ddf279",
                                "sense_id": "e9871dc2-439e-3001-9fb9-badfb7df9930",
                                "text": "„Wer die Aufnahme hört, kann kaum glauben, dass da eine Muttersprachlerin redet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
