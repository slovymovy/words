                "senses": [
                    {
                        "sense_id": "f4dda325-57c5-3438-abd1-987636db75b5",
                        "entry_id": "216af0b0-00c0-3c98-b9af-27e55514c164",
                        "glosses": [
                            "Donner un caractère de litanie à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f00eb1d-aba3-41e7-8a35-4f2fcf375036",
                                "sense_id": "f4dda325-57c5-3438-abd1-987636db75b5",
                                "text": "Ajoutons que beaucoup de ces néoverbes sont bien difficiles à prononcer; plus la peine de se coincer un crayon dans la bouche ou de « litaniser » les chaussettes de l’archiduchesse (moi aussi, je néologise, je néoverbalise, j’ai bien le droit), les néoverbes sont autant d’exercices pour l’apprenti comédien."
                            },
                            {
                                "example_id": "727f9c70-4126-423e-a95d-5a45c1a88740",
                                "sense_id": "f4dda325-57c5-3438-abd1-987636db75b5",
                                "text": "Et Viviane se met à m’injurier sans me regarder, et l’autre inconnue se met à litaniser sans que je puisse la voir puisqu’elle est enfouie sous les couvertures."
                            }
                        ]
                    }
                ],
