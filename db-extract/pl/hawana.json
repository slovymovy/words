                    {
                        "translation_id": "32c75715-4b5f-4c4a-8f5b-e2d3e995cf69",
                        "source_entry_id": "d5de8f14-c201-34e2-a6ab-692bf5a73fd7",
                        "source_sense_id": "c4d9db98-b28b-301a-839f-a180ba54babe",
                        "target_lang_word": "Havanna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Havanna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "820df2cf-4890-3ed7-b0c3-a7979c1da873",
                                        "entry_id": "d88545fd-6181-3012-82b8-78ea018a5663",
                                        "glosses": [
                                            "Hauptstadt von Kuba"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc140ca-d7dd-406d-9c62-5b8ef9b8a9d0",
                                                "sense_id": "820df2cf-4890-3ed7-b0c3-a7979c1da873",
                                                "text": "Die vollständige Bezeichnung von Havanna lautet: San Cristóbal de La Habana."
                                            },
                                            {
                                                "example_id": "1af17435-3385-430a-b4af-c5f2af505dcf",
                                                "sense_id": "820df2cf-4890-3ed7-b0c3-a7979c1da873",
                                                "text": "„Auf dem Wege zum Hafen kamen wir durch die Altstadt von Havanna, an deren engen Straßen noch einige gut erhaltene Patrizierhäuser aus der Kolonialzeit stehen, die von der Kathedrale, einem prachtvollen Barockbau aus dem 18. Jahrhundert, überragt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Havanna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b8eedec-eccd-373e-bb28-c50123cd149b",
                                        "entry_id": "5f3057ca-e03f-36e9-8c79-8c707b9bc3a4",
                                        "glosses": [
                                            "aus kubanischen Tabaken hergestellte Zigarre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f3eae97-81b7-431c-a972-c8ac8f736b7f",
                                                "sense_id": "6b8eedec-eccd-373e-bb28-c50123cd149b",
                                                "text": "„Jochen lehnte sich zurück, saugte an seiner Havanna, trank förmlich den Rauch.“"
                                            },
                                            {
                                                "example_id": "c2fdfbfe-2ff2-4e22-a640-1b9101ee0621",
                                                "sense_id": "6b8eedec-eccd-373e-bb28-c50123cd149b",
                                                "text": "„Der Alte betrachtete das rippenlose Deckblatt seiner Havanna, atmete den feinen Rauch ein und passte auf, dass die eineinhalb Zentimeter, die den vollkommenen Rauchgenuss garantierten, nicht abfielen.“"
                                            },
                                            {
                                                "example_id": "efbec53f-9497-4a5e-a434-96c46d110986",
                                                "sense_id": "6b8eedec-eccd-373e-bb28-c50123cd149b",
                                                "text": "„Bei Silver war es eine Brazil gewesen; hier eine echte Havanna.“"
                                            },
                                            {
                                                "example_id": "ba36f8ff-46cc-4f51-ae74-f7ae7ac23dfd",
                                                "sense_id": "6b8eedec-eccd-373e-bb28-c50123cd149b",
                                                "text": "„Sie zündeten sich jeder eine Havanna an und pafften zufrieden vor sich hin, während sie Anekdoten aus früheren Operationen zum Besten gaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Havanna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fde7688-cadb-31cd-b8f7-9cf6898865a2",
                                        "entry_id": "f4d27b75-2083-3d08-8aaf-ab4b17d2ced9",
                                        "glosses": [
                                            "hauptsächlich als Deckblatt bei der Herstellung von Zigarren verwendeter, feiner kubanischer Tabak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420f2741-b7fa-4ac4-8003-03dd3c824874",
                                                "sense_id": "8fde7688-cadb-31cd-b8f7-9cf6898865a2",
                                                "text": "„Im Nordosten Brasiliens gedeiht mit der ‚Flor de Brasil‘, jener Tabak, der neben dem Havanna zu den besten zählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
