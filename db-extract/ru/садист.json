                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9816b8f-32b0-44ae-82b0-cbaf46ca75aa",
                                                "sense_id": "558b23db-5f86-3046-b3f6-09d3c60f1ed1",
                                                "text": "W obozie zasłynął jako sadysta, który dopuścił się wielu zbrodni na umieszczonych tam dzieciach."
                                            }
