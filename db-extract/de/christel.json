                "senses": [
                    {
                        "sense_id": "021d921b-573e-3088-902b-733283bb5a16",
                        "entry_id": "22ea4b04-0881-30ba-be6d-d6f003660bd1",
                        "glosses": [
                            "weiblicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ce3aaa2-e561-423d-8d2d-c25420a03130",
                                "sense_id": "021d921b-573e-3088-902b-733283bb5a16",
                                "text": "Christel unterrichtet Erdkunde und Biologie an einem Gymnasium."
                            },
                            {
                                "example_id": "3ccea5f0-825b-4a84-ac65-5fe33c7f72b9",
                                "sense_id": "021d921b-573e-3088-902b-733283bb5a16",
                                "text": "Nie im Leben würde ich freiwillig mit der schwatzhaften Christel ins Allgäu fahren."
                            },
                            {
                                "example_id": "f5425a61-cc2a-417d-aa4e-5682901899c6",
                                "sense_id": "021d921b-573e-3088-902b-733283bb5a16",
                                "text": "Es bereitet Christel mit ihren 95 Jahren zunehmend Schwierigkeiten, den Gesprächen der anderen Bewohner des Altenheims zu folgen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
