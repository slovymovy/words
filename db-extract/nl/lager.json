                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5fcbea3-9176-30cc-a20c-cc80ce6f773f",
                                        "entry_id": "c2727a5e-e6d0-3763-b76b-91ce5b0773a5",
                                        "glosses": [
                                            "Of a beam, column, or other device, carrying weight or load."
                                        ],
                                        "tags": [
