                    {
                        "sense_id": "11a023e6-dd0d-3e27-ba83-9e533a11921f",
                        "entry_id": "8ab99529-258a-3fc6-be61-bd76dd96da8a",
                        "glosses": [
                            "to come to one's senses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "254e9135-6b09-4139-b870-771238d68bc7",
                                "sense_id": "11a023e6-dd0d-3e27-ba83-9e533a11921f",
                                "text": "заста́вить кого́-л оду́маться",
                                "translation": "to bring someone to someone's senses",
                                "english": "to bring someone to someone's senses"
                            },
                            {
                                "example_id": "46b5555b-2c28-4647-bfd2-c33083bd8c1b",
                                "sense_id": "11a023e6-dd0d-3e27-ba83-9e533a11921f",
                                "text": "когда́ же она́ наконе́ц оду́мается?",
                                "translation": "when will she come to her senses, after all?",
                                "english": "when will she come to her senses, after all?"
                            },
                            {
                                "example_id": "a5a05fc2-ae6f-4fdb-be82-1b8cab3fddee",
                                "sense_id": "11a023e6-dd0d-3e27-ba83-9e533a11921f",
                                "text": "не успе́л он оду́маться, как они́ ...",
                                "translation": "before he knew it, they ...",
                                "english": "before he knew it, they ..."
                            }
                        ]
                    }
                ],
