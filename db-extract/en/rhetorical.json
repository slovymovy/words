                        ]
                    },
                    {
                        "translation_id": "f8029372-52a3-4992-8e45-7b51d0786912",
                        "source_entry_id": "5deab6c0-bc26-3540-b7c7-674048b1964d",
                        "source_sense_description": "part of or similar to rhetoric",
                        "target_lang_word": "rhétorique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhétorique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81fd7451-36cb-32c6-9a72-5fccb1c106ae",
                                        "entry_id": "72f418cb-0882-3d86-8c23-22a9e1039c9f",
                                        "glosses": [
                                            "Oratoire, relatif à l’art de bien parler, relatif à la rhétorique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b73360-8400-454e-872f-22c899148297",
                                                "sense_id": "81fd7451-36cb-32c6-9a72-5fccb1c106ae",
                                                "text": "Les traités rhétoriques."
                                            },
                                            {
                                                "example_id": "700be00f-f5c8-4b26-88b3-ff27e77ee32f",
                                                "sense_id": "81fd7451-36cb-32c6-9a72-5fccb1c106ae",
                                                "text": "Une question rhétorique est une figure de style qui consiste à poser une question n’attendant pas de réponse."
                                            },
                                            {
                                                "example_id": "39eb87f3-40b5-44d9-9b0d-9bf4aaaf558d",
                                                "sense_id": "81fd7451-36cb-32c6-9a72-5fccb1c106ae",
                                                "text": "Ce concept a été mobilisé à des fins rhétoriques pour proclamer la fin de la pandémie et la levée des mesures barrières."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rhétorique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e029f364-368d-30c8-a6c7-8f37d75e9e3d",
                                        "entry_id": "42f674e4-7aed-36cc-ac75-9e97bd8c8887",
                                        "glosses": [
                                            "Science (au sens d’étude structurée) et art (au sens de pratique reposant sur un savoir éprouvé) qui se rapporte à l’action du discours sur les esprits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "861d074b-d1b0-4b4d-8d37-06f9a1d632d8",
                                                "sense_id": "e029f364-368d-30c8-a6c7-8f37d75e9e3d",
                                                "text": "Ainsi que Brunetière, il use d’un jargon scolard et sans souplesse, où voisinent Vaugelas et le P. Le Batteux. Il assemble de poussiéreux bouquets d’herbier et il les tend d’un air triomphant à la dame de ses pensées, à Synecdoche, à Catachrèse, à Hypallage. C’est le Don Juan des figures de rhétorique."
                                            },
                                            {
                                                "example_id": "b9ed65bf-0c3c-4a40-a080-245ae57ce572",
                                                "sense_id": "e029f364-368d-30c8-a6c7-8f37d75e9e3d",
                                                "text": "Une incroyable facilité lui permettait de déployer toutes les pompes de la rhétorique sur n’importe quel sujet, sans le moindre effort ni la moindre préparation."
                                            },
                                            {
                                                "example_id": "8d37607d-357c-45d6-87ef-ca2817a9a282",
                                                "sense_id": "e029f364-368d-30c8-a6c7-8f37d75e9e3d",
                                                "text": "Avec Aristote, la rhétorique devient une technique à part entière parce qu’elle est appuyée sur une éthique qui ne place pas l’efficacité au premier rang."
                                            },
                                            {
                                                "example_id": "2ccfaa61-0218-4622-a649-78401d58f582",
                                                "sense_id": "e029f364-368d-30c8-a6c7-8f37d75e9e3d",
                                                "text": "La rhétorique fut, dès son origine, une forme esthétisante du langage. L’esthétique faisant naturellement référence au sens, la rhétorique était cet art qui cherchait à convaincre non pas en s'appuyant sur la raison, mais en « faisant sensation »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eee44bd-60aa-3fcc-8d39-40b6f35f6cb5",
                                        "entry_id": "42f674e4-7aed-36cc-ac75-9e97bd8c8887",
                                        "glosses": [
                                            "Classe de lycée, équivalente à la première ^([DAF8]) actuelle, où on enseignait la rhétorique."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "note": "Existe encore en Belgique pour désigner la terminale",
                                        "examples": [
                                            {
                                                "example_id": "2585eeda-e827-4ddc-9c47-1016e134abb5",
                                                "sense_id": "3eee44bd-60aa-3fcc-8d39-40b6f35f6cb5",
                                                "text": "Sans doute il est à craindre que la rhétorique, c'est-à-dire l'art d'apprendre à écrire sans don naturel, ne continue à priver les jeunes gens d'une année heureuse, et cela sans aucun profit ni intellectuel, ni esthétique […]"
                                            },
                                            {
                                                "example_id": "38545941-44d3-4be3-986b-ef9264f67f8e",
                                                "sense_id": "3eee44bd-60aa-3fcc-8d39-40b6f35f6cb5",
                                                "text": "Les compliments de ce maire quand Pasteur obtint, à la fin de la rhétorique, plus de prix qu’il ne pouvait en porter ; les nouveaux conseils de Romanet réveillèrent l’ambition normalienne."
                                            },
                                            {
                                                "example_id": "f3bbdc10-9807-4a16-be16-2566ea3ba276",
                                                "sense_id": "3eee44bd-60aa-3fcc-8d39-40b6f35f6cb5",
                                                "text": "Si tu n’as fait ta rhétorique\nChez Satan, le rusé doyen,\nJette ! tu n’y comprendrais rien,\nOu tu me croirais hystérique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45dcdd59-0460-3872-b8e0-06bf607a7919",
                                        "entry_id": "42f674e4-7aed-36cc-ac75-9e97bd8c8887",
                                        "glosses": [
                                            "Classe de sixième secondaire où on enseigne la rhétorique. Équivalent de la terminale en France."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9029e96d-0d44-3a96-bad6-a19911bb660f",
                                        "entry_id": "42f674e4-7aed-36cc-ac75-9e97bd8c8887",
                                        "glosses": [
                                            "Sixième année du cours classique."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "note": "Le cours classique a été aboli vers la fin des années 1960",
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d965d23e-0a6e-399b-86c5-76562dcb05b7",
                                        "entry_id": "42f674e4-7aed-36cc-ac75-9e97bd8c8887",
                                        "glosses": [
                                            "Titre de certains traités de rhétorique."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "293fe9ca-b37c-41d0-a26f-c673537dea30",
                                                "sense_id": "d965d23e-0a6e-399b-86c5-76562dcb05b7",
                                                "text": "La rhétorique d’Aristote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7d45875-319c-334d-a63d-87fabe81687d",
                                        "entry_id": "42f674e4-7aed-36cc-ac75-9e97bd8c8887",
                                        "glosses": [
                                            "Tout ce qu’on emploie dans le discours pour persuader quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c50b39f-2c96-41c3-9972-582befe2bd1e",
                                                "sense_id": "b7d45875-319c-334d-a63d-87fabe81687d",
                                                "text": "Le fait est que chacun se réserve au profit de ce qu’il croit ses intérêts particuliers. Cela n’est pas nouveau. Était-ce bien la peine de se mettre en si grande dépense de rhétorique révolutionnaire depuis un siècle, pour aboutir à ce résultat."
                                            },
                                            {
                                                "example_id": "dae3625f-9467-4ede-a2c3-7b6c2b68c00b",
                                                "sense_id": "b7d45875-319c-334d-a63d-87fabe81687d",
                                                "text": "Jacqueline de Romilly lui emboîte le pas et donne elle aussi une définition tout aussi restrictive de l’agôn tragique :\n« Né de l’habitude du débat judiciaire, perfectionné par la rhétorique du temps, l’art de la joute oratoire était en plein essor. C’était ce qu’on appelait un agôn.[…]. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc44898-7518-3264-8c56-cb71d87374b5",
                                        "entry_id": "42f674e4-7aed-36cc-ac75-9e97bd8c8887",
                                        "glosses": [
                                            "Affectation d’éloquence, discours vain et pompeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0b86ea-0887-48f1-8194-68c0e272d1f4",
                                                "sense_id": "adc44898-7518-3264-8c56-cb71d87374b5",
                                                "text": "Les propagateurs de réformes sociales, les utopistes et les démocrates avaient fait un tel abus de la Justice qu'on était en droit de regarder toute dissertation sur un tel sujet comme un exercice de rhétorique ou comme une sophistique destinée à égarer les personnes qui s'occupaient du mouvement ouvrier."
                                            },
                                            {
                                                "example_id": "bca909af-50b6-49ce-96af-c45ea604c4bf",
                                                "sense_id": "adc44898-7518-3264-8c56-cb71d87374b5",
                                                "text": "L’abstraction devient la puissance de réflexion, l’inaction une capacité à formuler les problèmes, l’inadaptation une polyvalence, l’indécision la certitude de l'incertain, la rhétorique un agir communicationnel, la complication la conscience de la complexité et l’achiffrisme s'évanouit dans l'usage commune d'une règle de trois appliquée à une langue des affaires qu'on apprend comme n'importe quelle langue."
                                            },
                                            {
                                                "example_id": "9a428d47-1200-4621-b157-3c5a9ad245c9",
                                                "sense_id": "adc44898-7518-3264-8c56-cb71d87374b5",
                                                "text": "Ainsi la télévision publique est-elle un thème de débat, une posture obligée, une rhétorique de salon qui mériterait de figurer dans les mythologies des couches cultivées."
                                            },
                                            {
                                                "example_id": "e85f7c7f-bd99-43ab-80f6-f551af9194ff",
                                                "sense_id": "adc44898-7518-3264-8c56-cb71d87374b5",
                                                "text": "Pour simplifier, on peut comparer cela à un talk-show télévisé. À côté de notre animateur préféré se tiennent les combattants de la rhétorique, bien alignés pour s'interpeller à volonté. Parfois, ils parlent tous en même temps, tant et si bien qu'il est impossible d’y comprendre quoi que ce soit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "437ed254-ec47-4fb3-b83d-8b80b1014b50",
