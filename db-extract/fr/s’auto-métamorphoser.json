                        "glosses": [
                            "Se métamorphoser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9be37f1-1548-4d29-8962-a8a3653f1fb4",
                                "sense_id": "784e3565-868f-3958-82e1-47f3fd92026b",
                                "text": "Les organisations du secteur marchand peuvent-elles s'auto-métamorphoser en \"entrepreneurs innovants\" et \"producteurs efficaces\" de \"développement durable\" et de \"bien être collectif\" ?"
                            },
                            {
                                "example_id": "bf95fb12-f7aa-42d3-bd9a-0c4c5d05c2d9",
                                "sense_id": "784e3565-868f-3958-82e1-47f3fd92026b",
                                "text": "Je voudrais savoir s'il était possible en quelque sorte de ... s'auto-métamorphoser ?"
                            },
                            {
                                "example_id": "7bcc8acd-9b42-4b34-b29b-a0e46c2e33cc",
                                "sense_id": "784e3565-868f-3958-82e1-47f3fd92026b",
                                "text": "Les baguettes, uniquement sous hautes compétences, peuvent s'auto-métamorphoser quelques secondes."
                            }
                        ]
                    }
