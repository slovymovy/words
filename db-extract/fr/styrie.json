                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d5bbb7-afa5-4605-a6de-96ce11ae030c",
                                "sense_id": "35a49835-2ddf-3592-8510-f9140a520c9b",
                                "text": "Graz était la capitale de la Styrie, ce lui fut une occasion nouvelle d’étaler son érudition, parlant des Babenberg, prédécesseurs des Habsbourg, et de cet archiduc Johann qui aima tant Anna Plochi, la fille du maître de poste d’Aussee."
                            }
                        ]
                    }
                ],
