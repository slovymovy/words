                                "target_senses": [
                                    {
                                        "sense_id": "1e22e951-6527-3fe7-af9d-00693b295102",
                                        "entry_id": "9120735a-5b42-33d4-a10d-ab051b34a8f2",
                                        "glosses": [
                                            "Manía u obsesión por coleccionar libros."
                                        ],
                                        "tags": [],
