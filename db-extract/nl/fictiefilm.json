                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fddfc30-93d9-4e6f-8161-2c45a352d45f",
                                "sense_id": "2be1940e-7151-3368-af62-59e624b71b19",
                                "text": "\"Het is bijna iets uit een fictiefilm\", zegt media- en genderwetenschapper Linda Duits van de Universiteit Utrecht. \"Dat zoiets verschrikkelijks kan gebeuren - en dat de makers denken dat het oké is. Het betekent dat bij de productie van dat programma een cultuur is ontstaan waarbij je zó ver kunt gaan met het uitlokken van emotie.\""
                            },
                            {
                                "example_id": "d7514493-3e1f-49b1-b8a9-66586e203db8",
                                "sense_id": "2be1940e-7151-3368-af62-59e624b71b19",
                                "text": "Dat bevestigt de 27-jarige Floor van der Meulen, die met haar fictiefilm In Vrijheid genomineerd is voor een Gouden Kalf."
                            },
                            {
                                "example_id": "7a8d863d-d762-4656-92b3-22400302ad7d",
                                "sense_id": "2be1940e-7151-3368-af62-59e624b71b19",
                                "text": "De Nederlandse inzending voor Korte Fictiefilm is A Hole in My Heart, van regisseur Mees Peijnenburg."
                            }
                        ]
                    }
