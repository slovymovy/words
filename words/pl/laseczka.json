{
    "word_family": [
        "laska",
        "laseczek",
        "laseczkowaty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52191986-5896-334c-88f7-a9ac62f6f349",
                    "sense_definition": "atrakcyjna, ładna młoda kobieta lub dziewczyna",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "atrakcyjna kobieta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spójrz na tamtą dziewczynę, to naprawdę niezła <w>laseczka</w>.",
                            "target_lang_translations": {
                                "ru": "Посмотри на ту девушку, она реально классная <w>красотка</w>."
                            }
                        },
                        {
                            "text": "Marek zaczął się spotykać z taką jedną <w>laseczką</w> z sąsiedztwa.",
                            "target_lang_translations": {
                                "ru": "Марек начал встречаться с одной <w>цыпочкой</w> по соседству."
                            }
                        }
                    ],
                    "synonyms": [
                        "laska"
                    ],
                    "common_phrases": [
                        "niezła laseczka",
                        "fajna laseczka"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "używane potocznie w odniesieniu do kobiet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "привлекательная, красивая молодая женщина или девушка"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красотка",
                                "target_lang_sense_clarification": "о привлекательной девушке"
                            },
                            {
                                "target_lang_word": "цыпочка",
                                "target_lang_sense_clarification": "сленг, о молодой девушке"
                            },
                            {
                                "target_lang_word": "тёлочка",
                                "target_lang_sense_clarification": "грубый сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6a32634-44e2-33b1-9d66-dbbc5e252cff",
                    "sense_definition": "zdrobnienie od <w>laska</w>; mały, cienki kijek służący do podpierania się lub ozdoby",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przedmiot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starsza pani podpierała się elegancką <w>laseczką</w> podczas spaceru w parku.",
                            "target_lang_translations": {
                                "ru": "Пожилая дама опиралась на элегантную <w>тросточку</w> во время прогулки в парке."
                            }
                        },
                        {
                            "text": "W sklepie z pamiątkami kupiłem drewnianą <w>laseczkę</w> z rzeźbioną rączką.",
                            "target_lang_translations": {
                                "ru": "В сувенирном магазине я купил деревянную <w>тросточку</w> с резной ручкой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drewniana laseczka",
                        "podpierać się laseczką"
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшительное от слова laska; маленькая, тонкая палочка, служащая для опоры или украшения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тросточка",
                                "target_lang_sense_clarification": "уменьшительное от трость"
                            },
                            {
                                "target_lang_word": "палочка",
                                "target_lang_sense_clarification": "небольшая палка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34c4e66e-4b30-3650-96b8-5eaf91edd951",
                    "sense_definition": "rodzaj bakterii o kształcie wydłużonego walca, zdolnej do wytwarzania przetrwalników",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pod mikroskopem wyraźnie było widać <w>laseczki</w> wąglika w pobranej próbce.",
                            "target_lang_translations": {
                                "ru": "Под микроскопом в отобранной пробе были отчетливо видны <w>бациллы</w> сибирской язвы."
                            }
                        },
                        {
                            "text": "Niektóre <w>laseczki</w> są chorobotwórcze dla człowieka i zwierząt.",
                            "target_lang_translations": {
                                "ru": "Некоторые <w>бациллы</w> являются болезнетворными для человека и животных."
                            }
                        }
                    ],
                    "synonyms": [
                        "pałeczka"
                    ],
                    "common_phrases": [
                        "laseczka jadu kiełbasianego",
                        "laseczka tężca"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "termin medyczny i biologiczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тип бактерий в форме удлиненного цилиндра, способных образовывать споры"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бацилла",
                                "target_lang_sense_clarification": "палочковидная бактерия"
                            },
                            {
                                "target_lang_word": "палочка",
                                "target_lang_sense_clarification": "в биологическом контексте"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}