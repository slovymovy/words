                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house was painted white with a beautiful blue <w>trim</w> around the windows.",
                            "target_lang_translations": {
                                "ru": "Дом был выкрашен в белый цвет с красивой синей <w>отделкой</w> вокруг окон."
                            }
