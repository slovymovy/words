                "senses": [
                    {
                        "sense_id": "22dfd6e9-b066-3e2f-8111-bd4416597d0d",
                        "entry_id": "48e5cb61-5c3c-37c0-8421-0da4d0e3f3b0",
                        "glosses": [
                            "David Jones, an Australian luxury department store."
                        ],
                        "tags": [
                            "Australia",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "558e74e3-31bc-48c0-a704-1f55e98a76ee",
                                "sense_id": "22dfd6e9-b066-3e2f-8111-bd4416597d0d",
                                "text": "DJs, as it is affectionately known by Australians, is the country's equivalent of Harvey Nichols. Operating for more than 170 years, the store sells upmarket brands to a legion of loyal customers."
                            },
                            {
                                "example_id": "6c349c25-274c-4176-8287-46b21218a720",
                                "sense_id": "22dfd6e9-b066-3e2f-8111-bd4416597d0d",
                                "text": "South Africa's Woolworths Holdings Ltd. is pursuing Aussie retailer DJs, and DJs badly wants the takeover."
                            },
                            {
                                "example_id": "458cd4c8-67ef-4e88-8ec8-7fd18222507a",
                                "sense_id": "22dfd6e9-b066-3e2f-8111-bd4416597d0d",
                                "text": "Despite the backlash, some Kardashian fans pushed back against the negativity. 'Why are there so many negative nancys in these comments? It's wonderful that DJs is stocking new and different brands,' wrote one."
                            }
                        ]
                    }
