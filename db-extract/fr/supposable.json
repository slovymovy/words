                    {
                        "sense_id": "f23f516b-7014-3a04-92f1-dd470a99d7d5",
                        "entry_id": "7d09b832-43c2-3218-a10f-8be3dc2a85fb",
                        "glosses": [
                            "Qu’on peut supposer, imaginable."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "041b6690-059a-46e9-b6ba-d0e66f3472e8",
                                "sense_id": "f23f516b-7014-3a04-92f1-dd470a99d7d5",
                                "text": "Il était supposable que les Américains avaient dû redescendre vers quelque établissement plus méridional, afin d'y passer les mois d'hiver."
                            },
                            {
                                "example_id": "d59159bd-311e-4805-b924-6deb098565a1",
                                "sense_id": "f23f516b-7014-3a04-92f1-dd470a99d7d5",
                                "text": "Mais regardez-le, Clémentine ! C’est pas supposable ! Sa chemise est en charpie…"
                            },
                            {
                                "example_id": "ef0579be-fd95-4206-a78c-b4090b4e8f06",
                                "sense_id": "f23f516b-7014-3a04-92f1-dd470a99d7d5",
                                "text": "Rappelant la définition des species comme « propriétés supposables d'entités déjà obtenues », il propose d'y remplacer supposables par connues : « En intuitionisme, on ne devrait pas faire des hypothèses dont on ignore s'il est possible de les satisfaire. »"
                            }
                        ]
                    }
