                "senses": [
                    {
                        "sense_id": "b8e3759a-9316-3ca3-a505-3d8743a3395a",
                        "entry_id": "544dab33-ae89-386c-a175-13203ad54d43",
                        "glosses": [
                            "Bombe mit starker Rauchentwicklung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6078f66b-04c0-4b7e-8914-9c93eacf75f2",
                                "sense_id": "b8e3759a-9316-3ca3-a505-3d8743a3395a",
                                "text": "„Lediglich im Stadion hatten einige deutsche Anhänger für Ärger gesorgt, als sie mehrfach Papierkugeln aufs Spielfeld warfen und eine Rauchbombe zündeten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24ff37c4-2dd3-46bd-8d73-00a1f4ea0fdf",
                        "source_entry_id": "544dab33-ae89-386c-a175-13203ad54d43",
                        "source_sense_id": "b8e3759a-9316-3ca3-a505-3d8743a3395a",
                        "source_sense_description": "Bombe mit starker Rauchentwicklung",
                        "target_lang_word": "smoke bomb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smoke bomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b843d59e-b252-3cde-9016-48cc972e7bbc",
                                        "entry_id": "21303a59-a18b-37cd-acc2-182865daeeba",
                                        "glosses": [
                                            "A firework designed to produce smoke upon ignition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131a7157-f4ba-4d39-8082-a029f99def29",
                                                "sense_id": "b843d59e-b252-3cde-9016-48cc972e7bbc",
                                                "text": "It was the morning of the Fourth of July and kids were lighting smoke bombs, sulfurous coils of red and green, the colors dense and bright like concentrated dye blooming through water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                        "entry_id": "21303a59-a18b-37cd-acc2-182865daeeba",
                                        "glosses": [
                                            "An explosive or incendiary device designed to emit smoke in order to mark a position or produce a smokescreen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac6f591-7626-4053-b58f-8986e5bca4fe",
                                                "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                                "text": "Smoke bombs would be used. The thick fumes resulting from their explosion between the lines would cover our advance."
                                            },
                                            {
                                                "example_id": "8f3bec0e-c32f-469c-b6eb-76a6bdfee43d",
                                                "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                                "text": "Over every German battery would soar the observation plane indicating by tinsel or smoke bombs the location of the guns […]"
                                            },
                                            {
                                                "example_id": "46cf9936-e5cf-4e4a-89a5-7607b2d86962",
                                                "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                                "text": "Margot would plant smoke-bombs in Kuno’s bedroom and then rush in to rescue him from the fumes."
                                            },
                                            {
                                                "example_id": "5753c341-4ad9-4220-8cf3-afacdac367ee",
                                                "sense_id": "9a45ff6b-45f6-3dd1-a9cd-1193d2639771",
                                                "text": "The agent gave them the two camera-cases you saw. […] He told them that the blue case contained a very powerful smoke-bomb. The red case was the explosive. As one of them threw the red case, the other was to press a switch on the blue case and they would escape under cover of the smoke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
