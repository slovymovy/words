                        ]
                    },
                    {
                        "translation_id": "199d76be-d01d-4829-9a6c-692a4dcbf3dc",
                        "source_entry_id": "212ef8fa-24b7-3773-87d1-1a2a2fe437ff",
                        "source_sense_id": "6fdc0ad6-ef9b-34fe-ad54-88dd11f46cca",
                        "target_lang_word": "dégoûtant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégoûtant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bac4180-894f-33f8-80d7-a44d26a6c538",
                                        "entry_id": "fb04f9b5-32a3-37c0-aab8-09348fc46889",
                                        "glosses": [
                                            "Qui donne du dégoût."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5632d2f4-7390-46cb-b59d-707f885f2c1a",
                                                "sense_id": "4bac4180-894f-33f8-80d7-a44d26a6c538",
                                                "text": "Plaie dégoûtante."
                                            },
                                            {
                                                "example_id": "c6b15ff7-cda5-4e08-ae2f-7e877d6fa57b",
                                                "sense_id": "4bac4180-894f-33f8-80d7-a44d26a6c538",
                                                "text": "Malpropreté dégoûtante."
                                            },
                                            {
                                                "example_id": "c25c41a3-823e-45fe-881e-7e9e7f56ca34",
                                                "sense_id": "4bac4180-894f-33f8-80d7-a44d26a6c538",
                                                "text": "J’achève de vivre, en robe de chambre, dans l’appareil des grands malades incurables, au fond d’un fauteuil à oreillettes où ma mère a attendu sa fin ; assis, comme elle, près d’une table couverte de potions, mal rasé, malodorant, esclave de plusieurs manies dégoûtantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed2e18c6-d4ef-327f-bbfe-ea8a16e0b712",
                                        "entry_id": "fb04f9b5-32a3-37c0-aab8-09348fc46889",
                                        "glosses": [
                                            "Qui inspire de l’aversion, de la répugnance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eca2a9ec-884c-415b-905f-cdbecdf7e82b",
                                                "sense_id": "ed2e18c6-d4ef-327f-bbfe-ea8a16e0b712",
                                                "text": "Car enfin il ne m’emballe pas, moi, ce raplati de Karfeck et il est un peu dégoûtant, ce vieux qui guigne tout le temps les mollets de Clotte."
                                            },
                                            {
                                                "example_id": "d44e9043-72b3-4a12-a6e8-0fa56a40e23b",
                                                "sense_id": "ed2e18c6-d4ef-327f-bbfe-ea8a16e0b712",
                                                "text": "Le charlatanisme des saints-simoniens fut aussi dégoûtant que celui de Murat ; d’ailleurs l’histoire de cette école est inintelligible quand on ne la rapproche pas des modèles napoléoniens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "208f31a8-6fe0-35f8-81da-9deba20705c3",
                                        "entry_id": "fb04f9b5-32a3-37c0-aab8-09348fc46889",
                                        "glosses": [
                                            "Qui cause des déceptions, de la répugnance."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc798492-963f-424d-a18b-73cad6c14e1d",
                                                "sense_id": "208f31a8-6fe0-35f8-81da-9deba20705c3",
                                                "text": "Il arrive bien des choses dégoûtantes dans la vie."
                                            },
                                            {
                                                "example_id": "ceaf6b10-5cc9-4fe7-ba9a-4e6172f5b194",
                                                "sense_id": "208f31a8-6fe0-35f8-81da-9deba20705c3",
                                                "text": "Cela est dégoûtant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dégoûtant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c19d1307-1219-30a4-8d6f-2a6f5e5037ff",
                                        "entry_id": "68ab03c4-6327-32d9-b8c6-c7204053df69",
                                        "glosses": [
                                            "Personne qui provoque de la répugnance, du dégoût, qui cause de la déception."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90243491-a01a-4824-b9f9-841849528946",
                                                "sense_id": "c19d1307-1219-30a4-8d6f-2a6f5e5037ff",
                                                "text": "Ce vaurien de Mablot, ce dégoûtant, ce saligaud  ! Et lui qui le tenait en si haute estime, lui qui avait tant chanté ses louanges  !"
                                            }
                                        ]
                                    }
                                ]
                            },
