                                                "sense_id": "c3bfaa4a-b592-3d9b-8c7b-70b9388f0e57",
                                                "text": "It’s important to research chemical fate because chemical fate is the best tool we have for understanding and managing human health risks or environmental damage caused by chemical release."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4065296-a179-3fdd-94a8-9d9aa4cc22c2",
