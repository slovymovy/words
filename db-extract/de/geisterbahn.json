                                    {
                                        "sense_id": "95ef20b1-52a1-394d-add1-81bf990f8622",
                                        "entry_id": "00ff8466-37b4-3e5a-a964-344b10dd50f1",
                                        "glosses": [
                                            "A fairground attraction in which participants ride through a haunted house in a railcar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "064651ed-026c-39a3-a16d-bd52adb09eeb",
                                        "entry_id": "00ff8466-37b4-3e5a-a964-344b10dd50f1",
                                        "glosses": [
                                            "A ghost-themed excursion offered by many tourist railways around the world. Usually, a fictional story is created and performed with static displays or live actors on either side of a train. Actors and actresses play out a story on the long and narrow stage provided by the railcar aisles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bde97df-7db1-30a4-aac3-7e82ef74ec2c",
                                        "entry_id": "00ff8466-37b4-3e5a-a964-344b10dd50f1",
                                        "glosses": [
                                            "A rail service which does not appear in the public timetables."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80479498-a4d4-31a2-9f38-52327aee3229",
                                        "entry_id": "00ff8466-37b4-3e5a-a964-344b10dd50f1",
                                        "glosses": [
                                            "A supernatural manifestation of a railway locomotive or passenger cars."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f664d4c6-0a73-3326-a46e-a0042d488325",
                                        "entry_id": "00ff8466-37b4-3e5a-a964-344b10dd50f1",
                                        "glosses": [
                                            "An unmanned train rolling on the train line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a003ac3-d9dd-37e6-b1a7-ee0a0e28979c",
                                        "entry_id": "00ff8466-37b4-3e5a-a964-344b10dd50f1",
                                        "glosses": [
                                            "A train service that no longer exists, having stopped running."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aee0aad-b0ff-45c8-8b31-5ad2782e117f",
                                                "sense_id": "5a003ac3-d9dd-37e6-b1a7-ee0a0e28979c",
                                                "text": "As a second-year student at Kharkiv University, I took a summer job as a conductor of the train that ran from Novorossiysk on the Russian Black Sea coast to Kaliningrad in the Baltics - a 48-hour journey via Kharkiv, from where the train originated. In modern geographical terms, it went across four independent states: Ukraine, Russia, Belarus, and Lithuania. As such, it has now joined the long list of 'ghost trains', extinguished by the ongoing war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05867c0d-4dba-43cd-a40d-a199f12c4327",
                        "source_entry_id": "bee18a3c-fda4-331f-907b-741c844a56fe",
                        "source_sense_id": "c4cdd42a-b6be-3412-978e-81698e459e42",
