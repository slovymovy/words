{
    "word_family": [
        "loop",
        "lopen",
        "verloop"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "0e8f43bc-569f-3d58-8207-bf19e1c56068",
                    "sense_definition": "op een ongedwongen manier, zonder er veel aandacht aan te besteden of de nadruk op te leggen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "terloops_gebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vertelde <w>terloops</w> dat hij volgende week gaat verhuizen naar een andere stad.",
                            "target_lang_translations": {
                                "en": "He mentioned <w>in passing</w> that he is moving to another city next week."
                            }
                        },
                        {
                            "text": "Tijdens het eten liet ze <w>terloops</w> vallen dat ze haar baan had opgezegd.",
                            "target_lang_translations": {
                                "en": "During dinner, she <w>casually</w> mentioned that she had quit her job."
                            }
                        }
                    ],
                    "synonyms": [
                        "tussen neus en lippen door"
                    ],
                    "antonyms": [
                        "nadrukkelijk",
                        "omstandig"
                    ],
                    "common_phrases": [
                        "iets terloops opmerken",
                        "terloops laten vallen"
                    ],
                    "target_lang_definitions": {
                        "en": "in a casual manner, without paying much attention to it or emphasizing it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "casually",
                                "target_lang_sense_clarification": "in an informal or relaxed way"
                            },
                            {
                                "target_lang_word": "in passing",
                                "target_lang_sense_clarification": "briefly and without focus"
                            },
                            {
                                "target_lang_word": "incidentally",
                                "target_lang_sense_clarification": "as a minor part of something else"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee590bba-45ee-32be-ba87-89b1b906d4be",
                    "sense_definition": "op een onopvallende wijze tussen andere zaken door, alsof het van ondergeschikt belang is",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "terloops_gebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit belangrijke feit wordt in het rapport slechts <w>terloops</w> vermeld in een voetnoot.",
                            "target_lang_translations": {
                                "en": "This important fact is only <w>briefly</w> mentioned in a footnote in the report."
                            }
                        },
                        {
                            "text": "De spreker noemde <w>terloops</w> de naam van zijn opvolger aan het einde van de presentatie.",
                            "target_lang_translations": {
                                "en": "The speaker <w>incidentally</w> mentioned the name of his successor at the end of the presentation."
                            }
                        }
                    ],
                    "synonyms": [
                        "tussen neus en lippen door"
                    ],
                    "antonyms": [
                        "uitgebreid"
                    ],
                    "common_phrases": [
                        "terloops vermelden"
                    ],
                    "target_lang_definitions": {
                        "en": "in an inconspicuous way among other matters, as if it were of secondary importance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "briefly",
                                "target_lang_sense_clarification": "shortly and without detail"
                            },
                            {
                                "target_lang_word": "in passing",
                                "target_lang_sense_clarification": "mentioned while talking about something else"
                            },
                            {
                                "target_lang_word": "parenthetically",
                                "target_lang_sense_clarification": "as an aside or extra information"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81b48858-f484-3bbb-bb1b-57e0d4c4bfd6",
                    "sense_definition": "vluchtig en zonder veel diepgang of aandacht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "terloops_kenmerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wierp een <w>terloopse</w> blik op de krant terwijl hij op de bus wachtte.",
                            "target_lang_translations": {
                                "en": "He cast a <w>casual</w> glance at the newspaper while waiting for the bus."
                            }
                        },
                        {
                            "text": "Haar <w>terloopse</w> opmerking bleek achteraf veel belangrijker dan we dachten.",
                            "target_lang_translations": {
                                "en": "Her <w>offhand</w> remark turned out to be much more important than we thought afterwards."
                            }
                        }
                    ],
                    "synonyms": [
                        "tussen neus en lippen door"
                    ],
                    "antonyms": [
                        "grondig",
                        "diepgaand"
                    ],
                    "common_phrases": [
                        "een terloopse blik",
                        "een terloopse opmerking"
                    ],
                    "target_lang_definitions": {
                        "en": "fleeting and without much depth or attention"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "casual",
                                "target_lang_sense_clarification": "not serious or thorough"
                            },
                            {
                                "target_lang_word": "fleeting",
                                "target_lang_sense_clarification": "lasting for a very short time"
                            },
                            {
                                "target_lang_word": "cursory",
                                "target_lang_sense_clarification": "hasty and therefore not thorough"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc9b6e40-61ee-3aee-bc5a-a4e34890b72c",
                    "sense_definition": "zijdelings of als een bijzaak fungerend",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "terloops_kenmerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Docent Lagergren vermeldde het <w>terloops</w> bij de eerste les en daarmee was de kous af.",
                            "target_lang_translations": {
                                "en": "Teacher Lagergren mentioned it <w>in passing</w> during the first lesson and that was the end of it."
                            }
                        },
                        {
                            "text": "Het was slechts een <w>terloopse</w> verwijzing in een verder heel ander verhaal.",
                            "target_lang_translations": {
                                "en": "It was only a <w>passing</w> reference in an otherwise completely different story."
                            }
                        }
                    ],
                    "synonyms": [
                        "tussen neus en lippen door"
                    ],
                    "antonyms": [
                        "centraal"
                    ],
                    "common_phrases": [
                        "een terloopse verwijzing"
                    ],
                    "target_lang_definitions": {
                        "en": "functioning sideways or as a side issue"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "passing",
                                "target_lang_sense_clarification": "brief and not lasting"
                            },
                            {
                                "target_lang_word": "incidental",
                                "target_lang_sense_clarification": "occurring as a minor accompaniment"
                            },
                            {
                                "target_lang_word": "offhand",
                                "target_lang_sense_clarification": "without previous thought or preparation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}