                        "entry_id": "8cea430c-9ab0-3b9c-8486-d4433f409d38",
                        "glosses": [
                            "osoba przyjmująca na siebie zobowiązanie zapłacenia w określonym terminie i miejscu wymienionej w wekslu sumy"
                        ],
