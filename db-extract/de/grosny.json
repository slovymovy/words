                        "sense_id": "e295cb63-8eba-39a3-868c-f4a230467f76",
                        "entry_id": "92959117-f551-3ae4-9530-89dfcfcad2f0",
                        "glosses": [
                            "am Fluss Sunscha gelegene Hauptstadt der Republik Tschetschenien in Russland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "015e55b9-9a2b-4be3-acd4-21836d1f1847",
                                "sense_id": "e295cb63-8eba-39a3-868c-f4a230467f76",
                                "text": "„Grosny gehörte, ähnlich wie Baku am Kaspischen Meer und das Wolgagebiet, zu jenen Ölförderregionen, die den sozialistischen Aufbau in der Sowjetunion vor dem Zweiten Weltkrieg speisten, die aber schon in der Zarenzeit erschlossen worden waren. Den Zaren war Grosny als günstig gelegene Festung am Sunscha-Fluß wichtig, das Erdöl kam Ende des 19. Jahrhunderts als Geschenk dazu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
