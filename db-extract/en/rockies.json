                        "glosses": [
                            "The Rocky Mountains, a mountain range in North America."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fa6b64c-00e1-4939-a7df-51789cf2c146",
                                "sense_id": "43e6355c-d201-399c-ad88-cf5b2511597d",
                                "text": "The North American continental divide runs along the Rockies."
                            },
                            {
                                "example_id": "882321ee-9f20-4d55-aece-f65f0009ff16",
                                "sense_id": "43e6355c-d201-399c-ad88-cf5b2511597d",
                                "text": "The Canadian Pacific Railway is about to introduce dome cars, already popular in the United States, which will add, if possible, to the scenic delights of the journey through the Rockies."
                            },
                            {
                                "example_id": "cb04996d-ea27-4239-9f80-1bc642f02add",
                                "sense_id": "43e6355c-d201-399c-ad88-cf5b2511597d",
                                "text": "To the north are the Rockies. To the west, the Chuska Mountains on the border of Arizona and New Mexico. And to the east, the dusty, sparsely-vegetated landscape of the San Juan Basin seems to go on forever, like a wide dry sea."
                            }
                        ]
                    }
