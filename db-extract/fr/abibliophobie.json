                                        "sense_id": "94e854b5-0168-3f8c-b52e-306c683add3f",
                                        "entry_id": "be78b3c1-44f5-3a57-8f14-2330ac9a8b0c",
                                        "glosses": [
                                            "Fear of running out of things to read."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe42664-e94c-4cb5-8010-170872aaff9d",
                                                "sense_id": "94e854b5-0168-3f8c-b52e-306c683add3f",
                                                "text": "Professor David Latchman, the Master of Birkbeck College, suffers from abibliophobia, a common affliction amongst book collectors that manifests itself as a morbid fear of running out of reading material."
                                            },
                                            {
                                                "example_id": "4366800c-d41f-4220-a51b-d22ab20b2233",
                                                "sense_id": "94e854b5-0168-3f8c-b52e-306c683add3f",
                                                "text": "Speaking of frightful words, a curious fear I've suffered from on occasion, especially on long airplane flights, is abibliophobia, the fear of not having enough to read."
                                            },
                                            {
                                                "example_id": "81b3d706-5a16-44be-bb7c-659b2db5a6db",
                                                "sense_id": "94e854b5-0168-3f8c-b52e-306c683add3f",
                                                "text": "The outdoor racks, maintained on an honor system, are open 24 hours a day, for those who suffer from abibliophobia—fear of lacking for reading material."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
