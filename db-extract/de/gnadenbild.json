                "senses": [
                    {
                        "sense_id": "ff4cfc48-4d57-3ce9-b122-14fca7bdc9d5",
                        "entry_id": "fb9ddb92-ba95-3cb9-9f2c-8f6f6bc62750",
                        "glosses": [
                            "Abbildung eines Heiligen, von Jesus oder der Mutter Gottes, der von Gläubigen Wunderkraft zugeschrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497d8da5-c0e6-431d-87f4-452b472c0296",
                                "sense_id": "ff4cfc48-4d57-3ce9-b122-14fca7bdc9d5",
                                "text": "„Damals pilgerten immer mehr Gläubige in das geheimnisvolle Tal, um in der unscheinbaren Kapelle vor dem Gnadenbild zu beten.“"
                            },
                            {
                                "example_id": "7e5d9159-8209-4c71-bac3-72cb46e5fe42",
                                "sense_id": "ff4cfc48-4d57-3ce9-b122-14fca7bdc9d5",
                                "text": "„Als das Gnadenbild seine Wundertaten einstellte (oder die Menschen aufhörten, daran zu glauben), waren die Leute von Zehma so vernünftig, die Kapelle wieder in ein Badehaus zu verwandeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
