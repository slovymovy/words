                ],
                "senses": [
                    {
                        "sense_id": "67453d65-6ec7-3ef2-9432-61ceb8679124",
                        "entry_id": "64b869dc-7ac8-37a4-b330-e18381d30a7f",
                        "glosses": [
                            "книжн. делать логический вывод из двух или нескольких суждений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a27321d-1ba5-4359-88c6-12ee1a376ccd",
                                "sense_id": "67453d65-6ec7-3ef2-9432-61ceb8679124",
                                "text": "Для того чтобы понимать, наблюдать, умозаключать, человек должен прежде сознавать себя живущим."
                            },
                            {
                                "example_id": "9eb468ed-2c2b-454d-ac8b-80c09e510b79",
                                "sense_id": "67453d65-6ec7-3ef2-9432-61ceb8679124",
                                "text": "Отцу, вероятно, очень не нравились и мой характер и моя наружность, по крайней мере я привык так умозаключать, судя по немногим моим столкновениям с виновником моего бытия."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83cab779-4592-409f-8743-a7f493329cf5",
                        "source_entry_id": "64b869dc-7ac8-37a4-b330-e18381d30a7f",
                        "source_sense_id": "67453d65-6ec7-3ef2-9432-61ceb8679124",
                        "target_lang_word": "conclude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conclude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4de53a79-9445-3f3f-9bf8-1269afa74bb6",
                                        "entry_id": "ab9a58d4-2f03-3cb9-82d5-b5f36abb050a",
                                        "glosses": [
                                            "To end; to come to an end."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d203b9-dac8-468b-a71f-50698a134c4c",
                                                "sense_id": "4de53a79-9445-3f3f-9bf8-1269afa74bb6",
                                                "text": "The story concluded with a moral."
                                            },
                                            {
                                                "example_id": "f9073c80-879c-46d5-b535-e4b2424fcff6",
                                                "sense_id": "4de53a79-9445-3f3f-9bf8-1269afa74bb6",
                                                "text": "He inveighed against the folly of making oneself liable for the debts of others; vented many bitter execrations against the brother; and concluded with wishing something could be done for the unfortunate family."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f9d0a71-f0ad-37eb-b594-73b9faceee4c",
                                        "entry_id": "ab9a58d4-2f03-3cb9-82d5-b5f36abb050a",
                                        "glosses": [
                                            "To bring to an end; to close; to finish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc069500-4323-4079-b5bc-73a892a7a2d5",
                                                "sense_id": "0f9d0a71-f0ad-37eb-b594-73b9faceee4c",
                                                "text": "I will conclude this part with the speech of a counsellor of state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3120f48b-7c38-35be-ad48-6b5fcbd914ac",
                                        "entry_id": "ab9a58d4-2f03-3cb9-82d5-b5f36abb050a",
                                        "glosses": [
                                            "To bring about as a result; to effect; to make."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c35677c-d43f-48fd-b8c1-1901e93da7d9",
                                                "sense_id": "3120f48b-7c38-35be-ad48-6b5fcbd914ac",
                                                "text": "to conclude a bargain"
                                            },
                                            {
                                                "example_id": "305405e3-4ae7-45b3-b398-9309c85e62d0",
                                                "sense_id": "3120f48b-7c38-35be-ad48-6b5fcbd914ac",
                                                "text": "if we conclude a peace"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88292a3d-1091-35e0-946c-e658e50fd87e",
                                        "entry_id": "ab9a58d4-2f03-3cb9-82d5-b5f36abb050a",
                                        "glosses": [
                                            "To come to a conclusion, to a final decision."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03929680-78d1-4ed6-8c0e-2dbc492627e0",
                                                "sense_id": "88292a3d-1091-35e0-946c-e658e50fd87e",
                                                "text": "From the evidence, I conclude that this man was murdered."
                                            },
                                            {
                                                "example_id": "1530b0e4-7d74-4ab5-8a5d-9cfcd95e86ed",
                                                "sense_id": "88292a3d-1091-35e0-946c-e658e50fd87e",
                                                "text": "No man can certainly conclude God's love or hatred to any person by anything that befalls him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "284ecd3e-5555-335d-a44c-88f1be40fbf3",
                                        "entry_id": "ab9a58d4-2f03-3cb9-82d5-b5f36abb050a",
                                        "glosses": [
                                            "To make a final determination or judgment concerning; to judge; to decide."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3cfe969-f5ff-4328-8429-895b128db24b",
                                                "sense_id": "284ecd3e-5555-335d-a44c-88f1be40fbf3",
                                                "text": "But no frail man, however great or high, / Can be concluded blest before he die."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "729c4a07-c3e2-37fa-965b-7c8e96e2f4c9",
                                        "entry_id": "ab9a58d4-2f03-3cb9-82d5-b5f36abb050a",
                                        "glosses": [
                                            "To shut off; to restrain; to limit; to estop; to bar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13b50dbe-8db9-458c-8e76-41fbf1909dda",
                                                "sense_id": "729c4a07-c3e2-37fa-965b-7c8e96e2f4c9",
                                                "text": "The defendant is concluded by his own plea."
                                            },
                                            {
                                                "example_id": "a0a0ab74-89bb-48e3-9738-1236c2c7cae2",
                                                "sense_id": "729c4a07-c3e2-37fa-965b-7c8e96e2f4c9",
                                                "text": "A judgment concludes the introduction of further evidence."
                                            },
                                            {
                                                "example_id": "651b45ea-ce3b-41ec-b26b-00c887033ed3",
                                                "sense_id": "729c4a07-c3e2-37fa-965b-7c8e96e2f4c9",
                                                "text": "If therefore they will appeal to revelation for their creation they must be concluded by it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a48c543-d2a0-3728-add3-b7fc5e67aac9",
                                        "entry_id": "ab9a58d4-2f03-3cb9-82d5-b5f36abb050a",
                                        "glosses": [
                                            "To shut up; to enclose."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2488ee3f-5bd2-4c8b-9b95-f09f31d85abb",
                                                "sense_id": "5a48c543-d2a0-3728-add3-b7fc5e67aac9",
                                                "text": "The very person of Christ [was] concluded within the grave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3efed8bc-17f8-3de7-bee5-c7a55e1e3227",
                                        "entry_id": "ab9a58d4-2f03-3cb9-82d5-b5f36abb050a",
                                        "glosses": [
                                            "To include; to comprehend; to shut up together; to embrace; to confine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2894f104-9c35-4bff-b704-c59b61387972",
                                                "sense_id": "3efed8bc-17f8-3de7-bee5-c7a55e1e3227",
                                                "text": "Banisht the Court? Let me be banisht Life;\n Since the chief end of Life is there concluded:\nWithin the Court is all the Kingdom bounded,\nAnd as her sacred Sphear doth comprehend\nTen thousand times so much, as so much Place\nIn any part of all the Empire else;\nSo every Body, moving in her Sphear,\nContains Ten thousand times as much in him,\nAs any other, her choice Orb excludes."
                                            },
                                            {
                                                "example_id": "fb55e0d7-5582-41f6-8e75-15068bfc4006",
                                                "sense_id": "3efed8bc-17f8-3de7-bee5-c7a55e1e3227",
                                                "text": "For God hath concluded all in unbelief."
                                            },
                                            {
                                                "example_id": "91922aef-0266-482d-8478-9d2720a0e88f",
                                                "sense_id": "3efed8bc-17f8-3de7-bee5-c7a55e1e3227",
                                                "text": "The Scripture hath concluded all under sin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4bff193-c178-3360-83a3-ae33207d644c",
                                        "entry_id": "ab9a58d4-2f03-3cb9-82d5-b5f36abb050a",
                                        "glosses": [
                                            "to deduce, to infer (develop a causal relation)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76be6f8a-101c-48d2-aa69-1ce7b6a4f3aa",
                        "source_entry_id": "64b869dc-7ac8-37a4-b330-e18381d30a7f",
                        "source_sense_id": "67453d65-6ec7-3ef2-9432-61ceb8679124",
                        "target_lang_word": "concluse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c770815a-f98e-41f8-a512-b4dcda04d925",
                        "source_entry_id": "64b869dc-7ac8-37a4-b330-e18381d30a7f",
                        "source_sense_id": "67453d65-6ec7-3ef2-9432-61ceb8679124",
                        "target_lang_word": "infer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bac55b11-583c-3aeb-ba43-3de17a3a3611",
                                        "entry_id": "c2ca044f-6d6b-3861-afc0-4736568782f2",
                                        "glosses": [
                                            "To introduce (something) as a reasoned conclusion; to conclude by reasoning or deduction, as from premises or evidence."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "613d7973-b1ad-4d5b-962a-b9579bfe5f57",
                                                "sense_id": "bac55b11-583c-3aeb-ba43-3de17a3a3611",
                                                "text": "It is dangerous to infer too much from martial bluster in British politics: at the first hint of trouble, channelling Churchill is a default tactic for beleaguered leaders of all sorts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fa560e3-0cb4-3103-ad40-3367ffe2021f",
                                        "entry_id": "c2ca044f-6d6b-3861-afc0-4736568782f2",
                                        "glosses": [
                                            "To lead to (something) as a consequence; to imply."
                                        ],
                                        "tags": [
                                            "often",
                                            "proscribed",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b224b793-1090-4ec7-9162-97387298f901",
                                                "sense_id": "5fa560e3-0cb4-3103-ad40-3367ffe2021f",
                                                "text": "a. 1535, Thomas More, letter to Fryth\nthe fyrste parte is not the proofe of the second. but rather contrarywyse the seconde inferreth well yͤ fyrst."
                                            },
                                            {
                                                "example_id": "5d3aa649-5bee-40fa-93ed-d67f2f9b39e7",
                                                "sense_id": "5fa560e3-0cb4-3103-ad40-3367ffe2021f",
                                                "text": "This doth infer the zeal I had to see him."
                                            },
                                            {
                                                "example_id": "be5831c7-e0a7-4c6e-9472-5ef2a08c1cec",
                                                "sense_id": "5fa560e3-0cb4-3103-ad40-3367ffe2021f",
                                                "text": "These and a thousand like propositions, which concurre in this purpose, do evidently inferre [translating sonnent] some thing beyond patient expecting of death it selfe to be suffered in this life[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bda9149a-f649-31a2-9940-4c04c7d49d5d",
                                        "entry_id": "c2ca044f-6d6b-3861-afc0-4736568782f2",
                                        "glosses": [
                                            "To cause, inflict (something) upon or to someone."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbf3a304-bd75-4119-9a1a-4692db57e968",
                                                "sense_id": "bda9149a-f649-31a2-9940-4c04c7d49d5d",
                                                "text": "faire Serena[…]fled fast away, afeard / Of villany to be to her inferd[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c949fc6-83d6-34a4-b3ad-bd7e1a5fff5c",
                                        "entry_id": "c2ca044f-6d6b-3861-afc0-4736568782f2",
                                        "glosses": [
                                            "To introduce (a subject) in speaking, writing etc.; to bring in, to adduce."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fc0962f-0112-4c5f-8109-7a1bd06e671c",
                                                "sense_id": "7c949fc6-83d6-34a4-b3ad-bd7e1a5fff5c",
                                                "text": "Full well hath Clifford played the orator, / Inferring arguments of mighty force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
