                "senses": [
                    {
                        "sense_id": "63ad5b34-0c07-34c2-a288-ae415fbe778e",
                        "entry_id": "d789a0df-9411-3e0f-9835-3a0ada3e7c2f",
                        "glosses": [
                            "Zelle des Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9d4c072-1ddc-46eb-a1fb-234521c6ae5f",
                                "sense_id": "63ad5b34-0c07-34c2-a288-ae415fbe778e",
                                "text": "„Blut befördert den in der Lunge aufgenommenen Sauerstoff zu jeder einzelnen Körperzelle.“"
                            },
                            {
                                "example_id": "9cf954c7-5d8a-4eb3-8387-96cfd6c3f4e0",
                                "sense_id": "63ad5b34-0c07-34c2-a288-ae415fbe778e",
                                "text": "„Blut leitet außerdem Glucose und andere Nährstoffe aus dem Dünndarm zu allen Körperzellen und bringt Hormone von den Drüsen zu den Zielorten im Körper.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
