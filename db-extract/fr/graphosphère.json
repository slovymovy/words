                "senses": [
                    {
                        "sense_id": "980ffa85-a98f-36db-bac9-d8f2300dd9c2",
                        "entry_id": "7c000d3e-0614-3253-81d3-9e65d823176a",
                        "glosses": [
                            "Période caractérisée par une culture basée sur les écrits et l’imprimerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45483d87-360c-42fd-b031-43bb99f302f9",
                                "sense_id": "980ffa85-a98f-36db-bac9-d8f2300dd9c2",
                                "text": "L’humanité serait ainsi passée de l’âge de la logosphère (fondée sur la parole et l’écriture) à celui de la graphosphère (fondée sur l’imprimerie) puis au stade de la vidéosphère (où règne l’audiovisuel)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7308ce96-1883-42f2-9126-3009df9ae281",
                        "source_entry_id": "7c000d3e-0614-3253-81d3-9e65d823176a",
                        "source_sense_id": "980ffa85-a98f-36db-bac9-d8f2300dd9c2",
                        "target_lang_word": "graphosphere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graphosphere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7368a41c-1b82-3cf0-a866-c4590ad0ef71",
                                        "entry_id": "4ae618e0-3ec5-396c-8928-61c6b45cfb5f",
                                        "glosses": [
                                            "The \\\"totality of graphic devices used to record, store, display, and disseminate messages and information, and the social and cultural spaces in which they figure.\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "933fc3ed-4783-4b30-b127-e4f231e1ba47",
                                                "sense_id": "7368a41c-1b82-3cf0-a866-c4590ad0ef71",
                                                "text": "2005, Jacques Derrida (2005), cited in R. Burt, 2016, Medieval and Early Modern Film and Media, Springer. p. 24.\nWhat belongs to the graphosphere always implies some kind of surface, and even the materiality of some kind of backing or support; but not all graphemes are necessarily imprinted on paper, or the skin, photographic film, or a piece of parchment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02cc6315-e62f-382e-8452-4a076abb80c6",
                                        "entry_id": "4ae618e0-3ec5-396c-8928-61c6b45cfb5f",
                                        "glosses": [
                                            "The age of print (following the logosphere, or age of writing, and preceding the videosphere)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7b0b38-8520-4aec-8731-64e5fd317db7",
                                                "sense_id": "02cc6315-e62f-382e-8452-4a076abb80c6",
                                                "text": "2007, Régis Debray, \"Socialism: A life-cycle,\" New Left Review, 46, July-August 2007.\nA second period, the graphosphere, runs from 1448 to around 1968: from the Gutenberg Revolution to the rise of TV."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
