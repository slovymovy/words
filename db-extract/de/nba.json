                "senses": [
                    {
                        "sense_id": "7a56f92c-3304-3b9c-8d53-f662dd73ac01",
                        "entry_id": "b36eb281-55ad-3e0d-ba53-4c016f058105",
                        "glosses": [
                            "nordamerikanische Basketball-Profiliga; die mit großem Abstand stärkste und populärste Basketball-Liga der Welt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12499d07-9045-4e3b-bd59-f5a235c88b89",
                                "sense_id": "7a56f92c-3304-3b9c-8d53-f662dd73ac01",
                                "text": "„Kobe Bryant hat die Los Angeles Lakers in der nordamerikanischen Basketballprofiliga NBA mit 43 Punkten zu einem 109:106-Sieg bei den Dallas Mavericks geführt.“"
                            },
                            {
                                "example_id": "21895f18-141e-47f6-8254-9c4797e757e5",
                                "sense_id": "7a56f92c-3304-3b9c-8d53-f662dd73ac01",
                                "text": "„Kobe hatte sich im April nach 20 Jahren in der nordamerikanischen Profiliga NBA von der Basketball-Bühne verabschiedet.“"
                            },
                            {
                                "example_id": "ce597e73-1c31-4fb3-b60d-4544cee847f2",
                                "sense_id": "7a56f92c-3304-3b9c-8d53-f662dd73ac01",
                                "text": "„Die NBA ist in den USA einer der wenigen Gesellschaftsbereiche, in dem sich nichtweiße Menschen zu Leistungsträgern entwickeln können.“"
                            },
                            {
                                "example_id": "d1738b8b-0153-4f73-8ea7-8230f95d6056",
                                "sense_id": "7a56f92c-3304-3b9c-8d53-f662dd73ac01",
                                "text": "„Er muss sich auch noch steigern, wenn er irgendwann in der NBA spielen will, was sein großer Traum ist.“"
                            },
                            {
                                "example_id": "4e4870c6-6061-4c2b-8a4f-4d013be3bfef",
                                "sense_id": "7a56f92c-3304-3b9c-8d53-f662dd73ac01",
                                "text": "„‚Ich mag zwar in der NBA aufgehört haben, aber ich habe mich noch nicht komplett vom Basketball verabschiedet‘, sagte der 33-Jährige auf einer Pressekonferenz in New York.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
