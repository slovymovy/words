                                        "glosses": [
                                            "Nutzungsüberlassung gegen Gebühr, zum Beispiel für Gebäude, Maschinen oder Fahrzeuge (oft mit der Option gekoppelt, später das Objekt zu erwerben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680d8050-6332-41c8-828a-0a68433ad82a",
                                                "sense_id": "154dc8f2-5a48-38fa-89a4-ca3e37b77777",
                                                "text": "Statt eine Produktionsanlage oder Immobilie zu kaufen, setzen Firmen vermehrt auf Leasing."
                                            },
                                            {
                                                "example_id": "685ac634-d288-4e70-8ead-c11205f7e709",
                                                "sense_id": "154dc8f2-5a48-38fa-89a4-ca3e37b77777",
                                                "text": "Leasing ist für Privat- und Firmenkunden in Deutschland eine sehr beliebte Form der Fahrzeugfinanzierung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
