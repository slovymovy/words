    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67667be2-76e4-3dfb-ae90-38541c56a4e8",
                    "sense_definition": "poświęcać komuś lub czemuś uwagę, troszczyć się i pielęgnować",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "troska",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marysia codziennie bardzo <w>dba</w> o swoje rośliny na balkonie.",
                            "target_lang_translations": {
                                "ru": "Марыся каждый день тщательно <w>ухаживает</w> за своими растениями на балконе."
                            }
                        },
                        {
                            "text": "Każdy człowiek powinien regularnie <w>dbać</w> o zdrowie oraz dobrą kondycję.",
                            "target_lang_translations": {
                                "ru": "Каждый человек должен регулярно <w>заботиться</w> о здоровье и хорошей физической форме."
                            }
                        }
                    ],
                    "synonyms": [
                        "troszczyć się",
                        "opiekować się"
                    ],
                    "antonyms": [
                        "zaniedbywać"
                    ],
                    "common_phrases": [
                        "dbać o zdrowie",
                        "dbać o linię",
                        "dbać o czystość",
                        "dbać o dzieci"
                    ],
                    "target_lang_definitions": {
                        "ru": "уделять кому-то или чему-то внимание, заботиться и ухаживать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заботиться",
                                "target_lang_sense_clarification": "о здоровье, детях, близких или порядке"
                            },
                            {
                                "target_lang_word": "ухаживать",
                                "target_lang_sense_clarification": "за растениями, внешностью или больными"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa4869a3-007b-36bf-baac-67f4ca160e3c",
                    "sense_definition": "przywiązywać do czegoś wagę, przejmować się czymś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "znaczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zupełnie nie <w>dbam</w> o to, co mówią o mnie obcy ludzie.",
                            "target_lang_translations": {
                                "ru": "Меня совершенно не <w>волнует</w>, что говорят обо мне чужие люди."
                            }
                        },
                        {
                            "text": "Nasz szef wcale nie <w>dba</w> o zdanie pracowników w trudnych sytuacjach.",
                            "target_lang_translations": {
                                "ru": "Наш начальник вовсе не <w>считается</w> со мнением сотрудников в трудных ситуациях."
                            }
                        }
                    ],
                    "antonyms": [
                        "lekceważyć"
                    ],
                    "common_phrases": [
                        "nie dbać o opinię",
                        "dbać o pozory"
                    ],
                    "target_lang_definitions": {
                        "ru": "придавать чему-то значение, беспокоиться или волноваться о чём-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоиться",
                                "target_lang_sense_clarification": "переживать о чём-то, принимать близко к сердцу"
                            },
                            {
                                "target_lang_word": "волноваться",
                                "target_lang_sense_clarification": "проявлять эмоциональный интерес или тревогу"
                            },
                            {
                                "target_lang_word": "обращать внимание",
                                "target_lang_sense_clarification": "придавать значение чужому мнению (обычно с отрицанием)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}