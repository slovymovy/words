        "fr-extract.jsonl": [
            {
                "entry_id": "a6e6a902-7c53-301b-979a-a8649392d7fe",
                "word": "feuilletoniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "41a9494c-8953-479d-b5ad-fe59b25938de",
                        "entry_id": "a6e6a902-7c53-301b-979a-a8649392d7fe",
                        "tags": [
                            "plural"
                        ],
                        "form": "feuilletonistes"
                    },
                    {
                        "form_id": "5e846526-9dc1-4852-8f38-116063cfa95c",
                        "entry_id": "a6e6a902-7c53-301b-979a-a8649392d7fe",
                        "tags": [],
                        "form": "feuilletonniste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "320bdd82-8fc2-31fe-9463-55062471e786",
                        "entry_id": "a6e6a902-7c53-301b-979a-a8649392d7fe",
                        "glosses": [
                            "Celui ou celle qui, collaborant à un journal, écrit habituellement un feuilleton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcbcac37-bd63-403f-b6c3-cdd59f72d687",
                                "sense_id": "320bdd82-8fc2-31fe-9463-55062471e786",
                                "text": "À cinq heures, nous prenions le chemin de fer de Strasbourg, où nous étions arrivé à dix heures du soir, rentrant en France pour en sortir ; car, le lendemain matin, nous traversions le pont de Khel, nous dirigeant, par le chemin de fer badois, vers Heidelberg. Vous voyez qu’un feuilletoniste en vacances ne perd pas son temps !"
                            },
                            {
                                "example_id": "a19f611c-273d-47e6-bd89-5d4a3b24b564",
                                "sense_id": "320bdd82-8fc2-31fe-9463-55062471e786",
                                "text": "Il tenait le rôle d’un feuilletoniste besogneux, accablé d’ennuis d’argent et excédé par les coûteux caprices d’une femme-enfant ; […]"
                            },
                            {
                                "example_id": "5b8ae9dd-8ffc-4170-a4f7-8207f2322fcf",
                                "sense_id": "320bdd82-8fc2-31fe-9463-55062471e786",
                                "text": "Un peu plus tard, le feuilletoniste, en rentrant chez lui est poursuivi par un personnage menaçant, comme Eugène Sue le fut par des individus louches au service des Jésuites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7de1d94f-8d7a-4cd9-ad44-a2eb4b72e0ef",
                        "source_entry_id": "a6e6a902-7c53-301b-979a-a8649392d7fe",
                        "source_sense_id": "320bdd82-8fc2-31fe-9463-55062471e786",
                        "target_lang_word": "Feuilletonist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuilletonist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7bde5c83-3500-3e14-9894-45ff23b81473",
                                        "entry_id": "3a990951-1e97-3a91-b72e-3df0f5713303",
                                        "glosses": [
                                            "jemand, der Beiträge zum Feuilleton verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b433ba6c-a9ea-4fe4-a358-9f317b3b431e",
                                                "sense_id": "7bde5c83-3500-3e14-9894-45ff23b81473",
                                                "text": "„Paris ist die Stadt des Feuilletons, hier ist dieses Genre im 19. Jahrhundert entstanden; die Berliner Feuilletonisten wie Ludwig Rellstab, Ernst Kossak, Julius Rodenberg kommen, um ihre Lehrzeit in Paris zu absolvieren.“"
                                            },
                                            {
                                                "example_id": "dd0f3c83-caca-4405-a4e3-49cf2d24d21c",
                                                "sense_id": "7bde5c83-3500-3e14-9894-45ff23b81473",
                                                "text": "„Es folgten schwierige Jahre in Berlin, als Feuilletonist, zusätzlich auch als Dozent an Wilhelm Liebknechts sozialistischer Arbeiterbildungsschule.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac536e7d-e3ba-424a-b652-456e0710e6fa",
                        "source_entry_id": "a6e6a902-7c53-301b-979a-a8649392d7fe",
                        "source_sense_id": "320bdd82-8fc2-31fe-9463-55062471e786",
                        "target_lang_word": "Feuilletonistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuilletonistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9210c0bd-e1d7-3305-9b4a-8c253ee267ee",
                                        "entry_id": "933dccdd-e700-3df7-b97d-3c7187159791",
                                        "glosses": [
                                            "weibliche Person, die Beiträge zum Feuilleton verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc58a834-850f-4fad-a3c8-32c6cb921c0f",
                                                "sense_id": "9210c0bd-e1d7-3305-9b4a-8c253ee267ee",
                                                "text": "„Nachdem sie sich Mitte der 1920er Jahre zu etablieren begann und eine gefragte Feuilletonistin wurde, war sie nach der Machtergreifung der Nationalsozialisten, ähnlich wie Mascha Kaléko, Dinah Nelken und viele andere Zeitgenossinnen, gezwungen, sich aus dem Journalismus zurückzuziehen und konnte auch später nicht an die früheren Erfolge anknüpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f784dbd-f551-4ac7-aec3-ab48491d0c3e",
                        "source_entry_id": "a6e6a902-7c53-301b-979a-a8649392d7fe",
                        "source_sense_id": "320bdd82-8fc2-31fe-9463-55062471e786",
                        "target_lang_word": "columnist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "columnist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                        "entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
                                        "glosses": [
                                            "A regular writer of a column, such as in a magazine or newspaper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd08776-e5f4-41e5-b306-bff48f3e0127",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "a sports columnist"
                                            },
                                            {
                                                "example_id": "675968fb-937b-4d0d-a9ef-b01aa348f82d",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "a news columnist"
                                            },
                                            {
                                                "example_id": "484fe5d7-07d3-4400-8f7c-5abe9610757d",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "a sporadic columnist"
                                            },
                                            {
                                                "example_id": "a60260b5-e449-43ee-a306-3d0169131d1a",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "Ann Landers, who sometimes wrote her columns from her bathtub, called herself “the general manager of the world,” which pretty much describes the types of questions an advice columnist might be called upon to answer."
                                            },
                                            {
                                                "example_id": "4350188b-ab4d-4138-a15a-ea9a90863407",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "As soon as it was suggested that it was considering the Swedish model – in which men are criminalised for buying sex, but the women working in prostitution are decriminalised – a slew of prominent male columnists started arguing against this infringement on a man's right to purchase a woman's body."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0edd1488-bc53-4db0-b5da-f271b8c2a29d",
                        "source_entry_id": "a6e6a902-7c53-301b-979a-a8649392d7fe",
                        "source_sense_id": "320bdd82-8fc2-31fe-9463-55062471e786",
                        "target_lang_word": "feuilletonist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feuilletonist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca93220f-7ae3-3cbe-a195-2f5400eadd9f",
                                        "entry_id": "731f74ad-bf98-3ac4-bbe9-4a5d4979736f",
                                        "glosses": [
                                            "A writer of feuilletons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7888315a-a68c-4a6b-a6d6-28ad1b0f05e3",
                                                "sense_id": "ca93220f-7ae3-3cbe-a195-2f5400eadd9f",
                                                "text": "In 1895, while Japan was busy beating China, and had convinced herself that she could beat the world, one of the Tōkyō papers achieved a success by the publication of a serial noved entitled Asahi-Zakura, by a feuilletonist called Murai Gensai."
                                            },
                                            {
                                                "example_id": "ff94d651-d097-40bc-ac6a-bf32fd014bf3",
                                                "sense_id": "ca93220f-7ae3-3cbe-a195-2f5400eadd9f",
                                                "text": "But for all this, Grassou gave excellent counsel, like those feuilletonists incapable of writing a book who know very well where a book is wanting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05cf8852-d00a-4ea5-ae0e-f21187e43b8f",
                        "source_entry_id": "a6e6a902-7c53-301b-979a-a8649392d7fe",
