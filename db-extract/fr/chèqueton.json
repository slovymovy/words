                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "a870125f-0fce-4f07-a9e7-895c5c7ccab8",
                                "sense_id": "ff915c44-e44c-3494-9eea-e75b834c68cf",
                                "text": "Un bon petit chèqueton de dix sacs s’est laissé extraire le Gros, « en provision », plutôt que de réemballer l’Irène dans sa tire !"
                            },
                            {
                                "example_id": "83519ee4-0605-407f-a8a5-01999419bb6e",
                                "sense_id": "ff915c44-e44c-3494-9eea-e75b834c68cf",
                                "text": "Le téléphone sans cesse sonne, le courrier sans cesse arrive, avec parfois, une « petite surprise », un « petit chèqueton » dont sa joie est grande de me tendre l’enveloppe."
                            },
                            {
                                "example_id": "6c519f37-3708-4954-8c18-ee4572db7b3e",
                                "sense_id": "ff915c44-e44c-3494-9eea-e75b834c68cf",
                                "text": "Seulement, voilà, il aura droit à un bel enterrement et sa daronne dans le Bronx à quelques fleurs et un chèqueton pour embellir sa peine."
                            }
                        ]
                    }
