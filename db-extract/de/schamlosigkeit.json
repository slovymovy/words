                                "target_senses": [
                                    {
                                        "sense_id": "b89bfc1e-b20d-3346-b3b0-1dabf79ee0a7",
                                        "entry_id": "ed2aac4c-8597-307e-a8d1-1b37df855779",
                                        "glosses": [
                                            "nieliczenie się z nikim i niczym, zbytnia pewność siebie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b7f4e06-1bc3-4430-b98a-971e62c889a2",
                                                "sense_id": "b89bfc1e-b20d-3346-b3b0-1dabf79ee0a7",
                                                "text": "Zamiast porządnieć, wspinasz się na szczyt bezczelności."
                                            },
                                            {
                                                "example_id": "d64d5564-c21e-4845-8726-614c8186ca7d",
                                                "sense_id": "b89bfc1e-b20d-3346-b3b0-1dabf79ee0a7",
                                                "text": "Nie oddałeś poprzedniego długu, a chcesz znów pożyczyć pieniądze? To bezczelność."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ec3d21c-62ba-4c1d-8e61-4d832ea5b58b",
                        "source_entry_id": "245371d9-57d0-3ad8-a986-684c17b3aa6e",
                        "source_sense_id": "dbd53ec5-5034-3447-8b59-79452c791750",
                        "source_sense_description": "schamlose Art",
