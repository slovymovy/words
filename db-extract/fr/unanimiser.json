                "senses": [
                    {
                        "sense_id": "69fb98bb-4636-3191-b34e-8d15b4eafc7a",
                        "entry_id": "8e1bc370-9611-3ec1-996c-d50f73e56d79",
                        "glosses": [
                            "Rendre unanime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8dc71ed-01b9-4446-a731-59905404523f",
                                "sense_id": "69fb98bb-4636-3191-b34e-8d15b4eafc7a",
                                "text": "Il \"faut\" discuter, partager, échanger, convaincre, argumenter, uniformiser, unanimiser, convenir, circonvenir."
                            },
                            {
                                "example_id": "8d3f1fbb-fe39-4e4c-a775-f21ffeffde1f",
                                "sense_id": "69fb98bb-4636-3191-b34e-8d15b4eafc7a",
                                "text": "Si, ce temps passé, ils n'ont pu s’unanimiser, ils votent alors, à la majorité."
                            },
                            {
                                "example_id": "ac7538d0-df5f-41aa-bcba-3083e4e6c2f2",
                                "sense_id": "69fb98bb-4636-3191-b34e-8d15b4eafc7a",
                                "text": "Et, pour maintenir ce goût, à la fois « essentiel » et « exponentiel », de s’unanimiser jusqu’au bout, que placer à la base sinon un attrait toujours plus explicitement exercé sur l’Espèce par le centre approchant de sa convergence biologique ?"
                            }
                        ]
                    }
