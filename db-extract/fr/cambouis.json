        "fr-extract.jsonl": [
            {
                "entry_id": "c9086abf-dac9-3d6f-8fd3-7a1b6fd9db04",
                "word": "cambouis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d27ff79-14b0-3806-ac9e-7f678f5ae358",
                        "entry_id": "c9086abf-dac9-3d6f-8fd3-7a1b6fd9db04",
                        "glosses": [
                            "Graisse avec laquelle on enduisait les essieux des voitures pour en faciliter le mouvement."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "07ef0385-36d1-3022-a0e0-35ec86ed5534",
                        "entry_id": "c9086abf-dac9-3d6f-8fd3-7a1b6fd9db04",
                        "glosses": [
                            "Graisse usagée et noircie dans la mécanique."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "639aeeb7-0926-4b9e-a0da-eed76ad3eef3",
                                "sense_id": "07ef0385-36d1-3022-a0e0-35ec86ed5534",
                                "text": "La veuve avait une robe verte garnie de chinchilla, qui lui allait comme une tache de cambouis sur le voile d’une mariée."
                            },
                            {
                                "example_id": "2dcea443-3755-45ff-9921-07d50b512d62",
                                "sense_id": "07ef0385-36d1-3022-a0e0-35ec86ed5534",
                                "text": "Les substances lubrifiantes ou enduits doivent être renouvelés souvent, car ils se chargent de poussière et de parcelles détachées des corps frottants, et ils forment une matière visqueuse nommée cambouis, qui augmente le frottement."
                            },
                            {
                                "example_id": "ae474ae1-f61f-4d7f-bb29-aeeffe4bfcac",
                                "sense_id": "07ef0385-36d1-3022-a0e0-35ec86ed5534",
                                "text": "Je faisais l’effet d’une tache de cambouis sur une robe de satin."
                            },
                            {
                                "example_id": "23dfdb4a-bc52-4793-af4d-8732cfdfc11d",
                                "sense_id": "07ef0385-36d1-3022-a0e0-35ec86ed5534",
                                "text": "Il me voyait, mon marteau à la main, et les doigts noirs de cambouis, penché sur un objet qui lui semblait très laid."
                            }
                        ]
                    },
                    {
                        "sense_id": "02e92f88-32b8-33f0-8f41-f31de2880238",
                        "entry_id": "c9086abf-dac9-3d6f-8fd3-7a1b6fd9db04",
                        "glosses": [
                            "Matière sébacée qui se trouve en quantité plus ou moins importante dans le prépuce de la verge des chevaux."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39844d18-c57b-428d-ae8b-6bc614cb610a",
                        "source_entry_id": "c9086abf-dac9-3d6f-8fd3-7a1b6fd9db04",
                        "target_lang_word": "Schmiere",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmiere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d92030aa-46af-33b6-a18e-c3c53caf7c57",
                                        "entry_id": "4318a8f5-498b-352b-85f2-1ff5cd70dc7b",
                                        "glosses": [
                                            "ölige, fetthaltige Substanz, besonders Schmiermittel und Schuhcreme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae62b9f6-a588-4afa-8e84-d007392e9d80",
                                                "sense_id": "d92030aa-46af-33b6-a18e-c3c53caf7c57",
                                                "text": "„Ulis ruhigere Gemütsweise, sein milderes Wesen, welches nicht immer erhitzt war zu Feuer und Flammen im Jagen nach einem unerreichbaren Ziele, einem Wagen gleich, den man ohne Roß und ohne Schmiere dahintreibt, hatte einen wohltätigen Einfluß auf die Arbeiter und das Gesinde.“"
                                            },
                                            {
                                                "example_id": "31b0994a-dbfd-405b-857e-329ab8da28e4",
                                                "sense_id": "d92030aa-46af-33b6-a18e-c3c53caf7c57",
                                                "text": "Die Anhängerkupplung quietscht, wie wäre es mit ein bisschen Schmiere?"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "1d51c3dd-3c53-32b0-b41f-775c83014db3",
                                        "entry_id": "4318a8f5-498b-352b-85f2-1ff5cd70dc7b",
                                        "glosses": [
                                            "Hautpflegemittel, bei dem die wirksamen Substanzen mit einer (fettigen) Masse vermengt sind"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "e3d0bef7-f136-3ea0-bd59-4286a49def46",
                                        "entry_id": "4318a8f5-498b-352b-85f2-1ff5cd70dc7b",
                                        "glosses": [
                                            "feuchte, glitschige, schmierige Substanz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e98ac0-d60e-49fc-bd04-fabe4b9eb7e4",
                                                "sense_id": "e3d0bef7-f136-3ea0-bd59-4286a49def46",
                                                "text": "„Sie zündeten trotz dem Einspruch des Gastgebers ein Endchen Fackel an, womit sonst den Spielern, die sich nach Verlust ihres Geldes fluchend entfernten, zur Tür geleuchtet wurde, und traten damit in die Kammer, in der die Frau bis zu den Knien hinab in der Schmiere lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1dbe2eba-2eac-38d2-9594-4464cf6aac87",
                                        "entry_id": "4318a8f5-498b-352b-85f2-1ff5cd70dc7b",
                                        "glosses": [
                                            "der streichbare Belag für die zum Verzehr bestimmte Brotschnitte"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4aee5f5-cf56-43b2-8f55-e435d57c236b",
                                                "sense_id": "1dbe2eba-2eac-38d2-9594-4464cf6aac87",
                                                "text": "Diese Schmiere sieht kaum appetitlich aus, und schmeckt auch so."
                                            }
                                        ],
                                        "sense_index_json": "\"3a\""
                                    },
                                    {
                                        "sense_id": "7e260e25-5348-3f7e-a67f-99edb9fdeb3d",
                                        "entry_id": "4318a8f5-498b-352b-85f2-1ff5cd70dc7b",
                                        "glosses": [
                                            "Scheibe Brot mit (streichbarem) Belag"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ab0966b-013c-4632-aa6c-7bea81f27675",
                                                "sense_id": "7e260e25-5348-3f7e-a67f-99edb9fdeb3d",
                                                "text": "Hastig griff sie sich eine belegte Schmiere, die ihr als Frühstück genügen musste, und stürzte schon zu ihrem ersten Termin."
                                            }
                                        ],
                                        "sense_index_json": "\"3b\""
                                    },
                                    {
                                        "sense_id": "3460ccfb-abac-3f54-af87-987277b469fb",
                                        "entry_id": "4318a8f5-498b-352b-85f2-1ff5cd70dc7b",
                                        "glosses": [
                                            "Schläge"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7e55a10-0fbd-41d6-812d-6d61503587cf",
                                                "sense_id": "3460ccfb-abac-3f54-af87-987277b469fb",
                                                "text": "„Es geschah wohl auch, daß Lehrer von der Art, welche alle Tage dreimal Schmiere mit der Rute nötig hätten, die Knaben, weil sie zu spät kamen, fragten, ob sie noch Därme hätten putzen oder auseinanderziehen müssen, oder daß sie einem, weil er seine Aufgabe nicht nach dem Sinne des Lehrers machte, sagten: »Aus dir gibt es dein Lebtag nichts als so ein dummer, grober Metzger, und es ist schade für jeden Kreuzer, den dein Vater für dich ausgibt!«“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b24f9b1d-e859-3a2b-a5b6-e861ed2e3ce4",
                                        "entry_id": "4318a8f5-498b-352b-85f2-1ff5cd70dc7b",
                                        "glosses": [
                                            "schlechte Wanderbühne"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0668e911-2dcb-4f48-b405-cba9af149d88",
                                                "sense_id": "b24f9b1d-e859-3a2b-a5b6-e861ed2e3ce4",
                                                "text": "„Das mit dem Theater sei freilich ein Wagestück. Wenn das Haus auch ganz hübsch zustande käme, wie solle man eine anständige Truppe herbeiziehen? Und mit einer armseligen Schmiere werde man doch nicht zufrieden sein.“"
                                            },
                                            {
                                                "example_id": "71a3d812-76b7-476c-8b42-4dadd5a963df",
                                                "sense_id": "b24f9b1d-e859-3a2b-a5b6-e861ed2e3ce4",
                                                "text": "„Seht doch die ausgezeichnete Schauspielerin, wie sie fremde Charaktere spielt, sich gebärdet wie auf dem Holzgerüst einer Schmiere, wie auf dem Jahrmarkt!“"
                                            }
                                        ],
                                        "sense_index_json": "\"5a\""
                                    },
                                    {
                                        "sense_id": "91d4a33b-405b-3436-aac8-ded7cc4bd214",
                                        "entry_id": "4318a8f5-498b-352b-85f2-1ff5cd70dc7b",
                                        "glosses": [
                                            "provinzielles, niveauloses Theater"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276f4315-5b47-4c6c-859d-19a1857360b2",
                                                "sense_id": "91d4a33b-405b-3436-aac8-ded7cc4bd214",
                                                "text": "„Meine Klage ist das alte Lied; die Directoren behandeln uns schlecht, sie glauben, weil sie uns Gage zahlen, müssen wir ihnen dienstbar seyn, das ist doch gegen alle Menschenwürde. Sehn Sie, ich bin Schofel’s Perle, sein Juwel, nur mich will das Publicum sehen, ohne mich muß er seine Schmiere schließen.“"
                                            },
                                            {
                                                "example_id": "a4ad7ecd-9e22-4bcf-9cb6-ceb093c83783",
                                                "sense_id": "91d4a33b-405b-3436-aac8-ded7cc4bd214",
                                                "text": "„Hermann Steinert, Theaterdirektor, las Fox an der Tür, auf einem Schild. - Schmiere! dachte er verächtlich; so tief bin ich noch nicht gesunken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5b\""
                                    },
                                    {
                                        "sense_id": "835e51ff-c7b1-3c16-ae9a-9705a9fca7d8",
                                        "entry_id": "4318a8f5-498b-352b-85f2-1ff5cd70dc7b",
                                        "glosses": [
                                            "unerlaubte Übersetzungshilfe während einer Klassenarbeit"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5394ddff-3a3b-4e7a-9c6a-d422b633dd26",
                                                "sense_id": "835e51ff-c7b1-3c16-ae9a-9705a9fca7d8",
                                                "text": "Bei der letzten Prüfung in Latein hat Thomas eine Schmiere benutzt."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schmiere",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68255ab0-400f-3740-992d-5d22e47c6888",
                                        "entry_id": "d284e6b6-f8f5-39ea-b3a9-6768711b83c1",
                                        "glosses": [
                                            "Wachdienst; den Wachdienst ausübender Wachposten"
                                        ],
                                        "tags": [
                                            "Gaunersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d6a210d-04a1-4083-8833-a9f61d729d15",
                                                "sense_id": "68255ab0-400f-3740-992d-5d22e47c6888",
                                                "text": "„Der Eine kann nur als Schränker glücklich handeln, der Andere sucht als Hochstappler bei der Agroscheninnung sich einen Namen zu machen; der Dritte vermag allein als Baldoberer oder Schmiere bei einem Einbruch der polizeilichen Gewalt gegenüber List der Schlauheit, Verwegenheit der Kühnheit entgegenzusetzen; der Vierte nur als Kochuner, Kinsler, Dorfdrücker, Treppenschleicher, Leimgänger sich eine Virtuosität zu erwerben.“"
                                            },
                                            {
                                                "example_id": "d9cec3ef-7295-4efb-b78c-7594e1aae519",
                                                "sense_id": "68255ab0-400f-3740-992d-5d22e47c6888",
                                                "text": "„Jadeflöte stand an der Türe Schmiere, während die beiden im Zimmer tändelten und kosten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6a88e9d4-ea4c-3cfa-b880-968453829835",
                                        "entry_id": "d284e6b6-f8f5-39ea-b3a9-6768711b83c1",
                                        "glosses": [
                                            "Polizei"
                                        ],
                                        "tags": [
                                            "Gaunersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d13465-6000-4353-91d8-03a770f9c015",
                                                "sense_id": "6a88e9d4-ea4c-3cfa-b880-968453829835",
                                                "text": "„Da sagte ich: »Ich hab noch nie ein Papier besessen; hab auch keins vonnöten gehabt auf meinen Reisen. - Wo kann man denn so was bekommen?« / »Auf der Polizei halt!« erwiderte mir der Fritz. / Der Magister aber wollt nicht viel davon wissen und brummelte: »Narr, einfältiger! Läßt den Kaffer zur Schmiere laufen! - Daß die grünen Hunde von mir Wind bekommen und mich einkasteln! Bist wohl verrückt - he!«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84003f1f-8ffb-47ea-8d39-8cca6950241d",
                        "source_entry_id": "c9086abf-dac9-3d6f-8fd3-7a1b6fd9db04",
                        "target_lang_word": "wagensmeer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
