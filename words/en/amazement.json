{
    "word_family": [
        "amaze",
        "amazing",
        "amazed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a1a4ddb-5f60-3980-b5c6-054d00b9bb79",
                    "sense_definition": "A feeling of great surprise or wonder.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stared at the beautiful sunset in <w>amazement</w>.",
                            "target_lang_translations": {
                                "ru": "Она смотрела на красивый закат с <w>изумлением</w>."
                            }
                        },
                        {
                            "text": "To my <w>amazement</w>, he finished the difficult project in one day.",
                            "target_lang_translations": {
                                "ru": "К моему <w>удивлению</w>, он закончил сложный проект за один день."
                            }
                        }
                    ],
                    "synonyms": [
                        "astonishment",
                        "wonder",
                        "surprise"
                    ],
                    "common_phrases": [
                        "in amazement",
                        "to my amazement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сильного удивления или восхищения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изумле́ние",
                                "target_lang_sense_clarification": "крайняя степень удивления"
                            },
                            {
                                "target_lang_word": "удивле́ние",
                                "target_lang_sense_clarification": "состояние, вызванное чем-то неожиданным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "445f3833-0c66-39ef-8fbf-094d57fe5982",
                    "sense_definition": "Something that causes a feeling of great surprise or wonder.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician performed an <w>amazement</w> that left the audience speechless.",
                            "target_lang_translations": {
                                "ru": "Фокусник показал такое <w>чудо</w>, что зрители лишились дара речи."
                            }
                        },
                        {
                            "text": "The new building is an <w>amazement</w> of modern architecture.",
                            "target_lang_translations": {
                                "ru": "Это новое здание — настоящее <w>диво</w> современной архитектуры."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonder",
                        "marvel"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что вызывает чувство сильного удивления или восхищения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чу́до",
                                "target_lang_sense_clarification": "нечто удивительное, поразительное"
                            },
                            {
                                "target_lang_word": "ди́во",
                                "target_lang_sense_clarification": "нечто необычное, вызывающее восхищение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "580dcd62-5fba-3cbc-a91f-a0e0f5bf8013",
                    "sense_definition": "A state of extreme mental confusion or frenzy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden chaos threw the crowd into a state of <w>amazement</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапный хаос поверг толпу в состояние <w>смятения</w>."
                            }
                        },
                        {
                            "text": "He wandered through the streets in a fit of <w>amazement</w>.",
                            "target_lang_translations": {
                                "ru": "Он бродил по улицам в припадке <w>исступления</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "frenzy",
                        "madness"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сильного душевного смятения или исступления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смяте́ние",
                                "target_lang_sense_clarification": "состояние растерянности и беспокойства"
                            },
                            {
                                "target_lang_word": "исступле́ние",
                                "target_lang_sense_clarification": "крайнее возбуждение, потеря самообладания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}