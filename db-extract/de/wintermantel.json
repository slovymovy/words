                "senses": [
                    {
                        "sense_id": "7c0daaf4-fcce-3a67-a6d3-c0253ab10b78",
                        "entry_id": "31b64bd6-1433-3d3f-b02f-fd91af8de428",
                        "glosses": [
                            "warmer Mantel, der nur an kalten Tagen getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c612bb-2610-43e1-94e7-1b0f7d450a2e",
                                "sense_id": "7c0daaf4-fcce-3a67-a6d3-c0253ab10b78",
                                "text": "„Der Wintermantel wird zum erstenmal wieder aus der Tiefe des Schranks geholt.“"
                            },
                            {
                                "example_id": "55fa0836-f167-4fa0-ba3b-0f0c929e9462",
                                "sense_id": "7c0daaf4-fcce-3a67-a6d3-c0253ab10b78",
                                "text": "„Dass alle Kinder warme Winterschuhe besaßen und Johanna und Fried Wintermäntel, fiel ihm zum Glück nicht auf.“"
                            },
                            {
                                "example_id": "ed282104-0d03-485c-b910-b54511cabca5",
                                "sense_id": "7c0daaf4-fcce-3a67-a6d3-c0253ab10b78",
                                "text": "„Sie hatte einen kleinen Rucksack auf dem Rücken, einen hübschen dunkelblauen Hut auf und den dicken blauen Wintermantel mit dem Pelzkragen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
