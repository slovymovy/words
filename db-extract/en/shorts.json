                                                "sense_id": "f36ed710-2c4d-308a-a461-c379b6066cec",
                                                "text": "Er trug ein rotes T-Shirt und blaue Shorts."
                                            },
                                            {
                                                "example_id": "2e09a93f-32fa-446c-ab24-659a05a7a2cd",
                                                "sense_id": "f36ed710-2c4d-308a-a461-c379b6066cec",
                                                "text": "„Er verlässt sofort das Haus, so, wie er ist, in Shorts und Flip-Flops.“"
                                            },
                                            {
                                                "example_id": "90398d2a-e3fe-4a2f-ae4b-83fc39ea3d8e",
                                                "sense_id": "f36ed710-2c4d-308a-a461-c379b6066cec",
                                                "text": "„Ein betrunkener Mann in Shorts und zerschlissenem Hemd näherte sich.“"
                                            },
                                            {
                                                "example_id": "583c32b4-6f0f-4da6-8195-3581e4e186c2",
                                                "sense_id": "f36ed710-2c4d-308a-a461-c379b6066cec",
                                                "text": "„Schon sind schwarzseidene Shorts für sommerliche Trauerfälle und warme gesellige Anlässe in Vorbereitung.“"
                                            },
                                            {
                                                "example_id": "ef118c5c-c5d8-49b1-aee5-30af3244670c",
                                                "sense_id": "f36ed710-2c4d-308a-a461-c379b6066cec",
                                                "text": "„Ich sah mir den kleinen Leif an, er trug Shorts und ein Hemdchen, das halb aus dem Hosenbund gerutscht war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
