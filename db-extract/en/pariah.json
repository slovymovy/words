                                                "sense_id": "33f5e728-759d-30f1-9e3e-dc555775da46",
                                                "text": "la casta dei paria"
                                            },
                                            {
                                                "example_id": "453c9a5b-0e23-426f-89bc-7c19a63e4d1c",
                                                "sense_id": "33f5e728-759d-30f1-9e3e-dc555775da46",
                                                "text": "Gandhi chiamava i paria \"figli di Dio\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d944b27-5800-3eec-a53c-05ae139182e5",
                                        "entry_id": "03fae755-246e-387e-b1ff-deb6f75daeed",
                                        "glosses": [
                                            "persona che è o ritiene di essere estromessa dalla società o comunque socialmente indesiderata a causa della sua origine umile, della sua condizione di povertà eccetera"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ff1a06-b4af-4047-9353-76448657c5b1",
                                                "sense_id": "6d944b27-5800-3eec-a53c-05ae139182e5",
                                                "text": "i paria della società"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paria",
