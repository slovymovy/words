                                        "entry_id": "ac63a613-59be-330a-9c30-4231d1688204",
                                        "glosses": [
                                            "A tropical Asian plant (Sesamum indicum) bearing small flat seeds used as food and as a source of oil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "602f9b6a-89da-33c7-a354-ef1639f10aea",
                                        "entry_id": "ac63a613-59be-330a-9c30-4231d1688204",
                                        "glosses": [
                                            "The seed of this plant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed5d6a39-045b-4bd9-9934-b0bde000b56d",
                                                "sense_id": "602f9b6a-89da-33c7-a354-ef1639f10aea",
                                                "text": "First, marinate the tofu. In a bowl, whisk the kecap manis, chilli sauce, and sesame oil together. Cut the tofu into strips about 1cm thick, mix gently (so it doesn't break) with the marinade and leave in the fridge for half an hour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
