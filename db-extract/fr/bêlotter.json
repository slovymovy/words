                "senses": [
                    {
                        "sense_id": "b236086f-b908-3958-bbe0-ad8848ee4ef9",
                        "entry_id": "89d81c1e-202c-3f10-a71b-c0ba3fedecc0",
                        "glosses": [
                            "Bêler, avec des petits bêlements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2078e1eb-4db0-4d1c-a3e1-d3d841d30283",
                                "sense_id": "b236086f-b908-3958-bbe0-ad8848ee4ef9",
                                "text": "Le loup en entendant cette drôle de voix qui roulotte, qui bêlotte et qui tremblote sort bien vite et se sauve en hurlant, la queue entre les jambes."
                            },
                            {
                                "example_id": "31346363-03e4-4e69-a75e-7d83293a9bfe",
                                "sense_id": "b236086f-b908-3958-bbe0-ad8848ee4ef9",
                                "text": "Il reprend vite ses sens et bêlotte, bon signe, le petit être respire et cela le remet (car il ne respire pas dans le ventre de sa mère)."
                            }
                        ]
                    }
