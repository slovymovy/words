                    "sense_id": "386336d8-f0d5-39b1-907b-0209cfbe4b68",
                    "sense_definition": "Een groot gebied dat dicht begroeid is met bomen en struiken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We maken elke zondag een lange wandeling in het <w>bos</w>.",
                            "target_lang_translations": {
                                "en": "We take a long walk in the <w>woods</w> every Sunday.",
                                "ru": "Мы каждое воскресенье совершаем долгую прогулку в <w>лесу</w>.",
                                "pl": "W każdą niedzielę chodzimy na długi spacer do <w>lasu</w>.",
                                "de": "Wir machen jeden Sonntag einen langen Spaziergang im <w>Wald</w>.",
                                "fr": "Nous faisons une longue promenade dans les <w>bois</w> tous les dimanches.",
                                "it": "Facciamo una lunga passeggiata nel <w>bosco</w> ogni domenica.",
                                "cs": "Každou neděli podnikáme dlouhou procházku v <w>lese</w>.",
                                "tr": "Her pazar <w>ormanda</w> uzun bir yürüyüş yaparız.",
                                "es": "Damos un largo paseo por el <w>bosque</w> todos los domingos."
                            }
                        },
                        {
                            "text": "De kinderen speelden verstoppertje achter de bomen in het <w>bos</w>.",
                            "target_lang_translations": {
                                "en": "The children played hide-and-seek behind the trees in the <w>forest</w>.",
                                "ru": "Дети играли в прятки за деревьями в <w>лесу</w>.",
                                "pl": "Dzieci bawiły się w chowanego za drzewami w <w>lesie</w>.",
                                "de": "Die Kinder spielten Verstecken hinter den Bäumen im <w>Wald</w>.",
                                "fr": "Les enfants jouaient à cache-cache derrière les arbres dans la <w>forêt</w>.",
                                "it": "I bambini giocavano a nascondino dietro gli alberi nella <w>foresta</w>.",
                                "cs": "Děti si hrály na schovávanou za stromy v <w>lese</w>.",
                                "tr": "Çocuklar <w>ormandaki</w> ağaçların arkasında saklambaç oynuyorlardı.",
                                "es": "Los niños jugaban al escondite detrás de los árboles en el <w>bosque</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "woud"
                    ],
                    "common_phrases": [
                        "in het bos",
                        "door het bos",
                        "het donkere bos"
                    ],
                    "target_lang_definitions": {
