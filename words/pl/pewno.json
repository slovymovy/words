                    "sense_id": "762e8a1e-ada8-325f-aefa-105f51129369",
                    "sense_definition": "Słowo wyrażające potwierdzenie, zgodę lub całkowitą pewność; używane często jako krótka, potoczna odpowiedź twierdząca.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "– Czy mogę pożyczyć twój długopis? – <w>Pewno</w>, bierz śmiało!",
                            "target_lang_translations": {
                                "ru": "– Могу я одолжить твою ручку? – <w>Конечно</w>, бери смело!",
                                "en": "– Can I borrow your pen? – <w>Sure</w>, go ahead!",
                                "nl": "– Mag ik je pen lenen? – <w>Natuurlijk</w>, pak hem gerust!",
                                "de": "– Kann ich mir deinen Stift leihen? – <w>Klar</w>, nimm ihn ruhig!",
                                "fr": "– Puis-je emprunter ton stylo ? – <w>Bien sûr</w>, sers-toi !",
                                "it": "– Posso prendere in prestito la tua penna? – <w>Certo</w>, prendila pure!",
                                "cs": "– Můžu si půjčit tvoji propisku? – <w>Jasně</w>, klidně si ji vezmi!",
                                "tr": "– Kalemini ödünç alabilir miyim? – <w>Tabii</w>, çekinmeden al!",
                                "es": "– ¿Puedo pedirte prestado el bolígrafo? – ¡<w>Claro</w>, tómalo sin miedo!",
                                "zh": "——我可以借用你的笔吗？——<w>当然</w>可以，拿去用吧！"
                            }
                        },
                        {
                            "text": "<w>Pewno</w>, że przyjdę na twoje przyjęcie.",
                            "target_lang_translations": {
                                "ru": "<w>Конечно</w>, я приду на твою вечеринку.",
                                "en": "<w>Of course</w> I will come to your party.",
                                "nl": "<w>Natuurlijk</w> kom ik naar je feestje.",
                                "de": "<w>Natürlich</w> komme ich zu deiner Party.",
                                "fr": "<w>Évidemment</w>, je viendrai à ta fête.",
                                "it": "<w>Certamente</w>, verrò alla tua festa.",
                                "cs": "<w>Samozřejmě</w>, že na tvoji oslavu přijdu.",
                                "tr": "<w>Elbette</w> partine geleceğim.",
                                "es": "<w>Por supuesto</w> que iré a tu fiesta.",
                                "zh": "<w>当然</w>，我会去参加你的派对。"
                            }
                        }
                    ],
