    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c5379fc-99a3-3b30-9e7e-b6a3130fd715",
                    "sense_definition": "Короткая одежда для верхней части тела, обычно изготовляемая из мягкой ткани.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она надела тёплую <w>кофту</w> перед выходом на улицу.",
                            "target_lang_translations": {
                                "en": "She put on a warm <w>cardigan</w> before going outside."
                            }
                        },
                        {
                            "text": "Эта вязаная <w>кофта</w> очень мягкая и удобная.",
                            "target_lang_translations": {
                                "en": "This knitted <w>sweater</w> is very soft and comfortable."
                            }
                        }
                    ],
                    "common_phrases": [
                        "вязаная кофта",
                        "тёплая кофта"
                    ],
                    "target_lang_definitions": {
                        "en": "A short garment for the upper body, usually made of soft fabric."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cardigan",
                                "target_lang_sense_clarification": "A knitted sweater that fastens up the front."
                            },
                            {
                                "target_lang_word": "knitted jacket",
                                "target_lang_sense_clarification": "A general term for a jacket made of knitted material."
                            },
                            {
                                "target_lang_word": "sweater",
                                "target_lang_sense_clarification": "A common term for a knitted upper-body garment."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3b5fd94-1673-3c52-b5a9-716613984dd0",
                    "sense_definition": "Короткое тёплое женское пальто.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бабушка накинула старую <w>кофту</w> и вышла в сад.",
                            "target_lang_translations": {
                                "en": "Grandma threw on an old <w>jacket</w> and went out into the garden."
                            }
                        },
                        {
                            "text": "В холодную погоду она всегда носит эту шерстяную <w>кофту</w>.",
                            "target_lang_translations": {
