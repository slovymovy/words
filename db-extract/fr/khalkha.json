                        "examples": [
                            {
                                "example_id": "5124352f-cb6b-4f60-96b7-cb0084184158",
                                "sense_id": "888174c7-2dc2-3a2e-a6b0-787cb8b8e266",
                                "text": "Plusieurs dialectes, tel le bouriate ou le khalkha connaissent des suffixes personnels dont l’emploi n’est cependant pas exclusif."
                            },
                            {
                                "example_id": "0d845ef0-4708-4e1e-9537-a3fcb01e2d4a",
                                "sense_id": "888174c7-2dc2-3a2e-a6b0-787cb8b8e266",
                                "text": "Le khalkha est la langue de la Mongolie Extérieure, ou si l’on préfère à cette dénomination géographique une définition politique, celle de la République Populaire Mongole."
                            }
                        ]
                    }
