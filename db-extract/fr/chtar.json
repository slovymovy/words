                    },
                    {
                        "sense_id": "be47ac11-4c96-301a-8df6-2536a280e705",
                        "entry_id": "4fa13f77-b96a-32de-a1cd-22d5f0ae3969",
                        "glosses": [
                            "pukkel, puist"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "c780f800-7647-4d7a-833b-3feb316ee5f0",
                                "sense_id": "be47ac11-4c96-301a-8df6-2536a280e705",
                                "text": "Avec les chtars que j’ai sur la gueule, tu veux qu’je vienne en boîte avec toi?",
                                "translation": "Wil je dat ik met je naar de disco ga met die puisten op mijn smoel?"
                            }
                        ]
                    },
                    {
                        "sense_id": "018a5e4a-3888-3b12-bfbd-72acc61700c4",
                        "entry_id": "4fa13f77-b96a-32de-a1cd-22d5f0ae3969",
                        "glosses": [
                            "bajes, bak"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "0481c391-c5c2-4cf2-bc04-720e61904a4f",
                                "sense_id": "018a5e4a-3888-3b12-bfbd-72acc61700c4",
                                "text": "Mon frangin il est au chtar pour trois mois.",
                                "translation": "Mijn broer zit voor drie maanden in de bak."
                            }
                        ]
                    },
                    {
                        "sense_id": "abcf1260-59d8-3cec-a19c-08269d145035",
                        "entry_id": "4fa13f77-b96a-32de-a1cd-22d5f0ae3969",
                        "glosses": [
                            "smeris, juut"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "0dfbcfc5-c6bb-4a5d-937b-2aea06674f12",
                                "sense_id": "abcf1260-59d8-3cec-a19c-08269d145035",
                                "text": "V’là les chtars qui rappliquent, on s’casse!",
                                "translation": "Daar komen de smerissen weer aan, we gaan er vandoor!"
                            }
                        ]
                    }
