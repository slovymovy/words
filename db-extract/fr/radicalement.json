        "fr-extract.jsonl": [
            {
                "entry_id": "159fe6c3-b37e-36c3-a6c5-c9cfa59f3965",
                "word": "radicalement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1f0fcbf3-6cb4-36b7-9c63-22605ed43c9a",
                        "entry_id": "159fe6c3-b37e-36c3-a6c5-c9cfa59f3965",
                        "glosses": [
                            "Dans le principe, dans la source, essentiellement, complètement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6729c5b6-391c-4a0d-b4de-6742139102d2",
                                "sense_id": "1f0fcbf3-6cb4-36b7-9c63-22605ed43c9a",
                                "text": "Cette locution a deux significations radicalement différentes."
                            },
                            {
                                "example_id": "cd0744c2-a463-43a6-88e5-b7d0e244cde0",
                                "sense_id": "1f0fcbf3-6cb4-36b7-9c63-22605ed43c9a",
                                "text": "L'activité des défricheurs s'exerça plus radicalement aux détriments d'une Forêt Noire ou de Nègre Selve, située jadis entre Authon-la-Plaine et Chalo-Saint-Mars. Elle n'a laissé aucune trace dans la toponymie."
                            },
                            {
                                "example_id": "f9b284b6-9923-41e3-9c20-775d8b678541",
                                "sense_id": "1f0fcbf3-6cb4-36b7-9c63-22605ed43c9a",
                                "text": "Comme si c’était une nouveauté que la grâce fut fondée radicalement sur la nature,"
                            },
                            {
                                "example_id": "3b7b63c6-a0fe-494b-bcae-b3b6cc10f568",
                                "sense_id": "1f0fcbf3-6cb4-36b7-9c63-22605ed43c9a",
                                "text": "Et parce que vous [Dieu] pouvez tout ce que vous voulez, tout vous est possible, et il n'est possible radicalement et originairement que parce que vous le pouvez,"
                            },
                            {
                                "example_id": "118aa39a-21ab-4a22-809f-aa89b05dda74",
                                "sense_id": "1f0fcbf3-6cb4-36b7-9c63-22605ed43c9a",
                                "text": "Nul ne détruit si radicalement le gouvernement que celui qui en tire un usage directement contraire à la fin pour laquelle il est institué,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a72555d-7139-46b5-82ae-f009e19582e7",
                        "source_entry_id": "159fe6c3-b37e-36c3-a6c5-c9cfa59f3965",
                        "source_sense_id": "1f0fcbf3-6cb4-36b7-9c63-22605ed43c9a",
                        "target_lang_word": "radically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "688bb8e3-83e2-3388-848f-fef723cecc45",
                                        "entry_id": "3bbe7e38-2ac7-324e-afba-d10d91261847",
                                        "glosses": [
                                            "In a radical manner; fundamentally; very."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f6830b8-6a33-4c7c-a375-f16658493c8a",
                                                "sense_id": "688bb8e3-83e2-3388-848f-fef723cecc45",
                                                "text": "two radically different political groups"
                                            },
                                            {
                                                "example_id": "c1c5584e-fe69-49d5-9c12-48c0c8c05580",
                                                "sense_id": "688bb8e3-83e2-3388-848f-fef723cecc45",
                                                "text": "The reasons for this growing disconnect are myriad and complex but the situation is exacerbated by the reality that those English players who do smash through our game's \"glass ceiling\" command radically inflated transfer fees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05989351-3a42-379d-868e-f23623156087",
                                        "entry_id": "3bbe7e38-2ac7-324e-afba-d10d91261847",
                                        "glosses": [
                                            "At the root."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3e2a04-0feb-4fe8-a7d1-50b9853985cf",
                                                "sense_id": "05989351-3a42-379d-868e-f23623156087",
                                                "text": "\"Clot\" and \"clod\" are radically the same word."
                                            },
                                            {
                                                "example_id": "6b9abf95-babe-4486-82dd-2154cae8ffbe",
                                                "sense_id": "05989351-3a42-379d-868e-f23623156087",
                                                "text": "This [Algonquian] language [family] is spoken by all the Indians throughout New England. Every tribe, as that of Stockbridge, that of Farmington, that of New London, &c. has a different dialect [i.e. language], but the language [family] is radically the same."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61329850-4804-4daf-8561-c855faa052d4",
                        "source_entry_id": "159fe6c3-b37e-36c3-a6c5-c9cfa59f3965",
