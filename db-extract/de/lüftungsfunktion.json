                "senses": [
                    {
                        "sense_id": "4d3fb919-0606-3564-ab74-53971b7deb3c",
                        "entry_id": "c251e7d5-8ed1-313d-adcb-7eb64f7cb7c8",
                        "glosses": [
                            "gleichbleibende Aufgabe, die Lüftung erledigt bzw. erfüllt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6478c41-0617-41da-88f2-19ae892884d3",
                                "sense_id": "4d3fb919-0606-3564-ab74-53971b7deb3c",
                                "text": "„Die Lüftungsfunktionen, die in Wohnungen hauptsächlich in der CO2- und Wasserdampfabfuhr bestehen, müssen erhalten bleiben.“"
                            },
                            {
                                "example_id": "cb488e28-a41a-450c-86a5-1902e3c309ad",
                                "sense_id": "4d3fb919-0606-3564-ab74-53971b7deb3c",
                                "text": "„Die Nachrüstung der Lüftungsfunktion ist durch Austausch des EVB gegen einen Lüftungsantrieb mit Set-L3 (siehe unten) möglich.“"
                            },
                            {
                                "example_id": "0aa6ae08-e6e6-4f2b-a46c-cbe32e2b35e2",
                                "sense_id": "4d3fb919-0606-3564-ab74-53971b7deb3c",
                                "text": "„Die Aufgabe der Lüftungsfunktion ist die Luft zu befeuchten und entfeuchten.“"
                            },
                            {
                                "example_id": "fc4adf2f-26ee-4ea2-beda-be51eba26fa7",
                                "sense_id": "4d3fb919-0606-3564-ab74-53971b7deb3c",
                                "text": "„Bei Lüftungsanlagen übernehmen Ventilatoren die gesamte Lüftungsfunktion.“"
                            },
                            {
                                "example_id": "4b625b37-6f79-4dc6-8903-d9b064605446",
                                "sense_id": "4d3fb919-0606-3564-ab74-53971b7deb3c",
                                "text": "„Bei der Lüftungsfunktion arbeitet die Anlage mit 100 % Frischluft, standardgemäß mit Wärmerückgewinnung. Im Sommer kann die Anlage ohne Wärmerückgewinnung arbeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
