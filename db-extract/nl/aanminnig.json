                    {
                        "translation_id": "23539d77-daf3-4a09-9938-8161e572b823",
                        "source_entry_id": "5b4c2465-4bb2-3360-b74f-6de854def4b2",
                        "source_sense_id": "f530068f-ed44-3a95-a0a8-a9db8bd4112f",
