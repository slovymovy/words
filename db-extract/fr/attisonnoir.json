                        "sense_id": "9ea580c5-36d4-3c18-a3b9-559ebc2196fa",
                        "entry_id": "29a97c3f-a818-3546-9630-4a68c2c44bf9",
                        "glosses": [
                            "Outil pour attiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7062e12e-b1d9-44c2-bc76-ca4d47d2a6a7",
                                "sense_id": "9ea580c5-36d4-3c18-a3b9-559ebc2196fa",
                                "text": "ATTISONNOIR, s. m. les Fondeurs appellent ainsi un outil crochu dont ils se servent pour attiser le feu."
                            },
                            {
                                "example_id": "ad48f6ca-79c9-417d-84a5-34c036046289",
                                "sense_id": "9ea580c5-36d4-3c18-a3b9-559ebc2196fa",
                                "text": "Après avoir terminé ses affaires de la journée, Trevelyan s’assied devant son foyer; il fait du feu, et jette ensuite l’attisonnoir sur un bloc de plomb qui se trouvait par hasard à portée; tout aussitôt un son clair et retentissant se fait entendre."
                            }
                        ]
                    }
                ],
