                ],
                "senses": [
                    {
                        "sense_id": "2a216deb-bf03-3970-b9c9-c22a244a0c5a",
                        "entry_id": "6e0bb326-1d28-3375-b234-5cd12f7bd2b8",
                        "glosses": [
                            "Epoche der Menschheitsgeschichte, in der Metallgegenstände hauptsächlich aus Bronze hergestellt wurden"
                        ],
                        "tags": [
                            "meist im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "53ec5667-8d25-46a8-a173-65d6ce040661",
                                "sense_id": "2a216deb-bf03-3970-b9c9-c22a244a0c5a",
                                "text": "Die Bronzezeit war in Europa ungefähr von 2200 v. Chr. bis 1200 v. Chr."
                            },
                            {
                                "example_id": "3ad962d6-6c1c-4caa-aef8-d707bab185a1",
                                "sense_id": "2a216deb-bf03-3970-b9c9-c22a244a0c5a",
                                "text": "„Während es für die Bronzezeit (frühe Hallstattkultur) keine Zeugnisse keltischer Art gibt, ist mit der Eisenzeit, das heißt mit der späten Hallstattkultur (650-400 v. Chr.), keltische Geschichte durch archäologische Zeugnisse belegt.“"
                            },
                            {
                                "example_id": "4b70b9f2-5c25-4b83-8e0b-13bb7ef55c1d",
                                "sense_id": "2a216deb-bf03-3970-b9c9-c22a244a0c5a",
                                "text": "„Wie alle Völker, die keine Schrift kennen, waren auch die Menschen der Bronzezeit große Erzähler.“"
                            },
                            {
                                "example_id": "613e45a9-e121-422f-932c-b189714cf64f",
                                "sense_id": "2a216deb-bf03-3970-b9c9-c22a244a0c5a",
                                "text": "„War es in der späten Bronzezeit üblich, die Toten zu verbrennen und in Urnen beizusetzen, so änderte sich allmählich die Bestattungssitte lediglich in der Weise, daß über dem Verbrennungsplatz ein Grabhügel errichtet wurde.“"
                            },
                            {
                                "example_id": "a7ee53e3-51ff-4905-b44c-5231fc785e78",
                                "sense_id": "2a216deb-bf03-3970-b9c9-c22a244a0c5a",
                                "text": "„Sie stammten von Gefäßen, die bis in die Bronzezeit zurückdatierten, aber auch aus der Urnenfelder- sowie der frühen Hallstattzeit stammten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
