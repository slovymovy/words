                            {
                                "example_id": "f61b79de-5c5b-4e5e-957f-fd3d26a3d7a3",
                                "sense_id": "06c14841-7284-39dc-9444-cf252439a659",
                                "text": "Przy roboczym stole marionetkarza znajdzie się i naparstek."
