                                        "glosses": [
                                            "Qui dure cinq ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda92684-d86c-4ef4-927d-1f6290d4c033",
                                                "sense_id": "308a472d-9386-3063-a2a1-ff72afc2e079",
                                                "text": "Magistrat quinquennal."
                                            },
                                            {
                                                "example_id": "9b14c5e0-5363-46cf-a947-df186ed5cc3f",
                                                "sense_id": "308a472d-9386-3063-a2a1-ff72afc2e079",
                                                "text": "La préparation du Vᵉ Plan quinquennal («ardente obligation » du général de Gaulle) fut l’occasion de définir les besoins en formation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe6f85e-8368-3a41-8a38-caec66cfaba1",
                                        "entry_id": "8f03f913-1ffd-324c-b036-82a8fe8dc205",
                                        "glosses": [
                                            "Qui se fait tous les cinq ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37e40cfa-6ca0-4075-8e31-9fff7e0ae24c",
                                                "sense_id": "7fe6f85e-8368-3a41-8a38-caec66cfaba1",
                                                "text": "Jeux quinquennaux."
                                            },
                                            {
                                                "example_id": "d375a07f-1362-4079-bdf1-a75c1294658f",
                                                "sense_id": "7fe6f85e-8368-3a41-8a38-caec66cfaba1",
                                                "text": "Le renouvellement quinquennal d’une assemblée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4524d3ac-46a0-340d-92b5-0183fa173bea",
                                        "entry_id": "8f03f913-1ffd-324c-b036-82a8fe8dc205",
                                        "glosses": [
                                            "Qui se produit en moyenne tous les cinq ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b103fbf3-71e8-4057-bd66-50840e578d0f",
                                                "sense_id": "4524d3ac-46a0-340d-92b5-0183fa173bea",
                                                "text": "En moyenne, les maxima avoisinent 20 à 30 m³/s. Mais les crues biennales atteignent 28 m³/s, les crues quinquennales 37 m³/s, décennales 43 m³/s et vicennales 49 m³/s."
                                            }
                                        ]
                                    }
