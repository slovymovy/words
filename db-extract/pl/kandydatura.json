                "translations": [
                    {
                        "translation_id": "030cbed4-de61-4bd9-a3ad-d27339a70553",
                        "source_entry_id": "cd3382ee-bad6-339a-8f6c-d0a5f30e5616",
                        "source_sense_id": "646cbdbe-07a1-3516-995b-df084a66245f",
                        "target_lang_word": "candidacy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "candidacy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6862301-376c-3bf6-a83e-1b16253bba04",
                                        "entry_id": "57cfb2bb-f171-397b-b57c-59882786f989",
                                        "glosses": [
                                            "The state of being a candidate; candidateship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f41dbbd-9b55-479c-925f-8b0be59adf54",
                                                "sense_id": "a6862301-376c-3bf6-a83e-1b16253bba04",
                                                "text": "Let it be borne in mind, moreover, that since the period of his last candidacy he has rendered the most memorable services to the country"
                                            },
                                            {
                                                "example_id": "df933a36-1889-44bd-a4ec-9ed7b646243c",
                                                "sense_id": "a6862301-376c-3bf6-a83e-1b16253bba04",
                                                "text": "Anyhow, if the opportunity presented itself, Requesens thought that Philip should support the candidacies of Giovanni Ricci, Clemente Dolerá, and Ghislieri, . . ."
                                            },
                                            {
                                                "example_id": "a5980425-1e8d-4c12-b909-ad32acc321ac",
                                                "sense_id": "a6862301-376c-3bf6-a83e-1b16253bba04",
                                                "text": "However, this almost certainly happened because of the third party candidacy of former Republican President Theodore Roosevelt"
                                            },
                                            {
                                                "example_id": "1d996704-e24e-426f-b779-81563b40f0ca",
                                                "sense_id": "a6862301-376c-3bf6-a83e-1b16253bba04",
                                                "text": "Artiles, a Republican operative with a reputation for a foul mouth and sharp elbows, is accused of financing a sham candidate whose candidacy was intended to siphon votes from a legitimate Democratic candidate in a state Senate race in South Florida’s 37th District. The candidate has the same last name as then-Democratic incumbent Jose Javier Rodriguez but did not actively campaign for the seat and has since admitted being recruited as a spoiler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
