                "senses": [
                    {
                        "sense_id": "dc672583-6713-30ea-8169-5e6baff28202",
                        "entry_id": "1b69f7d6-511d-3f62-b947-132cac4fa942",
                        "glosses": [
                            "муз. отдельное музыкальное произведение (или несколько одновременно написанных небольших по объёму произведений), обозначаемое номером в ряду других произведений данного композитора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a6069dc-1f1a-4693-973f-9666e2b0d03a",
                                "sense_id": "dc672583-6713-30ea-8169-5e6baff28202",
                                "text": "Играли 115-й опус Брамса, кларнетный квинтет, немыслимо трудный для исполнения."
                            }
                        ]
                    },
                    {
                        "sense_id": "be53ce33-09be-3978-8432-d328931b7095",
                        "entry_id": "1b69f7d6-511d-3f62-b947-132cac4fa942",
                        "glosses": [
                            "шутл. всякое сочинение, произведение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9769d8-0b5b-4f8d-a179-62d6edc5c7bb",
                                "sense_id": "be53ce33-09be-3978-8432-d328931b7095",
                                "text": "Обратиться за советом к брату его побудило и ещё одно обстоятельство: Крамерс принёс научный опус, пересыщенный математикой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21edd14f-5521-4fd5-99af-dc6205783d53",
                        "source_entry_id": "1b69f7d6-511d-3f62-b947-132cac4fa942",
                        "target_lang_word": "opus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2572cf2-f29a-31cb-9ea8-41f2997996d5",
                                        "entry_id": "419eee00-d08b-3db4-9107-2705110f4aa6",
                                        "glosses": [
                                            "A work of music or set of works with a specified rank in an ordering of a composer's complete published works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16d89fd-57ec-4ad4-a685-1346544854ba",
                                                "sense_id": "e2572cf2-f29a-31cb-9ea8-41f2997996d5",
                                                "text": "Beethoven's \"Razumovsky\" Quartets, Op. 59, are considered by many to be the beginning of the Romantic era."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b238896-152e-3247-9d97-5282b68441c9",
                                        "entry_id": "419eee00-d08b-3db4-9107-2705110f4aa6",
                                        "glosses": [
                                            "A work, especially of art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27665d51-1970-4b4c-8ea9-1229bf32106f",
                                                "sense_id": "0b238896-152e-3247-9d97-5282b68441c9",
                                                "text": "The painter's last opus was a dedication to all things living, in a surprising contrast to all of his prior work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "868820b3-d952-457c-8d63-d8f321b03193",
                        "source_entry_id": "1b69f7d6-511d-3f62-b947-132cac4fa942",
                        "target_lang_word": "opus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opus",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0d6f8b95-7ef3-3a6c-93df-dbfa18d15151",
                                        "entry_id": "a39f1bec-c6f6-3cae-b0f5-1c732e67bb04",
                                        "glosses": [
                                            "umělecké, nejčastěji hudební dílo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fff25350-628c-4292-aaea-9d5ea51a150f",
                                                "sense_id": "0d6f8b95-7ef3-3a6c-93df-dbfa18d15151",
                                                "text": "Byla to horká lázeň pro takového provinilce, jehož opus Skuherský podrobil kousavé, zdrcující kritice, která končila nezřídka krutým výsměchem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990d7324-1b51-357d-8766-385934a17bc7",
                                        "entry_id": "a39f1bec-c6f6-3cae-b0f5-1c732e67bb04",
                                        "glosses": [
                                            "skladba nebo soubor skladeb mající v seznamu děl skladatele stejné pořadové číslo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c12fdbd8-b20c-4afb-a1a7-11f217f2e03c",
                                                "sense_id": "990d7324-1b51-357d-8766-385934a17bc7",
                                                "text": "Beethovenova slavná Symfonie č. 9 d moll, S Ódou na radost, opus 125"
                                            }
                                        ]
                                    }
                                ]
                            }
