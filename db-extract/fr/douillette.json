                                        "sense_id": "35cf39ca-2d82-3d27-942e-b485459bf09b",
                                        "entry_id": "580ed40f-80d0-3f5c-b17c-9bdbc1b40fb8",
                                        "glosses": [
                                            "leichter Umhang ohne Ärmel, oftmals nicht länger als bis zur Taille"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f86c51-ed73-4f14-89ad-f431122b36bb",
                                                "sense_id": "35cf39ca-2d82-3d27-942e-b485459bf09b",
                                                "text": "Magst du mir mein Cape bringen? Es wird etwas frisch."
                                            },
                                            {
                                                "example_id": "187e66af-d5cb-40c9-bc32-37ea8cae9787",
                                                "sense_id": "35cf39ca-2d82-3d27-942e-b485459bf09b",
                                                "text": "„Sie zog ihr Cape enger um die Schultern, als wäre das Licht die schlimmste Bedrohung, der gefährlichste Feind, und verließ die Bar.“"
                                            },
                                            {
                                                "example_id": "ca04339b-e554-4bde-b49b-dad0431f12c8",
                                                "sense_id": "35cf39ca-2d82-3d27-942e-b485459bf09b",
                                                "text": "„Als Thomas ihr das Cape um die Schultern legte, roch er erneut den Duft ihrer Haut, der ihn bei ihrer ersten Begegnung so betört hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
