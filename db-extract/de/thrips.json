                        "cross_references": [
                            {
                                "target_word": "thrips",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                                        "entry_id": "e3c211d3-34d4-38a0-8d72-3ba76cec19bd",
                                        "glosses": [
                                            "Any of the many small insects of the order Thysanoptera, especially those that attack useful plants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff2e9e6-0278-410d-a967-1b2585dc4f53",
                                                "sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                                                "text": "The turnrows and margins of the fields should be cultivated often enough to prevent the growth of weeds, many forms of which harbor the onion thrips."
                                            },
                                            {
                                                "example_id": "778032c5-ee30-48ed-b621-2b314cc3733e",
                                                "sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                                                "text": "2002, Thrips, article in International Wildlife Encyclopedia Volume 19, Picture caption, page 2676,\nThe thousands of thrips species include among their number the smallest of all winged insects."
                                            },
                                            {
                                                "example_id": "f1d28e8e-9b6b-46e0-9c33-7e300154294e",
                                                "sense_id": "fe5e25cd-a9dd-3c1a-b7d2-fc84225c94c5",
                                                "text": "Bleaching and stippling on viburnum foliage infested with greenhouse thrips. Because this sluggish thrips feeds openly on the underside of leaves, it is controlled by thorough coverage with insecticidal soap or oil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db877bf0-a272-4e25-9ba8-c117bf64309b",
                        "source_entry_id": "eaa439f5-76b5-3afd-8816-e4e3cfe98ba8",
                        "source_sense_id": "c694b516-5681-3679-a04f-9e46b6ac32a3",
                        "source_sense_description": "Zoologie, Entomologie; Biologie: Insekt aus der Ordnung der Fransenflügler (Thysanoptera)",
                        "target_lang_word": "thrips",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
