                "senses": [
                    {
                        "sense_id": "aec8f4e2-2367-39a1-b660-b43e3eccda7e",
                        "entry_id": "5832b6d2-b755-3a4e-835e-e774d994d1c7",
                        "glosses": [
                            "Person, die das Brettspiel Backgammon spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a77af61-6066-4c7c-b4df-b214c27e7653",
                                "sense_id": "aec8f4e2-2367-39a1-b660-b43e3eccda7e",
                                "text": "„Er galt als versierter Baccara- und Backgammonspieler und trug den Beinamen \"Lucky\".“"
                            },
                            {
                                "example_id": "af2305c8-fc3d-4b11-a150-366cbb293bb5",
                                "sense_id": "aec8f4e2-2367-39a1-b660-b43e3eccda7e",
                                "text": "„Doch da taucht Bai Dan auf, sein Großvater aus der Heimat, ein besonders guter Backgammonspieler.“"
                            },
                            {
                                "example_id": "5432bd88-510c-4e9c-8c7a-e2331df6a62a",
                                "sense_id": "aec8f4e2-2367-39a1-b660-b43e3eccda7e",
                                "text": "„Und natürlich sind Backgammonspieler zugleich tatsächlich die Hölle. Ebenso wie Fahrradfahrer. Und Tanztheater. Und Gitarrenhändler.“"
                            },
                            {
                                "example_id": "07a89baf-de49-413e-b57a-c218f0f2bc19",
                                "sense_id": "aec8f4e2-2367-39a1-b660-b43e3eccda7e",
                                "text": "„Später sind es die Tanztheater und die Backgammonspieler dieser Stadt, die der damals 23-jährige Tocotronic-Sänger Dirk von Lowtzow so hasst.“"
                            },
                            {
                                "example_id": "9390cbbf-fb53-4b40-98c3-8d25a64142e8",
                                "sense_id": "aec8f4e2-2367-39a1-b660-b43e3eccda7e",
                                "text": "„Erfolge verbuchen, Weichen stellen, Fehler ausbaden, eine gewisse Leidensfähigkeit zeigen - all das durchleben Backgammonspieler während des Spiels mit den weißen und schwarzen Steinchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
