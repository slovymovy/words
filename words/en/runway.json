{
    "word_family": [
        "run",
        "runner",
        "runaway"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5dd2a7f1-8b0c-38fd-ace8-d24483d457e3",
                    "sense_definition": "A long, hard surface at an airport where airplanes take off and land.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plane landed safely on the <w>runway</w> despite the rain.",
                            "target_lang_translations": {
                                "ru": "Самолет благополучно приземлился на <w>взлетно-посадочную полосу</w>, несмотря на дождь.",
                                "zh": "尽管下着雨，飞机还是安全地降落在了<w>跑道</w>上。"
                            }
                        },
                        {
                            "text": "We had to wait for the snow to be cleared from the <w>runway</w>.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось ждать, пока снег уберут со <w>взлетной полосы</w>.",
                                "zh": "我们不得不等待积雪从<w>跑道</w>上清理干净。"
                            }
                        }
                    ],
                    "synonyms": [
                        "airstrip"
                    ],
                    "common_phrases": [
                        "airport runway",
                        "end of the runway",
                        "taxi to the runway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная твердая поверхность в аэропорту, где самолеты взлетают и приземляются.",
                        "zh": "机场内供飞机起飞和降落的长条形硬质地面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взлётно-посадочная полоса",
                                "target_lang_sense_clarification": "авиация"
                            },
                            {
                                "target_lang_word": "взлётная полоса",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "ВПП",
                                "target_lang_sense_clarification": "аббревиатура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跑道",
                                "target_lang_sense_clarification": "航空"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7d27dd6-e82b-3f3b-bac2-4f01bbf02fac",
                    "sense_definition": "A narrow platform extending from a stage, used by models to display clothes at a fashion show.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous model smiled as she walked down the <w>runway</w>.",
                            "target_lang_translations": {
                                "ru": "Знаменитая модель улыбалась, идя по <w>подиуму</w>.",
                                "zh": "那位名模微笑着走在<w>T台</w>上。"
                            }
                        },
                        {
                            "text": "Designers presented their latest collection on the <w>runway</w> in Paris.",
                            "target_lang_translations": {
                                "ru": "Дизайнеры представили свою последнюю коллекцию на <w>подиуме</w> в Париже.",
                                "zh": "设计师们在巴黎的<w>T台</w>上展示了他们最新的系列作品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "catwalk"
                    ],
                    "common_phrases": [
                        "walk the runway",
                        "fashion runway",
                        "runway model"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая платформа, отходящая от сцены, используемая моделями для демонстрации одежды на показе мод.",
                        "zh": "时装表演中从舞台延伸出来的狭长平台，供模特展示服装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подиум",
                                "target_lang_sense_clarification": "мода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "T台",
                                "target_lang_sense_clarification": "时尚"
                            },
                            {
                                "target_lang_word": "走秀台",
                                "target_lang_sense_clarification": "时尚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4ac525f-bfe9-32d1-8753-ce3dd074dbba",
                    "sense_definition": "The amount of time a company can continue to operate with its current financial reserves before running out of money.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The startup has enough <w>runway</w> to last for another year.",
                            "target_lang_translations": {
                                "ru": "У стартапа достаточно <w>финансового запаса</w>, чтобы продержаться еще год.",
                                "zh": "这家初创公司有足够的<w>资金周转期</w>再维持一年。"
                            }
                        },
                        {
                            "text": "They need to raise more capital to extend their financial <w>runway</w>.",
                            "target_lang_translations": {
                                "ru": "Им нужно привлечь больше капитала, чтобы продлить свой финансовый <w>срок жизни</w>.",
                                "zh": "他们需要筹集更多资金来延长公司的<w>生存期</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cash runway",
                        "run out of runway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, в течение которого компания может продолжать работать на текущих финансовых резервах до того, как закончатся деньги.",
                        "zh": "指公司在资金耗尽前，依靠现有财务储备能够维持运营的时间长度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "финансовый запас",
                                "target_lang_sense_clarification": "бизнес"
                            },
                            {
                                "target_lang_word": "срок жизни",
                                "target_lang_sense_clarification": "стартапа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资金周转期",
                                "target_lang_sense_clarification": "商业"
                            },
                            {
                                "target_lang_word": "生存期",
                                "target_lang_sense_clarification": "初创企业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7974827-e6f7-35ea-8782-8c5595e17739",
                    "sense_definition": "A short track used by athletes to build up speed before a jump or throw.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete sprinted down the <w>runway</w> before launching the javelin.",
                            "target_lang_translations": {
                                "ru": "Спортсмен пробежал по <w>дорожке для разбега</w> перед тем, как метнуть копье.",
                                "zh": "运动员在投掷标枪前沿着<w>助跑道</w>冲刺。"
                            }
                        },
                        {
                            "text": "He checked his starting mark on the <w>runway</w> prior to the long jump.",
                            "target_lang_translations": {
                                "ru": "Он проверил свою стартовую отметку на <w>дорожке</w> перед прыжком в длину.",
                                "zh": "他在跳远前检查了<w>助跑道</w>上的起跳标记。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая дорожка, используемая спортсменами для набора скорости перед прыжком или броском.",
                        "zh": "运动员在跳跃或投掷前用于加速的短跑道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорожка для разбега",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "дорожка",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "助跑道",
                                "target_lang_sense_clarification": "体育"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "199b0bb8-02ab-37a9-909a-2f8191e81865",
                    "sense_definition": "A narrow path, ramp, or structure used to move materials or provide access between points.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Workers slid the heavy crates down the wooden <w>runway</w>.",
                            "target_lang_translations": {
                                "ru": "Рабочие спускали тяжелые ящики по деревянному <w>скату</w>.",
                                "zh": "工人们把沉重的板条箱顺着木制<w>斜坡</w>滑了下去。"
                            }
                        },
                        {
                            "text": "A temporary <w>runway</w> was built to allow carts to enter the warehouse.",
                            "target_lang_translations": {
                                "ru": "Был построен временный <w>настил</w>, чтобы тележки могли въезжать на склад.",
                                "zh": "为了让手推车进入仓库，人们搭建了一个临时<w>通道</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкий путь, рампа или конструкция, используемая для перемещения материалов или обеспечения доступа между точками.",
                        "zh": "用于搬运物资或在两点间提供通道的狭窄路径、斜坡或结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настил",
                                "target_lang_sense_clarification": "строительство"
                            },
                            {
                                "target_lang_word": "скат",
                                "target_lang_sense_clarification": "для спуска грузов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斜坡",
                                "target_lang_sense_clarification": "搬运"
                            },
                            {
                                "target_lang_word": "通道",
                                "target_lang_sense_clarification": "建筑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2a8634c-99bc-3eaf-b6d4-dba98b6246a5",
                    "sense_definition": "A path regularly used by animals to travel through a forest or natural area.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter waited quietly near the deer <w>runway</w>.",
                            "target_lang_translations": {
                                "ru": "Охотник тихо ждал возле оленьей <w>тропы</w>.",
                                "zh": "猎人安静地守在鹿群的<w>兽道</w>旁。"
                            }
                        },
                        {
                            "text": "We found a small <w>runway</w> made by rabbits in the tall grass.",
                            "target_lang_translations": {
                                "ru": "Мы нашли маленькую <w>тропку</w>, проделанную кроликами в высокой траве.",
                                "zh": "我们在高草丛中发现了一条兔子踩出来的<w>小径</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тропа, регулярно используемая животными для передвижения по лесу или природной территории.",
                        "zh": "动物在森林或自然区域中经常行走的路径。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тропа",
                                "target_lang_sense_clarification": "животных"
                            },
                            {
                                "target_lang_word": "лаз",
                                "target_lang_sense_clarification": "в траве или кустах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兽道",
                                "target_lang_sense_clarification": "动物"
                            },
                            {
                                "target_lang_word": "小径",
                                "target_lang_sense_clarification": "自然"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}