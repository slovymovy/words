                                "target_senses": [
                                    {
                                        "sense_id": "0747c942-aef2-3f11-b4a1-cbfdd6f0cf91",
                                        "entry_id": "a6ebe109-0aab-3b57-9166-69ac1b219f21",
                                        "glosses": [
                                            "o ato ou efeito de emigrar; movimentação de uma localidade pra outra"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1df6cbb-d6b9-48b8-ae91-f3d5ba4fff31",
                                                "sense_id": "0747c942-aef2-3f11-b4a1-cbfdd6f0cf91",
                                                "text": "Não será com um muro que se resolverá o problema da emigração (ilegal aos EUA)."
                                            }
