    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6f4a6f5-9b54-396f-87f3-c0cbbd4cc3d2",
                    "sense_definition": "Voie de circulation fermée à l'un de ses bouts et qui n'a pas d'autre issue que son entrée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "voie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous sommes trompés de chemin et nous sommes entrés dans une <w>impasse</w> sombre."
                        },
                        {
                            "text": "Cette petite <w>impasse</w> est très calme parce qu'aucune voiture n'y circule à vive allure."
                        }
                    ],
                    "synonyms": [
                        "cul-de-sac"
                    ],
                    "common_phrases": [
                        "au fond d'une impasse",
                        "s'engager dans une impasse"
                    ]
                },
                {
                    "sense_id": "6a2f5669-6a50-3f52-9f16-572615631307",
                    "sense_definition": "Situation bloquée et sans issue favorable apparente où tout progrès semble impossible.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les négociations entre les deux pays sont dans une véritable <w>impasse</w> depuis plusieurs semaines."
                        },
                        {
                            "text": "Après des heures de débat stérile, nous cherchons encore un moyen de sortir de cette <w>impasse</w>."
                        }
                    ],
                    "synonyms": [
                        "point mort"
                    ],
                    "common_phrases": [
                        "être dans une impasse",
                        "sortir de l'impasse",
                        "mener à une impasse"
                    ]
                },
                {
                    "sense_id": "df4a4422-500d-3bca-8c22-f3569d5f9fab",
                    "sense_definition": "Au jeu de cartes, particulièrement au bridge, manœuvre consistant à tenter de capturer un honneur adverse au moyen d'une carte intermédiaire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cartes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur a tenté une <w>impasse</w> à pique dans l'espoir d'obtenir une levée supplémentaire."
                        },
                        {
                            "text": "Sa décision de risquer une <w>impasse</w> lui a permis de remporter la partie de bridge."
                        }
                    ],
                    "common_phrases": [
                        "faire une impasse",
                        "réussir une impasse"
                    ]
                }
            ]
        }
    ]
