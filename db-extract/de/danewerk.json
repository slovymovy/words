                "senses": [
                    {
                        "sense_id": "db49705b-bea4-36d6-81e3-eb310ce43eec",
                        "entry_id": "e3becbef-d289-3d49-bb8f-2ea6ff581046",
                        "glosses": [
                            "dänischer Schutzwall zur Zeit der Wikinger zwischen der Treene im Westen und der Ostsee im Osten (nahe der heutigen Stadt Schleswig verlaufend)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59af7de4-ec97-49bf-b9be-9bcd7619ecea",
                                "sense_id": "db49705b-bea4-36d6-81e3-eb310ce43eec",
                                "text": "„Für das aufblühende Haithabu ist das Danewerk lebenswichtig, denn es schützt den Handelsweg zwischen beiden Meeren.“"
                            },
                            {
                                "example_id": "a2bf034b-5c56-42fb-a00e-4b6121ce8a4c",
                                "sense_id": "db49705b-bea4-36d6-81e3-eb310ce43eec",
                                "text": "„Nun gibt es 43 Welterbestätten in Deutschland: Die Wikingerstätten Haithabu und Danewerk in Schleswig-Holstein haben es auf die Liste der Unesco geschafft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
