                ],
                "senses": [
                    {
                        "sense_id": "f15cf3c4-3647-36b7-8b61-5b5ed64d2ac9",
                        "entry_id": "dd6b5d2a-4b26-36dd-bbb8-c9fdea042e6b",
                        "glosses": [
                            "истор. место пыток при следствии и допросе в Московской Руси"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b95ccf-721d-4252-936e-4e7f1c72b5f3",
                                "sense_id": "f15cf3c4-3647-36b7-8b61-5b5ed64d2ac9",
                                "text": "Эй, Борис, ступай в застенок, боярина допрашивать!"
                            }
                        ]
                    },
                    {
                        "sense_id": "2280a7f4-f7c7-3845-b7d6-410e734d0b7f",
                        "entry_id": "dd6b5d2a-4b26-36dd-bbb8-c9fdea042e6b",
                        "glosses": [
                            "тюрьма, где производятся допросы с истязаниями"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "bc21a79b-3eb0-413a-a6fd-cb74a26789da",
                                "sense_id": "2280a7f4-f7c7-3845-b7d6-410e734d0b7f",
                                "text": "Лучшие представители русского народа гибнут в большевистских застенках."
                            },
                            {
                                "example_id": "ec0f3b2c-8328-4c6c-afe8-663736ebd343",
                                "sense_id": "2280a7f4-f7c7-3845-b7d6-410e734d0b7f",
                                "text": "В оренбургских застенках начались допросы с пристрастием и великие пытки, кровь потекла."
                            },
                            {
                                "example_id": "11033b66-36f6-4399-833c-e37698f789d4",
                                "sense_id": "2280a7f4-f7c7-3845-b7d6-410e734d0b7f",
                                "text": "Акишев был взят и отправлен к царю, а потом подвергнут пытке в застенке."
                            }
                        ]
                    }
                ],
