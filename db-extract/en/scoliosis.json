                    {
                        "translation_id": "c6f33a3f-022c-4f96-858d-9c5245b87af2",
                        "source_entry_id": "290e9e7c-a3fc-3aee-a2b6-b8e710867a4c",
                        "source_sense_id": "aaac31ad-9439-3629-8af4-04546857d727",
