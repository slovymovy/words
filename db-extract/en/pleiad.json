                                        "sense_id": "a2f39a4c-77fd-379f-8076-a76dee444836",
                                        "entry_id": "7ae1a7f2-a3dd-3bb7-b3a0-4041f07a4ff1",
                                        "glosses": [
                                            "elk van de zeven dochters van Atlas en Pleione, die de godin Artemis vergezelden en van Zeus een veilige plaats aan de hemel hadden gekregen"
                                        ],
                                        "tags": [
                                            "Griekenland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c13ff9b8-ec3c-4fdc-b1cd-7556e0e1d5a2",
                                                "sense_id": "a2f39a4c-77fd-379f-8076-a76dee444836",
                                                "text": "Daar wees Aeneas de koning erop dat zij verre verwanten waren. Hij was zelf een nazaat van Dardanos, een zoon van de pleiade Electra en een kleinzoon van Atlas , terwijl Evander op zijn beurt afstamde van Mercurius , een zoon van de pleiade Maia en bijgevolg ook een kleinzoon van Atlas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
