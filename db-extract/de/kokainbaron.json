                "senses": [
                    {
                        "sense_id": "1f8c10cf-46c3-33a0-b474-419b5faf1cb1",
                        "entry_id": "7fff92bf-09be-3d85-891c-3dd69085deeb",
                        "glosses": [
                            "besonders mächtiger, einflussreicher Kokainhändler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad97b5e-38b3-4e01-bab3-612139894871",
                                "sense_id": "1f8c10cf-46c3-33a0-b474-419b5faf1cb1",
                                "text": "„Um öffentliche Unterstützung für einen Krieg oder auch nur für Rüstungsausgaben zu mobilisieren, braucht man Feinde, und kolumbianische Kokainbarone entsprachen haargenau dem Feindbild.“"
                            },
                            {
                                "example_id": "20d2398b-9dac-4420-991a-8caa2877b12d",
                                "sense_id": "1f8c10cf-46c3-33a0-b474-419b5faf1cb1",
                                "text": "„Sie töteten die Tochter des Mannes und all ihre Klassenkameraden, weil die Kokainbarone das Land für ihre eigenen Zwecke nutzen wollen.“"
                            },
                            {
                                "example_id": "84f3d336-09dc-4460-be48-d1b70702084a",
                                "sense_id": "1f8c10cf-46c3-33a0-b474-419b5faf1cb1",
                                "text": "„Die ›Liliputaner‹ sind zwar nicht mehr unumschränkt herrschende Kokainbarone, aber Schätzungen zufolge produziert Kolumbien weiterhin rund sechzig Prozent des weltweit konsumierten Kokains.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
