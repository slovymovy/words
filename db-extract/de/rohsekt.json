                "senses": [
                    {
                        "sense_id": "548f79c8-6d15-35b9-ac95-073959c1d5f7",
                        "entry_id": "7f89ac37-1890-35f9-ae01-2121c9da4e1a",
                        "glosses": [
                            "Sekt nach der Flaschengärung (zweiten Gärung), der einige Zeit bis zum Dégorgement (Hefesatzentfernung) lagert und noch nicht auslieferungsfähig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd63957-7de6-4e23-b595-a4fd547e41aa",
                                "sense_id": "548f79c8-6d15-35b9-ac95-073959c1d5f7",
                                "text": "„Auch eine Abfüllanlage, die Besucher mit ihrem Geklacker und den endlosen Reihen von Sektflaschen bei Henkell und auch bei Matheus Müller immer fasziniert, gibt es hier nicht zu sehen: Erst in Eltville wird der in Hochheim vergorene Rohsekt zu MM extra oder Jules Mumm.“"
                            },
                            {
                                "example_id": "211d31a9-12ab-4893-ba37-3abfe91c3bca",
                                "sense_id": "548f79c8-6d15-35b9-ac95-073959c1d5f7",
                                "text": "„So wurden allein in einer Kellerei bei Trier 1,7 Millionen Liter Rohsekt beschlagnahmt.“"
                            },
                            {
                                "example_id": "660bee16-7f54-44ff-982b-b3de719f61ca",
                                "sense_id": "548f79c8-6d15-35b9-ac95-073959c1d5f7",
                                "text": "„Die Flasche wird sofort wieder bis zum Nennvolumen mit Rohsekt befüllt und mit einem Sektkorken verschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
