                        ],
                        "examples": [
                            {
                                "example_id": "48956dc8-3ed1-44c9-bfef-f76769bb3791",
                                "sense_id": "47056b8a-6c3a-3976-8c2f-2ef9ae332731",
                                "text": "Он не то на серебре — на золоте едал."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ddda7bd-189d-418d-9c6b-667decb24958",
                        "source_entry_id": "b749598e-7690-31de-adc1-2daad76ea78a",
                        "source_sense_id": "47056b8a-6c3a-3976-8c2f-2ef9ae332731",
                        "target_lang_word": "eat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c89e2c8-f722-35d3-a487-786c1d4f6367",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To ingest; to be ingested.",
                                            "To consume (something solid or semi-solid, usually food) by putting it into the mouth and swallowing it."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6be8152-5412-4048-aded-502ce6a51f59",
                                                "sense_id": "1c89e2c8-f722-35d3-a487-786c1d4f6367",
                                                "text": "He's eating an apple. / Don't disturb me now; can't you see that I'm eating?"
                                            },
                                            {
                                                "example_id": "53e4a552-3483-4351-ac41-c7d10f216b4c",
                                                "sense_id": "1c89e2c8-f722-35d3-a487-786c1d4f6367",
                                                "text": "But meate commendeth vs not to God: for neither if we eate, are we the better: neither if wee eate not, are we the woꝛſe."
                                            },
                                            {
                                                "example_id": "e6eb1ca4-8e19-4470-a407-62c0b5fdfd94",
                                                "sense_id": "1c89e2c8-f722-35d3-a487-786c1d4f6367",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap orred tape, but they eat the luncheon crumbs."
                                            },
                                            {
                                                "example_id": "bf8307d6-0a9c-4a59-b8aa-c78ae5133f3b",
                                                "sense_id": "1c89e2c8-f722-35d3-a487-786c1d4f6367",
                                                "text": "But Richmond[…]appeared to lose himself in his own reflections. Some pickled crab, which he had not touched, had been removed with a damson pie; and his sister saw[…]that he had eaten no more than a spoonful of that either."
                                            },
                                            {
                                                "example_id": "cfc3a2be-500f-4a55-a554-7096926f0fa1",
                                                "sense_id": "1c89e2c8-f722-35d3-a487-786c1d4f6367",
                                                "text": "Shepard: Everyone on this station is chafing under Anoleis' extortion. You might end up a hero.\nLorik Qui'in: My employers rely on the goodwill of the Executive Board to work here.\nWrex: If these \"executives\" don't blame Anoleis for provoking this, they're fools. You should eat them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f60dac4a-481e-3171-862d-dbf8ba85520e",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To ingest; to be ingested.",
                                            "To consume a meal."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a110f7e-e687-4c55-a7bc-e3b068730419",
                                                "sense_id": "f60dac4a-481e-3171-862d-dbf8ba85520e",
                                                "text": "What time do we eat this evening?"
                                            },
                                            {
                                                "example_id": "87c6b5e2-c09a-4414-b510-2933838e5038",
                                                "sense_id": "f60dac4a-481e-3171-862d-dbf8ba85520e",
                                                "text": "I eat in the kitchen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a6862c-f307-3bc8-94ff-dc66757f3d0f",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To ingest; to be ingested.",
                                            "To be eaten."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31cdd167-f99f-4c98-b677-ff73a96d69a1",
                                                "sense_id": "63a6862c-f307-3bc8-94ff-dc66757f3d0f",
                                                "text": "It's a soup that eats like a meal."
                                            },
                                            {
                                                "example_id": "9081015b-4c6d-4614-8518-20068ce2e48e",
                                                "sense_id": "63a6862c-f307-3bc8-94ff-dc66757f3d0f",
                                                "text": "I don't know any quarter in England where you get such undeniable mutton—mutton that eats like mutton, instead of the nasty watery, stringy, turnipy stuff, neither mutton nor lamb, that other countries are inundated with."
                                            },
                                            {
                                                "example_id": "fe4d9cc7-9e85-4d69-ae35-f23821f28463",
                                                "sense_id": "63a6862c-f307-3bc8-94ff-dc66757f3d0f",
                                                "text": "[D]ish him with thlitheth of orangeth, barberrieth, grapeth, goothberrieth, and butter; and you will find that he eaths deliciouthly either with farced pain or gammon pain.",
                                                "translation": "[D]ish him [the fish] with slices of oranges, barberries, grapes, gooseberries, and butter; and you will find that he eats deliriously either with farced pain or gammon pain.",
                                                "english": "[D]ish him [the fish] with slices of oranges, barberries, grapes, gooseberries, and butter; and you will find that he eats deliriously either with farced pain or gammon pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f5300c-b58a-311b-a0d6-07ab7feeddbe",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To ingest; to be ingested.",
                                            "To have a particular quality of diet; to be well-fed or underfed (typically as \\\"eat healthy\\\" or \\\"eat good\\\")."
                                        ],
                                        "tags": [
                                            "copulative",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ff32167-94ec-3064-9f08-d9f3b5ddec37",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To use up.",
                                            "To destroy, consume, or use up."
                                        ],
                                        "tags": [
                                            "often",
                                            "transitive",
                                            "with-up"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46a06d9-ea7d-48bc-bd82-5fd005855861",
                                                "sense_id": "5ff32167-94ec-3064-9f08-d9f3b5ddec37",
                                                "text": "This project is eating up all the money."
                                            },
                                            {
                                                "example_id": "818040e3-e9b2-4024-94b8-4c0f561f8ff6",
                                                "sense_id": "5ff32167-94ec-3064-9f08-d9f3b5ddec37",
                                                "text": "His wretched estate is eaten up with mortgages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2ceec2a-9daa-363b-8511-07a38f20f099",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To use up.",
                                            "To consume (an exception, an event, etc.) so that other parts of the program do not receive it."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cfd1336-8a0e-4954-94fb-c6dfeb65cfc5",
                                                "sense_id": "d2ceec2a-9daa-363b-8511-07a38f20f099",
                                                "text": "A bigger problem, however, is that if you catch/eat an exception and do nothing with it, you are very likely introducing subtle bugs in your application that will be next to impossible to track down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a8029bc-68f5-3a2a-ae5d-846133de304b",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To use up.",
                                            "To damage, destroy, or fail to eject a removable part or an inserted object."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94a7584d-f4ba-4fc0-8ed4-9d5ad77699ce",
                                                "sense_id": "0a8029bc-68f5-3a2a-ae5d-846133de304b",
                                                "text": "No! There's a problem with the cassette player. Don't press fast forward or it eats the tape!"
                                            },
                                            {
                                                "example_id": "f8a5c613-f1ee-472d-836a-cd9add6930f1",
                                                "sense_id": "0a8029bc-68f5-3a2a-ae5d-846133de304b",
                                                "text": "The VHS recorder just ate the tape and won't spit it out."
                                            },
                                            {
                                                "example_id": "24ba7fc5-25e4-4b12-a71e-36178d1609bd",
                                                "sense_id": "0a8029bc-68f5-3a2a-ae5d-846133de304b",
                                                "text": "John is late for the meeting because the photocopier ate his report."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c4a7ce3-177e-37fd-b053-8e6710e2efdf",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To use up.",
                                            "To consume money (or other instruments of value, such as a token) deposited or inserted by a user, while failing to either provide the intended product or service or return the payment."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2952bbef-0183-4847-a072-66e6ebe4df25",
                                                "sense_id": "9c4a7ce3-177e-37fd-b053-8e6710e2efdf",
                                                "text": "The video game in the corner just ate my quarter."
                                            },
                                            {
                                                "example_id": "020f3b96-6480-461e-9877-33ef59e9f476",
                                                "sense_id": "9c4a7ce3-177e-37fd-b053-8e6710e2efdf",
                                                "text": "Hey! This stupid [soda vending] machine ate my quarter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0088e1c8-d669-3c81-af6c-86c64f9f42b4",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To cause (someone) to worry."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67493bbf-2cfb-4c31-8868-526b343c18be",
                                                "sense_id": "0088e1c8-d669-3c81-af6c-86c64f9f42b4",
                                                "text": "What's eating you?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ead69b3-5dbb-32c0-9046-406fb8bfdb78",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To take the loss in a transaction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f7ed657-0ce3-4a9e-83d3-cbd55f7a53ce",
                                                "sense_id": "0ead69b3-5dbb-32c0-9046-406fb8bfdb78",
                                                "text": "I have to have him in court tomorrow, if he doesn't show up, I forfeit the bond and I have to eat the $300,000."
                                            },
                                            {
                                                "example_id": "738e6319-4ec0-4747-9f2d-0075932df3b6",
                                                "sense_id": "0ead69b3-5dbb-32c0-9046-406fb8bfdb78",
                                                "text": "The server made an error when taking the order. The bartender prepared two scorpion bowls. When the error was realized the bartender was faced with having to \"eat\" the extra scorpion bowl […]"
                                            },
                                            {
                                                "example_id": "c0284d1e-195b-400f-8756-b83e20a3dfcc",
                                                "sense_id": "0ead69b3-5dbb-32c0-9046-406fb8bfdb78",
                                                "text": "When they were doing it with the valuation professionals, they were billing the client, but the valuation professional in a lot of those early cases had to eat the cost of showing the auditor how the auditors' test model was incorrect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ada3883-8788-3f8b-8e0c-96766856a141",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To be injured or killed by (something such as a firearm or its projectile), especially in the mouth."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba50396e-2e31-40e3-b038-5fb8d31fdb84",
                                                "sense_id": "5ada3883-8788-3f8b-8e0c-96766856a141",
                                                "text": "I risk my whole future, the hatred of the cops and Eddie Mars' gang. I dodge bullets and eat saps."
                                            },
                                            {
                                                "example_id": "d6709c27-514c-49ee-a74d-47c7e5d88da6",
                                                "sense_id": "5ada3883-8788-3f8b-8e0c-96766856a141",
                                                "text": "And, of course, there was Brian Rusk, who had eaten a bullet at the ripe old age of eleven."
                                            },
                                            {
                                                "example_id": "11f5f7f1-3999-4bdb-980e-f4098b651d49",
                                                "sense_id": "5ada3883-8788-3f8b-8e0c-96766856a141",
                                                "text": "Friends are only necessary in the ghastly country, where you have to have them, along with rubber boots and a barometer and secateurs, to put off bucolic idiocy, a wet brain, or eating the 12-bore."
                                            },
                                            {
                                                "example_id": "5110a8bc-d92c-4a7d-ae88-2fc29c66c16e",
                                                "sense_id": "5ada3883-8788-3f8b-8e0c-96766856a141",
                                                "text": "Mike had been to other calls where someone had eaten a gun. He knew to expect teeth embedded in the ceiling and brains dripping off it."
                                            },
                                            {
                                                "example_id": "ac3b2d7f-9eda-428a-9c2e-28a1ab45abed",
                                                "sense_id": "5ada3883-8788-3f8b-8e0c-96766856a141",
                                                "text": "The animal was sweating and scared and MacAdams was surprised when they finished up without either of them eating a kick."
                                            },
                                            {
                                                "example_id": "fc12d21a-ce70-4de6-9265-4b524f733b4a",
                                                "sense_id": "5ada3883-8788-3f8b-8e0c-96766856a141",
                                                "text": "There was a resounding smacking noise and Georgy was sure Philip had just eaten a fist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ee3e8d-6e87-3c0b-90b2-87f571e1b515",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To corrode or erode."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1d1ac89-0e1c-47b5-95fb-bec46fa8ec62",
                                                "sense_id": "b0ee3e8d-6e87-3c0b-90b2-87f571e1b515",
                                                "text": "The acid rain ate away the statue.  The strong acid eats through the metal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af446bc7-499b-348d-9eb8-526dda3847b8",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To perform oral sex (on a person or body part)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f73e3d3-be51-452a-b26e-0de6c2d565a2",
                                                "sense_id": "af446bc7-499b-348d-9eb8-526dda3847b8",
                                                "text": "Eat me!"
                                            },
                                            {
                                                "example_id": "84d4fac3-c079-49b6-875d-484ee050c79d",
                                                "sense_id": "af446bc7-499b-348d-9eb8-526dda3847b8",
                                                "text": "I ate his ass."
                                            },
                                            {
                                                "example_id": "f2adad40-17af-4fb1-8c1c-9f0a52051930",
                                                "sense_id": "af446bc7-499b-348d-9eb8-526dda3847b8",
                                                "text": "Yeah, eat that dick / eat that pussy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26a06664-a224-3fc8-b3dd-3163b2ddc75f",
                                        "entry_id": "e3f6f014-42e6-36fe-8321-997f318ed0b3",
                                        "glosses": [
                                            "To be very good; to rule, to slay."
                                        ],
                                        "tags": [
                                            "slang",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ee07c6b-2801-47e1-9410-713c3a2da263",
                                                "sense_id": "26a06664-a224-3fc8-b3dd-3163b2ddc75f",
                                                "text": "You ate that performance!"
                                            },
                                            {
                                                "example_id": "172be7a4-df89-429a-969d-11c27013c067",
                                                "sense_id": "26a06664-a224-3fc8-b3dd-3163b2ddc75f",
                                                "text": "This song eats!"
                                            },
                                            {
                                                "example_id": "17795670-0224-4210-9b84-4bb2f7c64de5",
                                                "sense_id": "26a06664-a224-3fc8-b3dd-3163b2ddc75f",
