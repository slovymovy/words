                        "cross_references": [
                            {
                                "target_word": "gaff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b17f96d5-4ab8-358b-8624-41ff10b3d872",
                                        "entry_id": "cd672dc2-d8a1-3859-978c-0d4ea6c06a4e",
                                        "glosses": [
                                            "A tool consisting of a large metal hook with a handle or pole, especially the one used to pull large fish aboard a boat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68cd0843-0cd7-4795-ad91-545b54a6b43e",
                                                "sense_id": "b17f96d5-4ab8-358b-8624-41ff10b3d872",
                                                "text": "When Leonard finally hauls up a cod of seventy-five centimeters, probably seven years old, a typical catch ten years ago, they all joke, \"Oh my God, get the gaff!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae6a6adb-8d05-3289-885f-74ae2b116433",
                                        "entry_id": "cd672dc2-d8a1-3859-978c-0d4ea6c06a4e",
                                        "glosses": [
                                            "A minor error or faux pas, a gaffe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "166c8805-de2c-4e89-9887-c879ce3b5e6d",
                                                "sense_id": "ae6a6adb-8d05-3289-885f-74ae2b116433",
                                                "text": "We politely ignored his gaff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8a6568d-61a4-3888-9396-a007c3152a38",
                                        "entry_id": "cd672dc2-d8a1-3859-978c-0d4ea6c06a4e",
                                        "glosses": [
                                            "A trick or con."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a277c807-dc12-43dc-80bc-43b9fbabe476",
                                                "sense_id": "d8a6568d-61a4-3888-9396-a007c3152a38",
                                                "text": "The sideshow feat was just a gaff, but the audience was too proud to admit they'd been fooled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9dddae8-b389-3e24-8b36-3b48580b840b",
                                        "entry_id": "cd672dc2-d8a1-3859-978c-0d4ea6c06a4e",
                                        "glosses": [
                                            "The upper spar used to control a gaff-rigged sail."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14acba2d-47f9-34a4-a53a-1be8318277b0",
                                        "entry_id": "cd672dc2-d8a1-3859-978c-0d4ea6c06a4e",
                                        "glosses": [
                                            "A type of tight, panty-like underwear worn to hold the penis and testicles tucked backwards and make one's genital region look smooth, as if one had a vulva."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "718cc547-a5c4-46ac-8ca3-d4a3a5b9ae4d",
                                                "sense_id": "14acba2d-47f9-34a4-a53a-1be8318277b0",
                                                "text": "This may sound strange to readers who know little about nudes but many female impersonators, or femme-mimics, work au naturel—except for a gaff, a bra, body makeup, jewelry, and a wig (on their head). See! Semi-nude!!"
                                            },
                                            {
                                                "example_id": "c4bd7e4e-a48d-46a2-889a-e65a89a77a74",
                                                "sense_id": "14acba2d-47f9-34a4-a53a-1be8318277b0",
                                                "text": "Sissy maids may be required to wear a gaff to disguise the male genitals, and a dominant may wish a slave to wear it on a daily basis."
                                            },
                                            {
                                                "example_id": "546c3085-29dc-4f3b-86f9-a9106b805a65",
                                                "sense_id": "14acba2d-47f9-34a4-a53a-1be8318277b0",
                                                "text": "Vicky is a pre-operative MTF transsexual […] Wearing feminine underwear over her gaff in bed helps her to redefine her absence of female genitalia during sex (sexuality) in terms of it being her 'time of the month', as she jokes to Sean [her first boyfriend]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8416c6a4-5e08-3ed0-a12c-bdb388352b38",
                                        "entry_id": "27c8da06-ac57-345a-b885-ad76659f3398",
                                        "glosses": [
                                            "To use a gaff, especially to land a fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a7dff51-267b-460d-b7ec-d4a0beff9bf1",
                                                "sense_id": "8416c6a4-5e08-3ed0-a12c-bdb388352b38",
                                                "text": "I stepped out and advanced valiantly upon a long-maned bull in the midst of his wives. I was armed with the regular club with which the boat-pullers killed the wounded seals gaffed aboard by the hunters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e70988f9-0700-3d4a-b028-1d9e46192617",
                                        "entry_id": "27c8da06-ac57-345a-b885-ad76659f3398",
                                        "glosses": [
                                            "To cheat or hoax."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50ed7fbf-6218-3abd-b1a2-9981d36a72fe",
                                        "entry_id": "27c8da06-ac57-345a-b885-ad76659f3398",
                                        "glosses": [
                                            "To doctor or modify for deceptive purposes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba5f826e-9bbd-406f-802c-8356aafeaf92",
                                                "sense_id": "50ed7fbf-6218-3abd-b1a2-9981d36a72fe",
                                                "text": "When the operator began losing, he gaffed the wheel and then the patron had no chance to win. With his secret device an experienced grifter could stop the wheel at will on any number."
                                            },
                                            {
                                                "example_id": "513166b0-7a3a-481d-8527-f64e96b59095",
                                                "sense_id": "50ed7fbf-6218-3abd-b1a2-9981d36a72fe",
                                                "text": "However, this apathy will quickly disappear if it is learned the friendly game involves marked (gaffed) cards."
                                            },
                                            {
                                                "example_id": "eb95cb9b-af9c-4b28-a309-c45787dfc722",
                                                "sense_id": "50ed7fbf-6218-3abd-b1a2-9981d36a72fe",
                                                "text": "You will be using gaffed cards: a double faced card."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "152d4414-3e97-3543-94de-974e326b7dc8",
                                        "entry_id": "27c8da06-ac57-345a-b885-ad76659f3398",
                                        "glosses": [
                                            "To gamble, especially by tossing coins."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a50c8c80-5f68-37a6-94ef-34e0ab493bb2",
                                        "entry_id": "27c8da06-ac57-345a-b885-ad76659f3398",
                                        "glosses": [
                                            "To affix gaffer tape to, or cover with gaffer tape."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe0801df-8521-4d2c-8d08-d0ad5e73e419",
                                                "sense_id": "a50c8c80-5f68-37a6-94ef-34e0ab493bb2",
                                                "text": "I gaffed down the sleeves to my lens hoods instead of just relying on the drawstring to hold it in place."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gaff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec83205-8e63-31aa-b2f2-5f7c6fb883c6",
                                        "entry_id": "19d33aab-5b10-3421-83d1-daaac5dfae5f",
                                        "glosses": [
                                            "Rough or harsh treatment; criticism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "171c0265-9ee3-4b3f-923a-3d958feaf5c7",
                                                "sense_id": "5ec83205-8e63-31aa-b2f2-5f7c6fb883c6",
                                                "text": "\"Numbers one, two, and five engines have broken down, sir,\" he called. \"Shall we force the remaining three?\" / \"We can do nothing else,\" I bellowed into the transmitter. / \"They won't stand the gaff, sir,\" he returned. / \"Can you suggest a better plan?\" I asked. / \"No, sir,\" he replied. / \"Then give them the gaff, lieutenant,\" I shouted back, and hung up the receiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d06e5e69-dd1d-39cb-aff4-6973e58502e2",
                                        "entry_id": "19d33aab-5b10-3421-83d1-daaac5dfae5f",
                                        "glosses": [
                                            "An outcry; nonsense."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gaff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34b902b9-a984-3371-adc4-3ea3e45bfe1a",
                                        "entry_id": "7dc3d469-cac6-343e-8c1e-50455e7b9a9c",
                                        "glosses": [
                                            "A place of residence."
                                        ],
                                        "tags": [
                                            "British",
                                            "Ireland",
                                            "Multicultural-London-English",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c40009-51c6-46bf-83b3-342b20d0c66b",
                                                "sense_id": "34b902b9-a984-3371-adc4-3ea3e45bfe1a",
                                                "text": "We're going round to Mike's gaff later to watch the footie."
                                            },
                                            {
                                                "example_id": "e14ea80c-b249-4a79-91ce-1bf2d3bf18b0",
                                                "sense_id": "34b902b9-a984-3371-adc4-3ea3e45bfe1a",
                                                "text": "\"Steady on, mate. How was I to know this was your gaff? I was lookin' for somewhere to kip.\""
                                            },
                                            {
                                                "example_id": "cc42b126-2dec-4a9d-96a6-48df6aecfcd3",
                                                "sense_id": "34b902b9-a984-3371-adc4-3ea3e45bfe1a",
                                                "text": "And like I said, I was so fuck-faced that I forgot I'd moved and let myself back into my old gaff."
                                            },
                                            {
                                                "example_id": "a2641774-5885-4af0-8a9a-661eb4d4e71b",
                                                "sense_id": "34b902b9-a984-3371-adc4-3ea3e45bfe1a",
                                                "text": "Am I alone in feeling smug (if slatternly) about the news that super-clean homes are a breeding ground for infection? Apparently, all that bleach is bad not just for germs but for children's immune systems, too, and paradoxically causes more disease than it prevents. Not round my gaff. Oh no. My standards of housekeeping are so abysmally low that my eldest daughter was three years old before she even developed a temperature."
                                            },
                                            {
                                                "example_id": "4e5c98b9-eecc-4377-96a0-8a1858a078bf",
                                                "sense_id": "34b902b9-a984-3371-adc4-3ea3e45bfe1a",
                                                "text": "Man will enter the gaf with crown\nGun shot spin his head right round"
                                            },
                                            {
                                                "example_id": "fd578ce7-817f-4a0c-b9f2-73d1092c4bb1",
                                                "sense_id": "34b902b9-a984-3371-adc4-3ea3e45bfe1a",
                                                "text": "The term ‘free gaf’ is music to any teenage ears in Dublin, while the term ‘wreak the gaf’ should fill any parent with dread. The term ‘gaf’ means ‘house,’ so when parents are away […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "057cd79c-6ae8-3c43-8df4-06fefae0607b",
                                        "entry_id": "7dc3d469-cac6-343e-8c1e-50455e7b9a9c",
                                        "glosses": [
                                            "A disreputable, low-end theatre."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62972f94-4136-42b2-8c4f-9f690208ab25",
                                                "sense_id": "057cd79c-6ae8-3c43-8df4-06fefae0607b",
                                                "text": "Significantly, the setting is a gaff, a low, illegal theatre, and not one of the legitimate East-End stages."
                                            }
                                        ]
                                    }
                                ]
                            },
