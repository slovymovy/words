                "translations": [
                    {
                        "translation_id": "f161d7ef-d10f-4e0f-9092-8c1219e8c8e0",
                        "source_entry_id": "3f6d1e77-1138-315a-a98a-c2ff21805858",
                        "source_sense_id": "e98dde78-720b-370c-ac38-f4f4ed3dbd84",
                        "target_lang_word": "crawl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crawl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9e692fe-abca-322c-9513-e82996eb3eca",
                                        "entry_id": "44fd9a6f-5c10-3c11-a3e9-2cb9342ba388",
                                        "glosses": [
                                            "To creep; to move slowly on hands and knees, or by dragging the body along the ground."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0991315-6541-4868-b393-76944d474a00",
                                                "sense_id": "d9e692fe-abca-322c-9513-e82996eb3eca",
                                                "text": "Clutching my wounded side, I crawled back to the trench."
                                            },
                                            {
                                                "example_id": "43b36c21-ef5b-49f7-9aa3-27f4d17001ed",
                                                "sense_id": "d9e692fe-abca-322c-9513-e82996eb3eca",
                                                "text": "A VVorm finds vvhat it ſearches after, only by Feeling, as it cravvls from one thing to another. VVhereas a Man, having Eyes, ſees it in a Moment, all before him."
                                            },
                                            {
                                                "example_id": "d10726cd-3418-4bb9-8ab9-f3b0319c5e94",
                                                "sense_id": "d9e692fe-abca-322c-9513-e82996eb3eca",
                                                "text": "'Children crawled over each other like little grey worms in the gutters,' he said. 'The only red things about them were their buttocks and they were raw. Their faces looked as if snails had slimed on them and their mothers were like great sick beasts whose byres had never been cleared.[…]'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14a1d99e-dcaf-3880-a0f6-05663e9f60de",
                                        "entry_id": "44fd9a6f-5c10-3c11-a3e9-2cb9342ba388",
                                        "glosses": [
                                            "To move forward slowly, with frequent stops."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "407a696f-5a8e-4854-bbc4-7d1a8399b9e6",
                                                "sense_id": "14a1d99e-dcaf-3880-a0f6-05663e9f60de",
                                                "text": "The rush-hour traffic crawled around the bypass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a43b8416-1f95-3c91-93c0-96d5c318dec9",
                                        "entry_id": "44fd9a6f-5c10-3c11-a3e9-2cb9342ba388",
                                        "glosses": [
                                            "To act in a servile manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f23349ef-6181-49ef-8be9-beb5aefeaae3",
                                                "sense_id": "a43b8416-1f95-3c91-93c0-96d5c318dec9",
                                                "text": "Don’t come crawling to me with your useless apologies!"
                                            },
                                            {
                                                "example_id": "6b8f45fa-e3b5-4999-9e72-0db4e15ff058",
                                                "sense_id": "a43b8416-1f95-3c91-93c0-96d5c318dec9",
                                                "text": "Our hard-ruled king. Again, there is sprung up. An heretic, an arch one, Cranmer; one. Hath crawled into the favour of the king"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65e3de8a-afa7-3f8c-9387-ac098ecc1948",
                                        "entry_id": "44fd9a6f-5c10-3c11-a3e9-2cb9342ba388",
                                        "glosses": [
                                            "Followed by with: see crawl with."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "069fe3f7-524b-327e-b2c6-478633cdaa9c",
                                        "entry_id": "44fd9a6f-5c10-3c11-a3e9-2cb9342ba388",
                                        "glosses": [
                                            "To feel a swarming sensation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1acf1f97-4c18-4857-b0ac-6b925479afba",
                                                "sense_id": "069fe3f7-524b-327e-b2c6-478633cdaa9c",
                                                "text": "The horrible sight made my skin crawl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca5e753-5740-34bd-b1a9-4d4295be807b",
                                        "entry_id": "44fd9a6f-5c10-3c11-a3e9-2cb9342ba388",
                                        "glosses": [
                                            "To swim using the crawl stroke."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5df8c5db-1b6f-4133-8018-7cec6fe45f63",
                                                "sense_id": "9ca5e753-5740-34bd-b1a9-4d4295be807b",
                                                "text": "I think I’ll crawl the next hundred metres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26719cde-1f8d-3d6a-86e6-2362f457dab3",
                                        "entry_id": "44fd9a6f-5c10-3c11-a3e9-2cb9342ba388",
                                        "glosses": [
                                            "To move over (an area) on hands and knees."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6154d8fe-46af-4997-ad70-8bf00ddc2004",
                                                "sense_id": "26719cde-1f8d-3d6a-86e6-2362f457dab3",
                                                "text": "The baby crawled the entire second floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ae16a13-8aa8-3be3-ba34-e4e81eb73cfc",
                                        "entry_id": "44fd9a6f-5c10-3c11-a3e9-2cb9342ba388",
                                        "glosses": [
                                            "To move over (an area) slowly, with frequent stops."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73cd6ee3-8a70-4013-9c98-464b8dee63e5",
                                                "sense_id": "9ae16a13-8aa8-3be3-ba34-e4e81eb73cfc",
                                                "text": "They crawled the downtown bars."
                                            },
                                            {
                                                "example_id": "04954df0-092f-4220-abc2-4adfcd12b958",
                                                "sense_id": "9ae16a13-8aa8-3be3-ba34-e4e81eb73cfc",
                                                "text": "\"I used to crawl the Dungeon like you do, Bell, saving up money... But one day, I screwed verything up. Got thoroughly wrecked by a monster, and it ate my right arm.\""
                                            },
                                            {
                                                "example_id": "cb1633d1-54e9-45a5-84f1-353d70c76cb4",
                                                "sense_id": "9ae16a13-8aa8-3be3-ba34-e4e81eb73cfc",
                                                "text": "Eric had crawled the downtown bar scene with these guys many nights, after gigs and back when they were all in college together. Eric liked hanging with them, because they were as comfortable hanging anywhere—sports bars; gay clubs; […]"
                                            },
                                            {
                                                "example_id": "aec5741c-6c02-4bf1-97a8-1b739ecce537",
                                                "sense_id": "9ae16a13-8aa8-3be3-ba34-e4e81eb73cfc",
                                                "text": "One of the later Crawl trailers, the Nintendo Switch version, advertises its key gameplay in a sentence, “Crawl the dungeon while your friends possess the traps, beasts, and bosses against you” before later adopting the phrase […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37aa8b8c-8f6e-3714-bf29-94d32ef3a155",
                                        "entry_id": "44fd9a6f-5c10-3c11-a3e9-2cb9342ba388",
                                        "glosses": [
                                            "To visit files or web sites in order to index them for searching."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b14fafc-9d7c-434e-a7a1-4558bda3e0af",
                                                "sense_id": "37aa8b8c-8f6e-3714-bf29-94d32ef3a155",
                                                "text": "Yahoo Search has updated its Slurp Crawler to crawl websites faster and more efficiently."
                                            }
                                        ]
                                    }
                                ]
                            },
