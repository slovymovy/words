                "translations": [
                    {
                        "translation_id": "746f84e7-5ce0-4d94-bcd3-26dc3083dd73",
                        "source_entry_id": "38086a7d-1e67-3a70-9279-cfee78a98237",
                        "source_sense_description": "act of discolouring or state of being discolored",
                        "target_lang_word": "décoloration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décoloration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7260f5d-4d8f-32e9-902f-497efc0b2fbf",
                                        "entry_id": "f5f797df-415f-3d3f-927f-ea5547ea3cc6",
                                        "glosses": [
                                            "Action de décolorer, de se décolorer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a830bd96-125f-401f-afac-9786a299ee6a",
                                                "sense_id": "c7260f5d-4d8f-32e9-902f-497efc0b2fbf",
                                                "text": "La décoloration de la peau, des cheveux."
                                            },
                                            {
                                                "example_id": "48e6172d-286b-4bba-a8af-c0ac86508686",
                                                "sense_id": "c7260f5d-4d8f-32e9-902f-497efc0b2fbf",
                                                "text": "Elles se caractérisent par la survenue d’un scotome central avec baisse de l’acuité visuelle, alors que le fond d’œil est normal et ne présente que tardivement une décoloration du segment temporal de la papille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4f60118-5635-4069-86f0-677d59ebde4e",
                        "source_entry_id": "38086a7d-1e67-3a70-9279-cfee78a98237",
                        "source_sense_description": "act of discolouring or state of being discolored",
                        "target_lang_word": "Verfärbung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfärbung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4cab5e7-1653-3f38-8ed3-32b65f6b8b76",
                                        "entry_id": "f451bd2b-80c0-3222-893c-79b387660db5",
                                        "glosses": [
                                            "Verlust der ursprünglichen Farbe, Farbwechsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9006bd52-ec19-4b3d-8d3f-e18629406804",
                                                "sense_id": "c4cab5e7-1653-3f38-8ed3-32b65f6b8b76",
                                                "text": "Dagegen haftet man als Mieter nicht für kleine Kratzer in der Badewanne, normale Verfärbungen der Wände oder Schäden an den Tapeten, die durch das Aufhängen von Bildern oder das Montieren eines handelsüblichen Wandregals entstanden sind."
                                            },
                                            {
                                                "example_id": "106e5d64-75c8-4796-91a2-9a8131803e6d",
                                                "sense_id": "c4cab5e7-1653-3f38-8ed3-32b65f6b8b76",
                                                "text": "Die Schäden durch Mikroorganismen sind sowohl struktureller als auch ästhetischer Natur: etwa Verfärbungen oder Ausbleichen."
                                            },
                                            {
                                                "example_id": "e16df166-e438-460a-9ee0-1d1266aacb59",
                                                "sense_id": "c4cab5e7-1653-3f38-8ed3-32b65f6b8b76",
                                                "text": "Ueber den riesigen Baumgängen, die hier und da bereits die Verfärbung des Herbstes zeigten, glänzte ein tiefblauer Himmel."
                                            },
                                            {
                                                "example_id": "f36a80ed-5073-495a-a76c-8240004bd7d9",
                                                "sense_id": "c4cab5e7-1653-3f38-8ed3-32b65f6b8b76",
                                                "text": "Die Regeln, was man womit nicht schneiden darf, sind meines Wissens alle obsolet. Sie haben nichts mit Manieren zu tun, sondern mit dem Schonen des Silberbestecks vor Verfärbungen durch Chemikalien in bestimmten Lebensmitteln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "743c679a-7007-3b2d-b015-032b1eee849a",
                                        "entry_id": "f451bd2b-80c0-3222-893c-79b387660db5",
                                        "glosses": [
                                            "verfärbte Stelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5773e140-aac4-4a9c-978b-402290c1a756",
                                                "sense_id": "743c679a-7007-3b2d-b015-032b1eee849a",
                                                "text": "Danach sind Menschen mit linsenförmigen Verfärbungen auf der Iris besonders gefühlsbetont und empfindlich, während ringähnliche Strukturen eher auf Impulsivität hinweisen (Biological Psychology, Online)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
