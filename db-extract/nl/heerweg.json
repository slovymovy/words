                        "entry_id": "2aa3a8ac-1336-3f3b-8d2e-12f89ffce8b5",
                        "glosses": [
                            "een verharde langeafstandsweg aangelegd in de Romeinse tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08f38d68-6d41-4be6-ac1e-ab3fa3e545b6",
                                "sense_id": "46417bbd-bf99-32d6-98ee-b77bf8c7fc35",
                                "text": "Deze heerweg werd later opgehoogd tot een dijk. Door de inpoldering verdween het slikgebied en alle kleine kreekjes en riviertjes. Het gewonnen, vruchtbare land was goed voor de teelt van suikerbieten, aardappelen, graan en andere akkerbouwproducten."
                            },
                            {
                                "example_id": "015f344d-211d-4fa3-abac-a04a940a8ca3",
                                "sense_id": "46417bbd-bf99-32d6-98ee-b77bf8c7fc35",
                                "text": "De mijlpaal, oorspronkelijk twee meter hoog, stond langs de Via Belgica, de moderne naam voor de Romeinse heerweg die van Boulogne-sur-Mer naar Keulen liep."
                            }
                        ]
                    }
