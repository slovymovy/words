                "senses": [
                    {
                        "sense_id": "1f8d5d5c-56fe-3877-9501-52ef6640ccc2",
                        "entry_id": "8c68294d-a72a-3683-89b4-19032b7225bd",
                        "glosses": [
                            "Vorrichtung zur elektrischen Auslösung eines Stromkreislaufs durch Loslassen des Schalters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20edcd3a-30ea-493c-99b6-b866366eead3",
                                "sense_id": "1f8d5d5c-56fe-3877-9501-52ef6640ccc2",
                                "text": "Ein Totmannschalter wird ausgelöst, sobald der Schalter losgelassen wird."
                            },
                            {
                                "example_id": "116956d3-3224-4e85-a2ff-0d6e07555a2c",
                                "sense_id": "1f8d5d5c-56fe-3877-9501-52ef6640ccc2",
                                "text": "„Der ‚Buzzer‘ könnte laut der These eine Art Totmannschalter des russischen Militärs sein.“"
                            },
                            {
                                "example_id": "f8626205-4646-466e-b1f9-6f2a998c79d5",
                                "sense_id": "1f8d5d5c-56fe-3877-9501-52ef6640ccc2",
                                "text": "„Verlässt die Bahn den Tunnel erhält der Fahrer ein akustisches Signal, das ihn dazu auffordert, den Totmannschalter zu betätigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
