                ],
                "senses": [
                    {
                        "sense_id": "abb45b6a-af49-364c-b9ba-4e8a6e554ad1",
                        "entry_id": "c919dd02-6841-3500-9405-9fbfb0136c8a",
                        "glosses": [
                            "ein Beinhaus, das um eine Totenkapelle erweitert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "301db921-23ae-43d5-8c99-661b36140a46",
                                "sense_id": "abb45b6a-af49-364c-b9ba-4e8a6e554ad1",
                                "text": "„Mitunter ist ein Beinhaus doppelgeschossig ausgeführt und um eine Totenkapelle erweitert und wird dann Karner genannt.“"
                            },
                            {
                                "example_id": "3cf21307-7dfd-486d-8649-0e0be97c9bb3",
                                "sense_id": "abb45b6a-af49-364c-b9ba-4e8a6e554ad1",
                                "text": "„Es gibt Karner 1. als Anbauten von Kirchen, 2. als verschlossene Räume oder Nischen am Kircheneingang, in einer Vorhalle oder unter dem Chor, 3. freistehende Karner auf quadratischem, rundem oder polygonalem Grundriß.“"
                            },
                            {
                                "example_id": "815592ff-77e0-4801-81c5-68a960146a68",
                                "sense_id": "abb45b6a-af49-364c-b9ba-4e8a6e554ad1",
                                "text": "„Das untere Geschoß eines Karners dient zur Aufbewahrung der Gebeine, das obere als Andachtsraum mit einem Altar für die Totenmesse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1625bbb5-e0fd-33ef-aeaa-693994c4d5d3",
                        "entry_id": "c919dd02-6841-3500-9405-9fbfb0136c8a",
                        "glosses": [
                            "Kammer zum Räuchern oder zur Aufbewahrung von Fleisch"
                        ],
                        "tags": [
