                                        "entry_id": "4888e477-d6c5-376a-ac46-3cc5099dad82",
                                        "glosses": [
                                            "Technique de composition musicale sur les douze sons de la gamme chromatique, c’est-à-dire les douze notes contenues à l’intérieur d’une octave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "424e87cd-fe54-4107-9398-97630a92c1b1",
                                                "sense_id": "169c100e-ac20-3dbc-b009-aceb453ed7e0",
                                                "text": "Le dodécaphonisme a été mis au point par les compositeurs Arnold Schoenberg et Josef Matthias Hauer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "125b07ec-d4d8-3fd9-833c-a037cd913a3e",
                                        "entry_id": "4888e477-d6c5-376a-ac46-3cc5099dad82",
                                        "glosses": [
                                            "Style musical qui est issu de cette technique de composition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b370b1d0-d3e3-4148-af1b-a769ea9735f9",
                                                "sense_id": "125b07ec-d4d8-3fd9-833c-a037cd913a3e",
                                                "text": "Pour eux, le dodécaphonisme n’est autre que le dernier développement du monde musical qui appartient entièrement au passé et qu’ils refusent."
                                            }
                                        ]
                                    }
                                ]
                            }
