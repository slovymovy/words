                "senses": [
                    {
                        "sense_id": "eb9836cd-42ce-3196-86c0-49045c93708c",
                        "entry_id": "3e8050fd-b687-3312-b56f-86a7db0b4908",
                        "glosses": [
                            "mangelnder Respekt, fehlende Achtung gegenüber der Würde/Erhabenheit von jemandem oder etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da9a3200-0a5e-460c-8636-c0b2c99087dd",
                                "sense_id": "eb9836cd-42ce-3196-86c0-49045c93708c",
                                "text": "„Die Priester werden wegen ihrer Ehrfurchtslosigkeit gegen Gott und der Mißachtung des Opfers gerügt.“"
                            },
                            {
                                "example_id": "1f616df0-074c-4348-81c2-17aa98323601",
                                "sense_id": "eb9836cd-42ce-3196-86c0-49045c93708c",
                                "text": "„Anstatt unsere Schuld abzutragen, verdoppeln wir sie auf diese Weise, da wir dem, den wir um Vergebung bitten müssen, ein Herz voller Ehrfurchtslosigkeit und Hass darbieten.“"
                            },
                            {
                                "example_id": "e61f0788-d39f-4603-a0f9-7f3d631ec7bb",
                                "sense_id": "eb9836cd-42ce-3196-86c0-49045c93708c",
                                "text": "„Mich erschreckt Deine Ehrfurchtslosigkeit gegenüber älteren Leuten, und besonders gegen die Eltern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
