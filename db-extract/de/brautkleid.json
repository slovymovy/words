                        ],
                        "form": "das Brautkleid"
                    },
                    {
                        "form_id": "9c96787c-4159-463b-bccf-b3d9671ffe9b",
                        "entry_id": "4b83b804-4db4-3e2d-a138-0b06ed637b31",
                        "tags": [
                            "accusative",
