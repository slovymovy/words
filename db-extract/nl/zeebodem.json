                "translations": [
                    {
                        "translation_id": "5ca251e0-fe01-48fc-8217-77f6d6fc24d6",
                        "source_entry_id": "1cd0094a-0e07-3bfe-8709-70381e3ce4b5",
                        "source_sense_id": "90b185e0-1e92-398f-a116-7aaf4ca37abb",
                        "source_sense_description": "het grondvlak van een zee",
                        "target_lang_word": "Meeresboden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meeresboden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55f6fd65-5f8f-3ca9-97c1-44c91c1cc586",
                                        "entry_id": "150c53f6-f595-3c20-b5ad-c344a16b02e7",
                                        "glosses": [
                                            "Boden eines Meeres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7751d6c2-42f9-4a60-945a-098fef10d960",
                                                "sense_id": "55f6fd65-5f8f-3ca9-97c1-44c91c1cc586",
                                                "text": "„Auf der 43-tägigen Forschungsreise, die drei Teams — Mikrobiologen, Geologen und Geochemiker — von Costa Rica über die Galapagos-Inseln bis nach Hawaii führte, haben sich die Geoforscher aus Potsdam das Leben im Meeresboden genauer angeschaut.“"
                                            },
                                            {
                                                "example_id": "afa8402b-c2df-4afd-83d3-feceec1a727a",
                                                "sense_id": "55f6fd65-5f8f-3ca9-97c1-44c91c1cc586",
                                                "text": "„Vulkanische Gase steigen aus einem hydrothermalen Schlot am Meeresboden auf.“"
                                            },
                                            {
                                                "example_id": "38d2af1c-0dd3-4a9d-bc6c-98dd4823beb6",
                                                "sense_id": "55f6fd65-5f8f-3ca9-97c1-44c91c1cc586",
                                                "text": "„Da Wüstensand nicht für Beton taugt, gerät der Meeresboden ins Visier.“"
                                            },
                                            {
                                                "example_id": "b08aef63-66b4-4b58-86f4-ab15c100be06",
                                                "sense_id": "55f6fd65-5f8f-3ca9-97c1-44c91c1cc586",
                                                "text": "„Das Boot ruckte an und kam vom Meeresboden frei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44942754-6397-4cec-aa85-5b5f4577c320",
                        "source_entry_id": "1cd0094a-0e07-3bfe-8709-70381e3ce4b5",
                        "source_sense_id": "90b185e0-1e92-398f-a116-7aaf4ca37abb",
                        "source_sense_description": "het grondvlak van een zee",
                        "target_lang_word": "Meeresgrund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meeresgrund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                        "entry_id": "a175cec7-3c08-37d3-b0c9-d486ed4d7701",
                                        "glosses": [
                                            "Boden des Meeres, der von Meerwasser bedeckt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f66a0502-04d5-4c1b-a26e-b26a34dcdb20",
                                                "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                                "text": "„Im Azorian-Projekt (auch bekannt als Jennifer-Projekt) versuchte die Central Intelligence Agency (CIA) unter strikter Geheimhaltung, das gesunkene sowjetische U-Boot K-129 vom Meeresgrund zu bergen.“"
                                            },
                                            {
                                                "example_id": "158e8036-fa44-497b-8db5-aae3de80c974",
                                                "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                                "text": "„Im offenen Meer vermischen sich chemische Stoffe gut, doch für das Überleben komplexer Moleküle ist es nicht ideal. Viele Wissenschaftler glauben, dass die Chancen auf dem Meeresgrund oder in Gesteinshöhlen besser waren.“"
                                            },
                                            {
                                                "example_id": "f906848f-b852-4819-953e-935176063490",
                                                "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                                "text": "„Marine Bodengemeinschaften benötigten aber nach der Bodenschatzgewinnung eine lange Zeit zur Regeneration. «Sandaale lieben Meeresgründe. Schweinswale lieben Sandaale», schilderte Benke.“"
                                            },
                                            {
                                                "example_id": "9d0e26f5-194a-4719-8ca1-7b7a631bc054",
                                                "sense_id": "3c923a3f-b202-3099-b6f9-d6cdf1298c1b",
                                                "text": "„[…] Was den Russen indes übel aufstößt, ist das Verhalten der russischen Führung im weiteren Sinne während der Tragödie der \"Kursk\", in den Tagen, da auf dem Meeresgrunde 118 Menschen qualvoll starben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
