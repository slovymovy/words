                        "sense_id": "c71b112e-92b7-3e46-9d11-b272cf99f7bf",
                        "entry_id": "62bdd5cd-5c1f-312e-aff5-ed92ea57f827",
                        "glosses": [
                            "Qui contient de l’uranium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4824d288-702c-4f0f-aa8f-45d199484d3f",
                                "sense_id": "c71b112e-92b7-3e46-9d11-b272cf99f7bf",
                                "text": "Minerai, substance, gisement uranifère."
                            },
                            {
                                "example_id": "0cb22fc8-f3da-4d43-b50e-a33d1a18cf0b",
                                "sense_id": "c71b112e-92b7-3e46-9d11-b272cf99f7bf",
                                "text": "Un accident nucléaire vient de se produire ce 19 septembre sur le site d'Areva-Orano à Malvési (Aude). Après avoir déployé un silence assourdissant, la direction de l'entreprise reconnaît qu'un fût de matière uranifère militaire situé au cœur d'un stock de 221 fûts entreposés-là depuis les années 1980, a explosé."
                            }
                        ]
                    },
                    {
                        "sense_id": "57c7c081-413c-375c-9f42-d4dea127897b",
                        "entry_id": "62bdd5cd-5c1f-312e-aff5-ed92ea57f827",
                        "glosses": [
                            "Relatif à l’uranium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7275a6d9-f798-4076-8d51-6993cd368037",
                                "sense_id": "57c7c081-413c-375c-9f42-d4dea127897b",
                                "text": "Industrie, exploration uranifère."
                            },
                            {
                                "example_id": "fca24f17-9a69-4f39-b62a-e235dd7fa9d8",
                                "sense_id": "57c7c081-413c-375c-9f42-d4dea127897b",
                                "text": "L’extraction uranifère au Niger a aussi aggravé la situation des nomades qui se sont vu confisquer de nombreuses zones de pâturage nécessaires à l’élevage."
                            }
                        ]
                    }
