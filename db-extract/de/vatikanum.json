                        "sense_id": "c782c35d-19ac-3eb2-a99b-405d5bf508db",
                        "entry_id": "7923118f-6014-35a6-beec-aa6838faa6b2",
                        "glosses": [
                            "Bezeichnung für die beiden Konzile, die in der Peterskirche in Rom stattfanden; erstes Vatikanum: 8. Dezember 1869 – 20. Oktober 1870; zweites Vatikanum: 11. Oktober 1962 – 8. Dezember 1965"
                        ],
                        "tags": [
                            "katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "2ea388b6-18f0-4c4c-ad58-9011511a4e33",
                                "sense_id": "c782c35d-19ac-3eb2-a99b-405d5bf508db",
                                "text": "„Jan-Heiner Tück nimmt wohlwollend zur Kenntnis, wie im zweiten Vatikanum, das vor vierzig Jahren zu Ende ging, der ‚Einbruch der Anderen‘ in Kauf genommen wurde.“"
                            }
                        ],
