                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>organized</w> a surprise party for her best friend last week.",
                            "target_lang_translations": {
                                "ru": "Она <w>организовала</w> вечеринку-сюрприз для своей лучшей подруги на прошлой неделе.",
                                "zh": "她上周为她最好的朋友<w>组织</w>了一场惊喜派对。"
                            }
                        },
                        {
                            "text": "The files were <w>organized</w> into different folders on the computer.",
                            "target_lang_translations": {
                                "ru": "Файлы были <w>организованы</w> по разным папкам на компьютере.",
                                "zh": "文件被<w>整理</w>到了电脑里的不同文件夹中。"
                            }
