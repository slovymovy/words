                "senses": [
                    {
                        "sense_id": "3667bee4-80c9-3a7f-9d07-49a855464a5d",
                        "entry_id": "a1902c91-1a9d-3317-8935-fc9637d4a2fc",
                        "glosses": [
                            "otwarty kanał, zwykle wzdłuż krawędzi jezdni, odprowadzający z ulicy wody opadowe i ściekowe"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2f4e2fc0-c9d4-350c-94b6-fff6ddc9d621",
                        "entry_id": "a1902c91-1a9d-3317-8935-fc9637d4a2fc",
                        "glosses": [
                            "środowisko ludzi zdemoralizowanych"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d57ac4b-602d-461b-b604-87289053b74c",
                        "source_entry_id": "a1902c91-1a9d-3317-8935-fc9637d4a2fc",
                        "source_sense_id": "3667bee4-80c9-3a7f-9d07-49a855464a5d",
                        "target_lang_word": "Rinnstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rinnstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c56176e4-9cbe-3a67-a6e5-5483936af034",
                                        "entry_id": "175b2ed6-492a-34c5-951f-06351a861733",
                                        "glosses": [
                                            "Rinne für den Abfluss neben dem Bürgersteig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccad976c-0937-4b93-991b-d648a4f59ce8",
                                                "sense_id": "c56176e4-9cbe-3a67-a6e5-5483936af034",
                                                "text": "„In den Rinnsteinen fließt das Wasser, die Straßen sind alle verlassen.“"
                                            },
                                            {
                                                "example_id": "57e4885e-9089-430a-a995-69b08776cd0a",
                                                "sense_id": "c56176e4-9cbe-3a67-a6e5-5483936af034",
                                                "text": "„Rosafarbenes Wasser rann an der Schwelle herab und malte auf seinem Weg zum Rinnstein ein Labyrinth in den Staub.“"
                                            },
                                            {
                                                "example_id": "ce62272a-fced-4505-8536-fd198b7f8f1c",
                                                "sense_id": "c56176e4-9cbe-3a67-a6e5-5483936af034",
                                                "text": "„Im Rinnstein ballten sich die Federn aus den aufgetrennten Kissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8f050222-5818-3cee-a26a-9cf0a70f474a",
                                        "entry_id": "175b2ed6-492a-34c5-951f-06351a861733",
                                        "glosses": [
                                            "Grenzstein des Bürgersteigs zur Gosse"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a4e2998-2db9-47e5-a82a-27eccd6958d8",
                        "source_entry_id": "a1902c91-1a9d-3317-8935-fc9637d4a2fc",
                        "source_sense_id": "3667bee4-80c9-3a7f-9d07-49a855464a5d",
                        "target_lang_word": "Gosse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gosse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                        "entry_id": "9bac0e60-e27d-319a-a8bd-f313eaeba396",
                                        "glosses": [
                                            "offene Rinne zur Abführung von Regen- und Schmutzwasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a04df5c0-64be-488f-956e-47385102dc0f",
                                                "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                                "text": "Die Gosse muss mal wieder gereinigt werden."
                                            },
                                            {
                                                "example_id": "dfdeaf31-3e0c-4705-ab58-719e20a4f610",
                                                "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                                "text": "„Sein Hunger war verschwunden, ebenso das noch vor wenigen Momenten recht dringliche Bedürfnis, eine Gosse oder einen Baum zu finden.“"
                                            },
                                            {
                                                "example_id": "f5c1df46-8fd7-4ef6-aa99-26ce31e3b2db",
                                                "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                                "text": "„Ich dachte auch an die Gossen, in denen ich einmal liegen würde.“"
                                            },
                                            {
                                                "example_id": "cc00b623-3870-4530-b026-d2536e2a3336",
                                                "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                                "text": "„Ungefähr ein halbes Dutzend Königspudel hockte in einer Reihe in der Gosse und erledigte seine Bedürfnisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a4e0c23-4d1d-371d-91f6-008da6b1a847",
                                        "entry_id": "9bac0e60-e27d-319a-a8bd-f313eaeba396",
                                        "glosses": [
                                            "sozial und/oder moralisch anrüchiger Bereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3ff64a-34a3-492b-a93d-efaa6c2c988b",
                                                "sense_id": "3a4e0c23-4d1d-371d-91f6-008da6b1a847",
                                                "text": "Er kommt aus der Gosse und verhält sich auch so."
                                            },
                                            {
                                                "example_id": "f7c7974f-17ad-4f99-99aa-ccf047186a50",
                                                "sense_id": "3a4e0c23-4d1d-371d-91f6-008da6b1a847",
                                                "text": "„Er war aus der Gosse gekommen und mußte in der Gosse bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "998e4312-0b71-4dec-bce3-c058be2ebf5b",
                        "source_entry_id": "a1902c91-1a9d-3317-8935-fc9637d4a2fc",
                        "source_sense_id": "3667bee4-80c9-3a7f-9d07-49a855464a5d",
                        "target_lang_word": "канава",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "канава",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0813d8de-876f-36f1-912d-a322a093ff02",
                                        "entry_id": "2f2b7b99-176c-31d5-bb28-22f201b97045",
                                        "glosses": [
                                            "протяжённая неглубокая выемка в грунте, обычно предназначенная для направления потока воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ac6d1b-82bd-4b79-ae3a-a28a9857b3b8",
                                                "sense_id": "0813d8de-876f-36f1-912d-a322a093ff02",
                                                "text": "В мае сточную канаву засыпают: прибыль воды прекращается."
                                            },
                                            {
                                                "example_id": "e1ac15f3-ca2e-43b3-b77b-1b1f06767d53",
                                                "sense_id": "0813d8de-876f-36f1-912d-a322a093ff02",
                                                "text": "И не зря: здесь кустарник подходил вплотную к дороге, а от трубы тянулась канава, и была эта канава, похоже, достаточно глубока, чтобы меня скрыть."
                                            },
                                            {
                                                "example_id": "a05b7404-4559-460c-913e-e46f522e0831",
                                                "sense_id": "0813d8de-876f-36f1-912d-a322a093ff02",
                                                "text": "Землянка была устроена следующим, вошедшим тогда в моду, способом: прорывалась канава в полтора аршина ширины, два — глубины и три с половиной длины. С одного конца канавы делались ступеньки, и это был сход, крыльцо; сама канава была комната, в которой у счастливых, как у эскадронного командира, в дальней, противуположной ступеням стороне, лежала на кольях, доска — это был стол."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb5aebc-c56a-3106-a8b6-2f7732967fa0",
                                        "entry_id": "2f2b7b99-176c-31d5-bb28-22f201b97045",
                                        "glosses": [
                                            "ров, вырытый для обозначения границ земельных участков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bfbfa1c-0a57-44a5-abf3-a6f1bae82294",
                                                "sense_id": "beb5aebc-c56a-3106-a8b6-2f7732967fa0",
                                                "text": "Ещё осенью землекопы рыли около Прогонной межевую канаву и прохарчили в трактире 18 рублей, и теперь нужно было застать в Шутейкине их подрядчика и получить с него эти деньги."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                        "entry_id": "2f2b7b99-176c-31d5-bb28-22f201b97045",
                                        "glosses": [
                                            "устар. наполненное водой искусственное русло, устраиваемое в грунте для судоходной связи между отдельными водоёмами, а также для водоснабжения, орошения, осушения болот и т. п.; канал"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36c1922c-6896-4eb4-a020-cd11bcbe215f",
                                                "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                                "text": "Вот, идем мы теперь мимо адмиралтейской крепостцы: небось не перемахнешь чрез валики, даром что водица в канавах заморожена."
                                            },
                                            {
                                                "example_id": "bf8c9ed7-e253-4a46-b2e7-0fb843c844e3",
                                                "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                                "text": "Работы производятся следующим образом: сперва запружают исток канала и прерывают сообщение его с Нилом; затем, чрез каждые 150 или 200 фут, устраивают поперек русла невысокие земляные плотинки; и наконец, вдоль и параллельно берегу канала, проводят узкую канаву."
                                            },
                                            {
                                                "example_id": "01745cf0-d3f4-4ada-9f84-4da05add7a15",
                                                "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                                "text": "С обеих сторон сих аллей было по три острова, четвероугольных, равной величины, разделенных между собою вновь прокопанными канавами, наполненными тогда ещё чистой, проточной водой и соединёнными деревянными мостиками."
                                            },
                                            {
                                                "example_id": "fdeda042-b173-4ae5-9a0e-7e8c6cd80722",
                                                "sense_id": "169ed35d-907b-35af-ac08-c99e8be4c10b",
                                                "text": "До недавнего времени не знали, как возвращать здоровье таким полянам; но теперь открыто средство; это ― дренаж: лишняя вода сбегает по канавам, остается воды сколько нужно, и она движется, и поляна получает реальность."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03f097de-e258-4eb3-b7be-2c9bb41aa429",
                        "source_entry_id": "a1902c91-1a9d-3317-8935-fc9637d4a2fc",
                        "source_sense_id": "2f4e2fc0-c9d4-350c-94b6-fff6ddc9d621",
                        "target_lang_word": "Gosse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gosse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                        "entry_id": "9bac0e60-e27d-319a-a8bd-f313eaeba396",
                                        "glosses": [
                                            "offene Rinne zur Abführung von Regen- und Schmutzwasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a04df5c0-64be-488f-956e-47385102dc0f",
                                                "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                                "text": "Die Gosse muss mal wieder gereinigt werden."
                                            },
                                            {
                                                "example_id": "dfdeaf31-3e0c-4705-ab58-719e20a4f610",
                                                "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                                "text": "„Sein Hunger war verschwunden, ebenso das noch vor wenigen Momenten recht dringliche Bedürfnis, eine Gosse oder einen Baum zu finden.“"
                                            },
                                            {
                                                "example_id": "f5c1df46-8fd7-4ef6-aa99-26ce31e3b2db",
                                                "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                                "text": "„Ich dachte auch an die Gossen, in denen ich einmal liegen würde.“"
                                            },
                                            {
                                                "example_id": "cc00b623-3870-4530-b026-d2536e2a3336",
                                                "sense_id": "fb7f6548-f677-343c-af6e-dedb85ef66d3",
                                                "text": "„Ungefähr ein halbes Dutzend Königspudel hockte in einer Reihe in der Gosse und erledigte seine Bedürfnisse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a4e0c23-4d1d-371d-91f6-008da6b1a847",
                                        "entry_id": "9bac0e60-e27d-319a-a8bd-f313eaeba396",
                                        "glosses": [
                                            "sozial und/oder moralisch anrüchiger Bereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3ff64a-34a3-492b-a93d-efaa6c2c988b",
                                                "sense_id": "3a4e0c23-4d1d-371d-91f6-008da6b1a847",
                                                "text": "Er kommt aus der Gosse und verhält sich auch so."
                                            },
                                            {
                                                "example_id": "f7c7974f-17ad-4f99-99aa-ccf047186a50",
                                                "sense_id": "3a4e0c23-4d1d-371d-91f6-008da6b1a847",
                                                "text": "„Er war aus der Gosse gekommen und mußte in der Gosse bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
