                "senses": [
                    {
                        "sense_id": "2b10a9f3-012f-3b62-92e6-92da3ebe147d",
                        "entry_id": "59477c42-73e9-31bc-8fe4-f6130f2cffeb",
                        "glosses": [
                            "Anweisung, Befehl, der meist von höherer Stelle gegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5d0b800-2e76-4e7f-a4d6-776cb6d680fc",
                                "sense_id": "2b10a9f3-012f-3b62-92e6-92da3ebe147d",
                                "text": "„Nach Ansicht der europäischen Flugsicherheitsbehörde EASA könnte ausgelaufenes und brennendes Öl Ursache des Triebwerksschadens bei dem Qantas-Airbus gewesen sein. Am Donnerstag hatte die Behörde deshalb in einer Direktive neue Untersuchungen bei den Riesenflugzeugen angeordnet.“"
                            },
                            {
                                "example_id": "faddb1b2-6f5e-484d-a5c1-6a2054898425",
                                "sense_id": "2b10a9f3-012f-3b62-92e6-92da3ebe147d",
                                "text": "„Die Kritiker hatten viele Jahre lang zu schreiben, was man ihnen sagte, sie konnten sich gegen die Direktiven des Propagandaministeriums nicht wehren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
