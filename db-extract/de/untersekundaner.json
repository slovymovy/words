                "senses": [
                    {
                        "sense_id": "8ec5e58a-0026-317b-8ce7-46fd92eb440f",
                        "entry_id": "a82f5c7d-959f-3eaf-bbb0-28007e247317",
                        "glosses": [
                            "Schüler, der in der Untersekunda ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c81c4da-9fe1-48fc-8c03-89e154287794",
                                "sense_id": "8ec5e58a-0026-317b-8ce7-46fd92eb440f",
                                "text": "„Ihr Sohn, ein Untersekundaner, ging wie mein Bruder auf das Möhlerather Gymnasium.“"
                            },
                            {
                                "example_id": "12adaee7-57c6-42ca-93f1-af64a4de198e",
                                "sense_id": "8ec5e58a-0026-317b-8ce7-46fd92eb440f",
                                "text": "„Aber so war ich nichts als ein etwas ältlicher Untersekundaner, von dem sie nur wußte, daß er ›ganz gut irgendwelche Faxen‹ machen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
