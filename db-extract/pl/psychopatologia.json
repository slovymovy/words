                                        "entry_id": "131e0227-1fa6-31c0-9fca-63faed3b9bd2",
                                        "glosses": [
                                            "The study of the origin, development, diagnosis and treatment of mental and behavioural disorders."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
