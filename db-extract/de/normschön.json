                "senses": [
                    {
                        "sense_id": "835e4951-0eac-3f5b-b818-9821fdb414cd",
                        "entry_id": "cd5b10ba-48b8-3229-90eb-17f703afd295",
                        "glosses": [
                            "das aktuell gewünschte Aussehen aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d2d0b1d-cd89-47ea-9640-0342e4ce4893",
                                "sense_id": "835e4951-0eac-3f5b-b818-9821fdb414cd",
                                "text": "„Wie ideologisch verblendet muss man sein, wie anfällig für Selbstbetrug, um angesichts Millionen plastisch-ästhetischer Eingriffe und Tausender normschöner Stars, Influencerinnen, Youtuber, Talkshow-Moderatorinnen, Messehostessen und Wetterfeen auf die dicke Eiskunstläuferin aus der Damenbindenwerbung zu zeigen und dann zu behaupten: Body Positivity? Läuft!“"
                            },
                            {
                                "example_id": "742c290a-b9f2-4685-8b45-672b8f69585f",
                                "sense_id": "835e4951-0eac-3f5b-b818-9821fdb414cd",
                                "text": "„Ob aber die Darstellung von dünnen oder normschönen Frauen einen unmittelbaren Effekt auf Essstörungen hat, ist nicht so eindeutig.“"
                            },
                            {
                                "example_id": "4d00a1e7-7602-414c-95c0-cad39f176716",
                                "sense_id": "835e4951-0eac-3f5b-b818-9821fdb414cd",
                                "text": "„Ein normschöner Körper hat es einfach beim Shoppen – in dem Moment, wo du mehrgewichtig bist, wird es schwierig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
