                "senses": [
                    {
                        "sense_id": "6679da7e-be43-3e19-816a-bbcf0f1f07a4",
                        "entry_id": "e6020c7d-041c-35ff-9790-afbe031e69e3",
                        "glosses": [
                            "Konsequenz, die sich erst nach einer gewissen Zeit bemerkbar macht und dann eine gewisse Zeit andauert"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "72df5807-8559-4ab2-a763-5ad0726267fd",
                                "sense_id": "6679da7e-be43-3e19-816a-bbcf0f1f07a4",
                                "text": "„Die Liste der möglichen Spät- und Langzeitfolgen einer Corona-Infektion ist lang. Doch neben Covid-19 können auch zahlreiche weitere Infektionskrankheiten eine Reihe schwerer Folgen mit sich bringen.“"
                            },
                            {
                                "example_id": "887021ed-28b2-4248-ba71-0e2387edac3c",
                                "sense_id": "6679da7e-be43-3e19-816a-bbcf0f1f07a4",
                                "text": "„Langzeitfolgen im Sinne von Erkrankungen, die erst viele Jahre nach der Impfung auftreten, gibt es nicht, denn Impfnebenwirkungen zeigen sich normalerweise innerhalb weniger Tage, spätestens nach ein paar Wochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a79225e1-f3dc-3e54-90e3-fb50409336be",
                        "entry_id": "e6020c7d-041c-35ff-9790-afbe031e69e3",
                        "glosses": [
                            "Nebenwirkung einer Infektion oder medizinischen Behandlung, die lange anhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e31ba20-f8d6-404b-baf3-b907e3cce9da",
                                "sense_id": "a79225e1-f3dc-3e54-90e3-fb50409336be",
                                "text": "„Rund die Hälfte der mit einer Corona-Infektion ins Krankenhaus eingelieferten Patienten leiden laut einer Studie ein Jahr später noch an Langzeitfolgen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
