{
    "word_family": [
        "circumscription",
        "circumscriptive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e525d736-a5b5-3762-852a-4e0ff8a5c765",
                    "sense_definition": "To limit narrowly or restrict the power, activity, or scope of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law will severely <w>circumscribe</w> the authority of local officials."
                        },
                        {
                            "text": "Economic sanctions were introduced to <w>circumscribe</w> the government's ability to trade internationally."
                        }
                    ],
                    "synonyms": [
                        "limit",
                        "restrict",
                        "confine",
                        "curb"
                    ],
                    "antonyms": [
                        "expand",
                        "broaden"
                    ],
                    "common_phrases": [
                        "circumscribe power",
                        "severely circumscribe",
                        "circumscribe the ability"
                    ]
                },
                {
                    "sense_id": "a96a58c7-4a0e-3062-ba38-028d83c729e4",
                    "sense_definition": "To draw a line around something; to encircle or mark off borders.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "draw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surveyor used a red pencil to <w>circumscribe</w> the boundaries on the map."
                        },
                        {
                            "text": "Ancient stone walls <w>circumscribe</w> the oldest part of the historic city."
                        }
                    ],
                    "synonyms": [
                        "encircle",
                        "surround",
                        "enclose"
                    ]
                },
                {
                    "sense_id": "f0605189-a4a5-3b02-85c9-c0dd6eee899a",
                    "sense_definition": "To draw a geometric figure around another so that they touch at as many points as possible without intersecting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "draw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students learned how to <w>circumscribe</w> a circle around an equilateral triangle."
                        },
                        {
                            "text": "Use a compass to <w>circumscribe</w> a regular polygon with a single circle."
                        }
                    ],
                    "antonyms": [
                        "inscribe"
                    ],
                    "common_phrases": [
                        "circumscribe a circle"
                    ]
                }
            ]
        }
    ]
}