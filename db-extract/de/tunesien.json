                    {
                        "translation_id": "d698fe5c-8552-49b6-adbe-c518e1535fde",
                        "source_entry_id": "b00173de-0721-38e0-bde8-c15d438e26cc",
                        "source_sense_id": "f69788ec-8ae2-30f5-b4fa-5033d619d520",
                        "source_sense_description": "Staat in Nordafrika",
