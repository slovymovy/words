                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c42470a0-31c4-4df7-87d7-aeb69cacf7c1",
                                                "sense_id": "5f0e76b9-55d1-3319-9ea7-d7c9ab94f075",
