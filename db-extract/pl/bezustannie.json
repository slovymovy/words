                    },
                    {
                        "translation_id": "e007d67d-baa6-4e18-b84f-5d48f564cf8f",
                        "source_entry_id": "e20de8f3-7919-3a96-a7b9-27c6710837cb",
                        "source_sense_id": "f16b3884-f97a-3f61-aeec-524638f7b069",
                        "target_lang_word": "continuously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "continuously",
