                        "sense_id": "c04f5042-1d82-3157-9f13-2eb093d6a3e6",
                        "entry_id": "83869175-50ab-3954-b3b5-210cf417e47d",
                        "glosses": [
                            "in de grond levende worm van de klasse Oligochaeta"
                        ],
                        "tags": [
                            "wormen"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a7254f65-a8fc-3c0c-914d-5ea8a3600566",
                        "entry_id": "83869175-50ab-3954-b3b5-210cf417e47d",
                        "glosses": [
                            "regenworm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c3cf5e0-2e65-4b97-8e1b-f6f1080dc14a",
                                "sense_id": "a7254f65-a8fc-3c0c-914d-5ea8a3600566",
                                "text": "Over enkele weken, na een paar felle najaarsstormen, zijn al die 200.000 bladeren verdwenen en worden ze door de wind voortgejaagd over de bosbodem, waar duizendpoten, maden, slijmzwammen, aardwormen en bacteriën ze zullen verteren tot nederige mulch."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dabcd9e-4c61-3c6d-bcf9-96cd37fbd44d",
                        "entry_id": "83869175-50ab-3954-b3b5-210cf417e47d",
                        "glosses": [
                            "mens"
                        ],
                        "tags": [
                            "plechtig"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df03c5a3-9edb-43dd-8896-4ed69d05adaa",
                        "source_entry_id": "83869175-50ab-3954-b3b5-210cf417e47d",
                        "target_lang_word": "Regenwurm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenwurm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                        "entry_id": "06976b1a-8c19-33d8-b07d-82cf78cda885",
                                        "glosses": [
                                            "im Boden lebender Wurm (zoologisch ein Ringelwurm aus der Ordnung der Wenigborster)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93d7206-c275-467b-812f-725215966420",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "Nach dem Regen beobachten die Kinder die Regenwürmer, die aus der Erde kriechen."
                                            },
                                            {
                                                "example_id": "9ed65d54-af2b-4952-a495-15c53d6d2cdb",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "„Regenwürmer leben im Boden, wo sie helfen, totes Pflanzenmaterial zu recyceln.“"
                                            },
                                            {
                                                "example_id": "c1330f06-7870-4758-9ea8-552055903adf",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "„Schon 1881 beschrieb Charles Darwin die Tatsache, dass Regenwürmer beständig die aus den tieferen Schichten des Bodens stammende Erde durch ihren Darm hindurch an die Erdoberfläche befördern und dadurch zur Auflockerung und Belüftung der Böden beitragen“"
                                            },
                                            {
                                                "example_id": "eec7a739-ce47-4035-884d-f1710fa8faea",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "„Die ersten Regenwürmer kriechen verliebt ans Tageslicht.“"
                                            },
                                            {
                                                "example_id": "34814273-3f31-4ac3-998a-92a17ac6067c",
                                                "sense_id": "87f467c1-9860-3d0d-9f36-a220df8fae9f",
                                                "text": "„Ein neutraler Köder, zum Beispiel ein Regenwurm, ist für beide Fischarten gleichermaßen (un)attraktiv.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "284465c6-382d-44f3-9766-515657e8dc17",
                        "source_entry_id": "83869175-50ab-3954-b3b5-210cf417e47d",
                        "target_lang_word": "earthworm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "earthworm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df9664a6-f498-3f61-851d-35e7c144aa9c",
                                        "entry_id": "fa743b4e-eb96-39d0-9f66-822d341fd930",
                                        "glosses": [
                                            "A worm that lives in the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4bed9c7-1ace-4ba8-a1b4-1603ad5ce65a",
                                                "sense_id": "df9664a6-f498-3f61-851d-35e7c144aa9c",
                                                "text": "It does not, however, happen that the whole spermatosphere is converted into spermatoblasts; there remains a passive portion, which in the earthworm occupies a central position; this is the \"sperm-blasophore,\" or \"blastophoral cell.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a2b98ff-9bdc-3681-be24-193867366b78",
                                        "entry_id": "fa743b4e-eb96-39d0-9f66-822d341fd930",
                                        "glosses": [
                                            "A worm of the family Lumbricidae, or, more generally, of the suborder Lumbricina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab91d401-b833-4727-ba71-60211b25704f",
                                                "sense_id": "7a2b98ff-9bdc-3681-be24-193867366b78",
                                                "text": "Before the study was begun, the known oligochaete fauna of Tasmania consisted of six species of aquatic microdriles, twenty-three indigenous species of megascolecid earthworms, and introduced earthworms of the family Lumbricidae."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "432798a4-823d-3089-9d48-9048a8bb22dd",
                                        "entry_id": "fa743b4e-eb96-39d0-9f66-822d341fd930",
                                        "glosses": [
                                            "A contemptible person; a groveller."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03fddac1-275c-46b5-a9c3-851b1bf0a7f5",
                        "source_entry_id": "83869175-50ab-3954-b3b5-210cf417e47d",
                        "target_lang_word": "lombrico",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d11f2039-ebc3-4956-ad38-088bbc958fa8",
                        "source_entry_id": "83869175-50ab-3954-b3b5-210cf417e47d",
                        "target_lang_word": "ver de terre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ver de terre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5268c009-47ce-3656-b671-d6a04370be10",
                                        "entry_id": "03f6b669-f5dd-3954-a395-1be1abccb23a",
                                        "glosses": [
                                            "Annélide oligochète terricole, invertébré de la famille des Lumbricidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "617fae8c-15c1-4d65-975f-a3c31b00a61c",
                                                "sense_id": "5268c009-47ce-3656-b671-d6a04370be10",
                                                "text": "D’un autre côté, Réaumur et ses émules interrogèrent les eaux douces, et les bryozoaires de nos étangs, les planaires et les nais de nos ruisseaux, les vers de terre eux-mêmes se montrèrent à divers degrés insensibles à des mutilations qui ne faisaient que les multiplier."
                                            },
                                            {
                                                "example_id": "bb4e0ffb-678c-4cbb-b324-564b1b625803",
                                                "sense_id": "5268c009-47ce-3656-b671-d6a04370be10",
                                                "text": "Le ver de terre , par sa présence, aère le sol, le rend perméable à l’eau, favorise l’installation de cloportes, de gloméris et de collemboles. Son abondance révèle une bonne fertilité du sol."
                                            },
                                            {
                                                "example_id": "d3d3883a-1e83-4b1a-94cc-904a37b39458",
                                                "sense_id": "5268c009-47ce-3656-b671-d6a04370be10",
                                                "text": "Le mercaptodiméthur, molluscicide de la société Bayer, est réputé avoir des effets in vitro sur les vers de terre. En fait, les expérimentations réalisées avec la formulation disponible en France (Mesurol RF) montrent que l'effet de la spécialité sur les vers de terre est non significatif tant au laboratoire qu'au champ."
                                            },
                                            {
                                                "example_id": "60875843-3311-4223-be8d-eb848a171289",
                                                "sense_id": "5268c009-47ce-3656-b671-d6a04370be10",
                                                "text": "Le lombricompostage est une variante du compostage reposant sur l'utilisation de vers de terre (lombrics) pour consommer et dégrader la matière organique du déchet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0477c344-8652-31d5-9823-7c165571c230",
                                        "entry_id": "03f6b669-f5dd-3954-a395-1be1abccb23a",
                                        "glosses": [
                                            "Personne insignifiante."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5247ec86-f786-4b18-8cd9-e1dd7b91bc51",
                                                "sense_id": "0477c344-8652-31d5-9823-7c165571c230",
                                                "text": "« Voulez-vous désobéir non à moi, qui suis un ver de terre, mais à notre roi légitime, Charles X ? leur dit-il quand il vit que chacun à son tour s’était donné le plaisir de parler de ses aïeux, de sa bravoure, et de la place qu’il avait occupée dans l’armée avant les fatales journées de 1830…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7314635-a48f-4f7c-8674-359e46c52a7f",
                        "source_entry_id": "83869175-50ab-3954-b3b5-210cf417e47d",
                        "target_lang_word": "lombric",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lombric",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "800fbed6-3ec3-387d-90f5-893fae93d1c6",
                                        "entry_id": "476f46c8-819b-34bd-a52e-f14cdda61032",
                                        "glosses": [
                                            "Genre d’annélides de la famille des lumbricidés (Lumbricidae)."
                                        ],
                                        "tags": [
                                            "Au sens étroit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1442b928-a179-445e-b5bb-399dea8d98c5",
                                                "sense_id": "800fbed6-3ec3-387d-90f5-893fae93d1c6",
                                                "text": "Les Naïs ont quelque analogie avec les Lombrics; leur sang est rouge et leur circulation très-facile à observer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e02e4e9-8520-3452-8e01-6160f8510bd5",
                                        "entry_id": "476f46c8-819b-34bd-a52e-f14cdda61032",
                                        "glosses": [
                                            "Sous-ordre des Lumbricina (ou lombriciens) faisant partie des annélides oligochètes Haplotaxida, avec des vers de grande taille."
                                        ],
                                        "tags": [
                                            "Au sens large"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83a820ba-0a9c-47c5-9946-2aecc54eb56b",
                                                "sense_id": "1e02e4e9-8520-3452-8e01-6160f8510bd5",
                                                "text": "Infatigable, le lombric creuse des galeries à la recherche de nourriture mais aussi pour y séjourner en profondeurs lors des périodes sèches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
