    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60a74854-6e16-349f-a6e0-16396ca21cac",
                    "sense_definition": "Обладать чем-либо, располагать в собственном пользовании или распоряжении.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу <w>иметь</w> хорошую работу и большую семью.",
                            "target_lang_translations": {
                                "en": "I want to <w>have</w> a good job and a big family.",
                                "es": "Quiero <w>tener</w> un buen trabajo y una gran familia.",
                                "fr": "Je veux <w>avoir</w> un bon travail et une grande famille."
                            }
                        },
                        {
                            "text": "Каждый человек должен <w>иметь</w> право на отдых.",
                            "target_lang_translations": {
                                "en": "Every person should <w>have</w> the right to rest.",
                                "es": "Cada persona debe <w>tener</w> derecho al descanso.",
                                "fr": "Chaque personne doit <w>avoir</w> le droit au repos."
                            }
                        }
                    ],
                    "synonyms": [
                        "обладать",
                        "владеть",
                        "располагать"
                    ],
                    "common_phrases": [
                        "иметь право",
                        "иметь значение",
                        "иметь возможность"
                    ],
                    "target_lang_definitions": {
                        "en": "To possess something, to have something at one's own disposal or use.",
                        "es": "Poseer o disponer de algo para su propio uso o disposición.",
                        "fr": "Posséder quelque chose, l'avoir à sa disposition ou en sa possession."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "general sense of possession"
                            },
                            {
                                "target_lang_word": "possess",
                                "target_lang_sense_clarification": "to own or hold property/qualities formally"
                            },
                            {
                                "target_lang_word": "own",
                                "target_lang_sense_clarification": "to possess as property"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tener",
                                "target_lang_sense_clarification": "poseer algo, sentido general"
                            },
                            {
                                "target_lang_word": "poseer",
                                "target_lang_sense_clarification": "ser dueño de algo"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir",
                                "target_lang_sense_clarification": "sens général de possession"
                            },
                            {
                                "target_lang_word": "posséder",
                                "target_lang_sense_clarification": "détenir la propriété"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "981ab84b-5117-33e3-b924-6b7960993611",
                    "sense_definition": "Характеризоваться определенными параметрами, формой или свойствами.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта комната <w>имеет</w> форму квадрата.",
                            "target_lang_translations": {
                                "en": "This room <w>has</w> the shape of a square.",
                                "es": "Esta habitación <w>tiene</w> forma de cuadrado.",
                                "fr": "Cette pièce <w>a</w> la forme d'un carré."
                            }
                        },
                        {
                            "text": "Участок <w>имеет</w> размер около десяти соток.",
                            "target_lang_translations": {
                                "en": "The plot <w>is</w> about one thousand square meters in size.",
                                "es": "El terreno <w>tiene</w> un tamaño de aproximadamente mil metros cuadrados.",
                                "fr": "Le terrain <w>a</w> une superficie d'environ dix ares."
                            }
                        }
                    ],
                    "synonyms": [
                        "характеризоваться"
                    ],
                    "common_phrases": [
                        "иметь форму",
                        "иметь размер"
                    ],
                    "target_lang_definitions": {
                        "en": "To be characterized by specific parameters, shape, or properties.",
                        "es": "Caracterizarse por tener ciertos parámetros, forma o propiedades.",
                        "fr": "Être caractérisé par des paramètres, une forme ou des propriétés particulières."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have",
                                "target_lang_sense_clarification": "to feature or express a property or dimension"
                            },
                            {
                                "target_lang_word": "be of",
                                "target_lang_sense_clarification": "to possess a particular form or size"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tener",
                                "target_lang_sense_clarification": "contar con cierta forma, tamaño o cualidad"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avoir",
                                "target_lang_sense_clarification": "présenter une caractéristique, une forme"
                            },
                            {
                                "target_lang_word": "présenter",
                                "target_lang_sense_clarification": "afficher une forme ou propriété"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d029a270-d2e8-3fd8-8df6-29708852cfe2",
                    "sense_definition": "Включать что-либо в свой состав; содержать.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот документ <w>имеет</w> несколько важных приложений.",
                            "target_lang_translations": {
                                "en": "This document <w>has</w> several important attachments.",
                                "es": "Este documento <w>tiene</w> varios anexos importantes.",
                                "fr": "Ce document <w>comporte</w> plusieurs annexes importantes."
                            }
                        },
                        {
                            "text": "Книга <w>имеет</w> развернутое оглавление.",
                            "target_lang_translations": {
                                "en": "The book <w>contains</w> a detailed table of contents.",
                                "es": "El libro <w>tiene</w> un índice detallado.",
                                "fr": "Le livre <w>contient</w> une table des matières détaillée."
