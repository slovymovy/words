                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zoekt een betrouwbare <w>partner</w> voor zijn nieuwe onderneming.",
                            "target_lang_translations": {
                                "en": "He is looking for a reliable <w>partner</w> for his new business.",
                                "ru": "Он ищет надежного <w>партнёра</w> для своего нового предприятия.",
                                "pl": "Szuka wiarygodnego <w>partnera</w> do swojego nowego przedsięwzięcia.",
                                "de": "Er sucht einen zuverlässigen <w>Partner</w> für sein neues Unternehmen.",
                                "fr": "Il cherche un <w>associé</w> fiable pour sa nouvelle entreprise.",
                                "it": "Cerca un <w>socio</w> affidabile per la sua nuova impresa.",
                                "cs": "Hledá spolehlivého <w>partnera</w> pro své nové podnikání.",
                                "tr": "Yeni girişimi için güvenilir bir <w>ortak</w> arıyor.",
                                "es": "Busca un <w>socio</w> de confianza para su nueva empresa."
                            }
                        },
                        {
                            "text": "De <w>partner</w> tekende het contract namens de hele firma.",
                            "target_lang_translations": {
                                "en": "The <w>partner</w> signed the contract on behalf of the entire firm.",
                                "ru": "<w>Партнёр</w> подписал контракт от имени всей фирмы.",
                                "pl": "<w>Wspólnik</w> podpisał umowę w imieniu całej firmy.",
                                "de": "Der <w>Partner</w> unterzeichnete den Vertrag im Namen der gesamten Firma.",
                                "fr": "Le <w>partenaire</w> a signé le contrat au nom de toute l'entreprise.",
                                "it": "Il <w>socio</w> ha firmato il contratto a nome di tutta l'azienda.",
                                "cs": "<w>Partner</w> podepsal smlouvu jménem celé firmy.",
                                "tr": "<w>Ortak</w>, sözleşmeyi tüm firma adına imzaladı.",
                                "es": "El <w>socio</w> firmó el contrato en nombre de toda la empresa."
                            }
                        }
