                "senses": [
                    {
                        "sense_id": "8c4e23a7-03bc-3a57-98f5-51922f834795",
                        "entry_id": "fd7073ec-4761-3ce4-b22f-f807a40c264a",
                        "glosses": [
                            "theoretischer Ansatz, mit dem man versucht, eine Quantentheorie des Universums zu entwickeln"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "58e20ffe-47f6-4e50-b045-e5acd8ff7991",
                                "sense_id": "8c4e23a7-03bc-3a57-98f5-51922f834795",
                                "text": "„Die Kosmologie baut insbesondere auf den Grundlagen der allgemeinen Relativitätstheorie auf, allerdings sind im Rahmen der Quantenkosmologie auch die Quantentheorien sehr bedeutsam um die Entwicklung des Universums in sehr viel früheren Phasen zu erklären.“"
                            },
                            {
                                "example_id": "8a333b07-2d8f-4e12-aa86-98ecbab7cc34",
                                "sense_id": "8c4e23a7-03bc-3a57-98f5-51922f834795",
                                "text": "„Auch in der Quantenkosmologie wurde die Viele-Welten-Interpretation als konzeptioneller Rahmen zur Beschreibung der Entwicklung des Universums verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
