                "senses": [
                    {
                        "sense_id": "4c5d5ddf-82f7-3a22-b400-fee08662b57a",
                        "entry_id": "0235ca7e-eda7-3c04-a664-5063e1a16cd7",
                        "glosses": [
                            "Retomber une nouvelle fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b825215a-e01b-44b6-b120-9fec8b6f44e1",
                                "sense_id": "4c5d5ddf-82f7-3a22-b400-fee08662b57a",
                                "text": "On dit que Rumba est l'histoire de gens qui tombent, qui se relèvent, qui re-retombent et se re-relèvent…"
                            },
                            {
                                "example_id": "3c0e87b4-5aab-460a-980d-b0607abb9e68",
                                "sense_id": "4c5d5ddf-82f7-3a22-b400-fee08662b57a",
                                "text": "J'ai vu des potes tomber, retomber et re-retomber."
                            },
                            {
                                "example_id": "1e88ca9f-06e2-4ba2-acc3-0b38ffb58877",
                                "sense_id": "4c5d5ddf-82f7-3a22-b400-fee08662b57a",
                                "text": "Je me re-exalte et je re-retombe — et toujours ainsi !"
                            }
                        ]
                    }
