                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b556784-afc6-4e06-9637-904af4d3c3ec",
                                "sense_id": "0d2ebf0e-f169-3cf9-a202-4353573f1c51",
                                "text": "De sage over het vrouwtje van Stavoren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e4eaef7-3d93-42e8-9958-9597b28fb07f",
                        "source_entry_id": "d36c6b5e-3fd2-3285-84e9-9b2877e7388e",
                        "source_sense_id": "0d2ebf0e-f169-3cf9-a202-4353573f1c51",
                        "target_lang_word": "Sage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4106ded5-fd56-37c9-b0a5-8ca5aa2fea76",
                                        "entry_id": "74473df5-7460-325d-b7f1-aa2142b7494e",
                                        "glosses": [
                                            "alte Erzählung unwahrer Ereignisse, welche oft historische Sachverhalte erklären soll oder auf solchen aufbaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22912128-65e0-4548-b2b4-4c40734c8074",
                                                "sense_id": "4106ded5-fd56-37c9-b0a5-8ca5aa2fea76",
                                                "text": "Die Sage von der Gründung Roms ist sehr bekannt."
                                            },
                                            {
                                                "example_id": "9208403a-2aa4-4312-8e3f-92476f9fef42",
                                                "sense_id": "4106ded5-fd56-37c9-b0a5-8ca5aa2fea76",
                                                "text": "„Das Adenauerhaus in Rhöndorf liegt am Fuß eines Bergs, der ohnehin überlaufen war: der Drachenfels, auf dem die romantische Sage ein Untier ansiedelte, das von einer frommen Jungfrau gezähmt wurde, auf dem ein Denkmal an die Befreiungskriege erinnert und auf den die erste deutsche Zahnradbahn führte.“"
                                            },
                                            {
                                                "example_id": "e54a5205-75c5-41bd-88d1-c36f29b23f5d",
                                                "sense_id": "4106ded5-fd56-37c9-b0a5-8ca5aa2fea76",
                                                "text": "„Das Rheingold, von dem die Sagen und Richard Wagner erzählen, lag nicht irgendwo zwischen den Felsen des Mittelrheins auf dem Flußgrund verborgen, sondern es wurde aus den Alpen, vom gebirgigen Ursprung her mit Glimmer, Quarz und Feldspat in winzigen Plättchen zu Tal geschwemmt und am Oberrhein abgelagert.“"
                                            },
                                            {
                                                "example_id": "c9b694d1-54e6-47de-93fe-2aedcf1f51fc",
                                                "sense_id": "4106ded5-fd56-37c9-b0a5-8ca5aa2fea76",
                                                "text": "„Der Sage nach rastete einst ein vom weiten Weg ermüdeter Riese auf der Felskante des Sonnenstein und schüttete währenddessen den Sand aus seinen Siebenmeilenstiefeln.“"
                                            },
                                            {
                                                "example_id": "b999e99e-8917-4b8c-b093-f60c87d35a7f",
                                                "sense_id": "4106ded5-fd56-37c9-b0a5-8ca5aa2fea76",
                                                "text": "„Hundert glorreiche Sagen von seiner Tollkühnheit sind hier wie überall im Schwang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3152e251-3c09-44df-baa1-c319cc2e5bcc",
                        "source_entry_id": "d36c6b5e-3fd2-3285-84e9-9b2877e7388e",
                        "source_sense_id": "0d2ebf0e-f169-3cf9-a202-4353573f1c51",
                        "target_lang_word": "saga",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saga",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c48ff5d-f017-34ae-8297-ed5e16abdfc6",
                                        "entry_id": "f0869d8f-212b-33c8-b0f5-11b83aa17a47",
                                        "glosses": [
                                            "An Old Norse (Icelandic) prose narrative, especially one dealing with family or social histories and legends."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fe164d1-22e9-394d-be13-95255080d8eb",
                                        "entry_id": "f0869d8f-212b-33c8-b0f5-11b83aa17a47",
                                        "glosses": [
                                            "Something with the qualities of such a saga; an epic, a long story."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eff24da-e0cd-4b58-aa62-891f13c6a663",
                                                "sense_id": "2fe164d1-22e9-394d-be13-95255080d8eb",
                                                "text": "The latest Fire Emblem, developed by the makers of Advance Wars and available in the U.S., is the seventh game in an epic saga that began 13 years ago on the NES."
                                            },
                                            {
                                                "example_id": "8f702545-f449-4b6b-b61a-d41cf8cf19b1",
                                                "sense_id": "2fe164d1-22e9-394d-be13-95255080d8eb",
                                                "text": "Manchester City put the Carlos Tevez saga behind them with a classy victory at Blackburn that keeps them level on points with leaders Manchester United."
                                            },
                                            {
                                                "example_id": "1e902c66-bee9-41b7-87c9-4f2a2fb13f6d",
                                                "sense_id": "2fe164d1-22e9-394d-be13-95255080d8eb",
                                                "text": "According to this saga of intellectual-property misanthropy, these creatures [patent trolls] roam the business world, buying up patents and then using them to demand extravagant payouts from companies they accuse of infringing them. Often, their victims pay up rather than face the costs of a legal battle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "saga",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
