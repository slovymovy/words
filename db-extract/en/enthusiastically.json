                                "target_senses": [
                                    {
                                        "sense_id": "90a38b14-1bbe-38a3-a680-316c6da0343b",
                                        "entry_id": "3e7bc589-f3ef-342f-997a-97418fe74217",
                                        "glosses": [
                                            "hartstochtelijk, met geestdrift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34953a74-e505-4b94-90be-524b87408a5b",
                                                "sense_id": "90a38b14-1bbe-38a3-a680-316c6da0343b",
                                                "text": "De enthousiaste aanhangers bleven hun ploeg de hele wedstrijd toejuichen."
                                            },
                                            {
                                                "example_id": "cca6e075-55ab-42d1-a9cb-fdd91f6ef0fa",
                                                "sense_id": "90a38b14-1bbe-38a3-a680-316c6da0343b",
                                                "text": "'Voor mij is een fatsoenlijke maaltijd: entree, plat, kaas, dessert', zegt Frédéric Deidier (49), terwijl hij enthousiast op zijn enorme buik kletst."
                                            },
                                            {
                                                "example_id": "73c7a6e9-ec13-4d1c-8c5e-278da41886d6",
                                                "sense_id": "90a38b14-1bbe-38a3-a680-316c6da0343b",
                                                "text": "Voor vertrek kreeg ik naast enthousiaste reacties ook veel aanmerkingen. Een halfjaar weg van mijn gezin vond men wel erg lang."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enthousiast",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e2db1d-5859-3f2c-b84b-971aaedb38f3",
                                        "entry_id": "78f16bdf-a2b5-3d2e-9ced-11f5bae8ae64",
                                        "glosses": [
                                            "iemand die over iets of iemand geestdriftig is (vaak gebruikt als tweede deel van een samengesteld begrip)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8456fcbe-93e7-4363-9eaa-5ddb266f2f1c",
                                                "sense_id": "a4e2db1d-5859-3f2c-b84b-971aaedb38f3",
                                                "text": "De eerste enthousiasten waren al twee uur voor de voorstelling aanwezig."
                                            },
                                            {
                                                "example_id": "66437445-fdb2-4455-815e-771c88a58068",
                                                "sense_id": "a4e2db1d-5859-3f2c-b84b-971aaedb38f3",
                                                "text": "De voetbalenthousiast bekeek elke wedstrijd drie keer op televisie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9154f4b4-d458-4021-847c-7e7c31367513",
                        "source_entry_id": "ed4ef5c3-22c2-3e82-9819-51464b843eb4",
