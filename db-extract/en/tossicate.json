                    {
                        "sense_id": "99880bcd-5a02-31a8-81e3-fe1f08a92407",
                        "entry_id": "f4bf3982-1e13-370f-b588-cbcdf7e490d2",
                        "glosses": [
                            "To upset, agitate, or disturb."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "436db511-ff0e-49b6-ab55-50d977cdd55e",
                                "sense_id": "99880bcd-5a02-31a8-81e3-fe1f08a92407",
                                "text": "“Sit down on the bed, a lanman,” whispered the director to me; “ they won't disturb a lady, though they'd think little about tossicating the poor.”"
                            },
                            {
                                "example_id": "57ab3f0e-cc77-46a9-85da-17967d9d6767",
                                "sense_id": "99880bcd-5a02-31a8-81e3-fe1f08a92407",
                                "text": "She'll tossicate yer brains in no time, and be as composed herself as a dove on her nest in a storm."
                            },
                            {
                                "example_id": "7a90e3e4-c659-476c-bc82-4a02771e9608",
                                "sense_id": "99880bcd-5a02-31a8-81e3-fe1f08a92407",
                                "text": "As one of the workmen expressed it, “ the earth was all turned and tossicated about.”"
                            },
                            {
                                "example_id": "1a1d0151-475c-41b2-b1f0-4461cb7c01f3",
                                "sense_id": "99880bcd-5a02-31a8-81e3-fe1f08a92407",
                                "text": "The whiskey is at length sent for, but only for the purpose of being diluted, which when Judy detects, she exclaims, \" Oh, if you plase, ma'am, don't put wather to it — the whiskey never harms me, but the water tossicates me sadly — just one glass, if you plase, ma'am; it's as good as five years' life to me.\""
                            }
                        ]
                    }
