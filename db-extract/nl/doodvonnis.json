                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5d279ac-c891-35a6-b083-b19338a2b5d1",
                        "entry_id": "f41cc3c3-8141-3018-bba3-4c60fbd60d9a",
                        "glosses": [
                            "vonnis waarbij iemand tot de doodstraf wordt veroordeeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c95133-7a70-4362-b3bc-1b3986b53dbd",
                                "sense_id": "a5d279ac-c891-35a6-b083-b19338a2b5d1",
                                "text": "Een doodvonnis mag alleen voor de ernstigste misdrijven worden uitgesproken."
                            },
                            {
                                "example_id": "a3c65200-d6ca-4843-b0f2-3d78b1c85949",
                                "sense_id": "a5d279ac-c891-35a6-b083-b19338a2b5d1",
                                "text": "De moordenaar zat in de gevangenis waar hij de voltrekking van zijn doodvonnis afwachtte."
                            }
                        ]
                    },
                    {
                        "sense_id": "6cd43735-f5d2-3a12-9f1e-ee694bf39d8c",
                        "entry_id": "f41cc3c3-8141-3018-bba3-4c60fbd60d9a",
                        "glosses": [
                            "fatale wending"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3fbfe0b3-8818-49d2-89bc-66ae10f0e516",
                                "sense_id": "6cd43735-f5d2-3a12-9f1e-ee694bf39d8c",
                                "text": "De diagnose kanker staat niet automatisch gelijk aan een doodvonnis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e25f7b3a-4a30-45fd-9f5f-f4c8d92076e3",
                        "source_entry_id": "f41cc3c3-8141-3018-bba3-4c60fbd60d9a",
                        "source_sense_id": "a5d279ac-c891-35a6-b083-b19338a2b5d1",
                        "source_sense_description": "juridisch",
                        "target_lang_word": "death sentence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "death sentence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35666a9f-9be4-33ee-a29a-59f25ecd15ba",
                                        "entry_id": "438e9ba4-0d3e-333c-8548-2d3e7671deb7",
                                        "glosses": [
                                            "A decree that someone be put to death as a punishment for a crime; a sentence of execution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58aff0be-485b-4d00-9d63-a086decc4a9b",
                                                "sense_id": "35666a9f-9be4-33ee-a29a-59f25ecd15ba",
                                                "text": "Tyrion’s tears contain the symbolic weight of his whole life; he wouldn’t be here if not for Jaime, as he admits, and his last hope is to give the man who risked everything to help him survive the same chance. Tyrion knows it’s a death sentence from Daenerys to betray her in this way, but he no longer cares."
                                            },
                                            {
                                                "example_id": "d5c9111b-6bd5-47aa-9a5b-d989cc41f946",
                                                "sense_id": "35666a9f-9be4-33ee-a29a-59f25ecd15ba",
                                                "text": "Comrades, here and now I pronounce the death sentence upon Snowball."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acc84a81-5cb0-3f0a-932c-8fb77cb2445d",
                                        "entry_id": "438e9ba4-0d3e-333c-8548-2d3e7671deb7",
                                        "glosses": [
                                            "Anything that spells death."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fde7093-8032-40ec-aafc-a7264881c5ff",
                                                "sense_id": "acc84a81-5cb0-3f0a-932c-8fb77cb2445d",
                                                "text": "Having the Huntington's gene is a death sentence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ab7c1a5-435e-44f4-9dca-745c6200ce7b",
                        "source_entry_id": "f41cc3c3-8141-3018-bba3-4c60fbd60d9a",
                        "source_sense_id": "a5d279ac-c891-35a6-b083-b19338a2b5d1",
                        "source_sense_description": "juridisch",
                        "target_lang_word": "arrêt de mort",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrêt de mort",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db96a835-7fc0-3ac1-a89a-0cf2df43776a",
                                        "entry_id": "8e28d096-ee56-3df3-b9de-17c236d99882",
                                        "glosses": [
                                            "Décision qui conduit à l’application de la peine de mort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8357d9c0-4e6f-4714-8102-61606cd547f6",
                                                "sense_id": "db96a835-7fc0-3ac1-a89a-0cf2df43776a",
                                                "text": "Le fugitif est sous le coup d’un arrêt de mort c’est pour cela qu’il est recherché mort ou vif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "974bb75c-d712-3ab9-8a50-a294d6e0192d",
                                        "entry_id": "8e28d096-ee56-3df3-b9de-17c236d99882",
                                        "glosses": [
                                            "Événement, situation, décision qui entraîne la mort ou la disparition certaine et définitive."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11f2cdec-71ad-4a3a-966e-161feafb0b20",
                                                "sense_id": "974bb75c-d712-3ab9-8a50-a294d6e0192d",
                                                "text": "Si on refusait une si juste demande, ce serait son arrêt de mort qu’on prononcerait, et dans ce cas je demande la permission de partir pour Sainte-Hélène, et d’aller rejoindre l’empereur pour recevoir ces derniers soupirs."
                                            },
                                            {
                                                "example_id": "fde1d669-53ad-4704-832b-d3f83004d3dc",
                                                "sense_id": "974bb75c-d712-3ab9-8a50-a294d6e0192d",
                                                "text": "De même que le renvoi d’un P-DG ou la fermeture d’une usine ne signent pas en eux-mêmes l’arrêt de mort d’une multinationale de l’automobile ou de la pharmacie, quelques arrestations télégéniques de chefs mafieux ne peuvent déstabiliser durablement et profondément une véritable mafia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d66a759-be3c-43bd-a08f-75d632c5192c",
                        "source_entry_id": "f41cc3c3-8141-3018-bba3-4c60fbd60d9a",
