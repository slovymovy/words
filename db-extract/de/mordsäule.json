                "senses": [
                    {
                        "sense_id": "150261fb-33e3-39dc-a5f6-3f6e5128fb00",
                        "entry_id": "aeb13ce9-5b33-38c1-8186-42197803fc1a",
                        "glosses": [
                            "hohe Säule mit Inschrift zur Erinnerung an einen feigen Mord"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59bd826d-770c-4e1f-a281-1b3cf708427c",
                                "sense_id": "150261fb-33e3-39dc-a5f6-3f6e5128fb00",
                                "text": "„Neben den zahlreichen historischen Grabmälern gibt es hier auch einen ganz besonderen Stein - die Mordsäule.“ Die"
                            },
                            {
                                "example_id": "4f00e6d5-a283-4872-8bab-e3ca24b722c1",
                                "sense_id": "150261fb-33e3-39dc-a5f6-3f6e5128fb00",
                                "text": "„Derselbe ist der Teil einer Mordsäule, die ursprünglich auf der Töpfer Gasse in Bautzen stand und daselbst im Jahre 1404 errichtet worden war.“"
                            },
                            {
                                "example_id": "8bdf7df3-a2d3-4d52-8371-0e872547dc77",
                                "sense_id": "150261fb-33e3-39dc-a5f6-3f6e5128fb00",
                                "text": "„Bei Eggesin machte ein Geocache diese Mordsäule zum Thema.“"
                            },
                            {
                                "example_id": "810b98ec-cba1-4fe6-a450-1b68202b84f1",
                                "sense_id": "150261fb-33e3-39dc-a5f6-3f6e5128fb00",
                                "text": "„Bei der Geschichte zur Mordsäule herrschte gespannte Ruhe.“"
                            },
                            {
                                "example_id": "9885756a-9c51-4466-9049-e91449c86e9f",
                                "sense_id": "150261fb-33e3-39dc-a5f6-3f6e5128fb00",
                                "text": "„Im dritten Teil Die zwei Mordsäulen in der Rochauer Heide befinden wir uns nach einem Zeitsprung einige Jahre nach den Verbrechen, die es aus dieser Position nun endgültig zu klären gilt.“"
                            },
                            {
                                "example_id": "84778183-41ab-4fd3-bc86-5d8941584385",
                                "sense_id": "150261fb-33e3-39dc-a5f6-3f6e5128fb00",
                                "text": "„Als eine der ersten Marter gilt die im Jahre 1202 erwähnte „Mordsäule“, eine steinerne Säule mit Inschrift.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
