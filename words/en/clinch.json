                            {
                                "target_lang_word": "omgeslagen spijkerpunt",
                                "target_lang_sense_clarification": "het omslaan van de spijkerpunt ter versteviging"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e139288e-f28f-33a9-ac4b-c48d171e01e0",
                    "sense_definition": "A pun or play on words.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old play was filled with witty banter and an occasional <w>clinch</w>.",
                            "target_lang_translations": {
                                "nl": "Het oude toneelstuk zat vol geestige scherts en af en toe een <w>woordspeling</w>."
                            }
                        },
                        {
                            "text": "He delighted the audience by making a clever <w>clinch</w>.",
                            "target_lang_translations": {
                                "nl": "Hij vermaakte het publiek met een slimme <w>woordspeling</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature for a pun"
                        }
                    ],
                    "target_lang_definitions": {
