{
    "word_family": [
        "viscountess",
        "viscountcy",
        "viscounty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "18826e28-039e-394a-b848-3d0c417457c1",
                    "sense_definition": "A member of the British peerage ranking above a baron and below an earl.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nobility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>viscount</w> attended the royal ceremony in his formal robes.",
                            "target_lang_translations": {
                                "tr": "<w>Vikont</w>, resmi kıyafetleriyle kraliyet törenine katıldı."
                            }
                        },
                        {
                            "text": "The local <w>viscount</w> owns much of the land in this county.",
                            "target_lang_translations": {
                                "tr": "Yerel <w>vikont</w>, bu ilçedeki arazilerin çoğuna sahiptir."
                            }
                        }
                    ],
                    "synonyms": [
                        "peer",
                        "nobleman"
                    ],
                    "common_phrases": [
                        "the viscount"
                    ],
                    "target_lang_definitions": {
                        "tr": "Baron ile kont arasında yer alan bir İngiliz soyluluk unvanı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "vikont",
                                "target_lang_sense_clarification": "Batı ülkelerinde kullanılan bir soyluluk unvanı."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b37439c8-3539-30a7-a01d-b161e1ff4003",
                    "sense_definition": "A type of nymphalid butterfly belonging to the genus Tanaecia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "butterfly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rare <w>viscount</w> butterfly is found in tropical forests.",
                            "target_lang_translations": {
                                "tr": "Nadir bulunan <w>vikont</w> kelebeği tropikal ormanlarda yaşar."
                            }
                        },
                        {
                            "text": "Collectors often look for the <w>viscount</w> among other nymphalid species.",
                            "target_lang_translations": {
                                "tr": "Koleksiyoncular, diğer nimfalid türleri arasında sıklıkla <w>vikont</w> kelebeğini ararlar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Tanaecia cinsine ait bir nimfalid kelebek türü."
                    },
                    "translations": {
                        "tr": []
                    }
                },
                {
                    "sense_id": "434954fb-3572-316d-be3b-f187ab3ff52a",
                    "sense_definition": "The formal title held by a viscount.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nobility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was granted the <w>viscount</w> by the monarch for his service.",
                            "target_lang_translations": {
                                "tr": "Hizmetlerinden dolayı hükümdar tarafından kendisine <w>vikontluk</w> unvanı verildi."
                            }
                        },
                        {
                            "text": "The <w>viscount</w> was officially bestowed upon the young heir.",
                            "target_lang_translations": {
                                "tr": "<w>Vikontluk</w> unvanı genç varise resmen verildi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir vikontun sahip olduğu resmi unvan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "vikontluk",
                                "target_lang_sense_clarification": "Vikont unvanı veya bu unvanın sağladığı makam."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "08fb99ae-4fe3-37e8-a8e1-2d89015c2f39",
                    "sense_definition": "A village located in Saskatchewan, Canada.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small town of <w>Viscount</w> on their way to Saskatoon.",
                            "target_lang_translations": {
                                "tr": "Saskatoon'a giderken <w>Viscount</w> adlı küçük kasabadan geçtiler."
                            }
                        },
                        {
                            "text": "The community of <w>Viscount</w> is situated in the rural plains.",
                            "target_lang_translations": {
                                "tr": "<w>Viscount</w> topluluğu kırsal ovalarda yer almaktadır."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Kanada'nın Saskatchewan eyaletinde bulunan bir köy."
                    },
                    "translations": {
                        "tr": []
                    }
                }
            ]
        }
    ]
}