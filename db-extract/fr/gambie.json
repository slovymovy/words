                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "298a55e0-e234-410f-be6b-4d352b8643b3",
                                                "sense_id": "7f426520-d9a0-35c0-85a7-56981e5bf876",
                                                "text": "„Abgesehen vom Küstenabschnitt ist Gambia vom zwanzigmal größeren Senegal umschlossen. Häufig wird das Land als eine Enklave bezeichnet, was aber den Zugang zum Atlantischen Ozean nicht berücksichtigt.“"
                                            },
                                            {
                                                "example_id": "9336a021-6bb9-4547-91fb-59f1c5ed5389",
                                                "sense_id": "7f426520-d9a0-35c0-85a7-56981e5bf876",
                                                "text": "„Abgesehen vom Küstenabschnitt ist Gambia vom zwanzig mal größeren Senegal umschlossen. Häufig wird das Land als eine Enklave bezeichnet, was aber nach der Definition inkorrekt ist.“"
                                            },
                                            {
                                                "example_id": "6b8d490d-adf4-40cf-9f7e-e57978d1cf39",
                                                "sense_id": "7f426520-d9a0-35c0-85a7-56981e5bf876",
                                                "text": "Banjul ist die Hauptstadt von Gambia."
                                            },
                                            {
                                                "example_id": "9f91a1aa-3d62-4efd-a919-e2aedaa9393d",
                                                "sense_id": "7f426520-d9a0-35c0-85a7-56981e5bf876",
                                                "text": "Das Gambia der Kolonialzeit kenne ich nur aus Geschichten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gambia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d1be461-f0d4-33f6-8966-2921e112f168",
