                "translations": [
                    {
                        "translation_id": "623f3f35-3cfc-4174-ac5d-631d09b4e249",
                        "source_entry_id": "0b2418fd-907d-35aa-aec3-a6cbb55004de",
                        "source_sense_id": "44992410-cd60-3a72-90c8-23659a8966d6",
                        "target_lang_word": "breathalyzer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "breathalyzer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cf29b3d-83c5-375d-8c65-40532bb61bfc",
                                        "entry_id": "46495754-2cbb-3211-a99a-d1d320647203",
                                        "glosses": [
                                            "A device that measures alcohol in expired air so as to estimate the concentration of alcohol in a person's blood; used by traffic police in cases of suspected driving while under the influence of alcohol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87352357-4fee-47f2-9fbc-0d140cda7491",
                                                "sense_id": "8cf29b3d-83c5-375d-8c65-40532bb61bfc",
                                                "text": "During the three day class we took one day of classroom study followed by one day of operating the breathalyzer and one day of drinking. Yes, I said drinking. […] I hated it but I got it down long enough to take the breathalyzer test. I blew a .11 on the model 900A Breathalyzer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8286255d-baf2-49ba-b7f6-a5554ec0e0fc",
                        "source_entry_id": "0b2418fd-907d-35aa-aec3-a6cbb55004de",
                        "source_sense_id": "44992410-cd60-3a72-90c8-23659a8966d6",
                        "target_lang_word": "alcootest",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcootest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7216195-20f8-3ca3-830b-bc9e4d5d95fd",
                                        "entry_id": "37288149-91f3-3cbd-ba8c-3b2ba40db0bb",
                                        "glosses": [
                                            "Éthylotest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e97fb185-3450-4329-be9d-a45fc96a20e5",
                                                "sense_id": "e7216195-20f8-3ca3-830b-bc9e4d5d95fd",
                                                "text": "Faire passer un alcootest."
                                            },
                                            {
                                                "example_id": "26daf735-9433-4da7-a9a8-f956a993f017",
                                                "sense_id": "e7216195-20f8-3ca3-830b-bc9e4d5d95fd",
                                                "text": "Et c’est ainsi que sur le coup de treize heures, un conducteur se soumettait à l’alcootest, au volant de son monospace qui transportait six facteurs rigolards…"
                                            },
                                            {
                                                "example_id": "106bdb5d-ce01-4193-9e04-fdc8cfd59fac",
                                                "sense_id": "e7216195-20f8-3ca3-830b-bc9e4d5d95fd",
                                                "text": "L’ « alcootest » a été reconnu extrêmement efficace, tant dans de nombreux pays étrangers (dans lesquels son utilisation a été rendue réglementaire) qu’au cours d’expériences faites en France dans divers départements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f8b865b-ebbb-4a2c-a9d1-f4b783fe8345",
                        "source_entry_id": "0b2418fd-907d-35aa-aec3-a6cbb55004de",
                        "source_sense_id": "44992410-cd60-3a72-90c8-23659a8966d6",
                        "target_lang_word": "alcotest",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcotest",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6145f64d-7acd-3716-9195-f3907c7c675d",
                                        "entry_id": "2bfdfded-a426-307c-85e4-e65690eb6855",
                                        "glosses": [
                                            "Variante orthographique de alcootest."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cba7c3e-20e3-453b-b81f-325d4806d169",
                                                "sense_id": "6145f64d-7acd-3716-9195-f3907c7c675d",
                                                "text": "Comme se présente l’alcotest ? Il comprend, tout d’abord un tube renfermant un réactif qui est un gel de silice imprégné de bichromate de potassium. En présence de vapeur d’alcool, ce réactif change de couleur : il est jaune et de jaune passe au vert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e8f8696-154c-460d-b7e1-42c9fffe7c2e",
