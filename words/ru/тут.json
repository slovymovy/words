{
    "word_family": [
        "тутовый",
        "тутовник",
        "тутовница"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "db37e6b1-f105-3e9e-a7b7-fc94e51eaf01",
                    "sense_definition": "Здесь; в этом месте.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я живу <w>тут</w> уже много лет.",
                            "target_lang_translations": {
                                "en": "I have lived <w>here</w> for many years.",
                                "zh": "我<w>这里</w>已经住了很多年了。"
                            }
                        },
                        {
                            "text": "Где-то <w>тут</w> должен быть магазин.",
                            "target_lang_translations": {
                                "en": "There must be a shop somewhere <w>here</w>.",
                                "zh": "商店应该就在<w>这儿</w>附近。"
                            }
                        }
                    ],
                    "synonyms": [
                        "здесь"
                    ],
                    "antonyms": [
                        "там"
                    ],
                    "common_phrases": [
                        "тут и там",
                        "тут как тут"
                    ],
                    "target_lang_definitions": {
                        "en": "Here; in this place.",
                        "zh": "指代说话人所在的位置或地点。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "here",
                                "target_lang_sense_clarification": "location"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "这里",
                                "target_lang_sense_clarification": "地点"
                            },
                            {
                                "target_lang_word": "这儿",
                                "target_lang_sense_clarification": "地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5aa081f-8014-3a48-92e4-b61db5e76d89",
                    "sense_definition": "В этот момент; в это время.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "И <w>тут</w> мы увидели море.",
                            "target_lang_translations": {
                                "en": "And <w>then</w> we saw the sea.",
                                "zh": "就在<w>当时</w>，我们看见了大海。"
                            }
                        },
                        {
                            "text": "Он <w>тут</w> же согласился помочь нам.",
                            "target_lang_translations": {
                                "en": "He <w>immediately</w> agreed to help us.",
                                "zh": "他<w>随即</w>答应了帮助我们。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "тут же"
                    ],
                    "target_lang_definitions": {
                        "en": "At this moment; at this time.",
                        "zh": "指代特定的时间点或紧接着发生的动作。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "sequence of events"
                            },
                            {
                                "target_lang_word": "at that moment",
                                "target_lang_sense_clarification": "time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当时",
                                "target_lang_sense_clarification": "时间"
                            },
                            {
                                "target_lang_word": "随即",
                                "target_lang_sense_clarification": "紧接着"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "931e7eaf-7813-39fe-82fc-325ccc163b18",
                    "sense_definition": "Южное лиственное дерево семейства тутовых (шелковица), а также его съедобный плод.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mulberry_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В нашем саду растёт старый <w>тут</w>.",
                            "target_lang_translations": {
                                "en": "An old <w>mulberry</w> grows in our garden.",
                                "zh": "我们的花园里长着一棵老<w>桑树</w>。"
                            }
                        },
                        {
                            "text": "Дети любят есть сладкий чёрный <w>тут</w>.",
                            "target_lang_translations": {
                                "en": "Children love eating sweet black <w>mulberries</w>.",
                                "zh": "孩子们喜欢吃甜甜的黑<w>桑葚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "шелковица",
                        "тутовник",
                        "тутовое дерево"
                    ],
                    "target_lang_definitions": {
                        "en": "Mulberry tree or its fruit.",
                        "zh": "桑科植物，指桑树或其果实。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mulberry",
                                "target_lang_sense_clarification": "tree or fruit"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桑树",
                                "target_lang_sense_clarification": "植物"
                            },
                            {
                                "target_lang_word": "桑葚",
                                "target_lang_sense_clarification": "果实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a579ca98-42c7-3ef7-9738-a7deb367e23e",
                    "sense_definition": "Древесина тутового дерева.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mulberry_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот музыкальный инструмент сделан из <w>тута</w>.",
                            "target_lang_translations": {
                                "en": "This musical instrument is made of <w>mulberry</w>.",
                                "zh": "这个乐器是用<w>桑木</w>做的。"
                            }
                        },
                        {
                            "text": "Мастер использовал <w>тут</w> для изготовления мебели.",
                            "target_lang_translations": {
                                "en": "The craftsman used <w>mulberry</w> to make furniture.",
                                "zh": "工匠用<w>桑木</w>来制作家具。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The wood of the mulberry tree.",
                        "zh": "桑树的木材。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mulberry",
                                "target_lang_sense_clarification": "material"
                            },
                            {
                                "target_lang_word": "mulberry wood",
                                "target_lang_sense_clarification": "material"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "桑木",
                                "target_lang_sense_clarification": "材料"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7c06bfd1-4e09-340f-832d-c30a316dd894",
                    "sense_definition": "Мужское имя.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Моего нового знакомого зовут <w>Тут</w>.",
                            "target_lang_translations": {
                                "en": "My new acquaintance is called <w>Tut</w>.",
                                "zh": "我新认识的朋友叫<w>图特</w>。"
                            }
                        },
                        {
                            "text": "<w>Тут</w> пришёл на встречу вовремя.",
                            "target_lang_translations": {
                                "en": "<w>Tut</w> arrived at the meeting on time.",
                                "zh": "<w>图特</w>准时参加了会议。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A male given name.",
                        "zh": "男性人名。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Tut",
                                "target_lang_sense_clarification": "name"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "图特",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}