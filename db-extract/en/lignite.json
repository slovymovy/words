                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4f91a78-d5b3-3b16-a512-722a2fd8bedc",
                                        "entry_id": "78184570-fd15-33a4-a35e-e4eb37190488",
                                        "glosses": [
                                            "Kohle, die hauptsächlich aus dem Tertiär stammt und relativ locker und bröckelig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5edc0ec-e8dd-492a-a315-ac5c443f428d",
                                                "sense_id": "b4f91a78-d5b3-3b16-a512-722a2fd8bedc",
                                                "text": "Braunkohle hat einen geringeren Heizwert als Steinkohle."
                                            },
                                            {
                                                "example_id": "f2d3576e-cc6c-43e2-b0b7-eeb0eb248ab0",
                                                "sense_id": "b4f91a78-d5b3-3b16-a512-722a2fd8bedc",
                                                "text": "Deutschland hat große Vorräte an Braunkohle."
                                            },
                                            {
                                                "example_id": "44aff291-dde7-4066-9a5d-4af3b37ba594",
                                                "sense_id": "b4f91a78-d5b3-3b16-a512-722a2fd8bedc",
                                                "text": "„Als der Weg an den Resten einer alten Seilbahnstütze vorbeiführt, macht Orfer daran regionale Geschichte fest: Mittels Seilbahn sei die in Grillenberg abgebaute Braunkohle früher in die Krupp'sche Metallfabrik in Berndorf transportiert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
