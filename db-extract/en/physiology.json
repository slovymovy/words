                                        "glosses": [
                                            "физиол. научная дисциплина, изучающая жизнедеятельность организмов, процессы, протекающие в их системах, органах, тканях, клетках и их структурных элементах, а также регуляцию функций"
                                        ],
                                        "tags": [],
