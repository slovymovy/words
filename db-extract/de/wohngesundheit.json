                "senses": [
                    {
                        "sense_id": "854a873e-83e1-3e5f-b88e-f239a01f845e",
                        "entry_id": "d5fd32d7-6169-3cc3-83e7-6231414ee8b4",
                        "glosses": [
                            "Gesundheitsverträglichkeit von Gebäuden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9bc25b8-94a5-4860-b2a5-75dd8bc7ff1c",
                                "sense_id": "854a873e-83e1-3e5f-b88e-f239a01f845e",
                                "text": "Die Wohngesundheit in unserem neuen Haus habe ich bereits bei der Lage, dem Baumaterial, der Heizungsanlage und der Lüftung bedacht."
                            },
                            {
                                "example_id": "83541e6a-e794-40d8-82b1-b8502b03d583",
                                "sense_id": "854a873e-83e1-3e5f-b88e-f239a01f845e",
                                "text": "„Haben wir dann schon einmal Einfluss auf die Gestaltung unserer gebauten Umwelt, sollten wir ihn auch nutzen und Experten der Wohngesundheit um Rat fragen: Baubiologen.“"
                            },
                            {
                                "example_id": "a7303fa5-fe80-45ab-88d4-784b17d513c3",
                                "sense_id": "854a873e-83e1-3e5f-b88e-f239a01f845e",
                                "text": "„In § 633 Absatz 2 des Bürgerlichen Gesetzbuchs wird auf Kriterien zur Wohngesundheit in der Beschaffenheitsvereinbarung verwiesen“"
                            },
                            {
                                "example_id": "7a6004fc-c12a-4ab5-b296-5f68849fe787",
                                "sense_id": "854a873e-83e1-3e5f-b88e-f239a01f845e",
                                "text": "„Wohngesundheit, Wohlfühlklima und Lebensqualität stellen sich nicht automatisch ein: Baumaterialien und Haustechnik müssen sensibel aufeinander abgestimmt und mit den Bedürfnissen der Bewohner in Einklang gebracht werden“"
                            },
                            {
                                "example_id": "726913cf-5a88-4c4f-a57f-20c6751bd6c1",
                                "sense_id": "854a873e-83e1-3e5f-b88e-f239a01f845e",
                                "text": "„Denn mit dem Institut für Umweltmedizin und Krankenhaushygiene und dessen Direktor, Prof. Dr. Volker Mersch-Sundermann, sowie mit dem Sentinel-Haus Institut hat sich Freiburg zu einem der wichtigsten Wissenszentren im Bereich Wohngesundheit entwickelt.“"
                            },
                            {
                                "example_id": "f65d1d55-0558-4ac9-9aa0-c505e1f139e8",
                                "sense_id": "854a873e-83e1-3e5f-b88e-f239a01f845e",
                                "text": "„Wohngesundheit beschäftigt sich mit der Vermeidung / Reduzierung der Gesundheit unzuträglicher Einflüsse bzw. Krankheit verursachender Faktoren gemäß dem Minimierungsgebot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
