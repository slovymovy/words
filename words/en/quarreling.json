    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31854f06-cef6-3b96-b91c-f3ac5d019dfb",
                    "sense_definition": "Present participle of <w>quarrel</w>: having an angry dispute or argument.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two brothers were constantly <w>quarreling</w> about which TV show to watch.",
                            "target_lang_translations": {
                                "cs": "Oba bratři se neustále <w>hádali</w> o to, na jaký televizní pořad se dívat."
                            }
                        },
                        {
                            "text": "We could hear the neighbors <w>quarreling</w> loudly late at night.",
                            "target_lang_translations": {
                                "cs": "Slyšeli jsme, jak se sousedé pozdě v noci hlasitě <w>hádají</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "arguing",
                        "bickering",
                        "squabbling",
                        "disputing"
                    ],
                    "antonyms": [
                        "agreeing",
                        "harmonizing"
                    ],
                    "common_phrases": [
                        "stop quarreling",
                        "quarreling about money"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "US standard spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "přítomné příčestí slovesa quarrel: vést hádku, hádat se či se přít."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hádat se",
                                "target_lang_sense_clarification": "mít slovní konflikt"
                            },
                            {
                                "target_lang_word": "přít se",
                                "target_lang_sense_clarification": "dohadovat se, vést spor"
                            },
                            {
                                "target_lang_word": "hašteřit se",
                                "target_lang_sense_clarification": "malicherně se hádat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "865e6090-6330-3f31-8aac-9580c34c9389",
                    "sense_definition": "The act of having an angry argument or dispute.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dispute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their constant <w>quarreling</w> made working in the office very difficult.",
                            "target_lang_translations": {
                                "cs": "Jejich neustálé <w>hádání</w> velmi ztěžovalo práci v kanceláři."
                            }
                        },
                        {
                            "text": "Tired of the endless <w>quarreling</w>, she decided to leave the room.",
                            "target_lang_translations": {
                                "cs": "Už měla plné zuby toho nekonečného <w>hašteření</w>, a tak se rozhodla odejít z místnosti."
                            }
                        }
                    ],
                    "synonyms": [
                        "arguing",
                        "bickering",
                        "squabbling",
                        "dispute"
                    ],
                    "antonyms": [
                        "agreement",
                        "harmony",
