                    {
                        "sense_id": "f40835a7-84ff-3dad-a0d0-6f5136857e0e",
                        "entry_id": "18cc7f2e-79a3-324e-a302-6508cc76bcfb",
                        "glosses": [
                            "abgefedertes Sprung- und Schwungbrett für Hoch- oder Kunstsprünge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97c62862-b8e4-47c4-b8fa-a9b1ba686aff",
                                "sense_id": "f40835a7-84ff-3dad-a0d0-6f5136857e0e",
                                "text": "„Am Rande des Springerbeckens installiert stehen sie wie vier Geschwister nebeneinander: Drei-Meter-Turm, Fünf-Meter-Turm, Drei-Meter-Turm mit Federbrett und Ein-Meter-Turm mit Federbrett.“"
                            },
                            {
                                "example_id": "af5858cb-0eb9-4dcf-811c-92d55e89e357",
                                "sense_id": "f40835a7-84ff-3dad-a0d0-6f5136857e0e",
                                "text": "„Erwähnt seien die schwierigen Taktfreiübungen, die sehr schöne Stellungen boten, das Keulenschwingen sowie die Sprünge am Kreuzpferd mit Benutzung eines Federbrettes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
