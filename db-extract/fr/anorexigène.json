                                "target_senses": [
                                    {
                                        "sense_id": "4672d9bc-aed0-38da-aa6a-97e69b97e9a7",
                                        "entry_id": "8d71baed-a7c6-394a-bb14-66a4959c2015",
                                        "glosses": [
                                            "creating or inducing a state of anorexia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa8f0099-66f1-4ba0-b2b5-49026aa5a285",
                                                "sense_id": "4672d9bc-aed0-38da-aa6a-97e69b97e9a7",
                                                "text": "No major advances were reported in the field of anorexigenic agents during the two year period 1968–1969."
                                            },
                                            {
                                                "example_id": "b208e54d-8c88-4a24-a502-2a68bf7058e1",
                                                "sense_id": "4672d9bc-aed0-38da-aa6a-97e69b97e9a7",
                                                "text": "Because of its efficacy and widespread clinical usage, amphetamine has been the standard anorexigenic drug for some time."
                                            },
                                            {
                                                "example_id": "134f1a22-cf76-4a1d-984d-d35e8fa9a8dd",
                                                "sense_id": "4672d9bc-aed0-38da-aa6a-97e69b97e9a7",
                                                "text": "Within this neural circuitry, numerous neuropeptides, both orexigenic (stimulate food intake) and anorexigenic (inhibit food intake), were discovered."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anorexigenic",
