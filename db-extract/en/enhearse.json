                "senses": [
                    {
                        "sense_id": "d4b2058c-07d2-3e14-9c15-3572079c639a",
                        "entry_id": "76718019-9fe7-3a60-aa0c-4833541be82b",
                        "glosses": [
                            "To place into, or as if into, a hearse or coffin."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e4bf7329-fbc2-4df7-b5fb-37daf94e7e1c",
                                "sense_id": "d4b2058c-07d2-3e14-9c15-3572079c639a",
                                "text": "Doubtless he would have made a noble knight;\nSee, where he lies inhearsed in the arms\nOf the most bloody nurser of his harms!"
                            },
                            {
                                "example_id": "e3250d11-8088-4d8a-bea7-fc3877d40ef2",
                                "sense_id": "d4b2058c-07d2-3e14-9c15-3572079c639a",
                                "text": "Enhearse thy sable soule in lasting feares;\nEnroule thy selfe amongst all mourners chiefe:"
                            },
                            {
                                "example_id": "0f1cc039-bb04-4ed1-8fd0-f0f799e28147",
                                "sense_id": "d4b2058c-07d2-3e14-9c15-3572079c639a",
                                "text": "Who, even that might, would dwell for ever pent\nIn this fair frame that doth the spirit inhearse,"
                            },
                            {
                                "example_id": "1c5e1308-aed2-4400-983c-41ce2ae830f2",
                                "sense_id": "d4b2058c-07d2-3e14-9c15-3572079c639a",
                                "text": "Dutifully we queue\nBy twosomes for each surrey cloaked in black\nTo pull up and enhearse us."
                            }
                        ]
                    }
                ],
