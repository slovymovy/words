                                        "sense_id": "91b31f81-d04f-3b92-9b87-fd5499c0c13a",
                                        "entry_id": "f5a413f0-7dfc-3120-9f27-c61336511922",
                                        "glosses": [
                                            "Enceinte de maisons où logeaient autrefois les chanoines des églises cathédrales ou collégiales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d37b6ea1-c601-4dfd-9259-ff40546f6022",
                                                "sense_id": "91b31f81-d04f-3b92-9b87-fd5499c0c13a",
                                                "text": "Le cloître de Notre-Dame ou de Saint-Germain-l'Auxerrois."
                                            }
