                "senses": [
                    {
                        "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                        "entry_id": "f7bdc8c8-11a7-371c-ba49-eb8a20e91371",
                        "glosses": [
                            "Gebäude eines Bauernhofs (eines landwirtschaftlichen Betriebs), das der Unterbringung von Kälbern und deren Aufzucht dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ef16958-14fe-4add-8d5e-a0607ffa01ce",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "„Mehrmalige Rundgänge im Kälberstall gehören zum täglichen Arbeitsmaß von Irma Benthin.“"
                            },
                            {
                                "example_id": "5488d826-9621-4bbb-9a56-5e1c328f011c",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "„Kleine Sensation – Kuh auf Südschwarzwälder Hof bekommt Drillinge“ […] „Die Kuhmutter braucht sich jetzt um nichts mehr zu kümmern. Sie darf wieder auf die Weide. Ihr Nachwuchs ist längst im Kälberstall einquartiert.“"
                            },
                            {
                                "example_id": "ccec0079-6049-4166-a78e-dc45fe3b5696",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "„Die Kamera wurde vor ein paar Tagen an der Decke versteckt. Seither dokumentiert sie, was in diesem brandenburgischen Kälberstall geschieht.“"
                            },
                            {
                                "example_id": "34109141-30c2-4ad8-8d97-0809e150fb09",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "[Auf dem Gelände sollen] „zwei neue hochmoderne Ställe entstehen, ein Kälberstall für 150 Jungtiere und ein Stall für 65 Milchkühe mit automatisiertem Melksystem.“"
                            },
                            {
                                "example_id": "08dde9a1-35e0-495a-95da-40dfbe27a389",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "„Elli rannte weiter, riss die Tür zum Kälberstall auf, wollte wieder nach den beiden rufen, aber die Worte blieben ihr im Hals stecken.“"
                            },
                            {
                                "example_id": "640a3c73-9357-4a55-8856-6201aa035f2c",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "„Die Hofmolkerei steht am Ortsrand von Heiligenbrunn und ist Teil des Bauernhofs der Familie Gasper. Molkerei und Kälberstall wurden innerhalb eines Jahres gebaut.“"
                            },
                            {
                                "example_id": "a9d6d7aa-81f5-4f54-86a5-13b903d7b182",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "„In Biebelried fing später ein Kälberstall Feuer, wie es von der Polizei am Freitag hieß.“"
                            },
                            {
                                "example_id": "b370e732-10a0-4a29-9436-45d8245f0dd9",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "„Der Brand in einem Kälberstall in Paternion am vergangenen Montag ist durch das Aufstreuen von ungelöschtem Kalk entstanden.“"
                            },
                            {
                                "example_id": "fa821b0a-0c16-42e0-a826-5ef47a9b4077",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "„Tierwohl-Preis für Milchviehbetrieb […] Der Betrieb Schwimmer erhielt den Preis für ein großzügiges und variabel gestaltbares Platzangebot im Kälberstall - kombiniert mit einer ausgefeilten Steuerung des Stallklimas.“"
                            },
                            {
                                "example_id": "7dcb31ff-a9c6-4f18-88c8-d14b5601b219",
                                "sense_id": "9b0d8ee1-4ded-3b68-89d5-90839944a735",
                                "text": "[…] „aus dem ehemaligen Kälberstall ist ein Café geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
