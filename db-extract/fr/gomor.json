                    }
                ],
                "senses": [
                    {
                        "sense_id": "dda23a38-bb30-3200-9a28-93c4d3915e98",
                        "entry_id": "84fefb2a-5cf9-341c-9394-2fca7550ec53",
                        "glosses": [
                            "Mesure de capacité chez les Hébreux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9813a1a-9ec6-44bf-8d25-976132b41d72",
                                "sense_id": "dda23a38-bb30-3200-9a28-93c4d3915e98",
                                "text": "Recueillez-en chacun selon ce qu’il peut manger, un gomor par personne. Vous en prendrez chacun selon le nombre des personnes qu’il a dans sa tente."
                            },
                            {
                                "example_id": "6cf63441-c07e-44f6-aa6d-5980f308d07a",
                                "sense_id": "dda23a38-bb30-3200-9a28-93c4d3915e98",
                                "text": "Le gomor, c’est un dixième de mesure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81e99b3e-a2b6-4924-9c67-4a55aaaa3792",
                        "source_entry_id": "84fefb2a-5cf9-341c-9394-2fca7550ec53",
                        "source_sense_id": "dda23a38-bb30-3200-9a28-93c4d3915e98",
                        "target_lang_word": "omer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc86d7af-581a-3973-abfe-8f204fa2b9ff",
                                        "entry_id": "245b3d06-05c5-337d-9902-75a5f42756bc",
                                        "glosses": [
                                            "A former small Hebrew unit of dry volume equal to about 2.3 L or 2.1 quarts."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82ebdd78-7dbd-456f-aaa1-f84709bf9741",
                                                "sense_id": "dc86d7af-581a-3973-abfe-8f204fa2b9ff",
                                                "text": "...that Omer which was every mans daily portion of Manna, is computed to have bin more then might have well suffic'd the heartiest feeder thrice as many meals."
                                            },
                                            {
                                                "example_id": "c9e4c0a7-ded7-4bcd-b961-13ece6ae5edd",
                                                "sense_id": "dc86d7af-581a-3973-abfe-8f204fa2b9ff",
                                                "text": "And it came to pass, that on the sixth day they gathered twice as much bread, two omers for one man: and all the rulers of the congregation came and told Moses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca06375-feaa-3ddb-94db-f321b0813ad4",
                                        "entry_id": "245b3d06-05c5-337d-9902-75a5f42756bc",
                                        "glosses": [
                                            "A vessel of one omer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8b2aa50-0aaf-35fe-8271-29ad1458253c",
                                        "entry_id": "245b3d06-05c5-337d-9902-75a5f42756bc",
                                        "glosses": [
                                            "The sheaf of barley offered on the second day of Passover."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "omer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0cd300b-00ec-32a9-8408-1bf7b3e5bcab",
                                        "entry_id": "5513c8df-4ca1-38aa-86d8-988685649e84",
                                        "glosses": [
                                            "The counting of the omer, that is, the period of 49 days between Passover and Shavuot."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "uncountable"
                                        ],
