                "senses": [
                    {
                        "sense_id": "fd7d4d34-8d51-3cee-a961-eacf6aecf4ee",
                        "entry_id": "da3eb767-b545-306e-bfb7-6dcbbc85b223",
                        "glosses": [
                            "Rendre ou déclarer comme compétent."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "03c17fec-331d-410f-b08e-20bdb224e6e6",
                                "sense_id": "fd7d4d34-8d51-3cee-a961-eacf6aecf4ee",
                                "text": "M'enfin amha les structures s'emmerdent pas et te compétentisent d'office du moment que tu exhibe gentiment une carte \"Nitrox\"...."
                            },
                            {
                                "example_id": "ec6ccf54-9711-4ffb-a0c3-995b9c58664f",
                                "sense_id": "fd7d4d34-8d51-3cee-a961-eacf6aecf4ee",
                                "text": "Donc, vous voulez que te juge se conscientise, se responsabilise, se \"compétentise\", etc., sur le fait d'emprisonner les individus, mais, par contre, le type va être amené directement en prison."
                            },
                            {
                                "example_id": "7e920375-c9c4-46f6-9eb7-db3fc5f573a5",
                                "sense_id": "fd7d4d34-8d51-3cee-a961-eacf6aecf4ee",
                                "text": "Aucune intimidation, aucun chantage, aucune mesure de rétorsion pour ceux qui décloisonnent, transversalisent, transdisciplinarisent, internautisent, littératurejeunissent, grammatotextualisent, compétentisent ou constructivisent."
                            }
                        ]
                    }
