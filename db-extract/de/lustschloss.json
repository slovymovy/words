                    {
                        "sense_id": "a784db41-3fe3-3aaa-95cd-483ee2d66d1f",
                        "entry_id": "ccf01d96-9392-3942-917c-cf368bc96d2c",
                        "glosses": [
                            "kleines Schloss auf dem Land für private Vergnügungen der Herrscher ohne aufwendiges Hofzeremoniell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2567a496-2177-430c-a827-1dd088165bc6",
                                "sense_id": "a784db41-3fe3-3aaa-95cd-483ee2d66d1f",
                                "text": "„[…] In Lahore erbauten die Mogul-Kaiser ihre Paläste, Lustschlösser, Moscheen und Prachtgärten; Kunst, Literatur und Handwerk erreichten hier eine außergewöhnliche Blüte; selbst die Backstein-Burgen der britischen Kolonialherren haben in diesem bunten Schmelztiegel der Formen und Farben orientalischen Charme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8f45c7d-e30c-406e-9df2-376eec2b4812",
