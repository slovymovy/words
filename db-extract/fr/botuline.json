                "senses": [
                    {
                        "sense_id": "3082263b-18be-3e6a-baa1-e4aa2ee96811",
                        "entry_id": "f4b73e77-262c-3abf-9acf-a2dffbb14f86",
                        "glosses": [
                            "Neurotoxine bactérienne produite par plusieurs bactéries anaérobies du genre Clostridium et causant le botulisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91905797-0deb-46ed-ac0e-1881fab17e44",
                                "sense_id": "3082263b-18be-3e6a-baa1-e4aa2ee96811",
                                "text": "L’action physiologique de la botuline est surtout remarquable chez le chat et le pigeon ; elle donne lieu à des phénomènes nerveux, à des parésies limitées et à des troubles sécrétoires entièrement analogues à ceux déterminés par le jambon d’Ellezelles."
                            },
                            {
                                "example_id": "8eb2144f-59bb-41ce-98e1-0f60adff7d81",
                                "sense_id": "3082263b-18be-3e6a-baa1-e4aa2ee96811",
                                "text": "Le botulisme est dû à un microbe qui produit une toxine très vi­r­ulente, la botuline."
                            },
                            {
                                "example_id": "d9e5b688-9648-4e63-a9ff-ef56cc676ac1",
                                "sense_id": "3082263b-18be-3e6a-baa1-e4aa2ee96811",
                                "text": "Le Botox est dérivé de la toxine botulique (ou botuline) A, produite par la bactérie à l’origine du botulisme - une forme d.intoxication alimentaire souvent fatale."
                            }
                        ]
                    }
                ],
