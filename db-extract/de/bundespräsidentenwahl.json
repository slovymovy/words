                "senses": [
                    {
                        "sense_id": "fdc51a86-11c0-3be8-b848-d98d7c083bd2",
                        "entry_id": "d00fe98a-7f05-3ed4-9eec-4c47dea3a920",
                        "glosses": [
                            "Wahl eines Bundespräsidenten oder einer Bundespräsidentin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f21169d-86c2-4712-9216-706116770b57",
                                "sense_id": "fdc51a86-11c0-3be8-b848-d98d7c083bd2",
                                "text": "„Der ehemalige Grünen-Chef, der als möglicher Kandidat für die Bundespräsidentenwahl 2016 gehandelt wird, heiratete Parteikollegin Doris Schmidauer.“"
                            },
                            {
                                "example_id": "380d37f3-22b9-4039-a39c-bfd212df264e",
                                "sense_id": "fdc51a86-11c0-3be8-b848-d98d7c083bd2",
                                "text": "„\"Man muss wissen, wo man hingehört\": So begründete Niederösterreichs Landeshauptmann Erwin Pröll (ÖVP) am Freitag im APA-Gespräch, warum er nicht bei der Bundespräsidentenwahl antritt.“"
                            },
                            {
                                "example_id": "4b9e8eab-5a51-48eb-be11-d71b362f92a2",
                                "sense_id": "fdc51a86-11c0-3be8-b848-d98d7c083bd2",
                                "text": "„Der Professor für Wirtschaftswissenschaft war bis Ende der 1980er Jahre Mitglied der Sozialdemokratischen Partei (SPÖ) und wechselte danach zu den Grünen. Zur Bundespräsidentenwahl trat er aber als Unabhängiger, nicht von einer Partei nominierter Kandidat an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
