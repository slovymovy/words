                    {
                        "sense_id": "13a17edb-a83b-3bc7-8150-5d6892ae43ed",
                        "entry_id": "214694aa-6e7f-3d2f-85a2-a15087d889cb",
                        "glosses": [
                            "een klein, houten huisje of cabine dat boven de vloedlijn op populaire stranden wordt geplaatst, en dient als omkleedruimte en opslag voor strandspullen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5de36864-4dcb-3c04-9821-989fbe455cd9",
                        "entry_id": "214694aa-6e7f-3d2f-85a2-a15087d889cb",
                        "glosses": [
                            "klein huis op het strand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e3bdc61-1882-4ae8-8408-6778d58235ee",
                                "sense_id": "5de36864-4dcb-3c04-9821-989fbe455cd9",
                                "text": "Hallo? Konnichiwa, ciao, zdraste, bonjour, hoort u mij, hallo? Op duizenden kilometers van hun orbit, achter de ronding van de aarde, staan in een strandhut nabij Cape Canaveral vier bedden die gisteren door een ander groepje astronauten werden verlaten."
                            },
                            {
                                "example_id": "b675ce83-0ee3-48f3-95a5-0e885157f049",
                                "sense_id": "5de36864-4dcb-3c04-9821-989fbe455cd9",
                                "text": "Bij het wakker worden in hun strandhut op Cape Canaveral heel even een gedesoriënteerd gevoel, dan zou het beginnen te dagen en zouden ze rechtop gaan zitten en hun benen over de rand van het bed zwaaien."
                            }
                        ]
                    }
