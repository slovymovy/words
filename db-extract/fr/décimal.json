                                        "glosses": [
                                            "auf der Grundzahl 10 beruhend; auf die Basis 10 bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83770a14-8790-4ff7-a323-90a0d6d7f568",
                                                "sense_id": "13458d09-12c1-3397-ac94-85ad8232426d",
                                                "text": "In der Antike und im Mittelalter wurden die meisten Einheiten nicht dezimal unterteilt."
                                            },
                                            {
                                                "example_id": "cf55951d-1d34-4328-a2c8-c3a6dda3442a",
                                                "sense_id": "13458d09-12c1-3397-ac94-85ad8232426d",
                                                "text": "„Das Querprodukt einer natürlichen Zahl ist – analog zur Quersumme – das Produkt ihrer Ziffernwerte. Das dezimale Querprodukt von 5496 ist beispielsweise 5·4·9·6 = 1080.“"
                                            }
