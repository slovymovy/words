                ],
                "senses": [
                    {
                        "sense_id": "fcd3467b-f345-35bf-b7fb-95338a8126e0",
                        "entry_id": "89436db6-4912-3336-8627-0202ab0cc6fd",
                        "glosses": [
                            "Faire tremper dans la saumure préalablement à la mise en conserve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcb4eb58-8eeb-45ae-b583-fe1075142c1e",
                                "sense_id": "fcd3467b-f345-35bf-b7fb-95338a8126e0",
                                "text": "Il est toujours possible de plonger ton canard entier dans une dilution sel + citron montée à 80° une heure comme si tu voulais le présaumurer, puis l'égoutter, le rincer et le plonger dans une solution neuve de citron à température ambiante et l'y laisser reposer pendant plusieurs jours, l'acidité du citron achevera le travail commencé par ton présaumurage tout en t'assurant une cuisson à coeur ainsi qu'un parfum très citronné."
                            },
                            {
                                "example_id": "dd5b1b03-5402-4549-b3c3-fe4164eee130",
                                "sense_id": "fcd3467b-f345-35bf-b7fb-95338a8126e0",
                                "text": "Notre foie gras mi-cuit à l'armagnac est présaumuré avec une fleur de sel puis mariné."
                            },
                            {
                                "example_id": "35b347dc-8928-42d1-9325-056f34ef6f7d",
                                "sense_id": "fcd3467b-f345-35bf-b7fb-95338a8126e0",
                                "text": "Lorsque les conserves sont préparées à partir de champignons présaumurés, la mention « préparés par le procédé de présaumurage » doit figurer dans la liste des ingrédients."
                            }
                        ]
                    }
