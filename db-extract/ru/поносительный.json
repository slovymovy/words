                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "insulting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db1c9f2d-1fca-3201-94de-76724ca9b011",
                                        "entry_id": "f5cb8e79-e8e2-342b-8ef9-61f215a4fb30",
                                        "glosses": [
                                            "The act of giving insult."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fee0d2a-61eb-4ed8-b036-6582d0051221",
                                                "sense_id": "db1c9f2d-1fca-3201-94de-76724ca9b011",
                                                "text": "grievous reproaches, and scornful insultings over him in his affliction"
                                            },
                                            {
                                                "example_id": "5ec3fd86-e752-4ab2-ac21-b0cd9bfee79c",
                                                "sense_id": "db1c9f2d-1fca-3201-94de-76724ca9b011",
                                                "text": "Many were the outragings and insultings of the Indians upon the English while Sir Edmund Andros was Governor."
                                            }
