                "senses": [
                    {
                        "sense_id": "c6048955-dadb-34f5-9419-a070d993075c",
                        "entry_id": "3e38ccf2-c6bb-3b4e-952e-84c85b10356d",
                        "glosses": [
                            "Rendre irréel."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bc405d41-b841-4e9a-8f71-7e251b3ea06b",
                                "sense_id": "c6048955-dadb-34f5-9419-a070d993075c",
                                "text": "Vous irréalisez les Formes à l’entour,\nTant vous éblouissez les Azurs et les Choses !"
                            },
                            {
                                "example_id": "c9ece579-bb7d-4cea-997b-56e293e35c4b",
                                "sense_id": "c6048955-dadb-34f5-9419-a070d993075c",
                                "text": "Le brouillard léger du matin et cette profuse lumière où s’évaporait et s’irréalisait chaque objet favorisaient encore son vertige."
                            },
                            {
                                "example_id": "41a4ef1f-7add-4fb9-b7aa-547a1330d80c",
                                "sense_id": "c6048955-dadb-34f5-9419-a070d993075c",
                                "text": "Constamment elle s’irréalise dans des histoires et des rencontres imaginaires qui finissent en orgasmes le soir sous les draps."
                            }
                        ]
                    },
