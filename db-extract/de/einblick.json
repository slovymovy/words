                "senses": [
                    {
                        "sense_id": "309843c5-d6b3-30fc-97ed-69837f8f0557",
                        "entry_id": "7b6b293d-9df6-3626-a01b-74178c883e1f",
                        "glosses": [
                            "Blick in die Zusammensetzung einer Sache, einer Situation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b677ac42-b355-45a3-b68d-b1539fa1730a",
                                "sense_id": "309843c5-d6b3-30fc-97ed-69837f8f0557",
                                "text": "„Er nimmt einen Einblick in die Unterlagen.“"
                            },
                            {
                                "example_id": "3a71bcb2-16dd-495d-a7eb-b40364564f33",
                                "sense_id": "309843c5-d6b3-30fc-97ed-69837f8f0557",
                                "text": "„Fortune gab einen neuen Einblick in Agrar- und Industriewirtschaft.“"
                            },
                            {
                                "example_id": "89469aad-55ef-4fab-9736-8c6e47acc500",
                                "sense_id": "309843c5-d6b3-30fc-97ed-69837f8f0557",
                                "text": "„Die Serie gibt einen Einblick in den Fußball der frühen Siebziger Jahre, als der Ligafußball weit weniger kommerziell geprägt war als heute.“"
                            },
                            {
                                "example_id": "301d34c3-650b-460c-a977-213f3a1b374f",
                                "sense_id": "309843c5-d6b3-30fc-97ed-69837f8f0557",
                                "text": "„Dort sollen Regierungskunden künftig Einblick in den Quellcode von Software und Diensten des Unternehmens erhalten, um deren Sicherheit selbst prüfen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f6d9fa1-5079-4bc8-84be-b97610c55fa3",
                        "source_entry_id": "7b6b293d-9df6-3626-a01b-74178c883e1f",
                        "source_sense_id": "309843c5-d6b3-30fc-97ed-69837f8f0557",
                        "source_sense_description": "Blick in die Zusammensetzung einer Sache, einer Situation",
                        "target_lang_word": "insight",
                        "target_lang_code": "en",
