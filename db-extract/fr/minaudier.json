                        "entry_id": "f46fe93d-28d2-3a23-94ec-c839ed7b30f9",
                        "glosses": [
                            "Personne minaudière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343bf2cb-2eb0-47c7-92cf-5692c01e1f2a",
                                "sense_id": "e257d1af-6a74-3e20-a308-7a383a6d8be8",
                                "text": "Dans le Haut-Languedoc, un cathari est un maniéré, un minaudier, un hypocrite et une catharinade est une caresse fallacieuse, une fleurette, un faux-semblant."
                            }
                        ]
                    }
