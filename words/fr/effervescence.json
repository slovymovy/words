            "senses": [
                {
                    "sense_id": "d75839e5-fc2e-3c1f-bf6e-277334552519",
                    "sense_definition": "État de vive animation, d'enthousiasme ou d'excitation dans un groupe ou un esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la ville était en pleine <w>effervescence</w> à la veille du festival de musique."
                        },
                        {
                            "text": "Son annonce a provoqué une vive <w>effervescence</w> parmi les étudiants réunis dans l'amphithéâtre."
                        }
                    ],
                    "synonyms": [
                        "excitation",
                        "animation",
                        "enthousiasme",
                        "agitation"
                    ],
                    "antonyms": [
                        "calme",
                        "apathie",
                        "tranquillité"
                    ],
                    "common_phrases": [
