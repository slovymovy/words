                                    {
                                        "sense_id": "d7894d58-717c-30cf-afb8-795f518fc6a9",
                                        "entry_id": "3cc19142-20dd-32c0-82fc-b4e41187cdad",
                                        "glosses": [
                                            "A person dedicated to a life of religion or monasticism, especially a member of an order without religious vows or a lay member of a religious community."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "290c313b-e4da-3041-a978-0b94281550c3",
                                        "entry_id": "3cc19142-20dd-32c0-82fc-b4e41187cdad",
                                        "glosses": [
                                            "A child given up by its parents into the keeping or dedication of a religious order or house."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e81a9b81-34e9-43c0-b099-ce2eb4b89ebb",
                                                "sense_id": "290c313b-e4da-3041-a978-0b94281550c3",
                                                "text": "2007, The Venerable Bede started as an oblate at St Paul's, Jarrow, but by the time of his death in 735 was surely the most learned man in Europe. — Tom Shippey, ‘I Lerne Song’, London Review of Books 29:4, p. 19"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oblate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7578269-5d39-3683-9f6b-7fbf9b565774",
                                        "entry_id": "fd860e49-282a-300d-acbe-dfe5d3980507",
                                        "glosses": [
                                            "Flattened or depressed at the poles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95851d4e-3262-4216-bacf-201ad7014d63",
                                                "sense_id": "b7578269-5d39-3683-9f6b-7fbf9b565774",
                                                "text": "The Earth is an oblate spheroid."
                                            },
                                            {
                                                "example_id": "0604b696-4b42-4109-828f-2b62206d1984",
                                                "sense_id": "b7578269-5d39-3683-9f6b-7fbf9b565774",
                                                "text": "Why should I not speak to him or to any human being who walks upright upon this oblate orange?"
                                            },
                                            {
                                                "example_id": "8a07ae2c-b411-441a-ab14-4aa20786ff36",
                                                "sense_id": "b7578269-5d39-3683-9f6b-7fbf9b565774",
                                                "text": "’Tis prolate, still,’ with a long dejected Geordie O. ‘Isn’t it…?’ ‘I’m an Astronomer,– trust me, ’tis gone well to oblate.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
