                    {
                        "form_id": "7a4e657e-787d-4e23-8611-1c898ae4d095",
                        "entry_id": "e55ee74d-057b-3c98-9663-b5a78f0ea6e4",
                        "tags": [
                            "participle",
                            "present"
                        ],
                        "form": "fossicking"
                    },
                    {
                        "form_id": "e26b35fc-8e34-472e-9b10-a5255c39f837",
                        "entry_id": "e55ee74d-057b-3c98-9663-b5a78f0ea6e4",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "fossicked"
                    },
                    {
                        "form_id": "715fc307-a4ed-422d-8ed7-ad1134e658b6",
                        "entry_id": "e55ee74d-057b-3c98-9663-b5a78f0ea6e4",
                        "tags": [
                            "past"
                        ],
                        "form": "fossicked"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa8bdcd7-cddb-334a-a197-9179ae3379eb",
                        "entry_id": "e55ee74d-057b-3c98-9663-b5a78f0ea6e4",
                        "glosses": [
                            "To search for something; to rummage."
                        ],
                        "tags": [
                            "Australia",
                            "British",
                            "New-Zealand",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e26c4765-0a4e-4dc0-959d-57c9950174ff",
                                "sense_id": "aa8bdcd7-cddb-334a-a197-9179ae3379eb",
                                "text": "I dined alone and sat after dinner in the smoking-room, for Odell never suggested the library, though I would have given a lot to fossick about that place."
                            },
                            {
                                "example_id": "909ea6da-fd3b-40d3-af8b-0032c248fd77",
                                "sense_id": "aa8bdcd7-cddb-334a-a197-9179ae3379eb",
                                "text": "I could have built a better fire myself but I was too cold when we arrived to fossick around for twigs. I went back to the warm car and let Neil and Henry fossick. Playing the dumb broad is profitable too."
                            },
                            {
                                "example_id": "0f34a1cb-9826-4e06-93ff-7d9c67b48ca0",
                                "sense_id": "aa8bdcd7-cddb-334a-a197-9179ae3379eb",
                                "text": "How strange it was to see men do something beautiful. Something pointless and elegant. There wasn't much room for beauty in the lives of our men. The only exception was the strange Yuri Orlov who carved lovely, old-world toys from stuff he fossicked up from the forest floor."
                            },
                            {
                                "example_id": "7488808b-c1e3-4723-a706-e062450c84e4",
                                "sense_id": "aa8bdcd7-cddb-334a-a197-9179ae3379eb",
                                "text": "He began to fossick again, shifting the bars of soap around until he became aware of something moving behind him."
                            },
                            {
                                "example_id": "ac511394-b215-4b1c-aae4-5e4070a6deb6",
                                "sense_id": "aa8bdcd7-cddb-334a-a197-9179ae3379eb",
                                "text": "Back in the kitchen, and with his mother off fossicking around for place mats, he tried to start the oven a couple of more times, then stood back scraching [sic] his head."
                            }
                        ]
                    },
                    {
                        "sense_id": "00649876-31a4-34fb-90b6-9a46a78b6c6b",
                        "entry_id": "e55ee74d-057b-3c98-9663-b5a78f0ea6e4",
                        "glosses": [
                            "To search for something; to rummage.",
                            "To elicit information; to ferret out."
                        ],
                        "tags": [
                            "Australia",
                            "British",
                            "New-Zealand",
                            "intransitive",
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "b443d518-78e9-49f1-9432-2e03faa93b41",
                                "sense_id": "00649876-31a4-34fb-90b6-9a46a78b6c6b",
                                "text": "[T]he honorable member went to the Railway department, and fossicked about for information, and he found, forsooth, that there had been a little rise in the salary of a son of a member of the House."
                            }
                        ]
                    },
                    {
                        "sense_id": "278e9fa3-eb5a-3a7e-8853-4cdb8c2e508c",
                        "entry_id": "e55ee74d-057b-3c98-9663-b5a78f0ea6e4",
                        "glosses": [
                            "To search for something; to rummage.",
                            "To search for gems, gold, etc., on the surface or in abandoned workings."
                        ],
                        "tags": [
                            "Australia",
                            "British",
                            "New-Zealand",
                            "intransitive",
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "4649671d-1acb-420b-a7fd-3ff7c6158e48",
                                "sense_id": "278e9fa3-eb5a-3a7e-8853-4cdb8c2e508c",
                                "text": "The \"fossicker\" is one who wanders about old diggings, armed with a knife and pan, and who seldom sinks or drives, but \"fossicks\" or searches about the old heaps of dirt, or in the bottoms of deserted shafts and drives, keen-eyed after unobserved gold."
                            },
                            {
                                "example_id": "5a27078a-f6c8-4158-aae9-006863dabbdb",
                                "sense_id": "278e9fa3-eb5a-3a7e-8853-4cdb8c2e508c",
                                "text": "In New South Wales the bureau has been able to dispose of a large contingent of the workless by sending them to fossick for gold on old or deserted goldfields."
                            },
                            {
                                "example_id": "d25fc760-ce10-49c5-80ef-31125a2b4d24",
                                "sense_id": "278e9fa3-eb5a-3a7e-8853-4cdb8c2e508c",
                                "text": "The best way to fossick on old dumps is to either sieve material from untouched areas (you'd do this on the opal fields) or drag down the sides with a rake. You can also find gemstones by closely examining the surface without necessarily disturbing it."
                            },
                            {
                                "example_id": "4378ea7f-7c55-4e3a-8211-85ccbb14693f",
                                "sense_id": "278e9fa3-eb5a-3a7e-8853-4cdb8c2e508c",
                                "text": "In order to fossick you must first obtain a fossicking permit (free). They are available from the tourist offices in Darwin and Alice Springs, or Gemtree […] in the Harts Range. Permission to fossick on freehold land and mineral leases must be obtained from the owner or leaseholder."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3cb1500-44ed-317a-9c4d-3ba4e7255cca",
                        "entry_id": "e55ee74d-057b-3c98-9663-b5a78f0ea6e4",
                        "glosses": [
                            "To be troublesome."
                        ],
                        "tags": [
                            "British",
                            "dialectal",
                            "intransitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96e93c77-9892-495c-943c-e8857c36e5cf",
                        "source_entry_id": "e55ee74d-057b-3c98-9663-b5a78f0ea6e4",
                        "source_sense_description": "to search for something",
                        "target_lang_word": "suchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfaa6678-d7af-32b8-ae2b-2ee9391464fa",
                                        "entry_id": "70e57759-04bf-3131-ad84-65269a20a57e",
                                        "glosses": [
                                            "sich bemühen, etwas oder jemanden zu finden, das oder der verloren oder versteckt ist"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3568e252-68ad-4fd9-ae7c-ea274d1b5106",
                                                "sense_id": "dfaa6678-d7af-32b8-ae2b-2ee9391464fa",
                                                "text": "Ich suche meinen Autoschlüssel."
                                            },
                                            {
                                                "example_id": "20e5f727-858e-4e4a-b93c-443bd3f7088c",
                                                "sense_id": "dfaa6678-d7af-32b8-ae2b-2ee9391464fa",
                                                "text": "Wo warst du? Wir haben dich schon überall gesucht! / Wo warst du? Wir haben schon überall nach dir gesucht!"
                                            },
                                            {
                                                "example_id": "b1961169-5571-4148-bcb7-d7d002e8a18e",
                                                "sense_id": "dfaa6678-d7af-32b8-ae2b-2ee9391464fa",
                                                "text": "Der Täter wird polizeilich gesucht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f81dbdb6-1362-30b2-af83-307c8ef40f6c",
                                        "entry_id": "70e57759-04bf-3131-ad84-65269a20a57e",
                                        "glosses": [
                                            "sich bemühen, etwas oder jemanden zu erlangen oder zu erwerben, das oder den man braucht"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "344d6452-f621-4702-a700-c2759693a323",
                                                "sense_id": "f81dbdb6-1362-30b2-af83-307c8ef40f6c",
                                                "text": "Bittet, so wird Euch gegeben; suchet, so werdet Ihr finden; klopfet an, so wird Euch aufgetan."
                                            },
                                            {
                                                "example_id": "112b276d-5c8c-416c-a670-60a79af35cf6",
                                                "sense_id": "f81dbdb6-1362-30b2-af83-307c8ef40f6c",
                                                "text": "„Wenn die Polizei erfuhr, dass Dragan tot war, würde sie nach dessen Mörder suchen.“"
                                            },
                                            {
                                                "example_id": "00592d86-ad1d-4265-99eb-bfb4ad3bd3eb",
                                                "sense_id": "f81dbdb6-1362-30b2-af83-307c8ef40f6c",
                                                "text": "Ich suche einen Ferienjob."
                                            },
                                            {
                                                "example_id": "47a18cdb-328b-4740-abe8-6a59dd8d2d17",
                                                "sense_id": "f81dbdb6-1362-30b2-af83-307c8ef40f6c",
                                                "text": "Wir suchen eine Wohnung in Hamburg."
                                            },
                                            {
                                                "example_id": "efe82dd0-f413-4a92-8500-b998d5c40286",
                                                "sense_id": "f81dbdb6-1362-30b2-af83-307c8ef40f6c",
                                                "text": "In diesem Geschäft werden Verkäufer gesucht."
                                            },
                                            {
                                                "example_id": "b81d2a8d-4873-4072-a833-10c8c81002b4",
                                                "sense_id": "f81dbdb6-1362-30b2-af83-307c8ef40f6c",
                                                "text": "Seit Jahren sucht er eine Frau."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "497feffe-5309-3858-9090-91ce75d81a80",
                                        "entry_id": "70e57759-04bf-3131-ad84-65269a20a57e",
                                        "glosses": [
                                            "sich bemühen, etwas durch Überlegungen zu finden und/oder zu entdecken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18313ef5-8ec9-4118-a630-d8b9074d56ad",
                                                "sense_id": "497feffe-5309-3858-9090-91ce75d81a80",
                                                "text": "Sie sucht nach Gründen, warum er das getan hat."
                                            },
                                            {
                                                "example_id": "feb0cea9-90af-44c3-bef4-d0255cd64f94",
                                                "sense_id": "497feffe-5309-3858-9090-91ce75d81a80",
                                                "text": "Sie suchen eine Antwort auf diese Frage."
                                            },
                                            {
                                                "example_id": "76c2cfe2-9dba-494a-b6bf-71631f184b7c",
                                                "sense_id": "497feffe-5309-3858-9090-91ce75d81a80",
                                                "text": "Ich suche schon seit einer Stunde nach dem Fehler in der Rechnung, kann ihn aber nicht finden."
                                            },
                                            {
                                                "example_id": "d6afe799-b1e0-4b3e-a078-f448bac9a898",
                                                "sense_id": "497feffe-5309-3858-9090-91ce75d81a80",
                                                "text": "Viele Menschen suchen nach dem Sinn des Lebens."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9771091a-dbe7-360e-a6a2-a4253eea73ee",
                                        "entry_id": "70e57759-04bf-3131-ad84-65269a20a57e",
                                        "glosses": [
                                            "sich bemühen, etwas zu erreichen und/oder zu verwirklichen, was man anstrebt/wünscht"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec9d8a1-4568-4ff8-a1b7-7cf6abe0e006",
                                                "sense_id": "9771091a-dbe7-360e-a6a2-a4253eea73ee",
                                                "text": "„Der Gipfelstürmer sucht das markante Unbekannte. Er hat sportliche Ambitionen.“"
                                            },
                                            {
                                                "example_id": "96ee3bb4-454c-482e-b716-4dbd2a42ab22",
                                                "sense_id": "9771091a-dbe7-360e-a6a2-a4253eea73ee",
                                                "text": "Sucht er Streit?"
                                            },
                                            {
                                                "example_id": "6cc67a38-023d-4182-a7ae-f49113b18a3e",
                                                "sense_id": "9771091a-dbe7-360e-a6a2-a4253eea73ee",
                                                "text": "Sie sucht immer nur ihren Vorteil bei allem, was sie tut."
                                            },
                                            {
                                                "example_id": "a567b75f-00df-4c55-b75a-1dcdec27e16e",
                                                "sense_id": "9771091a-dbe7-360e-a6a2-a4253eea73ee",
                                                "text": "Er suchte Rat bei seinem Vater."
                                            },
                                            {
                                                "example_id": "0aa2729c-0507-4a1c-92b8-7651a24fdec2",
                                                "sense_id": "9771091a-dbe7-360e-a6a2-a4253eea73ee",
                                                "text": "Sie suchen unsere Gesellschaft."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6a9cd663-9f26-3e67-bcce-29b565e481fd",
                                        "entry_id": "70e57759-04bf-3131-ad84-65269a20a57e",
                                        "glosses": [
                                            "etwas erstreben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bc0ddc9-06f8-40fd-b87b-cddae60ff2a2",
                                                "sense_id": "6a9cd663-9f26-3e67-bcce-29b565e481fd",
                                                "text": "Das Jungtier sucht die Wärme seiner Mutter."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "2a725d96-4d85-32fa-9908-f035f6182157",
                                        "entry_id": "70e57759-04bf-3131-ad84-65269a20a57e",
                                        "glosses": [
                                            "etwas versuchen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9265be4-68af-4fc5-a03b-653463eddf13",
                                                "sense_id": "2a725d96-4d85-32fa-9908-f035f6182157",
                                                "text": "Sie suchen dir zu helfen."
                                            },
                                            {
                                                "example_id": "d9f6cd93-4545-4c49-b354-9366abe0f5d9",
                                                "sense_id": "2a725d96-4d85-32fa-9908-f035f6182157",
                                                "text": "Er suchte diese schrecklichen Ereignisse zu vergessen."
                                            },
                                            {
                                                "example_id": "3a19eafe-9caa-4494-bd61-f89efd333673",
                                                "sense_id": "2a725d96-4d85-32fa-9908-f035f6182157",
                                                "text": "„Durch Pferdewetten suchte er ihrer beider Lebensunterhalt zu sichern.“"
                                            },
                                            {
                                                "example_id": "5a54d91a-730f-4c1c-8294-f5050d1dd6bb",
                                                "sense_id": "2a725d96-4d85-32fa-9908-f035f6182157",
                                                "text": "„Mit Amuletten, die um den Hals getragen oder im Hause aufgehängt wurden, suchte man sich vor dem Zugriff der Geister zu schützen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
