{
    "word_family": [
        "suspend",
        "suspension",
        "suspensive",
        "suspenseful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a150fdfc-ea35-3fe7-8cc0-eea88baaeefa",
                    "sense_definition": "A feeling of excited or anxious uncertainty about what may happen, especially in a narrative work.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie built up the <w>suspense</w> so effectively that nobody in the cinema made a sound.",
                            "target_lang_translations": {
                                "de": "Der Film baute die <w>Spannung</w> so wirkungsvoll auf, dass im Kino niemand auch nur einen Laut von sich gab."
                            }
                        },
                        {
                            "text": "Don't keep me in <w>suspense</w>, tell me who won the competition!",
                            "target_lang_translations": {
                                "de": "Spann mich nicht auf die <w>Folter</w>, sag mir, wer den Wettbewerb gewonnen hat!"
                            }
                        }
                    ],
                    "synonyms": [
                        "anticipation",
                        "tension"
                    ],
                    "common_phrases": [
                        "keep in suspense",
                        "build suspense"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Gefühl aufgeregter oder banger Ungewissheit darüber, was geschehen wird, besonders in Büchern oder Filmen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Spannung",
                                "target_lang_sense_clarification": "Dramaturgie, Neugier, Vorfreude"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16ad565e-1e64-3c90-8568-3feeff639628",
                    "sense_definition": "An unpleasant feeling of anxiety, apprehension, or indecision in an uncertain situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waiting for the medical test results kept the entire family in painful <w>suspense</w> for days.",
                            "target_lang_translations": {
                                "de": "Das Warten auf die medizinischen Testergebnisse hielt die ganze Familie tagelang in schmerzhafter <w>Ungewissheit</w>."
                            }
                        },
                        {
                            "text": "She could not bear the terrible <w>suspense</w> of not knowing whether her application had been accepted.",
                            "target_lang_translations": {
                                "de": "Sie ertrug die quälende <w>Ungewissheit</w> nicht, nicht zu wissen, ob ihre Bewerbung angenommen worden war."
                            }
                        }
                    ],
                    "synonyms": [
                        "anxiety",
                        "uncertainty",
                        "apprehension"
                    ],
                    "antonyms": [
                        "certainty"
                    ],
                    "common_phrases": [
                        "terrible suspense",
                        "prolong the suspense"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein unangenehmes Gefühl von Angst, Unruhe oder Ungewissheit in einer unklaren Situation."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ungewissheit",
                                "target_lang_sense_clarification": "quälender Schwebezustand, Unklarheit"
                            },
                            {
                                "target_lang_word": "Anspannung",
                                "target_lang_sense_clarification": "nervöse Belastung, innere Unruhe"
                            },
                            {
                                "target_lang_word": "Spannung",
                                "target_lang_sense_clarification": "emotionaler Zustand des Wartens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61e7d0b5-5a77-3bb1-9deb-ce079a577192",
                    "sense_definition": "A state of temporary cessation, pause, or delay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conflict came to a temporary <w>suspense</w> as both sides gathered to negotiate terms.",
                            "target_lang_translations": {
                                "de": "Der Konflikt kam zu einem vorübergehenden <w>Stillstand</w>, als beide Seiten zusammenkamen, um über Bedingungen zu verhandeln."
                            }
                        },
                        {
                            "text": "During the long winter, there was a quiet <w>suspense</w> of all regular construction work.",
                            "target_lang_translations": {
                                "de": "Während des langen Winters kam es zu einer stillen <w>Aussetzung</w> aller regulären Bauarbeiten."
                            }
                        }
                    ],
                    "synonyms": [
                        "suspension",
                        "cessation",
                        "abeyance"
                    ],
                    "antonyms": [
                        "continuation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English compared to 'suspension'"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Zustand des vorübergehenden Stillstands, Aufschubs oder Ruhens."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Aussetzung",
                                "target_lang_sense_clarification": "vorübergehendes Ruhen"
                            },
                            {
                                "target_lang_word": "Stillstand",
                                "target_lang_sense_clarification": "vorübergehende Unterbrechung"
                            },
                            {
                                "target_lang_word": "Unterbrechung",
                                "target_lang_sense_clarification": "Pause, vorübergehender Halt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38f6fac0-af10-35c8-a645-b612cbe9118c",
                    "sense_definition": "The temporary cessation or extinguishment of a legal right or profit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under property law, the unity of possession caused a total <w>suspense</w> of the rent claim.",
                            "target_lang_translations": {
                                "de": "Nach dem Sachenrecht führte die Vereinigung des Besitzes zu einem vollständigen <w>Ruhen</w> des Mietanspruchs."
                            }
                        },
                        {
                            "text": "The debtor argued that there was a legal <w>suspense</w> of the creditor's enforcement rights.",
                            "target_lang_translations": {
                                "de": "Der Schuldner machte geltend, dass eine rechtliche <w>Hemmung</w> der Vollstreckungsrechte des Gläubigers vorliege."
                            }
                        }
                    ],
                    "synonyms": [
                        "suspension",
                        "abeyance"
                    ],
                    "target_lang_definitions": {
                        "de": "Das vorübergehende Ruhen oder Erlöschen eines Rechtsanspruchs."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ruhen",
                                "target_lang_sense_clarification": "von Rechten oder Ansprüchen"
                            },
                            {
                                "target_lang_word": "Sistierung",
                                "target_lang_sense_clarification": "juristischer Aufschub, Hemmung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "386e27c2-7b95-3de8-85dc-40063ebe97de",
                    "sense_definition": "A deadline or specified completion date.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager assigned the report with a strict <w>suspense</w> of Friday afternoon.",
                            "target_lang_translations": {
                                "de": "Die Führungskraft gab den Bericht mit einer strikten <w>Frist</w> bis Freitagnachmittag auf."
                            }
                        },
                        {
                            "text": "Ensure that all documentation is submitted before the designated <w>suspense</w> expires.",
                            "target_lang_translations": {
                                "de": "Stellen Sie sicher, dass alle Unterlagen eingereicht werden, bevor der festgelegte <w>Termin</w> abläuft."
                            }
                        }
                    ],
                    "synonyms": [
                        "deadline"
                    ],
                    "common_phrases": [
                        "suspense date"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Frist, ein Endtermin oder ein Fälligkeitsdatum."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Frist",
                                "target_lang_sense_clarification": "Zeitspanne oder Termin zur Fertigstellung"
                            },
                            {
                                "target_lang_word": "Termin",
                                "target_lang_sense_clarification": "Fälligkeits- oder Abgabetermin"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73aaee35-2eeb-31a5-b909-714b1bad64ae",
                    "sense_definition": "Expressing, or proceeding from, suspense or uncertainty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He waited in silence with a <w>suspense</w> gaze fixed upon the courtroom doors.",
                            "target_lang_translations": {
                                "de": "Er wartete schweigend mit einem <w>gespannten</w> Blick, der auf die Türen des Gerichtssaals gerichtet war."
                            }
                        },
                        {
                            "text": "The crowd held a <w>suspense</w> breath as the diver prepared to take the leap.",
                            "target_lang_translations": {
                                "de": "Die Menge hielt mit <w>angehaltenem</w> Atem inne, als der Springer sich zum Sprung bereit machte."
                            }
                        }
                    ],
                    "synonyms": [
                        "doubtful",
                        "hesitant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Now archaic or obsolete"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Spannung oder Ungewissheit ausdrückend; erwartungsvoll oder zögerlich."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gespannt",
                                "target_lang_sense_clarification": "voller Erwartung oder Ungewissheit"
                            },
                            {
                                "target_lang_word": "erwartungsvoll",
                                "target_lang_sense_clarification": "in banger Erwartung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab34b790-9a97-303b-8100-545db9acb4b2",
                    "sense_definition": "Held or lifted up; prevented from proceeding.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanical arms remained <w>suspense</w> until the safety sequence was completed.",
                            "target_lang_translations": {
                                "de": "Die mechanischen Arme blieben <w>arretiert</w>, bis die Sicherheitssequenz abgeschlossen war."
                            }
                        },
                        {
                            "text": "He watched the great light remain <w>suspense</w> in the sky above the darkening hills.",
                            "target_lang_translations": {
                                "de": "Er beobachtete, wie das große Licht über den dunkler werdenden Hügeln am Himmel <w>schwebend</w> verharrte."
                            }
                        }
                    ],
                    "synonyms": [
                        "suspended"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Archaic poetic use"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "In der Schwebe oder in der Luft gehalten; angehalten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schwebend",
                                "target_lang_sense_clarification": "in der Luft gehalten"
                            },
                            {
                                "target_lang_word": "angehalten",
                                "target_lang_sense_clarification": "am Weitergehen gehindert"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}