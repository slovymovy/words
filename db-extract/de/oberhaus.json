                    },
                    {
                        "form_id": "2021aa7f-d937-442a-beb4-593425ccc1cb",
                        "entry_id": "c6c35670-01b9-3de0-909e-a0e02eb9b1ff",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Oberhäuser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19328fb9-bbb9-3042-bf60-db2f66b4d272",
                        "entry_id": "c6c35670-01b9-3de0-909e-a0e02eb9b1ff",
                        "glosses": [
                            "eine von zwei Kammern eines Parlaments"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "bc8c40d3-b30c-48a8-9bea-2e40ab478b6c",
                                "sense_id": "19328fb9-bbb9-3042-bf60-db2f66b4d272",
                                "text": "„Aus Sicht des Königs bedeutete das Oberhaus, dass seine Macht nicht einseitig durch das Volk, durch den südniederländischen Adel oder die früheren Regenten des Nordens bedroht wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "445db4de-e0c7-3d32-afe9-5015952f8456",
                        "entry_id": "c6c35670-01b9-3de0-909e-a0e02eb9b1ff",
                        "glosses": [
                            "die erste Kammer britischen Parlaments"
                        ],
                        "tags": [
                            "no-plural",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "c84d8f89-9f16-4ba8-9d9f-bd61b17902e7",
                                "sense_id": "445db4de-e0c7-3d32-afe9-5015952f8456",
                                "text": "„Die Zahl der Mitglieder des Oberhauses, das einst ein Organ mit lediglich 50 Mitgliedern gewesen war, war durch die Großzügigkeit Georgs III. und seiner Nachfolger bei der Einrichtung von Adelstiteln stark angewachsen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0c7892e-8b6b-4692-9093-61d631ca534b",
                        "source_entry_id": "c6c35670-01b9-3de0-909e-a0e02eb9b1ff",
                        "source_sense_id": "19328fb9-bbb9-3042-bf60-db2f66b4d272",
                        "source_sense_description": "Politik, allgemein: eine von zwei Kammern eines Parlaments",
                        "target_lang_word": "upper house",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "upper house",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91f86ffb-d8a1-3b93-8276-9c251151835c",
                                        "entry_id": "a6a41f4e-25a7-39c7-9240-75eb9568bda8",
                                        "glosses": [
                                            "The upper legislative house in a bicameral legislature; usually smaller and having more restricted power than the lower house."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8e1411-8e52-4ef7-9947-889a5a8486da",
                                                "sense_id": "91f86ffb-d8a1-3b93-8276-9c251151835c",
                                                "text": "It was, however, thrown out when it reached the \" Upper House,\" as the Legislative Council is designated."
                                            },
                                            {
                                                "example_id": "6bebb711-bb70-4462-b273-d36011387c86",
                                                "sense_id": "91f86ffb-d8a1-3b93-8276-9c251151835c",
                                                "text": "In March, Thais will vote for the 500-seat lower house of parliament. But the 250-member upper house, or Senate, will be chosen entirely by the military."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d604fc0f-1d73-4bcd-88aa-2e9616cecf34",
                        "source_entry_id": "c6c35670-01b9-3de0-909e-a0e02eb9b1ff",
                        "source_sense_id": "19328fb9-bbb9-3042-bf60-db2f66b4d272",
                        "source_sense_description": "Politik, allgemein: eine von zwei Kammern eines Parlaments",
                        "target_lang_word": "upper chamber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "upper chamber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a5eb936-8743-36fa-9b56-86ca52667c09",
                                        "entry_id": "a718b3e2-8ab5-3cae-9787-277b74fc8539",
                                        "glosses": [
                                            "The upper legislative chamber in a bicameral legislature; usually smaller and having more restricted power than the lower chamber."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39253042-d23a-4812-aa53-9387df835827",
                        "source_entry_id": "c6c35670-01b9-3de0-909e-a0e02eb9b1ff",
                        "source_sense_id": "19328fb9-bbb9-3042-bf60-db2f66b4d272",
                        "source_sense_description": "Politik, allgemein: eine von zwei Kammern eines Parlaments",
                        "target_lang_word": "chambre haute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chambre haute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ecb494e-8758-3ad7-9832-14af1e245bf7",
                                        "entry_id": "e76a55cf-5f6f-35e7-856d-72d4afd19038",
                                        "glosses": [
                                            "L’une des deux assemblées du parlement bicaméral, très souvent sans priorité et élue moins directement par les citoyens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b721ed-cc53-4997-8258-1e4080eae78d",
                                                "sense_id": "3ecb494e-8758-3ad7-9832-14af1e245bf7",
                                                "text": "Chambre haute du Parlement d’Angleterre, est la première des deux chambres qui composent ce parlement. C’est la même qu’on appelle aussi chambre de pairs ou des seigneurs."
                                            },
                                            {
                                                "example_id": "53d05184-8fc8-45f8-942d-1e57d85b223c",
                                                "sense_id": "3ecb494e-8758-3ad7-9832-14af1e245bf7",
                                                "text": "La majorité de cette assemblée législative, nommée par les citoyens actifs seuls, ne voulait pas de l’égalité ; M. le marquis de Lafayette était son dieu, & Lafayette, lui, voulait deux chambres comme en Angleterre : la chambre haute des nobles & des évêques, & la chambre basse des communes."
                                            },
                                            {
                                                "example_id": "76addcde-d4b2-49f7-9d5d-4d57bc769680",
                                                "sense_id": "3ecb494e-8758-3ad7-9832-14af1e245bf7",
                                                "text": "Dans l’Assemblée, elle se traduisait déjà par l’entente des Feuillants et des Noirs pour introduire dans la Constitution (toujours en voie d’élaboration) le système d’une Chambre haute et d’une Chambre basse, emprunté au régime anglais."
                                            },
                                            {
                                                "example_id": "b7560fc2-4093-4f85-8ef5-3c2fbab87400",
                                                "sense_id": "3ecb494e-8758-3ad7-9832-14af1e245bf7",
                                                "text": "Mitch McConnell, le meneur républicain de la chambre haute, est un adversaire redoutable et un fin stratège."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
