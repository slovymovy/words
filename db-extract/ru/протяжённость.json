                                    },
                                    {
                                        "sense_id": "c33262f4-dda2-37b1-8082-f84969b31eea",
                                        "entry_id": "d1b19bc6-8635-3f13-bfe7-e4a39fb82d91",
                                        "glosses": [
                                            "The space, area, volume, point, or abstract location, to which something extends."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98351364-4bed-4017-9f07-17e1d1ee0440",
                                                "sense_id": "c33262f4-dda2-37b1-8082-f84969b31eea",
                                                "text": "I'm a thoroughgoing pragmatist to the fullest extent of the word."
                                            },
                                            {
                                                "example_id": "d271c229-3f4b-40b8-b5d1-98fefd0757fc",
                                                "sense_id": "c33262f4-dda2-37b1-8082-f84969b31eea",
                                                "text": "The extent of his knowledge of the language is a few scattered words."
                                            },
                                            {
                                                "example_id": "876bcfe3-f24a-4fb8-9ad2-f68506ba32ee",
                                                "sense_id": "c33262f4-dda2-37b1-8082-f84969b31eea",
                                                "text": "But when they came where that dead Dragon lay, / Stretcht on the ground in monstrous large extent"
                                            },
                                            {
                                                "example_id": "1a93dc59-7dbe-4063-a5cf-50b3d380faaa",
                                                "sense_id": "c33262f4-dda2-37b1-8082-f84969b31eea",
                                                "text": "The surface of the Balaton and the surrounding marshes is not less than 24 German square miles, or 384 English square miles; its principal feeder is the Szala, but all the water it receives appears inconsiderable relatively to its superficial extent, and the quantity lost in evaporation."
                                            },
                                            {
                                                "example_id": "2d78dc87-9239-4358-86a9-293398e7c68a",
                                                "sense_id": "c33262f4-dda2-37b1-8082-f84969b31eea",
                                                "text": "[S]he [Edwina, mother of Tennessee Williams] was indeed Amanda [Wingfield, character in Williams' play The Glass Menagerie] in the flesh: a doughty chatterbox from Ohio who adopted the manner of a Southern belle and eschewed both drink and sex to the greatest extent possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1563910f-c2f9-3648-b310-a75486f0e3ae",
                                        "entry_id": "d1b19bc6-8635-3f13-bfe7-e4a39fb82d91",
                                        "glosses": [
                                            "A contiguous area of storage in a file system."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "082628f7-7f73-4b61-b028-af999eb3c5a2",
                                                "sense_id": "1563910f-c2f9-3648-b310-a75486f0e3ae",
                                                "text": "Each extent contains one or more contiguous clusters. The file system describes each extent with two numbers: the number of the first cluster in the extent, and the number of clusters in the extent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "131958cc-383f-302f-8a06-7d95792c86e3",
                                        "entry_id": "d1b19bc6-8635-3f13-bfe7-e4a39fb82d91",
                                        "glosses": [
                                            "The valuation of property."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fdcb423-784e-328f-9027-8b4aa02dda8f",
                                        "entry_id": "d1b19bc6-8635-3f13-bfe7-e4a39fb82d91",
                                        "glosses": [
                                            "A writ directing the sheriff to seize the property of a debtor, for the recovery of debts of record due to the Crown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7f97f63-4f4e-4842-9298-c99d1f481d51",
                                                "sense_id": "9fdcb423-784e-328f-9027-8b4aa02dda8f",
                                                "text": "Well, push him out of doors;\nAnd let my officers of such a nature\nMake an extent upon his house and lands.\nDo this expediently, and turn him going."
                                            }
                                        ]
                                    }
                                ]
                            },
