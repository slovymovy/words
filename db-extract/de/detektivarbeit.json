                        "examples": [
                            {
                                "example_id": "7250b6e0-987d-4973-94e4-1b5761a8792d",
                                "sense_id": "a2c93214-8137-3aa0-bc4c-7c54833648a1",
                                "text": "„Er nahm an, Wellington wolle mit einem seiner anderen Klienten reden - warum er das geglaubt hat, weiß er nicht. Schlechte Detektivarbeit, schätzt er.“"
                            },
                            {
                                "example_id": "2721aaac-d883-408c-9c10-fe6c2dfc3aa1",
                                "sense_id": "a2c93214-8137-3aa0-bc4c-7c54833648a1",
                                "text": "„So funktioniert Detektivarbeit - Detail für Detail, das eine brachte uns weiter, das andere führte uns in die Irre -, aber ich hatte mittlerweile kapiert, dass es keine überflüssigen Details gab.“"
                            }
                        ],
