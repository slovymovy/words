{
    "word_family": [
        "humiliate",
        "humiliating",
        "humiliated"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d364b87-5654-3620-8f24-6d41ce22117f",
                    "sense_definition": "The act of causing someone to feel ashamed or lose their dignity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humiliation_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public <w>humiliation</w> of the politician destroyed his career.",
                            "target_lang_translations": {
                                "zh": "那位政客遭受的公开<w>羞辱</w>毁了他的职业生涯。"
                            }
                        },
                        {
                            "text": "He suffered the <w>humiliation</w> of being fired in front of his colleagues.",
                            "target_lang_translations": {
                                "zh": "他忍受了在同事面前被解雇的<w>屈辱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mortification",
                        "shame"
                    ],
                    "antonyms": [
                        "honor"
                    ],
                    "common_phrases": [
                        "public humiliation"
                    ],
                    "target_lang_definitions": {
                        "zh": "使人感到羞耻或丧失尊严的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "羞辱",
                                "target_lang_sense_clarification": "指对他人的侮辱或使人蒙羞的行为。"
                            },
                            {
                                "target_lang_word": "耻辱",
                                "target_lang_sense_clarification": "指导致名誉受损或尊严丧失的事件。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d66dccfe-360a-3136-86ab-af1d84ab04c3",
                    "sense_definition": "The feeling of being ashamed or losing one's dignity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humiliation_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat in <w>humiliation</w> after her mistake was revealed.",
                            "target_lang_translations": {
                                "zh": "错误被揭露后，她坐在那里感到十分<w>羞愧</w>。"
                            }
                        },
                        {
                            "text": "He felt a deep sense of <w>humiliation</w> when he realized his error.",
                            "target_lang_translations": {
                                "zh": "当他意识到自己的错误时，感到了一种深深的<w>屈辱</w>感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "embarrassment",
                        "shame"
                    ],
                    "antonyms": [
                        "exaltation"
                    ],
                    "target_lang_definitions": {
                        "zh": "感到羞耻或丧失尊严的状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "屈辱",
                                "target_lang_sense_clarification": "指内心深处感受到的羞愧与受辱感。"
                            },
                            {
                                "target_lang_word": "羞愧",
                                "target_lang_sense_clarification": "指因做错事或丢脸而感到的羞耻。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}