                            "trait_type": "archaic",
                            "comment": "Rarely used transitively in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand treiteren of bespotten met sarcastische opmerkingen."
                    },
                    "translations": {
