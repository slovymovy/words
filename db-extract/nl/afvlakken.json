        "nl-extract.jsonl": [
            {
                "entry_id": "f4fe6aa9-5419-32c1-9cd4-d7fb398a084c",
                "word": "afvlakken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "64aeded1-4252-342b-8c8e-22ad35af5e0c",
                        "entry_id": "f4fe6aa9-5419-32c1-9cd4-d7fb398a084c",
                        "glosses": [
                            "langzamer gaan van veranderingen verminderen zodat een grafische voorstelling van de verandering horizontaler wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "687059a2-67e9-4aff-b78b-2ab48cde5f84",
                                "sense_id": "64aeded1-4252-342b-8c8e-22ad35af5e0c",
                                "text": "In Ierland wordt een prijsstijging voorspeld van gemiddeld 7 procent, terwijl de Duitse huizenprijzen met 6 procent zullen stijgen. Dat komt onder meer door aanhoudend economisch herstel, toenemende werkgelegenheid en gunstige hypotheekrentes. De slechtste huizenmarkt bevindt zich in Italië, waar S&P geen groei van de prijzen voorspelt. De groei in Nederland zal wel wat gaan afvlakken, aldus S&P, door bijvoorbeeld een hogere inflatie. In 2018 zullen de Nederlandse huizenprijzen volgens de kredietbeoordelaar daardoor gemiddeld met zo’n 3 procent toenemen. (ANP)"
                            }
                        ]
                    },
                    {
                        "sense_id": "f29a9afb-5121-3062-922c-797cd240d2eb",
                        "entry_id": "f4fe6aa9-5419-32c1-9cd4-d7fb398a084c",
                        "glosses": [
                            "iets wat bol of oneffen is vlak maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e5350c-01f9-4a41-b2ed-a126c21d6aed",
                                "sense_id": "f29a9afb-5121-3062-922c-797cd240d2eb",
                                "text": "Toen de drie met de kunstvoorwerpen uit de monoliet kwamen, werden ze begroet door de aanblik van een afvlakkende Aarde."
                            }
                        ]
                    },
                    {
                        "sense_id": "983ca96c-69d2-381f-9816-38300bccf847",
                        "entry_id": "f4fe6aa9-5419-32c1-9cd4-d7fb398a084c",
                        "glosses": [
                            "grote schommelingen dempen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5902dac2-fb31-3771-be8d-7ce80896f024",
                        "entry_id": "f4fe6aa9-5419-32c1-9cd4-d7fb398a084c",
                        "glosses": [
                            "minder vitaal en levendig worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e182f9e-f55d-413a-a81f-d2d196a1e68a",
                                "sense_id": "5902dac2-fb31-3771-be8d-7ce80896f024",
                                "text": "Het is een leugen die je jezelf hebt verteld waarmee je datgene afvlakt wat pijn doet."
                            }
                        ]
                    }
