                "senses": [
                    {
                        "sense_id": "d95c80e6-788a-3e68-85ea-35df4b3b8897",
                        "entry_id": "43dbb800-f0d2-38ff-af00-04ee63eaec56",
                        "glosses": [
                            "Einfassung (äußere Abgrenzung) bei Öffnungen an Deck von Booten oder Schiffen, die zum Schutz gegen eindringendes Wasser dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde91e82-3483-464e-b328-588d33f401f2",
                                "sense_id": "d95c80e6-788a-3e68-85ea-35df4b3b8897",
                                "text": "„Alle offenen Boote haben einen Süllrand. Das sind die Leisten, die den oberen Abschluss des Rumpfs bilden und an denen häufig die Sitze und die Duchten (Querstreben/‘Thwarts‘) befestigt sind.“"
                            },
                            {
                                "example_id": "56bb6ebc-d9f2-494b-b727-7ab840097ae0",
                                "sense_id": "d95c80e6-788a-3e68-85ea-35df4b3b8897",
                                "text": "„Üblicherweise beginnt der Aufbau mit dem Anfertigen eines Süllrandes um die Zugangsöffnung im Deck. Dieser Süllrand verhindert, dass Wasser vom Deck ins Bootsinnere läuft.“"
                            },
                            {
                                "example_id": "9bdca9a4-6eca-40b7-acee-a8acf5425a50",
                                "sense_id": "d95c80e6-788a-3e68-85ea-35df4b3b8897",
                                "text": "„Wenn beim Modell keine Gewichtsprobleme auftreten, kann man mit kleinen Gewichten die Lukendeckel oder Aufbauten in die Süllränder und Sitze ziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
