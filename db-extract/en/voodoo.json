                "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                "word": "voodoo",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7e52b817-52f7-44ed-a538-481dae87e53b",
                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                        "tags": [
                            "plural"
                        ],
                        "form": "voodoos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3aa7a4db-94f3-3bdf-8487-e937cdc26474",
                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                        "glosses": [
                            "Any of a group of related religious practices found chiefly in and around the Caribbean, particularly in Haiti and Louisiana."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "59b0eccc-7005-4d99-9b13-bd3b7101e0e5",
                                "sense_id": "3aa7a4db-94f3-3bdf-8487-e937cdc26474",
                                "text": "You cannot understand Haitian Vodou as it is practised today without first knowing something about the culture from which it sprang, and the ways history has shaped religion, and vice versa."
                            }
                        ]
                    },
                    {
                        "sense_id": "69ba231a-200b-3492-836e-a64c2fcd52e8",
                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                        "glosses": [
                            "The spiritual beliefs of the Ewe/Fon of West Africa, practiced chiefly in Benin and in the south of Togo."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "26b47cbc-aa14-35dc-8c70-cd2aecd949d0",
                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                        "glosses": [
                            "Any sort of magical or irrational approach to a problem."
                        ],
                        "tags": [
                            "countable",
                            "derogatory",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cdc47e8a-5d2d-46ed-a5df-2723fc9ede2f",
                                "sense_id": "26b47cbc-aa14-35dc-8c70-cd2aecd949d0",
                                "text": "I want a real explanation, not this statistical voodoo."
                            }
                        ]
                    },
                    {
                        "sense_id": "61d9d31e-e120-3084-97fa-c70d0fcde5dc",
                        "entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
                        "glosses": [
                            "One who practices voodoo; a native sorcerer."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1fa26685-3ad7-4f4a-a4bc-975dfb0538e0",
                                "sense_id": "61d9d31e-e120-3084-97fa-c70d0fcde5dc",
                                "text": "So a reporter of the Boston Herald (U.S.) has 'interviewed' a few local Voodoos. He has seen a dance round a boiling pot, seen some tomfoolery with spiders, and heard a lot of superstitious stories."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7666d667-4415-4e1b-a802-e3eb9631192e",
                        "source_entry_id": "a62a4213-856d-3273-b7f7-a983bd356588",
