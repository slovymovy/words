                                        "examples": [
                                            {
                                                "example_id": "e95b9cfc-f7b6-4148-b2d6-11bdfd63b759",
                                                "sense_id": "c2909566-d038-30c1-ada1-fc1fb73e372d",
                                                "text": "The nose's comic potency is enhanced by the Indo-European rootedness of its own name, securing it a pivotal role in translingual games."
                                            },
                                            {
                                                "example_id": "c0daa2a1-c9e5-4449-92e6-51c9b4e391b1",
                                                "sense_id": "c2909566-d038-30c1-ada1-fc1fb73e372d",
                                                "text": "You must establish that a translingual approach is rhetorically justified, critically relevant, and communicates ideas with clarity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01ce24b4-1a93-3a76-8a82-1fe069463076",
                                        "entry_id": "1dcbab76-0a78-378e-a8d9-46e7e820afa0",
                                        "glosses": [
                                            "Having the same meaning in many languages."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32440930-d148-495b-8f93-d406e35825b0",
