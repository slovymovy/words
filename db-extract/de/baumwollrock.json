                "senses": [
                    {
                        "sense_id": "a7a21a6f-a07f-3298-916d-9a43e373b941",
                        "entry_id": "35bcc13d-be60-31ec-a9e2-0cc2378ff99b",
                        "glosses": [
                            "Rock aus Baumwolle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8339b8-b2cd-40cc-9938-8136c3fd9116",
                                "sense_id": "a7a21a6f-a07f-3298-916d-9a43e373b941",
                                "text": "„Ich strample, um mit Marlas bedrucktem indischem Baumwollrock im Arm von dem verschmierten Boden hochzukommen, und Marla, in ihrem Höschen, den Keilabsätzen und der Folklorebluse, reißt das Tiefkühlfach des Kühlschranks auf, und da drinnen ist kein Collagenvorrat.“"
                            },
                            {
                                "example_id": "c8dd0afa-7281-42f6-a162-ab7a58718698",
                                "sense_id": "a7a21a6f-a07f-3298-916d-9a43e373b941",
                                "text": "„Sie hatte eine pfirsichfarbene Seidenbluse und einen weißen Baumwollrock getragen, doch von beidem waren nur noch kaum wiederzuerkennende Fetzen übrig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
