                    {
                        "sense_id": "d3360e57-ac50-3d2d-9f9f-fe019859586c",
                        "entry_id": "331c2393-cdea-3176-ad83-d4d643014a73",
                        "glosses": [
                            "To change to a monophthong (as by removing a vowel)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c9cf550d-6ab5-40db-b560-01bc61b5a5af",
                                "sense_id": "d3360e57-ac50-3d2d-9f9f-fe019859586c",
                                "text": "Inherited -au- was monophthongized to -a- in Sardinian. These forms must therefore go back to […] *aCurri, with an elided consonant."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c578fa8-34aa-3fc6-aba0-36c6ab47fd83",
                        "entry_id": "331c2393-cdea-3176-ad83-d4d643014a73",
                        "glosses": [
                            "To become a monophthong."
                        ],
