                ],
                "senses": [
                    {
                        "sense_id": "95245204-be89-347d-a0a9-1191d6fc87af",
                        "entry_id": "830fb53e-7937-334f-ad52-c55d29587ee0",
                        "glosses": [
                            "den Ausgang eines Wettrennens wesentlich beeinflussend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cfa6ba4-3955-4490-8ad5-57e764ea4693",
                                "sense_id": "95245204-be89-347d-a0a9-1191d6fc87af",
                                "text": "„Der Reifen-Poker wird vermutlich auch in Malaysia rennentscheidend.“"
                            },
                            {
                                "example_id": "5a17a63a-f093-44b1-a758-3d79c97430e5",
                                "sense_id": "95245204-be89-347d-a0a9-1191d6fc87af",
                                "text": "„Rennentscheidend könnten am Freitag (18.45 Uhr, live ORF eins) angesichts des Neuschnees die Startnummern sein.“"
                            },
                            {
                                "example_id": "204854e1-4823-407d-be0b-89b0debc2c5d",
                                "sense_id": "95245204-be89-347d-a0a9-1191d6fc87af",
                                "text": "„Vor dem Start erkundigte sich Hamilton bei seinem Renningenieur nach dem Wind, der sich in Barcelona oft rennentscheidend auswirkt.“"
                            },
                            {
                                "example_id": "08d63ad7-15cb-4707-8c41-83f7b2db5a89",
                                "sense_id": "95245204-be89-347d-a0a9-1191d6fc87af",
                                "text": "„Eine Plastiktüte sieht harmlos aus, kann aber, wenn sie sich um das Schwert des Bootes wickelt, rennentscheidend sein.“"
                            },
                            {
                                "example_id": "997e55c5-a9b6-49b1-b993-95d0f900d56b",
                                "sense_id": "95245204-be89-347d-a0a9-1191d6fc87af",
                                "text": "„Dieser schnelle Stopp von Hamilton war rennentscheidend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
