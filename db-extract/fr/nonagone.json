                        "examples": [
                            {
                                "example_id": "1b1708f6-87d5-48de-868f-79ae1b501361",
                                "sense_id": "a1582214-25bb-39f5-a0e1-a2a1f87a1b3b",
                                "text": "NONAGONE, s. m. (Gramm.) figure de 9 angles & de 9 côtés. On dit plus communément ennéagone. Voyez ce mot."
                            },
                            {
                                "example_id": "53125150-5db6-4a3a-b768-3c170e3ea12c",
                                "sense_id": "a1582214-25bb-39f5-a0e1-a2a1f87a1b3b",
                                "text": "Un ennéagone, parfois appelé « nonagone », est un polygone à neuf côtés, de même longueur quand il est régulier."
                            }
                        ]
                    }
