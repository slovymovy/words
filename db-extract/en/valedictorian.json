    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2300bb3c-8986-3894-8835-cd632a1a85b9",
                "word": "valedictorian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2b63fafa-9028-41a4-8dba-0ebcd11143cd",
                        "entry_id": "2300bb3c-8986-3894-8835-cd632a1a85b9",
                        "tags": [
                            "plural"
                        ],
                        "form": "valedictorians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee42bcd8-6ca4-30a2-a131-2cd388176f99",
                        "entry_id": "2300bb3c-8986-3894-8835-cd632a1a85b9",
                        "glosses": [
                            "The individual in a graduating class who delivers the farewell or valedictory address, often the person who graduates with the highest grades."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "a664afd7-25f5-4f0b-b8fd-57c21ee2373b",
                                "sense_id": "ee42bcd8-6ca4-30a2-a131-2cd388176f99",
                                "text": "Our oldest son was valedictorian of his high school class and went to a top university. But right about this time two years ago, our second son told us he wasn’t interested in college."
                            },
                            {
                                "example_id": "d8e79890-5695-4214-8926-b55cde0cc0d7",
                                "sense_id": "ee42bcd8-6ca4-30a2-a131-2cd388176f99",
                                "text": "At first, it seemed a joyous occasion. There was an audible gasp in the room, then boisterous cheering and applause when the announcement was made: Ikeria Washington and Layla Temple had been named 2021 valedictorian and salutatorian for West Point High School."
                            }
                        ]
                    },
                    {
                        "sense_id": "77a5adcf-a387-378f-93e0-338e95baa354",
                        "entry_id": "2300bb3c-8986-3894-8835-cd632a1a85b9",
                        "glosses": [
                            "The individual in a graduating class who graduates with the highest grades."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "532666ad-bdfe-4b5a-b24f-7bb1513f9250",
                                "sense_id": "77a5adcf-a387-378f-93e0-338e95baa354",
                                "text": "A social media firestorm erupted last week after two Texas high school valedictorians revealed that they were undocumented immigrants heading to well-respected U.S. colleges with financial aid."
                            }
                        ]
                    }
                ],
                "translations": [
