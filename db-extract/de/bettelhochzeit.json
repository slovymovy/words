                "senses": [
                    {
                        "sense_id": "933afa0e-f474-37f9-99eb-eea936c8f63e",
                        "entry_id": "ec863c41-23b6-34ec-bd0a-f1519439d901",
                        "glosses": [
                            "närrische Trauungszeremonie eines kurios aussehendes Brautpaars während der Faschingszeit, meist gefolgt von einem Hochzeitszug und/oder einer Feier"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "ce7629fd-40d9-4fe2-8589-0857047ac941",
                                "sense_id": "933afa0e-f474-37f9-99eb-eea936c8f63e",
                                "text": "„Wenn Frauen mit aufgeklebten Bärten und Hut Männer in Dirndl und Perücke zum Tanz auffordern, dann ist Bettelhochzeit.“"
                            },
                            {
                                "example_id": "03d3a7d1-a443-44c2-85ca-dff3421e4244",
                                "sense_id": "933afa0e-f474-37f9-99eb-eea936c8f63e",
                                "text": "„Einmal im Vierteljahrhundert feiert die kleine Gemeinde Au bei Bad Feilnbach ihre berühmte Bettelhochzeit.“"
                            },
                            {
                                "example_id": "d56b2478-cf77-4d41-b786-e5b891aebb37",
                                "sense_id": "933afa0e-f474-37f9-99eb-eea936c8f63e",
                                "text": "„Auf der Bettelhochzeit bei Emmering herrschte am vergangenen Samstagabend eine ausgelassene Partystimmung.“"
                            },
                            {
                                "example_id": "bb07e409-ac41-426c-bfeb-64ae17507587",
                                "sense_id": "933afa0e-f474-37f9-99eb-eea936c8f63e",
                                "text": "„Zum dritten Mal findet in Dietramszell am kommenden Samstag eine Bettelhochzeit statt.“"
                            },
                            {
                                "example_id": "923845ff-b508-4029-8231-99da5f47362c",
                                "sense_id": "933afa0e-f474-37f9-99eb-eea936c8f63e",
                                "text": "„Gerade in den letzten Jahren wurden die Bettelhochzeiten oftmals von der Landjugend wiederentdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
