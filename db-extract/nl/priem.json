                "translations": [
                    {
                        "translation_id": "25961453-3363-41ff-8a43-b491aa90f6fe",
                        "source_entry_id": "df4151b7-e570-3b61-93f1-0c6e32585b21",
                        "source_sense_id": "c0ff3c25-fd68-3cbe-925c-bca0c1aa4710",
                        "source_sense_description": "priem",
                        "target_lang_word": "Ahle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ahle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d58c7e7-901d-3f4c-a8ed-d07d3ce23a55",
                                        "entry_id": "7924b5eb-a6b3-369f-8fe1-d244ffb7af78",
                                        "glosses": [
                                            "Werkzeug, mit dem man Löcher in derbe, feste Materialien, zum Beispiel Leder, machen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f589b814-2aef-4ef6-808f-c395438a60a8",
                                                "sense_id": "8d58c7e7-901d-3f4c-a8ed-d07d3ce23a55",
                                                "text": "Ein Schuhmacher benutzt eine Ahle, um Löcher für die Naht in das Leder zu machen."
                                            },
                                            {
                                                "example_id": "4a13f145-6c98-4409-ac9d-15e02da55059",
                                                "sense_id": "8d58c7e7-901d-3f4c-a8ed-d07d3ce23a55",
                                                "text": "Neben Schuhmachern benutzen auch Polsterer, Sattler und viele andere Handwerker eine Ahle."
                                            },
                                            {
                                                "example_id": "83a378c8-39f0-47f0-ab2d-33b1c9e84730",
                                                "sense_id": "8d58c7e7-901d-3f4c-a8ed-d07d3ce23a55",
                                                "text": "„Sie lernte mit der Ahle aus zugeschabter Hirschgeweihsprosse und Garn aus gepechter Hirschsehne Wildleder zu Wams und Schuh zu nähen und sogar zierlich farbig auszusteppen, den Mokassin mit Schoppenpelz auszufüttern, Linseytuch aus Flachs und Einschlag von Büffelwolle zu weben, Kerzen zu ziehen und Wildbret einzupökeln – Frauenkünste des Urwalds, die auch den andern Müttern von Worms gezeigt, doch bald versäumt und verschmäht worden.“"
                                            },
                                            {
                                                "example_id": "508261e1-2cf8-4c56-a801-27457d3fcc1e",
                                                "sense_id": "8d58c7e7-901d-3f4c-a8ed-d07d3ce23a55",
                                                "text": "„Ich sehe am Boden die Ahle und reime mir zusammen, was passiert ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "839217b2-834f-4c64-9589-0ffcc74b171e",
                        "source_entry_id": "df4151b7-e570-3b61-93f1-0c6e32585b21",
                        "source_sense_id": "c0ff3c25-fd68-3cbe-925c-bca0c1aa4710",
