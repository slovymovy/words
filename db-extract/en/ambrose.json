                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fcf2a9b-6b21-4f01-b522-cfe55f4ff219",
                                                "sense_id": "ae581dc0-32fa-3c01-bd90-33d41eabe6ae",
                                                "text": "Frau Ambros ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "9b00d804-755c-4315-94e9-43dd80d0219c",
                                                "sense_id": "ae581dc0-32fa-3c01-bd90-33d41eabe6ae",
                                                "text": "Herr Ambros wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "c6bdfc16-a75b-45a1-b129-02c30cc59695",
                                                "sense_id": "ae581dc0-32fa-3c01-bd90-33d41eabe6ae",
                                                "text": "Die Ambrosens fliegen heute nach Wien."
                                            },
                                            {
                                                "example_id": "9268f952-631f-438e-894d-3fa52d8945f4",
                                                "sense_id": "ae581dc0-32fa-3c01-bd90-33d41eabe6ae",
                                                "text": "Der Ambros trägt nie die Pullover, die die Ambros ihm strickt."
                                            },
                                            {
                                                "example_id": "1b382d6d-0f34-4805-9394-37be6cafdb08",
                                                "sense_id": "ae581dc0-32fa-3c01-bd90-33d41eabe6ae",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ambros kommt, geht der Herr Ambros.“"
                                            },
                                            {
                                                "example_id": "3cfc7716-d1e4-4306-aa65-95165726bd70",
                                                "sense_id": "ae581dc0-32fa-3c01-bd90-33d41eabe6ae",
                                                "text": "Ambros kommt und geht."
                                            },
                                            {
                                                "example_id": "8c54e5bf-9b6c-4e97-a06d-7d96386547ba",
                                                "sense_id": "ae581dc0-32fa-3c01-bd90-33d41eabe6ae",
                                                "text": "Ambrosens kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
