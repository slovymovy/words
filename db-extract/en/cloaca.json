                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2fbfc4a-f77d-4017-92df-07897b1bba22",
                                                "sense_id": "79ff3340-e6d2-329a-8baf-72edd5da24bc",
                                                "text": "Ke katakombám řadí se kloaky, jimiž odvádějí se z města nepotřebné vody."
                                            }
                                        ]
