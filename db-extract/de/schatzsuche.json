                "senses": [
                    {
                        "sense_id": "988e499b-df83-3521-a62e-aa28a85b05b3",
                        "entry_id": "e996307d-2af7-3929-84d3-0fd917edea7b",
                        "glosses": [
                            "die Suche nach Schätzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53daa9f1-ad4e-4ed3-8cc7-f225ca0ac5d4",
                                "sense_id": "988e499b-df83-3521-a62e-aa28a85b05b3",
                                "text": "„Eines der Probleme des Kulturgut-Schutzes sind die Plünderungen antiker Stätten weltweit, die häufig als Schatzsuche bagatellisiert und als Kavaliersdelikt wahrgenommen werden.“"
                            },
                            {
                                "example_id": "46ae7958-33d0-4f93-8191-19dd7abb67c4",
                                "sense_id": "988e499b-df83-3521-a62e-aa28a85b05b3",
                                "text": "„Martin beteiligte sich an dieser Art Schatzsuche nicht.“"
                            },
                            {
                                "example_id": "b88f4e80-d7d2-4d23-bc94-9befd063e988",
                                "sense_id": "988e499b-df83-3521-a62e-aa28a85b05b3",
                                "text": "„Anderen gegenüber ist es schwer zu erklären, aber Amalias und mein Leben, bestehend aus Schatzsuchen, Internetauktionen, Schnäppchenjagden und langen Stunden in der Werkstatt mit der Arbeit an alten Büchern, Karten, Drucken und Handschriften war für mich gewohnt komfortabel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
