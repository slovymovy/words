            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdc7f11a-55b3-3aa4-9653-baa19fec5687",
                    "sense_definition": "dać komuś pieniądze lub jakąś rzecz do tymczasowego użytku z oczekiwaniem zwrotu",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pożyczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy możesz <w>pożyczyć</w> mi sto złotych do jutra?",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>одолжить</w> мне сто злотых до завтра?"
                            }
                        },
                        {
                            "text": "Brat <w>pożyczył</w> koledze swój nowy rower na weekend.",
                            "target_lang_translations": {
                                "ru": "Брат <w>одолжил</w> другу свой новый велосипед на выходные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pożyczyć komuś pieniądze",
                        "pożyczyć koledze książkę"
                    ],
                    "target_lang_definitions": {
                        "ru": "дать кому-либо деньги или вещь во временное пользование с ожиданием возврата"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одолжить",
                                "target_lang_sense_clarification": "дать кому-то во временное пользование"
                            },
                            {
                                "target_lang_word": "дать в долг",
                                "target_lang_sense_clarification": "предоставить деньги или вещи взаймы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edc40005-9120-3581-a75a-bf5ff1a3468f",
                    "sense_definition": "wziąć coś od kogoś na pewien czas z zamiarem oddania",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pożyczanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <w>pożyczyć</w> od sąsiada drabinę, żeby pomalować sufit.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>взять</w> у соседа лестницу, чтобы покрасить потолок."
                            }
                        },
                        {
                            "text": "Zwróciłem już wszystkie <w>pożyczone</w> z biblioteki książki.",
                            "target_lang_translations": {
                                "ru": "Я уже вернул все <w>взятые</w> из библиотеки книги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pożyczyć od kogoś pieniądze",
                        "pożyczyć z biblioteki"
                    ],
                    "target_lang_definitions": {
                        "ru": "взять что-либо у кого-либо на время с намерением вернуть"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взять в долг",
                                "target_lang_sense_clarification": "получить деньги или вещи с обязательством вернуть"
                            },
                            {
                                "target_lang_word": "занять",
                                "target_lang_sense_clarification": "взять взаймы (обычно о деньгах)"
                            },
                            {
                                "target_lang_word": "одолжить",
                                "target_lang_sense_clarification": "взять у кого-то во временное пользование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45b57170-7db8-3877-a953-aaf9bdee6fff",
                    "sense_definition": "przywłaszczyć sobie czyjąś własność bez zgody; ukraść",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ktoś <w>pożyczył</w> sobie mój rower i zapomniał go oddać.",
                            "target_lang_translations": {
                                "ru": "Кто-то <w>позаимствовал</w> мой велосипед и забыл его вернуть."
                            }
                        },
                        {
                            "text": "Złodzieje <w>pożyczyli</w> w nocy sprzęt z placu budowy.",
                            "target_lang_translations": {
                                "ru": "Воры ночью <w>увели</w> оборудование со стройплощадки."
                            }
