                ],
                "senses": [
                    {
                        "sense_id": "d4a4ad31-a4e8-3e2e-bb5c-5a341b74b5e8",
                        "entry_id": "abc16cd3-4d99-39fe-8046-5d522312e0d6",
                        "glosses": [
                            "Piquer."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ab60d98a-0a56-4a40-b1d5-118ee5062fdf",
                                "sense_id": "d4a4ad31-a4e8-3e2e-bb5c-5a341b74b5e8",
                                "text": "Tous sont espoinçonnez d’une mesme fureur."
                            },
                            {
                                "example_id": "6a1a28d8-d689-4a37-af86-e427c58dafe5",
                                "sense_id": "d4a4ad31-a4e8-3e2e-bb5c-5a341b74b5e8",
                                "text": "Jadis un loup, dit-il, que la faim époinçonne."
                            },
                            {
                                "example_id": "64a3afaa-a6bb-4e99-9d94-850fc76eadf7",
                                "sense_id": "d4a4ad31-a4e8-3e2e-bb5c-5a341b74b5e8",
                                "text": "Ce complot, le complot belge, je le vois ourdi dès le premier jour de notre indépendance, ourdi par des hommes travaillés de dépit et époinçonnés de haine."
                            },
                            {
                                "example_id": "c6348da2-7ecd-4049-b86f-2183e5b42df0",
                                "sense_id": "d4a4ad31-a4e8-3e2e-bb5c-5a341b74b5e8",
                                "text": "Ces derniers mots versèrent un léger baume sur le cœur de Frédéric, que la sensation d’être pris en faute avait époinçonné."
                            }
                        ]
                    }
