                "forms": [
                    {
                        "form_id": "42beacd7-28b4-43c0-82de-09de2f797e9f",
                        "entry_id": "fbb61878-be61-3802-8089-8f6da96cf977",
                        "tags": [
                            "plural"
                        ],
                        "form": "latérites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ce72339-15a6-3183-862e-85f7c640f29c",
                        "entry_id": "fbb61878-be61-3802-8089-8f6da96cf977",
                        "glosses": [
                            "Roche rouge, jaspée, ressemblant à de la brique, composée d’une roche trappéenne altérée et d’oxyde de fer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ab7dee-fb4b-4d0b-8c59-89b4563fbccb",
                                "sense_id": "6ce72339-15a6-3183-862e-85f7c640f29c",
                                "text": "[…] ; l'air est chaud et humide, la foule animée, la latérite omniprésente rouge passé, même si les bords des flaques d'eau du dernier orage donnent l'impression de lèvres de blessure en cours de cicatrisation."
                            },
                            {
                                "example_id": "01b8eee4-e0ff-41ba-9475-7d70fa07c84d",
                                "sense_id": "6ce72339-15a6-3183-862e-85f7c640f29c",
                                "text": "Le taxi est arrivé sur un promontoire en latérite qui surplombait la rivière. — (Gaël Faye, Petit Pays, Grasset, 2016, page 207)"
                            },
                            {
                                "example_id": "a4ccc7a4-0cfd-4fcb-9fe4-379799165d2a",
                                "sense_id": "6ce72339-15a6-3183-862e-85f7c640f29c",
                                "text": "La chaleur abrutissante, la poussière rouge de la latérite, les silences de plomb et les bruits assourdissants, les couleurs exsangues des paysages, le chaos, le feu et la mort semblent être ses moyens d’autodéfense."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "825c4dca-add7-4679-b6f1-23c70d020aab",
                        "source_entry_id": "fbb61878-be61-3802-8089-8f6da96cf977",
                        "source_sense_id": "6ce72339-15a6-3183-862e-85f7c640f29c",
                        "target_lang_word": "laterite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laterite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85c786d5-99c4-3644-93a3-998326f6f459",
                                        "entry_id": "a4019d27-1d9c-37ac-80f6-bda163ab2af2",
                                        "glosses": [
                                            "A red hard or gravel-like soil or subsoil formed in the tropics that has been leached of soluble minerals leaving insoluble iron and aluminium oxides and hydroxides; used to make bricks and roads."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8146ff14-6907-4dee-bad6-ea2700a1888e",
                                                "sense_id": "85c786d5-99c4-3644-93a3-998326f6f459",
                                                "text": "Although the track is ballasted, it does not prevent clouds of reddish dust from the laterite soil blowing about when the train is in motion; after a journey with the windows open a bath is a necessity!"
                                            },
                                            {
                                                "example_id": "1b85da0c-89e4-4992-b654-bac20876212f",
                                                "sense_id": "85c786d5-99c4-3644-93a3-998326f6f459",
                                                "text": "Constant tropical rain makes a mush of hard old lavas. The end product is a brick red soil called laterite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
