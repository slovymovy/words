                        "form": "mukluks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75c26b27-861b-31ac-b3a9-2224bab69bd7",
                        "entry_id": "38031374-afb3-3b30-8812-735a01572613",
                        "glosses": [
                            "A soft knee-high boot of sealskin or reindeer skin, originally worn by Inuit and Yupik."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "6ddf06ec-bc83-48bd-b67f-f66e1b93f4c5",
                                "sense_id": "75c26b27-861b-31ac-b3a9-2224bab69bd7",
                                "text": "Her parkee, made of Caribou, it is a lovely fit, / And she's all right from muck-a-luck unto her dainty mit. / This lovely Klooch is fond of Hooch, and makes it very well."
                            }
                        ]
                    },
                    {
                        "sense_id": "43aed2dd-4e52-3c57-b2cb-5985f5428aad",
                        "entry_id": "38031374-afb3-3b30-8812-735a01572613",
                        "glosses": [
                            "A laced winter boot resembling a traditional mukluk, with thick rubber sole and cloth upper."
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "bf0bc87d-56d7-4446-a3fb-fcc69c40a495",
                                "sense_id": "43aed2dd-4e52-3c57-b2cb-5985f5428aad",
                                "text": "[...] the Canadians’ [soldiers’] mukluks and sleeping bags were superior to anything in use. the mukluk, a rubber-soled boot with a calf-high outer nylon cover, has a thick woollen inner boot that keeps feet warm in the coldest of weather."
                            },
                            {
                                "example_id": "a5e8f389-6e48-4c74-ab23-d03e7752aa46",
                                "sense_id": "43aed2dd-4e52-3c57-b2cb-5985f5428aad",
                                "text": "The skin is used to make mukluks, hats, parkas. We are resourceful and respectful of the animals, the land."
                            }
                        ]
                    }
                ],
