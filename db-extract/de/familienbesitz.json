                                "target_senses": [
                                    {
                                        "sense_id": "cb201d74-8186-3338-a9b4-8b8f4b726be2",
                                        "entry_id": "9cebe2d6-1102-3add-9948-72fde85851a7",
                                        "glosses": [
                                            "iets waar een familie (al generaties lang) eigenaar van is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc878586-76dc-4517-9a61-252be802c220",
                                                "sense_id": "cb201d74-8186-3338-a9b4-8b8f4b726be2",
                                                "text": "Zijn studie wordt geen succes. Hij geeft haar in 1847 op en neemt zijn intrek op het ouderlijk landgoed, dat na de verdeling van het familiebezit zijn eigendom is geworden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea8f5403-14b1-31bf-b8fd-75dc3b8bd5ba",
                                        "entry_id": "9cebe2d6-1102-3add-9948-72fde85851a7",
                                        "glosses": [
                                            "iets wat door privépersonen bezeten wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f858935-e16f-4bc7-934c-2ca9dc3b6bfe",
                                                "sense_id": "ea8f5403-14b1-31bf-b8fd-75dc3b8bd5ba",
                                                "text": "Kasteel Duivenvoorde was 800 jaar familiebezit, maar straks niet meer"
                                            },
                                            {
                                                "example_id": "4f3435cc-0e56-4438-9386-ed28962d767d",
                                                "sense_id": "ea8f5403-14b1-31bf-b8fd-75dc3b8bd5ba",
                                                "text": "Museum Singer Laren heeft een aquarel van Anton Mauve (1838-1888) gekregen uit een erfenis. Het werk, Aan de ploeg, was jarenlang familiebezit, meldt NH Nieuws. Het geldt als een van de hoogtepunten uit het werk van Mauve."
                                            }
                                        ]
                                    }
                                ]
