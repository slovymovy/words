                        "examples": [
                            {
                                "example_id": "8c629eb9-70cd-49f5-a46e-c386b3de14b8",
                                "sense_id": "c50b2439-802b-347a-b5e8-1b0d26e6c015",
                                "text": "Производство свернулось."
                            },
                            {
                                "example_id": "c3666455-7527-473b-a82b-e5dd353b9ab4",
                                "sense_id": "c50b2439-802b-347a-b5e8-1b0d26e6c015",
                                "text": "Лазареты свернулись."
                            }
