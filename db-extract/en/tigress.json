                        "sense_id": "7b1bc820-3f3b-37a2-9ed3-f724d18f59f9",
                        "entry_id": "98b7fc73-fd0f-31cc-b19e-f89c2b0c8326",
                        "glosses": [
                            "eine Frau mit einem Verhalten, welches an einen Tiger erinnert"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "985f3765-55dc-4ad6-8e89-1561bc0f8d5d",
                                "sense_id": "7b1bc820-3f3b-37a2-9ed3-f724d18f59f9",
                                "text": "\"Such a tigress once lived at my house. When her territory was invaded, she fought for her rights, and she roared a terrible roar. I was that tigress. I turned into a defensive, unpleasant beast when my husbnad retired.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
