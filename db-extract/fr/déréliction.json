                                "target_senses": [
                                    {
                                        "sense_id": "9608b992-2026-328f-a636-0146dd5a7d9f",
                                        "entry_id": "4726da44-60dc-343e-8b87-c35798fcaa0c",
                                        "glosses": [
                                            "een toestand van door allen verlaten zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f1861e-c0e2-406b-9727-71410ceaab8d",
                                                "sense_id": "9608b992-2026-328f-a636-0146dd5a7d9f",
                                                "text": "Dat deel van de Kalahari straalt een overweldigende verlatenheid uit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eac66041-f796-48ca-ad65-196b88e1355f",
                        "source_entry_id": "b183d784-fd99-3b85-a634-f891ca5e683f",
                        "target_lang_word": "eenzaamheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eenzaamheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31b898fe-b6fc-393e-a9b8-c34ce14ec9d5",
                                        "entry_id": "1f88fc09-230d-33cb-90b6-a5db50925c0a",
                                        "glosses": [
                                            "de hoedanigheid van het eenzaam zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61f9f43f-2db3-44c6-bc7d-aec39add7f11",
                                                "sense_id": "31b898fe-b6fc-393e-a9b8-c34ce14ec9d5",
                                                "text": "Eenzaamheid die niet bang maakt. Durf om alleen verder te gaan."
                                            },
                                            {
                                                "example_id": "b87fc3cd-0e9f-4c31-82f0-b9223723f166",
                                                "sense_id": "31b898fe-b6fc-393e-a9b8-c34ce14ec9d5",
                                                "text": "Het boek behandelt onze relatie met de nieuwsmedia, onze ideeën over liefde en seks, onze veronderstellingen over geld en onze carrières, onze houding ten opzichte van dieren en de natuur, onze bewondering voor wetenschap en technologie, ons geloof in individualisme en secularisme - en onze verhouding tot rust en eenzaamheid."
                                            },
                                            {
                                                "example_id": "5af3ac0c-3c21-4da5-aa7a-66a17c97c14c",
                                                "sense_id": "31b898fe-b6fc-393e-a9b8-c34ce14ec9d5",
                                                "text": "Dat Olive haar aandacht naar iemand anders had verlegd, was een kloppende zweer, een eigenaardig soort kwelling; de eenzaamheid was lastig te meten zolang de bron ervan zich voor haar ogen bevond, de trap op en af liep, door de boomgaard, de voordeur uit en weg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe54360-dc8b-30b4-b6d8-b4a46fcd367b",
                                        "entry_id": "1f88fc09-230d-33cb-90b6-a5db50925c0a",
                                        "glosses": [
                                            "het gevoel eenzaam te zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ce2aaf-8efc-4d47-9ea7-da2961a0be0f",
                                                "sense_id": "bbe54360-dc8b-30b4-b6d8-b4a46fcd367b",
                                                "text": "De eenzaamheid speelt je parten."
                                            },
                                            {
                                                "example_id": "9918771c-195b-4127-9974-d3c39a95caf3",
                                                "sense_id": "bbe54360-dc8b-30b4-b6d8-b4a46fcd367b",
                                                "text": "Tot op dat moment had ik nooit echt geweten wat eenzaamheid was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
