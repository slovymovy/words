                "senses": [
                    {
                        "sense_id": "d9f66855-0551-390a-9fb1-389b033a6041",
                        "entry_id": "301efa6c-a1bb-36a4-82c1-8de6833fd085",
                        "glosses": [
                            "Fettsäure, die sich in der Art ihrer Kohlenstoff-Doppelbindung von natürlich vorkommenden Fettsäuren unterscheidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19f3870-9054-4340-a13f-f5ff9d1e0a87",
                                "sense_id": "d9f66855-0551-390a-9fb1-389b033a6041",
                                "text": "Eine Ernährung, die reich an Transfettsäuren ist, erhöht das LDL-Cholesterol im Blut und senkt das HDL-Cholesterol. Daraus resultiert ein ungünstigeres Verhältnis von Gesamtcholesterol zu HDL-Cholesterol, welches einen Risikofaktor für koronare Herzkrankheiten darstellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
