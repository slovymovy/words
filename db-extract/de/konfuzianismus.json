                        ],
                        "examples": [
                            {
                                "example_id": "3c799ade-7744-4be9-ae98-069b645d7485",
                                "sense_id": "5db5b2ed-5abb-3ae2-97b7-d83f723e4809",
                                "text": "„Die Regierungsform Nordkoreas ist stalinistisch, hat zugleich tiefreligiöse Züge und viel vom Konfuzianismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
