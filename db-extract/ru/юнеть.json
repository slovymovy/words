                "translations": [
                    {
                        "translation_id": "25f52270-30b8-4a40-a368-0450350e3268",
                        "source_entry_id": "39bc57ff-e466-366e-9441-8bb22c34fe0a",
                        "source_sense_id": "8dc4a94e-e79e-38aa-999e-9f3c3961ca09",
                        "target_lang_word": "rajeunir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rajeunir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cf92867-011d-3722-80e4-6d72c55c6bfa",
                                        "entry_id": "8da939ff-df75-38fa-a24f-2f6725e8b91f",
                                        "glosses": [
                                            "Rendre jeune, rendre la jeunesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0b799c-a318-469e-abb5-803e4eccf934",
                                                "sense_id": "6cf92867-011d-3722-80e4-6d72c55c6bfa",
                                                "text": "Selon la Fable, Médée rajeunit Éson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0488d59-0629-3ab7-aa3a-03d24db195f4",
                                        "entry_id": "8da939ff-df75-38fa-a24f-2f6725e8b91f",
                                        "glosses": [
                                            "Rendre l’aspect de la jeunesse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07addbfa-9856-475b-8ae5-bf1f33342c78",
                                                "sense_id": "f0488d59-0629-3ab7-aa3a-03d24db195f4",
                                                "text": "Mme Ida était vexée parce que justement elle ravalait sa façade, astiquait sa beauté tous les jours et qu'on lui disait qu'elle avait rajeuni de cinq ans. Et cinq ans, pour une femme, c'est quelque chose."
                                            },
                                            {
                                                "example_id": "500a3bfc-cd50-4f90-b098-34dd275b2746",
                                                "sense_id": "f0488d59-0629-3ab7-aa3a-03d24db195f4",
                                                "text": "Ce costume le rajeunit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05dac5b0-b6fb-3994-8c82-6c3f2c47d245",
                                        "entry_id": "8da939ff-df75-38fa-a24f-2f6725e8b91f",
                                        "glosses": [
                                            "Donner un caractère plus récent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "241ea182-24b6-42be-8d8b-311ea677835d",
                                                "sense_id": "05dac5b0-b6fb-3994-8c82-6c3f2c47d245",
                                                "text": "À Rochechouard, « Médrano », a rajeuni le cirque Fernando, et dans le souvenir du clown Boum-Boum, a trouvé un heureux déroulement de spectacle."
                                            },
                                            {
                                                "example_id": "bba6b6c7-da0a-40b2-a3f3-9e78eb8db14f",
                                                "sense_id": "05dac5b0-b6fb-3994-8c82-6c3f2c47d245",
                                                "text": "Les sols azonaux sont des sols pédologiquement jeunes que l'on observe en particulier sur les pentes rajeunies par l'érosion. Ils présentent des minéraux argileux sous un aspect frais, voisin de celui de la roche-mère originelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e670bd-b010-31b2-afdb-c5f2475b86e2",
                                        "entry_id": "8da939ff-df75-38fa-a24f-2f6725e8b91f",
                                        "glosses": [
                                            "Attribuer à quelqu’un moins d’années qu’il n’en a, le dire ou le supposer plus jeune qu’il n’est."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a5537a-fe45-4efd-a62b-70a344fa92e1",
                                                "sense_id": "30e670bd-b010-31b2-afdb-c5f2475b86e2",
                                                "text": "Vous me donnez quarante ans, vous me rajeunissez."
                                            },
                                            {
                                                "example_id": "8a75d7ec-adf3-4b73-a213-d992e27d48a7",
                                                "sense_id": "30e670bd-b010-31b2-afdb-c5f2475b86e2",
                                                "text": "Les dictionnaires biographiques le rajeunissent de cinq ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1df9664b-12c8-3f08-a78e-87859cbafb24",
                                        "entry_id": "8da939ff-df75-38fa-a24f-2f6725e8b91f",
                                        "glosses": [
                                            "Redonner de la vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b959124b-1d6e-4e59-82ce-3de1cbd8cd80",
                                                "sense_id": "1df9664b-12c8-3f08-a78e-87859cbafb24",
                                                "text": "Rajeunir un arbre en le taillant."
                                            },
                                            {
                                                "example_id": "697ac68c-39d1-4e8a-94ff-a339853dff92",
                                                "sense_id": "1df9664b-12c8-3f08-a78e-87859cbafb24",
                                                "text": "Rajeunir un vieux mot en l’employant à propos."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rajeunir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1e3c25c-e026-3ee8-be6a-e9ac8a3650a7",
                                        "entry_id": "8162876d-028d-3be4-bdce-00a1bf30da74",
                                        "glosses": [
                                            "Redevenir jeune, reprendre l’air et la vigueur de la jeunesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03820946-e6d9-4a0f-b8f4-d7344a9aa018",
                                                "sense_id": "e1e3c25c-e026-3ee8-be6a-e9ac8a3650a7",
                                                "text": "Il semble que cette femme rajeunisse."
                                            },
                                            {
                                                "example_id": "69488add-8665-42e2-aa83-730a025d468f",
                                                "sense_id": "e1e3c25c-e026-3ee8-be6a-e9ac8a3650a7",
                                                "text": "Depuis son mariage, il a rajeuni."
                                            },
                                            {
                                                "example_id": "e94ec079-3899-4d1c-8dc7-e7a2a22ea544",
                                                "sense_id": "e1e3c25c-e026-3ee8-be6a-e9ac8a3650a7",
                                                "text": "Au printemps la nature rajeunit, les arbres rajeunissent, tout rajeunit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d4f442-77dd-3e29-8d3b-a6dd5a81f41e",
                                        "entry_id": "8162876d-028d-3be4-bdce-00a1bf30da74",
                                        "glosses": [
                                            "Se prétendre plus jeune qu’on ne l’est réellement."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a3d68b-0bf9-49df-9f74-80c0bcbab804",
                                                "sense_id": "52d4f442-77dd-3e29-8d3b-a6dd5a81f41e",
                                                "text": "Elle dit avoir vingt-neuf ans, je crois qu’elle se rajeunit un peu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed64fdee-1ffc-303b-a0f1-793c3b1822e9",
                                        "entry_id": "8162876d-028d-3be4-bdce-00a1bf30da74",
                                        "glosses": [
                                            "Prendre un caractère plus jeune."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0533279d-dc10-4ecd-9d37-602f8559cc63",
                                                "sense_id": "ed64fdee-1ffc-303b-a0f1-793c3b1822e9",
                                                "text": "Oui, mais combien de temps, dans une discipline où l’élite se rajeunit et « s’athlétise » toujours plus ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
