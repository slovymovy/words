                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c05f3f87-fb6f-4ccf-a9f5-34aa1cad276d",
                                                "sense_id": "589f59ec-2e53-3236-894f-9c17f2ea9fa8",
                                                "text": "„Der mehr als lebensfrohe Texaner, Sohn des Musical-Stars Mary Martin und eines Anwalts, begleitete nach der Scheidung der Eltern seine Mutter auf Tourneen.“"
                                            },
                                            {
                                                "example_id": "9c414df9-aafc-4051-a661-d130c402f647",
                                                "sense_id": "589f59ec-2e53-3236-894f-9c17f2ea9fa8",
                                                "text": "„Der gesuchte Texaner, der am Dienstagabend zu Hause in Gegenwart seiner Frau von zwei maskierten Männern gekidnappt worden war, war spurlos verschwunden.“"
                                            },
                                            {
                                                "example_id": "9b4ec415-8bf1-41f9-96f6-a9f9a15997af",
                                                "sense_id": "589f59ec-2e53-3236-894f-9c17f2ea9fa8",
                                                "text": "„Allen Amerikanern, nicht nur den Texanern, ist schließlich sonnenklar, dass die texanische Mentalität grundsätzlich anders ist als im Rest des Landes, und außerdem ist Texas ja wohl reich genug, um ohne die anderen 49 Bundesstaaten auszukommen.“"
                                            }
                                        ],
