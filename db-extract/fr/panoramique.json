                                        "sense_id": "f4b85ca1-6835-3289-9c62-b1c657cc4f23",
                                        "entry_id": "828ce806-dc39-3713-8ead-1b2c49ccd7d0",
                                        "glosses": [
                                            "ruim (van uitzicht); luisterrijk, groots"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c3d8030-efb9-4ee5-a090-ac130e06bcc5",
                                                "sense_id": "f4b85ca1-6835-3289-9c62-b1c657cc4f23",
                                                "text": "Dit was verreweg het weidste landschap dat we te zien kregen op deze reis."
                                            },
                                            {
                                                "example_id": "7b9be55a-65e0-4f54-98e2-123fbd1f0bd5",
                                                "sense_id": "f4b85ca1-6835-3289-9c62-b1c657cc4f23",
                                                "text": "Dat kwam waarschijnlijk omdat je in de woestijn altijd alles om je heen kon zien, maar ook doordat ik uit het vlakke Nederland kom, waar ik gewend ben aan weidse landschappen met vergezichten en hoge luchten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
