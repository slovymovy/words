                "senses": [
                    {
                        "sense_id": "b87752c4-51a7-3c4d-93c7-12b82d63efa0",
                        "entry_id": "d014eb35-5b31-3a1e-b595-c68272a9024f",
                        "glosses": [
                            "computerspel, waarin het racen over een circuit met een auto of ander transportmiddel centraal staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6217fca7-8664-4266-ab64-d50b5a4774cd",
                                "sense_id": "b87752c4-51a7-3c4d-93c7-12b82d63efa0",
                                "text": "In Nature schrijft het team van neurowetenschapper Adam Gazzaley van de University of California in San Francisco dat ouderen van tussen de 60 en 85 jaar oud die gedurende een maand drie keer een uur per week het racespel deden, beter leren multitasken (sturen en schieten tegelijk)."
                            },
                            {
                                "example_id": "a21d3b76-9ad7-4e17-b329-9d0f7534b2f9",
                                "sense_id": "b87752c4-51a7-3c4d-93c7-12b82d63efa0",
                                "text": "De familie heeft meer dan 20.000 euro in het project zitten. Van der Hulst verwacht dat die terugverdiend worden. Zeker als het hun uitgever JustGames gaat lukken om een licentie voor het bordspel te krijgen voor Frankrijk en wellicht Spanje en Italië. \"Of het spel daar dezelfde naam houdt, of een Vuelta- of Giro-spel wordt, moeten we nog even bekijken. Voorlopig zijn we druk met ons volgende zet: een heel mooi Formule 1-racespel. Daar verwachten we veel van, zeker met alle belangstelling voor Max Verstappen.\""
                            },
                            {
                                "example_id": "075879c4-81bc-41fc-939e-5ac82985377f",
                                "sense_id": "b87752c4-51a7-3c4d-93c7-12b82d63efa0",
                                "text": "Wel opvallend is dat het bedrijf met The Crew verder gaat. Het racespel werd destijds niet bijzonder positief ontvangen, maar werd wel lang ondersteund met extra content."
                            },
                            {
                                "example_id": "891cf213-b104-4916-bea3-b9904065f136",
                                "sense_id": "b87752c4-51a7-3c4d-93c7-12b82d63efa0",
                                "text": "Bij het motorstuur hoort een racespel, het huis herbergt een aantal minigames, de vishengel dien je uit te werpen om een digitale vis aan de haak te slaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfe6e2d1-777b-3d08-b84f-ce00918381e1",
                        "entry_id": "d014eb35-5b31-3a1e-b595-c68272a9024f",
                        "glosses": [
                            "computerspelgenre, waarin het racen over een circuit met een auto of ander transportmiddel centraal staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "832954aa-3c3d-4ac3-889d-eeda55059dd6",
                                "sense_id": "bfe6e2d1-777b-3d08-b84f-ce00918381e1",
                                "text": "Ben jij een liefhebber van racespelen of vind je bordspelen leuker?"
                            }
                        ]
                    }
