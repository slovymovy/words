                "senses": [
                    {
                        "sense_id": "4ab2e917-b0fa-35b4-ae63-98eb1d781766",
                        "entry_id": "04373a0f-2bc0-3e51-9694-b813057337b0",
                        "glosses": [
                            "coś, co jest rzadkie, nietypowe, zdarza się/występuje rzadko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edfa61bd-9f45-425a-ab70-46d577eaa1b6",
                                "sense_id": "4ab2e917-b0fa-35b4-ae63-98eb1d781766",
                                "text": "Jelenie sika są w Polsce rzadkością, jednak nasi południowi sąsiedzi mają bardzo liczną populację i przepiękne gwizdowiska"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78d773ad-fbe7-48ee-8b89-fbceddd4cd6c",
                        "source_entry_id": "04373a0f-2bc0-3e51-9694-b813057337b0",
                        "source_sense_id": "4ab2e917-b0fa-35b4-ae63-98eb1d781766",
                        "target_lang_word": "rarity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rarity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b129a328-f6ad-361e-bddb-a57124ebe462",
                                        "entry_id": "cde02766-4f8f-3426-a8b2-dc9825c9e0f3",
                                        "glosses": [
                                            "A measure of the scarcity of an object."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68914b0b-eae5-3a32-a92b-af6fc755ab86",
                                        "entry_id": "cde02766-4f8f-3426-a8b2-dc9825c9e0f3",
                                        "glosses": [
                                            "Thinness; the property of having low density"
                                        ],
                                        "tags": [
                                            "of a gas"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4584b76-1788-4966-b14f-76509e447550",
                                                "sense_id": "68914b0b-eae5-3a32-a92b-af6fc755ab86",
                                                "text": "Only the increasing rarity bothered him, and he thought that perhaps it was this which had turned the heads of other travellers and excited those absurd tales of night-gaunts whereby they explained the loss of such climbers as fell from these perilous paths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f60eb8e-067e-357a-9772-37e2d8db8af7",
                                        "entry_id": "cde02766-4f8f-3426-a8b2-dc9825c9e0f3",
                                        "glosses": [
                                            "A rare object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c6fefce-4dc4-40c5-ac17-c63b852d63d5",
                                                "sense_id": "2f60eb8e-067e-357a-9772-37e2d8db8af7",
                                                "text": "Plant breeding is always a numbers game.[…]In addition, we are looking for rare alleles, so the more plants we try, the better. These rarities may be new mutations, or they can be existing ones that are neutral—or are even selected against—in a wild population. A good example is mutations that disrupt seed dispersal, leaving the seeds on the heads long after they are ripe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "597efe6c-5cdb-4517-90b5-4cb8c016350b",
                        "source_entry_id": "04373a0f-2bc0-3e51-9694-b813057337b0",
                        "source_sense_id": "4ab2e917-b0fa-35b4-ae63-98eb1d781766",
                        "target_lang_word": "rareté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rareté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "404db7a6-e451-37fc-8fe0-e341e8370847",
                                        "entry_id": "aa92d233-c289-3c1a-9609-91e2472ef0e2",
                                        "glosses": [
                                            "Qualité des choses qui sont en petit nombre, en petite quantité ; il est opposé à abondance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "305bae22-0987-40e5-a955-c3ce05ccc597",
                                                "sense_id": "404db7a6-e451-37fc-8fe0-e341e8370847",
                                                "text": "En France, les maternités manquent de tout. De sages-femmes tout d'abord, dont la part travaillant dans les établissements hospitaliers est en baisse constante depuis plusieurs années. […] Mais aussi de pédiatres, d'anesthésistes ou de gynécologues-obstétriciens, dont la rareté provoque de nombreuses fermetures intempestives de plateaux techniques sur tout le territoire."
                                            },
                                            {
                                                "example_id": "621359dd-669d-4808-a64a-366ed59ed392",
                                                "sense_id": "404db7a6-e451-37fc-8fe0-e341e8370847",
                                                "text": "Il y eut grande rareté de vin cette année-là."
                                            },
                                            {
                                                "example_id": "f13bd0e5-d26d-4431-a267-86517c7d1a07",
                                                "sense_id": "404db7a6-e451-37fc-8fe0-e341e8370847",
                                                "text": "Ces objets coûtent cher à cause de leur rareté."
                                            },
                                            {
                                                "example_id": "b700e20e-ee4c-43d7-8a79-75599a9e6162",
                                                "sense_id": "404db7a6-e451-37fc-8fe0-e341e8370847",
                                                "text": "La rareté en augmente le prix."
                                            },
                                            {
                                                "example_id": "0683c1b4-533b-4920-8725-daab56d96dd0",
                                                "sense_id": "404db7a6-e451-37fc-8fe0-e341e8370847",
                                                "text": "Il n’y a pas plus d’épées à Tolède que de cuir à Cordoue, que de dentelles à Malines, que d’huîtres à Ostende et de pâtés de foie gras à Strasbourg ; c’est à Paris que sont toutes les raretés, et si l’on en rencontre quelques-unes dans les pays étrangers, c’est qu’elles viennent de la boutique de mademoiselle Delaunay, quai Voltaire."
                                            },
                                            {
                                                "example_id": "290eb855-b393-4a64-b36b-92d5c117bd9c",
                                                "sense_id": "404db7a6-e451-37fc-8fe0-e341e8370847",
                                                "text": "Le président de l’Association des producteurs d’arbres de Noël du Québec, Charles Vaillancourt, a affirmé qu’il ne devrait pas y avoir de pénurie puisque les producteurs seront en mesure de livrer autant d’arbres que l’an dernier, mais la forte demande risque de créer une rareté, ce qui pourrait faire augmenter les prix entre 2 $ et 5 $ par sapin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7486f4c-a3c3-3b5a-9521-ef43a75de6ec",
                                        "entry_id": "aa92d233-c289-3c1a-9609-91e2472ef0e2",
                                        "glosses": [
                                            "Chose qui se trouve difficilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc984187-5f61-4bcc-be9d-05b77e1b05be",
                                                "sense_id": "b7486f4c-a3c3-3b5a-9521-ef43a75de6ec",
                                                "text": "La rareté des diamants contribue beaucoup à leur prix."
                                            },
                                            {
                                                "example_id": "226beae8-7e84-404b-84b0-5263ebebe8e3",
                                                "sense_id": "b7486f4c-a3c3-3b5a-9521-ef43a75de6ec",
                                                "text": "Il y a dans sa collection des pièces d’une rareté singulière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d396c338-3c8f-3dbd-b5ca-be8d8faf1182",
                                        "entry_id": "aa92d233-c289-3c1a-9609-91e2472ef0e2",
                                        "glosses": [
                                            "Ce qui est peu fréquent, peu commun."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29c7d898-616c-4ba3-97af-c7ad24d6a9ac",
                                                "sense_id": "d396c338-3c8f-3dbd-b5ca-be8d8faf1182",
                                                "text": "C’est une rareté que de vous voir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a25e1f6-bbe1-3483-b388-491a211b35f7",
                                        "entry_id": "aa92d233-c289-3c1a-9609-91e2472ef0e2",
                                        "glosses": [
                                            "Quasi absence."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9f5c98c-618c-4fb7-aeaa-881083cf9d3e",
                                                "sense_id": "0a25e1f6-bbe1-3483-b388-491a211b35f7",
                                                "text": "Vous êtes, vous devenez d’une grande rareté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fc1755c-dd86-32c8-984c-9c1b9e7a8e8c",
                                        "entry_id": "aa92d233-c289-3c1a-9609-91e2472ef0e2",
                                        "glosses": [
                                            "Objet rare, singulier ou curieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ddee07a-6c8d-4319-a64e-7b34ab4b3565",
                                                "sense_id": "2fc1755c-dd86-32c8-984c-9c1b9e7a8e8c",
                                                "text": "Je m'étais déterminé à prendre la route de Salzburg, afin de voir la Bibliothèque de l’archevêché de cette ville , composée de 21000 volumes; elle contient un assez grand nombre de raretés en manuscrits et en livres incunables; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06f495bc-8bbd-3acd-a91c-c221a3ad4d88",
                                        "entry_id": "aa92d233-c289-3c1a-9609-91e2472ef0e2",
                                        "glosses": [
                                            "État de ce qui est rare, par opposition à densité."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e580634-093c-4929-aba8-da87e1068d8b",
                                                "sense_id": "06f495bc-8bbd-3acd-a91c-c221a3ad4d88",
                                                "text": "La rareté de l’air sur les montagnes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fd8a611-68bc-4b14-bf40-27efa086ebd9",
                        "source_entry_id": "04373a0f-2bc0-3e51-9694-b813057337b0",
                        "source_sense_id": "4ab2e917-b0fa-35b4-ae63-98eb1d781766",
