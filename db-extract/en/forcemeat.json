                                "target_senses": [
                                    {
                                        "sense_id": "3c1f8b53-15f2-3312-b051-fb26ae4aca45",
                                        "entry_id": "0a3eceb7-c2d6-3d2f-a23d-a829c3d3aa32",
                                        "glosses": [
                                            "belachelijke of misleidende gang van zaken"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7c49189-ad7e-4c50-b0a7-3cd06a9269e8",
                                                "sense_id": "3c1f8b53-15f2-3312-b051-fb26ae4aca45",
                                                "text": "Dat optreden van die twee oude vrouwen was een farce."
                                            },
                                            {
                                                "example_id": "441ce3f4-c435-4c8f-96c3-9769fff981a5",
                                                "sense_id": "3c1f8b53-15f2-3312-b051-fb26ae4aca45",
                                                "text": "De openbaarheid die zo vaak gepredikt wordt, blijkt in de praktijk maar al te vaak een farce, zich uitend in tergende obstructie waarna de rechter er aan te pas moet komen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "991d7b6f-04db-3b89-a1d4-49406a2fb7db",
                                        "entry_id": "0a3eceb7-c2d6-3d2f-a23d-a829c3d3aa32",
                                        "glosses": [
                                            "humoristisch theaterstuk, met in het plot veelal een samenloop van omstandigheden die tot hilariteit/hilarische momenten leiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef6f296d-b47b-430c-9e38-6655eeb8b465",
                                                "sense_id": "991d7b6f-04db-3b89-a1d4-49406a2fb7db",
                                                "text": "De vraag naar 'het komische' van de farce is welbeschouwd onnodig: de komische kracht van de farce ligt precies in de mechanische, machinale structuur die de farce in haar ogen als genre definieert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e896533b-cf13-3839-b716-21d9aef8c939",
                                        "entry_id": "0a3eceb7-c2d6-3d2f-a23d-a829c3d3aa32",
                                        "glosses": [
                                            "vulsel of vulling voor gerechten, meestal op basis van fijngehakt vlees of vis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5504ed19-2018-4c2c-9479-d70f59513239",
                                                "sense_id": "e896533b-cf13-3839-b716-21d9aef8c939",
                                                "text": "Snijd 1 kipfilet in stukjes en pureer deze in een keukenmachine, samen met 1 ei, knoflook en room, tot een zogenaamde farce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
