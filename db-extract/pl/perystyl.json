                "senses": [
                    {
                        "sense_id": "2733ea3d-64f5-3e0c-bce9-a16aa8353262",
                        "entry_id": "d2dd6981-5aad-34f2-b7c0-592334bdbe2b",
                        "glosses": [
                            "dziedziniec lub ogród wewnętrzny otoczony kolumnadą"
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "de36268d-3c42-4c1e-8816-bc31aa003ff1",
                                "sense_id": "2733ea3d-64f5-3e0c-bce9-a16aa8353262",
                                "text": "Dobudówka składała się z perystylu i sali zebrań dla gminy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8d84f0ea-476f-3296-a2e8-294f4b688f47",
                        "entry_id": "d2dd6981-5aad-34f2-b7c0-592334bdbe2b",
                        "glosses": [
                            "kolumnada otaczająca dziedziniec lub ogród"
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "809fa91b-6dc1-40ef-9b75-ec94016a1322",
                                "sense_id": "8d84f0ea-476f-3296-a2e8-294f4b688f47",
                                "text": "Bezpośrednio za perystylem znajdowała się długa pergola z wodotryskami i rzeźbami"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f41c460c-144d-4bfe-bd90-efc1c25291fc",
                        "source_entry_id": "d2dd6981-5aad-34f2-b7c0-592334bdbe2b",
                        "source_sense_id": "2733ea3d-64f5-3e0c-bce9-a16aa8353262",
                        "target_lang_word": "peristyle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peristyle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b243bfe-a0be-3ad9-ba67-42c88bd2fbd8",
                                        "entry_id": "28927359-6992-3d7e-9113-007930285f88",
                                        "glosses": [
                                            "A colonnade surrounding a courtyard, temple, etc., or the yard enclosed by such columns."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac0c1504-6933-4a55-af51-5bb6bc503438",
                                                "sense_id": "8b243bfe-a0be-3ad9-ba67-42c88bd2fbd8",
                                                "text": "One cannot, for example, see the Temple of Æsculapius as one stands in the fine open courtyard as it was intended one should do; the interstices on that side of the peristyle have been blocked by Venetian Gothic buildings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc79736a-8723-3899-899c-b30ec2bf8ae9",
                                        "entry_id": "28927359-6992-3d7e-9113-007930285f88",
                                        "glosses": [
                                            "A porch surrounded by columns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15ee733b-cfb1-3032-9e58-2a971450e3e6",
                                        "entry_id": "28927359-6992-3d7e-9113-007930285f88",
                                        "glosses": [
                                            "A sacred roofed courtyard with a central pillar (the potomitan), used as a space for voodoo ceremonies, either alone or as an adjunct to an enclosed temple or altar-room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5561b5b0-b428-4a39-8c7b-596502f52a03",
                                                "sense_id": "15ee733b-cfb1-3032-9e58-2a971450e3e6",
                                                "text": "The peristyle is a roofed structure, open at the sides, in which most of the ceremonials and dances take place."
                                            },
                                            {
                                                "example_id": "cfab79e9-7187-4f08-81a9-8681b2a25ceb",
                                                "sense_id": "15ee733b-cfb1-3032-9e58-2a971450e3e6",
                                                "text": "Most peristyles in Haiti have hard-packed dirt floors that can soak up libations when they're poured on the ground in honor of the spirits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
