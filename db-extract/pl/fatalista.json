                    {
                        "translation_id": "4f886184-4145-4543-98d7-d412abec832e",
                        "source_entry_id": "d43a9cff-538b-37e2-871b-957d47cbef61",
                        "source_sense_id": "b939e41b-a68b-324f-9488-28f367cdeaf2",
                        "target_lang_word": "Fatalist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fatalist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "199b6132-e4a0-3af6-bee9-3ae5916d5b28",
                                        "entry_id": "5459a498-1858-3311-9e70-9c35da691ff6",
                                        "glosses": [
                                            "Person, die dem Fatalismus anhängt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b1fb536-49dc-412e-b1bd-2af7fb7264cc",
                                                "sense_id": "199b6132-e4a0-3af6-bee9-3ae5916d5b28",
                                                "text": "Mein Vater ist ein schrecklicher Fatalist."
                                            },
                                            {
                                                "example_id": "64ae8fee-1f68-4fd3-a6f6-e017f600d710",
                                                "sense_id": "199b6132-e4a0-3af6-bee9-3ae5916d5b28",
                                                "text": "„Die Franzosen sind Fatalisten.“"
                                            },
                                            {
                                                "example_id": "f94d1622-0805-4608-bea7-465e26f33746",
                                                "sense_id": "199b6132-e4a0-3af6-bee9-3ae5916d5b28",
                                                "text": "„Als er mir vom Berufensein zur stoischen Philosophie sprach, erkannte ich in ihm den Fatalisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
