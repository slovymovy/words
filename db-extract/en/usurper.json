                                        "entry_id": "945d1049-1537-3bf3-865d-3b5bdee3842e",
                                        "glosses": [
                                            "weibliche Person, die sich widerrechtlich der Herrschaftsgewalt im Staat bemächtigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
