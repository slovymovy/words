                    "sense_definition": "Oklepane, często powtarzane wyrażenie lub powiedzenie, które straciło swoją oryginalność i głębszy sens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cliche",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Polityk w swoim przemówieniu użył tylko pustych <w>frazesów</w> zamiast przedstawić konkretny plan działania.",
                            "target_lang_translations": {
                                "ru": "В своей речи политик использовал лишь пустые <w>фразы</w>, вместо того чтобы представить конкретный план действий."
                            }
                        },
                        {
                            "text": "Nie lubię słuchać tego <w>frazesu</w> o tym, że pieniądze szczęścia nie dają.",
                            "target_lang_translations": {
                                "ru": "Я не люблю слушать эту <w>банальность</w> о том, что деньги счастья не приносят."
                            }
                        }
                    ],
                    "synonyms": [
                        "banał",
                        "komunał",
                        "slogan",
                        "truizm",
                        "ogólnik",
                        "stara śpiewka"
                    ],
                    "common_phrases": [
                        "pusty frazes",
                        "sypać frazesami"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избитое, часто повторяемое выражение или высказывание, утратившее свою оригинальность и глубокий смысл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фраза",
