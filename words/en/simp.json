                    "sense_definition": "initialism of strongly interacting massive particle",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher discussed the properties of the <w>SIMP</w> in the context of dark matter.",
                            "target_lang_translations": {
                                "ru": "Исследователь обсудил свойства <w>СИМП</w> в контексте темной материи."
                            }
