                                        "examples": [
                                            {
                                                "example_id": "77311e4c-8756-46bd-ab66-8b15f0961664",
                                                "sense_id": "031e5d7d-1041-353c-85a2-bd1aaa2cf82b",
                                                "text": "„Der deutsche Kartograph Martin Waldseemüller (um 1475–um 1521) nannte den neuen Kontinent 1507 auf einer seiner Karten »America« und ehrte damit Amerigo Vespucci, den er für den Entdecker der Neuen Welt hielt.“"
                                            }
