                "senses": [
                    {
                        "sense_id": "3c0b1787-d91f-366e-aa68-3fd03de1f259",
                        "entry_id": "9a521d65-67fa-34c3-bbb7-7a942cdf324a",
                        "glosses": [
                            "Accompagne un mouvement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dccb11f1-f701-4e59-911e-3ed208adabed",
                                "sense_id": "3c0b1787-d91f-366e-aa68-3fd03de1f259",
                                "text": "On entend un petit cri.\nEh youp ! eh youp !\nMon père, qui est en face de moi, a l’air frappé d’un coup de sang, et je vais voler dans ses bras.\nEh youp ! eh youp ! la Catherina ! eh youp !"
                            },
                            {
                                "example_id": "e3a1277b-72a0-4e43-ab9f-12bdd213fc7c",
                                "sense_id": "3c0b1787-d91f-366e-aa68-3fd03de1f259",
                                "text": "Tu leur aurais dit il y a un an : « Pote, faut te sauver ! Soye héroïque ! Retourne au Basto ! […] » Ils t’auraient buté Roi des Folles !... Aujourd’hui trompettes et tata !... Tu leur dis : « Barrez Tourlourous ! Un sou les douze balles ! Allez youp ! Les voilà qui volent !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
