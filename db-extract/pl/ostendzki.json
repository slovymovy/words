                        "sense_id": "22f678cb-13e6-3b7d-b20c-e913b77b7abc",
                        "entry_id": "de87c22c-c25b-377f-b28f-d8d11d5e9b41",
                        "glosses": [
                            "związany z Ostendą, dotyczący Ostendy, pochodzący z Ostendy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c954b8d5-2d3c-4dc2-8bda-53e003e2235b",
                                "sense_id": "22f678cb-13e6-3b7d-b20c-e913b77b7abc",
                                "text": "Mający wiele wariantów geograficznych kierunek zachodni - w tym ostendzki (rzadziej nawiedzany) czy paryski (częściej) - odegra również ważną rolę w życiu i twórczości znakomitego pisarza"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
