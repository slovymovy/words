                ],
                "senses": [
                    {
                        "sense_id": "94bc38e7-2759-3402-8b17-9f18d6a60893",
                        "entry_id": "09a8d366-d22c-3a3a-9fbb-94d6d32d77af",
                        "glosses": [
                            "qualifizierte Person, der vom Bauherrn die Verantwortung für spezielle Baumaßnahmen übertragen worden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6539c2e-55fa-4f2c-9248-c3adf059e71b",
                                "sense_id": "94bc38e7-2759-3402-8b17-9f18d6a60893",
                                "text": "„Hat der Bauleiter nicht für alle ihm obliegenden Aufgaben die erforderliche Sachkunde und Erfahrung, hat er den Bauherrn zu veranlassen, geeignete Fachbauleiter zu bestellen.“"
                            },
                            {
                                "example_id": "21b5b1b4-8a57-4403-9e63-b7cdd3fca06e",
                                "sense_id": "94bc38e7-2759-3402-8b17-9f18d6a60893",
                                "text": "„Der Bauleiter muss über die für seine Aufgabe erforderliche Sachkunde und Erfahrung verfügen. Verfügt er auf einzelnen Teilgebieten nicht über die erforderliche Sachkunde, so sind geeignete Fachbauleiter heranzuziehen. Der Bauleiter hat die Tätigkeit der Fachbauleiter und seine Tätigkeit aufeinander abzustimmen.“"
                            },
                            {
                                "example_id": "1343e69e-a50a-4d48-a731-251f6a00d654",
                                "sense_id": "94bc38e7-2759-3402-8b17-9f18d6a60893",
                                "text": "„Der Fachbauleiter soll für die sogenannten \"großen\" Sonderbauten gefordert werden und darüber wachen, dass das genehmigte Brandschutzkonzept umgesetzt sowie Änderungen einer Genehmigung zugeführt werden. Soweit die Genehmigungsbehörde die Bestellung eines Fachbauleiters für den Brandschutz nicht fordert, liegt die Verantwortung für dessen Tätigwerden in den Händen des Bauleiters, der die Pflicht hat, einen Fachbauleiter bestellen zu lassen, wenn die eigene Sachkunde nicht ausreicht.“"
                            },
                            {
                                "example_id": "837a15a4-da2c-4f3b-a956-1bc29c5b9428",
                                "sense_id": "94bc38e7-2759-3402-8b17-9f18d6a60893",
                                "text": "„Der Fachbauleiter ist Ansprechpartner der Baubehörde für die Einhaltung der öffentlich-rechtlichen Belange einer Baumaßnahme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
