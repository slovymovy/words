                                "target_senses": [
                                    {
                                        "sense_id": "f98524d8-2f2a-33e7-acf1-5c52eb315d8a",
                                        "entry_id": "4fd53096-c12b-32e0-9e90-10dc378a9625",
                                        "glosses": [
                                            "Archipel du Sud-Est de l’Asie, bordé à l’est par la mer des Philippines, à l’ouest par la mer de Chine méridionale, au sud-ouest par la mer de Sulu et au sud par la mer de Célèbes."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad981e62-b655-4c17-a9d8-f15557664a27",
                                                "sense_id": "f98524d8-2f2a-33e7-acf1-5c52eb315d8a",
                                                "text": "Et puis un jour, alors que nous étions en cale sèche dans une des Philippines, j’avais vu mon beau bâtiment se volatiliser sous quelques torpilles lancées de plein fouet par une vague d’avions américains […]"
                                            },
                                            {
                                                "example_id": "1c16be96-0d1c-4e64-99df-32cc0d2408e0",
                                                "sense_id": "f98524d8-2f2a-33e7-acf1-5c52eb315d8a",
                                                "text": "Les Philippines sont situées dans la «ceinture de feu» du Pacifique, active sur le plan sismique, et comptent plus de 20 volcans actifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "985216ba-3cf9-349e-a426-a614bc965d9c",
                                        "entry_id": "4fd53096-c12b-32e0-9e90-10dc378a9625",
                                        "glosses": [
                                            "Pays dont le territoire correspond à ces îles. Sa capitale est Manille."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "674c38cc-3649-4db4-b8fb-e22edee73dae",
                                                "sense_id": "985216ba-3cf9-349e-a426-a614bc965d9c",
                                                "text": "Au début du siècle à Hawaï, le boum de l’activité sucrière attira une main-d'œuvre étrangère venue de pays aussi différents que la Chine, le Japon, les Philippines, la Corée et le Portugal."
                                            },
                                            {
                                                "example_id": "a03f11a9-1b45-45ac-a91c-af4ad6367b22",
                                                "sense_id": "985216ba-3cf9-349e-a426-a614bc965d9c",
                                                "text": "Comment parler des odyssées souvent anonymes de ces Chinois émigrés en Asie du Sud, de Java aux Philippines, tant ils furent nombreux et précoces ? Dès le début du XVᵉ siècle, la flotte de Zheng He en rencontre dans les îles de Java, de Sumatra et ailleurs."
                                            }
                                        ]
                                    }
                                ]
                            },
