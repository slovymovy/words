                    {
                        "translation_id": "00d126fd-da77-4b8c-9eec-4cc6a5a51a5b",
                        "source_entry_id": "ffe982e3-bca7-3db0-ac57-156faefb3c61",
                        "source_sense_id": "819bf4a7-fee3-3975-be31-e0f852a21d63",
                        "target_lang_word": "Gießerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gießerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                        "entry_id": "66f481fe-8697-31e0-9b70-d258063ea34a",
                                        "glosses": [
                                            "eine (Teil-)Fabrik, in der Rohlinge aus zuvor geschmolzenen Materialien (Metall, Glas) für die Fertigung produziert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa1a63db-c217-4759-a49d-38cac0d73907",
                                                "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                                "text": "Da die Firma ihre Gießerei ausgliederte, kann sie nicht mehr so schnell auf Probleme reagieren."
                                            },
                                            {
                                                "example_id": "4cc3debc-f555-46db-b618-7f312e5b1dc4",
                                                "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                                "text": "„Der Insolvenzverwalter möchte die Stilllegung der Gießerei verhindern.“"
                                            },
                                            {
                                                "example_id": "01c8e111-bbd8-4cfe-9fd4-fa5a53e1dea5",
                                                "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                                "text": "„Es beginnt aber im eigentlichen Sinne 1829, als Friedrich Nies eine Buchdruckerei gründete, der er 1830 eine Gießerei anfügte.“"
                                            },
                                            {
                                                "example_id": "6b378a26-717b-412a-ada0-1684e649c23d",
                                                "sense_id": "9dc02dd8-5a7d-3400-a3d5-f7dd7c25cb5d",
                                                "text": "Im 19. Jahrhundert gab es in unserer Stadt mehrere Gießereien."
                                            },
                                            {
