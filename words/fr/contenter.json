    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3907c907-1579-3906-b34b-4d53083b6922",
                    "sense_definition": "S'accommoder de quelque chose, trouver suffisant ce que l'on a sans demander plus.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "satisfaction_personnelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est très modeste et sait se <w>contenter</w> de peu pour être parfaitement heureux."
                        },
                        {
                            "text": "Pour le repas de ce soir, nous allons nous <w>contenter</w> de ce qui reste dans le réfrigérateur."
                        }
                    ],
                    "synonyms": [
                        "se satisfaire"
                    ],
                    "common_phrases": [
                        "se contenter de peu"
                    ]
                },
                {
                    "sense_id": "0515a6bf-8df7-3d6b-8271-b8dc2ca06eda",
                    "sense_definition": "Rendre quelqu'un satisfait en répondant à ses désirs ou à ses attentes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfaction_d_autrui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a fait des compromis pour <w>contenter</w> ses employés et éviter une grève."
                        },
                        {
                            "text": "Il est souvent impossible de <w>contenter</w> tout le monde lors d'un choix important."
                        }
                    ],
                    "synonyms": [
                        "combler",
                        "satisfaire"
                    ],
                    "antonyms": [
                        "décevoir",
                        "mécontenter"
                    ],
                    "common_phrases": [
                        "contenter tout le monde"
                    ]
                },
                {
                    "sense_id": "e1c748ab-ca2f-3e46-8140-06f82e8d799e",
                    "sense_definition": "Assouvir ou combler un désir, une passion ou un besoin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfaction_des_desirs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a posé plusieurs questions indiscrètes afin de <w>contenter</w> sa curiosité au sujet de cette affaire."
                        },
                        {
                            "text": "Un simple morceau de pain n'a pas suffi à <w>contenter</w> sa faim après cette longue marche."
                        }
                    ],
                    "synonyms": [
                        "assouvir",
                        "satisfaire"
                    ],
                    "antonyms": [
                        "frustrer"
                    ],
                    "common_phrases": [
                        "contenter sa curiosité",
                        "contenter son appétit"
                    ]
                }
            ]
        }
    ]
