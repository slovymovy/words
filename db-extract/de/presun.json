                "senses": [
                    {
                        "sense_id": "badaa898-235b-3c5f-b629-8931c2dd8592",
                        "entry_id": "008d6e56-13aa-3621-8b94-1fb69b9a3b9c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e6f870-52c5-4e30-8671-85130e76c803",
                                "sense_id": "badaa898-235b-3c5f-b629-8931c2dd8592",
                                "text": "Frau Presun ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9bde171a-2e02-4baf-aede-25ef9953de2e",
                                "sense_id": "badaa898-235b-3c5f-b629-8931c2dd8592",
                                "text": "Herr Presun wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2c2762c9-2c3c-4fcd-b849-63aef2d74617",
                                "sense_id": "badaa898-235b-3c5f-b629-8931c2dd8592",
                                "text": "Die Presuns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7516daf7-0bd3-4553-ad05-ec14c2c284b9",
                                "sense_id": "badaa898-235b-3c5f-b629-8931c2dd8592",
                                "text": "Der Presun trägt nie die Schals, die die Presun ihm strickt."
                            },
                            {
                                "example_id": "584b84e3-c98a-441a-a585-ad12ffd761d7",
                                "sense_id": "badaa898-235b-3c5f-b629-8931c2dd8592",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Presun kommt, geht der Herr Presun.“"
                            },
                            {
                                "example_id": "185a7fab-e910-439a-a271-99d996487f18",
                                "sense_id": "badaa898-235b-3c5f-b629-8931c2dd8592",
                                "text": "Presun kommt und geht."
                            },
                            {
                                "example_id": "709079a3-4eff-42bf-a762-9088fe6c6016",
                                "sense_id": "badaa898-235b-3c5f-b629-8931c2dd8592",
                                "text": "Presuns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
