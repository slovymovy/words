                    "frequency": "High",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux meilleures équipes vont s'<w>affronter</w> en finale du championnat ce week-end."
                        },
                        {
                            "text": "Plusieurs candidats s'<w>affrontent</w> lors d'un débat télévisé très attendu par le public."
                        }
                    ],
                    "common_phrases": [
