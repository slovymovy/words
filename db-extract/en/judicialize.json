                        "translation_id": "fb46c8ff-ab57-498f-b328-7d8b0bebdba0",
                        "source_entry_id": "330cd235-03cb-3d5a-914f-9c95077abc70",
                        "source_sense_id": "8f37471d-3b56-325f-be74-be537f8bab6d",
