                        "glosses": [
                            "Fruit du chérimolier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe48f485-f14f-41a9-9437-26343fb1c031",
                                "sense_id": "119f87be-9dc6-3b14-9759-cf38388fd0b9",
                                "text": "Parmi les hybrides des cœurs de bœuf, on trouve un croisement de pomme-cannelle et de cachiment, et un croisement de cachiment et de chérimole."
                            }
                        ]
                    }
