                        "examples": [
                            {
                                "example_id": "0e24d5a9-1d11-4dc5-86fc-b535d474164e",
                                "sense_id": "bb26b71a-b572-31c7-a539-c468efff1a2b",
                                "text": "Imagine this: you walk into work and the camera above the doors scans your face, opening them seamlessly without you lifting a finger."
                            },
                            {
                                "example_id": "5d05b68a-aa4f-4dc8-ba0b-6140665f8ad3",
                                "sense_id": "bb26b71a-b572-31c7-a539-c468efff1a2b",
                                "text": "To allow up to 250,000 passengers a day to move seamlessly between HS2, Elizabeth line and Great Western Main Line services, the station will have 53 lifts and 44 escalators across the 14 platforms."
                            }
                        ]
                    }
