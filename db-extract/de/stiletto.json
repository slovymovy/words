                                    },
                                    {
                                        "sense_id": "df672dd5-56df-3cef-be7e-f4768919f214",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "A woman's shoe with a tall, slender heel (called a stiletto heel)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dd41dbd4-143b-3529-9e5b-220ee313f873",
                                        "entry_id": "a0f9774f-139a-3c2b-9710-7d98c12a750c",
                                        "glosses": [
                                            "A beard trimmed into a pointed form."
                                        ],
                                        "tags": [
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa55d2c-4166-472a-9e60-073b8cba52a4",
                                                "sense_id": "dd41dbd4-143b-3529-9e5b-220ee313f873",
                                                "text": "The very quaik of faſhions, the very hee that / VVeares a Steletto on his chinne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stiletto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb69d226-2cd4-37f3-acab-57ac5c59d1b6",
                                        "entry_id": "91b8a9f2-aa87-3a7a-93d8-01904399cf4a",
                                        "glosses": [
                                            "To attack or kill with a stiletto (dagger)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff8c9221-a653-4c8e-9735-8eddaf365fa1",
                                                "sense_id": "fb69d226-2cd4-37f3-acab-57ac5c59d1b6",
                                                "text": "The recollection of former atrocities by the populace in plundering the city and stilettoing the inhabitants, is sufficiently fresh in the remembrance of the government to serve as an additional stimulus to prevent similar disorders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46f09575-2d71-402e-93b1-88fe23446da3",
                        "source_entry_id": "e5df076f-70f9-31f7-af51-087dacea7213",
                        "source_sense_id": "7ed3b0e7-3142-3611-a52d-ead1b7bf003e",
                        "source_sense_description": "Damenschuh mit besonders hohem, dünnem Absatz",
                        "target_lang_word": "talon aiguille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talon aiguille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25846c5d-4efc-3c32-bafd-f70027be714d",
                                        "entry_id": "c570a296-d6d7-3cfd-9a43-6ecfcb869df8",
                                        "glosses": [
                                            "Talon d’une chaussure, haut et mince."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df487d56-a48b-4499-a6dd-32caaba1a7df",
                                                "sense_id": "25846c5d-4efc-3c32-bafd-f70027be714d",
                                                "text": "Elle Macpherson se juche sur une paire de sandales à très fines lanières et talons aiguilles vertigineux, de quoi apporter une bonne dose de glamour et de féminité à la combinaison pantalon."
                                            },
                                            {
                                                "example_id": "324107c5-24a4-4a78-a208-60ab999443a7",
                                                "sense_id": "25846c5d-4efc-3c32-bafd-f70027be714d",
                                                "text": "Et le sociologue Frédéric Godart, qui travaille aussi sur le talon haut, d’ajouter : « La nouvelle génération explique que, dans l’objectif d’obtenir l’égalité, la femme peut faire usage de toutes les armes de séduction dont elle dispose, dont les talons aiguilles. »"
                                            },
                                            {
                                                "example_id": "82a99ab0-9e40-4f04-ba9d-9a67a4350d4b",
                                                "sense_id": "25846c5d-4efc-3c32-bafd-f70027be714d",
                                                "text": "L’acteur explique : « C'est une femme qui sait très bien filmer les hommes (...) et sa manière de mener une grosse équipe, on pourrait dire que c'est une autorité en talons aiguilles »."
                                            },
                                            {
                                                "example_id": "a7c232f5-0dc1-45a2-a077-be03dd85e9bf",
                                                "sense_id": "25846c5d-4efc-3c32-bafd-f70027be714d",
                                                "text": "Tu sais ce qu'un homme préfère entre une bonne fille de ferme et une pétasse sur talons aiguilles ? Aucune des deux, poursuivit-il sans attendre de réponse. Il a de l'affection pour la première et du désir pour la seconde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c32b0e08-6209-3af1-8c0a-3325055a8d5c",
                                        "entry_id": "c570a296-d6d7-3cfd-9a43-6ecfcb869df8",
                                        "glosses": [
                                            "Chaussure élevée par un tel talon."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e0f2691-b74c-43fe-a2f1-f47dd8392c7b",
                                                "sense_id": "c32b0e08-6209-3af1-8c0a-3325055a8d5c",
                                                "text": "Soi-disant c'était la ministre des Jeunes et du Sport (Michèle Alliot-Marie). Tu aurais vu la yeuve(vieille), elle était habillée en tailleur et en talons aiguilles. Tu avais dix keums pour surveiller son keuss (sac)."
                                            },
                                            {
                                                "example_id": "dc04f419-17a2-411a-9a3a-597207b41995",
                                                "sense_id": "c32b0e08-6209-3af1-8c0a-3325055a8d5c",
                                                "text": "Dans cette « marche des salopes » convoquée sur Internet, se mélangeaient des hommes vêtus en femmes et des femmes en soutien-gorge, short et talons aiguilles, la bouche maquillée en rouge vif."
                                            },
                                            {
                                                "example_id": "2a767b17-9ca9-41b4-ac9b-f9495f98b92b",
                                                "sense_id": "c32b0e08-6209-3af1-8c0a-3325055a8d5c",
                                                "text": "Dans ce monde-là, on ne dit jamais « j’ai du mal à marcher sur des talons aiguille », mais « prête-moi tes stillettos, y sont trop top »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
