                        "glosses": [
                            "gelijkend op, of eigenschappen hebbend van circus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e463f7e6-8e9e-42d7-81fc-464c2724d6a4",
                                "sense_id": "52bd3731-5d83-3507-9348-156f164e394e",
                                "text": "Vanaf het circusachtige geschetter van de aanvang werkte de muziek rechtstreeks elektriserend op mijn benen, mijn nekwervels, mijn maagstreek; denken kon ik niet meer; ik wist alleen, dat het veel te vlug voorbijging, dat ik deze klanken twintigmaal achtereen zou moeten beluisteren, al zou ik waarschijnlijk dood zijn tegen dat het helemaal afgelopen was (uit: De Koperentuin van Simon Vestdijk)."
                            }
                        ]
                    }
