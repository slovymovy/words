                                        "glosses": [
                                            "Large, grand and imposing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7ffb81a-3323-3f3a-876c-db644912b88f",
                                        "entry_id": "6df1f02f-9c6d-370f-9e10-506b011f93c7",
                                        "glosses": [
                                            "Taking a great amount of time and effort to complete."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aec4a377-12b2-4df5-967b-d6e0ec79c5c0",
                                                "sense_id": "a7ffb81a-3323-3f3a-876c-db644912b88f",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            },
                                            {
                                                "example_id": "72136c89-438d-4634-945e-9c96ee0c5617",
                                                "sense_id": "a7ffb81a-3323-3f3a-876c-db644912b88f",
                                                "text": "a monumental task"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea6a15e2-6215-365f-9118-eccc30d0ff86",
                                        "entry_id": "6df1f02f-9c6d-370f-9e10-506b011f93c7",
                                        "glosses": [
                                            "Relating to monuments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bd1c88d-0fae-40b2-8bc7-e0a2b7458bc0",
                                                "sense_id": "ea6a15e2-6215-365f-9118-eccc30d0ff86",
                                                "text": "Monumental construction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcb068e0-5164-4fdf-87fe-f6f6f1288cee",
