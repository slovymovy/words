{
    "word_family": [
        "wargowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d80b4b0b-d58f-322e-99d7-660db498ad05",
                    "sense_definition": "miękka część ciała otaczająca otwór gębowy",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziewczyna pomalowała swoje <w>wargi</w> czerwoną szminką przed wyjściem na spotkanie.",
                            "target_lang_translations": {
                                "ru": "Девушка накрасила свои <w>губы</w> красной помадой перед выходом на встречу."
                            }
                        },
                        {
                            "text": "Podczas zimnego wiatru jej <w>wargi</w> stały się suche i popękane.",
                            "target_lang_translations": {
                                "ru": "Из-за холодного ветра её <w>губы</w> стали сухими и потрескавшимися."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spierzchnięte wargi",
                        "pomalowane wargi"
                    ],
                    "target_lang_definitions": {
                        "ru": "мягкая часть тела, окружающая ротовое отверстие"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губа",
                                "target_lang_sense_clarification": "анатомическая часть лица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c856823f-98b7-3bde-b077-b1da8f4715c2",
                    "sense_definition": "część ubrania, np. płaszcza lub sukni",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "odzież",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złapał za <w>wargę</w> płaszcza, próbując się szybciej ubrać.",
                            "target_lang_translations": {
                                "ru": "Он схватился за <w>полу</w> пальто, пытаясь быстрее одеться."
                            }
                        },
                        {
                            "text": "Wiatr mocno szarpał za <w>wargi</w> jej długiego, wełnianego płaszcza.",
                            "target_lang_translations": {
                                "ru": "Ветер сильно трепал <w>полы</w> её длинного шерстяного пальто."
                            }
                        }
                    ],
                    "synonyms": [
                        "poła"
                    ],
                    "target_lang_definitions": {
                        "ru": "край одежды, например, пальто или платья"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пола",
                                "target_lang_sense_clarification": "нижняя часть одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1beac03c-dab1-3122-a139-2afda6cb7399",
                    "sense_definition": "element budowy korony niektórych kwiatów",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dolna <w>warga</w> kwiatu storczyka służy jako lądowisko dla owadów zapylających.",
                            "target_lang_translations": {
                                "ru": "Нижняя <w>губа</w> цветка орхидеи служит посадочной площадкой для насекомых-опылителей."
                            }
                        },
                        {
                            "text": "Budowa kwiatu szałwii charakteryzuje się wyraźnie wykształconą górną i dolną <w>wargą</w>.",
                            "target_lang_translations": {
                                "ru": "Строение цветка шалфея характеризуется чётко выраженными верхней и нижней <w>губой</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "элемент строения венчика некоторых цветов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губа",
                                "target_lang_sense_clarification": "в ботанике: часть цветка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d64003c6-4cea-3791-a4b0-72d560f87dd5",
                    "sense_definition": "część aparatu gębowego owadów",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "U wielu owadów dolna <w>warga</w> stanowi element zamykający otwór gębowy od dołu.",
                            "target_lang_translations": {
                                "ru": "У многих насекомых нижняя <w>губа</w> представляет собой элемент, закрывающий ротовое отверстие снизу."
                            }
                        },
                        {
                            "text": "Badania mikroskopowe wykazały specyficzną budowę <w>wargi</w> u tego gatunku chrząszcza.",
                            "target_lang_translations": {
                                "ru": "Микроскопические исследования выявили специфическое строение <w>губы</w> у этого вида жука."
                            }
                        }
                    ],
                    "synonyms": [
                        "fafle"
                    ],
                    "target_lang_definitions": {
                        "ru": "часть ротового аппарата насекомых"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губа",
                                "target_lang_sense_clarification": "в энтомологии: часть ротового аппарата"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9c9890a8-940a-35c3-a557-59b5dbef9b0b",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwiska",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Warga</w> przyszedł dzisiaj do urzędu złożyć wniosek.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Варга</w> пришёл сегодня в учреждение подать заявление."
                            }
                        },
                        {
                            "text": "Wczoraj rozmawiałem z profesorem <w>Wargą</w> o jego najnowszej publikacji.",
                            "target_lang_translations": {
                                "ru": "Вчера я разговаривал с профессором <w>Варгой</w> о его последней публикации."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Варга",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b37376a5-85b3-3ca7-851e-d1967236d7e6",
                    "sense_definition": "polskie nazwisko żeńskie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwiska",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani Anna <w>Warga</w> prowadzi dzisiaj to ważne spotkanie.",
                            "target_lang_translations": {
                                "ru": "Госпожа Анна <w>Варга</w> ведёт сегодня эту важную встречу."
                            }
                        },
                        {
                            "text": "Wysłaliśmy zaproszenie do pani <w>Wargi</w> na konferencję naukową.",
                            "target_lang_translations": {
                                "ru": "Мы отправили приглашение госпоже <w>Варге</w> на научную конференцию."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская женская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Варга",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
