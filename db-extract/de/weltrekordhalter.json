                "senses": [
                    {
                        "sense_id": "2f99bfc4-c7be-347b-b3ff-e909e6e430c3",
                        "entry_id": "ad834c10-144f-3494-a543-02db4a551240",
                        "glosses": [
                            "jemand, der einen Weltrekord hält; der einen Weltrekord innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f1cdbbf-3e76-4b59-a854-9e41db9d2827",
                                "sense_id": "2f99bfc4-c7be-347b-b3ff-e909e6e430c3",
                                "text": "Bei diesem Turnier wird auch der Weltrekordhalter antreten."
                            },
                            {
                                "example_id": "e96b1e01-426d-42c8-81b5-2edf5aa62c0e",
                                "sense_id": "2f99bfc4-c7be-347b-b3ff-e909e6e430c3",
                                "text": "„Boris Nikolai Konrad, geboren 1984, ist Neurowissenschaftler, Weltmeister und Weltrekordhalter im Gedächtnissport.“"
                            },
                            {
                                "example_id": "b8e1f5d3-f03a-4fd4-9880-c70118940109",
                                "sense_id": "2f99bfc4-c7be-347b-b3ff-e909e6e430c3",
                                "text": "„Der frühere Weltrekordhalter blieb schon zum vierten Mal unter 2:04 Stunden - das hat noch kein anderer Läufer auf der 42,195 Kilometer langen Strecke geschafft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
