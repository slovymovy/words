                "senses": [
                    {
                        "sense_id": "aef36c5d-32c1-34d2-833d-182a3eacebc0",
                        "entry_id": "4d8a073c-1f3f-32fa-a39b-e5b3321b96a8",
                        "glosses": [
                            "Huche à pain, maie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca81ebc-9a74-4300-8135-fd835ae71949",
                                "sense_id": "aef36c5d-32c1-34d2-833d-182a3eacebc0",
                                "text": "Enfin, un jour, la mère fut dépouillée de tout. Pendant une pêche de son père, le fils emporta le buffet, la mette, les draps, le linge, ne laissa que les quatre murs, il avait tout vendu pour aller faire ses frigousses à Nantes."
                            },
                            {
                                "example_id": "1a54c7ed-9fb7-4661-a371-c6bebc1180b5",
                                "sense_id": "aef36c5d-32c1-34d2-833d-182a3eacebc0",
                                "text": "Il ouvrit la mette où était la farine, lui en donna une mesure, et ajouta quelques onces de beurre au morceau qu’il avait déjà coupé."
                            }
                        ]
                    }
                ],
