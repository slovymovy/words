{
    "word_family": [
        "inleg",
        "inlegger",
        "inlegging",
        "inlegzool"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b1a3bf8f-d187-3f83-9b57-756c01931a0a",
                    "sense_definition": "geld storten, toevoegen of investeren in een gezamenlijk fonds of project",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elke investeerder <w>legde</w> honderdduizend euro <w>in</w> om het nieuwe bedrijf te starten.",
                            "target_lang_translations": {
                                "en": "Every investor <w>contributed</w> one hundred thousand euros to start the new company."
                            }
                        },
                        {
                            "text": "Als we allemaal tien euro <w>inleggen</w>, kunnen we vanavond samen wat pizza's halen.",
                            "target_lang_translations": {
                                "en": "If we all <w>chip in</w> ten euros, we can get some pizzas together tonight."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geld inleggen",
                        "een bedrag inleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "to deposit, contribute, or invest money into a joint fund or project"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to contribute",
                                "target_lang_sense_clarification": "money to a shared fund"
                            },
                            {
                                "target_lang_word": "to chip in",
                                "target_lang_sense_clarification": "informal contribution of money"
                            },
                            {
                                "target_lang_word": "to invest",
                                "target_lang_sense_clarification": "putting money into a venture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "057d415c-7871-326a-ac4d-336d3ee6d32a",
                    "sense_definition": "iets binnenin of tussen andere dingen plaatsen of leggen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de nieuwe zooltjes voorzichtig in je schoenen <w>inleggen</w> voor meer comfort.",
                            "target_lang_translations": {
                                "en": "You should carefully <w>insert</w> the new insoles into your shoes for more comfort."
                            }
                        },
                        {
                            "text": "De bibliothecaris zal een bladwijzer in het boek <w>inleggen</w> om de pagina te onthouden.",
                            "target_lang_translations": {
                                "en": "The librarian will <w>put</w> a bookmark <w>in</w> the book to remember the page."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to place or lay something inside or between other things"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to insert",
                                "target_lang_sense_clarification": "to put something inside something else"
                            },
                            {
                                "target_lang_word": "to put in",
                                "target_lang_sense_clarification": "to place inside"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e1cfb46-d7bf-3455-a427-6b750fa21733",
                    "sense_definition": "voedsel conserveren door het in azijn, zout water of suiker te bewaren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conserveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>ingelegde</w> groente bewaar ik in glazen potten in de koele kelder.",
                            "target_lang_translations": {
                                "en": "I keep the <w>pickled</w> vegetables in glass jars in the cool cellar."
                            }
                        },
                        {
                            "text": "In de zomer gaan we vaak augurken <w>inleggen</w> om ze de hele winter te kunnen eten.",
                            "target_lang_translations": {
                                "en": "In the summer we often <w>pickle</w> gherkins so we can eat them all winter."
                            }
                        }
                    ],
                    "synonyms": [
                        "inmaken"
                    ],
                    "common_phrases": [
                        "augurken inleggen",
                        "groenten inleggen"
                    ],
                    "target_lang_definitions": {
                        "en": "to preserve food by keeping it in vinegar, salt water, or sugar"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pickle",
                                "target_lang_sense_clarification": "preserving in brine or vinegar"
                            },
                            {
                                "target_lang_word": "to preserve",
                                "target_lang_sense_clarification": "general food preservation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f939298-0684-337f-9768-12d7d9f726d5",
                    "sense_definition": "versieren door materialen zoals edelstenen of hout in een oppervlak te vatten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decoratie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze gouden ring is prachtig <w>ingelegd</w> met een kleine diamant en een robijn.",
                            "target_lang_translations": {
                                "en": "This gold ring is beautifully <w>inlaid</w> with a small diamond and a ruby."
                            }
                        },
                        {
                            "text": "De antieke tafel was stijlvol <w>ingelegd</w> met verschillende soorten lichtgekleurd hout.",
                            "target_lang_translations": {
                                "en": "The antique table was stylishly <w>inlaid</w> with different types of light-colored wood."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ingelegd met"
                    ],
                    "target_lang_definitions": {
                        "en": "to decorate by embedding materials such as gemstones or wood into a surface"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to inlay",
                                "target_lang_sense_clarification": "embedding decorative materials"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d031e13e-ffb3-30c5-96a0-df68dec1dbed",
                    "sense_definition": "iets abstracts zoals eer of roem verkrijgen door een bepaalde prestatie",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "prestatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge wetenschapper wist met zijn nieuwe ontdekking veel eer <w>in</w> te <w>leggen</w>.",
                            "target_lang_translations": {
                                "en": "The young scientist managed to <w>gain</w> much honor with his new discovery."
                            }
                        },
                        {
                            "text": "Zij hopen met dit gewaagde project veel roem <w>in</w> te <w>leggen</w> bij het publiek.",
                            "target_lang_translations": {
                                "en": "They hope to <w>win</w> much fame with the public with this daring project."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eer inleggen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in de uitdrukking 'eer inleggen'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to gain something abstract like honor or fame through a specific achievement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to gain",
                                "target_lang_sense_clarification": "to acquire honor or fame"
                            },
                            {
                                "target_lang_word": "to win",
                                "target_lang_sense_clarification": "to earn recognition"
                            }
                        ]
                    }
                }
            ]
        },
