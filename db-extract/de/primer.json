                                        "sense_id": "ad792110-84d8-382e-addc-d5c9c531e07d",
                                        "entry_id": "a859c809-ddd4-39cd-8130-89548c3dd9d4",
                                        "glosses": [
                                            "A prayer or devotional book intended for laity, initially an abridgment of the breviary and manual including the hours of the Virgin Mary, 15 gradual and 7 penitential psalms, the litany, the placebo and dirige forming the office of the dead, and the commendations."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8642fb24-506d-3f66-8c93-ccb83e86cda4",
                                        "entry_id": "a859c809-ddd4-39cd-8130-89548c3dd9d4",
                                        "glosses": [
                                            "Any of various similar works issued in England for private prayer in accordance with the Book of Common Prayer."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66b607db-d894-3510-856c-cc78c2e994d6",
                                        "entry_id": "a859c809-ddd4-39cd-8130-89548c3dd9d4",
                                        "glosses": [
                                            "A children's book intended to teach literacy: how to read, write, and spell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9abd265c-08d6-4715-9be0-185124461bf8",
                                                "sense_id": "66b607db-d894-3510-856c-cc78c2e994d6",
                                                "text": "Four-year-old Elizabeth Finkle-McGraw would receive the Young Lady's Illustrated Primer from her grandfather. Fiona Hackworth would be getting a copy of the Illustrated Primer too, for this had been John Percival Hackworth's crime: He had programmed the matter compiler to place the cockleburs on the outside of Elizabeth's book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c02020-3502-3ba2-ba3d-5e2eec65d9e1",
                                        "entry_id": "a859c809-ddd4-39cd-8130-89548c3dd9d4",
                                        "glosses": [
                                            "An introductory text on any subject, particularly basic concepts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a78b16a6-674f-4a4f-8f25-d58b825af3c5",
                                                "sense_id": "46c02020-3502-3ba2-ba3d-5e2eec65d9e1",
                                                "text": "[...] The two assets of the book are clear explanation, and a multitude of extremely helpful diagrams, some in two colours, and cutaway photographs; these clearly unravel a difficult subject for the layman, as well as the student engineman for whom the primer is chiefly designed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a46a2cb-d2b2-34cb-8edf-775ceb3414ec",
                                        "entry_id": "a859c809-ddd4-39cd-8130-89548c3dd9d4",
                                        "glosses": [
                                            "An elementary school class; an elementary school student."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "primer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1515431c-6050-37ea-9188-6e00cfe4cb09",
                                        "entry_id": "24a17946-347b-3433-87c5-5665ca91f7b2",
                                        "glosses": [
                                            "Any substance or device, such as priming wire or blasting cap, used to ignite gunpowder or other explosive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6387f781-d4da-4d2f-9a5a-f039ff4bc6ca",
                                                "sense_id": "1515431c-6050-37ea-9188-6e00cfe4cb09",
                                                "text": "The percussion primer, known as the “ 110-grain percussion primer,” contains an igniting charge of 95 grains of black powder in addition to the essential elements of a percussion primer."
                                            },
                                            {
                                                "example_id": "88cfdc0b-bc5b-4526-b968-b3023b2a37a7",
                                                "sense_id": "1515431c-6050-37ea-9188-6e00cfe4cb09",
                                                "text": "Therefore, the shotgun primer is quite self- contained. It consists of a separate metal cup called a battery cup that contains the primer itself. That's why it is considered a two-piece primer."
                                            },
                                            {
                                                "example_id": "06ab7d23-7847-4e0c-aedd-23fb4c06f70c",
                                                "sense_id": "1515431c-6050-37ea-9188-6e00cfe4cb09",
                                                "text": "Take care when handling primers, especially ensure that your fingers are free of oil or dirt. Oil can affect the detonating properties of the primer pellet, and can be the cause of misfires if too much oil gets into the primer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28426327-61e7-3618-b87e-9b4b2968d889",
                                        "entry_id": "24a17946-347b-3433-87c5-5665ca91f7b2",
                                        "glosses": [
                                            "A person who primes explosives."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
