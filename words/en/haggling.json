{
    "word_family": [
        "haggle",
        "haggler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b384f1a-30c1-3aba-ae76-fdeacd37464c",
                    "sense_definition": "The act of negotiating the price of something in a persistent or petty way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hours of <w>haggling</w>, we finally agreed on a price for the antique table.",
                            "target_lang_translations": {
                                "ru": "После нескольких часов <w>торга</w> мы наконец договорились о цене на антикварный стол."
                            }
                        },
                        {
                            "text": "The constant <w>haggling</w> over small details made the business meeting last much longer than expected.",
                            "target_lang_translations": {
                                "ru": "Постоянный <w>торг</w> из-за мелких деталей заставил деловую встречу длиться гораздо дольше, чем ожидалось."
                            }
                        }
                    ],
                    "synonyms": [
                        "bargaining",
                        "bartering"
                    ],
                    "common_phrases": [
                        "intense haggling",
                        "endless haggling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс упорного или мелочного торга о цене чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торг",
                                "target_lang_sense_clarification": "процесс обсуждения цены"
                            },
                            {
                                "target_lang_word": "торговля",
                                "target_lang_sense_clarification": "процесс спора о стоимости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ec602f2-c1cf-32b0-8a5c-18138a65a621",
                    "sense_definition": "Present participle and gerund of <w>haggle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They were <w>haggling</w> over the price of the car for nearly an hour.",
                            "target_lang_translations": {
                                "ru": "Они почти час <w>торговались</w> из-за цены на машину."
                            }
                        },
                        {
                            "text": "She is <w>haggling</w> with the shopkeeper to get a better deal on the souvenirs.",
                            "target_lang_translations": {
                                "ru": "Она <w>торгуется</w> с продавцом, чтобы получить более выгодную цену на сувениры."
                            }
                        }
                    ],
                    "synonyms": [
                        "bargaining",
                        "bartering"
                    ],
                    "common_phrases": [
                        "haggling over price"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is the present participle and gerund form of the verb haggle."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «торговаться»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торгующийся",
                                "target_lang_sense_clarification": "причастие, описывающее процесс"
                            },
                            {
                                "target_lang_word": "торгуясь",
                                "target_lang_sense_clarification": "деепричастие, описывающее действие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
