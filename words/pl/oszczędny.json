            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3d7a6695-63ef-306d-b53d-b790a3bcb5bd",
                    "sense_definition": "rozsądnie gospodarujący pieniędzmi lub majątkiem i nietrwoniący ich",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zarzadzanie_zasobami",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój brat jest bardzo <w>oszczędny</w> i odkłada część pensji na wakacje.",
                            "target_lang_translations": {
                                "ru": "Мой брат очень <w>экономен</w> и откладывает часть зарплаты на отпуск."
                            }
                        },
                        {
                            "text": "Tato zarabiał skromnie, ale matka była <w>oszczędna</w>, więc wystarczało nam na wszystko.",
                            "target_lang_translations": {
                                "ru": "Папа зарабатывал скромно, но мама была <w>бережливой</w>, поэтому нам на всё хватало."
                            }
                        }
                    ],
                    "synonyms": [
                        "nierozrzutny",
                        "skrzętny"
                    ],
                    "antonyms": [
                        "rozrzutny",
                        "nieoszczędny"
                    ],
                    "common_phrases": [
                        "oszczędny człowiek",
                        "bardzo oszczędny"
                    ],
                    "target_lang_definitions": {
                        "ru": "разумно расходующий деньги или имущество, не расточительный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экономный",
                                "target_lang_sense_clarification": "о человеке, бережливо расходующем деньги"
                            },
                            {
                                "target_lang_word": "бережливый",
                                "target_lang_sense_clarification": "заботливо и расчётливо относящийся к вещам и деньгам"
                            },
                            {
                                "target_lang_word": "расчётливый",
                                "target_lang_sense_clarification": "склонный к строгому учету расходов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6851507b-3c7a-3bb9-9748-4697d544f562",
                    "sense_definition": "taki, który zużywa niewiele energii, paliwa lub innych zasobów",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zarzadzanie_zasobami",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiliśmy nowy, bardziej <w>oszczędny</w> samochód, który spala mało paliwa w mieście.",
                            "target_lang_translations": {
                                "ru": "Мы купили новую, более <w>экономичную</w> машину, которая расходует мало топлива в городе."
                            }
                        },
                        {
                            "text": "W naszym biurze zainstalowano <w>oszczędne</w> żarówki, aby zmniejszyć comiesięczne rachunki.",
                            "target_lang_translations": {
                                "ru": "В нашем офисе установили <w>энергосберегающие</w> лампочки, чтобы снизить ежемесячные счета."
                            }
                        }
                    ],
                    "synonyms": [
                        "ekonomiczny",
                        "wydajny"
                    ],
                    "antonyms": [
                        "nieekonomiczny",
                        "kosztowny"
                    ],
                    "common_phrases": [
                        "oszczędny silnik",
                        "oszczędne auto"
                    ],
                    "target_lang_definitions": {
                        "ru": "расходующий мало энергии, топлива или других ресурсов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экономичный",
                                "target_lang_sense_clarification": "требующий мало затрат, выгодный в потреблении"
                            },
                            {
                                "target_lang_word": "экономный",
                                "target_lang_sense_clarification": "расходующий мало ресурсов (о технике)"
                            },
                            {
                                "target_lang_word": "энергосберегающий",
                                "target_lang_sense_clarification": "о лампах, приборах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73328030-7876-3daf-980a-83478dc45e67",
                    "sense_definition": "powściągliwy w okazywaniu emocji lub używaniu słów i gestów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "umiar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor był wyjątkowo <w>oszczędny</w> w słowach i rzadko chwalił swoich pracowników.",
                            "target_lang_translations": {
                                "ru": "Директор был исключительно <w>скуп</w> на слова и редко хвалил своих сотрудников."
                            }
                        },
                        {
                            "text": "Aktor stosował bardzo <w>oszczędne</w> gesty, co nadało jego postaci wyjątkowy spokój.",
                            "target_lang_translations": {
                                "ru": "Актёр использовал очень <w>сдержанные</w> жесты, что придало его персонажу исключительное спокойствие."
                            }
                        }
                    ],
                    "synonyms": [
                        "powściągliwy",
                        "umiarkowany"
                    ],
                    "common_phrases": [
                        "oszczędny w słowach",
                        "oszczędny w gestach"
                    ],
                    "target_lang_definitions": {
                        "ru": "сдержанный в проявлении эмоций или использовании слов и жестов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скупой",
                                "target_lang_sense_clarification": "сдержанный на слова, жесты или эмоции"
                            },
                            {
                                "target_lang_word": "сдержанный",
                                "target_lang_sense_clarification": "не проявляющий лишних чувств или движений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f1ba53d-a565-3267-8bab-0dddce10c1f7",
                    "sense_definition": "skromny, prosty i pozbawiony zbytecznych ozdób lub dodatków",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "umiar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Projektant wybrał niezwykle <w>oszczędny</w> styl, rezygnując ze wszystkich zbędnych dekoracji.",
                            "target_lang_translations": {
                                "ru": "Дизайнер выбрал чрезвычайно <w>лаконичный</w> стиль, отказавшись от всех лишних украшений."
                            }
                        },
                        {
                            "text": "Wnętrze mieszkania miało <w>oszczędny</w> wystrój, który sprzyjał skupieniu i odpoczynkowi.",
                            "target_lang_translations": {
                                "ru": "Интерьер квартиры имел <w>строгий</w> декор, способствовавший сосредоточенности и отдыху."
                            }
                        }
                    ],
                    "synonyms": [
                        "skromny",
                        "prosty",
                        "ascetyczny",
                        "niewymyślny",
                        "niewyszukany"
                    ],
                    "antonyms": [
                        "bogaty",
                        "okazały",
                        "wymyślny",
                        "wyszukany"
                    ],
                    "common_phrases": [
                        "oszczędny wystrój",
                        "oszczędna forma"
                    ],
                    "target_lang_definitions": {
                        "ru": "скромный, простой, лишенный лишних украшений или деталей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаконичный",
                                "target_lang_sense_clarification": "строгий, без лишних деталей в стиле или форме"
                            },
                            {
                                "target_lang_word": "строгий",
                                "target_lang_sense_clarification": "простой и без излишеств"
                            },
                            {
                                "target_lang_word": "сдержанный",
                                "target_lang_sense_clarification": "в дизайне или оформлении"
                            }
                        ]
                    }
                }
            ]
        }
