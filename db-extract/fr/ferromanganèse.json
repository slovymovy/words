            {
                "entry_id": "557a3dba-e56b-3eda-b3fe-0daa22c42858",
                "word": "ferromanganèse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e621f9fe-8064-4ba8-b1e5-e35fd59ac3c6",
                        "entry_id": "557a3dba-e56b-3eda-b3fe-0daa22c42858",
                        "tags": [
