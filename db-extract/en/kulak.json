                    {
                        "translation_id": "d17f9e04-4896-4ab1-8ba9-2e251f5e54b0",
                        "source_entry_id": "d18e6ccd-9d78-3c6a-b38c-766dc9eb70da",
                        "source_sense_id": "b347a4ed-b392-3cc9-85af-8f644c5c484b",
                        "source_sense_description": "prosperous peasant",
                        "target_lang_word": "кула́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кула́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9196a57d-98b5-33a7-aec6-90fcc72659e9",
                                        "entry_id": "338fb1a0-e1dc-31a5-8b2e-7970407aa918",
                                        "glosses": [
                                            "кисть руки с согнутыми и прижатыми к ладони пальцами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c2cbfa0-bb18-42ca-ae12-b64f36c7a306",
                                                "sense_id": "9196a57d-98b5-33a7-aec6-90fcc72659e9",
                                                "text": "Драгунский капитан, разгорячённый вином, ударил по столу кулаком, требуя внимания."
                                            },
                                            {
                                                "example_id": "ef13289a-7e12-4b72-9736-953f5913357f",
                                                "sense_id": "9196a57d-98b5-33a7-aec6-90fcc72659e9",
                                                "text": "Вместо ответа обезумевший чудак бросился на старика с кулаками; их едва розняли."
                                            },
                                            {
                                                "example_id": "8259f411-a4ae-496e-9032-218a8a2e1791",
                                                "sense_id": "9196a57d-98b5-33a7-aec6-90fcc72659e9",
                                                "text": "Я сунул руку в карман и крепко сжал платок в кулаке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "726f7e4d-7fef-3809-a116-f728512e4ff4",
                                        "entry_id": "338fb1a0-e1dc-31a5-8b2e-7970407aa918",
                                        "glosses": [
                                            "воен. сосредоточенные в одном месте для решительного удара войска"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb0e89e-3360-4c95-bf0e-a8f56540d316",
                                                "sense_id": "726f7e4d-7fef-3809-a116-f728512e4ff4",
                                                "text": "Собрав в ударный кулак мотопехоту, танки и авиацию, гитлеровцы атаковали наши оборонительные рубежи."
                                            },
                                            {
                                                "example_id": "a8a43f54-ec5c-41f1-a7bd-281fd5236dda",
                                                "sense_id": "726f7e4d-7fef-3809-a116-f728512e4ff4",
                                                "text": "Опыт боёв с частями фашистской Германии показал, что наши танковые части в результате неправильного боевого использования их со стороны общевойсковых командиров и штабов, которым придавались эти соединения, несли потери и целиком не использовали мощь танкового кулака."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e496e284-3d33-3690-a831-e4fb39a70002",
                                        "entry_id": "338fb1a0-e1dc-31a5-8b2e-7970407aa918",
                                        "glosses": [
                                            "техн. приспособление в форме выступа для крепления двух или более основных частей какого-либо механизма, толчками приводящее механизмы в движение"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12ebcb82-cbbb-3ad7-8702-6a63612b3444",
                                        "entry_id": "338fb1a0-e1dc-31a5-8b2e-7970407aa918",
                                        "glosses": [
                                            "прост. группа тесно расположенных, почти сросшихся сёл или посёлков"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "кула́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0d675dd-e4b0-3038-a54a-e01f88e0b4a0",
                                        "entry_id": "08e6d7db-fd08-3fad-a4b5-7d1a964d6018",
                                        "glosses": [
                                            "истор. зажиточный крестьянин-собственник, использующий наёмный труд батраков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db18e60-bdfe-4341-9fc7-d599e88e8739",
                                                "sense_id": "b0d675dd-e4b0-3038-a54a-e01f88e0b4a0",
                                                "text": "Ясное дело, что он кулак в прошлом, но сейчас работает добросовестно, наверное побаивается за своё прошлое…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4c39269-2782-3306-bc2c-797265a32c7f",
