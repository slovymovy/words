                    }
                ],
                "senses": [
                    {
                        "sense_id": "09f437ad-716f-3233-be0f-7469f2379815",
                        "entry_id": "f543be9b-3de1-3026-a779-e2eec618d9f3",
                        "glosses": [
                            "To withdraw or retract (something told); to never have told."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "568a5bf0-6801-437a-a304-f067d099bf96",
                                "sense_id": "09f437ad-716f-3233-be0f-7469f2379815",
                                "text": "Narrative untells itself by multiplying itself into discontinuous \"turns\" that cannot be resolved into a continuous story."
                            },
                            {
                                "example_id": "6102c3f2-f1cb-4f3f-9ebb-5ac8eab0b7c3",
                                "sense_id": "09f437ad-716f-3233-be0f-7469f2379815",
                                "text": "Trinh (1991) writes that untelling the stories of privilege and marginality is a form of displacement that takes a long time."
                            },
                            {
                                "example_id": "aa8ade3b-a210-4642-a6ed-bc89a27aa825",
                                "sense_id": "09f437ad-716f-3233-be0f-7469f2379815",
                                "text": "And once his story was told, it was told; there was no way to untell it, no way to make himself look good."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c8cd95e-8757-3821-906f-6ffb8993af31",
                        "entry_id": "f543be9b-3de1-3026-a779-e2eec618d9f3",
                        "glosses": [
                            "To undo or reverse the counting of; to count back."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6c4d5c03-67d2-4c4f-be49-9d97733fe2c8",
                                "sense_id": "5c8cd95e-8757-3821-906f-6ffb8993af31",
                                "text": "That Time could turn up his swift sandy glass, / To untell the days, and to redeem these hours."
                            }
                        ]
                    }
                ],
