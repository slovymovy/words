                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "autorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le haut <w>commandement</w> a validé le plan stratégique proposé par les conseillers militaires."
                        },
                        {
                            "text": "Une réunion d'urgence a rassemblé les membres du <w>commandement</w> des armées hier soir."
                        }
                    ],
                    "synonyms": [
