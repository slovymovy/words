                "senses": [
                    {
                        "sense_id": "f21c65e4-7fab-3a7e-8d69-dda14d35a0b5",
                        "entry_id": "5ce342b4-f2b3-3a44-b0a6-eb8d7e0323d4",
                        "glosses": [
                            "ботан. травянистое растение семейства Зонтичные (Anthríscus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd4126a-80a3-4073-9391-618664cdf2ce",
                                "sense_id": "f21c65e4-7fab-3a7e-8d69-dda14d35a0b5",
                                "text": "Около мастерских росли купыри и лопухи, теперь одеревеневшие от старости."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6826e66a-717d-4ebe-970b-9d2ddb1f617c",
                        "source_entry_id": "5ce342b4-f2b3-3a44-b0a6-eb8d7e0323d4",
                        "source_sense_id": "f21c65e4-7fab-3a7e-8d69-dda14d35a0b5",
                        "target_lang_word": "beakchervil",
                        "target_lang_code": "en",
