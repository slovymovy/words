                                        "entry_id": "5b829334-9d33-3178-99c3-6e42c47c25b3",
                                        "glosses": [
                                            "Großamt des Oberfeldherrn des französischen Königs ab dem 12. Jahrhundert bis 1627"
                                        ],
                                        "tags": [
                                            "Militärgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22049d66-ca40-4415-bdc8-0c746d42ded9",
                                                "sense_id": "9f991a7e-7f4f-3bb0-aa67-db9250f33bbe",
                                                "text": "Das Großamt des Konnetabels wurde 1627 durch Kardinal Richelieu abgeschafft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b3f6fb9-4284-33be-b82d-8d2fc7ad970f",
                                        "entry_id": "5b829334-9d33-3178-99c3-6e42c47c25b3",
                                        "glosses": [
                                            "Träger des Amtes des Konnetabels"
                                        ],
                                        "tags": [
                                            "Militärgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7beea56-e643-491b-bc20-102ee30be6f4",
                                                "sense_id": "3b3f6fb9-4284-33be-b82d-8d2fc7ad970f",
                                                "text": "„Der zuständige Konnetabel befiehlt die Aufnahme in Andujar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
