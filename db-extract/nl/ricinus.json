                        "translation_id": "f90e06ac-8f29-40a2-8566-6f73bd3c12a8",
                        "source_entry_id": "310a2016-fba7-32d3-baeb-ee648db4d349",
                        "source_sense_id": "be4324e8-9306-3a3e-aa15-f981d4f88cda",
                        "source_sense_description": "een snelgroeiende tropische boom uit de wolfsmelkfamilie",
                        "target_lang_word": "ricin",
