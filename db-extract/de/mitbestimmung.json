                        "cross_references": [
                            {
                                "target_word": "cogestion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb558c3e-789c-385a-910e-54d9ad20dc56",
                                        "entry_id": "4793b211-f1bf-3003-9481-8b723f0347f9",
                                        "glosses": [
                                            "Système de direction décentralisée dans lequel les représentants du personnel exercent la gestion de l’entreprise conjointement avec les représentants du capital."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fe95692-5cb2-4431-a9f0-c811ec75adc1",
                                                "sense_id": "cb558c3e-789c-385a-910e-54d9ad20dc56",
                                                "text": "La cogestion est surtout utilisée en Allemagne."
                                            },
                                            {
                                                "example_id": "3db39de8-3dab-4d6e-860d-538e37758938",
                                                "sense_id": "cb558c3e-789c-385a-910e-54d9ad20dc56",
                                                "text": "Il faut dire que cette usine américaine est la seule, parmi les 105 que Volkswagen compte dans le monde, qui ne soit pas syndiquée. Il faut dire aussi que dans chacune des 104 autres usines, on trouve un conseil de cogestion, constitué à parts égales de représentants patronaux et syndicaux, qui ne se prononce pas sur les salaires, mais fixe, entre autres, les règles en matière d’heures de travail, de vacances et de procédure de mises à pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a7e4e0-2918-32be-b61d-7603817cc9a7",
                                        "entry_id": "4793b211-f1bf-3003-9481-8b723f0347f9",
                                        "glosses": [
                                            "Dans une université, régime de gestion partagée entre les administrateurs, les professeurs et les étudiants."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5ed23ad-c001-411f-a217-ba51a90b2843",
                                                "sense_id": "21a7e4e0-2918-32be-b61d-7603817cc9a7",
                                                "text": "Les militants felquistes ne croient évidemment pas à la participation des étudiants aux divers comités universitaires qui entretiennent l'illusion d'une cogestion de l'établissement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
