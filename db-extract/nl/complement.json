                                        "sense_id": "bbe7f6c4-9115-3fa5-ba1d-ed787a3865db",
                                        "entry_id": "15f5041e-f002-3c1b-9467-e6e2378a8f6b",
                                        "glosses": [
                                            "The act of completing something, or the fact of being complete; completion, completeness, fulfilment."
                                        ],
