        "fr-extract.jsonl": [
            {
                "entry_id": "74878d0a-61f7-3cd4-a7d9-2fd612d1bf80",
                "word": "relâchement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "64765223-52ae-45fe-85a3-fe9a7b559a89",
                        "entry_id": "74878d0a-61f7-3cd4-a7d9-2fd612d1bf80",
                        "tags": [
                            "plural"
                        ],
                        "form": "relâchements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f098ae65-7c90-3d6a-b289-689df48502ff",
                        "entry_id": "74878d0a-61f7-3cd4-a7d9-2fd612d1bf80",
                        "glosses": [
                            "État d’une chose qui devient moins tendue qu’elle n’était, qui a perdu de son ressort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b629eda0-c8bf-4d83-a00a-e36a69f0e203",
                                "sense_id": "f098ae65-7c90-3d6a-b289-689df48502ff",
                                "text": "Lorsqu'un relâchement se manifeste, et surtout pendant l'été, les champs de glace se brisent, […]."
                            },
                            {
                                "example_id": "ad7595de-4a52-4b7f-a8d6-15936dc22171",
                                "sense_id": "f098ae65-7c90-3d6a-b289-689df48502ff",
                                "text": "Le relâchement des cordes d’un violon."
                            },
                            {
                                "example_id": "2b0d484a-2dd4-459a-8f5f-599e73aac1d8",
                                "sense_id": "f098ae65-7c90-3d6a-b289-689df48502ff",
                                "text": "— Le relâchement du ventre."
                            }
                        ]
                    },
                    {
                        "sense_id": "667cacc1-03e7-3821-8549-9ac49739c297",
                        "entry_id": "74878d0a-61f7-3cd4-a7d9-2fd612d1bf80",
                        "glosses": [
                            "Diminution de l’effort, de la vigueur, de la régularité, de la sévérité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "8130a181-00dc-4668-acb7-6ec5e7838a6c",
                                "sense_id": "667cacc1-03e7-3821-8549-9ac49739c297",
                                "text": "François-Noël Buffet estime que « cette détérioration s’explique par un relâchement inacceptable des comportements au volant. Alors que plus de 9 accidents sur 10 résultent d’une faute humaine, le bon sens et le respect des règles élémentaires de prudence restent les premiers garants de la sécurité sur nos routes »."
                            },
                            {
                                "example_id": "5c853acc-3530-4335-987d-11c05df3205e",
                                "sense_id": "667cacc1-03e7-3821-8549-9ac49739c297",
                                "text": "Lors même que l’arrivée du grand maître n’eût pas été si soudaine et si inattendue, il n’y aurait rien eu à Templestowe qui eût décelé un relâchement de discipline, […]."
                            },
                            {
                                "example_id": "821c90b1-cd0b-40f2-bd40-e213b0c1b246",
                                "sense_id": "667cacc1-03e7-3821-8549-9ac49739c297",
                                "text": "La marquise avait perdu sa mère en bas âge, et son éducation fut naturellement influencée par le relâchement qui, pendant la révolution, dénoua les liens religieux en France."
                            },
                            {
                                "example_id": "6809aa4b-9a5a-4827-b1ed-58353211349a",
                                "sense_id": "667cacc1-03e7-3821-8549-9ac49739c297",
                                "text": "Le relâchement du lien vassalitique est une des causes de la défaite finale du Midi et de son suzerain, le comte de Toulouse."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbedaaee-dad3-322f-822c-9a01d16f6e73",
                        "entry_id": "74878d0a-61f7-3cd4-a7d9-2fd612d1bf80",
                        "glosses": [
                            "Délassement ; état de repos ; utile cessation de travail ou d’exercice."
                        ],
                        "tags": [
                            "En bonne part"
                        ],
                        "examples": [
                            {
                                "example_id": "fc72a4a4-a80f-4ddc-bd44-799a747f2b70",
                                "sense_id": "dbedaaee-dad3-322f-822c-9a01d16f6e73",
                                "text": "Après une grande contention d’esprit, on a besoin de quelque relâchement."
                            },
                            {
                                "example_id": "e8e3e8f7-0d9b-4338-ae7d-0f5a76b1d957",
                                "sense_id": "dbedaaee-dad3-322f-822c-9a01d16f6e73",
                                "text": "Épuisée par une longue résistance, elle s’abandonnait au plaisir physique du relâchement."
                            }
                        ]
                    },
                    {
                        "sense_id": "af9f6c35-d0a7-3860-8a9f-1f9e05962f9a",
                        "entry_id": "74878d0a-61f7-3cd4-a7d9-2fd612d1bf80",
                        "glosses": [
                            "Relargage."
                        ],
                        "tags": [
                            "Parfois"
                        ],
                        "examples": [
                            {
                                "example_id": "4570dea8-a389-481c-bfd1-a76a1dcfa324",
                                "sense_id": "af9f6c35-d0a7-3860-8a9f-1f9e05962f9a",
                                "text": "En outre, contrairement à celui de Tchernobyl, ils sont munis d'une enceinte de confinement, qui restreindrait le relâchement de la radioactivité en cas d'accident grave."
                            }
                        ]
                    }
                ],
