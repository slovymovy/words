                ],
                "senses": [
                    {
                        "sense_id": "ec4ff488-8b0e-3de0-8aba-82fde6f245fb",
                        "entry_id": "57c9448b-3936-3645-af3f-ac9bb6f19bda",
                        "glosses": [
                            "akustische Kommunikation der Wale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "febed371-05ae-466b-9d02-fc908c2120af",
                                "sense_id": "ec4ff488-8b0e-3de0-8aba-82fde6f245fb",
                                "text": "„Walgesang wird selten per Kontaktmikrofon als Körperschall eines einzelnen Wals aufgenommen, zumeist jedoch als Wasserschall durch ein Unterwassermikrofon, womit der Schall mehrerer Wale empfangen wird, umso lauter, je näher sich ein Individuum zum Mikrofon befindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd50c9c6-0a26-4b69-8e52-333d2a080163",
                        "source_entry_id": "57c9448b-3936-3645-af3f-ac9bb6f19bda",
                        "source_sense_id": "ec4ff488-8b0e-3de0-8aba-82fde6f245fb",
                        "source_sense_description": "Zoologie: akustische Kommunikation der Wale",
                        "target_lang_word": "whale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b4a7ad2-b950-3b89-992a-47937e78ba1a",
                                        "entry_id": "7ed32bcd-d6b5-3c1b-b1e4-da0a1a31b0ae",
                                        "glosses": [
                                            "Any one of numerous large marine mammals comprising an informal group within infraorder Cetacea that usually excludes dolphins and porpoises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a84d6ca-e658-4e5b-ab68-c539450fb058",
                                                "sense_id": "1b4a7ad2-b950-3b89-992a-47937e78ba1a",
                                                "text": "And God created great whales, and euery liuing creature that moueth, which the waters brought forth aboundantly after their kinde, and euery winged foule after his kinde: and God saw that it was good."
                                            },
                                            {
                                                "example_id": "fcb047ff-6c35-4ae7-bfc4-6293ec1a9aa6",
                                                "sense_id": "1b4a7ad2-b950-3b89-992a-47937e78ba1a",
                                                "text": "Whale oil was still moderately useful for several things, and whale lives were valueless. Dead whales were used to soften leather and lubricate machines and to somewhat mitigate the effects of trench foot in the first world war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20b1b7aa-f703-3cfb-bb34-84439f790b90",
                                        "entry_id": "7ed32bcd-d6b5-3c1b-b1e4-da0a1a31b0ae",
                                        "glosses": [
                                            "Any species of Cetacea."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48d8a360-7001-46fd-8ad9-c1910e6f025b",
                                                "sense_id": "20b1b7aa-f703-3cfb-bb34-84439f790b90",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania.[…]It was used to make kerosene, the main fuel for artificial lighting after overfishing led to a shortage of whale blubber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63ecbe0a-acb0-3804-9e1d-acc6e655fa80",
                                        "entry_id": "7ed32bcd-d6b5-3c1b-b1e4-da0a1a31b0ae",
                                        "glosses": [
                                            "Something, or someone, that is very large."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f3fd896-01d1-48f3-a927-7728f76bd06c",
                                                "sense_id": "63ecbe0a-acb0-3804-9e1d-acc6e655fa80",
                                                "text": "It was a whale of a job. […] It took two months, and the fair blush of youth off my cheeks."
                                            },
                                            {
                                                "example_id": "1447d55a-bb3a-4ac6-a276-2227b0458bcd",
                                                "sense_id": "63ecbe0a-acb0-3804-9e1d-acc6e655fa80",
                                                "text": "But when it comes to his business life and business career, Will Clayton is not as other men; he is such a whale of a lot better that it suggests a qualitative as well as a quantitative difference."
                                            },
                                            {
                                                "example_id": "1946df44-0f36-46c1-9f96-1269111a35e4",
                                                "sense_id": "63ecbe0a-acb0-3804-9e1d-acc6e655fa80",
                                                "text": "Passing the Congregation Shearith Israel on Central Park West (a white whale of a building with a triangular pediment supported by four count ’em four massive Corinthian columns), Professor Solanka scurrying through the downpour remembered the newly bat-mitzvahed thirteen-year-old girl he’d glimpsed through the side door, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "723fc368-1324-37cb-bd7f-201a1d17772e",
                                        "entry_id": "7ed32bcd-d6b5-3c1b-b1e4-da0a1a31b0ae",
                                        "glosses": [
                                            "Something, or someone, that is excellent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68f56e3-c17c-443e-8ea0-47a7b2582997",
                                                "sense_id": "723fc368-1324-37cb-bd7f-201a1d17772e",
                                                "text": "My own father only wrote one poem in his life as far as I know, but it was a whale of a lyric, the kind you would give your whole life to write, which he did, but that is another story."
                                            },
                                            {
                                                "example_id": "fcfb92bd-1d5f-40aa-b05f-421bdcb90768",
                                                "sense_id": "723fc368-1324-37cb-bd7f-201a1d17772e",
                                                "text": "Busley Crowther in The New York Times called it “a whale of a comedy” even though he couldn't tell the four musicians apart except for Ringo (“the big-nosed one”)."
                                            },
                                            {
                                                "example_id": "8af12351-f138-4aeb-afcd-5cc8333f58b1",
                                                "sense_id": "723fc368-1324-37cb-bd7f-201a1d17772e",
                                                "text": "They were having a whale of a time when a very stern looking shop assistant came over to tell them off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f4df547-323d-3355-8db4-dd6a855039c3",
                                        "entry_id": "7ed32bcd-d6b5-3c1b-b1e4-da0a1a31b0ae",
                                        "glosses": [
                                            "A gambler who routinely wagers large amounts of money."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1cd911e-72db-4ad3-9591-f17ce394335f",
                                                "sense_id": "7f4df547-323d-3355-8db4-dd6a855039c3",
                                                "text": "These are often no-limit games as maximum bets cramp a whale’s style."
                                            },
                                            {
                                                "example_id": "50e9c01e-2fab-4d05-880b-3360df04e98b",
                                                "sense_id": "7f4df547-323d-3355-8db4-dd6a855039c3",
                                                "text": "A handful of the richest whales routinely play for $200,000 a hand. Australian media mogul Kerry Packer not only regularly bets that much, but has plunked down $200,000 bets for the dealer as a form of a tip."
                                            },
                                            {
                                                "example_id": "0b26c860-ac9f-44c1-8058-51a6f9f7e88e",
                                                "sense_id": "7f4df547-323d-3355-8db4-dd6a855039c3",
                                                "text": "The high roller who had the most ferocious reputation for trying to run the business of the casinos where he played, before he died on December 26, 2006, was Kerry Packer. In the casino world, Packer was the Prince of Whales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dac02bf-7267-3b08-98e7-955a7920c6f7",
                                        "entry_id": "7ed32bcd-d6b5-3c1b-b1e4-da0a1a31b0ae",
                                        "glosses": [
                                            "An investor who deals with very large amounts of money."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a6fe2b9-b889-4769-bd68-c8250791c636",
                                                "sense_id": "6dac02bf-7267-3b08-98e7-955a7920c6f7",
                                                "text": "If the banks knew how big Archegos’s position was, they may have realized other banks were supplying it with the same leverage — and reconsidered the trade. But a set of worrisome regulatory loopholes kept them from detecting this lurking whale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b2ee33-2b85-370a-a03f-e07a569e9f81",
                                        "entry_id": "7ed32bcd-d6b5-3c1b-b1e4-da0a1a31b0ae",
                                        "glosses": [
                                            "A person who spends large amounts of money on things that are marketed to them."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05c93980-4cf1-4e8c-86a7-699cb98d28f9",
                                                "sense_id": "97b2ee33-2b85-370a-a03f-e07a569e9f81",
                                                "text": "Whales are the big spenders who drop huge amounts of money into a game."
                                            },
                                            {
                                                "example_id": "4e9cd694-18f7-4980-8fba-cd1939fcf8c5",
                                                "sense_id": "97b2ee33-2b85-370a-a03f-e07a569e9f81",
                                                "text": "These different customer groups will be attracted to very different promotions. Your whales might enjoy receiving frequent emails from you and will purchase almost every time."
                                            },
                                            {
                                                "example_id": "5bd1756d-8f50-41ff-9667-8e98ecaa1459",
                                                "sense_id": "97b2ee33-2b85-370a-a03f-e07a569e9f81",
                                                "text": "[…] gleaned from their activity: one group they dubbed “whales,” the highest-value customers, who bought shave cream and wipes as well as razors; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3448e53b-6c05-364a-851d-dd91c7bffdf8",
                                        "entry_id": "7ed32bcd-d6b5-3c1b-b1e4-da0a1a31b0ae",
                                        "glosses": [
                                            "An overweight person (usually a woman)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3856e7d9-46f4-4610-a23a-d6792fd3e937",
                                                "sense_id": "3448e53b-6c05-364a-851d-dd91c7bffdf8",
                                                "text": "The whale is still snoring. He's a real beauty, the whale. Got this thick curly hair all over his chest and stomach and legs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68ac6af6-1a1f-34f5-83ba-6c183dc22afd",
                                        "entry_id": "eb5931be-cb84-3944-ad34-b7f6ba963e65",
                                        "glosses": [
                                            "To hunt for whales."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "whale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                        "entry_id": "d77e554c-e874-3c31-a57e-d98e6797b0f8",
                                        "glosses": [
                                            "To thrash, to flog, to beat vigorously or soundly."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52c33cfe-5883-48b9-9b68-5684b726d473",
                                                "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                                "text": "Brought him back, put him in the stall—low stable—got out of his reach, and then begun to whale him. Then he kicked up agin; […]"
                                            },
                                            {
                                                "example_id": "4c6980c6-d46f-42aa-b58a-d25d1a99b366",
                                                "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                                "text": "\"I wouldn't let him. When you were a boy in your part of the country, and other boys told tales about you, what did you do with them?\" \"Whaled 'em like time, Captin',\" answered the man; \"and if ye'll only shet yer eyes to 't, I'll whale him.\" \"I can't allow such things in the prison,\" said the Captain; \"and besides, the fellow will be lame for a fortnight, and wouldn't be a match for you in that condition. Let him get limber, and then, if you don't whale him, I'll make you walk the ladder for a month.\" The result was, the conscript officer received a sound thrashing; and did not commit another act worthy of punishment for a week."
                                            },
                                            {
                                                "example_id": "601edf41-2f72-47d2-b38d-089fdee9ee9f",
                                                "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                                "text": "They beat him down and kept whaling him after he was flat."
                                            },
                                            {
                                                "example_id": "35aa6142-e105-4f9c-b149-0b3a857fbfe1",
                                                "sense_id": "1f94f2a1-1458-3546-bb41-49e532525131",
                                                "text": "For quotations using this term, see Citations:whale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
