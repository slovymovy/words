                "senses": [
                    {
                        "sense_id": "2b60ec73-337f-3b31-9d4f-6a01fc9beb91",
                        "entry_id": "9b9f33e0-ba8d-36ff-bb83-7041c72a2676",
                        "glosses": [
                            "Ursprung von Geruch; Verursacher"
                        ],
                        "tags": [
                            "Referenz"
                        ],
                        "examples": [
                            {
                                "example_id": "8c479e98-a458-4aa1-9a0e-6f8500794643",
                                "sense_id": "2b60ec73-337f-3b31-9d4f-6a01fc9beb91",
                                "text": "„Die Geruchsquelle „Güllelager“ stellt eine windinduzierte Geruchsquelle dar.“"
                            },
                            {
                                "example_id": "1850ce07-03ea-4382-b644-d2c45a212674",
                                "sense_id": "2b60ec73-337f-3b31-9d4f-6a01fc9beb91",
                                "text": "„»Immer wieder bekommen wir Aufträge dubiose Geruchsquellen in Gebäuden ausfindig zu machen und bei der Beseitigung der selben beratend tätig zu werden«, erzählt Dr. Andrea Burdack-Freitag, projektleitende Wissenschaftlerin in der Arbeitsgruppe Chemie und Sensorik. “"
                            },
                            {
                                "example_id": "9ca9eda2-f313-43ed-b559-8378b02a53fa",
                                "sense_id": "2b60ec73-337f-3b31-9d4f-6a01fc9beb91",
                                "text": "„Auch in diesem Bereich der Gebäudediagnostik hat sich in der Praxis die Einstellung von 10 Pa Unterdruck bei jenen Fällen bewährt, bei denen die Geruchsquelle in Hohlräumen des Fußbodenaufbaus bzw. der Wandkonstruktion oder auch in anderen Zonen des Gebäudes vermutet wird.“"
                            },
                            {
                                "example_id": "65fdb3e0-015e-4271-b967-ffa38821d611",
                                "sense_id": "2b60ec73-337f-3b31-9d4f-6a01fc9beb91",
                                "text": "„Wenn es im Labor stärker oder anders als sonst riecht, sollten Sie diesem Signal unbedingt nachgehen und die Geruchsquelle ausfindig machen.“"
                            },
                            {
                                "example_id": "dad09bd4-f90c-448c-9962-2ed3c65fd92b",
                                "sense_id": "2b60ec73-337f-3b31-9d4f-6a01fc9beb91",
                                "text": "„Zur Ableitung des Ausmaßes des Abschlages für als \"angenehm\" klassifizierte und verifizierte Geruchsquellen wird die Verwendung der ermittelten Expositions-Wirkungskurven empfohlen.“"
                            },
                            {
                                "example_id": "d75b1896-9f0a-4f92-ab69-89056cb6d7a3",
                                "sense_id": "2b60ec73-337f-3b31-9d4f-6a01fc9beb91",
                                "text": "„Die Geruchsquelle wird in Olf (von olfaktorisch) angegeben, wobei ein Olf der Geruchsbelastung durch eine Standardperson (erwachsen, geduscht, sitzend) entspricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
