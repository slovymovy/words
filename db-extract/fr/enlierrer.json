                "senses": [
                    {
                        "sense_id": "95bb59c1-0734-34b8-bc42-dd18804a63ed",
                        "entry_id": "927a0543-415a-3ade-a60a-a89f35a21db7",
                        "glosses": [
                            "Couvrir de lierre, envahir de lierre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe19576a-3606-48de-8205-c7bbbebcc779",
                                "sense_id": "95bb59c1-0734-34b8-bc42-dd18804a63ed",
                                "text": "Si j'étais Dieu je pourrais peut-être effacer les bleus qui m'enlierrent la poitrine ?"
                            },
                            {
                                "example_id": "a7759489-68e5-4d3b-8a3e-8cf4207ebb81",
                                "sense_id": "95bb59c1-0734-34b8-bc42-dd18804a63ed",
                                "text": "Cette commune qui a la chance de posséder une tour (dite d’Enfer, puisqu’elle est située au bas d’une pente) au pied du bourg la laisse s’enlierrer et on ne la redécouvre que grâce à la fantaisie de son propriétaire."
                            },
                            {
                                "example_id": "11c1cc39-3fca-4ec4-a1a2-1c9ef93e53f4",
                                "sense_id": "95bb59c1-0734-34b8-bc42-dd18804a63ed",
                                "text": "Il n'haie plus au sarment D'enlierrer les palissades. Grimpant continuellement. Des souvenirs en façade."
                            }
                        ]
                    }
