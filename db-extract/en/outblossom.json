                    {
                        "sense_id": "3f846fc7-94c0-329e-8dd3-5725e1ae3a1f",
                        "entry_id": "395818aa-2654-3ab5-aac7-106c85f5f4a7",
                        "glosses": [
                            "The best that is produced (by something); culmination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b82df5-9e9f-4458-962f-c6f8173e375c",
                                "sense_id": "3f846fc7-94c0-329e-8dd3-5725e1ae3a1f",
                                "text": "Florence herself is the outblossom of modern Italian civilization."
                            },
                            {
                                "example_id": "a4da8596-3b1d-41e4-9762-fe90d88490b3",
                                "sense_id": "3f846fc7-94c0-329e-8dd3-5725e1ae3a1f",
                                "text": "Religion, as such, is the outblossom of human nature in its entirety."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b8e878ec-ed25-3507-9792-0f732be079f9",
