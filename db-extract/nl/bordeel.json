                                            {
                                                "example_id": "72d2c83c-59fc-4638-9197-ce2f655d8391",
                                                "sense_id": "737ec61e-5750-3640-9991-ba0e7db7759e",
                                                "text": "The Towne Hall is a big inflatable building in the middle of the Snooze ’n’ Crusie. It is Derelict Las Vegas: convenience store, video arcade, laundromat, bar, liquor store, flea market, whorehouse."
                                            }
