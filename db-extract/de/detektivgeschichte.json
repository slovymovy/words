                "senses": [
                    {
                        "sense_id": "b749552f-31a4-3b9e-b00a-7ab7395bd239",
                        "entry_id": "1176bcf4-5e26-36c9-9583-89f8ff9ae938",
                        "glosses": [
                            "Geschichte über Detektivarbeit, mit einem Detektiv als Hauptfigur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23776e3-1ef1-49cc-bdff-394e3582ca99",
                                "sense_id": "b749552f-31a4-3b9e-b00a-7ab7395bd239",
                                "text": "„Geduldig erklärt sie es mir: Sie mag die Wildnis, ist gern in der Natur und hat einen schottischen Autor gelesen, der eine sehr bewegende Detektivgeschichte geschrieben hat, die in Tansania spielt.“"
                            },
                            {
                                "example_id": "4472a071-6d3f-4a84-a808-7b235a7be52b",
                                "sense_id": "b749552f-31a4-3b9e-b00a-7ab7395bd239",
                                "text": "„Viele Kongressmitglieder, stellte er fest, lasen nichts anderes als Western und Detektivgeschichten, und Peter Berry war ein bisschen enttäuscht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
