                    {
                        "translation_id": "f67da4b8-5957-409d-989e-810dc49821d6",
                        "source_entry_id": "fa74f7ee-5a49-3964-8c00-10eb8f655970",
                        "source_sense_id": "428819ed-6f1b-35d9-a895-7b226a210cba",
                        "source_sense_description": "langsamer, höfischer Tanz des Barock",
                        "target_lang_word": "sarabande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarabande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaa70b88-a451-3105-ace3-a3a217e80a70",
                                        "entry_id": "21fcc89c-443f-3ce5-969e-cfa43f43aee2",
                                        "glosses": [
                                            "Danse d’origine espagnole, d’abord endiablée, puis devenue danse lente et noble, au bal et au théâtre, où elle était exécutée en couple, surtout aux XVIIᵉ et XVIIIᵉ siècles, en France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c357a443-40d7-4423-bbc0-34ee97345c93",
                                                "sense_id": "eaa70b88-a451-3105-ace3-a3a217e80a70",
                                                "text": "Inézilla, qui dansa la sarabande à la prière des comédiens, se fit admirer."
                                            },
                                            {
                                                "example_id": "9a0dcee4-0a38-4e4d-b2cb-754d605e7b1c",
                                                "sense_id": "eaa70b88-a451-3105-ace3-a3a217e80a70",
                                                "text": "Quelles boules ! dit Bixiou à du Bruel, quelle belle caricature si on les dessinait sous forme de raies, de dorades, et de claquarts (nom vulgaire d’un coquillage) dansant une sarabande !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb97d671-f699-325a-93bf-332b3dec4a17",
                                        "entry_id": "21fcc89c-443f-3ce5-969e-cfa43f43aee2",
                                        "glosses": [
                                            "Pièce instrumentale lente à trois temps, de coupe binaire à reprises, appartenant à une suite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04858a99-0928-3479-86db-b04caabdaa7e",
                                        "entry_id": "21fcc89c-443f-3ce5-969e-cfa43f43aee2",
                                        "glosses": [
                                            "Désordre, vacarme dû à des jeux bruyants."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bfd5552-7a41-3807-a720-c1a69a9124f7",
                                        "entry_id": "21fcc89c-443f-3ce5-969e-cfa43f43aee2",
                                        "glosses": [
                                            "Agitation d’une multitude de choses."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e36e881-deb0-4779-93b9-4d518fd89ab2",
                                                "sense_id": "5bfd5552-7a41-3807-a720-c1a69a9124f7",
                                                "text": "Nous étions dans la région des vagues espagnoles, […]. Le pauvre petit Valdemar roulait, tanguait, et tout ce qu’il contenait d’animé et d’inanimé se livrait à une sarabande désordonnée. Nous aurions pu nous croire dans une baratte américaine."
                                            },
                                            {
                                                "example_id": "6af73be8-899a-4119-ae64-42c16e85eb8c",
                                                "sense_id": "5bfd5552-7a41-3807-a720-c1a69a9124f7",
                                                "text": "Cette sarabande de la nuit précédente m’avait laissé comme un drôle de bruit de remords."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sarabande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3ef519b-ca91-3a89-a5c9-bee1cf0f47e4",
                                        "entry_id": "c0924813-a7f2-3a61-8d28-d3c0379ab8fc",
