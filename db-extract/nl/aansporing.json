                ],
                "senses": [
                    {
                        "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                        "entry_id": "7d377a47-6303-366a-8a29-d3210ffb6015",
                        "glosses": [
                            "aanmoediging tot actie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76958318-222d-43c4-a9dd-4f56f7bcc3a3",
                                "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                                "text": "Na een kleine aansporing wilde de meester toch wel beginnen met de uitleg."
                            },
                            {
                                "example_id": "68d0c0e1-8d01-435b-8cf1-ff54c5338fbb",
                                "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                                "text": "Tv-zender CNN vatte Obama’s woorden op als een aansporing voor jongeren om te blijven protesteren tegen het politiegeweld."
                            },
                            {
                                "example_id": "312a69f1-3ef2-48b4-b2e4-76f34f79760c",
                                "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                                "text": "Om ons minder eenzaam te voelen hebben de meesten van ons niets aan aansporingen om uit te gaan of de zoveelste aanmoediging om de volmaakte geliefde te zoeken."
                            },
                            {
                                "example_id": "744423af-f767-40f6-a932-58364cf6db4f",
                                "sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                                "text": "Gemor, gelach, aansporingen, misschien zelfs protest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3e31125-24fd-48d4-b871-140e62f31a72",
                        "source_entry_id": "7d377a47-6303-366a-8a29-d3210ffb6015",
                        "source_sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
                        "source_sense_description": "aanmoediging tot actie",
                        "target_lang_word": "incitement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incitement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67d1fbec-b294-37fe-b659-0f56e7857b73",
                                        "entry_id": "1dc54b65-6d1b-3a53-86dc-f39f8c4fbe05",
                                        "glosses": [
                                            "A call to act; encouragement to act, often in an illegal way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba03cbfb-5e70-483e-9614-f3e81d1ec2ea",
                                                "sense_id": "67d1fbec-b294-37fe-b659-0f56e7857b73",
                                                "text": "The sheriff was constantly goading me into shooting trespassers, which should surely count as incitement at the very least."
                                            },
                                            {
                                                "example_id": "70254f65-e392-4a66-ab10-e2c4f0204651",
                                                "sense_id": "67d1fbec-b294-37fe-b659-0f56e7857b73",
                                                "text": "Another element in the incitement, however unwitting, was political."
                                            },
                                            {
                                                "example_id": "4fb0c286-d42e-457c-898f-616b8c86777f",
                                                "sense_id": "67d1fbec-b294-37fe-b659-0f56e7857b73",
                                                "text": "In 2019, the F.B.I. cited QAnon as one of the dangerous conspiracy theories posing domestic terrorist threats to the United States and cited past incitements of violence from its adherents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "995e1a3b-94c7-4584-9ed9-8b73d0f941cc",
                        "source_entry_id": "7d377a47-6303-366a-8a29-d3210ffb6015",
                        "source_sense_id": "37d128b4-c309-3b48-a8e6-cf190159a56a",
