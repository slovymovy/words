                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12bf3031-ba31-4c10-b377-16dea7c4c473",
                                "sense_id": "ed21d7bd-adc2-3b45-8c11-fcc8838a28e6",
                                "text": "The ore is a richly magnetiferous Pochuck gneiss."
                            },
                            {
                                "example_id": "30859000-7645-46b3-bdc1-25aaceb11545",
                                "sense_id": "ed21d7bd-adc2-3b45-8c11-fcc8838a28e6",
                                "text": "Observations by Ball and myself in Colorado show that in the case of magnetiferous granites, the magnetite was a mineral of the pegmatite stage."
                            }
                        ]
