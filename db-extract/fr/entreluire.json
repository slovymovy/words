                        "glosses": [
                            "Luire faiblement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fd30aec-248f-43a7-a6b9-6833b207ede0",
                                "sense_id": "046cbdb3-e1dc-3fb0-90ea-7a272435c050",
                                "text": "Des municipaux indulgents laissaient entreluire cette possibilité dans leurs paroles."
                            },
                            {
                                "example_id": "0434daad-55d0-4e31-96c3-9bbf3d333644",
                                "sense_id": "046cbdb3-e1dc-3fb0-90ea-7a272435c050",
                                "text": "Il faisait entreluire à leurs yeux la reconnaissance du futur souverain qui récompenserait les services rendus à la France ou qui proscrirait en eux les bourreaux et les incendiaires de sa capitale."
                            }
                        ]
