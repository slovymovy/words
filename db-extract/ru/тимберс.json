                                        "glosses": [
                                            "Used by loggers to warn others that a tree being felled is falling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "945c9e0a-9e72-46dd-9c56-33b8ddbeac83",
                                                "sense_id": "e2f2c72d-b5da-357c-9109-897788785632",
                                                "text": "From the core of the trunk come explosive cracks sounding like rifle-fire. The top of the tree begins swaying drunkenly, as if struggling to keep on its feet. The warning cry \"Timber!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "141057c7-8e23-3905-aaf8-4aea655c3ee1",
                                        "entry_id": "164489a4-9728-3974-81e5-e46b2c147a99",
                                        "glosses": [
                                            "By extension, a cry used when anything is falling over."
                                        ],
