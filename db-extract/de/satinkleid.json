                "senses": [
                    {
                        "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                        "entry_id": "a40bc214-39da-389d-ab46-e6bbcbfbdd4f",
                        "glosses": [
                            "Kleid, das aus Satin gefertigt ist – einem leicht glänzenden, sehr edel scheinenden Gewebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2450d629-57a7-4e3d-a34a-64c5dd4b9033",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "Du siehst einfach klasse aus in diesem Satinkleid!"
                            },
                            {
                                "example_id": "1d89ff3d-4bc7-4b61-b87d-c146b711be23",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "Dieses Satinkleid passt ihnen wie angegossen."
                            },
                            {
                                "example_id": "883b8293-f0b5-44a3-8244-db9e03ec7e3c",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "Was hältst Du von einem weißen Satinkleid als Brautkleid?"
                            },
                            {
                                "example_id": "330c1590-0a68-44ae-8943-dbe22613e882",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "Für den Ball kaufte ich mir ein langes schwarzes Satinkleid."
                            },
                            {
                                "example_id": "2e4c77a4-d1c4-435b-8f27-90817c72feda",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "„Gleichmütig hängte Eve das Kleid zurück und nahm das tiefausgeschnittene Satinkleid heraus.“"
                            },
                            {
                                "example_id": "4d018079-86e8-48f1-ae6b-6a585b0b9802",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "„In der Lobby eines Zürcher Hotels […] sitzt die Frau im schwarzen Satinkleid, […].“"
                            },
                            {
                                "example_id": "9144bdfb-87b4-41e8-b386-8ca9c7407a25",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "„So wurde etwa berichtet, wie sich \"Fräulein Hella Oehmichen\" auf den Berliner Presseball vorbereitete – sie wählte schließlich ein teerosenfarbenes Satinkleid.“"
                            },
                            {
                                "example_id": "62aa297d-bf19-48bf-93da-0e53327a8983",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "„Wenn Lary im Musikvideo dazu in einem hauchzarten Satinkleid durch eine […] Spelunke taumelt, dann ist der Regler […] auf heiß gestellt.“"
                            },
                            {
                                "example_id": "a5da7d90-60b5-4c7e-aa20-8a2523172519",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "[1925 – Werbefoto der französischen Schauspielerin und Tänzerin Edmonde Guy:] „Mit dunklem Bubikopf und kirschrot geschminkten Lippen, goldenem Satinkleid und grellroten Stöckelschuhen steht sie für das selbstbewusste Frauenbild der damaligen Zeit.“"
                            },
                            {
                                "example_id": "ab8cccfb-9f70-49cc-8f2f-24beff21c6c3",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "„Die einstige US-amerikanische Skirennläuferin Lindsey Vonn (34, \"Strong Is the New Beautiful\") erschien auf dem roten Teppich des \"NBCUniversal Upfront\" in New York in einem eleganten Satinkleid ganz in Rot. Die bodenlange Abendrobe mit langen Ärmeln zog auf dem roten Teppich alle Blicke auf sich.“"
                            },
                            {
                                "example_id": "27eec547-72f2-4a05-a61c-105f9a34484b",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "„[…] oh mein Gott, das ist doch wirklich eine junge Frau in einem roten Satinkleid, und der Satin spannt über ihrem Bauch, wie das Satin nun einmal tut, wenn man einatmet.“"
                            },
                            {
                                "example_id": "f92ab066-0c66-4409-afba-e2c8b23dea49",
                                "sense_id": "b8d90214-63db-3b0f-b8a5-f0152c3fd7d7",
                                "text": "„Dann drehte sie sich um, ließ ihren Bademantel fallen wie ein Filmstar und stieg in ein neues Satinkleid, mit Rüschen am Ausschnitt und eng anliegend an den Hüften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
