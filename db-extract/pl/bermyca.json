                ],
                "translations": [
                    {
                        "translation_id": "83c82d0b-45f7-4745-ab4b-a13da60e35d5",
                        "source_entry_id": "e73951f1-c608-3dd7-8c62-634dca2c4f4d",
                        "source_sense_id": "b5e27f67-a520-36a4-8bbe-dd7df420ffd7",
                        "target_lang_word": "busby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "busby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bc077ff-d216-304a-8f92-1f9c29966fdc",
                                        "entry_id": "5f0179f7-1445-34dc-8707-6b89a64b3042",
                                        "glosses": [
                                            "A fur hat, usually with a plume in the front, worn by certain members of the military or brass bands."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c9bdeb5-beb8-4a70-9289-9c6d70b683b9",
                                                "sense_id": "6bc077ff-d216-304a-8f92-1f9c29966fdc",
                                                "text": "[…] many Khorassanis wearing huge sheepskin busbies, similar to the head-gear of the Roumanians and Tabreez Turks of Ovahjik and the Perso-Turkish border."
                                            },
                                            {
                                                "example_id": "165353a3-738d-443b-a4fa-970ed0cd664a",
                                                "sense_id": "6bc077ff-d216-304a-8f92-1f9c29966fdc",
                                                "text": "They were a fine lot of fellows, in their pale blue, tight-fitting jackets, jaunty busbys and white riding breeches with the double yellow stripe […]"
                                            },
                                            {
                                                "example_id": "550b6d14-3d81-4244-9c64-5e74513105f9",
                                                "sense_id": "6bc077ff-d216-304a-8f92-1f9c29966fdc",
                                                "text": "His head was shaped like a busby, a high solid arrogant rock, covered with thick moss."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ceb7da2-2e79-4849-9485-092114f460af",
                        "source_entry_id": "e73951f1-c608-3dd7-8c62-634dca2c4f4d",
                        "source_sense_id": "b5e27f67-a520-36a4-8bbe-dd7df420ffd7",
                        "target_lang_word": "bearskin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bearskin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7133bf0b-b79b-375d-8cfa-a5e1d805e9ee",
                                        "entry_id": "2272fa12-0ea0-33b2-a23f-c6c5e63066a2",
                                        "glosses": [
                                            "The pelt of a bear, especially when used as a rug."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc1493d4-03d4-47a6-9bc8-be6f0f0bae3f",
                                                "sense_id": "7133bf0b-b79b-375d-8cfa-a5e1d805e9ee",
                                                "text": "The farmer flayed him as he had the bear, and so he had both bear-skin and fox-skin."
                                            },
                                            {
                                                "example_id": "ec219e09-49ca-4f4f-88aa-19c3b4346e37",
                                                "sense_id": "7133bf0b-b79b-375d-8cfa-a5e1d805e9ee",
                                                "text": "In the midst stalked the King, his great limbs muffled, like Goldry’s, in a cloak: and it was of black silk lined with black bearskin, and ornamented with crabs worked in diamonds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fb39e79-7f18-3f8a-8552-23394b3c8765",
                                        "entry_id": "2272fa12-0ea0-33b2-a23f-c6c5e63066a2",
                                        "glosses": [
                                            "A tall ceremonial hat worn by members of some British regiments for ceremonial occasions; a busby."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a807459a-3ca5-3127-96ec-01ecc26b9d39",
                                        "entry_id": "2272fa12-0ea0-33b2-a23f-c6c5e63066a2",
                                        "glosses": [
                                            "A coarse, shaggy, woollen cloth for overcoats."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "778ffe91-c5d5-4b6a-a24c-b42aaa90374f",
                        "source_entry_id": "e73951f1-c608-3dd7-8c62-634dca2c4f4d",
