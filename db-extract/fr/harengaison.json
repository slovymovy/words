                                "sense_id": "d8d8adca-509f-39fb-8641-f91b4ca1fe01",
                                "text": "En France, la harengaison est depuis la fin de septembre jusqu’en décembre."
                            },
                            {
                                "example_id": "0bd55bbf-3c0f-4920-878a-c46183cf536b",
                                "sense_id": "d8d8adca-509f-39fb-8641-f91b4ca1fe01",
                                "text": "La harengaison a été bonne cette année."
                            },
                            {
                                "example_id": "a6041e3b-ba4d-4d76-b7d7-c877a14c0b23",
                                "sense_id": "d8d8adca-509f-39fb-8641-f91b4ca1fe01",
                                "text": "Pratiquée l’hiver, elle était associée à la harengaison estivale."
                            }
                        ]
                    }
