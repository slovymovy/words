                ],
                "senses": [
                    {
                        "sense_id": "7ebf37f0-fdca-355c-b594-0c0b08b7127e",
                        "entry_id": "d157489f-5da9-3e83-9e3e-ca61af934fb2",
                        "glosses": [
                            "направленный против русских, русского языка или русской культуры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6961a82c-307e-4e1b-8ded-e9ee8def9df4",
                                "sense_id": "7ebf37f0-fdca-355c-b594-0c0b08b7127e",
                                "text": "До тех пор, пока этот государственный аппарат, по природе своей антирусский и русофобский, будет иметь возможность самовоспроизводиться, он будет самовоспроизводиться в соответствии со своей природой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4c0d73a-f3f0-4cde-ae7e-93661a6addca",
                        "source_entry_id": "d157489f-5da9-3e83-9e3e-ca61af934fb2",
                        "source_sense_id": "7ebf37f0-fdca-355c-b594-0c0b08b7127e",
                        "target_lang_word": "antirussisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antirussisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "634ef441-1ed9-32e9-a42a-55abd7ed1eec",
                                        "entry_id": "6165b786-6d5a-3a40-b38e-e2e21eacac67",
                                        "glosses": [
                                            "negativ gegenüber Russland eingestellt, sich gegen Russland aussprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62384e8-3361-462d-b2b8-ea023164c822",
                                                "sense_id": "634ef441-1ed9-32e9-a42a-55abd7ed1eec",
                                                "text": "„Sollten die Minderheitsrechte der muslimischen Krim-Tataren bei einem Anschluss der Halbinsel an Russland verletzt werden, würden antirussische Ressentiments innerhalb der arabischen Bevölkerungen weiter genährt.“"
                                            },
                                            {
                                                "example_id": "eff94af6-ce68-40b4-b26b-65dcc63a7513",
                                                "sense_id": "634ef441-1ed9-32e9-a42a-55abd7ed1eec",
                                                "text": "„[..] In diese Kerbe schlägt Russland nun dankbar und mit ganzer Wucht hinein. Denn die Demonstrationen auf dem Maidan und der anschließende Umsturz in Kiew sind aus Putins Sicht nicht proeuropäisch gewesen, sondern allem voran antirussisch.“"
                                            },
                                            {
                                                "example_id": "508971b9-c9ba-400a-a698-a53ee0518eba",
                                                "sense_id": "634ef441-1ed9-32e9-a42a-55abd7ed1eec",
                                                "text": "„Wenige Tage nach dem Umsturz der ukrainischen Führung um Präsident Viktor Janukowitsch verlagern sich die Auseinandersetzungen zunehmend auf die Halbinsel Krim. Dort war es in den vergangenen Tagen zu Gewalt zwischen antirussischen Demonstranten und moskautreuen Einwohnern gekommen.“"
                                            },
                                            {
                                                "example_id": "c8381d34-6c85-4253-be24-6e0a8b1c668a",
                                                "sense_id": "634ef441-1ed9-32e9-a42a-55abd7ed1eec",
                                                "text": "„[..] Und dann ist da noch Oleg Tjagnibok, der Chef der ultranationalen Swoboda, der immer wieder mit fremdenfeindlichen, antisemitischen und antirussischen Sprüchen aufgefallen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
