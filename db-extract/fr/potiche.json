                                "target_senses": [
                                    {
                                        "sense_id": "695435d8-e963-3f6a-9523-239dfb962551",
                                        "entry_id": "3535da67-c93b-38bd-8758-1594ccfb02d2",
                                        "glosses": [
                                            "To place in a vase or similar container."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b87893-1415-4360-b768-9e18a7035679",
                                                "sense_id": "695435d8-e963-3f6a-9523-239dfb962551",
                                                "text": "She bought only pastel pencils and vased them in cups, great wooden bouquets in mugs on nightstands and kitchen chairs."
                                            },
                                            {
                                                "example_id": "f8095057-1c30-4943-a082-407bb01c8792",
                                                "sense_id": "695435d8-e963-3f6a-9523-239dfb962551",
                                                "text": "After she'd finished, she picked a bouquet of wildflowers and vased them in an old mason jar. That seemed a fitting centerpiece for the table."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
