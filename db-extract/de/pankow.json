                                "example_id": "b185a628-c2ca-4819-9f45-e761969f50f1",
                                "sense_id": "cf89227a-a4e6-3ee9-a6cd-7e1b146aa245",
                                "text": "Im Jahr 2000 hatte Pankow 125.345 Einwohner."
                            }
