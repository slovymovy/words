                ],
                "senses": [
                    {
                        "sense_id": "0f60d238-682e-3561-9a7d-7e0d3f7ef954",
                        "entry_id": "60ba0ca0-a9b4-3b9a-a23e-87d5085bd293",
                        "glosses": [
                            "Gebäude, in dem ein Reichstag tagt(e)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5831cbc-c556-41dc-b535-16a31251b976",
                                "sense_id": "0f60d238-682e-3561-9a7d-7e0d3f7ef954",
                                "text": "„Im gegenüberliegenden Reichstagsgebäude trafen sich die Mächtigen des Abendlandes.“"
                            },
                            {
                                "example_id": "d3f941d9-bd0a-45c0-9606-ab661b48b8d6",
                                "sense_id": "0f60d238-682e-3561-9a7d-7e0d3f7ef954",
                                "text": "„Das Reichstagsgebäude war jetzt Sitz des Stabes der Europäischen Union.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f842ac5-dadb-3993-b503-29b6f6152b53",
                        "entry_id": "60ba0ca0-a9b4-3b9a-a23e-87d5085bd293",
                        "glosses": [
                            "Gebäude, in dem seit dem Umzug der Regierung nach Berlin der deutsche Bundestag tagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f39d2e-c190-4cc4-a857-e140d31b12f2",
                                "sense_id": "2f842ac5-dadb-3993-b503-29b6f6152b53",
                                "text": "„Besonders zu empfehlen ist die Gegend rings um das Reichstagsgebäude.“"
                            },
                            {
                                "example_id": "c6a9ee09-e3a3-439d-bcb1-572a0ccf3655",
                                "sense_id": "2f842ac5-dadb-3993-b503-29b6f6152b53",
                                "text": "„Der 21. Deutsche Bundestag tritt am Dienstag, 25. März 2025, zu seiner ersten, konstituierenden Sitzung zusammen. Sie beginnt um 11 Uhr im Plenarsaal des Reichstagsgebäudes in Berlin.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
