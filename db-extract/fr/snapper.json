                ],
                "senses": [
                    {
                        "sense_id": "271d0259-179e-35bd-b584-45cbecd84c05",
                        "entry_id": "2f8eaa63-94f6-37fc-8e79-8a1218a227ac",
                        "glosses": [
                            "Prendre entre les dents sans vraiment mordre, en parlant d’un chien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be400a3b-fb62-41ec-93dd-92814443a734",
                                "sense_id": "271d0259-179e-35bd-b584-45cbecd84c05",
                                "text": "Notre chien, un Labrador de 3 ans, vient de « snapper » au visage ma fille de 16 ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "3173e4e5-1d73-371b-99f7-a6e0ce099a07",
                        "entry_id": "2f8eaa63-94f6-37fc-8e79-8a1218a227ac",
                        "glosses": [
                            "Diffuser via l’application Snapchat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e925ae2-e5ae-485b-a9ea-a8b2162888ff",
                                "sense_id": "3173e4e5-1d73-371b-99f7-a6e0ce099a07",
                                "text": "Soit il y en a qui n'arrêtent pas de \"snapper\" les choses qu'ils sont en train de faire (quand ils sont en boîte, à la montagne ou alors le très célèbre \"avec les potos on va se mettre iieeenb\")."
                            },
                            {
                                "example_id": "aa7d1251-500a-409c-847f-6fe5b7f5e67a",
                                "sense_id": "3173e4e5-1d73-371b-99f7-a6e0ce099a07",
                                "text": "Elsa a pris le soleil à Port Aventura et a snappé ses aventures."
                            }
                        ]
                    },
                    {
                        "sense_id": "c52d96d6-c1a0-3539-9a58-24837cef3b61",
                        "entry_id": "2f8eaa63-94f6-37fc-8e79-8a1218a227ac",
                        "glosses": [
                            "Récupérer un nom de domaine au moment de son expiration, si son propriétaire ne l’a pas renouvelé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e56566e5-6e07-42ca-9d51-a7bfdf60b6a8",
                                "sense_id": "c52d96d6-c1a0-3539-9a58-24837cef3b61",
                                "text": "Il n'y a donc aucun risque à tenter de snapper un domaine."
                            }
                        ]
                    }
