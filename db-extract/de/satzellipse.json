                "senses": [
                    {
                        "sense_id": "42f273f2-7b0d-3376-855e-fc48d1cee1d6",
                        "entry_id": "3dd5bd58-c5be-3ddc-bd1a-5e5abf463f25",
                        "glosses": [
                            "Fehlen von syntaktisch notwendigen Satzteilen"
                        ],
                        "tags": [
                            "Rhetorik"
                        ],
                        "examples": [
                            {
                                "example_id": "f84239b8-c6e8-4b3b-8fd3-69ec8d3d24d5",
                                "sense_id": "42f273f2-7b0d-3376-855e-fc48d1cee1d6",
                                "text": "Viele Überschriften sind syntaktisch gesehen Satzellipsen."
                            },
                            {
                                "example_id": "9955f991-4f9e-488c-ac52-cc9cf8c0c5e0",
                                "sense_id": "42f273f2-7b0d-3376-855e-fc48d1cee1d6",
                                "text": "„Diese verkürzten Sätze heißen Satzellipsen oder Kurzsätze. In der Schriftsprache sollte man sie eher vermeiden und durch vollständige Sätze ersetzen.“"
                            },
                            {
                                "example_id": "a8ca870f-823e-48f2-aeda-00702f6a79d4",
                                "sense_id": "42f273f2-7b0d-3376-855e-fc48d1cee1d6",
                                "text": "Bünting & Bergenholtz definieren: „Kurzsatz (Satzellipse): unvollständiger einfacher Satz, insofern ungrammatisch, aber in Texten häufig zu finden;…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
