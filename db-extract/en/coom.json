                        "examples": [
                            {
                                "example_id": "fe054774-824c-496c-8df5-0ca4e942b1ef",
                                "sense_id": "96056f97-79aa-3e78-8a37-c5abcae9dc39",
                                "text": "“Not a bit,” replied the Yorkshireman, extending his mouth from ear to ear. “There I lay, snoog in schoolmeasther’s bed long efther it was dark, and nobody coom nigh the pleace. ‘Weel!’ thinks I, ‘he’s got a pretty good start, and if he bean’t whoam by noo, he never will be; so you may coom as quick as you loike, and foind us reddy’—that is, you know, schoolmeasther might coom.”"
                            }
                        ]
