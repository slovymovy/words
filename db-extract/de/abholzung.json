                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac8c0553-b7d1-4511-938c-7485a9754302",
                                                "sense_id": "978cd4a0-bf78-3705-9a6b-2b14a58afcd3",
                                                "text": "One forest officer, stationed in the buffer of the Buxa Tiger Reserve, argued that 80% of the illegal fellings are carried out by forest villagers and that more or less all Rabhas are involved."
                                            }
