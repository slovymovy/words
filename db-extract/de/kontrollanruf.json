                "senses": [
                    {
                        "sense_id": "15c77f75-39f7-3ca2-9537-36c27af3b8dd",
                        "entry_id": "3a3d6684-5523-3ec5-add9-442f1eda66ec",
                        "glosses": [
                            "Anruf zur Überprüfung von jemandem oder etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b7477c-b24f-47a6-882f-ea495793ebb3",
                                "sense_id": "15c77f75-39f7-3ca2-9537-36c27af3b8dd",
                                "text": "„Der Kontrollanruf führt tatsächlich zu der Ansage: ‚Der gewählte Anschluss ist zurzeit nicht erreichbar.‘“"
                            },
                            {
                                "example_id": "78d5a8d0-65d1-469a-b80e-e47836ba76e1",
                                "sense_id": "15c77f75-39f7-3ca2-9537-36c27af3b8dd",
                                "text": "„Ein Kontrollanruf zu Hause verstärkt die Sorge: Der Teilnehmer sei nicht erreichbar, ertönt es aus dem Lautsprecher.“"
                            },
                            {
                                "example_id": "a480e8ec-efc6-4f6d-8902-79aec18a8efb",
                                "sense_id": "15c77f75-39f7-3ca2-9537-36c27af3b8dd",
                                "text": "„Immer wieder bekam sie Kontrollanrufe von der Agentur: ‚Wie viel hast du denn schon abgenommen?‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
