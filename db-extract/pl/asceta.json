                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "88b01882-824c-3e62-94a1-3dbeb6382e71",
                        "entry_id": "d4d3b888-01e0-3d3f-b246-45eb26dbb137",
                        "glosses": [
                            "zwolennik prostoty i surowości formy w sztuce"
                        ],
