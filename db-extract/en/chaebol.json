                ],
                "translations": [
                    {
                        "translation_id": "c3814539-6d34-49de-80f3-1f7c05a5ad03",
                        "source_entry_id": "a1759394-c5e7-3ff1-90a8-3c448e8f23ac",
                        "source_sense_id": "44b184c8-4c2b-3141-afd4-751314e28d4f",
                        "source_sense_description": "large, family-controlled Korean business conglomerate",
                        "target_lang_word": "chaebol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chaebol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ea56195f-9e79-3b94-98e6-7048557fc7f8",
                                        "entry_id": "bb1c29ea-8f34-3d83-bfca-59994735b398",
                                        "glosses": [
                                            "Conglomérat sud-coréen de domaines variés, entretenant des participations croisées, dirigé par la famille fondatrice."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a85bcc-c578-4e8f-a6e4-aa255ea06d6d",
                                                "sense_id": "ea56195f-9e79-3b94-98e6-7048557fc7f8",
                                                "text": "Elle annonce des changements destinés à inciter les chaebols à opter pour des structures plus transparentes."
                                            },
                                            {
                                                "example_id": "9366f611-2e7b-4607-b793-e743ea4925ce",
                                                "sense_id": "ea56195f-9e79-3b94-98e6-7048557fc7f8",
                                                "text": "Voilà pourquoi les chaebol fabriquent un peu de tout avec un surendettement structurel mais sans risque de faillite, puisqu’ils sont garantis par l’État."
                                            },
                                            {
                                                "example_id": "26d7013c-8edd-44a3-ac89-54ef891add94",
                                                "sense_id": "ea56195f-9e79-3b94-98e6-7048557fc7f8",
                                                "text": "Les chaebols ne se cantonnent pas à des activités purement commerciales et ne sont pas de simples sociétés d’« import-export »."
                                            },
                                            {
                                                "example_id": "8750ce70-dd0a-40b1-a64a-90a59d382bfe",
                                                "sense_id": "ea56195f-9e79-3b94-98e6-7048557fc7f8",
                                                "text": "Même les chaebols coréens, pourtant très tournés vers la production de masse, investissent aujourd’hui dans le marketing de leur « brand »."
                                            },
                                            {
                                                "example_id": "f18c10da-ecb2-475c-bb7e-121456bcf91e",
                                                "sense_id": "ea56195f-9e79-3b94-98e6-7048557fc7f8",
                                                "text": "Cependant, il est difficile de remettre en cause l’esprit d’innovation de ceux qui ont créé un chaebol à partir d’un ou deux biens assignés, de quelques marchés non concurrentiels ou d’un vieux camion."
                                            },
                                            {
                                                "example_id": "3597910d-59af-46d9-b517-3073a42b45cb",
                                                "sense_id": "ea56195f-9e79-3b94-98e6-7048557fc7f8",
                                                "text": "D’après une étude réalisée en 2014 par le cabinet sud-coréen CEOScore, 32 membres des familles dirigeantes des 30 premiers chaebols ont accédé à des postes à responsabilité trois ans et demi en moyenne après avoir rejoint l’entreprise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
