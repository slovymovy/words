                                        "glosses": [
                                            "Présence d’une même personne en même temps en plusieurs endroits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3624495-9ac3-439b-8359-4acaf48c006c",
                                                "sense_id": "bfabd2ac-472d-3d1f-bc89-0e6ab726cbff",
                                                "text": "Leur mère a le don de la bilocation, se montre en plusieurs endroits, en même temps, trace partout où elle passe un sillon délicieux d’odeurs, […]."
                                            },
                                            {
                                                "example_id": "6589957d-3572-4ad3-abab-6d97a081eb97",
                                                "sense_id": "bfabd2ac-472d-3d1f-bc89-0e6ab726cbff",
                                                "text": "Il vit ici ce que Charles Richet analyse comme un cas de bilocation : « Les personnes qui croient à la bilocation disent que c’est le double de tel ou tel individu qui se manifeste »."
                                            }
                                        ]
                                    }
