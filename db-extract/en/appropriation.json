                        "target_lang_word": "toe-eigening",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5e88a4eb-1e98-48f8-9c32-89ab0fc5ae42",
                        "source_entry_id": "511317ef-bda1-386f-8c19-8954922591f6",
                        "source_sense_description": "act of appropriating, or something appropriated",
                        "target_lang_word": "Aneignung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aneignung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3074a98e-923c-3474-8ab4-f65948b08ee6",
                                        "entry_id": "50ffb8dc-d6cb-3e4e-bea6-fb3d29d0a459",
                                        "glosses": [
                                            "Inbesitznahme einer herrenlosen Sache"
                                        ],
                                        "tags": [
                                            "Sachenrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21153ecf-1dee-498e-835d-c678598bf082",
                                                "sense_id": "3074a98e-923c-3474-8ab4-f65948b08ee6",
                                                "text": "„Mit der privaten Aneignung des Grund und Bodens, der sowohl als wichtigstes Produktionsmittel als auch als Produktionsgegenstand diente, war auch die private Aneignung des Viehs verbunden.“"
                                            },
                                            {
                                                "example_id": "ad1b9df3-1c23-460f-8326-9c1ddc86c28c",
                                                "sense_id": "3074a98e-923c-3474-8ab4-f65948b08ee6",
                                                "text": "„Dazu wurde vertreten, dass sich die Aneignung von herrenlosem Land in Deutsch-Südwestafrika nicht als besonderes Vorrecht des Schutzgebietsfiskus darstelle, da es auch von Privaten ausgeübt werden könne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                        "entry_id": "50ffb8dc-d6cb-3e4e-bea6-fb3d29d0a459",
                                        "glosses": [
                                            "unrechtmäßige Inbesitznahme einer Sache"
                                        ],
                                        "tags": [
                                            "Sachenrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c98dae93-56cc-484f-9095-3b5514eae51e",
                                                "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                                "text": "„Die englische Herrschaft über Irland ging in den folgenden 200 Jahren mit einer weitgehenden Aneignung des Grundbesitzes durch die Engländer und einer Lähmung der irischen Wirtschaft einher.“"
                                            },
                                            {
                                                "example_id": "5a085802-1310-4ae1-b285-c2dd0df010d4",
                                                "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                                "text": "„So raubte der IS etwa beim Einmarsch in Mossul im vergangenen Jahr Millionen von Dollar aus den Tresoren der örtlichen Banken – ganz zu schweigen von der Aneignung des Militärgeräts der irakischen Armee, die Hals über Kopf aus der Stadt geflüchtet war und den Terroristen damit einiges an Ausgaben ersparte.“"
                                            },
                                            {
                                                "example_id": "a42dc293-9d2c-466b-ad56-ccc410d5f490",
                                                "sense_id": "09ef2fc6-22e6-31ab-8412-9096db3e34b1",
                                                "text": "„Chinas historische Begründung für seine Expansion im Südchinesischen Meer ist nicht anerkannt und mit der Aneignung der Inseln verstößt China gegen das Seerechtsübereinkommen der Vereinten Nationen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                        "entry_id": "50ffb8dc-d6cb-3e4e-bea6-fb3d29d0a459",
                                        "glosses": [
                                            "Erwerb von Wissen, Fähigkeiten, Verhaltensweisen, Ideologien oder Ähnlichem, beispielsweise durch Lernen, Üben oder Angewöhnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e014f35c-d498-41dc-9384-18612d9c07d6",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Die Aneignung einer Fremdsprache unterscheidet sich von der Aneignung einer Zweitsprache primär dadurch, dass der erste Prozess nur auf einige Stunden pro Woche reduziert ist.“"
                                            },
                                            {
                                                "example_id": "65f65ea2-2903-4842-b108-2f98df256d2e",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Trotz der Aneignung von Traditionen bleibt Picasso immer er selbst.“"
                                            },
                                            {
                                                "example_id": "9bb334ba-5629-4556-9c75-719b4883e0a3",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Übersehen wird dabei, dass es beim Denglischen nicht um eine aktive, aufgeschlossene Aneignung des Fremden geht, sondern um eine wachsende sprachliche Monokultur auch unter den Intellektuellen.“"
                                            },
                                            {
                                                "example_id": "f5692867-042b-4ccb-a28e-95f8e23a280e",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Der Traditionsbruch und die Öffnung zum Westen, zu dem ja auch die teilweise Aneignung des Leninismus gehört, hätten es tatsächlich geschafft, dass sich die Nation jetzt gegenüber dem Westen behaupten könne - was jedoch keineswegs heißt, dass historische Kontinuitäten als Legitimationsquelle für die Kommunisten nicht wichtig wären.“"
                                            },
                                            {
                                                "example_id": "a6f32482-30e2-43f5-a2a0-72ad68c163b4",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Zentral sei in der Wiener Lehrerausbildung nun die Aneignung von etwa 30 Kernkompetenzen wie zum Beispiel der Innovationskompetenz, der Reflexionskompetenz, der Prüfungskompetenz, des Durchhaltevermögens oder gar der Kompetenzorientierungskompetenz.“"
                                            },
                                            {
                                                "example_id": "1a5b930a-3ba3-4879-938f-3c866ee7640e",
                                                "sense_id": "c5a722f1-9a61-310c-aeee-1a42f9fa81bf",
                                                "text": "„Musik sei entstanden durch Vermischung der Kulturen und Wanderung. Er mache die Musik, die er fühle. ‚Wenn jemand anders sagt, das ist kulturelle Aneignung, dann interessiert mich das einen Scheißdreck‘, so Schneider.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
