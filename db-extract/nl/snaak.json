                                                "sense_id": "37069c21-f5f6-3d28-9af2-63e0ffdd80dc",
                                                "text": "A skilled prankster."
                                            },
                                            {
                                                "example_id": "6f69e31b-0891-42e2-89c6-8d8d236b7e43",
                                                "sense_id": "37069c21-f5f6-3d28-9af2-63e0ffdd80dc",
                                                "text": "She became famous as a prankster."
                                            },
                                            {
                                                "example_id": "88f49cbc-c62c-46dd-a79e-26885c98cccf",
                                                "sense_id": "37069c21-f5f6-3d28-9af2-63e0ffdd80dc",
                                                "text": "He loves being a prankster and is often seen pulling off several pranks on his bullies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
