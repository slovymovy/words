    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "affae887-8d79-32aa-9ca6-273a1af80939",
                    "sense_definition": "Substance qui, introduite dans l'organisme, altère ou détruit les fonctions vitales.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce champignon contient un <w>poison</w> redoutable qui attaque le foie en quelques heures."
                        },
                        {
                            "text": "Le médecin légiste a découvert des traces suspectes de <w>poison</w> dans son verre."
                        }
                    ],
                    "synonyms": [
                        "toxique"
                    ],
                    "antonyms": [
                        "antidote",
                        "contrepoison"
                    ],
                    "common_phrases": [
                        "dose de poison",
                        "effet du poison"
                    ]
                },
                {
                    "sense_id": "b55a96c5-5c79-386d-9586-856a345bb549",
                    "sense_definition": "Chose pernicieuse qui corrompt l'esprit, trouble la raison ou détruit le bonheur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La jalousie excessive est un véritable <w>poison</w> pour la vie de couple."
                        },
                        {
                            "text": "Ses remarques méchantes agissent comme un <w>poison</w> sur l'ambiance de travail."
                        }
                    ],
                    "common_phrases": [
                        "un poison lent"
                    ]
                },
                {
                    "sense_id": "7ef65dbc-481f-38fa-a5e5-37d6bc44ceb2",
                    "sense_definition": "Personne malveillante, méchante ou particulièrement insupportable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette voisine acariâtre est une vraie <w>poison</w> qui surveille et dénonce tout le quartier."
                        },
                        {
                            "text": "Ne l'écoutez pas, cette vieille <w>poison</w> ne cherche qu'à semer la discorde entre nous."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "5912e506-d356-3d6d-88ba-bf37a4a7b77b",
                    "sense_definition": "Isotope qui absorbe fortement les neutrons et ralentit la réaction en chaîne dans un réacteur nucléaire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accumulation de xénon agit comme un <w>poison</w> qui perturbe le redémarrage du réacteur."
                        },
                        {
                            "text": "Les ingénieurs doivent surveiller la concentration de chaque <w>poison</w> neutronique dans le cœur."
                        }
                    ]
                }
            ]
        }
    ]
