                "senses": [
                    {
                        "sense_id": "e965551b-7022-3793-bb1e-6870f8b6577e",
                        "entry_id": "233720af-6fcc-3525-994a-2f7c3e622649",
                        "glosses": [
                            "kleines Bauerngut in Bayern und Österreich, von dem allein der Bauer meist nicht leben konnte"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "85659a91-d684-4fc9-aa6f-65de07039ac8",
                                "sense_id": "e965551b-7022-3793-bb1e-6870f8b6577e",
                                "text": "„Seit 1445 teilte man die Bauerngüter ein in ganze Höfe, halbe Höfe oder Huben, Viertelhöfe oder Lehen, Achtelhöfe oder Bausölden, dazu kamen seit dem 16. Jahrhundert noch Sechzehntelhöfe oder gemeine Sölden, ferner bloße Häusl oder Leerhäusl (Zweiunddreißigstelhöfe), waren diese unter zwei Inhaber geteilt, dann sprach man von Vierundsechzigstelhöfen.“"
                            },
                            {
                                "example_id": "cdcd29f0-735f-4081-8b5f-db1be77ee476",
                                "sense_id": "e965551b-7022-3793-bb1e-6870f8b6577e",
                                "text": "„Hausnamen von 1/16 Sölden und 1/32 Leerhäusern werden nur dort aufgeführt, wo sie dazu dienen, den Besitz mehrerer, an einem Ort begüterter Grundherrschaften genau festzulegen.“"
                            },
                            {
                                "example_id": "862c7645-f252-46fc-a1c8-9fdc83c4a700",
                                "sense_id": "e965551b-7022-3793-bb1e-6870f8b6577e",
                                "text": "„Hörmann konnte sich immerhin soweit durchbringen, daß er auf seiner Sölde, zu der zwei Gärten gehörten, mindestens eine Kuh halten konnte: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
