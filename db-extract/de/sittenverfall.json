                "senses": [
                    {
                        "sense_id": "e438a3bb-1fbb-3217-b146-4de22ef969c6",
                        "entry_id": "22426b9a-1699-3151-81d3-7ed4e2e80eb3",
                        "glosses": [
                            "Verlust geltender moralischer Maßstäbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e5e408-9968-4b25-bd4f-1051670cdeb4",
                                "sense_id": "e438a3bb-1fbb-3217-b146-4de22ef969c6",
                                "text": "„Jedes Mal, wenn so eine Druckwelle der Sittlichkeit stoßweise das Land erschütterte, ging es auch der Rockmusik an den Kragen, die sich ohnehin von Natur aus verdächtig machte, Unmoral, Zügellosigkeit und Sittenverfall Vorschub zu leisten.“"
                            },
                            {
                                "example_id": "e8a6dec5-f8e3-469c-a9a4-f1f492e7cf6f",
                                "sense_id": "e438a3bb-1fbb-3217-b146-4de22ef969c6",
                                "text": "„Daß der weise Sokrates vor nun schon fast zweieinhalb Jahrtausenden bei der Jugend seiner Zeit einen verderblichen Sittenverfall gerügt hat, wird immer wieder gern zitiert: ein Topos, der sich seither durch die Weltgeschichte zieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
