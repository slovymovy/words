                        "examples": [
                            {
                                "example_id": "b95c72b9-2eab-4f95-aefd-e26189198e92",
                                "sense_id": "b1b22ff3-b7be-36f7-ad12-3c81ec8f6a4d",
                                "text": "Bei der Schiffstaufe war auch der Schiffseigentümer anwesend."
                            },
                            {
                                "example_id": "6ecbddea-1607-477f-a9a5-d79a72efdc45",
                                "sense_id": "b1b22ff3-b7be-36f7-ad12-3c81ec8f6a4d",
                                "text": "„In der DTG haben sich rund 100 selbstständige Schiffseigentümer, sogenannte Partikuliere, zusammengeschlossen.“"
                            },
                            {
                                "example_id": "e7787d44-7af5-47a4-b77e-a807c5e30280",
                                "sense_id": "b1b22ff3-b7be-36f7-ad12-3c81ec8f6a4d",
                                "text": "„Bei Bedarf schickt das System per Hafen-WLAN, integrierter Mobilfunk- oder Satellitenkommunikation dem Schiffseigentümer oder auch der Hafenverwaltung eine Alarm-SMS über den potenziellen Schadensfall auf der überwachten Yacht.“"
                            }
                        ],
