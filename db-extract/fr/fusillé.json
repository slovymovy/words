                        "glosses": [
                            "Personne qui est fusillée, qui est tuée à l'aide de fusil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "080787b4-4ba1-41db-9cb0-5f962a9b664e",
                                "sense_id": "a73f4bca-c3b1-3327-b932-6875357ad4c1",
                                "text": "Du mur des fusillés de mai 71, j’aurais voulu saluer les morts des hécatombes nouvelles, les martyrs de Montjuich, les égorgés d’Arménie, les foules écrasées d’Espagne, […]."
                            },
                            {
                                "example_id": "e97e3214-471e-4b7c-bf6f-f6055a62c90f",
                                "sense_id": "a73f4bca-c3b1-3327-b932-6875357ad4c1",
                                "text": "Cette hypothèse est alors publiée dans la presse avec appel à témoins pour identifier le fusillé."
                            }
                        ]
                    }
                ],
