                                    {
                                        "sense_id": "24b479d4-08d6-3203-b85c-4de8d6577c67",
                                        "entry_id": "8b04f929-20c3-31bd-b79f-0387f44c84f5",
                                        "glosses": [
                                            "Oligosaccharide composé par deux saccharides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceba281a-ffb2-4205-984f-070e5fbea783",
                                                "sense_id": "24b479d4-08d6-3203-b85c-4de8d6577c67",
                                                "text": "Les disaccharides sont invertis par les ferments invertissants, les monoses résultants subissent alors la fermentation alcoolique."
                                            },
                                            {
                                                "example_id": "50a81f96-97bc-4dfb-a177-7c5ffb975f5b",
                                                "sense_id": "24b479d4-08d6-3203-b85c-4de8d6577c67",
                                                "text": "Ainsi, les κ-, ι- et λ-carraghénanes comportent respectivement, un, deux et trois groupements sulfate par disaccharide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5e0932b-cd65-4315-b15a-494f42711996",
                        "source_entry_id": "d7b6602e-9c3c-3a0c-8dd3-6505f4ecfeeb",
