                        "zh": [
                            {
                                "target_lang_word": "大麻烟卷",
                                "target_lang_sense_clarification": "俚语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f9234c5-b2eb-3975-a671-d989a9e2fa8b",
                    "sense_definition": "A large piece of meat consisting of a bone and the meat around it, usually roasted.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "culinary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a large <w>joint</w> of beef to cook for Sunday lunch.",
                            "target_lang_translations": {
                                "ru": "Она купила большой <w>кусок</w> говядины, чтобы приготовить его к воскресному обеду.",
                                "zh": "她买了一大<w>块</w>牛肉准备周日午餐。"
                            }
                        },
                        {
                            "text": "Carving the <w>joint</w> at the table is a family tradition.",
                            "target_lang_translations": {
                                "ru": "Разделка <w>мяса</w> за столом — это семейная традиция.",
                                "zh": "在餐桌上切这<w>块</w>肉是我们家的传统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "roast"
                    ],
                    "common_phrases": [
                        "Sunday joint",
                        "joint of beef",
                        "joint of pork"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой кусок мяса на кости, обычно предназначенный для запекания.",
                        "zh": "一大块带骨的肉，通常用于烘烤。"
                    },
                    "translations": {
                        "ru": [
