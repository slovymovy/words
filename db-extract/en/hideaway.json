                        "entry_id": "6868f44c-7771-387b-9e66-953a0d6d4ca3",
                        "glosses": [
                            "a hiding place, somewhere one can go to get away from other people"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "841df0f4-e168-4c06-a975-a7e8bf3de8f5",
                                "sense_id": "d6a112ef-23c0-3c4d-ac39-65a6454c5934",
                                "text": "This weekend, let's find some romantic hideaway on the coast."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b57a9cf0-f8bf-451a-bce9-e37ad9ebaddc",
                        "source_entry_id": "6868f44c-7771-387b-9e66-953a0d6d4ca3",
