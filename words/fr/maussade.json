                },
                {
                    "sense_id": "c3c3ed32-3d8c-3658-bcc0-5ac462eae2ec",
                    "sense_definition": "Qui provoque l'ennui, la lassitude ou la tristesse ; terne et sans attrait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ennuyeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il redoutait de passer une soirée <w>maussade</w> devant un film particulièrement décevant.",
                            "target_lang_translations": {
                                "en": "He dreaded spending a <w>dull</w> evening in front of a particularly disappointing film.",
                                "ru": "Он боялся провести <w>скучный</w> вечер за просмотром особенно разочаровывающего фильма.",
                                "de": "Er fürchtete, den Abend vor einem besonders enttäuschenden Film <w>langweilig</w> zu verbringen.",
                                "es": "Temía pasar una velada <w>aburrida</w> delante de una película especialmente decepcionante.",
                                "zh": "他担心要在一部特别令人失望的电影前度过一个<w>乏味</w>的夜晚。"
                            }
                        },
                        {
                            "text": "Ce roman dépeint l'existence <w>maussade</w> d'un employé de bureau dans une petite ville.",
                            "target_lang_translations": {
                                "en": "This novel portrays the <w>dreary</w> existence of an office worker in a small town.",
                                "ru": "Этот роман рисует <w>унылое</w> существование конторского служащего в маленьком городке.",
                                "de": "Dieser Roman schildert die <w>trostlose</w> Existenz eines Büroangestellten in einer Kleinstadt.",
                                "es": "Esta novela retrata la existencia <w>monótona</w> de un empleado de oficina en una pequeña ciudad.",
                                "zh": "这部小说描绘了一名小镇办公室职员<w>单调</w>的生活。"
                            }
                        }
                    ],
                    "synonyms": [
