                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd83f217-c206-4d5e-a4ce-68053303a119",
                                "sense_id": "2e8366c2-b1d0-394e-b94c-305cc001af20",
                                "text": "But the young gentleman […] walked down the dark side of the street in peals of laughter, making, ever and anon, little breathless remarks to himself, which his colleague could not hear, but which seemed to have the effect of setting him off again into new hemi-demi-semiquavers and roars of laughter […]"
                            }
                        ]
                    }
                ],
