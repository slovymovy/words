                    }
                ],
                "senses": [
                    {
                        "sense_id": "441a7c3d-0925-3953-8f5d-8ddbd88c498a",
                        "entry_id": "94991483-c1eb-31af-b833-406789ba50d4",
                        "glosses": [
                            "Pente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c110bf9a-b1b6-4047-9e85-8159e2c7e9fc",
                                "sense_id": "441a7c3d-0925-3953-8f5d-8ddbd88c498a",
                                "text": "D’où le fait que le maintien du genou en rectitude totale, même avec une déclive du membre, fait obstacle à la circulation veineuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "8210d096-9106-3ba2-99eb-3b2dc2030b32",
                        "entry_id": "94991483-c1eb-31af-b833-406789ba50d4",
                        "glosses": [
                            "Fait d’imposer au corps une position inclinée où la tête est située au point le plus bas, en particulier pour favoriser l’expectoration."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
