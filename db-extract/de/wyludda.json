                "senses": [
                    {
                        "sense_id": "6c565630-cbf8-3c8f-b68e-edc75b002410",
                        "entry_id": "c48b8f1b-d692-32ea-b850-f9986c5b2467",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2969c69d-f2ab-4d0f-a7b9-bbae7160e9b6",
                                "sense_id": "6c565630-cbf8-3c8f-b68e-edc75b002410",
                                "text": "Frau Wyludda ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "78abc6d8-ad69-45d2-baea-76673f0a42c5",
                                "sense_id": "6c565630-cbf8-3c8f-b68e-edc75b002410",
                                "text": "Herr Wyludda wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "aadf1c3e-7691-4ad7-a639-6ac193d7dbd6",
                                "sense_id": "6c565630-cbf8-3c8f-b68e-edc75b002410",
                                "text": "Die Wyluddas fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "f5d56e6d-798d-4eb4-8d5e-6382ccec5a90",
                                "sense_id": "6c565630-cbf8-3c8f-b68e-edc75b002410",
                                "text": "Der Wyludda trägt nie die Pullover, die die Wyludda ihm strickt."
                            },
                            {
                                "example_id": "ae55b022-365e-4304-9608-b860ae4feb41",
                                "sense_id": "6c565630-cbf8-3c8f-b68e-edc75b002410",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wyludda kommt, geht der Herr Wyludda.“"
                            },
                            {
                                "example_id": "452ea587-e739-4699-8237-fa9f66c96007",
                                "sense_id": "6c565630-cbf8-3c8f-b68e-edc75b002410",
                                "text": "Wyludda kommt und geht."
                            },
                            {
                                "example_id": "786bef7e-0e65-462b-a59c-ac0e27181eb3",
                                "sense_id": "6c565630-cbf8-3c8f-b68e-edc75b002410",
                                "text": "Wyluddas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
