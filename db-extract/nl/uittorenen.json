        "nl-extract.jsonl": [
            {
                "entry_id": "0fb6cfbf-13b1-38bf-985b-ebf8297469be",
                "word": "uittorenen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5794442c-534d-3cc5-87c2-8898fd85aaa8",
                        "entry_id": "0fb6cfbf-13b1-38bf-985b-ebf8297469be",
                        "glosses": [
                            "ergens bovenuit steken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d1f9dce-24b6-49c3-962c-8bed3aaeecae",
                                "sense_id": "5794442c-534d-3cc5-87c2-8898fd85aaa8",
                                "text": "De gemeente wil Nyenrode Universiteit graag behouden voor Breukelen, maar is het met omwonenden eens dat het aanzicht van het statige landgoed niet aangetast mag worden. Bebouwing mag dan ook niet boven het groen uittorenen en de universiteit mag niet buiten de grenzen van het landgoed bouwen."
                            },
                            {
                                "example_id": "96ee7360-0a21-40bc-9320-8e2055340e7f",
                                "sense_id": "5794442c-534d-3cc5-87c2-8898fd85aaa8",
                                "text": "De defensie van de Eagles liet hem volledig ongedekt en zag hem onverschrokken boven iedereen uittorenen."
                            },
                            {
                                "example_id": "aec31b25-fdba-49e1-a9c4-ac7f351acebb",
                                "sense_id": "5794442c-534d-3cc5-87c2-8898fd85aaa8",
                                "text": "Elk jaar lokt Beachy Head zo’n 350.000 bezoekers naar de indrukwekkende krijtrotsen, die 162 meter boven zeeniveau uittorenen en tot de hoogste van Engeland behoren. De plek is al eeuwenlang eveneens berucht voor het aantal zelfmoorden dat er jaarlijks plaatsvindt."
                            },
                            {
                                "example_id": "71bb6d9f-c053-4b37-bf3c-5320a4120e32",
                                "sense_id": "5794442c-534d-3cc5-87c2-8898fd85aaa8",
                                "text": "De nieuwe 'berg' moet nu nog de hoogte in, trouwens. Nu nog lager dan het niveau van het asfalt van de nieuwe weg, moet de top van de heuvel 6,5 meter uittorenen boven de weg. Wie naar boven klautert heeft binnenkort uitzicht over het Berkeldal. En over de N18..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b85f2829-0c87-4f5f-8c99-c2b1e2333a5b",
                        "source_entry_id": "0fb6cfbf-13b1-38bf-985b-ebf8297469be",
                        "source_sense_id": "5794442c-534d-3cc5-87c2-8898fd85aaa8",
                        "target_lang_word": "tower above",
