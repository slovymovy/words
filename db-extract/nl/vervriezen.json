                        "glosses": [
                            "door bevriezing beschadigd of gewond raken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84bc0c6a-8b3c-47c7-99b4-9977d24dcef3",
                                "sense_id": "8bd9d691-6425-38fb-8390-3c77aa233146",
                                "text": "‘Verplicht minister van Defensie Pieter De Crem manu militari om Koets naar Wenen van Jan Procházka te lezen. Christendemocraat De Crem vindt het niet opportuun om legerbussen in te zetten voor het vervoer van daklozen die op straat vervriezen. Het sturen van oorlogstroepen naar Afghanistan vond hij dan weer wel bittere noodzaak. Misschien kan de lectuur van Koets naar Wenen de man wat menslievender en minder oorlogszuchtig maken. Misschien.’"
                            }
                        ]
                    }
