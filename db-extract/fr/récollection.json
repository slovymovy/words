                        "sense_id": "d1da230d-8831-3aa3-9f8a-74ad67a24b19",
                        "entry_id": "c3fa023f-3849-3809-ad87-db9f5e859069",
                        "glosses": [
                            "Réunion de groupe, journée, organisée dans le but de se recueillir."
