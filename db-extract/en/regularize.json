                        ],
                        "examples": [
                            {
                                "example_id": "e5277012-a689-4f9f-9dbb-ee1521c586a3",
                                "sense_id": "8c05f18a-bd87-3b7d-887b-d621a5a6db0a",
                                "text": "Regularizing spelling was an important step in the advancement of literary society."
                            }
                        ]
