{
    "word_family": [
        "tumult",
        "tumultuary"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6230b502-2e23-3600-94d9-8ac6e8cdb112",
                    "sense_definition": "Characterized by loud, confused noise.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tumultuous</w> cheering from the stadium could be heard blocks away after the winning goal.",
                            "target_lang_translations": {
                                "tr": "Galibiyet golünün ardından stadyumdan yükselen <w>coşkulu</w> tezahüratlar sokaklar öteden duyulabiliyordu."
                            }
                        },
                        {
                            "text": "They struggled to hear each other over the <w>tumultuous</w> sound of the crashing waves.",
                            "target_lang_translations": {
                                "tr": "Kıyıya vuran dalgaların <w>gürültülü</w> sesi yüzünden birbirlerini duymakta zorlandılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "noisy",
                        "uproarious",
                        "clamorous",
                        "raucous"
                    ],
                    "antonyms": [
                        "quiet",
                        "calm"
                    ],
                    "common_phrases": [
                        "tumultuous roar",
                        "tumultuous noise"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yüksek ve karmaşık bir gürültü ile nitelenen; gürültülü, patırtılı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "gürültülü",
                                "target_lang_sense_clarification": "yüksek ve karmaşık sesler içeren"
                            },
                            {
                                "target_lang_word": "patırtılı",
                                "target_lang_sense_clarification": "bağrış çağrış veya kargaşa sesi barındıran"
                            },
                            {
                                "target_lang_word": "coşkulu",
                                "target_lang_sense_clarification": "tezahürat ve alkış için gürültülü seviyede coşkun"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35a6c789-c057-371d-b008-6ecd8314cc1f",
                    "sense_definition": "Causing or characterized by chaos, disorder, or intense emotional agitation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company went through a <w>tumultuous</w> period of restructuring that lasted for several months.",
                            "target_lang_translations": {
                                "tr": "Şirket, birkaç ay süren <w>çalkantılı</w> bir yeniden yapılanma sürecinden geçti."
                            }
                        },
                        {
                            "text": "After a <w>tumultuous</w> start to the season, the team finally began to play with more consistency.",
                            "target_lang_translations": {
                                "tr": "Sezona <w>fırtınalı</w> bir başlangıç yaptıktan sonra, takım nihayet daha istikrarlı oynamaya başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "chaotic",
                        "disorderly",
                        "riotous",
                        "tempestuous"
                    ],
                    "antonyms": [
                        "calm"
                    ],
                    "common_phrases": [
                        "tumultuous period",
                        "tumultuous start"
                    ],
                    "target_lang_definitions": {
                        "tr": "Kaos, düzensizlik, fırtınalı olaylar veya yoğun çalkantılarla dolu olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çalkantılı",
                                "target_lang_sense_clarification": "huzursuzluk ve karışıklık dolu dönemler veya durumlar için"
                            },
                            {
                                "target_lang_word": "fırtınalı",
                                "target_lang_sense_clarification": "mecazi olarak olaylı, karmaşık ve zorlu süreçler için"
                            },
                            {
                                "target_lang_word": "olaylı",
                                "target_lang_sense_clarification": "pek çok olayın ve kargaşanın yaşandığı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}