        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "09f7c1d0-f33d-3a1a-a640-92e4dd91fee9",
                    "sense_definition": "В настоящее время, на данный момент (подразумевается, что ситуация временная или может измениться).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_adverb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>пока</w> не знаю, что буду делать вечером.",
                            "target_lang_translations": {
                                "en": "I don't know <w>yet</w> what I'll do in the evening.",
                                "tr": "Akşam ne yapacağımı <w>henüz</w> bilmiyorum.",
                                "zh": "我<w>暂时</w>还不知道晚上要做什么。",
                                "nl": "Ik weet <w>nog</w> niet wat ik vanavond ga doen.",
                                "pl": "Jeszcze nie wiem, co będę robić wieczorem, <w>na razie</w> nie mam planów.",
                                "de": "Ich weiß <w>momentan</w> noch nicht, was ich heute Abend mache.",
                                "fr": "Je ne sais pas <w>encore</w> ce que je ferai ce soir.",
                                "it": "Non so <w>ancora</w> cosa farò stasera.",
                                "cs": "Já <w>zatím</w> nevím, co budu dělat večer.",
                                "es": "Todavía no sé qué voy a hacer por la tarde, <w>por ahora</w>."
                            }
                        },
                        {
                            "text": "Мы <w>пока</w> живём в маленькой квартире, но планируем переезд.",
                            "target_lang_translations": {
                                "en": "We are living in a small apartment <w>for now</w>, but we plan to move.",
                                "tr": "<w>Şimdilik</w> küçük bir dairede yaşıyoruz ama taşınmayı planlıyoruz.",
                                "zh": "我们<w>暂时</w>住在一个小公寓里，但计划搬家。",
                                "nl": "We wonen <w>voorlopig</w> in een klein appartement, maar we zijn van plan te verhuizen.",
                                "pl": "Mieszkamy <w>na razie</w> w małym mieszkaniu, ale planujemy przeprowadzkę.",
                                "de": "Wir wohnen <w>vorläufig</w> in einer kleinen Wohnung, planen aber umzuziehen.",
                                "fr": "Nous vivons dans un petit appartement <w>pour l'instant</w>, mais nous prévoyons de déménager.",
                                "it": "Viviamo in un piccolo appartamento <w>per ora</w>, ma abbiamo in programma di trasferirci.",
                                "cs": "My <w>zatím</w> bydlíme v malém bytě, ale plánujeme stěhování.",
                                "es": "<w>Por ahora</w> vivimos en un apartamento pequeño, pero planeamos mudarnos."
                            }
                        }
                    ],
                    "synonyms": [
                        "покамест",
                        "временно",
                        "на данный момент"
                    ],
                    "antonyms": [
                        "уже́"
                    ],
                    "common_phrases": [
                        "пока что",
                        "пока нет"
                    ],
                    "target_lang_definitions": {
                        "en": "At the present time, for the moment (implying the situation is temporary or may change).",
                        "tr": "Şu anda, bu an itibarıyla (durumun geçici olduğu veya değişebileceği ima edilir).",
                        "zh": "目前，暂时（暗示情况是暂时的或可能会改变）。",
                        "nl": "Op dit moment, voorlopig (impliceert dat de situatie tijdelijk is of kan veranderen).",
                        "pl": "W obecnej chwili, na dany moment (sugeruje, że sytuacja jest tymczasowa lub może ulec zmianie).",
