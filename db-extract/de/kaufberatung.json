                "senses": [
                    {
                        "sense_id": "a3e5ccf3-344e-3840-bd47-1829ec8de118",
                        "entry_id": "5213f6a5-f78e-3ce6-a6ee-09218f3a142d",
                        "glosses": [
                            "Beratung bei Kaufentscheidungen; Unterstützung/Hilfestellung bei der Auswahl eines Produkts, das man beabsichtigt zu kaufen, häufig als Gespräch mit einem Verkäufer oder Experten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c96a36e-0fe5-4e99-9fd7-2fd16ee875ca",
                                "sense_id": "a3e5ccf3-344e-3840-bd47-1829ec8de118",
                                "text": "„Alle weiteren Infos und die ausführlichen Testergebnisse lesen Sie in der umfangreichen Kaufberatung.“"
                            },
                            {
                                "example_id": "5b0a2514-9281-4341-a359-e00f4c451851",
                                "sense_id": "a3e5ccf3-344e-3840-bd47-1829ec8de118",
                                "text": "„Damit Sie Ihrem Kunden schnell und sicher das richtige Laufwerk empfehlen können, zeigt REATAILmagazin auf was Sie bei der Kaufberatung achten müssen.“"
                            },
                            {
                                "example_id": "32d9d50e-374c-4453-b6ee-ebcb7cf41745",
                                "sense_id": "a3e5ccf3-344e-3840-bd47-1829ec8de118",
                                "text": "„Um Ihnen die Entscheidung zu erleichtern und Fehlkäufe zu vermeiden, haben wir hier eine umfassende Kaufberatung mit allem Wissenswerten rund um Fahrrad-Rahmenschutz zusammengestellt.“"
                            },
                            {
                                "example_id": "61d76690-442b-4258-bf35-fbdae5f7d4ce",
                                "sense_id": "a3e5ccf3-344e-3840-bd47-1829ec8de118",
                                "text": "„Zwar findet man in Fachgeschäften oft Experten, die eine gute Kaufberatung und Fachwissen bieten, allerdings sind diese Verkäufer eben auch geschult ein Produkt an den Mann zu bringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
