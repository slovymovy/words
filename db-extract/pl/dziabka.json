                                "target_senses": [
                                    {
                                        "sense_id": "35a68257-58a4-3661-8bd2-abe4308d55dd",
                                        "entry_id": "43ef4de8-156b-3a21-be6e-020ca7ec61fd",
                                        "glosses": [
                                            "с.-х. ручное земледельческое орудие для рыхления или копки, металлический или каменный наконечник, насаженный под углом на длинную рукоятку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56349b3c-ac66-49fc-9186-6e752be17352",
                                                "sense_id": "35a68257-58a4-3661-8bd2-abe4308d55dd",
                                                "text": "Любопытней всего, что мотыга в до предела механизированной Америке устояла перед машиной на самых плодородных землях, прилегающих к Миссисипи."
                                            },
                                            {
                                                "example_id": "e5b4aa5d-59be-4d90-96dc-c92d966685ab",
                                                "sense_id": "35a68257-58a4-3661-8bd2-abe4308d55dd",
                                                "text": "Для выкопки картофеля служили прочные стальные мотыги с треугольными и плоскими рожками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12e9995c-82e5-3bf0-94ef-03b7e0e13d4d",
                                        "entry_id": "43ef4de8-156b-3a21-be6e-020ca7ec61fd",
                                        "glosses": [
                                            "перен., вульг. высокая, долговязая, неловкая девушка"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "мотыга",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2509fbd6-0af1-34f5-8f78-8112135fb9b7",
                                        "entry_id": "589596f9-46e5-3a53-970c-341e13b1d4e3",
                                        "glosses": [
                                            "устар., разг. тот, кто нерасчётливо или неразумно расходует деньги, имущество"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf370073-26b2-495e-bec4-f7f1be180b26",
                                                "sense_id": "2509fbd6-0af1-34f5-8f78-8112135fb9b7",
                                                "text": "Сын мотыга, гордец, француз, построил себе дом в Москии, переехали жильцы."
                                            },
                                            {
                                                "example_id": "c248ec37-35b6-4052-88d3-f4495184eefa",
                                                "sense_id": "2509fbd6-0af1-34f5-8f78-8112135fb9b7",
                                                "text": "Вестимо, ты мотыга; вот уж с месяц, как взял у меня три рубля, а и в помине о них нет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
