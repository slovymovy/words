                "senses": [
                    {
                        "sense_id": "abf23a19-1c88-35f9-9890-15389c4bc5aa",
                        "entry_id": "a049174c-a6d6-37fc-a30a-ac47b4468ba4",
                        "glosses": [
                            "niederländischer Aufständischer im Achtzigjährigen Krieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c78df06b-c6eb-4744-820b-de346d5bbdf1",
                                "sense_id": "abf23a19-1c88-35f9-9890-15389c4bc5aa",
                                "text": "„Doch auch die Geusen blieben nicht von den religiösen Gegensätzen der Zeit verschont.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1893eec7-abe7-49f6-8eb6-9a060ff5d4c4",
