                        "examples": [
                            {
                                "example_id": "6b7e612a-f406-4bc2-9d23-958b8bc9e061",
                                "sense_id": "96cff786-9223-3241-83d9-43b2f452eb3b",
                                "text": "Boghan est un petit village entièrement arabe, cramponné sur le dos d'un mamelon soleilleux et toujours aride."
                            },
                            {
                                "example_id": "a7b9d1fc-fc06-4742-a5d0-d6a9eea8a80a",
                                "sense_id": "96cff786-9223-3241-83d9-43b2f452eb3b",
                                "text": "Parcourir, un jour, les rues calmes, aux larges pans d’ombre et de lumière, le lendemain, les allées soleilleuses de la forêt de Soignes."
                            },
                            {
                                "example_id": "7bbdf442-1caa-45be-83b4-33448d9bda2e",
                                "sense_id": "96cff786-9223-3241-83d9-43b2f452eb3b",
                                "text": "Et moi, je considérai dans mon cœur la basse maison girondine de mon enfance, l’allée du « tour du rond », les vignes soleilleuses, l’immobile vivier et la chapelle vêtue de lierres et de roses …"
                            }
                        ]
                    }
