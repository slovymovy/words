                        "glosses": [
                            "ein Mittel, das einen Schwangerschaftsabbruch herbeiführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab66eaf-81a7-4a30-ac85-92ec86f3ff07",
                                "sense_id": "a02a1b5b-5588-3a83-97cc-28c686e118aa",
                                "text": "„Unterschieden werden die Empfängnisverhütungsmittel, die eine Befruchtung verhindern, von den sog. Abortiva, die die Einnistung (Nidation) des befruchteten Eies in die Uterusschleimhaut verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "157c8372-c192-3abd-a72b-d85dc28b2f13",
                        "entry_id": "06103d04-2763-3f6f-b653-2228c804c820",
                        "glosses": [
                            "ein Mittel, das den Verlauf einer Krankheit deutlich verkürzt oder ihren Ausbruch verhindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b52063d0-84d9-485b-aa1e-2aaad777deac",
                                "sense_id": "157c8372-c192-3abd-a72b-d85dc28b2f13",
                                "text": "In Indien wurde Hanf schon zu vedischer Zeit (ab 1500 vor Christus) als Abortivum verwendet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
