                "senses": [
                    {
                        "sense_id": "c948ca79-74c9-32a4-aa41-e02b47f20a75",
                        "entry_id": "2ad332cf-5e48-3587-b51e-f7b517863315",
                        "glosses": [
                            "das kulturelle Umfeld, in dem Literatur produziert, vermittelt und konsumiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b177c9e-d738-4a7f-b5ee-5c33aa171198",
                                "sense_id": "c948ca79-74c9-32a4-aa41-e02b47f20a75",
                                "text": "„Als ehemaliger Grazer Stadtschreiber (1993 bis 1994) und Vortagender an der Universität Graz ist der gebürtige Wiener und seit 1980 in Rettenegg lebende Schriftsteller und Dichter mit der Literaturszene der Steiermark eng verbunden.“"
                            },
                            {
                                "example_id": "017007ac-c04b-40bf-ab33-c86d57c5740a",
                                "sense_id": "c948ca79-74c9-32a4-aa41-e02b47f20a75",
                                "text": "„In der jiddischen Literaturszene war Abramowitsch von Beginn an als ein herausragender Schriftsteller anerkannt.“"
                            },
                            {
                                "example_id": "f7c52969-c32f-4bf4-a3fa-d1f1445bf658",
                                "sense_id": "c948ca79-74c9-32a4-aa41-e02b47f20a75",
                                "text": "„Obwohl sich Jünger dort virtuos bewegt, ist ihm eine gewisse Blindheit angesichts der regen Pariser Literaturszene und ihrer glanzvollen Inszenierungen nicht abzusprechen.“"
                            },
                            {
                                "example_id": "c1d81540-32be-4611-ad39-773e217cfb35",
                                "sense_id": "c948ca79-74c9-32a4-aa41-e02b47f20a75",
                                "text": "„Eine dynamische Literaturszene, die alle Genres von der Lyrik über Romane und Kurzgeschichten bis zu Community Theatre, von politischer Bekenntnisliteratur über Kriegserinnerungen bis zu Bekundungen eines ausgeprägten Individualismus in beeindruckender Breite aufwies, fand in den frühen 1990er Jahren in der internationalen afrikanischen Buchmesse in Harare eine Art Schaufenster und Treffpunkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
