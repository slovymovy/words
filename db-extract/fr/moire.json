        "fr-extract.jsonl": [
            {
                "entry_id": "a840f00a-8291-398b-8531-6487848ae758",
                "word": "moire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "690f4efc-1e90-4ef3-a525-f24d830f4313",
                        "entry_id": "a840f00a-8291-398b-8531-6487848ae758",
                        "tags": [
                            "plural"
                        ],
                        "form": "moires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec7fb4df-5885-3af4-a87e-71145a3a440b",
                        "entry_id": "a840f00a-8291-398b-8531-6487848ae758",
                        "glosses": [
                            "Apprêt que reçoivent, par un calandrage spécifique, certaines étoffes de soie, de laine, de coton ou de lin, et qui leur communique un éclat changeant, une apparence ondée et chatoyante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af9f4ba0-7032-4c71-b18b-4ea2a56593d2",
                                "sense_id": "ec7fb4df-5885-3af4-a87e-71145a3a440b",
                                "text": "Moire à grands, à riches effets."
                            },
                            {
                                "example_id": "28fad8e6-aef1-434b-9fb3-247a90dd7e52",
                                "sense_id": "ec7fb4df-5885-3af4-a87e-71145a3a440b",
                                "text": "Moire à petites ondes."
                            },
                            {
                                "example_id": "c3992e45-717f-4035-9218-c5de0adf3289",
                                "sense_id": "ec7fb4df-5885-3af4-a87e-71145a3a440b",
                                "text": "Cette popeline a bien pris la moire."
                            },
                            {
                                "example_id": "299ed1f3-8cbb-4ac2-b298-09ef683e7598",
                                "sense_id": "ec7fb4df-5885-3af4-a87e-71145a3a440b",
                                "text": "Plus loin s’étend la plaine où le Guadalquivir promène la moire de son cours."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0942d52-520f-3e2f-897b-05576457995b",
                        "entry_id": "a840f00a-8291-398b-8531-6487848ae758",
                        "glosses": [
                            "Reflet, éclat, chatoiement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7e96fca2-c1cf-4daf-a656-d10487eca195",
                                "sense_id": "a0942d52-520f-3e2f-897b-05576457995b",
                                "text": "S’étant détournée de la glace, elle alla soulever le coin d’un rideau et vit par la fenêtre, à travers les arbres noirs du quai, sous un jour blême, la Seine traîner ses moires jaunes."
                            },
                            {
                                "example_id": "e4e227ea-26d0-4238-b8ea-382349aa9366",
                                "sense_id": "a0942d52-520f-3e2f-897b-05576457995b",
                                "text": "Ils voyaient le barragiste aller et venir devant eux, et sa haute taille se découpait sur la moire glissante des eaux, se penchant d’un mouvement régulier, pour relever les aiguilles de sapin."
                            },
                            {
                                "example_id": "aac73756-7ff7-498a-99a4-388bb8784f96",
                                "sense_id": "a0942d52-520f-3e2f-897b-05576457995b",
                                "text": "Le soleil, réverbéré sur les eaux, faisait courir le long des murs des moires chatoyantes."
                            },
                            {
                                "example_id": "d8a0fb3e-8b9c-41fe-9fb5-b2368e8f704f",
                                "sense_id": "a0942d52-520f-3e2f-897b-05576457995b",
                                "text": "L’enfant tourna un peu la tête vers la fenêtre. Il resta ainsi, de biais, à regarder la moire, sur le mur, du soleil reflété par la mer."
                            },
                            {
                                "example_id": "edcc2c97-e7a1-4715-93f9-06141ba35205",
                                "sense_id": "a0942d52-520f-3e2f-897b-05576457995b",
                                "text": "La pluie se détacha du ciel, d’un seul coup. Des moires d’argent jouèrent sur la pelouse."
                            }
                        ]
                    },
                    {
                        "sense_id": "20966ae9-65e8-3631-aa86-0458876cebbd",
                        "entry_id": "a840f00a-8291-398b-8531-6487848ae758",
                        "glosses": [
                            "Étoffe qui a reçu ce genre d’apprêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa09c81-90f3-41d5-a59c-8524677fce1b",
                                "sense_id": "20966ae9-65e8-3631-aa86-0458876cebbd",
                                "text": "[…] ; et voici, en robe de moire, la dame châtelaine qui contemple à son balcon la belle nuit étoilée et le beau lac endormi."
                            },
                            {
                                "example_id": "3ab79d9f-994d-4bb5-9157-50a22bed6ad3",
                                "sense_id": "20966ae9-65e8-3631-aa86-0458876cebbd",
                                "text": "Marie ne cesse pas de regarder la carte lithographiée, qui est épinglée au large ruban de moire sous un flot de tulle."
                            }
                        ]
                    },
                    {
                        "sense_id": "618dcb85-cfad-3eb0-aaec-750b1754ac9f",
                        "entry_id": "a840f00a-8291-398b-8531-6487848ae758",
                        "glosses": [
                            "Étoffe qui a reçu ce genre d’apprêt.",
                            "Moire antique : Tissu dont le moire présente de grandes ondulations."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c198598e-f60c-3a76-b12a-ba7a1817d03c",
                        "entry_id": "a840f00a-8291-398b-8531-6487848ae758",
                        "glosses": [
                            "Étoffe qui a reçu ce genre d’apprêt.",
                            "Moire changeante: Effet de moire sur un tissu dont la trame et la chaîne sont de couleurs différentes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1466f9e8-f7f5-3d60-8c79-e2d95093fa80",
                        "entry_id": "a840f00a-8291-398b-8531-6487848ae758",
                        "glosses": [
                            "Étoffe qui a reçu ce genre d’apprêt.",
                            "Moire pradaz : Dont les dessins font ressembler le tissu à des cartons perforés d’orgue de Barbarie. (synonyme : Moire musique)."
                        ],
                        "tags": [],
