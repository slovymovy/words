                        "examples": [
                            {
                                "example_id": "ac04e584-7285-4f4a-b215-044f7b557922",
                                "sense_id": "7d16f45e-20aa-3ad3-b8ce-42b72de10451",
                                "text": "Het idee? 'De Winddrinker zet brak water om in zoet drinkwater. De ontziltingspomp wordt aangedreven door een windmolen. Hiermee kan het gedeeltelijk een oplossing bieden voor het drinkwaterprobleem in ontwikkelingslanden.'"
                            },
                            {
                                "example_id": "c9ac7bf0-b2a7-417d-accc-fec778b7b048",
                                "sense_id": "7d16f45e-20aa-3ad3-b8ce-42b72de10451",
                                "text": "Documentaire over de Franse ingenieur Georges Mougin, die het drinkwaterprobleem in droge streken wil oplossen door er ijsbergen naartoe te slepen. Jaarlijks breken er talloze blokken zoet water af van de poolgletsjers. Ze drijven rond en smelten weg in de zoute zee. Zonde, vindt Mougin."
                            }
                        ]
                    }
