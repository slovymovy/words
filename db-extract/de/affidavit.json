                ],
                "senses": [
                    {
                        "sense_id": "a79cb1c2-1f01-3e24-aee1-9299281fd4b9",
                        "entry_id": "d39f520f-f948-374d-8c25-05480a9c1e55",
                        "glosses": [
                            "eidesstattliche Versicherung/eidesstattliche Erklärung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41df464-45f4-48fe-95d5-9b8cd1f78f98",
                                "sense_id": "a79cb1c2-1f01-3e24-aee1-9299281fd4b9",
                                "text": "„Es giebt Barbiere, betreffs deren man ein eidesstättiges Affidavit abgeben könnte, daß sie irgend einmal, wo nicht heute, so doch morgen, ein Unheil anrichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca2f5173-c629-33aa-aef5-b885cdbd7331",
                        "entry_id": "d39f520f-f948-374d-8c25-05480a9c1e55",
                        "glosses": [
                            "Bürgschaftserklärung eines heimischen Bürgers für einen Einwanderer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "359c9c6b-c2fa-4d70-b58f-56632fdc1349",
                                "sense_id": "ca2f5173-c629-33aa-aef5-b885cdbd7331",
                                "text": "„Damals, als die Lage in Europa allzu bedrohlich wurde, schrieb Alice Falkenberg schließlich an ihre Cousine in Amerika und fragte an, was ein Affidavit sei.“"
                            },
                            {
                                "example_id": "ad9d8a29-dcc9-48ed-aad8-da0fc7dc31c0",
                                "sense_id": "ca2f5173-c629-33aa-aef5-b885cdbd7331",
                                "text": "„Als die USA Emigranten aus Deutschland nur noch mit der persönlichen Bürgschaft eines Amerikaners einwandern ließen, wandte sich Laemmle in Bittbriefen an die jüdische Prominenz Hollywoods, möglichst großzügig solche Bürgschaften (›Affidavits‹) zu leisten.“"
                            },
                            {
                                "example_id": "306afbe0-3f49-40ba-add9-3dc0c930efeb",
                                "sense_id": "ca2f5173-c629-33aa-aef5-b885cdbd7331",
                                "text": "„Mitten auf hoher See erhielten wir ein Kabel von unserer Freundin Dorothy Thompson aus New York, die für eines der beiden ›Affidavits‹ gebürgt hatte, wie man sie zum Einreisevisum in die USA benötigt.“"
                            },
                            {
                                "example_id": "0183e334-4ac9-47d0-b0a4-c797218f8c57",
                                "sense_id": "ca2f5173-c629-33aa-aef5-b885cdbd7331",
                                "text": "„Vor den amerikanischen Konsulaten in Wien, Prag, Paris oder Marseille drängten sich die Menschen in der Hoffnung, die begehrten Affidavits zu erlangen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6c80289-8cda-4e29-b104-42ec39dd84d3",
                        "source_entry_id": "d39f520f-f948-374d-8c25-05480a9c1e55",
                        "source_sense_id": "a79cb1c2-1f01-3e24-aee1-9299281fd4b9",
                        "source_sense_description": "eidesstattliche Versicherung/eidesstattliche Erklärung",
                        "target_lang_word": "affidavit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affidavit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec4f25fd-e131-37aa-abbe-63913c79c788",
                                        "entry_id": "d3ac098c-0761-3d2c-91cf-ea688e24c8d8",
                                        "glosses": [
                                            "A signed document wherein an affiant makes a sworn statement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b0caaf-0982-4d83-bab4-1aefc38d53ce",
                                                "sense_id": "ec4f25fd-e131-37aa-abbe-63913c79c788",
                                                "text": "He submitted his affidavit rather than appearing to testify in court."
                                            },
                                            {
                                                "example_id": "c2bdf334-162d-4ee8-95dd-4923e36a312f",
                                                "sense_id": "ec4f25fd-e131-37aa-abbe-63913c79c788",
                                                "text": "Lee's case is urgent. He has to file an immediate affidavit that he is suffering from bubonic plague to avoid eviction from the house he has occupied ten years without paying the rent."
                                            },
                                            {
                                                "example_id": "a33dfbe0-99ac-4b79-9ec2-c0623cc63d42",
                                                "sense_id": "ec4f25fd-e131-37aa-abbe-63913c79c788",
                                                "text": "All lifters were certified by affidavit and polygraph to be steroid free."
                                            }
                                        ]
                                    }
                                ]
                            },
