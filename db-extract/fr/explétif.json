                    },
                    {
                        "form_id": "4917f6a0-2802-405f-a0cb-268950fb3848",
                        "entry_id": "2b967dec-bb1d-33cd-8e8c-031f671201ed",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "explétives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8fb3e00f-440a-3000-b22a-17ca294c4796",
                        "entry_id": "2b967dec-bb1d-33cd-8e8c-031f671201ed",
                        "glosses": [
                            "Qui, sans être nécessaire au sens d’une phrase, y introduit cependant une nuance, et souvent la renforce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58dc31d1-5e12-4f1c-bba9-1c66bee4ea3b",
                                "sense_id": "8fb3e00f-440a-3000-b22a-17ca294c4796",
                                "text": "Dans les phrases « À moins qu’il ne pleuve », « Regarde-moi ce bazar » et « Je vous le traiterai comme il le mérite », « ne », « moi » et « vous » sont des mots explétifs. Dans le cas de « moi » et « vous », on parle également de « datif éthique »."
                            },
                            {
                                "example_id": "3fb82794-5000-48c2-accb-932e783db5e7",
                                "sense_id": "8fb3e00f-440a-3000-b22a-17ca294c4796",
                                "text": "Particule explétive : Petit mot ou partie de mot qui s’ajoute à un autre mot sans en changer la signification et qui était en usage fréquent dans les langues grecque et latine. On en trouve quelques exemples en français ; ainsi on dit Non pas ! et Oui-da !"
                            },
                            {
                                "example_id": "87dac6cb-55fb-4b60-b372-468a0ca793f7",
                                "sense_id": "8fb3e00f-440a-3000-b22a-17ca294c4796",
                                "text": "Marco se laissa aller à des explétifs, des « bon, enfin passons », des « ah là là, je ne sais plus où j’en suis », des « n’est-ce pas » multipliés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b067227f-03ca-4a63-8fca-ddeb0d65297f",
                        "source_entry_id": "2b967dec-bb1d-33cd-8e8c-031f671201ed",
                        "source_sense_id": "8fb3e00f-440a-3000-b22a-17ca294c4796",
                        "source_sense_description": "Qui renforce",
                        "target_lang_word": "expletive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expletive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76f6dc86-422e-3d5c-988c-c37c56ec8b3c",
                                        "entry_id": "215b5a8a-165f-3c2b-b022-3f415b567d2c",
                                        "glosses": [
                                            "Serving to fill up, merely for effect, otherwise redundant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "128399c2-be6a-461f-a3c7-1557ced933dc",
                                                "sense_id": "76f6dc86-422e-3d5c-988c-c37c56ec8b3c",
                                                "text": "No one entered more fully than Shakespeare into the character of this species of poetry, which admits of no expletive imagery, no merely ornamental line."
                                            },
                                            {
                                                "example_id": "2d57e7fb-e9b7-48a8-b554-699288529683",
                                                "sense_id": "76f6dc86-422e-3d5c-988c-c37c56ec8b3c",
                                                "text": "deprecating being taken for ſerious, or to be underſtood that he meaneth any thing by them; but only that he uſeth them as expletive phraſes ... to plump his ſpeech, and fill up ſentences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b4718cf-255c-3069-b539-bbf5c78e8139",
                                        "entry_id": "215b5a8a-165f-3c2b-b022-3f415b567d2c",
                                        "glosses": [
                                            "Marked by expletives (phrase-fillers)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expletive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85d11f37-a690-32f9-8e95-86aed7f67971",
                                        "entry_id": "d481d4a3-1760-33b4-9a56-f91dd91575ed",
                                        "glosses": [
                                            "A profane, vulgar term, notably a curse or obscene oath."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da55309f-8e1f-4d17-bb90-187acdce9600",
                                                "sense_id": "85d11f37-a690-32f9-8e95-86aed7f67971",
                                                "text": "If we don't take advantage of any [expletive] in any way, then it's our loss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e90d106-e192-3d83-a005-60a83930a111",
                                        "entry_id": "d481d4a3-1760-33b4-9a56-f91dd91575ed",
                                        "glosses": [
                                            "A word without meaning added to fill a syntactic position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "575530b2-c71d-3d90-bec0-de348b61cd68",
                                        "entry_id": "d481d4a3-1760-33b4-9a56-f91dd91575ed",
                                        "glosses": [
                                            "A word that adds to the strength of a phrase without affecting its meaning (such as fuckin in \\\"there's no fuckin way he's gonna get away with it\\\")."
                                        ],
                                        "tags": [],
                                        "examples": []
