                    },
                    {
                        "translation_id": "f863ce11-bf7c-4998-a491-e3d44564ea70",
                        "source_entry_id": "2affe929-1a4e-38ff-ba77-1dff067ad581",
                        "source_sense_id": "8ef8d1dd-aaee-3afb-a1b8-25e16a4204dc",
