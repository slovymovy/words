    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ebb6989-d594-3ae0-87c8-111295fff8ad",
                    "sense_definition": "cecha charakterystyczna kogoś lub czegoś; cecha przypisana danemu obiektowi lub substancji",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cecha",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Woda w stanie ciekłym ma niezwykłe <w>właściwości</w> fizyczne.",
                            "target_lang_translations": {
                                "ru": "Вода в жидком состоянии обладает необычными физическими <w>свойствами</w>."
                            }
                        },
                        {
                            "text": "Ten miód ma znane od wieków <w>właściwości</w> lecznicze.",
                            "target_lang_translations": {
                                "ru": "Этот мёд обладает известными с древних времён лечебными <w>свойствами</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cecha",
                        "własność"
                    ],
                    "common_phrases": [
                        "właściwości fizyczne",
                        "właściwości chemiczne",
                        "właściwości lecznicze"
                    ],
                    "target_lang_definitions": {
                        "ru": "характерная черта, качество кого-либо или чего-либо; присущий объекту или веществу признак"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свойство",
                                "target_lang_sense_clarification": "качество, отличительная черта или характеристика вещества, предмета"
                            },
                            {
                                "target_lang_word": "качество",
                                "target_lang_sense_clarification": "характерная черта или особенность"
                            },
                            {
                                "target_lang_word": "признак",
                                "target_lang_sense_clarification": "показатель или особенность, по которой что-либо определяют"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40b33b0d-5927-37cb-957e-803a3bfeef05",
                    "sense_definition": "cecha czegoś, co jest odpowiednie, stosowne lub takie, jakie być powinno",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "odpowiedniość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor ocenił <w>właściwość</w> takiego zachowania w miejscu pracy.",
                            "target_lang_translations": {
                                "ru": "Директор оценил <w>уместность</w> подобного поведения на рабочем месте."
                            }
                        },
                        {
                            "text": "Mamy wątpliwości co do <w>właściwości</w> podjętych wczoraj kroków.",
                            "target_lang_translations": {
                                "ru": "У нас есть сомнения относительно <w>правильности</w> предпринятых вчера шагов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "соответствие установленным требованиям, правилам или ситуации; уместность, надлежащий характер"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уместность",
                                "target_lang_sense_clarification": "соответствие обстановке или случаю"
                            },
                            {
                                "target_lang_word": "правильность",
                                "target_lang_sense_clarification": "соответствие нормам, надлежащее состояние"
                            },
                            {
                                "target_lang_word": "целесообразность",
                                "target_lang_sense_clarification": "оправданность или соответствие цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "867c93f4-89f0-35bb-aeaf-010476fe7e2f",
                    "sense_definition": "zakres uprawnień sądu lub innego organu państwowego do rozpoznawania i rozstrzygania określonych spraw",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąd uznał brak swojej <w>właściwości</w> miejscowej i przekazał sprawę dalej.",
                            "target_lang_translations": {
                                "ru": "Суд признал отсутствие своей территориальной <w>подсудности</w> и передал дело дальше."
                            }
                        },
                        {
                            "text": "Pismo odesłano zgodnie z <w>właściwością</w> rzeczową do innego urzędu.",
                            "target_lang_translations": {
                                "ru": "Письмо перенаправили в соответствии с предметной <w>подведомственностью</w> в другое ведомство."
                            }
                        }
                    ],
                    "common_phrases": [
                        "właściwość miejscowa",
                        "właściwość rzeczowa",
                        "właściwość sądu"
                    ],
                    "target_lang_definitions": {
                        "ru": "полномочия суда или другого государственного органа рассматривать и разрешать определённые дела"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсудность",
                                "target_lang_sense_clarification": "компетенция судебного органа по рассмотрению дела"
                            },
                            {
                                "target_lang_word": "подведомственность",
                                "target_lang_sense_clarification": "отнесение спора к компетенции определённого органа"
                            },
                            {
                                "target_lang_word": "компетенция",
                                "target_lang_sense_clarification": "круг установленных законом полномочий органа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}