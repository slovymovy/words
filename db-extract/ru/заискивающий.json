                        "cross_references": [
                            {
                                "target_word": "obséquieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e6ac7da-16dd-3272-8c61-63f496be6198",
                                        "entry_id": "8236099d-6955-3658-8a04-0bf9caf227e1",
                                        "glosses": [
                                            "Qui porte à l’excès les témoignages de respect, les égards, la complaisance, les attentions, par servilité ou hypocrisie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bed1cc10-5077-45d5-8fb9-9165b6906bde",
                                                "sense_id": "5e6ac7da-16dd-3272-8c61-63f496be6198",
                                                "text": "Un courtisan est un homme de la cour du roi, j’entends un homme qui a une charge ou un emploi domestique dans le palais, […], qui à ce titre reçoit de l’argent, et parle au maître avec tout le respect obséquieux, avec toutes les humbles salutations convenables à l’emploi."
                                            },
                                            {
                                                "example_id": "cea15a08-99e2-4ffc-965b-324fdc2fe73a",
                                                "sense_id": "5e6ac7da-16dd-3272-8c61-63f496be6198",
                                                "text": "L’étranger arriva ici pauvre, mendiant, obséquieux et rampant, prêt à ôter son bonnet devant le dernier valet de la maison."
                                            },
                                            {
                                                "example_id": "08dba673-c69d-426e-bd61-2fff1790838f",
                                                "sense_id": "5e6ac7da-16dd-3272-8c61-63f496be6198",
                                                "text": "D’obséquieux flatteurs le comparaient au prince Noir, à Alcibiade, à César."
                                            },
                                            {
                                                "example_id": "93f1928a-f87f-4b36-b4c5-5754b6feb746",
                                                "sense_id": "5e6ac7da-16dd-3272-8c61-63f496be6198",
                                                "text": "Par le trou de la serrure, elle entrevit une grande femme sèche et ridée, au sourire obséquieux, qui devait être la négociatrice professionnelle des mariages, […]."
                                            },
                                            {
                                                "example_id": "cb759ba9-b783-4580-83e9-e9cffd7e00b0",
                                                "sense_id": "5e6ac7da-16dd-3272-8c61-63f496be6198",
                                                "text": "Le huguenot, d’un air obséquieux et vain, les yeux fermés et la bouche ouverte, salua."
                                            },
                                            {
                                                "example_id": "ab008505-84d9-4271-aee1-90d25bd0a6c6",
                                                "sense_id": "5e6ac7da-16dd-3272-8c61-63f496be6198",
                                                "text": "Mais quand le sénateur obséquieux et moralisateur Ted Cruz est monté sur scène, ça ne s’est pas passé comme prévu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
