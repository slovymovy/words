                            {
                                "example_id": "f61893a2-0972-4da4-827d-b67fb6be2615",
                                "sense_id": "1d0230ca-c11f-3420-b3e9-87c326d4eb8d",
                                "text": "„Die Staats- und Regierungschefs billigten schließlich einen großen Maßnahmenkatalog, zu dem verstärkte diplomatische Beziehungen zu Ländern im Nahen Osten, in Nordafrika und dem westlichen Balkan gehören.“"
                            },
                            {
                                "example_id": "279fb10c-1bda-4874-9f70-ebd7a5a75d67",
                                "sense_id": "1d0230ca-c11f-3420-b3e9-87c326d4eb8d",
                                "text": "„Die bisherigen Beschreibungen und Erklärungen zum Thema Stürze im Alter fordern einen entsprechenden Maßnahmenkatalog zur Reduzierung der menschlich tragisch und volkswirtschaftlich belastenden Entwicklung.“"
                            }
                        ],
