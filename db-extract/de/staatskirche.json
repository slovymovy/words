                        "form": "die Staatskirche"
                    },
                    {
                        "form_id": "24055c5e-9720-48cb-be40-5a52e6988545",
                        "entry_id": "a7a0d1c5-4908-3630-8e74-dec55b77f2b9",
                        "tags": [
