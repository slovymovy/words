                    {
                        "translation_id": "359a440d-79ec-4f24-a237-862666dd620a",
                        "source_entry_id": "18bd65c2-9877-3974-ad0c-af835b6f236e",
                        "target_lang_word": "якутский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "якутский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "50109b24-1d49-3494-8588-4beeadc00a29",
                                        "entry_id": "0de9ee2d-633a-3fc3-8b97-fbcc1addfed5",
                                        "glosses": [
                                            "относящийся к Якутии, к Якутску, к якутам или к их языку, находящийся в Якутии или в Якутске, свойственный Якутии, Якутску или якутам и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd5b77fc-b17f-42f1-a2a7-fe9b7deae29c",
                                                "sense_id": "50109b24-1d49-3494-8588-4beeadc00a29",
                                                "text": "Плотников, учитель русской литературы в Якутии, проработавший среди якутов двадцать пять лет, всю жизнь собирал якутский эпос."
                                            },
                                            {
                                                "example_id": "76ced26d-276f-4360-81eb-7b2d5954faa6",
                                                "sense_id": "50109b24-1d49-3494-8588-4beeadc00a29",
                                                "text": "Неплохая, скажем мягко, находка случилась у якутских алмазодобытчиков."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43403782-df36-3f1d-b758-d179711144c3",
                                        "entry_id": "0de9ee2d-633a-3fc3-8b97-fbcc1addfed5",
                                        "glosses": [
                                            "субстантивир., лингв. то же, что якутский язык"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed232f8-a0b9-4049-b1f1-042657a2a158",
                                                "sense_id": "43403782-df36-3f1d-b758-d179711144c3",
                                                "text": "Алтайские языки включают турецкий, монгольский, якутский, азербайджанский, узбекский, казахский, киргизский…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
