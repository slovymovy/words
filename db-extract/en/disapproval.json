                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66793493-3148-4268-8cd0-f812c86b3a28",
                        "source_entry_id": "57a67ba5-fae1-3af6-b928-2319c5f1b9f8",
                        "source_sense_id": "73f4253a-7e02-3b53-ba32-fe845649bf61",
                        "source_sense_description": "Missbilligung, Missfallen",
                        "target_lang_word": "Missfallen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Missfallen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eae4864e-d8ab-3afb-b592-987be8f48f3f",
                                        "entry_id": "f5e70b2b-8de2-37f1-a3c0-2ebe74c9d1d6",
                                        "glosses": [
                                            "Ablehnung oder Unzufriedenheit über etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3005857-5523-406e-8c62-0e2d399ae4b9",
                                                "sense_id": "eae4864e-d8ab-3afb-b592-987be8f48f3f",
                                                "text": "„Mit Missfallen haben Merkels Gegner in den vergangenen Monaten beobachtet, wie sich der politische Druck von Merkel weg- und auf die CDU-Vorsitzende zubewegte.“"
                                            },
                                            {
                                                "example_id": "9795cc22-3334-4b93-ad4b-fd790a2b6b68",
                                                "sense_id": "eae4864e-d8ab-3afb-b592-987be8f48f3f",
                                                "text": "„Graf Ilja Andrejewitsch bemerkte zu seinem Missfallen, dass die Gesellschaft vornehmlich aus solchen Herren und Damen bestand, deren sehr freie Umgangsformen allgemein bekannt waren.“"
                                            },
                                            {
                                                "example_id": "509a245c-d1c2-45c7-8df2-bc6b3b6dbdc8",
                                                "sense_id": "eae4864e-d8ab-3afb-b592-987be8f48f3f",
                                                "text": "„Die rasche Abkehr der USA von ihrem Land nach dem sowjetischen Abzug aus Afghanistan (1989) war auf großes Missfallen gestoßen, zumal dies erhebliche volkswirtschaftliche Folgen gehabt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
