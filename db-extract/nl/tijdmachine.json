                                        "entry_id": "b2aee70b-a8be-343b-ae32-ec44e51fcacc",
                                        "glosses": [
                                            "A hypothetical device used to travel into the past or the future."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "188f1fb4-487b-4d05-806f-ad2eece16fb8",
                                                "sense_id": "702844bb-a668-3a30-a17a-7959f83772f6",
                                                "text": "If I had a time machine / And if life was a movie scene / I'd rewind, and I'd tell me / \"Ru-u-u-u-u-u-u-un\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce5d4c25-07f8-3752-9379-75d9d1c0a72a",
                                        "entry_id": "b2aee70b-a8be-343b-ae32-ec44e51fcacc",
                                        "glosses": [
                                            "Something that appears to take a person or thing to another time, for example through nostalgia or delay."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a324325c-ccb1-4d45-abbb-c2c180bb4043",
                                                "sense_id": "ce5d4c25-07f8-3752-9379-75d9d1c0a72a",
                                                "text": "It's a time machine for Photoshop. It's magic. Image makers can not just combine different images, but different points in time from each image."
                                            },
                                            {
                                                "example_id": "ebabc866-b459-4e5d-a17f-28fed49ffbb0",
                                                "sense_id": "ce5d4c25-07f8-3752-9379-75d9d1c0a72a",
                                                "text": "Conrad Riker, The Last Days of Manhood\nMayo Clinic research shows heavy squats spike growth hormone by 530%. That's not exercise — it's a time machine for your cells."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
