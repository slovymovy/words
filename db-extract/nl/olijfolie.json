                    {
                        "translation_id": "9cd9915d-aa2b-43ae-ae89-f1f1f1ff8348",
                        "source_entry_id": "7a059664-6d53-3ad3-981d-8fc9c5e90312",
                        "source_sense_id": "51f167a3-e17c-3429-8040-87e1fb7035f8",
