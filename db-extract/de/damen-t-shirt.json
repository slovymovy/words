                "senses": [
                    {
                        "sense_id": "678bde93-5208-3374-8a41-10df2694006d",
                        "entry_id": "a1cf6893-2ca6-3504-9bb0-779129635332",
                        "glosses": [
                            "T-Shirt für Frauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78125e1a-2708-4138-b31d-bdec6723f6e1",
                                "sense_id": "678bde93-5208-3374-8a41-10df2694006d",
                                "text": "„Ein Damen-T-Shirt hat gegenüber dem Herrenmodell einen vergleichsweise deutlich weiteren Ausschnitt (bei den ursprünglichen Modellen war der Halsausschnitt oft so eng, dass man um seinen Atem bangen musste) und darf gerne die Schlüsselbeine entblössen.“"
                            },
                            {
                                "example_id": "8a29508f-fa83-45be-afc0-8211c48f2c2b",
                                "sense_id": "678bde93-5208-3374-8a41-10df2694006d",
                                "text": "„Ein Damen-T-Shirt mit dem Schriftzug ‚Atréju‘, eine Handyhülle mit dem Elfenbeinturm der kindlichen Kaiserin: Noch 35 Jahre nach der Filmpremiere lässt sich mit Fanartikeln der ‚Unendlichen Geschichte‘ Geld verdienen – und wird um die Vermarktungsrechte gestritten.“"
                            },
                            {
                                "example_id": "4bebf9b9-689f-4107-85f9-bd04464e4908",
                                "sense_id": "678bde93-5208-3374-8a41-10df2694006d",
                                "text": "„Ich schaue erstaunt, was er gekauft hat, und kann nicht aufhören zu lachen. […] Erst als ich ihm erkläre, dass es ein Damen-T-Shirt ist und dass jeder […] lachen würde, bringt er das T-Shirt zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
