    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91d605df-5b9f-3130-9cb0-6cc0a63e92e2",
                    "sense_definition": "A long Scottish dagger with a straight blade.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional Highland costume includes a <w>dirk</w> worn on the right side.",
                            "target_lang_translations": {
                                "de": "Die traditionelle Highland-Tracht beinhaltet einen <w>Dirk</w>, der auf der rechten Seite getragen wird."
                            }
                        },
                        {
                            "text": "He carried a sharp <w>dirk</w> tucked into his sock as part of his ceremonial outfit.",
                            "target_lang_translations": {
                                "de": "Er trug einen scharfen <w>Dirk</w> als Teil seiner zeremoniellen Kleidung in seinem Strumpf."
                            }
                        }
                    ],
                    "synonyms": [
                        "dagger"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein langer schottischer Dolch mit gerader Klinge."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dirk",
                                "target_lang_sense_clarification": "schottischer Dolch"
                            },
                            {
                                "target_lang_word": "Dolch",
                                "target_lang_sense_clarification": "allgemeine Bezeichnung für eine kurze Stichwaffe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23881ede-078b-3763-abad-2a9c6821db06",
                    "sense_definition": "A ceremonial dagger worn by naval or air force officers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naval officer wore his formal uniform complete with a polished <w>dirk</w>.",
                            "target_lang_translations": {
                                "de": "Der Marineoffizier trug seine Galauniform, komplett mit einem polierten <w>Ehrendolch</w>."
                            }
                        },
                        {
                            "text": "During the parade, the cadets carried a <w>dirk</w> as a symbol of their rank.",
                            "target_lang_translations": {
                                "de": "Während der Parade trugen die Kadetten einen <w>Dolch</w> als Symbol ihres Ranges."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein zeremonieller Dolch, der von Marine- oder Luftwaffenoffizieren getragen wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dolch",
                                "target_lang_sense_clarification": "als Teil der Uniform"
                            },
                            {
                                "target_lang_word": "Ehrendolch",
                                "target_lang_sense_clarification": "zeremonielle Waffe bei Offizieren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d60c5545-62e7-38bb-9330-b145f114bbc2",
                    "sense_definition": "To stab with a dagger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain attempted to <w>dirk</w> the hero during the intense struggle.",
                            "target_lang_translations": {
                                "de": "Der Bösewicht versuchte, den Helden während des heftigen Kampfes zu <w>erstechen</w>."
                            }
                        },
                        {
                            "text": "He was <w>dirked</w> in the dark alleyway by an unknown assailant.",
                            "target_lang_translations": {
                                "de": "Er wurde in der dunklen Gasse von einem unbekannten Angreifer <w>erstochen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stab"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit einem Dolch erstechen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "erstechen",
                                "target_lang_sense_clarification": "mit einer Stichwaffe töten"
                            },
                            {
                                "target_lang_word": "dolchen",
                                "target_lang_sense_clarification": "veraltet oder selten für mit einem Dolch stechen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "03d6b292-497a-3d1e-91f1-d51ae12201fe",
                    "sense_definition": "A male given name of German or Dutch origin.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Dirk</w> is a common name in the Netherlands.",
                            "target_lang_translations": {
                                "de": "<w>Dirk</w> ist ein gebräuchlicher Vorname in den Niederlanden."
                            }
                        },
                        {
                            "text": "I met a man named <w>Dirk</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "de": "Ich habe gestern auf der Konferenz einen Mann namens <w>Dirk</w> getroffen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a given name."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein männlicher Vorname deutscher oder niederländischer Herkunft."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dirk",
                                "target_lang_sense_clarification": "Vorname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}