{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "125872f6-4103-34a0-86b6-05f69da60b0a",
                    "sense_definition": "To make a loud, harsh, or brassy sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Car horns began to <w>blare</w> as the traffic came to a complete halt.",
                            "target_lang_translations": {
                                "it": "I clacson delle auto hanno iniziato a <w>strombazzare</w> quando il traffico si è bloccato del tutto."
                            }
                        },
                        {
                            "text": "The emergency siren will <w>blare</w> throughout the town during the drill.",
                            "target_lang_translations": {
                                "it": "La sirena di emergenza <w>risuonerà</w> in tutta la città durante l'esercitazione."
                            }
                        }
                    ],
                    "synonyms": [
                        "blast",
                        "bray"
                    ],
                    "common_phrases": [
                        "blare out"
                    ],
                    "target_lang_definitions": {
                        "it": "Emettere un suono forte, stridente o metallico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "risuonare",
                                "target_lang_sense_clarification": "echeggiare rumorosamente"
                            },
                            {
                                "target_lang_word": "squillare",
                                "target_lang_sense_clarification": "emettere un suono acuto o metallico"
                            },
                            {
                                "target_lang_word": "strombazzare",
                                "target_lang_sense_clarification": "di clacson o trombe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70b8d67f-adfe-3c93-8c4b-538570a90efa",
                    "sense_definition": "To emit, broadcast, or play something at an uncomfortably loud volume.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our noisy neighbours <w>blared</w> dance music until four in the morning.",
                            "target_lang_translations": {
                                "it": "I nostri rumorosi vicini hanno <w>sparato a tutto volume</w> musica dance fino alle quattro del mattino."
                            }
                        },
                        {
                            "text": "A police helicopter <w>blared</w> instructions to the crowd below.",
                            "target_lang_translations": {
                                "it": "Un elicottero della polizia <w>diffondeva a tutto volume</w> istruzioni alla folla sottostante."
                            }
                        }
                    ],
                    "synonyms": [
                        "blast"
                    ],
                    "target_lang_definitions": {
                        "it": "Diffondere, trasmettere o suonare qualcosa a volume assordante o sgradevolmente alto."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sparare a tutto volume",
                                "target_lang_sense_clarification": "musica o suoni da altoparlanti"
                            },
                            {
                                "target_lang_word": "diffondere a tutto volume",
                                "target_lang_sense_clarification": "annunci o messaggi vocali"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "977ac81c-bb40-320a-8d63-566a965bd247",
                    "sense_definition": "To proclaim, announce, or trumpet information loudly or aggressively.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sensational headlines <w>blared</w> the scandal across the front pages.",
                            "target_lang_translations": {
                                "it": "Titoli sensazionalistici <w>strombazzavano</w> lo scandalo sulle prime pagine."
                            }
                        },
                        {
                            "text": "The speaker <w>blared</w> his extreme views without listening to opposing arguments.",
                            "target_lang_translations": {
                                "it": "L'oratore <w>strombazzava</w> le sue opinioni estreme senza ascoltare le argomentazioni contrarie."
                            }
                        }
                    ],
                    "synonyms": [
                        "trumpet",
                        "proclaim"
                    ],
                    "target_lang_definitions": {
                        "it": "Proclamare o strombazzare informazioni ad alta voce o in modo insistente e aggressivo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "strombazzare",
                                "target_lang_sense_clarification": "diffondere enfaticamente notizie o opinioni"
                            },
                            {
                                "target_lang_word": "sbattere in prima pagina",
                                "target_lang_sense_clarification": "notizie giornalistiche eclatanti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ca1b91d-6b4e-3acd-b816-92b7d1d63965",
                    "sense_definition": "To bellow or roar, especially of cattle or other animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened calves were <w>blaring</w> loudly in the cold barn.",
                            "target_lang_translations": {
                                "it": "I vitelli spaventati stavano <w>mugghiando</w> rumorosamente nella stalla fredda."
                            }
                        },
                        {
                            "text": "Across the fields, the cattle <w>blared</w> as the storm rolled in.",
                            "target_lang_translations": {
                                "it": "Attraverso i campi, il bestiame <w>muggiva</w> mentre la tempesta si avvicinava."
                            }
                        }
                    ],
                    "synonyms": [
                        "bellow",
                        "bleat"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "used mainly in regional or archaic contexts for animal sounds"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Mugghiare o ruggire rumorosamente, riferito in particolare al bestiame."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "mugghiare",
                                "target_lang_sense_clarification": "verso rumoroso di bovini"
                            },
                            {
                                "target_lang_word": "muggire",
                                "target_lang_sense_clarification": "verso di mucche o vitelli"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0627f56b-24a3-300e-ad69-a75def0339d4",
                    "sense_definition": "A loud, harsh, unpleasant sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can hardly hear your voice over the <w>blare</w> of the television.",
                            "target_lang_translations": {
                                "it": "Riesco a malapena a sentire la tua voce a causa del <w>frastuono</w> della televisione."
                            }
                        },
                        {
                            "text": "The sudden <w>blare</w> of a horn startled everyone on the street.",
                            "target_lang_translations": {
                                "it": "L'improvviso <w>strombettio</w> di un clacson ha fatto sobbalzare tutti in strada."
                            }
                        }
                    ],
                    "synonyms": [
                        "blast",
                        "din",
                        "clamour"
                    ],
                    "antonyms": [
                        "silence"
                    ],
                    "common_phrases": [
                        "blare of trumpets",
                        "blare of sirens"
                    ],
                    "target_lang_definitions": {
                        "it": "Un suono forte, sgradevole, squillante o metallico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "strombettio",
                                "target_lang_sense_clarification": "suono forte di clacson o trombe"
                            },
                            {
                                "target_lang_word": "squillo",
                                "target_lang_sense_clarification": "suono acuto e potente"
                            },
                            {
                                "target_lang_word": "frastuono",
                                "target_lang_sense_clarification": "rumore forte e fastidioso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "590fb4fd-49b3-3d73-9aec-985f24f6f723",
                    "sense_definition": "An intense, dazzling, and often garish brightness of light or colour.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "visual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright <w>blare</w> of neon signs illuminated the wet pavement.",
                            "target_lang_translations": {
                                "it": "Il vivido <w>bagliore</w> delle insegne al neon illuminava il marciapiede bagnato."
                            }
                        },
                        {
                            "text": "She squinted against the sudden <w>blare</w> of stage lights.",
                            "target_lang_translations": {
                                "it": "Strinse gli occhi contro l'improvviso <w>bagliore</w> delle luci del palcoscenico."
                            }
                        }
                    ],
                    "synonyms": [
                        "glare",
                        "dazzle"
                    ],
                    "target_lang_definitions": {
                        "it": "Luminosità intensa, abbagliante e spesso sgradevole di luci o colori."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bagliore",
                                "target_lang_sense_clarification": "luce abbagliante o vivida"
                            },
                            {
                                "target_lang_word": "sfavillio",
                                "target_lang_sense_clarification": "brillantezza vistosa e intensa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6f389b3-7bb6-3281-9d71-ee2960b31170",
                    "sense_definition": "A prolonged, loud bellow or roar from a person or animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wounded bull gave a final, savage <w>blare</w> before falling.",
                            "target_lang_translations": {
                                "it": "Il toro ferito emise un ultimo, selvaggio <w>muggito</w> prima di cadere."
                            }
                        },
                        {
                            "text": "A distant <w>blare</w> echoed from the herd as danger approached.",
                            "target_lang_translations": {
                                "it": "Un lontano <w>muggito</w> echeggiò dalla mandria all'avvicinarsi del pericolo."
                            }
                        }
                    ],
                    "synonyms": [
                        "bellow",
                        "roar"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare and largely archaic usage for animal cries"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Un muggito o ruggito prolungato e potente emesso da una persona o da un animale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "muggito",
                                "target_lang_sense_clarification": "verso prolungato del bestiame"
                            },
                            {
                                "target_lang_word": "ruggito",
                                "target_lang_sense_clarification": "urlo o verso profondo e selvaggio"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}