                "senses": [
                    {
                        "sense_id": "5bafd17a-b784-3dd4-af51-39e940657398",
                        "entry_id": "3650493d-1e23-3c85-8877-1504e50a73c1",
                        "glosses": [
                            "rodzaj instrumentu dętego drewnianego z grupy aerofonów dwustroikowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9362469-128f-4b0b-b694-e175aa9e6c2d",
                                "sense_id": "5bafd17a-b784-3dd4-af51-39e940657398",
                                "text": "Od roku Jacek uczy się gry na oboju i uparcie ćwiczy wieczorami."
                            },
                            {
                                "example_id": "f3f28760-4511-4c78-9e03-f2207334696a",
                                "sense_id": "5bafd17a-b784-3dd4-af51-39e940657398",
                                "text": "I teraz wspominając po nocy ową dzienną wesołość, wygrywał sobie: „Mój zielony dzban” i uśmiechał się jeszcze teraz, o ile mu na to pozwalały usta zajęte dmuchaniem w obój"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b9ca97b4-2b3e-3bad-b782-a7ffb961c73c",
                        "entry_id": "3650493d-1e23-3c85-8877-1504e50a73c1",
                        "glosses": [
                            "językowy (stroikowy) głos organowy, którego barwa przypomina obój (1.1)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "723c8e43-3346-4409-b260-9eea3c4df3c8",
                        "source_entry_id": "3650493d-1e23-3c85-8877-1504e50a73c1",
                        "source_sense_id": "5bafd17a-b784-3dd4-af51-39e940657398",
                        "target_lang_word": "oboe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oboe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "108a39d5-24b8-31c0-9927-4484b47eaef4",
                                        "entry_id": "35be3674-f5a6-31a9-88c4-a6a26f3859c4",
                                        "glosses": [
                                            "A soprano and melody wind instrument in the modern orchestra and wind ensemble. It is a smaller instrument and generally made of grenadilla wood. It is a member of the double reed family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91cb6b63-1d45-4a1f-a9ff-8972dba4b95f",
                                                "sense_id": "108a39d5-24b8-31c0-9927-4484b47eaef4",
                                                "text": "Whistles, mirlitons, flutes, trumpets or horns, clarinets, and oboes are all played in one or more parts of the continent."
                                            },
                                            {
                                                "example_id": "ea783aa7-3e0f-458a-afca-c261539ff13c",
                                                "sense_id": "108a39d5-24b8-31c0-9927-4484b47eaef4",
                                                "text": "This does become monstrously antimusical in one scene: when Tchaikovsky’s music, softly depicting the sleeping palace (my favorite passage of this composer’s entire oeuvre, with its beautifully muffled oboe melody suggesting how beauty ripens in sleep like a chrysalis), is turned into an epic battle for the poor passive Prince, conducted between the wicked Carabosse, with her ghoulish minions, and the Lilac Fairy, with her elves."
                                            },
                                            {
                                                "example_id": "ac3b7d4c-0f19-4f38-b47b-d8ee57e8ab1d",
                                                "sense_id": "108a39d5-24b8-31c0-9927-4484b47eaef4",
                                                "text": "Using the “endangered species” model employed by the World Wide Fund for Nature, campaigners are highlighting the scarcity of bassoonists and paving the way for the promotion of some other orchestral instruments that are under threat, such as the oboe, French horn, viola, trombone and double bass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c504bd62-4e5f-4a93-af41-7c4746e31660",
                        "source_entry_id": "3650493d-1e23-3c85-8877-1504e50a73c1",
                        "source_sense_id": "5bafd17a-b784-3dd4-af51-39e940657398",
