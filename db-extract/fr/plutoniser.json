                "senses": [
                    {
                        "sense_id": "02fa54fb-5f65-382a-86db-172b4e7b6281",
                        "entry_id": "38f9b805-9baf-3126-97af-740542870803",
                        "glosses": [
                            "Rétrograder, dévaloriser quelqu’un ou quelque chose."
                        ],
                        "tags": [
                            "familiar",
                            "neologism",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a630ddb4-c009-409f-8d2a-f0b57f0192fe",
                                "sense_id": "02fa54fb-5f65-382a-86db-172b4e7b6281",
                                "text": "Vous avez été plutonisé !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f828958-ae33-4694-889a-8f4e778fdcf5",
                        "source_entry_id": "38f9b805-9baf-3126-97af-740542870803",
                        "source_sense_id": "02fa54fb-5f65-382a-86db-172b4e7b6281",
                        "target_lang_word": "pluto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pluto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3385b1dc-2aab-37ae-8cd5-1816afa6e933",
                                        "entry_id": "20716828-d48b-3685-aad4-f5d5c0bd6468",
                                        "glosses": [
                                            "To demote or devalue something."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c121321-f23b-456a-909d-7b99ecad0bd3",
                                                "sense_id": "3385b1dc-2aab-37ae-8cd5-1816afa6e933",
                                                "text": "2007 April 21, The Meerkat , OT:Catholic Church ditches Limbo, aus.tv, Usenet.\nLimbo has been plutoed. No half way house any more. It's heaven or hell."
                                            },
                                            {
                                                "example_id": "bb375480-4bb8-4cc0-aae1-bd9f4f6f51b1",
                                                "sense_id": "3385b1dc-2aab-37ae-8cd5-1816afa6e933",
                                                "text": "2007, Andrew Swift, The Daily Iowan - Opinion Column\nWinter is dead. The break the university community has just returned from is ostensibly known as winter break. But those who stayed in the Iowa City area know the sad truth: The four seasons Midwesterners grew up with have been Plutoed."
                                            },
                                            {
                                                "example_id": "fd7a8951-6647-4107-a908-cb19e8b4d27b",
                                                "sense_id": "3385b1dc-2aab-37ae-8cd5-1816afa6e933",
                                                "text": "2007, Richard Davis, Courier Press - Entertainment Column\nI'm sure I looked really cool (or has that word been plutoed?) in my sneakers and old-fashioned Levis, next to jocks, Greek Life poster children, guys with Bluetooth headsets, and a young woman in ski boots and leotards that left little to the imagination."
                                            },
                                            {
                                                "example_id": "b4d6616c-1897-48c0-a914-e08d8afa257e",
                                                "sense_id": "3385b1dc-2aab-37ae-8cd5-1816afa6e933",
                                                "text": "2008 April 13, GET WISDOM! , GET WISDOM! Understanding, GET WISDOM!, Usenet.\nAs a result of...plutoing that class, I made room for another in-depth marketing class that will better serve me and you, my clients and readers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
