                    "sense_definition": "The Australian Labor Party, a major centre-left political party in Australia.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "political_party",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "There has always been some international isolationism in <Labor> circles in Australia.",
                            "target_lang_translations": {
