                "senses": [
                    {
                        "sense_id": "dafe8cfc-130d-31ce-9148-afda067f66f2",
                        "entry_id": "be9fb96b-09f5-38ee-b626-a32db13cf8e1",
                        "glosses": [
                            "vom Wind bewegter, relativ heftiger Schneefall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d28dd215-272c-4564-9e95-1f1135a9457e",
                                "sense_id": "dafe8cfc-130d-31ce-9148-afda067f66f2",
                                "text": "„Schneefall wird zu Schneegestöber, und Schneetreiben wandelt sich in Schneesturm.“"
                            },
                            {
                                "example_id": "e4409acc-17a7-4979-be0a-e97d2fe81a4e",
                                "sense_id": "dafe8cfc-130d-31ce-9148-afda067f66f2",
                                "text": "„Auch das Schneetreiben nahm an Heftigkeit zu.“"
                            },
                            {
                                "example_id": "e1ef1619-1a1a-493e-ae4b-135f15290b94",
                                "sense_id": "dafe8cfc-130d-31ce-9148-afda067f66f2",
                                "text": "„Ein Schneetreiben hat eingesetzt; Schauder von Kälte im schneidenden Wind.“"
                            },
                            {
                                "example_id": "7c4c5f6f-52d9-471c-a3f3-4a87d1161a5e",
                                "sense_id": "dafe8cfc-130d-31ce-9148-afda067f66f2",
                                "text": "„Es wurde dunkel, und bald setzte Schneetreiben ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
