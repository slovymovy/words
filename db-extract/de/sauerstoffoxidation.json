                "senses": [
                    {
                        "sense_id": "b9d3f857-1ac4-37ba-a38e-55cde3fe0388",
                        "entry_id": "073bb9e3-fc23-348f-9937-831f569e4e4f",
                        "glosses": [
                            "Oxidation durch die Energieabgabe des geladenen Sauerstoffs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be4ab84-cae0-444a-8fc2-ddb755a00fae",
                                "sense_id": "b9d3f857-1ac4-37ba-a38e-55cde3fe0388",
                                "text": "Sauerstoff kann nichts anderes tun, als irgendetwas zu oxidieren und so sein positives/negatives Energiepotential bei der Sauerstoffoxidation abgeben."
                            },
                            {
                                "example_id": "7ffd2157-62e3-43bd-b5bb-00b3efed863a",
                                "sense_id": "b9d3f857-1ac4-37ba-a38e-55cde3fe0388",
                                "text": "„Zur Kinetik der Sauerstoffoxidation von Kohlenstoffmaterialien existiert eine Vielzahl von Untersuchungen, allerdings ist der Anteil der Arbeiten zur Umsetzung fester Pyrolyseprodukte aus Biomasse gering.“"
                            },
                            {
                                "example_id": "9d89c6ee-9821-494e-a48e-b4e02fb983f3",
                                "sense_id": "b9d3f857-1ac4-37ba-a38e-55cde3fe0388",
                                "text": "„Durch die Sauerstoffoxidation werden auch die Bodenheizungsrohre spröde.“"
                            },
                            {
                                "example_id": "c2da7bc1-d4e7-44f2-a922-52fca6b225d6",
                                "sense_id": "b9d3f857-1ac4-37ba-a38e-55cde3fe0388",
                                "text": "„Nach einer ebenfalls 20-stündigen Sauerstoffoxidation bei 450°C (Abbildung 19(d)) läßt sich eine ausgeprägte Fibrillarstruktur erkennen.“"
                            },
                            {
                                "example_id": "f8f43933-5196-41ff-9903-dbf895d59a84",
                                "sense_id": "b9d3f857-1ac4-37ba-a38e-55cde3fe0388",
                                "text": "„Es wird durch UV-Strahlung und Sauerstoffoxidation deaktiviert.“"
                            },
                            {
                                "example_id": "8e947ab4-3835-4589-9d30-c54ee7025c60",
                                "sense_id": "b9d3f857-1ac4-37ba-a38e-55cde3fe0388",
                                "text": "„Die Kondenswasserbildung, die Ölverdünnung durch Benzinkondensat, die Alterung durch Sauerstoffoxidation und das Absetzen von Schmutzpartikeln imFilter verschlechtern mit der Zeit den optimalen Schmierkreislauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
