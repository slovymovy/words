                                "target_senses": [
                                    {
                                        "sense_id": "1a4aae35-4f9a-34d8-bcf0-d9692a86a2b7",
                                        "entry_id": "3da81966-ab63-38fa-84c6-3fd6fe34f710",
                                        "glosses": [
                                            "A point on an engineering drawing that has been added to make the layout of the part easier. It is usually the intersection of the tangent lines of a curve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "194616d0-d378-3086-a1e3-819c5103c15f",
                                        "entry_id": "3da81966-ab63-38fa-84c6-3fd6fe34f710",
                                        "glosses": [
                                            "A location that is worth visiting because it is a tourist attraction or the base for some type of service such as a restaurant or shop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d97db1-e249-4503-b328-a62f645d976e",
                                                "sense_id": "194616d0-d378-3086-a1e3-819c5103c15f",
                                                "text": "The most important places and attractions of the city (i.e., points of interest) are identified by icons on the map."
                                            },
                                            {
                                                "example_id": "6c43c57a-8505-4a30-bc96-a7d2080bf6e2",
                                                "sense_id": "194616d0-d378-3086-a1e3-819c5103c15f",
                                                "text": "Chicago by the 'L shows you how to go to more than 50 points of interest easily and inexpensively by using Chicago's excellent 'L (elevated /subway train) and Metra suburban rail systems."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
