        "de-extract.jsonl": [
            {
                "entry_id": "018a5bc5-6093-318c-9984-b85f7e5bcfd8",
                "word": "unspeakably",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "852d8f1a-2397-345f-b902-170b78b36321",
                        "entry_id": "018a5bc5-6093-318c-9984-b85f7e5bcfd8",
                        "glosses": [
                            "unbeschreiblich, unsagbar, unaussprechlich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "400cd26b-4b4f-41a0-a27c-2b24b86bbe77",
                                "sense_id": "852d8f1a-2397-345f-b902-170b78b36321",
                                "text": "„His Majesty entered the office — a portly, rather flabby man, with the face of a gentleman, rendered unspeakably pathetic and absurd by the great sabre at his side and the peacock's feather in his hat.“",
                                "translation": "Seine Majestät betrat das Büro – ein korpulenter, eher schwabbliger Mann mit dem Gesicht eines Gentlemans, den der große Säbel an seiner Seite und die Pfauenfeder auf seinem Hut unsagbar pathetisch und absurd werden ließen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8642124-eb3e-4c20-8ffd-15791d467b8f",
                        "source_entry_id": "018a5bc5-6093-318c-9984-b85f7e5bcfd8",
                        "source_sense_id": "852d8f1a-2397-345f-b902-170b78b36321",
                        "source_sense_description": "unbeschreiblich, unsagbar, unaussprechlich",
                        "target_lang_word": "unbeschreiblich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbeschreiblich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f35353e1-c372-3de4-8036-7c80676455e9",
                                        "entry_id": "9e746d12-9366-3cac-b75d-7395dc11e05b",
                                        "glosses": [
                                            "in seiner Eigenart so ausgeprägt, dass es sich einer Schilderung entzieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14515f55-c1d7-405f-85b6-cce7b56dbd05",
                                                "sense_id": "f35353e1-c372-3de4-8036-7c80676455e9",
                                                "text": "„Jedenfalls wussten die Jungen sofort, dass sie da etwas Einzigartiges entdeckt hatten: ‚Unsere Freude war unbeschreiblich, eine Bande von Wilden hätte beim Kriegstanz nicht ausgelassener sein können!‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ade0155-7fc9-4605-aca3-dc99b4d3b6a0",
                        "source_entry_id": "018a5bc5-6093-318c-9984-b85f7e5bcfd8",
                        "source_sense_id": "852d8f1a-2397-345f-b902-170b78b36321",
                        "source_sense_description": "unbeschreiblich, unsagbar, unaussprechlich",
                        "target_lang_word": "unsagbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsagbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae0de44c-a9e2-3c4f-9791-75fc7249f87d",
                                        "entry_id": "523a102c-b0bc-384c-80dc-d420a1142291",
                                        "glosses": [
                                            "unbeschreiblich, überaus intensiv/überaus groß/überaus stark, außerordentlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028c66d5-5499-44df-b601-9a96e43a302c",
                                                "sense_id": "ae0de44c-a9e2-3c4f-9791-75fc7249f87d",
                                                "text": "Käthes unsagbare Schönheit betört alle Männer."
                                            },
                                            {
                                                "example_id": "44a74711-f15a-43a7-9ea3-37d1afbf83f9",
                                                "sense_id": "ae0de44c-a9e2-3c4f-9791-75fc7249f87d",
                                                "text": "„Das herrliche, das hinreissend Schöne aber dieser heroischen Willensstärke bei den unsagbarsten Schmerzen in der Einöde und Allverlassenheit liegt darin, dass der Widerstand nicht als Trotz erscheint, sondern als tiefberechtigte Empörtheit eines grossen Heldenherzens über erduldete Kränkung.“"
                                            },
                                            {
                                                "example_id": "6ad55ac9-a719-4e93-89f0-02e6e2dd4d10",
                                                "sense_id": "ae0de44c-a9e2-3c4f-9791-75fc7249f87d",
                                                "text": "„In dieser ruhigen Stube, wo man geräuschlos aus- und einging, wo man das tägliche Mahl einnahm, wo der Vater Abends für sich las, während die Mutter spann, in dieser stillen Stube da weilte ein größeres, ein unsagbareres Unglück, als je die heißesten Thränen beweint haben.“"
                                            },
                                            {
                                                "example_id": "02f971bd-3f8e-422c-8adb-c2947a0d04cc",
                                                "sense_id": "ae0de44c-a9e2-3c4f-9791-75fc7249f87d",
                                                "text": "„Deine Haut wird sich auflösen in schwärende, offene Wunden und für jede deiner Taten wirst du unsagbare Schmerzen erleiden.“"
                                            },
                                            {
                                                "example_id": "3180a470-c9f4-4740-8a26-1db6d0f22855",
                                                "sense_id": "ae0de44c-a9e2-3c4f-9791-75fc7249f87d",
                                                "text": "Er stellte dies mit einer unsagbaren Bitterkeit fest."
                                            },
                                            {
                                                "example_id": "32f33066-9a91-407f-90ed-8300f5499ca2",
                                                "sense_id": "ae0de44c-a9e2-3c4f-9791-75fc7249f87d",
                                                "text": "Die unsagbare Kälte, die seinem Verhalten gegenüber seiner Mutter innewohnte, erschütterte Bettina."
                                            },
                                            {
                                                "example_id": "e1f7df21-29fa-466d-ac69-9f2b8bba4b27",
                                                "sense_id": "ae0de44c-a9e2-3c4f-9791-75fc7249f87d",
                                                "text": "Vaters und Mutters einstiger Liebling hatte sein Leben mit unsagbarer Präzision gegen die Wand gefahren."
                                            },
                                            {
                                                "example_id": "de075e39-f998-4e2f-80d6-1dfa916e1f24",
                                                "sense_id": "ae0de44c-a9e2-3c4f-9791-75fc7249f87d",
                                                "text": "Emmerichs Berührungen waren von unsagbarer Zärtlichkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f6b89f0-e55e-37ea-874e-c227c82416c2",
                                        "entry_id": "523a102c-b0bc-384c-80dc-d420a1142291",
                                        "glosses": [
                                            "in sehr hohem Maße, ungeheuer, sehr"
                                        ],
                                        "tags": [
                                            "zur Verstärkung von Adjektiven und Verben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b88b397b-1037-4910-b81b-04a700ef835a",
                                                "sense_id": "6f6b89f0-e55e-37ea-874e-c227c82416c2",
                                                "text": "Es geht Aljoscha unsagbar schlecht."
                                            },
                                            {
                                                "example_id": "97b19c6d-6bd1-42e1-97f5-a732e079ceb1",
                                                "sense_id": "6f6b89f0-e55e-37ea-874e-c227c82416c2",
                                                "text": "Es ist so unsagbar schön bei euch in Erlangen."
                                            },
                                            {
                                                "example_id": "dfdaae5e-07b0-4683-a589-b1ce1a040f93",
                                                "sense_id": "6f6b89f0-e55e-37ea-874e-c227c82416c2",
                                                "text": "Irmchen war unsagbar glücklich, als der Brief von ihrer Schwester aus Bangkok ankam."
                                            },
                                            {
                                                "example_id": "1f9fee1c-b150-4b3a-8f7c-6686abb38bec",
                                                "sense_id": "6f6b89f0-e55e-37ea-874e-c227c82416c2",
                                                "text": "Wir alle freuen uns unsagbar über deine Rückkehr."
                                            },
                                            {
                                                "example_id": "652d5038-9d6d-49ca-a482-de0cdcce32e7",
                                                "sense_id": "6f6b89f0-e55e-37ea-874e-c227c82416c2",
                                                "text": "Manfreds Freunde leiden unsagbar unter seinem Sinneswandel."
                                            },
                                            {
                                                "example_id": "89f598af-3167-4936-bd46-5b5c7fe086d4",
                                                "sense_id": "6f6b89f0-e55e-37ea-874e-c227c82416c2",
                                                "text": "Dort unten gibt es unsagbar viele Muscheln."
                                            },
                                            {
                                                "example_id": "950fa804-e0fd-4ea6-a395-79e2b01e2429",
                                                "sense_id": "6f6b89f0-e55e-37ea-874e-c227c82416c2",
                                                "text": "Hieronymus liebt das Staubsaugen unsagbar."
                                            },
                                            {
                                                "example_id": "99c6762f-6333-4cfc-8e46-32bf0e893895",
                                                "sense_id": "6f6b89f0-e55e-37ea-874e-c227c82416c2",
                                                "text": "Ich bin so unsagbar stolz auf dich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
