                "senses": [
                    {
                        "sense_id": "a72233fc-689b-3e01-ba99-055aaebfab99",
                        "entry_id": "77aa7f56-3386-34f9-8d34-2b6f84578c3e",
                        "glosses": [
                            "Vater von Ururgroßmutter oder Ururgroßvater"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1db5c13f-372a-499e-8cb2-c1b83f4f993a",
                                "sense_id": "a72233fc-689b-3e01-ba99-055aaebfab99",
                                "text": "„Johnnys Großvater, Urgroßvater, Ururgroßvater und Urururgroßvater, alle waren Schauspieler, nur sein Vater nicht.“"
                            },
                            {
                                "example_id": "0a8f3d49-8727-4fef-a7cb-96f7bab89aaa",
                                "sense_id": "a72233fc-689b-3e01-ba99-055aaebfab99",
                                "text": "„Französisch also der Namensursprung, und Aachen und Kaiserswerth die Lebensmittelpunkte zumindest seit den Tagen des Urururgroßvaters.“"
                            },
                            {
                                "example_id": "51b51db8-39bd-413b-82e2-eec85841e93f",
                                "sense_id": "a72233fc-689b-3e01-ba99-055aaebfab99",
                                "text": "„Die Gelehrsamkeit lag ihm im Blut, denn bereits sein Urgroßvater Sir Robert Jermyn war ein anerkannter Anthropologe gewesen und sein Urururgroßvater Sir Wade Jermyn einer der ersten Erforscher des Kongo-Gebietes, der kenntnisreich die dortigen Stämme, Tierarten und vermeintlichen Altertümer beschrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "666f612f-51f7-4dce-8a24-78b2f45e7c13",
                        "source_entry_id": "77aa7f56-3386-34f9-8d34-2b6f84578c3e",
                        "source_sense_id": "a72233fc-689b-3e01-ba99-055aaebfab99",
                        "source_sense_description": "Vater von Ururgroßmutter oder Ururgroßvater",
                        "target_lang_word": "great-great-great-grandfather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "25af6a9e-293a-4a17-bf1b-70b40338188f",
                        "source_entry_id": "77aa7f56-3386-34f9-8d34-2b6f84578c3e",
                        "source_sense_id": "a72233fc-689b-3e01-ba99-055aaebfab99",
                        "source_sense_description": "Vater von Ururgroßmutter oder Ururgroßvater",
                        "target_lang_word": "quadrisaïeul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrisaïeul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d7bb4e5-ee22-3efe-bc09-7338f285a2c5",
                                        "entry_id": "1d6a2afa-027e-3d56-a222-206659bcd60f",
                                        "glosses": [
                                            "Père du trisaïeul ou de la trisaïeule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c2392a2-f44f-4d5d-a594-f8d661f8ff49",
                                                "sense_id": "4d7bb4e5-ee22-3efe-bc09-7338f285a2c5",
                                                "text": "Mon père, mon aïeul, mon bisaïeul, mon trisaïeul, mon quadrisaïeul, mon quinquisaïeul ont toujours mangé, comme les rats, à la table d'autrui."
                                            },
                                            {
                                                "example_id": "a84836aa-e220-403a-afe7-aedb4b988f0d",
                                                "sense_id": "4d7bb4e5-ee22-3efe-bc09-7338f285a2c5",
                                                "text": "Enfin, saisissant l'importance des parentés, le comte Roland de Montrichard a écrit Trois siècles de parentés , dont le texte, publié en 1953, présente la descendance complète, en ligne masculine et féminine, des 32 quadrisaïeuls de son père Louis de Montrichard."
                                            },
                                            {
                                                "example_id": "f9bb668d-234a-46e3-82ef-6a2a2db1699c",
                                                "sense_id": "4d7bb4e5-ee22-3efe-bc09-7338f285a2c5",
                                                "text": "Du côté paternel, le seul qui m'occupe ici, quatre arrière-grands-parents en 1850, seize quadrisaïeuls vers l'An II, cinq cent douze à l'époque de la jeunesse de Louis XIV, quatre mille quatre-vingt-seize sous François Ier, un million plus ou moins à la mort de Saint Louis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60297e3e-7e26-4f66-b573-924a9e5e8b34",
                        "source_entry_id": "77aa7f56-3386-34f9-8d34-2b6f84578c3e",
                        "source_sense_id": "a72233fc-689b-3e01-ba99-055aaebfab99",
                        "source_sense_description": "Vater von Ururgroßmutter oder Ururgroßvater",
                        "target_lang_word": "arrière-arrière-arrière-grand-père",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrière-arrière-arrière-grand-père",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5ffb2e4-57d7-3c30-aa41-00cd37148d38",
                                        "entry_id": "ee6e9719-8ec7-38af-8bde-626919123f1d",
                                        "glosses": [
                                            "Arrière-grand-père de l’un des grands-parents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de41e9c-721f-495c-9641-da64aba51f66",
                                                "sense_id": "b5ffb2e4-57d7-3c30-aa41-00cd37148d38",
                                                "text": "C’est mon arrière-arrière-arrière-grand-père, Jacques Elias, qui a acheté le moulin de la Veyssière, le 19 avril 1857."
                                            },
                                            {
                                                "example_id": "f6a888a2-102d-4c8f-bb6c-2209d58446a0",
                                                "sense_id": "b5ffb2e4-57d7-3c30-aa41-00cd37148d38",
                                                "text": "C’est là que ton arrière-arrière-arrière-grand-père est enterré."
                                            },
                                            {
                                                "example_id": "d8325ae1-13d0-44d8-8616-98e9cfa13b28",
                                                "sense_id": "b5ffb2e4-57d7-3c30-aa41-00cd37148d38",
                                                "text": "Je suppose qu'il soit enterré puisque c'est ton arrière-arrière-arrière-grand-père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80c89e09-7c51-410e-83d6-46e78a3f66ab",
                        "source_entry_id": "77aa7f56-3386-34f9-8d34-2b6f84578c3e",
