                "senses": [
                    {
                        "sense_id": "5708f911-e3a3-3e11-a186-9816a7609327",
                        "entry_id": "2bd76f9c-38aa-3841-90b5-30287085ef32",
                        "glosses": [
                            "'t kofschip:ezelsbruggetje om te bepalen hoe bepaalde werkwoordsvormen volgens de Nederlandse spelling geschreven moeten worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9afc3cb-8b7e-4aa0-bc75-24a828f79efb",
                                "sense_id": "5708f911-e3a3-3e11-a186-9816a7609327",
                                "text": "De show draait onder meer om spelling, grammatica en spreekwoorden. ,,Over alles wat we dagelijks gebruiken en op school geleerd hebben, maar vergeten zijn. Want hoe zit het ook alweer met het kofschip? En groter als of dan?"
                            },
                            {
                                "example_id": "ac6e5747-042f-4c5e-a2cf-638618b74ba2",
                                "sense_id": "5708f911-e3a3-3e11-a186-9816a7609327",
                                "text": "Zomaar meer taal- en rekenonderwijs voor alle mbo-scholen bijvoorbeeld draagt volgens hem niet bij aan een verbetering van de arbeidsmarktkansen. „Een timmerman moet bijvoorbeeld wel iets weten van hoeken en dat een rechte hoek negentig graden is. Maar die hoeft weer niet perfect de regels van 't kofschip toe te kunnen passen. Dat is voor een secretaresse weer precies andersom”."
                            }
                        ]
                    },
                    {
                        "sense_id": "7edc1088-b7b0-386e-aeaa-7f9ea5608d32",
                        "entry_id": "2bd76f9c-38aa-3841-90b5-30287085ef32",
                        "glosses": [
                            "soort historische zeilschip met 2 masten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "443f937a-5373-46ae-aafd-e65aac6e73c7",
                                "sense_id": "7edc1088-b7b0-386e-aeaa-7f9ea5608d32",
                                "text": "Op een oud kofschip zullen scouts oude tijden laten herleven met ambachten als vis roken en touwslaan."
                            },
                            {
                                "example_id": "6888fe76-d0c3-48b6-a19b-5a6fbfd5e731",
                                "sense_id": "7edc1088-b7b0-386e-aeaa-7f9ea5608d32",
                                "text": "Het interieur van de Doniakerk van de protestantse gemeente te Makkum is sinds kort verrijkt met een kofschip op schaal. Het scheepje herinnert aan het vissersverleden van het dorp."
                            }
                        ]
                    }
