{
    "word_family": [
        "uitputten",
        "uitputting",
        "onuitputtelijk"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c177be90-24d9-350a-be1e-4fad8c80c70d",
                    "sense_definition": "Zeer moe en zonder energie, vaak na een zware fysieke of mentale inspanning.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vermoeidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitgeputte</w> wandelaars bereikten eindelijk de berghut na een tocht van tien uur.",
                            "target_lang_translations": {
                                "en": "The <w>exhausted</w> hikers finally reached the mountain hut after a ten-hour trek.",
                                "ru": "<w>Изнурённые</w> туристы наконец добрались до горной хижины после десятичасового перехода.",
                                "zh": "<w>精疲力竭的</w>徒步者在走了十个小时后终于到达了山间小屋。"
                            }
                        },
                        {
                            "text": "Ik voel me helemaal <w>uitgeput</w> na deze lange en stressvolle werkweek.",
                            "target_lang_translations": {
                                "en": "I feel completely <w>exhausted</w> after this long and stressful work week.",
                                "ru": "Я чувствую себя совершенно <w>истощённым</w> после этой длинной и напряженной рабочей недели.",
                                "zh": "经过这漫长且充满压力的一周工作，我感到<w>精疲力竭</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "afgemat",
                        "doodmoe",
                        "uitgeteld",
                        "uitgeblust",
                        "kapot",
                        "op"
                    ],
                    "antonyms": [
                        "fit",
                        "uitgerust",
                        "energiek"
                    ],
                    "common_phrases": [
                        "volledig uitgeput",
                        "emotioneel uitgeput",
                        "fysiek uitgeput"
                    ],
                    "target_lang_definitions": {
                        "en": "Very tired and lacking energy, often after heavy physical or mental exertion.",
                        "ru": "Очень уставший и лишенный энергии, часто после тяжелой физической или умственной нагрузки.",
                        "zh": "指极度疲劳且缺乏精力，通常是在高强度的体力或脑力劳动之后。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exhausted",
                                "target_lang_sense_clarification": "extremely tired"
                            },
                            {
                                "target_lang_word": "worn out",
                                "target_lang_sense_clarification": "informal, very tired"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "изнурённый",
                                "target_lang_sense_clarification": "крайняя степень усталости"
                            },
                            {
                                "target_lang_word": "истощённый",
                                "target_lang_sense_clarification": "физическое или моральное истощение"
                            },
                            {
                                "target_lang_word": "выбившийся из сил",
                                "target_lang_sense_clarification": "потерявший способность действовать из-за усталости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精疲力竭",
                                "target_lang_sense_clarification": "形容极其疲劳，体力耗尽"
                            },
                            {
                                "target_lang_word": "疲惫不堪",
                                "target_lang_sense_clarification": "形容非常疲劳，难以忍受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6740c86-be3c-36f9-aabd-21562655ece6",
                    "sense_definition": "Helemaal leeggehaald of opgebruikt, zodat er niets meer van over is (bijvoorbeeld bronnen of voorraden).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "leeg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>uitgeputte</w> goudmijn was al jaren gesloten omdat er niets meer te vinden was.",
                            "target_lang_translations": {
                                "en": "The <w>exhausted</w> gold mine had been closed for years because there was nothing left to find.",
                                "ru": "<w>Истощённый</w> золотой рудник был закрыт уже много лет, так как там больше нечего было добывать.",
                                "zh": "这座<w>枯竭的</w>金矿已经关闭多年，因为里面什么也找不到了。"
                            }
                        },
                        {
                            "text": "Door intensieve landbouw is de grond in dit gebied volledig <w>uitgeput</w> geraakt.",
                            "target_lang_translations": {
                                "en": "Due to intensive farming, the soil in this area has become completely <w>exhausted</w>.",
                                "ru": "Из-за интенсивного земледелия почва в этом районе стала полностью <w>истощённой</w>.",
                                "zh": "由于集约化耕作，该地区的土地已经完全<w>耗尽</w>了肥力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opgebruikt",
                        "leeg"
                    ],
                    "antonyms": [
                        "onaangeroerd",
                        "vol"
                    ],
                    "common_phrases": [
                        "uitgeputte voorraad",
                        "uitgeputte grond",
                        "uitgeputte bronnen"
                    ],
                    "target_lang_definitions": {
                        "en": "Completely emptied or used up, so that nothing remains (e.g., sources or supplies).",
                        "ru": "Полностью опустошенный или израсходованный, так что ничего не осталось (например, ресурсы или запасы).",
                        "zh": "指资源、储备或土地被完全用尽或耗干，不再有剩余。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depleted",
                                "target_lang_sense_clarification": "resources used up"
                            },
                            {
                                "target_lang_word": "exhausted",
                                "target_lang_sense_clarification": "completely used up"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "истощённый",
