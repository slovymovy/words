                        ],
                        "examples": [
                            {
                                "example_id": "7f79126c-0e72-4ace-a994-78a5170a13cf",
                                "sense_id": "11a46975-1c2d-312f-b4f3-4fef15a0d9a7",
                                "text": "‘In there, you nong,’ Max said, pointing out a pink-brick home with a 1950s skillion roof."
                            },
                            {
                                "example_id": "50d5aea4-e0cb-4514-86c0-e0819b73ad27",
                                "sense_id": "11a46975-1c2d-312f-b4f3-4fef15a0d9a7",
                                "text": "‘You guys are such nongs! Why would you want to face up to Shoaib Akhtar when you could win a World Cup against the young blond Aussie star at the home of cricket?’"
                            },
                            {
                                "example_id": "948510d4-7cc9-48ab-b1a2-eb96efdac396",
                                "sense_id": "11a46975-1c2d-312f-b4f3-4fef15a0d9a7",
                                "text": "[…]and spend every second Saturday defiant and one-eyed among the opposition nongs at the Barkly Street end."
                            }
                        ]
                    }
