                    {
                        "translation_id": "0c44e09a-d24c-48ab-9312-eb4f768b1eb3",
                        "source_entry_id": "d7bc6d29-9f2a-3f52-bd7a-b97010d2e817",
                        "source_sense_id": "38fd8831-d6ef-37ff-8fe3-9fada86501c0",
