                    },
                    {
                        "sense_id": "f82e2aff-fdbe-3d38-a9de-235da907a0c0",
                        "entry_id": "3f098741-4639-377b-9042-d7d1c29ef712",
                        "glosses": [
                            "перен., разг. заканчивающийся провалом"
                        ],
                        "tags": [],
