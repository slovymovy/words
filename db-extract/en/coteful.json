                        "glosses": [
                            "A number sufficient to fill a cote."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5fd2738c-9d85-435c-a026-d156b181867e",
                                "sense_id": "8a373cf0-1371-32d9-9750-b2e72fd23e64",
                                "text": "Seven honest good fellows were respectfully afraid of one rogue ; and the rogue was perfectly aware of the fact, and treated them accordingly ; much as a hawk would treat a coteful of pigeons, if he found it convenient to pass the night among them."
                            },
                            {
                                "example_id": "87db345b-64ad-464c-98f8-8b2a2761d8de",
                                "sense_id": "8a373cf0-1371-32d9-9750-b2e72fd23e64",
                                "text": "[…] there were old gaunt trees, and some five-barred gates, and crooked chimneys, and a coteful of doves, that gave the place a certain rural charm, even in mid-winter."
                            },
                            {
                                "example_id": "7ba3e16a-6b4d-42ee-98fe-378e94778c70",
                                "sense_id": "8a373cf0-1371-32d9-9750-b2e72fd23e64",
                                "text": "So, when she asked me to bring over that lad Jamie an’ his coteful of pigeons, I thought nowt of it but took him aboard."
                            }
                        ]
                    }
                ],
