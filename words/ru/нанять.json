{
    "word_family": [
        "наём",
        "наёмник",
        "наёмный",
        "наниматель",
        "нанимательница"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3412c531-7b17-3486-8a35-2a9b20f549dd",
                    "sense_definition": "Взять кого-либо на работу за плату.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компания решила <w>нанять</w> нового специалиста для работы над проектом.",
                            "target_lang_translations": {
                                "en": "The company decided to <w>hire</w> a new specialist to work on the project."
                            }
                        },
                        {
                            "text": "Нам нужно <w>нанять</w> рабочих для ремонта в квартире.",
                            "target_lang_translations": {
                                "en": "We need to <w>hire</w> workers for the apartment renovation."
                            }
                        }
                    ],
                    "synonyms": [
                        "подрядить"
                    ],
                    "antonyms": [
                        "уволить",
                        "рассчитать"
                    ],
                    "common_phrases": [
                        "нанять работника",
                        "нанять специалиста"
                    ],
                    "target_lang_definitions": {
                        "en": "To engage someone for work in exchange for payment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hire",
                                "target_lang_sense_clarification": "To give someone a job or obtain their services for payment."
                            },
                            {
                                "target_lang_word": "employ",
                                "target_lang_sense_clarification": "To retain someone as an employee."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18262e03-434e-37ad-843e-08071a5368bf",
                    "sense_definition": "Взять во временное пользование жилье или помещение за плату.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили <w>нанять</w> небольшую квартиру на время отпуска.",
                            "target_lang_translations": {
                                "en": "We decided to <w>rent</w> a small apartment for the duration of our vacation."
                            }
                        },
                        {
                            "text": "Туристы <w>наняли</w> дом у самого моря на две недели.",
                            "target_lang_translations": {
                                "en": "The tourists <w>rented</w> a house right by the sea for two weeks."
                            }
                        }
                    ],
                    "common_phrases": [
                        "нанять квартиру",
                        "нанять жилье"
                    ],
                    "target_lang_definitions": {
                        "en": "To take temporary possession of housing or a space in exchange for payment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rent",
                                "target_lang_sense_clarification": "To pay for the use of property or housing."
                            },
                            {
                                "target_lang_word": "hire",
                                "target_lang_sense_clarification": "To pay for the temporary use of something (common in UK English)."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}