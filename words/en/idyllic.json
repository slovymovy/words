{
    "word_family": [
        "idyll",
        "idyllically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7ebacaa8-f752-3c62-93ff-0d08a528ed31",
                    "sense_definition": "Extremely happy, peaceful, or picturesque.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "peaceful_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent an <w>idyllic</w> summer living in a small cottage by the sea.",
                            "target_lang_translations": {
                                "nl": "Ze brachten een <w>idyllische</w> zomer door in een klein huisje aan zee."
                            }
                        },
                        {
                            "text": "The village is set in an <w>idyllic</w> landscape surrounded by green hills.",
                            "target_lang_translations": {
                                "nl": "Het dorp ligt in een <w>idyllisch</w> landschap, omringd door groene heuvels."
                            }
                        }
                    ],
                    "synonyms": [
                        "peaceful",
                        "picturesque",
                        "serene",
                        "tranquil"
                    ],
                    "antonyms": [
                        "chaotic",
                        "turbulent"
                    ],
                    "common_phrases": [
                        "idyllic setting",
                        "idyllic life"
                    ],
                    "target_lang_definitions": {
                        "nl": "Uiterst gelukkig, vredig of schilderachtig."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "idyllisch",
                                "target_lang_sense_clarification": "Beschrijft iets dat bekoorlijk is door landelijke eenvoud en liefelijkheid."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdc73d3d-3f58-39f9-9617-4a4299219262",
                    "sense_definition": "Relating to or characteristic of an idyll.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literary_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poem captures an <w>idyllic</w> vision of rural life common in classical literature.",
                            "target_lang_translations": {
                                "nl": "Het gedicht vangt een <w>idyllische</w> visie op het plattelandsleven die gebruikelijk is in de klassieke literatuur."
                            }
                        },
                        {
                            "text": "His writing style is deeply rooted in <w>idyllic</w> traditions of the nineteenth century.",
                            "target_lang_translations": {
                                "nl": "Zijn schrijfstijl is diep geworteld in de <w>idyllische</w> tradities van de negentiende eeuw."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op of kenmerkend voor een idylle."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "idyllisch",
                                "target_lang_sense_clarification": "Verwijzend naar de literaire of artistieke traditie van een idylle."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d332074c-0ee5-3e8b-b48b-6872f2d39b1c",
                    "sense_definition": "An idyllic state or situation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "peaceful_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sought to escape the city and find a quiet <w>idyllic</w> in the countryside.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde aan de stad te ontsnappen en een rustige <w>idylle</w> op het platteland te vinden."
                            }
                        },
                        {
                            "text": "The artist painted a dreamlike <w>idyllic</w> that felt far removed from reality.",
                            "target_lang_translations": {
                                "nl": "De kunstenaar schilderde een droomachtige <w>idylle</w> die ver verwijderd voelde van de werkelijkheid."
                            }
                        }
                    ],
                    "synonyms": [
                        "paradise",
                        "utopia"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een idyllische toestand of situatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "idylle",
                                "target_lang_sense_clarification": "Een vredige, gelukkige toestand of plek."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}