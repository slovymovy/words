                    "sense_definition": "To remove or rub out something written or drawn on a surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "remove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>efface</w> the notes I have written on the whiteboard."
                        },
                        {
                            "text": "Time had <w>effaced</w> the inscription on the old stone monument."
                        }
                    ],
                    "synonyms": [
