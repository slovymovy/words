                "senses": [
                    {
                        "sense_id": "697bde25-c85a-35e2-975d-f50a2efdd43d",
                        "entry_id": "8e57112e-57f2-39a8-8fbe-9ac9823eaca7",
                        "glosses": [
                            "in Simbabwe (dort Amtssprache), Botsuana und Namibia gesprochene Nguni-Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df9756e-b487-4c07-bbb8-e08a567754ee",
                                "sense_id": "697bde25-c85a-35e2-975d-f50a2efdd43d",
                                "text": "Das Nord-Ndebele ist nach Shona die wichtigste Sprache Simbabwes."
                            },
                            {
                                "example_id": "a2f012e0-0b51-4eeb-908d-88c20327d532",
                                "sense_id": "697bde25-c85a-35e2-975d-f50a2efdd43d",
                                "text": "„Ein bekannter Aktivist für die Anerkennung von Nord-Ndebele als zwölfte offizielle Sprache Südafrikas rechtfertigt diese problematische Forderung […], indem er auf geringfügige lexikalische Unterschiede zwischen dieser Sprache und Süd-Ndebele hinweist (was unter dem Namen isiNdebele als eine der elf offiziellen Sprachen des Landes anerkannt ist).“"
                            },
                            {
                                "example_id": "9511325a-8d47-4cbb-99d0-e9749efae039",
                                "sense_id": "697bde25-c85a-35e2-975d-f50a2efdd43d",
                                "text": "„Sprachbezeichnung zugelassener Code nach ISO639-2/B […]\nNdebele (Nord-Ndebele) nde“"
                            },
                            {
                                "example_id": "b7e77e90-5ba5-451b-b04f-30e9baed2dec",
                                "sense_id": "697bde25-c85a-35e2-975d-f50a2efdd43d",
                                "text": "„Einheimische Sprachen: Nguni-Sprachen:\nNord-Ndebele 180 000“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
