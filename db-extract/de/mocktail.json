                "senses": [
                    {
                        "sense_id": "6ea813d5-f46b-3baf-8dd9-3bc29eb07422",
                        "entry_id": "dbaaf827-71db-3613-b04e-020b01df7f12",
                        "glosses": [
                            "alkoholfreier Cocktail, der einem alkoholhaltigen Cocktail nachempfunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9850b07f-5a88-44d9-b268-3436f0c437ae",
                                "sense_id": "6ea813d5-f46b-3baf-8dd9-3bc29eb07422",
                                "text": "„War in den 90ern und 2000ern noch die Rede von einem \"Virgin Sex on the Beach\" oder einer \"Virgin Piña Colada\", spricht man heute von Mocktails. Der Begriff setzt sich aus den englischen Wörtern \"Mock\" und \"Cocktail\" zusammen. \"To mock\" bedeutet so viel wie \"etwas vortäuschen\" bzw. \"etwas simulieren\". In diesem Fall wird also ein \"echter\" Cocktail, der traditionell mit Alkohol zubereitet wird, vorgetäuscht, ohne dabei auf einen leckeren Geschmack und auf Ästhetik zu verzichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
