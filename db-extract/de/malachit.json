                "senses": [
                    {
                        "sense_id": "8545d020-c004-3231-aceb-bbf77747292d",
                        "entry_id": "8973b931-d9af-3b2e-84d5-a58d1e95ec8e",
                        "glosses": [
                            "grünliches Mineral"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0965d1c-743c-4358-a2af-bf435c4116cd",
                                "sense_id": "8545d020-c004-3231-aceb-bbf77747292d",
                                "text": "„In jeden Fall baute man auch in Europa, im Bergwerk von Rudna Glava in Serbien, um diese Zeit bereits in Schächten Malachit und Azurit ab, was möglicherweise in den ersten Jahrhunderten hauptsächlich zu Schmuck und Farbpigmenten verarbeitet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73f2e4ee-c7b2-4a31-9bc6-b391659b03dd",
                        "source_entry_id": "8973b931-d9af-3b2e-84d5-a58d1e95ec8e",
                        "source_sense_id": "8545d020-c004-3231-aceb-bbf77747292d",
                        "source_sense_description": "grünliches Mineral",
                        "target_lang_word": "malachite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malachite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ace5f83-a406-3341-9eec-268bbdc270b7",
                                        "entry_id": "c90bacfb-2871-3661-94ff-16e4792ed256",
                                        "glosses": [
                                            "A bright green mineral, a basic copper carbonate, Cu₂CO₃(OH)₂; one of the principal ores of copper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e059e149-5c9b-45d5-8c33-ac871b146ceb",
                                                "sense_id": "5ace5f83-a406-3341-9eec-268bbdc270b7",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are […] . (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "898e42a3-9f40-3dea-9978-65f01adc71da",
                                        "entry_id": "c90bacfb-2871-3661-94ff-16e4792ed256",
                                        "glosses": [
                                            "A mild green color, like that of the mineral."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "malachite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a019b0-57db-3460-8c24-cf3ccf24c8be",
                                        "entry_id": "83cb82cb-9c3d-37a9-a952-e49a6c8dfff3",
                                        "glosses": [
                                            "Of a color ranging from olive-taupe to a mild to deeply-rich (at times seemingly translucent) green, like that of the mineral which is present on oxidized copper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "483733ac-ab04-4dbd-bb5c-9e04108616f9",
                        "source_entry_id": "8973b931-d9af-3b2e-84d5-a58d1e95ec8e",
                        "source_sense_id": "8545d020-c004-3231-aceb-bbf77747292d",
                        "source_sense_description": "grünliches Mineral",
                        "target_lang_word": "malachite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malachite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b83e28fe-706d-3b14-924d-8193dd91543b",
                                        "entry_id": "3b49034a-86b8-3cae-bf39-e21ab1f76952",
                                        "glosses": [
                                            "Espèce minérale du groupe des carbonates et du sous-groupe des carbonates anhydres avec anions étrangers de formule Cu₂(CO₃)(OH)₂, susceptible de recevoir un beau poli et employée pour la fabrication d’objets d’ornement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a3e2e4-0d4d-4d18-b1ff-b1a6583021b6",
                                                "sense_id": "b83e28fe-706d-3b14-924d-8193dd91543b",
                                                "text": "Le pauvre amant, pour subvenir aux frais de cette boite qui devait être en malachite, avait fait pour Florent et Chanor deux torchères, en leur en abandonnant la propriété, deux chefs-d’œuvre."
                                            },
                                            {
                                                "example_id": "98f1a149-e803-4823-a07d-1d4eebdce7ce",
                                                "sense_id": "b83e28fe-706d-3b14-924d-8193dd91543b",
                                                "text": "Il avait laissé tomber à ses pieds le couteau de malachite enrichi d’or dont il s’était servi pour couper les feuillets d’un livre."
                                            },
                                            {
                                                "example_id": "4ebaa407-3dd1-477e-8fc9-868428bf7165",
                                                "sense_id": "b83e28fe-706d-3b14-924d-8193dd91543b",
                                                "text": "Et alors, tandis qu’ils se tenaient debout dans le hall d’entrée à prendre leurs gants jaunes dans la coupe sur la table en malachite et que Hugh offrait à Miss Brush avec une politesse tout à fait superflue un vieux ticket de théâtre ou autre gracieuseté, qui lui faisait horreur au fond du cœur, elle en était devenue rouge brique, Richard se tourna vers Lady Bruton, le chapeau à la main, et lui dit : « Nous vous verrons ce soir à notre réception ? »"
                                            },
                                            {
                                                "example_id": "7cf3e58a-a186-4bb6-984d-701aa9f221cd",
                                                "sense_id": "b83e28fe-706d-3b14-924d-8193dd91543b",
                                                "text": "Les stucs, l’or, le bronze et les malachites; les tons chauds et ambrés des peintures sur lesquelles se détachent d’émouvantes carnations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2028edb5-5e99-4b1a-85b0-5d3a715e81e7",
                        "source_entry_id": "8973b931-d9af-3b2e-84d5-a58d1e95ec8e",
