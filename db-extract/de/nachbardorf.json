                        "form": "die Nachbardörfer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8794906b-8c21-3742-97b1-2a889f6d1431",
                        "entry_id": "058d8f56-0060-3f35-80f2-83fba28123e9",
                        "glosses": [
                            "Dorf, das in der Nachbarschaft einer Stadt oder eines Dorfes liegt; Dorf, dass man von der betreffenden Gemeinde aus direkt erreichen kann, ohne durch ein anderes Dorf oder eine Stadt zu fahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b899c67-5730-4ea6-bb52-b05e867bad62",
                                "sense_id": "8794906b-8c21-3742-97b1-2a889f6d1431",
                                "text": "In den Nachbardörfern gab es auch jedes Jahr ein Feuerwehrfest. Warum nicht auch in Benndorf?"
                            },
                            {
                                "example_id": "e0b3d3cd-4761-4e5d-adda-10dcfe452b44",
                                "sense_id": "8794906b-8c21-3742-97b1-2a889f6d1431",
                                "text": "Der Schustergeselle heiratete eine hübsche Magd aus dem Nachbardorf."
                            },
                            {
                                "example_id": "e60138bf-4cfc-470c-8005-dabf9afad9fa",
                                "sense_id": "8794906b-8c21-3742-97b1-2a889f6d1431",
                                "text": "Die Kinder gehen zusammen mit denen der Nachbardörfer in das Nachbardorf Karakaya zum Unterricht."
                            },
                            {
                                "example_id": "6c8924c8-af5f-4741-bfc0-97dbfd3d1000",
                                "sense_id": "8794906b-8c21-3742-97b1-2a889f6d1431",
                                "text": "„Früher machte man eine Lehre im Nachbardorf, wurde übernommen und bekam später eine Armbanduhr für fünfzig Jahre Betriebszugehörigkeit.“"
                            },
                            {
                                "example_id": "25b9657a-465f-4231-91fa-b3d675453003",
                                "sense_id": "8794906b-8c21-3742-97b1-2a889f6d1431",
                                "text": "„Didier sorgte dafür, dass sie in geweihte Erde kamen, fand in einem der Nachbardörfer einen Priester, der die Seelenmesse las.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
