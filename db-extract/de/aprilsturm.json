                "senses": [
                    {
                        "sense_id": "bcaf1d77-be01-3676-a446-4f1dd5fd8e94",
                        "entry_id": "008fbb2a-4d05-31e3-94a5-a6245cbdbd9b",
                        "glosses": [
                            "im Monat April wehender, kräftiger Sturm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f94214d-d658-4cf6-a3f4-f197cfcf4f48",
                                "sense_id": "bcaf1d77-be01-3676-a446-4f1dd5fd8e94",
                                "text": "„Jetzt sind seine Beinkleider bespritzt, und seine Haare sind vom Aprilsturm durcheinandergewühlt.“"
                            },
                            {
                                "example_id": "dc7bcf72-ff00-4544-bc9b-f1e4574cbefa",
                                "sense_id": "bcaf1d77-be01-3676-a446-4f1dd5fd8e94",
                                "text": "„Für Fritzchen freilich ist der Sommer im Grunde heute schon da, trotz Schnee, Hagel, Aprilsturm und Nässe.“"
                            },
                            {
                                "example_id": "a8e0b136-d638-4c79-9845-f961d93d2d29",
                                "sense_id": "bcaf1d77-be01-3676-a446-4f1dd5fd8e94",
                                "text": "„Ein anständiger Aprilsturm wehte draußen und brach sich heulend an der scharfen Ede des hohen Schlosses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
