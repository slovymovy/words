                                        "entry_id": "a6666388-8c51-309d-bdd9-09e62aa965c1",
                                        "glosses": [
                                            "The state induced by hypnotic methods (especially that of Mesmer himself)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
