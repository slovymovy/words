                "senses": [
                    {
                        "sense_id": "462bb9be-4b25-37a9-93d1-9ec29956230e",
                        "entry_id": "017a179d-8e2a-32f8-886d-fdba42798a58",
                        "glosses": [
                            "kleines, altertümliches Ladengeschäft mit Lebensmitteln, Getränken und Waren des täglichen Bedarfs"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "21d5b53f-70bf-4b9b-a4b6-580d2808bb59",
                                "sense_id": "462bb9be-4b25-37a9-93d1-9ec29956230e",
                                "text": "„Andrea Lunzer plant genau so ein Geschäft, wie es ihre Großmütter früher erlebt haben – eine Greißlerei.“"
                            },
                            {
                                "example_id": "205bea41-8b1c-4247-a215-dba482a1be58",
                                "sense_id": "462bb9be-4b25-37a9-93d1-9ec29956230e",
                                "text": "„In der Greißlerei warte der Genosse Pleyl.“"
                            },
                            {
                                "example_id": "9f84a727-6ef0-4faf-9e2f-6b89010eaa22",
                                "sense_id": "462bb9be-4b25-37a9-93d1-9ec29956230e",
                                "text": "„Er betreibt dort ein Geschäft mit dem Charme einer alten Greißlerei, in der er Eis mit gozitanischer Gelassenheit verkauft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
