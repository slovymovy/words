                "senses": [
                    {
                        "sense_id": "8ca7353f-954e-3b49-bb49-5d8b34db170a",
                        "entry_id": "a862477a-3455-3648-a7f9-427ac4f9c1ae",
                        "glosses": [
                            "Qui détermine, qui précise ou restreint la signification d’un mot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56dbe730-eca8-4ceb-8b2a-8ad06f75f7e7",
                                "sense_id": "8ca7353f-954e-3b49-bb49-5d8b34db170a",
                                "text": "Dans \"La lumière du soleil\", soleil est le nom déterminatif. — Déterminatif de lumière."
                            },
                            {
                                "example_id": "6d2230b4-c2b5-4f95-bd8d-84921fb8eb96",
                                "sense_id": "8ca7353f-954e-3b49-bb49-5d8b34db170a",
                                "text": "Adjectif déterminatif. - Complément déterminatif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b94f4027-27b9-4bb8-ae22-a4d82b503b40",
                        "source_entry_id": "a862477a-3455-3648-a7f9-427ac4f9c1ae",
