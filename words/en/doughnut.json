                            {
                                "target_lang_word": "пампу́шка",
                                "target_lang_sense_clarification": "небольшая мягкая булочка из дрожжевого теста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee6a64e1-097c-348e-83b8-b3b1af259ceb",
                    "sense_definition": "A foolish or stupid person.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>doughnut</w> and listen to the instructions.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>болва́ном</w> и послушай инструкции."
                            }
                        },
                        {
                            "text": "He acted like a total <w>doughnut</w> when he forgot his keys again.",
                            "target_lang_translations": {
                                "ru": "Он повел себя как полный <w>дура́к</w>, когда снова забыл ключи."
                            }
                        }
