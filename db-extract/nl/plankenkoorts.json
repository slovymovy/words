                                            {
                                                "example_id": "6951d8f2-7d91-4e42-8e1a-e6660a550403",
                                                "sense_id": "693e5145-f5b9-3c01-b494-c61812927aab",
                                                "text": "Selbst erfahrene Entertainer können vor einem Fernsehauftritt noch Lampenfieber bekommen."
                                            },
                                            {
                                                "example_id": "672000e0-120d-46f1-974a-1e893094f8ab",
                                                "sense_id": "693e5145-f5b9-3c01-b494-c61812927aab",
                                                "text": "„Ein leichtes Zittern in Hamanns Stimme verrät das Lampenfieber vor dem ersten Auftritt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3976e0f9-e016-318b-aeaa-ddfdb0df4f4e",
                                        "entry_id": "0443eb25-e6ff-36e4-8c61-928df03beceb",
                                        "glosses": [
                                            "die Anspannung oder gar Panik eines Menschen kurz vor einem Auftritt vor (meist vielen) Personen"
                                        ],
