                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1341893-9c90-444e-a445-5d736b7be4f2",
                                "sense_id": "f28714a4-c8b3-3e5f-be35-7a8d91499211",
                                "text": "Der Zugbetrieb wird für drei Wochen eingestellt, da das Gleisbett saniert und die Oberleitungen ersetzt werden."
                            },
                            {
                                "example_id": "362775cd-ce9a-438c-bed6-2915faff377a",
                                "sense_id": "f28714a4-c8b3-3e5f-be35-7a8d91499211",
                                "text": "„Auf der Strecke Breslau–Königszelt wird der elektrische Zugbetrieb eröffnet.“"
                            },
                            {
                                "example_id": "925d81c7-5486-4b00-bda3-068a2091286f",
                                "sense_id": "f28714a4-c8b3-3e5f-be35-7a8d91499211",
                                "text": "„Dagegen ist es zulässig, den Fehlbetrag, der für den Fährbetrieb, an und für sich betrachtet, überhaupt entsteht, vom Zugbetriebe zu decken […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
