                ],
                "senses": [
                    {
                        "sense_id": "74e94f29-502d-3af0-be88-b81102ed2a0f",
                        "entry_id": "c8c5b54b-8479-3f30-9541-9e2ab71776f4",
                        "glosses": [
                            "страд. прич. прош. вр. от позабыть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "0c55e13f-9a34-418f-8321-7f9bbf7a9b92",
                                "sense_id": "74e94f29-502d-3af0-be88-b81102ed2a0f",
                                "text": "Невзгоды, постигшие беглецов в прошлую осень, были позабыты."
                            },
                            {
                                "example_id": "7390b434-8099-4ee5-bd05-21bb1ebe2d20",
                                "sense_id": "74e94f29-502d-3af0-be88-b81102ed2a0f",
                                "text": "Казалось, она старалась припомнить какую-то позабытую мысль или отыскать какой-то потерянный предмет."
                            },
                            {
                                "example_id": "4b661724-1b6c-4c0e-8ca4-9be1574af875",
                                "sense_id": "74e94f29-502d-3af0-be88-b81102ed2a0f",
                                "text": "Однако этот негритянский танец был вскорости позабыт."
                            },
                            {
                                "example_id": "5b69c8cf-7c04-4bf8-a598-5afde712c679",
                                "sense_id": "74e94f29-502d-3af0-be88-b81102ed2a0f",
                                "text": "Подростков брали только через биржу труда ― учреждение ныне позабытое, а многим и вовсе неизвестное."
                            }
                        ]
                    }
                ],
