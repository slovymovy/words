                "senses": [
                    {
                        "sense_id": "859437c9-8c20-3b11-b367-9b2fe5fcd355",
                        "entry_id": "5601df2d-7c7d-349c-8adf-18719bd8d342",
                        "glosses": [
                            "Espèce chimique ne différant d’une autre que par ses isotopes, mais identique sur le plan de la structure atomique."
                        ],
                        "tags": [],
                        "note": "à distinguer du terme isotopomère, où c'est la position des isotopes qui diffère",
                        "examples": [
                            {
                                "example_id": "80a7f459-ec89-4707-89de-32e0609f1a8f",
                                "sense_id": "859437c9-8c20-3b11-b367-9b2fe5fcd355",
                                "text": "L’eau lourde (D₂O) est un isotopologue de l’eau légère (H₂O)."
                            },
                            {
                                "example_id": "54f6a0be-fe57-4915-923d-85fc1cd92ef4",
                                "sense_id": "859437c9-8c20-3b11-b367-9b2fe5fcd355",
                                "text": "En effet, les différents processus conduisant à l’émission de méthane dans l’atmosphère ne traitent pas l’isotopologue ¹²CH₄ comme l’isotopologue ¹³CH₄, ni le méthane deutéré comme le méthane non deutéré."
                            },
                            {
                                "example_id": "b1f45491-a224-4296-b7ab-567390513574",
                                "sense_id": "859437c9-8c20-3b11-b367-9b2fe5fcd355",
                                "text": "Comme ce rapport entre les isotopologues dépend de la température, il permet de connaître la température au moment de la production du carbonate du coquillage."
                            }
                        ]
                    }
                ],
