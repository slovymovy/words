                ],
                "senses": [
                    {
                        "sense_id": "62f5da25-8b79-33c0-a958-1b822ecfec20",
                        "entry_id": "aea70f43-d80f-316f-b66e-9f39b6400e0c",
                        "glosses": [
                            "A vessel equipped for the removal of sand or sediment from the seabed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253653b5-7d9e-445b-a945-c86b161c792d",
                                "sense_id": "62f5da25-8b79-33c0-a958-1b822ecfec20",
                                "text": "The section includes also combination bucket and suction dredges, true suction dredgers, the Friihling dredge, the reclamation dredge, the longshoot dredge, the hopper barge, the self-propelling hopper, and the rock cutter."
                            }
                        ]
                    },
                    {
                        "sense_id": "9daeb335-f430-39c8-a156-46200740da6f",
                        "entry_id": "aea70f43-d80f-316f-b66e-9f39b6400e0c",
                        "glosses": [
                            "One who fishes with a dredge."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f6b785d8-e078-35b7-882e-e893d5c1655c",
                        "entry_id": "aea70f43-d80f-316f-b66e-9f39b6400e0c",
                        "glosses": [
                            "A dredging machine."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "af3d09b6-fbd0-321c-aaa1-39a575c83d2f",
                        "entry_id": "aea70f43-d80f-316f-b66e-9f39b6400e0c",
                        "glosses": [
                            "A container with a perforated lid, used to sprinkle sugar or flour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd25a286-0868-4ca8-998c-fd3109a0e508",
                                "sense_id": "af3d09b6-fbd0-321c-aaa1-39a575c83d2f",
                                "text": "In the kitchen Mrs. Piper was busy with a flour dredger, a rolling pin, and a basin of dough."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6254485-eda9-42bd-b66f-997e12a2c13f",
                        "source_entry_id": "aea70f43-d80f-316f-b66e-9f39b6400e0c",
                        "source_sense_description": "A vessel",
                        "target_lang_word": "dragueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dragueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab329a0f-c4d6-3102-b358-ba9c7c94e82c",
                                        "entry_id": "a916434f-2a3f-3753-8bbb-b3bc31df96b6",
                                        "glosses": [
                                            "Sorte d'engin de forage."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3050642a-a19c-4950-ae3f-20a35815af36",
                                                "sense_id": "ab329a0f-c4d6-3102-b358-ba9c7c94e82c",
                                                "text": "Le cylindre en tôle attaché à l'instrument étant resté ancré dans le petit puits, la tige de l'outil s'est brisée quand on a tiré dessus ; plusieurs des pièces du dragueur restèrent dans le trou ; il fallut travailler pendant trois jours pour les retirer et pour détacher le cylindre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad2db5c-f601-3213-9498-32debb970e35",
                                        "entry_id": "a916434f-2a3f-3753-8bbb-b3bc31df96b6",
                                        "glosses": [
                                            "Bateau équipé pour faire des opérations de dragage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8e32c7-3c03-4435-9284-e155a85bb761",
                                                "sense_id": "1ad2db5c-f601-3213-9498-32debb970e35",
                                                "text": "Le curage des vases de la Darse au moyen d'un dragueur à la vapeur de la force de 14 chevaux, a été complet en 1837."
                                            },
                                            {
                                                "example_id": "95b8cb4f-19c8-487f-b647-01cfa1047f81",
                                                "sense_id": "1ad2db5c-f601-3213-9498-32debb970e35",
                                                "text": "Le dragueur du lac à la Tortue avait une capacité de 40 tonnes par jour. Les morceaux de minerai devaient être sensiblement de même grosseur avant d’être soumis à l’action des hauts fourneaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3fc6bdc-ab93-31bb-ba1e-546b42b5f940",
                                        "entry_id": "a916434f-2a3f-3753-8bbb-b3bc31df96b6",
                                        "glosses": [
                                            "Navire de guerre équipé pour détruire les mines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5488d1e-142f-4403-a7de-07d55c7cf0a0",
                                                "sense_id": "a3fc6bdc-ab93-31bb-ba1e-546b42b5f940",
                                                "text": "D'un treuil placé à l'arrière de chaque dragueur part un câble d'acier appelé remorque, lequel, à une cinquantaine de mètres du bord, se divise en deux « brins de drague » divergents, longs de 200 mètres. L'ensemble dessine un Y couché."
                                            },
                                            {
                                                "example_id": "4ef6e5fd-477d-4606-80f0-518219c492b6",
                                                "sense_id": "a3fc6bdc-ab93-31bb-ba1e-546b42b5f940",
                                                "text": "Ceux qui sont ici depuis plusieurs mois me recommandent tout de suite de chercher à me faire embarquer sur un Dragueur de mines car sur ces petites unités l'ambiance est excellente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "319b8538-2742-3445-8e1e-7093a572a320",
                                        "entry_id": "a916434f-2a3f-3753-8bbb-b3bc31df96b6",
                                        "glosses": [
                                            "Bateau équipé pour la pêche de bancs de poisson : la morue, le maquereau, le hareng, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa0743bd-8e16-4ef0-ab0f-bc2d1d72492f",
                                                "sense_id": "319b8538-2742-3445-8e1e-7093a572a320",
                                                "text": "Aux Iles, le premier dragueur chalutier en bois et pêchant latéralement, arriva en 1954, commandé par un pêcheur du Havre aux Maisons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11ff4889-b8e3-3241-9157-eea12d4af369",
                                        "entry_id": "a916434f-2a3f-3753-8bbb-b3bc31df96b6",
                                        "glosses": [
                                            "Bateau équipé pour la culture des huîtres en eaux profondes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dragueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0cff25-874c-31ae-882e-254b76585701",
                                        "entry_id": "135136cd-6459-3d89-93f0-59fffa74dd0c",
                                        "glosses": [
                                            "Celui qui pêche à la drague."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f6aed4c-ffae-3194-bcd5-e1419ec20fdf",
                                        "entry_id": "135136cd-6459-3d89-93f0-59fffa74dd0c",
                                        "glosses": [
                                            "Marin-pêcheur qui drague les bancs d’huître."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9ba75c4-693f-3b0a-972e-5cf23b58ac68",
                                        "entry_id": "135136cd-6459-3d89-93f0-59fffa74dd0c",
                                        "glosses": [
                                            "Celui qui conduit une drague."
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7dd4507-ed5f-4b88-b3c6-084db625ebd1",
                                                "sense_id": "a9ba75c4-693f-3b0a-972e-5cf23b58ac68",
                                                "text": "Il avait été choyé cette année-là par la femme d’un maître dragueur, dont le bateau était amarré dans une anse tranquille de la Moselle ; une belle femme brune, aux yeux ardents, approchant de la trentaine, et qui dès le matin se tenait sur le devant de sa cabine, vêtue de camisoles d’une blancheur irréprochable, ayant l’air d’attendre, on ne savait quoi, dans sa mise de femme entretenue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ce50e7-3e74-3503-9f1b-0f3b61c80ac7",
                                        "entry_id": "135136cd-6459-3d89-93f0-59fffa74dd0c",
                                        "glosses": [
                                            "Ouvrier qui tire du sable du fond des eaux et cure les cours d’eau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b537e831-f22e-402b-b163-e4a8c83f9f30",
                                                "sense_id": "76ce50e7-3e74-3503-9f1b-0f3b61c80ac7",
                                                "text": "Le dragueur tenant le manche par son extrémité lance la drague devant lui, puis quand elle a touché le fond il pose le bout du manche sur son épaule et ramène l'engin vers lui en appuyant des deux mains sur le manche de manière à faire pénétrer la cuiller dans le sol."
                                            },
                                            {
                                                "example_id": "b200f7b0-3160-49a6-a315-9163741178c7",
                                                "sense_id": "76ce50e7-3e74-3503-9f1b-0f3b61c80ac7",
                                                "text": "Le salaire du dragueur est généralement payé en nature, le plus souvent avec une part d'eau. Dans un village de Gonabad, dans le nord-est, tous les champs sont irrigués tous les quatorze jours l'été […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03a9e65b-f082-3277-b7ea-8427d831ac88",
                                        "entry_id": "135136cd-6459-3d89-93f0-59fffa74dd0c",
                                        "glosses": [
                                            "Celui qui fait la cour dans le but d’obtenir des faveurs amoureuses ; séducteur assez importun, qui parvient peu à ses fins ; lovelace."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b3c70cd-0793-405d-9154-147d3fed7e18",
                                                "sense_id": "03a9e65b-f082-3277-b7ea-8427d831ac88",
                                                "text": "Agressif ou flatteur, impromptu ou acharné, le dragueur égrène tout au long de son infructueuse quête sa concupiscente litanie. On presse alors le pas, tête baissée, découragée et battue, tristement ramenée à son humiliante condition de femme dans le décor flamboyant de la capitale."
                                            },
                                            {
                                                "example_id": "8b0627e9-b160-40c4-960e-d72bc48eca4f",
                                                "sense_id": "03a9e65b-f082-3277-b7ea-8427d831ac88",
                                                "text": "Phèdre, qui « reconnut Vénus et ses feux redoutables » en voyant son beau-fils pour la première fois, ressemble, malgré elle, au dragueur maladroit qui aborde les filles par: « on ne s'est pas déjà vu quelque part ? »"
                                            },
                                            {
                                                "example_id": "016afc18-42d4-4548-9854-6f3142183b4e",
                                                "sense_id": "03a9e65b-f082-3277-b7ea-8427d831ac88",
                                                "text": "Elle laisse entendre au dragueur qu'elle est ouverte a toute éventualité. Elle va alors lui donner une série de rendez-vous auxquels elle ne se rendra pas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dragueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27868d24-0bde-3b5f-bb2f-d38e7097cbb5",
                                        "entry_id": "3fd0e9e4-db97-3984-882b-5e5c27cb8354",
                                        "glosses": [
                                            "Qui porte une drague ; qui effectue un dragage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e12546a7-16f9-476d-b85c-a6b6d2520dec",
                                                "sense_id": "27868d24-0bde-3b5f-bb2f-d38e7097cbb5",
                                                "text": "Ce bateau dragueur présente dans sa combinaison les caractères distinctifs suivants : […]."
                                            },
                                            {
                                                "example_id": "e0ed7eae-19b5-4d44-aeac-a49baa703094",
                                                "sense_id": "27868d24-0bde-3b5f-bb2f-d38e7097cbb5",
                                                "text": "Sa forme est celle d'un rectangle, évidé à l'une de ses extrémités pour laisser passer l'appareil dragueur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
