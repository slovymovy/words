            {
                "entry_id": "1a6b80d5-5365-37e4-84e3-a673b4edf1de",
                "word": "woods",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "13088882-8d72-347b-be7b-392571c75af1",
                        "entry_id": "1a6b80d5-5365-37e4-84e3-a673b4edf1de",
                        "glosses": [
                            "A dense collection of trees, usually one covering a relatively small area; usually smaller than a forest."
                        ],
                        "tags": [
                            "plural",
                            "sometimes",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e204d9ce-8fff-4256-baeb-e10f0015aaad",
                                "sense_id": "13088882-8d72-347b-be7b-392571c75af1",
                                "text": "These woods are part of the Campbell property."
                            },
                            {
                                "example_id": "d97043fe-7e64-4a03-9a4c-675315576b35",
                                "sense_id": "13088882-8d72-347b-be7b-392571c75af1",
                                "text": "This woods is part of the Campbell property. (uncommon)"
                            },
                            {
                                "example_id": "9bd0db50-3dc0-43b8-aa67-19b01d883df7",
                                "sense_id": "13088882-8d72-347b-be7b-392571c75af1",
                                "text": "The woods are lovely, dark and deep"
                            },
                            {
                                "example_id": "6b1d6e94-5db9-460d-b22f-3be09ad899f3",
                                "sense_id": "13088882-8d72-347b-be7b-392571c75af1",
                                "text": "Where protection is not considered essential, the logical places for establishing a woods are on those portions of the farm which have steep slopes […]."
                            },
                            {
                                "example_id": "7edba26e-0092-4c96-81f6-43f1fc6e5e9f",
                                "sense_id": "13088882-8d72-347b-be7b-392571c75af1",
                                "text": "Night after night, we both had similar dreams that our daughter was wandering around in a woods."
                            },
                            {
                                "example_id": "e0a9a938-cac1-4704-bd53-c1e82ab45d43",
                                "sense_id": "13088882-8d72-347b-be7b-392571c75af1",
                                "text": "It is a crop, like a crop of corn, which differs from a natural field of grasses in the way that a crop of trees differs from a woods."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6bc6d60-da10-343c-86fa-c90ab83ecdcc",
                        "entry_id": "1a6b80d5-5365-37e4-84e3-a673b4edf1de",
                        "glosses": [
                            "For chemical behavior purposes, trees in full leaf (coniferous or medium-dense deciduous forests)."
                        ],
                        "tags": [
                            "attributive",
                            "plural"
                        ],
                        "examples": []
                    }
