                "senses": [
                    {
                        "sense_id": "94d9520a-366e-3627-bc47-d102531d6a6b",
                        "entry_id": "8ed4f3d6-6f1f-3e56-bb1b-af882625ead1",
                        "glosses": [
                            "Chor, in dem ausschließlich männliche, meist erwachsene Personen singen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56cffccd-5c9f-4169-9409-e13f38357efb",
                                "sense_id": "94d9520a-366e-3627-bc47-d102531d6a6b",
                                "text": "„Der Männerchor Wehr gestaltete seinen festlichen Konzertabend in der Wehrer Stadthalle als Mehr-Generationenprojekt.“"
                            },
                            {
                                "example_id": "d46d6cc9-0d72-4fa2-b95f-e966e0eafba1",
                                "sense_id": "94d9520a-366e-3627-bc47-d102531d6a6b",
                                "text": "„Noch gab es nur reinen Wohlklang, die drei Os rollten wie die Bassstimmen eines Männerchors.“"
                            }
                        ],
