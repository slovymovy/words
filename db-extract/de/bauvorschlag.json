                "senses": [
                    {
                        "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                        "entry_id": "8ccf0abd-3301-3a8e-a52e-1987ee2339ba",
                        "glosses": [
                            "Empfehlung, beispielsweise eines Experten, an jemanden, etwas zu bauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15d86e0a-0106-44b3-b8f6-f268af96857f",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "Dieser Bauvorschlag ist kinderleicht nachzubauen."
                            },
                            {
                                "example_id": "9bc45b3a-ea5a-4fba-9f74-66495734f259",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "Sie werden, um diesen Bauvorschlag zu realisieren, etwa acht Stunden Zeit investieren müssen."
                            },
                            {
                                "example_id": "e1c9d523-ad23-4ca5-b31f-4f66d60a8552",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "„Das Internet bietet eine Fülle von Bauvorschlägen.“"
                            },
                            {
                                "example_id": "66fd747a-6ad4-495e-87b9-d3933ff61617",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "[Lautsprecher:] „Clevere Concepte, das sind unsere Bauvorschläge mit dem besten Preis-Leistungs-Verhältnis.“"
                            },
                            {
                                "example_id": "22ab3da7-ab89-4523-bd19-ce7a3af10823",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "[Lautsprecher:] „Da ich schon länger […] auf der Seite unterwegs war, stellte sich nur die Frage, welcher der Bauvorschläge in Frage kommt.“"
                            },
                            {
                                "example_id": "3b88bf50-9fed-4b36-9227-f8bcb2dde355",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "„Unser Bauvorschlag für einen 7-Watt-Minirechner vereint AMD Athlon 200GE, SSD, USB-C und zwei 4K-Displayausgänge zu einem günstigen, zuverlässigen Bürorechner.“"
                            },
                            {
                                "example_id": "d4a7c05d-0f28-4ede-a4ae-9fcd6b759a63",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "[DIY-Rechner:] „Wer […] selbst basteln möchte, findet am Ende noch drei tolle Bauvorschläge.“"
                            },
                            {
                                "example_id": "2c35ecba-8800-44a4-8a00-607610ada83c",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "[DIY-Rechner:] „Wir empfehlen eine Kurve, die die Drehzahl bei ansteigender Temperatur möglichst lange niedrig hält und dann exponentiell ansteigt. Bei unseren Bauvorschlägen haben wir damit gute Erfahrungen gemacht.“"
                            },
                            {
                                "example_id": "c7de7cff-0205-48d1-bb0b-0c97e368327f",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "„Dänemark hat die Weichen für den Bau eines 18 Kilometer langen Ostsee-Tunnels nach Deutschland gestellt. Am Dienstag stimmten in Kopenhagen sieben von acht Parlamentsfraktionen einem entsprechenden Bauvorschlag zu.“"
                            },
                            {
                                "example_id": "3d82a879-9680-4f51-bf84-1b6c08b0953d",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "„Diesen Bauvorschlag skizzierte Garbers schematisch und in groben Zügen auf einem losen Blatt Papier […].“"
                            },
                            {
                                "example_id": "7fa692ec-80f5-4ecd-aec6-29d7c54245e0",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "„Die jahrelang skandalös verschleppte Topographie des Terrors in Berlin soll mit einem neuen Bauvorschlag gerettet werden“"
                            },
                            {
                                "example_id": "59cba7de-990e-4464-9e8e-80c7c1788344",
                                "sense_id": "a887ece7-b7ed-3900-8695-180ba8a7c8cd",
                                "text": "„Bereits 1991 hatte eine vom Land Brandenburg finanzierte Studie des Planungsbüros Berliner Verkehrs-Consult Bauvorschläge für die zweigleisige Anbindung Rangsdorfs an die S-Bahn vorgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
