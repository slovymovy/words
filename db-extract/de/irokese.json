                        "entry_id": "fe543c7e-db2f-36fb-a494-7e9ddd554614",
                        "glosses": [
                            "nordamerikanischer Ureinwohner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b7d62b5-b1a3-4707-82f1-cf5ff23d16eb",
                                "sense_id": "1b576e5f-b295-3970-9035-0b7fcac44d87",
                                "text": "Mein Urgroßvater war Irokese."
                            },
                            {
                                "example_id": "669b5166-5c6b-462a-96f1-d28cbcab5fab",
                                "sense_id": "1b576e5f-b295-3970-9035-0b7fcac44d87",
                                "text": "„[…] Die polnische Führungsschicht etwa beschimpfte [Friedrich der Große] als die »Irokesen Europas«.“"
                            },
                            {
                                "example_id": "fa437994-0b10-4fdc-bd26-e3b7be709a2e",
                                "sense_id": "1b576e5f-b295-3970-9035-0b7fcac44d87",
                                "text": "„So nannten Irokesen und Cherokee das Dreigespann aus Mais, Bohnen und Kürbis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c145296d-6e51-3733-8935-4bac464a1352",
                        "entry_id": "fe543c7e-db2f-36fb-a494-7e9ddd554614",
                        "glosses": [
                            "Frisur mit rasierten Kopfseiten (und typischerweise hochgegeltem Haar)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9cabd99-5f1a-4fa6-b211-c3c7eb29ec15",
                                "sense_id": "c145296d-6e51-3733-8935-4bac464a1352",
                                "text": "Michi ist der mit dem Irokesen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e072c5b-658a-48a0-bca6-21a852e3ea8b",
                        "source_entry_id": "fe543c7e-db2f-36fb-a494-7e9ddd554614",
