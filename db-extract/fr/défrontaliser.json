                        "glosses": [
                            "Faire perdre à quelque chose son caractère frontal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00f62ba1-4345-41a5-b4dd-fdacd1bcc863",
                                "sense_id": "b1d38ba6-c90d-326f-961e-29dc90664735",
                                "text": "Tout le problème c’est de défrontaliser l’enseignement, de décoaguler les relations duelles en groupe qui peuvent dégénérer ; d’ouvrir la classe – on pourrait dire : et la famille ! – médiévales à la pensée et à la recherche."
                            },
                            {
                                "example_id": "03cf7282-bb3b-447b-902e-27bc8390b073",
                                "sense_id": "b1d38ba6-c90d-326f-961e-29dc90664735",
                                "text": "Ces panoramas, non trafiqués, n’existent pourtant pas tels qu’on les imagine : l’absence d'indices et leur point de vue défrontalisé laissent suspendue la question de leur origine."
                            },
                            {
                                "example_id": "2b79b447-1f10-409f-b7bf-e3c38f98e3b3",
                                "sense_id": "b1d38ba6-c90d-326f-961e-29dc90664735",
                                "text": "A partir du moment où les actions seront automatisées, elles seront « défrontalisées »."
                            }
                        ]
                    }
