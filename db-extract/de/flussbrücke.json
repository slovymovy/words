                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03140ad9-c2e2-4090-9b72-e4b70193f7af",
                                "sense_id": "c4868a3c-8e55-3757-8822-40ed46115e81",
                                "text": "„Nach seiner Rückkehr berichtete er, dass sie wohl damit beschäftigt seien, die alte, moosüberwucherte Flussbrücke zu begutachten.“"
                            },
                            {
                                "example_id": "fab8b76a-7d2d-4273-9f9b-984cfd6a9cda",
                                "sense_id": "c4868a3c-8e55-3757-8822-40ed46115e81",
                                "text": "„Der frühmorgendliche Bus- und Autoverkehr hatte bereits eingesetzt, und die Fahrzeuge rumpelten lärmend über den Golha-Platz zur Flussbrücke hin.“"
                            },
                            {
                                "example_id": "17d48d45-529a-4119-a76f-fd778e95834c",
                                "sense_id": "c4868a3c-8e55-3757-8822-40ed46115e81",
                                "text": "„Sie überquerte die Flussbrücke, ging behutsam die schlecht verfugten Planken entlang und blickte hinunter zum Wasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
