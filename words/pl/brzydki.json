                {
                    "sense_id": "5c019277-56b2-3734-8756-d8219638c5f4",
                    "sense_definition": "Subiektywnie pozbawiony piękna lub wartości estetycznych.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten stary budynek jest bardzo <w>brzydki</w> i wymaga natychmiastowego remontu.",
                            "target_lang_translations": {
                                "ru": "Это старое здание очень <w>некрасивое</w> и требует немедленного ремонта.",
                                "de": "Dieses alte Gebäude ist sehr <w>hässlich</w> und muss sofort renoviert werden.",
                                "en": "That old building is very <w>ugly</w> and requires immediate renovation.",
                                "zh": "那座老楼很<w>难看</w>，急需翻修。"
                            }
                        },
                        {
                            "text": "Nie kupuj tej sukienki, bo ma wyjątkowo <w>brzydki</w> kolor.",
                            "target_lang_translations": {
                                "ru": "Не покупай это платье, потому что у него исключительно <w>некрасивый</w> цвет.",
                                "de": "Kauf dieses Kleid nicht, denn es hat eine ausgesprochen <w>hässliche</w> Farbe.",
                                "en": "Don't buy that dress because it has an exceptionally <w>ugly</w> color.",
                                "zh": "别买这条连衣裙，它的颜色特别<w>难看</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nieładny",
                        "nieestetyczny",
                        "nieatrakcyjny"
                    ],
                    "antonyms": [
