    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e4f77e5-b799-37d3-a238-08eff2cdd677",
                    "sense_definition": "Signe graphique que l'on place sur certaines voyelles pour en modifier la prononciation ou pour distinguer des homonymes.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ecriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de mettre un <w>accent</w> aigu sur la lettre e."
                        },
                        {
                            "text": "En français, le mot où s'écrit avec un <w>accent</w> grave pour le différencier de la conjonction ou."
                        }
                    ],
                    "synonyms": [
                        "diacritique"
                    ],
                    "common_phrases": [
                        "accent aigu",
                        "accent circonflexe",
                        "accent grave"
                    ]
                },
                {
                    "sense_id": "eeb820ed-d16d-3c00-9320-b3676bdf2522",
                    "sense_definition": "Manière particulière de prononcer propre aux habitants d'une région ou aux locuteurs d'une langue étrangère.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle parle très bien l'anglais mais conserve un léger <w>accent</w> français."
                        },
                        {
                            "text": "Les touristes ont remarqué son <w>accent</w> chantant typique du sud du pays."
                        }
                    ],
                    "synonyms": [
                        "prononciation"
                    ],
                    "common_phrases": [
                        "accent étranger",
                        "accent régional",
                        "avoir de l'accent"
                    ]
                },
                {
                    "sense_id": "d081172d-fada-37ec-9baa-3dcbfef0443b",
                    "sense_definition": "Insistance ou importance particulière accordée à un point précis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a mis l'<w>accent</w> sur la nécessité d'apprendre régulièrement les leçons."
                        },
                        {
                            "text": "Notre nouvelle campagne met l'<w>accent</w> sur la protection de l'environnement."
                        }
                    ],
                    "common_phrases": [
                        "mettre l'accent sur"
                    ]
                },
                {
                    "sense_id": "b887372a-2ecc-36dd-9e87-628eb27c7331",
                    "sense_definition": "Élévation de la voix ou augmentation de l'intensité sur une syllabe donnée au sein d'un mot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "phonetique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En espagnol, la place de l'<w>accent</w> tonique peut totalement changer le sens d'un verbe."
                        },
                        {
                            "text": "Le poète respecte scrupuleusement la règle des <w>accents</w> dans chaque vers."
                        }
                    ],
                    "common_phrases": [
                        "accent tonique"
                    ]
                },
                {
                    "sense_id": "bd5dfff4-23ac-39ac-bb51-45c2f495aa50",
                    "sense_definition": "Intonation ou nuance de voix traduisant une émotion ou un sentiment particulier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a présenté ses excuses avec un <w>accent</w> de sincérité qui a convaincu tout le monde."
                        },
                        {
                            "text": "Dans sa voix perçait un <w>accent</w> de tristesse qu'elle ne parvenait pas à cacher."
                        }
                    ],
                    "synonyms": [
                        "inflexion"
                    ],
                    "common_phrases": [
                        "accent de sincérité",
                        "accent de vérité"
                    ]
                },
                {
                    "sense_id": "67e443ee-0826-395b-bb41-9975309add4e",
                    "sense_definition": "Tonalité générale ou allure qui confère un caractère ou une ambiance spécifique à une œuvre ou un discours.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce récit autobiographique prend parfois des <w>accents</w> tragiques qui bouleversent le lecteur."
                        },
                        {
                            "text": "Son discours électoral comportait des <w>accents</w> résolument patriotiques."
                        }
                    ],
                    "common_phrases": [
                        "accents dramatiques",
                        "accents lyriques"
                    ]
                },
                {
                    "sense_id": "4dfb36b2-81dc-3516-8eda-fbfdc4894399",
                    "sense_definition": "Sonorité vive ou émission d'un son musical ou vocal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On entendait au loin les <w>accents</w> cuivrés d'une fanfare de village."
                        },
                        {
                            "text": "Les premiers <w>accents</w> de l'orgue remplirent toute la nef de la cathédrale."
