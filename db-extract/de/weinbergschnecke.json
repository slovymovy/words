                "senses": [
                    {
                        "sense_id": "c434587c-d6de-3c32-8b44-284a4ad0bce1",
                        "entry_id": "ffb36e09-becb-3c09-bb7e-102f25fe5232",
                        "glosses": [
                            "eine essbare Schnecke mit Lungenatmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cce9bb6b-3774-40c6-a01b-8f11f70ad690",
                                "sense_id": "c434587c-d6de-3c32-8b44-284a4ad0bce1",
                                "text": "Manchen Leuten gilt die Weinbergschnecke als eine erstklassige Delikatesse."
                            },
                            {
                                "example_id": "d3afeba1-0ced-4b83-acef-b2a161b9fa83",
                                "sense_id": "c434587c-d6de-3c32-8b44-284a4ad0bce1",
                                "text": "„Papa bestellte sechs Weinbergschnecken und das geschmorte Rindfleisch nach Art Karls des Großen.“"
                            },
                            {
                                "example_id": "630e3085-3974-4e1e-bd58-0178cf97d405",
                                "sense_id": "c434587c-d6de-3c32-8b44-284a4ad0bce1",
                                "text": "„Auch hier hatte ich schnell die in meinen Augen herrlichsten Weinbergschnecken entdeckt, eingesammelt und stolz in die Küche gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
