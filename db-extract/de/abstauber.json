                "senses": [
                    {
                        "sense_id": "c6fcca85-591d-3b4e-a7f0-19cea384bc0c",
                        "entry_id": "bcc32d45-2163-37c2-980a-7a9da4d33699",
                        "glosses": [
                            "Spieler, in der Regel ein Stürmer, der vorwiegend seine Tore dadurch erzielt, dass er nach entscheidenden Vorarbeiten anderer Mitspieler oder durch Unachtsamkeiten der gegnerischen Abwehr den Ball einfach und ohne Mühe ins leere Tor einschiebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6397c6f2-d164-4743-b1f2-ea81f876c7eb",
                                "sense_id": "c6fcca85-591d-3b4e-a7f0-19cea384bc0c",
                                "text": "Gerd Müller war wohl weltweit einer der genialsten Abstauber."
                            },
                            {
                                "example_id": "708b6bcb-c2db-4646-a81c-bdcb039a1e27",
                                "sense_id": "c6fcca85-591d-3b4e-a7f0-19cea384bc0c",
                                "text": "Abstauber sind Spieler, die sich durch eine hervorragende Fähigkeit zur Antizipation von Spielgeschehen auszeichnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9bc9903-7bf9-30c8-8997-9f249945d593",
                        "entry_id": "bcc32d45-2163-37c2-980a-7a9da4d33699",
                        "glosses": [
                            "Tor, das nach dem unter [1] beschriebenen Verfahren zustande gekommen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9602e9d4-5343-4fe0-bfdb-0273152e7764",
                                "sense_id": "e9bc9903-7bf9-30c8-8997-9f249945d593",
                                "text": "Wir haben nur durch diesen dummen Abstauber verloren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3705e0f9-dac7-3423-b7e7-c15c1fe6c3a1",
                        "entry_id": "bcc32d45-2163-37c2-980a-7a9da4d33699",
                        "glosses": [
                            "jemand, der ohne eigenen Beitrag Nutzen zieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e54a724-2b2a-4ce3-a214-3a2a897bc62c",
                                "sense_id": "3705e0f9-dac7-3423-b7e7-c15c1fe6c3a1",
                                "text": "„Und von Anfang an gab es die Abstauber.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "fc95fcde-4244-3604-8619-b555bf9e52b2",
                        "entry_id": "bcc32d45-2163-37c2-980a-7a9da4d33699",
                        "glosses": [
                            "handliches Gerät mit weichen, dünnen Borsten, Federn oder dergleichen zum Entfernen von Staub oder Schmutz, häufig an schwer erreichbaren Stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17cc1eff-20a4-48d1-87eb-2754d7b3c2d6",
                                "sense_id": "fc95fcde-4244-3604-8619-b555bf9e52b2",
                                "text": "„Wände und Zimmerdecke mögen alle 4-6 Wochen mit dem Abstauber abgestäubt werden.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
