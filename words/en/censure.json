        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41263cea-a5b1-3fba-b331-00aa24f42d7b",
                    "sense_definition": "To express strong disapproval or harsh criticism of someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people were quick to <w>censure</w> the company for its poor environmental record."
                        },
                        {
                            "text": "It is not our place to <w>censure</w> others for choices that do not affect us."
                        }
                    ],
                    "synonyms": [
                        "criticize",
                        "condemn",
                        "rebuke"
                    ],
                    "antonyms": [
                        "praise",
                        "commend"
                    ],
