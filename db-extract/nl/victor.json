                                    {
                                        "sense_id": "aca3626f-aad2-383d-a8a9-8349293d42f4",
                                        "entry_id": "a6d4c711-829b-3669-bc6c-54d593d5ee13",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40a5eb17-a048-45ee-b37d-dcb2433b3b26",
                                                "sense_id": "aca3626f-aad2-383d-a8a9-8349293d42f4",
                                                "text": "Ce vendredi 12 août, le joueurs concernés par la tournée du XV de France au Japon étaient tous présents, mis à part Thomas Lavault et Matthias Haddad-Victor, respectivement opérés de la cheville et du genou, et l’Argentin Joel Sclavi, retenu par le Rugby Championship."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Victor",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72b0e017-79a0-3751-96b5-14a6252fa2be",
                                        "entry_id": "2084c4ce-7d2c-351b-9f60-e09f8345fba8",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05fd9734-1ce5-4784-adaf-a3c0fd063daa",
                                                "sense_id": "72b0e017-79a0-3751-96b5-14a6252fa2be",
                                                "text": "Ils sont tous là-bas dans la maison, à cause de la noce du cousin Victor."
                                            },
                                            {
                                                "example_id": "b2b90db7-6989-4319-b44f-3cf2bd9c293e",
                                                "sense_id": "72b0e017-79a0-3751-96b5-14a6252fa2be",
                                                "text": "C’est dans cet endroit que Victor se réfugiait pour échapper aux criailleries de sa femme et lire à la lueur de la bougie des ouvrages sur l’Orient."
                                            },
                                            {
                                                "example_id": "97280793-1426-41ef-adff-fa150bca47db",
                                                "sense_id": "72b0e017-79a0-3751-96b5-14a6252fa2be",
                                                "text": "T’es pas dingue, Victor ? Je souhaite de mal à personne."
                                            },
                                            {
                                                "example_id": "ead0668d-fef8-47d3-a144-df577932a4f9",
                                                "sense_id": "72b0e017-79a0-3751-96b5-14a6252fa2be",
                                                "text": "Le Français Victor Koretzky s’est classé quatrième."
                                            }
                                        ]
                                    }
                                ]
                            }
