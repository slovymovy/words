                    {
                        "sense_id": "080fad3f-8172-3c3c-9b2a-25371b995379",
                        "entry_id": "7b91335b-e257-3e72-a3a3-e043a474e7c1",
                        "glosses": [
                            "Nom propre désignant une voie de communication."
                        ],
                        "tags": [
                            "Didactique",
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "f764240a-f313-40ee-b97e-4956fb7349c1",
                                "sense_id": "080fad3f-8172-3c3c-9b2a-25371b995379",
                                "text": "Un odonyme est un nom de lieu qui se réfère à une voie de communication (rue, place, avenue…)."
                            },
                            {
                                "example_id": "d31b4eda-5b3c-499c-b1f3-6c83502e4f48",
                                "sense_id": "080fad3f-8172-3c3c-9b2a-25371b995379",
                                "text": "Des exemples d’odonymes sont rue Victor-Hugo, Downing Street, place de la Concorde, Chemin du Roy, Autoroute Jean-Lesage, La Transcanadienne, Boulevard René-Lévesque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fd760e2-0244-49c0-a84a-c7dca800f736",
                        "source_entry_id": "7b91335b-e257-3e72-a3a3-e043a474e7c1",
                        "source_sense_id": "080fad3f-8172-3c3c-9b2a-25371b995379",
                        "target_lang_word": "Straßenname",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Straßenname",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f06b0fa2-56d6-3c53-9f81-08172abdc59d",
                                        "entry_id": "d0973589-1faa-3b0e-b62c-0fb8ee3d2b06",
                                        "glosses": [
                                            "Eigenname für eine Straße, die der Identifizierung baulich angelegter, befestigter Verkehrsverbindungen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20491a1d-9272-4faa-8caf-9673152f2429",
                                                "sense_id": "f06b0fa2-56d6-3c53-9f81-08172abdc59d",
                                                "text": "„Der Autor berät die Stadt Regensburg, wenn es um Bindestriche in Straßennamen geht, und das Institut Papst Benedikt XVI. bei der Herausgabe der Schriften Josef Razingers.“"
                                            },
                                            {
                                                "example_id": "c2e1cc63-1d71-4fbb-ab19-2998f2b97a48",
                                                "sense_id": "f06b0fa2-56d6-3c53-9f81-08172abdc59d",
                                                "text": "„In allem waren diese neuen Siedlungen einheitlich: in der Anlage des Straßennetzes, der Architektur der Häuser, sogar in den Straßennamen.“"
                                            },
                                            {
                                                "example_id": "92be8e0c-deb6-4170-9492-355a0ea43014",
                                                "sense_id": "f06b0fa2-56d6-3c53-9f81-08172abdc59d",
                                                "text": "„Noch etwas fiel ihm auf: Die Straßennamen oder Viertel klangen zum Teil gar nicht englisch.“"
                                            },
                                            {
                                                "example_id": "b90eeed3-f7a5-47d5-96b4-7543735ddaf2",
                                                "sense_id": "f06b0fa2-56d6-3c53-9f81-08172abdc59d",
                                                "text": "„Als meine Mutter diesen Straßennamen hörte, wurde sie hektisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
