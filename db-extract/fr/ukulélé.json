                                "target_senses": [
                                    {
                                        "sense_id": "93471203-a10e-338c-975d-6f05bc8c4d3b",
                                        "entry_id": "8eb09dee-bcf3-3a08-871b-92ab5dcd5617",
                                        "glosses": [
                                            "ein Zupfinstrument, das an eine kleine Gitarre erinnert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb439a22-6dc6-47dc-8bea-d42de86946cf",
                                                "sense_id": "93471203-a10e-338c-975d-6f05bc8c4d3b",
                                                "text": "In den letzten Jahren ist die Beliebtheit der Ukulele gestiegen."
                                            },
                                            {
                                                "example_id": "dfd8a61f-f71f-4039-8f74-4814b7f9ac26",
                                                "sense_id": "93471203-a10e-338c-975d-6f05bc8c4d3b",
                                                "text": "„Manchmal hockte ein Straßenmusiker da und zupfte die Ukulele.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
