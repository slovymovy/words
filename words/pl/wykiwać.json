            "senses": [
                {
                    "sense_id": "bc346398-933a-3e6e-9f54-e783e51a2d25",
                    "sense_definition": "oszukać kogoś, postępując podstępnie lub sprytnie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "oszustwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie udało mu się <w>wykiwać</w> doświadczonego sprzedawcy podczas negocjacji cenowych.",
                            "target_lang_translations": {
                                "ru": "Ему не удалось <w>обвести вокруг пальца</w> опытного продавца во время ценовых переговоров."
                            }
                        },
                        {
                            "text": "Kolega próbował <w>wykiwać</w> nas na pieniądze, ale szybko odkryliśmy jego plan.",
                            "target_lang_translations": {
                                "ru": "Коллега пытался <w>надуть</w> нас на деньги, но мы быстро раскрыли его план."
                            }
                        }
                    ],
                    "synonyms": [
                        "oszukać",
                        "nabrać",
                        "przechytrzyć",
                        "okpić"
                    ],
                    "common_phrases": [
                        "wykiwać na pieniądze",
                        "dać się wykiwać"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w mowie potocznej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "обмануть кого-либо, действуя хитро или коварно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обвести вокруг пальца",
                                "target_lang_sense_clarification": "идиоматическое выражение, означающее ловко обмануть"
                            },
                            {
                                "target_lang_word": "перехитрить",
                                "target_lang_sense_clarification": "оказаться хитрее кого-либо, обмануть в результате хитрости"
                            },
                            {
                                "target_lang_word": "надуть",
                                "target_lang_sense_clarification": "разговорный вариант, означающий обмануть, часто в денежных делах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "643c3f23-42df-39bf-ac0d-9f7dc34bd876",
                    "sense_definition": "w sporcie: przeprowadzić piłkę obok przeciwnika za pomocą zwodów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Napastnik z łatwością <w>wykiwał</w> obrońcę i oddał celny strzał na bramkę.",
                            "target_lang_translations": {
                                "ru": "Нападающий с легкостью <w>обыграл</w> защитника и нанес точный удар по воротам."
                            }
                        },
                        {
                            "text": "Młody zawodnik potrafi <w>wykiwać</w> nawet trzech rywali w jednej akcji.",
                            "target_lang_translations": {
                                "ru": "Молодой игрок способен <w>обвести</w> даже трех соперников в одном эпизоде."
                            }
                        }
                    ],
                    "synonyms": [
                        "ominąć",
                        "przejść"
                    ],
                    "common_phrases": [
                        "wykiwać obrońcę",
                        "wykiwać bramkarza"
                    ],
                    "target_lang_definitions": {
                        "ru": "в спорте: обыграть соперника с помощью финтов или обманных движений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обыграть",
                                "target_lang_sense_clarification": "в спортивном контексте: пройти соперника с мячом"
                            },
                            {
                                "target_lang_word": "обвести",
                                "target_lang_sense_clarification": "пройти мимо соперника, контролируя мяч"
                            }
                        ]
                    }
                }
            ]
        }
    ]
