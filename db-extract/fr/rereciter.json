                "senses": [
                    {
                        "sense_id": "25ff2ed7-443e-3a6a-8413-3d00d0a8ab23",
                        "entry_id": "a52e61c3-28f9-3d4c-94ee-c1bbbf25ede3",
                        "glosses": [
                            "Reciter de nouveau ; reciter encore une fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26b840cc-ecbb-40c0-8809-3dd05d1e9f75",
                                "sense_id": "25ff2ed7-443e-3a6a-8413-3d00d0a8ab23",
                                "text": "Ayant été cité et recité, je me permets donc à nouveau la répétition de me rereciter afin d’ouvrir votre âme sur la lumière de mon paradis informatique qu’est l'open source dans les Systèmes d’Exploitation plus communément dénommés sous l’acronyme d'OS."
                            },
                            {
                                "example_id": "f9424d7a-d8ce-4ffa-a768-328579462c8d",
                                "sense_id": "25ff2ed7-443e-3a6a-8413-3d00d0a8ab23",
                                "text": "Je ne vais pas rereciter les messages comme je l’ai fait une page plus tôt, mais je ne vois toujours pas où vous avez été incendiés ?"
                            }
                        ]
                    }
