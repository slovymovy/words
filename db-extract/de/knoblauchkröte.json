                ],
                "senses": [
                    {
                        "sense_id": "025a8e42-5a9b-331d-a0cd-8ca2152022e4",
                        "entry_id": "536d477d-1c1b-33eb-8ec5-3d80237114f4",
                        "glosses": [
                            "Froschlurch aus der Gattung der Europäischen Schaufelkröten innerhalb der Familie der Krötenfrösche (Pelobatideae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24160f6d-0302-42a4-b828-ee1d5ae41d81",
                                "sense_id": "025a8e42-5a9b-331d-a0cd-8ca2152022e4",
                                "text": "„Die Knoblauchkröte (Pelobates fuscus) gilt in Nordrhein-Westfalen als vom Aussterben bedroht.“"
                            },
                            {
                                "example_id": "21d982b7-7364-4992-922a-df78f629c704",
                                "sense_id": "025a8e42-5a9b-331d-a0cd-8ca2152022e4",
                                "text": "„Obwohl sie zu den häufigsten Amphibienarten Berlins gehört, haben viele Leute noch nie eine Knoblauchkröte gesehen.“"
                            },
                            {
                                "example_id": "3a694c00-e025-4cdb-b8e9-35abb5cea593",
                                "sense_id": "025a8e42-5a9b-331d-a0cd-8ca2152022e4",
                                "text": "„In optimalen Lebensräumen können manchmal Populationen von mehreren hundert oder sogar über tausend Knoblauchkröten nachgewiesen werden“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
