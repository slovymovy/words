                "senses": [
                    {
                        "sense_id": "a3926bdb-eb0d-352c-b526-33a0be56ba79",
                        "entry_id": "d073f3d1-a4fa-3de4-92a5-ab51c0bdb916",
                        "glosses": [
                            "eine Strecke, die durch ein Gebiet ohne Wasser führt"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [
                            {
                                "example_id": "bd9a5b01-6358-4a8e-aa62-f9ac57231cdd",
                                "sense_id": "a3926bdb-eb0d-352c-b526-33a0be56ba79",
                                "text": "Der einzige Weg durch diese Wüste ist eine Durststrecke."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "caee1fe9-8ace-390a-a0e2-3ab5202c3959",
                        "entry_id": "d073f3d1-a4fa-3de4-92a5-ab51c0bdb916",
                        "glosses": [
                            "eine Zeitspanne, in der jemand Einschränkungen und Entbehrungen auf sich nehmen muss"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c636e638-189d-4214-878b-63a754d5d4e6",
                                "sense_id": "caee1fe9-8ace-390a-a0e2-3ab5202c3959",
                                "text": "Nach dem heutigen Sieg endet für den Profiboxer eine lange Durststrecke."
                            },
                            {
                                "example_id": "e75f28e0-9453-4c69-872f-033176c5bfc0",
                                "sense_id": "caee1fe9-8ace-390a-a0e2-3ab5202c3959",
                                "text": "„Die 31-jährige Weltmeisterin feierte am Samstag in Bad Kleinkirchheim ihren ersten Abfahrtssieg im Weltcup und beendete auf der ‚Franz Klammer‘-Piste die dreijährige Durststrecke der ÖSV-Damen in der Königsdisziplin.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
