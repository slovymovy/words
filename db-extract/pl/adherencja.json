                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce7b9b2c-ed2b-4048-86e0-60cdd5ef3d78",
                        "source_entry_id": "a7522ae3-65d4-396f-8406-c3a45acbdee7",
                        "source_sense_id": "b0bd6854-f84a-3884-908f-c5bcec2f6946",
                        "source_sense_description": "Befürwortung, Unterstützung",
                        "target_lang_word": "Befürwortung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befürwortung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e6ac4d2-5f36-3045-aca1-8c166ba354fc",
                                        "entry_id": "64eba0b4-c6a4-328b-8f4e-9eb4e7b556da",
                                        "glosses": [
                                            "Einstellung/Haltung, etwas zu unterstützen, sein Wort für etwas einsetzen zu wollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3491589-a0c1-4412-aef6-cebea6714e1d",
                                                "sense_id": "2e6ac4d2-5f36-3045-aca1-8c166ba354fc",
                                                "text": "„Die Ergebnisse lassen vermuten, dass Offenheit für Neues und Verträglichkeit einen positiven Zusammenhang mit der Befürwortung von Chancengleichheit aufweisen.“"
                                            },
                                            {
                                                "example_id": "457bd1e7-ecfa-47f7-81eb-267a09da6864",
                                                "sense_id": "2e6ac4d2-5f36-3045-aca1-8c166ba354fc",
                                                "text": "„Besonders stark gestiegen ist die Befürwortung eines Rauchverbots im Pkw in Anwesenheit von Kindern und Jugendlichen.“"
                                            },
                                            {
                                                "example_id": "4898dc10-6065-4430-b5f3-8e85ebf403f8",
                                                "sense_id": "2e6ac4d2-5f36-3045-aca1-8c166ba354fc",
                                                "text": "„Auf seiten der Geschäftsführer steht bei der Befürwortung von langfristigen Verträgen eindeutig die Beurteilung der positiven Wirkungen dieses Steuerungsinstruments im Vordergrund.“"
                                            },
                                            {
                                                "example_id": "e99b8213-6775-4738-868f-fd727417d229",
                                                "sense_id": "2e6ac4d2-5f36-3045-aca1-8c166ba354fc",
                                                "text": "„Es scheint bei manchen Altersgruppen in Westdeutschland eine deutliche Zunahme der Befürwortung legaler Demonstrationen zu geben und eine tendenzielle Zunahme der Befürwortung von Verkehrsblockaden im Verlauf von Demonstrationen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a6a48a2-40bd-4f24-b9a2-b037cd805fb9",
                        "source_entry_id": "a7522ae3-65d4-396f-8406-c3a45acbdee7",
                        "source_sense_id": "b0bd6854-f84a-3884-908f-c5bcec2f6946",
                        "source_sense_description": "Befürwortung, Unterstützung",
                        "target_lang_word": "Unterstützung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterstützung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                        "entry_id": "0117c5ad-d7fb-30ba-8e29-bff4cdeea477",
                                        "glosses": [
                                            "Hilfe oder Mithilfe von jemandem (oder im übertragenen Sinne auch von etwas)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb827330-0572-46d5-862b-5e18b621df36",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "Wir rechnen mit Ihrer Unterstützung."
                                            },
                                            {
                                                "example_id": "6c1e7c91-d7ab-4eab-b2fa-54d9c0275b15",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "„Vermutlich wäre es nicht so gekommen, hätte es nicht die vielen Zeitungsberichte gegeben, die Empörung im ganzen Land über den Tod des jungen Mannes und die Unterstützung der anderen Rechtswissenschaftler.“"
                                            },
                                            {
                                                "example_id": "a69e1f37-ebd3-45d6-8a3b-846400e34637",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "„Rachel und Simon stellten ihre Unterstützung und ihre positive Einstellung zu meinem Afrika-Trip zur Schau und ich tat alles, um mich selbstbewusst und optimistisch zu zeigen.“"
                                            },
                                            {
                                                "example_id": "8a983ab6-d519-49a5-8eba-1038df068488",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "„Dem Exilpräsidenten war bis in das Jahr 1942 hinein nicht klar, wie viele Deutsche man abschieben könne, denn er wusste natürlich, dass die Tschechen die Unterstützung der Großmächte, jedenfalls ihre Duldung, für die Vertreibung brauchten.“"
                                            },
                                            {
                                                "example_id": "dd6c8636-9068-4d35-a94c-f0e4e2b88fc1",
                                                "sense_id": "56c307ea-9212-3218-af96-ec1db43f216b",
                                                "text": "„Da verweigert der deutschnationale und reiche jüdische Emigrant Oppenheim dem um Unterstützung bittenden Ludwig Kern jede Hilfe, und der Klinikarzt Beer wird für ihn und seine Geliebte zum uneigennützigen Lebensretter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8049e61b-d5d0-3792-9a7e-4fee1c26d15c",
                                        "entry_id": "0117c5ad-d7fb-30ba-8e29-bff4cdeea477",
                                        "glosses": [
                                            "technische Stütze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84ca0dd5-f748-4914-ba31-0d1e7f7be3ed",
                                                "sense_id": "8049e61b-d5d0-3792-9a7e-4fee1c26d15c",
                                                "text": "Nach dem Erdbeben braucht das Gebäude eine Unterstützung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "84e7444b-6d6f-3470-b211-93921a382061",
                                        "entry_id": "0117c5ad-d7fb-30ba-8e29-bff4cdeea477",
                                        "glosses": [
                                            "Beihilfe vom Staat in Form von Geldzahlungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d886cb-a5a8-41d9-810a-427695783818",
                                                "sense_id": "84e7444b-6d6f-3470-b211-93921a382061",
                                                "text": "Er lebt nur von der Unterstützung."
                                            },
                                            {
                                                "example_id": "551c9816-619f-4440-a657-5d26c51f2c56",
                                                "sense_id": "84e7444b-6d6f-3470-b211-93921a382061",
                                                "text": "„Sie bekamen ihre finanzielle Unterstützung und fuhren gleich in den Supermarkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
