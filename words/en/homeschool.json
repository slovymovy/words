{
    "word_family": [
        "homeschooler",
        "homeschooling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "538ac373-0203-3f1f-a2de-032775e93a34",
                    "sense_definition": "To educate one's children at home rather than sending them to a conventional school",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>homeschool</w> their children to provide a more flexible schedule.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>обучать</w> своих детей <w>на дому</w>, чтобы обеспечить более гибкий график."
                            }
                        },
                        {
                            "text": "She <w>homeschools</w> the two oldest children while running her business from home.",
                            "target_lang_translations": {
                                "ru": "Она <w>учит дома</w> двоих старших детей, одновременно управляя бизнесом из дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "decide to homeschool",
                        "homeschool children"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обучать детей дома самостоятельно, а не отправлять их в обычную школу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обучать на дому",
                                "target_lang_sense_clarification": "детей школьного возраста"
                            },
                            {
                                "target_lang_word": "переводить на домашнее обучение",
                                "target_lang_sense_clarification": "выбирать семейное образование"
                            },
                            {
                                "target_lang_word": "учить дома",
                                "target_lang_sense_clarification": "самостоятельно давать образование"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f7d42f1-fc87-38a3-a7be-4badacd2a209",
                    "sense_definition": "A school conducted within a private home, typically run by parents or tutors",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They set up a structured daily routine for their <w>homeschool</w>.",
                            "target_lang_translations": {
                                "ru": "Они установили чёткий распорядок дня для своей <w>домашней школы</w>."
                            }
                        },
                        {
                            "text": "Several families in the neighborhood joined together to run a cooperative <w>homeschool</w>.",
                            "target_lang_translations": {
                                "ru": "Несколько семей по соседству объединились, чтобы создать совместную <w>семейную школу</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "homeschool curriculum",
                        "homeschool program"
                    ],
                    "target_lang_definitions": {
                        "ru": "Домашняя школа; образовательный процесс, организованный родителями или тьюторами дома"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "домашняя школа",
                                "target_lang_sense_clarification": "форма обучения на дому"
                            },
                            {
                                "target_lang_word": "семейная школа",
                                "target_lang_sense_clarification": "часто организованная несколькими семьями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}