                        "sense_id": "8f94cb18-8474-3696-b1b9-80cffbd82a9f",
                        "entry_id": "92e47e88-9ce8-3c2f-bce6-07344efc5553",
                        "glosses": [
                            "iemand met die slecht kan lopen omdat hij een mank been heeft"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "0f184e7f-2a2f-464e-bf48-62b410f6698d",
                                "sense_id": "8f94cb18-8474-3696-b1b9-80cffbd82a9f",
                                "text": "Kreeg vorige week een folder aangereikt van een firma in de buurt met daarin een uitnodiging voor een \"Demodag gezond slapen\". Nou doe ik dat bij voorkeur 's nachts en als het moet in een sterrenhotel met voorzieningen voor mankepoten."
                            },
                            {
                                "example_id": "a5ac708c-555e-4ce1-b722-985d62c850a7",
                                "sense_id": "8f94cb18-8474-3696-b1b9-80cffbd82a9f",
                                "text": "Want gelijke kansen en beoordelingen zijn niet vanzelfsprekend, weet de Twentse maar al te goed. \"Soms hoor je achter je rug mensen zeggen: kijk die mankepoot. Of je hoort ze lachen. Of je wordt nagestaard.\""
                            }
                        ]
                    }
