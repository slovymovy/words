                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9fdd15c-fe58-4ab2-9e00-73cb3f192745",
                                "sense_id": "151cef68-e10f-3e51-9716-adbc0dfc351a",
                                "text": "Weil das Alkoholmessgerät bei Peter 0,6 Promille anzeigte, ordnete die Polizei einen Bluttest an."
                            },
                            {
                                "example_id": "689826cb-1417-46f4-a5e7-6bfe74190867",
                                "sense_id": "151cef68-e10f-3e51-9716-adbc0dfc351a",
                                "text": "„Die Idee war bestechend und machte Elizabeth Holmes zur Milliardärin: einfache Bluttests mit nur einem Tropfen für jedermann zugänglich zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
