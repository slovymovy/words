                                    {
                                        "sense_id": "11d91654-6104-38cf-b85f-f320111f4ca7",
                                        "entry_id": "7ca614d0-8c72-3daa-951b-852745b18df7",
                                        "glosses": [
                                            "Hatred of sex workers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e545a5d-ba0a-4fba-9aa0-cb20799dc7c8",
                                                "sense_id": "11d91654-6104-38cf-b85f-f320111f4ca7",
                                                "text": "However, to stop there, ignoring the manner in which whorephobia articulates with patriarchy, heterosexism, and homophobia, is to elide and, in turn, to misunderstand the subtle similarities and differences in the experiences of sex workers."
                                            },
                                            {
                                                "example_id": "d451fde8-4392-4ab9-9619-dd6fa4149c8d",
                                                "sense_id": "11d91654-6104-38cf-b85f-f320111f4ca7",
                                                "text": "Accusations of “whorephobia” are increasingly used to silence and deter any criticism of the sex trade whatsoever."
                                            }
                                        ]
                                    }
                                ]
                            }
