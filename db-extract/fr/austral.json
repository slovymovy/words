                "senses": [
                    {
                        "sense_id": "345a4d3b-c096-3333-b7c0-68af231f3559",
                        "entry_id": "72c7c2db-d9e4-353d-b687-1868c98c2551",
                        "glosses": [
                            "Qui se situe du côté sud du globe terrestre, et plus spécialement qui se situe près du pôle Sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0158a471-a701-4526-a56f-ffa8262f777c",
                                "sense_id": "345a4d3b-c096-3333-b7c0-68af231f3559",
                                "text": "C’était l’été austral ; le jeudi 19 novembre, je passai exactement sous le soleil à midi par un ciel sans nuages, sur un océan sans rides."
                            },
                            {
                                "example_id": "48d20756-5449-42c2-83b9-71b7181f3fa6",
                                "sense_id": "345a4d3b-c096-3333-b7c0-68af231f3559",
                                "text": "L’hémisphère austral."
                            },
                            {
                                "example_id": "fb21ef69-8d8d-4c1c-b637-c367303badee",
                                "sense_id": "345a4d3b-c096-3333-b7c0-68af231f3559",
                                "text": "Les terres australes."
                            },
                            {
                                "example_id": "91220282-fa20-44ba-b60a-cfd0d4ef9ee1",
                                "sense_id": "345a4d3b-c096-3333-b7c0-68af231f3559",
                                "text": "Étant donné la position actuelle de Mars dans le cycle de précession orbitale, les hivers austraux sont plus longs que les hivers boréaux."
                            },
                            {
                                "example_id": "891031d9-36b6-44d3-b5ba-f79ad78fbb6b",
                                "sense_id": "345a4d3b-c096-3333-b7c0-68af231f3559",
                                "text": "Vous les connaissez comme moi, ces parages australs, où l’on trouve les grandes houles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdc5fafe-3d19-4445-8d54-fca4532899e8",
