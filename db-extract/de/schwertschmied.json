                "senses": [
                    {
                        "sense_id": "41a9cbb6-f499-3219-9ae0-eea06785bf79",
                        "entry_id": "e2d52823-cbfb-3b58-8eee-b23a7d66e2c4",
                        "glosses": [
                            "Schmied, der Schwerter anfertigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a65a32-d14a-47e4-9f0d-27d6ff9aaf7d",
                                "sense_id": "41a9cbb6-f499-3219-9ae0-eea06785bf79",
                                "text": "„In Japan gibt es noch immer einen Kult um die Schwertschmiede und ihre jahrhundertealte Kunst.“"
                            },
                            {
                                "example_id": "8887fa7b-9fb8-43ff-a839-1ba52bffbebf",
                                "sense_id": "41a9cbb6-f499-3219-9ae0-eea06785bf79",
                                "text": "„[Das River-Witham-Schwert] wurde wahrscheinlich von einem Schwertschmied im heutigen Deutschland hergestellt – und sie ist nicht die einzige derartige Blankwaffe.“"
                            },
                            {
                                "example_id": "400e4f4a-fda0-47e2-81a9-d588f347ccf0",
                                "sense_id": "41a9cbb6-f499-3219-9ae0-eea06785bf79",
                                "text": "„In China gab es einen Schwertschmied, der jedes Jahr sehr viele Schwerter schmiedete, die er aber nur sehr schlecht verkaufen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
