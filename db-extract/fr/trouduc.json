                                        "examples": [
                                            {
                                                "example_id": "9b94cd36-e88d-4247-8d17-fca45e6102a2",
                                                "sense_id": "d08d66dd-a722-3517-842a-07b70b3850cc",
                                                "text": "My former landlord was a world-class asshole. Fortunately my current landlord is an actual human being."
                                            },
                                            {
                                                "example_id": "d69d9665-4d26-4b33-ab57-cd5b74c5d739",
                                                "sense_id": "d08d66dd-a722-3517-842a-07b70b3850cc",
                                                "text": "He philosophised all day about Morandi, Klee, Miró and Picasso, and was such an asshole that he spelled \"cunt\" with a \"d\"."
                                            },
                                            {
                                                "example_id": "b5de761e-58a7-46f0-97a2-af14cc0c982f",
                                                "sense_id": "d08d66dd-a722-3517-842a-07b70b3850cc",
                                                "text": "They are the assholes for thinking they and their little crotch-spawn were special and exempt from the event guidelines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "301fffa8-a29c-352f-8833-7897c9ff1a5f",
                                        "entry_id": "63070978-44d5-3291-b060-30a86c5c5973",
                                        "glosses": [
                                            "Anything (especially a place) that is unpleasant or undesirable."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ffc30d-ab70-4f73-b630-c433676de05e",
                                                "sense_id": "301fffa8-a29c-352f-8833-7897c9ff1a5f",
                                                "text": "Welcome to the Northeast, the asshole of America."
                                            },
                                            {
                                                "example_id": "c05f5f58-8b39-41e7-b9a7-37342502fea2",
                                                "sense_id": "301fffa8-a29c-352f-8833-7897c9ff1a5f",
                                                "text": "You oughta have better sense than to trust anyone with anything in this asshole place."
                                            },
                                            {
                                                "example_id": "aff5bdea-c700-4abb-aa59-a1386e1a99b7",
                                                "sense_id": "301fffa8-a29c-352f-8833-7897c9ff1a5f",
                                                "text": "... but when he started bugging the bartender to shut the asshole TV off because he wanted to have a serious discussion..."
                                            }
