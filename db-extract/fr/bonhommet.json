                                "target_senses": [
                                    {
                                        "sense_id": "24a94069-be04-3d76-ba50-72b5c9726644",
                                        "entry_id": "ba30d6bc-1b16-30c4-a60d-5ee0229158aa",
                                        "glosses": [
                                            "An ordinary man of no particular fame or accomplishment; especially, everyone who is an underdog by the nature of not being rich or powerful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9656667-cbb7-438f-aa2a-91301630cab9",
                                                "sense_id": "24a94069-be04-3d76-ba50-72b5c9726644",
                                                "text": "Near-synonym: common man"
                                            },
                                            {
                                                "example_id": "40144c13-b4c3-4de4-9c0a-c86574784dd7",
                                                "sense_id": "24a94069-be04-3d76-ba50-72b5c9726644",
                                                "text": "Who's going to look out for the little man as insurers increasingly weasel out of paying claims?"
                                            },
                                            {
                                                "example_id": "b3d79463-54a8-4c9a-9800-c543f383862f",
                                                "sense_id": "24a94069-be04-3d76-ba50-72b5c9726644",
                                                "text": "Well Kansas is for the farmer\nWe stand behind the little man\nAnd we need a firehouse in Topeka\nSo help us if you can"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2de3576-633b-3073-bac6-7d5ec5d2c6c9",
                                        "entry_id": "ba30d6bc-1b16-30c4-a60d-5ee0229158aa",
                                        "glosses": [
                                            "A young boy."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "endearing",
                                            "term-of-address"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b67e66ae-3ef3-4ae9-b32f-39e112fe84a6",
                                                "sense_id": "b2de3576-633b-3073-bac6-7d5ec5d2c6c9",
                                                "text": "And how are you, my little man?"
                                            },
                                            {
                                                "example_id": "55c72b19-b2d7-4946-a469-9336e3c9fb1a",
                                                "sense_id": "b2de3576-633b-3073-bac6-7d5ec5d2c6c9",
                                                "text": "Little man here is going to pour the milk himself. Watch how well he does it!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2bd156b-8403-3cea-840b-cf3635c30dfd",
                                        "entry_id": "ba30d6bc-1b16-30c4-a60d-5ee0229158aa",
                                        "glosses": [
                                            "A man with dwarfism, or short stature resulting from a medical condition."
