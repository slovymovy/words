                "senses": [
                    {
                        "sense_id": "dbc206bf-e818-3107-baae-2671514b2938",
                        "entry_id": "03d33bea-2a00-3808-92a2-86ed91942fdb",
                        "glosses": [
                            "Grand dinosaure herbivore du crétacé inférieur du sous-ordre des ornitischiens et de l’infra-ordre des ornithopodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbaa1255-638a-4115-90fe-20b4d24b82a7",
                                "sense_id": "dbc206bf-e818-3107-baae-2671514b2938",
                                "text": "En fait, j’y suis resté le temps de découvrir que l’iguanodon n’était pas un animal de boudoir, sa queue balancier ravage l’alentour au moindre mouvement!"
                            },
                            {
                                "example_id": "b15b5f54-8896-48ff-8e72-6ae8519e9030",
                                "sense_id": "dbc206bf-e818-3107-baae-2671514b2938",
                                "text": "Parmi les autres véhicules, le pick-up se distinguait du troupeau comme un animal issu des âges préhistoriques fascinant immédiatement les quelques gamins embarqués, yeux grands ouverts, attirés par cette chose ferrailleuse, imposante comme une armure d’iguanodon agrémentée d’amulettes en plastoc."
                            }
                        ]
                    }
                ],
