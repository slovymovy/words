                "senses": [
                    {
                        "sense_id": "47e98d2c-91c9-3c99-9e0b-b1ae40752e99",
                        "entry_id": "961f20ab-53b8-3a47-97a3-46a8c19c6555",
                        "glosses": [
                            "der fünfte Verwaltungsbezirk von Berlin (Deutschland)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f3170d9-acad-4d12-9a76-0e960cdc46b5",
                                "sense_id": "47e98d2c-91c9-3c99-9e0b-b1ae40752e99",
                                "text": "Spandau befindet sich an beiden Ufern der Havel."
                            },
                            {
                                "example_id": "6ed5ef56-e16a-4aac-a3d2-08f2e89d9724",
                                "sense_id": "47e98d2c-91c9-3c99-9e0b-b1ae40752e99",
                                "text": "„In Teilen von Neukölln, Spandau und Lichtenberg trieben rivalisierende Banden und Bürgerwehren ihr Unwesen, weil der Staat weder die Versorgung der Bevölkerung gewährleisten noch deren Sicherheit garantieren konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83396d41-b46b-349f-a3db-6e5487b2db91",
                        "entry_id": "961f20ab-53b8-3a47-97a3-46a8c19c6555",
                        "glosses": [
                            "Berlin-Spandau, der namensgebende Ortsteil des Stadtbezirkes Spandau^([1])"
                        ],
                        "tags": [
                            "kurz"
                        ],
                        "examples": [
                            {
                                "example_id": "3a180a4d-3142-4609-82b6-b4e9f94f98eb",
                                "sense_id": "83396d41-b46b-349f-a3db-6e5487b2db91",
                                "text": "Der Ortsteil Spandau repräsentiert den Ortskern des ehemaligen Stadtkreises Spandau, der 1920 nach Groß-Berlin eingemeindet wurde."
                            }
                        ],
                        "sense_index_json": "\"2\""
