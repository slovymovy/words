                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ca79e3f-9738-4081-b60e-0b2c1dfa4e05",
                                                "sense_id": "9f64ac44-0038-38de-a3bf-c8d3c280f024",
                                                "text": "La propuesta de ley polarizó al congreso, con un sector en contra y otro a favor"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b812ef9f-c68d-3144-930a-1a9d5d899b2c",
                                        "entry_id": "8a8185c7-0bf2-36eb-9670-5c8b37e36768",
                                        "glosses": [
                                            "Enfocar mucho las emociones o el ánimo en algo, generalmente omitiendo otras cosas."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e02963fa-79ac-44a8-b443-0424ca2ee2e3",
                                                "sense_id": "b812ef9f-c68d-3144-930a-1a9d5d899b2c",
                                                "text": "—¿Qué opinas? ¿Retomo mi relación o no?\n—En vez de estar pensando estupideces, polarízate en las clases de matemáticas; estás muy mal en este curso.\n—¡Ves! Por eso no quiero contarte nada; solo me criticas o me ignoras.\n—Pero lo hago porque te quiero.\n—¡Jódete! Para la próxima no te voy a decir nada."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
