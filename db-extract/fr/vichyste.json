                    {
                        "sense_id": "df23ee1a-8248-3e87-9aed-a4ef78bb91ab",
                        "entry_id": "82713e68-877f-3070-95e7-ee4a0f397b2e",
                        "glosses": [
                            "Relatif au régime de Vichy (1940–44) ou à ses partisans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "753e869e-dca7-4baf-9e1a-b3c858c5eb38",
                                "sense_id": "df23ee1a-8248-3e87-9aed-a4ef78bb91ab",
                                "text": "Et pourtant, il souligne lui-même que la politique d’expulsion des immigrés illégaux ne peut être comparée à un statut des Juifs ou à une loi vichyste."
                            }
                        ]
                    }
                ],
