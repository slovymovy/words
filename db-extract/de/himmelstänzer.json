                        "examples": [
                            {
                                "example_id": "5edef1a2-322c-4082-af69-62f9403cd4db",
                                "sense_id": "180baaa6-b282-3ba0-b7a2-7fd78c857f61",
                                "text": "Ein Schwarm Möwen erhebt sich in die Luft, die Schatten huschen über Macs Schultern wie Himmelstänzer. Ich blicke nach oben, sehe zu, wie die Vögel immer höher und höher kreisen, bis sie ganz klein sind, so klein, dass sie Aschepartikeln ähneln, die vom Wind davongetragen werden."
                            }
                        ]
                    }
