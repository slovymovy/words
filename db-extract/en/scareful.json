                        "examples": [
                            {
                                "example_id": "0b93e5fe-63a2-4aa2-8b85-9359f4de9b8f",
                                "sense_id": "64dfaf0d-ed1d-3e3b-b4a8-c0f3e2efd2d9",
                                "text": "‘Twas sort of scareful, that midnight ride;"
                            },
                            {
                                "example_id": "08755fe7-9cd1-46db-ac24-b488b950067b",
                                "sense_id": "64dfaf0d-ed1d-3e3b-b4a8-c0f3e2efd2d9",
                                "text": "“Do you want the neighbors to hear us talkin' about the doctor's gettin' married ?” / “No, but you are so scareful.” / “Scareful or not scareful, I shouldn’t be surprised if he’d get married some day.”"
                            },
                            {
                                "example_id": "dfc510aa-9ea3-4e74-a96f-68db12a7837b",
                                "sense_id": "64dfaf0d-ed1d-3e3b-b4a8-c0f3e2efd2d9",
                                "text": "Sometimes she would tell of the old samurai and their dark deeds of revenge, of attacks on castles, and fights in the moats, and the imaginary clashing of swords and shouts of men would get so real to June that he would say: \"I don't want any more scareful ones tonight. Please tell me about the little mosquito boy.\""
                            },
                            {
                                "example_id": "cf4a04d6-a2ef-4b99-8a0d-63e280ec5912",
                                "sense_id": "64dfaf0d-ed1d-3e3b-b4a8-c0f3e2efd2d9",
                                "text": "“The Chime Child, she got to be grown,” said Tiddy Rex. “She got herself a job too scareful for brats.”"
                            }
                        ]
                    }
