                "senses": [
                    {
                        "sense_id": "3246f926-4de1-356b-80bc-dff12466c333",
                        "entry_id": "0903f315-ed4b-3391-9af4-3bf2b12e7e86",
                        "glosses": [
                            "een half verharde weg met kiezelstenen als toplaag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b28d6560-19c6-40d8-a370-2b0e0bf852b7",
                                "sense_id": "3246f926-4de1-356b-80bc-dff12466c333",
                                "text": "‘Op een kwaaie dag had de AVRO het grindpad, het tuinhek en de deurbel kapot. En Robert Paul was niet komen opdagen.’ Zelden is het hoorspel treffender omschreven dan cabaretier Herman Finkers het deed in een van zijn voorstellingen. Hoorspel, dat is een eindeloos traag verhaal, gemaakt in een studio vol opgewonden stemartiesten en knechtjes die al stampend, piepend en krakend voor het bijpassende geluidsdecor zorgen."
                            },
                            {
                                "example_id": "c8ee8893-b578-451f-9d8b-394878384903",
                                "sense_id": "3246f926-4de1-356b-80bc-dff12466c333",
                                "text": "De oprijlaan naar de woning van Ina Hummel op de Noetselerberg is versierd met een Nederlandse en Canadese vlag en boven het grindpad hangt een spandoek met ‘Welkom to Hummel-home’."
                            },
                            {
                                "example_id": "4ce83a93-44d9-456b-9935-65414ad75e81",
                                "sense_id": "3246f926-4de1-356b-80bc-dff12466c333",
                                "text": "De derde rit was vooraf omschreven als een koninginnenrit en de eerste col (Cottonwood Pass) voerde het peloton naar een hoogte van liefst 3696 meter en op sommige gedeelten moesten de coureurs over een grindpad fietsen."
                            },
                            {
                                "example_id": "b053d19c-3410-4439-a506-596b112afe4b",
                                "sense_id": "3246f926-4de1-356b-80bc-dff12466c333",
                                "text": "Wandelaars wijken van het grindpad af. Fietsers remmen af en rijden stapvoets verder. Ze stoppen voor de 14 kunstwerken die langs fietssnelweg 35 opdoemen aan de waterkant van Kristalbad."
                            }
                        ]
                    }
