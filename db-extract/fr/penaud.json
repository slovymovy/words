                "senses": [
                    {
                        "sense_id": "fd9bd0e9-62bd-3e9f-b913-b37ad77b428b",
                        "entry_id": "48c611dc-9d73-3a78-96ea-6ec9b2c42358",
                        "glosses": [
                            "Qui est embarrassé, honteux, décontenancé par le fait d’une déconvenue ou d’une déception."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d02055f2-be23-44f2-9389-4158cc356c19",
                                "sense_id": "fd9bd0e9-62bd-3e9f-b913-b37ad77b428b",
                                "text": "Le caporal, tout penaud, dut se résigner, et la marche du détachement, un instant interrompue, fut reprise aussitôt."
                            },
                            {
                                "example_id": "14f7e708-20ca-43f1-bca7-7e10345cdbc2",
                                "sense_id": "fd9bd0e9-62bd-3e9f-b913-b37ad77b428b",
                                "text": "Trois heures après, Boisvert reparut tout penaud, avec une paire de souliers, mais sans mouton."
                            },
                            {
                                "example_id": "77bd56c3-c4fe-4b06-9346-f24eda0b351c",
                                "sense_id": "fd9bd0e9-62bd-3e9f-b913-b37ad77b428b",
                                "text": "Le regard de ma mère, faraude, attendant l'action de grâces, faisait pendant à l'air penaud de la Berrichonne qui n'avait pas osé refuser."
                            },
                            {
                                "example_id": "9988c50f-30a3-41e8-bb57-fee59e5b17a4",
                                "sense_id": "fd9bd0e9-62bd-3e9f-b913-b37ad77b428b",
                                "text": "Quelque peu penaud, il tergiverse à peine, content d’empocher son argent, et s’en va sans demander son reste."
                            },
                            {
                                "example_id": "8a4eca0b-13a3-42f9-860f-de105b2655d3",
                                "sense_id": "fd9bd0e9-62bd-3e9f-b913-b37ad77b428b",
                                "text": "Décontenancé par la sollicitude détachée de Minne : « Tu n’as pas eu de thé ? tu ne reprends pas de gâteau ?… » il s’est tenu à peu près coi et penaud, attendant tout d’elle, sauf le bonheur…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "428db8fa-d008-4d3a-b14f-d39ff5f46df0",
                        "source_entry_id": "48c611dc-9d73-3a78-96ea-6ec9b2c42358",
