                        "glosses": [
                            "moeilijkheid die ontstaat door overmatig alcohol gebruik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e8af62-3bda-4d6f-b895-39460ca466e1",
                                "sense_id": "c6b9f81e-44ca-3804-bdaf-7212d92af064",
                                "text": "We maken het thuis allemaal mee door de camera van Frank Wiering. Steeds komt hij terug bij zijn hoofdpersonen om te kijken hoe het met ze gaat: de man die fietsen opknapt en tegelijk werkt aan zijn alcoholprobleem, de asielzoeker die in de kringloopwinkel Nederland leert kennen, de docente die zwaar depressief is geweest en in de winkel nieuwe talenten ontdekt - mooi gedaan."
                            },
                            {
                                "example_id": "8a3dcb08-58fa-497b-8cb5-dbc2909bb5f3",
                                "sense_id": "c6b9f81e-44ca-3804-bdaf-7212d92af064",
                                "text": "In het interview gaat mijnheer Gilet in op de roep van deskundigen om strengere maatregelen die alcoholproblemen moeten voorkomen, zoals het invoeren van minimumprijzen, het verder verhogen van de accijnzen, het inperken van sportsponsoring door alcoholproducenten, het invoeren van een algeheel reclameverbod voor alcohol of het beperken van het aantal verkooppunten."
                            },
                            {
                                "example_id": "07593204-de52-452f-9285-5f6d6982b86a",
                                "sense_id": "c6b9f81e-44ca-3804-bdaf-7212d92af064",
                                "text": "'Is uw vrouw opgenomen geweest vanwege een alcoholprobleem?' preciseerde Ferrati."
                            },
                            {
                                "example_id": "2c102d9a-5b18-43a3-b591-e53eaab3f5e2",
                                "sense_id": "c6b9f81e-44ca-3804-bdaf-7212d92af064",
                                "text": "Gote is eerder gewelddadig te noemen en heeft een alcoholprobleem."
                            }
                        ]
                    }
