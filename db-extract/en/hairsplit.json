                        "glosses": [
                            "To make fine distinctions concerning."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f3dde1df-2b86-4374-a346-a8068b6fa349",
                                "sense_id": "432920f8-670e-3968-a82f-823382343806",
                                "text": "The real criticism of your article is not only your attitude of mind as expressed therein, but also in dealing with details and inclination to hairsplit minor matters"
                            },
                            {
                                "example_id": "e4f54d6a-6ad8-4ff3-886e-b10d23019b76",
                                "sense_id": "432920f8-670e-3968-a82f-823382343806",
                                "text": "This would lend support to the view that it would be unrealistic to hairsplit various activities of an educational institution to ferret out if any one of them, by itself, involves profit-making."
                            }
                        ]
                    },
                    {
                        "sense_id": "6748f2a6-a229-35ba-ac64-e55a971d5ae8",
                        "entry_id": "d1f5e37f-e34a-303c-8b1b-9de2b8661777",
                        "glosses": [
                            "To split hairs."
