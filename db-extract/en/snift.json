                        "examples": [
                            {
                                "example_id": "d6ba0482-0a19-4702-881e-5fe41577ac2b",
                                "sense_id": "2e8c3126-47a1-3372-991f-7e29dc8681da",
                                "text": "An' if thou'll make a shift effort\nTo tak thi time a bit, owd lass,\nThou's have him in a snift!"
                            },
                            {
                                "example_id": "4f0e16da-0ee3-47fa-b3b3-3d5b87862edc",
                                "sense_id": "2e8c3126-47a1-3372-991f-7e29dc8681da",
                                "text": "An ' if thou'll make a shift To tak thi time a bit, owd lass, Thou's have him in a snift!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "25eea45e-14ec-3674-92fc-f4ec3c5aa6ab",
                        "entry_id": "1fff88d5-39fe-339e-bffb-c98babda38b1",
                        "glosses": [
                            "A light dusting, as of snow."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ce05b12d-436a-413e-916a-048855409845",
                                "sense_id": "25eea45e-14ec-3674-92fc-f4ec3c5aa6ab",
                                "text": "Good Lorjus, Meary ! theawrt so hasty; so I clum th' steeigh in o snift, shoavt th' awts eawt, an smackt me riddle oth' hoyle."
                            },
                            {
                                "example_id": "b28918d2-2407-4391-966d-d4a407b71bc9",
                                "sense_id": "25eea45e-14ec-3674-92fc-f4ec3c5aa6ab",
                                "text": "He frowned, and sent snifts of snow and symptoms of rain that dampened the ardor of the golf contingent and made things murky and dreary outside."
                            },
                            {
                                "example_id": "2debe496-4d58-4977-bcd2-40f64e525044",
                                "sense_id": "25eea45e-14ec-3674-92fc-f4ec3c5aa6ab",
                                "text": "Mingled labdanum w'fine snift of myrrh, to enhaunt her nautical J-chamois"
                            }
                        ]
                    }
                ],
