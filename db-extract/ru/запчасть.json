                "senses": [
                    {
                        "sense_id": "82bf88b4-015c-3ddd-9db2-00fcaed51250",
                        "entry_id": "048ae251-5c8e-3cec-80c5-9c8ff2af269a",
                        "glosses": [
                            "разг. сокр. от запасная часть; дополнительная, запасная деталь механизма, прибора, которая может быть использована, если сломается работающая деталь"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "4241e839-ecdb-438a-8c47-9fea1b1d59f5",
                                "sense_id": "82bf88b4-015c-3ddd-9db2-00fcaed51250",
                                "text": "9. Клапан нагнетательный (запчасть) 2 шт. 10. Клапан всасывающий (запчастъ) 1 шт. ❬…❭ 14. Поршень (запчасть) 1 шт."
                            },
                            {
                                "example_id": "c773617a-7a5d-4184-b1e1-dab47f8b434c",
                                "sense_id": "82bf88b4-015c-3ddd-9db2-00fcaed51250",
                                "text": "— А чем делать? А где запчасти? Ты мне дай запчасть. Нету… И не откажешь, свои люди."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d005dfaf-510d-4f72-9345-ab34107912f9",
                        "source_entry_id": "048ae251-5c8e-3cec-80c5-9c8ff2af269a",
                        "source_sense_id": "82bf88b4-015c-3ddd-9db2-00fcaed51250",
                        "target_lang_word": "spare part",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spare part",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cd7d9b1-2986-3d7e-8866-8a9772b7168a",
                                        "entry_id": "e1d042ec-199e-3bd7-9609-de9cc781c647",
                                        "glosses": [
                                            "A component of any manufactured goods, kept in reserve to replace one that fails; a spare."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bc333bf-76b5-4ee1-9493-502906763d09",
                                                "sense_id": "1cd7d9b1-2986-3d7e-8866-8a9772b7168a",
                                                "text": "It is extremely difficult to obtain spare parts from abroad, and these are manufactured in the shops [workshops]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92f8c890-8b01-4d73-94d2-e2843b42ad63",
                        "source_entry_id": "048ae251-5c8e-3cec-80c5-9c8ff2af269a",
                        "source_sense_id": "82bf88b4-015c-3ddd-9db2-00fcaed51250",
                        "target_lang_word": "pièce détachée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pièce détachée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f74edd4-75ce-32b2-93aa-d37d67fe1638",
                                        "entry_id": "41b00206-3cbc-353e-b795-fbcdf650acc8",
                                        "glosses": [
                                            "Pièce d’artillerie en position isolée de défense."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c494a41d-6e21-463f-b610-ab20743943b1",
                                                "sense_id": "9f74edd4-75ce-32b2-93aa-d37d67fe1638",
                                                "text": "Quoique souvent une pièce détachée suffise seule et isolée, pour remplir complètement les différents objets que nous lui avons assignés, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e197a35d-56d4-34be-bacd-2b6f295fb6dd",
                                        "entry_id": "41b00206-3cbc-353e-b795-fbcdf650acc8",
                                        "glosses": [
                                            "Élément d’un ensemble fonctionnel que l’on peut extraire, isoler ou remplacer."
                                        ],
                                        "tags": [
                                            "generically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb58fb0-84f0-48c8-af6f-a38b72c4834c",
                                                "sense_id": "e197a35d-56d4-34be-bacd-2b6f295fb6dd",
                                                "text": "on doit faire face aux désirs des consommateurs et ce d’autant plus que la pièce détachée est vendue sous la marque du fabricant."
                                            },
                                            {
                                                "example_id": "9325c6f1-50a4-46de-83ac-bf3407b44387",
                                                "sense_id": "e197a35d-56d4-34be-bacd-2b6f295fb6dd",
                                                "text": "À Gaillac, loin de se limiter à la pièce détachée, l’entreprise reconditionne désormais 2 400 voitures remises à la vente avec près de 30 % de pièces réemployées."
                                            },
                                            {
                                                "example_id": "7ba714f1-6d99-49b4-bd93-c2cd9c5b4343",
                                                "sense_id": "e197a35d-56d4-34be-bacd-2b6f295fb6dd",
                                                "text": "Des mecs te dépiautaient ta Peugeot en moins de deux et tu retrouvais les pièces détachées jusqu’à Bamako."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
