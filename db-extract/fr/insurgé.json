                        "form": "insurgée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1bf48298-cdf2-3936-9836-624327687b0b",
                        "entry_id": "d7c9324a-104f-383b-94d3-832226ad3e92",
                        "glosses": [
                            "Personne qui s’est insurgée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f107f4cf-ea1d-4d63-bea8-523c0ab356db",
                                "sense_id": "1bf48298-cdf2-3936-9836-624327687b0b",
                                "text": "Et pourtant il y a eu une balle perdue qui, après avoir ricoché, est allée faire un bleu sur la joue d’un insurgé…"
                            },
                            {
                                "example_id": "f52dcdda-643d-40cd-ac2b-72bca757b41a",
                                "sense_id": "1bf48298-cdf2-3936-9836-624327687b0b",
                                "text": "Devant toi, misère sauvage,\nDevant toi, pesant esclavage,\nL’insurgé\nSe dresse, le fusil chargé!"
                            },
                            {
                                "example_id": "c485aab2-d7ac-4c56-8591-884782d82258",
                                "sense_id": "1bf48298-cdf2-3936-9836-624327687b0b",
                                "text": "Toujours aussi loin des réalités, le tsar a pour seule réponse la répression mais, le 27 février, les 150 000 hommes de la garnison de Petrograd passent du côté des insurgés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "602b392a-a041-4d7b-8adf-61a8817cf43a",
                        "source_entry_id": "d7c9324a-104f-383b-94d3-832226ad3e92",
                        "source_sense_id": "1bf48298-cdf2-3936-9836-624327687b0b",
