{
    "word_family": [
        "monkeyish"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "21be9796-f312-3a11-b4bb-259e03fbca2e",
                    "sense_definition": "A primate of the clade Simiiformes, generally distinguished from apes by being smaller and having a tail.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>monkey</w> climbed quickly up the tall tree.",
                            "target_lang_translations": {
                                "ru": "Маленькая <w>обезьяна</w> быстро вскарабкалась на высокое дерево.",
                                "zh": "那只小<w>猴子</w>迅速爬上了高树。"
                            }
                        },
                        {
                            "text": "We saw a <w>monkey</w> eating a banana at the zoo.",
                            "target_lang_translations": {
                                "ru": "Мы видели, как <w>обезьяна</w> ела банан в зоопарке.",
                                "zh": "我们在动物园看到一只<w>猴子</w>在吃香蕉。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Примат из отряда обезьянообразных, обычно отличающийся от человекообразных обезьян меньшим размером и наличием хвоста.",
                        "zh": "灵长目动物，通常指体型较小且有尾巴的猴类。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезьяна",
                                "target_lang_sense_clarification": "животное"
                            },
                            {
                                "target_lang_word": "мартышка",
                                "target_lang_sense_clarification": "разговорное, часто о маленьких обезьянах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猴子",
                                "target_lang_sense_clarification": "一般指猴类动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a17320c7-4423-3d46-b827-311cd6567e3a",
                    "sense_definition": "A naughty or mischievous person, especially a child.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Come here, you cheeky <w>monkey</w>, and put your shoes on!",
                            "target_lang_translations": {
                                "ru": "Иди сюда, нахальный <w>проказник</w>, и надень ботинки!",
                                "zh": "过来，你这个<w>小淘气</w>，快把鞋穿上！"
                            }
                        },
                        {
                            "text": "The little <w>monkey</w> hid my keys somewhere in the living room.",
                            "target_lang_translations": {
                                "ru": "Этот маленький <w>шалун</w> спрятал мои ключи где-то в гостиной.",
                                "zh": "那个<w>小猴子</w>把我的钥匙藏在客厅的某个地方了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cheeky monkey",
                        "little monkey"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непослушный или озорной человек, особенно ребёнок.",
                        "zh": "调皮或淘气的人，尤指小孩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проказник",
                                "target_lang_sense_clarification": "озорник"
                            },
                            {
                                "target_lang_word": "шалун",
                                "target_lang_sense_clarification": "баловник"
                            },
                            {
                                "target_lang_word": "обезьянка",
                                "target_lang_sense_clarification": "ласковое обращение к ребенку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小淘气",
                                "target_lang_sense_clarification": "指调皮的孩子"
                            },
                            {
                                "target_lang_word": "小猴子",
                                "target_lang_sense_clarification": "对小孩的昵称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e77bb329-55d8-3e14-abce-42381faf1a9e",
                    "sense_definition": "A menial employee who does a repetitive job supposedly requiring minimal intelligence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worked as a grease <w>monkey</w> in the garage for five years.",
                            "target_lang_translations": {
                                "ru": "Он пять лет проработал <w>механиком</w> в гараже.",
                                "zh": "他在修车厂当了五年<w>苦力</w>。"
                            }
                        },
                        {
                            "text": "I am tired of being a code <w>monkey</w> and want to design the software myself.",
                            "target_lang_translations": {
                                "ru": "Мне надоело быть простым <w>кодером</w>, я хочу сам проектировать программное обеспечение.",
                                "zh": "我厌倦了做<w>码农</w>，我想自己设计软件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grease monkey",
                        "code monkey"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работник, выполняющий механическую, рутинную работу, якобы требующую минимального интеллекта.",
                        "zh": "从事重复性、机械性工作，被认为不需要太多智力的员工。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исполнитель",
                                "target_lang_sense_clarification": "работник рутинного труда"
                            },
                            {
                                "target_lang_word": "работяга",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苦力",
                                "target_lang_sense_clarification": "指从事繁重或机械劳动的人"
                            },
                            {
                                "target_lang_word": "码农",
                                "target_lang_sense_clarification": "指从事重复性编程工作的程序员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "112e87c7-4aac-3be7-970c-0572bb83d1d3",
                    "sense_definition": "A drug habit; an addiction; a compulsion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "idiom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finally managed to get the <w>monkey</w> off his back after years of struggle.",
                            "target_lang_translations": {
                                "ru": "После долгих лет борьбы ему наконец удалось избавиться от <w>зависимости</w>.",
                                "zh": "经过多年的挣扎，他终于摆脱了那份<w>毒瘾</w>。"
                            }
                        },
                        {
                            "text": "The program is designed to help people deal with the <w>monkey</w> of addiction.",
                            "target_lang_translations": {
                                "ru": "Программа разработана, чтобы помочь людям справиться с бременем <w>зависимости</w>.",
                                "zh": "该项目旨在帮助人们应对成瘾带来的<w>瘾</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "monkey on one's back"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наркотическая зависимость; непреодолимое влечение или проблема.",
                        "zh": "毒瘾、成瘾或某种难以摆脱的负担。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зависимость",
                                "target_lang_sense_clarification": "наркотическая"
                            },
                            {
                                "target_lang_word": "обуза",
                                "target_lang_sense_clarification": "тяжкая проблема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瘾",
                                "target_lang_sense_clarification": "指成瘾性依赖"
                            },
                            {
                                "target_lang_word": "负担",
                                "target_lang_sense_clarification": "指沉重的心理或生活压力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a410d2c3-f31a-3616-892d-c4c03e7871d2",
                    "sense_definition": "Five hundred pounds sterling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The repair bill for the car came to nearly a <w>monkey</w>.",
                            "target_lang_translations": {
                                "ru": "Счет за ремонт машины составил почти <w>пятьсот фунтов</w>.",
                                "zh": "汽车维修费总共花了将近<w>五百英镑</w>。"
                            }
                        },
                        {
                            "text": "He bet a <w>monkey</w> on the horse race and lost it all.",
                            "target_lang_translations": {
                                "ru": "Он поставил <w>пятьсот фунтов</w> на скачках и всё проиграл.",
                                "zh": "他在赛马中押了<w>五百英镑</w>，结果全输光了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "five hundred"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пятьсот фунтов стерлингов (британский сленг).",
                        "zh": "五百英镑（英国俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятьсот фунтов",
                                "target_lang_sense_clarification": "сумма денег"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "五百英镑",
                                "target_lang_sense_clarification": "货币金额"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d2783d34-966c-3a28-bf43-0dad6ad51049",
                    "sense_definition": "To meddle or interfere with something; to mess around.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please do not <w>monkey</w> with the thermostat settings.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не <w>лезь</w> в настройки термостата.",
                                "zh": "请不要<w>乱动</w>恒温器的设置。"
                            }
                        },
                        {
                            "text": "The children were <w>monkeying</w> around in the backyard all afternoon.",
                            "target_lang_translations": {
                                "ru": "Дети весь день <w>валяли дурака</w> на заднем дворе.",
                                "zh": "孩子们整个下午都在后院<w>瞎胡闹</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interfere",
                        "fiddle"
                    ],
                    "common_phrases": [
                        "monkey around",
                        "monkey with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вмешиваться во что-либо; возиться, баловаться или бездельничать.",
                        "zh": "胡乱摆弄、干扰或无所事事地玩耍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валять дурака",
                                "target_lang_sense_clarification": "бездельничать, дурачиться"
                            },
                            {
                                "target_lang_word": "лезть",
                                "target_lang_sense_clarification": "вмешиваться, трогать"
                            },
                            {
                                "target_lang_word": "возиться",
                                "target_lang_sense_clarification": "копаться с чем-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乱动",
                                "target_lang_sense_clarification": "指随意摆弄某物"
                            },
                            {
                                "target_lang_word": "瞎胡闹",
                                "target_lang_sense_clarification": "指无所事事地玩耍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4adc2c9-9807-30c9-a7e5-5d3f5bed9b31",
                    "sense_definition": "To mimic or imitate someone's movements or behavior.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boy <w>monkeyed</w> his father's gestures perfectly.",
                            "target_lang_translations": {
                                "ru": "Мальчик идеально <w>сбезьянничал</w> жесты своего отца.",
                                "zh": "那个男孩完美地<w>学样</w>了他父亲的手势。"
                            }
                        },
                        {
                            "text": "She laughed as he <w>monkeyed</w> the walk of the old man.",
                            "target_lang_translations": {
                                "ru": "Она смеялась, когда он <w>передразнивал</w> походку старика.",
                                "zh": "当他<w>模仿</w>老人的步态时，她笑了起来。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подражать чьим-либо движениям или поведению; кривляться.",
                        "zh": "模仿某人的动作或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезьянничать",
                                "target_lang_sense_clarification": "подражать"
                            },
                            {
                                "target_lang_word": "передразнивать",
                                "target_lang_sense_clarification": "копировать с насмешкой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学样",
                                "target_lang_sense_clarification": "指模仿动作"
                            },
                            {
                                "target_lang_word": "模仿",
                                "target_lang_sense_clarification": "指模仿行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "346a90a1-850b-3e22-8d59-088c57b360ff",
                    "sense_definition": "The ninth of the 12-year cycle of animals which appear in the Chinese zodiac related to the Chinese calendar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "astrology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "My brother was born in the Year of the <w>Monkey</w>.",
                            "target_lang_translations": {
                                "ru": "Мой брат родился в год <w>Обезьяны</w>.",
                                "zh": "我哥哥出生于<w>猴</w>年。"
                            }
                        },
                        {
                            "text": "The <w>Monkey</w> is associated with intelligence and curiosity in the zodiac.",
                            "target_lang_translations": {
                                "ru": "<w>Обезьяна</w> в зодиаке ассоциируется с интеллектом и любопытством.",
                                "zh": "在十二生肖中，<w>猴</w>象征着智慧与好奇心。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Девятый знак 12-летнего цикла животных китайского зодиака.",
                        "zh": "中国十二生肖中的第九位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Обезьяна",
                                "target_lang_sense_clarification": "знак зодиака"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猴",
                                "target_lang_sense_clarification": "生肖属相"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}