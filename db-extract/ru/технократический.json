                    {
                        "translation_id": "866a6d39-8424-4a19-b6cb-767c08ab21aa",
                        "source_entry_id": "66143ec3-636b-35a8-baa0-568b4b019126",
                        "source_sense_id": "2cda022b-faaf-3a5d-9c4c-6997da904ecb",
                        "target_lang_word": "technokratisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technokratisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d91523a-ae71-3e3c-9147-f1db7106c5a5",
                                        "entry_id": "cfe2ffa3-2e15-36a3-8a32-6e18b0dbe29a",
                                        "glosses": [
                                            "die Technokratie betreffend, in der Art einer Technokratie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e509988-96da-4a9d-81cc-1ac475b83331",
                                                "sense_id": "7d91523a-ae71-3e3c-9147-f1db7106c5a5",
                                                "text": "„Auch wenn die Apartheid und ihre Umsetzung viel mit technokratischen Kenntnissen, bürokratischer Expertise und einer positivistischen Datenobsession zu tun hatten, waren es die Geisteswissenschaften, die dem Apartheid-Konzept die Legitimationsgrundlage verliehen.“"
                                            },
                                            {
                                                "example_id": "dda27a05-4c1c-4c95-b7d3-27e155a1e314",
                                                "sense_id": "7d91523a-ae71-3e3c-9147-f1db7106c5a5",
                                                "text": "„Gleich würde er für eine technokratische Diktatur plädieren, für die Registrierung aller Bürger, für Personalausweise, eine strikte Politik der Geburtenkontrolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b65266d-8f21-4345-b020-b7a9790c8e97",
                        "source_entry_id": "66143ec3-636b-35a8-baa0-568b4b019126",
                        "source_sense_id": "2cda022b-faaf-3a5d-9c4c-6997da904ecb",
                        "target_lang_word": "technokratyczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technokratyczny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "0c1afd0f-fe9f-3d6b-b861-a7379e7092c1",
                                        "entry_id": "318c08fa-1d60-302a-b80d-7db87e8af4db",
                                        "glosses": [
                                            "związany z technokracją lub technokratą"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58ed593b-b33b-4f7b-9604-4bbb3d794e62",
                                                "sense_id": "0c1afd0f-fe9f-3d6b-b861-a7379e7092c1",
                                                "text": "Myślenie technokratyczne wysuwało na pierwszy plan wzrost produkcji"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66e3a933-06a5-49c0-9980-ed30266f63bd",
                        "source_entry_id": "66143ec3-636b-35a8-baa0-568b4b019126",
                        "source_sense_id": "2cda022b-faaf-3a5d-9c4c-6997da904ecb",
                        "target_lang_word": "technocratique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technocratique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "516af184-ece7-33ff-867f-eb94f83b0f08",
                                        "entry_id": "527865f3-e805-3e6e-a662-8657ce7912c7",
                                        "glosses": [
                                            "Relatif à un technocrate ou à la technocratie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0377da18-6cc8-41dd-a1f2-bddc3dd4f088",
                                                "sense_id": "516af184-ece7-33ff-867f-eb94f83b0f08",
                                                "text": "Il est secrétaire d’État auprès du ministre de la Cohésion des territoires. C’est comme ça qu’en Macronie on appelle la politique de la ville et l’aménagement du territoire. C’est super comme intitulé et ce n’est pas du tout technocratique."
                                            },
                                            {
                                                "example_id": "5641e632-89d1-4215-ae01-a98568fb4a42",
                                                "sense_id": "516af184-ece7-33ff-867f-eb94f83b0f08",
                                                "text": "En fait, les freins à la démocratie technique sont ceux dont souffre la représentativité citoyenne en général (la démocratie participative, le tirage au sort) : une certaine peur de la parole populaire et une foi aveugle en un régime technocratique qui pourrait s’absoudre de toute position idéologique, quand bien même il est incapable d’observer les siennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
