                        ],
                        "form": "das Spitzenspiel"
                    },
                    {
                        "form_id": "e96121dc-082d-4b44-8d16-2c4d78bbdcba",
                        "entry_id": "1024d0f1-3267-3cdb-a72d-54c883eb44d2",
                        "tags": [
                            "accusative",
