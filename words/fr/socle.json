    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40731785-0e9d-3326-8015-7f0690553751",
                    "sense_definition": "Base ou support horizontal sur lequel repose une statue, un buste, une colonne ou un objet décoratif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste a déposé sa sculpture en bronze sur un <w>socle</w> en marbre blanc."
                        },
                        {
                            "text": "La vieille statue de la place centrale repose sur un imposant <w>socle</w> de pierre."
                        }
                    ],
                    "synonyms": [
                        "piédestal",
                        "base",
                        "support"
                    ],
                    "common_phrases": [
                        "sur son socle",
                        "socle en marbre",
                        "socle de pierre"
                    ]
                },
                {
                    "sense_id": "0e981148-633a-3bfa-ad40-dc2ba0996180",
                    "sense_definition": "Support conçu pour accueillir et recharger un appareil électrique ou électronique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à remettre le combiné téléphonique sur son <w>socle</w> après chaque appel."
                        },
                        {
                            "text": "Elle a posé son téléphone portable directement sur le <w>socle</w> de chargement sans fil."
                        }
                    ],
                    "synonyms": [
                        "support"
                    ],
                    "common_phrases": [
                        "socle de chargement",
                        "socle de recharge"
                    ]
                },
                {
                    "sense_id": "5f5af7e8-c384-350d-939d-143071b6414b",
                    "sense_definition": "Fondement ou principe essentiel sur lequel repose une idée, une institution ou une négociation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "base_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'apprentissage de la lecture et de l'écriture constitue le véritable <w>socle</w> de l'instruction."
                        },
                        {
                            "text": "La confiance mutuelle et le respect forment le <w>socle</w> solide de leur partenariat professionnel."
                        }
                    ],
                    "synonyms": [
                        "fondement",
                        "base",
                        "pilier"
                    ],
                    "common_phrases": [
                        "socle commun",
                        "constituer le socle",
                        "servir de socle"
                    ]
                },
                {
                    "sense_id": "e9b67ccc-8c2f-3290-85c9-a5478cab130c",
                    "sense_definition": "Ensemble rocheux ancien et plissé formant l'assise rigide sous une couverture de sédiments.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les géologues étudient les failles profondes qui traversent le <w>socle</w> cristallin de la région."
                        },
                        {
                            "text": "La couverture sédimentaire s'est déposée lentement au-dessus du <w>socle</w> rocheux au cours des millénaires."
                        }
                    ],
                    "common_phrases": [
                        "socle cristallin",
                        "socle géologique"
                    ]
                }
            ]
        }
    ]
