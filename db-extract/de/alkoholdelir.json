                "senses": [
                    {
                        "sense_id": "3591a783-8d40-3e58-bf12-601c9ecff1ce",
                        "entry_id": "8efd2f00-eef5-3599-822c-78db92fc9594",
                        "glosses": [
                            "ernste und potentiell lebensbedrohende Komplikation im Alkoholentzug bei einer schon länger bestehenden Alkoholkrankheit"
                        ],
                        "tags": [
                            "Psychiatrie"
                        ],
                        "examples": [
                            {
                                "example_id": "c56393a3-83c3-4941-8b87-396568cf4e2d",
                                "sense_id": "3591a783-8d40-3e58-bf12-601c9ecff1ce",
                                "text": "„Ein Alkoholdelir (Synonym: Delirium tremens) erleiden bis zu 15% der Alkoholkranken.“"
                            },
                            {
                                "example_id": "a4f38c3b-df2f-482e-8376-559363bb8498",
                                "sense_id": "3591a783-8d40-3e58-bf12-601c9ecff1ce",
                                "text": "„Sie sind vor allem zur Prophylaxe und Therapie des Alkoholdelirs wirksam.“"
                            },
                            {
                                "example_id": "29d015bd-a44b-4afb-ad4a-a4ebbe5cfeae",
                                "sense_id": "3591a783-8d40-3e58-bf12-601c9ecff1ce",
                                "text": "„Die Symptomatik kann fließend in ein Alkoholdelir übergehen!“"
                            },
                            {
                                "example_id": "f1bc491f-2dff-43c0-9626-9f1d319e3fe1",
                                "sense_id": "3591a783-8d40-3e58-bf12-601c9ecff1ce",
                                "text": "„Im Gegensatz zum Alkoholdelir gibt es bei der Alkoholhalluzinose kaum oder nur gering ausgeprägte vegetative Begleitsymptome.“"
                            },
                            {
                                "example_id": "69c02c3b-438c-4f11-a4aa-eb82cf1e555f",
                                "sense_id": "3591a783-8d40-3e58-bf12-601c9ecff1ce",
                                "text": "„Das Alkoholdelir hat unbehandelt eine Mortalität von bis zu 25%.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
