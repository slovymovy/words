                ],
                "senses": [
                    {
                        "sense_id": "e69e8a89-ad45-3db2-82ca-508bbf6f363e",
                        "entry_id": "f967c670-4cf9-333f-8d0a-814dc8d4fc92",
                        "glosses": [
                            "gerichtliches Verbot, einen Beruf auszuüben, als Strafmaßnahme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5940c9c-6233-47e3-af8f-83d8c47dc58c",
                                "sense_id": "e69e8a89-ad45-3db2-82ca-508bbf6f363e",
                                "text": "„Außerdem wird das Gericht dem Angeklagten aller Voraussicht nach ein Berufsverbot auferlegen.“"
                            },
                            {
                                "example_id": "9bd678cc-7376-47d9-90ea-917ace3aff0a",
                                "sense_id": "e69e8a89-ad45-3db2-82ca-508bbf6f363e",
                                "text": "„Mit Berufsverboten sind wir in Deutschland nicht gut gefahren.“"
                            },
                            {
                                "example_id": "d293cb2b-626c-4403-9834-05474a26c312",
                                "sense_id": "e69e8a89-ad45-3db2-82ca-508bbf6f363e",
                                "text": "„Diese Darbietung hatte ihm siebzehn Monate Haft auf Bewährung und zwei Jahre Berufsverbot für besonders schwerwiegende Körperverletzung, Landfriedensbruch, systematische und geplante Aufwiegelung eingebracht .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "01434de4-842f-3408-9326-8835df0b32be",
                        "entry_id": "f967c670-4cf9-333f-8d0a-814dc8d4fc92",
                        "glosses": [
                            "staatliches Verbot, einen Beruf im öffentlichen Dienst auszuüben, aufgrund einer extremen politischen Einstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04e79aca-31cd-41b3-9aa3-1636006be50a",
                                "sense_id": "01434de4-842f-3408-9326-8835df0b32be",
                                "text": "Sechs Jahre Berufsverbot musste der Grundschullehrer Udo Lammers erleiden − weil er für die DKP, die Deutsche Kommunistische Partei, in Ostfriesland aktiv vor."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
