            {
                "entry_id": "6da96f43-20e7-3026-95aa-2e381965b751",
                "word": "faïencerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a433cd96-ba73-4640-a52a-d0a27a6d432b",
                        "entry_id": "6da96f43-20e7-3026-95aa-2e381965b751",
                        "tags": [
