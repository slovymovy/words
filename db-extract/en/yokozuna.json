                    {
                        "sense_id": "1abe1cf5-7491-30e8-80c1-2fad23740ab5",
                        "entry_id": "81ff306f-3eb8-3cf4-b884-2b8f09732569",
                        "glosses": [
                            "The highest rank of sumo wrestler, above ozeki; grand champion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89fb1f61-246e-4182-a518-b51ff3a5c0f3",
                                "sense_id": "1abe1cf5-7491-30e8-80c1-2fad23740ab5",
                                "text": "A yokozuna is the very highest rank in sumo – “just like Mameha's position in Gion,” as Nobu explained it to me. I had no reason to doubt him; but if Mameha ever took half as much time entering a party as these yokozuna took entering the ring, she'd certainly never be invited back."
                            }
                        ]
                    },
                    {
                        "sense_id": "98eeb8cc-bf4a-3cf3-b017-a26bc10c6f5c",
                        "entry_id": "81ff306f-3eb8-3cf4-b884-2b8f09732569",
                        "glosses": [
                            "A person holding the rank, either competing at the rank or retired after having achieved it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6f751fa-bb20-4e89-9335-4fa7fea99457",
                                "sense_id": "98eeb8cc-bf4a-3cf3-b017-a26bc10c6f5c",
                                "text": "What mattered most was that, from the very top of the Nihon Sumo Kyōkai, Yokozuna Akebono had been shown respect."
                            }
                        ]
                    }
                ],
