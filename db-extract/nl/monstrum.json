                "senses": [
                    {
                        "sense_id": "400f7c99-4e9e-3349-b0bd-6b1105020b0f",
                        "entry_id": "39f0f230-9ba7-3900-92f7-10f74fc9c6f6",
                        "glosses": [
                            "verkeerd aangelegd organisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f41d00b9-f055-4501-8473-05d2e6b19fb6",
                                "sense_id": "400f7c99-4e9e-3349-b0bd-6b1105020b0f",
                                "text": "Het meest spraakmakend echter was Everaerts' in 1662 gepubliceerde beschrijving en analyse van een in Middelburg geboren ‘monstrum’’."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f5ad530-e468-3a8f-a69b-bd4cdc36bbdd",
                        "entry_id": "39f0f230-9ba7-3900-92f7-10f74fc9c6f6",
                        "glosses": [
                            "iets wat helemaal verkeerd gemaakt is (vooral van wetten en regelingen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5aa0af0-b4c2-49e9-acc8-06c5ffd16ef9",
                                "sense_id": "5f5ad530-e468-3a8f-a69b-bd4cdc36bbdd",
                                "text": "De Nederlandse dichter en schrijver, geboren als Robert Gabor Charles, als zoon van twee Joods-Hongaarse immigranten, is in Vlaanderen weinig bekend. In Nederland omschreef De Volkskrant-recensent Arjan Peters hem als ‘de kleine dichter met de tedere taal’, zijn literatuur als ‘hoogstaand klagen, met stilistisch vertoon en volledige inzet.’ Marja Pruis daarentegen, literatuurredactrice van De Groene Amsterdammer, bestempelde zijn autobiografische roman Kameraad scheermes (2003) destijds als een ‘monstrum van een boek, het product van schaamteloze zwelgzucht.’"
                            }
                        ]
                    },
