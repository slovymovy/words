                                                "sense_id": "12b242f1-8615-30c0-a8d7-0286f426d1c8",
                                                "text": "(στην Ελλάδα) τσιφλικάς, προύχοντας, δημογέροντας"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "735ba6a7-9c84-3172-92eb-e5456cf6dc93",
                                        "entry_id": "c4cad1f1-1ab3-3ea9-a66c-b0036aa44d52",
                                        "glosses": [
