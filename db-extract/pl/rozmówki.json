                        "entry_id": "3530f136-94ba-3a84-800f-36126e0065e2",
                        "glosses": [
                            "niewielka książeczka zawierająca podstawowe zwroty używane w typowych sytuacjach, pomocna w nauce języka obcego lub w porozumiewaniu się za granicą; także: dialogi zawarte w takiej książeczce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0f0ba9d-d5e5-4138-baf4-c7b7c5f98658",
                                "sense_id": "8e0f86ae-b942-3c28-965c-a78c671b0751",
                                "text": "Jedziesz do Niemiec? Weź ze sobą rozmówki polsko-niemieckie."
                            }
