    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ebfe36f6-8684-3c7c-abb0-8517d3e4f5ac",
                "word": "Polony",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e41dcf8e-ed68-3952-8baf-d4b63cfa9660",
                        "entry_id": "ebfe36f6-8684-3c7c-abb0-8517d3e4f5ac",
                        "glosses": [
                            "Polish (especially of shoes)."
                        ],
                        "tags": [
                            "historical",
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "288c2df3-e776-4737-a0a9-e8a0e5349189",
                                "sense_id": "e41dcf8e-ed68-3952-8baf-d4b63cfa9660",
                                "text": "In Costume in the Drama of Shakespeare and his Contemporaries, M. Channing Linthicum cites two allusions to Polonian, Polonia, or Polony shoes, or to their high heels, in 1611, and two more in 1617 and 1618."
                            },
                            {
                                "example_id": "f2bb3c0f-5ea2-4430-8646-8307227410be",
                                "sense_id": "e41dcf8e-ed68-3952-8baf-d4b63cfa9660",
                                "text": "Obviously Polony heels were made in Western Europe, though at present it is not clear why this name was given to the stacked heels."
                            },
                            {
                                "example_id": "12b75ec7-d2de-4780-b6dd-adc0b0ee88b6",
                                "sense_id": "e41dcf8e-ed68-3952-8baf-d4b63cfa9660",
                                "text": "Such a one is in Houndsditch with us, but it is a Polony shoe with a bell, that will not be left for ten pound, because he hath it by inheritance."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8430089b-f4cc-3041-88cf-26ef118f28ea",
                "word": "polony",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f4d8d0e3-ed74-4b9b-98bf-289b2ddcfa63",
                        "entry_id": "8430089b-f4cc-3041-88cf-26ef118f28ea",
                        "tags": [
                            "plural"
                        ],
                        "form": "polonies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bf9fd6f-70ae-364c-98be-df0ddd7305e7",
                        "entry_id": "8430089b-f4cc-3041-88cf-26ef118f28ea",
                        "glosses": [
                            "A kind of sausage made of meat that has been only partly cooked."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3bad1ff-9bfb-4e32-9679-7450c04d37a8",
                                "sense_id": "0bf9fd6f-70ae-364c-98be-df0ddd7305e7",
                                "text": "A dreadful day it was for young Dobbin when one of the youngsters of the school, having run into the town upon a poaching excursion for hardbake and polonies, espied the cart of Dobbin & Rudge, Grocers and Oilmen, Thames Street, London, at the Doctor's door, discharging a cargo of the wares in which the firm dealt."
                            },
                            {
                                "example_id": "0f0aec1b-fd42-4ae9-9f97-220e8e2f8c58",
                                "sense_id": "0bf9fd6f-70ae-364c-98be-df0ddd7305e7",
                                "text": "There was a touch of quiet humour in Rachel, and with a demure smile, she internally wondered why it was precisely her polony that had been selected by puss, but aloud she merely declared that she could make an excellent supper on bread and beer."
                            },
                            {
                                "example_id": "592eff14-9a0f-4279-b852-9eaaff999231",
                                "sense_id": "0bf9fd6f-70ae-364c-98be-df0ddd7305e7",
                                "text": "A survey of 25 polony samples of different brands available to the consumer in Bloemfontein showed that significant numbers of various micro-organisms were present."
                            },
                            {
                                "example_id": "79f0f36c-e459-4d13-a1af-11487d402032",
                                "sense_id": "0bf9fd6f-70ae-364c-98be-df0ddd7305e7",
                                "text": "Shlomo threw the polony and bread ceremoniously into the lorry and heaved himself up to see who it was who recognised him."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "d33db827-d970-357f-b7a7-659fab8218a6",
