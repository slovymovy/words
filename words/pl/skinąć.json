{
    "word_family": [
        "skinienie",
        "skinnięcie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa45d857-63fd-3277-8d4b-9589ab6236cd",
                    "sense_definition": "uczynić ruch głową lub ręką na znak czegoś, zwłaszcza na znak zgody, przyzwolenia, powitania lub pożegnania",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gestykulacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Erec <w>skinął</w> głową na znak zgody.",
                            "target_lang_translations": {
                                "ru": "Эрек <w>кивнул</w> головой в знак согласия."
                            }
                        },
                        {
                            "text": "Kiedy go zobaczył, <w>skinął</w> ręką, żeby podszedł bliżej.",
                            "target_lang_translations": {
                                "ru": "Когда он его увидел, то <w>махнул</w> рукой, чтобы тот подошел ближе."
                            }
                        }
                    ],
                    "synonyms": [
                        "kiwnąć",
                        "przytaknąć"
                    ],
                    "common_phrases": [
                        "skinąć głową",
                        "skinąć ręką"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать движение головой или рукой в знак чего-либо, особенно согласия, приветствия или прощания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кивнуть",
                                "target_lang_sense_clarification": "движение головой"
                            },
                            {
                                "target_lang_word": "махнуть",
                                "target_lang_sense_clarification": "движение рукой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b1b73b9-7e85-30d8-90d3-f37dd60327e2",
                    "sense_definition": "wykonać krótki ruch w określonym kierunku, aby kogoś przywołać lub wskazać drogę",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gestykulacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kelner <w>skinął</w> na gościa, wskazując wolny stolik przy oknie.",
                            "target_lang_translations": {
                                "ru": "Официант <w>поманил</w> гостя, указывая на свободный столик у окна."
                            }
                        },
                        {
                            "text": "Nauczyciel <w>skinął</w> na ucznia, aby ten podszedł do tablicy.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>поманил</w> ученика, чтобы тот подошел к доске."
                            }
                        }
                    ],
                    "synonyms": [
                        "kiwnąć"
                    ],
                    "common_phrases": [
                        "skinąć na kogoś"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать короткий жест рукой или головой в определенном направлении, чтобы подозвать кого-то или указать путь"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поманить",
                                "target_lang_sense_clarification": "призвать жестом подойти"
                            },
                            {
                                "target_lang_word": "кивнуть",
                                "target_lang_sense_clarification": "указать направление жестом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}