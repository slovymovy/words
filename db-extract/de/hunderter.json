                ],
                "senses": [
                    {
                        "sense_id": "7e867575-7fbd-37da-8f87-76edebb59cd6",
                        "entry_id": "fdadabd4-d518-3612-95a9-09f27b00b7ce",
                        "glosses": [
                            "etwas mit Größe, Wert, Maß oder Nummer 100"
                        ],
                        "tags": [
                            "colloquial",
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "58b2603b-2b06-41a0-bcf1-7f2738453d68",
                                "sense_id": "7e867575-7fbd-37da-8f87-76edebb59cd6",
                                "text": "Im ‚Club der Hunderter‘ werden Sportler mit mehr als 100 Länderspielen gezählt."
                            },
                            {
                                "example_id": "2c5b41f1-2d2b-49b1-b5ba-f140c3786562",
                                "sense_id": "7e867575-7fbd-37da-8f87-76edebb59cd6",
                                "text": "„Neben Eberhard Vogel und Achim Streich war er der dritte im „Club der Hunderter“. Der Vorsprung gegenüber Jena und Dresden wuchs auf fünf Punkte an.“"
                            },
                            {
                                "example_id": "77a4cd46-7705-4162-8df8-587f81bc3ea3",
                                "sense_id": "7e867575-7fbd-37da-8f87-76edebb59cd6",
                                "text": "„Ab 400 sind die Hunderter ganz regelmäßig zusammengesetzt.“"
                            },
                            {
                                "example_id": "fb7c00ac-d2a2-49aa-b0af-ad4278abc9ab",
                                "sense_id": "7e867575-7fbd-37da-8f87-76edebb59cd6",
                                "text": "„In Danzig und Holland wird das Salz nach Hunderten gerechnet, vielleicht nach hundert Stücken oder hundert Tonnen.“"
                            },
                            {
                                "example_id": "04c3cbfe-c345-455c-92f7-aeca3d934a0a",
                                "sense_id": "7e867575-7fbd-37da-8f87-76edebb59cd6",
                                "text": "„Der 29-Jährige hält vor den Nations-League-Spielen gegen Nordirland und Norwegen bei 85 Länderspielen - der Hunderter kann also schon im kommenden Jahr fallen, wenn die ÖFB-Auswahl zumindest 15 Partien bestreitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b73a0eae-f4c3-3539-a7bb-8df6bc169154",
                        "entry_id": "fdadabd4-d518-3612-95a9-09f27b00b7ce",
                        "glosses": [
                            "Geldschein oder seltener eine Münze mit dem Wert 100 Währungseinheiten"
                        ],
                        "tags": [
                            "colloquial",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "b4a0efc2-af0b-4981-b9d0-36ea98d355fb",
                                "sense_id": "b73a0eae-f4c3-3539-a7bb-8df6bc169154",
                                "text": "„Ich reiche murrend einen Hunderter nach.“"
                            },
                            {
                                "example_id": "0ca42998-2124-4293-a287-72b797f6602f",
                                "sense_id": "b73a0eae-f4c3-3539-a7bb-8df6bc169154",
                                "text": "Kannst du mir einen Hunderter wechseln?"
                            },
                            {
                                "example_id": "089722ee-e290-45e1-9e06-e1c66d1e71fd",
                                "sense_id": "b73a0eae-f4c3-3539-a7bb-8df6bc169154",
                                "text": "„Bei diesen Worten warf ich ihr einen Hunderter hin, damit sie ihren Lebensbalsam herstellen könne, und legte keinen Wert darauf, die Quittung abzuwarten, die sie mir ausstellen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dbae5dea-5c6d-3084-8b2c-970452338194",
                        "entry_id": "fdadabd4-d518-3612-95a9-09f27b00b7ce",
                        "glosses": [
                            "im Dezimalsystem die dritte Vorkommastelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bba1a30e-d84f-4dda-85f7-21e9ba80935a",
                                "sense_id": "dbae5dea-5c6d-3084-8b2c-970452338194",
                                "text": "Beim schriftlichen Addieren werden die Zehner vor den Hundertern zusammengezählt."
                            },
                            {
                                "example_id": "4a2fd1a4-6b69-4507-acbc-c5246f637468",
                                "sense_id": "dbae5dea-5c6d-3084-8b2c-970452338194",
                                "text": "„Bei dem Eintragen der Barometer-Beobachtungen ist es sehr zu empfehlen, die Hunderter der Millimeter wegzulassen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "590afd86-893c-3016-aa4b-8aa129ab89b1",
                        "entry_id": "fdadabd4-d518-3612-95a9-09f27b00b7ce",
                        "glosses": [
                            "eine Hundert"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "3aef52dc-0052-4773-b058-64b5abde4643",
                                "sense_id": "590afd86-893c-3016-aa4b-8aa129ab89b1",
                                "text": "Warum hast du da einen Hunderter hingeschrieben?"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "637cc716-c5c3-4f0f-bc12-5bcbe8240187",
                        "source_entry_id": "fdadabd4-d518-3612-95a9-09f27b00b7ce",
                        "source_sense_id": "b73a0eae-f4c3-3539-a7bb-8df6bc169154",
                        "target_lang_word": "Benjamin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Benjamin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebbfbc6a-c29c-3a93-95e3-82bbb3c90b7e",
                                        "entry_id": "95097efd-7e01-3212-81d3-1cff7dc02d3c",
                                        "glosses": [
                                            "The youngest of the sons of Jacob and Rachel in the Bible."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "576b82e8-4b72-47d9-877a-bad9f076dcee",
                                                "sense_id": "ebbfbc6a-c29c-3a93-95e3-82bbb3c90b7e",
                                                "text": "And it came to pass, as her soul was in departing, (for she died) that she called his name Benoni: but his father called him Benjamin."
                                            },
                                            {
                                                "example_id": "134cec40-1744-4852-9a26-934fd782bca3",
                                                "sense_id": "ebbfbc6a-c29c-3a93-95e3-82bbb3c90b7e",
                                                "text": "What about the youngest child - the Benjamin - the child of its parents' mature strength and charity, always better treated than the unfortunate eldest children of their youthful ignorance and wilfulness?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e26b549c-a528-3e97-acd8-6e78ab84ef77",
                                        "entry_id": "95097efd-7e01-3212-81d3-1cff7dc02d3c",
                                        "glosses": [
                                            "A male given name from Hebrew of biblical origin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a924c36-ac5f-4e53-a4e7-34d804683f78",
                                                "sense_id": "e26b549c-a528-3e97-acd8-6e78ab84ef77",
                                                "text": "\"Well, who the hell ever thinks some boy with a name like Benjamin is going to kill someone?\" I said. \"It's like someone named Winnie the Pooh taking hostages!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc02f43-46ed-3085-9990-ce2377f2301a",
                                        "entry_id": "95097efd-7e01-3212-81d3-1cff7dc02d3c",
                                        "glosses": [
                                            "A small city, the county seat of Knox County, Texas, United States."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "311fb143-ebbe-3666-96cd-0852cf1809a7",
                                        "entry_id": "95097efd-7e01-3212-81d3-1cff7dc02d3c",
                                        "glosses": [
                                            "A patrilineal surname transferred from the given name."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Benjamin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                        "entry_id": "a2d4c40b-401a-326c-9375-00c6b9597ef4",
                                        "glosses": [
                                            "A $100 bill, which bears a portrait of Benjamin Franklin."
                                        ],
                                        "tags": [
                                            "US",
                                            "in-plural",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67ddd718-738a-4ebb-9312-106afc07b1bb",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "Fuck the past, let's dwell on the 500SL, the E&J and ginger ale / The way my pockets swell to the rims with Benjamins"
                                            },
                                            {
                                                "example_id": "c5a23d70-6aac-4e8c-9868-8d8ec5f26f65",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "Swimmin' in women wit they own condominiums / Five plus fives, who drive millenniums / It's all about the Benjamins, what?"
                                            },
                                            {
                                                "example_id": "ffee86de-25c0-42a2-ad94-1426a4d3c5f1",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "Health Care: It's All About the Benjamins [title]"
                                            },
                                            {
                                                "example_id": "9a9b8127-6aba-47b6-afa1-ff6351ac398d",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "Sneering through gold grillz, inked to the neck in bad tattoos and representing my area code, Franco leads the spring breakers through a stylized, mtv version of thug life, replete with drugs, guns, Benjamins and booty call."
                                            },
                                            {
                                                "example_id": "6dc77626-dc28-4dba-80ef-f3024e4b75ec",
                                                "sense_id": "fcb960f6-b85a-3c6a-b4b6-2741e82c67c7",
                                                "text": "He pursed his lips, went to the cash register, and opened it. He pulled out two Benjamins and a US Grant, which he set down on the glass case before me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
