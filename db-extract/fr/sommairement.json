        "fr-extract.jsonl": [
            {
                "entry_id": "3a04d61a-1d41-3eeb-997b-89251c91f745",
                "word": "sommairement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "83628204-1b0e-3f2b-8a8b-0e8adf80074b",
                        "entry_id": "3a04d61a-1d41-3eeb-997b-89251c91f745",
                        "glosses": [
                            "D’une manière sommaire, en peu de paroles ou d’écrits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85b541a8-fe22-46e9-94d9-d283f94b50a3",
                                "sense_id": "83628204-1b0e-3f2b-8a8b-0e8adf80074b",
                                "text": "Auprès du grand marché [à Mexico] était un palais où l’on rendait sommairement la justice aux marchands, comme dans la juridiction des consuls de Paris, qui n'a été établie que sous le roi Charles IX, après la destruction de l’empire du Mexique […]."
                            },
                            {
                                "example_id": "3f5fec94-193d-4a44-9fe1-a8afe5ac4259",
                                "sense_id": "83628204-1b0e-3f2b-8a8b-0e8adf80074b",
                                "text": "Leibnitz n'a exposé son système que fort sommairement ; pour en avoir la clef, il faut chercher dans plusieurs de ses ouvrages,"
                            },
                            {
                                "example_id": "4cfc4dad-4dc5-4808-993d-243e06ae12d0",
                                "sense_id": "83628204-1b0e-3f2b-8a8b-0e8adf80074b",
                                "text": "Les amendements sont présentés par écrit et sont sommairement motivés."
                            }
                        ]
                    },
                    {
                        "sense_id": "d83b0533-c160-374c-8ece-8eb4e698718b",
                        "entry_id": "3a04d61a-1d41-3eeb-997b-89251c91f745",
                        "glosses": [
                            "Avec peu de moyens, avec peu de rigueur."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "e4124a98-f641-45b6-9a87-b9fef85e0d47",
                                "sense_id": "d83b0533-c160-374c-8ece-8eb4e698718b",
                                "text": "Un homme sommairement vêtu. — Un mur sommairement bâti."
                            },
                            {
                                "example_id": "ddb51f0d-e995-45fe-a9db-a41b57b4f33f",
                                "sense_id": "d83b0533-c160-374c-8ece-8eb4e698718b",
                                "text": "En une minute, il fut sommairement habillé et, sans hésiter, descendit vers le magasin."
                            },
                            {
                                "example_id": "1c56f5ca-a096-4fec-af52-bdc36854a1c8",
                                "sense_id": "d83b0533-c160-374c-8ece-8eb4e698718b",
                                "text": "En huit jours, les marins de l’Atlantic, aidés de quelques Groënlandais attirés par la haute paye offerte, eurent élevé une clôture en fils de fer dont les deux extrémités allaient plonger dans la mer, et construit une cabane en planches qui fut sommairement meublée des objets les plus indispensables."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "860a3126-28a4-40db-bdd8-83597c18128b",
                        "source_entry_id": "3a04d61a-1d41-3eeb-997b-89251c91f745",
                        "source_sense_id": "83628204-1b0e-3f2b-8a8b-0e8adf80074b",
                        "source_sense_description": "D’une manière sommaire, en peu de paroles ou d’écrits",
                        "target_lang_word": "kurz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86babc48-2a26-3152-bad9-7aa36f855486",
                                        "entry_id": "76cb9c4a-95db-3215-bf36-3d14eccab3ee",
                                        "glosses": [
                                            "wenig Länge habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c450686-63eb-4b4d-8542-7054fb89b016",
                                                "sense_id": "86babc48-2a26-3152-bad9-7aa36f855486",
                                                "text": "Es ist ein kurzer Weg bis nach München."
                                            },
                                            {
                                                "example_id": "f73fb32c-d9a4-421a-bd9d-4ee38ef07b54",
                                                "sense_id": "86babc48-2a26-3152-bad9-7aa36f855486",
                                                "text": "Die Tage werden länger und die Röcke kürzer."
                                            },
                                            {
                                                "example_id": "e0002d40-02af-42fc-a468-45b29837dea3",
                                                "sense_id": "86babc48-2a26-3152-bad9-7aa36f855486",
                                                "text": "Nimm das Messer, und dann hier kurz abschneiden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6f114f5-9f53-37e6-9565-0e38f7047d74",
                                        "entry_id": "76cb9c4a-95db-3215-bf36-3d14eccab3ee",
                                        "glosses": [
                                            "wenig Worte benötigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19d3b2c5-a26a-4611-a1aa-71ba1621bf3f",
                                                "sense_id": "e6f114f5-9f53-37e6-9565-0e38f7047d74",
                                                "text": "Luft, Wasser, Milch und Boden, kurz: alles ruiniert - (Brokdorf-Song)"
                                            },
                                            {
                                                "example_id": "83d6c5ac-0b79-4316-9716-224feb498a8c",
                                                "sense_id": "e6f114f5-9f53-37e6-9565-0e38f7047d74",
                                                "text": "Kurz und gut, ich bin pleite."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                        "entry_id": "76cb9c4a-95db-3215-bf36-3d14eccab3ee",
                                        "glosses": [
                                            "wenig Zeit benötigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c0c616e-bf83-42e0-8055-9d81cf05276f",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "„Wenn ich die Route geschafft habe, bin ich kurz glücklich, bald darauf aber traurig, weil ich einen Traum realisiert habe und dieser somit nicht mehr existiert, zitiert Zak den Freikletterer A. Albert.“"
                                            },
                                            {
                                                "example_id": "819d659e-7234-4467-b94c-06678530d718",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "Ich bin nur kurz weg!"
                                            },
                                            {
                                                "example_id": "35c9a26f-0062-4645-be3a-7e5e5afe13f1",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "Könnte ich Sie kurz mal sprechen?"
                                            },
                                            {
                                                "example_id": "7c3301eb-c2ba-4a4a-bee3-5b9d0c8d5c3f",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "Darf ich kurz stören?"
                                            },
                                            {
                                                "example_id": "2daa2b64-50ef-4d0e-9fa9-e1ef2b112a53",
                                                "sense_id": "b34aa4c2-1a3e-35cb-b5d9-ecf733441c81",
                                                "text": "Kannst du heute Abend kurz vorbeischauen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
