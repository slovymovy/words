                "senses": [
                    {
                        "sense_id": "1f79020e-6a5e-37c6-998a-be15b63fcfb2",
                        "entry_id": "9e25be24-fa02-3c42-b4fc-227b03ab2407",
                        "glosses": [
                            "ein preisgünstiges, kleines Notebook, welches sich durch sein kompaktes Design und hohe Mobilität auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d0b46f-e522-4a9a-a918-f43eb3f5591a",
                                "sense_id": "1f79020e-6a5e-37c6-998a-be15b63fcfb2",
                                "text": "Mein Netbook ist mobiler als dein Laptop."
                            },
                            {
                                "example_id": "55f134ea-184e-4d9a-b5aa-0012a54d67f3",
                                "sense_id": "1f79020e-6a5e-37c6-998a-be15b63fcfb2",
                                "text": "„Hinterlassen Netbooks sonst gern mal einen leicht \"trashigen\" Beigeschmack, zeigt sich der neue HP Mini hier von seiner besten Seite.“"
                            },
                            {
                                "example_id": "b7aa9f60-b8b0-4da0-b1d9-f8eef79f7757",
                                "sense_id": "1f79020e-6a5e-37c6-998a-be15b63fcfb2",
                                "text": "„Laut dem Strafbefehl wird auch das Netbook des Studenten, eine Festplatte und ein sogenannter Keylogger eingezogen und vernichtet.“"
                            },
                            {
                                "example_id": "fcb5a0b2-fbec-415b-8da5-de5dfae1c48c",
                                "sense_id": "1f79020e-6a5e-37c6-998a-be15b63fcfb2",
                                "text": "„Und weil die Festplattenkapazität der Netbooks auf 160 Gigabyte beschränkt bleibt – eine Bedingung, die Intel den PC-Herstellern aufzwingt –, sind die kleinen Computer ohnehin nicht in der Lage, grosse Multimedia-Bibliotheken zu fassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
