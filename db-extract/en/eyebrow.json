                        "source_entry_id": "9d8b7031-cc7a-34dd-8ffe-00070bc390a6",
                        "source_sense_description": "hair that grows over the bone ridge above the eye socket",
                        "target_lang_word": "wenkbrauw",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
