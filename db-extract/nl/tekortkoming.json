                                "sense_id": "374666b0-5dac-34ca-9369-e1f40428d9f3",
                                "text": "De tekortkomingen in de productieprocessen hebben geleid tot vertragingen in de levering van de goederen.",
                                "translation": "The lack in the production processes has led to delays in the delivery of the goods.",
                                "english": "The lack in the production processes has led to delays in the delivery of the goods."
                            }
