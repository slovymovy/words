                "senses": [
                    {
                        "sense_id": "052081be-56e2-3557-b92c-ccbc4be8a1b9",
                        "entry_id": "abd387c2-bcdf-3900-95e3-9cb7fee30120",
                        "glosses": [
                            "Donner un caractère religieux à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36f7c1ca-9785-43dd-9d7a-55fad3755de6",
                                "sense_id": "052081be-56e2-3557-b92c-ccbc4be8a1b9",
                                "text": "Le religieux ne relève plus nécessairement d’une institution religieuse mais de la faculté de « religiosiser » divers affects, de donner un sens « religieux » à ce qui, au départ, n’a rien de religieux."
                            },
                            {
                                "example_id": "37315061-f2e6-4c4f-aeaa-2ed386cf836b",
                                "sense_id": "052081be-56e2-3557-b92c-ccbc4be8a1b9",
                                "text": "Je crois qu’il serait dommage de « religiosiser » Camus."
                            }
                        ]
                    }
