                                            {
                                                "example_id": "e97b1036-7c17-40a9-84d1-c5f3d317fd49",
                                                "sense_id": "a44d666c-d92a-3981-8bb7-3a231eb9646d",
                                                "text": "Voor onszelf zou ik deze rasp nooit kopen, ook omdat ik geen zin heb in Laurens schamperende blik ('het lijkt wel een metalen dildo'), maar Marie-Claire geef ik hem graag cadeau als we in Griekenland zijn."
                                            },
                                            {
                                                "example_id": "778533f9-440b-4745-9771-865effd93376",
                                                "sense_id": "a44d666c-d92a-3981-8bb7-3a231eb9646d",
                                                "text": "Voor onszelf zou ik deze rasp nooit kopen, ook omdat ik geen zin heb in Laurens schamperende blik ('het lijkt wel een metalen dildo'), maar Marie-Claire geef ik hem graag cadeau als we in Griekenland zijn."
                                            }
                                        ]
                                    }
