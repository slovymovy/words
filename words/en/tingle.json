    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a2a5e07-bef3-3f85-9157-1dd2209cf53e",
                    "sense_definition": "to feel a prickling or mildly stinging sensation",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My fingers began to <w>tingle</w> after being out in the freezing snow for an hour.",
                            "target_lang_translations": {
                                "ru": "Мои пальцы начало <w>покалывать</w> после того, как я провел час на морозе."
                            }
                        },
                        {
                            "text": "She felt her skin <w>tingle</w> with excitement as the concert was about to begin.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала, как по коже пробежало <w>покалывание</w> от волнения, когда концерт вот-вот должен был начаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "prickle",
                        "sting"
                    ],
                    "common_phrases": [
                        "tingle with excitement",
                        "tingle with cold"
                    ],
                    "target_lang_definitions": {
                        "ru": "испытывать ощущение покалывания или легкого жжения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покалывать",
                                "target_lang_sense_clarification": "о физическом ощущении"
                            },
                            {
                                "target_lang_word": "щипать",
                                "target_lang_sense_clarification": "о коже или глазах"
                            },
                            {
                                "target_lang_word": "зудеть",
                                "target_lang_sense_clarification": "вызывать легкий зуд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8830fa20-1959-3f30-93f0-532806c7343d",
                    "sense_definition": "to cause someone to feel a prickling or mildly stinging sensation",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spicy peppers will <w>tingle</w> your tastebuds and leave a warm heat in your mouth.",
                            "target_lang_translations": {
                                "ru": "Острый перец будет <w>пощипывать</w> ваши вкусовые рецепторы и оставит приятное тепло во рту."
                            }
                        },
                        {
                            "text": "The cold minty lotion started to <w>tingle</w> his skin immediately after application.",
                            "target_lang_translations": {
                                "ru": "Холодный мятный лосьон начал <w>покалывать</w> кожу сразу после нанесения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tingle your tastebuds"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать у кого-либо ощущение покалывания или легкого жжения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покалывать",
                                "target_lang_sense_clarification": "вызывать покалывание"
                            },
                            {
                                "target_lang_word": "пощипывать",
                                "target_lang_sense_clarification": "о специях или лосьонах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21952df0-8844-3d8d-b52d-cb95557fd2e0",
                    "sense_definition": "to ring with a light, metallic sound",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small silver bells <w>tingle</w> softly whenever the door is opened by a customer.",
                            "target_lang_translations": {
                                "ru": "Маленькие серебряные колокольчики тихо <w>звенят</w> каждый раз, когда покупатель открывает дверь."
                            }
                        },
                        {
                            "text": "I could hear the wind chimes <w>tingle</w> in the distance during the quiet night.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как вдалеке в тихую ночь <w>звенят</w> ветряные колокольчики."
