                        ],
                        "form": "подстро́чна"
                    },
                    {
                        "form_id": "5470fe60-0238-4bf2-a026-03629649f965",
                        "entry_id": "bd6ca96a-58a9-3bf1-a26c-d7d91f0a4bf8",
                        "tags": [
                            "plural",
