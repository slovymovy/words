                        "translation_id": "aef10240-dcd2-4dfc-b38d-038f8a8c410f",
                        "source_entry_id": "322d97f6-60c6-3873-ba52-f0f7e70f3418",
                        "source_sense_id": "8eed0f4d-2a17-3731-9601-8f5818a4eef5",
                        "source_sense_description": "adres voor het ontvangen en verzenden van e-mail",
                        "target_lang_word": "E-Mail-Adresse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "E-Mail-Adresse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52cf56a6-4a2f-378e-8b80-e3adc56669e3",
                                        "entry_id": "0180d6fb-3eb5-3cc2-953d-44d63bd41c68",
                                        "glosses": [
                                            "eine eindeutige Absender- und Empfangsadresse für den elektronischen Briefverkehr"
                                        ],
                                        "tags": [
                                            "EDV",
                                            "Kommunikation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cfeb6f3-09f2-42b3-954d-864c2df9f0f2",
                                                "sense_id": "52cf56a6-4a2f-378e-8b80-e3adc56669e3",
                                                "text": "Jeder Student bekommt bei der Immatrikulation eine E-Mail-Adresse für studentische Zwecke zugewiesen."
                                            },
                                            {
                                                "example_id": "0b40aa78-f370-4084-af41-8759b582ca09",
                                                "sense_id": "52cf56a6-4a2f-378e-8b80-e3adc56669e3",
                                                "text": "Mein Internetdienstanbieter erlaubt es mir, mehrere E-Mail-Adressen nach meinen Wünschen einzurichten."
                                            },
                                            {
                                                "example_id": "c11f1a9c-1641-4784-9d9b-998cb182a7f9",
                                                "sense_id": "52cf56a6-4a2f-378e-8b80-e3adc56669e3",
                                                "text": "Um das Paket zu installieren, muss der Benutzer eine gültige E-Mail-Adresse angeben."
                                            },
                                            {
                                                "example_id": "bf4891dd-0e55-4a32-b8df-62cf863c2a27",
                                                "sense_id": "52cf56a6-4a2f-378e-8b80-e3adc56669e3",
                                                "text": "Auf Joseph Kardinal Ratzinger kommt als Papst Benedikt XVI. viel Arbeit zu. Er ist Besitzer einer eigenen E-Mail-Adresse."
                                            },
                                            {
                                                "example_id": "92c4c0d3-7750-4275-a532-3bfd68ee7769",
                                                "sense_id": "52cf56a6-4a2f-378e-8b80-e3adc56669e3",
                                                "text": "„Irgendwann suchte er im Netz nach der E-Mail-Adresse von Wolf Singer, einem renommierten Neurowissenschaftler, von dem er einige Bücher gelesen hatte.“"
                                            },
                                            {
                                                "example_id": "1c39b2db-e3b9-4083-9aec-f2e21931daab",
                                                "sense_id": "52cf56a6-4a2f-378e-8b80-e3adc56669e3",
                                                "text": "„Okay, dann müssen wir Folgendes machen: Du mailst mir deine Fax-Nummer, und ich werde dir meine E-Mail-Adresse senden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
