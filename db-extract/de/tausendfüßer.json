                "translations": [
                    {
                        "translation_id": "cb7a59b5-5c6e-4a7f-98a3-44e21882d7b9",
                        "source_entry_id": "7cc659df-37ca-3250-905c-8cc057e04378",
                        "source_sense_id": "23b0bf7d-2af9-3ac8-a371-1cd2d7f3c14a",
                        "source_sense_description": "nur Plural: Myriapoda, eine Untergruppe der Tracheentiere",
                        "target_lang_word": "myriapod",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myriapod",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbf5e128-ce7b-3917-a141-6c8248caafc5",
                                        "entry_id": "971a7332-6682-3be8-8b30-ee970ebcaec3",
                                        "glosses": [
                                            "Any arthropod (such as centipedes and millipedes) of the subphylum Myriapoda."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81a295a1-7141-4fc7-ab46-868b927951dc",
                        "source_entry_id": "7cc659df-37ca-3250-905c-8cc057e04378",
                        "source_sense_id": "23b0bf7d-2af9-3ac8-a371-1cd2d7f3c14a",
                        "source_sense_description": "nur Plural: Myriapoda, eine Untergruppe der Tracheentiere",
                        "target_lang_word": "centipede",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centipede",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                        "entry_id": "4e9afd66-0b9a-3a59-a21b-dc308533c030",
                                        "glosses": [
                                            "Any arthropod of class Chilopoda, which have a segmented body with one pair of legs per segment and from about 20 to 300 legs in total."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4374c3fb-5dba-480a-b4ab-17f20ac3ece1",
                                                "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                                "text": "Centipedes differ from millipedes by having a single pair of legs on each body segment."
                                            },
                                            {
                                                "example_id": "96686866-bb91-476d-8614-ac4c115e709b",
                                                "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                                "text": "The existence of millipedes, centipedes, insects, and spiders along-side the first tetrapods sustained a robust ecosystem in which most animals were predators or scavengers."
                                            },
                                            {
                                                "example_id": "30ad95fa-d7c9-4868-aaff-4d6249ef810a",
                                                "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                                "text": "All centipedes (Chilopoda) and spiders (Aranea) are predatory and although they are often found on corpses their impact on the other fauna is not known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bfa6b51-06ed-3ac0-951a-91d9272d4b90",
                                        "entry_id": "4e9afd66-0b9a-3a59-a21b-dc308533c030",
                                        "glosses": [
                                            "A many-oared Chinese smuggling boat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0062fec2-9303-4953-a86e-f9a7323b15a5",
                        "source_entry_id": "7cc659df-37ca-3250-905c-8cc057e04378",
                        "source_sense_id": "23b0bf7d-2af9-3ac8-a371-1cd2d7f3c14a",
                        "source_sense_description": "nur Plural: Myriapoda, eine Untergruppe der Tracheentiere",
                        "target_lang_word": "millipede",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millipede",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                        "entry_id": "6be5358a-f4c9-3ab3-9925-52bbf218832a",
                                        "glosses": [
                                            "Any of many elongated arthropods, of the class Diplopoda, with cylindrical bodies that have two pairs of legs for each one of their 20 to 100 or more body segments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "273903be-bac3-4999-bda9-3344fb81af60",
                                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                                "text": "The ſaid leaves alſo ſtamped with honey and brought to the forme of a cataplaſme, cure the bloudie-falls or night-blains: but tempered with wine, they heale the bitings of dogs, as alſo of the Millepeed, which the Greeks call Seps, a long worm with hairie feet, doing much harme to cattaile eſpecially; for looke where it biteth, the place preſently ſwelleth and putrifieth."
                                            },
                                            {
                                                "example_id": "9019d7f4-dbe9-4176-bb68-d6914a78df01",
                                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                                "text": "With one or two exceptions, male millipedes make direct contact with the female and transfer sperm via a pair of modified front legs (gonopods) which have been charged with semen from the genitalia situated towards the rear of the body."
                                            },
                                            {
                                                "example_id": "1c7b61f3-16bf-48f6-aff2-1bc0914be1a4",
                                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                                "text": "When alive, millipedes maintain tension in these^([intersegmental]) muscles and are therefore difficult to straighten out when coiled."
                                            },
                                            {
                                                "example_id": "1a82886e-fb9b-4c33-a274-09c1ca6c2475",
                                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                                "text": "Soil millipedes (Diplopoda) possess a specific gut microbiota that differs from microbial communities in soil and leaf litter."
                                            },
                                            {
                                                "example_id": "413f3ebd-762e-428e-a934-01c128d95579",
                                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                                "text": "Working with her colleague Henrik Enghoff, the two discovered several specimens of the same fungus on North American millipedes right there in the Natural History Museum’s collection."
                                            },
                                            {
                                                "example_id": "2348fa89-927d-430e-b1e5-1b368a3ac98a",
                                                "sense_id": "e2e3fff9-753c-353f-afd7-abe07e09ba0b",
                                                "text": "An entomologist named a new species of millipede Nannaria swiftae after pop star Taylor Swift."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4f729f0-58b3-40e1-ba54-bc9bcf298ac6",
                        "source_entry_id": "7cc659df-37ca-3250-905c-8cc057e04378",
                        "source_sense_id": "23b0bf7d-2af9-3ac8-a371-1cd2d7f3c14a",
