                    "frequency": "High",
                    "semantic_group_id": "accord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs jours de <w>négociation</w>, les deux pays ont enfin signé un traité de paix."
                        },
