        "nl-extract.jsonl": [
            {
                "entry_id": "0321ae0f-b2a6-39c5-9ea0-71373fce9e64",
                "word": "terreur",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c9dadb3a-3b88-34b6-8b6c-2d87aa2f93c3",
                        "entry_id": "0321ae0f-b2a6-39c5-9ea0-71373fce9e64",
                        "glosses": [
                            "georganiseerde geweldpleging om politieke of andere doelen te bereiken"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7baa8ee-0637-4fd3-8e12-937163b27131",
                        "source_entry_id": "0321ae0f-b2a6-39c5-9ea0-71373fce9e64",
                        "source_sense_id": "c9dadb3a-3b88-34b6-8b6c-2d87aa2f93c3",
                        "target_lang_word": "Terror",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Terror",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e26b3a0-e1b8-3c9e-9b53-49a604daf214",
                                        "entry_id": "5216c137-c41a-35ab-b1ba-7f0ecd3aaa85",
                                        "glosses": [
                                            "Gewalttaten einer bestimmten Gruppe von Menschen, zum Beispiel Bombenanschläge oder Morde, um bestimmte Ziele durchzusetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f42a5cf7-e205-4a2b-a36e-189130e541c8",
                                                "sense_id": "7e26b3a0-e1b8-3c9e-9b53-49a604daf214",
                                                "text": "Terroristen benutzen Terror als Mittel zur Erzwingung ihrer politischen Ziele."
                                            },
                                            {
                                                "example_id": "f07a57b6-588a-448a-85b1-e4f32274c5a0",
                                                "sense_id": "7e26b3a0-e1b8-3c9e-9b53-49a604daf214",
                                                "text": "„Dieser Einwand kursierte, seit der Terror des Pariser Wohlfahrtsausschusses viele deutsche Schriftsteller und Gelehrte über ihre eigene Courage hatte so erschrecken lassen, dass sie auch mental wieder zu jener Ordnung zurückkehrten, die von ihnen politisch ohnehin nie infrage gestellt worden war.“"
                                            },
                                            {
                                                "example_id": "0454a45c-5b55-4d6f-8a80-55e27a05cc89",
                                                "sense_id": "7e26b3a0-e1b8-3c9e-9b53-49a604daf214",
                                                "text": "„Gerhard Baum als Bundesinnenminister bewies, dass die Herausforderung durch den Terror keinen Freibrief für den Abbau von Bürgerrechten rechtfertigte.“"
                                            },
                                            {
                                                "example_id": "65f00dfc-a726-4dc5-8d4e-bc0d890bf0af",
                                                "sense_id": "7e26b3a0-e1b8-3c9e-9b53-49a604daf214",
                                                "text": "Noch immer kommen der Berlinerin [Sara Sliwka] die Tränen, wenn sie vom Terror ihrer Kindheit berichtet: von der Verhaftung im heimatlichen Czestochowa sowie von ihrer anschließenden Schufterei im Getto, im Arbeitslager und im KZ."
                                            },
                                            {
                                                "example_id": "e5c7844a-361d-4096-8299-6a910596dc93",
                                                "sense_id": "7e26b3a0-e1b8-3c9e-9b53-49a604daf214",
                                                "text": "„Der islamistische Fundamentalismus hatte besorgniserregende Ausmaße angenommen; nach London war jetzt auch Brüssel zu einem Heiligtum des Terrors geworden.“"
                                            },
                                            {
                                                "example_id": "bd0111d1-5bb2-4c47-a3e9-4a02bebb9ccc",
                                                "sense_id": "7e26b3a0-e1b8-3c9e-9b53-49a604daf214",
                                                "text": "„Rechter Terror ist keine leidige gesellschaftliche Randerscheinung, sondern ein akutes Problem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a00a5f13-194f-3697-9d96-54a3296e7ab9",
                                        "entry_id": "5216c137-c41a-35ab-b1ba-7f0ecd3aaa85",
                                        "glosses": [
                                            "länger andauernde, systematische Verbreitung von Angst und Schrecken, um andere einzuschüchtern und schließlich zu beherrschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb1e0d94-0233-4773-833b-4244833f9cd0",
                                                "sense_id": "a00a5f13-194f-3697-9d96-54a3296e7ab9",
                                                "text": "Wenn ich meine Hausübungen nicht bringe, üben meine Lehrer Terror auf mich aus."
                                            },
                                            {
                                                "example_id": "c1b4dcd5-ab5d-4fc6-a4e9-6ca36f10e4c2",
                                                "sense_id": "a00a5f13-194f-3697-9d96-54a3296e7ab9",
                                                "text": "„Nicht einmal die gruseligen Berichte über Terror und Guillotine können die Burgunder von ihrem Hunger ablenken.“"
                                            },
                                            {
                                                "example_id": "bb37bc29-04be-4c19-9993-58a37988fefd",
                                                "sense_id": "a00a5f13-194f-3697-9d96-54a3296e7ab9",
                                                "text": "„Der Terror hat zugenommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f543ea38-9aa4-38a7-924b-45c33d997b38",
                                        "entry_id": "5216c137-c41a-35ab-b1ba-7f0ecd3aaa85",
                                        "glosses": [
                                            "anhaltende, belastende Auseinandersetzung/Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be2b61a-8f2c-40de-a140-d7f62fca1bb5",
                                                "sense_id": "f543ea38-9aa4-38a7-924b-45c33d997b38",
                                                "text": "Bei uns zu Hause herrscht der reinste Terror, seit meine Schwester unseren Eltern den Krieg erklärt hat."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "071b18ac-ebf7-4297-b04f-928292f1ec06",
                        "source_entry_id": "0321ae0f-b2a6-39c5-9ea0-71373fce9e64",
                        "source_sense_id": "c9dadb3a-3b88-34b6-8b6c-2d87aa2f93c3",
                        "target_lang_word": "terror",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "Intense dread, fright, or fear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fabdba5a-06db-4876-9ad2-c79a34c27a6d",
                                                "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                                "text": "\"How thinkest thou that I rule this people? I have but a regiment of guards to do my bidding, therefore it is not by force. It is by terror. My empire is of the imagination.\""
                                            },
                                            {
                                                "example_id": "020f42f0-0214-4fab-9570-ba2c04d09bef",
                                                "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                                "text": "The terrors with which I was seized […] were extreme."
                                            },
                                            {
                                                "example_id": "04080c1a-eb8b-4907-b683-0bc067a17f49",
                                                "sense_id": "a14b19d6-e943-38bb-81cc-7fd968a8fc07",
                                                "text": "Fear of their cargo bred a savage cruelty into the crew. One captain, to strike terror into the rest, killed a slave and dividing heart, liver and entrails into 300 pieces made each of the slaves eat one, threatening those who refused with the same torture. Such incidents were not rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b70f8dd0-2847-32dd-a3ee-ce3810211a8b",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "The action or quality of causing dread; terribleness, especially such qualities in narrative fiction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "Something or someone that causes such fear."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35afdbab-ad88-419c-b67d-cb5c2315f934",
                                                "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                                "text": "The Begums' ministers, on the contrary, to extort from them the disclosure of the place which concealed the treasures, were, […] after being fettered and imprisoned, led out on to a scaffold, and this array of terrours proving unavailing, the meek tempered Middleton, as a dernier resort, menaced them with a confinement in the fortress of Chunargar. Thus, my lords, was a British garrison made the climax of cruelties!"
                                            },
                                            {
                                                "example_id": "dc3f0cd8-2604-489c-aa2a-d410ed687f85",
                                                "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                                "text": "The terrors of the storm"
                                            },
                                            {
                                                "example_id": "923288e4-79e1-4dc4-a16c-beb35aecea83",
                                                "sense_id": "3d2133ae-518a-3598-ba96-33e58c2f1b37",
                                                "text": "A chap named Eleazir Kendrick and I had chummed in together the summer afore and built a fish-weir and shanty at Setuckit Point, down Orham way. For a spell we done pretty well. Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "Terrorism."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d73de9df-6d74-4d6e-ae2d-964f74fd4691",
                                                "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                                "text": "a terror attack"
                                            },
                                            {
                                                "example_id": "86bffb05-5e79-4808-b0af-e1fb163f71ef",
                                                "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                                "text": "the War on Terror"
                                            },
                                            {
                                                "example_id": "8b4cc247-41ab-4a15-802e-4bfcc9e51db4",
                                                "sense_id": "2358d86a-472e-3c26-885b-0b5766e6b19b",
                                                "text": "Rank-and-file progressives don’t usually think of the immigration policies they support—expanding refugee quotas, easing restrictions on some classes of immigrants, and ending family separation—as an endorsement of detention, deportation, and racialized terror."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd089fd2-98ca-3087-b19b-71216dd6ff52",
                                        "entry_id": "60014f4b-2208-3807-b2c7-6d6e6640c0e3",
                                        "glosses": [
                                            "A night terror."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "terror",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc657e79-8ced-3f1f-9757-2f7ae7bf0705",
                                        "entry_id": "7662ffa1-702a-3444-94bd-a1d9cefd81d0",
                                        "glosses": [
                                            "A strict teacher who fails most of the students."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2354b730-5a18-46ff-a943-baf3be40d4ab",
                                                "sense_id": "fc657e79-8ced-3f1f-9757-2f7ae7bf0705",
                                                "text": "I have a terror math teacher."
                                            }
                                        ]
