                                        "entry_id": "46cf5ec6-f135-37db-9cb3-b8a6cc7d1ee7",
                                        "glosses": [
                                            "die vertikale Dimension/Höhe, die bei Kleinbuchstaben wie <g>, <j>, <q> unter die Mittellänge reicht"
                                        ],
                                        "tags": [
                                            "speziell Typographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6d9f3d9-b3a6-4ace-891d-3a3c768e379a",
                                                "sense_id": "1e82d3f3-9c7e-3044-87c7-8c0d310e385c",
                                                "text": "„Im Gegensatz zu den Kapitalis-Schriften bestimmten in zunehmendem Maße die neu auftretenden Ober- und Unterlängen der Buchstaben b, d, h, i, l, g, p und q das Schriftbild.“"
                                            },
                                            {
                                                "example_id": "d59998a3-48a1-4037-965b-54972892b94f",
                                                "sense_id": "1e82d3f3-9c7e-3044-87c7-8c0d310e385c",
                                                "text": "„Insgesamt treten etwas mehr Unterlängen auf als sonst in Dincklages Handschrift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
