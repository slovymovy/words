                "senses": [
                    {
                        "sense_id": "03fc7555-3176-3427-bb4a-a8df3e54f275",
                        "entry_id": "dfa916dc-b802-33c9-ad34-4829e4360c50",
                        "glosses": [
                            "organische Säure, die oft in Harzen vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2240d0f7-1641-470f-94b0-c43fdfaa0979",
                                "sense_id": "03fc7555-3176-3427-bb4a-a8df3e54f275",
                                "text": "\"Aus dem Harz der unreifen Zapfen kann Isopimarinsäure gewonnen werden, die eine antibakterielle Wirkung hat und gegen den multiresistenten Erreger Staphylococcus aureus eingesetzt werden kann.\""
                            },
                            {
                                "example_id": "3efc15fe-520d-41ca-ae50-89e23a459453",
                                "sense_id": "03fc7555-3176-3427-bb4a-a8df3e54f275",
                                "text": "\"Bei den Harzsäuren treten besonders im Gehalt an Abietin-, Neoabietin-, und Isopimarinsäure größere Differenzen auf.\""
                            },
                            {
                                "example_id": "ef796fcc-8ab3-41cc-bd96-9ea67839d33a",
                                "sense_id": "03fc7555-3176-3427-bb4a-a8df3e54f275",
                                "text": "\"Zu geeigneten nicht phenolhaltigen Klebrigmachern gehören eine oder mehrere Abietinsäurearten wie etwa Abietinsäure, Neoabietinsäure, Palustrinsäure, Dihydroabietinsäure, Tetrahydroabietinsäure, Dehydroabietinsäure und ihre Ester sowie Pimarinsäurearten wie etwa Pimarinsäure, Isopimarinsäure, dehydrierte Versionen davon und ihre Ester.\""
                            },
                            {
                                "example_id": "8a24926a-7659-4fc0-93ed-ac4521bc948c",
                                "sense_id": "03fc7555-3176-3427-bb4a-a8df3e54f275",
                                "text": "\"Mit Isopimarinsäure und Sandaracopimarinsäure aus Biota orientalis konnten im Rahmen dieser Masterarbeit zwei neue GABAA-Rezeptor-aktive Diterpene identifiziert und isoliert werden, die interessante Leitstrukturen in der Entwicklung von neuartigen, möglicherweise selektiven GABAA-Rezeptor-Liganden darstellen.\""
                            },
                            {
                                "example_id": "31c26b13-e708-4ec4-8aba-3dbabb1f9933",
                                "sense_id": "03fc7555-3176-3427-bb4a-a8df3e54f275",
                                "text": "\"Neben der Abietinsäure ((CH3)4C15H17COO(H)) sind auch Neoabietinsäure, Palustrinsäure oder Dehydroabietinsäure einsetzbar, für die Pimarsäure ((CH3)3(CH2)C15H23COO(H)) seien die Levopimarinsäure und die Isopimarinsäure genannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
