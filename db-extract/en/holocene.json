                        "entry_id": "a9e83090-847d-3f81-9a11-db943161a6bf",
                        "glosses": [
                            "Of a geologic epoch within the Quaternary period from about the year 10 000 BC to the present; the age of man."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
