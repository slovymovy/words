                    {
                        "form_id": "dd9b8a93-bbc7-4921-b128-c8b3ff9ab586",
                        "entry_id": "7a58d118-b160-3440-bea1-cfe725efd516",
                        "tags": [
                            "accusative",
                            "definite",
