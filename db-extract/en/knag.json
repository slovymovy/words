                    {
                        "sense_id": "0ec603d3-c7f6-37c4-ad1d-897ad7e0d3e5",
                        "entry_id": "df205246-cfa9-35a4-9a53-4a3dc3f70089",
                        "glosses": [
                            "der Knoten"
                        ],
                        "tags": [],
