                                "target_senses": [
                                    {
                                        "sense_id": "efe0fed0-8620-3e58-b247-02a84de038f7",
                                        "entry_id": "bea71b0e-2847-30f8-94dd-a663d368ef12",
                                        "glosses": [
                                            "Appareil électronique ou mécanique, que l’on trouve notamment dans les casinos, et qui permet des mises automatiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4f476ae-b909-474f-a1a0-a42db2d6fd4f",
                                                "sense_id": "efe0fed0-8620-3e58-b247-02a84de038f7",
                                                "text": "Près d’un an plus tôt, l’adolescent avait indigné Monsieur de C. en refusant d’entrer dans la chambre de la mourante : à en croire son père, il aurait passé ces quelques journées atroces à manœuvrer, à la foire, des machines à sous."
                                            },
                                            {
                                                "example_id": "d7e56f98-1d8d-4035-a36b-ef3719edd196",
                                                "sense_id": "efe0fed0-8620-3e58-b247-02a84de038f7",
                                                "text": "Peu après, ils étaient assis face à face dans un bar puant, avec le bruit des machines à sous en toile de fond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b905e25b-1b1e-391d-a918-9a3320284024",
                                        "entry_id": "bea71b0e-2847-30f8-94dd-a663d368ef12",
                                        "glosses": [
                                            "Jeu de hasard qui se joue avec cette machine."
                                        ],
