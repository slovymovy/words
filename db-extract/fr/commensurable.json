                                                "sense_id": "9e54093f-a1bb-3831-8776-a4e352570808",
                                                "text": "For that division is not naturally founded, but artificially set down, and by agreement, as the aptest terms to define or commensurate the longitude of places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a577044-bfbc-3bb3-939e-e0f2cdaa9114",
                                        "entry_id": "1c1b81b8-773f-30a2-8954-5014039bdb4a",
                                        "glosses": [
                                            "To proportionate; to adjust."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
