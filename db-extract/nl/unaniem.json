                        "examples": [
                            {
                                "example_id": "e1294985-27e5-43b2-87ef-a7e6fe031b14",
                                "sense_id": "67a1b3a3-2173-3f6b-91d1-1abecd9c7cc8",
                                "text": "De leiders van de 27 overblijvende EU-lidstaten hebben zaterdag een unaniem akkoord bereikt over richtlijnen voor de onderhandelingen over de Britse uittreding uit de Europese Unie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c56b6a2f-8959-4b2b-8595-79afdb9e3cc8",
                        "source_entry_id": "88a8080a-7878-344c-9d66-b940442f39ac",
                        "source_sense_id": "67a1b3a3-2173-3f6b-91d1-1abecd9c7cc8",
                        "source_sense_description": "met eenheid van stemmen",
                        "target_lang_word": "einstimmig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
