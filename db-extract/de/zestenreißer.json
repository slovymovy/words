                        "entry_id": "703db84f-44a3-31d5-8993-7e76fe930d4a",
                        "glosses": [
                            "Halter mit einer mit Aussparungen versehenen Klinge, mit der man hauchdünne Streifen, zum Beispiel von der Schale von Zitrusfrüchten, abschaben kann"
                        ],
                        "tags": [
                            "Küchengerät"
                        ],
                        "examples": [
                            {
                                "example_id": "24b00a5f-5032-4bb4-be00-f5963a69ea97",
                                "sense_id": "a7343a0a-ae49-346c-9bfc-12832bc834d3",
                                "text": "„Halten Sie die Frucht in der einen Hand und den Zestenreißer in der anderen und fahren Sie mit dem Zestenreißer der Länge nach an der Frucht entlang. Die Schale wird dabei in feinen Streifen von der Unterschale gelöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
