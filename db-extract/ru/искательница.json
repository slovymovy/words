                                                "sense_id": "bad4b2ff-3a6a-3228-877e-b5f72b2785d3",
                                                "text": "Missile à tête chercheuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54bfbe1b-9b68-462a-bfad-1b0a7ed241a9",
                        "source_entry_id": "e3c1be15-f573-3fb8-9b25-95068018ee5d",
                        "source_sense_id": "7640e5c8-bdce-3875-8732-24619806a650",
                        "target_lang_word": "fureteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fureteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14cccdd6-04c8-3cb7-a63e-b02de0fe7911",
                                        "entry_id": "6a19f053-2836-3930-ad41-f2a250be223f",
                                        "glosses": [
                                            "Celle qui fouille, qui cherche partout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "112026e5-8f4d-4c02-a31b-c51d5fcca5f1",
                                                "sense_id": "14cccdd6-04c8-3cb7-a63e-b02de0fe7911",
                                                "text": "Voilà qui semblait lui promettre un tas de surprises, toujours passionnantes pour une fureteuse comme elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab5c74d0-f4e5-3385-8d4d-8649804796fe",
                                        "entry_id": "6a19f053-2836-3930-ad41-f2a250be223f",
                                        "glosses": [
                                            "Celle qui est en quête de curiosités, de bibelots, d’estampes anciennes et tout particulièrement de celui, de celle qui fouille dans les vieux papiers, archives, journaux, documents inédits à la recherche de détails inconnus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbc6328-d433-410c-849a-9539a63d6e79",
                                                "sense_id": "ab5c74d0-f4e5-3385-8d4d-8649804796fe",
                                                "text": "Je suis une fureteuse… Or, que ne trouve- t-on pas dans les greniers ?…"
                                            },
                                            {
                                                "example_id": "84c5de85-27b9-4d3c-8d57-843ecd82a896",
                                                "sense_id": "ab5c74d0-f4e5-3385-8d4d-8649804796fe",
                                                "text": "La curiosité, le flair, les trouvailles d’une fureteuse."
