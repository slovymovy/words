                        "examples": [
                            {
                                "example_id": "fd1313ec-0878-4856-bf2b-a60379274733",
                                "sense_id": "78a54044-da91-34ba-8218-42c9961e2b22",
                                "text": "Er stond al een rij bij de steiger van vishandelaar Brown om Sandhamn-schol te kopen, die Brown even snel schoonmaakte en fileerde als opa Oscar."
                            },
                            {
                                "example_id": "96f03347-dc7d-4076-898f-3b5f674e457f",
                                "sense_id": "78a54044-da91-34ba-8218-42c9961e2b22",
                                "text": "De 66-jarige Lim is de zoon van een vishandelaar uit Singapore, verdiende geld met de effectenhandel en werd miljardair door investeringen in palmolie, vastgoed en de gezondheidszorg. Zijn grootste liefhebberij: voetbal."
                            }
                        ]
                    }
