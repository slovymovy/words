                "senses": [
                    {
                        "sense_id": "be481d56-9b15-34ec-8722-63ffc9c835f3",
                        "entry_id": "7b221fb4-cf0b-3f42-9a7d-c32128ea4f2b",
                        "glosses": [
                            "przezroczysta zasłona na twarz stanowiąca przybranie damskiego kapelusza"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26afd61c-311e-427a-800b-79bae5a6da98",
                                "sense_id": "be481d56-9b15-34ec-8722-63ffc9c835f3",
                                "text": "Przynieś mi ciemny płaszczyk i czarny kapelusz z woalką"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9e6e49b-374b-41b4-a989-5161424c86f0",
                        "source_entry_id": "7b221fb4-cf0b-3f42-9a7d-c32128ea4f2b",
                        "source_sense_id": "be481d56-9b15-34ec-8722-63ffc9c835f3",
                        "target_lang_word": "вуаль",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вуаль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "82856388-bf1d-3e2d-9493-6e00f8907504",
                                        "entry_id": "01d60ad8-1285-34e0-9450-39781803fcdf",
                                        "glosses": [
                                            "кусок тонкой прозрачной ткани или сетки, прикрепляемый к женской шляпе и обычно закрывающий лицо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1cac410-d551-4181-95c3-7ce0a5f82814",
                                                "sense_id": "82856388-bf1d-3e2d-9493-6e00f8907504",
                                                "text": "На ней средневековое платье красного бархата и высокий колпак со спадающей вуалью"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "121e7c0a-012b-3937-b3ca-eb778ec4e37e",
                                        "entry_id": "01d60ad8-1285-34e0-9450-39781803fcdf",
                                        "glosses": [
                                            "лёгкая прозрачная ткань"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e08e9e33-e374-4a07-be7b-6a4741316299",
                                                "sense_id": "121e7c0a-012b-3937-b3ca-eb778ec4e37e",
                                                "text": "Последний из портретов завешен чёрной вуалью"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b0bb34-076e-3de2-b999-82b8ef326b36",
                                        "entry_id": "01d60ad8-1285-34e0-9450-39781803fcdf",
                                        "glosses": [
                                            "книжн. то, что делает неясным, скрывает истинное положение вещей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deebf5ff-cc9a-4884-afbe-b44692ea0bce",
                                                "sense_id": "86b0bb34-076e-3de2-b999-82b8ef326b36",
                                                "text": "Легкая, почти неуловимая вуаль печали скользнула по ее лицу и прошла"
                                            },
                                            {
                                                "example_id": "54c4d281-d3fc-446c-a4fb-c3bedadf8f7f",
                                                "sense_id": "86b0bb34-076e-3de2-b999-82b8ef326b36",
                                                "text": "Последнюю неделю, если не бывает дождя, собаки с поиска в траве являются покрытыми такой густой вуалью паутины, что вероятно едва ли видят свет"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e45b7d4e-1a34-387e-8d62-efde6eb57137",
                                        "entry_id": "01d60ad8-1285-34e0-9450-39781803fcdf",
                                        "glosses": [
                                            "фотогр. то же, что фотографическая вуаль; нежелательная оптическая плотность, возникающая в проявленном фотоматериале в местах, на которые не попадал экспонирующий свет"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d18dde2-b499-4d6f-b2f2-317cb2f78dbe",
                                                "sense_id": "e45b7d4e-1a34-387e-8d62-efde6eb57137",
                                                "text": "Как известно, снимок с годами слабеет или покрывается вуалью ― недаром на футлярах всегда указывается срок, после которого фабрика не ручалась за отчетливость изображения."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
