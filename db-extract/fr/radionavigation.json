                    {
                        "sense_id": "7a778bdc-b0ca-3ccf-a72b-fd369751d585",
                        "entry_id": "487324b3-73f9-3e27-9725-2921ebcc6f14",
                        "glosses": [
                            "Technique de positionnement qui utilise les ondes radioélectriques pour déterminer la position, la direction ou la célérité d’un mobile (comme un avion, un navire ou un véhicule terrestre), en se basant sur les signaux émis ou reçus par des stations radio fixes ou satellites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2dc0450-56cc-4d5c-bb62-d6cd87c027d6",
                                "sense_id": "7a778bdc-b0ca-3ccf-a72b-fd369751d585",
                                "text": "Un système de radionavigation est passif, le mobile déterminant sa position a partir des signaux reçus, sans émetteur à bord alors qu’un système de radiolocalisation est un système actif avec transmission entre mobile et base, permettant le suivi d'un mobile (navire, véhicule, bouée) depuis un poste central."
                            }
                        ]
                    }
                ],
