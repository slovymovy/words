    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "646fcb5d-9100-308c-ad06-c5454ac991e9",
                    "sense_definition": "The state, quality, or period of being young or youthful.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "youth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tree takes several years to transition from <w>juvenility</w> to its reproductive stage.",
                            "target_lang_translations": {
                                "ru": "Дереву требуется несколько лет, чтобы перейти из <w>ювенильного состояния</w> в стадию плодоношения."
                            }
                        },
                        {
                            "text": "His playful spirit and curiosity reflected an enduring <w>juvenility</w> that charmed his colleagues.",
                            "target_lang_translations": {
                                "ru": "Его игривый нрав и любознательность отражали неувядающую <w>молодость</w> души, которая очаровывала его коллег."
                            }
                        }
                    ],
                    "synonyms": [
                        "youthfulness",
                        "youth"
                    ],
                    "antonyms": [
                        "senility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, свойство или период молодости, юношества или ювенильности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молодость",
                                "target_lang_sense_clarification": "период или состояние юности"
                            },
                            {
                                "target_lang_word": "юношеский возраст",
                                "target_lang_sense_clarification": "период взросления или развития"
                            },
                            {
                                "target_lang_word": "ювенильность",
                                "target_lang_sense_clarification": "биологическая незрелость, ювенильная фаза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88278779-428a-3255-935a-ebae2a277058",
                    "sense_definition": "Immature or childish behavior, mannerisms, or creative work.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "immaturity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic dismissed the author's early poems as mere <w>juvenilities</w> lacking technical skill.",
                            "target_lang_translations": {
                                "ru": "Критик отверг ранние стихотворения автора как простые <w>юношеские незрелые пробы</w>, лишенные технического мастерства."
                            }
                        },
                        {
                            "text": "We expected professional conduct, but he continually disappointed us with his petty <w>juvenility</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ожидали профессионального поведения, но он постоянно разочаровывал нас своим мелким <w>ребячеством</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "immaturity",
                        "childishness",
                        "puerility"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незрелое или детское поведение, манеры либо незрелые юношеские сочинения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детскость",
                                "target_lang_sense_clarification": "незрелость в поведении"
                            },
                            {
                                "target_lang_word": "ребячество",
                                "target_lang_sense_clarification": "незрелое, ребяческое поведение"
                            },
                            {
                                "target_lang_word": "юношеские пробы пера",
                                "target_lang_sense_clarification": "ранние, незрелые произведения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}