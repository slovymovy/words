                "senses": [
                    {
                        "sense_id": "85ac5faf-babd-390c-92cc-c4e05febf39b",
                        "entry_id": "8e80da45-ad5d-3c31-add8-14bde9d87e37",
                        "glosses": [
                            "Wohlgeruch einer Blume/von Blumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1860677-a75a-461e-9d74-dc85c65985de",
                                "sense_id": "85ac5faf-babd-390c-92cc-c4e05febf39b",
                                "text": "„Der Mond war hinter dem Giebel des kleinen Hauses hervorgekommen; starker, wunderbarer Blumenduft drang aus dem altmodischen Garten, an dessen derbem Zaun sie standen.“"
                            },
                            {
                                "example_id": "eaebad8b-1d7a-4a75-89f7-b9ac1fc4719d",
                                "sense_id": "85ac5faf-babd-390c-92cc-c4e05febf39b",
                                "text": "„Durch das Fenster kam Blumenduft.“"
                            },
                            {
                                "example_id": "0f2b0c57-a1b3-45ff-8987-ea4685a266d4",
                                "sense_id": "85ac5faf-babd-390c-92cc-c4e05febf39b",
                                "text": "„Die Luft war etwas schwer von Blumenduft und Ofendunst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
