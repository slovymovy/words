                ],
                "senses": [
                    {
                        "sense_id": "c5fade5c-b88a-3f34-8aaf-8ff78de0c545",
                        "entry_id": "d8ff19e1-d212-3fda-913f-2bd393dfcd72",
                        "glosses": [
                            "szybko obracający się sztywny obiekt zachowujący stały kierunek osi obrotu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db626f19-1e75-406a-b14e-d4ad97ec023a",
                                "sense_id": "c5fade5c-b88a-3f34-8aaf-8ff78de0c545",
                                "text": "Załoga Endeavoura przymocuje do stacji ważącą 2, 5 tony konstrukcję kratową modułu łącznikowego ITS S5 Truss, wymieni żyroskop pomocny w określaniu położenia statku, przeładuje na stację sprzęt oraz części zamienne, a także przetestuje system, który pozwoli promowi ewentualnie pozostać dłużej na orbicie dzięki pobieraniu z ISS energii elektrycznej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1e6bb4eb-d2eb-3239-bda3-c5755c2b6c7f",
                        "entry_id": "d8ff19e1-d212-3fda-913f-2bd393dfcd72",
                        "glosses": [
                            "kompas wykorzystujący właściwości żyroskopu (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b40ba40-a58c-4872-a216-be093b95fa78",
                                "sense_id": "1e6bb4eb-d2eb-3239-bda3-c5755c2b6c7f",
                                "text": "Nawigator spoglądał na żyroskop."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "736341de-9958-4752-8b13-f7953250ab6d",
                        "source_entry_id": "d8ff19e1-d212-3fda-913f-2bd393dfcd72",
                        "source_sense_id": "c5fade5c-b88a-3f34-8aaf-8ff78de0c545",
                        "target_lang_word": "gyroscope",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gyroscope",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81e8d5a1-542f-3497-a840-640706b3598d",
                                        "entry_id": "35656c9f-1600-3ae3-ad6d-925382233a9e",
                                        "glosses": [
                                            "An apparatus composed of a wheel which spins inside of a frame (gimbal) and causes the balancing of the frame in any direction or position. In the form of a gyroscopic stabilizer, used to help keep aircraft and ships steady."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce59ec57-671a-4495-b4fa-e7b99ee432c5",
                                                "sense_id": "81e8d5a1-542f-3497-a840-640706b3598d",
                                                "text": "Working with NR, ScotRail and Porterbrook, Perpetuum has fitted sensors with gyroscopes and accelerometers to trains that are already in passenger service."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5a8c81f-f56a-4230-8609-8a894c95ead2",
                        "source_entry_id": "d8ff19e1-d212-3fda-913f-2bd393dfcd72",
                        "source_sense_id": "c5fade5c-b88a-3f34-8aaf-8ff78de0c545",
                        "target_lang_word": "gyroscope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gyroscope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56421e9d-b761-3004-a2d0-0f6ebe04dc85",
                                        "entry_id": "aef44c07-f6bc-31aa-a844-5c758327b065",
                                        "glosses": [
                                            "Appareil qui exploite le principe de la conservation du moment angulaire en physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "491612a8-188f-42cb-bfe5-e5b1a7d3adb2",
                                                "sense_id": "56421e9d-b761-3004-a2d0-0f6ebe04dc85",
                                                "text": "Un gyroscope peut servir à indiquer le Nord."
                                            },
                                            {
                                                "example_id": "4747f0a9-385c-4083-af72-c1ad6994fc42",
                                                "sense_id": "56421e9d-b761-3004-a2d0-0f6ebe04dc85",
                                                "text": "GASTON, fouillant aussi. – Il n’y a pas de polichinelles, d’arche de Noé ?\nMme RENAUD – Tout petit, tu n’as plus voulu que des jouets scientifiques. Voilà tes gyroscopes, tes éprouvettes, tes électroaimants, tes cornues, ta grue mécanique.\nGEORGES – Nous voulions faire de toi un brillant ingénieur."
                                            },
                                            {
                                                "example_id": "cc089f11-91b0-41e2-afdc-c4af0bfb54b3",
                                                "sense_id": "56421e9d-b761-3004-a2d0-0f6ebe04dc85",
                                                "text": "A ce moment Nestor prit la boîte et l’ouvrit en m’expliquant gravement : « C’est un gyroscope, c’est la clé de l’absolu. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8be37dc-281c-3ab9-a5ae-f366bc98c1c1",
                                        "entry_id": "aef44c07-f6bc-31aa-a844-5c758327b065",
                                        "glosses": [
                                            "Capteur de position angulaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51286cd1-ed05-48f7-ae0f-21f32f735729",
                                                "sense_id": "a8be37dc-281c-3ab9-a5ae-f366bc98c1c1",
                                                "text": "Le système est couplé avec des données de gyroscope et d’accéléromètre pour le haut, le bas et la ligne d’horizon, développe Thomas Dexmier, vice-président associé EMEA chargé des solutions entreprise chez HTC Vive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d92fe189-8d21-4a9e-87bb-2c4b806ff25f",
                        "source_entry_id": "d8ff19e1-d212-3fda-913f-2bd393dfcd72",
                        "source_sense_id": "c5fade5c-b88a-3f34-8aaf-8ff78de0c545",
                        "target_lang_word": "giróscopo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "giróscopo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ab0d369b-3396-3d7e-bd9f-a274d4fdbbb1",
                                        "entry_id": "e7aa281b-1fc8-381e-be9c-b051e5e2ff20",
                                        "glosses": [
                                            "Dispositivo formado por un cuerpo en rotación dentro de un cardán, cuyo momento angular lo hace prácticamente independiente del momento de fuerza externo, por lo que mantiene casi exactamente la misma orientación sin importar los movimientos"
                                        ],
