                                            {
                                                "example_id": "124a1889-e20e-44ca-ae40-68e51d69fd57",
                                                "sense_id": "21bfbd33-5dd2-30d6-9b98-865976217339",
                                                "text": "Das kostet 4 Franken."
                                            },
                                            {
                                                "example_id": "c5b77764-0e21-4f52-bb98-043bcd7dddc2",
                                                "sense_id": "21bfbd33-5dd2-30d6-9b98-865976217339",
                                                "text": "Die Omi hat dem Rudi und mir 20 Franken geschenkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79670ec6-1624-3bf7-b86e-88d9c0f5bb22",
                                        "entry_id": "7c8b54fd-c647-3d29-9edc-c025c4322334",
                                        "glosses": [
