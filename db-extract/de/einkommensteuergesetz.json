                ],
                "senses": [
                    {
                        "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                        "entry_id": "a579e4c1-740c-36cc-b7bc-ec0bc472e70e",
                        "glosses": [
                            "rechtliche Regelungen zur Besteuerung von Einkünften natürlicher Personen mit Wohnsitz im Inland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0d2ca57-034c-43f8-8aff-7657b888794d",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "„Allein 254 Din-A4-Seiten füllt das aktuelle deutsche Einkommensteuergesetz und ständig kommen weitere hinzu.“"
                            },
                            {
                                "example_id": "707bd8ab-a674-4d03-ab39-8ba2dd5f2021",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "[…] „der Bundestag beschloss am späten Donnerstagabend (27.06.2013) ein Gesetz zur Änderung des Einkommensteuergesetzes.“"
                            },
                            {
                                "example_id": "7fe863e7-5fc9-41d7-ae92-68ee1a3a0787",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "„Die gesetzliche Grundlage bildet das Einkommensteuergesetz (EStG), ergänzt um die Einkommensteuer-Durchführungsverordnung und die Einkommensteuer-Richtlinien.“"
                            },
                            {
                                "example_id": "2ccd944a-ba7b-463a-8743-09603182c182",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "„Daneben arbeitet das Einkommensteuergesetz oft mit Pauschalen.“"
                            },
                            {
                                "example_id": "1a9d9b9b-f50b-4804-948f-b7d79a3e2bb2",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "„Mit 2021 soll ein völlig neu geschriebenes Einkommensteuergesetz in Kraft treten.“"
                            },
                            {
                                "example_id": "09689d88-3ff0-420c-9d2b-48bfdce23ee5",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "„Bestimmte Einnahmen sind gänzlich von der Einkommensteuer befreit. Dazu zählen laut Einkommensteuergesetz rund 70 verschiedene Einnahmen, unter anderem das Arbeitslosengeld, BAföG-Leistungen, Stipendien oder auch das Elterngeld.“"
                            },
                            {
                                "example_id": "775a7704-96c5-4f8d-98ed-8cea5e302479",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "„Für alle Einkommensarten mit Ausnahme der Kapitaleinkünfte (wie etwa Einkünfte aus Aktien, Investmentfonds, Zinseinnahmen aus Geldvermögen) gilt derzeit im Einkommensteuergesetz eine Kombination aus einem progressiven und einem proportionalen Steuertarif.“"
                            },
                            {
                                "example_id": "2acd55a9-6836-4ad7-8c5d-0b0f1680832e",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "„Eine Einkommensteuererklärung müssen Sie nach § 46 des Einkommensteuergesetzes daher auch dann abgeben, wenn Ihr Einkommen ganz oder teilweise aus nichtselbständiger Arbeit hervorgeht - das heißt zum Beispiel aus Lohnersatzleistungen -“ […]."
                            },
                            {
                                "example_id": "51b0f276-ca17-4fb3-8f01-f19a49be00f9",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "„Das Einkommensteuergesetz ermöglicht es Unternehmen, den Mitarbeitern ganz legal einige hundert Euro mehr netto zukommen zu lassen - ohne dass das Finanzamt daran beteiligt werden muss.“"
                            },
                            {
                                "example_id": "c705b681-d0bc-4843-ba66-5ec1bd3eb2fe",
                                "sense_id": "c033a685-72a0-3b85-83c9-683a9d5daf00",
                                "text": "[Steuerliche Gleichstellung der Homoehe:] „»Die entsprechenden Vorschriften des Einkommensteuergesetzes verstoßen gegen den allgemeinen Gleichheitssatz, da es an hinreichend gewichtigen Sachgründen für die Ungleichbehandlung fehlt«, begründen die Richter in Karlsruhe mit sechs zu zwei Stimmen die notwendige Korrektur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
