                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "53136cd6-9250-4eb7-aec4-5c9e2e172150",
                                "sense_id": "ec7ce5d9-8529-3272-a0f0-cc3112580b85",
                                "text": "Kaffee, Fruchtsäfte, Limonaden, Alkohol und fettige Speisen reizen den Darm zusätzlich. Es kann daher besser sein, auf diese Lebensmittel und Getränke erstmal zu verzichten.",
                                "translation": "Le café, les jus de fruits, les limonades, l’alcool et les aliments gras irritent davantage l'intestin. Il peut donc être préférable de renoncer à ces aliments et boissons dans un premier temps."
                            }
                        ]
                    }
