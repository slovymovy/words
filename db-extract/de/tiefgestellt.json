                ],
                "senses": [
                    {
                        "sense_id": "8d5e593a-e002-397f-a2f2-73aa8cad6e53",
                        "entry_id": "8d1e9246-aaa5-368d-87d5-ddb8ae585edf",
                        "glosses": [
                            "unterhalb der Schriftlinie von Texten und kleiner als normale Schriftzeichen dargestellt"
                        ],
                        "tags": [
                            "Typographie"
                        ],
                        "examples": [
                            {
                                "example_id": "3458c20a-1f00-496c-b389-28cf20194b54",
                                "sense_id": "8d5e593a-e002-397f-a2f2-73aa8cad6e53",
                                "text": "Die Summenformel einer chemischen Verbindung besteht aus den Elementsymbolen der enthaltenen chemischen Elemente und kleinen, tiefgestellten arabischen Ziffern für deren jeweilige Anzahl in dieser Verbindung."
                            },
                            {
                                "example_id": "38f1c20b-2d43-4c1a-918d-11bc6aabdcf6",
                                "sense_id": "8d5e593a-e002-397f-a2f2-73aa8cad6e53",
                                "text": "Die Konsonantencluster der tibetischen Schrift werden entweder durch vor- oder nachgestellte Buchstaben beziehungsweise durch hoch- oder tiefgestellte Buchstaben wiedergegeben."
                            },
                            {
                                "example_id": "562b00a2-fb0f-41f3-9a78-66922820dfd5",
                                "sense_id": "8d5e593a-e002-397f-a2f2-73aa8cad6e53",
                                "text": "Tiefgestellte Zahlen und Buchstaben sind nützlich, um mathematische Formeln, chemische Formeln und akademische Titel wie Magistra oder Dipl.-Ing. richtig darzustellen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
