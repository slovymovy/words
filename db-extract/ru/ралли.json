                        "cross_references": [
                            {
                                "target_word": "rally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0be4c26c-67da-356b-b43d-6b90f4fa01d5",
                                        "entry_id": "4fc72aae-1f47-3974-acbb-ac59315a47b0",
                                        "glosses": [
                                            "A public gathering or mass meeting that is not mainly a protest and is organized to inspire enthusiasm for a cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1c656b-4327-4827-9e5c-e9611d2095c7",
                                                "sense_id": "0be4c26c-67da-356b-b43d-6b90f4fa01d5",
                                                "text": "a campaign rally"
                                            },
                                            {
                                                "example_id": "2281ab48-129f-4d42-b1e6-904c70341f11",
                                                "sense_id": "0be4c26c-67da-356b-b43d-6b90f4fa01d5",
                                                "text": "an election rally"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b237cb68-94e0-32a3-8ee7-87c860512251",
                                        "entry_id": "4fc72aae-1f47-3974-acbb-ac59315a47b0",
                                        "glosses": [
                                            "A protest or demonstration for or against something, but often with speeches and often without marching, especially in North America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bee46523-3409-4321-8f12-081943258060",
                                                "sense_id": "b237cb68-94e0-32a3-8ee7-87c860512251",
                                                "text": "a political rally"
                                            },
                                            {
                                                "example_id": "bc6e5c1f-9952-42bf-b9ef-200e761fbf86",
                                                "sense_id": "b237cb68-94e0-32a3-8ee7-87c860512251",
                                                "text": "The EDL said Saturday’s rally was aimed at highlighting what it describes as a “continued increase in Islamic terrorism” linked to Birmingham."
                                            },
                                            {
                                                "example_id": "5bcea4ed-1be4-4c5f-99a8-c4258be7f2af",
                                                "sense_id": "b237cb68-94e0-32a3-8ee7-87c860512251",
                                                "text": "Mortenson, who asked to use a pseudonym for this story, says she has been attending rallies and vigils in her home state to regain her optimism, but she’s finding it tough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8abb2d79-254c-31db-8d31-1848a6f9e695",
                                        "entry_id": "4fc72aae-1f47-3974-acbb-ac59315a47b0",
                                        "glosses": [
                                            "A sequence of strokes between serving and scoring a point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf8bf472-ed43-3fc8-b2fe-984a7a185d32",
                                        "entry_id": "4fc72aae-1f47-3974-acbb-ac59315a47b0",
                                        "glosses": [
                                            "An event in which competitors drive through a series of timed special stages at intervals. The winner is the driver who completes all stages with the shortest cumulative time."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2b91fd9-8d8a-38e8-b0cd-25eadba4f736",
                                        "entry_id": "4fc72aae-1f47-3974-acbb-ac59315a47b0",
                                        "glosses": [
                                            "A recovery after a decline in prices (said of the market, stocks, etc.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1596e211-551c-3d59-8deb-ba95c1337dcc",
                                        "entry_id": "c23e4f57-4030-3510-84e0-0fdbd1cd2304",
                                        "glosses": [
                                            "To collect, and reduce to order, as troops dispersed or thrown into confusion; to gather again; to reunite."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28ea8bff-dcc1-35f8-be80-a53b2f78c639",
                                        "entry_id": "c23e4f57-4030-3510-84e0-0fdbd1cd2304",
                                        "glosses": [
                                            "To come into orderly arrangement; to renew order, or united effort, as troops scattered or put to flight; to assemble."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e879ccdd-4fdd-41cc-8be4-08f9ac0fd0b2",
                                                "sense_id": "28ea8bff-dcc1-35f8-be80-a53b2f78c639",
                                                "text": "Innumerable parts of matter chanced just then to rally together, and to form themselves into this new world."
                                            },
                                            {
                                                "example_id": "88108b01-f6ae-4151-b65c-ad0a7d3dfe36",
                                                "sense_id": "28ea8bff-dcc1-35f8-be80-a53b2f78c639",
                                                "text": "The Grecians rally, and their powers unite."
                                            },
                                            {
                                                "example_id": "676e8d0a-6208-4ff3-bd22-e97580289318",
                                                "sense_id": "28ea8bff-dcc1-35f8-be80-a53b2f78c639",
                                                "text": "The USA were dominant but, to England’s immense credit, they repeatedly rallied, refusing to fold. Indeed they could conceivably have gone in level at the interval had Naeher not made an acrobatic, stretching, fingertip save to divert Walsh’s 25-yard thunderbolt as it whizzed unerringly on its apparently inexorable trajectory towards the top corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cc4cf4d-d0bb-33da-b567-eb2917d5763a",
                                        "entry_id": "c23e4f57-4030-3510-84e0-0fdbd1cd2304",
                                        "glosses": [
                                            "To collect one's vital powers or forces; to regain health or consciousness."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b707bd51-c4db-4970-879a-626fb8ca3756",
                                                "sense_id": "0cc4cf4d-d0bb-33da-b567-eb2917d5763a",
                                                "text": "Norbourne was almost thankful for any excuse that enabled him to avoid seeing Lady Marchmont. In vain he sought to rally his spirits, and to conceal his depression; but the idea of Ethel mocked his efforts to forget."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14da256f-d1a4-31c6-a813-a62a9104ca3d",
                                        "entry_id": "c23e4f57-4030-3510-84e0-0fdbd1cd2304",
                                        "glosses": [
                                            "To recover strength after a decline in prices."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35376641-6716-40e1-b21a-4e9e44184c22",
                                                "sense_id": "14da256f-d1a4-31c6-a813-a62a9104ca3d",
                                                "text": "Bitcoin has still plunged in value by almost two-thirds this year, it should be said. But it has also rallied by about 10% since the downwards lurch when FTX filed for bankruptcy in mid-November, which is extraordinary."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce9520f2-c167-3f41-9483-3bf0cd166d75",
                                        "entry_id": "8c6c74af-94cf-31ad-834c-23c6cd4200b8",
                                        "glosses": [
                                            "To tease; to chaff good-humouredly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d27398a6-cac7-471b-b822-15816f2e991b",
                                                "sense_id": "ce9520f2-c167-3f41-9483-3bf0cd166d75",
                                                "text": "But you must not rally him on the subject Sir Oliver—'tis a tender Point I assure you though He has been married only seven months."
                                            },
                                            {
                                                "example_id": "277e527b-d93b-49b8-8ad1-351282156e2d",
                                                "sense_id": "ce9520f2-c167-3f41-9483-3bf0cd166d75",
                                                "text": "Honeycomb […] rallies me after his way upon my country life."
                                            },
                                            {
                                                "example_id": "e3f25f9d-815c-4878-b422-0337f2b95ab5",
                                                "sense_id": "ce9520f2-c167-3f41-9483-3bf0cd166d75",
                                                "text": "Strephon had long confeſs'd his am'rous Pain, / VVhich gay Corinna railly'd vvith Diſdain: […]"
                                            },
                                            {
                                                "example_id": "a8a7391b-7366-47ce-9a56-10be6294c34d",
                                                "sense_id": "ce9520f2-c167-3f41-9483-3bf0cd166d75",
                                                "text": "So the athletic Magnolia instantly impounded the little Lieutenant, and began to rally him, in the sort of slang she delighted in, with plenty of merriment and malice upon his tendre for Miss Chattesworth, and made the gallant young gentleman blush and occasionally smile, and bow a great deal, and take some snuff."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbe855cf-4365-3d3f-8a0f-bf5ae0678b57",
                                        "entry_id": "be15556e-3f82-34f1-b309-28c63f66c8ed",
                                        "glosses": [
                                            "Good-humoured raillery."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7192d6b6-c123-475b-8452-69e6ebb61a2a",
                        "source_entry_id": "21f071be-c72a-3f9b-af00-07c8c9c1a7a8",
                        "source_sense_id": "792e85af-f26b-3478-b26e-8a5f8dac785d",
