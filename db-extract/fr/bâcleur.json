                ],
                "senses": [
                    {
                        "sense_id": "14c5a4ac-a66c-3ea2-a66a-2513075d492b",
                        "entry_id": "d79c0ff8-5170-3c97-8c78-70e5ff8b21db",
                        "glosses": [
                            "Personne qui bâcle quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40474399-2a4f-4801-bc51-1a1200597892",
                                "sense_id": "14c5a4ac-a66c-3ea2-a66a-2513075d492b",
                                "text": "Il y a d’abord les bâcleurs de « copie », les producteurs de « littérature alimentaire », dont les noms s’étalent sur des affiches affriolantes."
                            },
                            {
                                "example_id": "e5910b97-c5db-4825-bf53-88018ac1671e",
                                "sense_id": "14c5a4ac-a66c-3ea2-a66a-2513075d492b",
                                "text": "Au sein de notre bande, il passait pour un boute-en-train hors pair et un bâcleur sans envergure, au contraire de Fjazac qui, pensions-nous, bâclait avec génie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac116aaf-75d7-35bb-b73c-6f45fc57bca4",
                        "entry_id": "d79c0ff8-5170-3c97-8c78-70e5ff8b21db",
                        "glosses": [
                            "Personne qui aide les rattacheurs, dans une filature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e4916b3-7e63-4463-a955-3ee60789346c",
                                "sense_id": "ac116aaf-75d7-35bb-b73c-6f45fc57bca4",
                                "text": "Ainsi dans la filature de coton l’équipe, composée du fileur, des rattacheurs et du bâcleur est payée parfois au salaire collectif simple, mais parfois aussi au salaire progressif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "418e6d2c-6044-43a1-a2cb-a87bb76fe083",
                        "source_entry_id": "d79c0ff8-5170-3c97-8c78-70e5ff8b21db",
                        "target_lang_word": "Pfuscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfuscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58b52d4b-80bd-30ae-984e-a97fa3a491dd",
                                        "entry_id": "2742a6ed-acd0-3468-b72f-4b798e5df7a8",
                                        "glosses": [
                                            "Person, die unprofessionell oder schlecht arbeitet"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b1423a0-aa80-4a9a-b13c-014a46c133af",
                                                "sense_id": "58b52d4b-80bd-30ae-984e-a97fa3a491dd",
                                                "text": "„Explodierende Mieten, Schuldenkrise und niedrige Zinsen-nie war es verlockender, sein Vermögen in ein Eigenheim zu investieren. Doch das Projekt kann schnell zum Alptraum werden, wenn man an Pfuscher oder Betrüger gerät.“"
                                            },
                                            {
                                                "example_id": "8582c656-7630-4797-9a0d-f4f23dbcae1d",
                                                "sense_id": "58b52d4b-80bd-30ae-984e-a97fa3a491dd",
                                                "text": "„Jeder Pfuscher wäre gut genug dazu gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b2b806a2-4aba-3919-8a99-b95d565724c3",
                                        "entry_id": "2742a6ed-acd0-3468-b72f-4b798e5df7a8",
                                        "glosses": [
                                            "Person, die ohne Bezahlung von Steuern und Sozialabgaben arbeitet"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1010ac25-f53f-4e65-8570-f47264d0b262",
                                                "sense_id": "b2b806a2-4aba-3919-8a99-b95d565724c3",
                                                "text": "„Pfuscher zahlen weder Steuern noch Sozialabgaben, die öffentliche Hand muss Mindereinnahmen durch Steuererhöhungen kompensieren.“"
                                            },
                                            {
                                                "example_id": "7896bc3e-9574-4f7e-a569-efe7f6fa9b3d",
                                                "sense_id": "b2b806a2-4aba-3919-8a99-b95d565724c3",
                                                "text": "„Er sei noch Lehrling und keinesfalls Schwarzarbeiter oder Pfuscher.“"
                                            },
                                            {
                                                "example_id": "b97f9eb2-2a21-4bcd-940c-747fc420d502",
                                                "sense_id": "b2b806a2-4aba-3919-8a99-b95d565724c3",
                                                "text": "„Der Zweck der Strafnorm […] liegt letztlich […] darin, das öffentliche Interesse an der Entrichtung von Steuern, Abgaben und Beiträgen zur Sozialversicherung bei der Beschäftigung von Ausländern durchzusetzen, einen geordneten Arbeitsmarkt sicherzustellen, die legalen Beschäftigungschancen inländischer und integrierter ausländischer Arbeitnehmer zu wahren (Arbeitsmarktprüfung, Ersatzkraftstellung) und ausländische Arbeitnehmer vor ausbeuterischen Lohn- und Arbeitsbedingungen sowie Arbeitgeber vor unlauterem Wettbewerb durch Pfuscher und Lohndumping durch in- und ausländische Unternehmen zu schützen […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70be051d-60bc-4cea-a755-8bf85f08fb34",
