                                        "glosses": [
                                            "část dne mezi ránem a polednem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8315d097-54d2-44cd-b71c-732bd8a00ad2",
                                                "sense_id": "50e789cf-14c1-34e1-82fc-9d5bc0287ad6",
                                                "text": "Každé všední dopoledne jsem samozřejmě ve škole."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dopoledne",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e8dc1d80-ce4a-3cbc-a38b-5a2998f5dece",
                                        "entry_id": "0e22e359-86f9-342e-9627-db592d564af9",
                                        "glosses": [
                                            "v průběhu dopoledne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43f2187-255e-480e-be7d-70e12da88d6e",
                                                "sense_id": "e8dc1d80-ce4a-3cbc-a38b-5a2998f5dece",
                                                "text": "Zboží má být dodáno zítra dopoledne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e33d7b80-a08b-4274-8061-5f41797f2cc8",
                        "source_entry_id": "4f325957-b1df-30e3-898d-593c969073a9",
                        "source_sense_id": "68c02370-d3ac-30ce-92a9-8cf405c48e92",
                        "source_sense_description": "forenoon - part of the day before noon",
                        "target_lang_word": "Vormittag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vormittag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                        "entry_id": "71ff7621-743d-38aa-8103-c98762847964",
                                        "glosses": [
                                            "Zeitraum zwischen dem Morgen und dem Mittag"
                                        ],
                                        "tags": [
                                            "Tageszeit"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "223019cd-84ba-4ad0-9ba5-294351ccad96",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "Ruf am besten am späten Vormittag an."
                                            },
                                            {
                                                "example_id": "9ea2b752-4796-4da7-8d7c-5952a318a5b3",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Gleich nach dem Frühstück fuhren wir mit der Weinlese fort und im Laufe des Vormittags kamen noch einige Dorfbewohner hinzu.“"
                                            },
                                            {
                                                "example_id": "45d17796-b9fc-497f-866c-905412c5eaa3",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Am späten Vormittag trat ein Wilder aus dem Busch.“"
                                            },
                                            {
                                                "example_id": "5afa85f4-2d99-45d0-acc3-f92a84abc73d",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Im Laufe des späten Vormittages führte Aëtius das Heer zur Schlacht auf die Ebene zwischen den beiden Lagern.“"
                                            },
                                            {
                                                "example_id": "649cea48-6bfa-4c5a-a3ab-ee26a2482979",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Am frühen Vormittag war ich in Trier.“"
                                            },
                                            {
                                                "example_id": "569dacf9-9407-48a5-b6d6-2c53ee6b4124",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Der Vormittag war vorüber.“"
                                            },
                                            {
                                                "example_id": "5c53c9f0-b3ea-4281-8131-5c245c4b3eff",
                                                "sense_id": "5d020dcb-1b74-3fbd-a5b2-81aea35bad44",
                                                "text": "„Die Kleinstadt, wo sie davor gelebt hatten und nach der Ada benannt wurde, war zu Fuß etwa einen halben Vormittag entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
