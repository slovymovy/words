    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65f051a2-3f02-352b-ae89-a22d5b077fe4",
                    "sense_definition": "die Beherrschung oder Nerven verlieren; in Panik, Hysterie oder extreme Wut geraten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kontrollverlust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn Tim noch mehr Stress bei der Arbeit hat, wird er bald völlig <w>durchdrehen</w>."
                        },
                        {
                            "text": "Als er die schlechte Nachricht hörte, <w>drehte</w> er vor Wut komplett <w>durch</w>."
                        }
                    ],
                    "synonyms": [
                        "ausrasten",
                        "ausflippen",
                        "austicken",
                        "überschnappen",
                        "die Nerven verlieren"
                    ],
                    "antonyms": [
                        "die Nerven behalten"
                    ],
                    "common_phrases": [
                        "völlig durchdrehen",
                        "fast durchdrehen",
                        "vor Wut durchdrehen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "weit verbreitete umgangssprachliche Formulierung"
                        }
                    ]
                },
                {
                    "sense_id": "9efee691-ea79-3415-a0cf-3b031d41d38e",
                    "sense_definition": "sich ohne Bodenhaftung oder Grip an Ort und Stelle drehen (besonders von Rädern)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drehbewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der vereisten Straße <w>drehten</w> die Reifen des Wagens sofort <w>durch</w>."
                        },
                        {
                            "text": "Gib beim Anfahren vorsichtig Gas, damit die Räder nicht im Matsch <w>durchdrehen</w>."
                        }
                    ],
                    "synonyms": [
                        "rotieren",
                        "rutschen"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "die Reifen durchdrehen lassen"
                    ]
                },
                {
                    "sense_id": "50448f74-2585-30eb-8f7e-db1aedaf5ce1",
                    "sense_definition": "Lebensmittel wie Fleisch oder Gemüse durch einen Fleischwolf drehen und dadurch zerkleinern",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kochen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für die Füllung müssen wir das Rindfleisch sorgfältig würfeln und anschließend <w>durchdrehen</w>."
                        },
                        {
                            "text": "Der Metzger <w>drehte</w> das Fleisch direkt vor den Augen der Kundin <w>durch</w>."
                        }
                    ],
                    "synonyms": [
                        "zerkleinern",
                        "faschieren",
                        "mahlen"
                    ],
                    "common_phrases": [
                        "Fleisch durchdrehen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c954d72-29f4-3d2b-871f-f9f0500bbdcf",
                    "sense_definition": "das Verlieren der Selbstbeherrschung oder das Rotieren ohne Grip; substantivierter Infinitiv von <w>durchdrehen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "substantivierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das plötzliche <w>Durchdrehen</w> der Antriebsräder führte dazu, dass der Wagen ins Schleudern geriet."
                        },
                        {
                            "text": "Sein nervöses <w>Durchdrehen</w> in der Krisensituation hat die ganze Abteilung verunsichert."
                        }
                    ],
                    "traits": [
