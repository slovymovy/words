    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43c7343a-6b7e-3c87-aa50-ce16fb77b8dd",
                    "sense_definition": "Literature composed in verse or language exhibiting conscious attention to patterns and rhythm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "More people write <w>poetry</w> than read it.",
                            "target_lang_translations": {
                                "ru": "Больше людей пишут <w>стихи</w>, чем читают их.",
                                "zh": "写<w>诗</w>的人比读<w>诗</w>的人多。"
                            }
                        },
                        {
                            "text": "She enjoys reading romantic <w>poetry</w> in her free time.",
                            "target_lang_translations": {
                                "ru": "В свободное время ей нравится читать романтическую <w>поэзию</w>.",
                                "zh": "她闲暇时喜欢读浪漫主义<w>诗歌</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "verse",
                        "poems"
                    ],
                    "antonyms": [
                        "prose"
                    ],
                    "common_phrases": [
                        "write poetry",
                        "read poetry",
                        "modern poetry",
                        "poetry reading"
                    ],
                    "target_lang_definitions": {
                        "ru": "Литература, написанная стихами; искусство стихосложения.",
                        "zh": "用韵文创作的文学作品，或注重节奏与韵律的语言艺术。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поэзия",
                                "target_lang_sense_clarification": "вид искусства"
                            },
                            {
                                "target_lang_word": "стихи",
                                "target_lang_sense_clarification": "стихотворные произведения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诗歌",
                                "target_lang_sense_clarification": "文学体裁或艺术形式"
                            },
                            {
                                "target_lang_word": "诗",
                                "target_lang_sense_clarification": "具体的诗作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc9c1dd6-c1d0-30cc-8910-f83ab379a366",
                    "sense_definition": "An artistic quality that appeals to or evokes the emotions, in any medium.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The way the football team played together was <w>poetry</w> in motion.",
                            "target_lang_translations": {
                                "ru": "То, как играла футбольная команда, было <w>поэзией</w> в движении.",
                                "zh": "那支足球队配合默契，简直是动态的<w>诗意</w>。"
                            }
                        },
                        {
                            "text": "His description of the sunset was pure <w>poetry</w>.",
                            "target_lang_translations": {
                                "ru": "Его описание заката было чистой <w>поэзией</w>.",
                                "zh": "他对日落的描述简直充满了<w>诗意</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "poetry in motion",
                        "pure poetry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красота, изящество и эмоциональное воздействие чего-либо (в переносном смысле).",
                        "zh": "指事物所具有的优美、动人或富有感染力的特质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поэзия",
                                "target_lang_sense_clarification": "перен. красота, очарование"
                            },
                            {
                                "target_lang_word": "поэтичность",
                                "target_lang_sense_clarification": "свойство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诗意",
                                "target_lang_sense_clarification": "形容事物具有美感或感染力"
                            },
                            {
                                "target_lang_word": "诗情画意",
                                "target_lang_sense_clarification": "形容意境优美"
                            }
                        ]
                    }
                }
            ]
        }
    ]
