                    },
                    {
                        "form_id": "dade5e7d-b1a8-4446-a364-dde9929f467d",
                        "entry_id": "56583e3c-c779-3b14-bf80-4db8aa9e2d17",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Küchengeräte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1179249-6afc-3c24-a6e8-27e3e79c4171",
                        "entry_id": "56583e3c-c779-3b14-bf80-4db8aa9e2d17",
                        "glosses": [
                            "in der Küche verwendetes Werkzeug zum Zubereiten von Speisen oder Getränken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc447a6-b03c-44f2-985c-6e85d99c6143",
                                "sense_id": "f1179249-6afc-3c24-a6e8-27e3e79c4171",
                                "text": "Viele Küchengeräte funktionieren heute elektrisch."
                            },
                            {
                                "example_id": "130cbbeb-ae7f-4b63-ac92-8bef297ed6eb",
                                "sense_id": "f1179249-6afc-3c24-a6e8-27e3e79c4171",
                                "text": "„Mit dem Küchengerät kehre ich nach Rowen zurück; für die folgende Nacht leihe ich eine Schubkarre aus, um die Stühle zu bergen.“"
                            },
                            {
                                "example_id": "075c59df-2943-438a-8451-95bca8d20d7b",
                                "sense_id": "f1179249-6afc-3c24-a6e8-27e3e79c4171",
                                "text": "„Die Kochkunst der französischen Hofküche übte ebenfalls einen großen Einfluss sowohl auf die Auswahl der Speisen in den Küchen der deutschen Fürstenhöfe als auch auf die Bezeichnungen der Gerichte selbst und sogar auf die zur Zubereitung benötigten Küchengeräte aus.“"
                            },
                            {
                                "example_id": "374a9f0e-b4aa-4792-8911-bcc97c1285e4",
                                "sense_id": "f1179249-6afc-3c24-a6e8-27e3e79c4171",
                                "text": "„Die Siedler sahen sich jeden einzelnen Gegenstand daraufhin an, aber die brandneuen Instrumente und Waffen trugen keinerlei Firmen- oder andere Namen, auch die Küchengeräte waren nicht gezeichnet.“."
                            },
                            {
                                "example_id": "798ca62d-13f4-4582-b37f-271e2ddc138a",
                                "sense_id": "f1179249-6afc-3c24-a6e8-27e3e79c4171",
