                "senses": [
                    {
                        "sense_id": "dfb22dde-0013-3099-99dd-e9c8e6de2d57",
                        "entry_id": "2ea5eeaf-5122-38a0-86cc-0a70dabf967e",
                        "glosses": [
                            "Photographier (en particulier avec un appareil japonais, de la marque Nikon)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "156fdd5a-5e3d-4032-b7fe-2ba0cec80094",
                                "sense_id": "dfb22dde-0013-3099-99dd-e9c8e6de2d57",
                                "text": "Les Japonais, en plus, nikonaient à tout va, à croire que ce peuple consacrait ses vacances à cartepostaliser la planète !"
                            },
                            {
                                "example_id": "84f35540-6b1f-4e23-b89a-ddd9a75e5377",
                                "sense_id": "dfb22dde-0013-3099-99dd-e9c8e6de2d57",
                                "text": "Il voyage, il nikone, il vit, et profite."
                            },
                            {
                                "example_id": "3ba20a84-766a-414a-a03f-7e3914501cf4",
                                "sense_id": "dfb22dde-0013-3099-99dd-e9c8e6de2d57",
                                "text": "Alors j'ai nikoné à donf. Parce qu'une petite carte postale fait toujours plaisir..."
                            },
                            {
                                "example_id": "8b26a4a1-8087-4a02-b40f-8b00cbd156c1",
                                "sense_id": "dfb22dde-0013-3099-99dd-e9c8e6de2d57",
                                "text": "Je n'avais pas tout suivi mais je vois que je ne suis pas le seul à avoir Nikoné !"
                            },
                            {
                                "example_id": "cfadfcad-db64-47fe-a0ce-90be02c59b4d",
                                "sense_id": "dfb22dde-0013-3099-99dd-e9c8e6de2d57",
                                "text": "Du franc soleil et du ciel bleu ?! Vite, Nikonons !"
                            }
                        ]
                    }
                ],
