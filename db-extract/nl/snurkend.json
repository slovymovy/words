                "senses": [
                    {
                        "sense_id": "1dae6b73-7d33-3310-b8c5-c8cab002e854",
                        "entry_id": "89061087-da1e-38f3-875f-7e5f3bcf6b1a",
                        "glosses": [
                            "bezig met snurken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8efb2043-1f9b-47c8-8165-9ca3601a35d5",
                                "sense_id": "1dae6b73-7d33-3310-b8c5-c8cab002e854",
                                "text": "In de slaapkamer zijn twee bedsteeën te vinden die je met een gordijntje kunt afsluiten. Ook is de kamer donker en volledig geluidsdicht (je eventueel snurkende buurman niet meegerekend)."
                            },
                            {
                                "example_id": "41cdb47e-b8b9-4e3a-9cd3-22fd844ab50c",
                                "sense_id": "1dae6b73-7d33-3310-b8c5-c8cab002e854",
                                "text": "Ik schijn ook intens hard te snurken.\nDaarvan deelt ze bewijsmateriaal; een geluidsopname die Erik maakte van zijn snurkende verloofde. Roxeannes conclusie luidt dan ook: \"Ik vind eigenlijk dat de mannen van zwangere vrouwen het veel zwaarder hebben.\""
                            }
                        ]
                    }
