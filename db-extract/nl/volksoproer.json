                                        "sense_id": "af44c42f-5d6d-3732-94e8-e8982ca49f5f",
                                        "entry_id": "76f2e919-b0e6-36e3-8fd4-e283306fd34e",
                                        "glosses": [
                                            "Armed resistance to an established government or ruler."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "286b9adf-fd18-4740-91b3-ceba76dce042",
                                                "sense_id": "af44c42f-5d6d-3732-94e8-e8982ca49f5f",
                                                "text": "The government is doing its best to stop rebellion in the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b58814d-c75a-377e-a3b6-6fb7aa672c1f",
                                        "entry_id": "76f2e919-b0e6-36e3-8fd4-e283306fd34e",
                                        "glosses": [
                                            "Defiance of authority or control; the act of rebelling."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df2ca29-1fbd-47fc-b516-fd95a3625ae9",
                                                "sense_id": "3b58814d-c75a-377e-a3b6-6fb7aa672c1f",
                                                "text": "Having a tattoo was Mathilda's personal rebellion against her parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e303755-1f2b-30a6-a71a-f732404eb113",
                                        "entry_id": "76f2e919-b0e6-36e3-8fd4-e283306fd34e",
                                        "glosses": [
                                            "An organized, forceful subversion of the law of the land in an attempt to replace it with another form of government."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a39624ab-cd5b-4ab8-9a2f-7f56daf82267",
                                                "sense_id": "1e303755-1f2b-30a6-a71a-f732404eb113",
                                                "text": "The army general led a successful rebellion and became president of the country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff8b1c0b-f632-4a85-a89f-a8ea14856039",
                        "source_entry_id": "80ddd068-2039-3ea6-b07a-6cc627660f4e",
                        "source_sense_id": "78027bcc-54b3-35bd-a54c-ea07f85a5cd5",
                        "target_lang_word": "revolt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8aad53b0-f663-358a-a625-56c5a7b12ccc",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To rebel, particularly against authority."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59921ba8-e9e3-4beb-939e-c13157df5a15",
                                                "sense_id": "8aad53b0-f663-358a-a625-56c5a7b12ccc",
                                                "text": "Our diſcontented Counties doe reuolt"
                                            },
                                            {
                                                "example_id": "60c770b2-83f6-45ec-a3b6-24074fe82d17",
                                                "sense_id": "8aad53b0-f663-358a-a625-56c5a7b12ccc",
                                                "text": "The farmers had to revolt against the government to get what they deserved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ae2376-249d-39d1-ae91-8e70b07be7c9",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To repel greatly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "294ce959-d0e5-4e7d-b1a0-3459e6960152",
                                                "sense_id": "97ae2376-249d-39d1-ae91-8e70b07be7c9",
                                                "text": "Your brother revolts me!"
                                            },
                                            {
                                                "example_id": "cb77c36a-e677-4211-ae6e-d0a933cbef0b",
                                                "sense_id": "97ae2376-249d-39d1-ae91-8e70b07be7c9",
                                                "text": "I shall be told, that this abominable medley is made rather to revolt young and ingenuous minds."
                                            },
                                            {
                                                "example_id": "f8a218a1-dc00-4a90-a29e-a9c4f2cafa23",
                                                "sense_id": "97ae2376-249d-39d1-ae91-8e70b07be7c9",
                                                "text": "1870, John Morley, Condorcet (published in the Fortnightly Review\nTo derive delight from what inflicts pain on any sentient creature revolted his conscience and offended his reason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "333e7cfe-6e21-377e-804f-20de95c09831",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To be disgusted, shocked, or grossly offended; hence, to feel nausea; used with at."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b1f1701-b74d-41f4-9ede-0cdb645c3292",
                                                "sense_id": "333e7cfe-6e21-377e-804f-20de95c09831",
                                                "text": "The stomach revolts at such food; his nature revolts at cruelty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84cb4257-d515-3ce6-a0ba-69ea7eec33a2",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To cause to turn back; to roll or drive back; to put to flight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79216969-f6e2-4bbe-8e8d-8efd2d7f7203",
                                                "sense_id": "84cb4257-d515-3ce6-a0ba-69ea7eec33a2",
                                                "text": "The foring clouds into fad fhowres y molt; / So to her yold the flames, and did their force reuolt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab163f09-0a29-330b-8486-2a14ab16767d",
                                        "entry_id": "bf243684-a3b3-3a9b-993f-141bca8bd261",
                                        "glosses": [
                                            "To turn away; to abandon or reject something; specifically, to turn away, or shrink, with abhorrence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7516ddc6-3136-409e-a56b-8dd3c13821a0",
                                                "sense_id": "ab163f09-0a29-330b-8486-2a14ab16767d",
                                                "text": "And ſtill revolt when truth would ſet them free."
                                            },
                                            {
                                                "example_id": "a0ad9826-7e43-41bd-879c-22690714e3dd",
                                                "sense_id": "ab163f09-0a29-330b-8486-2a14ab16767d",
                                                "text": "His clear intelligence revolted from the dominant sophisms of that time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "revolt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2d486e4-230e-3817-b6ae-4fc9ea5a8396",
                                        "entry_id": "0f990847-2e9b-3746-86ab-858b85d2b9cc",
                                        "glosses": [
                                            "An act of revolting."
