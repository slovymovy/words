                ],
                "senses": [
                    {
                        "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                        "entry_id": "d2132e85-e1a8-3389-b345-ac3cadf44dca",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf2f2660-f0d0-4b7c-a6e8-52cef958cb80",
                                "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                                "text": "Frau Schoppe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fd1ff989-0ca3-4fe4-b6b2-dcae9f696a68",
                                "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                                "text": "Herr Schoppe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cf3333ab-ba05-474d-9c16-40e70f1161f2",
                                "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                                "text": "Die Schoppes kommen heute vom Starnberger See."
                            },
                            {
                                "example_id": "2d406dfd-11e0-487d-a206-143c065bd595",
                                "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                                "text": "Der Schoppe trägt nie die Schals, die die Schoppe ihm strickt."
                            },
                            {
                                "example_id": "e7b42960-8f86-459e-ae9a-cf37b79d4f13",
                                "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schoppe kommt, geht der Herr Schoppe.“"
                            },
                            {
                                "example_id": "15ca6ebd-987c-4d04-b12f-64af947a157a",
                                "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                                "text": "Schoppe kommt und geht."
                            },
                            {
                                "example_id": "e8d989cb-cabe-470a-89c3-3b81bcf4e2fd",
                                "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                                "text": "Schoppes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "e9a035e1-adc0-49d5-8108-f726f1244337",
                                "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                                "text": "An verregneten Herbsttagen ist Familie Schoppes liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "d568a220-f1a4-4750-8533-a990662bc6e8",
                                "sense_id": "100307ab-d4a3-3a71-ae01-93b40b727529",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Schoppe das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
