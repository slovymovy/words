                "senses": [
                    {
                        "sense_id": "5f064946-d9ec-3871-bbfa-ebfad7a9014b",
                        "entry_id": "ba8e95ab-970e-31fe-88cc-48f32bc35728",
                        "glosses": [
                            "Sous-espèce du cerf élaphe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc7a41cc-a4be-4572-887f-5b05af6ffc0d",
                                "sense_id": "5f064946-d9ec-3871-bbfa-ebfad7a9014b",
                                "text": "Tchinguiz Aïtmatov se désolait déjà en 1970 à propos des mârals du Kirghizistan : Il naquit des hommes qui, de leur vie, n’en apercevaient jamais un. Contempler la vie sauvage, une des raisons de mes voyages."
                            },
                            {
                                "example_id": "eccc9d41-0aae-4299-b7cf-c32f6de9fd05",
                                "sense_id": "5f064946-d9ec-3871-bbfa-ebfad7a9014b",
                                "text": "Les Cosaques la poursuivirent avec rapidité, gagnant du terrain sur elle ; tout à coup le maral s’arrêta hésitant, et regarda en arrière dans l’intention apparente de revenir sur ses pas."
                            }
                        ]
                    }
