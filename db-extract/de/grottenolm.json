                "senses": [
                    {
                        "sense_id": "fbabe203-f0bc-3ce7-9ac2-1467a8b0427e",
                        "entry_id": "08dfb9fc-01eb-3217-97f7-04c6dd4a1a2e",
                        "glosses": [
                            "Schwanzlurch mit einem länglichen, aalähnlichen Körper und besonders kleinen, dünnen Gliedmaßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35b8dd06-31d6-4471-b411-6022be756bcb",
                                "sense_id": "fbabe203-f0bc-3ce7-9ac2-1467a8b0427e",
                                "text": "„Der Grottenolm ist den Angaben zufolge ein Schwanzlurch mit Verbreitungsgebiet auf dem südwestlichen Balkan, etwa in Slowenien und Kroatien.“"
                            },
                            {
                                "example_id": "444f2e91-0944-4ba8-9dab-dbe6e38df6a0",
                                "sense_id": "fbabe203-f0bc-3ce7-9ac2-1467a8b0427e",
                                "text": "„Wer schon einmal die Adelberger Grotten bei Postojna im alpinen Karstgebirge Sloweniens besucht hat, konnte Grottenolme sehen.“"
                            },
                            {
                                "example_id": "8ffc6627-6b07-475d-af48-938bf8c60477",
                                "sense_id": "fbabe203-f0bc-3ce7-9ac2-1467a8b0427e",
                                "text": "„Obwol [sic] sich der Grottenolm ausschließlich im Wasser aufhält , so soll er nach Aussage der Grottenführer doch zuweilen, namentlich beim Herannahen eines Gewitters, aus dem Wasser herausgehen und mit unbeholfenen aalartigen Bewegungen im Schlamme herumkriechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31621f7b-f613-4426-8672-ebb1c624b8de",
                        "source_entry_id": "08dfb9fc-01eb-3217-97f7-04c6dd4a1a2e",
                        "source_sense_id": "fbabe203-f0bc-3ce7-9ac2-1467a8b0427e",
                        "target_lang_word": "olm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2038d7cb-5e3f-3f3a-ae8b-aea819bbb4bd",
                                        "entry_id": "70f6af41-9c4e-38d7-8fa0-b39e1a250cec",
                                        "glosses": [
                                            "Proteus anguinus, a cave-dwelling neotenous salamander with external gills, found along the coast from northeastern Italy to Montenegro."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b88413-8b04-490f-81ac-f67e33ccb7da",
                                                "sense_id": "2038d7cb-5e3f-3f3a-ae8b-aea819bbb4bd",
                                                "text": "O is for Olm. The Olm has teeny-weeny legs. Its eyes are covered with skin and it can barely see. Olms live in caves where there is hardly any light."
                                            },
                                            {
                                                "example_id": "968d0cb4-baee-400d-bb6b-4d759913650c",
                                                "sense_id": "2038d7cb-5e3f-3f3a-ae8b-aea819bbb4bd",
                                                "text": "A fully grown olm is around 30 cm with a sinuous body and long tail. There are two pairs of stumpy legs and three pairs of feathery gills behind the head. In its natural environment, the olm is pink with semitranslucent skin."
                                            },
                                            {
                                                "example_id": "6f482578-d1b9-4caf-afe3-dc1517d0923a",
                                                "sense_id": "2038d7cb-5e3f-3f3a-ae8b-aea819bbb4bd",
                                                "text": "Also known as the proteus, the olm is a blind amphibian found only in the underwater caves of southern Europe, specifically parts of Italy, Croatia, and Slovenia."
                                            },
                                            {
                                                "example_id": "47b4f9ae-aaca-40cf-a1a1-466708f789dc",
                                                "sense_id": "2038d7cb-5e3f-3f3a-ae8b-aea819bbb4bd",
                                                "text": "Olms have special sensors inside their ears that detect sound waves in the water as well as vibrations from the ground."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
