                        "examples": [
                            {
                                "example_id": "bb0cfd0c-844c-4e47-8b04-41bc2bfa8234",
                                "sense_id": "b6189da2-fdfc-3a64-afdb-185dc2a7c7a9",
                                "text": "Es ist ferner schon in der Waare eingeschlossen, und noch mehr in der Waare als Produkt des Kapitals, die Verdinglichung der gesellschaftlichen Produktionsbestimmungen und die Versubjektivirung der materiellen Grundlagen der Produktion, welche die ganze kapitalistische Produktionsweise charakterisirt."
                            },
                            {
                                "example_id": "7c52954a-7543-4adc-a57a-a45ffc402e62",
                                "sense_id": "b6189da2-fdfc-3a64-afdb-185dc2a7c7a9",
                                "text": "Die Beseelung der Maschine – ist das nicht der Gipfel der Verdinglichung?"
                            }
                        ]
                    }
