                    },
                    {
                        "translation_id": "7f2afedd-44aa-4b5c-8422-cd978858c73c",
                        "source_entry_id": "5c787497-1157-3bf4-88e3-59dcbd7fc4b8",
                        "source_sense_description": "подниматься торчком",
                        "target_lang_word": "se dresser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se dresser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2b8c6b3-212c-3f6a-ae7d-923f03b0e7b2",
                                        "entry_id": "50b30b63-7f69-38c5-964b-08bbc734454e",
                                        "glosses": [
                                            "Forme pronominale de dresser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eab50f3-cfa6-4225-91aa-5b9733a9ebd5",
                                                "sense_id": "b2b8c6b3-212c-3f6a-ae7d-923f03b0e7b2",
                                                "text": "Mais voici. Sur le seuil du juste assassiné,\nCroisant ses bras velus sur sa large poitrine,\nSe dresse un grand vieillard, farouche et décharné."
                                            },
                                            {
                                                "example_id": "9c0bb7d4-b0d0-41d8-a334-80d57b0d1550",
                                                "sense_id": "b2b8c6b3-212c-3f6a-ae7d-923f03b0e7b2",
                                                "text": "Au nord ouest, près de la route de Sommerance, se dressaient les bois de la potence, instrument de la haute justice seigneuriale."
                                            },
                                            {
                                                "example_id": "ec7d55a2-8776-4057-89ae-c785a4ddb929",
                                                "sense_id": "b2b8c6b3-212c-3f6a-ae7d-923f03b0e7b2",
                                                "text": "Il bruinait ; le Mont-Saint-Michel abandonné des touristes se dressait solitairement entre le gris du ciel et le gris de la mer."
                                            },
                                            {
                                                "example_id": "d6a83445-1d76-4684-8e4b-8849f9a513f3",
                                                "sense_id": "b2b8c6b3-212c-3f6a-ae7d-923f03b0e7b2",
                                                "text": "Jeantet se dressa soudain sur ses talons, son teint était devenu rouge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "531c52a9-4a33-483f-9441-dce488651f9c",
                        "source_entry_id": "5c787497-1157-3bf4-88e3-59dcbd7fc4b8",
                        "source_sense_description": "злиться, сердиться",
                        "target_lang_word": "s'irriter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8d4b7ef4-cd66-42bf-a290-5691f602a7da",
                        "source_entry_id": "5c787497-1157-3bf4-88e3-59dcbd7fc4b8",
                        "source_sense_description": "злиться, сердиться",
                        "target_lang_word": "se fâcher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se fâcher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98b37fe8-17e3-34e0-8b56-b69119701970",
                                        "entry_id": "354ebd48-d057-3a89-8d7f-9ac271e58b63",
                                        "glosses": [
                                            "Se mettre en colère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be284b1c-0676-4513-9e0b-8524b101e221",
                                                "sense_id": "98b37fe8-17e3-34e0-8b56-b69119701970",
                                                "text": "Il n'y avait pas moyen de se fâcher contre cette créature. Pibrac et Delle ne purent pas s'empêcher de rire aussi. La glace était rompue et la conversation tourna vite à la gaité."
                                            },
                                            {
                                                "example_id": "b5b3b891-9bc7-49f5-ab36-fe020e62e4e6",
                                                "sense_id": "98b37fe8-17e3-34e0-8b56-b69119701970",
                                                "text": "Le Capitaine, […], s’était fâché rouge lorsque son fils avait réclamé ses comptes de tutelle, et même lui avait coupé les vivres, tout net."
                                            },
                                            {
                                                "example_id": "758272ec-14c2-44a1-b5c4-0625afd9d6d2",
                                                "sense_id": "98b37fe8-17e3-34e0-8b56-b69119701970",
                                                "text": "Te fâche pas, Jo, qu’il a rambiné très papelard, à toi la parole, je ne l’ouvre plus."
                                            },
                                            {
                                                "example_id": "6f943440-6094-4627-bb5f-6757066c0e74",
                                                "sense_id": "98b37fe8-17e3-34e0-8b56-b69119701970",
                                                "text": "C’est dans cet accès spontané, tout naturel, à ses sentiments et à ses désirs personnels que l’être humain puise sa force intérieure et son respect de lui-même. Il a le droit de vivre ses émotions, d’être triste, désespéré ou d’avoir besoin d’aide, sans trembler de perturber quelqu’un. Il a le droit d’avoir peur quand il se sent menacé, de se fâcher quand il ne peut satisfaire ses désirs. Il sait non seulement ce qu’il ne veut pas, mais aussi ce qu’il veut, et se permet de l’exprimer – que cela lui vaille d’être aimé ou détesté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
