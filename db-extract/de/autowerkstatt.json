                                            },
                                            {
                                                "example_id": "c35e8e84-3269-42ad-9e77-0a7509b28c0a",
                                                "sense_id": "6083760f-3e16-32c9-9334-fdb190c74473",
                                                "text": "Ik wist niet wat ik zag toen ik aankwam. De hele tuin was omgetoverd tot een festivalterrein met ruim vijftig tenten die met minder dan een centimeter tussenruimte waren opgezet. In de garage stonden honderden resupplydozen met voedsel die hikers aan zichzelf hadden gestuurd. Er was wifi en Donna Saufley bood zelfs aan mijn was te doen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b574f444-c5d4-3d91-b499-685c10146f61",
                                        "entry_id": "0b13f3f9-17b8-31a3-9131-b7d72b1f74c8",
                                        "glosses": [
                                            "een bedrijf dat reparatieservices aan motorvoertuigen verricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "682a8ea2-8a6e-4de4-9c52-40eaa0691c79",
                                                "sense_id": "b574f444-c5d4-3d91-b499-685c10146f61",
                                                "text": "Je moet die kapotte auto nu toch echt naar de garage brengen."
                                            },
                                            {
                                                "example_id": "6f1fda31-144c-4d2a-b8fd-dac0e7fa98d4",
                                                "sense_id": "b574f444-c5d4-3d91-b499-685c10146f61",
                                                "text": "De herinnering aan de Nationale 7 wordt ook levend gehouden in kleine musea, vaak gerund door vrijwilligers. In een oude garage in Piolenc bij Orange is een charmant museum gevestigd met oude auto's, foto's, reclameborden en andere memorabilia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
