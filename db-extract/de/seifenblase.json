                                "target_senses": [
                                    {
                                        "sense_id": "a713cf6f-5abc-39b0-bd12-5efc58cbcdff",
                                        "entry_id": "98fba927-53d9-3b7a-84de-e7cdcae3079c",
                                        "glosses": [
                                            "A very thin film of soapy water that forms a sphere with an iridescent surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13621cdd-b210-3f3f-809c-47cd452e73b0",
                                        "entry_id": "98fba927-53d9-3b7a-84de-e7cdcae3079c",
                                        "glosses": [
                                            "Anything attractive but insubstantial."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82c26b8-f3ac-4f27-8708-83d57bc1e5e6",
                                                "sense_id": "13621cdd-b210-3f3f-809c-47cd452e73b0",
                                                "text": "These words so pierce this soap-bubble of the metaphysicians, that we can hardly read them without fancying that the poet meant them to be ironical."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
