    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "49bab57f-e73f-3d58-b470-0cea9779f938",
                    "sense_definition": "het tonen of laten zien van een bewijs of document",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "presentatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op <w>vertoon</w> van je abonnement mag je de trein nemen.",
                            "target_lang_translations": {
                                "en": "Upon <w>presentation</w> of your season ticket, you may take the train."
                            }
                        },
                        {
                            "text": "De bezoeker kreeg alleen toegang tot de zaal op <w>vertoon</w> van een geldig legitimatiebewijs.",
                            "target_lang_translations": {
                                "en": "The visitor was only granted access to the hall upon <w>production</w> of a valid ID."
                            }
                        }
                    ],
                    "synonyms": [
                        "overlegging"
                    ],
                    "common_phrases": [
                        "op vertoon van"
                    ],
                    "target_lang_definitions": {
                        "en": "the act of showing or presenting a proof or document"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "presentation",
                                "target_lang_sense_clarification": "of a document or ID"
                            },
                            {
                                "target_lang_word": "production",
                                "target_lang_sense_clarification": "of evidence or papers"
                            },
                            {
                                "target_lang_word": "showing",
                                "target_lang_sense_clarification": "of a ticket or pass"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86779f1d-2b1e-31e1-b6ab-542f20324df7",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>vertonen</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>vertoon</w> mijn nieuwste film vanavond voor het eerst aan een klein publiek.",
                            "target_lang_translations": {
                                "en": "I am <w>screening</w> my latest film for the first time tonight for a small audience."
                            }
                        },
                        {
                            "text": "Soms <w>vertoon</w> ik vreemd gedrag als ik erg zenuwachtig ben voor een examen.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>exhibit</w> strange behavior when I am very nervous for an exam."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first-person singular present indicative of 'vertonen' (to show, display, or exhibit)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "show",
                                "target_lang_sense_clarification": "to display something"
                            },
                            {
                                "target_lang_word": "exhibit",
                                "target_lang_sense_clarification": "to demonstrate a behavior or trait"
                            },
                            {
                                "target_lang_word": "screen",
                                "target_lang_sense_clarification": "to show a film"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e20bbc77-3264-3795-a453-714649e147ce",
                    "sense_definition": "gebiedende wijs van <w>vertonen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vertoon</w> je onmiddellijk bij de hoofdingang van het gebouw!",
                            "target_lang_translations": {
                                "en": "<w>Report</w> immediately to the main entrance of the building!"
                            }
                        },
                        {
                            "text": "<w>Vertoon</w> geen angst wanneer je voor de grote groep mensen moet spreken.",
                            "target_lang_translations": {
                                "en": "Do not <w>show</w> any fear when you have to speak in front of the large group of people."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "imperative form of 'vertonen' (to show, appear, or display)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "show",
                                "target_lang_sense_clarification": "command to display something"
                            },
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "command to present oneself"
                            },
                            {
                                "target_lang_word": "display",
                                "target_lang_sense_clarification": "command to exhibit a quality"
                            }
                        ]
                    }
                }
            ]
