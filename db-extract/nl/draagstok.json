                    },
                    {
                        "translation_id": "9e866c4e-3ff2-46bc-8c68-d9544cfd3032",
                        "source_entry_id": "e8c53808-7240-37c2-a3e0-44c715244e48",
                        "source_sense_id": "44937950-b60d-3697-a149-e66da062b508",
                        "source_sense_description": "stok waaraan men iets draagt",
