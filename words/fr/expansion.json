            "senses": [
                {
                    "sense_id": "f3c2c61b-670e-3053-9ce7-64a427ceeb95",
                    "sense_definition": "Croissance, développement ou accroissement important en volume, en territoire ou en activité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "croissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise technologique connaît une formidable <w>expansion</w> sur les marchés internationaux."
                        },
                        {
                            "text": "Le secteur des énergies renouvelables est actuellement en pleine <w>expansion</w> dans notre région."
                        }
                    ],
                    "synonyms": [
                        "croissance",
                        "développement",
                        "essor"
                    ],
                    "antonyms": [
                        "déclin",
                        "récession",
                        "régression"
                    ],
                    "common_phrases": [
