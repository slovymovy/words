                "senses": [
                    {
                        "sense_id": "cb4e6d4e-5efe-3fa9-bf83-f1cc59334c95",
                        "entry_id": "5eda2174-e015-30e2-8c28-269d363687c4",
                        "glosses": [
                            "zestawienie wyrazów podobnie brzmiących o różnych znaczeniach"
                        ],
                        "tags": [],
