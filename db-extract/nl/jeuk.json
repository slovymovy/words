                    {
                        "sense_id": "f648c68d-ddee-3b2a-ae47-4ebc5d043d3d",
                        "entry_id": "ae4e5af6-c63a-3ffe-b286-93b4f456da69",
                        "glosses": [
                            "kriebel"
                        ],
