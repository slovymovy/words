                            {
                                "target_word": "selva",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "9593954d-4bb1-39dd-a9f4-fa4953d83906",
                                        "entry_id": "5fdc8657-00c6-3894-adc2-e3cd64ff5520",
                                        "glosses": [
                                            "bioma florestal caracterizado por vegetação densa e de grande biodiversidade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0707f96a-f0f4-4f97-9915-28bf6af03cd2",
                                                "sense_id": "9593954d-4bb1-39dd-a9f4-fa4953d83906",
                                                "text": "Ele esteve no Brasil em março, e cantou do extremo sul ao Amazonas, onde - lembra com orgulho - foi saudado por indígenas no meio da selva."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da629e9d-4fad-4838-9472-5d068ad8846b",
                        "source_entry_id": "709713be-38df-3b60-9f8c-1d62ec814b27",
                        "target_lang_word": "сельва",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сельва",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7e6dee82-2b5c-31c7-9920-126f3f3509b9",
                                        "entry_id": "e97ed64d-3784-32b9-b818-dff1bae4dccf",
                                        "glosses": [
                                            "влажный экваториальный или тропический лес, обычно — в Южной Америке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0f48c0-ad75-408a-b785-c7206b88fbf4",
                                                "sense_id": "7e6dee82-2b5c-31c7-9920-126f3f3509b9",
                                                "text": "А у вас — полидоминантное сообщество, очень много разных видов, известно, что там на одном гектаре амазонской сельвы больше видов деревьев, чем во всей Англии."
                                            },
                                            {
                                                "example_id": "36de9f96-ea05-48e0-85cc-d74489694247",
                                                "sense_id": "7e6dee82-2b5c-31c7-9920-126f3f3509b9",
                                                "text": "Рядом стеной стояла совершенно непроходимая сельва, из которой время от времени на нашу территорию вторгались представители здешней экзотической фауны."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
