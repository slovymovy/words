                "senses": [
                    {
                        "sense_id": "651481e9-7de0-300b-a177-19c0d66b8e2c",
                        "entry_id": "25f759e9-1f49-33aa-bb5d-a90413bf4ccb",
                        "glosses": [
                            "Schokolade"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "colloquial",
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "69479677-705f-4ebe-913d-d150979dd33a",
                                "sense_id": "651481e9-7de0-300b-a177-19c0d66b8e2c",
                                "text": "„In seinem winzigen Zimmer hat er für uns frische Brötchen und heiße Schoggi vorbereitet.“"
                            },
                            {
                                "example_id": "1976469a-b1de-45f7-8282-74d765a02e94",
                                "sense_id": "651481e9-7de0-300b-a177-19c0d66b8e2c",
                                "text": "„Und dann, wenn das Holz im Ofen knistere, werde er einen Topf auf den Ofen setzen und darin Schoggi schmelzen.“"
                            },
                            {
                                "example_id": "e22293e0-a891-42e2-abf1-01d734c78f10",
                                "sense_id": "651481e9-7de0-300b-a177-19c0d66b8e2c",
                                "text": "„Lisa sagte ihr Gedicht auf, und der Klaus belohnte sie mit vielen Nüssen, Mandarinen, Lebkuchen und Schoggi.“"
                            },
                            {
                                "example_id": "ef768a84-9090-49fc-bf4d-6ea5eb942d76",
                                "sense_id": "651481e9-7de0-300b-a177-19c0d66b8e2c",
                                "text": "„Die Schoggis habe ich verteilt, man lässt sich durch mich vielmals herzlich bedanken!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
