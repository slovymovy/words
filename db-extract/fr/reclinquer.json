                "senses": [
                    {
                        "sense_id": "f7ba5f1f-1f28-33e3-822a-cd9935ab6f45",
                        "entry_id": "864c0b6c-6012-3b44-8b83-2c7e2d2c8a12",
                        "glosses": [
                            "Réparer un bateau dont la bordée est assemblée avec des clins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc06ceb-a238-4cd9-a48f-26b5550cf25c",
                                "sense_id": "f7ba5f1f-1f28-33e3-822a-cd9935ab6f45",
                                "text": "Charpentiers, calfats, cordiers, forgerons ont travaillé sans relâche pour réparer, pour « reclinquer » nefs, hourques, barges et pour en construire de nouvelles."
                            }
                        ]
                    },
                    {
                        "sense_id": "8030d08e-c9a6-3c0f-ba74-f6d465405b8f",
                        "entry_id": "864c0b6c-6012-3b44-8b83-2c7e2d2c8a12",
                        "glosses": [
                            "Retaper, requinquer, faire revenir à un état normal."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4d20e7bf-dd13-4c78-9684-6f563654930b",
                                "sense_id": "8030d08e-c9a6-3c0f-ba74-f6d465405b8f",
                                "text": "En temps ordinaire, harcelé par un bon tisonneur, Lorimer se reconnaît quelques dons : pour ranimer des sourires écrasés aux commissures des lèvres, reclinquer des regards éteints au fond de golfes sombres, revigorer des poitrines affalées à force d'angoisses tues, redresser des dos voûtés sous une charge de malheurs endurcis."
                            }
                        ]
                    }
                ],
