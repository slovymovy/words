                "forms": [],
                "senses": [
                    {
                        "sense_id": "56aa7b9e-9194-3b64-a0c9-498816c465f0",
                        "entry_id": "382242bc-2686-33fd-bf08-321a95dd6f1d",
                        "glosses": [
                            "теопатия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "759a0ac2-af84-4692-abd2-f12e3292179f",
                                "sense_id": "56aa7b9e-9194-3b64-a0c9-498816c465f0",
                                "text": "Hartley calls the moral sense the «monitor» of sympathy and theopathy; it is a higher ego, or self, beyond the ego."
                            },
                            {
                                "example_id": "fbe21db1-47b3-4d55-972d-b2057e1a8286",
                                "sense_id": "56aa7b9e-9194-3b64-a0c9-498816c465f0",
                                "text": "Theopathy is that state of the affections towards God, which makes him not only the primary object of love, but the centre of repose, of trust, and of happiness in the heart."
                            }
                        ]
                    }
                ],
