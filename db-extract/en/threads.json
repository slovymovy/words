    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "175e616b-4dbe-31a5-a662-aded410ba30c",
                "word": "Threads",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f66bd5e0-acc3-33ec-82ec-1110b9780ded",
                        "entry_id": "175e616b-4dbe-31a5-a662-aded410ba30c",
                        "glosses": [
                            "A social media platform developed by Meta, integrated into the fediverse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "920d851c-3991-40d3-a0dc-02b662fb67c9",
                                "sense_id": "f66bd5e0-acc3-33ec-82ec-1110b9780ded",
                                "text": "On the one hand, Threads has a decent chance of becoming a — maybe even the — major new hub for text-based online conversations. Unlike other would-be Twitter rivals Bluesky and Mastodon, Threads arrives with a potential audience of billions who already use Meta’s photo and video-oriented Instagram, which Threads is built on top of."
                            },
                            {
                                "example_id": "d229bd4b-c458-4b3b-af71-6cdef11e0aae",
                                "sense_id": "f66bd5e0-acc3-33ec-82ec-1110b9780ded",
                                "text": "The point of Meta's Threads app is to read and engage in public conversations. On Threads, users can post a \"thread\" — usually a short piece of text — and other users can \"like,\" repost, or reply to the thread."
                            },
                            {
                                "example_id": "6e2b50eb-e590-40c3-b0a0-aecd592b9df4",
                                "sense_id": "f66bd5e0-acc3-33ec-82ec-1110b9780ded",
                                "text": "Meta did initially suggest that it wouldn’t look to launch ads in Threads till the app reached a billion users, though initial Threads ad formats were spotted in testing in August last year."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73ccb9ef-ac0d-41e5-a55d-c6f161dfb5c0",
                        "source_entry_id": "175e616b-4dbe-31a5-a662-aded410ba30c",
                        "source_sense_id": "f66bd5e0-acc3-33ec-82ec-1110b9780ded",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Threads",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
