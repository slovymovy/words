                "senses": [
                    {
                        "sense_id": "2169713f-5c62-3eee-a877-4b280d5677cb",
                        "entry_id": "a6f4c3e3-1421-337f-9384-7755c3068be6",
                        "glosses": [
                            "związany z Asyżem, dotyczący Asyżu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "455a96b2-9a0e-4acf-9f84-0a6d6010f311",
                                "sense_id": "2169713f-5c62-3eee-a877-4b280d5677cb",
                                "text": "Obraz przedstawiał asyskiego patrona."
                            },
                            {
                                "example_id": "59843bed-57d7-4f8d-9392-e28e78d48d56",
                                "sense_id": "2169713f-5c62-3eee-a877-4b280d5677cb",
                                "text": "We wrześniu zwiedziliśmy asyskie zabytki."
                            },
                            {
                                "example_id": "dee8b942-5913-41ba-945a-ff140da05c3c",
                                "sense_id": "2169713f-5c62-3eee-a877-4b280d5677cb",
                                "text": "Ze swego zaoceanicznego miejsca pobytu Wittlin pisał 30 grudnia 1959 roku: „Straszną rzeczą jest dla pisarza starzeć się w obcym świecie i to w dodatku w Nowym Jorku, będącym chyba ostateczną antypodą Asyżu i wszystkiego, co asyskie”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
