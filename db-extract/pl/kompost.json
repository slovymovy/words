                    {
                        "translation_id": "f190f41b-af1a-4446-8c7e-d7d9397d7911",
                        "source_entry_id": "333d322f-d443-383a-a8a2-ba16bfd0aa97",
                        "source_sense_id": "f422eda1-fdf9-39ba-a90d-bf75e95eb830",
                        "target_lang_word": "Kompost",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kompost",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                        "entry_id": "89135e62-311d-302d-8d5d-d2616609b588",
                                        "glosses": [
                                            "organische Stoffe im Endstadium der Rotte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc7b8a5-9308-48f0-8730-7dbc3e6b2433",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "Zur Herstellung eines guten Kompostes benötigt man viele Regenwürmer."
                                            },
                                            {
                                                "example_id": "9e502539-b3ad-4ca8-835a-658a4c79c214",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "„Das Camp war auch umweltfreundlich, produzierte Solarstrom und verarbeitete alle Küchenabfälle zu Kompost, mit dem der ausgedehnte Gemüsegarten gedüngt wurde.“"
                                            },
                                            {
                                                "example_id": "a722b6f4-cba2-4211-80da-b436c529cb2b",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "„Ich brachte die Schalen auf den Kompost, und die Mutter setzte die Kartoffeln auf.“"
                                            },
                                            {
                                                "example_id": "5ba66804-8fba-4e62-9b7b-87dbec01e0fe",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "„Mein Blick fiel auf die Elster, die auf dem Kompost zwischen den riesigen Kürbisblättern herumhüpfte.“"
                                            },
                                            {
                                                "example_id": "8bfcf7d2-d5f8-49a6-bde2-ee77a807d2d9",
                                                "sense_id": "1fc80cba-0ad7-394a-ba81-02c6dce2afe6",
                                                "text": "„Nachdem die Pflanzlöcher gegraben waren, schnitten sie das äußerste Ende sämtlicher Wurzeln ab, der guten wie der schlechten, und setzten sie in Kompost ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
