                                        "examples": [
                                            {
                                                "example_id": "80bfda15-b992-4cdb-a835-e2fae640809c",
                                                "sense_id": "5ce43426-1f75-3ced-9b4e-b0d59fa2dea0",
                                                "text": "When the Turkes took Constantinople, they melted the Bells into Ordnance; I have heard both Bells and Ordnance, but never been so much affected with those, as with these Bells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79616640-a840-3f3c-91a3-5f9a256ebe20",
                                        "entry_id": "d7176e4f-22be-3c36-a2e0-76ed0a78aab3",
                                        "glosses": [
                                            "Artillery."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "428d33fc-81bd-4563-9382-3b3be81836e9",
                                                "sense_id": "79616640-a840-3f3c-91a3-5f9a256ebe20",
                                                "text": "From the belfries far and near the funereal deathbell tolled unceasingly while all around the gloomy precincts rolled the ominous warning of a hundred muffled drums punctuated by the hollow booming of pieces of ordnance."
                                            }
