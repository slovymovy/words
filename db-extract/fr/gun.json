                        "examples": [
                            {
                                "example_id": "c6f7d314-8189-4e18-bfbf-b075255faab5",
                                "sense_id": "96fd4f73-4a79-3a91-b020-75d05b405460",
                                "text": "Pis vous croyez vraiment que Moustafa Abdel Jalil le président du conseil est autre chose qu’un pantin de l’occident? Il préside avec un gun de la CIA sur la tempe."
                            },
                            {
                                "example_id": "ac46a533-ff7e-4ffa-8f70-3757db1a2486",
                                "sense_id": "96fd4f73-4a79-3a91-b020-75d05b405460",
                                "text": "Il est allé chercher quoi, là ? Une matraque ? Un gun ? Un bazooka ?"
                            },
                            {
                                "example_id": "c95c42f7-3c30-4f5e-a27d-f5e08d04fecf",
                                "sense_id": "96fd4f73-4a79-3a91-b020-75d05b405460",
                                "text": "Avec un gun su’a tempe, avec un canon dans l'front me semble, qu’c’est dur de dire non."
                            },
                            {
                                "example_id": "bb6eaaf1-3a27-46fd-aac6-3458d033a1af",
                                "sense_id": "96fd4f73-4a79-3a91-b020-75d05b405460",
                                "text": "Mais ce qui est vrai, c’est que mes empreintes sont sur le gun, ajouta-t-il plus bas."
                            }
                        ]
                    }
