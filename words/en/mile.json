{
    "word_family": [
        "mileage",
        "miler",
        "milestone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d205347b-f296-39e1-aeab-9d492ab75119",
                    "sense_definition": "A unit of distance equal to 1,760 yards or approximately 1.6 kilometers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "unit_of_length",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nearest gas station is about five <w>miles</w> down the road.",
                            "target_lang_translations": {
                                "ru": "Ближайшая заправка находится примерно в пяти <w>милях</w> по дороге.",
                                "zh": "最近的加油站就在这条路前方约五<w>英里</w>处。"
                            }
                        },
                        {
                            "text": "She runs three <w>miles</w> every morning to stay fit.",
                            "target_lang_translations": {
                                "ru": "Она пробегает три <w>мили</w> каждое утро, чтобы поддерживать форму.",
                                "zh": "她每天早上跑三<w>英里</w>来保持健康。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "miles per hour",
                        "miles away",
                        "square mile",
                        "nautical mile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения расстояния, равная 1760 ярдам или примерно 1,6 километра.",
                        "zh": "一种长度单位，等于1760码或约1.6公里。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миля",
                                "target_lang_sense_clarification": "мера длины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "英里",
                                "target_lang_sense_clarification": "长度单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c7a5061-b96a-34a9-9efe-f3501251f163",
                    "sense_definition": "A point earned in a frequent flyer program that can be used to pay for flights or upgrades.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have collected enough <w>miles</w> to get a free ticket to Paris.",
                            "target_lang_translations": {
                                "ru": "Я накопил достаточно <w>миль</w>, чтобы получить бесплатный билет в Париж.",
                                "zh": "我已经攒够了<w>里程</w>，可以换一张去巴黎的免费机票。"
                            }
                        },
                        {
                            "text": "You can earn extra <w>miles</w> by using this credit card.",
                            "target_lang_translations": {
                                "ru": "Вы можете заработать дополнительные <w>мили</w>, используя эту кредитную карту.",
                                "zh": "使用这张信用卡可以赚取额外的<w>里程</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "point",
                        "reward points",
                        "air miles"
                    ],
                    "common_phrases": [
                        "frequent flyer miles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Балл, начисляемый в программах лояльности авиакомпаний, который можно использовать для оплаты перелетов.",
                        "zh": "航空公司常旅客计划中积累的积分，可用于兑换机票或升舱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миля",
                                "target_lang_sense_clarification": "бонус авиакомпании"
                            },
                            {
                                "target_lang_word": "балл",
                                "target_lang_sense_clarification": "единица счета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "里程",
                                "target_lang_sense_clarification": "航空积分"
                            },
                            {
                                "target_lang_word": "积分",
                                "target_lang_sense_clarification": "奖励点数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b892971-4258-37c5-8a6c-222830002ccf",
                    "sense_definition": "One mile per hour, used as a measure of speed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was driving ten <w>miles</w> over the speed limit.",
                            "target_lang_translations": {
                                "ru": "Он превысил скорость на десять <w>миль</w>.",
                                "zh": "他开车超速了十<w>英里</w>。"
                            }
                        },
                        {
                            "text": "The car was doing ninety <w>miles</w> on the freeway.",
                            "target_lang_translations": {
                                "ru": "Машина ехала по шоссе со скоростью девяносто <w>миль</w>.",
                                "zh": "那辆车在高速公路上以时速九十<w>英里</w>行驶。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for 'miles per hour'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна миля в час, используется как мера скорости.",
                        "zh": "指代“英里每小时”，用作速度单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миля",
                                "target_lang_sense_clarification": "миля в час (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "英里",
                                "target_lang_sense_clarification": "速度单位（口语）"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "345a284b-e2dd-3007-829c-28c7ec64cbaf",
                    "sense_definition": "A running race over a distance of one mile.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He holds the school record for the <w>mile</w>.",
                            "target_lang_translations": {
                                "ru": "Ему принадлежит школьный рекорд в беге на <w>милю</w>.",
                                "zh": "他保持着学校的<w>英里赛</w>纪录。"
                            }
                        },
                        {
                            "text": "Athletes from around the world competed in the <w>mile</w>.",
                            "target_lang_translations": {
                                "ru": "Спортсмены со всего мира соревновались в забеге на <w>милю</w>.",
                                "zh": "来自世界各地的运动员参加了这项<w>英里赛</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "run the mile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забег на дистанцию в одну милю.",
                        "zh": "一英里距离的赛跑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миля",
                                "target_lang_sense_clarification": "дистанция бега"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "英里赛",
                                "target_lang_sense_clarification": "跑步比赛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72ca9984-a5c4-3c7a-96d9-5c5d284018f6",
                    "sense_definition": "A very large distance or a large margin.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His guess was off by a <w>mile</w>.",
                            "target_lang_translations": {
                                "ru": "Он ошибся на целую <w>милю</w>.",
                                "zh": "他猜得简直是<w>十万八千里</w>。"
                            }
                        },
                        {
                            "text": "You can see that he is nervous a <w>mile</w> off.",
                            "target_lang_translations": {
                                "ru": "То, что он нервничает, видно за <w>версту</w>.",
                                "zh": "你从<w>老远</w>就能看出他很紧张。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "miss by a mile",
                        "stand out a mile",
                        "run a mile"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used figuratively for emphasis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большое расстояние или значительное преимущество.",
                        "zh": "指极大的距离或巨大的差距。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верста",
                                "target_lang_sense_clarification": "перен. большое расстояние"
                            },
                            {
                                "target_lang_word": "миля",
                                "target_lang_sense_clarification": "прямое значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十万八千里",
                                "target_lang_sense_clarification": "形容差距极大"
                            },
                            {
                                "target_lang_word": "老远",
                                "target_lang_sense_clarification": "形容距离很远"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "036d9914-3266-3ac7-ab82-16dcadebeecf",
                    "sense_definition": "A male given name from Macedonian.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My neighbor <w>Mile</w> is originally from Skopje.",
                            "target_lang_translations": {
                                "ru": "Мой сосед <w>Миле</w> родом из Скопье.",
                                "zh": "我的邻居<w>米莱</w>来自斯科普里。"
                            }
                        },
                        {
                            "text": "We invited <w>Mile</w> to the dinner party.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили <w>Миле</w> на званый ужин.",
                                "zh": "我们邀请了<w>米莱</w>来参加晚宴。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя македонского происхождения.",
                        "zh": "马其顿语源的男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Миле",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "米莱",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f43d1487-0fe9-3086-a013-1ef7c187df3e",
                    "sense_definition": "A city in Yunnan province, China.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They traveled to <w>Mile</w> to see the famous Buddha statue.",
                            "target_lang_translations": {
                                "ru": "Они поехали в <w>Милэ</w>, чтобы увидеть знаменитую статую Будды.",
                                "zh": "他们去<w>弥勒</w>旅游，参观了那座著名的佛像。"
                            }
                        },
                        {
                            "text": "The city of <w>Mile</w> is known for its hot springs.",
                            "target_lang_translations": {
                                "ru": "Город <w>Милэ</w> известен своими горячими источниками.",
                                "zh": "<w>弥勒</w>市以其温泉而闻名。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в провинции Юньнань, Китай.",
                        "zh": "中国云南省的一个城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Милэ",
                                "target_lang_sense_clarification": "город"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弥勒",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
