                "senses": [
                    {
                        "sense_id": "d694e200-7805-323b-aa99-688927f0f58a",
                        "entry_id": "e5797229-ce3e-32e5-81df-3b718ef76719",
                        "glosses": [
                            "разг. прикрыть от солнца, света, скрыть в тени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "126572f0-8ac2-4068-b579-dcd6e3542d38",
                                "sense_id": "d694e200-7805-323b-aa99-688927f0f58a",
                                "text": "За 3–4 дня до высадки в грунт клубни нужно притенить, прикрыть мешковиной или любой тёмной тканью, чтобы они «привыкли» к темноте, а перед самой посадкой опудрить их золой."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d802df7-6605-3062-b1dc-d7e481454ea9",
                        "entry_id": "e5797229-ce3e-32e5-81df-3b718ef76719",
                        "glosses": [
                            "спец. (о живописи) наложить тень на что-либо, слегка оттенить что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35fbd3f0-01eb-4727-b325-b8c53ba216dd",
                                "sense_id": "5d802df7-6605-3062-b1dc-d7e481454ea9",
                                "text": "Притенить волосы, лицо на портрете."
                            },
                            {
                                "example_id": "f3803896-d38c-4d70-a3c6-9690b305a149",
                                "sense_id": "5d802df7-6605-3062-b1dc-d7e481454ea9",
                                "text": "Притенить чёрным или синим."
                            },
                            {
                                "example_id": "8ad5d570-1a0c-4262-aa58-f1ec32d87bb1",
                                "sense_id": "5d802df7-6605-3062-b1dc-d7e481454ea9",
                                "text": "Едва заметно притенить."
                            }
                        ]
                    }
