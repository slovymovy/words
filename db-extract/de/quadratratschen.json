                "senses": [
                    {
                        "sense_id": "4a30d8d7-ca6a-3240-844e-c4ca3d9813f6",
                        "entry_id": "8b3b3372-2040-3c92-94c3-8b590ecaac66",
                        "glosses": [
                            "besonders schwatzhafte, Klatsch verbreitende Person"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "24baaec4-4e20-4053-b80b-6a25344880d5",
                                "sense_id": "4a30d8d7-ca6a-3240-844e-c4ca3d9813f6",
                                "text": "„Wir haben Beschreibungen dieser Frauen als Klatschbasen, Schwatzbasen, Quasseltanten, Quasselstrippen, im Bayerischen als Quadratratschen und Tratschtanten.“"
                            },
                            {
                                "example_id": "9be9984a-2ee8-49bb-9590-fdadd2d22449",
                                "sense_id": "4a30d8d7-ca6a-3240-844e-c4ca3d9813f6",
                                "text": "„Sie ist so gfotzert, das selbst eine Quadratratschn wortkarg wirkt.“"
                            },
                            {
                                "example_id": "17ca3b22-283d-4983-9836-a62bc38a564f",
                                "sense_id": "4a30d8d7-ca6a-3240-844e-c4ca3d9813f6",
                                "text": "„Die Quadratratschen aus ihrem Heimatort, die ihr keine schönen Äußerungen an den Kopf warf, in der Zeit, als ihr Leben ohnehin ein Spießrutenlauf war!“"
                            },
                            {
                                "example_id": "98671625-960c-420a-8248-6c1940bb3f57",
                                "sense_id": "4a30d8d7-ca6a-3240-844e-c4ca3d9813f6",
                                "text": "„Wenn jemand über das soziale Umfeld der Gebrüder, über deren Macken und Marotten, deren Gewohnheiten und Vorlieben Bescheid wusste, dann eine Quadratratschen von ihrem Kaliber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
