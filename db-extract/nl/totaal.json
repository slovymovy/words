                "forms": [],
                "senses": [
                    {
                        "sense_id": "067065d7-400f-3226-96c8-3bb8be9df956",
                        "entry_id": "80e3af65-9405-3a93-9371-f1de1919ef8c",
                        "glosses": [
                            "alle onderdelen tezamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5294a77-d9ff-493c-b09e-292787128c4f",
                                "sense_id": "067065d7-400f-3226-96c8-3bb8be9df956",
                                "text": "Het totaal is meer dan de som der delen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6756ab3c-94b2-440e-896c-006c24cd7173",
                        "source_entry_id": "80e3af65-9405-3a93-9371-f1de1919ef8c",
                        "source_sense_id": "067065d7-400f-3226-96c8-3bb8be9df956",
                        "source_sense_description": "alle onderdelen tezamen",
                        "target_lang_word": "total",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "total",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "581ddf1c-8dbb-33d0-9d14-af0061e981e5",
                                        "entry_id": "c92386e5-844e-3a86-80e8-beff582c92d9",
                                        "glosses": [
                                            "An amount obtained by the addition of smaller amounts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "651e8397-c5ec-4054-8f56-00fa41f451c3",
                                                "sense_id": "581ddf1c-8dbb-33d0-9d14-af0061e981e5",
                                                "text": "A total of £145 was raised by the bring-and-buy stall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b2588a0-eb6d-3428-9ba6-c894a1430dc9",
                                        "entry_id": "c92386e5-844e-3a86-80e8-beff582c92d9",
                                        "glosses": [
                                            "Sum."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3a4d5e0-34d3-4039-88e1-4084f00baa78",
                                                "sense_id": "8b2588a0-eb6d-3428-9ba6-c894a1430dc9",
                                                "text": "The total of 4, 5 and 6 is 15."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "total",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49dd2ba4-7824-37ef-a76f-cc483464ce6c",
                                        "entry_id": "53b9c5b9-4cd4-3de6-9f00-d6c5fc97f43a",
                                        "glosses": [
                                            "Entire; relating to the whole of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e0f52c3-262e-483e-ab11-453dd86e6ebe",
                                                "sense_id": "49dd2ba4-7824-37ef-a76f-cc483464ce6c",
                                                "text": "The total book is rubbish from start to finish.  The total number of votes cast is 3,270."
                                            },
                                            {
                                                "example_id": "3e41b030-19dd-49f6-a2f0-9b8d1d0de2e0",
                                                "sense_id": "49dd2ba4-7824-37ef-a76f-cc483464ce6c",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers,[…]. Even such a boat as the Mount Vernon offered a total deck space so cramped as to leave secrecy or privacy well out of the question, even had the motley and democratic assemblage of passengers been disposed to accord either."
                                            },
                                            {
                                                "example_id": "539a3f8d-7ef1-4f3f-b1ab-a9bf9dc11b23",
                                                "sense_id": "49dd2ba4-7824-37ef-a76f-cc483464ce6c",
                                                "text": "Each member brought a unique musical influence to the total sound."
                                            },
                                            {
                                                "example_id": "4b25a6c6-d25c-486a-86fb-162cea920ef3",
                                                "sense_id": "49dd2ba4-7824-37ef-a76f-cc483464ce6c",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bc72b52-22f8-3810-a862-275ebb77cbfb",
                                        "entry_id": "53b9c5b9-4cd4-3de6-9f00-d6c5fc97f43a",
                                        "glosses": [
                                            "Complete; absolute."
                                        ],
                                        "tags": [
                                            "used as an intensifier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "326cac7d-88ba-4248-bc12-91dfff85e65b",
                                                "sense_id": "4bc72b52-22f8-3810-a862-275ebb77cbfb",
                                                "text": "He is a total failure."
                                            },
                                            {
                                                "example_id": "137a3739-4730-460b-9c5a-9b5394ad52d4",
                                                "sense_id": "4bc72b52-22f8-3810-a862-275ebb77cbfb",
                                                "text": "Air waid! Wights out! Total bwackout!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e4e047-8fc1-383f-a173-d9f0b23351f6",
                                        "entry_id": "53b9c5b9-4cd4-3de6-9f00-d6c5fc97f43a",
                                        "glosses": [
                                            "Defined on all possible inputs."
                                        ],
                                        "tags": [
                                            "of a function"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba023f2-5635-49e2-809e-5621bcc1e023",
                                                "sense_id": "89e4e047-8fc1-383f-a173-d9f0b23351f6",
                                                "text": "The Ackermann function is one of the simplest and earliest examples of a total computable function that is not primitive recursive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63946a5d-9b91-353e-a1a8-4e4d33a2d025",
                                        "entry_id": "53b9c5b9-4cd4-3de6-9f00-d6c5fc97f43a",
                                        "glosses": [
                                            "Left total: Such that for every x in X there is a y in Y with x R y."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3285d708-5c65-378c-8bd0-6597f14a8da0",
                                        "entry_id": "53b9c5b9-4cd4-3de6-9f00-d6c5fc97f43a",
                                        "glosses": [
                                            "Such that any two elements are comparable, i.e. for all a and b, either a ≤ b, or b ≤ a."
                                        ],
                                        "tags": [
                                            "of a partial order ≤"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "total",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "004b9246-f490-34e0-873a-f116a2f0fe13",
                                        "entry_id": "713eaf45-9f63-3b49-8a77-4412f80eee39",
                                        "glosses": [
                                            "To add up; to calculate the sum of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a44df25-f6c2-4811-a5c5-84ab28e04b44",
                                                "sense_id": "004b9246-f490-34e0-873a-f116a2f0fe13",
                                                "text": "When we totalled the takings, we always got a different figure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d4b1e5d-fc33-3e94-80b9-8b194f77f64e",
                                        "entry_id": "713eaf45-9f63-3b49-8a77-4412f80eee39",
                                        "glosses": [
                                            "To equal a total of; to amount to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05424464-e884-403b-84e9-884e7dc88f8f",
                                                "sense_id": "4d4b1e5d-fc33-3e94-80b9-8b194f77f64e",
                                                "text": "That totals seven times so far."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2334502-8b1d-3c94-9d53-ef4cf7d408bd",
                                        "entry_id": "713eaf45-9f63-3b49-8a77-4412f80eee39",
                                        "glosses": [
                                            "To demolish; to wreck completely. (from total loss)"
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "404360ec-8bde-49c5-93d1-89ed95a6438f",
                                                "sense_id": "d2334502-8b1d-3c94-9d53-ef4cf7d408bd",
                                                "text": "Honey, I’m OK, but I’ve totaled the car."
                                            },
                                            {
                                                "example_id": "7321d18d-6284-40ab-a8dc-759561f5f204",
                                                "sense_id": "d2334502-8b1d-3c94-9d53-ef4cf7d408bd",
                                                "text": "He acted real funny / He hocked up a rock and / It totaled my car!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbdb4240-4864-3729-8b1e-b5886eac03da",
                                        "entry_id": "713eaf45-9f63-3b49-8a77-4412f80eee39",
                                        "glosses": [
                                            "To amount to; to add up to."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bebaacb9-7ec9-4d21-8345-e5b26534a512",
                                                "sense_id": "bbdb4240-4864-3729-8b1e-b5886eac03da",
                                                "text": "It totals nearly a pound."
                                            }
                                        ]
                                    }
                                ]
                            }
