                        "glosses": [
                            "Action de sacraliser, fait de conférer à une personne, un objet ou une idée un caractère sacré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c53c458-4026-44ff-8747-384789913c5f",
                                "sense_id": "d7813933-98b7-3416-8d1e-a3bb11d57660",
                                "text": "La sacralisation de l'enfance, de la victime."
                            },
                            {
                                "example_id": "5a241d25-b81b-47e1-a13d-68fc63ba0be5",
                                "sense_id": "d7813933-98b7-3416-8d1e-a3bb11d57660",
                                "text": "De la sacralisation de la Nature à la naissance de l’écologie."
                            },
                            {
                                "example_id": "c78dcf9f-4a7e-45a3-8da9-7416105faec5",
                                "sense_id": "d7813933-98b7-3416-8d1e-a3bb11d57660",
                                "text": "Durkheim n’a pas présenté une véritable théorie du processus de la sacralisation."
                            }
                        ]
                    },
