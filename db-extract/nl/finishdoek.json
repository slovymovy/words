                        "glosses": [
                            "spandoek dat aangeeft waar het einde van de race zich bevindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a002a86-6b36-4e79-8852-32345ab13e5d",
                                "sense_id": "101f098d-b132-3c3d-b20b-b6057fd68740",
                                "text": "\"Nu zien ze het finishdoek. Dat is belangrijk. Nee, Langeveld gaat al aan! Oh, dat is vroeg, zeg, dat is vroeg. Kan hij Flecha nog wel opvangen?\""
                            },
                            {
                                "example_id": "270d9177-dac6-4497-956c-61e33e80f036",
                                "sense_id": "101f098d-b132-3c3d-b20b-b6057fd68740",
                                "text": "Amper 24 uur eerder gleed de Amerikaanse lievelinge na 1.52,61 onder het finishdoek door, meer dan anderhalve seconde eerder dan Cook. Tina Weirather uit Liechtenstein deelde de derde plaats met de Duitse Maria Höfl-Riesch. Hun achterstand op de zilveren Cook was slechts een honderdste."
                            }
                        ]
                    },
                    {
                        "sense_id": "a87aac14-9d74-37ce-ab8f-40a15b817425",
                        "entry_id": "7ff41b68-d62b-3268-8bb7-4065842a51f2",
                        "glosses": [
                            "vlag die gezwaaid wordt aan het einde van een race"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c32bfcc-eac6-4a65-a886-f6bb2dc11d7a",
                                "sense_id": "a87aac14-9d74-37ce-ab8f-40a15b817425",
                                "text": "Max Verstappen start zondag voor de derde keer in de Grand Prix van Monaco. Nog nooit zag hij er het zwart-wit-geblokte finishdoek. Het doel: dit jaar wél uit de muur blijven en de race voltooien. Tijdens een persbijeenkomst in het vorstendom blikt de jonge Limburger vooruit."
                            }
                        ]
                    }
