                ],
                "senses": [
                    {
                        "sense_id": "f91065da-e918-31bc-8826-498fa22c1881",
                        "entry_id": "ce7e1424-9b08-3a3c-bfb4-77529576ba5c",
                        "glosses": [
                            "Menge an Laktat (Milchsäure) im Blut; physiologischer Marker, der (unter anderem) Hinweise auf die Leistungsfähigkeit und den Trainingszustand gibt"
                        ],
                        "tags": [
                            "insbesondere",
                            "Sportmedizin",
                            "Leistungsdiagnostik"
                        ],
                        "examples": [
                            {
                                "example_id": "e153e795-d8b4-4f71-aafe-e09688fddc84",
                                "sense_id": "f91065da-e918-31bc-8826-498fa22c1881",
                                "text": "„Dennoch führen anaerobe Maximalbelastungen in den oft nur Sekunden dauernden eigentlichen Nahkampfphasen zu hohen Laktatkonzentrationen >15 mmol/l im Blut, so dass gemäß den DKV Empfehlungen zusätzlich eine Verbesserung der Laktattoleranz durch ein anaerobes laktazides Training angestrebt werden sollte.“"
                            },
                            {
                                "example_id": "261de22b-c879-416f-a0ef-b63dedfcfd79",
                                "sense_id": "f91065da-e918-31bc-8826-498fa22c1881",
                                "text": "„Die Laktatkonzentration kann dann über 4 mmol und somit über der anaeroben Schwelle liegen.“"
                            },
                            {
                                "example_id": "753bc80b-60ea-445c-87d9-5edd1939f076",
                                "sense_id": "f91065da-e918-31bc-8826-498fa22c1881",
                                "text": "„Eine Möglichkeit ist der Laktattest, bei dem die Laktatkonzentration im Blut während einer Belastung gemessen wird.“"
                            },
                            {
                                "example_id": "a8e4c52e-531e-4703-b7ac-97174c6499f8",
                                "sense_id": "f91065da-e918-31bc-8826-498fa22c1881",
                                "text": "„Dennoch haben gut trainierte Sportler tendenziell eine niedrigere Laktatkonzentration im Blut, da sie u.a. in der Lage sind Laktat besser zu verwerten und nicht weil sie ausschließlich weniger Laktat produzieren würden.“"
                            },
                            {
                                "example_id": "24cca0c9-6caf-416c-9d25-5d0fd4d1f520",
                                "sense_id": "f91065da-e918-31bc-8826-498fa22c1881",
                                "text": "„Eine Doppelblindstudie mit 10 Schwimmern zeigte, Koffein verbessert die Schwimmgeschwindigkeit, senkt die empfundene Anstrengung und die Laktatkonzentration während eines hochintensiven intermittierenden aeroben Trainings (Salgueiro et al. 2022).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
