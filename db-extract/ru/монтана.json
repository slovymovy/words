                        "examples": [
                            {
                                "example_id": "04d9364a-c8e4-4326-83a2-78156138c330",
                                "sense_id": "b0c76309-85e2-3d0e-9cf1-bfbd6e5a847f",
                                "text": "Я вам скажу по секрету пример: в тысяча девятьсот девятнадцатом году в штате Монтана я бетонировал шоссе, и мы однажды за сутки уложили пятьсот кубов."
                            }
                        ]
