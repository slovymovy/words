                        ],
                        "form": "regenwormpje"
                    },
                    {
                        "form_id": "1132d9db-1d22-4a3c-8d69-d9cd017bb9ae",
                        "entry_id": "ad1bb098-39ba-390d-8c2e-8357681aaf9f",
                        "tags": [
                            "diminutive",
