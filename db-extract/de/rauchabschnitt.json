                "senses": [
                    {
                        "sense_id": "4fcb4d89-6746-3a61-b15d-caa6e5903b68",
                        "entry_id": "302d7dfa-8b86-33b7-b237-214e282d0a28",
                        "glosses": [
                            "baulich klar definierter, eingegrenzter Bereich, in dem sich Rauch ausbreiten darf, um die Schutzziele in anderen Bereichen zu erreichen"
                        ],
                        "tags": [
                            "Bauordnung"
                        ],
                        "examples": [
                            {
                                "example_id": "1a96d430-9222-413d-9efc-d710f03638f4",
                                "sense_id": "4fcb4d89-6746-3a61-b15d-caa6e5903b68",
                                "text": "„Ein Rauchabschnitt darf sich über mehrere Geschosse erstrecken.“"
                            },
                            {
                                "example_id": "f4bb4a50-6354-4844-8189-89000b0f4187",
                                "sense_id": "4fcb4d89-6746-3a61-b15d-caa6e5903b68",
                                "text": "„Gerade bei größeren Räumen ist es häufig erforderlich, Rauchabschnitte zu bilden bzw. Gebäudebereiche so weit abzuschirmen, dass der Rauchübertritt von einem Gebäudeteil in den anderen über einen längeren Zeitraum verhindert werden kann.“"
                            },
                            {
                                "example_id": "87b1cd10-0140-4ee9-b0f5-97f5b62c8ddc",
                                "sense_id": "4fcb4d89-6746-3a61-b15d-caa6e5903b68",
                                "text": "„Die Bildung von Rauchabschnitten in Gebäuden ist erforderlich, um die Ausbreitung von Rauch im Gebäude zu verhindern und die Personenrettung ausreichend lange zu ermöglichen (Schutzziel).“"
                            },
                            {
                                "example_id": "36150c23-c24f-4879-832f-1f1241f4f276",
                                "sense_id": "4fcb4d89-6746-3a61-b15d-caa6e5903b68",
                                "text": "„Welche Klappe kann für die Nachströmung einer Entrauchung aus einem benachbarten Rauchabschnitt verwendet werden?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
