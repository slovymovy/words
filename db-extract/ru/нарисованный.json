                    {
                        "sense_id": "f69b3629-babc-3086-8917-1b78368bea19",
                        "entry_id": "03842f1e-d371-3693-b586-9e22bf7f5b96",
                        "glosses": [
                            "страд. прич. прош. вр. от нарисовать"
