                "senses": [
                    {
                        "sense_id": "e761e57f-fb29-31ec-8f51-ec297287ef87",
                        "entry_id": "6e4fd413-a573-32b7-a166-2e48354d1a87",
                        "glosses": [
                            "Personne pouvant transmettre une doléance particulière à la bonne personne, au bon organisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "774e0c35-db1f-49b1-9e5a-c63c4e2aeaad",
                                "sense_id": "e761e57f-fb29-31ec-8f51-ec297287ef87",
                                "text": "L’aide-soignante, un référent privilégié de par sa proximité."
                            },
                            {
                                "example_id": "4b9eaa49-c823-4d7a-9169-91134d4ff00c",
                                "sense_id": "e761e57f-fb29-31ec-8f51-ec297287ef87",
                                "text": "Un secteur « Ecoles spéciales » fut supprimé par décision du Secrétariat du CEIC du 20 mai 1936. 98. F.S.Kotelnikov (1893-?) était référent pour les organisations de masse au Département d'organisation en 1932."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "f31268ae-8443-4792-b08a-4a25f6bdbcb0",
                        "source_entry_id": "6e4fd413-a573-32b7-a166-2e48354d1a87",
                        "source_sense_ids": [
                            "e761e57f-fb29-31ec-8f51-ec297287ef87"
