{
    "word_family": [
        "ick",
        "ickiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e68011a-dbaf-3a9e-ab82-90360c1b536c",
                    "sense_definition": "Unpleasantly sticky, slimy, or disgusting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disgusting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stepped in something <w>icky</w> on the sidewalk and it smells terrible.",
                            "target_lang_translations": {
                                "it": "Ho calpestato qualcosa di <w>schifoso</w> sul marciapiede e puzza da morire."
                            }
                        },
                        {
                            "text": "There was an <w>icky</w> brown liquid leaking from the broken trash can.",
                            "target_lang_translations": {
                                "it": "C'era un liquido marrone <w>disgustoso</w> che colava dal bidone rotto."
                            }
                        }
                    ],
                    "synonyms": [
                        "disgusting",
                        "yucky",
                        "nasty"
                    ],
                    "antonyms": [
                        "pleasant",
                        "clean"
                    ],
                    "common_phrases": [
                        "icky substance",
                        "icky mess"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Sgradevolmente appiccicoso, viscido o disgustoso."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "disgustoso",
                                "target_lang_sense_clarification": "che provoca ribrezzo o repulsione"
                            },
                            {
                                "target_lang_word": "schifoso",
                                "target_lang_sense_clarification": "molto sgradevole o ripugnante"
                            },
                            {
                                "target_lang_word": "viscido",
                                "target_lang_sense_clarification": "appiccicoso o gelatinoso al tatto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b196fcb6-bbbc-3269-a99b-87321e3c1890",
                    "sense_definition": "Feeling mildly sick, unwell, or uncomfortable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unwell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to stay home today because I feel <w>icky</w>.",
                            "target_lang_translations": {
                                "it": "Ho deciso di restare a casa oggi perché mi sento <w>indisposto</w>."
                            }
                        },
                        {
                            "text": "Eating too many sweets made my stomach feel rather <w>icky</w>.",
                            "target_lang_translations": {
                                "it": "Mangiare troppi dolci mi ha fatto venire lo stomaco piuttosto <w>sottosopra</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unwell",
                        "sickly",
                        "queasy"
                    ],
                    "antonyms": [
                        "healthy",
                        "well"
                    ],
                    "common_phrases": [
                        "feel icky"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Che si sente leggermente malato, indisposto o a disagio."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "indisposto",
                                "target_lang_sense_clarification": "leggermente malato o debole"
                            },
                            {
                                "target_lang_word": "nauseato",
                                "target_lang_sense_clarification": "con la nausea o il mal di stomaco"
                            },
                            {
                                "target_lang_word": "sottosopra",
                                "target_lang_sense_clarification": "riferito allo stomaco, con una sensazione di malessere"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4bbc810-1da6-3511-b948-c1d15d6f518d",
                    "sense_definition": "Distastefully or excessively sentimental.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sentimental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The romantic movie was ruined by its overly <w>icky</w> dialogue.",
                            "target_lang_translations": {
                                "it": "Il film romantico è stato rovinato dai suoi dialoghi fin troppo <w>sdolcinati</w>."
                            }
                        },
                        {
                            "text": "He disliked greeting cards filled with <w>icky</w> love poems.",
                            "target_lang_translations": {
                                "it": "Non sopportava i biglietti d'auguri pieni di poesie d'amore <w>svenevoli</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "corny",
                        "sappy",
                        "maudlin"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Eccessivamente o fastidiosamente sentimentale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sdolcinato",
                                "target_lang_sense_clarification": "eccessivamente mieloso o lezioso"
                            },
                            {
                                "target_lang_word": "svenevole",
                                "target_lang_sense_clarification": "artificiosamente affettato o sentimentale"
                            },
                            {
                                "target_lang_word": "melenso",
                                "target_lang_sense_clarification": "pesantemente sentimentale o sciocco"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}