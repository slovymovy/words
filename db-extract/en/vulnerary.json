                    },
                    {
                        "form_id": "bd27caa6-2c61-481d-86e4-d8b498aac1e2",
                        "entry_id": "36bb0d22-fb01-35a8-a5a8-a5c6b691ec54",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most vulnerary"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9dc4e42-df4b-3e22-aa33-e7f2a52e8bfd",
                        "entry_id": "36bb0d22-fb01-35a8-a5a8-a5c6b691ec54",
                        "glosses": [
                            "Useful or used for healing wounds; curative, healing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f51238-d4cc-4ddb-8597-5b48eba0abad",
                                "sense_id": "c9dc4e42-df4b-3e22-aa33-e7f2a52e8bfd",
                                "text": "Rebecca examined the wound, and having applied to it such vulnerary remedies as her art prescribed, informed her father that […] there was nothing to fear for his guest’s life."
                            },
                            {
                                "example_id": "9d6c56d0-f64a-484e-a79c-d1539ac2dfc1",
                                "sense_id": "c9dc4e42-df4b-3e22-aa33-e7f2a52e8bfd",
                                "text": "Take, for example, the famous vulnerary ointment attributed to Paracelsus."
                            }
                        ]
                    },
                    {
                        "sense_id": "3dfd5fa2-90a0-30d7-a503-07aff3b0fad3",
                        "entry_id": "36bb0d22-fb01-35a8-a5a8-a5c6b691ec54",
                        "glosses": [
                            "Causing wounds; wounding."
                        ],
                        "tags": [
                            "archaic",
                            "rare"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37ea2738-6e26-464b-acc7-e48ffdaad9ff",
                        "source_entry_id": "36bb0d22-fb01-35a8-a5a8-a5c6b691ec54",
                        "source_sense_description": "useful or used for healing wounds",
                        "target_lang_word": "hojivý",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d7b88e1e-d6b5-4cc7-ba55-8cd4be3105f2",
                        "source_entry_id": "36bb0d22-fb01-35a8-a5a8-a5c6b691ec54",
                        "source_sense_description": "useful or used for healing wounds",
                        "target_lang_word": "vulnéraire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulnéraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "225db995-a44c-31ae-bbfa-9cc028db6bac",
                                        "entry_id": "9231b134-2ccc-30d0-bd46-5ee1780394c4",
                                        "glosses": [
                                            "Qui guérit les plaies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d0e0563-d4ca-44ca-a1da-53fe5bdf1fd9",
                                                "sense_id": "225db995-a44c-31ae-bbfa-9cc028db6bac",
                                                "text": "La sanicle est une de ces plantes autrefois célèbres, comme vulnéraires ; […]. Elle est utile pour déterger les ulcères."
                                            },
                                            {
                                                "example_id": "632bf603-16ce-455d-87e3-24965325894e",
                                                "sense_id": "225db995-a44c-31ae-bbfa-9cc028db6bac",
                                                "text": "Au sortir du cimetière, plusieurs assistantes voulaient faire prendre quelque chose à Marie, chez le marchand de vins, pour la remettre : un kirsch ou un vulnéraire, les deux au besoin, il paraît que c’est très bon pour les enfants."
                                            },
                                            {
                                                "example_id": "d8431f58-224a-4d82-843a-aa4950866ea3",
                                                "sense_id": "225db995-a44c-31ae-bbfa-9cc028db6bac",
                                                "text": "– Et le vulnéraire opère bien : nous avons imbibé le pansement de teinture d’aloès. Faute d’aristoloche."
                                            },
                                            {
                                                "example_id": "6d5e5022-0449-41a5-bd4b-0d3ae8681b01",
                                                "sense_id": "225db995-a44c-31ae-bbfa-9cc028db6bac",
                                                "text": "Ce n'est pas lui qui m'a versé un verre de vulnéraire, ou d'arquebuse, après ma chute sur la tête dans la fosse du garage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vulnéraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ee52b79-590f-33c8-90fd-6a88bc9178ca",
                                        "entry_id": "d2834b15-b9e9-31fa-bb95-76ef00b217a5",
                                        "glosses": [
                                            "Substance aux propriétés de cicatrisation des plaies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1b89fa5-5c74-36e1-8d4b-b4364eaaa43e",
                                        "entry_id": "d2834b15-b9e9-31fa-bb95-76ef00b217a5",
                                        "glosses": [
                                            "Préparation destiné à guérir les plaies."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7c0780f-be20-3912-96bd-0a94db1601f6",
                                        "entry_id": "d2834b15-b9e9-31fa-bb95-76ef00b217a5",
                                        "glosses": [
                                            "Cordial ; Boisson tonique que l’on donne notamment à une personne venant de subir un traumatisme."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1efcda11-3d01-474b-b56f-df5f7d58779f",
                                                "sense_id": "b7c0780f-be20-3912-96bd-0a94db1601f6",
                                                "text": "« On lui a donné un vulnéraire. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e70ca46-a669-3a9b-b884-4b0e364e5050",
                                        "entry_id": "d2834b15-b9e9-31fa-bb95-76ef00b217a5",
                                        "glosses": [
                                            "Boisson alcoolisée."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79fbc33b-7622-4434-a051-e1d4d8343519",
                                                "sense_id": "1e70ca46-a669-3a9b-b884-4b0e364e5050",
                                                "text": "[Il] dérobait une grande partie du temps qu’il devait à ses maîtres à chercher la composition d’un nouveau vulnéraire supérieur, auquel il voulait donner son nom."
                                            },
                                            {
                                                "example_id": "3d4e8145-d61d-451a-9905-938b2e5a32c9",
                                                "sense_id": "1e70ca46-a669-3a9b-b884-4b0e364e5050",
                                                "text": "Je viens d’assister à un spectacle tellement déchirant ! Oh oui, déchirant, oh combien ! Garçon !… un vulnéraire !… Ça me remettra, le vulnéraire !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vulnéraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c8e9aac-9239-38f5-a5f1-1e828eeb802e",
