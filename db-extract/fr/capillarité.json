                                        "entry_id": "2609cd9d-ad00-30c5-85c1-e31a60e1744d",
                                        "glosses": [
                                            "The interaction between the surfaces of a solid and liquid in contact that distorts the normal geometry of the liquid surface; especially the rise or fall of a liquid in a fine tube."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "231b6b38-609e-4936-aec6-96f60115d518",
                                                "sense_id": "0f3d607b-3e30-3259-ae36-39a704681fff",
                                                "text": "Hence the allowance to be made for diminution of the height of a mercurial column, owing to capillarity, is determined by two considerations — the diameter of the tube and versed sine of the corresponding meniscus."
                                            }
                                        ]
                                    }
                                ]
