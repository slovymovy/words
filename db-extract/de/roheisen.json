                ],
                "senses": [
                    {
                        "sense_id": "9b16ad3f-5508-366c-b3f9-1cd6b6d3dd30",
                        "entry_id": "b09d0145-6abf-3291-baa9-5ca36939c6e0",
                        "glosses": [
                            "das Produkt des Hochofenprozesses"
                        ],
                        "tags": [
                            "Werkstoffkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "d574089b-4714-4b8a-addf-0a6676fda9a6",
                                "sense_id": "9b16ad3f-5508-366c-b3f9-1cd6b6d3dd30",
                                "text": "Roheisen kann zu Gusseisen oder Stahl weiterverarbeitet werden."
                            },
                            {
                                "example_id": "d14882f1-2222-4be4-9970-e7d75646abcd",
                                "sense_id": "9b16ad3f-5508-366c-b3f9-1cd6b6d3dd30",
                                "text": "„Weltweit wurden 2012 weit mehr als 1 Milliarde Roheisen erzeugt.“"
                            },
                            {
                                "example_id": "78c82b4c-c868-48c2-8a2d-b2008ab967ea",
                                "sense_id": "9b16ad3f-5508-366c-b3f9-1cd6b6d3dd30",
                                "text": "„Das im Hochofenprozess gewonnene Roheisen enthält noch etwa 10% Verunreinigungen – vor allem Kohlenstoff und in kleineren Anteilen Mangan, Silicium, Phosphor und Schwefel.“"
                            },
                            {
                                "example_id": "ff1801e0-781d-48ea-a80f-c239fa6be0c6",
                                "sense_id": "9b16ad3f-5508-366c-b3f9-1cd6b6d3dd30",
                                "text": "„Bei der Herstellung von Stahl werden die im Roheisen enthaltenen unerwünschten Stoffe oxidiert. Man bezeichnet diesen Vorgang als 'Frischen'.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
