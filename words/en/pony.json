                            {
                                "target_lang_word": "подстрочник",
                                "target_lang_sense_clarification": "перевод"
                            },
                            {
                                "target_lang_word": "шпаргалка",
                                "target_lang_sense_clarification": "подсказка"
                            }
                        ],
                        "zh": [
