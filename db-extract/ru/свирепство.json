                    {
                        "sense_id": "80f7252b-54e3-3738-9315-d6815a4af5d2",
                        "entry_id": "60046fb8-efa9-3481-b2dd-9d9c61646758",
                        "glosses": [
                            "ferocity, savagery, atrociousness"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "5cc2dc8b-c72b-4aad-9f6d-f30b1e728bb0",
                                "sense_id": "80f7252b-54e3-3738-9315-d6815a4af5d2",
                                "text": "— Поми́луй нас го́споди! Не в де́да он пошё́л, а в ба́тюшку, и не по мла́дости испо́лнено его́ се́рдце свире́пства; не бу́дет нам уте́хи от его́ ца́рствования!",
                                "translation": "Aleksey Konstantinovich Tolstoy",
                                "english": "Aleksey Konstantinovich Tolstoy"
                            }
                        ]
                    }
                ],
