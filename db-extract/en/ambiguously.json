                    {
                        "sense_id": "cbb9a9c3-961d-3b34-8101-0c4baacff8e7",
                        "entry_id": "4a9887c3-4730-3409-a802-6e1cfeb79bc3",
                        "glosses": [
                            "двусмысленно"
