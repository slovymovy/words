                "senses": [
                    {
                        "sense_id": "9aea1a2f-22f8-3c32-a784-c29b894e189e",
                        "entry_id": "a37133c7-7782-379d-9227-7a5ccc29f602",
                        "glosses": [
                            "Zeitraum, in dem sich Verhältnisse grundlegend ändern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22ed3157-0d8f-4d76-9006-70f36b34ead7",
                                "sense_id": "9aea1a2f-22f8-3c32-a784-c29b894e189e",
                                "text": "„Und hätte ich in der Wendezeit nicht die ergreifende Ruine der Frauenkirche mit eigenen Augen gesehen, würde ich heute sicher keine Minute daran zweifeln, dass diese Kirche schon immer da stand.“"
                            },
                            {
                                "example_id": "d1fab59c-7dac-4f9e-a8aa-f13976b7660c",
                                "sense_id": "9aea1a2f-22f8-3c32-a784-c29b894e189e",
                                "text": "„Während es in der DDR und in der Wendezeit eine Fülle politischer Witze und Sprachspiele gegeben hat, blieb die Bundesrepublik erstaunlich arm an dieser Form von Sprachkritik.“"
                            }
                        ],
