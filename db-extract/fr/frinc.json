                        "examples": [
                            {
                                "example_id": "7d62a7b3-ba2f-4ca4-b7ca-1f85322004b3",
                                "sense_id": "2a1c9495-dc5a-347b-ba98-77373aee2f55",
                                "text": "Il me regardait avec le plus doux des sourires, en secouant un trousseau de clefs de toutes dimensions, suspendu à son index. Le sourire m’aurait prévenu en sa faveur, mais les clefs grinçaient avec un bruit terrible — frinc ! frinc ! frinc ! — qui me fit peur."
                            },
                            {
