                "senses": [
                    {
                        "sense_id": "e2b0e7c1-d2a3-3372-92c9-600d55b99fa0",
                        "entry_id": "ca835f15-2f68-3528-918f-123cb9f88b0e",
                        "glosses": [
                            "A plant of the genus Pimpinella, especially burnet saxifrage (Pimpinella saxifraga)."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "14156227-8395-3a5f-bd6c-240d3bc8bc2f",
                        "entry_id": "ca835f15-2f68-3528-918f-123cb9f88b0e",
                        "glosses": [
                            "Any of various plants of the genus Anagallis, having small red, white or purple flowers, especially the scarlet pimpernel (Anagallis arvensis)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64805934-1add-4543-b511-7d539c0f78cf",
                                "sense_id": "14156227-8395-3a5f-bd6c-240d3bc8bc2f",
                                "text": "Common Pimpernel has diverse weak square stalks lying on the ground, beset all along with two small and almost round leaves at every joint [...]."
                            },
                            {
                                "example_id": "1eb59dfb-1c95-45ed-9740-b7763ee5951b",
                                "sense_id": "14156227-8395-3a5f-bd6c-240d3bc8bc2f",
                                "text": "Pimpernel (poor man's weather glass) was also a protection, but as the gatherer collected the herbs, he must chant a certain incantation and continue to do so twice a day for 15 days[.]"
                            }
                        ]
                    },
                    {
                        "sense_id": "5452d1fb-4891-367f-abe7-6f90d8cdfbd5",
                        "entry_id": "ca835f15-2f68-3528-918f-123cb9f88b0e",
                        "glosses": [
                            "Sanguisorba spp.",
                            "Great burnet (Sanguisorba officinalis)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3eb4c1f2-567d-361f-a3a2-94cfb555450f",
                        "entry_id": "ca835f15-2f68-3528-918f-123cb9f88b0e",
                        "glosses": [
                            "Sanguisorba spp.",
                            "Salad burnet (Sanguisorba minor)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fa91acce-3bf0-31d4-a4fe-6ad49c02647b",
                        "entry_id": "ca835f15-2f68-3528-918f-123cb9f88b0e",
                        "glosses": [
                            "A yellow pimpernel (Taenidia integerrima)"
                        ],
                        "tags": [
                            "Canada",
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f1c08cee-4a09-32c2-a321-83ae495e45d3",
                        "entry_id": "ca835f15-2f68-3528-918f-123cb9f88b0e",
                        "glosses": [
                            "Someone resembling the fictional Scarlet Pimpernel; a gallant dashing resourceful man given to remarkable feats of bravery and derring-do in liberating victims of tyranny and injustice."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "85a2893e-2445-4d0c-a57c-468199aa4d51",
                                "sense_id": "f1c08cee-4a09-32c2-a321-83ae495e45d3",
                                "text": "Lined up solidly with the Pimpernels and with the persecuted."
                            }
                        ]
                    }
                ],
                "translations": [
