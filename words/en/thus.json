                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "incienso",
                                "target_lang_sense_clarification": "resina aromática utilizada para quemar"
                            },
                            {
                                "target_lang_word": "olíbano",
                                "target_lang_sense_clarification": "término técnico para la resina del árbol Boswellia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乳香",
                                "target_lang_sense_clarification": "一种用于制作香料的树脂"
                            }
                        ]
                    }
                }
            ]
        }
    ]
