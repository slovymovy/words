                                            {
                                                "example_id": "2aad2fe7-97f9-4bc5-bedd-ffee5a83c606",
                                                "sense_id": "aed70ba4-08ae-3b1a-9ce7-a9039c802887",
                                                "text": "Voici ce que tu vas faire, Yvan."
                                            },
                                            {
                                                "example_id": "5bb3e79b-fb95-4c4f-a8fd-6368804ae286",
                                                "sense_id": "aed70ba4-08ae-3b1a-9ce7-a9039c802887",
                                                "text": "À commencer par « Yvan Wouandji Kepmegni, médaillé paralympique et champion d’Europe avec l’équipe de France de cécifoot », annonce Évelyne Ciriegi, présidente du comité régional olympique et sportif d’Île-de-France."
                                            },
                                            {
                                                "example_id": "2754fa8f-0f38-44bf-9bc8-23a1956ad58f",
                                                "sense_id": "aed70ba4-08ae-3b1a-9ce7-a9039c802887",
                                                "text": "Nos compétences vont au-delà de la kiné de désencombrement, répond Yvan Tourjansky, président de l’union régionale des kinésithérapeutes libéraux d’Île-de-France."
                                            },
                                            {
                                                "example_id": "9ddc6379-9fa2-48ca-9163-2a97e5b7b9f7",
                                                "sense_id": "aed70ba4-08ae-3b1a-9ce7-a9039c802887",
                                                "text": "Malgré tout, comme pour les joueurs, la majorité des transferts se fait hors contrat, comme le souligne l’agent Yvan Le Mée, à la tête de la structure Sport Profile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
