                "senses": [
                    {
                        "sense_id": "5e675207-8d07-3015-99bc-8723000709e7",
                        "entry_id": "fe5d036c-d31d-3df0-aef8-aa01833893c9",
                        "glosses": [
                            "Protection de l’environnement, écologie appliquée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30a3c81d-9cba-4b6c-abd9-5972ef6c5a63",
                                "sense_id": "5e675207-8d07-3015-99bc-8723000709e7",
                                "text": "In Deutschland sind von staatlicher Seite in erster Linie das Bundesministerium für Umwelt, Naturschutz und nukleare Sicherheit (BMUB) und das Umweltbundesamt (UBA) für den Umweltschutz zuständig.",
                                "translation": "En Allemagne, le ministère fédéral de l’Environnement, de la Protection de la nature et de la Sécurité nucléaire (BMUB) et l’Office fédéral de l'environnement (UBA) sont les principaux responsables de la protection de l’environnement."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
