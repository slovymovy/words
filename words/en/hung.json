                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My laptop is <hung> and I might have to restart it.",
                            "target_lang_translations": {
                                "ru": "Мой ноутбук <завис>, и мне, возможно, придется его перезагрузить.",
                                "es": "Mi portátil se ha <bloqueado> y quizás tenga que reiniciarlo.",
                                "zh": "我的笔记本电脑<w>死机</w>了，我可能得重启它。"
                            }
