                                    {
                                        "sense_id": "8c19cfaf-fe3c-3f63-bc46-1d1929effb34",
                                        "entry_id": "e0216a2e-7f06-30ed-a75a-f8bb2427a9a7",
                                        "glosses": [
                                            "männliches Geschlechtshormon, das die Entwicklung und Funktionalität der männlichen Geschlechtsorgane gewährleistet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7680bc2-ad9f-4e97-86a4-417b694a9c4f",
                                                "sense_id": "8c19cfaf-fe3c-3f63-bc46-1d1929effb34",
                                                "text": "„Das Y-Chromosom ist der Schlüssel zur Männlichkeit: Es setzt die Produktion von Androgenen im Fötus in Gang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
