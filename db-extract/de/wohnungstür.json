                ],
                "senses": [
                    {
                        "sense_id": "854e87cb-67ff-33af-9b21-2b3067714c36",
                        "entry_id": "aa351ed4-b970-3c6d-8823-8a9b247d04f7",
                        "glosses": [
                            "Ein- und Ausgangstür einer Wohnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e57b0d4-c5d1-4670-b940-f7afa9ade2ec",
                                "sense_id": "854e87cb-67ff-33af-9b21-2b3067714c36",
                                "text": "„Dann hörte Max, wie Reizl die Wohnungstür öffnete.“"
                            },
                            {
                                "example_id": "ddfb4723-fd0b-417b-82cf-b2a713ed0a17",
                                "sense_id": "854e87cb-67ff-33af-9b21-2b3067714c36",
                                "text": "„Die Wohnungstür fiel ins Schloss, Schritte im Flur.“"
                            },
                            {
                                "example_id": "24e78010-9fda-4737-aae6-261f36d7b03f",
                                "sense_id": "854e87cb-67ff-33af-9b21-2b3067714c36",
                                "text": "„Als sie die Wohnungstür aufschloss, zog sie der Himbeerduft zuerst in die Küche.“"
                            },
                            {
                                "example_id": "f90a27ee-cbec-4441-8ed4-d0fcf7368481",
                                "sense_id": "854e87cb-67ff-33af-9b21-2b3067714c36",
                                "text": "„Nach und nach kamen immer mehr Menschen an die Wohnungstür, um sich Anna anzusehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
