                "senses": [
                    {
                        "sense_id": "df7d72b0-3416-3c72-9f39-be32ff892996",
                        "entry_id": "cd2dca70-cba2-39d1-a481-e98aa2ff8779",
                        "glosses": [
                            "absichtliche oder wissentliche Verhinderung der Bestrafung eines Straftäters"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "48d52838-2032-4997-a1d2-d2ab750b2d60",
                                "sense_id": "df7d72b0-3416-3c72-9f39-be32ff892996",
                                "text": "„Wegen Strafvereitelung wird nicht bestraft, wer durch die Tat zugleich ganz oder zum Teil vereiteln will, daß er selbst bestraft […] wird.“"
                            },
                            {
                                "example_id": "89e258de-bda0-48e1-a267-bd1109384537",
                                "sense_id": "df7d72b0-3416-3c72-9f39-be32ff892996",
                                "text": "„Leide hat bereits eine umfangreiche Studie und wichtige Aufsätze über die aktive Strafvereitelung der Stasi bei NS-Verbrechen vorgelegt.“"
                            },
                            {
                                "example_id": "e8d72cef-a0cf-4f51-bb0c-87bd0a1f6ff1",
                                "sense_id": "df7d72b0-3416-3c72-9f39-be32ff892996",
                                "text": "„Beteiligte Polizisten stellten Strafanzeige gegen ihn, den Einsatzleiter Uwe Wiedemann sowie den Polizeipräsidenten Herbert Sander wegen Strafvereitelung im Amt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
