                "senses": [
                    {
                        "sense_id": "cb95b7b7-5a2a-3b5c-b32f-22062677aa40",
                        "entry_id": "96df603e-d052-3f8b-9275-61b69d98135d",
                        "glosses": [
                            "Qui est très actif, qui agit beaucoup, qui travaille beaucoup (en parlant des personnes ou des groupes de personnes)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f82c4d-6d82-4888-ba6f-ec330d0a1a79",
                                "sense_id": "cb95b7b7-5a2a-3b5c-b32f-22062677aa40",
                                "text": "Nous sommes des transitionnistes hyperactifs. Le « Virtuosa » fonctionne au fuel mais ce n’est pas le même qu’avant. Il est équipé de pots catalytiques qui transforment 97 % des oxydes d’azote."
                            },
                            {
                                "example_id": "676f495f-ea62-474a-b64e-ffc6982b01d8",
                                "sense_id": "cb95b7b7-5a2a-3b5c-b32f-22062677aa40",
                                "text": "Il estime que le syndicat Alliance a été « hyperactif » et « a fait évoluer le projet »."
                            }
                        ]
                    },
                    {
                        "sense_id": "73998ed3-2b95-3750-81dd-96a2aae4b732",
                        "entry_id": "96df603e-d052-3f8b-9275-61b69d98135d",
                        "glosses": [
                            "Qui est très actif (en parlant des choses)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1319d0f-74b6-4a71-8a64-4446cd3674a5",
                                "sense_id": "73998ed3-2b95-3750-81dd-96a2aae4b732",
                                "text": "Un médicament, un traitement hyperactif, une réaction hyperactive."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6b4226a-9869-39eb-9373-788b4286750f",
                        "entry_id": "96df603e-d052-3f8b-9275-61b69d98135d",
                        "glosses": [
                            "Qui manifeste de l’hyperactivité."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
