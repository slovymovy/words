                                        "glosses": [
                                            "wielościan o czterech trójkątnych ścianach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998ebe21-df78-4421-9ade-1969d2eacc68",
                                                "sense_id": "5d3e0ee5-9606-319c-a3f9-93e595a70eed",
                                                "text": "Głównym motywem strukturalnym krzemianów są czworościany zbudowane z krzemu znajdującego się w środku i otoczonego czterema atomami tlenu umieszczonymi na wierzchołkach."
                                            }
                                        ],
