                        "source_entry_id": "e7e65e57-7eb0-3dbf-9a17-09aac9644e72",
                        "target_lang_word": "Jew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d405f44e-341f-3349-8517-53fd768edc9b",
                                        "entry_id": "b8d317a7-b153-3ecf-a143-57eeae2b6c86",
                                        "glosses": [
                                            "An adherent of Judaism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3746f495-f81c-424e-a88d-6ee4d02bcc85",
                                                "sense_id": "d405f44e-341f-3349-8517-53fd768edc9b",
                                                "text": "Both Jews and Muslims refrain from eating pork."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a18409-ebd7-36e6-82c2-494923837c90",
                                        "entry_id": "b8d317a7-b153-3ecf-a143-57eeae2b6c86",
                                        "glosses": [
                                            "A member or descendant of the Jewish people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da067d6-52dd-4ed7-9b5e-8f0058078f14",
                                                "sense_id": "66a18409-ebd7-36e6-82c2-494923837c90",
                                                "text": "Many Jews eat bagels."
                                            },
                                            {
                                                "example_id": "b9c90d21-fef4-4f9c-9d4e-570300ceda20",
                                                "sense_id": "66a18409-ebd7-36e6-82c2-494923837c90",
                                                "text": "Hath not a Jew eyes? Hath not a Jew hands, organs\ndimensions, senses, affections, passions; fed with\nthe same food, hurt with the same weapons, subject\nto the same diseases, heal'd by the same means,\nwarm'd and cool'd by the same winter and summer\nas a Christian is?"
                                            },
                                            {
                                                "example_id": "207001f5-021e-49b8-b8fc-97a41b7cf14b",
                                                "sense_id": "66a18409-ebd7-36e6-82c2-494923837c90",
                                                "text": "The wrongs of a Jew are not lightly forgotten, for the race can both love and hate."
                                            },
                                            {
                                                "example_id": "6b195241-434a-40ef-8c47-abdaeeb13d4f",
                                                "sense_id": "66a18409-ebd7-36e6-82c2-494923837c90",
                                                "text": "A young Australian Jew engaged on the trip of a lifetime finally arrives in the homeland of his people."
                                            },
                                            {
                                                "example_id": "7f046ca5-2eab-4d8e-aca8-b34237cebfec",
                                                "sense_id": "66a18409-ebd7-36e6-82c2-494923837c90",
                                                "text": "The local gazetteers of Xiangfu district, Kaifeng prefecture, and Henan province⁵ mention a surprisingly large number of Kaifeng Jews and their successes in Chinese society with dates."
                                            },
                                            {
                                                "example_id": "06fb3c30-6635-474d-bdb0-b4e767544e67",
                                                "sense_id": "66a18409-ebd7-36e6-82c2-494923837c90",
                                                "text": "There are Jews who consider themselves White and Jews who are people of color."
                                            },
                                            {
                                                "example_id": "925db8c0-ad59-44b5-b34b-21ccaf1e8b1d",
                                                "sense_id": "66a18409-ebd7-36e6-82c2-494923837c90",
                                                "text": "The 15th-century explorer Christopher Columbus was a Sephardic Jew from Western Europe, Spanish scientists said on Saturday, after using DNA analysis to tackle a centuries-old mystery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3714c7c-749d-3bcc-b87c-1c08fcfb36a0",
                                        "entry_id": "b8d317a7-b153-3ecf-a143-57eeae2b6c86",
                                        "glosses": [
                                            "A miserly or greedy person; a cheapskate."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4e6816-9dad-4dc0-8c63-137c6798525a",
                                                "sense_id": "f3714c7c-749d-3bcc-b87c-1c08fcfb36a0",
                                                "text": "“Jesus, Williams, you're such a Jew,” Jimmy said in an annoyed, high-pitched tone. “Have you ever just paid a check, or do you always make an ass of yourself?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19142866-7eb5-3c1d-936b-2ec496276e29",
                                        "entry_id": "b8d317a7-b153-3ecf-a143-57eeae2b6c86",
                                        "glosses": [
                                            "A ship's tailor."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Jew",
