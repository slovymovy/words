                                "target_senses": [
                                    {
                                        "sense_id": "5d97cb34-a73b-3132-b748-7b5ce1b92002",
                                        "entry_id": "18580f7a-670b-3d30-91f2-ab9ea86dd91d",
                                        "glosses": [
                                            "The pathological examination of a corpse, particularly to determine cause of death."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c350168b-f79d-4301-b999-cc02dee3ad4c",
                                                "sense_id": "5d97cb34-a73b-3132-b748-7b5ce1b92002",
                                                "text": "Anatomy theory led to morbid anatomy in necropsy studies pursued by, among others, Johann Wepfer (1620–95) and Théophile Bonet (1620–89), both Swiss."
                                            },
                                            {
                                                "example_id": "97fddba5-8148-43a6-8694-cc8e6d092aae",
                                                "sense_id": "5d97cb34-a73b-3132-b748-7b5ce1b92002",
                                                "text": "During the necropsy, he pored carefully through the body, combing the tissues and organs for signs of an abscess or wound."
                                            }
                                        ]
                                    }
                                ]
                            },
