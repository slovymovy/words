                        "glosses": [
                            "Gerät, mit dem schussartig ein Impfstoff gespritzt wird und das bei Massenimpfungen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aeb0a04-73e4-4919-aec1-be5c7fb27917",
                                "sense_id": "194b96b0-3bf4-3324-934f-b82ff865fe83",
                                "text": "„Mit der Impfpistole konnte man 600 Patienten pro Stunde immunisieren.“"
                            },
                            {
                                "example_id": "d25d911b-ff2a-4e5b-974e-bbd693376699",
                                "sense_id": "194b96b0-3bf4-3324-934f-b82ff865fe83",
                                "text": "„Von einer Milliarde direkt durch Pocken bedrohter Menschen wurden 1968 schätzungsweise 200 Millionen und 1969 nahezu 300 Millionen geimpft, zumeist mit einer tropenfesten Vakzine, die aus Impfpistolen (maximal 1400 Schuß in der Stunde) gespritzt werden kann.“"
                            }
                        ],
