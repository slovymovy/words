                    {
                        "translation_id": "618b5bfb-a38b-4101-bfde-31ea8874b963",
                        "source_entry_id": "886d8fa3-5b25-3a4c-b950-d25b5315a736",
                        "source_sense_id": "ce0cb394-723e-3975-a99b-cbce9b513834",
                        "target_lang_word": "Wochenzeitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wochenzeitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                        "entry_id": "be94f003-a3fc-33c7-be70-b850fcf65816",
                                        "glosses": [
                                            "Zeitung, die wöchentlich erscheint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "560454e9-3923-4be0-963d-6bdd74a9b270",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "„Bis Ende März baut die Wochenzeitung «TagesWoche» fünf Stellen ab, zwei davon in der Redaktion.“"
                                            },
                                            {
                                                "example_id": "178c1dd3-c1de-4ad7-835d-99759c23d8e1",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "„Nach dem Studium der Theaterwissenschaft und Germanistik an der Freien Universität Berlin war sie unter anderem Autorin und Redakteurin der Fachzeitschrift \"Theater der Zeit\" und bei der Wochenzeitung \"Freitag\".“"
                                            },
                                            {
                                                "example_id": "709cf779-b584-47dd-b09e-75d924753367",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "[Paul Auster:] „Geschichten zu Papier zu bringen, war seine Obsession: »Schreiben ist für mich kein Akt des freien Willens, es ist eine Frage des Überlebens«, bekannte er einmal in der Wochenzeitung \"Die Zeit\".“"
                                            },
                                            {
                                                "example_id": "ae55ec18-8764-441f-abd6-19f64c9e1548",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "[Claus Leggewie:] „Als freier Autor schreibt er für in- und ausländische Tages- und Wochenzeitungen und den Hörfunk.“"
                                            },
                                            {
                                                "example_id": "1920794a-318b-42b5-9be0-40ea7f4d79cb",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "[Deutschland:] „Im Jahr 2018 erschienen täglich 327 verschiedene Tageszeitungen – die meisten allerdings nur in bestimmten Regionen. Hinzu kamen 21 Wochenzeitungen und sechs Sonntagszeitungen.“"
                                            },
                                            {
                                                "example_id": "fb39d7f4-666a-4f6d-9ece-ff35b244e704",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "„Die Inhalte reichen vom Klimawandel über Trump bis zur Nahostpolitik. Themen, wie man sie durchaus auch in großen Wochenzeitungen oder Nachrichtenmagazinen verfolgen kann.“"
                                            },
                                            {
                                                "example_id": "2eb48d4e-7faf-499f-bc4c-6d841439678f",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "„In einem Brief an Chefredakteure, Intendanten, Verleger und Herausgeber kritisieren sie: »Nur zwei Prozent aller Chefredakteure der rund 360 deutschen Tages- und Wochenzeitungen sind Frauen«“"
                                            },
                                            {
                                                "example_id": "b0afa82c-93f7-4bca-8125-4dba1e0c4fb7",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "„Es erscheinen drei Wochenzeitungen in Tonga: The Tongan Chronicle (Kolonikali Tonga), Tonga Star sowie die in Auckland (Neuseeland) herausgegebene The Times of Tonga (Taimi ʻo Tonga).“"
                                            },
                                            {
                                                "example_id": "90a5c466-c71a-4bba-a614-cc0f6e2194ac",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "„WOZ Die Wochenzeitung ist eine genossenschaftlich organisierte überregionale linke Wochenzeitung in der Schweiz mit Sitz in Zürich.“"
                                            },
                                            {
                                                "example_id": "b6b9f2bd-6bc0-45c2-88f2-68dcead16e4f",
                                                "sense_id": "6e5d5d05-1791-3a08-82eb-fb908c8617a9",
                                                "text": "„Als „Wochenzeitung für Politik, Kultur, Religion und jüdisches Leben“ – so ihr Untertitel – sieht sich die Jüdische Allgemeine in der publizistischen Tradition der großen liberalen Blätter des 19. und 20. Jahrhunderts und insbesondere der Allgemeinen Zeitung des Judenthums, die 1837 gegründet wurde,“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
