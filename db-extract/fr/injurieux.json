                                    {
                                        "sense_id": "430d816b-fb81-340f-95df-b6524d0b3fe3",
                                        "entry_id": "99deb9f4-57ec-3f13-9dd2-ce5be00b9d8e",
                                        "glosses": [
                                            "jemandes Gefühle durch abwertende Worte, Gesten oder Handlungen verletzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68513554-ee6d-4387-bb6a-f4833a31a11c",
                                                "sense_id": "430d816b-fb81-340f-95df-b6524d0b3fe3",
                                                "text": "„Wenn Du mich noch einmal solch beleidigende Ausdrücken verwendest gibt's richtig Ärger!“"
                                            },
                                            {
                                                "example_id": "720e6b36-886f-47dc-82d1-401770731bf7",
                                                "sense_id": "430d816b-fb81-340f-95df-b6524d0b3fe3",
                                                "text": "„Das ist eine meine Intelligenz beleidigende Aussage.“"
                                            },
                                            {
                                                "example_id": "520e932b-2eb3-451e-b0d5-df614982cec1",
                                                "sense_id": "430d816b-fb81-340f-95df-b6524d0b3fe3",
                                                "text": "Monatelang ätzte Donald Trump beleidigend gegen die TV-Moderatorin Megyn Kelly. Nun zelebrierten beide publikumswirksam ihre Versöhnung."
                                            },
                                            {
                                                "example_id": "48720e8f-a0b1-46a6-8465-6ca5d89cf449",
                                                "sense_id": "430d816b-fb81-340f-95df-b6524d0b3fe3",
                                                "text": "Das Gedicht sei absolut geschmacklos, die Wortwahl beleidigend, der Ton rassistisch, bemängeln Kritiker."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "beleidigend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "491f1b8b-0c0c-3cc4-ab86-e37eaa66e819",
