            {
                "entry_id": "ac987dae-84a3-390c-851a-2d806afe1bda",
                "word": "logicien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dcd2db9e-18a3-4a93-8b77-9d6fdc43e326",
                        "entry_id": "ac987dae-84a3-390c-851a-2d806afe1bda",
