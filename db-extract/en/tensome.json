                                        "glosses": [
                                            "десять субъектов, обозначаемых существительными муж. р. или личными местоимениями."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8145d30b-b8ae-4890-a8e8-e4e4bd796147",
                                                "sense_id": "7165153b-45a9-3fc8-aa91-b231dea060f6",
                                                "text": "Десятеро мужчин."
                                            },
                                            {
                                                "example_id": "f4e62d97-0e98-44ec-b48a-ab425435f803",
                                                "sense_id": "7165153b-45a9-3fc8-aa91-b231dea060f6",
                                                "text": "Их было десятеро."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "523d67d8-fdca-3a21-bb5e-ec15081628b7",
                                        "entry_id": "c756bcbe-d8b3-3d83-8dec-e73846fdcbe1",
                                        "glosses": [
                                            "десять объектов, обозначаемых существительными только мн. ч."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db011fbf-76b4-4e3f-86cb-4d462edd11bd",
                                                "sense_id": "523d67d8-fdca-3a21-bb5e-ec15081628b7",
                                                "text": "Десятеро суток."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d55bee1-0cae-3461-893c-a1ca922cbb6e",
                                        "entry_id": "c756bcbe-d8b3-3d83-8dec-e73846fdcbe1",
                                        "glosses": [
                                            "десять парных объектов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d788a53f-edbd-4d59-b782-ebecc38cb9b7",
                                                "sense_id": "0d55bee1-0cae-3461-893c-a1ca922cbb6e",
