                                "target_senses": [
                                    {
                                        "sense_id": "77e9b1fb-ba3d-399b-91ca-71b19a13f71e",
                                        "entry_id": "3dffae58-dd6d-3704-83f7-c76938027ec8",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4f17299-c8e1-4eef-92fe-bd75fba8e620",
                                                "sense_id": "77e9b1fb-ba3d-399b-91ca-71b19a13f71e",
                                                "text": "Pour la génération de journalistes qui s’est révélée en 1968, a été licenciée dans la foulée, portée aux nues par Desgraupes et « replacardisée » sous Arthur Comte, Giscard est plus qu’une nouveauté : une bénédiction."
                                            },
                                            {
                                                "example_id": "2516be3d-efdd-4e36-8fe8-bfe1be85d90f",
                                                "sense_id": "77e9b1fb-ba3d-399b-91ca-71b19a13f71e",
                                                "text": "Mon cher Arthur, je t’avais donné le seul moyen que je connusse de garder Aurélie, et tu n’as pas voulu…"
                                            },
                                            {
                                                "example_id": "b0754e27-0975-4ead-a489-4293bd55732d",
                                                "sense_id": "77e9b1fb-ba3d-399b-91ca-71b19a13f71e",
                                                "text": "Un chef-d'œuvre d’Arthur Schnitzler converti en un monologue vécu en direct par l’héroïne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fc21c48-cf06-3afd-99d4-7f60d793a96f",
                                        "entry_id": "3dffae58-dd6d-3704-83f7-c76938027ec8",
                                        "glosses": [
                                            "Le roi Arthur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f2dc813-7bed-4efb-8e24-6098504c16c0",
                                                "sense_id": "4fc21c48-cf06-3afd-99d4-7f60d793a96f",
                                                "text": "... où trouver l’axe menant des mégalithes aux Celtes, des Celtes aux chevaliers d’Arthur et des chevaliers au panceltisme littéraire ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
