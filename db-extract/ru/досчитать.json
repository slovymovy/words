                                                "example_id": "db770aae-26ba-46df-a975-bfe875f847be",
                                                "sense_id": "23c76677-d4f8-3dde-bdac-f25768304283",
                                                "text": "By the official count, there are something like thirteen hundred species of birds in the Amazon, but Cohn-Haft thinks there are actually a good many more, because people have relied too much on features like size and plumage and not paid enough attention to sound."
                                            }
                                        ]
                                    },
