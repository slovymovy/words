                "senses": [
                    {
                        "sense_id": "2ddbd534-ae93-3b8d-b8de-dbf6e4f45e2e",
                        "entry_id": "3d729e9b-52ca-357f-9aaa-55bbcebdb0a5",
                        "glosses": [
                            "A woman's breast."
                        ],
                        "tags": [
                            "UK",
                            "in-plural",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ce70375e-98f0-4572-ba97-42fd8d1b30bd",
                                "sense_id": "2ddbd534-ae93-3b8d-b8de-dbf6e4f45e2e",
                                "text": "There was another teacher […] who came to class fairly often wearing a thin silk blouse and NO BRA. Her 'mams' bounced appropriately, which was of course utterly FASCINATING for every boy in the class."
                            },
                            {
                                "example_id": "66d248f1-4886-407c-bdc8-1c3c6b202375",
                                "sense_id": "2ddbd534-ae93-3b8d-b8de-dbf6e4f45e2e",
                                "text": "She focused her entire mind on that moment she had shared with Shan, the softness of her mams, the wetness of her lips."
                            }
                        ]
                    }
                ],
