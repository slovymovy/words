                    {
                        "translation_id": "8951a50b-d91c-441c-bd51-16f520225539",
                        "source_entry_id": "f9c21635-9487-3260-815f-a9743d63d167",
                        "source_sense_description": "metal process or state that is an incidental by-product of physiological events in the brain or nervous system",
                        "target_lang_word": "Begleiterscheinung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begleiterscheinung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                        "entry_id": "220a951f-e53e-383c-9d81-ffd3a9687d84",
                                        "glosses": [
                                            "Phänomen, das sich bei einem Vorgang/einer Handlung zusätzlich einstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d6294a-66a2-4767-a57c-2e4255b0767c",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Die Eigner des Schiffes betrachteten die Todesfälle und die Tatsache, dass das Leben so vieler Menschen zerstört wurde, als normale Begleiterscheinung eines zugegebenermaßen schmutzigen Geschäfts.“"
                                            },
                                            {
                                                "example_id": "fa13be83-df32-4500-8cf1-f08251ed282c",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Übergewicht und Fettleibigkeit wurden zu unübersehbaren Begleiterscheinungen moderner Wohlstandsgesellschaften.“"
                                            },
                                            {
                                                "example_id": "c663833d-b378-4241-ab3d-249bb479dfec",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Dieser sein Eintritt ins Regiment fiel so ziemlich mit dem Regierungsantritt Friedrich Wilhelms IV. zusammen, und wenn er dessen erwähnte, so hob er, sich selbst persiflierend, gerne hervor, ‚daß alles Große seine Begleiterscheinungen habe‘.“"
                                            },
                                            {
                                                "example_id": "a8363fb4-bf10-49cb-b78f-3cf744f8a1f7",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Der Sprechdurchfall kann dann auch beispielsweise eine Begleiterscheinung von ADHS oder ein Hinweis auf eine bipolare Störung sein.“"
                                            },
                                            {
                                                "example_id": "70a8b981-3caf-4b88-bd00-36b445996035",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Schnakenbisse sind eine unangenehme Begleiterscheinung des Sommers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
