                        "entry_id": "aad7de99-8f4c-3e90-a0ff-e8384d5a1fa6",
                        "glosses": [
                            "Kriterium, nach welchem „ein Tötungsdelikt unter den besonders schwereren Tatbestand des Mordes fällt“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cee73aac-28e5-42be-9455-3ac29ff3b888",
                                "sense_id": "7087708e-8293-31cd-aa4e-2668ab860a0b",
                                "text": "„Zu töten, um eine andere Straftat zu vertuschen, ist ein Mordmerkmal.“"
                            },
                            {
                                "example_id": "56e28896-b49f-43e5-b85d-8404783eedcf",
                                "sense_id": "7087708e-8293-31cd-aa4e-2668ab860a0b",
                                "text": "„Diese Überlegungen […] müssten durch die Auflösung der zwingenden Verbindung zwischen der Verwirklichung eines Mordmerkmales und der lebenslangen Freiheitsstrafe ergänzt werden.“"
                            }
                        ],
