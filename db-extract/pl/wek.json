                "senses": [
                    {
                        "sense_id": "86c31d6f-ce69-3ea8-b114-48b0f058e47e",
                        "entry_id": "a025ce51-e3f2-3469-b8f3-9e69b065593e",
                        "glosses": [
                            "słoik z pokrywką ze szkła, szczelnie zamykany za pomocą gumowej uszczelki i metalowego zacisku, przeznaczony do przechowywania przetworów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3263914-e1c4-463f-a3fa-5c68d2c8d1c1",
                                "sense_id": "86c31d6f-ce69-3ea8-b114-48b0f058e47e",
                                "text": "Weki nie nadają się do pasteryzacji na sucho (w piekarniku), bo pod wpływem suchego powietrza o wysokiej temperaturze rozpadają się gumki uszczelniające."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "96cff821-88a8-3874-b424-358f50c1d40e",
                        "entry_id": "a025ce51-e3f2-3469-b8f3-9e69b065593e",
                        "glosses": [
                            "przetworzona żywność stanowiąca zawartość weka (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf9506aa-3078-458c-b018-26a746b476c3",
                                "sense_id": "96cff821-88a8-3874-b424-358f50c1d40e",
                                "text": "Lato i jesień to najlepsza pora na robienie weków."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
