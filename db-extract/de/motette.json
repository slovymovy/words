                    }
                ],
                "senses": [
                    {
                        "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                        "entry_id": "0ede24ff-9895-3d08-a381-c0d7beb9ec5b",
                        "glosses": [
                            "mehrstimmiger geistlicher oder weltlicher Chorgesang mit mehreren Abschnitten, zumeist ohne Instrumentalbegleitung"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "8bff5397-9af2-40a2-a0fd-f8c9c830f6c1",
                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                "text": "Die Messen und Motetten des um 1500 unweit von Lille geborenen Nicolas Gombert gehören zum Schönsten, was die franko-flämische Polyfonie des 15. und 16. Jahrhunderts hinterlassen hat."
                            },
                            {
                                "example_id": "981f79f8-ce9a-4848-ae29-a48fb090c29b",
                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                "text": "Bachs unvergleichliches Verdienst bei der Renovierung des Prinzips Motette lag in der Verbindung von kontrapunktischer Feinarbeit und doppelchörigem Bauplan, von triebhaft-horizontalem Fugenwerk und federnd gelagerter Gruppenstruktur."
                            },
                            {
                                "example_id": "19c6e673-74e8-42a0-a2d5-38cba7e54527",
                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                "text": "Es war nicht irgendein Gelegenheitswerk, sondern die Motette Exsultate, jubilate KV 165, ein typisch italienisches, opernhaftes Bravourstück mit furiosen Ecksätzen, einem Rezitativ und einer ausdrucksvollen Andante-Arie."
                            },
                            {
                                "example_id": "4798675b-3e9f-4264-a643-651c8e07b8a9",
                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                "text": "Was sich nicht zuletzt in dessen madrigalesken Chorwerken aus den 30er-Jahren niederschlägt, die der NDR Chor unter Philipp Ahmann zum Doppelportrait ebenso sinnfesselnd beisteuerte wie Messiaens liturgische Motette \"O sacrum convivium\" (O heiliges Mahl)."
                            },
                            {
                                "example_id": "8a340c03-43a7-45c1-acf6-8663dfa02bdd",
                                "sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
                                "text": "Gewiss singt er mit ihnen auch mal ein Schlagerlied, \"die trällern das dann im Bus bei unseren Konzertreisen vergnügt vor sich hin\", um gleich wieder ohne Murren zu einer Motette von Heinrich Schütz, einem Chorsatz von Mendelssohn zurückzukehren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6125b4a-ebe8-4a8c-b363-e1c44da85480",
                        "source_entry_id": "0ede24ff-9895-3d08-a381-c0d7beb9ec5b",
                        "source_sense_id": "88ab63a9-cec4-3059-98bd-5ac74db6dce6",
