                "senses": [
                    {
                        "sense_id": "1ce2ffb6-7959-3c96-990c-cfce2cfc05c9",
                        "entry_id": "5640a349-c77e-3b26-ad6e-6e5203d995a6",
                        "glosses": [
                            "alte babylonische, phönizische und hebräische Einheit für ein Gewicht (von – je nach Epoche und Region – einigen Gramm, besonders für Edelmetalle wie Gold und Silber) und für das Geld bestimmter Münzen als Währung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09cec5e6-3a6a-44a9-8c02-fa095ff94ad6",
                                "sense_id": "1ce2ffb6-7959-3c96-990c-cfce2cfc05c9",
                                "text": "„Die fünfte glückverheißende Deponierung […] besteht aus einem Löwen aus Gold von einem Scheqel Gewicht sowie aus drei Rinderpaaren – das eine aus Eisen, ‚mit einem silbernen Joch angeschirrt, jedes Rind von einem Scheqel Gewicht; unter ihnen ist ein Sockel.‘“"
                            },
                            {
                                "example_id": "ce9a3730-4b38-4ad8-b45b-dd7901484ec5",
                                "sense_id": "1ce2ffb6-7959-3c96-990c-cfce2cfc05c9",
                                "text": "„Wenn ein Arzt einem Bürger eine schwere Wunde mit einem Operationsmesser beibringt und den Bürger heilt, oder wenn er die Schläfe eines Bürgers mit dem Operationsmesser öffnet und das Auge des Bürgers erhält, so soll er zehn Scheqel Silber erhalten [ein Scheqel entspricht etwa 8 1/3 Gramm; in der Zeit Hammurapis konnte bereits für 20 Scheqel Silber ein Sklave erworben werden].“"
                            },
                            {
                                "example_id": "80a70eca-fbb9-415d-b960-2f324253fd0d",
                                "sense_id": "1ce2ffb6-7959-3c96-990c-cfce2cfc05c9",
                                "text": "„7 2/3 Scheqel 8 Korn geläutertes Silber nach dem Gewichtsstein von Mari, als Zins kommt auf 10 Scheqel je ein Viertel (Scheqel) hinzu: von […] Dadā, hat Puzur-Mamma […] (es) […] genommen.“ (Verpflichtungsschein, 19.–18. Jh. v. Chr.)"
                            },
                            {
                                "example_id": "b45b0e8d-2408-4230-a70e-f90d78c3eada",
                                "sense_id": "1ce2ffb6-7959-3c96-990c-cfce2cfc05c9",
                                "text": "„Wenn jemand einen ausgebildeten Vogelfänger kauft, gibt er 25 Scheqel Silber.“"
                            },
                            {
                                "example_id": "bbf00a11-68dd-4047-ae35-7792410a17d9",
                                "sense_id": "1ce2ffb6-7959-3c96-990c-cfce2cfc05c9",
                                "text": "„Die Auslösungssumme für einen Erstgeborenen betrug 5 Scheqel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
