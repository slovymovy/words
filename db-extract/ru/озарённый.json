                            "past",
                            "perfective"
                        ],
                        "examples": [
                            {
                                "example_id": "74615159-9fe2-419e-b75c-dfaf479439d0",
                                "sense_id": "22aa13f8-2585-30f6-a9f7-7b3370a59caf",
                                "text": "Таба́чный дым голубы́ми стру́ями ви́лся о́коло реде́ющих воло́с моего́ дя́ди и тяну́лся в окно́, на двор, озарённый я́рким со́лнцем.",
                                "translation": "Yakov Polonsky",
                                "english": "Yakov Polonsky"
                            }
                        ]
