                ],
                "senses": [
                    {
                        "sense_id": "e42c9390-dee6-3d37-a330-c237a6098fed",
                        "entry_id": "a72e3b65-808f-3f7f-95a5-0d3f6ee828cc",
                        "glosses": [
                            "the state or quality of suffering due to compassion for someone else's suffering"
                        ],
                        "tags": [
                            "archaic",
                            "feminine",
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "1e1c178b-c909-432e-abab-cdad17bda92f",
                                "sense_id": "e42c9390-dee6-3d37-a330-c237a6098fed",
                                "text": "Jeder Theil des Körpers sympathisirt mit dem Gemüthe; denn was das Gemüth afficiert, afficirt den Körper im Verhältnisse. Diese Mitleidenschaften sind am stärksten in den Lebenstheilen; aber ausser diesen allgemeinen Mitleidenschaften zwischen dem Magen, dem Gemüthe und allen Theilen des Körpers gibt es besondere Mitleidenschaften, z. B. die des Herzens mit den Lungen."
                            }
                        ]
                    },
                    {
                        "sense_id": "16e3b217-cca8-3001-8d84-51578867df2f",
                        "entry_id": "a72e3b65-808f-3f7f-95a5-0d3f6ee828cc",
                        "glosses": [
                            "embroilment, involvement (the state or quality of suffering negative consequences caused by someone or something else)"
                        ],
                        "tags": [
                            "broadly",
                            "feminine",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "0f7d6b4c-de99-409c-b523-b6f38370b046",
                                "sense_id": "16e3b217-cca8-3001-8d84-51578867df2f",
                                "text": "in Mitleidenschaft ziehen",
                                "translation": "to affect (negatively), to involve",
                                "english": "to affect (negatively), to involve"
                            },
                            {
                                "example_id": "1aee3d67-7892-43e7-a18b-55907dc59498",
                                "sense_id": "16e3b217-cca8-3001-8d84-51578867df2f",
                                "text": "Das alles aber kam daher, daß jetzt nicht mehr nur ein Lappen der rechten Lunge, sondern die ganze rechte Lunge in Mitleidenschaft gezogen war, ja, daß, wenn nicht alles täuschte, auch schon an der linken Seite Spuren des Vorganges bemerkbar waren, […]",
                                "translation": "It was accounted for by the fact that now not only a lobe of the right lung, but the whole right lung, was affected, with even distinct traces of a process in the left, […]",
                                "english": "It was accounted for by the fact that now not only a lobe of the right lung, but the whole right lung, was affected, with even distinct traces of a process in the left, […]"
                            },
                            {
                                "example_id": "f151c36d-2b43-4aa7-aae8-df62b52cdd17",
                                "sense_id": "16e3b217-cca8-3001-8d84-51578867df2f",
                                "text": "Da du sagst, daß auch die Familie durch den Prozeß in Mitleidenschaft gezogen würde,—was ich für meinen Teil durchaus nicht begreifen kann, das ist aber Nebensache—so will ich dir gerne in allem folgen.",
                                "translation": "Since you tell me that the family would be involved in any scandal arising from the case—I don't see myself how that could be so, but that's beside the point—I'll submit willingly to your judgement.",
                                "english": "Since you tell me that the family would be involved in any scandal arising from the case—I don't see myself how that could be so, but that's beside the point—I'll submit willingly to your judgement."
                            }
                        ]
                    }
                ],
