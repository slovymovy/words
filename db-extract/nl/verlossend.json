        "nl-extract.jsonl": [
            {
                "entry_id": "3d3251d4-db99-32f9-9404-68ce8ef8fcdd",
                "word": "verlossend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b350f11-ce87-3bb8-b28a-c052cc65a962",
                        "entry_id": "3d3251d4-db99-32f9-9404-68ce8ef8fcdd",
                        "glosses": [
                            "van iets dat het iemand bevrijd van een last"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87df6d03-6b13-42fc-8e80-aabac5c5cacb",
                                "sense_id": "1b350f11-ce87-3bb8-b28a-c052cc65a962",
                                "text": "Uiteindelijk moet worden gegoogeld welke wiskundige met de constante pi omtrek en oppervlakte van cirkels berekende. Archimedes is hier het verlossende laatste antwoord."
                            },
                            {
                                "example_id": "83adf9b0-3c15-4456-b312-f8db94e65343",
                                "sense_id": "1b350f11-ce87-3bb8-b28a-c052cc65a962",
                                "text": "Een achtbaan, zo omschrijft Michel Vlap de laatste weken, waarin hij continu heen en weer werd geslingerd tussen het heden bij Heerenveen en de door hem gewenste toekomst bij Anderlecht. Dinsdagmiddag kwam het verlossende woord: hij wordt speler van Anderlecht."
                            },
                            {
                                "example_id": "e2e0f0f1-e68f-4f71-9977-9dc4bcd1854a",
                                "sense_id": "1b350f11-ce87-3bb8-b28a-c052cc65a962",
                                "text": "Astrid Holleeder heeft jaren, samen met zus Sonja, gestreden om haar broer Willem Holleeder achter de tralies te krijgen. Gisteren was daar de verlossende uitspraak: de beruchtste crimineel van Nederland krijgt levenslang."
                            }
                        ]
                    }
