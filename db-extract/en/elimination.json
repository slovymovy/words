                    },
                    {
                        "sense_id": "39e2045a-81cc-3865-8485-306d60389a2c",
                        "entry_id": "7b406c57-6229-36ca-9d63-7a7a92589e9b",
                        "glosses": [
                            "The act of excluding a losing contestant from a match, tournament, or other competition."
