                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9be8f715-6c03-42e3-a3c1-d331709d1603",
                        "source_entry_id": "6fb01249-f6ed-37d7-9982-ddd7a855e084",
                        "source_sense_id": "d86a260e-9401-3f50-8d89-427bd0744b24",
                        "target_lang_word": "Balalaika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balalaika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                        "entry_id": "cba420bc-6d77-3f46-8d5b-0df613f0ff0f",
                                        "glosses": [
                                            "dreisaitiges, russisches Zupfinstrument mit einem dreieckigem Resonanzkörper aus Holz und einem langen Hals mit Bünden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35df8c1c-7939-47de-8656-dc71fbb470af",
                                                "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                                "text": "Die Balalaika ist im Klang der Mandoline verwandt."
                                            },
                                            {
                                                "example_id": "cff816b7-0d6a-421b-8aea-9a928c768384",
                                                "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                                "text": "„Wir hatten, wenn überhaupt, unterwegs nur sehr leise miteinander gesprochen, nicht mit Wodkaflaschen gewunken und weder Matroschkas noch Balalaikas in den Händen.“"
                                            },
                                            {
                                                "example_id": "8cfe1d1d-ab4a-4900-8728-476f9e104c13",
                                                "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                                "text": "„In weiser Voraussicht hat er seine Balalaika mitgebracht und begleitet sich selbst zum wehmütigen Gesang.“"
                                            },
                                            {
                                                "example_id": "cdd90899-65df-40cf-92bb-1fbcd9abb664",
                                                "sense_id": "29e8cfc6-fc1c-357c-b5f4-4be8ed161e4a",
                                                "text": "„Jetzt kamen deutlich vernehmbar die Töne einer Balalaika aus dem Korridor, und offenbar wurde dieses Instrument von der Hand eines Meisters gespielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16b70ac8-fa2c-4c80-82a3-3ca72b9a292e",
                        "source_entry_id": "6fb01249-f6ed-37d7-9982-ddd7a855e084",
                        "source_sense_id": "d86a260e-9401-3f50-8d89-427bd0744b24",
                        "target_lang_word": "балалайка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "балалайка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ddee2a3b-6c6a-3b1f-ba1b-ab17e8d3c42a",
                                        "entry_id": "97f423ba-4668-3705-8b84-a31a77f2917d",
                                        "glosses": [
                                            "муз. русский народный трёхструнный щипковый музыкальный инструмент"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "361dcdf5-dfcc-4ae8-bf43-38715d71cdb0",
                                                "sense_id": "ddee2a3b-6c6a-3b1f-ba1b-ab17e8d3c42a",
                                                "text": "И там же, на стенке, висела его заветная балалайка. Это была страсть Антипа, это была его бессловесная глубокая любовь всей жизни — балалайка. Антип мог часами играть на ней, склонив набочок голову, и непонятно было: то ли она ему рассказывает что-то очень дорогое, давно забытое им, то ли он передаёт ей свои неторопливые стариковские думы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede3d5b2-1514-3497-9a9b-0d0de7fbaa69",
                                        "entry_id": "97f423ba-4668-3705-8b84-a31a77f2917d",
