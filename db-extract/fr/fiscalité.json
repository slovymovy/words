                                "example_id": "5ba16587-e21f-4884-9c41-08f3e8ccb535",
                                "sense_id": "1043edcd-41ab-3564-8805-c4cfda67ac27",
                                "text": "Cette prétention a un caractère odieux de fiscalité."
                            }
                        ]
