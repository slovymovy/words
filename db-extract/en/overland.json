                        "examples": [
                            {
                                "example_id": "784ec82c-535a-419c-93dd-789961238205",
                                "sense_id": "a64ee554-9c3d-3a76-8ad4-245c3ea8d5da",
                                "text": "So, sir. I desire of you\nA conduct overland to Milford Haven."
