                    {
                        "sense_id": "f2539196-93eb-3616-a43f-fcce209d32ea",
                        "entry_id": "58977468-2268-3b12-9449-f4f47350ba6d",
                        "glosses": [
                            "een draagbare tas, die meestal met een draagband of draagriem over één schouder gedragen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae6b2907-0fb3-415f-9e6b-6bfc175b439d",
                                "sense_id": "f2539196-93eb-3616-a43f-fcce209d32ea",
                                "text": "Een tas van Eric Beauduin. Ik was al lang op zoek naar een rug- en schoudertas en die kreeg ik van mijn man cadeau, dus dubbel geluk. Ik gebruik hem alle dagen en zou hem liefst overal mee naar toe nemen."
                            },
                            {
                                "example_id": "a5480536-c983-42b1-b8bb-c168156088e1",
                                "sense_id": "f2539196-93eb-3616-a43f-fcce209d32ea",
                                "text": "Goed, het kost de hondeneigenaren nogal wat training, maar als het dier het eenmaal gewend is, dan stapt hij rustig in een tas. Dat is ook wel te zien aan de foto's die het afgelopen jaar online zijn verschenen. Van een pitbull in een groene canvas schoudertas tot een vuilnisbak in een beroemde tas van Ikea."
                            }
                        ]
                    }
