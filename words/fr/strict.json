    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f463a789-4f67-3811-9d92-8545fdb535db",
                    "sense_definition": "Qui fait preuve d'une grande sévérité, d'une grande rigueur dans ses exigences ou son comportement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce professeur est très <w>strict</w> avec ses élèves sur la ponctualité.",
                            "target_lang_translations": {
                                "en": "This teacher is very <w>strict</w> with students about punctuality.",
                                "ru": "Этот учитель очень <w>строг</w> к ученикам в вопросах пунктуальности.",
                                "de": "Dieser Lehrer ist sehr <w>streng</w> mit seinen Schülern, was Pünktlichkeit angeht.",
                                "es": "Este profesor es muy <w>estricto</w> con sus alumnos en lo que respecta a la puntualidad.",
                                "zh": "这位老师在守时方面对学生非常<w>严格</w>。"
                            }
                        },
                        {
                            "text": "Ses parents sont particulièrement <w>stricts</w> concernant les sorties en soirée.",
                            "target_lang_translations": {
                                "en": "Their parents are particularly <w>strict</w> about going out in the evening.",
                                "ru": "Родители особенно <w>строги</w> насчёт вечерних выходов из дома.",
                                "de": "Seine Eltern sind bei abendlichen Ausgängen besonders <w>streng</w>.",
                                "es": "Sus padres son especialmente <w>estrictos</w> con las salidas nocturnas.",
                                "zh": "他的父母在晚上外出的问题上特别<w>严格</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sévère",
                        "exigeant",
                        "intransigeant",
                        "rigide"
                    ],
                    "antonyms": [
                        "indulgent",
                        "tolérant",
                        "permissif",
                        "souple"
                    ],
                    "common_phrases": [
                        "parents stricts",
                        "professeur strict"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing great severity and rigour in one's demands or behaviour.",
                        "ru": "Проявляющий большую строгость и требовательность в своих требованиях или поведении.",
                        "de": "Zeigt große Strenge und Genauigkeit in seinen Forderungen und seinem Verhalten.",
                        "es": "Que muestra gran severidad y rigor en sus exigencias o en su comportamiento.",
                        "zh": "对要求和行为极为严厉、一丝不苟的。"
                    },
                    "translations": {
