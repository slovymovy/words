                        "sense_id": "8dcca05f-3864-31c5-89a0-c157de700adb",
                        "entry_id": "000880f9-84c8-3ed4-b251-1142bb583d73",
                        "glosses": [
                            "Contrary to mainstream or accepted opinion."
                        ],
