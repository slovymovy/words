        "ru-extract.jsonl": [
            {
                "entry_id": "5d59efc4-b943-3fb1-affa-b6ae141ba8fd",
                "word": "технически",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1cabb9c7-3430-3ed1-8f05-915ed59a874d",
                        "entry_id": "5d59efc4-b943-3fb1-affa-b6ae141ba8fd",
                        "glosses": [
                            "наречие к технический; с точки зрения техники"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "81a634eb-8b59-4706-9ccb-5cd88593a6f3",
                                "sense_id": "1cabb9c7-3430-3ed1-8f05-915ed59a874d",
                                "text": "Душа человека, как почва, которую можно не возделывать совсем, и тогда она будет технически называться пустошью; можно возделать и засеять пшеницей и чем угодно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83a522ee-3620-46cc-981f-bfef234a852a",
                        "source_entry_id": "5d59efc4-b943-3fb1-affa-b6ae141ba8fd",
                        "source_sense_id": "1cabb9c7-3430-3ed1-8f05-915ed59a874d",
                        "target_lang_word": "technically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99412723-70a4-3949-816d-0e07869f750c",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "Based on precise facts, which, however, may be contrary to common belief or casual terminology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd8c6ea-9b20-44fd-9270-b19a2ebdec5e",
                                                "sense_id": "99412723-70a4-3949-816d-0e07869f750c",
                                                "text": "Near-synonym: stricto sensu"
                                            },
                                            {
                                                "example_id": "d2195851-6d0f-4162-9415-cb29973b071b",
                                                "sense_id": "99412723-70a4-3949-816d-0e07869f750c",
                                                "text": "Technically, he was Canadian, but everyone assumed he was American."
                                            },
                                            {
                                                "example_id": "f7dfc83d-35e3-4ff6-ba30-90cea2a7cd49",
                                                "sense_id": "99412723-70a4-3949-816d-0e07869f750c",
                                                "text": "Technically, a guinea pig is not a pig, nor is it from Guinea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "Based on formal (de jure) arguments, which, however, may be misleading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a599111-4391-4eae-88fe-6d1d46334f84",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "technically correct"
                                            },
                                            {
                                                "example_id": "3a367a48-be29-455b-858c-7ca8d951dfa1",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "Due to an omission in the peace treaty of the Russo-Japanese War, Montenegro was technically at war with Japan for 102 years."
                                            },
                                            {
                                                "example_id": "0c6f3d43-660c-480a-9aef-efd0ba2ba43b",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "Stalin was not technically the Head of State."
                                            },
                                            {
                                                "example_id": "d41d576a-1f81-4e88-b6cf-63bed77f3ca8",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "Number 1.0 [the head bureaucrat of a legion of bureaucrats]: Bureaucrat Conrad, you are technically correct — the best kind of correct. I hereby promote you to grade 37."
                                            },
                                            {
                                                "example_id": "8db5885c-4b58-4eb1-88c1-1deba84ceab0",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "\"I warned you not to gaze upon my grand godson with that spell. I warned you it would not work properly. Granted, you couldn't hear me then any more than you can now, and you'd never met Tedd, but I diiiid technically say it!\""
                                            },
                                            {
                                                "example_id": "61970393-5b20-410c-a0ab-9f214250004e",
                                                "sense_id": "df62b94b-608d-37be-983a-f3dccaca7759",
                                                "text": "For the Japanese, however, it's easier to summarize what is still afloat. Nagato, Kongō, and Haruna are technically still afloat, but all three are quite clearly on their way to the bottom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c0012e8-4be0-3b04-b6d9-3dda32a01cfe",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "In terms of technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f41896c6-1983-45a0-863e-ab2c965b2926",
                                                "sense_id": "9c0012e8-4be0-3b04-b6d9-3dda32a01cfe",
                                                "text": "Although she is technically gifted, her piano playing lacks passion."
                                            },
                                            {
                                                "example_id": "73c6d6a7-6b12-4581-a446-771318b90813",
                                                "sense_id": "9c0012e8-4be0-3b04-b6d9-3dda32a01cfe",
                                                "text": "In Choosing Children one literally feels as if one were entering the lives of these parents and feels welcomed as they share their experiences with us openly and generously. Technically, this effect is enhanced by the straightforward camera work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d13113-8353-3a61-b58c-7d697e834f58",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "In a technical (involving specialized knowledge) way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0273f96f-3366-445b-9af3-9d4fc5dc226c",
                                                "sense_id": "c5d13113-8353-3a61-b58c-7d697e834f58",
                                                "text": "The ladies were not much the wiser, though, I confess, they were not far removed from the door. The great men inside talked indistinctly and technically, and once Doctor Dillon was so unfeeling as to crack a joke […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00edd874-3624-34f8-a939-6c43e76aedc9",
                                        "entry_id": "fd84ad3d-36a0-3d44-9559-6ea3d6566498",
                                        "glosses": [
                                            "According to the current state of technology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fabd124e-e5f3-4555-bc33-856fa4cdf7d0",
                                                "sense_id": "00edd874-3624-34f8-a939-6c43e76aedc9",
                                                "text": "For now, it is technically impossible to have a manned flight to Mercury."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a5d8576-c8a2-4371-8038-aaa670bae530",
                        "source_entry_id": "5d59efc4-b943-3fb1-affa-b6ae141ba8fd",
