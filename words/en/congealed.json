{
    "word_family": [
        "congeal",
        "congealment"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "060edd21-c9f4-3326-9f89-34206e0e36db",
                    "sense_definition": "Viscid, coagulated, or jelly-like; unusually thick in consistency.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "thickened_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>congealed</w> fat on the surface of the soup was unappealing to the guests.",
                            "target_lang_translations": {
                                "nl": "Het <w>gestolde</w> vet op het oppervlak van de soep was onaantrekkelijk voor de gasten."
                            }
                        },
                        {
                            "text": "After cooling for an hour, the sauce became <w>congealed</w> and difficult to pour.",
                            "target_lang_translations": {
                                "nl": "Na een uur afkoelen was de saus <w>gestold</w> en moeilijk uit te schenken."
                            }
                        }
                    ],
                    "synonyms": [
                        "coagulated",
                        "thickened",
                        "viscous"
                    ],
                    "antonyms": [
                        "liquid",
                        "fluid"
                    ],
                    "common_phrases": [
                        "congealed fat",
                        "congealed blood"
                    ],
                    "target_lang_definitions": {
                        "nl": "Stroperig, gestold of geleiachtig; ongewoon dik van consistentie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gestold",
                                "target_lang_sense_clarification": "algemene term voor vloeistof die dik of vast is geworden"
                            },
                            {
                                "target_lang_word": "dikvloeibaar",
                                "target_lang_sense_clarification": "verwijst naar een stroperige consistentie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0c381d4-3694-3764-8469-cc7acb03e714",
                    "sense_definition": "Turned into ice or solidified due to extreme cold.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "thickened_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water in the pipes had <w>congealed</w> during the record-breaking winter storm.",
                            "target_lang_translations": {
                                "nl": "Het water in de leidingen was tijdens de recordbrekende winterstorm <w>bevroren</w>."
                            }
                        },
                        {
                            "text": "The small pond was <w>congealed</w> into a solid sheet of ice by morning.",
                            "target_lang_translations": {
                                "nl": "De kleine vijver was tegen de ochtend <w>bevroren</w> tot een massieve ijsplaat."
                            }
                        }
                    ],
                    "synonyms": [
                        "frozen",
                        "solidified"
                    ],
                    "antonyms": [
                        "melted"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in literary or older contexts to describe freezing."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Veranderd in ijs of vast geworden door extreme kou."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bevroren",
                                "target_lang_sense_clarification": "veranderd in ijs door kou"
                            },
                            {
                                "target_lang_word": "vastgevroren",
                                "target_lang_sense_clarification": "door bevriezing vast komen te zitten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0dfabd04-d66b-399b-9da1-d8d8382aee05",
                    "sense_definition": "Simple past and past participle of <w>congeal</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gravy <w>congealed</w> quickly once it was removed from the heat.",
                            "target_lang_translations": {
                                "nl": "De jus <w>stolde</w> snel zodra deze van het vuur werd gehaald."
                            }
                        },
                        {
                            "text": "The blood had <w>congealed</w> on the bandage before the doctor arrived.",
                            "target_lang_translations": {
                                "nl": "Het bloed was op het verband <w>gestold</w> voordat de dokter arriveerde."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van stollen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "stolde",
                                "target_lang_sense_clarification": "verleden tijd van stollen"
                            },
                            {
                                "target_lang_word": "gestold",
                                "target_lang_sense_clarification": "voltooid deelwoord van stollen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}