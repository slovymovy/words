                    "frequency": "High",
                    "semantic_group_id": "reception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants du village ont réservé un <w>accueil</w> chaleureux aux nouveaux résidents."
                        },
                        {
                            "text": "Je vous remercie pour votre <w>accueil</w> très aimable lors de mon séjour."
                        }
                    ],
