                        "entry_id": "22b97dea-57bb-3207-afe9-0323cbffa715",
                        "glosses": [
                            "Qualité de ce qui n'est pas concevable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f53db2d-4787-4bc8-afae-55325b760d1a",
                                "sense_id": "a01762cf-9b87-3633-b140-4a5557f785df",
                                "text": "Il y a des inconcevabilités artificielles dont la force n’est pas moindre que celle des inconcevabilités naturelles."
                            },
                            {
                                "example_id": "935233a7-7ece-46ae-9a9e-c7355d4e9870",
                                "sense_id": "a01762cf-9b87-3633-b140-4a5557f785df",
                                "text": "Il fut un temps où l’idée des antipodes était une inconcevabilité."
                            },
                            {
                                "example_id": "53175b86-0f89-4141-abc2-d48ddfc84331",
                                "sense_id": "a01762cf-9b87-3633-b140-4a5557f785df",
                                "text": "L’habitude ne peut, tout au plus, que nous rendre inattentifs à l’inconcevabilité d’un phénomène — non à la faire disparaître."
                            }
                        ]
                    }
