                        "entry_id": "488ae66d-59ff-39b8-98cd-2dac1090ebc9",
                        "glosses": [
                            "The city of Livorno in Italy."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "5cae2892-69e2-4ab4-9a04-2f48a6b4bb79",
                                "sense_id": "ce5e5dc7-dcd5-373a-9d58-4ea86b2beb24",
                                "text": "Leghorn was the nearest port of consequence, […] the most likely of any in Italy to assist their plan. (III, ix)"
                            }
