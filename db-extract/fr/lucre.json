                                        "examples": [
                                            {
                                                "example_id": "389900ad-d3ee-4976-a950-307a09850655",
                                                "sense_id": "24943bce-601a-32d9-8b74-b525142ea76c",
                                                "text": "De onrust op de aandelenmarkt was in zijn voordeel."
                                            },
                                            {
                                                "example_id": "6eb311af-0a88-4268-896a-ab316f5db2dd",
                                                "sense_id": "24943bce-601a-32d9-8b74-b525142ea76c",
                                                "text": "Een even groot percentage acht zichzelf er niet toe in staat. En meer dan de helft is bang een boete te krijgen of een voordeeltje mis te lopen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "834c079f-3d37-32fa-aca5-0ed55146a599",
                                        "entry_id": "2c1394b1-408c-3760-99b5-61d9f4303ee1",
                                        "glosses": [
                                            "aangename eigenschap"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb81c532-1275-49e3-b090-1cc13ddfd106",
                                                "sense_id": "834c079f-3d37-32fa-aca5-0ed55146a599",
                                                "text": "Een voordeel van een motorfiets is het lage benzineverbruik per kilometer."
                                            },
                                            {
                                                "example_id": "aedf6d5e-7d15-487a-aa80-67a083307f12",
                                                "sense_id": "834c079f-3d37-32fa-aca5-0ed55146a599",
                                                "text": "Uit een onderzoek van de Stanford University uit 2014 bleek dat lange-afstandslopen vele voordelen heeft, behalve het feit dat je in de natuur bent en dat het nagenoeg gratis is."
                                            }
                                        ]
                                    },
