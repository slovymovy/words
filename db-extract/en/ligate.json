                                        "entry_id": "f6aab93c-07c7-3137-8f50-b6add647a77b",
                                        "glosses": [
                                            "een deel van een groter geheel losmaken door middel van een koord of touw"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
