                                        "examples": [
                                            {
                                                "example_id": "34d04be3-660e-4a91-bf32-9cfebffb9e5e",
                                                "sense_id": "134993bb-ce8e-3892-8c6b-bb252249b50f",
                                                "text": "Der Arzt behandelte sie versuchsweise mit einigen Hypnosen, jeweils im Abstand von wenigen Tagen."
                                            },
                                            {
                                                "example_id": "9a340a1e-9452-4755-b80e-d5cf7603eddf",
                                                "sense_id": "134993bb-ce8e-3892-8c6b-bb252249b50f",
                                                "text": "Hypnose wird nicht von jeder Krankenkasse als Therapie anerkannt."
                                            },
                                            {
                                                "example_id": "385dff93-ca02-4b71-a5ce-c138d998ab2d",
                                                "sense_id": "134993bb-ce8e-3892-8c6b-bb252249b50f",
                                                "text": "„Um sich Mut zu machen, experimentierten die Kampfbündler mit Hypnose und Selbsthypnose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "728b52fe-800d-3547-b113-0284df27215b",
                                        "entry_id": "fbc180b4-1b27-312b-8f42-5ad2acd2da60",
                                        "glosses": [
                                            "Zustand erhöhter Suggestibilität"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
