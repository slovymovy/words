                        "examples": [
                            {
                                "example_id": "879e530e-d83e-40d1-85b0-93af145553ab",
                                "sense_id": "86d6f358-78b1-37cb-bc18-85fed56d0745",
                                "text": "Der kleinste Bub kann freilich noch nix wie auf'n Fotzenhobel blasen; aber er bettelt mich so viel, daß ich ihm vom nächsten übrigen Geldl doch eine Trompeten oder so was kaufen muß."
                            },
                            {
                                "example_id": "e8b6fa6b-e7c6-49e5-a600-f9c5b18252f6",
                                "sense_id": "86d6f358-78b1-37cb-bc18-85fed56d0745",
                                "text": "Dementsprechend werden Norddeutsche bisweilen durch das oberbayerische Fotzenhobel für Mundharmonika arg schockiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
