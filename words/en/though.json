                {
                    "sense_id": "b2a3398d-4d8e-3f79-b805-d589073d7f2c",
                    "sense_definition": "If, that, even if.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will follow this path <w>though</w> it may lead to danger.",
                            "target_lang_translations": {
                                "ru": "Я пойду по этому пути, <w>даже если</w> он может привести к опасности.",
                                "nl": "Ik zal dit pad volgen, <w>zelfs als</w> het tot gevaar kan leiden.",
                                "pl": "Pójdę tą ścieżką, <w>choćby</w> miała prowadzić do niebezpieczeństwa.",
                                "de": "Ich werde diesen Weg gehen, <w>selbst wenn</w> er in Gefahr führen mag.",
                                "fr": "Je suivrai ce chemin <w>même s'</w>il peut mener au danger.",
                                "it": "Seguirò questo sentiero <w>anche se</w> potrebbe portare al pericolo.",
                                "cs": "Půjdu touto cestou, <w>i kdyby</w> mohla vést do nebezpečí.",
                                "tr": "Tehlikeye yol açabilecek <w>olsa bile</w> bu yolu takip edeceğim.",
                                "es": "Seguiré este camino <w>aunque</w> pueda llevar al peligro."
                            }
                        },
                        {
                            "text": "Walk on <w>though</w> your dreams be tossed and blown.",
                            "target_lang_translations": {
                                "ru": "Иди вперед, <w>даже если</w> твои мечты разбиты и развеяны.",
                                "nl": "Loop door, <w>al</w> worden je dromen geteisterd en weggeblazen.",
                                "pl": "Idź dalej, <w>nawet jeśli</w> twoje marzenia zostaną zniszczone i rozproszone.",
                                "de": "Geh weiter, <w>auch wenn</w> deine Träume zerrüttet und verweht werden.",
                                "fr": "Continue à marcher <w>même si</w> tes rêves sont bousculés et emportés par le vent.",
                                "it": "Continua a camminare, <w>anche se</w> i tuoi sogni vengono scossi e spazzati via.",
                                "cs": "Kráčej dál, <w>byť</w> by tvé sny byly rozmetány a rozfoukány.",
                                "tr": "Hayallerin sarsılıp savrulsa <w>bile</w> yürümeye devam et.",
                                "es": "Sigue caminando <w>aunque</w> tus sueños sean sacudidos y arrastrados."
                            }
                        }
                    ],
                    "traits": [
