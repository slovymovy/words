                ],
                "senses": [
                    {
                        "sense_id": "a8418cc6-fa62-3c69-9a3d-531cae00fb59",
                        "entry_id": "43904fb4-02d6-3183-a55e-4c0d35da0adb",
                        "glosses": [
                            "Teil des Wortschatzes, den jeder zuerst erlernen muss, der eine Sprache lernen will"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13844372-16da-4c6d-ab7c-253636b0d1ed",
                                "sense_id": "a8418cc6-fa62-3c69-9a3d-531cae00fb59",
                                "text": "Zum Grundwortschatz einer Sprache gehören wenige tausend Wörter, mit denen man einen sehr hohen Anteil der Texte verstehen kann, ohne die Wörter nachschlagen zu müssen."
                            },
                            {
                                "example_id": "9a899caa-0aa2-469e-a343-6bf3abf72b81",
                                "sense_id": "a8418cc6-fa62-3c69-9a3d-531cae00fb59",
                                "text": "Will man, dass etwa 85% des Wortschatzes von Texten bekannt sein soll, beläuft sich der Grundwortschatz auf etwa 2500 Wörter."
                            },
                            {
                                "example_id": "ef55105d-a899-436a-a56d-a801a434d7c3",
                                "sense_id": "a8418cc6-fa62-3c69-9a3d-531cae00fb59",
                                "text": "„Ihm werden die operational bestimmten Lexeme des Grundwortschatzes zugeordnet, die mit ihm in semantischem Zusammenhang stehen.“"
                            },
                            {
                                "example_id": "11dcef2e-f5cb-4ba1-9476-944d735e95d1",
                                "sense_id": "a8418cc6-fa62-3c69-9a3d-531cae00fb59",
                                "text": "„Zwar bieten einige Verlage bereits eine Reihe von Programmen an, die den neuen Regeln folgen - allerdings zumeist nur für den Grundwortschatz.“"
                            },
                            {
                                "example_id": "0bcc06ed-9c3b-4293-a0c9-203edee61bad",
                                "sense_id": "a8418cc6-fa62-3c69-9a3d-531cae00fb59",
                                "text": "„Er trat näher, um etwas von ihrer Sprache zu erhaschen, irgendetwas Vertrautes, vielleicht einen Begriff aus ihrem Grundwortschatz.“"
                            },
                            {
                                "example_id": "b9735d93-10b7-44c8-8cf5-1e10ae4f4fad",
                                "sense_id": "a8418cc6-fa62-3c69-9a3d-531cae00fb59",
                                "text": "„Der Grundwortschatz umfaßt nur einen verhältnismäßig kleinen Teil des gesamten Wortbestandes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
