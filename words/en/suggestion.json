{
    "word_family": [
        "suggest",
        "suggestible",
        "suggestive",
        "suggestibility"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c23bbdc8-b37b-3a9a-b824-d5d13d5c905c",
                    "sense_definition": "An idea, plan, or possibility that someone mentions for others to consider.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "proposal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you have a better <w>suggestion</w> for where to eat, please let me know.",
                            "target_lang_translations": {
                                "ru": "Если у тебя есть лучшее <w>предложение</w> относительно того, где поесть, пожалуйста, дай мне знать.",
                                "zh": "如果你有更好的吃饭地点的<w>建议</w>，请告诉我。"
                            }
                        },
                        {
                            "text": "I would like to make a <w>suggestion</w> regarding the new office layout.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы сделать <w>предложение</w> по поводу новой планировки офиса.",
                                "zh": "我想就新的办公室布局提一个<w>建议</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "proposal",
                        "hint"
                    ],
                    "common_phrases": [
                        "make a suggestion",
                        "helpful suggestion",
                        "useful suggestion",
                        "follow a suggestion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идея, план или возможность, которые кто-то предлагает на рассмотрение другим.",
                        "zh": "为了让别人考虑而提出的想法、计划或可能性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предложение",
                                "target_lang_sense_clarification": "идея или план"
                            },
                            {
                                "target_lang_word": "совет",
                                "target_lang_sense_clarification": "рекомендация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "提出的想法或计划"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4925ecdb-0214-3581-b987-485a048fc9d6",
                    "sense_definition": "The process or act of mentioning or recommending something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "proposal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>suggestion</w> of a new tax caused a lot of debate in the city.",
                            "target_lang_translations": {
                                "ru": "<w>Предложение</w> о введении нового налога вызвало много споров в городе.",
                                "zh": "关于征收新税的<w>建议</w>在城里引起了许多争论。"
                            }
                        },
                        {
                            "text": "At the <w>suggestion</w> of my doctor, I started exercising every morning.",
                            "target_lang_translations": {
                                "ru": "По <w>совету</w> моего врача я начал делать зарядку каждое утро.",
                                "zh": "在医生的<w>建议</w>下，我开始每天早上锻炼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incitement"
                    ],
                    "common_phrases": [
                        "at the suggestion of",
                        "power of suggestion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или акт упоминания или рекомендации чего-либо.",
                        "zh": "提出或推荐某事的过程或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предложение",
                                "target_lang_sense_clarification": "акт предложения"
                            },
                            {
                                "target_lang_word": "рекомендация",
                                "target_lang_sense_clarification": "совет сделать что-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "提出建议的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6f49cd6-772b-3b26-9148-4056602a31bd",
                    "sense_definition": "A slight trace or a sign that something exists or might happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>suggestion</w> of a smile on her face when she heard the news.",
                            "target_lang_translations": {
                                "ru": "На её лице появился <w>намек</w> на улыбку, когда она услышала новости.",
                                "zh": "听到这个消息时，她的脸上露出一丝<w>暗示</w>笑意的神情。"
                            }
                        },
                        {
                            "text": "The soup had just a faint <w>suggestion</w> of garlic in the broth.",
                            "target_lang_translations": {
                                "ru": "В бульоне чувствовался лишь едва уловимый <w>оттенок</w> чеснока.",
                                "zh": "汤里只有<w>一丝</w>淡淡的蒜味。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hint"
                    ],
                    "common_phrases": [
                        "faint suggestion",
                        "slight suggestion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабый след или признак того, что что-то существует или может произойти.",
                        "zh": "某事存在或可能发生的微弱迹象或痕迹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намек",
                                "target_lang_sense_clarification": "едва заметный признак"
                            },
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "легкий след чувства или вкуса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暗示",
                                "target_lang_sense_clarification": "微弱的迹象"
                            },
                            {
                                "target_lang_word": "一丝",
                                "target_lang_sense_clarification": "极少的量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "687b9d7c-df1f-310c-827b-152f42784fd7",
                    "sense_definition": "The process by which a physical or mental state is influenced by a thought or idea, especially during hypnosis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist used hypnotic <w>suggestion</w> to help the patient overcome his phobia.",
                            "target_lang_translations": {
                                "ru": "Терапевт использовал гипнотическое <w>внушение</w>, чтобы помочь пациенту преодолеть фобию.",
                                "zh": "治疗师利用催眠<w>暗示</w>来帮助病人克服恐惧症。"
                            }
                        },
                        {
                            "text": "Some people are more susceptible to the power of <w>suggestion</w> than others.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди более восприимчивы к силе <w>внушения</w>, чем другие.",
                                "zh": "有些人比其他人更容易受到心理<w>暗示</w>的影响。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hypnotic suggestion",
                        "power of suggestion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context in psychology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, посредством которого на физическое или психическое состояние влияет мысль или идея, особенно во время гипноза.",
                        "zh": "通过思想或观念影响生理或心理状态的过程，常见于催眠中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внушение",
                                "target_lang_sense_clarification": "психологическое воздействие"
                            },
                            {
                                "target_lang_word": "суггестия",
                                "target_lang_sense_clarification": "научный термин в психологии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暗示",
                                "target_lang_sense_clarification": "心理学上的影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16b37845-a59a-3242-b0c9-d07457e7940b",
                    "sense_definition": "An indirect statement or insinuation that is not based on solid evidence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer argued that the witness's testimony was mere <w>suggestion</w> rather than fact.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что показания свидетеля были лишь <w>предположением</w>, а не фактом.",
                                "zh": "律师辩称证人的证词仅仅是<w>暗示</w>，而非事实。"
                            }
                        },
                        {
                            "text": "He resented the <w>suggestion</w> that he had cheated on the exam.",
                            "target_lang_translations": {
                                "ru": "Его возмутил <w>намек</w> на то, что он жульничал на экзамене.",
                                "zh": "他很反感别人<w>暗示</w>他在考试中作弊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hint"
                    ],
                    "common_phrases": [
                        "mere suggestion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Косвенное утверждение или инсинуация, не основанная на твердых доказательствах.",
                        "zh": "非基于确凿证据的间接陈述或影射。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намек",
                                "target_lang_sense_clarification": "косвенное указание"
                            },
                            {
                                "target_lang_word": "предположение",
                                "target_lang_sense_clarification": "догадка без доказательств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "影射",
                                "target_lang_sense_clarification": "暗中指责"
                            },
                            {
                                "target_lang_word": "暗示",
                                "target_lang_sense_clarification": "间接的说法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}