                                        "sense_id": "5104713f-7dc9-357c-8bac-25e253a84e22",
                                        "entry_id": "1b7a6571-3033-370e-8400-5405dd14b9e9",
                                        "glosses": [
                                            "Of or pertaining to the fathers of the early Christian church, especially their writings."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5f36bc1-7a1b-4386-9f06-9a04d6de6522",
                                                "sense_id": "5104713f-7dc9-357c-8bac-25e253a84e22",
                                                "text": "The word modern was a term of reproach used by patristic humanists against the medieval schoolmen who developed the new logic and physics."
                                            }
                                        ]
                                    },
