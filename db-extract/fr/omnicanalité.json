                    {
                        "sense_id": "60e62f96-ffad-3c5f-9305-45a8f18362eb",
                        "entry_id": "86a30ff2-7fd0-3641-b58b-aa69576c0a8a",
                        "glosses": [
                            "Stratégie de vente et de contact avec la clientèle utilisant, simultanément ou de façon interconnectée, tous les canaux disponibles, en relation les uns avec les autres : magasin, téléphone, catalogue, Internet..."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd068e1-b9fe-4498-8a6e-da15ca8fefb2",
                                "sense_id": "60e62f96-ffad-3c5f-9305-45a8f18362eb",
                                "text": "L’omnicanalité est souvent vue comme une évolution du multicanal où l’utilisation simultanée des canaux disponibles est mieux optimisée."
                            },
                            {
                                "example_id": "092a2216-d106-4b4a-9dd5-561629930cec",
                                "sense_id": "60e62f96-ffad-3c5f-9305-45a8f18362eb",
                                "text": "L’omnicanalité recouvre aussi toutes les interactions entre le physique et le numérique. Tout d’abord l'utilisateur lui-même se numérise et peut, grâce à son smartphone, montrer dans l’instant au vendeur les prix chez la concurrence."
                            }
                        ]
                    }
