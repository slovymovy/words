            {
                "entry_id": "be093952-2519-3045-902f-f70322ee0e31",
                "word": "overkomst",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ee7c3cde-15f7-4548-8918-8e1470155c70",
                        "entry_id": "be093952-2519-3045-902f-f70322ee0e31",
                        "tags": [
                            "plural"
                        ],
                        "form": "overkomsten"
