                        {
                            "text": "In the old story, the villain was punished for his <w>enormous</w> sins.",
                            "target_lang_translations": {
                                "ru": "В старой истории злодей был наказан за свои <w>тяжкие</w> грехи.",
                                "tr": "Eski hikayede kötü adam, <w>büyük</w> günahları yüzünden cezalandırıldı.",
                                "zh": "在那个古老的故事里，反派因其<w>极度邪恶</w>的罪孽而受到了惩罚。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно порочный; чудовищный или возмутительный.",
                        "tr": "Aşırı derecede kötü; korkunç veya rezilce.",
                        "zh": "极其邪恶；残暴或令人发指的。"
                    },
                    "translations": {
