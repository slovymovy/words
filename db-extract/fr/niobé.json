            {
                "entry_id": "206bb78d-0110-37c0-8332-f85bf372dab5",
                "word": "Niobé",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "91b98335-4e3c-390b-8d92-d0882fc61e73",
                        "entry_id": "206bb78d-0110-37c0-8332-f85bf372dab5",
                        "glosses": [
                            "Fille de Tantale, épouse d’Amphion, roi de Thèbes, ses sept fils et sept filles furent assassinés par Apollon et Diane."
                        ],
                        "tags": [
                            "Mythologie grecque"
                        ],
                        "examples": [
                            {
                                "example_id": "15134e5c-aebf-4842-8254-d4335c504700",
                                "sense_id": "91b98335-4e3c-390b-8d92-d0882fc61e73",
                                "text": "Ils ont raison, ma fille, vous êtes aimable, et rien n’est comme vous… depuis Niobé, jamais une mère n’a parlé comme je fais."
                            },
                            {
                                "example_id": "35777f7a-19b7-4a16-a593-28ba427ee8e0",
                                "sense_id": "91b98335-4e3c-390b-8d92-d0882fc61e73",
                                "text": "Lorenzo. – J’ai versé plus de larmes sur la pauvre Italie que Niobé sur ses filles."
                            },
                            {
                                "example_id": "f63dd9f9-b9e9-4864-8d98-020339f7a178",
                                "sense_id": "91b98335-4e3c-390b-8d92-d0882fc61e73",
                                "text": "Dites-moi si la Niobé antique surpasse en désolation et en noblesse cette mère agenouillée au milieu de sa famille devant les baïonnettes françaises !"
                            }
                        ]
                    },
                    {
                        "sense_id": "4484e999-053a-3041-9491-d3dd89737ba3",
                        "entry_id": "206bb78d-0110-37c0-8332-f85bf372dab5",
                        "glosses": [
                            "71ᵉ astéroïde découvert en 1864 par M. Luther."
                        ],
