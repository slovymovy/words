                    {
                        "translation_id": "fb450c3e-78ed-4ddd-8fda-ace2e9c8dd0e",
                        "source_entry_id": "43676086-461b-36d8-aeab-0a0973caee95",
                        "source_sense_description": "collection of nerve cell bodies outside the brain",
                        "target_lang_word": "ganglion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
