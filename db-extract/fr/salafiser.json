                "senses": [
                    {
                        "sense_id": "99971f3a-9194-3d93-8c51-2f0cc4556534",
                        "entry_id": "2a0d7c14-87fd-35f6-9cda-76dc64c0ba26",
                        "glosses": [
                            "Donner un caractère salafiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3557763e-5690-4dac-935c-46c7320eba52",
                                "sense_id": "99971f3a-9194-3d93-8c51-2f0cc4556534",
                                "text": "Elle sait que le salafisme a un réel avenir dans les sociétés arabes et son objectif est donc de «salafiser» le parti Ennahdha, afin qu’il garde une influence chez les plus radicaux."
                            },
                            {
                                "example_id": "1b60c87a-f269-48a0-aed0-a7366d1b9f67",
                                "sense_id": "99971f3a-9194-3d93-8c51-2f0cc4556534",
                                "text": "Quand on observe avec quelle rapidité les banlieues tendent à se « salafiser » aussi bien à Londres, à Paris qu’à Copenhague, la question reste ouverte."
                            },
                            {
                                "example_id": "6dd08543-97e8-499f-809a-e98b621bc4c7",
                                "sense_id": "99971f3a-9194-3d93-8c51-2f0cc4556534",
                                "text": "Ennahdha serait en train de se « salafiser », selon Vincent Geisser"
                            }
                        ]
                    }
