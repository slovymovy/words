                        "entry_id": "a5acd17b-c6ea-3c36-a9ca-3499bd9d0eb0",
                        "glosses": [
                            "zanurzane w wodzie, proste kuchenne urządzenie elektryczne do przygotowywania wrzątku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "082ccafb-5cc2-4120-af8e-7b3ce384ccad",
                                "sense_id": "d3658388-8e58-36f1-835b-d3e17574ac64",
                                "text": "Po uzyskaniu zgody mamy, pewnego popołudnia przyjaciółki zataszczyły na wieżę piecyk elektryczny, materac dmuchany, koce, lampę, adapter „Mister Hit”, stos płyt, garnek, grzałkę do wody, paczkę herbaty, cukier, łyżeczki, kubki – no, i oczywiście, książki i zeszyty"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "47d681d3-5c0b-3e87-bc35-cbc562689cc9",
