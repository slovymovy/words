                        "entry_id": "64157586-27c7-3115-8c6e-e327e5ea8491",
                        "glosses": [
                            "Youth; the condition of being immature or not fully grown"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d2e6c7a2-aadb-45ea-96fb-c73f8f5bcadd",
                                "sense_id": "a3c7e41b-5a3b-3320-abc2-46b72bf70123",
                                "text": "emotional immaturity"
                            },
                            {
                                "example_id": "1b6222cb-062d-4c54-b22b-2ba72192cb98",
                                "sense_id": "a3c7e41b-5a3b-3320-abc2-46b72bf70123",
                                "text": "childish immaturity"
                            },
                            {
                                "example_id": "a90eb847-92a0-4e63-9ae3-1802f10f6f1e",
                                "sense_id": "a3c7e41b-5a3b-3320-abc2-46b72bf70123",
                                "text": "stage of immaturity"
                            },
                            {
                                "example_id": "d74718e6-2291-47fc-a0b1-13dac6794be4",
                                "sense_id": "a3c7e41b-5a3b-3320-abc2-46b72bf70123",
                                "text": "His constant joking showed his immaturity."
                            },
                            {
                                "example_id": "c9e3b731-711e-40c8-a7e0-20db595369dd",
                                "sense_id": "a3c7e41b-5a3b-3320-abc2-46b72bf70123",
                                "text": "The plant’s immaturity made it sensitive to frost."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8190d6cc-79d7-41ab-8929-4f433b7fc8bc",
                        "source_entry_id": "64157586-27c7-3115-8c6e-e327e5ea8491",
                        "source_sense_id": "a3c7e41b-5a3b-3320-abc2-46b72bf70123",
                        "source_sense_description": "the state of being immature",
                        "target_lang_word": "onvolwassenheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onvolwassenheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "69c87659-5c01-3c8a-a7cd-b568699ab550",
                                        "entry_id": "9bc3ca99-b7b8-3bab-9f22-ba6e3b8bb0fd",
                                        "glosses": [
                                            "het zo jong zijn dat men nog niet meerderjarig is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0615f91e-fb86-465e-a434-c0299fef997b",
                                                "sense_id": "69c87659-5c01-3c8a-a7cd-b568699ab550",
                                                "text": "De relatie begon ermee dat ze de 14-jarige jongen 'voorlichting' gaf en dat mondde uit in een seksuele verhouding die vier jaar duurde. \"Ik was verliefd op hem\", zei ze eerder tegen de rechter....\"Zij heeft misbruik gemaakt van het grote leeftijdsverschil van 28 jaar en de onvolwassenheid van het slachtoffer\", aldus de rechtbank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba2767c1-8ce0-3813-b4e9-5b441abab4d3",
                                        "entry_id": "9bc3ca99-b7b8-3bab-9f22-ba6e3b8bb0fd",
                                        "glosses": [
                                            "nog steeds heel kinderachtig zijn terwijl men eigenlijk beter zou moeten weten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48ccee6b-ac36-4908-87c0-a6e475691a3f",
                                                "sense_id": "ba2767c1-8ce0-3813-b4e9-5b441abab4d3",
                                                "text": "Die vervloekte onvolwassenheid."
                                            },
                                            {
                                                "example_id": "ae818419-d474-41ea-9b3f-ac8f049d8b1c",
                                                "sense_id": "ba2767c1-8ce0-3813-b4e9-5b441abab4d3",
                                                "text": "Het huwelijk tussen Mako en Kei Komuro zou eigenlijk dit jaar zijn, maar het stel zegt nu meer tijd nodig te hebben om zich voor te bereiden op de ceremonie en hun huwelijksleven. De prinses laat weten in een verklaring: \"De vertraging komt door onze onvolwassenheid en daar hebben wij spijt van.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1faeafec-377f-4500-9741-22723679e2cc",
                        "source_entry_id": "64157586-27c7-3115-8c6e-e327e5ea8491",
                        "source_sense_id": "a3c7e41b-5a3b-3320-abc2-46b72bf70123",
