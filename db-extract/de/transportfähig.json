                "senses": [
                    {
                        "sense_id": "a664a896-9127-3ea0-bacd-3c5372d99e3c",
                        "entry_id": "14009e38-4795-336b-a822-68bfa0bf1d38",
                        "glosses": [
                            "eine Beschaffenheit aufweisend, die einen Transport ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39d30923-ad20-4b92-a429-d9b17359e470",
                                "sense_id": "a664a896-9127-3ea0-bacd-3c5372d99e3c",
                                "text": "„China lehnte es am Montag erneut ab, den krebskranken Bürgerrechtler trotz seines kritischen Gesundheitszustandes zur Behandlung ins Ausland reisen zu lassen, obwohl er nach Einschätzung deutscher und amerikanischer Experten transportfähig ist.“"
                            },
                            {
                                "example_id": "bd06b8b2-cc05-4f2e-8a82-24be2ea6cfe8",
                                "sense_id": "a664a896-9127-3ea0-bacd-3c5372d99e3c",
                                "text": "„Nordkorea soll es gelungen sein, seine Atombomben zu miniaturisieren. Damit wären sie transportfähig, was die Voraussetzung ist, um sie überhaupt gegen verfeindete Staaten einzusetzen.“"
                            },
                            {
                                "example_id": "8703ea8b-4e4b-4ddd-8fb2-434745805f54",
                                "sense_id": "a664a896-9127-3ea0-bacd-3c5372d99e3c",
                                "text": "„‚Es kann nicht sein, dass 70 Prozent der Männer unter 40 Jahren vor einer Abschiebung für krank und nicht transportfähig erklärt werden‘, so de Maizière.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
