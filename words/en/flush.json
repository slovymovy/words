{
    "word_family": [
        "flusher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41cf8859-feef-397c-a772-a2f8cd3d16d0",
                    "sense_definition": "To clean a toilet by causing a large amount of water to flow through it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please remember to <w>flush</w> the toilet before you leave the bathroom.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не забудь <w>смыть</w> воду в туалете перед выходом из ванной.",
                                "zh": "离开洗手间前，请记得<w>冲水</w>。"
                            }
                        },
                        {
                            "text": "The handle was broken, so I could not <w>flush</w> it properly.",
                            "target_lang_translations": {
                                "ru": "Ручка была сломана, поэтому я не мог нормально <w>смыть</w> воду.",
                                "zh": "把手坏了，所以我没法正常<w>冲水</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flush the toilet",
                        "flush the loo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смывать воду в туалете, пуская сильный поток воды.",
                        "zh": "指通过大量水流冲洗厕所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смывать",
                                "target_lang_sense_clarification": "воду в туалете"
                            },
                            {
                                "target_lang_word": "смыть",
                                "target_lang_sense_clarification": "воду в туалете (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲水",
                                "target_lang_sense_clarification": "指冲洗厕所"
                            },
                            {
                                "target_lang_word": "冲厕所",
                                "target_lang_sense_clarification": "指冲洗厕所的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9c527dd-ccef-304b-998c-6615643ed582",
                    "sense_definition": "To become red in the face, especially as a result of strong emotion, heat, or alcohol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "redness_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt her cheeks <w>flush</w> with embarrassment when everyone looked at her.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала, как её щёки <w>вспыхнули</w> от смущения, когда все посмотрели на неё.",
                                "zh": "当大家都看向她时，她感到双颊因尴尬而<w>涨红</w>了。"
                            }
                        },
                        {
                            "text": "His face started to <w>flush</w> with anger as he read the letter.",
                            "target_lang_translations": {
                                "ru": "Его лицо начало <w>краснеть</w> от гнева, пока он читал письмо.",
                                "zh": "读信时，他的脸因愤怒而开始<w>涨红</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blush"
                    ],
                    "common_phrases": [
                        "flush with anger",
                        "flush with embarrassment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краснеть лицом, особенно от сильных эмоций, жары или алкоголя.",
                        "zh": "指因强烈情绪、高温或饮酒而脸红。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "краснеть",
                                "target_lang_sense_clarification": "становиться красным"
                            },
                            {
                                "target_lang_word": "вспыхнуть",
                                "target_lang_sense_clarification": "внезапно покраснеть"
                            },
                            {
                                "target_lang_word": "залиться краской",
                                "target_lang_sense_clarification": "сильно покраснеть от смущения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脸红",
                                "target_lang_sense_clarification": "因情绪或生理原因变红"
                            },
                            {
                                "target_lang_word": "涨红",
                                "target_lang_sense_clarification": "因激动或愤怒而脸部充血"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5464dfe-6674-3b17-be55-1aae31bfe933",
                    "sense_definition": "To clean or wash something by letting water or another fluid flow over or through it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>flush</w> the wound with clean water to prevent infection.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>промыть</w> рану чистой водой, чтобы предотвратить инфекцию.",
                                "zh": "你应该用清水<w>冲洗</w>伤口以防感染。"
                            }
                        },
                        {
                            "text": "The mechanic needs to <w>flush</w> the radiator to remove the rust and debris.",
                            "target_lang_translations": {
                                "ru": "Механику нужно <w>промыть</w> радиатор, чтобы удалить ржавчину и мусор.",
                                "zh": "技工需要<w>冲洗</w>散热器以清除铁锈和杂物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flush the system",
                        "flush with water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать или мыть что-либо, пропуская через это поток воды или другой жидкости.",
                        "zh": "指通过水流或其他液体冲洗以达到清洁目的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промывать",
                                "target_lang_sense_clarification": "очищать жидкостью"
                            },
                            {
                                "target_lang_word": "промыть",
                                "target_lang_sense_clarification": "очистить жидкостью (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲洗",
                                "target_lang_sense_clarification": "用水流清洁"
                            },
                            {
                                "target_lang_word": "清洗",
                                "target_lang_sense_clarification": "通过液体流动进行清洁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dc6c70f-ec64-3e8f-bde2-a5335aa568f8",
                    "sense_definition": "To force a person or animal to leave a place where they are hiding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drive_out",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunters used trained dogs to <w>flush</w> the birds from the tall grass.",
                            "target_lang_translations": {
                                "ru": "Охотники использовали обученных собак, чтобы <w>выгнать</w> птиц из высокой травы.",
                                "zh": "猎人们利用训练有素的狗将鸟儿从高草丛中<w>惊起</w>。"
                            }
                        },
                        {
                            "text": "Police used tear gas to <w>flush</w> the suspect out of the building.",
                            "target_lang_translations": {
                                "ru": "Полиция применила слезоточивый газ, чтобы <w>выкурить</w> подозреваемого из здания.",
                                "zh": "警方使用催泪瓦斯将嫌疑人从大楼里<w>赶出</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flush out",
                        "drive",
                        "scare up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять человека или животное покинуть место, где они прячутся.",
                        "zh": "指强迫人或动物离开藏身之处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгонять",
                                "target_lang_sense_clarification": "из укрытия"
                            },
                            {
                                "target_lang_word": "спугивать",
                                "target_lang_sense_clarification": "дичь, птиц"
                            },
                            {
                                "target_lang_word": "выкуривать",
                                "target_lang_sense_clarification": "заставлять выйти (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赶出",
                                "target_lang_sense_clarification": "迫使离开藏身处"
                            },
                            {
                                "target_lang_word": "惊起",
                                "target_lang_sense_clarification": "指使鸟兽从隐蔽处飞出或跑出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "572ebbc1-ee10-3513-a30e-6dcc30fd2221",
                    "sense_definition": "To clear data from a computer's memory buffer or cache.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system automatically <w>flushes</w> the cache every few minutes to free up memory.",
                            "target_lang_translations": {
                                "ru": "Система автоматически <w>очищает</w> кэш каждые несколько минут для освобождения памяти.",
                                "zh": "系统每隔几分钟会自动<w>清空</w>缓存以释放内存。"
                            }
                        },
                        {
                            "text": "You must <w>flush</w> the buffer to ensure all data is written to the disk.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>сбросить</w> буфер, чтобы убедиться, что все данные записаны на диск.",
                                "zh": "你必须<w>清空</w>缓冲区，以确保所有数据都已写入磁盘。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать буфер памяти или кэш компьютера.",
                        "zh": "指清除计算机内存缓冲区或缓存中的数据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "память, кэш"
                            },
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "буфер данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清空",
                                "target_lang_sense_clarification": "清除缓存或缓冲区"
                            },
                            {
                                "target_lang_word": "刷新",
                                "target_lang_sense_clarification": "指清除并更新数据"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "359346b8-c66d-3b2e-83b3-3bbe7fdc3118",
                    "sense_definition": "The act of cleaning a toilet with a sudden flow of water, or the mechanism used to do this.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>flush</w> on this toilet is broken and needs to be repaired.",
                            "target_lang_translations": {
                                "ru": "<w>Смыв</w> в этом туалете сломан, и его нужно починить.",
                                "zh": "这个马桶的<w>冲水装置</w>坏了，需要修理。"
                            }
                        },
                        {
                            "text": "With a loud <w>flush</w>, the water swirled away down the drain.",
                            "target_lang_translations": {
                                "ru": "С громким <w>сливом</w> вода устремилась в канализацию.",
                                "zh": "伴随着一声响亮的<w>冲水</w>声，水旋转着流进了下水道。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "toilet flush",
                        "give it a flush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие смыва воды в туалете или механизм, используемый для этого.",
                        "zh": "指冲洗厕所的动作或相关装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смыв",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "слив",
                                "target_lang_sense_clarification": "механизм или действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲水",
                                "target_lang_sense_clarification": "冲洗动作"
                            },
                            {
                                "target_lang_word": "冲水装置",
                                "target_lang_sense_clarification": "指冲厕所的机械结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f4ed35a-b4cf-32b9-ab60-f7d66f0ea87d",
                    "sense_definition": "A hand in card games, such as poker, where all cards are of the same suit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He won the game because he held a royal <w>flush</w>.",
                            "target_lang_translations": {
                                "ru": "Он выиграл игру, потому что у него был роял-<w>флеш</w>.",
                                "zh": "他赢了比赛，因为他拿到了皇家<w>同花</w>。"
                            }
                        },
                        {
                            "text": "I was hoping for a heart to complete my <w>flush</w>.",
                            "target_lang_translations": {
                                "ru": "Я надеялся на черву, чтобы собрать свой <w>флеш</w>.",
                                "zh": "我当时希望能来一张红桃来凑齐我的<w>同花</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "royal flush",
                        "straight flush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Комбинация в карточных играх (например, в покере), где все карты одной масти.",
                        "zh": "指扑克牌中所有牌花色相同的组合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "флеш",
                                "target_lang_sense_clarification": "комбинация в покере"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同花",
                                "target_lang_sense_clarification": "扑克牌术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9710b1d9-90ad-359b-a057-e4df22c4a011",
                    "sense_definition": "A red color that appears on someone's face because of emotion, heat, or illness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "redness_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>flush</w> of embarrassment crept up her neck when she realized her mistake.",
                            "target_lang_translations": {
                                "ru": "<w>Краска</w> смущения поползла по её шее, когда она осознала свою ошибку.",
                                "zh": "当她意识到自己的错误时，一阵尴尬的<w>潮红</w>爬上了她的脖子。"
                            }
                        },
                        {
                            "text": "The <w>flush</w> on his cheeks showed that he had been running hard.",
                            "target_lang_translations": {
                                "ru": "<w>Румянец</w> на его щеках показывал, что он быстро бежал.",
                                "zh": "他脸上的<w>红晕</w>显示他刚才跑得很卖力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hot flush",
                        "flush of anger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Красный цвет, появляющийся на чьем-то лице из-за эмоций, жары или болезни.",
                        "zh": "指因情绪、高温或疾病而在脸上出现的红色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "румянец",
                                "target_lang_sense_clarification": "на щеках"
                            },
                            {
                                "target_lang_word": "краска",
                                "target_lang_sense_clarification": "покраснение лица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "红晕",
                                "target_lang_sense_clarification": "脸上的红色"
                            },
                            {
                                "target_lang_word": "潮红",
                                "target_lang_sense_clarification": "因生理或情绪引起的脸部发红"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8275999-6f63-339d-9762-0362fb7805da",
                    "sense_definition": "A sudden strong feeling or rush of emotion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "redness_emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden <w>flush</w> of joy when she heard the good news.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала внезапный <w>прилив</w> радости, когда услышала хорошие новости.",
                                "zh": "听到好消息时，她感到一阵<w>涌现</w>的喜悦。"
                            }
                        },
                        {
                            "text": "In the first <w>flush</w> of romance, everything seemed absolutely perfect.",
                            "target_lang_translations": {
                                "ru": "В первом <w>приливе</w> романтики всё казалось абсолютно идеальным.",
                                "zh": "在恋爱的最初<w>一阵</w>甜蜜中，一切看起来都完美无缺。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "first flush",
                        "flush of success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное сильное чувство или прилив эмоций.",
                        "zh": "指突然涌现的强烈情感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилив",
                                "target_lang_sense_clarification": "чувств, эмоций"
                            },
                            {
                                "target_lang_word": "порыв",
                                "target_lang_sense_clarification": "внезапное чувство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涌现",
                                "target_lang_sense_clarification": "指情感的突然爆发"
                            },
                            {
                                "target_lang_word": "一阵",
                                "target_lang_sense_clarification": "指情感的短暂爆发"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4cf062a3-597a-3cd1-aa45-baae9ee60c79",
                    "sense_definition": "Completely level or even with another surface, not sticking out.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "alignment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the screw head is <w>flush</w> with the wood surface so it is smooth.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что головка винта находится <w>вровень</w> с поверхностью дерева, чтобы она была гладкой.",
                                "zh": "确保螺丝头与木材表面<w>齐平</w>，这样表面才会平滑。"
                            }
                        },
                        {
                            "text": "The door sits <w>flush</w> with the frame when it is closed properly.",
                            "target_lang_translations": {
                                "ru": "Дверь стоит <w>заподлицо</w> с рамой, когда она закрыта правильно.",
                                "zh": "门关好后与门框<w>齐平</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "justified"
                    ],
                    "common_phrases": [
                        "flush with",
                        "flush against"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся на одном уровне с другой поверхностью, не выступающий.",
                        "zh": "指与另一表面齐平，不突出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вровень",
                                "target_lang_sense_clarification": "на одном уровне"
                            },
                            {
                                "target_lang_word": "заподлицо",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "齐平",
                                "target_lang_sense_clarification": "处于同一水平面"
                            },
                            {
                                "target_lang_word": "平齐",
                                "target_lang_sense_clarification": "与表面一致"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e860292d-7f96-31d3-853d-649a03cb1acb",
                    "sense_definition": "Having a large amount of money, usually temporarily.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>flush</w> with cash after winning the lottery last week.",
