                "senses": [
                    {
                        "sense_id": "46005a36-116c-3281-be3b-0ab4c62ffa42",
                        "entry_id": "d5131fb7-fbc0-3edc-be45-e6d9bb8a1774",
                        "glosses": [
                            "Kleidung, die man (typischerweise) beim Laufen trägt"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "8520853d-3984-4269-b648-becda5ec3e4d",
                                "sense_id": "46005a36-116c-3281-be3b-0ab4c62ffa42",
                                "text": "„Mit trendigem, farbenfrohem und funktionalem Laufoutfit kann die winterliche Laufsaison kommen.“"
                            },
                            {
                                "example_id": "24fb9678-f880-474d-b15a-06ed2d3b31c9",
                                "sense_id": "46005a36-116c-3281-be3b-0ab4c62ffa42",
                                "text": "„Bei dem Staffellauf gibt es keinen Dresscode, so dass sich jede Mannschaft auch gern ein eigenes Laufoutfit entwerfen und nutzen kann.“"
                            },
                            {
                                "example_id": "95ebd946-b231-454e-9b5d-83524c789665",
                                "sense_id": "46005a36-116c-3281-be3b-0ab4c62ffa42",
                                "text": "„Österreichs schnellste Läufer, die in ihrem Alltag zwischen Uniform und Laufoutfit hin und her wechseln, spekulieren bei den Polizei-Europameisterschaften im Marathon, eingebettet in den Eindhoven Marathon, mit Edelmetall in der Nationenwertung.“"
                            },
                            {
                                "example_id": "a84ff9c6-e014-4350-931e-78213dcaac6b",
                                "sense_id": "46005a36-116c-3281-be3b-0ab4c62ffa42",
                                "text": "„Aber auch ein tolles neues Laufoutfit, eine coole Sicherheitsweste, ein neues Paar Laufschuhe oder eine Laufuhr kann Anreiz für zusätzliches Training sein.“"
                            },
                            {
                                "example_id": "d738560c-5ec0-4b98-bb0d-d786aabc5a62",
                                "sense_id": "46005a36-116c-3281-be3b-0ab4c62ffa42",
                                "text": "„Um die Bemühungen um die ausgefallenen Laufoutfits zu belohnen, werden bei der Siegerehrung nicht nur die jeweils drei besten Läuferinnen und Läufer ausgezeichnet, sondern stets die schönste oder ausgefallenste Verkleidung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
