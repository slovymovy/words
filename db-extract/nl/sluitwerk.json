                                                "example_id": "1369d093-c84e-4af4-8cd8-8c2bbdba1ca6",
                                                "sense_id": "f48ddcc6-4827-3eaa-ae7b-f8dbaf56197d",
                                                "text": "to find emotional closure"
                                            },
                                            {
                                                "example_id": "c23397d0-d228-42f7-8077-af97ddb82f88",
                                                "sense_id": "f48ddcc6-4827-3eaa-ae7b-f8dbaf56197d",
                                                "text": "In Israel, a state commission of inquiry is not merely a judicial instrument or a means of settling facts. It’s a ritual of national closure that allows people to put events in order and move on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0c173fe-d2ca-30f3-9f6b-31b1bf677a5b",
