                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e7d7d178-9e97-4d03-9ed3-630a36cc82ee",
                        "entry_id": "a8842660-01b7-3a13-bc5e-c0cc2d6d8c02",
                        "tags": [
                            "plural"
                        ],
                        "form": "hyperesthésies"
