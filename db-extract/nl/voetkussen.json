                "senses": [
                    {
                        "sense_id": "edb19780-b7cd-351f-801a-79ce20d15739",
                        "entry_id": "cc12bfbc-4f23-3e09-bf98-4c941c095827",
                        "glosses": [
                            "zacht deel aan de onderkant van de poot van een hond of kat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4aeff2d-3e6d-4ddc-bf04-80fc9aa563f5",
                                "sense_id": "edb19780-b7cd-351f-801a-79ce20d15739",
                                "text": "De Catalaanse herder Diesel moet een voetkussentje missen. Zijn rechterpoot zit nog maanden in het verband. Misschien kan de hond nooit meer lopen door een beet van het 'monster'."
                            },
                            {
                                "example_id": "a9c42b4b-8d09-460f-9782-8e3a2c58cd93",
                                "sense_id": "edb19780-b7cd-351f-801a-79ce20d15739",
                                "text": "Voetkussentjes van honden bevatten zweetklieren die een duidelijke geur afscheiden. Door achteruit te graven, verspreiden zij hun geur. Voor katten geldt juist het tegenovergestelde: zij graven een kuil, doen daar hun behoefte in en dekken deze vervolgens weer af zodat een prooi niet ruikt dat ze in de buurt zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "930aca26-6fc5-3717-a24f-c85d9e8a50a5",
                        "entry_id": "cc12bfbc-4f23-3e09-bf98-4c941c095827",
                        "glosses": [
                            "een kussen waarop de voet kan rusten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f94bbfca-c875-4654-8e38-d1e7f684e138",
                                "sense_id": "930aca26-6fc5-3717-a24f-c85d9e8a50a5",
                                "text": "Een voetkussen in de boot dat in verbinding staat met het aggregaat dient als extra beveiliging. Haalt de visser zijn voet er vanaf dan valt het apparaat stil. De apparatuur moet sinds 1984, toen subsidie van het ministerie mogelijk werd aan strenge eisen voldoen."
                            }
                        ]
                    }
                ],
