                        "translation_id": "cb5867f4-323f-4113-a471-39f098bb9118",
                        "source_entry_id": "62277fd5-0b9b-3cf1-987b-562c41519c80",
                        "source_sense_id": "966e50ae-6376-3c1b-b184-99e53e9624f3",
                        "target_lang_word": "decease",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                                        "entry_id": "3651deaa-168a-3f75-b992-98bfde8ddfc0",
                                        "glosses": [
                                            "Death, departure from life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbb31956-a75c-44b8-854f-9050943038cc",
                                                "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                                                "text": "So should that beauty which you hold in lease\nFind no determination: then you were\nYourself again after yourself's decease […]"
                                            },
                                            {
                                                "example_id": "fd4bf109-db3a-447b-9ea4-06e54bd0a7c1",
                                                "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                                                "text": "I thought about my predecessor, who had died of drink and smoke; and I could have wished he had been so good as to live, and not bother me with his decease."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7becba34-b32c-3c8d-a02a-f58f806af582",
                                        "entry_id": "d49cd7b5-51c5-3104-8a7e-534a158e05a6",
                                        "glosses": [
                                            "To die."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4740ce84-1841-4e5f-a67b-7154d3782fcc",
                                                "sense_id": "7becba34-b32c-3c8d-a02a-f58f806af582",
                                                "text": "After which usurped victorie, he presently deceased: and partly through the excessive joy he thereby conceived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e73d6b95-b247-32bf-9276-fdf72cc7bd06",
                                        "entry_id": "d49cd7b5-51c5-3104-8a7e-534a158e05a6",
                                        "glosses": [
                                            "To cause to die."
                                        ],
                                        "tags": [
                                            "formal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
