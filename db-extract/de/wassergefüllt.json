                ],
                "senses": [
                    {
                        "sense_id": "6cc2929a-be3b-318e-a4aa-1bfafef519b4",
                        "entry_id": "10260175-9ada-3f85-bd31-3e94648e70ea",
                        "glosses": [
                            "mit Wasser gefüllt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d85dab86-3126-42a5-9ea5-d09dc82d5f8f",
                                "sense_id": "6cc2929a-be3b-318e-a4aa-1bfafef519b4",
                                "text": "„Ich begann zu begreifen, was einige von Klenzes Launen verursacht hatte, denn als ich dem Tempel näher und immer näher kam, fürchtete ich seine wassergefüllten Abgründe mit blindem und wachsendem Grauen.“"
                            },
                            {
                                "example_id": "1ea71ebd-bdce-4804-bbd2-1c285022695d",
                                "sense_id": "6cc2929a-be3b-318e-a4aa-1bfafef519b4",
                                "text": "„Und eine Jungfrau mit wassergefülltem Marmorkrug stieg aus dem lebenden Fries, die wiedererlangten Augen mit schwarzer Pupille und hellschillernder meerblauer Iris, und strebte lächelnd dem Träumer zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
