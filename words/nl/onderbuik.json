    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a89a86f7-4c8c-3d11-bb3a-1063443413a9",
                    "sense_definition": "Het onderste gedeelte van de buik, het dichtst bij de benen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jongen zei tegen de dokter dat de pijn in zijn <w>onderbuik</w> zat.",
                            "target_lang_translations": {
                                "en": "The boy told the doctor that the pain was in his <w>lower abdomen</w>."
                            }
                        },
                        {
                            "text": "Na het sporten voelde zij een lichte kramp in haar <w>onderbuik</w>.",
                            "target_lang_translations": {
                                "en": "After exercising, she felt a slight cramp in her <w>lower belly</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "bovenbuik"
                    ],
                    "common_phrases": [
                        "pijn in de onderbuik"
                    ],
                    "target_lang_definitions": {
                        "en": "The lower part of the abdomen, closest to the legs."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lower abdomen",
                                "target_lang_sense_clarification": "anatomical region"
                            },
                            {
                                "target_lang_word": "lower belly",
                                "target_lang_sense_clarification": "informal anatomical region"
                            },
                            {
                                "target_lang_word": "abdomen",
                                "target_lang_sense_clarification": "general medical term"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d3ca150-9a42-37e9-a09c-3977b2a9f8c7",
                    "sense_definition": "De zetel van irrationele, instinctieve emoties, vooroordelen en onderbuikgevoelens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieke partij probeert het sentiment in de <w>onderbuik</w> van de kiezers aan te spreken.",
                            "target_lang_translations": {
                                "en": "The political party tries to appeal to the <w>gut feelings</w> of the voters."
                            }
                        },
                        {
                            "text": "Beslissingen die puur vanuit de <w>onderbuik</w> worden genomen, zijn niet altijd rationeel.",
                            "target_lang_translations": {
                                "en": "Decisions made purely from the <w>gut</w> are not always rational."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderbuikgevoel",
                        "instinct"
                    ],
                    "common_phrases": [
                        "stemmen uit de onderbuik",
                        "reageren vanuit de onderbuik"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in politieke en maatschappelijke discussies"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The seat of irrational, instinctive emotions, prejudices, and gut feelings."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gut",
                                "target_lang_sense_clarification": "as the source of instinct or raw emotion"
                            },
                            {
                                "target_lang_word": "gut feeling",
                                "target_lang_sense_clarification": "instinctive reaction"
                            },
                            {
                                "target_lang_word": "underbelly",
                                "target_lang_sense_clarification": "figurative, referring to base instincts or public sentiment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d3bdf6e-9d59-3f29-83b7-7c36f99a910d",
                    "sense_definition": "Een kwetsbare plek of zwakke zijde van iets of iemand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdediging van het team bleek de zwakke <w>onderbuik</w> van de hele opstelling te zijn.",
                            "target_lang_translations": {
                                "en": "The team's defense turned out to be the soft <w>underbelly</w> of the entire lineup."
                            }
                        },
                        {
                            "text": "Hij heeft een zwakke plek, een <w>onderbuik</w>, voor honden.",
                            "target_lang_translations": {
                                "en": "He has a <w>soft spot</w> for dogs."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwakke plek",
                        "achilleshiel"
                    ],
                    "common_phrases": [
                        "de zwakke onderbuik"
                    ],
                    "target_lang_definitions": {
                        "en": "A vulnerable spot or weak side of someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "soft underbelly",
                                "target_lang_sense_clarification": "vulnerable point of an organization or defense"
                            },
                            {
                                "target_lang_word": "weak spot",
                                "target_lang_sense_clarification": "vulnerability"
                            },
                            {
                                "target_lang_word": "Achilles' heel",
                                "target_lang_sense_clarification": "fatal weakness"
                            }
                        ]
                    }
                }
            ]
        }
    ]
