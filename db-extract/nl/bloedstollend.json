                        "form": "bloedstollenders"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6622099-3213-3902-837b-60498bb98fe2",
                        "entry_id": "17742843-17cb-36df-bcf7-721d1fc05daa",
                        "glosses": [
                            "waardoor bloed gaat klonteren en een korst vormt (om verder bloedverlies te voorkomen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c30b9d-373f-4d1e-9bbb-3db170e4099b",
                                "sense_id": "c6622099-3213-3902-837b-60498bb98fe2",
                                "text": "Aan die koolstofbelletjes hecht tranexaminezuur, een bloedstollend middel, zich eenvoudig en kan zo de inwendige wond bereiken."
                            }
                        ]
                    },
                    {
                        "sense_id": "3753a65e-f4e3-3af3-87ec-504fa990a70c",
                        "entry_id": "17742843-17cb-36df-bcf7-721d1fc05daa",
                        "glosses": [
                            "angstaanjagend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c532b07f-dbb2-473f-a2d0-b3e3c0995ea3",
                                "sense_id": "3753a65e-f4e3-3af3-87ec-504fa990a70c",
                                "text": "Een bloedstollend ingrediënt van dat mengsel is het beeld van wreedheid, hardheid, genadeloze rechtvaardigheid (…)"
                            },
                            {
                                "example_id": "03f84e48-80a7-40ed-82ef-05bfc8132245",
                                "sense_id": "3753a65e-f4e3-3af3-87ec-504fa990a70c",
                                "text": "Bloedstollend denkbeeld; hij zal er niet zijn!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c932e08b-67f6-3012-af14-1038ad4cbd8b",
                        "entry_id": "17742843-17cb-36df-bcf7-721d1fc05daa",
                        "glosses": [
                            "heel spannend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eef2909-76b5-46f3-8ef1-397d800239f2",
                                "sense_id": "c932e08b-67f6-3012-af14-1038ad4cbd8b",
                                "text": "In deze spannende roman brengt Annie Degroote een bloedstollend verhaal over de dappere Flore die tegen alle vooroordelen van haar tijd in kiest voor de liefde en de vrijheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e7512df-d7da-3922-bbd1-79c476a8c71b",
                        "entry_id": "17742843-17cb-36df-bcf7-721d1fc05daa",
                        "glosses": [
                            "heel erg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58aa387d-2a94-4eae-b3fb-8b8c5bd6f1f1",
                                "sense_id": "9e7512df-d7da-3922-bbd1-79c476a8c71b",
                                "text": "En laat het nu net in deze afwisseling van bezettingen en dus klankidiomen zijn, dat de kracht van dit bijwijlen bloedstollend mooie album ligt."
                            }
                        ]
                    }
                ],
