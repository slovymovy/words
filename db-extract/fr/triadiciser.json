                "senses": [
                    {
                        "sense_id": "aa3ae05c-43b7-3139-8daf-831e9a87b8d9",
                        "entry_id": "27ddd8b7-1608-3a42-8ce0-7c4ef5735826",
                        "glosses": [
                            "Donner un caractère triadique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "639fac30-6dd9-4ac5-85ce-b92b7fa6a51d",
                                "sense_id": "aa3ae05c-43b7-3139-8daf-831e9a87b8d9",
                                "text": "L’acte de la communication jouée — une secondéité — sera triadicisé de la façon suivante : R est le répertoire, décodage potentiel pour l’encodage et encodage potentiel pour le décodage."
                            },
                            {
                                "example_id": "499ea96e-0477-4a84-90fb-5206f057a03f",
                                "sense_id": "aa3ae05c-43b7-3139-8daf-831e9a87b8d9",
                                "text": "Nous ne pouvons pas triadiciser le deux."
                            },
                            {
                                "example_id": "6553ec3c-908d-4ec5-8dcb-a889d0450491",
                                "sense_id": "aa3ae05c-43b7-3139-8daf-831e9a87b8d9",
                                "text": "Je suis donc allé regarder toute cette histoire de très près et j'ai essayé de triadiciser."
                            }
                        ]
                    }
