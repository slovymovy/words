{
    "word_family": [
        "hypothesis",
        "hypothesize",
        "hypothetically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8302f6a9-c28e-3e67-9952-0fd5200fa203",
                    "sense_definition": "Based on a hypothesis or theory rather than on facts or reality",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "theoretical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist discussed a <w>hypothetical</w> scenario where the earth has two moons.",
                            "target_lang_translations": {
                                "ru": "Ученый обсудил <w>гипотетический</w> сценарий, в котором у Земли две луны."
                            }
                        },
                        {
                            "text": "We are just talking about a <w>hypothetical</w> situation to see what might happen.",
                            "target_lang_translations": {
                                "ru": "Мы просто обсуждаем <w>гипотетическую</w> ситуацию, чтобы посмотреть, что может произойти."
                            }
                        }
                    ],
                    "synonyms": [
                        "conjectural",
                        "theoretical",
                        "supposed"
                    ],
                    "antonyms": [
                        "actual"
                    ],
                    "common_phrases": [
                        "hypothetical situation",
                        "hypothetical question",
                        "purely hypothetical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на гипотезе или теории, а не на фактах или реальности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипотетический",
                                "target_lang_sense_clarification": "основанный на предположении"
                            },
                            {
                                "target_lang_word": "предположительный",
                                "target_lang_sense_clarification": "допускаемый"
                            },
                            {
                                "target_lang_word": "теоретический",
                                "target_lang_sense_clarification": "не подтвержденный практикой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e44cab5e-9e07-39fe-8fda-0d5590dfa64c",
                    "sense_definition": "Dependent on a certain condition or antecedent; conditional",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theoretical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In logic, a <w>hypothetical</w> proposition is one that takes the form of if-then.",
                            "target_lang_translations": {
                                "ru": "В логике <w>условное</w> суждение — это суждение, принимающее форму «если-то»."
                            }
                        },
                        {
                            "text": "The <w>hypothetical</w> nature of the agreement means it only applies if the merger occurs.",
                            "target_lang_translations": {
                                "ru": "<w>Условный</w> характер соглашения означает, что оно вступает в силу только в случае слияния."
                            }
                        }
                    ],
                    "synonyms": [
                        "conditional",
                        "contingent"
                    ],
                    "antonyms": [
                        "categorical"
                    ],
                    "common_phrases": [
                        "hypothetical proposition",
                        "hypothetical syllogism"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in logic or philosophy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зависящий от определенного условия; условный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "условный",
                                "target_lang_sense_clarification": "действующий при наличии условий"
                            },
                            {
                                "target_lang_word": "гипотетический",
                                "target_lang_sense_clarification": "в логике и философии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "375319c5-73b6-3816-b74b-8b24efaa057a",
                    "sense_definition": "A possible situation or statement that is imagined rather than known to be true",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer asked the witness to consider a <w>hypothetical</w> regarding the accident.",
                            "target_lang_translations": {
                                "ru": "Адвокат попросил свидетеля рассмотреть <w>гипотетический случай</w>, касающийся аварии."
                            }
                        },
                        {
                            "text": "Let us deal with facts instead of wasting time on a <w>hypothetical</w>.",
                            "target_lang_translations": {
                                "ru": "Давайте иметь дело с фактами, а не тратить время на <w>предположения</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "supposition",
                        "assumption"
                    ],
                    "common_phrases": [
                        "deal in hypotheticals",
                        "give a hypothetical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможная ситуация или утверждение, которое является воображаемым, а не истинным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипотетический случай",
                                "target_lang_sense_clarification": "воображаемая ситуация"
                            },
                            {
                                "target_lang_word": "предположение",
                                "target_lang_sense_clarification": "допущение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
