                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e953a70-642c-4f1e-978d-a25e8c4f8d04",
                                "sense_id": "491951f7-b755-3aa0-9dae-875e619e2807",
                                "text": "Elke deal met PSA zou de vrees voor bezuinigingen op de productie in het Verenigd Koninkrijk en verder banenverlies doen toenemen, wat een grote klap betekent voor de toch al worstelende auto-industrie in Engeland. PSA, dat al eigenaar is van de Britse autofabrikant Vauxhall, is voor 14 procent in handen van de Franse overheid."
                            },
                            {
                                "example_id": "393b8381-c00e-4df3-b9a8-62e093e06ad4",
                                "sense_id": "491951f7-b755-3aa0-9dae-875e619e2807",
                                "text": "De innovatierace onder autofabrikanten lijkt vooral te leiden tot hoofdpijn bij autokopers. Onder storingen in multimediasystemen vallen problemen met audio, communicatie, entertainment en navigatie. BMW, Fiat en Audi scoren qua storingen het slechtst, terwijl Peugeot en Skoda als beste uit de bus komen."
                            }
                        ]
                    }
