                        "entry_id": "7c1f2fe0-b1b7-3496-b175-d641506fe4de",
                        "glosses": [
                            "Sorte de machine à vapeur, puis ensuite à moteur à combustion interne, qui se déplace et qui servait à l’agriculture ou à l’industrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3063dfe-8e32-43ff-983f-ef2b224548dd",
                                "sense_id": "b59b30ff-f458-3f4a-9685-4cfa1e8881b0",
                                "text": "Les locomobiles de la force de 4 à 5 chevaux ont un poids qui atteint déjà 2000 kilogrammes."
                            },
                            {
                                "example_id": "afeb6208-7f0c-4d53-87e0-ba988252293a",
                                "sense_id": "b59b30ff-f458-3f4a-9685-4cfa1e8881b0",
                                "text": "Il fit entrer les fourches fines, les pelles minces, les binettes robustes dans la chaudière et la cheminée d’une malheureuse locomobile."
                            }
                        ]
                    }
