    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d9b5254-1dbd-3af5-9f03-3c2d1e2aca05",
                    "sense_definition": "Relating to the present or recent times as opposed to the remote past.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "contemporary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The building has a very <w>modern</w> look despite being several centuries old.",
                            "target_lang_translations": {
                                "ru": "Здание выглядит очень <w>современным</w>, несмотря на то, что ему несколько веков."
                            }
                        },
                        {
                            "text": "In <w>modern</w> times, most people rely on smartphones for daily communication.",
                            "target_lang_translations": {
                                "ru": "В <w>современные</w> времена большинство людей полагаются на смартфоны для повседневного общения."
                            }
                        }
                    ],
                    "synonyms": [
                        "contemporary",
                        "current",
                        "present"
                    ],
                    "antonyms": [
                        "ancient",
                        "old",
                        "past",
                        "old-fashioned"
                    ],
                    "common_phrases": [
                        "modern times",
                        "modern world",
                        "modern technology",
                        "modern art"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к настоящему или недавнему времени, в отличие от далекого прошлого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "современный",
                                "target_lang_sense_clarification": "относящийся к текущему времени или стилю"
                            },
                            {
                                "target_lang_word": "новейший",
                                "target_lang_sense_clarification": "самый последний, актуальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d3ea297-3371-32a7-a37a-45a537bde823",
                    "sense_definition": "Relating to the historical period from approximately 1800 to the present day.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "historical_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students in the <w>modern</w> history course study the industrial revolution and its effects.",
                            "target_lang_translations": {
                                "ru": "Студенты на курсе <w>новой</w> истории изучают промышленную революцию и её последствия."
                            }
                        },
                        {
                            "text": "The museum features an extensive collection of <w>modern</w> era artifacts.",
                            "target_lang_translations": {
                                "ru": "В музее представлена обширная коллекция артефактов <w>современной</w> эпохи."
                            }
                        }
                    ],
                    "antonyms": [
                        "premodern",
                        "historical",
                        "former"
                    ],
                    "common_phrases": [
                        "modern history",
                        "modern era"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к историческому периоду примерно с 1800 года по настоящее время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "современный",
                                "target_lang_sense_clarification": "относящийся к истории последних веков"
                            },
                            {
                                "target_lang_word": "нового времени",
                                "target_lang_sense_clarification": "относящийся к эпохе после Средневековья"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2679b184-f41f-3a60-8716-483203d7951a",
                    "sense_definition": "A person who lives in or belongs to the current era or recent times.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>moderns</w> often find it difficult to imagine life without electricity.",
                            "target_lang_translations": {
                                "ru": "Нам, <w>современникам</w>, часто трудно представить жизнь без электричества."
                            }
                        },
                        {
                            "text": "The author compares the values of the ancients with those of the <w>moderns</w>.",
                            "target_lang_translations": {
                                "ru": "Автор сравнивает ценности древних с ценностями <w>людей нашего времени</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "ancient"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, живущий в нынешнюю эпоху или принадлежащий к недавнему времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "современник",
                                "target_lang_sense_clarification": "человек нынешней эпохи"
                            },
                            {
                                "target_lang_word": "люди нашего времени",
                                "target_lang_sense_clarification": "представители нынешнего поколения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}