                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e60cd9e-76b3-473c-9352-5dd44e6b9ceb",
                        "source_entry_id": "eacc9ebc-c5bf-3717-a4fd-1705a6c99361",
                        "source_sense_id": "96150883-9288-39e0-a685-b93c72f486d5",
                        "target_lang_word": "Gebot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "161a8c13-fb4a-3e7f-af77-e0d2ea85d814",
                                        "entry_id": "d9141f3a-21db-3f1d-a0f9-2d118b65afa7",
                                        "glosses": [
                                            "Verpflichtung oder Anweisung"
                                        ],
                                        "tags": [
                                            "Ethik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2892d3bf-25bc-4296-94a4-21571f27198c",
                                                "sense_id": "161a8c13-fb4a-3e7f-af77-e0d2ea85d814",
                                                "text": "Die Zehn Gebote des Juden- und Christentums sind verpflichtend."
                                            },
                                            {
                                                "example_id": "edad07ff-f1ed-4da7-9130-f165326ee8e6",
                                                "sense_id": "161a8c13-fb4a-3e7f-af77-e0d2ea85d814",
                                                "text": "„Fußball ist keine Religion, da seine Regeln nicht auf übermenschliche Gebote zurückgehen.“"
                                            },
                                            {
                                                "example_id": "97091712-a72c-4257-b5f0-4918187240d5",
                                                "sense_id": "161a8c13-fb4a-3e7f-af77-e0d2ea85d814",
                                                "text": "„Für fromme Juden ist dieser Zwang im Fruchtbarkeitsgebot der Bibel begründet, für Perez aber wird die Einhaltung des Gebotes zum Stoff der Satire.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "27907e20-37ec-3b46-a9e2-ebc773a90e53",
                                        "entry_id": "d9141f3a-21db-3f1d-a0f9-2d118b65afa7",
                                        "glosses": [
                                            "Erfordernis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af8bd9d-a7bd-4195-af8a-400c9c12bdab",
                                                "sense_id": "27907e20-37ec-3b46-a9e2-ebc773a90e53",
                                                "text": "Es ist ein Gebot der Stunde, Mitgefühl zu zeigen."
                                            },
                                            {
                                                "example_id": "f000adc6-2c91-444f-a6e1-d0d4af375791",
                                                "sense_id": "27907e20-37ec-3b46-a9e2-ebc773a90e53",
                                                "text": "„Da die uns zu Gebote stehenden Züge zahlreich und dabei von ungleichem Wert sind, ist es natürlich sehr leicht möglich, dieses oder jenes zu übersehen; in neun Fällen unter zehn wird der Spieler, der seine Gedanken vollkommen zu konzentrieren versteht, selbst über den geschickteren Gegner den Sieg davontragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fad61780-c47f-3afa-8b40-6c9278e35c1d",
                                        "entry_id": "d9141f3a-21db-3f1d-a0f9-2d118b65afa7",
                                        "glosses": [
                                            "Kaufangebot bei einer Auktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "736739c3-ddf1-440e-8087-602673abf91a",
                                                "sense_id": "fad61780-c47f-3afa-8b40-6c9278e35c1d",
                                                "text": "Sie sollten jetzt ein höheres Gebot abgeben, wenn sie die Vase wirklich für die Sammlung erwerben wollen."
                                            },
                                            {
                                                "example_id": "e1cddcc8-2e68-4095-b4fb-7479a487e805",
                                                "sense_id": "fad61780-c47f-3afa-8b40-6c9278e35c1d",
                                                "text": "„Es sei ein neues Gebot eingegangen, noch immer unter unserer Preisforderung, aber besser als das vorige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5668b07-9e86-40d6-8d33-468dfa94ce5e",
                        "source_entry_id": "eacc9ebc-c5bf-3717-a4fd-1705a6c99361",
                        "source_sense_id": "96150883-9288-39e0-a685-b93c72f486d5",
                        "target_lang_word": "commandment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commandment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "430fde33-b879-38e9-93c3-19b4fadf693b",
                                        "entry_id": "33aa3709-efc9-3b9a-9723-8564a6b2a9fd",
                                        "glosses": [
                                            "A divinely ordained command, especially one of the Ten Commandments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96a1f681-1d76-4903-81b4-bd2203e2add4",
                                                "sense_id": "430fde33-b879-38e9-93c3-19b4fadf693b",
                                                "text": "A new commandement I giue vnto you, That yee loue one another, as I haue loued you, that yee alſo loue one another."
                                            },
                                            {
                                                "example_id": "2c2aa9b1-fc47-45f8-83e5-03db0aa5121d",
                                                "sense_id": "430fde33-b879-38e9-93c3-19b4fadf693b",
                                                "text": "But besides having the bent of the affections towards Him, and desiring His favour, His near presence with us, there is that great rule of His, “This is love, that we walk after His commandments.”"
                                            },
                                            {
                                                "example_id": "6c8c7e02-62dc-483f-963b-db26e051a7c1",
                                                "sense_id": "430fde33-b879-38e9-93c3-19b4fadf693b",
                                                "text": "Even those commandments which have a rational basis are kept by Jews only because that is God's will (Aruch HaShulchan). This lesson is encapsulated in the story of Dama ben Nesina."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f092f7d7-226c-3b5c-9a2a-3c4abe1d019b",
                                        "entry_id": "33aa3709-efc9-3b9a-9723-8564a6b2a9fd",
                                        "glosses": [
                                            "Something that must be obeyed; a command or edict."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "humorous",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9e78708-0d03-47b3-b521-a5dc83a72323",
                                                "sense_id": "f092f7d7-226c-3b5c-9a2a-3c4abe1d019b",
                                                "text": "Pau. Pray you then, / Conduct me to the Queene. / Gao. I may not (Madam) / To the contrary I haue expreſſe commandment."
                                            },
                                            {
                                                "example_id": "5f1f122a-7ae2-4480-9e12-8dcda96d26d6",
                                                "sense_id": "f092f7d7-226c-3b5c-9a2a-3c4abe1d019b",
                                                "text": "The HIG delivers Apple's design commandments, the company's definition of what it means to be a good iPhone citizen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57395324-d09c-3862-898e-e6473df73149",
                                        "entry_id": "33aa3709-efc9-3b9a-9723-8564a6b2a9fd",
                                        "glosses": [
                                            "The offence of commanding or inducing another to violate the law."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8480baa-6b91-318b-bd12-2ba70a3a0f7b",
                                        "entry_id": "33aa3709-efc9-3b9a-9723-8564a6b2a9fd",
                                        "glosses": [
                                            "The act of commanding; exercise of authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7947b0ae-b4b5-4d9d-ba57-f0a90c3c3ad2",
                                                "sense_id": "a8480baa-6b91-318b-bd12-2ba70a3a0f7b",
                                                "text": "To rule, is vnderſtoode to haue the higheſt and ſupreme authoritie of commaundement."
                                            },
                                            {
                                                "example_id": "4bfa0d0a-0279-4884-9bb0-fa876579571e",
                                                "sense_id": "a8480baa-6b91-318b-bd12-2ba70a3a0f7b",
                                                "text": "Speake you ſo gently? Pardon me I pray you, / I thought that all things had bin ſauage heere, / And therefore put I on the countenance / Of ſterne command'ment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "687077c2-ca54-4489-9a51-c7edab4b0bb1",
                        "source_entry_id": "eacc9ebc-c5bf-3717-a4fd-1705a6c99361",
                        "source_sense_id": "96150883-9288-39e0-a685-b93c72f486d5",
                        "target_lang_word": "commandement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commandement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f96dcb91-c2e1-331d-8473-256bfc5c333f",
                                        "entry_id": "79d06e08-e153-32e7-af3e-82739628c7d8",
                                        "glosses": [
                                            "Ordre que donne celui qui a pouvoir de commander."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9293100f-1491-4a4f-8308-e15517b72873",
                                                "sense_id": "f96dcb91-c2e1-331d-8473-256bfc5c333f",
                                                "text": "Commandement par écrit."
                                            },
                                            {
                                                "example_id": "0f1507b1-056f-4f4c-a9cf-35086166fa2e",
                                                "sense_id": "f96dcb91-c2e1-331d-8473-256bfc5c333f",
                                                "text": "Il a fait cela par votre commandement."
                                            },
                                            {
                                                "example_id": "505b0f77-cef5-4faa-b6d5-9e8f340dfd43",
                                                "sense_id": "f96dcb91-c2e1-331d-8473-256bfc5c333f",
                                                "text": "J’obéis à vos commandements."
                                            },
                                            {
                                                "example_id": "28b1e938-e4ed-4829-becd-ad07ad68cfb9",
                                                "sense_id": "f96dcb91-c2e1-331d-8473-256bfc5c333f",
                                                "text": "Commandement verbal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bbf3b58-3745-307b-b71b-e9b0660c20ed",
                                        "entry_id": "79d06e08-e153-32e7-af3e-82739628c7d8",
                                        "glosses": [
                                            "Tout ordre bref qu’on donne à haute voix pour faire exécuter certains mouvements, certaines manœuvres."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "588ad1b1-067c-4f48-bea5-66c26517fd3d",
                                                "sense_id": "1bbf3b58-3745-307b-b71b-e9b0660c20ed",
                                                "text": "Au commandement de… vous ferez telle chose."
                                            },
                                            {
                                                "example_id": "920d63c6-186f-4b0f-ad5a-29936b412c82",
                                                "sense_id": "1bbf3b58-3745-307b-b71b-e9b0660c20ed",
                                                "text": "Il n’entendit pas le commandement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "881318db-6f41-3bf3-a5d0-a8a69d29dc75",
                                        "entry_id": "79d06e08-e153-32e7-af3e-82739628c7d8",
                                        "glosses": [
                                            "L’autorité qui octroie le pouvoir de commander, qui permet de transmettre des ordres à autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f4d66c2-8a23-4264-889b-b5097d26d023",
                                                "sense_id": "881318db-6f41-3bf3-a5d0-a8a69d29dc75",
                                                "text": "L’Invincible Armada devait avoir pour amiral le marquis de Santa-Cruz ; mais il mourut pendant les préparatifs, et le commandement fut donné au duc de Medina-Sidonia, marin de cour, dont la présomption égalait l’ignorance."
                                            },
                                            {
                                                "example_id": "feb488de-643d-4252-8d9e-77a3b97bb5fd",
                                                "sense_id": "881318db-6f41-3bf3-a5d0-a8a69d29dc75",
                                                "text": "[…] la Marine lui accorda le commandement du brick de 8 canons « La Lilloise ». Ce navire devait surveiller les bâtiments français qui se livraient à la pêche à la morue en Islande et leur porter assistance en cas de besoin."
                                            },
                                            {
                                                "example_id": "46eb6429-18e7-4194-9141-a6f73056d95b",
                                                "sense_id": "881318db-6f41-3bf3-a5d0-a8a69d29dc75",
                                                "text": "La tentation d’être un chef juste et humain est naturelle dans un homme instruit ; mais il faut savoir que le pouvoir change profondément celui qui l’exerce ; et cela ne tient pas seulement à une contagion de société ; la raison en est dans les nécessités du commandement, qui sont inflexibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa58e505-49bb-3611-a14f-7fb116918f70",
                                        "entry_id": "79d06e08-e153-32e7-af3e-82739628c7d8",
                                        "glosses": [
                                            "L’entité ou la personne détentrice de cette autorité."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79199e93-08c1-4961-b3a7-1f8d576a1d4e",
                                                "sense_id": "aa58e505-49bb-3611-a14f-7fb116918f70",
                                                "text": "Voilà qui est entendu : vous alliez à Agadès, vous irez à Agadem... Je vous nomme au commandement de la Section méhariste d'Agadem... Vous voyez, à une lettre près, votre destination n'a pas changé..."
                                            },
                                            {
                                                "example_id": "3f22aace-00d6-4a27-bd5a-65608a72d520",
                                                "sense_id": "aa58e505-49bb-3611-a14f-7fb116918f70",
                                                "text": "Le Président de la République, Pr Alpha Condé, a reçu en audience le samedi 16 juin 2012 à Sékhoutouréya, le haut commandement de l’armée composé du chef d’État Major Général des forces armées, les chefs d’États majors particuliers et les Commandants d’Unités, le cabinet militaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17ebafb5-2c92-34ce-a2a1-82d3838f1872",
                                        "entry_id": "79d06e08-e153-32e7-af3e-82739628c7d8",
                                        "glosses": [
                                            "Exploit fait par un huissier, en vertu d’un jugement ou d’un titre exécutoire par lequel il commande, au nom de la loi et de la justice, de payer, de vider les lieux, etc."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64176868-7462-4848-afb1-d1b314d670ae",
                                                "sense_id": "17ebafb5-2c92-34ce-a2a1-82d3838f1872",
                                                "text": "Toute saisie-exécution doit être précédée d’un commandement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17398b82-0349-38ed-b63d-781942242ae2",
                                        "entry_id": "79d06e08-e153-32e7-af3e-82739628c7d8",
                                        "glosses": [
                                            "Loi ou précepte religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a08ab7a-55ce-4e8b-aa5a-b4f0fff5e4e0",
                                                "sense_id": "17398b82-0349-38ed-b63d-781942242ae2",
                                                "text": "En règle générale, lorsqu’une femme parle de son curé en de mauvais termes, lorsqu’elle débute, au confessionnal, par vous dire qu’il est inintelligent, sans éducation, inapte à comprendre et à guider les âmes, vous pouvez être sûr que l’aveu du péché contre le VIᵉ commandement est proche."
                                            },
                                            {
                                                "example_id": "bd222342-b563-4294-aaf1-9a889a7890a1",
                                                "sense_id": "17398b82-0349-38ed-b63d-781942242ae2",
                                                "text": "Dans les premières pages du Petit catéchisme de Québec [dans les années 1920], dès qu'il est question d'apprendre la religion aux enfants et d'informer les adultes surviennent les dix Commandements. … Quant aux sept Commandements de l'Église, ceux-ci profitent de la proximité des Commandements de Dieu; ils relèvent du même enseignement et des mêmes techniques d'apprentissage. … Ces mêmes commandements, dix-sept en tout, font parfois partie de la prière du soir, à la suite de la récitation du chapelet. … Pour être encore plus certain que ses paroissiens sont bien informés, le même monsieur le curé commentera en chaire, chaque dimanche, chacun des commandements, qui deviennent pour les paroissiens une référence commode lorsqu'il s'agit de se confesser. … Il se peut même que tous ces commandements récités à la file deviennent un défi durant les veillées familiales : « Récite-moi donc tous les commandements et tu auras un prix. » Le prestige des commandements est tel que pour connaître exactement la volonté de Dieu sur sa propre conduite, il suffit de les interroger. Bref, « faire la volonté de Dieu sur la terre », c'est avant tout, et concrètement, observer de son mieux tous les commandements. Qui connaît ses commandements est en principe un bon pratiquant, un homme, une femme de devoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128e24cd-1c4f-3f26-b20a-37c8f8069a0d",
                                        "entry_id": "79d06e08-e153-32e7-af3e-82739628c7d8",
                                        "glosses": [
