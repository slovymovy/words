                "senses": [
                    {
                        "sense_id": "a9e0e11a-3ea7-3a2f-90af-48a842f43e8f",
                        "entry_id": "da299573-dafa-3195-8c56-19f01dbbe686",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b0a97e9-4799-4eed-97b7-a4ad1fe3104f",
                                "sense_id": "a9e0e11a-3ea7-3a2f-90af-48a842f43e8f",
                                "text": "Frau Azone ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dd04dc8e-d485-4d07-9cc7-59f94d19e59d",
                                "sense_id": "a9e0e11a-3ea7-3a2f-90af-48a842f43e8f",
                                "text": "Herr Azone wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1566c9c8-8666-4cb8-9222-aaca03d7d2eb",
                                "sense_id": "a9e0e11a-3ea7-3a2f-90af-48a842f43e8f",
                                "text": "Die Azones fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "744dae9e-7909-4300-bc09-b74d2e0aa536",
                                "sense_id": "a9e0e11a-3ea7-3a2f-90af-48a842f43e8f",
                                "text": "Der Azone trägt nie die Pullover, die die Azone ihm strickt."
                            },
                            {
                                "example_id": "0db14304-59dc-4df0-9aff-c7968302be3d",
                                "sense_id": "a9e0e11a-3ea7-3a2f-90af-48a842f43e8f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Azone kommt, geht der Herr Azone.“"
                            },
                            {
                                "example_id": "d6d1dbc0-5cfb-463d-8d7b-442790cf2fad",
                                "sense_id": "a9e0e11a-3ea7-3a2f-90af-48a842f43e8f",
                                "text": "Azone kommt und geht."
                            },
                            {
                                "example_id": "9793b14c-b461-4988-be75-575b730028ef",
                                "sense_id": "a9e0e11a-3ea7-3a2f-90af-48a842f43e8f",
                                "text": "Azones kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
