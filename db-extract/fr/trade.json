        "fr-extract.jsonl": [
            {
                "entry_id": "351508da-f026-3a19-ac16-abdadbbb18e4",
                "word": "trade",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9ee3fbbb-8142-36db-a835-680c9e343b16",
                        "entry_id": "351508da-f026-3a19-ac16-abdadbbb18e4",
                        "glosses": [
                            "Pratiquer le trading."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ac477975-0dd6-4ebc-9638-14d679b411bc",
                                "sense_id": "9ee3fbbb-8142-36db-a835-680c9e343b16",
                                "text": "Journée de repos donc je vais trade en matinée principalement. Je m’en veux encore des pertes d’hier."
                            },
                            {
                                "example_id": "d72b6805-a9b4-4fd2-9cf5-6fb0b9bc1e05",
                                "sense_id": "9ee3fbbb-8142-36db-a835-680c9e343b16",
                                "text": "Vous êtes trader de forex ou crypto et souhaitez automatiser votre trading pour optimiser votre temps. … Il y a un peu de frais mais c’est le meilleur site pour trade."
                            },
                            {
                                "example_id": "40fd56cf-c44c-4efa-924c-1065b263ae7b",
                                "sense_id": "9ee3fbbb-8142-36db-a835-680c9e343b16",
                                "text": "Ah ça c'est soit parce que j’ai un type à dé-dominer, soit parce que je fais pas gaffe, que je suis en train de trade ou de changer de loadout."
                            },
                            {
                                "example_id": "e08ca223-4163-4956-95e0-4f02bc6d0679",
                                "sense_id": "9ee3fbbb-8142-36db-a835-680c9e343b16",
                                "text": "Je vais trade dans un serveur de pauvre."
                            }
                        ]
                    },
                    {
                        "sense_id": "337010a5-7dc4-3814-879f-e824e5bb19fc",
                        "entry_id": "351508da-f026-3a19-ac16-abdadbbb18e4",
                        "glosses": [
                            "Vendre ou acheter."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ea06820e-3dbd-4bac-a61a-24e82d8f39a8",
                                "sense_id": "337010a5-7dc4-3814-879f-e824e5bb19fc",
                                "text": "Quand quelqu’un m’avait dit « ne trade pas plus que 20% » je me suis dit « oui mais je veux plus donc je vais trade avec 50% »."
                            },
                            {
                                "example_id": "be5cc735-a42e-4579-973d-e9c379405923",
                                "sense_id": "337010a5-7dc4-3814-879f-e824e5bb19fc",
                                "text": "Je vais trade un QB je pense."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88ec24ba-27bd-4cfd-9bd7-21108ebfe46a",
                        "source_entry_id": "351508da-f026-3a19-ac16-abdadbbb18e4",
                        "target_lang_word": "trade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trade",
