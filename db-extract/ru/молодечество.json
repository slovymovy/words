                "senses": [
                    {
                        "sense_id": "acec1c99-afb7-3c8b-b20c-2d433a3d3058",
                        "entry_id": "d63868b8-f2b1-352f-a83b-33603c11476b",
                        "glosses": [
                            "bravado"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "811ebf70-fbbc-4604-9c5c-8ce9b45c02f4",
                                "sense_id": "acec1c99-afb7-3c8b-b20c-2d433a3d3058",
                                "text": "Пи́во он пил то́лько из молоде́чества, но не выноси́л его́ го́рького вку́са и сам удивля́лся, как э́то его́ пьют други́е.",
                                "translation": "Beer he drank only out of bravado, but could not bear its bitter taste, and wondered himself how others could ever drink it.",
                                "english": "Beer he drank only out of bravado, but could not bear its bitter taste, and wondered himself how others could ever drink it."
                            }
                        ]
                    }
                ],
