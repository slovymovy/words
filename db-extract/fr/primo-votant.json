                        "glosses": [
                            "Personne qui vote pour la première fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d2fbe44-acd5-441b-bbb8-5608ae7b2f6f",
                                "sense_id": "e18cc960-b6a6-30c1-86d1-0d6e9d11124d",
                                "text": "Intrigués par leurs motivations et leurs craintes, nous avons interrogés les primo-votants, via un groupe Facebook"
                            },
                            {
                                "example_id": "51cc5030-ed2c-41f6-9712-5690b511c7c0",
                                "sense_id": "e18cc960-b6a6-30c1-86d1-0d6e9d11124d",
                                "text": "Les sondages réalisés pendant la campagne sur les «primo-votants», ceux qui n’ont jamais été inscrits sur les listes, ont mis en évidence leur fort intérêt pour l’élection."
                            },
                            {
                                "example_id": "4d1fb6a8-304a-4ec8-b6f1-61caa915deb3",
                                "sense_id": "e18cc960-b6a6-30c1-86d1-0d6e9d11124d",
                                "text": "Ce sont eux qui pourraient aujourd’hui récupérer la mise, dans un pays en proie à la hausse du prix de l’énergie, à l’inflation et à l’augmentation des actes de violence parmi les plus jeunes, où 28 % des primo-votants se tourneraient vers l’extrême droite, selon l’institut Kantar, contre 23 % pour les sociaux-démocrates."
                            }
                        ]
                    }
