                ],
                "senses": [
                    {
                        "sense_id": "cb9891f1-b61e-387d-a961-a4b5f9592f63",
                        "entry_id": "13e41e36-73ad-3453-bb16-53dc0dfb2dcf",
                        "glosses": [
                            "Sémiotiser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5aef948-11fd-4c33-9e7b-7ca0a821409f",
                                "sense_id": "cb9891f1-b61e-387d-a961-a4b5f9592f63",
                                "text": "Il s’agit pour le groupe de « désémiotiser » et de « resémiotiser » les lieux (bâtiments et voies publiques) de manière à les mettre en conformité avec le sens affirmé par le groupe contestataire."
                            },
                            {
                                "example_id": "ca197a26-3804-4c26-92a0-af0e30fb7445",
                                "sense_id": "cb9891f1-b61e-387d-a961-a4b5f9592f63",
                                "text": "Il faut ainsi resémiotiser la cognition, comme s’y consacrent de nombreux chercheurs depuis quelques années."
                            },
                            {
                                "example_id": "0ad8d590-44a6-406f-9c8e-6e14345a4a9f",
                                "sense_id": "cb9891f1-b61e-387d-a961-a4b5f9592f63",
                                "text": "Tu as parti-pris de resémiotiser à outrance les mots de l'ennemi, et tu remplis tes mots et ton vagin d'une nouvelle signifiance réitérée chaque fois que tu baises."
                            }
                        ]
                    }
