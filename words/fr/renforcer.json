{
    "word_family": [
        "renfort",
        "renforcement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c195f41-857a-3d32-a5df-4777ba554ab3",
                    "sense_definition": "Rendre un objet, une structure ou un corps plus solide, plus résistant physiquement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "solidification_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers doivent <w>renforcer</w> les fondations de ce bâtiment avant l'arrivée de l'hiver."
                        },
                        {
                            "text": "Nous avons décidé de <w>renforcer</w> la porte principale pour décourager les cambrioleurs."
                        }
                    ],
                    "synonyms": [
                        "consolider",
                        "fortifier"
                    ],
                    "antonyms": [
                        "affaiblir"
                    ],
                    "common_phrases": [
                        "renforcer les fondations",
                        "renforcer la structure"
                    ]
                },
                {
                    "sense_id": "6e735962-506f-38ef-a9b9-e177ef327af9",
                    "sense_definition": "Accroître l'intensité, l'importance, l'efficacité ou la portée de quelque chose d'abstrait.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "augmentation_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement souhaite <w>renforcer</w> les mesures de sécurité dans les gares."
                        },
                        {
                            "text": "Cette victoire importante va certainement <w>renforcer</w> la confiance de tous les joueurs."
                        }
                    ],
                    "synonyms": [
                        "affermir",
                        "consolider"
                    ],
                    "antonyms": [
                        "affaiblir"
                    ],
                    "common_phrases": [
                        "renforcer la sécurité",
                        "renforcer les liens",
                        "renforcer les mesures"
                    ]
                },
                {
                    "sense_id": "0e69c16b-591f-3bde-becc-94a8493a4ad5",
                    "sense_definition": "Donner plus de puissance ou d'intensité à un son ou à la voix.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensification_sonore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comédien doit <w>renforcer</w> sa voix pour être bien entendu par tout le public."
                        },
                        {
                            "text": "L'ingénieur a choisi de <w>renforcer</w> les basses sur cet enregistrement musical."
                        }
                    ],
                    "antonyms": [
                        "affaiblir"
                    ],
                    "common_phrases": [
                        "renforcer la voix",
                        "renforcer le son"
                    ]
                },
                {
                    "sense_id": "30fb7602-9eb3-3c8d-9106-80d11c5aeb00",
                    "sense_definition": "Donner plus de vivacité, d'intensité ou de contraste à une couleur ou à une image.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensification_visuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le photographe utilise un logiciel pour <w>renforcer</w> les contrastes de cette image sombre."
                        },
                        {
                            "text": "Il est nécessaire de <w>renforcer</w> cette teinte pour équilibrer la composition du tableau."
                        }
                    ],
                    "antonyms": [
                        "affaiblir"
                    ],
                    "common_phrases": [
                        "renforcer les contrastes",
                        "renforcer les couleurs"
                    ]
                }
            ]
        }
    ]
}