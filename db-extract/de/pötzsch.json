                "senses": [
                    {
                        "sense_id": "eeb129f2-96e9-312b-99d6-224730d809dd",
                        "entry_id": "24981b46-62fe-377e-9b27-365fcb60b206",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d9dc82a-4a08-40da-b11f-1243c9cd9b8f",
                                "sense_id": "eeb129f2-96e9-312b-99d6-224730d809dd",
                                "text": "Frau Pötzsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1723a232-c8f1-4247-90a7-6a37e39f8370",
                                "sense_id": "eeb129f2-96e9-312b-99d6-224730d809dd",
                                "text": "Herr Pötzsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "25d9e21f-90c7-4264-8fa5-12efc9d97859",
                                "sense_id": "eeb129f2-96e9-312b-99d6-224730d809dd",
                                "text": "Die Pötzschs fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "60ae63eb-1d94-45d5-83cd-90dd87f390ce",
                                "sense_id": "eeb129f2-96e9-312b-99d6-224730d809dd",
                                "text": "Der Pötzsch trägt nie die Pullover, die die Pötzsch ihm strickt."
                            },
                            {
                                "example_id": "23f2f081-63fb-40cc-98cb-0e8ea0728141",
                                "sense_id": "eeb129f2-96e9-312b-99d6-224730d809dd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pötzsch kommt, geht der Herr Pötzsch.“"
                            },
                            {
                                "example_id": "ce281f92-c453-48c3-97f1-c9541d15d762",
                                "sense_id": "eeb129f2-96e9-312b-99d6-224730d809dd",
                                "text": "Pötzsch kommt und geht."
                            },
                            {
                                "example_id": "ca86c6b8-5d59-478b-b91f-ad9cebbcdb08",
                                "sense_id": "eeb129f2-96e9-312b-99d6-224730d809dd",
                                "text": "Pötzschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
