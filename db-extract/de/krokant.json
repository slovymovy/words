                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7aa223a-bf9b-4af6-891e-2afbe0928d45",
                                                "sense_id": "8168b61c-4d01-3f3c-b27c-c78475577011",
                                                "text": "The project is based on a similar project, the Class project, which was started by the University of Cornell several years ago under the leadership of Stuart Lynn to preserve brittling old books."
                                            },
                                            {
                                                "example_id": "b6ae6899-10a5-459e-b1f9-2aaf809e3141",
                                                "sense_id": "8168b61c-4d01-3f3c-b27c-c78475577011",
                                                "text": "Her heart fluttered, then stilled when May snapped the image away and her voice brittled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41270237-4e0f-3d43-aaa2-339ffdd3ca86",
                                        "entry_id": "929caef0-3e94-39a9-a66c-6fb8d7dc988a",
                                        "glosses": [
                                            "To gut."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b27e4426-1d6e-484b-8fd2-ce044ee77db5",
                                                "sense_id": "41270237-4e0f-3d43-aaa2-339ffdd3ca86",
                                                "text": "Not being versed in the terms of English venery, he asked Abbot Ulfketyl what brittling of a deer might mean; and being informed that it was that operation on the carcass of a stag which his countrymen called eventrer, and Highland gillies now “gralloching”[.]"
                                            }
                                        ]
