{
    "word_family": [
        "pavement",
        "paving",
        "paver",
        "repave"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "074f7bac-5fcb-3895-834b-f8830d007cb0",
                    "sense_definition": "To cover a surface with a hard material like stone, concrete, or asphalt to make it suitable for travel.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council decided to <w>pave</w> the old dirt road to improve access for cars.",
                            "target_lang_translations": {
                                "ru": "Городской совет решил <w>заасфальтировать</w> старую грунтовую дорогу, чтобы улучшить подъезд для автомобилей."
                            }
                        },
                        {
                            "text": "Workers will <w>pave</w> the driveway with bricks to match the style of the house.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>вымостят</w> подъездную дорожку кирпичом, чтобы она соответствовала стилю дома."
                            }
                        }
                    ],
                    "synonyms": [
                        "surface",
                        "tar",
                        "asphalt"
                    ],
                    "antonyms": [
                        "dig up",
                        "unpave"
                    ],
                    "common_phrases": [
                        "pave the driveway",
                        "pave with concrete"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность твердым материалом, таким как камень, бетон или асфальт, чтобы сделать ее пригодной для проезда или прохода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мостить",
                                "target_lang_sense_clarification": "покрывать камнем или брусчаткой"
                            },
                            {
                                "target_lang_word": "вымостить",
                                "target_lang_sense_clarification": "завершить покрытие поверхности камнем"
                            },
                            {
                                "target_lang_word": "асфальтировать",
                                "target_lang_sense_clarification": "покрывать асфальтом"
                            },
                            {
                                "target_lang_word": "заасфальтировать",
                                "target_lang_sense_clarification": "завершить покрытие асфальтом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b80ca2b0-9404-36e2-9e60-c7cab87b9749",
                    "sense_definition": "To create a situation that makes it easier for something to happen or for someone to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "facilitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new scientific discovery will <w>pave</w> the way for future medical breakthroughs.",
                            "target_lang_translations": {
                                "ru": "Это новое научное открытие <w>проложит</w> путь для будущих прорывов в медицине."
                            }
                        },
                        {
                            "text": "Her early success in the industry helped <w>pave</w> the way for other women in leadership.",
                            "target_lang_translations": {
                                "ru": "Ее ранний успех в этой индустрии помог <w>подготовить</w> почву для других женщин на руководящих должностях."
                            }
                        }
                    ],
                    "synonyms": [
                        "prepare",
                        "facilitate",
                        "smooth"
                    ],
                    "antonyms": [
                        "hinder",
                        "obstruct"
                    ],
                    "common_phrases": [
                        "pave the way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать условия, которые облегчают наступление какого-либо события или выполнение какой-либо деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокладывать",
                                "target_lang_sense_clarification": "в выражении 'прокладывать путь'"
                            },
                            {
                                "target_lang_word": "подготавливать",
                                "target_lang_sense_clarification": "создавать почву для чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}