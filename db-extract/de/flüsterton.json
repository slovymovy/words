                "senses": [
                    {
                        "sense_id": "002e4645-8e8f-31aa-9649-3d1b3fdcf7a9",
                        "entry_id": "3b0548b3-ebe9-30ac-a6c1-3b1e43a00c95",
                        "glosses": [
