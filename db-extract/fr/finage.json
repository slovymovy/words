                "entry_id": "4d2a8bc9-3c4f-3d53-a762-552be5479581",
                "word": "finage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ca42cb6-e5f3-4df1-8d1e-8c6b243fa571",
                        "entry_id": "4d2a8bc9-3c4f-3d53-a762-552be5479581",
                        "tags": [
                            "plural"
