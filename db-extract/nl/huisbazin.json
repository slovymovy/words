                        ],
                        "examples": [
                            {
                                "example_id": "6bc9898e-f509-4c9e-95f7-9c6a5a187bcd",
                                "sense_id": "d6d39b78-eee4-3026-821e-3da977231ba6",
                                "text": "Het ergste is natuurlijk: het had niet gehoeven. Als de huisbazin op tijd de gammele brug van de dijk naar het huis had gerepareerd, zoals bij de buren was gebeurd, dan had echtgenoot Cees met zijn twee zonen nog best de dijk kunnen bereiken."
                            },
                            {
                                "example_id": "4ab31be2-c78e-4028-a174-8c69143294cd",
                                "sense_id": "d6d39b78-eee4-3026-821e-3da977231ba6",
                                "text": "Volgens onze Praagse huisbazin is een bezoek aan Praag niets waard als je niet tenminste een keer over de beroemde Karelsbrug geslenterd bent. Het is de oudste en meest bekende brug in Praag die de Oude Stad verbindt met de Malá Strana, oftewel de Kleine Zijde."
                            }
                        ]
                    }
