                "forms": [
                    {
                        "form_id": "043307c6-e6d7-461c-9e49-9b2f57644947",
                        "entry_id": "fe4d925f-9d23-316f-a591-75ddf4419e58",
                        "tags": [
                            "plural"
                        ],
                        "form": "protéomes"
                    },
                    {
                        "form_id": "df1c36db-5344-4089-b572-f0a74de90610",
                        "entry_id": "fe4d925f-9d23-316f-a591-75ddf4419e58",
                        "tags": [],
                        "form": "protéôme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06b7d001-779c-369b-acb8-688666632688",
                        "entry_id": "fe4d925f-9d23-316f-a591-75ddf4419e58",
                        "glosses": [
                            "Ensemble des protéines codées par un génome, à un moment déterminé, et caractérisées par leur quantité et leur conformation."
                        ],
                        "tags": [
                            "Bioinformatique",
                            "Biologie moléculaire",
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "c2bad547-742e-40c3-9eac-2651b83ac386",
                                "sense_id": "06b7d001-779c-369b-acb8-688666632688",
                                "text": "En outre, l’outil a prédit les protéomes presque complets de 20 autres organismes, dont ceux de la souris, du rat, de la drosophile (mouche du vinaigre), du poisson zèbre et de la bactérie E. coli."
                            },
                            {
                                "example_id": "23a4a267-5cff-495e-abb6-afc0cfdd7c02",
                                "sense_id": "06b7d001-779c-369b-acb8-688666632688",
                                "text": "L’absence de peptides spécifiques aux mâles prouve que la dent a appartenu à un individu féminin, mais le « protéome » s’est avéré trop dégradé pour pouvoir conclure quant à l’espèce."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "694a64a5-7121-4d13-86bc-54a6635f467f",
                        "source_entry_id": "fe4d925f-9d23-316f-a591-75ddf4419e58",
                        "source_sense_id": "06b7d001-779c-369b-acb8-688666632688",
                        "target_lang_word": "Proteom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Proteom",
                                "target_lang_code": "de",
