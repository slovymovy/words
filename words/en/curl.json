{
    "word_family": [
        "curler",
        "curling",
        "curly",
        "uncurled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "256eb97d-b477-3d0f-a349-05d8f7f52c9d",
                    "sense_definition": "A curving piece or lock of hair; a ringlet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gently brushed a truant <w>curl</w> away from her forehead.",
                            "target_lang_translations": {
                                "ru": "Она осторожно убрала непослушный <w>локон</w> со лба."
                            }
                        },
                        {
                            "text": "The young girl had beautiful golden <w>curls</w> that bounced when she ran.",
                            "target_lang_translations": {
                                "ru": "У девочки были прекрасные золотистые <w>кудряшки</w>, которые подпрыгивали при беге."
                            }
                        }
                    ],
                    "synonyms": [
                        "ringlet"
                    ],
                    "common_phrases": [
                        "truant curl",
                        "bouncy curls",
                        "lock of hair"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изогнутая прядь волос; колечко."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "локон",
                                "target_lang_sense_clarification": "красивая прядь"
                            },
                            {
                                "target_lang_word": "кудряшка",
                                "target_lang_sense_clarification": "мелкий завиток"
                            },
                            {
                                "target_lang_word": "завиток",
                                "target_lang_sense_clarification": "форма волоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b297e380-21e4-3ea5-9451-52fa33e44f21",
                    "sense_definition": "A curved stroke, shape, or spiral pattern.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist added a small <w>curl</w> at the end of each letter.",
                            "target_lang_translations": {
                                "ru": "Художник добавил небольшой <w>завиток</w> в конце каждой буквы."
                            }
                        },
                        {
                            "text": "A thin <w>curl</w> of smoke rose slowly from the chimney into the cold air.",
                            "target_lang_translations": {
                                "ru": "Тонкая <w>струйка</w> дыма медленно поднималась из трубы в холодный воздух."
                            }
                        }
                    ],
                    "synonyms": [
                        "curlicue",
                        "curve",
                        "flourish",
                        "loop",
                        "spiral"
                    ],
                    "common_phrases": [
                        "curl of smoke",
                        "decorative curl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изогнутая линия, форма или спиральный узор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завиток",
                                "target_lang_sense_clarification": "спиральная форма"
                            },
                            {
                                "target_lang_word": "завитушка",
                                "target_lang_sense_clarification": "декоративный элемент"
                            },
                            {
                                "target_lang_word": "струйка",
                                "target_lang_sense_clarification": "о дыме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60810e07-9d6a-30ac-97fa-e98e0a8c9bbc",
                    "sense_definition": "An exercise performed by bending a limb against resistance, typically to train the biceps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He finished his workout with three sets of a bicep <w>curl</w> using heavy dumbbells.",
                            "target_lang_translations": {
                                "ru": "Он закончил тренировку тремя подходами <w>сгибаний</w> на бицепс с тяжелыми гантелями."
                            }
                        },
                        {
                            "text": "Make sure to keep your back straight while performing a <w>curl</w> and an overhead press.",
                            "target_lang_translations": {
                                "ru": "Следите за тем, чтобы спина оставалась прямой во время выполнения <w>подъема</w> на бицепс и жима над головой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bicep curl",
                        "leg curl",
                        "wrist curl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Упражнение, выполняемое путем сгибания конечности с отягощением, обычно для тренировки бицепса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгибание",
                                "target_lang_sense_clarification": "на бицепс"
                            },
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "на бицепс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a743252-3bbd-31e0-948d-0d84c357b9e2",
                    "sense_definition": "A spin that causes the trajectory of a moving object, like a ball, to curve.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physics_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soccer player put a lot of <w>curl</w> on the ball to bypass the wall of defenders.",
                            "target_lang_translations": {
                                "ru": "Футболист сильно <w>подкрутил</w> мяч, чтобы обвести стенку защитников."
                            }
                        },
                        {
                            "text": "It is difficult to control the <w>curl</w> on the ball when the wind is blowing strongly.",
                            "target_lang_translations": {
                                "ru": "Трудно контролировать <w>вращение</w> мяча, когда дует сильный ветер."
                            }
                        }
                    ],
                    "synonyms": [
                        "curve"
                    ],
                    "common_phrases": [
                        "curl on the ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вращение, заставляющее траекторию движущегося объекта, например мяча, искривляться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкрутка",
                                "target_lang_sense_clarification": "мяча"
                            },
                            {
                                "target_lang_word": "кручение",
                                "target_lang_sense_clarification": "траектория"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7537a5e3-d55f-38c7-861c-5f359732860f",
                    "sense_definition": "The concave, hollow part of a breaking wave.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surfer managed to stay inside the <w>curl</w> for several seconds before the wave crashed.",
                            "target_lang_translations": {
                                "ru": "Серферу удавалось оставаться внутри <w>завитка</w> волны несколько секунд, прежде чем она обрушилась."
                            }
                        },
                        {
                            "text": "Experienced surfers always try to remain in the <w>curl</w> to maintain their speed.",
                            "target_lang_translations": {
                                "ru": "Опытные серферы всегда стараются оставаться в <w>трубе</w>, чтобы сохранять скорость."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the curl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вогнутая, полая часть разбивающейся волны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завиток",
                                "target_lang_sense_clarification": "гребень волны"
                            },
                            {
                                "target_lang_word": "труба",
                                "target_lang_sense_clarification": "в серфинге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06e8f367-ffea-3b73-b859-a6f21645bc97",
                    "sense_definition": "The vector field denoting the rotationality of a given vector field.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In multivariable calculus, we calculate the <w>curl</w> of a vector field to determine its rotation.",
                            "target_lang_translations": {
                                "ru": "В многомерном исчислении мы вычисляем <w>ротор</w> векторного поля, чтобы определить его вращение."
                            }
                        },
                        {
                            "text": "The <w>curl</w> of the magnetic field is related to the electric current density.",
                            "target_lang_translations": {
                                "ru": "<w>Ротор</w> магнитного поля связан с плотностью электрического тока."
                            }
                        }
                    ],
                    "synonyms": [
                        "mul:∇×"
                    ],
                    "common_phrases": [
                        "scalar curl",
                        "vectorial curl"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Векторное поле, обозначающее вращательную способность данного векторного поля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ротор",
                                "target_lang_sense_clarification": "математический оператор"
                            },
                            {
                                "target_lang_word": "вихрь",
                                "target_lang_sense_clarification": "векторного поля"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c7ab887-8ac7-3d55-8f6a-ae4bc8e8b42c",
                    "sense_definition": "To twist or form hair into ringlets.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hair_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>curl</w> her hair for the wedding to look more formal.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>завить</w> волосы на свадьбу, чтобы выглядеть более официально."
                            }
                        },
                        {
                            "text": "It takes a long time to <w>curl</w> locks with a hot iron every morning.",
                            "target_lang_translations": {
                                "ru": "Каждое утро уходит много времени на то, чтобы <w>накручивать</w> локоны плойкой."
                            }
                        }
                    ],
                    "antonyms": [
                        "straighten"
                    ],
                    "common_phrases": [
                        "curl hair",
                        "curl locks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закручивать или формировать волосы в локоны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завивать",
                                "target_lang_sense_clarification": "волосы"
                            },
                            {
                                "target_lang_word": "накручивать",
                                "target_lang_sense_clarification": "на плойку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a44b0fe8-1727-39d8-88d6-0599dd5c8c9a",
                    "sense_definition": "To assume the shape of a curl, spiral, or curve.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shape_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old pages of the book began to <w>curl</w> at the edges over time.",
                            "target_lang_translations": {
                                "ru": "Со временем старые страницы книги начали <w>закручиваться</w> по краям."
                            }
                        },
                        {
                            "text": "I watched the smoke <w>curl</w> up toward the ceiling in the quiet room.",
                            "target_lang_translations": {
                                "ru": "Я смотрел, как дым <w>вьется</w> к потолку в тихой комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "coil",
                        "roll up"
                    ],
                    "antonyms": [
                        "straighten",
                        "uncoil",
                        "unroll"
                    ],
                    "common_phrases": [
                        "curl at the edges",
                        "curl up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать форму завитка, спирали или кривой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "виться",
                                "target_lang_sense_clarification": "о дыме или тропинке"
                            },
                            {
                                "target_lang_word": "закручиваться",
                                "target_lang_sense_clarification": "о краях бумаги"
                            },
                            {
                                "target_lang_word": "извиваться",
                                "target_lang_sense_clarification": "волнистой линией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b17f25a-f25f-3cba-922c-14e9df59191a",
                    "sense_definition": "To cause something to move in a curve.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physics_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker managed to <w>curl</w> the ball around the goalkeeper and into the net.",
                            "target_lang_translations": {
                                "ru": "Нападающему удалось <w>закрутить</w> мяч мимо вратаря прямо в сетку."
                            }
                        },
                        {
                            "text": "He tried to <w>curl</w> an effort over the wall, but the ball went too high.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>перебросить</w> мяч крученым ударом через стенку, но мяч пролетел слишком высоко."
                            }
                        }
                    ],
                    "common_phrases": [
                        "curl the ball"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо двигаться по кривой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подкручивать",
                                "target_lang_sense_clarification": "мяч"
                            },
                            {
                                "target_lang_word": "закручивать",
                                "target_lang_sense_clarification": "траекторию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df1fd9a1-f4ee-3648-b92f-e17eb041a112",
                    "sense_definition": "To exercise by bending a limb against resistance, especially to isolate the biceps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exercise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When <w>curling</w> the weight, you should keep your elbows as immobile as possible.",
                            "target_lang_translations": {
                                "ru": "При <w>подъеме</w> веса на бицепс локти должны оставаться максимально неподвижными."
                            }
                        },
                        {
                            "text": "He can <w>curl</w> fifty pounds with one arm without much effort.",
                            "target_lang_translations": {
                                "ru": "Он может <w>поднять</w> на бицепс пятьдесят фунтов одной рукой без особых усилий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "curl the weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять упражнение, сгибая конечность с сопротивлением, особенно для изоляции бицепса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгибать",
                                "target_lang_sense_clarification": "руки на бицепс"
                            },
                            {
                                "target_lang_word": "качать",
                                "target_lang_sense_clarification": "бицепс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c8659ee-a16b-39a6-afc4-e90511955dcf",
                    "sense_definition": "To take part in the winter sport of curling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people in Canada like to <w>curl</w> at their local club during the winter months.",
                            "target_lang_translations": {
                                "ru": "Многие в Канаде любят <w>играть в кёрлинг</w> в местном клубе в зимние месяцы."
                            }
                        },
                        {
                            "text": "He has been learning how to <w>curl</w> since he was a young child.",
                            "target_lang_translations": {
                                "ru": "Он учится <w>играть в кёрлинг</w> с самого детства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "curl at a club"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать участие в зимнем виде спорта — кёрлинге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "играть в кёрлинг",
                                "target_lang_sense_clarification": "вид спорта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "949c761b-c803-3a47-bbcc-d7de4943e643",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the new biography is a man named Thomas <w>Curl</w>.",
                            "target_lang_translations": {
                                "ru": "Автор новой биографии — человек по имени Томас <w>Керл</w>."
                            }
                        },
                        {
                            "text": "We are meeting with the <w>Curl</w> family for dinner this evening.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы встречаемся за ужином с семьей <w>Керл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Керл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}