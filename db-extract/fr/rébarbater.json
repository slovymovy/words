                ],
                "senses": [
                    {
                        "sense_id": "561bad4b-3db2-37b2-8f4a-90cae645bbeb",
                        "entry_id": "59f73422-4d95-3d1c-b49b-833b62f76802",
                        "glosses": [
                            "Se montrer peu engageant, voire hostile."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "033ec85c-657c-4c06-8149-d8026a1c8b4a",
                                "sense_id": "561bad4b-3db2-37b2-8f4a-90cae645bbeb",
                                "text": "Elle rébarbate dans un tailleur mal coupé qui ne parvient pas à lui composer la silhouette hommasse souhaitée au départ, parce que la nénette en question a des formes incomprimables et hautement harmonieuses."
                            },
                            {
                                "example_id": "a1b2ace5-b343-4384-8ed1-a323d6bf25df",
                                "sense_id": "561bad4b-3db2-37b2-8f4a-90cae645bbeb",
                                "text": "Quand je te dis porte, c’est du haut de gamme. La vraie lourde de blockhaus, mon vieux. Elle rébarbate vachement."
                            },
                            {
                                "example_id": "845b42ff-1a7c-4c05-8476-b22312815ad0",
                                "sense_id": "561bad4b-3db2-37b2-8f4a-90cae645bbeb",
                                "text": "Il sort dans le couloir où une théorie de portes closes sur des mystères malodorants rébarbatent."
                            },
                            {
                                "example_id": "300a67a1-5c7d-43ef-b520-eec19e3a9517",
                                "sense_id": "561bad4b-3db2-37b2-8f4a-90cae645bbeb",
                                "text": "L’entrée rébarbate. Magine un endroit plus vaste que la gare de Collonges-au-Mont-d’Or, sans ouvertures sur l’extérieur en dehors de l’énorme porte pour chambre forte qui s’ouvre après qu’on a actionné une chiée de combinaisons subtiles."
                            },
                            {
                                "example_id": "e2406016-ad8d-4f7f-9972-537ffdcdbe83",
                                "sense_id": "561bad4b-3db2-37b2-8f4a-90cae645bbeb",
                                "text": "Des classeurs classiques, bourrés de dossiers qui rébarbatent, attachés par des sangles : Achtung ! C’est du sérieux."
                            }
                        ]
                    }
                ],
