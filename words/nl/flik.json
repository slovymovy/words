                                "target_lang_sense_clarification": "разговорное, часто пренебрежительное название полицейского"
                            },
                            {
                                "target_lang_word": "легавый",
                                "target_lang_sense_clarification": "жаргонное название полицейского"
                            }
                        ]
                    }
                },
                {
