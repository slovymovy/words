                            {
                                "example_id": "4f3524d7-51bb-4e46-9b6a-f1e07f2a6a90",
                                "sense_id": "77db7b21-45c6-3a84-b501-91052fd87247",
                                "text": "Une agate rubanée, c'est-à-dire une sardoine associée à une couche de chalcédoine et à une couche d'onyx, qui ne sont, comme elle, que des nuances de l'agate, devient une sardonyx."
                            },
                            {
                                "example_id": "5073c004-aa6a-459d-8a3d-0940157a852d",
                                "sense_id": "77db7b21-45c6-3a84-b501-91052fd87247",
                                "text": "La chalcédoine, enseigne de la charité, on l’applique à Joseph qui fut si pitoyable, si clément pour ses frères et à saint Jacques le Majeur."
                            }
                        ]
                    }
