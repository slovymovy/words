                                    {
                                        "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                        "entry_id": "4e5960b7-7a5b-3180-8085-e09a7949ca57",
                                        "glosses": [
                                            "A morbid condition, characterized by yellowness of the eyes, skin, and urine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ee85cf-aad5-4fc1-866b-1f1813b0fff2",
                                                "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                                "text": "Why ſhould a man whoſe bloud is warme within, / Sit like his Grandſire, cut in Alabaſter? / Sleepe when he wakes? and creep into the Iaundies / By being peeuiſh?"
                                            },
                                            {
                                                "example_id": "b3080ead-776b-44c2-a311-3c3fdf17ce18",
                                                "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                                "text": "But look in this new mirror, lovely friend. / Both gods and fairies wait on lovers' wills. / That jaundices be changed to daffodils!"
                                            },
                                            {
                                                "example_id": "b231bf57-fbed-4a29-aae1-2e24538efb05",
                                                "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                                "text": "In British folk medicine there are some unusual remedies for jaundice. A bizarre superstition from Staffordshire is that if a bladder is filled with the patient's urine and placed near the fire, as it dries out, the patient will recover (Black 1883: 56)."
                                            },
                                            {
                                                "example_id": "47b9fe5e-6f9a-4704-b5d6-2ff0fd7780f6",
                                                "sense_id": "52bd2e1b-6236-3bdd-ad24-b25bd433be84",
                                                "text": "Just ask the doctors how many cases of infantile jaundice in newborn babies have this scene that particular week?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b021dae-0154-3532-91a1-f15a3d2f1bdb",
                                        "entry_id": "4e5960b7-7a5b-3180-8085-e09a7949ca57",
                                        "glosses": [
                                            "A feeling of bitterness, resentment or jealousy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d3874a-e4ad-49ad-8937-51dddc2995ea",
                                                "sense_id": "7b021dae-0154-3532-91a1-f15a3d2f1bdb",
                                                "text": "No, sir, he, / Vex'd with a morbid devil in his blood / That veil'd the world with jaundice, hid his face / From all men, and commercing with himself, / He lost the sense that handles daily life— […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jaundice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05caf614-ad93-3b3c-8775-999ee2ee2ebe",
                                        "entry_id": "dd6007d2-5ee0-3bd5-9800-9a9dd4aa69ed",
                                        "glosses": [
                                            "To affect with jaundice; to color by prejudice or envy; to prejudice."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b6bd08a-fc7d-44c1-a340-fb77c78f9a81",
                                                "sense_id": "05caf614-ad93-3b3c-8775-999ee2ee2ebe",
                                                "text": "The envy of wealth jaundiced his soul."
                                            }
