                ],
                "senses": [
                    {
                        "sense_id": "0f0dea07-ddb6-3356-bcbd-af3ff1617ae6",
                        "entry_id": "9396ae52-3f45-368a-b45b-6f4e94b06137",
                        "glosses": [
                            "definierter Bereich des Militärs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5b2c5d1-4bc0-463b-b57f-0ae6c79c8893",
                                "sense_id": "0f0dea07-ddb6-3356-bcbd-af3ff1617ae6",
                                "text": "„Als Freiwilliger konnte ich mir die Waffengattung aussuchen, und da ging ich, ich kam aus Sachsen, zur Marine.“"
                            },
                            {
                                "example_id": "561aef86-d0d3-4c5a-a91f-306c60ddb232",
                                "sense_id": "0f0dea07-ddb6-3356-bcbd-af3ff1617ae6",
                                "text": "„Er hatte Reidel gefragt, ob er Wünsche hinsichtlich der Waffengattung habe.“"
                            },
                            {
                                "example_id": "4f6dd276-1c80-4ba9-b66a-ef27cc1f0016",
                                "sense_id": "0f0dea07-ddb6-3356-bcbd-af3ff1617ae6",
                                "text": "„Die zurückgehaltenen Infanteristen drängten sich im zerstampften Schmutz vor der Brücke und betrachteten die sauberen, stutzerhaft anmutenden, in guter Ordnung an ihnen vorübermarschierenden Husaren mit jenem ganz besonderen missgünstigen Gefühl der Fremdheit und des Spottes, das Truppen verschiedener Waffengattungen einander entgegenzubringen pflegen.“"
                            },
                            {
                                "example_id": "6f36d3f7-ac4a-40c4-a664-42ddd1ae2c67",
                                "sense_id": "0f0dea07-ddb6-3356-bcbd-af3ff1617ae6",
                                "text": "„Die mittelalterliche indische Kriegstechnik mit den Kriegselefanten als zentrale Waffengattung blieb weiterhin erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
