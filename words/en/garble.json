{
    "word_family": [
        "garbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "729499bc-e3b9-3317-9930-59dcbe59a2b3",
                    "sense_definition": "To corrupt or distort a message or sound, making it confusing, unreadable, or unintelligible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A bad connection can easily <w>garble</w> the audio during an important phone conference.",
                            "target_lang_translations": {
                                "zh": "不良的网络连接很容易在一场重要的电话会议中<w>搞乱</w>音频信号。"
                            }
                        },
                        {
                            "text": "The computer error threatened to <w>garble</w> the text files beyond recognition.",
                            "target_lang_translations": {
                                "zh": "这起电脑故障可能会把文本文件<w>搞乱</w>到面目全非的地步。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scramble",
                        "muddle",
                        "distort"
                    ],
                    "antonyms": [
                        "clarify"
                    ],
                    "common_phrases": [
                        "garble the transmission",
                        "garble the message"
                    ],
                    "target_lang_definitions": {
                        "zh": "使（信息或声音）失真、错乱或含混不清"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "搞乱",
                                "target_lang_sense_clarification": "使信息或顺序混乱"
                            },
                            {
                                "target_lang_word": "使混淆",
                                "target_lang_sense_clarification": "使内容模糊不清"
                            },
                            {
                                "target_lang_word": "使失真",
                                "target_lang_sense_clarification": "指声音或信号变形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79a53c56-b33c-32b2-9929-10e10579c652",
                    "sense_definition": "To intentionally alter or misquote a text, report, or statement so as to mislead or misrepresent the author's meaning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician accused the media of attempting to <w>garble</w> his statements to create controversy.",
                            "target_lang_translations": {
                                "zh": "这位政客指责媒体企图<w>歪曲</w>他的言论以制造争议。"
                            }
                        },
                        {
                            "text": "Dishonest reviewers often <w>garble</w> quotations to support an inaccurate narrative.",
                            "target_lang_translations": {
                                "zh": "不诚实的书评人经常<w>曲解</w>引文，以支撑不准确的叙述。"
                            }
                        }
                    ],
                    "synonyms": [
                        "misrepresent",
                        "pervert",
                        "twist"
                    ],
                    "common_phrases": [
                        "garble a quotation",
                        "garble the facts"
                    ],
                    "target_lang_definitions": {
                        "zh": "蓄意曲解、歪曲或断章取义（文字、言论等）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "曲解",
                                "target_lang_sense_clarification": "故意作错误解释"
                            },
                            {
                                "target_lang_word": "歪曲",
                                "target_lang_sense_clarification": "故意改变原意"
                            },
                            {
                                "target_lang_word": "断章取义",
                                "target_lang_sense_clarification": "孤立截取片段歪曲原意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f3085cc-359a-343f-9ee2-bc2da96c7972",
                    "sense_definition": "To make false or inaccurate by altering, mutilating, or adding erroneous details.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "distort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor began to <w>garble</w> the story until it barely resembled the truth.",
                            "target_lang_translations": {
                                "zh": "编辑开始<w>篡改</w>这个故事，直到它几乎与事实毫无相似之处。"
                            }
                        },
                        {
                            "text": "Unverified rumors will inevitably <w>garble</w> the original witness reports.",
                            "target_lang_translations": {
                                "zh": "未经证实的谣言必然会<w>窜改</w>目击者的原始陈述。"
                            }
                        }
                    ],
                    "synonyms": [
                        "falsify",
                        "tamper"
                    ],
                    "common_phrases": [
                        "garble the story"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过篡改、删减或增添错误细节来窜改（事实或报道）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "篡改",
                                "target_lang_sense_clarification": "用作伪手段改动"
                            },
                            {
                                "target_lang_word": "窜改",
                                "target_lang_sense_clarification": "改动文字使其失真"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63dfcd48-1579-3c75-8e42-3e42ef776dbf",
                    "sense_definition": "To sift or separate valuable parts from coarse residue, refuse, or dirt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Merchants used to carefully <w>garble</w> spices to remove any dust or dirt.",
                            "target_lang_translations": {
                                "zh": "商人们过去常常仔细地<w>拣选</w>香料，以去除灰尘或泥土。"
                            }
                        },
                        {
                            "text": "Workers had to <w>garble</w> the raw harvest before packing it for shipment.",
                            "target_lang_translations": {
                                "zh": "工人们在打包运送前必须先对原收成物进行<w>筛除</w>杂质。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sift",
                        "winnow"
                    ],
                    "common_phrases": [
                        "garble spices"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically of sifting spices or herbs."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "拣选、筛除（香料、药物等的杂质或劣质部分）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拣选",
                                "target_lang_sense_clarification": "剔除劣质杂质"
                            },
                            {
                                "target_lang_word": "筛除",
                                "target_lang_sense_clarification": "通过筛选去除杂质"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c148495c-c465-3121-ac6f-856f7cd08cf5",
                    "sense_definition": "Confused, distorted, or unintelligible speech or sound.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio receiver produced mostly static and indistinct <w>garble</w>.",
                            "target_lang_translations": {
                                "zh": "无线电接收机传出的主要是静电干扰和模糊不清的<w>杂音</w>。"
                            }
                        },
                        {
                            "text": "His explanation was reduced to meaningless <w>garble</w> when the microphone cut out.",
                            "target_lang_translations": {
                                "zh": "麦克风断断续续时，他的解释变成了一堆毫无意义的<w>含糊不清的话</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gibberish",
                        "babble"
                    ],
                    "antonyms": [
                        "clarity"
                    ],
                    "common_phrases": [
                        "static and garble"
                    ],
                    "target_lang_definitions": {
                        "zh": "含混不清的话语或杂乱的声音"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "含糊不清的话",
                                "target_lang_sense_clarification": "指辨认不出的言语"
                            },
                            {
                                "target_lang_word": "杂音",
                                "target_lang_sense_clarification": "指混乱失真的声音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbaebff3-6928-3c2e-b406-21f5b791ff34",
                    "sense_definition": "Refuse, dirt, or impurities separated out from spices, drugs, or other goods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant discarded the accumulated <w>garble</w> left behind in the sacks of cloves.",
                            "target_lang_translations": {
                                "zh": "商人把丁香麻袋里堆积的<w>杂质</w>全扔掉了。"
                            }
                        },
                        {
                            "text": "Inspectors checked that no unwanted <w>garble</w> remained mixed with the medicinal herbs.",
                            "target_lang_translations": {
                                "zh": "检查员核实了药草中没有混入多余的<w>残渣</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dross",
                        "refuse",
                        "rubbish"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to refuse or dross sifted out."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "从香料、药物等中筛拣出的残渣或杂质"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "杂质",
                                "target_lang_sense_clarification": "筛出的无用物质"
                            },
                            {
                                "target_lang_word": "残渣",
                                "target_lang_sense_clarification": "剩下的碎屑下脚料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43cbefed-ace5-3757-9595-74e59328ba36",
                    "sense_definition": "Rubbish, trash, or refuse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Old barrels in the cellar were filled with useless <w>garble</w>.",
                            "target_lang_translations": {
                                "zh": "地窖里的旧桶里装满了毫无用处的<w>垃圾</w>。"
                            }
                        },
                        {
                            "text": "They cleared out piles of dry <w>garble</w> from the abandoned warehouse.",
                            "target_lang_translations": {
                                "zh": "他们从废弃仓库中清理出一堆堆干燥的<w>废弃物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rubbish",
                        "trash"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "垃圾；废弃物"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "垃圾",
                                "target_lang_sense_clarification": "废弃不用的杂物"
                            },
                            {
                                "target_lang_word": "废弃物",
                                "target_lang_sense_clarification": "弃置的废物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f701c076-0c49-3198-aa41-1e19e996dcee",
                    "sense_definition": "The act of mutilating or the state of being mutilated or corrupted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manuscript suffered severe <w>garble</w> over centuries of poor copying.",
                            "target_lang_translations": {
                                "zh": "在数个世纪拙劣的抄写过程中，该手稿遭受了严重的<w>窜改</w>与讹误。"
                            }
                        },
                        {
                            "text": "Scholars deplored the systematic <w>garble</w> inflicted upon the original historical records.",
                            "target_lang_translations": {
                                "zh": "学者们谴责对原始历史档案进行系统的<w>篡改</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mutilation",
                        "corruption"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a noun meaning mutilation."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "窜改；残缺；被篡改的状态"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "窜改",
                                "target_lang_sense_clarification": "文字等遭改动失真"
                            },
                            {
                                "target_lang_word": "篡改",
                                "target_lang_sense_clarification": "被非法或错误改动的行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}