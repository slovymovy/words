                "senses": [
                    {
                        "sense_id": "632adcd8-944a-33e5-837a-1e74635b1bf2",
                        "entry_id": "083f7bf4-bf63-3571-9f46-6af6dc5157f2",
                        "glosses": [
                            "Bombenflugzeug, welches die Tarnkappentechnik nutzt, um die Ortung des Flugzeugs durch Unterdrücken der vom georteten Objekt ausgesandten oder reflektierten Emissionen zu erschweren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72940878-afca-49d0-91e2-1e05310b9fdd",
                                "sense_id": "632adcd8-944a-33e5-837a-1e74635b1bf2",
                                "text": "Der modernste bekannte Tarnkappenbomber ist derzeit der B-2 Spirit Stealth Bomber der United States Air Force."
                            },
                            {
                                "example_id": "b0676b83-d46a-47f3-aede-3a7dd0db635c",
                                "sense_id": "632adcd8-944a-33e5-837a-1e74635b1bf2",
                                "text": "„Die zwei atomwaffenfähigen Tarnkappenbomber sollen der Abschreckung dienen.“"
                            },
                            {
                                "example_id": "992c1db8-76ef-427a-a117-a491acc382d6",
                                "sense_id": "632adcd8-944a-33e5-837a-1e74635b1bf2",
                                "text": "„Insgesamt verfügt die US-Luftwaffe über 21 Exemplare des Tarnkappenbombers.“"
                            },
                            {
                                "example_id": "81f07c44-a4be-4150-9604-98e16b2ecbcf",
                                "sense_id": "632adcd8-944a-33e5-837a-1e74635b1bf2",
                                "text": "„Die russische Armee präsentierte bei der Parade auf dem Roten Platz neue Waffentechnik wie Tarnkappenbomber und Kampfdrohnen – insgesamt 159 Waffentypen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
