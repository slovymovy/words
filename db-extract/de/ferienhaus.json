                        ],
                        "form": "das Ferienhaus"
                    },
                    {
                        "form_id": "9243e8ec-0028-44e9-a3c9-49ac8b04afd6",
                        "entry_id": "18053c67-098f-3a8a-84ac-49c500dbfbb4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ferienhäuser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a05e1d1a-ea8b-3aac-8b60-3cea9ef9e2b4",
                        "entry_id": "18053c67-098f-3a8a-84ac-49c500dbfbb4",
                        "glosses": [
                            "(meist kleines) Haus, das nur als vorübergehender Aufenthalt in freier Zeit genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ec7013-d122-4fe3-a9f4-c749d2f296fc",
                                "sense_id": "a05e1d1a-ea8b-3aac-8b60-3cea9ef9e2b4",
                                "text": "„Auf den Hügeln des gegenüberliegenden Ufers gingen die Lichter der unzähligen Ferienhäuser an.“"
                            },
                            {
                                "example_id": "5e9506b8-2bfa-4487-b1ad-e815dd60e55a",
                                "sense_id": "a05e1d1a-ea8b-3aac-8b60-3cea9ef9e2b4",
                                "text": "„Der alte Dorfkern mit seinen kleinen, bunten Häuschen neben der Schlucht und den engen Gassen wird zusehends von modernen Ferienhäusern eingerahmt.“"
                            },
                            {
                                "example_id": "9e834bde-8012-4483-82fd-289eadea0749",
                                "sense_id": "a05e1d1a-ea8b-3aac-8b60-3cea9ef9e2b4",
                                "text": "„Auf dem weitläufigen Gelände stehen unter Bäumen verschiedene Ferienhäuser in unterschiedlicher Größe und Ausstattung.“"
                            },
                            {
                                "example_id": "47c7b1e0-f844-4896-95b3-7d7b061cd3d1",
                                "sense_id": "a05e1d1a-ea8b-3aac-8b60-3cea9ef9e2b4",
                                "text": "„In La Baule traf sich die Schickeria, und wer es sich leisten konnte, hatte sich ein protziges Ferienhaus an die Küste gestellt.“"
                            },
                            {
                                "example_id": "7559e0b1-0f69-4c04-816e-d3d3309201f6",
                                "sense_id": "a05e1d1a-ea8b-3aac-8b60-3cea9ef9e2b4",
                                "text": "„Die Clubs und die Ferienhäuser sind fest verschlossen, ihre Zufahrtswege von Schranken versperrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fdab6e6-cd78-48ad-b57d-6a64c127b1d3",
                        "source_entry_id": "18053c67-098f-3a8a-84ac-49c500dbfbb4",
                        "source_sense_id": "a05e1d1a-ea8b-3aac-8b60-3cea9ef9e2b4",
