                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82dacc87-0440-4283-bcd6-331fd63d0563",
                                "sense_id": "bb353b3a-f2fd-3077-99f4-ebbfb11491ab",
                                "text": "Dans ces conditions, la dépendaison devient un acte hautement politique traduisant une opposition violente au régime, cette action réfutant l’autorité judiciaire du roi."
                            },
                            {
                                "example_id": "920c8039-dfe4-4e60-bd9a-3ff6026b22ac",
                                "sense_id": "bb353b3a-f2fd-3077-99f4-ebbfb11491ab",
                                "text": "La mort a fait son œuvre ; cependant, le médecin ordonne que la dépendaison n’ai lieu qu’à 11 h 50 et que le corps soit conduit à la morgue de l’hôpital."
                            },
                            {
                                "example_id": "2eb5b753-f3ca-4cc3-b51c-f15262110493",
                                "sense_id": "bb353b3a-f2fd-3077-99f4-ebbfb11491ab",
                                "text": "La pendaison et la dépendaison de Turnil ont fourni à l’auteur un excellent passage semi-dramatique, semi-grotesque."
                            }
                        ]
