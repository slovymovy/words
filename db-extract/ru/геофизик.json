                                        "glosses": [
                                            "A physicist who specializes in geophysics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbc20c67-6901-455d-83d8-cf31e271ac1f",
                                                "sense_id": "02139182-4343-34df-8a73-f4128b57499b",
                                                "text": "Yevgeny K. Fedorov, one of the Soviet Union's leading geophysicists, died Wednesday, Tass, the official press agency, reported today. He was 71 years old."
                                            },
                                            {
                                                "example_id": "24846c57-4614-4461-8ff4-a64c6e3fbd19",
                                                "sense_id": "02139182-4343-34df-8a73-f4128b57499b",
                                                "text": "“The lack of an agreement to phase out fossil fuels was devastating,” said Prof Michael Mann, a climatologist and geophysicist at the University of Pennsylvania in the US."
                                            }
