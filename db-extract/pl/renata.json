                "senses": [
                    {
                        "sense_id": "891eb637-e69b-3ee6-86f5-00880ab677fa",
                        "entry_id": "19fbcd5c-3c25-373f-8791-0b8ba781a6a9",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdb1fe0c-72b3-4ca6-a8ee-2cc3b845cff3",
                                "sense_id": "891eb637-e69b-3ee6-86f5-00880ab677fa",
                                "text": "Czy pani Renata zajmuje się slawistyką, czy digitalizacją w bibliotece cyfrowej?"
                            },
                            {
                                "example_id": "80fdf999-961a-4ee5-b841-e0ea1549aed3",
                                "sense_id": "891eb637-e69b-3ee6-86f5-00880ab677fa",
                                "text": "U nas propozycje małżeńskie składa się przeważnie mimochodem w łóżku, pod zgubnym wpływem seksualnego zadowolenia. Ale co było robić? Zwabić Alicję do mego pokoiku i zgwałcić na tapczanie Renaty?"
                            },
                            {
                                "example_id": "39d4e1b9-38de-48db-9206-9539b4abbcfb",
                                "sense_id": "891eb637-e69b-3ee6-86f5-00880ab677fa",
                                "text": "Zadzwoniono do drzwi i Renata wprowadziła mężczyznę o zmiętym wyglądzie i biegających nerwowo oczkach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
