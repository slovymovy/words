                    {
                        "translation_id": "650c6c79-908e-4dc1-8f3e-980648839482",
                        "source_entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
                        "source_sense_description": "in order of time from the earliest to the latest",
                        "target_lang_word": "chronologisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronologisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "685c3a91-4c6b-35e3-b591-5cee29eec315",
                                        "entry_id": "2be478d3-1fb4-3642-888b-68c619ce4f3b",
                                        "glosses": [
                                            "naar tijdstip gerangschikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a757f7-6c2d-42b6-996c-fba8088354c2",
                                                "sense_id": "685c3a91-4c6b-35e3-b591-5cee29eec315",
                                                "text": "We hebben ons niet strikt aan de chronologische volgorde gehouden."
                                            },
                                            {
                                                "example_id": "0864b2ac-a3e4-45ff-bffe-575e0b4a9ac4",
                                                "sense_id": "685c3a91-4c6b-35e3-b591-5cee29eec315",
                                                "text": "Er werkten veel en uiteenlopende Rubensspecialisten mee, meer dan aan bijvoorbeeld het Rembrandt Research Project, waarmee het Antwerpse project vaak wordt vergeleken. McGrath: „Dat onderzoek was veel kleiner, werkte chronologisch en focuste ook meer op toeschrijving van.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baf8f249-e88a-3395-a69b-a7ae5bb2dca6",
                                        "entry_id": "2be478d3-1fb4-3642-888b-68c619ce4f3b",
                                        "glosses": [
                                            "tijdrekenkundig"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7739f689-1b64-43aa-bedc-6758120a8f30",
                        "source_entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
                        "source_sense_description": "in order of time from the earliest to the latest",
                        "target_lang_word": "chronologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                        "entry_id": "88009291-be3c-3693-908c-d9b1a7a2953e",
                                        "glosses": [
                                            "Relatif à la chronologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ea9aac-0090-4456-810b-c8f530fa63a8",
                                                "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                                "text": "C'est l’annaliste L. Calpurnius Pison (suivi par Denys) qui, à la suite de calculs chronologiques, faisait de Tarquin l’Ancien l’aïeul de Lucius."
                                            },
                                            {
                                                "example_id": "a76e0df0-5450-406d-9b62-fc4a77067bca",
                                                "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                                "text": "Nous avons présenté cette histoire, non dans une successivité véritablement chronologique, mais dans un ordre d’heuristicité croissante."
                                            },
                                            {
                                                "example_id": "6875e992-691e-4a22-bdc7-d25edd17a490",
                                                "sense_id": "0e78f38e-00ff-31cd-815d-a834492d99f6",
                                                "text": "Nous proposons alors une approche chronologique en nous appuyant sur une nouvelle datation et sur la corrélation avec les stades des Alpes orientales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc37266d-3036-46ad-beef-0d8305f03f1e",
                        "source_entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
                        "source_sense_description": "in order of time from the earliest to the latest",
                        "target_lang_word": "chronologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbd47ea3-a2f6-3233-8655-efc923e3b295",
                                        "entry_id": "bda76647-f568-3658-b493-c8c8ca1a9d97",
                                        "glosses": [
                                            "in zeitlicher Reihenfolge geordnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8383e64c-de81-47a9-86e0-d7cdc31c6710",
                                                "sense_id": "cbd47ea3-a2f6-3233-8655-efc923e3b295",
                                                "text": "„Die beiden Ausstellungen zeigen schön, wie vielseitig Rauch in der Variation seiner Malerei ist. Andererseits verdrängt man durch den Verzicht auf eine chronologische Anordnung, dass der Maler kein wirkliches Frühwerk besitzt.“"
                                            },
                                            {
                                                "example_id": "9126cf95-eb01-45d2-a1fc-847557995630",
                                                "sense_id": "cbd47ea3-a2f6-3233-8655-efc923e3b295",
                                                "text": "„Das Leben war eher ein Tappen von Falle zu Falle. Dem wird die Form des Buches dadurch gerecht, dass, bei chronologischer Grundanlage, immer wieder ein Blatt dazwischenliegt, das die Chronologie durchbricht. Meistens öffnen sich dann Abgründe.“"
                                            },
                                            {
                                                "example_id": "906534c1-2a42-4ff2-8944-4f8e931abf72",
                                                "sense_id": "cbd47ea3-a2f6-3233-8655-efc923e3b295",
                                                "text": "„In dem umfangreichen Werk werden nach Verlagsangaben zum ersten Mal alle 291 noch erhaltenen Einfamilienhäuser des Architekten vorgestellt. Essayistisch begleiten Experten wie die Architekturhistoriker Kenneth Frampton und Kathryn Smith den chronologischen Gang durch Wrights Lebenswerk.“"
                                            },
                                            {
                                                "example_id": "50976266-4988-43b6-8e04-ee130d460e17",
                                                "sense_id": "cbd47ea3-a2f6-3233-8655-efc923e3b295",
                                                "text": "„So haben die Mehrheitsfraktionen CDU und FDP durchgesetzt, dass die Asse-Geschichte im Untersuchungsausschuss chronologisch aufgearbeitet wird. Vergeblich hatten SPD, Grüne und Linke darauf gedrängt, dass zunächst geklärt wird, welche Stoffe überhaupt in der Asse lagern.“"
                                            },
                                            {
                                                "example_id": "12ef69ac-86f4-4559-a91d-fd13451ce5e9",
                                                "sense_id": "cbd47ea3-a2f6-3233-8655-efc923e3b295",
                                                "text": "„So ist der gesellschaftliche und historische Kontext des Romans, der das Schicksal von Hans Sievez bis in die 70er Jahre verfolgt, kaum sichtbar und allenfalls ahnbar, beispielsweise durch den Bau eines Wellness-Bades neben der Gärtnerei. Die Zeit scheint in diesem Roman trotz seiner chronologischen Dramaturgie beängstigend und bedrohlich still zu stehen.“"
                                            },
                                            {
                                                "example_id": "448055d7-a20a-43b3-a804-0aa1031c6c53",
                                                "sense_id": "cbd47ea3-a2f6-3233-8655-efc923e3b295",
                                                "text": "„Seine Romane verfügen über deutlich geordnetere und chronologischere narrative Strukturen als z.B. die parallel vom Suhrkamp Verlag veröffentlichen Texte Rave von Rainald Goetz und Gut laut von Andreas Neumeister.“"
                                            },
                                            {
                                                "example_id": "ccbdeb37-5a56-48ab-9aee-fab2d6bcf189",
                                                "sense_id": "cbd47ea3-a2f6-3233-8655-efc923e3b295",
                                                "text": "„Den Nachvollzug dieser Traditionslinie hätte eine etwas chronologischere Anordnung der Beiträge erleichtert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "754b6636-f1f4-46f0-ac08-bc7e8215c920",
                        "source_entry_id": "83df61e0-3c3e-30d0-a689-4f68572d72bb",
