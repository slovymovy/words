{
    "word_family": [
        "drobiazgowy",
        "drobiazgowość",
        "drobny",
        "drobina",
        "drobić"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "11fa6bff-e38d-3a2e-b4e2-db7fde2fec8b",
                    "sense_definition": "mały przedmiot o niewielkiej wartości materialnej lub użytkowej",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przedmiot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W szufladzie biurka trzymam tylko różne podręczne <w>drobiazgi</w> i stare paragony.",
                            "target_lang_translations": {
                                "ru": "В ящике письменного стола я держу только всякие подручные <w>мелочи</w> и старые чеки."
                            }
                        },
                        {
                            "text": "Przed wyjazdem kupiłem na targu kilka pamiątkowych <w>drobiazgów</w> dla znajomych.",
                            "target_lang_translations": {
                                "ru": "Перед отъездом я купил на рынке несколько памятных <w>безделушек</w> для знакомых."
                            }
                        }
                    ],
                    "synonyms": [
                        "cacko",
                        "detal"
                    ],
                    "common_phrases": [
                        "różne drobiazgi",
                        "pamiątkowe drobiazgi"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой предмет небольшой материальной или практической ценности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелочь",
                                "target_lang_sense_clarification": "небольшая вещь или безделушка"
                            },
                            {
                                "target_lang_word": "безделушка",
                                "target_lang_sense_clarification": "мелкая декоративная или сувенирная вещь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d02c793-7d4e-32c4-97ee-e3cdaa2d2fc5",
                    "sense_definition": "sprawa, kwestia lub zdarzenie o małym, nieistotnym znaczeniu",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "znaczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie powinniśmy kłócić się o taki <w>drobiazg</w>, gdy mamy ważniejsze sprawy.",
                            "target_lang_translations": {
                                "ru": "Нам не стоит ссориться из-за такого <w>пустяка</w>, когда у нас есть дела поважнее."
                            }
                        },
                        {
                            "text": "Nie martw się skaleczeniem, to naprawdę zwykły <w>drobiazg</w>.",
                            "target_lang_translations": {
                                "ru": "Не переживай из-за пореза, это правда сущая <w>мелочь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bagatela",
                        "błahostka",
                        "drobnostka",
                        "głupstwo"
                    ],
                    "common_phrases": [
                        "kłócić się o drobiazg",
                        "zwykły drobiazg"
                    ],
                    "target_lang_definitions": {
                        "ru": "дело, вопрос или событие маловажного, несущественного значения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелочь",
                                "target_lang_sense_clarification": "незначительное дело, пустяк"
                            },
                            {
                                "target_lang_word": "пустяк",
                                "target_lang_sense_clarification": "несущественное обстоятельство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "634760d2-fdd0-39e7-aab6-796e660b410f",
                    "sense_definition": "dawne określenie na ptactwo domowe; <w>drób</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zwierzęta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodarz wyszedł rano na podwórze, aby nakarmić zgromadzony tam <w>drobiazg</w>.",
                            "target_lang_translations": {
                                "ru": "Хозяин утром вышел во двор, чтобы покормить собравшуюся там <w>птицу</w>."
                            }
                        },
                        {
                            "text": "W starych księgach wiejskich wspominano o hodowli różnego <w>drobiazgu</w>.",
                            "target_lang_translations": {
                                "ru": "В старых сельских книгах упоминалось о разведении разной <w>мелкой живности</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drób"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historyczne lub przestarzałe znaczenie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "устаревшее собирательное обозначение домашней птицы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "птица",
                                "target_lang_sense_clarification": "домашняя птица (собирательно)"
                            },
                            {
                                "target_lang_word": "мелкая живность",
                                "target_lang_sense_clarification": "домашняя птица и мелкие животные"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "f77774d3-b653-364d-ac83-b9c517f97c38",
                    "sense_definition": "używane w odpowiedzi na podziękowanie lub przeprosiny: nie ma za co, to nic wielkiego",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziękuję bardzo za pomoc przy wnoszeniu walizki, to dla mnie <w>drobiazg</w>!",
                            "target_lang_translations": {
                                "ru": "Большое спасибо за помощь с чемоданом! — Для меня это <w>пустяки</w>!"
                            }
                        },
                        {
                            "text": "Przepraszam, że musiałeś na mnie czekać, ale to naprawdę <w>drobiazg</w>.",
                            "target_lang_translations": {
                                "ru": "Извини, что тебе пришлось меня ждать. — Да это правда <w>мелочи</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ale drobiazg"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane potocznie jako formuła grzecznościowa"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "вежливая реплика в ответ на благодарность или извинения: пустяки, не стоит благодарности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустяки",
                                "target_lang_sense_clarification": "в ответ на «спасибо» или «извините»"
                            },
                            {
                                "target_lang_word": "не за что",
                                "target_lang_sense_clarification": "формула вежливости"
                            },
                            {
                                "target_lang_word": "мелочи",
                                "target_lang_sense_clarification": "разговорное выражение вежливости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}