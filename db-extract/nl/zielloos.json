                            {
                                "example_id": "60207949-8f9f-4f4f-993c-0990a42ac1bf",
                                "sense_id": "789b1380-eb1d-382c-a1e9-00fdf5ee8595",
                                "text": "Zijn zielloze lichaam werd later in het ravijn aangetroffen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b170bfb2-bc94-340c-96fe-53ebb819074d",
                        "entry_id": "2ba3e3ee-d94a-3116-ae6c-4986585cf634",
                        "glosses": [
                            "zonder innerlijke waarde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e84ef839-37d7-4c08-842f-3bd43d1bebb1",
                                "sense_id": "b170bfb2-bc94-340c-96fe-53ebb819074d",
                                "text": "De volgende stop is dan Bar VIP, eigendom van de familie Messi. De bar is dicht, de journalist staart ontnuchterd naar de vaalblauwe parasols en de zielloze hipheid van de zaak. En weer: nergens iets dat aan Messi doet denken. Niet eens een naam."
                            }
                        ]
