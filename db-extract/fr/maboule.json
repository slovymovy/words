                        "examples": [
                            {
                                "example_id": "7f8247eb-08ec-4b49-9fec-4f41819ccce6",
                                "sense_id": "883d1a96-345b-3ff4-8223-a2b740593a59",
                                "text": "De la réponse de Phili je perçus le mot « maboule ». Un gendre d’Hubert, celui qui ne parle presque jamais, dit d’une voix étranglée :\n— Je vous prie d’être poli avec ma belle-mère."
                            },
                            {
                                "example_id": "9afc2173-2374-4c1b-8b80-9dddf7c4c068",
                                "sense_id": "883d1a96-345b-3ff4-8223-a2b740593a59",
                                "text": "Elle m’emmène à l’arrière de son scooter et roule vraiment comme une maboule."
                            }
                        ]
                    }
