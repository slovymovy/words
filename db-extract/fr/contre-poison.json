                "senses": [
                    {
                        "sense_id": "1d235ab7-0e18-375f-a53a-2d22447afeb2",
                        "entry_id": "d96dec82-8b01-3c48-8f3b-ce88e7dca6d1",
                        "glosses": [
                            "Substance qui est peu nuisible ou qui ne l’est pas à l’économie, et qui, ingérée dans les voies digestives, y neutralise le poison de la même façon qu’elle ferait dans un vase de laboratoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f3922ea-990a-48dc-8524-f14763caa7ea",
                                "sense_id": "1d235ab7-0e18-375f-a53a-2d22447afeb2",
                                "text": "Il donnait du contre-poison à ce pauvre mari."
                            },
                            {
                                "example_id": "8be92215-bd3a-4d26-9155-8eaaf398454b",
                                "sense_id": "1d235ab7-0e18-375f-a53a-2d22447afeb2",
                                "text": "Elle prit du contre-poison qu’une vieille femme lui avait fourni."
                            }
                        ]
                    },
                    {
                        "sense_id": "edd3657c-1762-3873-b0d3-e54244dac7be",
                        "entry_id": "d96dec82-8b01-3c48-8f3b-ce88e7dca6d1",
                        "glosses": [
                            "Remède."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "26220be3-32bb-4609-9728-d51a474063db",
                                "sense_id": "edd3657c-1762-3873-b0d3-e54244dac7be",
                                "text": "Le caprice est dans les femmes tout proche de la beauté, pour être son contre-poison, et afin qu’elle nuise moins aux hommes, qui n’en guériraient pas sans remède."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fee9daa-1194-41b8-870d-2c3e56c38553",
                        "source_entry_id": "d96dec82-8b01-3c48-8f3b-ce88e7dca6d1",
                        "target_lang_word": "antidote",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antidote",
