            "pos": "noun",
            "senses": [
                {
                    "sense_id": "391e68b3-38d2-3ec3-972f-d8180ec38003",
                    "sense_definition": "Disposition affective ou état d'esprit passager ou habituel d'une personne.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "etat_esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce matin, le professeur est de très bonne <w>humeur</w> avec tous ses élèves."
                        },
                        {
                            "text": "Elle est souvent de mauvaise <w>humeur</w> quand elle ne dort pas assez la nuit."
                        }
                    ],
                    "common_phrases": [
                        "bonne humeur",
                        "mauvaise humeur",
                        "sautes d'humeur"
                    ]
                },
                {
                    "sense_id": "8aebd18d-c1e9-375a-b160-2fa0504863d7",
                    "sense_definition": "Mouvement d'irritation, de dépit ou de mécontentement passager.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "etat_esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a eu un geste d'<w>humeur</w> en apprenant le nouveau retard de son train."
                        },
                        {
                            "text": "Face à ces remarques désobligeantes, la directrice n'a pas pu dissimuler son <w>humeur</w>."
                        }
                    ],
                    "common_phrases": [
                        "mouvement d'humeur",
                        "accès d'humeur"
                    ]
                },
                {
                    "sense_id": "b91eccaa-6068-32c8-a817-02abd694f8ff",
                    "sense_definition": "Substance liquide ou fluide sécrétée dans un organisme vivant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fluide_biologique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>humeur</w> aqueuse permet de maintenir la pression normale à l'intérieur de l'œil."
                        },
                        {
                            "text": "La théorie médicale antique affirmait que la santé dépendait de quatre <w>humeurs</w> fondamentales."
                        }
                    ],
                    "common_phrases": [
                        "humeur aqueuse",
                        "humeur vitrée"
                    ]
                },
                {
                    "sense_id": "d1c92414-1386-34d8-bc8d-fd23e642fd6c",
                    "sense_definition": "Personne qui hume, qui aspire des odeurs ou des vapeurs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>humeur</w> professionnel de café parvient à reconnaître les arômes les plus subtils."
                        },
                        {
                            "text": "L'<w>humeur</w> de vin respire attentivement le bouquet avant de tremper ses lèvres dans le verre."
                        }
                    ]
                }
            ]
        }
