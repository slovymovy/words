    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7f36b444-728f-316d-9e9d-c2a2b3e19282",
                "word": "apiece",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "169f35aa-4959-3142-9bcf-4f63a09c01bf",
                        "entry_id": "7f36b444-728f-316d-9e9d-c2a2b3e19282",
                        "glosses": [
                            "Each by itself; for or to each one."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f9c1f208-39b6-4d30-9d8f-d3f071dbc36f",
                                "sense_id": "169f35aa-4959-3142-9bcf-4f63a09c01bf",
                                "text": "These melons cost a dollar apiece."
                            },
                            {
                                "example_id": "03fb0f12-bd8b-4230-9cc3-c5e8e510a9f6",
                                "sense_id": "169f35aa-4959-3142-9bcf-4f63a09c01bf",
                                "text": "The engines were built in the Doncaster works at what I believe to have been the low cost, even for those days, of £2,500 apiece, [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "734adc0a-b12c-39b2-890c-f5f7db76522c",
                        "entry_id": "7f36b444-728f-316d-9e9d-c2a2b3e19282",
                        "glosses": [
                            "An undetermined distance."
                        ],
                        "tags": [
                            "Maine",
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "353eaece-af70-4cef-af10-cc0f1f54166c",
                        "source_entry_id": "7f36b444-728f-316d-9e9d-c2a2b3e19282",
