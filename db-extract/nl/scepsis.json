                        "examples": [
                            {
                                "example_id": "42cc0c2c-4124-4187-af89-7d1b9650757c",
                                "sense_id": "c4f417a8-0190-36e2-a2b5-f554e175a6d3",
                                "text": "Hij had grote scepsis bij wat de fantast hem allemaal op de mouw probeerde te spelden."
                            },
                            {
                                "example_id": "8b4889f2-fde7-4870-80a3-4ca88069ea49",
                                "sense_id": "c4f417a8-0190-36e2-a2b5-f554e175a6d3",
                                "text": "Hij had grote scepsis bij de kansen op genezing van zijn zieke vrouw."
                            },
                            {
                                "example_id": "c18b373f-fc3a-4419-a6a3-68114ef809cc",
                                "sense_id": "c4f417a8-0190-36e2-a2b5-f554e175a6d3",
                                "text": "Tegen de heuvels rond Maastricht werden vijftig jaar geleden de eerste wijnranken aangelegd. Toen werd er nog met scepsis tegen wijnbouw in Nederland aangekeken. Inmiddels is het zelfs voor de Moezel- en Elzasdruiven, zoals Müller-Thurgau, Riesling en Pinot Gris, te warm geworden op het zuidelijk deel van wijngaard."
                            }
                        ]
                    }
