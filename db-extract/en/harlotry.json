                        "entry_id": "79898059-4bc2-3fcd-9b9d-08c85a8292b9",
                        "glosses": [
                            "The trade of a harlot; prostitution."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8d42f774-a007-404a-aeb1-21c4c7729921",
                                "sense_id": "61517521-4a62-348c-9d64-1063ffe767fe",
                                "text": "She fell in with bad companions, and became addicted to drink, going from bad to worse until drunkenness, robbery, and harlotry brought her to the lowest depths."
                            },
                            {
                                "example_id": "c03816f5-8c89-47e8-ba47-b0c7fc591cbe",
                                "sense_id": "61517521-4a62-348c-9d64-1063ffe767fe",
                                "text": "Harlotry, wine, and new wine take away the understanding."
                            },
                            {
                                "example_id": "f52ea73e-e79c-422b-b1a1-482cebbf1773",
                                "sense_id": "61517521-4a62-348c-9d64-1063ffe767fe",
                                "text": "Harlotry, wine, and new wine enslave the heart."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a6e290d-948d-4c63-bd10-d00e253da032",
                        "source_entry_id": "79898059-4bc2-3fcd-9b9d-08c85a8292b9",
