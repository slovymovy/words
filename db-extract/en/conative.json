                                "target_senses": [
                                    {
                                        "sense_id": "0d1cc3c5-66e4-3a81-af46-8864ba4587c5",
                                        "entry_id": "f6656324-dabf-3e78-b2e8-503d1b1a3e3d",
                                        "glosses": [
                                            "im Wesen antriebhaft, strebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1004de-7985-4fdb-b0ce-c7b04fbb6208",
                                                "sense_id": "0d1cc3c5-66e4-3a81-af46-8864ba4587c5",
                                                "text": "Im vorliegenden Zustand ist der Wunsch jedoch konativ also antreibend, da der Sachverhalt als hervorzubringend begriffen wird."
                                            },
                                            {
                                                "example_id": "4aa8db41-a6e7-4081-a4f4-00a723195dae",
                                                "sense_id": "0d1cc3c5-66e4-3a81-af46-8864ba4587c5",
                                                "text": "Konative Beeinflussungen der Informationsverarbeitung sieht Kroppenberg z. B. in der selektiven Wahrnehmung entsprechend der Antriebssituation."
                                            },
                                            {
                                                "example_id": "c27adea1-39a5-42f7-9e27-653b4aedcc4b",
                                                "sense_id": "0d1cc3c5-66e4-3a81-af46-8864ba4587c5",
                                                "text": "Werbewirkungen auf konativer Ebene soll Kaufneigung, also eine Handlungsabsicht, Kauf und Verwendung eines Produkts initiieren."
                                            },
                                            {
                                                "example_id": "081d8cce-afa4-4a09-8d45-b58b0cfbcacc",
                                                "sense_id": "0d1cc3c5-66e4-3a81-af46-8864ba4587c5",
                                                "text": "Konative Ziele zielen speziell auf die Auslösung von Verhaltensabsichten beim Konsumenten."
                                            },
                                            {
                                                "example_id": "3e6a8790-a065-41aa-b60d-4d96439c057d",
                                                "sense_id": "0d1cc3c5-66e4-3a81-af46-8864ba4587c5",
                                                "text": "Die konative Ebene ermittelt schließlich die innere Aktivierung und die Einbettung bzw. Nutzung des Imageobjekts - zum Beispiel eine spezielle Marke - im Lebens- bzw. Geschäftsalltag."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
