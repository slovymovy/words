            "senses": [
                {
                    "sense_id": "e60da6e1-0255-3c50-89c0-c646ed450aa1",
                    "sense_definition": "iets in de openbaarheid brengen of algemeen bekend laten worden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bekendmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Men wilde het nieuws over de fusie nog niet <w>ruchten</w> voordat de contracten getekend waren.",
                            "target_lang_translations": {
                                "en": "They did not want to <w>spread</w> the news about the merger yet before the contracts were signed."
                            }
                        },
                        {
                            "text": "Het is niet verstandig om dit geheim overal te <w>ruchten</w>.",
                            "target_lang_translations": {
                                "en": "It is not wise to <w>publicize</w> this secret everywhere."
                            }
                        }
                    ],
                    "synonyms": [
                        "bekendmaken",
                        "uitlekken"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly used in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To bring something into the public eye or make it generally known."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to spread",
                                "target_lang_sense_clarification": "to make news or information known to many people"
                            },
                            {
                                "target_lang_word": "to publicize",
                                "target_lang_sense_clarification": "to make something public or widely known"
                            },
                            {
                                "target_lang_word": "to broadcast",
                                "target_lang_sense_clarification": "to tell many people about something"
                            }
                        ]
                    }
                },
                {
