                ],
                "senses": [
                    {
                        "sense_id": "08fe508a-b543-3eff-8437-9ca8ba4794df",
                        "entry_id": "02183c55-39a4-3cf7-b005-b9c0d2e74da8",
                        "glosses": [
                            "Anzahl der unterschiedlichen Einzelbilder pro Zeiteinheit, aus denen ein Film oder ein anderes bewegtes Bild besteht"
                        ],
                        "tags": [
                            "Filmtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "8dff3577-ff42-4d5a-bfe5-d42ec5640387",
                                "sense_id": "08fe508a-b543-3eff-8437-9ca8ba4794df",
                                "text": "„Die Bildwechselrate kann von 25 Bildern pro Sekunde bis zu 60 Bildern pro Sekunde eingestellt werden.“"
                            },
                            {
                                "example_id": "c360ebfe-e8b5-4fca-9f7f-2499f7c1396c",
                                "sense_id": "08fe508a-b543-3eff-8437-9ca8ba4794df",
                                "text": "„Mit einer Bildwechselrate von wahlweise 60 oder 120Hz erreicht sie einen Dynamikbereich von 12Bit; bei der vollen Bildfrequenz von 350Hz liegt die Dynamik bei 14Bit.“"
                            },
                            {
                                "example_id": "831185e1-e81c-4761-bc78-c5e2c9163a39",
                                "sense_id": "08fe508a-b543-3eff-8437-9ca8ba4794df",
                                "text": "„Muss bei der Konvertierung von Abtastformaten gleichzeitig die Bildwechselrate, zum Beispiel von 60 nach 50 Hz, gewandelt werden, so spricht man von einer Standard-Konvertierung.“"
                            },
                            {
                                "example_id": "ec86c6e6-996d-4b44-8753-0622b65f7297",
                                "sense_id": "08fe508a-b543-3eff-8437-9ca8ba4794df",
                                "text": "„Um den ungeheuren Umfang der holografisch gespeicherten Daten so schnell wie möglich und mit angemessener Qualität auszulesen, ist ein hochauflösender CMOS-Bildsensor mit hoher Bildwechselrate nötig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
