                "senses": [
                    {
                        "sense_id": "77a0d078-da86-36ca-97d2-50f6a3773bf3",
                        "entry_id": "b794fb2c-cda4-3f08-8940-4c74f9bb3fb3",
                        "glosses": [
                            "Caractère égocentrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2336c29-489c-4791-9ac6-9e96056f1dce",
                                "sense_id": "77a0d078-da86-36ca-97d2-50f6a3773bf3",
                                "text": "La désagrégation de la famille en de multiples formes très individuelles de la vie en commun dessine aujourd'hui une société très éclatée dont les nombreuses égocentricités ne permettraient plus de générer un projet fédérateur commun."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa5f7e5c-a1ca-4f76-bba2-f36d3b95eb32",
                        "source_entry_id": "b794fb2c-cda4-3f08-8940-4c74f9bb3fb3",
                        "source_sense_id": "77a0d078-da86-36ca-97d2-50f6a3773bf3",
                        "target_lang_word": "Egozentrizität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Egozentrizität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72a10b54-8293-3ec9-b50c-c6056227a98b",
                                        "entry_id": "00e85d0e-ff6a-3b68-9b6b-947d780fa3ac",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße selbstbezogenes (egozentrisches) Verhalten zeigt; dies reicht vom philosophischen Sich-seiner-selbst-bewusst-sein bis zum ausgelebten Egoismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a64a66ff-27a9-4ae6-b3d7-a04fb879b256",
                                                "sense_id": "72a10b54-8293-3ec9-b50c-c6056227a98b",
                                                "text": "„Ich weiß um meine Wünsche, Absichten usw., und dieses Wissen ist es, das meine Egozentrizität konstituiert.“"
                                            },
                                            {
                                                "example_id": "9146c9ec-0c3e-42ac-9363-024a102f81fd",
                                                "sense_id": "72a10b54-8293-3ec9-b50c-c6056227a98b",
                                                "text": "„An Stelle der bisher herrschenden Egozentrizität Ruths tritt so die Beziehung, die auf Zusammenwirken und Respekt für den anderen beruht.“"
                                            },
                                            {
                                                "example_id": "2bde4fde-5140-4e62-b054-a59724232572",
                                                "sense_id": "72a10b54-8293-3ec9-b50c-c6056227a98b",
                                                "text": "„Ihre Egozentrizität spornt sie an, das augenblicklich Erreichbare zu ergattern, ohne dabei den wahren Wert des Zwischenmenschlichen zu bedenken.“"
                                            },
                                            {
                                                "example_id": "c992dd4f-87f1-4905-9c20-436727b27565",
                                                "sense_id": "72a10b54-8293-3ec9-b50c-c6056227a98b",
                                                "text": "„Abraham Maslow ergänzte seine bekannte Bedürfnispyramide (1943) in späteren Jahren um das Konzept der Selbsttranszendenz (1969), worunter er ein Überwinden von Egozentrizität, Egoismus und Selbstbezogenheit verstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
