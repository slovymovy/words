                        ],
                        "form": "die Nachschübe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b9d1a88-f183-36fe-a9ca-a16f87828e2f",
                        "entry_id": "8e221453-9a5b-3aa8-a85d-12a71895f095",
                        "glosses": [
                            "neues, ergänzendes Material (mit dem Truppen im Krieg versorgt werden)"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3bcf30f5-0aa8-47b4-afe1-ef80e4deef6b",
                                "sense_id": "3b9d1a88-f183-36fe-a9ca-a16f87828e2f",
                                "text": "Wir brauchen Nachschub."
                            },
                            {
                                "example_id": "8711fe63-c944-452c-a2fa-da9e7faa43c1",
                                "sense_id": "3b9d1a88-f183-36fe-a9ca-a16f87828e2f",
                                "text": "„Der erste Stoß war steckengeblieben, der Nachschub war nicht organisiert, hieß es.“"
                            },
                            {
                                "example_id": "e6f2c012-eaf4-419c-8c3c-b289c8a3a6a6",
                                "sense_id": "3b9d1a88-f183-36fe-a9ca-a16f87828e2f",
                                "text": "„Seine Aufgabe war es, die in Deutschland vorhandenen Rohstoffe, vor allem die in den Lagern privater Unternehmen, zu erfassen und zentral im Sinne der Bedürfnisse des militärischen Nachschubs zu bewirtschaften.“"
                            },
                            {
                                "example_id": "0dc3aaa0-ce12-4f85-8d1b-dd3242bdf3fa",
                                "sense_id": "3b9d1a88-f183-36fe-a9ca-a16f87828e2f",
                                "text": "„Sie brachten Kriegsgerät und Proviant aus den Danziger und Königsberger Lagern, den Nachschub für Napoleons Armee.“"
                            },
                            {
                                "example_id": "e73c4245-66e5-422d-b3e5-b5aa5fd06c28",
                                "sense_id": "3b9d1a88-f183-36fe-a9ca-a16f87828e2f",
                                "text": "„Der Nachschub von Morituri scheint immer noch zu klappen: Die Personalreserven sind offenbar noch nicht erschöpft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "19571476-c47c-3bd3-af4b-23bd11ff4757",
                        "entry_id": "8e221453-9a5b-3aa8-a85d-12a71895f095",
                        "glosses": [
                            "Beschaffung von neuem Material"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86d690a2-eba6-4261-a28a-78b05cf52105",
                                "sense_id": "19571476-c47c-3bd3-af4b-23bd11ff4757",
                                "text": "Der Nachschub gerät ins Stocken."
                            },
                            {
                                "example_id": "2df62f59-da99-43b4-b820-cb05e3fc4edd",
                                "sense_id": "19571476-c47c-3bd3-af4b-23bd11ff4757",
                                "text": "„Seit Jahrzehnten schon schaffte man ständig Nachschub über den Atlantik und den Indischen Ozean in die älteren Kolonien.“"
                            },
                            {
                                "example_id": "c044cfb8-933a-4c0c-b2a3-91d4134a817a",
                                "sense_id": "19571476-c47c-3bd3-af4b-23bd11ff4757",
                                "text": "„Als Cäsar zugetragen wurde, dass Nachschub für die Germanen unterwegs sein sollte, ergriff er die Initiative und brach mit seinen Legionen auf.“"
                            },
                            {
                                "example_id": "5516f92b-bc3c-43ff-bd2d-ca9a58a38cd2",
                                "sense_id": "19571476-c47c-3bd3-af4b-23bd11ff4757",
                                "text": "„Aber schon bald reicht der Nachschub an Kriegsgefangenen nicht mehr aus, um den Bedarf der Weißen nach Arbeitskräften zu decken.“"
                            },
                            {
                                "example_id": "dd2f7702-260f-4f5a-a390-04851abf8278",
                                "sense_id": "19571476-c47c-3bd3-af4b-23bd11ff4757",
                                "text": "„Sie liebte es, wenn es ihr gelang, einem Fremden genau das richtige Buch in die Hand zu drücken, und dieser dann zurückkam, um Nachschub bat, und zu einem Freund wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
