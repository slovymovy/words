                "senses": [
                    {
                        "sense_id": "9fd09252-5e0a-37ee-aee7-1ff5ffdf1238",
                        "entry_id": "32592d7d-2023-3cde-aaac-7f1a656badee",
                        "glosses": [
                            "spezielles Fahrzeug, das durch sein Eigengewicht und spezielle Räder den überfahrenen Müll zerkleinert und verdichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaa8daf3-3fec-4f53-9639-a32c8044b2e2",
                                "sense_id": "9fd09252-5e0a-37ee-aee7-1ff5ffdf1238",
                                "text": "„Der Abfalleinbau erfolgt, wie im Deponiebetrieb üblich, mittels Müllkompaktor im Dünnschichtverfahren.“"
                            },
                            {
                                "example_id": "b56b024c-35d8-4fb3-bc5b-4d30e5cf05d3",
                                "sense_id": "9fd09252-5e0a-37ee-aee7-1ff5ffdf1238",
                                "text": "„Der Einbau der Abfälle erfolgte mit einem 28 Tonnen schweren Müllkompaktor.“"
                            },
                            {
                                "example_id": "ebb7266d-02df-4a8b-9e6d-cfa452acdac2",
                                "sense_id": "9fd09252-5e0a-37ee-aee7-1ff5ffdf1238",
                                "text": "„Nach zehn Jahren wertvoller Dienste wurde der Zerkleinerer von einem „Müllkompaktor” abgelöst, der gleichzeitig verkleinerte, verteilte und verdichtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3560c72f-eabf-3bba-a26d-299d3950bd44",
                        "entry_id": "32592d7d-2023-3cde-aaac-7f1a656badee",
                        "glosses": [
                            "spezielle Vorrichtung, die Müll oder Abfallstoffe kompakt verdichtet und somit Platz spart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a91b9d1-9ef7-4fe4-b23c-dbe74a61ee12",
                                "sense_id": "3560c72f-eabf-3bba-a26d-299d3950bd44",
                                "text": "„Im Müllkompaktor zusammengepresstes Papier braucht weniger LKW-Fahrten.“"
                            },
                            {
                                "example_id": "eb77c6d8-1405-4f10-b19a-388074e7bc8f",
                                "sense_id": "3560c72f-eabf-3bba-a26d-299d3950bd44",
                                "text": "„Es gibt einige wichtige Trends in der Gesellschaft, die das Konto einer anderen Klasse von Geräten unter der Theke zeigen, können zusätzlich zu den Müllkompaktor und Geschirrspüler, wird einen Hauch von Kultiviertheit seiner schnellen Sanierung präsentieren.“"
