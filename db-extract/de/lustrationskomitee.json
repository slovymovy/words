                ],
                "senses": [
                    {
                        "sense_id": "fdbca702-b62d-3100-91ed-614e2ff04acd",
                        "entry_id": "2b6ff55d-c7ad-3021-9676-40e78024c828",
                        "glosses": [
                            "Gremium, das darüber entscheidet, ob politisch belastete Amtsträger und Personen im Staatsdienst weiterhin ihrer Tätigkeit nachgehen dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a18aab5-1ab5-4cbb-9acb-0e1b2abc97cb",
                                "sense_id": "fdbca702-b62d-3100-91ed-614e2ff04acd",
                                "text": "„Die Sicherheitskräfte sollen nach Wunsch des ukrainischen Lustrationskomitees unter Leitung von Jegor Sobolew wie alle anderen Staatsbediensteten unter die‚Lustration‘ fallen.“"
                            },
                            {
                                "example_id": "b3afb90a-7c0e-43d2-8de9-913a4acb85f7",
                                "sense_id": "fdbca702-b62d-3100-91ed-614e2ff04acd",
                                "text": "„Das Dokument wurde von der Expertin der Stiftung, Agneschka Piasecka, dem Vertreter des Lustrationskomitees, Maxim Mankowskij, und dem Mitglied des Bürgerrats für Lustrationsfragen, Sergej Iwanow, während einer Pressekonferenz im Ukrainischen Crisis Media Center vorgestellt.“"
                            },
                            {
                                "example_id": "d6609cf5-7186-494d-9254-2c703ea38244",
                                "sense_id": "fdbca702-b62d-3100-91ed-614e2ff04acd",
                                "text": "„Bereits im Februar hatten Aktivisten, die offenbar der Swoboda-Partei nahestehen, das Hauptquartier der Kommunisten besetzt und dort ein sogenanntes Lustrationskomitee eingerichtet.“"
                            },
                            {
                                "example_id": "6da5e06f-8ab3-4435-9afe-8eb83055f61f",
                                "sense_id": "fdbca702-b62d-3100-91ed-614e2ff04acd",
                                "text": "„Um überwintern zu können und allgemein unabhängig zu sein, forderte Iegor SOBOLIEV, Leiter des Lustrationskomitees der Ukraine, das ‚räuberische System aufzubrechen‘.“"
                            },
                            {
                                "example_id": "667619c7-49eb-4e3a-b791-6da6c68464c5",
                                "sense_id": "fdbca702-b62d-3100-91ed-614e2ff04acd",
                                "text": "„Deshalb ist ein Lustrationskomitee, das die öffentlichen Einrichtungen auf paternalistische Netzwerke der Janukowitsch-Ära und Geheimdienstbeteiligung untersuchen soll, zwar gebildet, aber nicht offiziell ernannt worden.“"
                            },
                            {
                                "example_id": "47857d79-a4ab-4722-aeae-0b884fb9dbae",
                                "sense_id": "fdbca702-b62d-3100-91ed-614e2ff04acd",
                                "text": "„Das Antikorruptionsbüro Tschornowols und das sogenannte Lustrationskomitee, das Sobolew leitet, existieren bisher weitgehend nur auf dem Papier.“"
                            },
                            {
                                "example_id": "9f6bccee-2135-4524-8344-aea46c52d9f4",
                                "sense_id": "fdbca702-b62d-3100-91ed-614e2ff04acd",
                                "text": "„Damit beschäftigt sich das so genannte Lustrationskomitee ‚Nikoli znowu‘, was, ins Deutsche übersetzt, ‚Nie wieder‘ bedeutet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
