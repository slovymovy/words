                                        "sense_id": "fc2ee7c1-95c4-3e92-a756-9da56e1f722a",
                                        "entry_id": "9eb78c09-7cc1-3b05-9afc-23cd4f8d9f63",
                                        "glosses": [
                                            "Bimode (ou bi-mode) et bicourant (ou bi-courant)."
