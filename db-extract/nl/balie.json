                        "target_lang_word": "Schalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e52bb07-224f-32de-8081-257a962b405b",
                                        "entry_id": "40da61e1-a072-3947-86bd-a75d90a31729",
                                        "glosses": [
                                            "elektrisches Bauelement zur Herstellung oder Unterbrechung einer elektrischen Verbindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfe9e737-b6ea-455f-ab86-212452965b49",
                                                "sense_id": "9e52bb07-224f-32de-8081-257a962b405b",
                                                "text": "Der Schalter für die Außenbeleuchtung ist neben der Haustür."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "39e5d7be-814b-35dd-89e3-c47763b15526",
                                        "entry_id": "40da61e1-a072-3947-86bd-a75d90a31729",
                                        "glosses": [
                                            "abgeteilter Raum oder Bereich zur Abfertigung des Publikums in einer Halle oder einem größeren Raum (zum Beispiel Bahnhof, Bank oder Post)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d108a9-f30b-4cb2-b3b3-e2e2cf83ed2f",
                                                "sense_id": "39e5d7be-814b-35dd-89e3-c47763b15526",
                                                "text": "Monatskarten können Sie an Schalter 3 kaufen."
                                            },
                                            {
                                                "example_id": "1492da2b-3835-4f07-848b-7d7aced98e08",
                                                "sense_id": "39e5d7be-814b-35dd-89e3-c47763b15526",
                                                "text": "„Der Professor war beim Schalter des Kassierers stehen geblieben, wo er sein Geld bekommen sollte.“"
                                            },
                                            {
                                                "example_id": "5e844ee5-4d53-4084-a506-61d808344da8",
                                                "sense_id": "39e5d7be-814b-35dd-89e3-c47763b15526",
                                                "text": "„Am Schalter nebenan versuchen zwei Männer abzuwenden, dass sie Aufpreis für ihr Übergepäck zahlen müssen.“"
                                            },
                                            {
                                                "example_id": "77440da7-b447-44d2-b122-ced13f7c9155",
                                                "sense_id": "39e5d7be-814b-35dd-89e3-c47763b15526",
                                                "text": "„Diese vorausentwerteten Postwertzeichen sind ausschließlich von Postbeamten am Schalter verwendet worden und wurden nie direkt ans Publikum verkauft.“"
                                            },
                                            {
                                                "example_id": "55ab5b9b-472c-4e3f-9abf-094d6cff0a65",
                                                "sense_id": "39e5d7be-814b-35dd-89e3-c47763b15526",
                                                "text": "„Die Menschen drängten sich vor dem Schalter der Transports Maritimes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
