    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c356c59b-975d-3edd-a98d-026b70216b0b",
                    "sense_definition": "Avoir une réalité, être réel et non seulement imaginé ou possible.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les licornes n'<w>existent</w> que dans les contes et les légendes."
                        },
                        {
                            "text": "Cette ville <w>existe</w> depuis plus de mille ans et elle est toujours très vivante."
                        },
                        {
                            "text": "Beaucoup d'enfants croient que le père Noël <w>existe</w> vraiment."
                        }
                    ],
                    "antonyms": [
                        "inexister"
                    ],
                    "common_phrases": [
                        "exister depuis longtemps",
                        "ne plus exister",
                        "exister vraiment"
                    ]
                },
                {
                    "sense_id": "c8bbe943-376d-3302-83ec-3955d5c3310a",
                    "sense_definition": "Se trouver quelque part ou avoir lieu, être présent dans un endroit ou dans une situation (souvent avec « il »).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>existe</w> plusieurs solutions à ce problème, mais aucune n'est parfaite."
                        },
                        {
                            "text": "Dans cette région, il <w>existe</w> de très belles prairies au bord de la rivière."
                        },
                        {
                            "text": "Des différences importantes <w>existaient</w> déjà entre les deux pays avant la guerre."
                        }
                    ],
                    "common_phrases": [
                        "exister en grand nombre",
                        "exister encore aujourd'hui"
                    ]
                },
                {
                    "sense_id": "36a1827e-bfee-35b1-b9a6-35f21b5e5e89",
                    "sense_definition": "Vivre, être en vie à un moment donné.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous n'<w>existiez</w> pas encore à cette époque."
                        },
                        {
                            "text": "Mon arrière-grand-père a cessé d'<w>exister</w> bien avant ma naissance."
                        }
                    ],
                    "synonyms": [
                        "vivre"
                    ],
                    "common_phrases": [
                        "cesser d'exister"
                    ]
                },
                {
                    "sense_id": "fa587ca6-50c1-352f-8623-ce7e8dc3cda6",
                    "sense_definition": "Compter pour quelqu'un, avoir de l'importance à ses yeux ; au négatif, ne pas être pris en considération.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour ce directeur, les petits clients n'<w>existent</w> pas, seuls les gros contrats l'intéressent."
                        },
                        {
                            "text": "Depuis son départ, j'ai l'impression de ne plus <w>exister</w> aux yeux de mes collègues."
                        }
                    ],
                    "synonyms": [
                        "compter"
                    ],
                    "common_phrases": [
                        "exister aux yeux de"
                    ]
                },
                {
                    "sense_id": "5a4ef64a-d311-3aad-ac0d-bfd5bb1ba883",
                    "sense_definition": "En philosophie, être présent dans le monde sous une forme concrète et objective, à l'extérieur de la pensée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour Sartre, <w>exister</w>, c'est d'abord être là, sans raison et sans nécessité."
                        },
                        {
                            "text": "Selon ce philosophe, ce qui est extérieur à nous <w>existe</w>, alors que nos rêveries n'ont pas la même réalité."
                        }
                    ],
                    "antonyms": [
                        "endosister"
                    ],
                    "common_phrases": [
                        "exister dans l'espace et dans le temps"
                    ]
                }
            ]
        }
    ]
}