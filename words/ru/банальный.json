{
    "word_family": [
        "банальность",
        "банально",
        "обаналить",
        "обаналивать"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68a550f1-bc52-3977-8216-793ecbe8990e",
                    "sense_definition": "потерявший новизну и выразительность от частого повторения; избитый, неоригинальный (о словах, идеях, сюжетах)",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "избитый",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его речь состояла из <w>банальных</w> фраз, которые все давно уже слышали.",
                            "target_lang_translations": {
                                "en": "His speech consisted of <w>trite</w> phrases that everyone had heard long ago."
                            }
                        },
                        {
                            "text": "Это звучит как <w>банальная</w> истина, но здоровье действительно важнее богатства.",
                            "target_lang_translations": {
                                "en": "It sounds like a <w>banal</w> truth, but health really is more important than wealth."
                            }
                        }
                    ],
                    "synonyms": [
                        "тривиальный",
                        "неоригинальный",
                        "пошлый"
                    ],
                    "antonyms": [
                        "оригинальный"
                    ],
                    "common_phrases": [
                        "банальная истина",
                        "банальные фразы",
                        "банальный сюжет"
                    ],
                    "target_lang_definitions": {
                        "en": "having lost novelty and expressiveness through frequent repetition; trite, cliché, unoriginal (of words, ideas, plots)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "banal",
                                "target_lang_sense_clarification": "unoriginal and predictable"
                            },
                            {
                                "target_lang_word": "trite",
                                "target_lang_sense_clarification": "overused and lacking original thought"
                            },
                            {
                                "target_lang_word": "hackneyed",
                                "target_lang_sense_clarification": "worn out by long overuse, cliché"
                            },
                            {
                                "target_lang_word": "corny",
                                "target_lang_sense_clarification": "hackneyed or cheesy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ab22f64-45e9-3614-ab88-c5050633b152",
                    "sense_definition": "лишённый своеобразия, ничем не выделяющийся среди других; заурядный",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "заурядный",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был самый <w>банальный</w> конфликт между соседями из-за шума по ночам.",
                            "target_lang_translations": {
                                "en": "It was the most <w>commonplace</w> dispute between neighbors over nighttime noise."
                            }
                        },
                        {
                            "text": "Преступление оказалось вполне <w>банальным</w> и лишённым какой-либо загадки.",
                            "target_lang_translations": {
                                "en": "The crime turned out to be completely <w>mundane</w> and devoid of any mystery."
                            }
                        }
                    ],
                    "synonyms": [
                        "заурядный"
                    ],
                    "antonyms": [
                        "оригинальный"
                    ],
                    "common_phrases": [
                        "банальный случай",
                        "банальная ссора"
                    ],
                    "target_lang_definitions": {
                        "en": "lacking uniqueness, indistinguishable from others; mediocre, run-of-the-mill"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "commonplace",
                                "target_lang_sense_clarification": "ordinary, lacking notable features"
                            },
                            {
                                "target_lang_word": "run-of-the-mill",
                                "target_lang_sense_clarification": "average, not special"
                            },
                            {
                                "target_lang_word": "mundane",
                                "target_lang_sense_clarification": "dull and ordinary"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11433a42-7142-30dc-a1a4-771f2cfa49f0",
                    "sense_definition": "простой, обыкновенный или повседневный",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "обыденный",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач сказал, что у пациента самая <w>банальная</w> простуда, и прописал чай с лимоном.",
                            "target_lang_translations": {
                                "en": "The doctor said that the patient had nothing more than a <w>common</w> cold and prescribed tea with lemon."
                            }
                        },
                        {
                            "text": "Иногда причиной серьёзных неудач становится <w>банальная</w> лень.",
                            "target_lang_translations": {
                                "en": "Sometimes the cause of serious failures is <w>plain</w> laziness."
                            }
                        }
                    ],
                    "synonyms": [
                        "обычный"
                    ],
                    "antonyms": [
                        "оригинальный"
                    ],
                    "common_phrases": [
                        "банальная простуда",
                        "банальная лень"
                    ],
                    "target_lang_definitions": {
                        "en": "simple, everyday, or plain; nothing extraordinary"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "common",
                                "target_lang_sense_clarification": "everyday, ordinary (e.g. common cold)"
                            },
                            {
                                "target_lang_word": "plain",
                                "target_lang_sense_clarification": "simple and unexceptional (e.g. plain laziness)"
                            },
                            {
                                "target_lang_word": "simple",
                                "target_lang_sense_clarification": "basic, ordinary"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}