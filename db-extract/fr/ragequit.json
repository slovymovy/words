                        "form_id": "8ef043c1-4eda-4285-abcb-0098fdfbb2e3",
                        "entry_id": "edfd8f2e-cf0c-3a70-b875-ece98dc85688",
                        "tags": [
                            "plural"
                        ],
                        "form": "ragequits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "167d3a1f-b8fc-3469-96b1-6386cacade6a",
                        "entry_id": "edfd8f2e-cf0c-3a70-b875-ece98dc85688",
                        "glosses": [
                            "Action de quitter un jeu de façon rageuse, à la suite d'un évènement fâcheux."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": [
                            {
                                "example_id": "03058312-b867-4ab1-b0f7-6a1657691083",
                                "sense_id": "167d3a1f-b8fc-3469-96b1-6386cacade6a",
                                "text": "On abandonne une partie de façon théâtrale, avec énervement. On peut ragequit sur un Mario, mais le ragequit se pratique surtout lors de parties en ligne lorsque l’injustice du jeu devient insupportable. Le ragequit est un geste de révolte avec toute la beauté qui l'accompagne..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ec6b791-7713-4a89-9e41-998f3bc65ac3",
                        "source_entry_id": "edfd8f2e-cf0c-3a70-b875-ece98dc85688",
                        "source_sense_id": "167d3a1f-b8fc-3469-96b1-6386cacade6a",
                        "target_lang_word": "ragequit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ragequit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e106a0b7-5105-3bc8-bbfb-124f6fe1fdf8",
                                        "entry_id": "78ffa7da-a3b6-3064-814b-60d4c6ea1295",
                                        "glosses": [
                                            "To quit an online video game in anger."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d7037af-5145-4228-9d7b-cbdcb7238dae",
                                                "sense_id": "e106a0b7-5105-3bc8-bbfb-124f6fe1fdf8",
                                                "text": "Having had my share of ragequitting teammates and unfinished campaigns -- I still haven't completed a L4D2 campaign on Expert -- I'll take a positive outlook and say that the complaints about difficulty amount to a longer and taller learning curve, that will give this game a longer lifespan than the first."
                                            },
                                            {
                                                "example_id": "a4472339-811e-4262-85d1-af6278e5ef9a",
                                                "sense_id": "e106a0b7-5105-3bc8-bbfb-124f6fe1fdf8",
                                                "text": "Cheap insta-kill attacks have made me ragequit at least twice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0e3e764-81a3-3f17-9a95-c92e66f843ff",
                                        "entry_id": "78ffa7da-a3b6-3064-814b-60d4c6ea1295",
                                        "glosses": [
                                            "To quit (something) in anger."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ragequit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab1429f9-53c5-315e-941c-cb1103b1f9dc",
                                        "entry_id": "71fb30b3-4c80-3c12-bc63-7b13b197962e",
                                        "glosses": [
                                            "The act of quitting an online video game in anger."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b0eaa47-97f8-41f5-99f0-0f807e33c27d",
                                                "sense_id": "ab1429f9-53c5-315e-941c-cb1103b1f9dc",
                                                "text": "Hardison: I don't know what happened. I had 'em and then I just—\nNate: Didn't anticipate the ragequit.\nHardison: You know gamer terminology?\nNate: I know the key to a good game is balancing boredom and frustration. Now the game — the puzzle's too easy, then the mark — the player — gets bored and walks away. The puzzle's too hard, then the player gets frustrated, and quits in a rage: ragequit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
