                ],
                "senses": [
                    {
                        "sense_id": "b1fe9f0b-b805-3563-9efd-867cf94f27fc",
                        "entry_id": "c9d0f4ec-ef1e-3160-a45c-28b52fc5f8eb",
                        "glosses": [
                            "vin d’appellation d’origine contrôlée (AOC) de la Bourgogne viticole, de vignoble situé en Saône-et-Loire sur les communes de Mercurey et de Saint-Martin-sous-Montaigu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb4aad3-f909-4bd3-97a2-aafe88400358",
                                "sense_id": "b1fe9f0b-b805-3563-9efd-867cf94f27fc",
                                "text": "Au début, avec un bon verre de mercurey, on ne parla pas des ruses et des feintes du gibier et de la malice ou de la science des chiens, mais lorsqu’on eut servi la gruillotte au chambertin, chacun raconta les choses à sa façon."
                            },
                            {
                                "example_id": "85db0ba6-10dd-4ed7-ae21-1344bd2e3fea",
                                "sense_id": "b1fe9f0b-b805-3563-9efd-867cf94f27fc",
                                "text": "J’aime ce mercurey pour l’étoffe de son fruit, sa carrure rassurante et ce granulé de terroir palpable qui allonge la finale."
                            },
                            {
                                "example_id": "bb7a3d3f-a4b1-4a37-8f8e-825f58fd8069",
                                "sense_id": "b1fe9f0b-b805-3563-9efd-867cf94f27fc",
                                "text": "Attention, on ne prenait pas des cuites mais ça a été le premier à me faire boire un vrai bon vin. C’était un bourgogne, un mercurey rouge."
                            },
                            {
                                "example_id": "fb4b9305-9123-4832-a14b-9cd237b5f980",
                                "sense_id": "b1fe9f0b-b805-3563-9efd-867cf94f27fc",
                                "text": "Les assiettes à dessert sont restées sur la table, et la bouteille de mercurey. On hésite à reprendre un verre, et puis oui. Tous les rites qui peuvent allonger le soir sont bienvenus."
                            }
                        ]
                    }
                ],
