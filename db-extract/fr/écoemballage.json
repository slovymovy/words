                                            {
                                                "example_id": "85bd86ec-3d18-41d0-8c4d-a17d78a55692",
                                                "sense_id": "b3f61998-01ca-36d0-a1a8-ef1fb8436bc7",
                                                "text": "Das neue umweltfreundliche Verfahren spart gleichzeitig erhebliche Kosten."
                                            },
                                            {
                                                "example_id": "d73e7c60-4e1d-4e8a-b0a6-a0f632297af5",
                                                "sense_id": "b3f61998-01ca-36d0-a1a8-ef1fb8436bc7",
                                                "text": "„Schon seit Jahren arbeiten Reifenhersteller daran, ihre Reifen umweltfreundlicher und nachhaltiger herzustellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
