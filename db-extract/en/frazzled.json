                "senses": [
                    {
                        "sense_id": "fcbeefbf-0359-344a-88d4-a0997dc699d4",
                        "entry_id": "de911ad6-1365-32ed-aa49-1b4f00782c7c",
                        "glosses": [
                            "Frayed at the edges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "400b0851-e8d8-4199-a7c2-98e534504cf1",
                                "sense_id": "fcbeefbf-0359-344a-88d4-a0997dc699d4",
                                "text": "Everyone believes that Thomas would…plant the frazzled banner of the distillers in its place."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f201c29-0e94-3c94-8c99-069430757cd3",
                        "entry_id": "de911ad6-1365-32ed-aa49-1b4f00782c7c",
                        "glosses": [
                            "Stressed and exhausted (either physically or emotionally)."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "dd357e99-68ea-4598-823a-3690f5c57efb",
                                "sense_id": "4f201c29-0e94-3c94-8c99-069430757cd3",
                                "text": "George Smith this cool morning, hungover, mouth dry, head throbbing.\n\"I just asked for the time.\"\n\"Twelve thirty.\"\n\"Thank you. Don't come in. I'm indelicate. Utterly frazzled. After being vaguely champion. I think. Last night. O God.\""
                            },
                            {
                                "example_id": "57b4433f-3fae-4a37-bb7e-1dac3ed7bf87",
                                "sense_id": "4f201c29-0e94-3c94-8c99-069430757cd3",
                                "text": "“These are extreme measures people are taking because they’re frazzled by what’s happening in the industry,” he said."
                            },
                            {
                                "example_id": "e137823d-417d-408c-a274-7c3858953799",
                                "sense_id": "4f201c29-0e94-3c94-8c99-069430757cd3",
                                "text": "\"Of course it's me, who else would it be?\" The voice sounded only half-certain. \"Who else would still be here? Unless you're one of the ones who's still here. Is that when you are? OKAY. Stop talking. Stop talking. Speak only when spoken to, so we can get through this. Who. Are. You.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15d00842-4310-4d78-83fb-3d6702f197f8",
                        "source_entry_id": "de911ad6-1365-32ed-aa49-1b4f00782c7c",
                        "source_sense_description": "stressed, exhausted",
                        "target_lang_word": "erschöpft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erschöpft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e61e76f9-3d68-35be-b5e9-5ae6df0b9b18",
                                        "entry_id": "6fb73dd7-4f68-3b3d-a055-85aed9e72efa",
                                        "glosses": [
                                            "sehr müde und ausgelaugt sein"
                                        ],
                                        "tags": [
                                            "von Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe37d64-2b79-4638-b737-6ca2a479f55f",
                                                "sense_id": "e61e76f9-3d68-35be-b5e9-5ae6df0b9b18",
                                                "text": "Nach dem Fußballspiel gingen die Spieler erschöpft in die Kabinen."
                                            },
                                            {
                                                "example_id": "5aa49829-8363-463f-8ad4-86e8ac1b5d76",
                                                "sense_id": "e61e76f9-3d68-35be-b5e9-5ae6df0b9b18",
                                                "text": "[Skilanglauf: Im Ziel] „fiel er völlig erschöpft in den Schnee, blieb ausgepumpt liegen und musste schließlich von Helfern aus dem Zielraum gebracht werden.“"
                                            },
                                            {
                                                "example_id": "cda3f0f7-6e82-45c6-a0a3-f6d238b866d4",
                                                "sense_id": "e61e76f9-3d68-35be-b5e9-5ae6df0b9b18",
                                                "text": "„Er sah erschöpft aus, entspannte sich jedoch und schlief wieder ein.“"
                                            },
                                            {
                                                "example_id": "79600627-c468-4ba2-8941-06eb708eeca4",
                                                "sense_id": "e61e76f9-3d68-35be-b5e9-5ae6df0b9b18",
                                                "text": "„»Ich war psychisch erschöpft.«“"
                                            },
                                            {
                                                "example_id": "82d7c4c4-f3de-413d-90c0-97360119b962",
                                                "sense_id": "e61e76f9-3d68-35be-b5e9-5ae6df0b9b18",
                                                "text": "[Coronapandemie 2021:] „Mein Glück war, dass ich vor einem Jahr von Pflegekräften umsorgt worden bin, die noch nicht vollkommen übermüdet und erschöpft waren.“"
                                            },
                                            {
                                                "example_id": "82ab2939-7a52-4169-a926-723481499d8a",
                                                "sense_id": "e61e76f9-3d68-35be-b5e9-5ae6df0b9b18",
                                                "text": "„Erschöpft und voller Erwartungen kommen Flüchtlingsfamilien im fremden Deutschland an.“"
                                            },
                                            {
                                                "example_id": "2aa68c1a-1b0e-4181-baa3-5b4d384f595d",
                                                "sense_id": "e61e76f9-3d68-35be-b5e9-5ae6df0b9b18",
                                                "text": "[Die an Corona und Long Covid erkrankte Krankenschwester Petra aus Kaufbeuren] „ist durch ihre Erkrankung so erschöpft, dass sie nicht mal mehr ihre Spülmaschine ohne Pause ausräumen kann.“"
                                            },
                                            {
                                                "example_id": "4acc1e92-69f9-4b79-9254-cf57131feb65",
                                                "sense_id": "e61e76f9-3d68-35be-b5e9-5ae6df0b9b18",
                                                "text": "„Erschöpfte Zugvögel sind leichte Beute für die Raubtiere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6fc22866-6c1c-3960-a236-3d93566c1666",
                                        "entry_id": "6fb73dd7-4f68-3b3d-a055-85aed9e72efa",
                                        "glosses": [
                                            "verfügbares Pensum aufgebraucht"
                                        ],
                                        "tags": [
                                            "von Dingen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95b55d46-9e1d-4178-aedd-ddf7200ef860",
                                                "sense_id": "6fc22866-6c1c-3960-a236-3d93566c1666",
                                                "text": "Nachdem die Goldader erschöpft war, zogen die Goldsucher weiter."
                                            },
                                            {
                                                "example_id": "8d37a712-9528-45b5-857f-2ae0e4b6b19d",
                                                "sense_id": "6fc22866-6c1c-3960-a236-3d93566c1666",
                                                "text": "[Russischer Krieg gegen die Ukraine 2022:] „Bei den Vorprodukten waren aufgrund der weltweiten Pandemie bereits vor Kriegsausbruch die Lagerbestände in einigen Bereichen weitgehend erschöpft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
