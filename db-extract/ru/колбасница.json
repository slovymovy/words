                    }
                ],
                "translations": [
                    {
                        "translation_id": "f661a1bc-c903-46f2-9ffa-16a6759f9455",
                        "source_entry_id": "955700b0-bf72-36f6-ac80-c77774d1483b",
                        "source_sense_id": "3239afc9-54bc-39ff-a944-5da077a45b70",
                        "target_lang_word": "charcutière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charcutière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08d8ea1b-dea6-39f9-8a17-562d688596b8",
                                        "entry_id": "c7c8d9b9-cc3e-33f0-8103-b07f014e4a77",
                                        "glosses": [
                                            "Artisane qui prépare et qui vend du porc frais ou préparé en boudins, saucisses ou toute autre viande hachée ou farcie (comme andouillettes et pâtés)."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Charcuterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b46b06af-2ba1-4f5b-a7af-08da08b8a356",
                                                "sense_id": "08d8ea1b-dea6-39f9-8a17-562d688596b8",
                                                "text": "Et la brave charcutière qui dépeçait et refaçonnait du porc à longueur de commande ne put en supporter davantage ; elle pensa « Mon Dieu » et s’abattit sur le sol."
                                            },
                                            {
                                                "example_id": "bd35c622-8580-4ba0-902b-9a7145186238",
                                                "sense_id": "08d8ea1b-dea6-39f9-8a17-562d688596b8",
                                                "text": "Pour Olivia Cavallaro, âgée aujourd’hui de 18 ans, tout remonte à l’enfance. « J’ai toujours voulu être charcutière, se souvient-elle. J’allais avec mon père à la chasse et ça m’a donné des idées de recettes. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bac25bfc-5d71-3d94-9608-9ad293c2f08a",
                                        "entry_id": "c7c8d9b9-cc3e-33f0-8103-b07f014e4a77",
                                        "glosses": [
                                            "Épouse d’un charcutier."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "charcutière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "602df54b-db4e-3d5a-a718-5265a1ee844d",
                                        "entry_id": "986b3cd1-8e73-31f6-b3f4-b04be5ab07f3",
                                        "glosses": [
                                            "Féminin singulier de charcutier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3c4e379-acf3-45ec-a1c9-eed2d2484728",
                                                "sense_id": "602df54b-db4e-3d5a-a718-5265a1ee844d",
                                                "text": "Mais, à défaut d’une sécurité budgétaire immédiate, il était absolument indispensable d’assurer, au moins, l’indépendance de l’écrivain, Marchenoir n’étant plus du tout le petit jeune homme trop heureux d’acheter l’insertion de son vocable patronymique dans un grand journal, au prix de n’importe quelle charcutière émasculation de sa pensée."
                                            },
                                            {
                                                "example_id": "83fbcf63-496f-4c97-ae58-a99c73f1628e",
                                                "sense_id": "602df54b-db4e-3d5a-a718-5265a1ee844d",
                                                "text": "Hier je vous ai présenté la sauce charcutière… Aujourd’hui, application… un sauté de porc accompagné de cette sauce !"
                                            },
                                            {
                                                "example_id": "f227c671-08ec-460b-874c-08040a0ad50e",
                                                "sense_id": "602df54b-db4e-3d5a-a718-5265a1ee844d",
                                                "text": "Avec Les Artcutiers, l’excellence charcutière n’est pas réservée à une poignée de privilégiés."
                                            },
                                            {
                                                "example_id": "1f025248-8d4b-41b1-b28a-e8982e48466b",
                                                "sense_id": "602df54b-db4e-3d5a-a718-5265a1ee844d",
                                                "text": "L’application Yuka, qui classe les produits alimentaires en fonction de leur impact sur la santé, a gagné le 8 décembre l’un de ses procès en appel contre l’industrie charcutière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
