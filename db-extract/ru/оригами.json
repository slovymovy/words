                                    {
                                        "sense_id": "c918e55a-d93b-3768-ab9f-28c24c5a0a4a",
                                        "entry_id": "ad6b602b-ee9f-36b6-ae92-423cc339ff8d",
                                        "glosses": [
                                            "uit Japan afkomstige kunst van het vouwen van objecten uit papier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6aaead-7ad2-4c0d-9af4-a090458b17c2",
                                                "sense_id": "c918e55a-d93b-3768-ab9f-28c24c5a0a4a",
                                                "text": "In Japan is namelijk het geloof dat wanneer je duizend origami kraanvogels vouwt, de goden je wens inwilligen en je ziekte genezen."
                                            },
                                            {
                                                "example_id": "a57d2d7b-4214-4d53-b04f-cd5e057cc34a",
                                                "sense_id": "c918e55a-d93b-3768-ab9f-28c24c5a0a4a",
                                                "text": "Ik ben nog bezig met een kerststal van origami en ik moet Jozef nog vouwen.”"
                                            },
                                            {
                                                "example_id": "8f435493-bb68-474b-8c0a-a6641dff255a",
                                                "sense_id": "c918e55a-d93b-3768-ab9f-28c24c5a0a4a",
                                                "text": "Op YouTube staan duizenden lessen in alles wat je kunt bedenken. Tekenen, dansen, goochelen, toepen, origami vouwen. Door de zoekvraag te beginnen met 'hoe' vind je de beste lessen op YouTube. Dus zoek niet op 'tekenles', maar op 'hoe teken ik een draak'. Je bent gegarandeerd uren zoet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
