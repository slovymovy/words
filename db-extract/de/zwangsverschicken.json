                        "entry_id": "5cd69f08-a2aa-33ba-af4f-37f8e7412529",
                        "glosses": [
                            "gegen jemandes Willen, unter Zwang jemanden an einen anderen Ort bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9a2da4-c187-4820-bb01-eb56517f1553",
                                "sense_id": "53bc546e-ed08-3672-b0f2-497aab9d60ba",
                                "text": "„Da waren sie als Jugendliche aufs Land zwangsverschickt worden.“"
                            },
                            {
                                "example_id": "bf2f7ddd-374c-4754-b8a1-9c6498769562",
                                "sense_id": "53bc546e-ed08-3672-b0f2-497aab9d60ba",
                                "text": "„Hunderttausende von amerikanischen Schülern sind seitdem, vor allem in den Südstaaten der USA, per Bus zwangsverschickt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
