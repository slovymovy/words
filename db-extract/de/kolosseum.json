                    {
                        "form_id": "ee2ea704-0fae-41e7-ba59-5bff4d5ca7e2",
                        "entry_id": "c3b1cb2a-10e2-32c6-b50f-02364ccfd444",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Kolosseum"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                        "entry_id": "c3b1cb2a-10e2-32c6-b50f-02364ccfd444",
                        "glosses": [
                            "antikes römisches Amphitheater aus dem 1. Jahrhundert nach Christus, heute noch in Teilen erhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67f7ac02-a63f-414b-beb6-8445575d3122",
                                "sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                                "text": "„In Rom gab es vier Gladiatorenschulen, die größte nannte sich Ludus Magnus und war mit dem später Kolosseum genannten Flavischen Amphitheater durch einen Tunnel verbunden.“"
                            },
                            {
                                "example_id": "19b62d9e-42b1-4c65-9085-1e4acd43c3c7",
                                "sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                                "text": "„Die Schornsteine der Häuser, die verfallenen Mauern, malerisch, an den Rhein und das Kolosseum gemahnend, erstreckten sich weithin durch die vom Brande betroffenen Stadtviertel, Ruine hinter Ruine.“"
                            },
                            {
                                "example_id": "fc29c15d-28f4-4a1e-af18-6b85547c5284",
                                "sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                                "text": "„Ohne die Grundrechenarten kann man weder das Kolosseum bauen noch einen Militärapparat aufrechterhalten und schon gar nicht ein kalkulierbares Steuersystem etablieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c20b838-422f-40e2-a783-f40ef4921d4d",
                        "source_entry_id": "c3b1cb2a-10e2-32c6-b50f-02364ccfd444",
                        "source_sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                        "target_lang_word": "Colosseum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Colosseum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "720041c2-0efc-3896-aa9b-0dc701bfb109",
                                        "entry_id": "108b3659-ddf5-345d-9f6e-87c9083fb368",
                                        "glosses": [
                                            "The largest stadium in the Roman empire, located near the center of Rome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78b133c-4667-4a48-a3ea-0dfc66f1afcf",
                                                "sense_id": "720041c2-0efc-3896-aa9b-0dc701bfb109",
                                                "text": "The Colosseum (known at the time as the Flavian Amphitheater) in Rome was the empire's greatest amphitheater. A marvel of Roman engineering, the Colosseum could hold up to 70,000 spectators."
                                            },
                                            {
                                                "example_id": "8f083d92-60e4-4523-91fe-169ca2eddbbc",
                                                "sense_id": "720041c2-0efc-3896-aa9b-0dc701bfb109",
                                                "text": "The Colosseum’s elliptical shape is 617 feet long, 512 feet across, and 159 feet high."
                                            },
                                            {
                                                "example_id": "01f181be-33da-4c6a-9203-5d037f4dcebd",
                                                "sense_id": "720041c2-0efc-3896-aa9b-0dc701bfb109",
                                                "text": "Perhaps no classical Roman ruin evokes the excesses of the late Empire like the Colosseum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24484779-0a35-44dc-b804-c53be1630b4b",
                        "source_entry_id": "c3b1cb2a-10e2-32c6-b50f-02364ccfd444",
                        "source_sense_id": "407f0657-2fc5-309c-97ee-f1310b7bf6ed",
                        "target_lang_word": "Colisée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
