                "senses": [
                    {
                        "sense_id": "003f110a-79cf-3ecd-b896-083f16d7e47d",
                        "entry_id": "006c01db-f134-3dd9-b248-b6c78fad19a1",
                        "glosses": [
                            "zabieg przygotowujący ciało do pochówku polegający na zabezpieczeniu go przed rozkładem lub na usunięciu zmian pośmiertnych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d75e918-f694-420a-89bf-f7e15a08ee2f",
                                "sense_id": "003f110a-79cf-3ecd-b896-083f16d7e47d",
                                "text": "Nowoczesne balsamowanie, zwane przez specjalistów tanatopraksją, polega na wpompowaniu w żyły zmarłego chemicznych płynów infuzyjnych i nasycenia ciała środkami chemicznymi. Cały zabieg tanatopraksji trwa 4–5 godzin"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
