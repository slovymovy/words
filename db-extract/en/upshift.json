                "senses": [
                    {
                        "sense_id": "59753530-5515-3f65-b0bb-ab6e3ab1ca4a",
                        "entry_id": "f1b21b60-619a-3b41-beaa-e667ad304cf3",
                        "glosses": [
                            "To shift to a higher gear."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d649542-10dc-46c0-b02f-c217a6366ce8",
                                "sense_id": "59753530-5515-3f65-b0bb-ab6e3ab1ca4a",
                                "text": "You can upshift to second gear once the car is moving."
                            }
                        ]
                    },
                    {
                        "sense_id": "67d3ffdb-cb8a-3487-89c5-ac4037df970b",
                        "entry_id": "f1b21b60-619a-3b41-beaa-e667ad304cf3",
                        "glosses": [
                            "To shift to a higher level, such as of frequency, growth rate, economic level, etc."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d9118f3f-07fa-420e-ad77-3c63de9828ba",
                                "sense_id": "67d3ffdb-cb8a-3487-89c5-ac4037df970b",
                                "text": "The frequency of the light is upshifted."
                            },
                            {
                                "example_id": "9ae282e2-0f9d-43c2-8a86-7463741dee0f",
                                "sense_id": "67d3ffdb-cb8a-3487-89c5-ac4037df970b",
                                "text": "That's how you upshift a conversation so you can navigate the great political divide in a way that insights, not incites."
                            },
                            {
                                "example_id": "96b1c292-184b-4bf3-8ad3-1b4d212d89ba",
                                "sense_id": "67d3ffdb-cb8a-3487-89c5-ac4037df970b",
                                "text": "Collectively, we need to “up-shift” our thinking—we need a new mindset."
                            },
                            {
                                "example_id": "ce85b8f7-f22b-47dd-ac45-850e7b3589d5",
                                "sense_id": "67d3ffdb-cb8a-3487-89c5-ac4037df970b",
                                "text": "Irritation will also occur if you or your family have never had, and will never have, a chance to 'upshift'."
                            }
                        ]
                    }
