                                                "example_id": "76b9a4b2-82d8-428b-b2d3-1aa892f5a3b1",
                                                "sense_id": "4c4f517d-d9f1-3c8e-856c-bd9c8e18c766",
                                                "text": "So they went in to where Gudruda sat spinning in the hall, singing as she span."
                                            },
                                            {
                                                "example_id": "bd2b1ace-8425-45b5-8907-341ca1d69cef",
                                                "sense_id": "4c4f517d-d9f1-3c8e-856c-bd9c8e18c766",
                                                "text": "Five spectators remained in critical condition on Monday, a day after they were injured when a giant pick-up truck span out of control during a stunt show in a Dutch town, killing three people, local officials said."
