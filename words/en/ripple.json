{
    "word_family": [
        "rippler",
        "ripply",
        "unrippled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fb87beb-af08-31af-9c02-d428f164bfdd",
                    "sense_definition": "a small wave or series of waves on the surface of water, caused by a slight breeze or an object dropping into it",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "water_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I dropped a small stone into the pond and watched the <w>ripples</w> spread across the calm surface.",
                            "target_lang_translations": {
                                "ru": "Я бросил маленький камень в пруд и наблюдал, как <w>круги</w> расходятся по спокойной поверхности."
                            }
                        },
                        {
                            "text": "The gentle wind created a tiny <w>ripple</w> on the water as the boat passed by.",
                            "target_lang_translations": {
                                "ru": "Легкий ветерок создал едва заметную <w>рябь</w> на воде, когда лодка проплывала мимо."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tiny ripple",
                        "ripple on the water",
                        "create a ripple"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшая волна или серия волн на поверхности воды, вызванная легким ветерком или падением предмета"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рябь",
                                "target_lang_sense_clarification": "мелкое волнение на поверхности воды"
                            },
                            {
                                "target_lang_word": "зыбь",
                                "target_lang_sense_clarification": "легкое колебание водной поверхности"
                            },
                            {
                                "target_lang_word": "круги",
                                "target_lang_sense_clarification": "расходящиеся волны от упавшего предмета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5abde50d-532a-3a9c-a033-5dd53470e3df",
                    "sense_definition": "a sound that is similar to the sound of water moving gently",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>ripple</w> of laughter spread through the audience after the comedian told a clever joke.",
                            "target_lang_translations": {
                                "ru": "<w>Раскат</w> смеха пронесся по залу после того, как комик рассказал остроумную шутку."
                            }
                        },
                        {
                            "text": "We could hear the soft <w>ripple</w> of the stream behind our tent during the night.",
                            "target_lang_translations": {
                                "ru": "Ночью мы слышали тихое <w>журчание</w> ручья за нашей палаткой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ripple of laughter",
                        "ripple of applause"
                    ],
                    "target_lang_definitions": {
                        "ru": "звук, похожий на тихое журчание воды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "журчание",
                                "target_lang_sense_clarification": "звук текущей воды или смеха"
                            },
                            {
                                "target_lang_word": "раскат",
                                "target_lang_sense_clarification": "волна звука, например, смеха или аплодисментов"
                            },
                            {
                                "target_lang_word": "гул",
                                "target_lang_sense_clarification": "нарастающий звук в толпе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57fcd47f-a6a1-3b56-93f2-eb9e3c070ab4",
                    "sense_definition": "a small oscillation or variation in an electrical signal or steady flow",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer noticed a slight voltage <w>ripple</w> in the power supply during the stress test.",
                            "target_lang_translations": {
                                "ru": "Инженер заметил небольшую <w>пульсацию</w> напряжения в источнике питания во время стресс-теста."
                            }
                        },
                        {
                            "text": "Filtering is necessary to reduce the <w>ripple</w> in the output of the rectifier circuit.",
                            "target_lang_translations": {
                                "ru": "Фильтрация необходима для уменьшения <w>колебаний</w> на выходе схемы выпрямителя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voltage ripple",
                        "output ripple"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшое колебание или изменение электрического сигнала или равномерного потока"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пульсация",
                                "target_lang_sense_clarification": "колебание напряжения или тока"
                            },
                            {
                                "target_lang_word": "колебания",
                                "target_lang_sense_clarification": "незначительные изменения сигнала"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4b6c704-96ed-3db0-affa-cb3e9e895ccb",
                    "sense_definition": "a style of ice cream where a flavored syrup is swirled through the base",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I enjoy fudge <w>ripple</w> ice cream because of the thick chocolate swirls mixed inside.",
                            "target_lang_translations": {
                                "ru": "Мне нравится мороженое с шоколадным <w>риплом</w> из-за густых шоколадных завитков внутри."
                            }
                        },
                        {
                            "text": "The raspberry <w>ripple</w> was the most popular dessert at the summer party.",
                            "target_lang_translations": {
                                "ru": "Малиновый <w>рипл</w> был самым популярным десертом на летней вечеринке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fudge ripple",
                        "raspberry ripple"
                    ],
                    "target_lang_definitions": {
                        "ru": "вид мороженого с прожилками сиропа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рипл",
                                "target_lang_sense_clarification": "мороженое с наполнителем в виде спиралей"
                            },
                            {
                                "target_lang_word": "прослойка",
                                "target_lang_sense_clarification": "слой сиропа в мороженом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99206fa6-dc77-35ab-ad55-13e51418eca3",
                    "sense_definition": "a comb-like tool used to remove seeds from the stalks of flax or broom corn",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer used a heavy iron <w>ripple</w> to clean the flax before processing the fibers.",
                            "target_lang_translations": {
                                "ru": "Фермер использовал тяжелый железный <w>гребень</w>, чтобы очистить лен перед обработкой волокон."
                            }
                        },
                        {
                            "text": "In the museum, we saw an ancient <w>ripple</w> used for harvesting seeds centuries ago.",
                            "target_lang_translations": {
                                "ru": "В музее мы увидели древний <w>риппель</w>, использовавшийся для сбора семян много веков назад."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "гребнеобразный инструмент для удаления семян со стеблей льна"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гребень",
                                "target_lang_sense_clarification": "инструмент для чесания льна"
                            },
                            {
                                "target_lang_word": "риппель",
                                "target_lang_sense_clarification": "специальный гребень для льна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f516809-2137-34cb-9213-798ab96c6437",
                    "sense_definition": "to move in small waves or to have a surface that looks like small waves",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall grass began to <w>ripple</w> in the wind like a green ocean.",
                            "target_lang_translations": {
                                "ru": "Высокая трава начала <w>колыхаться</w> на ветру, словно зеленый океан."
                            }
                        },
                        {
                            "text": "You can see his muscles <w>ripple</w> under his skin when he lifts those heavy weights.",
                            "target_lang_translations": {
                                "ru": "Видно, как его мышцы <w>перекатываются</w> под кожей, когда он поднимает эти тяжести."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruffle"
                    ],
                    "common_phrases": [
                        "ripple in the wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "двигаться мелкими волнами или иметь поверхность, похожую на мелкие волны"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колыхаться",
                                "target_lang_sense_clarification": "о траве или поверхности"
                            },
                            {
                                "target_lang_word": "идти рябью",
                                "target_lang_sense_clarification": "покрываться мелкими волнами"
                            },
                            {
                                "target_lang_word": "перекатываться",
                                "target_lang_sense_clarification": "о мышцах под кожей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e66a700d-d5c0-354b-b4e3-09948f568d29",
                    "sense_definition": "to spread through something or a group of people like a wave",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propagation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of the company's closing <w>rippled</w> through the small town, causing great concern.",
                            "target_lang_translations": {
                                "ru": "Новость о закрытии компании <w>прокатилась</w> по маленькому городку, вызвав серьезную обеспокоенность."
                            }
                        },
                        {
                            "text": "Economic changes in one country can <w>ripple</w> through the global market very quickly.",
                            "target_lang_translations": {
                                "ru": "Экономические изменения в одной стране могут очень быстро <w>распространиться</w> по всему мировому рынку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ripple through"
                    ],
                    "target_lang_definitions": {
                        "ru": "распространяться через что-либо или группу людей подобно волне"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокатиться",
                                "target_lang_sense_clarification": "о слухах или новостях"
                            },
                            {
                                "target_lang_word": "распространяться",
                                "target_lang_sense_clarification": "передаваться по цепочке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1169189-debe-33ea-a4d9-20720b412664",
                    "sense_definition": "to make a gentle, flowing sound like water moving over stones",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small brook <w>rippled</w> over the pebbles, creating a peaceful atmosphere in the garden.",
                            "target_lang_translations": {
                                "ru": "Маленький ручей <w>журчал</w> по гальке, создавая мирную атмосферу в саду."
                            }
                        },
                        {
                            "text": "I love to listen to the water as it <w>ripples</w> against the side of the boat.",
                            "target_lang_translations": {
                                "ru": "Я люблю слушать, как вода <w>плещется</w> о борт лодки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ripple over stones"
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать мягкий, текучий звук, подобно воде, текущей по камням"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "журчать",
                                "target_lang_sense_clarification": "издавать звук текущей воды"
                            },
                            {
                                "target_lang_word": "плескаться",
                                "target_lang_sense_clarification": "тихо ударяться о поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fd6bbc6-845b-3ff5-8d52-6caa9593b96d",
                    "sense_definition": "to release or fire several things in very quick succession",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rapid_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot <w>rippled</w> several rockets at the target to ensure it was destroyed.",
                            "target_lang_translations": {
                                "ru": "Пилот <w>выпустил серию</w> ракет по цели, чтобы гарантировать ее уничтожение."
                            }
                        },
                        {
                            "text": "The ship's battery <w>rippled</w> its fire across the horizon during the naval exercise.",
                            "target_lang_translations": {
                                "ru": "Корабельная батарея <w>дала залп</w> по горизонту во время военно-морских учений."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "выпускать или выстреливать несколько зарядов в очень быстрой последовательности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускать серию",
                                "target_lang_sense_clarification": "о ракетах или снарядах"
                            },
                            {
                                "target_lang_word": "давать залп",
                                "target_lang_sense_clarification": "быстро стрелять один за другим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b1d9244-81f1-37d4-900a-438ebaa36215",
                    "sense_definition": "to slightly scratch or graze the surface of something",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thorn <w>rippled</w> his skin as he pushed through the thick bushes.",
                            "target_lang_translations": {
                                "ru": "Шип <w>оцарапал</w> его кожу, когда он пробирался сквозь густые кусты."
                            }
                        },
                        {
                            "text": "The arrow <w>rippled</w> the surface of the shield but did not penetrate it.",
                            "target_lang_translations": {
                                "ru": "Стрела <w>задела</w> поверхность щита, но не пробила его."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "слегка поцарапать или задеть поверхность чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оцарапать",
                                "target_lang_sense_clarification": "слегка задеть поверхность"
                            },
                            {
                                "target_lang_word": "задеть",
                                "target_lang_sense_clarification": "коснуться вскользь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4967195d-52ca-3886-a27a-ae876548a0bc",
                    "sense_definition": "to use a <w>ripple</w> tool to remove seeds from flax or similar plants",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Workers would <w>ripple</w> the flax by hand to prepare the stalks for the next stage.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>очесывали</w> лен вручную, чтобы подготовить стебли к следующему этапу."
                            }
                        },
                        {
                            "text": "It takes a lot of effort to <w>ripple</w> the entire harvest before the rains begin.",
                            "target_lang_translations": {
                                "ru": "Требуется много усилий, чтобы <w>очесать</w> весь урожай до начала дождей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "использовать специальный инструмент для удаления семян со льна"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очесывать",
                                "target_lang_sense_clarification": "удалять семена со льна"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f4ee0ffc-c6b9-3ace-b20c-6838f54bf7a4",
                    "sense_definition": "a village and civil parish in the Dover district of Kent, England",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The historic church in <w>Ripple</w> attracts many visitors to the Kent countryside.",
                            "target_lang_translations": {
                                "ru": "Историческая церковь в <w>Риппле</w> привлекает множество посетителей в сельскую местность Кента."
                            }
                        },
                        {
                            "text": "He grew up in a small cottage located in the parish of <w>Ripple</w>.",
                            "target_lang_translations": {
                                "ru": "Он вырос в маленьком коттедже, расположенном в приходе <w>Риппл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United Kingdom"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "деревня и община в районе Дувр, графство Кент, Англия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Риппл",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90fa22e6-5a73-31c9-9df6-ffedd079294d",
                    "sense_definition": "a family name or surname",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Ripple</w> was known throughout the neighborhood for his beautiful garden.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Риппл</w> был известен на всю округу своим прекрасным садом."
                            }
                        },
                        {
                            "text": "The <w>Ripple</w> family has lived in this valley for over three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Риппл</w> живет в этой долине уже более трех поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Риппл",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}