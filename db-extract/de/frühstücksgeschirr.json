                        "glosses": [
                            "Geschirr, speziell fürs Frühstück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3ca1e5-5669-4e22-89e7-aafbf850fc61",
                                "sense_id": "86590a1e-30d4-3a64-8fec-b670700dae25",
                                "text": "„Das ungute Gefühl, das ihn in der Hotelhalle befiel, verstärkte sich, als er sah, dass alle Tische im Speiseraum vom Frühstücksgeschirr befreit, bereits für den Mittag hergerichtet waren.“"
                            },
                            {
                                "example_id": "d157c83e-ff89-40e5-bc8b-139c86790639",
                                "sense_id": "86590a1e-30d4-3a64-8fec-b670700dae25",
                                "text": "„Der alte Holztisch, übersät mit dunklen Ringen von zu heiß darauf abgestellten Getränken, Wein- und anderen Flecken, war zur Hälfte mit Büchern und Magazinen, zur anderen mit Frühstücksgeschirr bedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
