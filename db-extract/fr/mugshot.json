                "senses": [
                    {
                        "sense_id": "09dcaed9-57fb-3f5a-ade8-0ac1a26b8581",
                        "entry_id": "fe1bd9e0-2234-3530-9bf2-4315f74c161f",
                        "glosses": [
                            "Aux États-Unis, photo d’identité prise de face et de profil pour tous les prévenus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa3cff8f-b7d8-4f2d-8a43-b9cc4eca57ff",
                                "sense_id": "09dcaed9-57fb-3f5a-ade8-0ac1a26b8581",
                                "text": "Il subira l’humiliant rituel infligé à tous les inculpés : relevé d’empreintes et mugshot (photo d’identité de face et de profil)."
                            },
                            {
                                "example_id": "cb3b9fea-8a72-4609-ae52-547cc3f406fe",
                                "sense_id": "09dcaed9-57fb-3f5a-ade8-0ac1a26b8581",
                                "text": "Elles sont allées jusqu’à proposer des tee-shirts à 36 dollars, montrant une photo anthropométrique de Donald Trump, accompagné du bandeau « innocent » - un montage, bien entendu, puisque la formalité du mugshot a été épargnée à l’ex-président lors de son arrivée à la Cour de justice."
                            },
                            {
                                "example_id": "ccdfd25a-1a14-4397-9b3c-c6f6b8092d57",
                                "sense_id": "09dcaed9-57fb-3f5a-ade8-0ac1a26b8581",
                                "text": "Les “mugshots” sont utilisés dans l’ensemble des États-Unis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c0e7251-6bb4-4635-9ae0-509ef03ddb3c",
                        "source_entry_id": "fe1bd9e0-2234-3530-9bf2-4315f74c161f",
                        "source_sense_id": "09dcaed9-57fb-3f5a-ade8-0ac1a26b8581",
                        "target_lang_word": "mug shot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mug shot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "810ee0ab-5ad3-39e2-9288-13ad3da334ec",
                                        "entry_id": "9ed3d8c5-2706-3208-b083-23e9ee4ff303",
                                        "glosses": [
                                            "A photograph of a person's face, especially one taken by the police during an arrest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7be71e4-3a80-40f0-859a-0b56f2f1b447",
                                                "sense_id": "810ee0ab-5ad3-39e2-9288-13ad3da334ec",
                                                "text": "All Summer Johnny was Prince of the penny arcade, arms around me on the tilt-a-whirl, mug-shot grins in the quarter photo booth, twanging his guitar for street kids on the hill who scored baggies of hashish and Panama Red."
                                            },
                                            {
                                                "example_id": "f6b7597b-01d2-4f63-b655-fa4b2b06c92d",
                                                "sense_id": "810ee0ab-5ad3-39e2-9288-13ad3da334ec",
                                                "text": "The buddy list has a bunch of visual status clues. Your buddy may have included a mug shot, perhaps through Photo Booth."
                                            },
                                            {
                                                "example_id": "677427a3-1e46-4115-906a-bbf3edaa5dad",
                                                "sense_id": "810ee0ab-5ad3-39e2-9288-13ad3da334ec",
                                                "text": "All these parameters of the series (the mug shot, the means of mechanical reproduction, the desirability of the outlawed, the reversal of law and desire and even the photo booth) are unmistakably present in Genet’s Our Lady of the Flowers."
                                            },
                                            {
                                                "example_id": "63309384-307a-47fd-bbe9-0ae89d80b02a",
                                                "sense_id": "810ee0ab-5ad3-39e2-9288-13ad3da334ec",
                                                "text": "After waiting some five hours to be called forward on an unusually hot, humid Summer’s day in London (I believe temperatures soared to around 30 degrees Centigrade or around 90F), I presented my mug shot to the perky female jobs-worth official."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
