                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dd28de5-8fd8-39fc-a0a2-30a2b57e4c56",
                    "sense_definition": "Действие или мера предосторожности, гарантирующая безопасность или успех в каком-либо деле.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "safety_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я взял с собой запасной ключ просто для <страховки>.",
                            "target_lang_translations": {
                                "en": "I took a spare key with me just for <insurance>.",
                                "es": "Me llevé una llave de repuesto solo para tener un <respaldo>.",
                                "fr": "J'ai pris une clé de rechange avec moi juste par <sécurité>."
                            }
                        },
                        {
                            "text": "Ему нужна была какая-то <страховка> на случай, если план провалится.",
                            "target_lang_translations": {
                                "en": "He needed some sort of <safety net> in case the plan failed.",
                                "es": "Necesitaba una especie de <red de seguridad> por si el plan fallaba.",
                                "fr": "Il lui fallait une <roue de secours> au cas où le plan échouerait."
                            }
                        }
                    ],
                    "common_phrases": [
                        "для страховки"
                    ],
                    "target_lang_definitions": {
                        "en": "An action or measure taken to guarantee safety or success; a backup plan.",
                        "es": "Medida de precaución o respaldo para garantizar la seguridad o el éxito en alguna acción.",
                        "fr": "Action ou mesure de précaution garantissant la sécurité ou le succès dans une affaire."
                    },
