                                "example_id": "d101a7de-18ed-4c20-95c7-ba174305abfd",
                                "sense_id": "28e2cb96-65a8-3e7e-9667-40daa851a341",
                                "text": "De quelle façon le net peut-il nous \"addicter\"?"
                            },
                            {
                                "example_id": "bbfbb761-7c8d-4f45-a189-f099e088467d",
                                "sense_id": "28e2cb96-65a8-3e7e-9667-40daa851a341",
                                "text": "Pas question de stresser, de burnouter, d'addicter ou de francetélécomer."
