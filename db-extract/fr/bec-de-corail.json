                "senses": [
                    {
                        "sense_id": "3aa64da4-59dc-396c-8fbd-b2d7201e4044",
                        "entry_id": "b04641f9-fbaf-33cd-881c-28ad960c44ae",
                        "glosses": [
                            "Nom couramment donné à l’astrild cendré, petit passereau africain fréquemment élevé en captivité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32071d5f-57e1-40ad-9ef4-3c264bb4356d",
                                "sense_id": "3aa64da4-59dc-396c-8fbd-b2d7201e4044",
                                "text": "Le bec-de-corail fait partie des oiseaux de cage les plus populaires. Aussi, a-t-on tout intérêt à tenter la reproduction de cet astrild, afin de limiter les captures en milieu naturel."
                            },
                            {
                                "example_id": "7fc5da72-8c82-42ca-b975-2cffa732afa5",
                                "sense_id": "3aa64da4-59dc-396c-8fbd-b2d7201e4044",
                                "text": "Le bec de corail est un petit oiseau svelte à la silhouette harmonieuse. Ses teintes pastels sont du plus bel effet. Son plumage brun et beige est rehaussé d’un bec rouge corail et d’un trait rouge vif sur chaque œil."
                            }
                        ]
                    }
                ],
