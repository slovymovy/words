        "fr-extract.jsonl": [
            {
                "entry_id": "55a5ad7d-24ec-3ecc-868a-085d54eaedd6",
                "word": "calende",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c607c52d-e3d4-44b4-b8d8-242b541381c4",
                        "entry_id": "55a5ad7d-24ec-3ecc-868a-085d54eaedd6",
                        "tags": [
                            "plural"
                        ],
                        "form": "calendes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "625f68bf-4b76-3c1f-9a26-25404e3ca0f4",
                        "entry_id": "55a5ad7d-24ec-3ecc-868a-085d54eaedd6",
                        "glosses": [
                            "Premier jour de chaque mois."
                        ],
                        "tags": [],
                        "note": "Ce terme est généralement utilisé au pluriel. (calendes",
                        "examples": [
                            {
                                "example_id": "43b9fade-0074-41db-9b04-78f19c7a21ba",
                                "sense_id": "625f68bf-4b76-3c1f-9a26-25404e3ca0f4",
                                "text": "Ainsi le premier jour de chaque mois, c'est-à-dire de la néoménie ou première apparition de la lune, était appelé calende […], et alors on faisait un sacrifice solennel à Junon."
                            },
                            {
                                "example_id": "49705540-ae70-4a57-8987-43e76bf62582",
                                "sense_id": "625f68bf-4b76-3c1f-9a26-25404e3ca0f4",
                                "text": "Mais, au moment où Guillaume parle, on n'était ni loin ni près de la calende, on était le jour de la calende."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc6088ea-0bd3-3e8e-92a2-b1e09e7540d3",
                        "entry_id": "55a5ad7d-24ec-3ecc-868a-085d54eaedd6",
                        "glosses": [
                            "Chant religieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd99a94d-123f-4803-96de-0f185aafa9b4",
                                "sense_id": "bc6088ea-0bd3-3e8e-92a2-b1e09e7540d3",
                                "text": "Elle chanta encore la calende la veille de Noël, malgré nos plus vives représentations pour l'en empêcher."
                            },
                            {
                                "example_id": "32268a56-4a99-4aab-8fe9-ef97ab0d88f0",
                                "sense_id": "bc6088ea-0bd3-3e8e-92a2-b1e09e7540d3",
                                "text": "Quoi qu'il en soit, Bruère rencontrant Sorgo à Paris aux environs de la Noël de l'année 1820 éprouve le besoin de lui chanter une calende et ce petit poème est tellement farci de souvenirs ragusains que l'éditeur a cru devoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "587e0af5-6058-39d7-8a37-2c6354544a0a",
                        "entry_id": "55a5ad7d-24ec-3ecc-868a-085d54eaedd6",
                        "glosses": [
                            "Assemblée de curés et de religieux convoquée par un évêque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e6da0b-3281-40cc-b1da-7a88a4711a5a",
                                "sense_id": "587e0af5-6058-39d7-8a37-2c6354544a0a",
                                "text": "Une calende dans chaque doyenné, le plus tôt possible après le synode, dans laquelle chaque curé rendra compte de l'état de sa paroisse au spirituel et au temporel."
                            },
                            {
                                "example_id": "8910e9ec-4780-4c85-8328-6fa14d7ce239",
                                "sense_id": "587e0af5-6058-39d7-8a37-2c6354544a0a",
                                "text": "La « calende » qu'il tenait dans cette paroisse centrale était comme un véritable petit synode où se trouvaient tous les curés et vicaires en chef du canton."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac41734e-a3f2-31ba-ac70-893548571987",
                        "entry_id": "55a5ad7d-24ec-3ecc-868a-085d54eaedd6",
                        "glosses": [
                            "Porte de cathédrale, place voisine."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a0ac6ecf-d05f-42cf-8c6c-5567b2f023a3",
                                "sense_id": "ac41734e-a3f2-31ba-ac70-893548571987",
                                "text": "Peut-être eût-on craint de la laisser passer, parmi la foule, devant la Calende et ses angelots."
                            },
                            {
                                "example_id": "e68b12a1-dbef-496e-8b19-a4a6057f8db2",
                                "sense_id": "ac41734e-a3f2-31ba-ac70-893548571987",
                                "text": "Réparer les marches du perron, et faire le pavé de la nef sous la calende."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
