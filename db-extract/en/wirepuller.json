                                "example_id": "3879e9eb-374d-4a00-aa10-e059be87397f",
                                "sense_id": "b7208d51-4372-37d8-90d5-185469f141ae",
                                "text": "'Filled with old doddering peers, cute financial magnates, clever wirepullers, big brewers with bulbous noses. All the enemies of progress are there — weaklings, sleek, slug, comfortable, self-important individuals."
                            },
                            {
                                "example_id": "4987eb70-716f-4f3b-a685-3f91d1abaac8",
                                "sense_id": "b7208d51-4372-37d8-90d5-185469f141ae",
                                "text": "[…] there lies, alas, the tragedy of the millions of lives immolated by the ignorant peoples as the price paid for the deception practised upon them by the Imperialistic wirepullers."
                            }
                        ]
