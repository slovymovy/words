{
    "word_family": [
        "déportation",
        "déport",
        "déportement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d01f0817-1b37-3117-be89-a98306b6650d",
                    "sense_definition": "Modifier sa trajectoire en se déplaçant vers un côté, notamment lors de la conduite d'un véhicule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trajectoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur a dû se <w>déporter</w> sur la gauche pour éviter un cycliste imprudent."
                        },
                        {
                            "text": "La voiture s'est brusquement <w>déportée</w> afin d'éviter un obstacle sur la chaussée."
                        }
                    ],
                    "synonyms": [
                        "dévier"
                    ],
                    "common_phrases": [
                        "se déporter sur la gauche",
                        "se déporter pour dépasser"
                    ]
                },
                {
                    "sense_id": "dd26f783-281f-3f2d-ae7b-60f6c78dd056",
                    "sense_definition": "Condamner à la déportation, exiler hors d'un territoire ou transférer de force des individus dans un camp.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le régime autoritaire a décidé de <w>déporter</w> de nombreux opposants politiques vers des contrées lointaines."
                        },
                        {
                            "text": "Des milliers de civils innocents ont été <w>déportés</w> pendant ce conflit tragique."
                        }
                    ],
                    "synonyms": [
                        "bannir",
                        "exiler"
                    ],
                    "antonyms": [
                        "rapatrier"
                    ],
                    "common_phrases": [
                        "se faire déporter",
                        "déporter des opposants"
                    ]
                },
                {
                    "sense_id": "c950d278-b78e-36ca-ad7a-0a2e74789d3b",
                    "sense_definition": "Écarter un navire, un aéronef ou un mobile de sa direction initiale sous l'effet du vent ou du courant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trajectoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une puissante rafale de vent a soudainement <w>déporté</w> l'avion lors de son atterrissage délicat."
                        },
                        {
                            "text": "Le fort courant marin a <w>déporté</w> notre voilier à plusieurs milles du cap prévu."
                        }
                    ],
                    "synonyms": [
                        "dévier"
                    ],
                    "common_phrases": [
                        "déporter le navire",
                        "déporter de sa trajectoire"
                    ]
                },
                {
                    "sense_id": "0211e021-1c9e-313d-851f-a8b34e957634",
                    "sense_definition": "Se récuser et renoncer volontairement à instruire ou à juger une affaire pour éviter tout soupçon de partialité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a préféré se <w>déporter</w> de cette affaire délicate en raison de ses liens familiaux."
                        },
                        {
                            "text": "Face au risque évident de conflit d'intérêts, la magistrate a choisi de se <w>déporter</w> sans hésiter."
                        }
                    ],
                    "common_phrases": [
                        "se déporter d'un dossier",
                        "se déporter d'une affaire"
                    ]
                }
            ]
        }
    ]
}