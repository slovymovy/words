                "senses": [
                    {
                        "sense_id": "4afaa337-0c6f-3b51-80d7-4b8bd32330e4",
                        "entry_id": "4a5d17d5-9ed3-3955-b6ca-017d1cf15375",
                        "glosses": [
                            "zeer waarschijnlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c542eb19-7f4d-481f-b366-e19ca06274d8",
                                "sense_id": "4afaa337-0c6f-3b51-80d7-4b8bd32330e4",
                                "text": "Dat zou allicht wel eens waar kunnen zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "53f0d021-4fee-3d60-8624-c3e5b20b0766",
                        "entry_id": "4a5d17d5-9ed3-3955-b6ca-017d1cf15375",
                        "glosses": [
                            "op z'n minst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6259adf3-0bed-49cc-99e4-a3ae272f60cf",
                                "sense_id": "53f0d021-4fee-3d60-8624-c3e5b20b0766",
                                "text": "Je zou allicht je boeken eens open kunnen doen voordat je naar het examen gaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c29918c-2294-311d-93bc-50ef37da64bb",
                        "entry_id": "4a5d17d5-9ed3-3955-b6ca-017d1cf15375",
                        "glosses": [
                            "vanzelfsprekend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96f454ae-1338-47e5-85c1-8749303736d3",
                                "sense_id": "2c29918c-2294-311d-93bc-50ef37da64bb",
                                "text": "Allicht kom ik op je verjaardag!"
                            },
                            {
                                "example_id": "3a9247d1-d316-4314-ba89-bf95709c7d65",
                                "sense_id": "2c29918c-2294-311d-93bc-50ef37da64bb",
                                "text": "Allicht hebben de mascarons geen armen en benen, toch zijn ze in staat in hun kwaaie betovering het gesteente tegen haar op te zetten."
                            },
                            {
                                "example_id": "701df900-5b87-4346-b9ce-3f6b3f19c933",
                                "sense_id": "2c29918c-2294-311d-93bc-50ef37da64bb",
                                "text": "'Ja, allicht heb je er weleens een gezien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3412b4a7-9c6c-459c-a765-8eff22cdff48",
                        "source_entry_id": "4a5d17d5-9ed3-3955-b6ca-017d1cf15375",
