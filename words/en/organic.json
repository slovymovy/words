                    "synonyms": [
                        "natural",
                        "pesticide-free"
                    ],
                    "antonyms": [
                        "inorganic"
                    ],
                    "common_phrases": [
                        "organic food",
                        "organic farming",
                        "organic vegetables"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произведенный без использования химических удобрений, пестицидов или других искусственных веществ.",
