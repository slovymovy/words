                        "sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                        "entry_id": "39f80940-4dbe-3a31-91cd-259d49964165",
                        "glosses": [
                            "Magnificent and impressive because of appearance, size, stateliness or dignity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d5597d6-8d94-4c06-b0ed-2024cddce139",
                                "sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                                "text": "an imposing presence"
                            },
                            {
                                "example_id": "115fc5a9-7629-467b-a9a1-271f80108832",
                                "sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                                "text": "an imposing building"
                            },
                            {
                                "example_id": "42257c68-b6d1-401a-971f-e0b09820fc35",
                                "sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                                "text": "The castle was an imposing sight on the hilltop."
                            },
                            {
                                "example_id": "cc36d93a-9a78-4805-9d7d-d09210247838",
                                "sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                                "text": "He had an imposing figure and a deep voice."
                            },
                            {
                                "example_id": "44eb73c6-d250-4a04-9df1-62ff4d2ccf8f",
                                "sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                                "text": "Considerable remains of that terminus still exist, and it does not appear to have been a very imposing place."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95106b1a-a305-4b50-91d0-4f5da366492b",
                        "source_entry_id": "39f80940-4dbe-3a31-91cd-259d49964165",
                        "source_sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                        "source_sense_description": "magnificent and impressive because of appearance, size, stateliness or dignity",
                        "target_lang_word": "impozantní",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4e5bf018-c7c5-4564-9f7f-9bfd0b8c3e10",
                        "source_entry_id": "39f80940-4dbe-3a31-91cd-259d49964165",
                        "source_sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                        "source_sense_description": "magnificent and impressive because of appearance, size, stateliness or dignity",
                        "target_lang_word": "imposant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imposant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b33a674e-7b43-32d1-8565-9d3824770fc0",
                                        "entry_id": "2d690205-97e1-3bb8-b75c-2631bb28cad4",
                                        "glosses": [
                                            "Qui impose, qui est propre à s’attirer de l’attention, des égards, du respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8183575-8739-41b6-b8cf-7695bf68f59e",
                                                "sense_id": "b33a674e-7b43-32d1-8565-9d3824770fc0",
                                                "text": "[…], et deux pages parurent, portant des flambeaux et éclairant une femme d’une taille imposante, d’un maintien majestueux, et surtout d’une admirable beauté."
                                            },
                                            {
                                                "example_id": "5a9732e3-50bb-4884-b1a9-0fe9dd1215b4",
                                                "sense_id": "b33a674e-7b43-32d1-8565-9d3824770fc0",
                                                "text": "Dans les environs, deux merveilleuses églises : celle de Ham-en-Artois, vestige imposant et vénérable de l’abbaye Saint-Sauveur; celle de Guarbecque, près de la petite ville de Saint-Venant, où triomphe aussi l’art roman."
                                            },
                                            {
                                                "example_id": "c8394df3-ae9b-4570-a370-631ec8cb3c68",
                                                "sense_id": "b33a674e-7b43-32d1-8565-9d3824770fc0",
                                                "text": "Rainie adorait ces montagnes. Elle avait grandi là, à l'ombre des imposants sapins de Douglas, à un jet de pierre de la côte rocheuse. Elle pensait que la nature se devait d'être grandiose, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97faf4ab-ca9f-3bb0-bbce-8015fc37fb05",
                                        "entry_id": "2d690205-97e1-3bb8-b75c-2631bb28cad4",
                                        "glosses": [
                                            "Qui élève l’âme et qui la remplit d’une admiration mêlée de respect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8106655e-87ca-4bfe-8d4f-f5a778d62564",
                                                "sense_id": "97faf4ab-ca9f-3bb0-bbce-8015fc37fb05",
                                                "text": "Un spectacle imposant."
                                            },
                                            {
                                                "example_id": "d5aeb8a8-d9b9-40ae-9912-70a56e792f92",
                                                "sense_id": "97faf4ab-ca9f-3bb0-bbce-8015fc37fb05",
                                                "text": "Un édifice dont l’architecture est imposante."
                                            },
                                            {
                                                "example_id": "aca1e37e-4da4-4803-9298-90b06600cf92",
                                                "sense_id": "97faf4ab-ca9f-3bb0-bbce-8015fc37fb05",
                                                "text": "Une cérémonie imposante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13ef94f4-7ec4-3ebe-84ac-61a797f5b9f4",
                                        "entry_id": "2d690205-97e1-3bb8-b75c-2631bb28cad4",
                                        "glosses": [
                                            "Qui est considérable au point d’inspirer la crainte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3677f6b2-b76d-4f02-a314-bd443ac4186b",
                                                "sense_id": "13ef94f4-7ec4-3ebe-84ac-61a797f5b9f4",
                                                "text": "Cet état mit sur pied des forces militaires imposantes pour lutter contre ses ennemis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "imposant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "575b2132-fd1f-3275-b53a-cdffd8cac348",
                                        "entry_id": "5050f7f8-2e4d-35b0-81f8-616818a913d8",
                                        "glosses": [
                                            "Participe présent de imposer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a8b7cd-55ad-448f-8f81-451a79cf48a3",
                                                "sense_id": "575b2132-fd1f-3275-b53a-cdffd8cac348",
                                                "text": "Dans ces conditions, rien ne s’oppose à robustifier les parcelles affaiblies en leur imposant 100 représentants à l’hectare."
                                            },
                                            {
                                                "example_id": "50317d72-acc7-4eca-8889-efc95d4c48c3",
                                                "sense_id": "575b2132-fd1f-3275-b53a-cdffd8cac348",
                                                "text": "Les deux clubs ont plus ou moins bien réussi leur entrée en Ligue Europa, jeudi, les Bretons s’imposant facilement face au Maccabi Haïfa (3-0) et les Occitans réalisant un nul très sérieux face à la Royale Union Saint-Gilloise (1-1)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e39be4a-793f-4b00-8863-6d8fe6112f5d",
                        "source_entry_id": "39f80940-4dbe-3a31-91cd-259d49964165",
                        "source_sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                        "source_sense_description": "magnificent and impressive because of appearance, size, stateliness or dignity",
                        "target_lang_word": "impressionnant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impressionnant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e534bae-f97a-3a0c-8f20-a2fe9cbbd508",
                                        "entry_id": "91ae28a3-f7c9-3b6f-871b-1b8d528ef24e",
                                        "glosses": [
                                            "Qui impressionne, qui produit sur la sensibilité physique ou morale ou sur l’esprit des impressions, une impression vive et forte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e00997a-5c19-41bf-b381-e7405316f14b",
                                                "sense_id": "8e534bae-f97a-3a0c-8f20-a2fe9cbbd508",
                                                "text": "Un peu plus tard, quand s’épaissit la brume, commence l’œuvre impressionnante des ensevelisseurs."
                                            },
                                            {
                                                "example_id": "4b7a0b49-d871-432d-a2ef-a0561bd8d548",
                                                "sense_id": "8e534bae-f97a-3a0c-8f20-a2fe9cbbd508",
                                                "text": "En dépit de sa réussite, l’Europe connaissait d'intenses frustrations. Cette réussite était pourtant éclatante. Les progrès scientifiques, technologiques et industriels y étaient impressionnants."
                                            },
                                            {
                                                "example_id": "155783f9-818f-424f-a099-34ed9d0b97de",
                                                "sense_id": "8e534bae-f97a-3a0c-8f20-a2fe9cbbd508",
                                                "text": "Viennent ensuite les conduites forcées qui mènent l’eau jusqu’aux turbines. Ces impressionnants tuyaux en acier de 1,9 à 2,3 mètres de diamètre peuvent supporter une pression de 28 bars."
                                            },
                                            {
                                                "example_id": "a69bc6c1-6e13-4fde-a156-1f769b5275bf",
                                                "sense_id": "8e534bae-f97a-3a0c-8f20-a2fe9cbbd508",
                                                "text": "L’impressionnant était que son visage, ridé comme une terre aride, était éclairé par des yeux d’un bleu clair dont la pupille, noire et fixe, mettait mal à l’aise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impressionnant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22d772c5-dfdd-3ade-ab73-a29a0474295e",
                                        "entry_id": "9d860d48-2f88-3133-aa7d-8bdcf55e2418",
                                        "glosses": [
                                            "Participe présent de impressionner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56151863-c54f-4233-8d05-22af6cc7da21",
                        "source_entry_id": "39f80940-4dbe-3a31-91cd-259d49964165",
                        "source_sense_id": "849783ca-fcfb-35cc-9c77-02d07c5bdbef",
                        "source_sense_description": "magnificent and impressive because of appearance, size, stateliness or dignity",
                        "target_lang_word": "imposant",
