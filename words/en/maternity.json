{
    "word_family": [
        "maternal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c7a1e2a-d20b-376f-abc8-864faa342546",
                    "sense_definition": "A ward or department in a hospital in which babies are born.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is working in <w>maternity</w> this month.",
                            "target_lang_translations": {
                                "ru": "В этом месяце она работает в <w>родильном отделении</w>.",
                                "zh": "她这个月在<w>产科</w>工作。"
                            }
                        },
                        {
                            "text": "We visited the <w>maternity</w> unit to see the new baby.",
                            "target_lang_translations": {
                                "ru": "Мы посетили <w>родильное отделение</w>, чтобы увидеть новорожденного.",
                                "zh": "我们去<w>产科</w>看望了那个新生儿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maternity ward"
                    ],
                    "common_phrases": [
                        "maternity unit",
                        "maternity hospital",
                        "maternity wing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отделение в больнице или специализированное учреждение, где рождаются дети",
                        "zh": "医院中专门用于接生婴儿的病房或科室。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родильное отделение",
                                "target_lang_sense_clarification": "отделение больницы"
                            },
                            {
                                "target_lang_word": "роддом",
                                "target_lang_sense_clarification": "учреждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产科",
                                "target_lang_sense_clarification": "医院的科室"
                            },
                            {
                                "target_lang_word": "产房",
                                "target_lang_sense_clarification": "接生婴儿的病房"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ccd0a6a-353d-3b62-9057-d0addfcf0aa3",
                    "sense_definition": "The state of being a mother.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_motherhood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently on <w>maternity</w> leave to care for her newborn.",
                            "target_lang_translations": {
                                "ru": "В настоящее время она находится в <w>декретном</w> отпуске по уходу за новорожденным.",
                                "zh": "她目前正在休<w>产假</w>以照顾新生儿。"
                            }
                        },
                        {
                            "text": "The joys of <w>maternity</w> have completely changed her perspective on life.",
                            "target_lang_translations": {
                                "ru": "Радости <w>материнства</w> полностью изменили её взгляд на жизнь.",
                                "zh": "为人<w>母亲</w>的喜悦彻底改变了她的人生观。"
                            }
                        }
                    ],
                    "antonyms": [
                        "paternity"
                    ],
                    "common_phrases": [
                        "maternity leave",
                        "maternity pay",
                        "maternity benefits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние женщины, являющейся матерью",
                        "zh": "身为母亲的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материнство",
                                "target_lang_sense_clarification": "состояние"
                            },
                            {
                                "target_lang_word": "декретный",
                                "target_lang_sense_clarification": "в словосочетании \"декретный отпуск\""
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "母亲",
                                "target_lang_sense_clarification": "身份状态"
                            },
                            {
                                "target_lang_word": "产假",
                                "target_lang_sense_clarification": "用于“产假”这一特定语境"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e952987-f3be-3c4a-a4fb-38dd4096e0b8",
                    "sense_definition": "The state of being pregnant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_motherhood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought some comfortable <w>maternity</w> clothes for the summer.",
                            "target_lang_translations": {
                                "ru": "Она купила удобную одежду <w>для беременных</w> на лето.",
                                "zh": "她买了一些夏天穿的舒适的<w>孕妇</w>装。"
                            }
                        },
                        {
                            "text": "Fashion for <w>maternity</w> has become much more stylish in recent years.",
                            "target_lang_translations": {
                                "ru": "Мода <w>для беременных</w> стала намного стильнее в последние годы.",
                                "zh": "近年来，<w>孕妇</w>时装变得更加时尚了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "maternity clothes",
                        "maternity wear",
                        "maternity dress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние беременности (часто используется как определение для одежды и товаров)",
                        "zh": "怀孕的状态，常用于描述孕妇专用的物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "для беременных",
                                "target_lang_sense_clarification": "об одежде или товарах"
                            },
                            {
                                "target_lang_word": "беременность",
                                "target_lang_sense_clarification": "состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "孕妇",
                                "target_lang_sense_clarification": "用于描述孕妇用品"
                            }
                        ]
                    }
                }
            ]
        }
    ]
