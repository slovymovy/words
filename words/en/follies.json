                },
                {
                    "sense_id": "d8998f27-8e40-38e0-b85b-eabf17bfb463",
                    "sense_definition": "A lavishly-produced theatrical revue characterized by major stars, huge casts, and opulent costumes and scenery.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatrical_revue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historic theater was famous for hosting spectacular Broadway <w>follies</w> during the golden age of stage entertainment.",
                            "target_lang_translations": {
                                "ru": "Исторический театр славился проведением зрелищных бродвейских <w>шоу-ревю</w> в золотой век сценического искусства."
                            }
                        },
                        {
                            "text": "She dreamed of dancing in the grand theatrical <w>follies</w> with their massive casts and beautiful costumes.",
                            "target_lang_translations": {
                                "ru": "Она мечтала танцевать в грандиозных театральных <w>ревю</w> с их огромным составом исполнителей и красивыми костюмами."
                            }
                        }
                    ],
                    "synonyms": [
