        "fr-extract.jsonl": [
            {
                "entry_id": "50ec94cb-8716-339a-b736-2f91348265e4",
                "word": "là-dedans",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2c8e01cd-059a-3c3a-b09e-6e7dae642731",
                        "entry_id": "50ec94cb-8716-339a-b736-2f91348265e4",
                        "glosses": [
                            "À l’intérieur de cet endroit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fa3e896-fb7e-4e67-8ebb-960d154a04ad",
                                "sense_id": "2c8e01cd-059a-3c3a-b09e-6e7dae642731",
                                "text": "On distingue vaguement des anciens restes de douves ; on entre quelques pas dans un souterrain comblé, on se promène là-dedans, on regarde et on s’en va."
                            }
                        ]
                    },
                    {
                        "sense_id": "436b7f3b-f381-319c-810b-ff11c258640b",
                        "entry_id": "50ec94cb-8716-339a-b736-2f91348265e4",
                        "glosses": [
                            "Dans cette affaire, dans ce texte, dans ce qui est énoncé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25543ef-e2b5-44e8-8ed2-3c12f9bd99bd",
                                "sense_id": "436b7f3b-f381-319c-810b-ff11c258640b",
                                "text": "– Lamy ? Qu’est-ce que l’évêque vient faire là-dedans ?\n– C’est moi qui l’ai prévenu de tes agissements coupables. Par la Sainte Bite de Notre Seigneur Jésus, j’y ai été contraint !"
                            }
                        ]
                    },
                    {
                        "sense_id": "fdddde4d-fdef-3374-a4cd-2f244b0f475d",
                        "entry_id": "50ec94cb-8716-339a-b736-2f91348265e4",
                        "glosses": [
                            "Dans la tête."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "112a63f0-b9a0-4760-aebf-71b7b0914496",
                                "sense_id": "fdddde4d-fdef-3374-a4cd-2f244b0f475d",
                                "text": "— Il en a là-d’dans, l’monstre. S’il voulait, bon Dieu, il deviendrait quelqu’un."
                            }
                        ]
                    }
                ],
