                ],
                "senses": [
                    {
                        "sense_id": "2cc234f9-af07-3207-8e65-964cfc533b68",
                        "entry_id": "5d732a18-82da-3702-b9bf-18275f896464",
                        "glosses": [
                            "sich hin bis zum Knöchel verengende, lange Hose, die mit einem Steg unter der Fußsohle straff gespannt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "163fddf4-370c-420e-942e-3845e9a08987",
                                "sense_id": "2cc234f9-af07-3207-8e65-964cfc533b68",
                                "text": "Die Keilhose wurde ja nicht nur auf der Piste getragen, sondern auch in der Stadt, weil sie eine sehr gute Figur gemacht hat."
                            },
                            {
                                "example_id": "2abfe0c4-da2d-4001-95a7-4cf654f51ea3",
                                "sense_id": "2cc234f9-af07-3207-8e65-964cfc533b68",
                                "text": "Maria Bogner erfand die elastische Keilhose zum Skifahren. In Amerika berichtete sogar die seriöse „New York Times“ über die Sensation aus Germany, eine „Bogner“ wurde zum Synonym für Skihosen."
                            },
                            {
                                "example_id": "d54e02f8-1947-489a-8986-e6b7c863fb1c",
                                "sense_id": "2cc234f9-af07-3207-8e65-964cfc533b68",
                                "text": "Wer auf dem Ski eine gute Figur machen wollte, ließ sich von Sepp Reinalter eine Keilhose schneidern, welche die damals figurlosen, flatternden Skihosen ablöste."
                            },
                            {
                                "example_id": "925921e2-838b-4d0c-994e-d2e246d6119d",
                                "sense_id": "2cc234f9-af07-3207-8e65-964cfc533b68",
                                "text": "Sepp Reinalter gilt als der Erfinder der Keilhose in Tirol in den 50iger Jahren. Olymiasieger und Weltmeister fuhren mit der Keilhose von Sieg zu Sieg. Darunter waren Toni Sailer, Karl Schranz, Ernst Hinterseer, Christl Haas, Traudl Hecher und viele andere."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
