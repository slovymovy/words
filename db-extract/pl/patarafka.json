                "senses": [
                    {
                        "sense_id": "73e85059-cb66-309f-828f-68cfc34b585c",
                        "entry_id": "bc3e4435-22ce-35ac-9835-e4a2d84daec4",
                        "glosses": [
                            "ozdobna haftowana serwetka służąca jako podkładka pod lampę, lichtarz, wazon lub bibeloty, także jako pokrowiec na podgłówki foteli i kanap, modna w XIX wieku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "119ff784-dfd9-4dba-b0a1-0125969c2daa",
                                "sense_id": "73e85059-cb66-309f-828f-68cfc34b585c",
                                "text": "Karol podniósł się i oglądał włóczkowe, czerwono-żółte patarafki, na jakich stały lichtarze i lampy"
                            },
                            {
                                "example_id": "e341a857-5ff1-43f2-8606-c721604750eb",
                                "sense_id": "73e85059-cb66-309f-828f-68cfc34b585c",
                                "text": "One utrzymywały porządek, one własnymi rękami wyrabiały dla ozdoby przeróżne firanki, serwetki, patarafki i osobliwsze arcydzieła krzyżowe, siatkowe i szydełkowe"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
