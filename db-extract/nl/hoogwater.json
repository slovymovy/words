                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5de9c846-5f21-4dc2-90b0-d17f41c5a76a",
                                                "sense_id": "3be8abf5-b2cb-383d-b1f9-0c1115d3eb48",
                                                "text": "One of the requirements of the design was the provision of a clear headway of 50 ft. at high water for shipping."
                                            }
                                        ]
                                    },
