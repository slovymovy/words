                ],
                "senses": [
                    {
                        "sense_id": "b221ecc8-5f08-3b23-858d-ec89afe68581",
                        "entry_id": "5b870618-a4f9-3b3a-8054-e0e56b41f078",
                        "glosses": [
                            "Arzneimittel zur Senkung von Fieber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bb6851d-6d36-41d9-ac12-c492444e6141",
                                "sense_id": "b221ecc8-5f08-3b23-858d-ec89afe68581",
                                "text": "„Ab Mitte des 19. Jahrhunderts versuchte man, das teure Chinin durch billigere und/oder wirksamere Derivate zu ersetzen. Dadurch erhielt man 1856 das giftige Abbauprodukt Chinolin, das man wiederum zur Erforschung weiterer Fiebermittel verwendete.“"
                            },
                            {
                                "example_id": "ce644d06-bf73-4a4e-9d0c-4f7f0f45b730",
                                "sense_id": "b221ecc8-5f08-3b23-858d-ec89afe68581",
                                "text": "„Die Reiseapotheke sollte ganz besonders sorgfältig gepackt sein, ein Fiebermittel in der Dosierung für Kinder von zu Hause mitnehmen, desgleichen Nasen- und Ohrentropfen.“"
                            },
                            {
                                "example_id": "c68753bd-3662-4322-9058-6dde43abd8fb",
                                "sense_id": "b221ecc8-5f08-3b23-858d-ec89afe68581",
                                "text": "„In ihrem Haus bewahrte sie ein Pulver auf, das sie aus der getrockneten Rinde des Weidenbaums gewonnen hatte. Sie verwendete es als Fiebermittel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "055e09c0-6816-335a-bb81-6cf807ca09b3",
                        "entry_id": "5b870618-a4f9-3b3a-8054-e0e56b41f078",
                        "glosses": [
                            "Arzneimittel zur Erzeugung von Fieber als Heilmethode"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f85661ed-54ba-40d8-bf21-484f4d87cdae",
                                "sense_id": "055e09c0-6816-335a-bb81-6cf807ca09b3",
                                "text": "„Der Arsenik, für das korrosivste aller Gifte gehalten, gab man sogar als Fiebermittel den Kranken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d6a1644-054a-421a-b949-756c831c1b28",
                        "source_entry_id": "5b870618-a4f9-3b3a-8054-e0e56b41f078",
                        "source_sense_id": "b221ecc8-5f08-3b23-858d-ec89afe68581",
                        "source_sense_description": "Medizin: Arzneimittel zur Senkung von Fieber",
                        "target_lang_word": "antipyretic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antipyretic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f41945f8-58a4-3d57-af85-287a70f5a01d",
                                        "entry_id": "a356fefb-6eca-3b42-84ca-3b92172f0238",
                                        "glosses": [
                                            "That reduces fever."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2d5f2b3-057b-4112-9215-427e9e1f8624",
                                                "sense_id": "f41945f8-58a4-3d57-af85-287a70f5a01d",
                                                "text": "The antipyretic action of AVP is limited mainly to its action in a precise location in the ventral septum, though there is some evidence for a similar action in the medial amygdala."
                                            },
                                            {
                                                "example_id": "fbe05c36-9714-41bd-b45c-a87d794cfdfb",
                                                "sense_id": "f41945f8-58a4-3d57-af85-287a70f5a01d",
                                                "text": "Hailed as a general remedy against fevers, it spurred hot debate among seventeenth-century medical professionals, especially in England. The bark, which includes among other active ingredients quinine, has a mild antipyretic effect and a far stronger impact in cases of malaria."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antipyretic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee11a57e-c267-3d07-9ad2-da28692cb659",
                                        "entry_id": "def69714-67e8-37a8-9e28-4785a5b6a595",
                                        "glosses": [
                                            "A medicine that reduces fever; a febrifuge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa1bf03b-276b-40dd-99c3-664e97886e87",
                        "source_entry_id": "5b870618-a4f9-3b3a-8054-e0e56b41f078",
                        "source_sense_id": "b221ecc8-5f08-3b23-858d-ec89afe68581",
                        "source_sense_description": "Medizin: Arzneimittel zur Senkung von Fieber",
                        "target_lang_word": "febrifuge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "febrifuge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "879eba3e-687f-3d45-bf69-745eecd7c0ce",
                                        "entry_id": "d325f20f-dcaa-37d6-b5fd-37ffa6a2d522",
                                        "glosses": [
                                            "Synonym of antipyretic (“a fever-reducing medication”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a836199-5ad5-4567-9084-160870a3d9a7",
                                                "sense_id": "879eba3e-687f-3d45-bf69-745eecd7c0ce",
                                                "text": "Ah, my boy, you forget the card index! Librarians invented that soothing device for the febrifuge of their souls..."
                                            },
                                            {
                                                "example_id": "b7cd963c-522a-430d-93cd-ff862aacd66b",
                                                "sense_id": "879eba3e-687f-3d45-bf69-745eecd7c0ce",
                                                "text": "...therein it differs not from the mode of operation, which we observe in the famous peruvian febrifuge."
                                            },
                                            {
                                                "example_id": "e56578b2-b89b-45b7-956f-0da742b8d0c9",
                                                "sense_id": "879eba3e-687f-3d45-bf69-745eecd7c0ce",
                                                "text": "And, by goodness, the door was ajar into the hall, for Constance had slipped out to the nearest pharmacy in search of a febrifuge for her fever-bound lover."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1be513d6-a7d9-42ec-8785-ec394f63875f",
                        "source_entry_id": "5b870618-a4f9-3b3a-8054-e0e56b41f078",
                        "source_sense_id": "b221ecc8-5f08-3b23-858d-ec89afe68581",
                        "source_sense_description": "Medizin: Arzneimittel zur Senkung von Fieber",
                        "target_lang_word": "fébrifuge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fébrifuge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1720bf51-7fcf-3d0d-9e52-f233deeac930",
                                        "entry_id": "b1e70411-bc12-398a-8696-1baeed3fa73c",
                                        "glosses": [
                                            "Qui a la propriété de combattre la fièvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9684b232-d80b-4124-ba11-c9650fffb136",
                                                "sense_id": "1720bf51-7fcf-3d0d-9e52-f233deeac930",
                                                "text": "Un remède, une plante fébrifuge."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fébrifuge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48e9c278-2baa-307f-84ff-adc723a45b5d",
                                        "entry_id": "73a7ac76-aeca-329b-bc2c-6320bc5c974a",
                                        "glosses": [
                                            "Produit faisant baisser la fièvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d4ad88-b4f5-4b85-a270-fb6044876925",
                                                "sense_id": "48e9c278-2baa-307f-84ff-adc723a45b5d",
                                                "text": "Administrer un fébrifuge."
                                            },
                                            {
                                                "example_id": "e04deb04-abdb-423d-b14c-ce426d31d082",
                                                "sense_id": "48e9c278-2baa-307f-84ff-adc723a45b5d",
                                                "text": "L’antipyrine, la quinine sont des fébrifuges."
                                            },
                                            {
                                                "example_id": "91381a5e-97f2-46ff-a2fc-f90c1df6e345",
                                                "sense_id": "48e9c278-2baa-307f-84ff-adc723a45b5d",
                                                "text": "Alors, pour tâcher de la contraindre à modifier sa réponse, nous nous adressâmes à une autre créature du même règne, mais plus puissante, qui ne se contente pas d’interroger le corps mais peut lui commander, un fébrifuge du même ordre que l’aspirine, non encore employée alors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
