                                        "sense_id": "7e6552a1-fae3-3a20-a811-dbeca275d1ab",
                                        "entry_id": "768648dc-1c0d-3c15-a17d-bc276f8b3288",
                                        "glosses": [
                                            "een land in Azië dat in de Himalaya ingeklemd ligt tussen China, Tibet en India. Het zuidelijke gedeelte van Bhutan ligt op het Indisch subcontinent"
                                        ],
                                        "tags": [],
                                        "examples": []
