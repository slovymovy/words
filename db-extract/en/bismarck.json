                                                "sense_id": "e538c074-2a94-31a9-85f1-dffbac6a0ba1",
                                                "text": "Frau Bismarck ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "3b484099-451d-425c-ba9c-ce1c1dd2c67b",
                                                "sense_id": "e538c074-2a94-31a9-85f1-dffbac6a0ba1",
                                                "text": "Herr Bismarck wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "5817c31b-afd4-4320-9fb1-aa93a624cc62",
                                                "sense_id": "e538c074-2a94-31a9-85f1-dffbac6a0ba1",
                                                "text": "Die Bismarcks fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "5411e499-8cd2-442c-8165-fa3095507b49",
                                                "sense_id": "e538c074-2a94-31a9-85f1-dffbac6a0ba1",
                                                "text": "Der Bismarck trägt nie die Schals, die die Bismarck ihm strickt."
                                            },
                                            {
                                                "example_id": "a5ed3e4f-ad3b-4f9d-9e8b-60ae395527a2",
                                                "sense_id": "e538c074-2a94-31a9-85f1-dffbac6a0ba1",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bismarck kommt, geht der Herr Bismarck.“"
                                            },
                                            {
                                                "example_id": "7edd059a-a420-4e4f-9cd3-602c68702580",
                                                "sense_id": "e538c074-2a94-31a9-85f1-dffbac6a0ba1",
                                                "text": "Bismarck kommt und geht."
                                            },
                                            {
                                                "example_id": "fe38d8f2-9c1f-4fac-98f7-d65180d34401",
                                                "sense_id": "e538c074-2a94-31a9-85f1-dffbac6a0ba1",
                                                "text": "Bismarcks kamen, sahen und siegten."
