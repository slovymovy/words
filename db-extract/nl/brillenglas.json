                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1f2d6b6-5267-4663-8840-d92c41728583",
                                "sense_id": "e5483a86-84d9-3bd9-ae0f-fd7354a216d2",
                                "text": "Het slijpen van een brillenglas is het werk van een opticien."
                            }
                        ]
