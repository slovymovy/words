                ],
                "senses": [
                    {
                        "sense_id": "2c22b1bf-2867-3a0d-90dd-4efb5dda1ede",
                        "entry_id": "4c2907ba-467e-3c3a-8bbb-44e6a34b7ee1",
                        "glosses": [
                            "leichter kreppartiger, meist gestreifter Baumwollstoff, der vorwiegend zur Herstellung von Sommerkleidung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9f1d372-e781-4c4e-b79d-473d72602525",
                                "sense_id": "2c22b1bf-2867-3a0d-90dd-4efb5dda1ede",
                                "text": "Die Geschichte des Seersucker-Stoffs reicht weit bis ins 17. und 18. Jahrhundert zurück, als dieser aus Ländern wie Indien und China nach Amerika und Europa kam."
                            },
                            {
                                "example_id": "ab4f2397-8263-47ae-857c-9a061cee8cfe",
                                "sense_id": "2c22b1bf-2867-3a0d-90dd-4efb5dda1ede",
                                "text": "Seersucker wurde erstmals anfangs des 20. Jahrhundert auf den Markt gebracht und hauptsächlich in der Kleidungsindustrie verwendet."
                            },
                            {
                                "example_id": "5f9549a7-1469-4e54-a7a0-a64f8e01580d",
                                "sense_id": "2c22b1bf-2867-3a0d-90dd-4efb5dda1ede",
                                "text": "Neben Seersucker aus Baumwolle, wird das Gewebe auch aus Microfaser hergestellt."
                            },
                            {
                                "example_id": "b2f98520-288f-4296-acaf-05ca91cca6ba",
                                "sense_id": "2c22b1bf-2867-3a0d-90dd-4efb5dda1ede",
                                "text": "Schon lange sollen die Sachen gespendet werden, sind sie doch zum Wegwerfen viel zu schade, aber wegen des Aufkommens pflegeleichter Materialien wie Biber und Seersucker nicht in Gebrauch."
                            },
                            {
                                "example_id": "6d402b2b-84d4-4683-8e0f-e2ee9614bcc7",
                                "sense_id": "2c22b1bf-2867-3a0d-90dd-4efb5dda1ede",
                                "text": "Das Kreppgewebe Seersucker sorgt im Sommer für eine gute Luftzirkulation, während Biber im Winter kuschelig wärmt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2203d1b8-8717-4585-ac09-d7da9b1cec28",
