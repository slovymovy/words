                "senses": [
                    {
                        "sense_id": "a39e5f46-3ae9-34dc-8e7c-f602a006f020",
                        "entry_id": "41b134c2-dc1b-318c-b385-60f650fea98c",
                        "glosses": [
                            "Geschäft, das modische Kleidung führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb4556e5-1158-4bd8-a38b-c381a0007125",
                                "sense_id": "a39e5f46-3ae9-34dc-8e7c-f602a006f020",
                                "text": "„Sie hatte ihren liebsten blauen Mantel und einen Hut aus einem Modehaus.“"
                            },
                            {
                                "example_id": "eee202a4-9252-4d58-b1b6-3b8fada422fc",
                                "sense_id": "a39e5f46-3ae9-34dc-8e7c-f602a006f020",
                                "text": "„Es sind Mädchen da, die in den Modehäusern arbeiten, in Verlagen.“"
                            },
                            {
                                "example_id": "ebda1336-5d53-4d70-b0c9-4fba1f31f101",
                                "sense_id": "a39e5f46-3ae9-34dc-8e7c-f602a006f020",
                                "text": "„Der Befehl ist gut; aber unsere Rückendeckung sind im Augenblick die großen Schaufenster des Modehauses Max Klein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
