                "senses": [
                    {
                        "sense_id": "b4640733-45e1-3d36-9a26-cbf8d6d9c9df",
                        "entry_id": "13e16d47-3da2-3876-b58a-dc1f3c09b840",
                        "glosses": [
                            "Zeitraum, in dem das Jagen von Wild oder Fischen bestimmter Fischarten verboten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "861663c7-66f4-4ed3-842e-38d559f920c2",
                                "sense_id": "b4640733-45e1-3d36-9a26-cbf8d6d9c9df",
                                "text": "„Im Unterschied zum Wild gibt es für Raubzeug keine Schonzeit.“"
                            },
                            {
                                "example_id": "205d1056-113b-43fd-807c-cd7b65533d06",
                                "sense_id": "b4640733-45e1-3d36-9a26-cbf8d6d9c9df",
                                "text": "„Als die Grönländer nach einer Schonzeit von 75 Jahren wieder eine Quote von drei Grönlandwalen erlegen durften, zogen sie eines der Tiere in die Rodebay.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "25529308-96b7-3c45-aac0-4b089b51289d",
                        "entry_id": "13e16d47-3da2-3876-b58a-dc1f3c09b840",
                        "glosses": [
                            "Zeitraum, in dem Fehler, ohne Gefahr Kritik dafür zu erhalten, gemacht werden dürfen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "caa1e751-bedd-4522-a8af-1d34e03fe1a1",
                                "sense_id": "25529308-96b7-3c45-aac0-4b089b51289d",
                                "text": "Die Schonzeit für die neue Partei war vorbei und es hagelte seitens der Medien längst Kritik."
                            }
                        ],
                        "sense_index_json": "\"2\""
