                        ],
                        "examples": [
                            {
                                "example_id": "b87cba47-dc5e-4ffa-93a8-002800aef310",
                                "sense_id": "60dfe59f-9c85-34eb-aeb8-341ed1c0c322",
                                "text": "Lucky Blondo est retourné en studio pour les réendisquer mais malheureusement, il n'a plus de voix et les arrangements sont horribles."
                            },
                            {
                                "example_id": "5597010f-f77b-40e6-a0eb-19c29fb4dd34",
                                "sense_id": "60dfe59f-9c85-34eb-aeb8-341ed1c0c322",
                                "text": "Je ne crois pas, qu'elle reviendra réendisquer ?"
                            },
                            {
                                "example_id": "25845d1e-5f73-4223-8b50-f28bad6d5e59",
                                "sense_id": "60dfe59f-9c85-34eb-aeb8-341ed1c0c322",
                                "text": "Cy Curnin remisant sa plume, le groupe se contentera de réendisquer des pièces déjà enregistrées mais en version spectacle."
