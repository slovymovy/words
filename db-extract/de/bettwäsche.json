                                    {
                                        "sense_id": "f758a0c2-3480-3291-81be-59b6fb0d321a",
                                        "entry_id": "e333bd6c-0755-3259-a6dc-5c66f9bffac6",
                                        "glosses": [
                                            "Sheets, blankets, quilts or other coverings used on a bed."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c24866f-dddc-4f10-8c9d-21c9327c2d03",
                                                "sense_id": "f758a0c2-3480-3291-81be-59b6fb0d321a",
                                                "text": "She pulled the bedclothes over her neck to stay warm."
                                            },
                                            {
                                                "example_id": "a5cd5e57-8063-445c-8b45-64d72fc62688",
                                                "sense_id": "f758a0c2-3480-3291-81be-59b6fb0d321a",
                                                "text": "When she was little and I went to see her in bed, I often thought she wasn't there. She lay so neatly and so straight, without a ruckle and with her head just under the top of the bedclothes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "670c3091-50b5-3908-9f6c-303da6b7abdb",
                                        "entry_id": "e333bd6c-0755-3259-a6dc-5c66f9bffac6",
                                        "glosses": [
                                            "Clothing worn to bed."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26da7d09-4d77-41ab-83c2-422e277761ba",
                                                "sense_id": "670c3091-50b5-3908-9f6c-303da6b7abdb",
                                                "text": "Tom put his bedclothes on and went to sleep."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ffeacae-c8d7-47bb-b3e8-1194809d42d7",
                        "source_entry_id": "49fd0222-93cc-364b-909f-79a7b2f4025e",
                        "source_sense_id": "9f4c3712-2bee-3c94-8d51-290cd248844c",
