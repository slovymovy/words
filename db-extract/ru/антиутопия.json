                "senses": [
                    {
                        "sense_id": "0bcc3b22-a531-393a-9051-7a62c9a44479",
                        "entry_id": "7a11ede7-1cef-31eb-b49a-0aaf3a0ab16f",
                        "glosses": [
                            "искусств. жанр фантастической литературы или фантастического кино, основанный на пессимистическом представлении о будущем человечества"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8d7a9a44-686b-3b63-8ce3-7f50781d2b83",
                        "entry_id": "7a11ede7-1cef-31eb-b49a-0aaf3a0ab16f",
                        "glosses": [
                            "произведение такого жанра"
                        ],
                        "tags": [],
