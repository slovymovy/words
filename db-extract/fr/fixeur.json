                        "entry_id": "be75dd6b-e1fe-33a2-97a0-928213f19efe",
                        "glosses": [
                            "Personne employée (comme guide, interprète etc.) par un(e) journaliste pour faciliter son travail dans une région dangereuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a4f4847-f24e-4c3a-aae4-77b9286c6727",
                                "sense_id": "bddd7d7c-e820-3662-9e58-9a7961a9079c",
                                "text": "Il est devenu très “coûteux” de couvrir le conflit afghan. Les fixeurs sont peu nombreux, aujourd’hui, à accepter de partir faire un reportage dans le Sud ou toute autre zone de combats."
                            }
                        ]
                    }
                ],
                "translations": [
