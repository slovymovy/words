                        "examples": [
                            {
                                "example_id": "3044d12d-db50-421e-bcfb-205ea3a19c85",
                                "sense_id": "e691c4ab-44c1-368a-8157-e1c0d566ea6f",
                                "text": "Pourquoi ce non-événement a-t-il généré une réaction si importante et si confuse ?"
                            },
                            {
                                "example_id": "f2ce835f-9731-4c02-b00b-6d0abc053981",
                                "sense_id": "e691c4ab-44c1-368a-8157-e1c0d566ea6f",
                                "text": "Ce chantier à 1 280 mètres d’altitude, au milieu d’une route perdue des Pyrénées, n’a pas intéressé grand monde. Quelques entrefilets dans la presse locale – et encore, relégués dans les dernières pages – pour un non-­événement dans un endroit qui ne dit rien à personne, sauf aux mordus du Tour de France (magnifique victoire de Raymond Poulidor au Portillon en 1964) et aux habitants du coin."
                            }
                        ]
