                                "target_senses": [
                                    {
                                        "sense_id": "6704d792-a5fb-3be5-86eb-cdfef6929811",
                                        "entry_id": "72a87501-61ab-3af3-93bf-9bcd202c4c0f",
                                        "glosses": [
                                            "met wolken bedekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa90e97a-83ad-4035-bb74-78ecedc65268",
                                                "sense_id": "6704d792-a5fb-3be5-86eb-cdfef6929811",
                                                "text": "Toen we het huis verlieten, kwam er ineens een bewolkte lucht boven ons."
                                            },
                                            {
                                                "example_id": "2b7b50cb-e017-4662-af6a-f7b552676941",
                                                "sense_id": "6704d792-a5fb-3be5-86eb-cdfef6929811",
                                                "text": "„Het was een bewolkte, zwoele namiddag; de matrozen hingen lui op het dek rond of staarden wezenloos over het loodkleurige water. Queequeg en ik waren rustig een zogenaamde zwaardmat aan het weven als extra sjorring voor onze sloep. Om ons heen was alles zo stil en gedempt en toch ook vervuld van wat ging komen en in de lucht hing zo’n mijmerachtige betovering dat die zwijgende mannen stuk voor stuk in hun eigen onzichtbare ik leken op te gaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c3b3d7-9ea6-3181-80fe-3f09f88a609e",
                                        "entry_id": "72a87501-61ab-3af3-93bf-9bcd202c4c0f",
                                        "glosses": [
                                            "een slechte stemming uitdrukkend"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e09ad15e-9c25-4390-be5b-a56e077fd3c7",
                                                "sense_id": "43c3b3d7-9ea6-3181-80fe-3f09f88a609e",
                                                "text": "Haar gezichtsuitdrukking veranderde van bewolkt naar onweer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dce94369-0533-4782-9822-260e5e2debca",
                        "source_entry_id": "20e67307-aefb-39cd-8dc2-3f11258db1bd",
                        "source_sense_id": "9c9358c8-5ae6-3652-9d0e-7d61d5c794e5",
                        "target_lang_word": "somber",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somber",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "034a9e8c-07f3-3867-9d7b-ef0e8ed0179d",
                                        "entry_id": "4975acdc-ed14-3f3c-add0-c475d29e5bde",
                                        "glosses": [
                                            "in neergeslagen stemming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269064a8-f582-4ed7-9a82-b4da4e0bc12a",
                                                "sense_id": "034a9e8c-07f3-3867-9d7b-ef0e8ed0179d",
                                                "text": "Hij was in een sombere bui."
                                            },
                                            {
                                                "example_id": "634d0c9a-24b2-409e-adde-0f65dc5c8858",
                                                "sense_id": "034a9e8c-07f3-3867-9d7b-ef0e8ed0179d",
                                                "text": "Iedereen hield zijn adem in toen Christa's sombere ogen in de spiegel keken en iedereen ademde opgelucht uit toen er een vage maar gemeende glimlach op haar gezicht verscheen."
                                            },
                                            {
                                                "example_id": "cf950fa0-6ffe-4d83-b3c4-6155f8c76cd2",
                                                "sense_id": "034a9e8c-07f3-3867-9d7b-ef0e8ed0179d",
                                                "text": "' 'Otto woont hier ' Nella's stem klinkt somber en uitgeput."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d04f4592-ce79-36d0-9f41-c7d5075bc6cb",
                                        "entry_id": "4975acdc-ed14-3f3c-add0-c475d29e5bde",
                                        "glosses": [
                                            "een neergeslagen stemming veroorzakend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45888957-3bab-4641-8b29-3503b352644d",
                                                "sense_id": "d04f4592-ce79-36d0-9f41-c7d5075bc6cb",
                                                "text": "Er kwam toen een sombere mededeling."
                                            },
                                            {
                                                "example_id": "d633aa8e-a1b1-479d-9c17-39a243ec04ae",
                                                "sense_id": "d04f4592-ce79-36d0-9f41-c7d5075bc6cb",
                                                "text": "De kleding van Thea's vader hangt somber aan een deur, en die van haar tante ook, in diepzwarte schakeringen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "245c44e4-a940-377c-988b-a2f97ef01325",
                                        "entry_id": "4975acdc-ed14-3f3c-add0-c475d29e5bde",
                                        "glosses": [
                                            "met weinig of geen zon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a607e599-314d-4d44-9fe9-73d8e9198315",
                                                "sense_id": "245c44e4-a940-377c-988b-a2f97ef01325",
                                                "text": "Wat een somber weer is het!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somber",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b0f7a03d-0990-3ca9-bd7c-b2d4f9c689f8",
