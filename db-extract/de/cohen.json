                ],
                "senses": [
                    {
                        "sense_id": "8bf5b5a4-5ce6-3ed0-b9ae-0b17c3fcc92a",
                        "entry_id": "a2273138-94ba-3ea1-b234-f2df8941efb4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91b89f55-ccce-4a40-b94b-cafbc7fc714c",
                                "sense_id": "8bf5b5a4-5ce6-3ed0-b9ae-0b17c3fcc92a",
                                "text": "Frau Cohen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d1872b61-31f1-4299-b208-250980eaeb0e",
                                "sense_id": "8bf5b5a4-5ce6-3ed0-b9ae-0b17c3fcc92a",
                                "text": "Herr Cohen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "acc47fb1-cc83-4701-895a-590017741c7e",
                                "sense_id": "8bf5b5a4-5ce6-3ed0-b9ae-0b17c3fcc92a",
                                "text": "Die Cohens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "20ac1507-f01d-4826-ad12-f53a372355b9",
                                "sense_id": "8bf5b5a4-5ce6-3ed0-b9ae-0b17c3fcc92a",
                                "text": "Der Cohen trägt nie die Schals, die die Cohen ihm strickt."
                            },
                            {
                                "example_id": "9db3614f-4c1e-4b07-bf55-4a2d26d8ecfd",
                                "sense_id": "8bf5b5a4-5ce6-3ed0-b9ae-0b17c3fcc92a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Cohen kommt, geht der Herr Cohen.“"
                            },
                            {
                                "example_id": "4068211b-ce23-4e34-ae06-18e8dc05288a",
                                "sense_id": "8bf5b5a4-5ce6-3ed0-b9ae-0b17c3fcc92a",
                                "text": "Cohen kommt und geht."
                            },
                            {
                                "example_id": "fe05b6f1-8852-4c0d-9faa-43e1177be533",
                                "sense_id": "8bf5b5a4-5ce6-3ed0-b9ae-0b17c3fcc92a",
                                "text": "Cohens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
