                                "target_senses": [
                                    {
                                        "sense_id": "593bd603-377c-39cd-bf2a-a2dc56b30fbc",
                                        "entry_id": "760794ba-28a5-3e4e-97eb-d230bf43e0c9",
                                        "glosses": [
                                            "Volume aménagé dans la console avant d’un véhicule, muni d’une porte et destiné au rangement de menus objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a954bb4b-398a-4958-b624-7eaa445dc18e",
                                                "sense_id": "593bd603-377c-39cd-bf2a-a2dc56b30fbc",
                                                "text": "Puis, devant l’impassibilité de grand-père, elle entreprenait de colmater les brèches à l’aide de vieux chiffons qui traînaient dans la « boîte à gants » (une tablette sous le tableau de bord)."
                                            },
                                            {
                                                "example_id": "68433a02-fca5-4981-bb68-b5ac88029a5c",
                                                "sense_id": "593bd603-377c-39cd-bf2a-a2dc56b30fbc",
                                                "text": "Cette boîte à gants était pleine de clefs de rechange. Donc, je savais bien que ça allait finir par arriver. J’ai passé un marché avec moi-même. Qu’il serait temps d’arrêter les conneries quand il n’y aurait plus de clefs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "559f6f9e-6b56-3b70-8bfd-3913bd33ec23",
                                        "entry_id": "760794ba-28a5-3e4e-97eb-d230bf43e0c9",
                                        "glosses": [
                                            "Enceinte étanche et transparente qui est équipée de gants intégrés permettant la manipulation, sous atmosphère contrôlée, de substances nécessitant un confinement."
                                        ],
                                        "tags": [
                                            "Cycle du combustible nucléaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
