        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a70a207-e60e-309f-8577-e9317824390b",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>keveren</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "keveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kever</w> de hele middag over onbelangrijke details.",
                            "target_lang_translations": {
                                "en": "I <w>chatter</w> all afternoon about unimportant details."
                            }
                        },
                        {
                            "text": "Als ik begin te praten, <w>kever</w> ik soms maar door.",
                            "target_lang_translations": {
                                "en": "When I start talking, I sometimes just <w>ramble</w> on."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van keveren"
                        }
                    ],
                    "target_lang_definitions": {
