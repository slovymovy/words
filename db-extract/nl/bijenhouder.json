                    {
                        "translation_id": "bd720189-1384-4c66-8d7f-c3dd3a9d2761",
                        "source_entry_id": "11e4620b-f165-3dfa-8b9f-43ded50caab9",
                        "source_sense_id": "4815735a-4d23-3c50-9684-0ed2ceb15711",
                        "source_sense_description": "iemand die bijen houdt voor het verkrijgen van honing",
                        "target_lang_word": "apiculteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apiculteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c005f7f-de6b-3e43-873e-6a8eb06c4fe9",
                                        "entry_id": "6d278379-4af8-37e3-ad2d-8994497a18d2",
                                        "glosses": [
                                            "Celui qui élève des abeilles."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59905dfe-803b-47d4-a101-70d3c40ccf3d",
                                                "sense_id": "7c005f7f-de6b-3e43-873e-6a8eb06c4fe9",
                                                "text": "Ce n’est pas le cas aujourd’hui pour l’apiculteur landernéen, même si la difficulté à trouer l’emplacement des nids empêche une éradication vraiment massive."
                                            },
                                            {
                                                "example_id": "6c097dec-35f4-4c6c-a619-c038ab49198e",
                                                "sense_id": "7c005f7f-de6b-3e43-873e-6a8eb06c4fe9",
                                                "text": "En 1910, les abeilles pointent elles aussi les aiguilles de leur montre vers le médecin suisse Auguste Forel. Dans son chalet à la montagne, cet apiculteur constate que ses tartines de confiture attirent vite les abeilles quand il prend son petit déjeuner dehors."
                                            },
                                            {
                                                "example_id": "d16da0de-31d0-4de1-a9d5-a6f7072eecd9",
                                                "sense_id": "7c005f7f-de6b-3e43-873e-6a8eb06c4fe9",
                                                "text": "Les traitements doivent avoir lieu au plus tard au début de la floraison. En fait, ils ont lieu bien souvent alors que les colzas sont en pleine floraison et intensément visités par les Abeilles. On assiste alors à des hécatombes qui provoquent la colère des apiculteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50434e7d-29d5-4260-a0d2-c16777461538",
                        "source_entry_id": "11e4620b-f165-3dfa-8b9f-43ded50caab9",
                        "source_sense_id": "4815735a-4d23-3c50-9684-0ed2ceb15711",
                        "source_sense_description": "iemand die bijen houdt voor het verkrijgen van honing",
                        "target_lang_word": "colmenero",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colmenero",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "430ba40e-dd75-3c1f-99ae-0a3b381c4e63",
                                        "entry_id": "a784ce23-3ec1-3b69-b465-e2b517bb8e10",
                                        "glosses": [
                                            "Persona que tiene colmenas o cuida de ellas."
                                        ],
                                        "tags": [
                                            "Oficios"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbae46bf-9e80-47ff-9fd7-cedfbc6425c1",
                                                "sense_id": "430ba40e-dd75-3c1f-99ae-0a3b381c4e63",
                                                "text": "«Los hornillos en su interior tienen unos travesaños cruzados (tranca) que cumplen la misión de sostener el peso de los panales e indicar al colmenero la cantidad de reservas que debe dejar al efectuar la “cata”»."
                                            },
                                            {
                                                "example_id": "4c9cf97b-d875-444b-b8d1-e7a50c3d0ebe",
                                                "sense_id": "430ba40e-dd75-3c1f-99ae-0a3b381c4e63",
                                                "text": "«Muchos colmeneros capturan todos los enjambres posibles, porque para ellos es la única forma de reponer las abundantes bajas invernales»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
