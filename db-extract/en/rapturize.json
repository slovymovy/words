                ],
                "senses": [
                    {
                        "sense_id": "ab83e081-72d1-34eb-b6eb-7580b6f13f3b",
                        "entry_id": "15abd63f-7343-398e-a4e3-ea46e25425f1",
                        "glosses": [
                            "To put in a state of rapture."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "879be4cd-4bc5-444e-815f-ad42bdf868d6",
                                "sense_id": "ab83e081-72d1-34eb-b6eb-7580b6f13f3b",
                                "text": "Soothing's various systems were tried, and her amanuensis (he who pens this, by their desire) laid her strange malady before your august body: and then it was, the light of your penetration rapturized the world by proclaiming, that her wings, instead of those her fears imagined, were long enough for her intended flight […]"
                            },
                            {
                                "example_id": "9535d8be-bb15-4f8b-8ba0-a1ebea7af087",
                                "sense_id": "ab83e081-72d1-34eb-b6eb-7580b6f13f3b",
                                "text": "\"Do not rapturize her with love, hombre,\" said Jorge, coming down the path, hitching up his white trousers."
                            },
                            {
                                "example_id": "c969a449-b21a-4aed-b7b6-8a5ca7f08e89",
                                "sense_id": "ab83e081-72d1-34eb-b6eb-7580b6f13f3b",
                                "text": "Speakers broke into song and verse as they rapturized the revolutionary upsurge in Paris and the start of \"freedom's glorious reign.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b3ee1061-4ab7-3084-8d43-30cee39021fb",
                        "entry_id": "15abd63f-7343-398e-a4e3-ea46e25425f1",
                        "glosses": [
                            "To enter a state of rapture."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8dd744cf-12da-4f45-aaac-7caf4fb06031",
                                "sense_id": "b3ee1061-4ab7-3084-8d43-30cee39021fb",
                                "text": "I will not rapturize again: but I give myself great credit in not being crazy out of pure delight."
                            },
                            {
                                "example_id": "206f19ac-1d72-4bc8-8805-1379e1cea4f1",
                                "sense_id": "b3ee1061-4ab7-3084-8d43-30cee39021fb",
                                "text": "They discuss its ruins, rapturize over its statues, bask in its sunshine, criticise its pictures, stare a little at its Church ceremonies—and this is all."
                            },
                            {
                                "example_id": "bf5d8b7d-2e0c-4255-8cf2-bf93a054691b",
                                "sense_id": "b3ee1061-4ab7-3084-8d43-30cee39021fb",
                                "text": "Don Gonselmo had but about three attendants, who were busily engaged in rapturizing and listening with their mouths, for they were wide open, to the enchanting tones of the fair Zuletta—when before them stood, uncovered, uncloaked, and not expected, a well-dressed stranger."
                            }
                        ]
                    }
