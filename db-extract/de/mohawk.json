                "senses": [
                    {
                        "sense_id": "2139963f-0a5c-3a4d-b4e4-0841ea3c583b",
                        "entry_id": "fce40562-db34-3e29-8f43-749f6ba2ba77",
                        "glosses": [
                            "Sprache, die vom gleichnamigen Volk im Nordosten Nordamerikas gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a0b3ad-0aff-4e71-b388-4af0956e78b8",
                                "sense_id": "2139963f-0a5c-3a4d-b4e4-0841ea3c583b",
                                "text": "„aber der erste Text, den sie noch in ihrem Gründungsjahr herausbrachte, war eine neue Übersetzung des Johannesevangeliums in Mohawk, einer kanadischen Indianersprache[…]“"
                            },
                            {
                                "example_id": "6e5e5252-cc18-4abc-8f1f-af51eb5bcf3a",
                                "sense_id": "2139963f-0a5c-3a4d-b4e4-0841ea3c583b",
                                "text": "„Es ist empirisch gehaltvoll festzustellen, dass beispielsweise das Mohawk die Eigenschaft, eine Infinitivstruktur aufzuweisen, nicht besitzt[…].“"
                            },
                            {
                                "example_id": "84c17ad6-8012-4841-8bd0-c8133422165d",
                                "sense_id": "2139963f-0a5c-3a4d-b4e4-0841ea3c583b",
                                "text": "„Typ-2-Grammatiken sind z.B. für Mohawk inadäquat, weil die Sprache beliebig viele ineinandergeschobene Symbolentsprechungen aufweist, die diese nicht aufweisen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
