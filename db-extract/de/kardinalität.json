                "senses": [
                    {
                        "sense_id": "d7e0c021-e600-3527-9c11-1eef07f45641",
                        "entry_id": "3c8cee3e-217b-3ff4-aae5-d569073a202a",
                        "glosses": [
                            "Anzahl der Elemente einer Menge; Mächtigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c903e3f-f656-44ed-8b77-412535a084ed",
                                "sense_id": "d7e0c021-e600-3527-9c11-1eef07f45641",
                                "text": "„|M| = ∞. Es bezeichnet |M| die Mächtigkeit (Kardinalität) von M, doch ∞ ist keine Kardinalzahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f1448c0a-b620-3710-9f04-303428d73fc9",
                        "entry_id": "3c8cee3e-217b-3ff4-aae5-d569073a202a",
                        "glosses": [
                            "Mengenangabe zu Beziehungstypen"
                        ],
                        "tags": [
                            "EDV",
                            "Datenbank"
                        ],
                        "examples": [
                            {
                                "example_id": "7c1b88f3-2b55-4e8c-ab40-e7027d58361d",
                                "sense_id": "f1448c0a-b620-3710-9f04-303428d73fc9",
                                "text": "„Die Kardinalität einer Beziehung bezeichnet die Anzahl der Zeilen einer untergeordneten Tabelle, die sich auf eine einzelne Zeile einer übergeordneten Tabelle beziehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d2f24e7-e9dd-4549-9e6e-56a7cddc3553",
                        "source_entry_id": "3c8cee3e-217b-3ff4-aae5-d569073a202a",
                        "source_sense_id": "d7e0c021-e600-3527-9c11-1eef07f45641",
                        "source_sense_description": "Mathematik: Anzahl der Elemente einer Menge; Mächtigkeit",
                        "target_lang_word": "cardinality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardinality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55077813-4fc6-3245-98e1-76cc0028cf21",
                                        "entry_id": "7e8d2c40-4458-3ef5-9883-71993a59050f",
                                        "glosses": [
                                            "The number of elements a given set contains."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64528598-186c-42e2-a1cd-e0edcc5aee4a",
                                                "sense_id": "55077813-4fc6-3245-98e1-76cc0028cf21",
                                                "text": "The empty set has a cardinality of zero."
                                            },
                                            {
                                                "example_id": "f06e35f9-a12f-464d-ab43-3913141aad53",
                                                "sense_id": "55077813-4fc6-3245-98e1-76cc0028cf21",
                                                "text": "The cardinality of a set A is the least ordinal α such that there exists a bijection between A and α. We sometimes use the notation #92;alpha#61;#124;A#124; to indicate this."
                                            },
                                            {
                                                "example_id": "f48cc85f-13d5-4526-b53d-4c11854168a7",
                                                "sense_id": "55077813-4fc6-3245-98e1-76cc0028cf21",
                                                "text": "For fuzzy sets, the concept of set size or cardinality is both richer and more problematic than it is for crisp sets. It is richer because, as we shall see, we may use more than one kind of cardinality."
                                            },
                                            {
                                                "example_id": "ae554e23-3489-4acd-8f3a-dd91e178bcf1",
                                                "sense_id": "55077813-4fc6-3245-98e1-76cc0028cf21",
                                                "text": "Clearly, in this example, the sensitivity to the cardinalities takes the weaker form F#91;M(A)#93;#61;#92;overset#123;#61;#125;#123;A#125; of a single-valued function from the measure to the cardinality rather than the stronger form M(A)#61;f(#92;overset#123;#61;#125;#123;A#125;) of a function from the cardinality to the measure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1649f4a4-6e89-3ba9-ad28-5c2eff31ee18",
                                        "entry_id": "7e8d2c40-4458-3ef5-9883-71993a59050f",
                                        "glosses": [
                                            "The number of terms that can inhabit a type; the possible values of a type."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e620a652-ddfd-4683-8528-11060dc323bb",
                                                "sense_id": "1649f4a4-6e89-3ba9-ad28-5c2eff31ee18",
                                                "text": "For many types, such as String, the set of possible values is unlimited. Such types have an infinite cardinality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d5c86fb-98db-3616-919f-805cd59bb0ee",
                                        "entry_id": "7e8d2c40-4458-3ef5-9883-71993a59050f",
                                        "glosses": [
                                            "The property of a relationship between a database table and another one, specifying whether it is one-to-one, one-to-many, many-to-one, or many-to-many."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c10206a-a209-39ad-9faa-cec285dc29e7",
                                        "entry_id": "7e8d2c40-4458-3ef5-9883-71993a59050f",
                                        "glosses": [
                                            "The status of being cardinalitial"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
