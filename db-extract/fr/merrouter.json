                "senses": [
                    {
                        "sense_id": "e5e2c0c5-647f-3022-94ec-a25d22f7fdd0",
                        "entry_id": "eade8038-af20-3aa1-9773-1b7ee92a1354",
                        "glosses": [
                            "Transporter jusqu’à destination par merroutage (en associant transport routier et bateaux pour transporter les camions)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0b410d6-31f5-4db8-8b4d-2472a6fe7a0f",
                                "sense_id": "e5e2c0c5-647f-3022-94ec-a25d22f7fdd0",
                                "text": "Conclusion, il faut désormais ferrouter, merrouter, circuler davantage en files indiennes, organiser ces files sur des parkings de préparations et de délestages aux portes des villes et des destinations."
                            },
                            {
                                "example_id": "e5d094f4-5a6e-4a39-9b4a-539a6838f915",
                                "sense_id": "e5e2c0c5-647f-3022-94ec-a25d22f7fdd0",
                                "text": "Serge Lepeltier, ministre de l'Ecologie, est également attendu pour rappeler que «merrouter», c'est aussi protéger l'environnement."
                            },
                            {
                                "example_id": "b61f5883-40f7-4371-a26b-74d40be87d2e",
                                "sense_id": "e5e2c0c5-647f-3022-94ec-a25d22f7fdd0",
                                "text": "APRÈS TOULON, CHERBOURG VEUT MERROUTER."
                            }
                        ]
                    }
