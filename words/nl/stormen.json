                    "sense_id": "c7bbab21-12d4-3265-bb63-60e8956a7685",
                    "sense_definition": "Bijzonder sterk en hevig waaien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>stormde</w> geweldig die nacht en er verging een aantal schepen.",
                            "target_lang_translations": {
                                "ru": "В ту ночь сильно <w>штормило</w>, и несколько кораблей затонуло.",
                                "en": "It <w>stormed</w> terribly that night and a number of ships were lost.",
                                "pl": "Tej nocy <w>szalała</w> potężna wichura i zatonęło kilka statków.",
                                "de": "Es <w>stürmte</w> in jener Nacht gewaltig und einige Schiffe gingen unter.",
                                "fr": "Il <w>tempêtait</w> violemment cette nuit-là et plusieurs navires ont fait naufrage.",
                                "it": "Quella notte <w>imperversava</w> una tempesta terribile e diverse navi affondarono.",
                                "cs": "Tu noc <w>zuřila</w> silná bouře a několik lodí ztroskotalo.",
                                "tr": "O gece müthiş bir <w>fırtına koptu</w> ve birkaç gemi battı.",
                                "es": "Esa noche <w>hubo una tormenta</w> terrible y varios barcos naufragaron.",
                                "zh": "那天晚上<w>刮着狂风</w>，好几艘船都沉没了。"
                            }
                        },
                        {
                            "text": "Als het buiten <w>stormt</w>, blijven de meeste mensen liever binnen.",
                            "target_lang_translations": {
                                "ru": "Когда на улице <w>штормит</w>, большинство людей предпочитают оставаться дома.",
                                "en": "When it <w>storms</w> outside, most people prefer to stay indoors.",
                                "pl": "Kiedy na zewnątrz <w>szaleje wichura</w>, większość ludzi woli zostać w domu.",
                                "de": "Wenn es draußen <w>stürmt</w>, bleiben die meisten Menschen lieber drinnen.",
                                "fr": "Quand il <w>tempête</w> dehors, la plupart des gens préfèrent rester à l'intérieur.",
                                "it": "Quando fuori <w>infuria la tempesta</w>, la maggior parte delle persone preferisce restare in casa.",
                                "cs": "Když venku <w>bouří</w>, většina lidí raději zůstává doma.",
                                "tr": "Dışarıda <w>fırtına koptuğunda</w>, çoğu insan içeride kalmayı tercih eder.",
                                "es": "Cuando <w>hay tormenta</w> afuera, la mayoría de la gente prefiere quedarse dentro.",
                                "zh": "当外面<w>狂风大作</w>时，大多数人宁愿待在室内。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spoken",
