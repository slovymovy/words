                                "target_senses": [
                                    {
                                        "sense_id": "286dfbf0-05e7-3612-a7b3-909ac2464a79",
                                        "entry_id": "3e3f1ab3-69c6-3016-81ec-a7d50a697fdc",
                                        "glosses": [
                                            "Vocalise d’une grande virtuosité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae83e2c-f019-4de6-aa03-cc0757a3d3f9",
                                                "sense_id": "286dfbf0-05e7-3612-a7b3-909ac2464a79",
                                                "text": "Les opéras de Rossini regorgent de coloratures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5962e903-59c5-31a3-9b70-3f495966c26e",
                                        "entry_id": "3e3f1ab3-69c6-3016-81ec-a7d50a697fdc",
                                        "glosses": [
                                            "Personne capable de cette virtuosité vocale, notamment dans les aiguës."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1b52b98-f02f-43da-9f4c-dfb22d3ba66c",
                                                "sense_id": "5962e903-59c5-31a3-9b70-3f495966c26e",
                                                "text": "Les plus grandes coloratures ont interprété l’air de la Reine de la nuit de Mozart (\"La Flûte enchantée\") ou \"Les oiseaux dans la charmille\" d’Offenbach (\"Les contes d’Hoffmann\")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "202f018f-a429-49b7-bbe1-0005eba9d5af",
                        "source_entry_id": "473613ba-d461-346a-a64a-a2e5801a59eb",
                        "source_sense_id": "fe0be408-933a-3dd0-8a5a-0a7196e39c7c",
