                "senses": [
                    {
                        "sense_id": "9ec2e500-eb2c-39ba-8d8f-8b9b48667023",
                        "entry_id": "dcdc1a67-85d1-38e9-91e7-8ef6fd75a880",
                        "glosses": [
                            "Adverb, das einen Relativsatz einleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe0945b0-4fbf-450c-a6ee-3ff4064a2d0f",
                                "sense_id": "9ec2e500-eb2c-39ba-8d8f-8b9b48667023",
                                "text": "In dem Satz „Ich habe dir etwas zu berichten, worüber du dich hoffentlich sehr freuen wirst“ ist „worüber“ ein Relativadverb."
                            },
                            {
                                "example_id": "968d5964-e6c9-4a40-8bdc-3b5074a486b9",
                                "sense_id": "9ec2e500-eb2c-39ba-8d8f-8b9b48667023",
                                "text": "„Relativadverbien leiten einen Relativsatz ein und beziehen sich auf eine vorgenannte Bezugsgröße.“"
                            },
                            {
                                "example_id": "da92a6a2-f922-4359-b48e-3c0f89cd85db",
                                "sense_id": "9ec2e500-eb2c-39ba-8d8f-8b9b48667023",
                                "text": "„Relativadverbien: Adverbien, die Relativsätze einleiten können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
