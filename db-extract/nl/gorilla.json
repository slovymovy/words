                    {
                        "translation_id": "4a8a8c06-9501-43b8-b8e1-5ca0fc8f6ad8",
                        "source_entry_id": "eba78e65-9571-373b-82c1-84e98d87dcf3",
                        "source_sense_id": "fe04e66c-c027-309e-9113-64282083f87a",
                        "source_sense_description": "Afrikaanse mensaap uit het geslacht Gorilla",
                        "target_lang_word": "gorilla",
