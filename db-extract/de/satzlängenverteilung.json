                "senses": [
                    {
                        "sense_id": "486442be-8132-3221-9b12-630139889ef5",
                        "entry_id": "0d3603d7-8154-394e-b720-c4f75732ac75",
                        "glosses": [
                            "Linguistik, speziell Angabe/Übersicht zur Häufigkeit der Sätze unterschiedlicher Länge in einem Text oder Korpus"
                        ],
                        "tags": [
                            "Quantitative Linguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "5e124d49-433d-4324-a3b8-56b337571970",
                                "sense_id": "486442be-8132-3221-9b12-630139889ef5",
                                "text": "„Insofern erscheint es angemessen, die oben vorgetragene Auffassung der Übertragung von Clines aus dem biologischen in den stilistischen Bereich am Beispiel der Satzlängenverteilung zu illustrieren.“"
                            },
                            {
                                "example_id": "47d50dab-8c90-473a-be99-5bb313fe6ee9",
                                "sense_id": "486442be-8132-3221-9b12-630139889ef5",
                                "text": "„Auch hierzu ist wieder zu sagen, daß eine einzige Stilcharakteristik, die Satzlängenverteilung, viel zu wenig ist.“"
                            },
                            {
                                "example_id": "23bac743-5842-4f3e-9c2c-34c4cfc27d36",
                                "sense_id": "486442be-8132-3221-9b12-630139889ef5",
                                "text": "„Im Allgemeinen gilt die negative Binomialverteilung als gutes Modell für die Satzlängenverteilung in Texten und Textstichproben auch typologisch unterschiedlicher Sprachen, wobei die Satzlänge in Clauses gemessen wird (..).“"
                            },
                            {
                                "example_id": "9946e6ab-2806-452a-a900-e4fa04d37957",
                                "sense_id": "486442be-8132-3221-9b12-630139889ef5",
                                "text": "„Kann man mit demselben Modell die Satzlängenverteilungen darstellen, gleich, ob Satzlänge in „clauses“ oder in Wörtern (oder noch andern Einheiten) gemessen wird?“"
                            },
                            {
                                "example_id": "30df9ee3-c96a-428f-ab1f-fc97cd8f43f2",
                                "sense_id": "486442be-8132-3221-9b12-630139889ef5",
                                "text": "„Für mittellange deutsche Texte bestätigte sich die Hypothese, daß die 0-gestutzte negative Binomialverteilung ein geeignetes Modell der Satzlängenverteilung ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
