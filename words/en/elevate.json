{
    "word_family": [
        "elevation",
        "elevator",
        "elevated"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32d81343-33d8-3f2b-b87e-0fabf828cbc2",
                    "sense_definition": "To raise something to a higher physical position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_raising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor told me <w>elevating</w> my legs would help reduce the swelling.",
                            "target_lang_translations": {
                                "ru": "Врач сказал мне, что <w>поднятие</w> ног поможет уменьшить отек.",
                                "zh": "医生告诉我，把腿<w>抬高</w>有助于消肿。"
                            }
                        },
                        {
                            "text": "Abdulla expressed his surprise by <w>elevating</w> his eyebrows.",
                            "target_lang_translations": {
                                "ru": "Абдулла выразил удивление, <w>приподняв</w> брови.",
                                "zh": "阿卜杜拉<w>扬起</w>眉毛，表达了他的惊讶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lift",
                        "raise"
                    ],
                    "antonyms": [
                        "drop",
                        "lower"
                    ],
                    "common_phrases": [
                        "elevate your legs",
                        "elevate the platform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднять что-либо в более высокое физическое положение.",
                        "zh": "将某物移动到更高的物理位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "перемещать вверх"
                            },
                            {
                                "target_lang_word": "приподнимать",
                                "target_lang_sense_clarification": "немного выше"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抬高",
                                "target_lang_sense_clarification": "移动到更高位置"
                            },
                            {
                                "target_lang_word": "举起",
                                "target_lang_sense_clarification": "向上移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cc05d29-752d-3796-83f5-7f7b9df965c2",
                    "sense_definition": "To promote someone to a higher rank or position of authority.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "promotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board decided to <w>elevate</w> her to the position of CEO after the successful merger.",
                            "target_lang_translations": {
                                "ru": "Совет директоров решил <w>повысить</w> ее до должности генерального директора после успешного слияния.",
                                "zh": "合并成功后，董事会决定将她<w>提拔</w>为首席执行官。"
                            }
                        },
                        {
                            "text": "It is dangerous to <w>elevate</w> mediocre people to positions of authority.",
                            "target_lang_translations": {
                                "ru": "Опасно <w>возвышать</w> посредственных людей до властных полномочий.",
                                "zh": "将平庸之辈<w>提拔</w>到领导岗位是很危险的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "promote",
                        "exalt"
                    ],
                    "antonyms": [
                        "demote"
                    ],
                    "common_phrases": [
                        "elevate to rank",
                        "elevate to status"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повысить кого-либо в звании или должности.",
                        "zh": "提升某人的职位或职权。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышать",
                                "target_lang_sense_clarification": "в должности или звании"
                            },
                            {
                                "target_lang_word": "возвышать",
                                "target_lang_sense_clarification": "давать высокий статус"
                            },
                            {
                                "target_lang_word": "продвигать",
                                "target_lang_sense_clarification": "по службе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提拔",
                                "target_lang_sense_clarification": "提升职位"
                            },
                            {
                                "target_lang_word": "晋升",
                                "target_lang_sense_clarification": "职级上升"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4aebf7b6-9925-3325-b3ce-0c906b72b78f",
                    "sense_definition": "To make something or someone more worthy, refined, or of greater value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A talented chef can <w>elevate</w> everyday ingredients into gourmet delights.",
                            "target_lang_translations": {
                                "ru": "Талантливый шеф-повар может <w>превратить</w> обычные ингредиенты в изысканные деликатесы.",
                                "zh": "天才厨师能将日常食材<w>提升</w>为美味佳肴。"
                            }
                        },
                        {
                            "text": "The new lighting will <w>elevate</w> the mood of the entire room.",
                            "target_lang_translations": {
                                "ru": "Новое освещение <w>улучшит</w> атмосферу во всей комнате.",
                                "zh": "新的照明设计将<w>提升</w>整个房间的氛围。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ennoble",
                        "exalt"
                    ],
                    "common_phrases": [
                        "elevate the experience",
                        "elevate the style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо или кого-либо более достойным, изысканным или ценным.",
                        "zh": "使某人或某物变得更优秀、更精致或更有价值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвышать",
                                "target_lang_sense_clarification": "делать благороднее"
                            },
                            {
                                "target_lang_word": "облагораживать",
                                "target_lang_sense_clarification": "делать лучше, качественнее"
                            },
                            {
                                "target_lang_word": "выводить на новый уровень",
                                "target_lang_sense_clarification": "улучшать качество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提升",
                                "target_lang_sense_clarification": "提高品质或水平"
                            },
                            {
                                "target_lang_word": "升华",
                                "target_lang_sense_clarification": "提高到更高境界"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d05a808-9aea-39a8-a3f4-1232a227b110",
                    "sense_definition": "To increase the intensity, degree, or level of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some drugs have the side effect of <w>elevating</w> your blood sugar level.",
                            "target_lang_translations": {
                                "ru": "Некоторые лекарства имеют побочный эффект в виде <w>повышения</w> уровня сахара в крови.",
                                "zh": "有些药物的副作用是会<w>提高</w>血糖水平。"
                            }
                        },
                        {
                            "text": "The stressful news began <w>elevating</w> his heart rate significantly.",
                            "target_lang_translations": {
                                "ru": "Стрессовые новости начали значительно <w>увеличивать</w> частоту его сердечных сокращений.",
                                "zh": "令人紧张的消息使他的心率显著<w>增加</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "increase",
                        "raise"
                    ],
                    "antonyms": [
                        "decrease",
                        "reduce",
                        "lower",
                        "diminish"
                    ],
                    "common_phrases": [
                        "elevate the level",
                        "elevate the temperature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличить интенсивность, степень или уровень чего-либо.",
                        "zh": "增加某事物的强度、程度或水平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышать",
                                "target_lang_sense_clarification": "уровень, температуру, давление"
                            },
                            {
                                "target_lang_word": "увеличивать",
                                "target_lang_sense_clarification": "показатели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提高",
                                "target_lang_sense_clarification": "增加水平或程度"
                            },
                            {
                                "target_lang_word": "增加",
                                "target_lang_sense_clarification": "提升数值"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9540e0c-9da9-3275-93bb-ed27417f3d74",
                    "sense_definition": "To lift the spirits or mood of someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_lift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beautiful music helped <w>elevate</w> his spirits after a long day.",
                            "target_lang_translations": {
                                "ru": "Прекрасная музыка помогла <w>поднять</w> ему настроение после долгого дня.",
                                "zh": "美妙的音乐帮助他在漫长的一天后<w>振奋</w>了精神。"
                            }
                        },
                        {
                            "text": "Kind words from a friend can <w>elevate</w> the soul during hard times.",
                            "target_lang_translations": {
                                "ru": "Добрые слова друга могут <w>возвысить</w> душу в трудные времена.",
                                "zh": "朋友的暖心话语能在困难时期<w>振奋</w>人的精神。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cheer up",
                        "elate"
                    ],
                    "antonyms": [
                        "depress",
                        "sadden"
                    ],
                    "common_phrases": [
                        "elevate the spirit",
                        "elevate the mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднять настроение или дух кому-либо.",
                        "zh": "改善某人的情绪或精神状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "настроение или дух"
                            },
                            {
                                "target_lang_word": "воодушевлять",
                                "target_lang_sense_clarification": "вдохновлять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "振奋",
                                "target_lang_sense_clarification": "使精神振作"
                            },
                            {
                                "target_lang_word": "提振",
                                "target_lang_sense_clarification": "改善情绪"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50efe975-e275-3f09-bc3a-e001dfdb10ff",
                    "sense_definition": "To temporarily grant a computer program additional security privileges to perform a specific action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Did you forget that all programs that modify the registry need to be <w>elevated</w>?",
                            "target_lang_translations": {
                                "ru": "Вы забыли, что все программы, изменяющие реестр, должны быть <w>запущены с повышенными правами</w>?",
                                "zh": "你忘了吗？所有修改注册表的程序都需要<w>提升</w>权限。"
                            }
                        },
                        {
                            "text": "You must <w>elevate</w> the command prompt to run this administrative script.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>повысить привилегии</w> командной строки, чтобы запустить этот административный скрипт.",
                                "zh": "你必须<w>提升</w>命令提示符的权限才能运行此管理脚本。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "elevate privileges",
                        "elevate permissions"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical usage in computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Временно предоставить компьютерной программе дополнительные права безопасности для выполнения действия.",
                        "zh": "临时授予计算机程序额外的安全权限以执行特定操作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышать",
                                "target_lang_sense_clarification": "права или привилегии"
                            },
                            {
                                "target_lang_word": "запускать от имени администратора",
                                "target_lang_sense_clarification": "в контексте ОС"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提升",
                                "target_lang_sense_clarification": "提高权限"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "584514c1-80a7-371f-b460-7f3b2d35b130",
                    "sense_definition": "To make someone slightly intoxicated or tipsy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wine began to <w>elevate</w> the guests at the dinner party.",
                            "target_lang_translations": {
                                "ru": "Крепкое вино начало <w>пьянить</w> гостей на званом ужине.",
                                "zh": "烈酒开始让晚宴上的客人们感到<w>微醺</w>。"
                            }
                        },
                        {
                            "text": "He felt slightly <w>elevated</w> after just one glass of the potent cider.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя слегка <w>навеселе</w> всего после одного бокала крепкого сидра.",
                                "zh": "只喝了一杯烈性苹果酒，他就感到有些<w>微醺</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used to describe mild drunkenness"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызвать у кого-либо легкое опьянение.",
                        "zh": "使人产生轻微的醉意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьянить",
                                "target_lang_sense_clarification": "вызывать опьянение"
                            },
                            {
                                "target_lang_word": "дурманить",
                                "target_lang_sense_clarification": "вскружить голову"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微醺",
                                "target_lang_sense_clarification": "形容轻微醉酒状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df0aa208-c0e2-3236-90eb-37662ceed800",
                    "sense_definition": "To attempt to make something seem less important or remarkable; to disparage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disparagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic tried to <w>elevate</w> and lessen the impact of the new discovery.",
                            "target_lang_translations": {
                                "ru": "Критик пытался <w>принизить</w> и уменьшить влияние нового открытия.",
                                "zh": "评论家试图<w>贬低</w>并削弱这一新发现的影响力。"
                            }
                        },
                        {
                            "text": "They sought to <w>elevate</w> the significance of the event to hide its failure.",
                            "target_lang_translations": {
                                "ru": "Они стремились <w>умалить</w> значимость события, чтобы скрыть его провал.",
                                "zh": "他们试图<w>贬低</w>该事件的重要性，以掩盖其失败。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lessen",
                        "detract",
                        "disparage"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare usage meaning to minimize"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться сделать что-то менее важным; умалять значение.",
                        "zh": "试图使某事显得不那么重要；贬低。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умалять",
                                "target_lang_sense_clarification": "значение или важность"
                            },
                            {
                                "target_lang_word": "принижать",
                                "target_lang_sense_clarification": "заслуги или роль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贬低",
                                "target_lang_sense_clarification": "降低价值"
                            },
                            {
                                "target_lang_word": "轻视",
                                "target_lang_sense_clarification": "不看重"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87840bde-61d7-3a5a-a57a-5280039bc9b4",
                    "sense_definition": "Being in a raised or lofty position; <w>elevated</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cross was three times devoutly <w>elevate</w> during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Во время церемонии крест был трижды благоговейно <w>поднят</w>.",
                                "zh": "仪式期间，十字架被虔诚地<w>举起</w>了三次。"
                            }
                        },
                        {
                            "text": "They sat apart on a hill in thoughts more <w>elevate</w> than the rest.",
                            "target_lang_translations": {
                                "ru": "Они сидели отдельно на холме, погруженные в мысли более <w>возвышенные</w>, чем у остальных.",
                                "zh": "他们独自坐在山丘上，思绪比其他人更为<w>高尚</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used as an adjective in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в поднятом или высоком положении; возвышенный.",
                        "zh": "处于升高的或崇高的位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднятый",
                                "target_lang_sense_clarification": "физически"
                            },
                            {
                                "target_lang_word": "возвышенный",
                                "target_lang_sense_clarification": "высокий, благородный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "高耸的",
                                "target_lang_sense_clarification": "物理位置高"
                            },
                            {
                                "target_lang_word": "崇高的",
                                "target_lang_sense_clarification": "精神境界高"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}