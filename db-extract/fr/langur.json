                        "glosses": [
                            "Espèce de grand singe d'Asie."
                        ],
                        "tags": [
                            "Primatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "9ae77588-2493-46de-8d19-1da2906b24f6",
                                "sense_id": "92a36d83-8904-37b7-b7c2-7e2a37447166",
                                "text": "Jay, je l'ai mentionné, étudiait les langurs dans une autre région de l'Inde. Elle n'a observé aucun infanticide mais sa connaissance des animaux impliqués va la conduire à prendre part au débat théorique."
                            },
                            {
                                "example_id": "0f9a192b-3c6f-4476-afdf-8d07fe01d9f2",
                                "sense_id": "92a36d83-8904-37b7-b7c2-7e2a37447166",
                                "text": "La police vietnamienne vient d'annoncer l'arrestation de six hommes qui sont accusés d’avoir tué puis mangé un langur, un singe appartenant à une espèce en voie de disparition."
                            },
                            {
                                "example_id": "64e25fd3-213d-4f97-80af-7ec567fd2b56",
                                "sense_id": "92a36d83-8904-37b7-b7c2-7e2a37447166",
                                "text": "Longtemps, des hommes ont patrouillé dans les rues de New Delhi accompagnés de langurs dressés, mais cette pratique a pris fin, un tribunal ayant jugé qu’il était cruel de les maintenir en captivité."
                            }
                        ]
                    }
