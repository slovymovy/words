                "senses": [
                    {
                        "sense_id": "7706799c-4d19-3b06-aef7-66d8d9cba4a8",
                        "entry_id": "04f56ed7-83b8-3dd1-9b0b-83b0f96bee8e",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb09db40-ddc0-464e-8b1b-73863f05f8d3",
                                "sense_id": "7706799c-4d19-3b06-aef7-66d8d9cba4a8",
                                "text": "Frau Hildegard ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1eb0750d-49c9-4264-986e-9122e37a0e52",
                                "sense_id": "7706799c-4d19-3b06-aef7-66d8d9cba4a8",
                                "text": "Herr Hildegard wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ff74cb72-3449-4b60-a5ea-786e813a3671",
                                "sense_id": "7706799c-4d19-3b06-aef7-66d8d9cba4a8",
                                "text": "Die Hildegards fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c4a42eeb-3d30-48b4-afff-824cb6f3b4ac",
                                "sense_id": "7706799c-4d19-3b06-aef7-66d8d9cba4a8",
                                "text": "Der Hildegard trägt nie die Schals, die die Hildegard ihm strickt."
                            },
                            {
                                "example_id": "2654a5a7-0e43-4b61-8a0b-e314c692cf3d",
                                "sense_id": "7706799c-4d19-3b06-aef7-66d8d9cba4a8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hildegard kommt, geht der Herr Hildegard.“"
                            },
                            {
                                "example_id": "bae0da52-6bf6-4393-97d7-6e51cb954bb3",
                                "sense_id": "7706799c-4d19-3b06-aef7-66d8d9cba4a8",
                                "text": "Hildegard kommt und geht."
                            },
                            {
                                "example_id": "4c203cc6-d7df-4667-8e26-20cca841464d",
                                "sense_id": "7706799c-4d19-3b06-aef7-66d8d9cba4a8",
                                "text": "Hildegards kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
