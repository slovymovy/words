                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0eb38fbf-56a5-4374-8c99-2d4c2444a5ab",
                                                "sense_id": "8b2b787b-e746-3932-a526-5bb49af8f415",
                                                "text": "La quantité de sucre diminue au cours du temps dans un jus de pomme contenant des levures."
