                        "examples": [
                            {
                                "example_id": "d43b9ed2-fee1-4889-bf37-9c343f47755f",
                                "sense_id": "c217d26b-9324-30f1-aa64-cc0d577c4852",
                                "text": "Пушки у нас давно не чищены стоят, все, чай, насквозь совсем проржавели."
                            }
                        ]
                    }
