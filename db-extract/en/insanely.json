                                "target_senses": [
                                    {
                                        "sense_id": "069be0c6-b3be-34aa-8745-fb283da5bbc4",
                                        "entry_id": "7f342d65-c6d9-319e-a9c4-b743253d5b74",
                                        "glosses": [
                                            "vom Wahnsinn geprägt, an Wahnsinn erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe49763-fed5-4cc5-900a-584334fe7001",
                                                "sense_id": "069be0c6-b3be-34aa-8745-fb283da5bbc4",
                                                "text": "Er führte sich auf wie wahnsinnig."
                                            },
                                            {
                                                "example_id": "62bca190-cda9-4266-8825-122fb2dd41a0",
                                                "sense_id": "069be0c6-b3be-34aa-8745-fb283da5bbc4",
                                                "text": "„Von allem, was ich gesehen und verstanden habe, und aufgrund meiner Unterredungen mit den besten Spezialisten, weiß ich nur, dass Narcisse nicht wahnsinnig ist.“"
                                            },
                                            {
                                                "example_id": "95400efb-9fae-4bfc-b777-7c7c92d713d7",
                                                "sense_id": "069be0c6-b3be-34aa-8745-fb283da5bbc4",
                                                "text": "„Ich müßte wirklich wahnsinnig sein, wenn ich da Glauben verlangen wollte, wo ich selbst das Zeugnis meiner eigenen Sinne verwerfen möchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d94a9f2b-9cfd-3ef8-bd8e-1b6744058350",
                                        "entry_id": "7f342d65-c6d9-319e-a9c4-b743253d5b74",
                                        "glosses": [
                                            "ohne jede Vernunft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4eac126-674e-4996-b6ca-7ddb58cb3e91",
                                                "sense_id": "d94a9f2b-9cfd-3ef8-bd8e-1b6744058350",
                                                "text": "Es war ein wirklich wahnsinniger Plan."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "42c8ddc4-d749-38a3-9322-91a5b2287348",
                                        "entry_id": "7f342d65-c6d9-319e-a9c4-b743253d5b74",
                                        "glosses": [
                                            "in hohem Maße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
