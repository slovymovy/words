                "senses": [
                    {
                        "sense_id": "91840b19-46c5-3dfd-b6e2-aa3977cbdc6e",
                        "entry_id": "8d4fc735-3937-3bd8-9151-d90410f0c176",
                        "glosses": [
                            "A row of trees that acts as a windbreak."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b42339a-9a54-467d-bf47-e18fbf6bdedc",
                                "sense_id": "91840b19-46c5-3dfd-b6e2-aa3977cbdc6e",
                                "text": "“The shelterbelts here,\" explained 53-year-old Ma Shoushou, head of the Bayannur League sand-protection station, “are only part of a great network of shelterbelts planted in 320 counties and banners stretching over 11 provinces and autonomous regions in China’s north, northeast and northwest."
                            },
                            {
                                "example_id": "a8094bb5-3ff8-4f57-be88-781241cc3d4b",
                                "sense_id": "91840b19-46c5-3dfd-b6e2-aa3977cbdc6e",
                                "text": "And then the engines shifted up a note and we began to descend, coming in over a wide plain carved into geometric shapes by lines of dark shelterbelt and long straight roads with their ant hordes of cars and trucks."
                            },
                            {
                                "example_id": "20e5eebf-1741-4e98-9bdc-38b28bddc1b0",
                                "sense_id": "91840b19-46c5-3dfd-b6e2-aa3977cbdc6e",
                                "text": "Now derelict, it is surrounded by a shelterbelt of ancient sycamore trees."
                            }
                        ]
                    }
                ],
