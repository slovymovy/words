                                                "example_id": "94d26c51-ff14-41b6-8142-6e71eb81b53b",
                                                "sense_id": "8cd8eb2c-ddfd-3604-ba8c-751ff3cb677f",
                                                "text": "Near-synonyms: birdlet, birdling, birb, cocky"
                                            },
