                            {
                                "example_id": "8d5204b1-1849-4e26-bb1f-d9592f8a4f84",
                                "sense_id": "5ca64286-e301-3b97-a4d4-75b3b21821e3",
                                "text": "For in the past I have been aware of sensibilia; and I have sensed instances of sensibilia temporally related to one another."
                            },
                            {
                                "example_id": "ca6f327f-b86a-46c0-adc3-972c4b6aa884",
                                "sense_id": "5ca64286-e301-3b97-a4d4-75b3b21821e3",
                                "text": "Russell also brought in the sense-data sensed by other persons and even unsensed sense-data, to which he gave the name of sensibilia."
                            },
                            {
                                "example_id": "65588e3c-8476-4e69-b32c-8421d402c3ac",
                                "sense_id": "5ca64286-e301-3b97-a4d4-75b3b21821e3",
                                "text": "It is because their being as sensibilia does not depend upon their being intentional objects for anyone […]"
                            },
                            {
                                "example_id": "c532af95-cfeb-427c-acb8-785ceb27bfca",
                                "sense_id": "5ca64286-e301-3b97-a4d4-75b3b21821e3",
                                "text": "Among the things which human beings do are (a) think of sensibilia in their absence, (b) make mental or verbal pictures of sensibilia, […]"
                            }
                        ]
                    }
