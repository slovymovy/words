            {
                "entry_id": "8d093603-ebe6-334e-9b69-c9d6ed8ea6f4",
                "word": "estivation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3142ef34-b492-40dd-bf7a-b89fd943812b",
                        "entry_id": "8d093603-ebe6-334e-9b69-c9d6ed8ea6f4",
                        "tags": [
                            "plural"
                        ],
                        "form": "estivations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b9701f4-b081-3762-930b-c654a41a3370",
                        "entry_id": "8d093603-ebe6-334e-9b69-c9d6ed8ea6f4",
                        "glosses": [
                            "Phénomène analogue à celui de l'hibernation, au cours duquel les animaux tombent en léthargie pendant l'été."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea1a4b9-1aee-4ae8-8a3e-dfb7961da2e1",
                                "sense_id": "2b9701f4-b081-3762-930b-c654a41a3370",
                                "text": "L'estivation se produit durant les périodes les plus chaudes de l'été."
                            },
                            {
                                "example_id": "5bc6caaa-32bb-4552-a1af-06ad39035504",
                                "sense_id": "2b9701f4-b081-3762-930b-c654a41a3370",
                                "text": "L'estivation s'observe chez certains serpents, chez des crocodiles et chez des poissons qui s'enfoncent dans la vase."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e81a5fe-4eda-31dd-a5b1-ad14b8556844",
                        "entry_id": "8d093603-ebe6-334e-9b69-c9d6ed8ea6f4",
                        "glosses": [
                            "Synonyme de préfloraison, agencement qu'observent les diverses parties de la fleur avant leur épanouissement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2eb6020-db72-446d-b356-91565c1ad920",
                                "sense_id": "0e81a5fe-4eda-31dd-a5b1-ad14b8556844",
                                "text": "Estivation valvaire, celle où les pièces florales se touchent seulement par leurs bords."
                            },
                            {
                                "example_id": "eada644a-7946-47e9-8b5c-622c8869def3",
                                "sense_id": "0e81a5fe-4eda-31dd-a5b1-ad14b8556844",
                                "text": "Estivation tordue, celle où les pétales se recouvrent les uns les autres et sont tordus en spirale."
                            },
                            {
                                "example_id": "68ed48fc-6383-4766-b347-c5e2f80ba9cc",
                                "sense_id": "0e81a5fe-4eda-31dd-a5b1-ad14b8556844",
                                "text": "Estivation imbricative ou imbriquée, celle quand chaque partie embrasse de ses bords ceux de la partie intérieure."
                            },
                            {
                                "example_id": "7287d324-f437-490d-9e23-d352de656374",
                                "sense_id": "0e81a5fe-4eda-31dd-a5b1-ad14b8556844",
                                "text": "Estivation quinconciale, celle où l'on voit deux parties extérieures, deux intérieures, une intermédiaire."
                            },
                            {
                                "example_id": "3115e728-4197-4dbc-a2da-952bb3dc2801",
                                "sense_id": "0e81a5fe-4eda-31dd-a5b1-ad14b8556844",
                                "text": "Estivation chiffonnée, celle où les pétales sont pliés et ramassés sur eux-mêmes sans aucune régularité."
                            },
                            {
                                "example_id": "65419b64-9d58-40bd-b975-342746c27d2c",
                                "sense_id": "0e81a5fe-4eda-31dd-a5b1-ad14b8556844",
                                "text": "Estivation vexillaire, préfloraison des fleurs papilionacées où l'étendard replié recouvre la moitié des autres organes."
                            },
                            {
                                "example_id": "2f86edf9-9f3a-475d-8c70-2f1d5cb7103f",
                                "sense_id": "0e81a5fe-4eda-31dd-a5b1-ad14b8556844",
                                "text": "Estivation cochléaire, préfloraison des fleurs à deux lèvres, où la supérieure recouvre l'inférieure."
                            }
                        ]
                    }
                ],
