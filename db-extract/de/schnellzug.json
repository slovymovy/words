                "senses": [
                    {
                        "sense_id": "8405e4a0-4482-305e-96a3-6850e4c9a894",
                        "entry_id": "41074efe-81f3-37c6-8881-ba900dc47aa7",
                        "glosses": [
                            "express train"
                        ],
