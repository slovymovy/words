                        "glosses": [
                            "Champignons microscopiques filamenteux parasite de la peau responsable des teignes appartenant aux genres trichophyton, microsporum et epidermophyton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47a25c4f-21b1-4da3-b084-8605f6627918",
                                "sense_id": "d2c3074e-a58e-3199-bdb5-14be92ee5c36",
                                "text": "Dans le bouillon, par contre, où le dermatophyte se développe avec une abondance extrême, le cheveu reste intact."
                            },
                            {
                                "example_id": "b6e5f0f8-09d0-4eeb-be57-7f7d6f4bfbce",
                                "sense_id": "d2c3074e-a58e-3199-bdb5-14be92ee5c36",
                                "text": "Les dermatophytes sont des champignons filamenteux formant un groupe relativement homogène, caractérisés par leur affinité pour la kératine de la peau et des phanères."
                            }
                        ]
                    }
