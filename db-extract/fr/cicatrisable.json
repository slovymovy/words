                "senses": [
                    {
                        "sense_id": "989c99ae-9bc9-3055-b724-ad62b6fd7c45",
                        "entry_id": "861adf27-f0f6-3809-b3ca-f82d2ddb5198",
                        "glosses": [
                            "Qui peut se cicatriser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "726d6d4b-5b80-4d98-9aac-d0e6036e3108",
                                "sense_id": "989c99ae-9bc9-3055-b724-ad62b6fd7c45",
                                "text": "Ne serait-ce pas quelquefois-là un excellent moyen pour consumer le virus vénérien avant qu’il ait encore porté ses ravages dans toute l’économie, et de convertir un chancre récent en une plaie simple et facilement cicatrisable ?"
                            },
                            {
                                "example_id": "a1b16f3c-d31b-4953-9325-3cf708d31965",
                                "sense_id": "989c99ae-9bc9-3055-b724-ad62b6fd7c45",
                                "text": "Le mal peut même guérir par des épanchements de lymphe cicatrisable dans le kyste et dans l’artère, comme nous le verrons."
                            },
                            {
                                "example_id": "19f4a7bf-db4f-4e96-8371-ddee6dace385",
                                "sense_id": "989c99ae-9bc9-3055-b724-ad62b6fd7c45",
                                "text": "Saïgon parle de cela à sa manière, de la façon dont la séparation avec un être aimé, un pays natal ouvre un gouffre à jamais non comblé, à jamais profond, une blessure non cicatrisable."
                            }
                        ]
                    }
                ],
