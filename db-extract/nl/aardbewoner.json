                        "tags": [],
                        "examples": [
                            {
                                "example_id": "368f4b38-be4b-445c-aa95-1036f0cf8e92",
                                "sense_id": "92ab7ef9-5f7e-3362-9fe0-ed0c4dad5bda",
                                "text": "' 'Het lijkt allemaal zo onnodig! Als ze het maar aan haar man had verteld! Als Janine maar had geprobeerd werk te vinden om van te leven en zich niet had ingelaten met chantage! Als Lavinia zich maar niet het hoofd op hol had laten brengen door die kerel!' 'Als de wereld maar anders was en alle aardbewoners volmaakt, zou het leven eenvoudiger zijn, nietwaar?' Hij bekeek me met een meewarig lachje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da24460c-9012-4521-be6c-f27380fc8c21",
                        "source_entry_id": "6910abaa-0daf-3574-b8ad-f5173e278bcd",
                        "source_sense_id": "92ab7ef9-5f7e-3362-9fe0-ed0c4dad5bda",
                        "source_sense_description": "bewoner van de planeet aarde",
                        "target_lang_word": "Erdbewohner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erdbewohner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                                        "entry_id": "ef2b0b4e-391a-3a93-97fa-199edb955f4e",
                                        "glosses": [
                                            "Bewohner des Planeten Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "181d34ea-ddc8-4e1d-a142-a7ee9344e0c2",
                                                "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                                                "text": "Die Anzahl der jemals gelebten Erdbewohner beläuft sich schätzungsweise auf rund 110 Milliarden."
                                            },
                                            {
                                                "example_id": "b2d212a5-beb3-4688-9c48-cc26df84874e",
                                                "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                                                "text": "„Der erste Zacken fiel den Erdbewohnern, die sich als Mittelpunkt der Schöpfung wähnten, durch Kopernikus und Galilei aus der Krone.“"
                                            },
                                            {
                                                "example_id": "b2407536-604f-4625-8019-dbeff507db6b",
                                                "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                                                "text": "„Die Erdbewohner verderben ihr eigenes Können; sie haben etwas zustande gebracht, was keiner auf meinem Stern jemals vermöchte.“"
                                            },
                                            {
                                                "example_id": "736989ff-5988-4777-b313-0c52c25bc99f",
                                                "sense_id": "0be4e82f-2112-36bd-bed7-6b41527ab7f3",
                                                "text": "„Die sonstigen Erdbewohner üben ihr Gewerbe im Herumziehen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
