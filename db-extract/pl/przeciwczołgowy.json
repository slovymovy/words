                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protitankový",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "5cf7fd20-fd58-3531-aa34-2f54e0ee52fe",
                                        "entry_id": "80baddf0-c9e0-3f98-a018-56b0efda2152",
