                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b60d020-e2c6-4ec8-989c-b1f62b88edc2",
                                                "sense_id": "692b471e-3671-342b-ac84-d739c0f8aad1",
