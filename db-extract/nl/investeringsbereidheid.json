                            {
                                "example_id": "9a47d940-022e-4b13-92b6-2b2e496c9fef",
                                "sense_id": "b9f5c590-7782-3191-808c-bf6efb423afc",
                                "text": "De wet leidt ook tot minder investeringsbereidheid bij grote energiebedrijven. Van die bedrijven worden grote investeringen gevraagd in warmtenetten terwijl de zeggenschap bij de overheid komt te liggen."
                            },
                            {
                                "example_id": "8f4be7a4-ffbb-4e20-a73d-4c2a6e6bf1dc",
                                "sense_id": "b9f5c590-7782-3191-808c-bf6efb423afc",
                                "text": "De Jonge: \"De investeringsbereidheid houden we zo overeind. Het meest zijn marktpartijen gebaat bij duidelijkheid op korte termijn, daarom zullen we het wetsvoorstel op basis van de aandachtspunten van de Raad van State afronden en in het begin van het jaar aan de Kamer sturen.\""
                            }
