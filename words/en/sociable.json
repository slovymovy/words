                    "sense_definition": "Capable of being joined or combined into one group or body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee was made up of several <w>sociable</w> groups united for a common goal.",
                            "target_lang_translations": {
                                "ru": "Комитет состоял из нескольких <w>объединенных</w> групп, сплоченных общей целью."
