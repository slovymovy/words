{
    "word_family": [
        "keutelen",
        "keutelachtig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f401d81-30cd-37f7-9b54-caa06c583f7e",
                    "sense_definition": "Een klein, hard, rond stukje ontlasting, voornamelijk van dieren zoals konijnen of schapen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontlasting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het gras lagen overal kleine <w>keutels</w> van de konijnen die er gisteravond hadden gespeeld.",
                            "target_lang_translations": {
                                "en": "In the grass lay small rabbit <w>droppings</w> everywhere from the rabbits that had played there last night."
                            }
                        },
                        {
                            "text": "De dierenarts bekeek een harde <w>keutel</w> om te controleren of de cavia wel gezond was.",
                            "target_lang_translations": {
                                "en": "The vet examined a hard <w>pellet</w> to check if the guinea pig was healthy."
                            }
                        }
                    ],
                    "synonyms": [
                        "drolletje"
                    ],
                    "common_phrases": [
                        "harde keutel",
                        "konijnen keutel"
                    ],
                    "target_lang_definitions": {
                        "en": "A small, hard, round piece of feces, primarily from animals such as rabbits or sheep."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "droppings",
                                "target_lang_sense_clarification": "small animal feces"
                            },
                            {
                                "target_lang_word": "pellet",
                                "target_lang_sense_clarification": "small, hard round piece of animal dung"
                            },
                            {
                                "target_lang_word": "turd",
                                "target_lang_sense_clarification": "small piece of excrement, informal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9693d27c-f457-3dcd-aac6-b840a1d5d6a2",
                    "sense_definition": "Een onbeduidend, klein of onbelangrijk persoon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laat je niet commanderen door die kleine <w>keutel</w> die denkt dat hij de baas is.",
                            "target_lang_translations": {
                                "en": "Don't let yourself be bossed around by that little <w>pipsqueak</w> who thinks he's the boss."
                            }
                        },
                        {
                            "text": "Hij gedraagt zich heel belangrijk, maar eigenlijk is het maar een <w>keutel</w> in de organisatie.",
                            "target_lang_translations": {
                                "en": "He acts very important, but actually he is just a <w>nobody</w> in the organization."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeduidendheid",
                        "nul"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to disparage someone's importance."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An insignificant, small, or unimportant person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nobody",
                                "target_lang_sense_clarification": "an insignificant person"
                            },
                            {
                                "target_lang_word": "pipsqueak",
                                "target_lang_sense_clarification": "a small or insignificant person, informal"
                            },
                            {
                                "target_lang_word": "nonentity",
                                "target_lang_sense_clarification": "a person of no importance"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "474a2491-6f40-3e55-9069-cea98d0bf0f9",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>keutelen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>keutel</w> vandaag lekker de hele middag in de tuin zonder haast te hebben.",
                            "target_lang_translations": {
                                "en": "Today I am happily <w>pottering about</w> in the garden all afternoon without being in a hurry."
                            }
                        },
                        {
                            "text": "Als ik zo rustig <w>keutel</w>, vergeet ik al mijn dagelijkse zorgen.",
                            "target_lang_translations": {
                                "en": "When I <w>dawdle</w> along so peacefully, I forget all my daily worries."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'keutelen' (to potter about, dawdle, or mess around)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "potter about",
                                "target_lang_sense_clarification": "doing small tasks in a relaxed way"
                            },
                            {
                                "target_lang_word": "dawdle",
                                "target_lang_sense_clarification": "moving or acting slowly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5b5fb1e-e9f7-3d4b-9b69-f428cf8fd75b",
                    "sense_definition": "De gebiedende wijs van <w>keutelen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Keutel</w> toch niet zo langzaam door, we moeten echt op tijd vertrekken!",
                            "target_lang_translations": {
                                "en": "Don't <w>dawdle</w> so slowly, we really need to leave on time!"
                            }
                        },
                        {
                            "text": "Kom op, <w>keutel</w> niet zo en maak nu eindelijk eens een duidelijke keuze.",
                            "target_lang_translations": {
                                "en": "Come on, don't <w>mess around</w> so much and finally make a clear choice."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'keutelen' (to potter about, dawdle, or mess around)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "potter about",
                                "target_lang_sense_clarification": "imperative form"
                            },
                            {
                                "target_lang_word": "dawdle",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d35bca21-b96c-3257-9148-4e72bf841f73",
                    "sense_definition": "De tweede persoon enkelvoud tegenwoordige tijd van <w>keutelen</w> bij inversie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>keutel</w> je zo lang aan die simpele taak in plaats van hem af te maken?",
                            "target_lang_translations": {
                                "en": "Why do you <w>dawdle</w> so long on that simple task instead of finishing it?"
                            }
                        },
                        {
                            "text": "Als je zo rustig <w>keutel</w> je de hele dag door zonder echt iets te bereiken.",
                            "target_lang_translations": {
                                "en": "If you <w>potter about</w> so quietly, you go through the whole day without really achieving anything."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Second-person singular present tense of 'keutelen' with inversion (to potter about, dawdle, or mess around)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "potter about",
                                "target_lang_sense_clarification": "second-person singular form"
                            },
                            {
                                "target_lang_word": "dawdle",
                                "target_lang_sense_clarification": "second-person singular form"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}