                        "glosses": [
                            "Rendre graduel."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ffaf2df3-b6c7-45e7-bb26-3d99e2f81b09",
                                "sense_id": "5791e286-b354-3af5-becb-6fd7b6013bdc",
                                "text": "La tendance « putschiste », très nette dans le parti fasciste, se manifeste par les oppositions à Mussolini lorsqu'il tente de « gradualiser » la prise du pouvoir."
                            },
                            {
                                "example_id": "ba3754af-97eb-4534-8ff4-7cb85750a47d",
                                "sense_id": "5791e286-b354-3af5-becb-6fd7b6013bdc",
                                "text": "Un argument primaire peut très bien gradualiser la réponse : reconnaître que le fait-type est effectivement attribuable au défendeur, mais, par exemple, qu'il doit l'être aussi en partie à la victime […]."
                            }
                        ]
                    }
