                "senses": [
                    {
                        "sense_id": "501e6024-1e7b-3bc8-8819-2c8e408b3406",
                        "entry_id": "7786ab70-be80-3f3d-8cd5-fedb26750804",
                        "glosses": [
                            "composed of water and earth; terraqueous"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "dbeb4264-4c38-40c0-a57a-6cb9f46a9d8a",
                                "sense_id": "501e6024-1e7b-3bc8-8819-2c8e408b3406",
                                "text": "C’est la fin du monde. C’est évidemment la fin de ce misérable globe terraqué. Il fallait un hoquet final, la France le pousse.",
                                "translation": "It's the end of the world. It's evidently the end of this miserable terraqueous globe. It needed a final hiccough, France is urging it on.",
                                "english": "It's the end of the world. It's evidently the end of this miserable terraqueous globe. It needed a final hiccough, France is urging it on."
                            },
                            {
                                "example_id": "7732ca99-77ba-43e4-b9fe-0c73b1acffbd",
                                "sense_id": "501e6024-1e7b-3bc8-8819-2c8e408b3406",
                                "text": "Ébranle-toi, bloc terraqué,\nNouvelle voie on t'ouvre, à force :\nLa moisissure ôtée à ton écorce,\nDe verts printemps tu pourras évoquer !",
                                "translation": "Shake yourself, terraqueous bloc,\nA new way is opened to you, through force:\nWith the rot stripped from your bark,\nSome green springs you will be able to evoke!",
                                "english": "Shake yourself, terraqueous bloc,\nA new way is opened to you, through force:\nWith the rot stripped from your bark,\nSome green springs you will be able to evoke!"
                            }
                        ]
                    }
                ],
