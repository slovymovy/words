                        "examples": [
                            {
                                "example_id": "70b5a16e-96ce-45cd-be7e-c4fe4692a3a4",
                                "sense_id": "9bfd3725-a627-3a6c-9670-da9f948f978f",
                                "text": "John Furlong, de hoogste baas van het organisatiecomité VANOC, bedankte de duizenden vrijwillgers voor hun grote inzet. Hij benadrukte dat de Spelen een positieve invloed op Canada hadden en roemde de Canadese gouden medaillewinnaars."
                            },
                            {
                                "example_id": "b6092b25-f136-4f12-9ca6-e3062e4041ec",
                                "sense_id": "9bfd3725-a627-3a6c-9670-da9f948f978f",
                                "text": "Tot nu toe zei het toenmalig WK-organisatiecomité, onder leiding van de Franz “der Kaiser” Beckenbauer, dat het bedrag bedoeld was om een groter bedrag van 170 miljoen veilig te stellen. Daarover werd al langer getwijfeld, maar nu is duidelijk dat het bedrag dus is terechtgekomen in Qatar."
                            }
