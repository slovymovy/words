                                "example_id": "368eb0d4-e1ee-495e-88ff-809e93ab0c52",
                                "sense_id": "99a9b36c-68f5-3260-87a0-eed543ec639a",
                                "text": "Met een buitentemperatuur van 40 graden Celsius voelt het alsof de stad in brand staat."
                            },
                            {
                                "example_id": "e59bdca2-f89c-458b-8024-69c60c65ba8c",
                                "sense_id": "99a9b36c-68f5-3260-87a0-eed543ec639a",
                                "text": "Hondencoach Arvid van Putten werd bij een buitentemperatuur van 26 graden en met een trui aan in stilstaande auto in de zon gezet. Onder begeleiding van een ehbo'er bleef hij net zo lang zitten tot zijn gezondheid in gevaar zou komen."
                            }
                        ]
                    }
