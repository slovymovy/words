                                        "entry_id": "00162635-250d-34c5-95ff-b83effe0ef68",
                                        "glosses": [
                                            "Person, die (unrechtmäßig) in einem leer stehenden Haus wohnt und dies besetzt hält, ohne deren Eigentümer zu sein oder Miete zu bezahlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd16da61-3080-4af9-89df-b0d120ef5cb7",
                                                "sense_id": "062bf4d3-7217-300b-b085-8133d35a509e",
