                    {
                        "sense_id": "912d73ef-7229-301e-86fb-9dc027bcae94",
                        "entry_id": "6d490da6-b2b2-38f1-a2c0-5c81030c66fd",
                        "glosses": [
                            "Anhänger der zur Fernsehserie „My Little Pony – Freundschaft ist Magie“ gehörigen Subkultur, vorwiegend, wenn über jugendliche bis erwachsene Männer außerhalb der offiziell vorgesehenen Zielgruppe gesprochen wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "61ca1c61-bace-4b1e-9b90-0b67b9001649",
                                "sense_id": "912d73ef-7229-301e-86fb-9dc027bcae94",
                                "text": "Männliche Fans von „My Little Pony“ bezeichnen sich selbst häufig als Bronies."
                            },
                            {
                                "example_id": "3f05cf50-4c1a-4bf2-97ca-5b98652a331a",
                                "sense_id": "912d73ef-7229-301e-86fb-9dc027bcae94",
                                "text": "„Die Brony-Welt ist aber nicht nur virtuell: Fast jede Woche findet irgendwo in Deutschland ein Treffen statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
