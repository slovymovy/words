                "senses": [
                    {
                        "sense_id": "8fc872b0-08d2-3de0-9fb0-65ccf1694129",
                        "entry_id": "8f1c663f-bbe2-39c0-b818-e76519ffe128",
                        "glosses": [
                            "действие по значению гл. проводить; провожать; обряд (обряды) прощания с кем-либо, чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f6fc8e4-ec72-4385-8434-a70b35b9b95d",
                                "sense_id": "8fc872b0-08d2-3de0-9fb0-65ccf1694129",
                                "text": "Проводы сына в армию."
                            },
                            {
                                "example_id": "bec3a578-ef8c-41b3-b241-505cca9cddbb",
                                "sense_id": "8fc872b0-08d2-3de0-9fb0-65ccf1694129",
                                "text": "Проводы мужа в командировку."
                            },
                            {
                                "example_id": "7d1c37c1-8b8e-4b50-921c-62a9ee8a2dd8",
                                "sense_id": "8fc872b0-08d2-3de0-9fb0-65ccf1694129",
                                "text": "Проводы гостей."
                            },
                            {
                                "example_id": "5153ea93-c5b2-4a71-b338-eff0567a8c92",
                                "sense_id": "8fc872b0-08d2-3de0-9fb0-65ccf1694129",
                                "text": "Проводы детства."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5dd1018-2995-3e4f-9098-ce35ae5aa567",
                        "entry_id": "8f1c663f-bbe2-39c0-b818-e76519ffe128",
                        "glosses": [
                            "разг. гулянье, обычно с угощением, устраиваемое при прощании с кем-либо, чем-либо или связанные с окончанием каких-нибудь праздников"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7b76c9f-5f24-430a-80d6-b39bb93ddca2",
                                "sense_id": "a5dd1018-2995-3e4f-9098-ce35ae5aa567",
                                "text": "Устроить торжественные проводы на пенсию."
                            },
                            {
                                "example_id": "a9009d30-4b8a-40b7-8519-db29f8dce02c",
                                "sense_id": "a5dd1018-2995-3e4f-9098-ce35ae5aa567",
                                "text": "Проводы масленицы."
                            }
                        ]
                    }
                ],
