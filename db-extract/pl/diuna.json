                        "glosses": [
                            "ruchoma wydma na wybrzeżu morskim powstała przez nawiewanie piasku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "836373a4-40a0-459d-9fe6-97b23d005d8d",
                                "sense_id": "eb25b207-d290-358a-98bb-112414038e2d",
