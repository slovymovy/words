{
    "word_family": [
        "grand",
        "grandir",
        "grandeur",
        "agrandissement",
        "agrandisseur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b8e5737-769a-3bef-978b-717d8c5b7c4e",
                    "sense_definition": "Rendre plus grand en dimensions, en surface ou en volume.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dimensions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous voulons <w>agrandir</w> le salon pour accueillir plus d'invités pendant les fêtes."
                        },
                        {
                            "text": "Il a fait <w>agrandir</w> cette photo de famille pour l'accrocher au mur."
                        }
                    ],
                    "synonyms": [
                        "élargir",
                        "étendre",
                        "augmenter"
                    ],
                    "antonyms": [
                        "rétrécir",
                        "réduire",
                        "diminuer"
                    ],
                    "common_phrases": [
                        "agrandir la maison",
                        "agrandir une photo",
                        "agrandir la pièce"
                    ]
                },
                {
                    "sense_id": "2f715f0f-de2d-3470-b4b4-1564cb9c19ac",
                    "sense_definition": "Donner l'illusion ou l'impression d'une dimension plus importante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand miroir placé au fond du couloir <w>agrandit</w> visiblement l'espace."
                        },
                        {
                            "text": "Le maquillage sombre autour de ses yeux <w>agrandit</w> son regard d'une façon très élégante."
                        }
                    ],
                    "antonyms": [
                        "rapetisser"
                    ],
                    "common_phrases": [
                        "agrandir l'espace",
                        "agrandir le regard"
                    ]
                },
                {
                    "sense_id": "50c98a71-86b1-3633-bf70-da5245d3032f",
                    "sense_definition": "Développer ou accroître la puissance, l'influence ou les mérites d'une personne ou d'une institution.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "statut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouveau dirigeant cherche à <w>agrandir</w> son influence politique dans toute la région."
                        },
                        {
                            "text": "Par ces réformes remarquables, la ministre a su <w>agrandir</w> le prestige de son institution."
                        }
                    ],
                    "synonyms": [
                        "accroître",
                        "élever"
                    ],
                    "antonyms": [
                        "affaiblir",
                        "rabaisser"
                    ],
                    "common_phrases": [
                        "agrandir son influence",
                        "agrandir son empire"
                    ]
                },
                {
                    "sense_id": "14943389-41f1-3d5f-afdb-10ed19f2333b",
                    "sense_definition": "Présenter des faits sous un jour excessif en leur donnant une importance exagérée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand il raconte ses voyages, il ne peut s'empêcher d'<w>agrandir</w> les faits."
                        },
                        {
                            "text": "Ne l'écoute pas trop, car il <w>agrandit</w> volontiers chaque incident du quotidien."
                        }
                    ],
                    "synonyms": [
                        "exagérer",
                        "amplifier"
                    ],
                    "antonyms": [
                        "minimiser"
                    ],
                    "common_phrases": [
                        "agrandir les faits",
                        "agrandir le récit"
                    ]
                }
            ]
        }
    ]
}