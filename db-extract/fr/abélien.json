                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d102855d-ab97-4c33-9660-8c4d86055a0e",
                        "entry_id": "c61ecb02-5b58-3cf7-9c44-4e4808578575",
                        "tags": [
