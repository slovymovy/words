                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc4d597d-105a-4507-8eec-087e3347b5a3",
                                                "sense_id": "21ae96ae-6f31-3d7b-9046-2dd5eeddd4ff",
                                                "text": "When I asked them if they had been at the party, they fudged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01d78159-765b-3772-a237-85785427b202",
                                        "entry_id": "e180f2b7-fdcd-388c-bb7c-21bf177e8d76",
                                        "glosses": [
                                            "To alter something from its true state, as to hide a flaw or uncertainty, deliberately but not necessarily dishonestly or immorally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff00dd7-c58e-48c2-a977-42dc4ede456c",
                                                "sense_id": "01d78159-765b-3772-a237-85785427b202",
                                                "text": "The results of the experiment looked impressive, but it turned out the numbers had been fudged."
                                            },
                                            {
                                                "example_id": "434f16ca-68c6-4908-b4e0-5af4e2f4a87a",
                                                "sense_id": "01d78159-765b-3772-a237-85785427b202",
                                                "text": "I had to fudge the lighting to get the color to look good."
                                            },
                                            {
                                                "example_id": "7769f7bc-4d0c-47ff-840c-c3a4b7badac6",
                                                "sense_id": "01d78159-765b-3772-a237-85785427b202",
                                                "text": "Do you fudge your age?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e142700-e252-34c3-b9b8-cafb52ad624a",
                                        "entry_id": "e180f2b7-fdcd-388c-bb7c-21bf177e8d76",
                                        "glosses": [
                                            "To botch or bungle something."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "dated"
                                        ],
