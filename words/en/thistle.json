{
    "word_family": [
        "thistly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93d6dc43-b137-3d3a-9004-4ba4d91ab850",
                    "sense_definition": "A type of prickly plant with showy flower heads.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The field was overgrown with sharp <w>thistles</w> that made walking difficult.",
                            "target_lang_translations": {
                                "ru": "Поле заросло острым <w>чертополохом</w>, из-за чего идти было трудно."
                            }
                        },
                        {
                            "text": "Be careful when picking flowers because that <w>thistle</w> has very sharp thorns.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, когда собираешь цветы, потому что у этого <w>чертополоха</w> очень острые шипы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Колючее растение с яркими соцветиями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертополо́х",
                                "target_lang_sense_clarification": "общее название колючих сорных растений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5add3f6b-bbcd-367c-90fc-0069293daf4c",
                    "sense_definition": "The national floral emblem of Scotland.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>thistle</w> is widely recognized as the national symbol of Scotland.",
                            "target_lang_translations": {
                                "ru": "<w>Чертополох</w> широко известен как национальный символ Шотландии."
                            }
                        },
                        {
                            "text": "Many traditional Scottish designs feature the <w>thistle</w> as a decorative element.",
                            "target_lang_translations": {
                                "ru": "Многие традиционные шотландские узоры используют <w>чертополох</w> в качестве декоративного элемента."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Национальный цветочный символ Шотландии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертополо́х",
                                "target_lang_sense_clarification": "как национальный символ Шотландии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bae581c4-9459-328e-b7be-68b706a1b398",
                    "sense_definition": "An image of the plant used as a heraldic charge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "symbol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient coat of arms displayed a golden <w>thistle</w> on a blue background.",
                            "target_lang_translations": {
                                "ru": "На древнем гербе был изображен золотой <w>чертополох</w> на синем фоне."
                            }
                        },
                        {
                            "text": "You can see a carved <w>thistle</w> above the entrance to the historic castle.",
                            "target_lang_translations": {
                                "ru": "Над входом в исторический замок можно увидеть резной <w>чертополох</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение растения, используемое в геральдике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чертополо́х",
                                "target_lang_sense_clarification": "геральдический символ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9638631-ecb3-3f81-a37c-5fc7a9c3dd9b",
                    "sense_definition": "The Order of the Thistle, a high-ranking Scottish order of chivalry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was honored with an appointment to the Order of the <w>Thistle</w>.",
                            "target_lang_translations": {
                                "ru": "Он был удостоен чести стать членом Ордена <w>Чертополоха</w>."
                            }
                        },
                        {
                            "text": "Membership in the <w>Thistle</w> is a prestigious recognition of public service.",
                            "target_lang_translations": {
                                "ru": "Членство в Ордене <w>Чертополоха</w> — это престижное признание заслуг перед обществом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Орден Чертополоха, высший рыцарский орден Шотландии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Орден Чертополоха",
                                "target_lang_sense_clarification": "рыцарский орден"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "78d160af-eaae-3610-81f8-03a63c5d8da1",
                    "sense_definition": "A family name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historian Mr. <w>Thistle</w> wrote a book about local genealogy.",
                            "target_lang_translations": {
                                "ru": "Историк мистер <w>Тисл</w> написал книгу о местной генеалогии."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Thistle</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции я встретил женщину по имени Сара <w>Тисл</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тисл",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}