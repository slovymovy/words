                ],
                "senses": [
                    {
                        "sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                        "entry_id": "7b8ea8b4-315b-35fd-967a-90a7a62c731b",
                        "glosses": [
                            "Celui qui est de la même équipe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5460cc0-9c2b-4b49-b369-fe7ebd141d68",
                                "sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                                "text": "On remet à chaque coéquipier une partie seulement de l’information ou du matériel nécessaire pour effectuer une tâche."
                            },
                            {
                                "example_id": "c0fd9633-b5cc-488d-bdf4-cf8ba6eb695b",
                                "sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                                "text": "C’est ce que m’ont conseillé Erwan Tabarly et Julien Pulvé, mes coéquipiers de la saison, explique-t-elle dans un communiqué."
                            },
                            {
                                "example_id": "a238a382-e45b-4996-b532-9987e4605d95",
                                "sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                                "text": "Il compte trois sélections en équipe de Belgique, où il a notamment côtoyé son nouveau coéquipier Jérémy Doku."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1793c27-6f7e-4da4-9a0d-25ab9209fb4a",
                        "source_entry_id": "7b8ea8b4-315b-35fd-967a-90a7a62c731b",
                        "source_sense_id": "0582e2df-06b6-3cf7-a47a-d39f5555c21f",
                        "target_lang_word": "Teamkollege",
