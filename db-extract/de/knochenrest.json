                "senses": [
                    {
                        "sense_id": "f31b8c2f-a528-3422-8777-f56f37099bbf",
                        "entry_id": "bfa34a33-0805-3c26-b94e-e517b133c679",
                        "glosses": [
                            "Überbleibsel eines Knochen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e05db54-7220-4741-b425-3f2f33c8594d",
                                "sense_id": "f31b8c2f-a528-3422-8777-f56f37099bbf",
                                "text": "„Mit großen Schritten gingen sie zu der mächtigen weißen Erhebung hinüber, wobei ihre Füße manchmal auf einem Schädel ausrutschten oder die Knochenreste unter ihren Füßen knirschten.“"
                            },
                            {
                                "example_id": "65d22942-09d3-44bf-afa2-be6feaaf9795",
                                "sense_id": "f31b8c2f-a528-3422-8777-f56f37099bbf",
                                "text": "„Sorgfältig suchte er das Tablett nach Knochenresten ab, damit er nichts übersah, und fegte die Asche mit einem Besen zusammen.“"
                            },
                            {
                                "example_id": "82588cb3-12fd-4e57-9c89-69919fb05f3a",
                                "sense_id": "f31b8c2f-a528-3422-8777-f56f37099bbf",
                                "text": "„Und das alles, weil ich mich nicht dazu bringen kann, meine jungfräuliche intelligente Seele mit den gelbsüchtigen Knochenresten eines grusligen verfaulten Losers zu vermischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
