                    },
                    {
                        "translation_id": "09b33c74-0e3a-41af-8d4c-828c7cc35a6e",
                        "source_entry_id": "78505353-389f-3d78-9c3d-49dfe73fe29d",
                        "source_sense_description": "clock",
                        "target_lang_word": "sablier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sablier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a598c8c-3f03-3808-b465-873342988093",
                                        "entry_id": "f302b1f3-71d0-3c71-be13-87cc1d876a6f",
                                        "glosses": [
                                            "Petit instrument composé de deux récipients de verre ajustés de manière que le sable fin qui est dans l’une s’écoule peu à peu dans l’autre par une petite ouverture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6042715-11b7-44e7-b459-75e36ed7ca5f",
                                                "sense_id": "6a598c8c-3f03-3808-b465-873342988093",
                                                "text": "On compte les minutes qui nous restent à vivre, et l’on secoue notre sablier pour le hâter."
                                            },
                                            {
                                                "example_id": "98e6d3a0-3e4b-4814-afa8-807243c82f04",
                                                "sense_id": "6a598c8c-3f03-3808-b465-873342988093",
                                                "text": "Il lui semblait que jamais Apollon ne dût remonter sur son char, et qu’une main invisible retînt en l’air la poudre du sablier."
                                            },
                                            {
                                                "example_id": "f096979c-30f2-4854-90ba-e81b8e1a893d",
                                                "sense_id": "6a598c8c-3f03-3808-b465-873342988093",
                                                "text": "On se sert encore d’un sablier pour évaluer le temps nécessaire à la cuisson d’un œuf à la coque."
                                            },
                                            {
                                                "example_id": "8bc5df9e-1130-4eba-82d5-bc5e41467d0d",
                                                "sense_id": "6a598c8c-3f03-3808-b465-873342988093",
                                                "text": "Retourner un sablier."
                                            },
                                            {
                                                "example_id": "ad00693d-6efe-4b83-8b18-9c74f7b9549b",
                                                "sense_id": "6a598c8c-3f03-3808-b465-873342988093",
                                                "text": "On représente le Temps un sablier à la main."
                                            },
                                            {
                                                "example_id": "b1a3f3b9-fd98-4c17-b021-ffd432dcb897",
                                                "sense_id": "6a598c8c-3f03-3808-b465-873342988093",
                                                "text": "« J’accorde trois minutes de réflexion : Pendant cette attente, le sablier tremblera dans la main du Temps effrayé. »"
                                            },
                                            {
                                                "example_id": "bd10c691-5a64-4082-a1fb-018cb6b38691",
                                                "sense_id": "6a598c8c-3f03-3808-b465-873342988093",
                                                "text": "C'était l'heure d'affluence. Les trains qui viennent de la banlieue déversent leurs voyageurs, tandis que la foule de ceux qui ont passé leur journée de travail à Paris se presse sur les quais de départ et ce mouvement de sablier dure jusqu'à huit heures du soir."
                                            },
                                            {
                                                "example_id": "225e8930-cde8-4bb0-9925-b41ee0dc89fc",
                                                "sense_id": "6a598c8c-3f03-3808-b465-873342988093",
                                                "text": "Les heures s’écoulaient comme au travers d’un sablier empli de grès (le lecteur déplorera sans doute la platitude de cette image : qu’il en apprécie, pourtant, la pertinence géologique)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86766e66-5c91-3a73-8360-abeec9023c6a",
                                        "entry_id": "f302b1f3-71d0-3c71-be13-87cc1d876a6f",
                                        "glosses": [
                                            "Temps durant lequel s’écoule le sable dans ce dernier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "605eec60-68a2-45b7-8f48-d8f8849f3fd6",
                                                "sense_id": "86766e66-5c91-3a73-8360-abeec9023c6a",
                                                "text": "Ton rôle n’est pas difficile ... Chaque fois que ce sablier sera vide, il faudra le retourner. Ce rôle n'est pas sans avantage... Tous les soixante douze sabliers, tu pourras te reposer pendant un sablier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "119846c1-ef33-38c9-876c-46ae6fa390eb",
                                        "entry_id": "f302b1f3-71d0-3c71-be13-87cc1d876a6f",
                                        "glosses": [
                                            "Petit récipient contenant du sable fin destiné à être répandu sur l’écriture pour la sécher."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65b38205-08c3-4eea-98d2-65d58e4ab49e",
                                                "sense_id": "119846c1-ef33-38c9-876c-46ae6fa390eb",
                                                "text": "Un sablier de cuivre, de fer-blanc, de bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c07dfd45-ebc1-3c26-a641-68a9a6dbfabf",
                                        "entry_id": "f302b1f3-71d0-3c71-be13-87cc1d876a6f",
                                        "glosses": [
                                            "Petit arbre d’Amérique, dont le fruit, qui est une capsule dure et très sèche, peut s’employer en guise de récipient pour mettre du sable pour sécher l’écriture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8158b73-31dc-41d3-bbc1-073a391105f3",
                                                "sense_id": "c07dfd45-ebc1-3c26-a641-68a9a6dbfabf",
                                                "text": "Les sabliers sont des arbres de l’Amérique tropicale, à suc laiteux, à feuilles alternes, pétiolées, portant deux glandes à l’extrémité de leur petiole. L’espèce la plus connue est le sablier élastique , hura crepitans, Linn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db2a9d0e-b668-3b1a-a37b-2e1fe1adf010",
                                        "entry_id": "f302b1f3-71d0-3c71-be13-87cc1d876a6f",
                                        "glosses": [
                                            "Icône représentant un sablier sur le curseur et indiquant qu’une tâche est en attente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f94c7763-014c-469e-9089-fd3dc1a6d0bd",
                                                "sense_id": "db2a9d0e-b668-3b1a-a37b-2e1fe1adf010",
                                                "text": "Le curseur de sa souris se transforma en sablier, et la petite icône pivota sur elle-même plusieurs fois."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "291495d6-fa55-4c3a-986d-92b5c05e32df",
                        "source_entry_id": "78505353-389f-3d78-9c3d-49dfe73fe29d",
