                    {
                        "translation_id": "a5682544-b02c-4726-a67b-6cba57d5566c",
                        "source_entry_id": "7b103a19-39e2-302a-af06-be9b45ddfc6a",
                        "source_sense_id": "1fddc341-052c-3925-8852-8647ec34a493",
                        "source_sense_description": "griechische Mythologie: Jüngling von großer Schönheit und Geliebter der Aphrodite",
