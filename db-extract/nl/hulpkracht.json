                            {
                                "example_id": "232f50e4-31dc-4e05-bcaf-ed710d99ec8f",
                                "sense_id": "823b463f-6bca-3ea7-b375-1abf58246f61",
                                "text": "Wel kregen twee mensen zuurstof toegediend: een bewoonster en een hulpkracht. Zij hoefden niet mee in de ambulance."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d4a5cbc-edd9-323d-bcec-dd1e64c259ea",
                        "entry_id": "b321fe02-50ec-3b25-9d14-dbbca2b7e6ed",
                        "glosses": [
                            "iemand die tijdelijk helpt bij het vervullen van een taak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a01f9864-c9f4-4769-a089-795cd45a7772",
                                "sense_id": "1d4a5cbc-edd9-323d-bcec-dd1e64c259ea",
                                "text": "Het bedrijf werft momenteel personeel voor het Eibergse filiaal, onder meer een verkoopmedewerker, hulpkracht en vulploegmedewerker."
                            }
                        ]
                    }
                ],
