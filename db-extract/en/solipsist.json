            },
            {
                "entry_id": "f61b0e26-e9ae-3a31-b935-9399e95074c8",
                "word": "solipsist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2107c43c-ccf9-4444-8953-d88979b7c574",
                        "entry_id": "f61b0e26-e9ae-3a31-b935-9399e95074c8",
                        "tags": [
                            "plural"
                        ],
                        "form": "solipsists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2ae3379-889e-3113-a9af-fafa9993979d",
                        "entry_id": "f61b0e26-e9ae-3a31-b935-9399e95074c8",
                        "glosses": [
                            "One who adheres to self-absorption and an ignorance of the views or needs of others."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6f6ffd6-85c1-4287-8fd1-b270651eb81b",
                                "sense_id": "d2ae3379-889e-3113-a9af-fafa9993979d",
                                "text": "Some of this grandiosity is to be expected. Innovators tend to be solipsists. They often want to cram every stray fact and experience into their new model."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3088dc8c-759b-4c31-b8ca-24743f8fe969",
                        "source_entry_id": "f61b0e26-e9ae-3a31-b935-9399e95074c8",
                        "source_sense_id": "d2ae3379-889e-3113-a9af-fafa9993979d",
                        "source_sense_description": "One who adheres to self-absorption and an ignorance of the views or needs of others.",
                        "target_lang_word": "solipsiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solipsiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a123aa9-a295-32a2-b756-575bee57c646",
                                        "entry_id": "9332e0bc-9edb-3ebc-a622-eb1f0fbf830f",
                                        "glosses": [
                                            "Sujet pensant pour qui il n’existe pas d’autre réalité que lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7de575-7c46-4ed4-b997-b0d3a87e1610",
                                                "sense_id": "6a123aa9-a295-32a2-b756-575bee57c646",
                                                "text": "Il est vrai que toute connaissance dérive de l’expérience, mais cela, même des idéalistes, des spiritualistes et un solipsiste comme Fichte, l’admettent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "solipsiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54369b32-c9d1-3dab-92f4-ad790bcd1c78",
                                        "entry_id": "782680ab-75e2-3ccd-b0e1-8e4fa8db56c3",
                                        "glosses": [
                                            "Qui relève du solipsisme, qui se vit ou se pense seul, sans les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c6dac8-f3e9-45bb-a0b4-473efab04c87",
                                                "sense_id": "54369b32-c9d1-3dab-92f4-ad790bcd1c78",
                                                "text": "La joie ne saurait être autiste ou solipsiste; elle est partage et partagée."
                                            },
                                            {
                                                "example_id": "c2e55432-2958-48d3-826c-aece704f89e3",
                                                "sense_id": "54369b32-c9d1-3dab-92f4-ad790bcd1c78",
                                                "text": "Jadis la vie privée avant besoin du Dehors, elle était inachevée, c'était son seul privilège. Désormais, secondée par l'arborescence de la Toile, elle est solipsiste et s'enivre d'elle-même, des ombres qu'elle prend pour la réalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "086b9a0d-63f1-4b50-90b8-b57ba25dd1ea",
                        "source_entry_id": "f61b0e26-e9ae-3a31-b935-9399e95074c8",
                        "source_sense_id": "d2ae3379-889e-3113-a9af-fafa9993979d",
                        "source_sense_description": "One who adheres to self-absorption and an ignorance of the views or needs of others.",
                        "target_lang_word": "Solipsist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Solipsist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d72e8c00-559c-391b-9364-afea22fc6cc3",
                                        "entry_id": "34588303-38d2-3191-9b41-5418ffe4734e",
                                        "glosses": [
                                            "Anhänger/Vertreter des Solipsismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f073e7b1-282a-4d7a-99fd-7371429a9ef3",
                                                "sense_id": "d72e8c00-559c-391b-9364-afea22fc6cc3",
                                                "text": "„Solipsisten vertreten eine ausgesprochen egozentrische Position in der Weise, dass ausschließlich die Existenz des eigenen Selbst behauptet wird.“"
                                            }
                                        ],
