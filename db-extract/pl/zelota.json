                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2369ba4-9dad-388d-8d8b-9af75c11d0eb",
                        "entry_id": "76e0a2ce-38e4-39fe-8ec9-c21f6f31d4c9",
                        "glosses": [
                            "członek żydowskiego ugrupowania religijno-politycznego z I w. n.e., którego celem była czynna walka z okupacją rzymską w Palestynie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df730384-d8d1-4800-b9b2-9493b89454a7",
                                "sense_id": "f2369ba4-9dad-388d-8d8b-9af75c11d0eb",
                                "text": "Ostatnim punktem oporu, ostatnią twierdzą zelotów w wojnie żydowskiej było oblężenie twierdzy Masada, której zdobycie zakończyło to nieudane powstanie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "569577fb-ea44-3f1e-a18a-ed38b6274aac",
                        "entry_id": "76e0a2ce-38e4-39fe-8ec9-c21f6f31d4c9",
                        "glosses": [
                            "członek antyarystokratycznego ugrupowania politycznego działającego w Salonikach w latach 1342-1350"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a47004ff-8c46-4c18-932c-82c9df2d7de9",
                                "sense_id": "569577fb-ea44-3f1e-a18a-ed38b6274aac",
                                "text": "Powstanie zelotów w Salonikach zostało stłumione przez cesarza bizantyjskiego, Jana VI Kantakuzena."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6c11a961-7bbd-37bc-b8a5-ce3739dc6b36",
                        "entry_id": "76e0a2ce-38e4-39fe-8ec9-c21f6f31d4c9",
                        "glosses": [
                            "gorliwy, fanatyczny entuzjasta, wyznawca jakiejś idei lub religii"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "4d2cbcb2-8ab8-4e63-a130-9c5c4b427d61",
                                "sense_id": "6c11a961-7bbd-37bc-b8a5-ce3739dc6b36",
                                "text": "Niektórzy z nich (wojujący demokraci) tak bardzo kochają ludzką godność, że są gotowi zalegalizować użycie tortur (które są ostateczną degradacją ludzkiej godności), żeby jej bronić… I czy to samo nie dotyczy także rosnących ostatnio w siłę obrońców Europy przeciwko imigranckiemu zagrożeniu? W swoim zapale do ochrony tradycji judeochrześcijańskiej, ci zeloci są gotowi poświęcić prawdziwe sedno chrześcijaństwa."
                            },
                            {
                                "example_id": "5f045c58-a54f-4e53-a49a-a0128fe4f215",
                                "sense_id": "6c11a961-7bbd-37bc-b8a5-ce3739dc6b36",
                                "text": "Nie jestem zelotą liberalizmu i nie uważam, żeby wolny rynek był panaceum na wszystko."
                            },
                            {
                                "example_id": "be57b641-2b64-4ec7-b893-a09a5d1fd36b",
                                "sense_id": "6c11a961-7bbd-37bc-b8a5-ce3739dc6b36",
                                "text": "Z tym zelotą zupełnie nie da się dyskutować!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4888b50a-5360-4b13-82bc-294daf5f69ea",
                        "source_entry_id": "76e0a2ce-38e4-39fe-8ec9-c21f6f31d4c9",
                        "source_sense_id": "f2369ba4-9dad-388d-8d8b-9af75c11d0eb",
