                        "glosses": [
                            "Traitement d’un sol compact destiné à l’aérer, sans le retourner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5305540-45aa-40ac-a028-f136fea44663",
                                "sense_id": "b33401b3-f58e-3f93-b3ed-0f6e7795c0c6",
                                "text": "Le décompactage en sec consiste à faire pénétrer, durant les périodes sèches, une dent en forme de pointe rigide (coutrier) pour briser la couche superficielle du sol et atteindre une profondeur moyenne de 7 à 10 cm. Les efforts engendrés par la réalisation du travail exigent la puissance d’une paire de bœufs pour tirer une dent."
                            }
                        ]
                    }
