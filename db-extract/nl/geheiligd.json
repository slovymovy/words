                                    },
                                    {
                                        "sense_id": "78340c81-cf3e-30c5-9c43-9656eb39adf4",
                                        "entry_id": "5d601bf6-d122-35bb-9069-9315a014a98c",
                                        "glosses": [
                                            "Digno del respeto más profundo, que no se debe tocar ni ofender."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9255a101-2cf3-47d2-9555-91c101aec86e",
                                                "sense_id": "78340c81-cf3e-30c5-9c43-9656eb39adf4",
                                                "text": "El sagrado recuerdo de mi fallecida madre."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
