                ],
                "senses": [
                    {
                        "sense_id": "6343fd7d-df02-3bc5-acb3-98764767c9ba",
                        "entry_id": "57aeb4b8-4248-320f-921d-7325c3dcea94",
                        "glosses": [
                            "Stempel der Post (Gerät)"
                        ],
                        "tags": [
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "338f923b-33f2-41a7-9e97-067b2aa2ce62",
                                "sense_id": "6343fd7d-df02-3bc5-acb3-98764767c9ba",
                                "text": "„Poststempel kamen ab 1764 nach dem Vorbild von Franklin zum Einsatz, zunächst auf Zeilenstempel mit Ortsnamen beschränkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b650883c-6504-3ec0-886a-b61b16d1836e",
                        "entry_id": "57aeb4b8-4248-320f-921d-7325c3dcea94",
                        "glosses": [
                            "Abdruck von [1]"
                        ],
                        "tags": [
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "6e51291b-e59f-4f3e-9025-019330f3e002",
                                "sense_id": "b650883c-6504-3ec0-886a-b61b16d1836e",
                                "text": "„Der einzige signifikante irische Poststempel aus dieser Zeit der postalischen Unabhängigkeit ist ein Stempel zur Aufteilung der bezahlten Taxe für die englische Verwaltung und die irische Verwaltung.“"
                            },
                            {
                                "example_id": "94e4f576-9e4f-4727-917e-d872326c9c03",
                                "sense_id": "b650883c-6504-3ec0-886a-b61b16d1836e",
                                "text": "„Jeder neue Poststempel wurde bejubelt.“"
                            },
                            {
                                "example_id": "9dc4a2d4-5537-432a-8017-0531a409b6ae",
                                "sense_id": "b650883c-6504-3ec0-886a-b61b16d1836e",
                                "text": "„Dazu treten alle Arten von Poststempeln und nicht zu vergessen, die Absenderfreistempel.“"
                            },
                            {
                                "example_id": "2b8cd074-86b9-47c1-a1a6-b46d3d1bb3ff",
                                "sense_id": "b650883c-6504-3ec0-886a-b61b16d1836e",
                                "text": "„Dreimal wöchentlich schrieb sie Briefe an ihre Familie und schickte sie an eine Freundin in Kopenhagen, die sie mit dem richtigen Poststempel nach Hella weitersandte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
