                        "entry_id": "d6e0b729-2371-35c2-a879-d64f37e3cb70",
                        "glosses": [
                            "A female given name from French."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa22748e-538c-481d-8a33-917d9faa96b6",
                                "sense_id": "94d710e5-2abc-3860-9f9b-0e7f8fe8fee3",
                                "text": "“Halt!” shouted the general as the happiest of Suzettes turned toward her kitchen."
                            },
                            {
                                "example_id": "ab9ef12e-2e08-4def-852d-dc0c6d4bfdf0",
                                "sense_id": "94d710e5-2abc-3860-9f9b-0e7f8fe8fee3",
                                "text": "On September 5, 1967, Iola gave birth to our last child. She was a beautiful, bright-eyed baby girl, and I named her Suzette. I had fallen in love with French names."
                            },
                            {
                                "example_id": "125b4536-c311-40e4-8179-9c1ffb0d347b",
                                "sense_id": "94d710e5-2abc-3860-9f9b-0e7f8fe8fee3",
                                "text": "Using the pen name “Suzette,” she became one of the country’s first female newspaper reporters."
                            },
                            {
                                "example_id": "880e068d-9695-4c30-9284-bc08cded1561",
                                "sense_id": "94d710e5-2abc-3860-9f9b-0e7f8fe8fee3",
                                "text": "Here's a little history of my introduction to The Big Cheesette. The first time she was nasty for no apparent reason, was on course, when I mispronounced the manager in charge of wardrobe's name, Suzette. I accidentally, called her Susan."
                            }
                        ]
                    }
