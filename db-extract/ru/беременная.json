                    {
                        "translation_id": "34d2a5de-7027-4b49-98ee-4bb798cb9076",
                        "source_entry_id": "8f19c3e3-1932-35c8-aa56-d6a5131d207f",
                        "source_sense_id": "e537b3b9-548e-3e60-a5aa-abc670f47052",
                        "target_lang_word": "pregnant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pregnant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec16d19a-ce97-3293-bc9a-8bc61f9370b1",
                                        "entry_id": "15c44e5a-1432-3dd2-9711-3a0df20a8656",
                                        "glosses": [
                                            "Carrying developing offspring within the body."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba398037-f5f0-497e-b8dd-dccbf274b345",
                                                "sense_id": "ec16d19a-ce97-3293-bc9a-8bc61f9370b1",
                                                "text": "I went to the doctor and, guess what, I’m five weeks pregnant!"
                                            },
                                            {
                                                "example_id": "61133990-5235-4c3d-b8ea-82d55720642c",
                                                "sense_id": "ec16d19a-ce97-3293-bc9a-8bc61f9370b1",
                                                "text": "I became pregnant in July 2014."
                                            },
                                            {
                                                "example_id": "f90a95f6-36d4-4b28-8455-a185eeb190ba",
                                                "sense_id": "ec16d19a-ce97-3293-bc9a-8bc61f9370b1",
                                                "text": "Once upon a time, not so long ago, women got pregnant and spent nine months in suspense before finding out if they were having a boy or a girl. But today? That waiting game is completely outdated, even quaint."
                                            },
                                            {
                                                "example_id": "91ba5e96-66e7-4328-b3e5-ecc11ed011f1",
                                                "sense_id": "ec16d19a-ce97-3293-bc9a-8bc61f9370b1",
                                                "text": "It suggests that pregnant women should be called pregnant people, presumably on the basis that just perhaps there may be a pregnant man somewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a998b2cc-5da3-3aa9-9b58-8e9ddf824ee3",
                                        "entry_id": "15c44e5a-1432-3dd2-9711-3a0df20a8656",
                                        "glosses": [
                                            "Carrying developing offspring within the body.",
                                            "Of a couple: expecting a baby together."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a4829f-0d4f-4a91-9a98-2f5a2d1360bb",
                                                "sense_id": "a998b2cc-5da3-3aa9-9b58-8e9ddf824ee3",
                                                "text": "We are pregnant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66c3696b-3f54-335f-83ca-4d5303c73207",
                                        "entry_id": "15c44e5a-1432-3dd2-9711-3a0df20a8656",
                                        "glosses": [
                                            "Meaningful, having numerous possibilities or implications; full of promise; abounding in ability, resources, etc."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "213d0848-f590-4de7-a4fe-7e89f0754a22",
                                                "sense_id": "66c3696b-3f54-335f-83ca-4d5303c73207",
                                                "text": "a pregnant pause"
                                            },
                                            {
                                                "example_id": "a25c6714-be02-49b1-be58-8e3162a22197",
                                                "sense_id": "66c3696b-3f54-335f-83ca-4d5303c73207",
                                                "text": "wherein the pregnant enemy does much"
                                            },
                                            {
                                                "example_id": "a8407ea8-d27d-4ac7-b78f-de1bfe9381e0",
                                                "sense_id": "66c3696b-3f54-335f-83ca-4d5303c73207",
                                                "text": "The many tear-jerkers deal with finality, with death and the end of love, with a stoicism pregnant with feeling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c564c1d5-65e0-3dcd-acf0-f9f22d71b6da",
                                        "entry_id": "15c44e5a-1432-3dd2-9711-3a0df20a8656",
                                        "glosses": [
                                            "Fecund, fertile, prolific (usually of soil, ground, etc.)."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec7016a-328f-4819-b668-11718006d562",
                                                "sense_id": "c564c1d5-65e0-3dcd-acf0-f9f22d71b6da",
                                                "text": "The sunne-beames bright vpon her body playd, / Being through former bathing mollifide, / And pierst into her wombe, where they embayd / With so sweet sence and secret power vnspide, / That in her pregnant flesh they shortly fructifide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9030f21f-9ca5-3e5d-b6a8-cfc8157f842b",
                                        "entry_id": "15c44e5a-1432-3dd2-9711-3a0df20a8656",
                                        "glosses": [
                                            "Affording entrance; receptive; yielding; willing; open; prompt."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cbdc1c9-fd9d-472d-8d2f-0722663c738d",
                                                "sense_id": "9030f21f-9ca5-3e5d-b6a8-cfc8157f842b",
                                                "text": "play at subtill games; faire vertues all;\nTo which the Grecians are most prompt and pregnant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3617dd41-01f7-3d19-88b5-7ff596bcf1fd",
                                        "entry_id": "15c44e5a-1432-3dd2-9711-3a0df20a8656",
                                        "glosses": [
                                            "Ready-witted; clever; ingenious."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pregnant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87487b98-7382-3904-b942-20401ebf26a4",
                                        "entry_id": "2df66fb0-79ba-3081-98ec-318d88776c4e",
                                        "glosses": [
                                            "A pregnant person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c494c812-c746-43a3-b0bf-cbeb36da418c",
                                                "sense_id": "87487b98-7382-3904-b942-20401ebf26a4",
                                                "text": "The Entbundenen, or those already delivered, are separate from those pregnants awaiting their accouchement"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pregnant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63a8cbb0-7841-3cc9-ae70-664576c12e54",
                                        "entry_id": "ed2c3583-f2d7-328f-b46e-2a840536a0dd",
                                        "glosses": [
                                            "Compelling; clear, evident."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc71dcf3-cffe-42ed-b1a1-eb5a8e27b42c",
                                                "sense_id": "63a8cbb0-7841-3cc9-ae70-664576c12e54",
                                                "text": "Peregrine was in a little time a distinguished character, not only for his acuteness of apprehension, but also for that mischievous fertility of fancy, of which we have already given such pregnant examples."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "beda968c-8820-429c-9d35-9e798106b7ec",
                        "source_entry_id": "8f19c3e3-1932-35c8-aa56-d6a5131d207f",
                        "source_sense_id": "e537b3b9-548e-3e60-a5aa-abc670f47052",
                        "target_lang_word": "schwanger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwanger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                        "entry_id": "133a5de6-aca0-3d12-9059-d9bc854838ef",
                                        "glosses": [
                                            "in dem Zustand, in dem ein Embryo (nach Herausbildung der inneren Organe ein Fötus) im Körper heranreift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fa0b24-7a68-4198-b4e8-7844c4cba9fa",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "Ich bin schwanger, sagte Sandra und schaute ihren Freund frohgelaunt an."
                                            },
                                            {
                                                "example_id": "ae62c80b-7d13-4e91-b983-2cf869cf5ebe",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Der Totemismus ist daher eine Schöpfung nicht des männlichen, sondern des weiblichen Geistes. Die Gelüste (sick fancies) des schwangeren Weibes sind die Wurzel desselben.“"
                                            },
                                            {
                                                "example_id": "b8ea0a80-6de7-4a51-a7c6-c922952f824a",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Für mich gibt es kaum etwas Peinlicheres, als wenn eine Frau ihren Mann verbittert anschaut, weil sie schwanger ist.“"
                                            },
                                            {
                                                "example_id": "37a13084-1686-488b-b6e4-f9c917c1ac7d",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Zusammengehörend sind sie auf die vierte Person, nämlich auf Jans Frau, Hedwig Bronski, geborene Lemke, die zu dem Zeitpunkt womöglich schon mit dem späteren Stephan schwanger ging, nur insofern angewiesen, als diese den Fotoapparat auf die drei und das Glück dieser drei Menschen richten muß, damit sich dreifaches Glück wenigstens mit den Mitteln der Fotografie festhalten läßt.“"
                                            },
                                            {
                                                "example_id": "44e2d2b6-34ee-405a-925b-3ee3e44618da",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Sie war allein und glücklich, schwanger zu sein, und als sie zu Joachim ging, um sich überreden zu lassen, war Hanna bereits entschlossen, ihr Kind zu haben; es störte sie nicht, daß Joachim damals meinte, sie in einem entscheidenden Beschluß ihres Lebens bestimmt zu haben, und daß er sich in Hanna verliebte, was kurz darauf zur Heirat führte.“"
                                            },
                                            {
                                                "example_id": "88537783-6768-4fd7-8977-39b1ab085004",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Aber ich glaub nicht, daß sie schwanger ist, nach meiner Rechnung ziemlich unwahrscheinlich.“"
                                            },
                                            {
                                                "example_id": "baf45c31-fb0a-43ab-8d46-433fda696264",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Sie wisse nicht, wie sie es sagen solle, aber, na ja, sie sei jetzt schwanger.“"
                                            },
                                            {
                                                "example_id": "d88c0b12-6520-4eb8-85af-a3d0ac7baaba",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Carla war schwanger, als sie zum Standesamt ging, und der weiße Schleier auf der Photographie war Lüge und doch nicht Lüge, weil niemand belogen wurde oder belogen werden konnte, denn der weiße Schleier hatte schon lange nur noch schmückenden Sinn und wurde eine peinliche dem Spott ausgelieferte Maskerade, wenn man ihn für das Zeichen der unverletzten Scham nahm, und keinesfalls war es frivol, daß man so dachte, denn die Zeit war eher geneigt, die Vorstellung, daß der Bräutigam nach vollzogener öffentlicher Zuführung und Feier sich auf die Braut stürze, auf das weiße Lamm, mit dem er das Hymenopfer vollzog, als frivol und schamlos zu empfinden, dennoch bedurfte es der Trauung, des Ordentlichen und der Amtlichkeit des Zusammentuns, des Segenspruches der Gemeinschaft, der Kinder wegen bedurfte es dies alles, der Kinder, die der Gemeinschaft geboren werden sollten und selbst mit Werbung ins Leben gelockt wurden,[…]“"
                                            },
                                            {
                                                "example_id": "fb69275a-ad17-4fdf-acd0-3b04db55574b",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Er spielte wieder Handball und trainierte den örtlichen Nachwuchs, während seine Frau erneut schwanger wurde und eine Tochter zur Welt brachte.“"
                                            },
                                            {
                                                "example_id": "ba4f96e5-25d8-4af7-b9f3-a176939b30e6",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Großer Überredungskünste von seiner Seite hatte es gewiß nicht bedurft, daß sie sich nach kurzem schwanger fühlte.“"
                                            },
                                            {
                                                "example_id": "6bd7491b-147c-4d1f-bdaa-9f6610cbda80",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Sie schlief mit ihm und wurde mit Horus schwanger, der das Reich seines Vaters wieder errichtete und die Religion des alten Ägypten prägte.“"
                                            },
                                            {
                                                "example_id": "420ea74f-4d2d-4869-8c80-e55db904fcf4",
                                                "sense_id": "fa3f1476-d507-3082-a642-e5202e8b00ed",
                                                "text": "„Weil Mama schwanger war, erhielt sie mehr Lebensmittelkarten als vorher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
