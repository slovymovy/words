                                    },
                                    {
                                        "sense_id": "8857f39c-9f68-3f12-9162-547a6ba149a9",
                                        "entry_id": "030327e7-9a0e-382b-90a5-eb8ded7f6bc3",
                                        "glosses": [
                                            "A person with mental retardation."
                                        ],
                                        "tags": [
                                            "dated",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86de9304-8a94-4ae9-b386-5871a8edfe39",
                                                "sense_id": "8857f39c-9f68-3f12-9162-547a6ba149a9",
                                                "text": "The retard in our class needs special help."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a658a19c-a0f5-3e12-ba7d-1fb18753050b",
                                        "entry_id": "030327e7-9a0e-382b-90a5-eb8ded7f6bc3",
                                        "glosses": [
                                            "A person or being who is extremely stupid or slow to learn."
                                        ],
                                        "tags": [
                                            "informal",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "636da25a-609f-41f8-bd2c-94b458685f30",
                                                "sense_id": "a658a19c-a0f5-3e12-ba7d-1fb18753050b",
                                                "text": "“That's 'cause your dog is a retard,” the large woman retorted. The pit bull must have sensed the insult because it got up on all fours and started barking at the woman. Not one to back down from an interspecies fight, the prison lady stood up […]"
                                            },
                                            {
                                                "example_id": "9bf639b6-e05b-4533-8e13-884a93a52741",
                                                "sense_id": "a658a19c-a0f5-3e12-ba7d-1fb18753050b",
                                                "text": "College freshman Scott Damerow set a new world record by using his head to bust 142 eggs and he now officially holds a place in the Guinness Book of Fucking Retards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d1c263a-12d3-3b3a-87bd-642114e36fb5",
                                        "entry_id": "396b3b3d-9bd6-3da0-b8f7-1b7c003abb41",
                                        "glosses": [
                                            "To keep delaying; to continue to hinder; to prevent from progressing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0c07dc-6a53-4b99-a264-d1c5ef572cb8",
                                                "sense_id": "7d1c263a-12d3-3b3a-87bd-642114e36fb5",
                                                "text": "retard the march of an army"
                                            },
                                            {
                                                "example_id": "af0c1bdd-bfb0-4eaa-8b2d-5e63c11bee70",
                                                "sense_id": "7d1c263a-12d3-3b3a-87bd-642114e36fb5",
                                                "text": "retard the motion of a ship"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff4470ff-03d4-34e9-875b-49aabff31fd9",
                                        "entry_id": "396b3b3d-9bd6-3da0-b8f7-1b7c003abb41",
                                        "glosses": [
                                            "To put off; to postpone."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bbd2b36-2896-446c-b07e-e2928f5a6c6f",
                                                "sense_id": "ff4470ff-03d4-34e9-875b-49aabff31fd9",
                                                "text": "to retard a rupture between nations"
                                            },
                                            {
                                                "example_id": "90d800bc-5511-44ee-bbe4-8e49b720bd12",
                                                "sense_id": "ff4470ff-03d4-34e9-875b-49aabff31fd9",
                                                "text": "to retard the attacks of old age"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "447fb994-a846-3fa5-9042-c9cbc6ce7fd6",
                                        "entry_id": "396b3b3d-9bd6-3da0-b8f7-1b7c003abb41",
                                        "glosses": [
                                            "To be slow or dilatory to perform (something)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9daa0fb-cc9b-38ba-9f41-ec2bc7ca32ae",
                                        "entry_id": "396b3b3d-9bd6-3da0-b8f7-1b7c003abb41",
                                        "glosses": [
                                            "To decelerate; to slow down."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ecd9ab7-07f5-4029-a7be-36646fc9bcac",
                                                "sense_id": "e9daa0fb-cc9b-38ba-9f41-ec2bc7ca32ae",
                                                "text": "70, 60, 50, 40, 30, 20, retard, retard..."
                                            },
                                            {
                                                "example_id": "aec20c62-8f56-4e82-b431-ad5e2ed2f5f7",
                                                "sense_id": "e9daa0fb-cc9b-38ba-9f41-ec2bc7ca32ae",
                                                "text": "This application of hydraulics led Sir George Dowty to develop the wagon retarder system, which comprised small hydraulic rams mounted inside the rail. These rams could simply retard a wagon, or both retard and 'boost' or speed up a wagon by hydraulic pressure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ede9ca5-ece8-39db-a698-3fb6ce9c2b9b",
                                        "entry_id": "396b3b3d-9bd6-3da0-b8f7-1b7c003abb41",
                                        "glosses": [
                                            "To stay back."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c0f1cb3-c4d4-43e9-a099-c6563faf6e9c",
                                                "sense_id": "0ede9ca5-ece8-39db-a698-3fb6ce9c2b9b",
                                                "text": "Some years it [The River Nile] hath also retarded, and come far later than usually it was expected"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfdb9fdf-92e8-4355-8eac-4143d24d3bf7",
                        "source_entry_id": "3cae8d6a-3b58-3fa5-a3d1-044870c2a383",
                        "source_sense_id": "e9755d91-02d4-3d0a-8014-0c9129d3e4d7",
                        "source_sense_description": "Schimpfwort; umgangssprachlich: jemand, der dumm, uncool, unfähig oder merkwürdig ist",
                        "target_lang_word": "abruti",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abruti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9757986-9baf-3df1-a5dd-00e98321d617",
                                        "entry_id": "6b758c08-1ab6-38d6-9693-28e99c3430bf",
                                        "glosses": [
                                            "Physiquement, moralement ou intellectuellement diminué par le bruit, la chaleur, la fatigue, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "284ebf4a-0e71-471e-954f-c5d0e906c4fd",
                                                "sense_id": "e9757986-9baf-3df1-a5dd-00e98321d617",
                                                "text": "Ils étaient là au milieu des malades, vieux hors d’âge, jeunes enfants pleurant dans les bras de leur mère, femmes à l’air hagard, abruties de douleur, jeunes hommes mal rasés au teint de cire."
                                            },
                                            {
                                                "example_id": "ee543400-e00e-4abf-a774-87cc2bbf31a5",
                                                "sense_id": "e9757986-9baf-3df1-a5dd-00e98321d617",
                                                "text": "À force de concentration, Beryl parvient à écarter l’idée qu’il l’a effectivement approchée, qu’il a pu la toucher tandis qu’elle était couchée, abrutie par les drogues qu’il a recommencé à mettre dans ses rations."
                                            },
                                            {
                                                "example_id": "ff5d26a7-4e8c-4802-bc0d-ef8843a72b8b",
                                                "sense_id": "e9757986-9baf-3df1-a5dd-00e98321d617",
                                                "text": "Ce souci rongeur donnait à ce gros petit homme, à sa figure autrefois rieuse, un air sombre et abruti qui le faisait ressembler à un malade dévoré par un poison ou par une affection chronique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "844bfc28-522d-3185-9678-63d0450f6101",
                                        "entry_id": "6b758c08-1ab6-38d6-9693-28e99c3430bf",
                                        "glosses": [
                                            "Bête ; stupide ; inconscient."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a4a58fb-2ac5-4b3b-8514-16f82e63ab1d",
                                                "sense_id": "844bfc28-522d-3185-9678-63d0450f6101",
                                                "text": "Louis XVI n’était pas précisément tel qu’on s’était attaché à le peindre pour l’avilir : ce n’était ni l’imbécile abruti qu’on exposait au mépris du peuple, ni l’honnête homme bon et sensible que préconisaient ses amis."
                                            },
                                            {
                                                "example_id": "9882674d-a838-4580-bcd2-dbf9f02a7052",
                                                "sense_id": "844bfc28-522d-3185-9678-63d0450f6101",
                                                "text": "Cet homme, sans chaperon et sans veste, au regard abruti, à la barbe et aux sourcils tachetés de plâtre, c’était son père!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abruti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be4a938d-897b-35e2-807b-eb79fb8b39d0",
                                        "entry_id": "5aa3a392-f43b-3bdd-a713-5eba52e23539",
                                        "glosses": [
                                            "Personne complètement stupide."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20e254e9-1798-4c01-a471-b522c28b4572",
                                                "sense_id": "be4a938d-897b-35e2-807b-eb79fb8b39d0",
                                                "text": "C'était probablement vrai ce que disaient les prompteurs, que nous étions des abrutis, autrement dit, des bébêtes ou des babaches, toujours disposés à gober n'importe quoi."
                                            },
                                            {
                                                "example_id": "557c0e52-5806-463a-b2e2-78b6302459fe",
                                                "sense_id": "be4a938d-897b-35e2-807b-eb79fb8b39d0",
                                                "text": "Y’a pas de mal à se moquer des abrutis. Ils sont là pour ça, non ?"
                                            },
                                            {
                                                "example_id": "036ef903-9c89-4044-a30d-bf98b2f9431b",
                                                "sense_id": "be4a938d-897b-35e2-807b-eb79fb8b39d0",
                                                "text": "Robotnik est un génie\nLe Hérisson est un abruti."
                                            },
                                            {
                                                "example_id": "2c3743e1-b426-4c98-8e4a-af1d4c7be5fd",
                                                "sense_id": "be4a938d-897b-35e2-807b-eb79fb8b39d0",
                                                "text": "Tous les quarts d’heure,\nUn paon siffleur\nNous traite de péquenots, de vendus, d’abrutis,\nDe vieux débris\nEt j’en oublie."
                                            }
                                        ]
                                    }
                                ]
