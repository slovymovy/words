                    },
                    {
                        "sense_id": "e8200597-f033-36be-a767-ee433b36b070",
                        "entry_id": "80586894-b8fa-34af-8393-1cb7a57d0d19",
                        "glosses": [
                            "ein einteiliger, verfalzter Dachziegel meist aus gebranntem Ton, der optisch im Verbund sehr ähnlich wie eine Eindeckung vom Ziegeltyp „Mönch und Nonne“ wirkt"
                        ],
                        "tags": [],
                        "examples": [
