                ],
                "senses": [
                    {
                        "sense_id": "8ac940fb-4adc-306d-a807-4e936a20d546",
                        "entry_id": "b792c3f4-8d30-3ca4-8e12-077f03ff575f",
                        "glosses": [
                            "Ausstrahlung von Radiosignalen, die analog übertragen werden"
                        ],
                        "tags": [
                            "Radiotechnik, kein Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b6f8947f-8ad1-46cf-88e0-f878c93755fd",
                                "sense_id": "8ac940fb-4adc-306d-a807-4e936a20d546",
                                "text": "„Trotz UKW und Stereo ist Analogradio auch heute weit von CD-Qualität entfernt.“"
                            },
                            {
                                "example_id": "8149b2a9-4440-49f9-b6f4-41583b4072f0",
                                "sense_id": "8ac940fb-4adc-306d-a807-4e936a20d546",
                                "text": "„Und wichtig für die Argumentation hier: Einige Dinge gäbe es nicht nur in schlechterer Qualität in dem Sinne, dass man halt von Digitalfunk wieder auf das alte UKW-Analogradio zurückgehen müsste; […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8a2641df-ba1d-3dbe-a646-d8225c845e8f",
                        "entry_id": "b792c3f4-8d30-3ca4-8e12-077f03ff575f",
                        "glosses": [
                            "ein elektronisches Gerät, das auf Analogtechnik basiert und nur solche Funksendungen korrekt empfangen kann, die in analogen Verfahren ausgestrahlt werden"
                        ],
                        "tags": [
                            "Technik, umgangssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "33b239d1-50c5-4c65-8f70-1d53489460b6",
                                "sense_id": "8a2641df-ba1d-3dbe-a646-d8225c845e8f",
                                "text": "„Jeder lötkolbenbestückte Hobbybastler konnte ein altes Analogradio mit Widerständen, Kondensatoren und ein paar geübten Handgriffen so umbauen, dass sich der Empfangsbereich auch auf die von der Polizei genutzten Frequenzen erstreckte.“"
                            },
                            {
                                "example_id": "e08cd5b2-8132-4a7f-ae86-3b69b07c6279",
                                "sense_id": "8a2641df-ba1d-3dbe-a646-d8225c845e8f",
                                "text": "„… und in der Klangtextur wird die gesprochene Sprache durch Stimmen ersetzt, die aus einem Radio zu kommen scheinen; andere Klänge klingen wie eine Sirene oder wie die Sendersuche auf einem Analogradio.“"
                            },
                            {
                                "example_id": "341e8f05-9a15-477b-98c8-65ee10613126",
                                "sense_id": "8a2641df-ba1d-3dbe-a646-d8225c845e8f",
                                "text": "„Viele solcher Stationen existieren immer noch, doch das Analogradio des Hyundais hatte etwa eine Woche nach Ablauf der Garantie den Geist aufgegeben.“"
                            },
                            {
                                "example_id": "677e0050-ca0b-4b14-8d0a-06ff11988c54",
                                "sense_id": "8a2641df-ba1d-3dbe-a646-d8225c845e8f",
                                "text": "„Die Musikwiedergabe der Digitalradio-Programme übernehmen, wie gehabt, das UKW-Radio und die Lautsprecher im Auto. Somit kann auf einfache Weise an jedem Analogradio DAB+ empfangen werden.“"
                            },
                            {
                                "example_id": "ba7ad731-49a5-4b1c-810c-a8a76c69fbff",
                                "sense_id": "8a2641df-ba1d-3dbe-a646-d8225c845e8f",
                                "text": "„Dieses graue AM/FM Analogradio mit Tragegriff strahlt einen Hauch von Retro aus und ist sehr stylisch.“"
                            },
                            {
                                "example_id": "5d5a8060-1b0b-4fb8-98b5-6d8f1ebcfc81",
                                "sense_id": "8a2641df-ba1d-3dbe-a646-d8225c845e8f",
                                "text": "„Um mit einem Analogradio über das Breitbandkabel weiter zu hören, benötigen Sie auch für das Radio einen digitalen Receiver.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
