                "senses": [
                    {
                        "sense_id": "f259904a-cef3-3a75-a906-4549dd954459",
                        "entry_id": "3ec5aaea-6b8e-3495-962c-664f3cdafa95",
                        "glosses": [
                            "Tier, das in einem Experiment als Proband dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbe8b0f6-f96d-45bd-875b-fec4c0de771f",
                                "sense_id": "f259904a-cef3-3a75-a906-4549dd954459",
                                "text": "„Die Künstlerin Susanne Mansen hingegen ehrt den Hund \"Laika\", den russische Kosmonauten als Testtier ins All schickten.“"
                            },
                            {
                                "example_id": "5fcba1ab-1eac-464a-9735-e68fb7c42d0f",
                                "sense_id": "f259904a-cef3-3a75-a906-4549dd954459",
                                "text": "„Im eigentlichen Test erhält dann das Testtier im Tausch gegen das Brot nur eine Traube, während das zweite Tier ein Leckerli bekommt.“"
                            },
                            {
                                "example_id": "a78660c9-e162-4774-90de-54e988601324",
                                "sense_id": "f259904a-cef3-3a75-a906-4549dd954459",
                                "text": "„Der sogenannte Spiegeltest, bei dem einem Tier schlicht ein Spiegel vorgehalten wird, soll belegen, ob das Testtier sich selbst erkennt oder nicht.“"
                            },
                            {
                                "example_id": "4fffe980-7f6c-4244-9c92-1d1f77bd872f",
                                "sense_id": "f259904a-cef3-3a75-a906-4549dd954459",
                                "text": "„Der US-Mediziner Michael McCulloch konnte 2006 nachweisen, dass Hunde in 88 bis 97 Prozent der Proben Krebspatienten korrekt erkannten. Jürgen Lösch vom Deutschen Krebsforschungszentrum rügte in der Folge methodische Mängel in der kalifornischen Studie, allen voran die geringe Zahl der Testtiere.“"
                            },
                            {
                                "example_id": "435dd036-d5ff-4489-b8de-240273607f84",
                                "sense_id": "f259904a-cef3-3a75-a906-4549dd954459",
                                "text": "„Zusammen mit dem Regensburger Zoologen Professor Dr. Jürgen Boeckh untersuchte Bayer die Wirkung von Bayrepel® auf die Gelbfiebermücke Aedes aegypti und die Malaria-übertragende Anophelesmücke. Dazu setzten die Forscher die Testtiere an das Ende des langen Schenkels einer y-förmigen Plexiglasröhre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
