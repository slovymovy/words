            {
                "entry_id": "49cf4fc5-3f7f-3b80-978c-411b57467fb4",
                "word": "deb",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7a13947d-41ba-464c-a7ff-6da12be8034a",
                        "entry_id": "49cf4fc5-3f7f-3b80-978c-411b57467fb4",
                        "tags": [
                            "plural"
                        ],
                        "form": "debs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05faa942-6074-3468-b731-879eff95de45",
                        "entry_id": "49cf4fc5-3f7f-3b80-978c-411b57467fb4",
                        "glosses": [
                            "A debutante (a young woman who makes her first formal appearance in society)."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "da38614a-76c3-4386-830e-c9f248f37ba3",
                                "sense_id": "05faa942-6074-3468-b731-879eff95de45",
                                "text": "Josie Powell that was, prettiest deb in Dublin. How time flies by!"
                            },
                            {
                                "example_id": "b32f1db3-0ce6-446b-b695-b6171647470a",
                                "sense_id": "05faa942-6074-3468-b731-879eff95de45",
                                "text": "Go back to your debs or little boys if that's what you fancy and leave us hard working girls, the virile, mature and experienced working men of this world."
                            },
                            {
                                "example_id": "178c9a38-7dc6-46f6-b344-64f1708e3b4c",
                                "sense_id": "05faa942-6074-3468-b731-879eff95de45",
                                "text": "'The Honourable Hester Bingham,' she told Simon. 'They said she was the most stylish deb of her season. Me and Mama read all about her. That was the first season after the war, you know, and she wote a Hardy Amies dress when she was presented to the King and Queen.'"
                            },
                            {
                                "example_id": "e5c37e3f-ba52-4bd2-bc59-490dc9dc4cbc",
                                "sense_id": "05faa942-6074-3468-b731-879eff95de45",
                                "text": "\"After that little crash and burn, I guess my mother thought it would help to give me the same training. Social graces and deportment and all that bullshit. I even had a deb ball.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "4137b4ae-4eb5-3c69-be51-b5b4ddd56703",
                        "entry_id": "49cf4fc5-3f7f-3b80-978c-411b57467fb4",
                        "glosses": [
                            "A debutante ball or debut."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "7355f640-7f75-4681-b817-9f5a03f19296",
                                "sense_id": "4137b4ae-4eb5-3c69-be51-b5b4ddd56703",
                                "text": "\"When I met him at my deb, I fell for him. Wanted nothing more than to marry him. That it happened, even after all those years, felt as if the stars had finally aligned.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "d70dc2e8-fdd9-3821-92f6-59da060be9d3",
                        "entry_id": "49cf4fc5-3f7f-3b80-978c-411b57467fb4",
                        "glosses": [
                            "A female member of a gang."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "404ca723-cd27-4410-9f33-ffc6ee2de406",
                                "sense_id": "d70dc2e8-fdd9-3821-92f6-59da060be9d3",
                                "text": "Then one night Liz showed up at the factory with a scratched face and torn blouse. She had been in a fight at the park with another girl, a deb of the Porto Rican Flyers."
                            },
                            {
                                "example_id": "7c54a737-8638-4f71-a43a-37a6c5135830",
                                "sense_id": "d70dc2e8-fdd9-3821-92f6-59da060be9d3",
                                "text": "I want you to take over absolute control of all the debs until Ruby is released. Your main job will be to see that most of the girls take at least two tricks a night someplace where the boys can roll them without too much trouble."
                            }
                        ]
                    }
                ],
