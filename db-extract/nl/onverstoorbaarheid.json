                                "target_senses": [
                                    {
                                        "sense_id": "0cf00f2c-7c6e-3a26-bb35-097f25bdd5d4",
                                        "entry_id": "f2fa874b-4e8e-3d2c-8055-ceefcbaca659",
                                        "glosses": [
                                            "A state of calm, unruffled self-assurance; aplomb, composure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d8b8caa-ef63-492f-86ce-eff96d7fc962",
                                                "sense_id": "0cf00f2c-7c6e-3a26-bb35-097f25bdd5d4",
                                                "text": "\"As I sat alone at my breakfast--Mrs. Challenger is in the habit of keeping her room of a morning--it suddenly entered my head that it would be entertaining and instructive to see whether I could find any limits to this woman's imperturbability.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
