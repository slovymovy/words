                "senses": [
                    {
                        "sense_id": "f245e79b-43f2-334d-b3ea-a792f4ff84c6",
                        "entry_id": "2b6313fd-6665-37c6-a433-57113232fb71",
                        "glosses": [
                            "Syndiquer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3e47c20-db06-423c-aa39-d830d47e98df",
                                "sense_id": "f245e79b-43f2-334d-b3ea-a792f4ff84c6",
                                "text": "Les banques créancières de ces fonds ne parvenaient plus à resyndiquer les prêts accordés auprès d'autres intermédiaires financiers."
                            },
                            {
                                "example_id": "83bb4dbf-0f15-45d7-9e0c-44c2f940ca45",
                                "sense_id": "f245e79b-43f2-334d-b3ea-a792f4ff84c6",
                                "text": "Quand il y avait piquet, moi je descendais quand même travailler. Et puis je me suis quand même resyndiqué par la suite, quand j'ai travaillé au jour."
                            }
                        ]
                    }
