                        "examples": [
                            {
                                "example_id": "56ff4a4b-3cd9-4e78-9507-d55ff2ab809e",
                                "sense_id": "ee772c4e-fbaa-3ba1-bdfe-c4d39f3aae93",
                                "text": "'Smuggling,' she said. 'has a fine romantic ring about it—once aboard the lugger, you heave ho and all that kind of malarky. [...]'"
                            },
                            {
                                "example_id": "b32a416f-64d8-4f15-a0af-96e6f5205023",
                                "sense_id": "ee772c4e-fbaa-3ba1-bdfe-c4d39f3aae93",
                                "text": "There's mischiefs and malarkies / But no queers, or yids, or darkies. / Within this bastard's carnival, / This vicious cabaret!"
                            },
                            {
                                "example_id": "89e1c7f3-1a7f-4d00-991f-2bc5a04c8e11",
                                "sense_id": "ee772c4e-fbaa-3ba1-bdfe-c4d39f3aae93",
                                "text": "A company that makes a fetish of never exceeding the budget invites game-playing and other malarky. It is easy to forget the obvious: that it involves no skill to come in on time and under budget if the schedule and budget are generous enough."
                            }
                        ]
                    }
