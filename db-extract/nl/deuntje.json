                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cantinela",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "25a0c3ef-cd8c-309c-a0e9-fd88bd76d646",
                                        "entry_id": "04318d02-5b0f-3d2b-9e42-4f54822cf98a",
                                        "glosses": [
                                            "Cantar, copla, composición poética breve, hecha generalmente para que se cante."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3715f25a-b28b-368f-96cd-990fe3e3325c",
                                        "entry_id": "04318d02-5b0f-3d2b-9e42-4f54822cf98a",
                                        "glosses": [
                                            "Repetición molesta e importuna de alguna cosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb21f029-9684-430c-84c7-f76c47dfcccb",
                                                "sense_id": "3715f25a-b28b-368f-96cd-990fe3e3325c",
                                                "text": "Yo le reprocho y le digo: \"¿Qué haces, Áyax? ¿Porqué sin ser llamado te lanzas a este intento, ?\" El me responde pocas palabras, la cantinela de siempre: \"Mujer, el silencio es el adorno de las mujeres.\"."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
