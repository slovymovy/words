{
    "word_family": [
        "mason"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdc6f28f-345e-3d2c-bd30-d13207df4824",
                    "sense_definition": "The art or occupation of a mason.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He studied <w>masonry</w> for five years to become a professional builder.",
                            "target_lang_translations": {
                                "zh": "他学习了五年<w>石工</w>，成为了一名专业的建筑工人。"
                            }
                        },
                        {
                            "text": "The local college offers a specialized course in traditional <w>masonry</w>.",
                            "target_lang_translations": {
                                "zh": "当地学院提供一门关于传统<w>砌筑</w>的专业课程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stonecraft"
                    ],
                    "target_lang_definitions": {
                        "zh": "石匠的技艺或职业。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "石工",
                                "target_lang_sense_clarification": "指石匠的职业或工作。"
                            },
                            {
                                "target_lang_word": "砌筑",
                                "target_lang_sense_clarification": "指建筑施工中的砌砖或砌石工艺。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b898872f-b78c-3de3-95f3-c25fd8096428",
                    "sense_definition": "The work or performance of a mason.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>masonry</w> on the cathedral was truly exquisite and detailed.",
                            "target_lang_translations": {
                                "zh": "大教堂上的<w>石工活</w>确实精美且细节丰富。"
                            }
                        },
                        {
                            "text": "Experts inspected the <w>masonry</w> to ensure the wall was structurally sound.",
                            "target_lang_translations": {
                                "zh": "专家检查了<w>砌筑工程</w>，以确保墙体结构稳固。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stonework"
                    ],
                    "target_lang_definitions": {
                        "zh": "石匠所完成的工程或作品。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "石工活",
                                "target_lang_sense_clarification": "指石匠完成的具体工程。"
                            },
                            {
                                "target_lang_word": "砌筑工程",
                                "target_lang_sense_clarification": "指建筑中砌筑部分的施工质量或成果。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6c27fc6-9415-3a45-b7f1-c5fe5ababcc8",
                    "sense_definition": "Anything constructed of materials such as stone, brick, or tiles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>masonry</w> was cracked due to the severe winter frost.",
                            "target_lang_translations": {
                                "zh": "由于严冬的霜冻，旧的<w>砖石结构</w>出现了裂缝。"
                            }
                        },
                        {
                            "text": "Many historic houses feature thick <w>masonry</w> walls for better insulation.",
                            "target_lang_translations": {
                                "zh": "许多历史悠久的房屋都采用厚实的<w>砌体</w>墙，以获得更好的隔热效果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stonework"
                    ],
                    "common_phrases": [
                        "masonry walls"
                    ],
                    "target_lang_definitions": {
                        "zh": "用石块、砖块或瓦片等材料建造的结构物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "砖石结构",
                                "target_lang_sense_clarification": "指由砖石砌筑而成的建筑部分。"
                            },
                            {
                                "target_lang_word": "砌体",
                                "target_lang_sense_clarification": "建筑学术语，指由砖、石、砌块等砌筑而成的构件。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c315329-dfa2-3ec5-8343-33bbd106e5cd",
                    "sense_definition": "The craft, institution, or mysteries of Freemasons.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He became interested in the history and traditions of <w>masonry</w>.",
                            "target_lang_translations": {
                                "zh": "他开始对<w>共济会</w>的历史和传统产生兴趣。"
                            }
                        },
                        {
                            "text": "The secret society of <w>masonry</w> has existed for several centuries.",
                            "target_lang_translations": {
                                "zh": "<w>共济会</w>这个秘密社团已经存在了几个世纪。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "共济会的组织、传统或神秘仪式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "共济会",
                                "target_lang_sense_clarification": "指那个历史悠久的秘密兄弟会组织。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}