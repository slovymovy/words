                                        "sense_id": "356c24e6-1c71-3524-b749-7df174d87849",
                                        "entry_id": "5573add8-0fff-3616-9380-979a49eba749",
                                        "glosses": [
                                            "In an indifferent manner.",
                                            "Tolerably; passably."
