                                                "example_id": "d99661c1-b578-42ed-b951-3e411d1fb15a",
                                                "sense_id": "a6209b37-b314-3028-b2a8-5465d6f18b7c",
                                                "text": "With the rise of cognitive neuroscience, the time may be coming when we can make a reasonable fist of mapping down from an understanding of the functional architecture of the mind to the structural architecture of the brain."
                                            }
                                        ]
                                    }
                                ]
