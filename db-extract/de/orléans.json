                "translations": [
                    {
                        "translation_id": "3cf33bc5-345a-4f31-9544-0bafb8dad313",
                        "source_entry_id": "a3ecab66-66ce-3faa-a468-f8d2def558f5",
                        "source_sense_id": "8456b51b-53cf-35c9-906a-91c37cd56770",
                        "source_sense_description": "Stadt in Zentralfrankreich",
                        "target_lang_word": "Orléans",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orléans",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfcf706d-a5dd-334e-9381-f6653f49cd19",
                                        "entry_id": "8f34948a-39e1-3e42-9449-388ee7dda7fb",
                                        "glosses": [
                                            "Commune, ville et chef-lieu de département française, située dans le département du Loiret."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f03e5e-f3bb-4ef9-9160-a8af2317d5c3",
                                                "sense_id": "dfcf706d-a5dd-334e-9381-f6653f49cd19",
                                                "text": "Lorsque la troupe des pastoureaux entra dans Orléans, le jour de saint Barnabas, l’évêque de cette ville interdit à tous ses clercs d’assister à ses prédications ; car, disait-il, ce sont les souricières du diable."
                                            },
                                            {
                                                "example_id": "3d19e463-91c6-4b5a-b0fd-85551390fc3c",
                                                "sense_id": "dfcf706d-a5dd-334e-9381-f6653f49cd19",
                                                "text": "Mon courrier est arrivé d’Orléans il y a une heure, et, grâce à la poste, a fait trente-deux lieues dans la journée."
                                            },
                                            {
                                                "example_id": "bfb592a7-ddd8-4266-b463-f10da397d787",
                                                "sense_id": "dfcf706d-a5dd-334e-9381-f6653f49cd19",
                                                "text": "Comme le supplicieur d’Orléans qui faisait bouillir les faux-monnayeurs et repoussait de la pique ceux qui venaient surnager, Ambroise Paré faisait échauder vivants deux petits chiens dans l’huile de lys […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c0391b-832d-3afd-89dd-4e36543c3172",
                                        "entry_id": "8f34948a-39e1-3e42-9449-388ee7dda7fb",
                                        "glosses": [
                                            "Branche de la lignée des Bourbons qui régnèrent sur la France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33da0bb2-adfd-499e-935c-f97a1f9161a7",
                                                "sense_id": "74c0391b-832d-3afd-89dd-4e36543c3172",
                                                "text": "Je demande que les individus de la famille d’Orléans dite Égalité, soient traduits devant le tribunal révolutionnaire […]"
                                            },
                                            {
                                                "example_id": "cdaf71cf-3213-41ac-98b9-3daa4f67c627",
                                                "sense_id": "74c0391b-832d-3afd-89dd-4e36543c3172",
                                                "text": "Un riche propriétaire, M. Roudier, au visage grassouillet et insinuant, y discourait des heures entières, avec la passion d’un orléaniste que la chute de Louis-Philippe avait dérangé dans ses calculs. C’était un bonnetier de Paris retiré à Plassans, ancien fournisseur de la cour, qui avait fait de son fils un magistrat, comptant sur les Orléans pour pousser ce garçon aux plus hautes dignités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
