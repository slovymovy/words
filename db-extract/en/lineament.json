                                    },
                                    {
                                        "sense_id": "a1440c1f-58dd-3aac-b9e6-3a08c5c8b39c",
                                        "entry_id": "ea1d8dfd-f5c7-3067-bc0f-3da7c19b23ec",
                                        "glosses": [
                                            "κάποιο γνώρισμα, ιδιότητα ή ποιότητα προσώπου ή πράγματος"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "248d1291-6a4a-4ded-bfa7-402d3f18981a",
                                                "sense_id": "a1440c1f-58dd-3aac-b9e6-3a08c5c8b39c",
                                                "text": "τα γενικά χαρακτηριστικά ενός τραπεζιού είναι το σχήμα της επίπεδης επιφάνειας, ο αριθμός των στηριγμάτων που την υποβαστάζουν, το υλικό κατασκευής του κλπ."
                                            },
                                            {
                                                "example_id": "6af99c48-cf03-400f-93b9-556300ca8a7b",
                                                "sense_id": "a1440c1f-58dd-3aac-b9e6-3a08c5c8b39c",
                                                "text": "※ Σημαντικό χαρακτηριστικό αποτελεί η μετατόπιση σημαντικών ζητημάτων από τον άνθρωπο στην ίδια την τεχνολογία και την πληροφορία, γεγονός που έχει ως αποτέλεσμα η λειτουργία του οργανισμού να φαίνεται κάπως αυθόρμητη, αδόμητη, παράδοξη και ίσως «μαγική». (Δημοσθένης Ι. Δασκαλάκης, Βιομηχανική Κοινωνιολογία και βιομηχανικές σχέσεις, εκδ. Παπαζήσης, 2014)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9686bd97-d46c-30b2-bafb-840c49951db3",
                                        "entry_id": "ea1d8dfd-f5c7-3067-bc0f-3da7c19b23ec",
                                        "glosses": [
                                            "κάτι που χαρακτηρίζει ένα αντικειμένου, το οποίο εκφράζεται με τις τιμές που λαμβάνουν μία ή περισσότερες μεταβλητές αντικειμένου (instance variable) και συνηθίζεται η διαχείρισή του να γίνεται με τα properties"
                                        ],
                                        "tags": [
                                            "αντικειμενοστρεφής προγραμματισμός"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2c7df34-a24b-3063-9535-444e30b5a47b",
