                        "glosses": [
                            "To make a system or subsystem that meets the standards of one newly manufactured by disassembling a used one, cleaning, inspecting, replacing worn and defective parts, and reassembling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b9ea85-4f63-40ae-acd2-78f8d457e093",
                                "sense_id": "894b1f09-332d-36fc-a9a3-72ada3498f2f",
                                "text": "But used starters and alternators are still remanufactured in the United States, reusing the costly copper wiring in each device and selling them in the $1.5 billion market for replacement starters and alternators."
                            }
                        ]
                    }
