                        "glosses": [
                            "groep winkels met één eigenaar en een gemeenschappelijke leiding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f68023-6e75-4556-a928-e823895048a3",
                                "sense_id": "6a536d2a-de27-3e1c-89de-0416cfcdbf49",
                                "text": "Eind februari werd boekhandelketen Polare failliet verklaard. De bedoeling is om elk van de twintig vestigingen apart te verkopen."
                            },
                            {
                                "example_id": "a34b680c-318e-4427-958e-032b6cf02aba",
                                "sense_id": "6a536d2a-de27-3e1c-89de-0416cfcdbf49",
                                "text": "De tijd dringt voor de groep. Bewindvoerder Jan Dingemans is sinds vrijdag in gesprek met een potentiële koper. Het zou gaan om durfinvestereerder ProCures uit Bussum. Dat bedrijf zou de boekhandelketen De Slegte willen samenvoegen met Selexyz. Zo zouden beide partijen de hoge huurlasten van de winkelpanden kunnen delen."
                            },
                            {
                                "example_id": "2636b282-7850-4563-b898-e24ffa72c7fa",
                                "sense_id": "6a536d2a-de27-3e1c-89de-0416cfcdbf49",
                                "text": "Het bedrijf verkeerde al tijden in zwaar weer doordat de verkoop van boeken daalt. De hele boekenbranche wordt daardoor getroffen. Vorige maand werd boekhandelketen Selexyz op het nippertje van een faillissement gered."
                            }
                        ]
