                    {
                        "sense_id": "a90575d8-5b11-3a8b-a009-69ef7194c0b6",
                        "entry_id": "e52776e9-abeb-3812-9eae-7536e3f18278",
                        "glosses": [
                            "Marocain, rebeu."
                        ],
                        "tags": [
