                                ]
                            },
                            {
                                "target_word": "mast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cfa46d5-62d8-3cb6-979b-e90507451203",
                                        "entry_id": "e5ea5545-4da0-31e0-9431-0ae1e417516c",
                                        "glosses": [
                                            "The fruit of forest-trees (beech, oak, chestnut, pecan, etc.), especially if having fallen from the tree, used as fodder for pigs and other animals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c077046e-1e5e-470b-a2c9-3d34ef3be89b",
                                                "sense_id": "3cfa46d5-62d8-3cb6-979b-e90507451203",
                                                "text": "She ſhut them ſtraight in ſties; and gaue them meate / Oke-maſt, and beech, and Cornell fruite, they eate, […]"
                                            },
                                            {
                                                "example_id": "dd3d8c67-6a7d-438b-9978-23105d50173f",
                                                "sense_id": "3cfa46d5-62d8-3cb6-979b-e90507451203",
                                                "text": "The Winter comes, and then the falling Maſt, / For greedy Swine, provides a full repaſt."
                                            },
                                            {
                                                "example_id": "785cad71-142e-433a-a1fb-d9f4eefa0d8f",
                                                "sense_id": "3cfa46d5-62d8-3cb6-979b-e90507451203",
                                                "text": "[T]hey feed and grovel like Swine under an Oak, filling themſelves with the Maſt, but never ſo much as looking up, either to the Bows that bore, or the Hands that ſhook it down."
                                            },
                                            {
                                                "example_id": "24eaf64d-ad90-4b3e-ad82-9a38b61bfdba",
                                                "sense_id": "3cfa46d5-62d8-3cb6-979b-e90507451203",
                                                "text": "He […] would begin to pick up the seed-cases or mast, squeeze each one with his fingers to see if it were fertile, and drop it if it were not."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec44bfa-2f21-32b9-bdaf-d1337c85717e",
                                        "entry_id": "0693bd2b-3c37-38df-a82a-5b01addbde44",
                                        "glosses": [
                                            "To feed on forest seed or fruit."
                                        ],
                                        "tags": [
                                            "of swine and other animals"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6bef215-9dae-3a1b-ab12-430509bbc324",
                                        "entry_id": "0693bd2b-3c37-38df-a82a-5b01addbde44",
                                        "glosses": [
                                            "To produce a very large quantity of fruit or seed in certain years but not others."
                                        ],
                                        "tags": [
                                            "of a population of plants"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6be8a0d0-e7da-4278-84e5-55c77cf3488f",
                                                "sense_id": "b6bef215-9dae-3a1b-ab12-430509bbc324",
                                                "text": "Any individual tree which masted in a generally non-mast year would be subjected to the exclusive attention of the seed predators and so would be selected against."
                                            },
                                            {
                                                "example_id": "3b89f5d9-1061-4b0a-a02e-775052ea3133",
                                                "sense_id": "b6bef215-9dae-3a1b-ab12-430509bbc324",
                                                "text": "However, if this were true, all or most masting species (e.g., Fagus and Quercus) in a forest would have to mast in synchrony to be effective against generalist herbivores."
                                            },
                                            {
                                                "example_id": "a84eb39a-20ca-4777-8cb2-b43c30f93119",
                                                "sense_id": "b6bef215-9dae-3a1b-ab12-430509bbc324",
                                                "text": "Because dipterocarp seeds are winged and spin gracefully as they fall, the dispersal of millions of dipterocarp seeds during a masting event is one of the greatest spectacles that you can see on planet Earth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02bb7bf2-6e55-329a-93d1-5325356f71fa",
                                        "entry_id": "f43686e8-e700-3736-ac0b-523c806db554",
                                        "glosses": [
