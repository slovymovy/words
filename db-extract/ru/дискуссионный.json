                "translations": [
                    {
                        "translation_id": "3082d397-ae03-4e26-ba8b-4383546f6f81",
                        "source_entry_id": "891a5f47-78c4-3600-b33e-0fee5cab4859",
                        "source_sense_description": "связанный, соотносящийся по значению с существительным дискуссия",
                        "target_lang_word": "discussion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discussion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d9dfd0-cffe-3eb1-84d5-312c3183f053",
                                        "entry_id": "1ee0fcf0-b879-39fe-b670-0d4e83b258da",
                                        "glosses": [
                                            "Conversation or debate concerning a particular topic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ba0a8e-320a-46af-a37b-55f843f7717d",
                                                "sense_id": "d8d9dfd0-cffe-3eb1-84d5-312c3183f053",
                                                "text": "There was then a long discussion of whether to capitalize words like \"east\"."
                                            },
                                            {
                                                "example_id": "80a1248a-4b35-4ac6-a020-50dd88fe3a56",
                                                "sense_id": "d8d9dfd0-cffe-3eb1-84d5-312c3183f053",
                                                "text": "This topic is not open to discussion."
                                            },
                                            {
                                                "example_id": "d03c1eef-e8dc-4fa6-a83c-3a008671a9b1",
                                                "sense_id": "d8d9dfd0-cffe-3eb1-84d5-312c3183f053",
                                                "text": "My discussion with the professor was very enlightening."
                                            },
                                            {
                                                "example_id": "c4092c2d-89dc-48df-8f57-52aa42c02cb1",
                                                "sense_id": "d8d9dfd0-cffe-3eb1-84d5-312c3183f053",
                                                "text": "In the May 12 memo, Meta said it had previously allowed open discussion of abortion at work but later recognized that it had led to “significant disruptions in the workplace given unique legal complexities and the number of people affected by the issue.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79c7ff19-5637-35fb-8ba7-ca81556135a2",
                                        "entry_id": "1ee0fcf0-b879-39fe-b670-0d4e83b258da",
                                        "glosses": [
                                            "Text giving further detail on a subject."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0529e69-9e87-4b5b-93ce-41a20a1128fd",
                                                "sense_id": "79c7ff19-5637-35fb-8ba7-ca81556135a2",
                                                "text": "Under each heading, you will find a discussion."
                                            },
                                            {
                                                "example_id": "12ad44d0-6d0c-4c38-ba27-be7b24e7bd45",
                                                "sense_id": "79c7ff19-5637-35fb-8ba7-ca81556135a2",
                                                "text": "The question of the plausibility of the counter-factual is seen as key in all three discussions of allohistorical fiction (as it is in Demandt's and Ferguson's examinations of allohistory) (cf. Rodiek 25–26; Ritter 15–16; Helbig 32)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1c5cdb5-5651-3c1d-b19e-e7d0687c8a5c",
                                        "entry_id": "1ee0fcf0-b879-39fe-b670-0d4e83b258da",
                                        "glosses": [
                                            "The dispersion of a tumour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edaba1f6-fbab-40a5-be5b-e711912b059f",
                        "source_entry_id": "891a5f47-78c4-3600-b33e-0fee5cab4859",
                        "source_sense_description": "вызывающий дискуссии; сомнительный, спорный",
                        "target_lang_word": "debatable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debatable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                        "entry_id": "6fe4b60d-3d64-3fbc-9062-4386a153408f",
                                        "glosses": [
                                            "Open to debate; not fully proved or confirmed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3cb4f4e-d14c-4863-8ac7-4d1c20b35fcc",
                                                "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                                "text": "Those data are debatable: no one has been able to replicate them."
                                            },
                                            {
                                                "example_id": "55a90c90-c3c1-4580-8487-77358fa56e44",
                                                "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                                "text": "It's debatable whether he is the best candidate for the position."
                                            },
                                            {
                                                "example_id": "2f9ffe52-af36-4cee-89a4-7e91603c6ff6",
                                                "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                                "text": "While the SCP universe is, of course, filled with things that we would certainly not consider \"real\", most of the SCPs are tangible or perceivable in some way. There are those concepts, however, whose reality is debatable, even to the SCP Foundation, begging them to ask the question of what, exactly, is real."
                                            },
                                            {
                                                "example_id": "2ccf50c0-6644-4697-923e-39dc77dbb597",
                                                "sense_id": "01502ba5-d476-39ef-b87a-e733cbc0d7de",
                                                "text": "There’s been a change in President Donald Trump. He used to say he had accomplished more than any other President, a debatable claim. But now he’s using messianic language about himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fab0324-195e-3a95-94a4-da6750d327a9",
                                        "entry_id": "6fe4b60d-3d64-3fbc-9062-4386a153408f",
                                        "glosses": [
                                            "Able to be debated; up for discussion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae419ff-8c72-4de9-8dd2-3e836b36a9cb",
                                                "sense_id": "0fab0324-195e-3a95-94a4-da6750d327a9",
                                                "text": "The lack of bonuses this year is not debatable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "debatable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f736af9-cd6e-31aa-8442-ac0252c211f3",
                                        "entry_id": "b9199e72-5f94-3ce2-85c6-afabd105506d",
                                        "glosses": [
                                            "A topic that is open to debate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da12cca0-b0d5-40db-8063-87a10a6b8621",
                                                "sense_id": "8f736af9-cd6e-31aa-8442-ac0252c211f3",
                                                "text": "Just how many glaucoma patients there are in the United States and just how prevalent is the disease are two unknowns or at least two debatables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb1e1995-7949-4b1f-a4df-6f13ec7221b4",
                        "source_entry_id": "891a5f47-78c4-3600-b33e-0fee5cab4859",
                        "source_sense_description": "вызывающий дискуссии; сомнительный, спорный",
                        "target_lang_word": "controversial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "controversial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02eaf502-ca58-3dc1-a5da-52be807d430b",
                                        "entry_id": "040b5abf-a75d-3c58-9484-5a72c4c0d44e",
                                        "glosses": [
                                            "Arousing or likely to arouse controversy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d2a2c7-e4cd-4fa1-bafa-9cf99ec99c51",
                                                "sense_id": "02eaf502-ca58-3dc1-a5da-52be807d430b",
                                                "text": "Whole libraries of controversial books."
                                            },
                                            {
                                                "example_id": "b7597b21-f9d1-415a-a1a2-8d5bd4593b87",
                                                "sense_id": "02eaf502-ca58-3dc1-a5da-52be807d430b",
                                                "text": "MAHER: Well, whatever. I just said we shouldn't have two national anthems. We're one country. It's not a good idea. We've seen what happens in other countries where you have, you know- when you separate things out. That's never where America was. That's never where liberalism was. It was about being a colorblind society. So, a new national anthem? Fine. I'll go for that. But not two. Because that leads down a road we don't wanna go. Applause.\nKIMMEL: Do you feel like...\nMAHER: Thank you.\nKIMMEL: Hey there's a lot of fear in the air and generally, you don't want to be caught applauding something that might be controversial.\nMAHER: I couldn't give a fuck.\nKIMMEL: I wasn't talking about you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80b65ae9-a5bd-36aa-8e61-ad30a1129633",
                                        "entry_id": "040b5abf-a75d-3c58-9484-5a72c4c0d44e",
                                        "glosses": [
                                            "Engaging in or given to controversy; disputatious, argumentative."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "controversial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ac36b56-40a2-39fc-ad5f-2136d250fa01",
                                        "entry_id": "25acbdb4-8013-3c9a-becf-7b0bc9405265",
                                        "glosses": [
                                            "Someone or something (such as a matter or an argument) that is controversial."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5efb685d-69cf-4120-8061-9618ec88be61",
                                                "sense_id": "3ac36b56-40a2-39fc-ad5f-2136d250fa01",
                                                "text": "No fundamental doctrine was omitted. Controversials were carefully avoided. Whether any blessing attended these attempts, will be known at the last day."
                                            },
                                            {
                                                "example_id": "bb1c5f70-e6d7-41bc-b33e-85ef81a24aaf",
                                                "sense_id": "3ac36b56-40a2-39fc-ad5f-2136d250fa01",
                                                "text": "Blowing like a blast of fresh astringent air into the hot-house atmosphere of these vapid languors, came news from America of a Rational Dress Campaign. Mrs. Amelia Bloomer’s conspicuous controversials were a wonderful gift to Punch, and were welcomed with enthusiasm and joyful derision by the cartoonists […]"
                                            },
                                            {
                                                "example_id": "b4835160-d42e-48a4-b137-fc57a8bf04d1",
                                                "sense_id": "3ac36b56-40a2-39fc-ad5f-2136d250fa01",
                                                "text": "Napoleon’s a pastry / Get this under your brow / All those big wig controversials / Are all commercials now."
                                            },
                                            {
                                                "example_id": "a9169e61-f174-4bc4-ad35-c727cb68d9f7",
                                                "sense_id": "3ac36b56-40a2-39fc-ad5f-2136d250fa01",
                                                "text": "Although the numbers of controversial children were few, their finely tuned distinction between types of transgression concurs with the observation that the behaviour of controversials is highly skilled. While the behaviour of controversial children may often meet with negative reactions from peers and reprimands from adults, controversials may engage in even more prosocial behaviour than do popular peers (Dodge, 1983)."
                                            },
                                            {
                                                "example_id": "6d7e16ed-8d81-4be0-b7e3-6004ce08d468",
                                                "sense_id": "3ac36b56-40a2-39fc-ad5f-2136d250fa01",
                                                "text": "It would be interesting to know whether the leadership capacities with which the controversials are credited is a mitigating factor with respect to their risk potential."
                                            },
                                            {
                                                "example_id": "236e3f41-9f4b-4ed9-b3e1-b0d8c730fd80",
                                                "sense_id": "3ac36b56-40a2-39fc-ad5f-2136d250fa01",
                                                "text": "One manager identified himself as a controversial, indicating both his formal role and confrontational style as reasons as to why he was both greatly liked and disliked. […] Lastly, a few managers suggested that controversials might have specific personality traits that make them liked by some and disliked by others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
