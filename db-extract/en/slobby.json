                            {
                                "example_id": "10e6de91-1a55-42cf-ac51-173468072892",
                                "sense_id": "81c7318c-bae1-363e-b893-79bcb9ece68e",
                                "text": "I've put on seven ugly, fat, sloppy, slobby pounds and I don't have anything I can wear. I'm beginning to look as slobby as I feel."
                            },
                            {
                                "example_id": "bc90ebd2-fe9d-467f-8e80-a3c9b3d70c2b",
                                "sense_id": "81c7318c-bae1-363e-b893-79bcb9ece68e",
                                "text": "He'd thought Joe Moreton a great slobby lump; and Joe had not been a great slobby lump. Joe Moreton at least was a man."
                            }
                        ]
                    },
                    {
                        "sense_id": "e65351a1-3f99-35fd-bebb-57f988d4805e",
                        "entry_id": "e7aa021e-4b13-36b4-8de6-8378bbeb0f7e",
