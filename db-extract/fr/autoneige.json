                        "entry_id": "c2be720f-b3bc-393e-aaa9-6704ddf05386",
                        "glosses": [
                            "Véhicule à cabine qui peut transporter plusieurs personnes dans des régions recouvertes de neige ou de glace sans nécessiter de route."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f672a4-2f7f-44da-8069-0d600cd8362a",
                                "sense_id": "15a42b17-cdce-3d34-a758-3e6f33e4b67d",
                                "text": "Térence louait une autoneige une fois par mois et venait passer le dimanche avec nous."
                            }
                        ]
                    }
                ],
