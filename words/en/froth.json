{
    "word_family": [
        "frother",
        "frothy",
        "frothily",
        "frothiness",
        "frothless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "287e210f-26f5-3ce0-90fa-4de9f92d83a0",
                    "sense_definition": "A mass of small bubbles formed on or in liquid; foam.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_foam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The barista poured the warm milk, leaving a layer of creamy <w>froth</w> on top.",
                            "target_lang_translations": {
                                "de": "Der Barista goss die warme Milch ein und hinterließ oben eine Schicht cremigen <w>Schaum</w>."
                            }
                        },
                        {
                            "text": "Strong ocean waves crashed against the jagged rocks, creating thick white <w>froth</w>.",
                            "target_lang_translations": {
                                "de": "Starke Meereswellen schlugen gegen die zerklüfteten Felsen und erzeugten dichte weiße <w>Gischt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "foam",
                        "lather",
                        "scum",
                        "suds"
                    ],
                    "common_phrases": [
                        "layer of froth",
                        "creamy froth",
                        "sea froth"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Masse kleiner Bläschen auf oder in einer Flüssigkeit; Schaum."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schaum",
                                "target_lang_sense_clarification": "auf Flüssigkeiten"
                            },
                            {
                                "target_lang_word": "Gischt",
                                "target_lang_sense_clarification": "Meeresschaum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19401db5-d57a-3c08-a1b5-b0aceafa4acf",
                    "sense_definition": "Content, conversation, or activity that is perceived as light, insubstantial, or of little value.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insubstantial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most entertainment news is sheer <w>froth</w> designed to distract the public from serious matters.",
                            "target_lang_translations": {
                                "de": "Die meisten Promi-Nachrichten sind reines <w>Geschwätz</w>, das darauf abzielt, die Öffentlichkeit von ernsten Themen abzulenken."
                            }
                        },
                        {
                            "text": "Behind the dramatic political rhetoric, there was little policy substance, only meaningless <w>froth</w>.",
                            "target_lang_translations": {
                                "de": "Hinter der dramatischen politischen Rhetorik steckte kaum inhaltliche Substanz, nur bedeutungsloser <w>Schall und Rauch</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drivel",
                        "fluff",
                        "trivia"
                    ],
                    "antonyms": [
                        "substance"
                    ],
                    "common_phrases": [
                        "showbiz froth",
                        "sheer froth"
                    ],
                    "target_lang_definitions": {
                        "de": "Inhalte, Gespräche oder Aktivitäten, die als belanglos, oberflächlich oder wertlos wahrgenommen werden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Geschwätz",
                                "target_lang_sense_clarification": "oberflächliches Gerede"
                            },
                            {
                                "target_lang_word": "Schall und Rauch",
                                "target_lang_sense_clarification": "Belangloses"
                            },
                            {
                                "target_lang_word": "Nebensächlichkeiten",
                                "target_lang_sense_clarification": "oberflächlicher Inhalt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9130b0fd-1b50-32fc-9ad8-108415cc54e3",
                    "sense_definition": "Excessive or unsustainable speculative activity in financial markets.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "financial_bubble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Central bankers warned that prolonged low interest rates were causing dangerous <w>froth</w> in housing prices.",
                            "target_lang_translations": {
                                "de": "Zentralbanker warnten davor, dass anhaltend niedrige Zinsen eine gefährliche <w>Überhitzung</w> der Immobilienpreise verursachen."
                            }
                        },
                        {
                            "text": "A sudden market correction quickly removed much of the speculative <w>froth</w> from technology stocks.",
                            "target_lang_translations": {
                                "de": "Eine plötzliche Marktkorrektur baute rasch einen Großteil der spekulativen <w>Blase</w> bei Technologieaktien ab."
                            }
                        }
                    ],
                    "synonyms": [
                        "bubble"
                    ],
                    "common_phrases": [
                        "market froth",
                        "speculative froth"
                    ],
                    "target_lang_definitions": {
                        "de": "Übermäßige oder unhaltbare Spekulationstätigkeit auf Finanzmärkten; Spekulationsblase."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Überhitzung",
                                "target_lang_sense_clarification": "am Markt"
                            },
                            {
                                "target_lang_word": "Spekulationsblase",
                                "target_lang_sense_clarification": "Finanzmarkt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd2877fe-9cf5-3eed-9407-a86d7b75a3ef",
                    "sense_definition": "The superficial and unproductive upper class of society.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insubstantial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The satirical novel poked cruel fun at the idle <w>froth</w> of high society.",
                            "target_lang_translations": {
                                "de": "Der satirische Roman machte sich erbarmungslos über die müßige <w>Schickeria</w> der feinen Gesellschaft lustig."
                            }
                        },
                        {
                            "text": "Working citizens resented paying taxes while the social <w>froth</w> squandered inherited fortunes.",
                            "target_lang_translations": {
                                "de": "Berufstätige Bürger ärgerten sich darüber, Steuern zu zahlen, während die oberflächliche <w>Oberschicht</w> geerbte Vermögen verprasste."
                            }
                        }
                    ],
                    "antonyms": [
                        "dregs"
                    ],
                    "common_phrases": [
                        "froth of society"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in social commentary referring to the idle wealthy."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die oberflächliche und unproduktive Oberschicht der Gesellschaft."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Schickeria",
                                "target_lang_sense_clarification": "oberflächliche Oberschicht"
                            },
                            {
                                "target_lang_word": "oberflächliche Elite",
                                "target_lang_sense_clarification": "müßiggängerische Gesellschaftsschicht"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8761a17a-04f2-344b-a7ad-81422cfdbb78",
                    "sense_definition": "To cause a liquid to produce a mass of bubbles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_foam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use the steam wand on the espresso machine to <w>froth</w> the milk properly.",
                            "target_lang_translations": {
                                "de": "Benutze die Dampflanze der Espressomaschine, um die Milch richtig <w>aufzuschäumen</w>."
                            }
                        },
                        {
                            "text": "She used a small whisk to gently <w>froth</w> the egg whites in the bowl.",
                            "target_lang_translations": {
                                "de": "Sie benutzte einen kleinen Schneebesen, um das Eiweiß in der Schüssel vorsichtig <w>schaumig zu schlagen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "foam",
                        "whip"
                    ],
                    "common_phrases": [
                        "froth milk"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Flüssigkeit dazu bringen, Schaum oder Bläschen zu bilden; verquirlen oder aufschäumen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufschäumen",
                                "target_lang_sense_clarification": "Milch oder Flüssigkeiten schaumig schlagen"
                            },
                            {
                                "target_lang_word": "schaumig schlagen",
                                "target_lang_sense_clarification": "z. B. Eiweiß"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9e4eceb-3c36-30a5-916f-cf73fbbe5db3",
                    "sense_definition": "Of a liquid, to produce or overflow with a mass of small bubbles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_foam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soapy water began to <w>froth</w> as the washing cycle started.",
                            "target_lang_translations": {
                                "de": "Das Seifenwasser begann zu <w>schäumen</w>, als der Waschgang startete."
                            }
                        },
                        {
                            "text": "Pour the carbonated beverage slowly or it will <w>froth</w> over the edge of the glass.",
                            "target_lang_translations": {
                                "de": "Gieße das kohlensäurehaltige Getränk langsam ein, sonst wird es über den Rand des Glases <w>überschäumen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bubble",
                        "foam",
                        "fizz"
                    ],
                    "common_phrases": [
                        "froth over"
                    ],
                    "target_lang_definitions": {
                        "de": "Von Flüssigkeiten: schäumen, Bläschen bilden oder überschäumen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schäumen",
                                "target_lang_sense_clarification": "Blasen bilden"
                            },
                            {
                                "target_lang_word": "überschäumen",
                                "target_lang_sense_clarification": "über den Rand laufen"
                            },
                            {
                                "target_lang_word": "aufschäumen",
                                "target_lang_sense_clarification": "sich nach oben bewegen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74ac8a19-7431-39b7-9c01-16e51d6bc1ef",
                    "sense_definition": "To spew saliva in excitement or madness; figuratively, to vent extreme rage or fury.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "venting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rabid dog began to <w>froth</w> at the mouth when the stranger approached.",
                            "target_lang_translations": {
                                "de": "Der tolle Hund begann <w>Schaum vor dem Mund</w> zu bekommen, als sich der Fremde näherte."
                            }
                        },
                        {
                            "text": "Pundits continued to <w>froth</w> with fury about the government's latest tax reform.",
                            "target_lang_translations": {
                                "de": "Kommentatoren <w>schäumten</w> weiterhin vor Wut über die jüngste Steuerreform der Regierung."
                            }
                        }
                    ],
                    "synonyms": [
                        "foam",
                        "fume",
                        "rage"
                    ],
                    "common_phrases": [
                        "froth at the mouth"
                    ],
                    "target_lang_definitions": {
                        "de": "Speichel vor Erregung oder Tollwut versprühen; übertragen: vor Wut kochen oder toben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schäumen",
                                "target_lang_sense_clarification": "vor Wut"
                            },
                            {
                                "target_lang_word": "Schaum vor dem Mund haben",
                                "target_lang_sense_clarification": "vor Wut oder Tollwut"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc1da19e-0c46-3d47-8c69-1c5198385576",
                    "sense_definition": "To eject, vent, or spit something out in a burst of foam or angry words.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "venting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a sudden fit of rage, the agitated orator <w>frothed</w> accusations against his rivals.",
                            "target_lang_translations": {
                                "de": "In einem plötzlichen Wutanfall <w>schleuderte</w> der aufgebrachte Redner Vorwürfe gegen seine Rivalen <w>hervor</w>."
                            }
                        },
                        {
                            "text": "He shook with anger as he <w>frothed</w> venomous insults into the microphone.",
                            "target_lang_translations": {
                                "de": "Er bebte vor Zorn, als er giftige Beleidigungen ins Mikrofon <w>spie</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "spew",
                        "vent"
                    ],
                    "common_phrases": [
                        "froth out"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in literary or dramatic contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas schäumend oder in einem Wutausbruch ausstoßen oder hervorbringen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "herausschleudern",
                                "target_lang_sense_clarification": "Worte zornig hervorstoßen"
                            },
                            {
                                "target_lang_word": "speien",
                                "target_lang_sense_clarification": "wütend hervorbringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e936076e-a6b6-30d9-a2f2-95cccdab7853",
                    "sense_definition": "To cover something with a layer of foam or foamy saliva.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "liquid_foam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a grueling race under the midday sun, sweat <w>frothed</w> the horse's flank.",
                            "target_lang_translations": {
                                "de": "Nach einem anstrengenden Rennen in der Mittagssonne <w>bedeckte</w> Schweiß die Flanken des Pferdes <w>mit Schaum</w>."
                            }
                        },
                        {
                            "text": "Churning breakers constantly crashed onto the beach and <w>frothed</w> the shoreline with foam.",
                            "target_lang_translations": {
                                "de": "Tosende Brandungswellen schlugen unaufhörlich auf den Strand und <w>überzogen</w> das Ufer mit Schaum."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas mit einer Schicht Schaum oder schaumigem Speichel bedecken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mit Schaum bedecken",
                                "target_lang_sense_clarification": "mit Schaum überziehen"
                            },
                            {
                                "target_lang_word": "einschäumen",
                                "target_lang_sense_clarification": "mit Schaum benetzen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}