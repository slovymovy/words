                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de slechte planning liep het project in de <w>soep</w>.",
                            "target_lang_translations": {
                                "en": "Due to poor planning, the project turned into a <w>mess</w>.",
                                "ru": "Из-за плохого планирования проект пошел <w>насмарку</w>.",
                                "pl": "Przez złe planowanie projekt <w>legł w gruzach</w>.",
                                "de": "Wegen der schlechten Planung ging das Projekt <w>schief</w>.",
                                "fr": "À cause d'une mauvaise planification, le projet est tombé à l'<w>eau</w>.",
                                "it": "A causa della cattiva pianificazione, il progetto è andato a <w>rotoli</w>.",
                                "cs": "Kvůli špatnému plánování projekt <w>ztroskotal</w>.",
                                "tr": "Kötü planlama yüzünden proje <w>suya düştü</w>.",
                                "es": "Debido a la mala planificación, el proyecto <w>fracasó</w>."
                            }
                        },
                        {
                            "text": "Wat een <w>soep</w> hebben ze van die administratie gemaakt.",
                            "target_lang_translations": {
                                "en": "What a <w>mess</w> they have made of that administration.",
                                "ru": "Какую <w>кашу</w> они устроили с этой администрацией.",
                                "pl": "Ale <w>bałagan</w> zrobili z tej administracji.",
                                "de": "Was für ein <w>Durcheinander</w> sie aus dieser Verwaltung gemacht haben.",
                                "fr": "Quel <w>gâchis</w> ils ont fait de cette administration.",
                                "it": "Che <w>pasticcio</w> hanno fatto con quell'amministrazione.",
                                "cs": "To je ale <w>zmatek</w>, co z té administrativy udělali.",
                                "tr": "O idari işleri tam bir <w>arapsaçına</w> çevirmişler.",
                                "es": "Qué <w>lío</w> han hecho con esa administración."
                            }
