                        ],
                        "form": "die Heimatstädte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "496a1e43-15f3-332d-852f-49f8552bfb88",
                        "entry_id": "1c77f6a5-511f-32d5-9812-b53e93834615",
                        "glosses": [
                            "die Stadt, in der man sich zuhause fühlt (oft die Stadt, in der man geboren und/oder aufgewachsen ist)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca32981d-9414-440d-939c-6bd22b6b2fef",
                                "sense_id": "496a1e43-15f3-332d-852f-49f8552bfb88",
                                "text": "„Grimmelshausen wurde, wie sein Held, früh von Vater und Mutter getrennt, wuchs auf beim Großvater, einem Bäcker und Weinhändler, und hat im Alter von wahrscheinlich zwölf Jahren erlebt, wie – im Jahr 1634 – seine Heimatstadt, das hessische Gelnhausen, von den katholischen Truppen des Kaisers geplündert und gebrandschatzt wurde.“"
                            },
                            {
                                "example_id": "c7024f62-2fa7-4ee9-aa83-b39a9a3535f7",
                                "sense_id": "496a1e43-15f3-332d-852f-49f8552bfb88",
                                "text": "„Ihre Heimatstadt wurde, da sie Kriegshafen war, besonders heftig und anhaltend bombardiert.“"
                            },
                            {
                                "example_id": "b7e687d4-001d-40a8-94b7-17cd263ded90",
                                "sense_id": "496a1e43-15f3-332d-852f-49f8552bfb88",
                                "text": "„Meine Heimatstadt Duisburg hat Geschichte geschrieben.“"
                            },
                            {
                                "example_id": "e07f7af8-97e0-4e5c-80bf-1d04e5361a8c",
                                "sense_id": "496a1e43-15f3-332d-852f-49f8552bfb88",
                                "text": "„Die sechs Überlebenden von Hirschs Heimatstadt trafen sich in der Achad-Ha'am-Straße.“"
                            },
                            {
                                "example_id": "034a38cc-212b-4303-bdca-ace046b1d27a",
                                "sense_id": "496a1e43-15f3-332d-852f-49f8552bfb88",
                                "text": "„Ich war in der Heimatstadt meines Vaters, wo ich keinen Menschen kannte; aber obwohl ich allein war, war ich doch sicher, daß ich nicht lange Zeit brauchen würde, um mich zurecht zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ce1a61b-cfe3-4e23-b768-2590f2ffec75",
                        "source_entry_id": "1c77f6a5-511f-32d5-9812-b53e93834615",
                        "source_sense_id": "496a1e43-15f3-332d-852f-49f8552bfb88",
                        "source_sense_description": "die Stadt, in der man sich zuhause fühlt (oft die Stadt, in der man geboren und/oder aufgewachsen ist)",
                        "target_lang_word": "home town",
