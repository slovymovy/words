                        "examples": [
                            {
                                "example_id": "ec30887a-d1ed-4798-b526-483c14dbbf72",
                                "sense_id": "cdb61080-766d-33ac-84c5-68202236a6c7",
                                "text": "Die genoemde strakheid kan echter ook tegen gaan werken. Als er een miniem scheurtje in het canvas zit, kan dat door de spanning op het doek binnen minuten leiden tot het aan flarden scheuren van de kostbare kap."
                            }
                        ]
                    },
                    {
                        "sense_id": "d20a7295-614c-3791-a608-235a007291cf",
                        "entry_id": "53b41080-5403-3628-afb8-b93c9b3fbfc4",
                        "glosses": [
                            "het glad zijn zonder tekening of oneffenheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0b6c5b1-66e1-4dfe-93e9-6a2cae58be7a",
                                "sense_id": "d20a7295-614c-3791-a608-235a007291cf",
                                "text": "Honigh schenkt mij de 'instap'-blanc in, een Côtes du Rhône Villages 2007 (€ 7,70), gemaakt van clairette en roussanne. Schoon, zuiver. De strakheid van de clairette."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf733028-ef9f-3efe-8f72-d444a5680cc8",
                        "entry_id": "53b41080-5403-3628-afb8-b93c9b3fbfc4",
                        "glosses": [
                            "het recht en onbuigzaam zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1eaebaf-0089-4ec9-9bfc-344f6731ed5e",
                                "sense_id": "cf733028-ef9f-3efe-8f72-d444a5680cc8",
                                "text": "De aandoening komt niet zonder gevaren. Zo is er kans op oververhitting omdat een persoon door de dikte van de huid niet kan zweten. Ook kunnen er oogproblemen optreden door de strakheid van de huid en haarverlies door schilfering van de hoofdhuid."
                            },
                            {
                                "example_id": "b553dec0-05af-4c38-b259-7a08b9570faa",
                                "sense_id": "cf733028-ef9f-3efe-8f72-d444a5680cc8",
                                "text": "„Nee, dat is niet de bedoeling. Nederland is een dichtbevolkt land en de overheid moet de ruimtelijke ordening in eigen hand houden. Maar het moet wel in elke gemeente mogelijk worden om naar eigen idee te bouwen. We willen een beetje ruimte van België combineren met de strakheid van Nederland.”"
                            }
                        ]
                    }
