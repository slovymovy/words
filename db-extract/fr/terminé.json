                                "target_senses": [
                                    {
                                        "sense_id": "8aaf5354-945b-3aa4-a187-4f993ea4deaa",
                                        "entry_id": "20887f83-56ec-3b22-b7ad-35e4f5926a76",
                                        "glosses": [
                                            "Having completed or finished an activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cc49a48-3f12-4261-8efb-1737346574bc",
                                                "sense_id": "8aaf5354-945b-3aa4-a187-4f993ea4deaa",
                                                "text": "He pushed his empty plate away, sighed and pronounced \"I am done.\""
                                            },
                                            {
                                                "example_id": "69bde27a-9927-4f50-b2a9-89bdc284067d",
                                                "sense_id": "8aaf5354-945b-3aa4-a187-4f993ea4deaa",
                                                "text": "They were done playing and were picking up the toys when he arrived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e67fe659-75d4-35f0-8bfe-bf2c08d25d65",
                                        "entry_id": "20887f83-56ec-3b22-b7ad-35e4f5926a76",
                                        "glosses": [
                                            "Completed or finished."
                                        ],
                                        "tags": [
                                            "of an activity or task"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e9e2fb3-0710-4a94-abf6-8ff052df483f",
                                                "sense_id": "e67fe659-75d4-35f0-8bfe-bf2c08d25d65",
                                                "text": "I'll text you when the movie's done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c5cd4aa-5a82-328f-89f0-1708b74ea265",
                                        "entry_id": "20887f83-56ec-3b22-b7ad-35e4f5926a76",
                                        "glosses": [
                                            "Ready, fully cooked."
                                        ],
                                        "tags": [
                                            "of food"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18914ed0-c371-4534-bde7-b402e05d37cd",
                                                "sense_id": "8c5cd4aa-5a82-328f-89f0-1708b74ea265",
                                                "text": "As soon as the potatoes are done we can sit down and eat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c50a3dad-bce4-3c10-b378-5ef7ff08db2c",
                                        "entry_id": "20887f83-56ec-3b22-b7ad-35e4f5926a76",
                                        "glosses": [
                                            "Being exhausted or fully spent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5e6eae-9f58-407b-8b48-7738c2f9b74e",
                                                "sense_id": "c50a3dad-bce4-3c10-b378-5ef7ff08db2c",
                                                "text": "When the water is done we will only be able to go on for a few days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab5ca58e-87b9-3a53-90dd-141bae277f8c",
                                        "entry_id": "20887f83-56ec-3b22-b7ad-35e4f5926a76",
                                        "glosses": [
                                            "Without hope or prospect of completion or success."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6630123-d438-4cc5-afba-adfaceb80646",
                                                "sense_id": "ab5ca58e-87b9-3a53-90dd-141bae277f8c",
                                                "text": "He is done, after three falls there is no chance he will be able to finish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f54c052-3d48-30de-b03c-b1e86990c817",
                                        "entry_id": "20887f83-56ec-3b22-b7ad-35e4f5926a76",
                                        "glosses": [
                                            "Fashionable, socially acceptable, tasteful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630c65e4-a72d-4a93-b6a6-e64132e892ce",
                                                "sense_id": "1f54c052-3d48-30de-b03c-b1e86990c817",
                                                "text": "I can't believe he just walked up and spoke to her like that, those kind of things just aren't done!"
                                            },
                                            {
                                                "example_id": "28174933-08c1-4623-98f9-2dadac9e4ebb",
                                                "sense_id": "1f54c052-3d48-30de-b03c-b1e86990c817",
                                                "text": "What is the done thing these days? I can't keep up!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad34017-5997-3afd-a367-d439e750c9e9",
                                        "entry_id": "20887f83-56ec-3b22-b7ad-35e4f5926a76",
                                        "glosses": [
                                            "Finished with (something)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philadelphia",
                                            "Scotland",
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c6975c-6a68-4ad8-9df5-78f290bf1559",
                                                "sense_id": "1ad34017-5997-3afd-a367-d439e750c9e9",
                                                "text": "I'm done my homework."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f4422e7-1fc7-300e-8fec-2c577f4621c8",
                                        "entry_id": "20887f83-56ec-3b22-b7ad-35e4f5926a76",
                                        "glosses": [
                                            "Punished."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5336f101-8e9b-4fc3-9c89-bed81f779ef7",
                                                "sense_id": "9f4422e7-1fc7-300e-8fec-2c577f4621c8",
                                                "text": "I can say what I like now because I am mental and I can't get done for it."
                                            },
                                            {
                                                "example_id": "9d4ca714-7e78-4f6e-88e5-14b0c54edb0c",
                                                "sense_id": "9f4422e7-1fc7-300e-8fec-2c577f4621c8",
                                                "text": "Normally, when you pass a law in New Zealand, you can't be done for it if you broke the law in the past."
                                            }
                                        ]
                                    }
                                ]
                            },
