    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "98b22e8c-4e6f-304c-a8e4-b20bebcdda29",
                    "sense_definition": "Previously owned or operated by another person; not new.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ownership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to buy a <w>used</w> car because it was much cheaper than a new one.",
                            "target_lang_translations": {
                                "ru": "Он решил купить <w>подержанный</w> автомобиль, потому что он был гораздо дешевле нового."
                            }
                        },
                        {
                            "text": "This shop sells <w>used</w> books that are still in very good condition.",
                            "target_lang_translations": {
                                "ru": "В этом магазине продаются <w>подержанные</w> книги, которые все еще находятся в очень хорошем состоянии."
                            }
                        }
                    ],
                    "synonyms": [
                        "pre-owned",
                        "second-hand"
                    ],
                    "antonyms": [
                        "new",
                        "unused"
                    ],
                    "common_phrases": [
                        "used car",
                        "used books",
                        "used clothing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ранее принадлежавший или использовавшийся другим человеком; не новый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подержанный",
                                "target_lang_sense_clarification": "о вещах, бывших в употреблении"
                            },
                            {
                                "target_lang_word": "б/у",
                                "target_lang_sense_clarification": "сокращение от бывший в употреблении"
                            },
                            {
                                "target_lang_word": "вторичный",
                                "target_lang_sense_clarification": "о рынке или товарах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9036b67-d5d2-3117-a456-22244557cd81",
                    "sense_definition": "Having already been utilized or consumed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "utilization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put all <w>used</w> towels in the laundry basket near the door.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положите все <w>использованные</w> полотенца в корзину для белья возле двери."
                            }
                        },
                        {
                            "text": "The ground was littered with <w>used</w> syringes left behind in the alley.",
                            "target_lang_translations": {
                                "ru": "Земля в переулке была завалена <w>использованными</w> шприцами."
                            }
                        }
                    ],
                    "antonyms": [
                        "unused"
                    ],
                    "common_phrases": [
                        "used towels",
                        "used matches",
                        "used tea bags"
                    ],
                    "target_lang_definitions": {
                        "ru": "Который уже был использован или израсходован."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использованный",
                                "target_lang_sense_clarification": "уже примененный по назначению"
                            },
                            {
                                "target_lang_word": "отработанный",
                                "target_lang_sense_clarification": "завершивший цикл использования"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a6aba756-12b1-3330-9171-302d160d1968",
                    "sense_definition": "Past tense and past participle of <w>use</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>used</w> a sharp knife to cut the vegetables for the soup.",
                            "target_lang_translations": {
                                "ru": "Я <w>использовал</w> острый нож, чтобы нарезать овощи для супа."
                            }
                        },
                        {
                            "text": "She felt that her friends only <w>used</w> her when they needed help with homework.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что друзья только <w>использовали</w> её, когда им нужна была помощь с домашним заданием."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола use (использовать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использовал",
                                "target_lang_sense_clarification": "прошедшее время"
                            },
                            {
                                "target_lang_word": "воспользовался",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ]
                    }
                }
            ]
        }
    ]
