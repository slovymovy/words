                "senses": [
                    {
                        "sense_id": "7b9c9c71-bf45-3ed2-99d2-ef060a24d162",
                        "entry_id": "2f2bad7b-8880-3abc-86c7-679946f3f1f3",
                        "glosses": [
                            "Qui se rapporte aux m’as-tu-vu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c15de17-bb30-4ac9-b893-da733913ca31",
                                "sense_id": "7b9c9c71-bf45-3ed2-99d2-ef060a24d162",
                                "text": "Je viens d’acheter d’occasion une Camaro, une voiture américaine. Elle est vert foncé, l’intérieur est en simili blanc, un peu m’as-tu-vu."
                            },
                            {
                                "example_id": "b99855a0-fbc1-44fd-8250-0a889e749a70",
                                "sense_id": "7b9c9c71-bf45-3ed2-99d2-ef060a24d162",
                                "text": "Mort était bruyant, teigneux et m’as-tu-vu. Flair, lui, était redoutable."
                            },
                            {
                                "example_id": "acfa01b2-be3c-4180-82f7-80313670044a",
                                "sense_id": "7b9c9c71-bf45-3ed2-99d2-ef060a24d162",
                                "text": "Epkeen croisa son reflet dans ses lunettes m’as-tu-vu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc91c6aa-f865-4726-98d0-834a0e37a191",
