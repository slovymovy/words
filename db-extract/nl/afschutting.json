                "senses": [
                    {
                        "sense_id": "79e9cafc-5fe2-3332-8899-15094f1c9211",
                        "entry_id": "70eccb67-4907-34af-a7fe-82b4a7ad61b7",
                        "glosses": [
                            "wand die men gebruikt om twee ruimtes van elkaar te scheiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0e10ba3-bb7f-49a8-9659-22d53bae3e5a",
                                "sense_id": "79e9cafc-5fe2-3332-8899-15094f1c9211",
                                "text": "Hij stond in de afdeling woninginrichting bij een tafel met vazen. Hij nam er een op, trad er mee achter een afschutting, waterde hem vol en zette hem op zijn plaats terug."
                            },
                            {
                                "example_id": "3a369e79-7fa6-49e9-8036-00f6eda008ed",
                                "sense_id": "79e9cafc-5fe2-3332-8899-15094f1c9211",
                                "text": "De jongeren zijn allemaal tussen 18 en 20 jaar oud en behoren tot een studentenclub uit Sint Katelijne-Waver, ze verbleven een weekend aan zee. Na een feestje richtten ze een groot aantal vernielingen aan op het strand en in de wijk. Verkeersborden, paaltjes en afschuttingen werden omvergeduwd en glazen belandden op de openbare weg. Ze pleegden ook een diefstal van drank."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff92c801-31da-472c-8684-ab4852ec8084",
                        "source_entry_id": "70eccb67-4907-34af-a7fe-82b4a7ad61b7",
                        "source_sense_id": "79e9cafc-5fe2-3332-8899-15094f1c9211",
                        "source_sense_description": "wand die men gebruikt om twee ruimtes van elkaar te scheiden",
                        "target_lang_word": "fence",
