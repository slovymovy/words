                        "examples": [
                            {
                                "example_id": "e295c660-77ff-4850-a9ad-72563e7059d3",
                                "sense_id": "def5da43-3583-302f-b711-0c14dfc9f60d",
                                "text": "In een vennootschap onder firma zijn de vennoten hoofdelijk aansprakelijk."
                            }
                        ]
                    },
                    {
                        "sense_id": "508af904-d60f-3b56-b532-92cbec813097",
                        "entry_id": "392e234c-ed11-337a-856e-62693389939b",
