                "senses": [
                    {
                        "sense_id": "12e3f2e0-9186-37df-adf2-ee48d0e9078e",
                        "entry_id": "260cdf8b-9631-3959-92a2-1531d7a60fce",
                        "glosses": [
                            "Rendre plus russe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ceced5-31d2-4cd6-851e-6d2cf8669050",
                                "sense_id": "12e3f2e0-9186-37df-adf2-ee48d0e9078e",
                                "text": "Au moyen des écoles, on chercha à russiser les populations finnoises et allemandes de la Baltique."
                            },
                            {
                                "example_id": "5ac6394b-6002-4f95-bd96-9675afcbfb3c",
                                "sense_id": "12e3f2e0-9186-37df-adf2-ee48d0e9078e",
                                "text": "On veut, coûte que coûte, russiser ces contrées."
                            },
                            {
                                "example_id": "cd49d1a3-2ca5-4057-b888-7090f64282b9",
                                "sense_id": "12e3f2e0-9186-37df-adf2-ee48d0e9078e",
                                "text": "Aujourd’hui encore, si les autochthones finnois continuent à se russiser, les cantons tatars, même convertis au christianisme, restent tatars."
                            }
                        ]
                    }
