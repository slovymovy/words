                    "sense_definition": "Lacking meaning or definition; making no sense.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The random letters on the screen were <w>meaningless</w> to me.",
                            "target_lang_translations": {
                                "ru": "Случайные буквы на экране были для меня <w>бессмысленными</w>.",
                                "es": "Las letras aleatorias en la pantalla no tenían <w>ningún sentido</w> para mí."
                            }
                        },
                        {
                            "text": "He mumbled a few <w>meaningless</w> words in his sleep.",
                            "target_lang_translations": {
                                "ru": "Он пробормотал во сне несколько <w>бессвязных</w> слов.",
                                "es": "Murmuró unas cuantas palabras <w>sin sentido</w> mientras dormía."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonsensical",
                        "senseless"
                    ],
                    "antonyms": [
                        "meaningful"
                    ],
                    "common_phrases": [
