    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44fabc09-c0f9-3292-a70c-cd924d885568",
                    "sense_definition": "Rester en vie après avoir échappé à un danger mortel ou à des conditions extrêmes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par miracle, tous les passagers ont <w>survécu</w> à ce terrible accident de la route."
                        },
                        {
                            "text": "Dans ces montagnes glaciales, les animaux doivent lutter pour <w>survivre</w> tout l'hiver."
                        }
                    ],
                    "synonyms": [
                        "réchapper"
                    ],
                    "common_phrases": [
                        "lutter pour survivre",
                        "survivre à un accident"
                    ]
                },
                {
                    "sense_id": "b1e5272b-4a5b-3379-b561-260bdbd167c5",
                    "sense_definition": "Demeurer en vie après le décès d'une autre personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme a <w>survécu</w> à son épouse pendant plus de dix ans."
                        },
                        {
                            "text": "Elle craignait de <w>survivre</w> à ses enfants et de rester seule au monde."
                        }
                    ],
                    "common_phrases": [
                        "survivre à son conjoint"
                    ]
                },
                {
                    "sense_id": "db1dc619-6f58-34b2-8d2e-1f7b593e4996",
                    "sense_definition": "Continuer d'exister malgré le passage du temps ou des circonstances défavorables.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne tradition a réussi à <w>survivre</w> jusqu'à notre époque moderne."
                        },
                        {
                            "text": "De nombreuses petites entreprises n'ont pas pu <w>survivre</w> face à cette concurrence mondiale."
                        }
                    ],
                    "common_phrases": [
                        "survivre à la crise",
                        "survivre à l'épreuve du temps"
                    ]
                }
            ]
        }
