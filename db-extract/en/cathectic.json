                        "glosses": [
                            "Of or pertaining to a connection that is charged with emotional energy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe371e5-62f0-4e8d-9697-1657db1e45ef",
                                "sense_id": "8283fd36-b780-3257-a5fd-2d1a93945084",
                                "text": "What we are dealing with here is more cathectic energy than the quota of affect as such, but the second is included in the first, as the following quotation shows:"
                            },
                            {
                                "example_id": "3a6d6b9c-76b8-466d-90a9-0cae298cc807",
                                "sense_id": "8283fd36-b780-3257-a5fd-2d1a93945084",
                                "text": "Viewing animals inside an enclosure bounded by barriers agitates many people simply because the perspective seems wrong. This remnant of modernism is perhaps the most cathectic concern and source of the sometimes intense criticism of zoos."
                            },
                            {
                                "example_id": "87b4185c-20ed-4ec1-9570-d2318690a13c",
                                "sense_id": "8283fd36-b780-3257-a5fd-2d1a93945084",
                                "text": "Nowhere is this contestation between purity, pleasure, and danger more clearly expressed than in gnotobiology's most cathectic public image: the boy in the bubble."
                            }
                        ]
                    }
                ],
