                        ],
                        "examples": [
                            {
                                "example_id": "627071a9-3516-4d33-9c53-340ae4d62b14",
                                "sense_id": "933eb6b7-505a-3ae2-8c38-37e7bb05c1cd",
                                "text": "A gleam of humour, a moment of beautiful pommy arrogance."
                            },
                            {
                                "example_id": "dcc05045-5a4d-44aa-b288-60fb0fcd537b",
                                "sense_id": "933eb6b7-505a-3ae2-8c38-37e7bb05c1cd",
                                "text": "That is, of course, until Australian movie stars like Cate Blanchett and Nicole Kidman proved that they could sell tickets in the West End so long as they could play at being what Rees calls a ‘movie siren’ with a convincing ‘fake pommy accent’."
                            },
                            {
                                "example_id": "0c753f23-7e95-4f89-9d1f-549d34ff29f9",
                                "sense_id": "933eb6b7-505a-3ae2-8c38-37e7bb05c1cd",
                                "text": "athol wrote:[…]> IIRC, \"hood lining\" is the more pommy terminology. :-)"
                            }
                        ]
                    }
