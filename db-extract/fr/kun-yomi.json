                        "glosses": [
                            "Prononciation d’un kanji (caractère chinois en japonais) par un mot natif japonais associé avec le même sens que le kanji."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aea4ff6-663f-452e-bad3-57d0c1850470",
                                "sense_id": "fa2e6c80-0f0c-307f-9cb6-93ccab06c930",
                                "text": "Le kanji 水 a deux prononciation totalement différentes : en on-yomi sui et en kun -yomi mizu, cette dernière étant un mot natif japonais associé à ce kanji par le même sens (« eau »)."
                            },
                            {
                                "example_id": "b91b49b7-c83a-4ed2-bb0e-f565c9b3e3d6",
                                "sense_id": "fa2e6c80-0f0c-307f-9cb6-93ccab06c930",
                                "text": "yomi 読み ou よみ : c’est à la fois le fait de lire et la façon dont se lisent les kanji (on-yomi : lecture on (sino-japonais), kun-yomi : lecture kun (indigène))."
                            }
                        ]
                    }
