                                        "entry_id": "ade2f8d5-a454-3bdd-a8e1-15d1e7e35f9a",
                                        "glosses": [
                                            "jemanden töten, indem man ihn mit Steinen bewirft"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
