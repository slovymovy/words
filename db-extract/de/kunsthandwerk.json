                "senses": [
                    {
                        "sense_id": "dbc94e1b-5bf1-3f4a-aa34-36120ffa3134",
                        "entry_id": "0658ef50-ef21-3184-814f-4852a149eab3",
                        "glosses": [
                            "ein Handwerk, für dessen Ausübung künstlerische Fähigkeiten erforderlich sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2622d38f-569b-4ade-bc9e-c164e640bf96",
                                "sense_id": "dbc94e1b-5bf1-3f4a-aa34-36120ffa3134",
                                "text": "Kunsthandwerk hat sich als Sammelbegriff für kunsthandwerkliche und kunstgewerbliche Produkte eingebürgert."
                            },
                            {
                                "example_id": "042b6fd6-f239-4180-ac15-04df6b546832",
                                "sense_id": "dbc94e1b-5bf1-3f4a-aa34-36120ffa3134",
                                "text": "Gold, Silber und Edelsteine beherrschten das Bild der damaligen Kunsthandwerke, wie sie kaum sonst in Europa in dieser Fülle und dieser Qualität zu finden sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
