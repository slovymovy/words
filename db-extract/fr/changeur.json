                                        "entry_id": "6b7e057d-dddc-3177-9fc8-c74c31b825d8",
                                        "glosses": [
                                            "A person who will exchange currency of one type for another for a fee or percentage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6dc66f-cb0b-4a97-bb98-7f35de035096",
                                                "sense_id": "abbdcfeb-57ed-3d9d-8998-de36a1ad4214",
                                                "text": "The money changer gave me rupees for my dollars."
                                            },
                                            {
                                                "example_id": "2ffc9a10-27a1-4c45-ab12-aaf60242fb8a",
                                                "sense_id": "abbdcfeb-57ed-3d9d-8998-de36a1ad4214",
                                                "text": "And Jesus went into the temple of God, and cast out all them that sold and bought in the temple, and overthrew the tables of the moneychangers, and the seats of them that sold doves, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f999d2-3cbe-3416-99a1-0c0368e3a29e",
                                        "entry_id": "6b7e057d-dddc-3177-9fc8-c74c31b825d8",
                                        "glosses": [
                                            "A portable device for dispensing change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a67963e-dbcd-4919-bb72-798f2fcaedfc",
                                                "sense_id": "e5f999d2-3cbe-3416-99a1-0c0368e3a29e",
                                                "text": "Women had replaced men on the streetcars as conductors and motormen, and the thought of sailing up and down the hills of San Francisco in a dark-blue uniform, with a money changer at my belt, caught my fancy."
                                            }
                                        ]
