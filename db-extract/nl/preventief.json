                                            {
                                                "example_id": "19db46ca-0616-4de8-b4c1-e79fb82cf121",
                                                "sense_id": "90014437-fe7c-31ab-97c1-74a63672b789",
                                                "text": "Dogs should be warmly but airily housed; heartily, but not heatingly, fed — old Indian meal, mixed with oatmeal, suppawn, is the best general food, with a small quantity of salt, which is a preventive against worms […]"
                                            }
