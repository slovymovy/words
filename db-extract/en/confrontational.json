                        "entry_id": "03f5166a-925c-36f4-b53d-a561080d99a2",
                        "glosses": [
                            "Pertaining to a confrontation; characterized by, or given to initiating hostile encounter; in-your-face."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "beb01981-24a0-45af-9db8-6e4fff8859ad",
                                "sense_id": "729e5008-8cb4-3404-8254-c7c955a4389d",
                                "text": "It was Liverpool who once again carried the momentum after the break and the recalled Rio Ferdinand was booked for a foul on Suarez, whose confrontational approach and brilliant natural ability was proving hard to handle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "986c85e1-ea08-43db-8ec9-6e5aa454b047",
                        "source_entry_id": "03f5166a-925c-36f4-b53d-a561080d99a2",
