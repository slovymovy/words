                "senses": [
                    {
                        "sense_id": "535529ba-2fa6-3613-bb2b-743850cb0f0e",
                        "entry_id": "7bb758b1-851f-344a-b15c-0fb1ca997010",
                        "glosses": [
                            "Möglichkeit/Zulassung zu einem Studium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b25ab94-943e-4eaa-bdcb-afb869eaae2c",
                                "sense_id": "535529ba-2fa6-3613-bb2b-743850cb0f0e",
                                "text": "„Sie kannte ein Menge Leute, die sich dadurch einen Studienplatz erschwindelt hatten, den sie gar nicht verdienten.“"
                            },
                            {
                                "example_id": "f0f2694c-06bc-4f7f-8a49-2cf8820931ed",
                                "sense_id": "535529ba-2fa6-3613-bb2b-743850cb0f0e",
                                "text": "„In Finnland ist es einfacher, einen Studienplatz für Medizin oder Jura zu bekommen, als einen für das Lehramt.“"
                            },
                            {
                                "example_id": "cf57559c-95fe-464a-9430-5948574f7280",
                                "sense_id": "535529ba-2fa6-3613-bb2b-743850cb0f0e",
                                "text": "„Wer als Chinese einen Studienplatz auf der Deutsch-Chinesischen Hochschule bekam, konnte auf einen lukrativen Job hoffen; im Handel, im Bergbau oder auch bei der Eisenbahn.“"
                            },
                            {
                                "example_id": "5d1b8e26-1382-41d6-8990-a5ee09140dd1",
                                "sense_id": "535529ba-2fa6-3613-bb2b-743850cb0f0e",
                                "text": "„Es fehlen ausreichend Studienplätze für Mediziner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
