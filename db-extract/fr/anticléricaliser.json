                "senses": [
                    {
                        "sense_id": "33936bd2-8be8-323b-94f7-b11d43c23b31",
                        "entry_id": "d1166750-eb3f-3b36-96a9-f6df99d18cee",
                        "glosses": [
                            "Donner un caractère anticlérical à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd97ac9-deee-4150-bf5a-202a1c28de71",
                                "sense_id": "33936bd2-8be8-323b-94f7-b11d43c23b31",
                                "text": "Ah s’ils pouvaient anticléricaliser l’Alsace, comme ils ont fait du reste de la France, comme tout s’arrangerait à leur gré."
                            },
                            {
                                "example_id": "fe4a8be5-12ad-4887-a7bd-7546f1c204f2",
                                "sense_id": "33936bd2-8be8-323b-94f7-b11d43c23b31",
                                "text": "Alors, les fiancés toulonnais se demanderont peut-être si quatre sous d’art valent la peine qu’on s’anticléricalise à grand spectacle."
                            }
                        ]
                    }
