                        "glosses": [
                            "Ne pas aller droit ; faire des zigzags."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "854aeb26-4716-4845-8483-aef801c1df2b",
                                "sense_id": "378a585b-ce85-30ee-8ba1-6b0557b9e242",
                                "text": "Pendant une seconde, des éclairs zig-zaguèrent devant mes yeux"
                            },
                            {
                                "example_id": "ce97aa47-9cba-4587-ad6a-61be6960f843",
                                "sense_id": "378a585b-ce85-30ee-8ba1-6b0557b9e242",
                                "text": "Pour cela il suffit de faire attention à zig-zaguer à bonne distance, et quand ce n'est pas possible parfois c'est case par case qu'il faut jongler."
                            }
                        ]
