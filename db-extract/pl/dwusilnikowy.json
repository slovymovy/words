                        "source_sense_id": "1776dd80-3fca-35b7-af43-326ccf704f96",
                        "target_lang_word": "bimoteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bimoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "943dc365-4c84-326c-be23-4b7ffe0143f3",
                                        "entry_id": "3459a96a-c43b-3bef-8546-e9ed4e968766",
                                        "glosses": [
                                            "Qui comporte deux moteurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27a025f7-bfde-4c12-84fb-2248e89bc2f3",
                                                "sense_id": "943dc365-4c84-326c-be23-4b7ffe0143f3",
                                                "text": "Le musée des Arts et Métiers conserve la version bimoteur du premier engin volant construit par le Français Clément Ader."
                                            },
                                            {
                                                "example_id": "085003f5-c6bf-41b6-995b-12fce3b44b30",
                                                "sense_id": "943dc365-4c84-326c-be23-4b7ffe0143f3",
                                                "text": "La RATP souhaitait étudier différentes possibilités et fournisseurs. Tout particulièrement, elle compara le bogie monomoteur type Duwag et le bogie bimoteur ANF."
                                            },
                                            {
                                                "example_id": "caf093ef-bb20-4510-b8a1-46d1a82cc3dd",
                                                "sense_id": "943dc365-4c84-326c-be23-4b7ffe0143f3",
                                                "text": "L'E-Fan est un avion électrique bimoteur dont le développement par Airbus Group Innovations a débuté en 2011."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bimoteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9afcee67-85e6-3504-ba58-cfd9b6c50335",
                                        "entry_id": "e7a6281f-cfa6-39ff-b647-886bdad6afd6",
                                        "glosses": [
                                            "Véhicule qui comporte deux moteurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "618bcfcf-f2c6-39aa-b7fd-4fd0fab6824b",
                                        "entry_id": "e7a6281f-cfa6-39ff-b647-886bdad6afd6",
                                        "glosses": [
                                            "Avion propulsé par deux moteurs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3afe113-aa27-4daf-a4dd-445511d7a1e1",
                                                "sense_id": "618bcfcf-f2c6-39aa-b7fd-4fd0fab6824b",
                                                "text": "Cependant ce petit bimoteur qui a formé la plupart des pilotes de bombardiers britanniques a joué un rôle obscur mais important dans l’histoire de la Seconde Guerre Mondiale."
                                            },
                                            {
                                                "example_id": "c5eadb56-87d0-40af-a8c4-0d45a88f1588",
                                                "sense_id": "618bcfcf-f2c6-39aa-b7fd-4fd0fab6824b",
                                                "text": "Ce jour-là, un bimoteur Dewoitine prend son envol depuis la base aérienne de Chartres."
                                            },
                                            {
                                                "example_id": "7c56ebe2-aa83-45bb-a06c-772ef89f126c",
                                                "sense_id": "618bcfcf-f2c6-39aa-b7fd-4fd0fab6824b",
                                                "text": "Il y a exactement 100 ans, John Alcock et Arthur Whitten Brown s’affairent autour de leur bimoteur Vickers Vimy dans un champ près de Saint-Jean de Terre-Neuve, au Canada, avec le secret espoir de réussir le pari qu’ils se sont fixé : réaliser la première traversée transatlantique sans escale en avion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
