                "senses": [
                    {
                        "sense_id": "19497f14-0a14-307c-813f-d8a60ccc36ad",
                        "entry_id": "4f544c74-e705-3bbe-8c1a-21db0bc007b1",
                        "glosses": [
                            "to interrupt, to break"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "203fff73-05d1-454d-b0bf-52700e0a3734",
                                "sense_id": "19497f14-0a14-307c-813f-d8a60ccc36ad",
                                "text": "Не перебива́й!",
                                "translation": "Don't interrupt!",
                                "english": "Don't interrupt!"
                            },
                            {
                                "example_id": "9d9ad613-048b-4a93-9322-a15c94b0effd",
                                "sense_id": "19497f14-0a14-307c-813f-d8a60ccc36ad",
                                "text": "Он сно́ва меня́ переби́л.",
                                "translation": "He interrupted me again.",
                                "english": "He interrupted me again."
                            }
                        ]
                    },
                    {
