                                                "sense_id": "61f3c3b0-eedf-364a-b448-77c5cdad445d",
                                                "text": "Haven't seen John for years. Someone said he had fucked off to Australia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34b19aa6-1d5c-3a6d-90ad-7b7c10cf325d",
