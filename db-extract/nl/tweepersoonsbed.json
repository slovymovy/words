                    {
                        "sense_id": "d55fbca0-0a25-3dc8-84f7-242c42eb80a5",
                        "entry_id": "5b8fa758-0e63-3103-b519-a3d7dba31f42",
                        "glosses": [
                            "bed voor twee personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04936155-798e-4058-87c0-365ac6fe4055",
                                "sense_id": "d55fbca0-0a25-3dc8-84f7-242c42eb80a5",
                                "text": "Al slaap je al je hele leven in een tweepersoonsbed, als je naar het verpleeghuis gaat moet je naar een eenpersoons."
                            },
                            {
                                "example_id": "28ed20e8-d8df-42b9-b078-756da5b1ddeb",
                                "sense_id": "d55fbca0-0a25-3dc8-84f7-242c42eb80a5",
                                "text": "Ze hadden een groot Frans tweepersoonsbed, lagen urenlang naast elkaar met allebei een hand op haar buik en voelden hoe ik daarbinnen trapte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ac33098-132d-4a1f-8563-3dd1f4a2c315",
                        "source_entry_id": "5b8fa758-0e63-3103-b519-a3d7dba31f42",
                        "source_sense_id": "d55fbca0-0a25-3dc8-84f7-242c42eb80a5",
                        "target_lang_word": "Doppelbett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doppelbett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2d2eba-300f-39f3-9a6a-ef6490e879e8",
                                        "entry_id": "a5d17cfc-9048-31dd-9f3f-cb1eccd5dea3",
                                        "glosses": [
                                            "Bett, in dem zwei Personen Platz haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f64015e9-4f7d-4878-8a7c-8947c4eff79c",
                                                "sense_id": "0a2d2eba-300f-39f3-9a6a-ef6490e879e8",
                                                "text": "Ein französisches Doppelbett hat eine durchgehende Matratze."
                                            },
                                            {
                                                "example_id": "b1eba338-0c22-405f-a9cd-63e49f21089e",
                                                "sense_id": "0a2d2eba-300f-39f3-9a6a-ef6490e879e8",
                                                "text": "„Ich ziehe mich bis aufs Unterhemd aus und lege mich in die Mitte des Doppelbettes.“"
                                            },
                                            {
                                                "example_id": "2001e4f4-2cfd-48ce-b85a-b416d1b451f7",
                                                "sense_id": "0a2d2eba-300f-39f3-9a6a-ef6490e879e8",
                                                "text": "„Sie ging vor dem Fußende des Doppelbettes auf und ab und schlug beim Gestikulieren mit der Zigarette jedesmal so präzis in die Luft, daß die kleinen Rauchwölkchen wie Punkte wirkten.“"
                                            },
                                            {
                                                "example_id": "0b81e219-a881-48f7-8f90-81c071acd265",
                                                "sense_id": "0a2d2eba-300f-39f3-9a6a-ef6490e879e8",
                                                "text": "„Im Schlafzimmer meiner Eltern wurde das Doppelbett von der Herbstsonne beschienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f44de0f4-3459-4b27-b981-88c7b789ca1a",
                        "source_entry_id": "5b8fa758-0e63-3103-b519-a3d7dba31f42",
                        "source_sense_id": "d55fbca0-0a25-3dc8-84f7-242c42eb80a5",
                        "target_lang_word": "double bed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "double bed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd2294eb-d33f-31cf-8d48-cdc76a6d5d36",
                                        "entry_id": "9ce1bbe3-c087-3583-bf3f-f83b037b9a53",
                                        "glosses": [
                                            "A bed designed for two adults, typically measuring 54 by 75 inches (1.35 by 1.9 meters)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86f6e139-066e-4eb8-b6c5-0d83e0f13364",
                                                "sense_id": "bd2294eb-d33f-31cf-8d48-cdc76a6d5d36",
                                                "text": "‘If you sleep on the floor, I’ll sleep on the floor too. But it seems rather a waste of a fine double bed.[’]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3046a445-bdb9-4340-afbb-d74c6518fa19",
                        "source_entry_id": "5b8fa758-0e63-3103-b519-a3d7dba31f42",
                        "source_sense_id": "d55fbca0-0a25-3dc8-84f7-242c42eb80a5",
                        "target_lang_word": "lits jumeaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lits jumeaux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f745d3e0-e350-3911-b315-876cfd215221",
                                        "entry_id": "3a2dc681-4918-3896-9c0c-16e3a5d3d428",
                                        "glosses": [
                                            "Ensemble de deux lits d’une personne de tailles identiques, placés dans la même chambre et pouvant être disposés côte à côte ou séparés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e775ea45-1164-47d4-ae61-828683ed36c5",
                                                "sense_id": "f745d3e0-e350-3911-b315-876cfd215221",
                                                "text": "Une nuit, Adeline, réveillée par un bruit étrange, ne trouva plus Hector dans le lit qu’il occupait auprès du sien, car ils couchaient dans des lits jumeaux, ainsi qu’il convient à des vieillards."
                                            },
                                            {
                                                "example_id": "bfcd2249-30a6-452a-823c-5da591057c54",
                                                "sense_id": "f745d3e0-e350-3911-b315-876cfd215221",
                                                "text": "En apparence les lits jumeaux semblaient prêcher davantage le repos. En fait leur puritanisme cachait une impureté. « Pour dormir vous vous isolerez de votre partenaire. Vous ne le rejoindrez que pour accomplir l’acte de chair. » Ils supprimaient l’intimité, la rêverie, la chaleur des corps qui deviennent des âmes."
                                            },
                                            {
                                                "example_id": "41b2db80-cd4d-461a-ac97-5f3eea08dbd6",
                                                "sense_id": "f745d3e0-e350-3911-b315-876cfd215221",
                                                "text": "Ils se couchèrent dans leurs lits jumeaux sans plus échanger un mot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
