                ],
                "senses": [
                    {
                        "sense_id": "f1270379-8659-3c6e-9e5c-322900fadcc3",
                        "entry_id": "5db10fb7-072c-3deb-b67f-7c2c82d02b79",
                        "glosses": [
                            "aus Freundschaftlichkeit erstellte Bescheinigung über erbrachte Leistungen, die nicht den wahren Leistungen entsprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0868fad2-12c3-4d7d-a778-a3cf653af2a8",
                                "sense_id": "f1270379-8659-3c6e-9e5c-322900fadcc3",
                                "text": "„Wenn die Klägerin solch eine Note fordere, müsse sie im Streitfall aber auch darlegen und beweisen, dass ihre Leistungen gut oder sehr gut waren. Einen Anspruch auf ein Gefälligkeitszeugnis habe sie nicht, da ein Zeugnis laut Gesetz inhaltlich ‚wahr‘ sein muss.“"
                            },
                            {
                                "example_id": "bd09c65c-ac5e-4912-91d6-01c83de1dbfc",
                                "sense_id": "f1270379-8659-3c6e-9e5c-322900fadcc3",
                                "text": "„Ein vor Lob überschäumendes Einser-Zeugnis ist keinesfalls eine Garantie für optimale Erfolgschancen bei einer Neubewerbung – jedenfalls nicht, wenn sich die Lobeselogen allzu auffällig als Teil eines Gefälligkeitszeugnisses entpuppen.“"
                            },
                            {
                                "example_id": "e3dadfd6-a5be-406a-8c4c-7e92621dcc02",
                                "sense_id": "f1270379-8659-3c6e-9e5c-322900fadcc3",
                                "text": "„Der Präsident des Bundesverbandes der Personalmanager (BPM) – einer berufsständischen Vereinigung von Personalprofis – ist auch überzeugt, dass es eine große Zahl von Gefälligkeitszeugnissen gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
