                        "target_lang_word": "adénopathie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adénopathie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f745bd1-8404-386e-b0a7-35e0c2be229a",
                                        "entry_id": "d1a41975-fc16-37e4-842c-4d8cb2106f7f",
                                        "glosses": [
                                            "État pathologique d’un ganglion lymphatique dont l’inflammation peut avoir plusieurs origines étiologiques."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60ad616-e7d2-40da-9b30-8028deee5a46",
                                                "sense_id": "0f745bd1-8404-386e-b0a7-35e0c2be229a",
                                                "text": "En pratique, la recherche directe du tréponème pâle se fera essentiellement au niveau du chancre, des adénopathies, des plaques muqueuses et des syphilides cutanées."
                                            },
                                            {
                                                "example_id": "35960958-eee4-4490-a68b-241bf35e2245",
                                                "sense_id": "0f745bd1-8404-386e-b0a7-35e0c2be229a",
                                                "text": "Des anomalies majeures radiologiques (atélectasie, épanchement pleural, pneumonie et/ou adénopathies) sont peu probables en l'absence de tout signe respiratoire (sensibilité de 80 %)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
