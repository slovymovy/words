                ],
                "senses": [
                    {
                        "sense_id": "3e8d17e2-558d-306b-a7fd-ae86d3ad3335",
                        "entry_id": "0c215951-6cd3-3630-a238-afbea67f2699",
                        "glosses": [
                            "een hek of andere afrastering die een bepaald gebied afsluit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35b9a008-ed26-4b05-887e-da4b6eed8153",
                                "sense_id": "3e8d17e2-558d-306b-a7fd-ae86d3ad3335",
                                "text": "Er werd onder meer een afspanning voorzien van minstens twee meter hoog met daarop een draad van 50 centimeter in een terugslag naar binnen. Er werd ook een draad in de grond voorzien zodat de hond zich niet kan uitgraven."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b4c6191-d60d-3c24-aaa2-2d5a9f4df0cc",
                        "entry_id": "0c215951-6cd3-3630-a238-afbea67f2699",
                        "glosses": [
                            "verankering met behulp van touwen en kabels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b037afcf-18d4-4ac5-b8fa-edbd93f9bdfc",
                                "sense_id": "4b4c6191-d60d-3c24-aaa2-2d5a9f4df0cc",
                                "text": "Op het toneel monteert Gengis van Gool, Zwitser met een Nederlandse opa, zijn Rad des Doods. Een act met risico. In de afspanningen zit teveel speling naar zijn zin. „Ich glaube, es wird gefährlich hier”, zegt de twintigjarige luchtacrobaat wiens tante in de allereerste Cascade aan de trapeze hing. Ik maan hem geen dolle dingen te doen."
                            }
                        ]
                    },
                    {
                        "sense_id": "86e7c58a-afe4-3bde-b8fa-0e28eedff5be",
                        "entry_id": "0c215951-6cd3-3630-a238-afbea67f2699",
                        "glosses": [
                            "gelegenheid waar trekpaarden rust krijgen en bevrijd worden van hun leidsels en waar de koetsier en passagiers iets kunnen gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2cad3e6-05ff-4a62-8ad1-99b961f60de3",
                                "sense_id": "86e7c58a-afe4-3bde-b8fa-0e28eedff5be",
                                "text": "Meer dan een halve eeuw later krijgt de frêle waardin van café De Afspanning rode wangen bij het horen van de naam van de gerenommeerde schilder."
                            }
                        ]
                    }
                ],
