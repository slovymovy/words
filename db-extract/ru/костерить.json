                            {
                                "example_id": "3706da63-440d-4f8f-9a39-6a6399b64b1b",
                                "sense_id": "35b877d6-2623-3f24-9b30-964cec6962af",
                                "text": "Затопает ногами, за волосы себя схватит и давай костерить на чём свет стоит…"
                            },
