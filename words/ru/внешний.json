{
    "word_family": [
        "внешность",
        "внешне"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cbb55218-0fee-3ad7-a05e-76b7b5c4cd7c",
                    "sense_definition": "Относящийся к внешнему виду, к тому, как кто-то или что-то выглядит; видимый глазу.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его <w>внешний</w> вид всегда был безупречен и опрятен.",
                            "target_lang_translations": {
                                "en": "His <w>outward</w> appearance was always impeccable and neat.",
                                "de": "Sein <w>äußeres</w> Erscheinungsbild war immer tadellos und gepflegt."
                            }
                        },
                        {
                            "text": "Не стоит судить о человеке только по <w>внешним</w> признакам.",
                            "target_lang_translations": {
                                "en": "One should not judge a person only by <w>external</w> signs.",
                                "de": "Man sollte einen Menschen nicht nur nach <w>äußerlichen</w> Merkmalen beurteilen."
                            }
                        }
                    ],
                    "antonyms": [
                        "внутренний"
                    ],
                    "common_phrases": [
                        "внешний вид",
                        "внешнее сходство",
                        "внешний облик"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to the look or visible aspect of someone or something.",
                        "de": "Auf das Aussehen oder das sichtbare Erscheinungsbild bezogen; mit den Augen wahrnehmbar."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outward",
                                "target_lang_sense_clarification": "visible to the eye"
                            },
                            {
                                "target_lang_word": "external",
                                "target_lang_sense_clarification": "relating to the outside aspect"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "äußerlich",
                                "target_lang_sense_clarification": "das Erscheinungsbild betreffend"
                            },
                            {
                                "target_lang_word": "äußerer",
                                "target_lang_sense_clarification": "von außen sichtbar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f0336c9-6e60-3ac9-8b2b-43ec6634d051",
                    "sense_definition": "Находящийся снаружи, расположенный на поверхности или за пределами чего-либо.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили покрасить <w>внешние</w> стены нашего дома в белый цвет.",
                            "target_lang_translations": {
                                "en": "We decided to paint the <w>exterior</w> walls of our house white.",
                                "de": "Wir haben beschlossen, die <w>Außenwände</w> unseres Hauses weiß zu streichen."
                            }
                        },
                        {
                            "text": "Жёсткая <w>внешняя</w> оболочка надёжно защищает плод.",
                            "target_lang_translations": {
                                "en": "A hard <w>outer</w> shell reliably protects the fruit.",
                                "de": "Eine harte <w>äußere</w> Hülle schützt die Frucht zuverlässig."
                            }
                        }
                    ],
                    "synonyms": [
                        "наружный"
                    ],
                    "antonyms": [
                        "внутренний"
                    ],
                    "common_phrases": [
                        "внешний мир",
                        "внешняя среда",
                        "внешняя сторона"
                    ],
                    "target_lang_definitions": {
                        "en": "Located on the outside or surface; situated beyond the limits of something.",
                        "de": "Außen oder an der Oberfläche befindlich; außerhalb der Grenzen von etwas gelegen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "outer",
                                "target_lang_sense_clarification": "located on the outside"
                            },
                            {
                                "target_lang_word": "external",
                                "target_lang_sense_clarification": "situated outside"
                            },
                            {
                                "target_lang_word": "exterior",
                                "target_lang_sense_clarification": "relating to the outer surface"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "äußerer",
                                "target_lang_sense_clarification": "außen befindlich"
                            },
                            {
                                "target_lang_word": "Außen-",
                                "target_lang_sense_clarification": "als Vorsilbe für an der Außenseite befindlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6878068e-f8cc-357c-8f5e-7629493b7219",
                    "sense_definition": "Связанный с отношениями с другими странами; международный.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "political",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Министр подробно рассказал о приоритетах <w>внешней</w> политики государства.",
                            "target_lang_translations": {
                                "en": "The minister spoke in detail about the priorities of the state's <w>foreign</w> policy.",
                                "de": "Der Minister erläuterte ausführlich die Prioritäten der <w>Außenpolitik</w> des Staates."
                            }
                        },
                        {
                            "text": "<w>Внешняя</w> торговля играет ключевую роль в экономике страны.",
                            "target_lang_translations": {
                                "en": "<w>Foreign</w> trade plays a key role in the country's economy.",
                                "de": "Der <w>Außenhandel</w> spielt eine Schlüsselrolle in der Wirtschaft des Landes."
                            }
                        }
                    ],
                    "antonyms": [
                        "внутренний"
                    ],
                    "common_phrases": [
                        "внешняя политика",
                        "внешняя торговля",
                        "внешний долг"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to relations with other countries; international.",
                        "de": "Auf die Beziehungen zu anderen Staaten bezogen; international."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "foreign",
                                "target_lang_sense_clarification": "relating to other countries"
                            },
                            {
                                "target_lang_word": "external",
                                "target_lang_sense_clarification": "involving other nations"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Außen-",
                                "target_lang_sense_clarification": "im Bezug auf auswärtige Angelegenheiten"
                            },
                            {
                                "target_lang_word": "außenpolitisch",
                                "target_lang_sense_clarification": "die Außenpolitik betreffend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab756cee-8961-3084-b4e8-c8e35d47bc9a",
                    "sense_definition": "Не затрагивающий сути, существующий только для вида; формальный.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_superficial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За <w>внешним</w> спокойствием он скрывал сильное волнение.",
                            "target_lang_translations": {
                                "en": "Behind an <w>outward</w> calm, he hid strong agitation.",
                                "de": "Hinter einer <w>äußerlichen</w> Ruhe verbarg er eine starke Aufregung."
                            }
                        },
                        {
                            "text": "Это был лишь <w>внешний</w> блеск, за которым не было содержания.",
                            "target_lang_translations": {
                                "en": "It was merely <w>superficial</w> glitter, behind which there was no substance.",
                                "de": "Das war nur <w>äußerer</w> Glanz, hinter dem kein Inhalt steckte."
                            }
                        }
                    ],
                    "synonyms": [
                        "поверхностный"
                    ],
                    "antonyms": [
                        "глубинный",
                        "внутренний"
                    ],
                    "common_phrases": [
                        "внешний эффект",
                        "внешний лоск"
                    ],
                    "target_lang_definitions": {
                        "en": "Existing only on the surface; not touching the essence or substance.",
                        "de": "Nur die Oberfläche berührend, nur zum Schein bestehend; oberflächlich oder formal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "superficial",
                                "target_lang_sense_clarification": "lacking depth or substance"
                            },
                            {
                                "target_lang_word": "outward",
                                "target_lang_sense_clarification": "apparent rather than real"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "äußerlich",
                                "target_lang_sense_clarification": "nur scheinbar, vordergründig"
                            },
                            {
                                "target_lang_word": "oberflächlich",
                                "target_lang_sense_clarification": "nicht in die Tiefe gehend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}