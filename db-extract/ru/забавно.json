                    {
                        "translation_id": "1160cb53-21d7-47ef-977c-fa115e634c1d",
                        "source_entry_id": "9f23d66d-7c3f-35ea-b50b-e1c16ca1f94c",
                        "source_sense_description": "наречие к прил. забавный",
                        "target_lang_word": "con gracia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "56377e08-4bab-46ac-a164-67ed44e03247",
                        "source_entry_id": "9f23d66d-7c3f-35ea-b50b-e1c16ca1f94c",
                        "source_sense_description": "наречие к прил. забавный",
                        "target_lang_word": "plaisamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plaisamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfda05ff-1c79-3a88-a41a-fe4a5c90d0f6",
                                        "entry_id": "f983c053-a999-389d-b2b4-3af1fe26a16d",
                                        "glosses": [
                                            "D’une manière plaisante, agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "989a0bf8-1b91-4038-b87f-0739523eb1e5",
                                                "sense_id": "dfda05ff-1c79-3a88-a41a-fe4a5c90d0f6",
                                                "text": "Mme de Coulanges conte fort plaisamment cette scène,"
                                            },
                                            {
                                                "example_id": "7a708641-25cb-462c-808a-a6b42e13fde0",
                                                "sense_id": "dfda05ff-1c79-3a88-a41a-fe4a5c90d0f6",
                                                "text": "Que ne venait-elle après moi ; et je l’aurais dit avant elle, a dit plaisamment un poëte en parlant de l’antiquité,"
                                            },
                                            {
                                                "example_id": "3382308e-54b8-43fb-b41c-9fcebc8ccd2a",
                                                "sense_id": "dfda05ff-1c79-3a88-a41a-fe4a5c90d0f6",
                                                "text": "1886 : Jules Verne est victime d’un attentat mystérieux sur lequel la presse fait vite le silence. Un de ses neveux, atteint de « dérangement cérébral », lui tire, à bout portant, deux coups de revolver qui l’atteignent au pied et feront de lui, pour le reste de ses jours, un infirme. « Me voilà condamné à une boiterie dont je me console en pensant à Mlle de La Vallière, à Talleyrand, à Lord Byron… », écrit-il plaisamment, mais il est plus atteint encore au moral qu’au physique et se mure dans une solitude dont les prévenances de son entourage ne peuvent le distraire. Il renonce à ses voyages et vend son yacht au prince de Monténégro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "657ffb9a-4300-3985-971a-ca0b9524cdec",
                                        "entry_id": "f983c053-a999-389d-b2b4-3af1fe26a16d",
                                        "glosses": [
                                            "D’une manière qui fait rire, ridicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72451b74-963e-4c04-8150-003991f4d493",
                                                "sense_id": "657ffb9a-4300-3985-971a-ca0b9524cdec",
                                                "text": "Il y a des cœurs plaisamment bâtis en ce monde,"
                                            },
                                            {
                                                "example_id": "64dc1305-2820-4f0f-9db5-73d99149336e",
                                                "sense_id": "657ffb9a-4300-3985-971a-ca0b9524cdec",
                                                "text": "Nous avons fait le voyage tout doucement et plaisamment, sans ennui d’aucune sorte, chacun à notre coin, regardant la diversité des feuillages frais à brouter, et nous disant de petites bêtises à risoter tout doux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6506d5c-aa50-4f74-8295-65a1e68fb7e3",
                        "source_entry_id": "9f23d66d-7c3f-35ea-b50b-e1c16ca1f94c",
                        "source_sense_description": "наречие к прил. забавный",
                        "target_lang_word": "drôlement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drôlement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cd93610-c0ca-38b4-aca7-7b49e2a03c9c",
                                        "entry_id": "e7f7f503-29a8-3fca-89ce-a97556b03203",
                                        "glosses": [
                                            "D’une manière drôle."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "046d77f9-38f5-451f-a0c0-03f9041172d3",
                                                "sense_id": "4cd93610-c0ca-38b4-aca7-7b49e2a03c9c",
                                                "text": "M. Paul, que cette malice cousue de fil blanc laissait insensible, sourit, hocha la tête, plissa drôlement son petit œil et répondit : […]."
                                            },
                                            {
                                                "example_id": "7c016450-77ec-4542-b0eb-3769730be1df",
                                                "sense_id": "4cd93610-c0ca-38b4-aca7-7b49e2a03c9c",
                                                "text": "Il s'est drôlement tiré d’affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e102b0-aca8-31af-92b1-fab50b029c46",
                                        "entry_id": "e7f7f503-29a8-3fca-89ce-a97556b03203",
                                        "glosses": [
                                            "Dans les réponses pour indiquer que c’est tout le contraire."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac5e6ef2-9df6-4b1b-8f56-813a89936451",
                                                "sense_id": "e8e102b0-aca8-31af-92b1-fab50b029c46",
                                                "text": "Vous avez reçu votre argent ? - Oui, drôlement ; je n’ai eu que des sottises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca806903-d3b0-3a55-bcd3-e3b9d8292165",
                                        "entry_id": "e7f7f503-29a8-3fca-89ce-a97556b03203",
                                        "glosses": [
                                            "Très, énormément."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7dcab9a-8b88-48f6-af94-8abe5389a7b4",
                                                "sense_id": "ca806903-d3b0-3a55-bcd3-e3b9d8292165",
                                                "text": "Elle tordit les lèvres en une moue inquiète.\n— Mais tu es drôlement maigrichonne, dis-moi ! Regarde-toi... Tu n’as plus que la peau sur les os !\n— C'est à l'hôpital que j'ai perdu du poids, admit Michelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e3805b3-770b-3600-842b-460afa676594",
                                        "entry_id": "e7f7f503-29a8-3fca-89ce-a97556b03203",
                                        "glosses": [
                                            "Beaucoup, très."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "573c16c6-378b-409b-9184-43029fc01e20",
                                                "sense_id": "0e3805b3-770b-3600-842b-460afa676594",
                                                "text": "Il a drôlement plu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
