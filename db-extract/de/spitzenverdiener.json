                ],
                "senses": [
                    {
                        "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                        "entry_id": "0083c55f-37cc-3a70-b3de-521bb5b3c5a2",
                        "glosses": [
                            "(männliche^☆) Person, die ein weit überdurchschnittliches Einkommen erzielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81ffc44-49a5-4dd1-b751-55c818317668",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Die Finanzierung des Wohlfahrtsstaats erfolgt zumeist über hohe Steuern und Abgaben – insbesondere bei Spitzenverdienern.“"
                            },
                            {
                                "example_id": "78b5858a-b681-4627-aa9a-9bdb2f3c0e38",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "[…] „Diese Spitzenverdiener des oberen einen Prozents »haben zusammen mehr vorsteuerliches Einkommen als die 120 Millionen ärmsten Menschen« in den USA.“"
                            },
                            {
                                "example_id": "68fa4fb4-29f1-4493-ae5c-3aa0cb2e1391",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Jetzt wird es gefährlich: Erneut geht eine Debatte los, ob Firmen und Spitzenverdiener bei der Steuer entlastet werden sollen.“"
                            },
                            {
                                "example_id": "189ae6d0-ee07-4f5a-bee0-b2eaeef9f3e6",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Spitzenverdiener müssen den Solidaritätszuschlag vorerst weiter zahlen.“"
                            },
                            {
                                "example_id": "b07bdcf1-cc44-4ede-9feb-d67e04983458",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Bundesweit an der Spitze liegt Bergisch Gladbach in Nordrhein-Westfalen: Dort zahlen Spitzenverdiener mehr als 1.200 Euro für einen Kita-Platz.“"
                            },
                            {
                                "example_id": "0130c43b-a2c9-4266-a692-94ad0c23893f",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Frankreichs höchstes Gericht hat die umstrittene 75-Prozent-Steuer für Spitzenverdiener gekippt.“"
                            },
                            {
                                "example_id": "be8ff0a9-a5bf-4609-b2e4-534d1290e20d",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Weniger Steuern für Spitzenverdiener heißt stärkere Belastung auch für andere Menschen, vor allem für Menschen mit geringem Einkommen. – Marcel Fratzscher, Leiter DIW“"
                            },
                            {
                                "example_id": "c84ec0b0-b17d-45c8-8c8a-2841ffa7fceb",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "[Vor allem die Steuersenkungen von Donald Trump] „von 2017 war für den Staat teuer und kostete zwischen 1,5 und zwei Billionen Dollar. Ein riesiges Geschenk für Spitzenverdiener und Großkonzerne - nicht für das Volk.“"
                            },
                            {
                                "example_id": "25204338-4e71-4bfc-8e7d-286da7bbd996",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„In vielen Kantonen müssen Menschen mit bescheidenem Einkommen mehr Steuern zahlen als noch vor zehn Jahren. Spitzenverdiener jedoch werden fast überall steuerlich entlastet.“"
                            },
                            {
                                "example_id": "9ddf4455-4a79-4b2c-ab6d-186827e4ea7d",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Zwischen den Schweizer Haushalten liegen beim Einkommen Welten: 2014 stand einem alleinstehenden Spitzenverdiener unter 65 viermal mehr Geld zur Verfügung als einer alleinstehenden Person der untersten Einkommensklasse.“"
                            },
                            {
                                "example_id": "dfa5fe97-4a93-4c51-969b-842ba3f64e47",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Niedergelassene Strahlentherapeuten gehören zu den Spitzenverdienern unter den Fachärzten.“"
                            },
                            {
                                "example_id": "5e760814-a2d1-4e7a-9e71-0842aa791da0",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Spitzenverdiener war der Vorstandschef der Hamburger Hafen- und Logistik AG (HHLA), Klaus-Dieter Peters, mit 950 000 Euro im Jahr 2014.“"
                            },
                            {
                                "example_id": "c59da338-aea5-4b47-acc8-1adfd3b1734b",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Der Dieselskandal kostete den VW-Konzern mehr als 30 Milliarden Euro, den Spitzenverdiener Stadler indes nur ein paar Millionen.“"
                            },
                            {
                                "example_id": "23b07ad3-020f-4556-9dbf-28aeec1db42d",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Experten taxieren das Jahres-Durchschnittsgehalt von Bundesligaprofis mittlerweile auf zwischen 1,5 und zwei Millionen Euro. Spitzenverdiener beim Rekordmeister FC Bayern sollen gar auf rund 20 Millionen Euro kommen.“"
                            },
                            {
                                "example_id": "4ae2eab2-2ff7-4a1d-8ded-c44f463d3e1a",
                                "sense_id": "f708de5a-a1f6-3277-a4cf-2778a0938c9c",
                                "text": "„Carroll Haak: Insgesamt 300.000 Menschen arbeiten als Musiker, bildende oder darstellende Künstler. Doch Spitzenverdiener sind nur sehr wenige dabei. Nettostundenlöhne von 5 Euro sind dagegen keine Seltenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
