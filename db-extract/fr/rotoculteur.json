                    {
                        "sense_id": "919ef760-3c66-3360-bc96-c95475443812",
                        "entry_id": "aeafc46e-5bd6-3866-9b6b-de9b1d55addd",
                        "glosses": [
                            "Engin agricole motorisé, généralement de faible puissance, dirigé par un homme à pied qui est utilisé pour le travail de la terre. A la différence de la motobineuse, le rotoculteur possède des roues tout terrain facilitant le déplacement de l'appareil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f418d48b-06a4-48f5-a161-d9ed95125c46",
                                "sense_id": "919ef760-3c66-3360-bc96-c95475443812",
                                "text": "Les rotoculteurs et motobêches sont les outils parfaits pour retourner la terre avant de planter, d’aérer le sol une fois la croissance des plantes amorcée."
                            },
                            {
                                "example_id": "7cd4ff64-1560-49e9-90bf-356467c4d78e",
                                "sense_id": "919ef760-3c66-3360-bc96-c95475443812",
                                "text": "Le cochon sauvage ressemble à bien des égards à un rotoculteur ambulant."
                            }
                        ]
                    }
                ],
