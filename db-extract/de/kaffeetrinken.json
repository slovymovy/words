                            "accusative",
                            "singular"
                        ],
                        "form": "das Kaffeetrinken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0c06e50-cca1-3a70-ba34-e85d150280b2",
                        "entry_id": "41e1f586-bf42-3e30-b691-b3b0f3a2c3e0",
                        "glosses": [
                            "in der Regel eine gemütliche Runde, die ursprünglich bei einer Tasse Kaffee zusammen sitzt und (belanglose) Gespräche führt. Es ist aber auch ein Synonym für die „gemütliche“ Runde bei warmen Getränken (Kaffee, Tee, warmer Schokolade oder Kakao) und Kuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d31b49a-8462-4741-801e-d1738e9cceab",
                                "sense_id": "b0c06e50-cca1-3a70-ba34-e85d150280b2",
                                "text": "Das Kaffeetrinken findet anlässlich des Geburtstags statt."
                            },
                            {
                                "example_id": "6e65e606-59bd-4062-9baf-c26d1365956a",
                                "sense_id": "b0c06e50-cca1-3a70-ba34-e85d150280b2",
                                "text": "Zum Jubiläum wurden viele Gäste zum Kaffeetrinken eingeladen."
                            },
                            {
                                "example_id": "ef435ff0-50c7-493f-be04-362f0b26afec",
                                "sense_id": "b0c06e50-cca1-3a70-ba34-e85d150280b2",
                                "text": "„Neben dem Spülstein stapelt sich das benutzte Geschirr vom Kaffeetrinken und Abendessen.“"
                            },
                            {
                                "example_id": "c064c705-8bc6-4e78-8d0d-9a8c4b19508b",
                                "sense_id": "b0c06e50-cca1-3a70-ba34-e85d150280b2",
                                "text": "„Am anderen Ufer waren viele Häuser zum Kaffeetrinken, ich ging ein wenig an all diesen Häusern vorbei, dann aber ging ich zur Fähre zurück und setzte mich ans Ufer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "873a0d41-b5c1-3c5e-a5dc-2b7163e05854",
                        "entry_id": "41e1f586-bf42-3e30-b691-b3b0f3a2c3e0",
                        "glosses": [
                            "Trinken (die Aufnahme) von Kaffee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8096d55-3d74-402f-adc3-d5e5866f02ef",
                                "sense_id": "873a0d41-b5c1-3c5e-a5dc-2b7163e05854",
                                "text": "Weil der Kaffee so heiß war, verbrannte er sich die Zunge beim Kaffeetrinken."
                            },
                            {
                                "example_id": "227b1506-ddd0-45fd-a762-f71e791b284f",
                                "sense_id": "873a0d41-b5c1-3c5e-a5dc-2b7163e05854",
                                "text": "„Soweit sie wusste, bewegten sie sich nur die Hälfte der Zeit, die andere Hälfte verbrachten sie mit Kaffeetrinken und Kuchenessen.“"
                            },
                            {
                                "example_id": "264fee50-9dcc-471d-b7d0-7db6c3dcc29b",
                                "sense_id": "873a0d41-b5c1-3c5e-a5dc-2b7163e05854",
                                "text": "„Obwohl er Tee lieber mochte, hatte er sich ans Kaffeetrinken gewöhnt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
