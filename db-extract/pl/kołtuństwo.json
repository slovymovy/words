                        "sense_id": "98b1c966-8606-3874-9d0f-bd01743794e6",
                        "entry_id": "2c48acc4-5b4b-32d4-ad69-0a019b6f4a81",
                        "glosses": [
                            "zbiorowość ludzi zacofanych, ciemnych i nietolerancyjnych"
                        ],
                        "tags": [
                            "literary",
                            "scornfully"
                        ],
                        "examples": [
                            {
