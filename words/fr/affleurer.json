    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b9e211f-d699-35f5-80bf-86a38e19e19c",
                    "sense_definition": "Apparaître à la surface du sol ou de l'eau, être au ras d'un niveau donné.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À marée basse, de dangereux récifs rocheux <w>affleurent</w> tout près des côtes."
                        },
                        {
                            "text": "Un bloc de calcaire gris <w>affleure</w> au milieu du sentier forestier."
                        }
                    ],
                    "synonyms": [
                        "émerger"
                    ],
                    "antonyms": [
                        "s'enfoncer",
                        "plonger"
                    ],
                    "common_phrases": [
                        "affleurer le sol",
                        "affleurer la surface"
                    ]
                },
                {
                    "sense_id": "583abce0-8971-3311-9856-353778898346",
                    "sense_definition": "Se manifester discrètement, devenir perceptible en restant presque invisible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une pointe de tristesse <w>affleurait</w> dans sa voix malgré ses sourires forcés."
                        },
                        {
                            "text": "De vieilles rancœurs <w>affleurent</w> souvent au cours de cette longue réunion familiale."
                        }
                    ],
                    "synonyms": [
                        "poindre",
                        "transparaître"
                    ],
                    "antonyms": [
                        "disparaître"
                    ],
                    "common_phrases": [
                        "laisser affleurer"
                    ]
                },
                {
                    "sense_id": "3864d556-42a5-3273-a78e-f3fea4f74645",
                    "sense_definition": "Mettre de niveau deux surfaces contiguës de façon qu'aucune ne dépasse l'autre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier a raboté la planche pour bien <w>affleurer</w> les panneaux du meuble."
                        },
                        {
                            "text": "Il faut soigneusement <w>affleurer</w> les deux dalles afin d'éviter tout décalage."
                        }
                    ],
                    "synonyms": [
                        "égaliser",
                        "niveler"
                    ],
                    "common_phrases": [
                        "affleurer les bords"
                    ]
                }
            ]
        }
    ]
