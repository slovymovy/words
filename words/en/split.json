                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a ferry from <w>Split</w> to visit the nearby islands.",
                            "target_lang_translations": {
                                "ru": "Мы сели на паром из <w>Сплита</w>, чтобы посетить близлежащие острова.",
                                "zh": "我们从<w>斯普利特</w>乘渡轮去参观附近的岛屿。"
