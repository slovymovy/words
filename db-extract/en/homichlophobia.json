                        "glosses": [
                            "The fear of fog."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "709dcacd-5da8-488b-93d6-6fce0e974445",
                                "sense_id": "0a7d93c2-d997-3183-859b-46fdf2d05b4d",
                                "text": "[…] as dense as the fog surrounding the house, outside through the window, sucking the crepuscular light up into the spooky mist, homichlophobia augmenting the turmoil."
                            },
                            {
                                "example_id": "a3ef3bc5-1c2a-4bdb-ab4f-0c1c9ecc7756",
                                "sense_id": "0a7d93c2-d997-3183-859b-46fdf2d05b4d",
                                "text": "Thick fog rolled in and swallowed Abby whole. Unable to see her outstretched hand, she clenched her jaw to stop her teeth from chattering. Homichlophobia — the fear of fog."
                            },
                            {
                                "example_id": "3be63e8b-9ee6-4cc9-b37f-2e5d50f72f1a",
                                "sense_id": "0a7d93c2-d997-3183-859b-46fdf2d05b4d",
                                "text": "“Necrophobia—fear of death and dead bodies. There's, like, hundreds of different phobias you could have. Know what homichlophobia is?”\nSousa shook his head. “No freakin' idea.”\n“Fear of fog,” the slender EMT said. […]"
                            },
                            {
                                "example_id": "cc87c9d7-82cc-4c9c-ad25-f682e64f5a08",
                                "sense_id": "0a7d93c2-d997-3183-859b-46fdf2d05b4d",
                                "text": "I responded, ... “I never knew Burl had to fear fog, or anything else for that matter.”\n“Homichlophobia,” she spat[.]"
                            }
                        ]
                    }
