                                                "example_id": "5635471b-cd88-4619-b9c3-0e56c6cbfdd6",
                                                "sense_id": "bf3b3de1-234c-33ab-b1e8-cf5e928edc88",
                                                "text": "„Auf gerader Strecke stehen die Leitpfosten in einem Abstand von 50 Metern.“"
                                            },
                                            {
                                                "example_id": "8da03d17-81f8-4361-a751-6fd03886c83a",
                                                "sense_id": "bf3b3de1-234c-33ab-b1e8-cf5e928edc88",
                                                "text": "„Sie ändern die Abstände zwischen Wörtern und Buchstaben, indem Sie die Funktionen von InDesign für das Kerning und die Laufweite anwenden.“"
                                            },
                                            {
                                                "example_id": "0f170e44-5cbc-4ecd-9bae-810b7e434111",
                                                "sense_id": "bf3b3de1-234c-33ab-b1e8-cf5e928edc88",
                                                "text": "„Fliegen Gleitschirme in unterschiedlichen Höhen, müssen die Abstände so gewählt sein, dass der Höhenverlust beim Einklappen oder Sackflug des oberen Schirms nicht zur Kollision mit dem unteren führt.“"
                                            },
                                            {
                                                "example_id": "6d660c7a-049b-4440-a28c-90e151e7467f",
                                                "sense_id": "bf3b3de1-234c-33ab-b1e8-cf5e928edc88",
                                                "text": "„Alex Honnold, geboren 1985 in Sacramento, ist der derzeit mit Abstand beste Freikletterer der Welt.“"
                                            },
                                            {
                                                "example_id": "47413f32-6c08-4c9c-ae14-c91941083288",
                                                "sense_id": "bf3b3de1-234c-33ab-b1e8-cf5e928edc88",
                                                "text": "übertragen: „An der Ostküste sind die Beschränkungen für die Exilanten kaum bemerkbar, und er hofft dort Abstand und Ruhe zu gewinnen.“"
                                            }
                                        ],
