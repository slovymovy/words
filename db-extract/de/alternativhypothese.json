                "senses": [
                    {
                        "sense_id": "40bd1497-c80b-3e41-97d6-4594a1dd47c5",
                        "entry_id": "05fe4491-2020-3cab-b970-c707ee06a88d",
                        "glosses": [
                            "Annahme (Hypothese) in der Forschung, die es zu beweisen gilt (solange das nicht gelingt, gilt die Nullhypothese)"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "70d516ab-3195-4204-a022-2be6f5ee86e6",
                                "sense_id": "40bd1497-c80b-3e41-97d6-4594a1dd47c5",
                                "text": "„Dies bedeutet, dass sich das gefundene Stichprobenergebnis nicht gut mit der Annahme vereinbaren lässt, dass in der Population die Nullhypothese gilt. Man lehnt deshalb die Nullhypothese ab und akzeptiert die Alternativhypothese.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5d289354-2cee-3314-97e4-06b1f25021a9",
                        "entry_id": "05fe4491-2020-3cab-b970-c707ee06a88d",
                        "glosses": [
                            "Erklärungsversuch, der als Alternative für eine bestehende Vermutung dient"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "9a2e1141-8ef3-4c41-a6af-092b7944b48b",
                                "sense_id": "5d289354-2cee-3314-97e4-06b1f25021a9",
                                "text": "„Eine Alternativhypothese stellt die Verteidigung nicht zur Debatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
