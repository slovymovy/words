                ],
                "senses": [
                    {
                        "sense_id": "90d3087f-721e-32c4-8dcb-f94fe5a23de2",
                        "entry_id": "a5eac316-b47f-3a0b-b835-2f8306c5ee7c",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "335a4b42-6632-41fa-94d1-b5955f1a0274",
                                "sense_id": "90d3087f-721e-32c4-8dcb-f94fe5a23de2",
                                "text": "Frau Frey ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "df70b08f-dc15-4ea0-9f48-48f8ecd8f94a",
                                "sense_id": "90d3087f-721e-32c4-8dcb-f94fe5a23de2",
                                "text": "Herr Frey wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "6c009dd3-bae4-4de1-b2b5-bf4de3a8c552",
                                "sense_id": "90d3087f-721e-32c4-8dcb-f94fe5a23de2",
                                "text": "Die Freys fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "68f5c8e6-48c9-47c6-a16d-081fd30eca31",
                                "sense_id": "90d3087f-721e-32c4-8dcb-f94fe5a23de2",
                                "text": "Der Frey trägt nie die Schals, die die Frey ihm strickt."
                            },
                            {
                                "example_id": "71cdc293-10ba-436c-9493-7ee49e35f108",
                                "sense_id": "90d3087f-721e-32c4-8dcb-f94fe5a23de2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Frey kommt, geht der Herr Frey.“"
                            },
                            {
                                "example_id": "191836c4-c3a0-4897-bf08-8edd7884ae63",
                                "sense_id": "90d3087f-721e-32c4-8dcb-f94fe5a23de2",
                                "text": "Frey kommt und geht."
                            },
                            {
                                "example_id": "2c61ddfc-a646-4fda-aa0f-8ff83c2b092b",
                                "sense_id": "90d3087f-721e-32c4-8dcb-f94fe5a23de2",
                                "text": "Freys kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
