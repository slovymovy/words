                        "glosses": [
                            "Électron ordinaire, de charge électrique négative."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "682da082-5679-41c0-b2d4-94f225d0b2e2",
                                "sense_id": "1b4b7f7c-b17a-3e45-af19-380b17563afc",
                                "text": "[…] ce qui suggère une symétrie complète entre l'électron positif ou positon et l'électron négatif ou négaton, qui auraient ainsi mêmes masses avec des charges égales et contraires."
                            },
                            {
                                "example_id": "296123ea-9060-46b4-9795-7881613058df",
                                "sense_id": "1b4b7f7c-b17a-3e45-af19-380b17563afc",
                                "text": "Ces grains d'électricité négative furent baptisés électrons ; nous les appelons aujourd'hui négatons pour les distinguer des électrons positifs, qui ont été découverts depuis."
                            }
                        ]
                    }
