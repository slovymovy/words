                ],
                "senses": [
                    {
                        "sense_id": "e2bdbe4a-9fba-3aad-8f9d-e874d659bd93",
                        "entry_id": "397c7fc3-add5-3d97-a611-d5f6a1988292",
                        "glosses": [
                            "ou Grincer des dents, plisser les lèvres en montrant les dents, grimacer."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3863d357-611a-44b3-847d-114a2e880cd8",
                                "sense_id": "e2bdbe4a-9fba-3aad-8f9d-e874d659bd93",
                                "text": "L’essentiel est de montrer les dents\n— C’est vrai ça ! Un chien qui grigne, on en a peur.\n— Eh bien ! nous grignerons, nous grignerons, mon brave !"
                            },
                            {
                                "example_id": "a9214d56-9666-4aff-a514-b5da3881cb17",
                                "sense_id": "e2bdbe4a-9fba-3aad-8f9d-e874d659bd93",
                                "text": "Il avait l'air […] d’un enfant qu’on a empêché de faire une sottise, une saleté, et qui grigne, à la fois furieux et penaud."
                            }
                        ]
                    },
                    {
                        "sense_id": "875b7d40-60f8-3a33-bd91-a068018eff39",
                        "entry_id": "397c7fc3-add5-3d97-a611-d5f6a1988292",
                        "glosses": [
                            "Plisser de façon anormale, faire des faux plis (en parlant de tissu), goder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e984482-f6d2-42bd-a88c-24cc7f0d7bec",
                                "sense_id": "875b7d40-60f8-3a33-bd91-a068018eff39",
                                "text": "MADAME D’HERBLAY : Vous voyez, ce corsage me va très mal, il plisse. Vous voyez bien que ça grigne.\n AUBIN : Ah, pour grigner, ça grigne."
                            },
                            {
                                "example_id": "6d16730e-5fd3-4bbc-b87e-162de40e8012",
                                "sense_id": "875b7d40-60f8-3a33-bd91-a068018eff39",
                                "text": "Étoffe qui grigne."
                            },
                            {
                                "example_id": "a171b28a-9ea0-4d46-b80c-5f552521b557",
                                "sense_id": "875b7d40-60f8-3a33-bd91-a068018eff39",
                                "text": "Le fil doit être tenu lâche pour que les points ne fassent pas grigner le tissu de fond."
                            }
                        ]
                    },
                    {
                        "sense_id": "205e7368-9b97-3964-baf6-44c0f3f52ce2",
                        "entry_id": "397c7fc3-add5-3d97-a611-d5f6a1988292",
                        "glosses": [
                            "Scarifier ou fendre le pain avant cuisson, traditionnellement afin de signer son pain pour le reconnaître dans le four commun, et pour laisser une partie des gaz s’échapper."
                        ],
                        "tags": [],
                        "examples": []
                    }
