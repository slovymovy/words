                            {
                                "example_id": "92c8e10f-c354-4014-bfb3-f8858f8688fc",
                                "sense_id": "2b09be02-22b5-3bff-9988-af6cf2d28159",
                                "text": "What a result, should this piebald, entangled, hypermetaphorical style of writing, not to say of thinking, become general among our literary men! as it might so easily do."
                            },
                            {
                                "example_id": "8132a804-880d-41a3-9f84-174e12f1dfbd",
                                "sense_id": "2b09be02-22b5-3bff-9988-af6cf2d28159",
                                "text": "For writing not only comes out of the zoo but (to be hypermetaphorical) goes back in again."
                            },
                            {
                                "example_id": "b3f854ae-a771-4ab8-8a0d-4005afddce4e",
                                "sense_id": "2b09be02-22b5-3bff-9988-af6cf2d28159",
                                "text": "The prose language in particular is hypermetaphorical, offering a number of processes and stages of metaphorisation […]"
                            }
                        ]
