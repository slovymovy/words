                            "accusative",
                            "plural"
                        ],
                        "form": "die Irrlichter"
                    },
                    {
                        "form_id": "65147450-b1ab-4f5c-88ca-c021758c337e",
                        "entry_id": "5458941a-9cee-308e-992c-6d57918d62cf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Irrlichte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3ac939df-cdb4-3fab-9e62-e119c2873b16",
                        "entry_id": "5458941a-9cee-308e-992c-6d57918d62cf",
                        "glosses": [
                            "kleine vom Boden aufsteigende Flämmchen, vorzugsweise auf sumpfigen und moorigem Gelände; in der Vergangenheit verband der Volksglauben mit dieser Naturerscheinungen allerlei Aberglauben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "404001e2-548c-498e-9b17-a7d84d6e386a",
                                "sense_id": "3ac939df-cdb4-3fab-9e62-e119c2873b16",
                                "text": "Lange glaubte die Wissenschaft, daß Irrlichter nichts anderes sind als Hirngespinste oder auch Verwechselungen mit anderen Leuchterscheinungen wie z.B. das Elmsfeuer oder Glühwürmchen. Erst durch Irrlichtbeschreibungen von angesehen Persönlichkeiten begann man an die reale Existenz von Irrlichtern zu glauben."
                            },
                            {
                                "example_id": "c6b3c28d-4df1-40c9-a516-d406aa2cea99",
                                "sense_id": "3ac939df-cdb4-3fab-9e62-e119c2873b16",
                                "text": "„Sie wirkten wie schmale Irrlichter in dem großen dröhnenden Raum und beleuchteten Gesichter und Hände, als wären die Körper bereits durch das Dröhnen zerfallen und nur die nackten Hände und Gesichter schwebten noch herum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c09598eb-c40d-395f-a23d-0298a07d6b03",
                        "entry_id": "5458941a-9cee-308e-992c-6d57918d62cf",
                        "glosses": [
                            "Märchenwesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce91f2d7-3d55-4ddf-92f3-78d0576960e6",
                                "sense_id": "c09598eb-c40d-395f-a23d-0298a07d6b03",
                                "text": "Als er vor die Tür hinaus trat, sah er zwei große Irrlichter über dem angebundenen Kahne schweben, die ihm versicherten, daß sie große Eile hätten und schon an jenem Ufer zu sein wünschten."
                            },
                            {
                                "example_id": "ba8299b8-6430-42c0-b184-cfdf98cd9452",
                                "sense_id": "c09598eb-c40d-395f-a23d-0298a07d6b03",
                                "text": "„Zudem spukten zwischen den Hügeln feurige Männer und Irrlichter.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "758dfdf6-9599-483e-9980-1ee042a399a9",
                        "source_entry_id": "5458941a-9cee-308e-992c-6d57918d62cf",
                        "source_sense_id": "3ac939df-cdb4-3fab-9e62-e119c2873b16",
                        "target_lang_word": "will o' the wisp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "will o' the wisp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c98df2c-3ee6-3a1a-9f3b-58eaebb66888",
                                        "entry_id": "5e2ed548-f611-363e-ae72-ac87236339c4",
                                        "glosses": [
                                            "Any of several kinds of pale, flickering light, appearing over marshland in many parts of the world with diverse folkloric explanations and multiple possible scientific explanations including bioluminescence and chemiluminescence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f44d05b6-2834-36bb-a441-132d08c2962f",
                                        "entry_id": "5e2ed548-f611-363e-ae72-ac87236339c4",
                                        "glosses": [
                                            "Any of several kinds of pale, flickering light, appearing over marshland in many parts of the world with diverse folkloric explanations and multiple possible scientific explanations including bioluminescence and chemiluminescence.",
                                            "A flickering light or lantern, especially over bogs, swamps or marshes, held by a supernatural creature who uses it to lure travelers at night to their demise."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19dd7893-06c7-4cd4-82fc-be081c9cf39d",
                                                "sense_id": "f44d05b6-2834-36bb-a441-132d08c2962f",
                                                "text": "1988, Michael Weikath, \"Keeper of the Seven Keys\", Helloween, Keeper of the Seven Keys: Part II.\nWill o' the wisps / Misguiding your path / You can't throw a curse / Without takin' their wrath"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "386a3222-8fe7-3739-b11f-2a4b5a3f68c1",
                                        "entry_id": "5e2ed548-f611-363e-ae72-ac87236339c4",
                                        "glosses": [
                                            "A delusionary or otherwise unachievable goal that one feels compelled to pursue."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e6e5194-ab44-475f-a883-a647f2288c48",
                                                "sense_id": "386a3222-8fe7-3739-b11f-2a4b5a3f68c1",
                                                "text": "Some preliminary legal arrangements were made, but the scheme proceeded no further, as the various local authorities concerned were unwilling to speculate public funds on what was, even at that date, a will o' the wisp."
                                            },
                                            {
                                                "example_id": "82127f1b-a6ac-4695-b86c-b64d96569143",
                                                "sense_id": "386a3222-8fe7-3739-b11f-2a4b5a3f68c1",
                                                "text": "I happen to think the brothers’ pi project is a will-o’-the-wisp, and is one of the least interesting things they’ve ever done. But what do I know?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8890d9d4-322f-411f-9da2-6d223a643b79",
                        "source_entry_id": "5458941a-9cee-308e-992c-6d57918d62cf",
                        "source_sense_id": "3ac939df-cdb4-3fab-9e62-e119c2873b16",
                        "target_lang_word": "fen fire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fen fire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d94fde03-f5b2-3fd8-8ae2-40ec406a86ee",
                                        "entry_id": "b9acd211-a0ff-3b4e-a983-8f4532a41918",
                                        "glosses": [
                                            "will o' the wisp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa2506fb-b435-4e6a-869a-4ac3ac9d62d8",
                                                "sense_id": "d94fde03-f5b2-3fd8-8ae2-40ec406a86ee",
                                                "text": "Also we were above the level of the marsh mist, which lay stretched beneath us like the dim smoke-pall over a city, lit up here and there by the wandering globes of fen fire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d91684d-12db-4cc3-91fc-ffe8e37776db",
                        "source_entry_id": "5458941a-9cee-308e-992c-6d57918d62cf",
                        "source_sense_id": "3ac939df-cdb4-3fab-9e62-e119c2873b16",
                        "target_lang_word": "feu follet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feu follet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c446ffaa-6221-35f9-913f-07d6920169a4",
                                        "entry_id": "9226ca88-03c7-3ee4-b6eb-efa4bd659a12",
                                        "glosses": [
                                            "Lueur que l’on voit voltiger la nuit sur les marais, dans les cimetières, produit par l’inflammation des gaz dégagés par des matières organiques en décomposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d38c536-1d9a-4d76-a4dd-d736706dce38",
                                                "sense_id": "c446ffaa-6221-35f9-913f-07d6920169a4",
                                                "text": "Ses broderies pétillaient si vivement au soleil, et l'aigrette de son schako étroit et long en recevait de si fortes lueurs, que les spectateurs durent le comparer à un feu follet, à une âme invisible chargée par l'empereur d'animer, de conduire ces bataillons […]"
                                            },
                                            {
                                                "example_id": "b536339e-45d3-46f2-9670-2c29144d2ba2",
                                                "sense_id": "c446ffaa-6221-35f9-913f-07d6920169a4",
                                                "text": "Les feux follets sont la même chose que le feu Saint-Elme; mais au lieu que celui-ci se voit sur la mer, les feux follets paroissent sur la terre, particulièrement en automne dans les endroits marécageux, dans les cimetières, etc. Tous les deux doivent leur origine à la même cause, l'électricité."
                                            },
                                            {
                                                "example_id": "a5489420-8486-4a43-a4b7-25c86d12defc",
                                                "sense_id": "c446ffaa-6221-35f9-913f-07d6920169a4",
                                                "text": "Ah ! si nous avions été là, nous autres, de tous ces Allemands qui sont entrés en France pas un ne serait sorti vivant. Nos draks, nos feux follets les auraient conduits dans des fondrières."
                                            },
                                            {
                                                "example_id": "a30f18aa-92f1-4b81-a9de-3567d5e7a5ce",
                                                "sense_id": "c446ffaa-6221-35f9-913f-07d6920169a4",
                                                "text": "Un tout petit mur entourait le cimetière, assez bas pour que les feux follets, les nuits de sabbat, puissent le sauter sans s’éteindre."
                                            },
                                            {
                                                "example_id": "72c3a1ef-d246-4688-83fd-dd1ba616f55f",
                                                "sense_id": "c446ffaa-6221-35f9-913f-07d6920169a4",
                                                "text": "C'est également l'origine des feux follets. Ceux-ci sont faits de flammes fugitives, très légères, qu'on apercevait jadis dans les cimetières et qui alimentaient la superstition et la terreur de ceux qui les observaient. Ces flammes sont dues à la combustion spontanée du phosphure d'hydrogène qui se dégage des cadavres en décomposition dans le sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf24f3a9-f6b9-3859-8488-ebaff8d4b167",
                                        "entry_id": "9226ca88-03c7-3ee4-b6eb-efa4bd659a12",
                                        "glosses": [
                                            "Chose fugace."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb7cdd94-04d7-401a-b343-00c36f354c10",
                                                "sense_id": "cf24f3a9-f6b9-3859-8488-ebaff8d4b167",
                                                "text": "Ses cheveux blonds étaient plus pâles qu’un reflet,\nEt je l’ai poursuivie ainsi qu’un feu follet.\nEcoute.. Tu le sais, ô charme de mes heures !\nLes premières amours ne sont pas les meilleures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c018e23-2276-377f-a2d9-90e7a2c83d14",
                                        "entry_id": "9226ca88-03c7-3ee4-b6eb-efa4bd659a12",
                                        "glosses": [
                                            "Personne vivace, insaisissable, animée comme une flamme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ead925e5-0fbb-4cd8-97e9-5a869ac9d84e",
                                                "sense_id": "9c018e23-2276-377f-a2d9-90e7a2c83d14",
                                                "text": "Ah ! ma bien-aimée, entends le terrible, le fatal, l’insolent mot de l’imbécile La Fayette à son maître, à son roi : Il est trop tard ! Ô ! ma vie, ma belle vie ! quel médecin me la rendra ? Je me suis frappée à mort. Hélas ! n’étais-je pas un feu follet de femme destiné à s’éteindre après avoir brillé ? Mes yeux sont deux torrents de larmes, et… je ne peux pleurer que loin de lui… Je le fuis et il me cherche. Mon désespoir est tout intérieur. Dante a oublié mon supplice dans son Enfer. Viens me voir mourir ?"
                                            },
                                            {
                                                "example_id": "ce8cf590-e9a9-4398-ade3-fc997879ce30",
                                                "sense_id": "9c018e23-2276-377f-a2d9-90e7a2c83d14",
                                                "text": "C’était le plus charmant, le plus fantaisiste, le plus irréel des compagnons, un feu follet assis sur les coussins de la victoria."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb3bf51b-23fb-4e0c-bac2-20446b63a8e7",
                        "source_entry_id": "5458941a-9cee-308e-992c-6d57918d62cf",
                        "source_sense_id": "3ac939df-cdb4-3fab-9e62-e119c2873b16",
                        "target_lang_word": "dwaallicht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwaallicht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2fecfbf9-d0a2-3bd4-8fd4-20052ae18523",
                                        "entry_id": "e89d12da-8efe-3f9e-8282-27acf9e24b1b",
                                        "glosses": [
                                            "in het volksgeloof een (blauwachtig) lichtje boven moerassen, poelen en kerkhoven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8281f93-92ed-4bd7-8484-699f8dcd8c6a",
                                                "sense_id": "2fecfbf9-d0a2-3bd4-8fd4-20052ae18523",
                                                "text": "Oostelijke sagen en legenden. Daar draait het om bij het interactieve theater aan het water. Bezoekers worden bij Het Hulsbeek door Vrouw Holle verwelkomd bij de Boetentiedse Biecht: de nacht waarin overleden zondaars verlost kunnen worden van hun eeuwige boetedoening als dwaallicht of Heemänneke. Met hulp van de smartphone kunnen bezoekers extra prikkelende indrukken opdoen van het evenement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e0a478-37e4-3ec4-b62a-652559b534c0",
                                        "entry_id": "e89d12da-8efe-3f9e-8282-27acf9e24b1b",
                                        "glosses": [
                                            "iemand met andere politieke ideeën dan jezelf hebt"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9968337-c146-44bb-a17d-dfc287b49d7d",
                                                "sense_id": "f1e0a478-37e4-3ec4-b62a-652559b534c0",
                                                "text": "Ook een andere horde jaagt nog steeds op cultureel erfgoed en probeert Piet zwart te maken. De goedheiligman en zijn vrolijke knechten, die volgens deze dwaallichten zouden herinneren aan de slavernij, zijn binnenkort in Suriname weer van harte welkom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fea558dd-c8e9-409c-b51b-bc225827a838",
                        "source_entry_id": "5458941a-9cee-308e-992c-6d57918d62cf",
                        "source_sense_id": "3ac939df-cdb4-3fab-9e62-e119c2873b16",
