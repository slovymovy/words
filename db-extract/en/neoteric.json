                    },
                    {
                        "sense_id": "e6feab9b-e72f-3d8e-b013-889e4e7b306d",
                        "entry_id": "d2957b5f-3ecf-3afe-b9c3-698d24c08ed8",
                        "glosses": [
                            "Someone with new or modern ideas."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1a9e18bd-c97c-3078-9c51-a6174eec7c5d",
