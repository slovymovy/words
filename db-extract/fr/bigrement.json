        "fr-extract.jsonl": [
            {
                "entry_id": "62e738f4-b224-3d24-86ab-30a9f127748d",
                "word": "bigrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36e6c6ba-2898-39ce-a6ba-98fafd46d423",
                        "entry_id": "62e738f4-b224-3d24-86ab-30a9f127748d",
                        "glosses": [
                            "Beaucoup, très."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9160cdb7-e1f4-41c4-8e0b-7de70269072e",
                                "sense_id": "36e6c6ba-2898-39ce-a6ba-98fafd46d423",
                                "text": "— Je suis très renseignée sur votre compte. Je pourrais vous dire sur vous des choses qui vous étonneraient bigrement."
                            },
                            {
                                "example_id": "9d06409c-d9e2-4fb7-954c-2453598b8a71",
                                "sense_id": "36e6c6ba-2898-39ce-a6ba-98fafd46d423",
                                "text": "— J’ai bigrement bien fait de prendre ma serpe…"
                            },
                            {
                                "example_id": "4b6c669b-e93a-4336-884c-6839c4ca6e33",
                                "sense_id": "36e6c6ba-2898-39ce-a6ba-98fafd46d423",
                                "text": "Il rechercha vainement un visage compatissant parmi ses camarades. Gabriel Morange prit alors conscience qu’il allait lui falloir être bigrement persuasif pour empêcher l’irréparable de se produire, et que si le besoin de sexe de ses compagnons était au moins aussi fort que le sien, c’était loin d’être gagné."
                            },
                            {
                                "example_id": "4192e31a-77d9-4561-81ae-0c4952924cbb",
                                "sense_id": "36e6c6ba-2898-39ce-a6ba-98fafd46d423",
                                "text": "Puis il se pencha soudain sur son boxeur et ce qui aurait dû être une exhortation au combat ressembla bigrement à une engueulade."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
