                        "examples": [
                            {
                                "example_id": "b85bd44d-ac76-474f-ac6c-38f173c8b3d9",
                                "sense_id": "b81f0a10-86f1-3aa6-aaac-36e5bb6e9bdd",
                                "text": "Quand j’ai commencé dans le business de matos hi-fi, j’étais pote avec un noich (Chinois) qui connaissait un réseau pour épuiser les stocks volés. Ça se passait surtout dans les magasins cambodgiens, je ne sais pas pourquoi."
                            },
                            {
                                "example_id": "0eaa5034-c8c9-4665-8033-9ebbe3b312a8",
                                "sense_id": "b81f0a10-86f1-3aa6-aaac-36e5bb6e9bdd",
                                "text": "Cyprien est allé s’acheter des pétards chez le noich."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a3e9e2f-9dd1-3937-bdc6-9c9ae639fc3b",
                        "entry_id": "7ba18502-dd9c-310d-bf9d-f23cf86247c4",
