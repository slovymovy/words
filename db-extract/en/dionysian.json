                "translations": [
                    {
                        "translation_id": "c004ea94-da66-43e5-8a3a-f36443beef4e",
                        "source_entry_id": "5abfda16-8432-3d62-b1e3-d20113f0b1c2",
                        "source_sense_description": "of or pertaining to Dionysus",
                        "target_lang_word": "dionysisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dionysisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac837dff-1dc2-31fa-83fb-263145138e3f",
                                        "entry_id": "14ec16a2-14d6-3e69-b441-fce9c450bb40",
                                        "glosses": [
                                            "die Angelegenheiten des griechischen Gottes Dionysos (lateinisch Bacchus) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a8cd07-fb48-478c-95de-606881656e7c",
                                                "sense_id": "ac837dff-1dc2-31fa-83fb-263145138e3f",
                                                "text": "„Hier wird unter anderem die Ansicht vertreten, daß der Hymnos eine attische Legende enthält, die dionysische Festbräuche in Brauron erklären soll.“"
                                            },
                                            {
                                                "example_id": "d843c21e-4141-4a5e-b496-65588d5ff08e",
                                                "sense_id": "ac837dff-1dc2-31fa-83fb-263145138e3f",
                                                "text": "„Es handelt sich um zwei Triebe in der Kunst, die in den ‚getrennten Kunstwelten des Traumes und des Rausches‘ das ‚ebenso dionysische und apollinische Kunstwerk der attischen Tragödie erzeugen‘. In der Synthese beider scheint das Apollinische dionysisch und das Dionysische apollinisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "43acb146-7bf8-37b9-bff6-f1062c42c4d9",
                                        "entry_id": "14ec16a2-14d6-3e69-b441-fce9c450bb40",
                                        "glosses": [
                                            "rauschhaft, wild, eben wie der griechische Gott Dionysos in wilden Umzügen gefeiert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89647087-85b4-4e54-9df4-69cf28729c66",
                                                "sense_id": "43acb146-7bf8-37b9-bff6-f1062c42c4d9",
                                                "text": "„Es handelt sich um zwei Triebe in der Kunst, die in den ‚getrennten Kunstwelten des Traumes und des Rausches‘ das ‚ebenso dionysische und apollinische Kunstwerk der attischen Tragödie erzeugen‘. In der Synthese beider scheint das Apollinische dionysisch und das Dionysische apollinisch.“"
                                            },
                                            {
                                                "example_id": "1a729ec5-3bc7-42fe-ba2e-2ee5c1c417bd",
                                                "sense_id": "43acb146-7bf8-37b9-bff6-f1062c42c4d9",
                                                "text": "„In den blühenden und schöpferischen Perioden, die die Krankheit manchmal mit sich bringt, erhebt er sich zum zauberhaften Meister mit alten Kräften aus einer anderen biologischen Welt, aus archaischen Tiefenschichten steigt es empor, ein rauschhaft starkes dionysisches Weltgefühl, eine grandiose Phantasiewelt entsteht, er wächst ins Kosmische, wird zum Mythos, er kämpft mit den Dämonen seines Schicksals, in der mystischen Ekstase der indischen Introversion.“"
                                            },
                                            {
                                                "example_id": "a71ddf1c-6a86-4732-8d1e-87e5170a481f",
                                                "sense_id": "43acb146-7bf8-37b9-bff6-f1062c42c4d9",
                                                "text": "Es waren dionysische Feiern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "243fe9e2-961a-46bd-afc0-d431857dbda3",
