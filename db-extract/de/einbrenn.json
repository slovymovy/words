                        "sense_id": "b0667852-7028-3312-bbb4-0e27cabd0ca1",
                        "entry_id": "08127cbf-143e-36ef-ac09-e9cdbf74ac5a",
                        "glosses": [
                            "in Butter oder anderem Fett angeröstetes Mehl zum Binden (Eindicken) von Suppen und Soßen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "b3d2366b-da8a-47f1-8072-10dc64a2a394",
                                "sense_id": "b0667852-7028-3312-bbb4-0e27cabd0ca1",
                                "text": "Eine Einbrenn sollte schon eine Weile kochen, damit der Mehlgeschmack verschwindet."
                            },
                            {
                                "example_id": "51d13b32-c3b6-4fe0-a289-d694f725c601",
                                "sense_id": "b0667852-7028-3312-bbb4-0e27cabd0ca1",
                                "text": "„Nun war sie dabei gewesen, Einbrenn in die grüne Masse zu rühren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
