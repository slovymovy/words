                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d08e8e37-7275-40d7-9325-322210d4107f",
                                "sense_id": "5ff52573-ca26-32d5-b73c-1c9e55cec947",
                                "text": "J'ai trouvé pour la première fois ce mot dans un livre de Charles Asselineau, un grand ami de Baudelaire : lui parle de sensualité littéraire pour définir la libricité."
                            },
                            {
                                "example_id": "7cd24279-bfe8-4037-8a9e-817911fe3c3d",
                                "sense_id": "5ff52573-ca26-32d5-b73c-1c9e55cec947",
                                "text": "Heureusement que tout cela n'est qu'un rêve, rêve affreux mais que clôt gaiement un déjeuner avec un ami, M. Conrad, flanqué d'une amie, Mlle Rodolfa. Notons, avant de finir, un mot créé par M. Ch. Asselineau pour exprimer la sensualité littéraire : LIBRICITÉ."
                            }
                        ]
                    }
