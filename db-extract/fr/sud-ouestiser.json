                        "glosses": [
                            "Donner un caractère lié au sud-ouest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "607e6a48-3ecb-4c64-b7d4-6d64ee892f8e",
                                "sense_id": "6c7a5c89-ce36-31b3-a523-c319b951add1",
                                "text": "On salue aussi l’effort de réinterprétation des grands classiques pour les “sud-ouestiser”, un pari réussi et un très bel ambassadeur de cette région."
                            },
                            {
                                "example_id": "58d1b262-61c8-4497-9378-af63400b8067",
                                "sense_id": "6c7a5c89-ce36-31b3-a523-c319b951add1",
                                "text": "Bien sûr...sud-ouestise (mais pas de bêtise, hein....avec les mojitos ??!!)."
                            },
                            {
                                "example_id": "e548e8cc-3a25-40c6-8717-faae368e88cc",
                                "sense_id": "6c7a5c89-ce36-31b3-a523-c319b951add1",
                                "text": "Bien sûr, on trouve sur place toute la gamme du fameux producteur de foie gras wallon d'Upigny, localité sud-ouestisée en Upignac."
                            }
                        ]
