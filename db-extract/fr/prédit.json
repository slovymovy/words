                        "sense_id": "72b99388-cdb6-3c71-9934-92f41b8a6495",
                        "entry_id": "f1d053aa-31c6-3737-b513-1c3403021946",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent de prédire."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "80832cc1-0b10-4680-88f0-055f96b5e6e5",
                                "sense_id": "72b99388-cdb6-3c71-9934-92f41b8a6495",
                                "text": "Il paraît satisfait de voir le vent déforcir et me prédit une arrivée calme à Mahébourg."
