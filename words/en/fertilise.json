                            }
                        },
                        {
                            "text": "It is important to <w>fertilise</w> the soil before planting new flowers in the garden.",
                            "target_lang_translations": {
                                "zh": "在花园里种新花之前，给土壤<w>施肥</w>很重要。"
                            }
