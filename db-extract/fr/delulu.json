                                    {
                                        "sense_id": "e9e57d77-9fc8-3a72-bdac-3726c8e5ad5f",
                                        "entry_id": "0b8b8a4d-c718-3385-be2f-ca5e7ebc88c5",
                                        "glosses": [
                                            "Delusional."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bee204b3-b5d5-414e-b208-446ac64eff39",
                                                "sense_id": "e9e57d77-9fc8-3a72-bdac-3726c8e5ad5f",
                                                "text": "I literally think someone gave me drugs while I was sleeping... Im so delulu right now what on earth"
                                            },
                                            {
                                                "example_id": "ced4cc5f-dc5f-44ff-a183-37381c5b9d1d",
                                                "sense_id": "e9e57d77-9fc8-3a72-bdac-3726c8e5ad5f",
                                                "text": "Most of the fans sending hate to the idol would claim that they are not delulu fans but they just want the idol out of the group because the group's growth will be affected by the wrath of delulu fans."
                                            },
                                            {
                                                "example_id": "483a6501-b352-4ad9-a296-7df91524fd98",
                                                "sense_id": "e9e57d77-9fc8-3a72-bdac-3726c8e5ad5f",
                                                "text": "\"You are so delulu boy. You need Jesus.\" Inez sighed."
                                            },
                                            {
                                                "example_id": "4bede2f1-228b-4997-b007-8c95d96efb7f",
                                                "sense_id": "e9e57d77-9fc8-3a72-bdac-3726c8e5ad5f",
                                                "text": "You are delulu if you still think about someone you once met years before."
                                            },
                                            {
                                                "example_id": "0c074fbe-46aa-497b-ae71-acfbf6cabefc",
                                                "sense_id": "e9e57d77-9fc8-3a72-bdac-3726c8e5ad5f",
                                                "text": "However, conspiracy theorists don't want decarbonization or climate adaptation measures. They are simply living in their delulu world."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "delulu",
                                "target_lang_code": "en",
