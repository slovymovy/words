                        "glosses": [
                            "skierowany w różne strony, mający szeroki zakres zainteresowań"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0e37f539-efa9-4e15-9fe7-4ed2c2c84006",
                                "sense_id": "fa0aceee-e640-39f2-bf8e-fb3e3225fe28",
                                "text": "Układ podobny powinien zadowolić każdego mitologa, albowiem ze wszystkich znanych mi planów systematycznych ten jest najlepiej obmyślany, gdyż w racyonalnym porządku wyczerpuje całe koło poszczególnych gałęzi wiedzy, przeto jako najróżnostronniejszy najbardziej odpowiada potrzebie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
