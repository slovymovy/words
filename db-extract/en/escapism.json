    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e82045c5-d7b6-31dc-b2bc-0ada7504a27a",
                "word": "escapism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c44b2d46-c988-453b-9d28-8832ca885fd9",
                        "entry_id": "e82045c5-d7b6-31dc-b2bc-0ada7504a27a",
                        "tags": [
                            "plural"
                        ],
                        "form": "escapisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39377ae8-01de-340c-9a8a-274dbcadd63b",
                        "entry_id": "e82045c5-d7b6-31dc-b2bc-0ada7504a27a",
                        "glosses": [
                            "An inclination to escape from routine or reality into fantasy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9edfa86f-9217-4a9d-bd16-a2064775be99",
                                "sense_id": "39377ae8-01de-340c-9a8a-274dbcadd63b",
                                "text": "“If you look at literature on why people watch reality TV, that’s one of the main reasons: escapism,” said Danielle J. Lindemann, the author of “True Story: What Reality TV Says About Us.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "054fa640-3d54-38c9-b9ad-856cdc4e1bd3",
                        "entry_id": "e82045c5-d7b6-31dc-b2bc-0ada7504a27a",
                        "glosses": [
                            "A genre of book, film etc. that one uses to indulge this tendency."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d2d58885-3bb8-3f5c-b0f4-bf2fdaaa087f",
                        "entry_id": "e82045c5-d7b6-31dc-b2bc-0ada7504a27a",
                        "glosses": [
                            "The performance of an escape artist."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c649be87-a351-4e35-abc3-4b0297ade7d7",
                        "source_entry_id": "e82045c5-d7b6-31dc-b2bc-0ada7504a27a",
                        "source_sense_description": "inclination to escape",
                        "target_lang_word": "escapisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escapisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e91c32f0-1270-3d55-a151-211601853b66",
                                        "entry_id": "c3c94f62-b900-39d6-8e85-fae7cf93d883",
                                        "glosses": [
                                            "Attitude qui consiste à se retirer du monde et de la vie civique, par fuite ou désabusement, par opposition à la prise de parole ou à l’action individuelle ou sociale."
                                        ],
                                        "tags": [
                                            "neologism",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c5c1a9a-1393-43c3-8628-1204ca2ac7d3",
                                                "sense_id": "e91c32f0-1270-3d55-a151-211601853b66",
                                                "text": "Tous les morticoles du ciboulot font bloc autour de leur petit patient qui n’en peut mais : il souffre d’escapisme aigu, cette drôle d’attitude qui consiste à se retirer lentement du monde et de toute vie civique, par fuite, par désabusement, en opposition à la prise de décision publique et à toute action individuelle ou sociale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c61e75a-04e3-384b-83ff-9eb9190ed817",
                                        "entry_id": "c3c94f62-b900-39d6-8e85-fae7cf93d883",
                                        "glosses": [
                                            "Évasion de la réalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7dc9cb-a66a-4005-a50c-c0617b0131d3",
                                                "sense_id": "9c61e75a-04e3-384b-83ff-9eb9190ed817",
                                                "text": "Du coup, du fait de la répétitivité de ces violences une forme d’indifférence ou d’escapisme s’était installée."
                                            },
                                            {
                                                "example_id": "2215991f-7405-4c52-87f9-81657250041f",
                                                "sense_id": "9c61e75a-04e3-384b-83ff-9eb9190ed817",
                                                "text": "C'est une attitude de fuite qui se dégage de cette chanson [la Paloma], un escarpisme au goût du jour et dont le vrai nom serait : le refoulement du passé et du présent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bfa7750-47ac-448f-8b8a-b66275590554",
                        "source_entry_id": "e82045c5-d7b6-31dc-b2bc-0ada7504a27a",
                        "source_sense_description": "inclination to escape",
                        "target_lang_word": "Eskapismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eskapismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                        "entry_id": "afff6ef4-b8c0-343b-b9b7-05c4ad483297",
                                        "glosses": [
                                            "Flucht vor der realen Welt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "978b074d-dea7-42f6-a47b-7369d7ecb30d",
                                                "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                                "text": "Diese Romane sind der reinste Eskapismus."
                                            },
                                            {
                                                "example_id": "fe94b612-826d-4115-870e-3c0ed989116f",
                                                "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                                "text": "„Eskapismus aus dem als kalt empfundenen »real life« ist ein weit verbreitetes Muster, das auch Suchterkrankungen zugrundeliegt […].“"
                                            },
                                            {
                                                "example_id": "ecc1a192-91d9-48e0-9674-78c1645b6348",
                                                "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                                "text": "„Das Schwelgen in ausgedachten Geschichten als Form des Eskapismus ist eine Sache.“"
                                            },
                                            {
                                                "example_id": "84ef8f9a-0e59-4db7-86c9-1fa80a4faeee",
                                                "sense_id": "cc65bb45-46bb-3a1f-b16a-26efd16cbe0e",
                                                "text": "„Der Pastor hielt seine ethnographischen Studien für Eskapismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81ccc29f-1877-434f-ab15-2ac8eccaa07f",
                        "source_entry_id": "e82045c5-d7b6-31dc-b2bc-0ada7504a27a",
                        "source_sense_description": "inclination to escape",
                        "target_lang_word": "Wirklichkeitsflucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wirklichkeitsflucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                        "entry_id": "8da66f27-fb14-3766-9dd8-7527159fb9fe",
                                        "glosses": [
                                            "Flucht, Rückzug aus der Wirklichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8480ff89-6c8f-4d84-b72b-408dc4082c16",
                                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                                "text": "„Es wäre einseitig anzunehmen, Unterhaltung befriedige lediglich Wünsche nach Zerstreuung und Entspannung, nach Wirklichkeitsflucht und Ablenkung.“"
                                            },
                                            {
                                                "example_id": "50a83835-394c-445e-9ed6-739d9727b661",
                                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                                "text": "„Kein Wunder, dass sich Zyniker über Heuchler in der Kirche beklagen und Glaube als Wirklichkeitsflucht diskreditieren.“"
                                            },
                                            {
                                                "example_id": "87d19079-1fba-4a88-a38c-b97c50c0f4b0",
                                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                                "text": "„Thomas hielt Seriengucken außerdem für Wirklichkeitsflucht.“"
                                            },
                                            {
                                                "example_id": "6c8e9bf2-334f-4013-bfb9-7a126317885f",
                                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                                "text": "„Der ‚ästhetische Staat‘ ist nicht ein Staat der Wirklichkeitsflucht, sondern der Wirklichkeitssuche.“"
                                            },
                                            {
                                                "example_id": "c283cd14-c3fc-4a6d-98a9-5a48bb5ed87c",
                                                "sense_id": "1c0014cc-8dad-3a1f-b3a0-64548d962e73",
                                                "text": "„In der Gegenwart zeigt sich auch bei den Magyaren Widerstreit zwischen Naturtreue und Wirklichkeitsflucht, Sozialismus und Individualismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ada8066f-2bba-43a8-9efc-ab50bd1c93c8",
                        "source_entry_id": "e82045c5-d7b6-31dc-b2bc-0ada7504a27a",
                        "source_sense_description": "inclination to escape",
                        "target_lang_word": "Realitätsflucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Realitätsflucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                                        "entry_id": "36b55153-3a77-3d36-8173-5b9f724125b2",
                                        "glosses": [
                                            "Flucht, Rückzug vor der realen Welt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ce6f01-8cdc-4925-9ecf-dabb7b95a982",
                                                "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                                                "text": "„Im Negativen neigt Josua zum Abheben und zur Realitätsflucht.“"
                                            },
                                            {
                                                "example_id": "0f7d2dcf-60b0-43bd-bbe3-faefb9052dbe",
                                                "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                                                "text": "„Schon in meiner Kindheit liebte ich die Realitätsflucht von Film und Fernsehen.“"
                                            },
                                            {
                                                "example_id": "93c966dd-f67c-4a97-bd77-5605d35d3629",
                                                "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                                                "text": "„In berückend schöner, kraftvoller Sprache entfaltet Ava Farmehri eine Geschichte von politischem Aufruhr, von Realitätsflucht, Unterdrückung und Isolation – makaber und magisch zugleich.“"
                                            },
                                            {
                                                "example_id": "589bd976-b44e-4cee-9551-32cc9886c70b",
                                                "sense_id": "dd497612-c7b7-3eeb-a6dd-dd44ac4c2369",
                                                "text": "„Die bereits stark ausgeprägte Identitätslosigkeit wird durch die ausgefeilte ‚Realitätsflucht‘ auffällig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
