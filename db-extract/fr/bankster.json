                    {
                        "sense_id": "88967944-8a57-3ea8-ab31-e8817d2763a7",
                        "entry_id": "49e95227-0e98-3715-ae72-72d7744ba37b",
                        "glosses": [
                            "Banquier profiteur et malhonnête."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d2f36214-54a9-454b-9764-77766cb1ea50",
                                "sense_id": "88967944-8a57-3ea8-ab31-e8817d2763a7",
                                "text": "Malgré les réticences du Congrès, l’Administration américaine ne regarde pas à la dépense à l’heure de venir à la rescousse des banksters (banquiers gangsters)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f02e66c-d21b-43e7-b854-be3984052c99",
                        "source_entry_id": "49e95227-0e98-3715-ae72-72d7744ba37b",
                        "source_sense_id": "88967944-8a57-3ea8-ab31-e8817d2763a7",
                        "target_lang_word": "Bankster",
