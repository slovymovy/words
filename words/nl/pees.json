                        {
                            "text": "Waarom <w>pees</w> jij altijd zo in het weekend?",
                            "target_lang_translations": {
                                "en": "Why do you always <w>grind</w> so hard on the weekend?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Betekent hard werken."
                        }
                    ],
                    "target_lang_definitions": {
