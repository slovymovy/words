                        "examples": [
                            {
                                "example_id": "219117e3-40d8-4443-9f5d-27e5df7e9d1a",
                                "sense_id": "33cca07b-c739-35e9-9c0c-3d0e3a6ab8b2",
                                "text": "„Festfreude liegt über der Landschaft und den Frauen und bringt mich in hohe Stimmung.“"
                            },
                            {
                                "example_id": "44ee4895-8c3a-4a37-a5b5-2c3ed0002952",
                                "sense_id": "33cca07b-c739-35e9-9c0c-3d0e3a6ab8b2",
                                "text": "„Den aktuellen Wirtschaftswert des Oktoberfests, das bis zum 4. Oktober dauert, schätzt das städtische Tourismusamt für München auf 830 Millionen Euro; so viel geben die Besucher für Festfreuden wie Bier, Zuckerwatte und Achterbahn, für Einkäufe in der Stadt und für Übernachtungen aus.“"
                            }
                        ],
