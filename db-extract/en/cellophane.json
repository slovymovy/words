                        "entry_id": "e7c74629-675d-3e0e-ae26-64f632a76106",
                        "glosses": [
                            "Any of a variety of transparent plastic films, especially one made of processed cellulose."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c39c6da5-3892-4520-afbb-33e6cef01510",
                                "sense_id": "fcd81ecb-52ca-380b-96de-a7ea1cee60b9",
                                "text": "Cellophane flowers of yellow and green towering over your head"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51157b53-9a10-465e-aac6-a383a397ceb9",
