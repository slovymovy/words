                        "examples": [
                            {
                                "example_id": "615db8da-f069-426a-951a-5834c110b9dd",
                                "sense_id": "6a9a2051-5179-3848-895f-c73f37d07a3c",
                                "text": "Szlaban opuścił się w ostatniej chwili, już było widać nadjeżdżający pociąg."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1db3f6a7-a280-320a-b2c9-fda1cfb4dcd2",
                        "entry_id": "38db2839-44be-377c-a53d-53ce4080d3b4",
                        "glosses": [
                            "zakaz wychodzenia z domu nakładany na dzieci przez rodziców"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "96c3bd37-2a98-4e79-8a6c-c500d952109e",
                                "sense_id": "1db3f6a7-a280-320a-b2c9-fda1cfb4dcd2",
                                "text": "Julka ma szlaban na dwa tygodnie, więc będziemy się widywać tylko w szkole."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "8a5b8a67-cd0e-302f-ac24-4fe311ff2655",
                        "entry_id": "38db2839-44be-377c-a53d-53ce4080d3b4",
                        "glosses": [
                            "inny zakaz nakładany na dzieci przez rodziców, zwykle związany z używaniem jakichś urządzeń lub usług"
                        ],
                        "tags": [
                            "colloquial",
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "0befc83b-bcb9-46fd-8a14-06211485d6eb",
                                "sense_id": "8a5b8a67-cd0e-302f-ac24-4fe311ff2655",
                                "text": "Nie pisz do mnie na Messengerze, bo mam szlaban na Internet."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
