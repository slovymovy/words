                "translations": [
                    {
                        "translation_id": "4260f0d5-f9c0-4fec-9460-3400616b3418",
                        "source_entry_id": "ec0db1f5-3c56-35ee-a612-163130c5eeb5",
                        "source_sense_id": "f1606cb5-36c0-36df-9053-ca3c641fe307",
                        "source_sense_description": "een woorddeel dat achter de stam van een woord gevoegd wordt",
                        "target_lang_word": "Suffix",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suffix",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8970808-2776-37ee-8977-0669f7b362a4",
                                        "entry_id": "25145e96-3878-3b7a-a016-1a68b38b85a8",
                                        "glosses": [
                                            "an einen Wortstamm angehängte Endung, die der Wortbildung oder Flexion dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a2b493c-ac17-4c00-9d63-816340564ce5",
                                                "sense_id": "e8970808-2776-37ee-8977-0669f7b362a4",
                                                "text": "-erl, -lein und -chen sind Suffixe."
                                            },
                                            {
                                                "example_id": "55773ff1-00c4-4554-a4ac-7cb9bb449ec7",
                                                "sense_id": "e8970808-2776-37ee-8977-0669f7b362a4",
                                                "text": "„Schließlich sei an Entwicklungsprozesse erinnert, die sich auch in der deutschen Sprache der Gegenwart vollziehen: die Entwicklung von Wörtern zu Suffixen.“"
                                            },
                                            {
                                                "example_id": "caf854c1-1071-4ee7-8aed-fcd2fcf4f711",
                                                "sense_id": "e8970808-2776-37ee-8977-0669f7b362a4",
                                                "text": "„An sich sollte die Etymologie von Präfixen und Suffixen in der historischen Wortbildungslehre behandelt werden und nicht im Wörterbuch.“"
                                            },
                                            {
                                                "example_id": "2300a3cb-7f8c-46ce-b0d5-eeaf82f65b02",
                                                "sense_id": "e8970808-2776-37ee-8977-0669f7b362a4",
                                                "text": "„Oft bleibt er stecken, und aus dem beabsichtigten geologischen Fachausdruck ist ein deutscher Fluch mit griechischem Prä- oder Suffix geworden.“"
                                            },
                                            {
                                                "example_id": "3c58bf15-2115-4057-904d-ced9453046aa",
                                                "sense_id": "e8970808-2776-37ee-8977-0669f7b362a4",
                                                "text": "„Darüber hinaus haben sie auch bestimmte Eigenschaften mit dem Suffix gemeinsam.“"
                                            },
                                            {
                                                "example_id": "a07477b6-2a20-4819-9483-232aa98a07f6",
                                                "sense_id": "e8970808-2776-37ee-8977-0669f7b362a4",
                                                "text": "„Eine komische Wirkung kommt auch zustande, wenn mit den verschiedenen Suffixen von zusammengesetzten Wörtern gespielt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09324b5e-da33-3c1a-b1fa-82082c9669a7",
                                        "entry_id": "25145e96-3878-3b7a-a016-1a68b38b85a8",
                                        "glosses": [
                                            "die letzten Zeichen einer Zeichenkette"
                                        ],
                                        "tags": [
                                            "theoretische Informatik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf7a1e3d-881b-4625-bfef-d5b35ca2cdf7",
                                                "sense_id": "09324b5e-da33-3c1a-b1fa-82082c9669a7",
                                                "text": "„Ansonsten betrachten wir im Suffix die früheste Stelle, an der die Zahl der Einsen die Zahl der Nullen um 1 übertrifft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "033a4c86-6dbf-4614-97e2-ab91362c4e38",
                        "source_entry_id": "ec0db1f5-3c56-35ee-a612-163130c5eeb5",
                        "source_sense_id": "f1606cb5-36c0-36df-9053-ca3c641fe307",
                        "source_sense_description": "een woorddeel dat achter de stam van een woord gevoegd wordt",
                        "target_lang_word": "suffix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aab5a922-844a-393f-a3fb-d616186c635e",
                                        "entry_id": "3dbf6574-844b-38db-911a-b65b983d480b",
                                        "glosses": [
                                            "A morpheme added at the end of a word to modify the word's meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b12c30a-4c89-4605-814f-26351c6088dc",
                                                "sense_id": "aab5a922-844a-393f-a3fb-d616186c635e",
                                                "text": "The suffix \"-able\" changes \"sing\" into \"singable\"."
                                            },
                                            {
                                                "example_id": "35f497bb-c94d-48c2-8435-f012cf7455b8",
                                                "sense_id": "aab5a922-844a-393f-a3fb-d616186c635e",
                                                "text": "The praenomen and nomen for the most part consisted of simple stems with the suffix -us or -ius, […]"
                                            },
                                            {
                                                "example_id": "157ddfd8-9acc-4484-9485-93d86b6b65f7",
                                                "sense_id": "aab5a922-844a-393f-a3fb-d616186c635e",
                                                "text": "Before I simply create a root meaning X, is there any way I can use Ithkuil morphological categories or the 150 or so suffix categories to derive this word from a more general or primary word? […] In other words, the writer would not write or “key” a certain Ithkuil symbol, but rather would select a particular root from a database and identify the particular forms of the 22 morphological categories which apply to the root as well as any suffixes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44594ef3-e7ac-3d48-8b08-97b036dd422e",
                                        "entry_id": "3dbf6574-844b-38db-911a-b65b983d480b",
                                        "glosses": [
                                            "A subscript."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d93cab9-3341-3608-9352-c0bc4d64cff7",
                                        "entry_id": "3dbf6574-844b-38db-911a-b65b983d480b",
                                        "glosses": [
                                            "A final segment of a string of characters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "546daeb5-d69f-41d1-a792-1f0d3027746d",
                                                "sense_id": "9d93cab9-3341-3608-9352-c0bc4d64cff7",
                                                "text": "The string \"abra\" is both a prefix and a suffix of the string \"abracadabra\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "suffix",
