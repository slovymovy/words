                        "glosses": [
                            "Qui se rapporte au gouvernement de Maurice Duplessis (surtout de 1944 à 1959)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e50eb27-c1bf-465f-896d-d5b90c83f764",
                                "sense_id": "7c3f02f5-06a9-37fe-add6-ab20ff2d4885",
                                "text": "L’ère duplessiste, l’époque duplessiste, la période duplessiste, la Grande Noirceur duplessiste, le régime duplessiste."
                            },
                            {
                                "example_id": "b71f358f-ae55-4833-a1fd-6f664a2a534f",
                                "sense_id": "7c3f02f5-06a9-37fe-add6-ab20ff2d4885",
                                "text": "Au début, la chorégraphe fondait même son spectacle sur les parallèles entre l’Espagne franquiste et le Québec duplessiste."
                            },
                            {
                                "example_id": "50984901-d7d0-4afb-b3d9-f4404e4cbf88",
                                "sense_id": "7c3f02f5-06a9-37fe-add6-ab20ff2d4885",
                                "text": "Ici, au Québec, c’était l’époque duplessiste, l’époque où la société bien pensante était cléricale, où les pauvres restaient à leur place — inférieure — et les femmes restaient à la maison — soumises à leur mari."
                            }
                        ]
                    }
