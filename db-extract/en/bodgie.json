        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1102c6d6-f4ac-373b-ab2b-16f944401d52",
                "word": "bodgie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a0a7784c-b0fa-4609-9422-3951033b624d",
                        "entry_id": "1102c6d6-f4ac-373b-ab2b-16f944401d52",
                        "tags": [
                            "plural"
                        ],
                        "form": "bodgies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "542a6930-896f-3b81-aea0-4fd3cb834b53",
                        "entry_id": "1102c6d6-f4ac-373b-ab2b-16f944401d52",
                        "glosses": [
                            "A member of a 1950s rock subculture; a teddy boy."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fe6493c7-3732-484f-871d-96b8783b5a50",
                                "sense_id": "542a6930-896f-3b81-aea0-4fd3cb834b53",
                                "text": "I comb my hair as best I can. It is in a crew-cut ordered by the chief warder. He must have read that bodgies wear their hair long and decided to do his bit in the fight against juvenile delinquency."
                            },
                            {
                                "example_id": "d1f8893a-4acc-4bcf-b81c-e85674e1d32d",
                                "sense_id": "542a6930-896f-3b81-aea0-4fd3cb834b53",
                                "text": "Unlike McDonald, Manning noted with dismay that traditional relations between the sexes were broken down in bodgie groups. Bodgies, he argued, were disturbed youth, hooligans, maladjusted."
                            },
                            {
                                "example_id": "513b7463-f541-471d-ae9e-ebdedf55a2de",
                                "sense_id": "542a6930-896f-3b81-aea0-4fd3cb834b53",
                                "text": "The New Zealand public and press largely shared his view of bodgies as juvenile delinquents who posed a social threat. The bodgie soon became a national bogey man, with alarmist newspaper reports about bodgie behaviour."
                            },
                            {
                                "example_id": "bef1a954-0c82-4441-90a5-246d55893747",
                                "sense_id": "542a6930-896f-3b81-aea0-4fd3cb834b53",
                                "text": "In Toowoomba, Magistrate Kearney was up in arms over the bodgies and widgies in town – those dressed-up teenagers with their spruced hair and polka-dot dresses who loitered around the city streets. They were seen as a threat to society."
                            }
                        ]
                    }
                ],
