                "senses": [
                    {
                        "sense_id": "984472fe-b896-3381-85e5-6cd5c5e7d728",
                        "entry_id": "602577bc-eb28-3fc1-9bf1-86efdf2a7800",
                        "glosses": [
                            "verglaste Sichtöffnung eines Kraftfahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fe8917f-26af-489f-b1d8-e20faa7e60c5",
                                "sense_id": "984472fe-b896-3381-85e5-6cd5c5e7d728",
                                "text": "Das Autofenster ist verkratzt."
                            },
                            {
                                "example_id": "194fc30c-1798-48f1-b4fb-f7395bed876e",
                                "sense_id": "984472fe-b896-3381-85e5-6cd5c5e7d728",
                                "text": "„Aus dem Autofenster sehe ich eine Kette schneebedeckter Gipfel in der Ferne, Hintergrundkulisse für eine Stadt, in der Baukräne schweigend herumstehen.“"
                            },
                            {
                                "example_id": "78085af5-e59c-43d1-babb-2a0930d3ac5f",
                                "sense_id": "984472fe-b896-3381-85e5-6cd5c5e7d728",
                                "text": "„An dem Tag, als wir zu Amalia gebracht wurden, schien die Sonne unerbittlich durch das Autofenster, und Milena hatte schon seit Stunden nichts mehr gesagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a687acf1-14fe-438f-8e1b-7ec5a882bafd",
                        "source_entry_id": "602577bc-eb28-3fc1-9bf1-86efdf2a7800",
                        "source_sense_id": "984472fe-b896-3381-85e5-6cd5c5e7d728",
                        "source_sense_description": "verglaste Sichtöffnung eines Kraftfahrzeugs",
                        "target_lang_word": "window",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "window",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de03fe2e-2e56-3014-bb9c-1188cc383d8e",
                                        "entry_id": "a0d93e1d-520f-35b2-be5c-780c825c2108",
                                        "glosses": [
                                            "An opening, usually covered by one or more panes of clear glass, to allow light and air from outside to enter a building or vehicle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be06cff2-b039-4694-842a-983a81ffb1ae",
                                                "sense_id": "de03fe2e-2e56-3014-bb9c-1188cc383d8e",
                                                "text": "She opened the window to let some air in."
                                            },
                                            {
                                                "example_id": "17b22142-1b3c-4858-affb-1261fd5077e8",
                                                "sense_id": "de03fe2e-2e56-3014-bb9c-1188cc383d8e",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window at the old mare feeding in the meadow below by the brook, and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge,[…]."
                                            },
                                            {
                                                "example_id": "931810aa-35b5-462b-86a6-9b1da9ca774b",
                                                "sense_id": "de03fe2e-2e56-3014-bb9c-1188cc383d8e",
                                                "text": "A window is an opening in a wall to admit light and air."
                                            },
                                            {
                                                "example_id": "18b3faa3-7eef-45a7-a820-791437d40f1c",
                                                "sense_id": "de03fe2e-2e56-3014-bb9c-1188cc383d8e",
                                                "text": "Nanny Broome was looking up at the outer wall. Just under the ceiling there were three lunette windows, heavily barred and blacked out in the normal way by centuries of grime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5587ad8b-8ee8-300e-bbe1-9f4e5230f630",
                                        "entry_id": "a0d93e1d-520f-35b2-be5c-780c825c2108",
                                        "glosses": [
                                            "An opening, usually covered by glass, in a shop which allows people to view the shop and its products from outside; a shop window."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "927a5307-b362-4621-9e98-b1d49a755bae",
                                                "sense_id": "5587ad8b-8ee8-300e-bbe1-9f4e5230f630",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy.[…]Passengers wander restlessly about or hurry, with futile energy, from place to place. Pushing men hustle each other at the windows of the purser's office, under pretence of expecting letters or despatching telegrams."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd1a4a38-5680-362c-acc6-479dff4ff0e9",
                                        "entry_id": "a0d93e1d-520f-35b2-be5c-780c825c2108",
                                        "glosses": [
                                            "The shutter, casement, sash with its fittings, or other framework, which closes a window opening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f052da1-7458-34e0-b864-74382bb80f0b",
                                        "entry_id": "a0d93e1d-520f-35b2-be5c-780c825c2108",
                                        "glosses": [
                                            "A period of time when something is available or possible; a limited opportunity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64047cd7-9080-4110-8262-346a0fe5c399",
                                                "sense_id": "7f052da1-7458-34e0-b864-74382bb80f0b",
                                                "text": "launch window"
                                            },
                                            {
                                                "example_id": "3c384ecc-c584-46ba-85e9-c43c50b06b44",
                                                "sense_id": "7f052da1-7458-34e0-b864-74382bb80f0b",
                                                "text": "window of opportunity"
                                            },
                                            {
                                                "example_id": "70973ba5-54f5-47a0-a316-e29e461549b4",
                                                "sense_id": "7f052da1-7458-34e0-b864-74382bb80f0b",
                                                "text": "You have a two-hour window of clear weather to finish working on the lawn."
                                            },
                                            {
                                                "example_id": "d0349829-b36b-4354-8407-266737f3d4fc",
                                                "sense_id": "7f052da1-7458-34e0-b864-74382bb80f0b",
                                                "text": "But rescuers have a dwindling window of opportunity, with forecasters predicting the return of heavy monsoon rains in the coming days, effectively sealing off the cave until October."
                                            },
                                            {
                                                "example_id": "3e3aa837-0d87-4218-b1ce-50c6949e0e6d",
                                                "sense_id": "7f052da1-7458-34e0-b864-74382bb80f0b",
                                                "text": "Now she'll be thinking about fleeing. (The verdict delay) provides a window for potential flight....if she has not fled already."
                                            },
                                            {
                                                "example_id": "bc5d00c0-0b86-4cd8-b3d4-52a913a25973",
                                                "sense_id": "7f052da1-7458-34e0-b864-74382bb80f0b",
                                                "text": "An extensive period of trial running will then take place in the first quarter of 2020. The full opening of the Elizabeth Line is still planned to be within a six-month window between October 2020 and March 2021."
                                            },
                                            {
                                                "example_id": "804dcb2d-ed8b-4546-92c9-940c571e24c0",
                                                "sense_id": "7f052da1-7458-34e0-b864-74382bb80f0b",
                                                "text": "“The Russian military command is likely aware of the closing window before more western aid arrives and is trying to secure offensive gains before the window closes,” it said in a briefing on Monday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b98ec88c-6fe3-3bd5-a53e-26c45ecf314b",
                                        "entry_id": "a0d93e1d-520f-35b2-be5c-780c825c2108",
                                        "glosses": [
                                            "Something that allows one to see through or into something"
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0a74b8d-e95e-40ea-9a8e-ba7330a8e95b",
                                                "sense_id": "b98ec88c-6fe3-3bd5-a53e-26c45ecf314b",
                                                "text": "His journal provides a rare window into his otherwise obscure life."
                                            },
                                            {
                                                "example_id": "8ce85d5f-9c9e-4b38-b756-49cccf3327e9",
                                                "sense_id": "b98ec88c-6fe3-3bd5-a53e-26c45ecf314b",
                                                "text": "Then we read Spear's confrontational commentary on the \"Richard Pryor Incident\" from the Black perspective...and suddenly we began to feel that GCN's window on the Gay World was something we couldn't live without since no other Gay Media voice seemed so speaking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b372ef6-7c28-373e-8d1a-89a2663474a4",
                                        "entry_id": "a0d93e1d-520f-35b2-be5c-780c825c2108",
                                        "glosses": [
                                            "A restricted range."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "158d958b-c11c-4f32-b32a-30dda77c8ad0",
                                                "sense_id": "5b372ef6-7c28-373e-8d1a-89a2663474a4",
                                                "text": "In this case, a band-pass filter using a range or window of frequencies is appropriate to isolate the frequency or the group of frequencies that characterize a specific cycle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8fbbea3-b84a-3eaa-9e2d-288b0a2d1aba",
                                        "entry_id": "a0d93e1d-520f-35b2-be5c-780c825c2108",
                                        "glosses": [
                                            "A rectangular area on a computer terminal or screen containing some kind of user interface, displaying output and allowing input, often for a single task in a multitasking system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0c029f3-f15b-3b47-beaa-13dc565028e2",
                                        "entry_id": "a0d93e1d-520f-35b2-be5c-780c825c2108",
                                        "glosses": [
                                            "A figure formed of lines crossing each other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "818ac80f-eb7f-4c97-b600-0af64417df3e",
                                                "sense_id": "a0c029f3-f15b-3b47-beaa-13dc565028e2",
                                                "text": "till he has windows on his bread and butter"
                                            }
                                        ]
                                    },
                                    {
