                        "examples": [
                            {
                                "example_id": "33e98068-381b-479d-b0f8-d4da372ddaf9",
                                "sense_id": "4957ee67-5e8c-321f-b692-1f229431bd3b",
                                "text": "De voetballer was slecht in vorm vandaag en speelde tot twee keer toe een ziekenhuisbal."
                            },
                            {
                                "example_id": "693d17f3-7d60-4ea7-9b8f-b24837b92ce0",
                                "sense_id": "4957ee67-5e8c-321f-b692-1f229431bd3b",
                                "text": "Monaco gooit de ene na de andere ziekenhuisbal richting het strafschopgebied van PSV, en PSV schiet vergelijkbare ballen terug richting de goal van de Fransen."
                            }
                        ]
                    }
                ],
                "translations": [
