                ],
                "senses": [
                    {
                        "sense_id": "9a785ade-bb1f-3741-ac99-f49c2f5e58c2",
                        "entry_id": "54c65d98-0378-3172-9826-f2b5ae473644",
                        "glosses": [
                            "One in a state of magnetic or mesmeric sleep; someone in a hypnotic trance."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9856c4bb-af43-42d8-8cc2-7d5fbf604ecc",
                                "sense_id": "9a785ade-bb1f-3741-ac99-f49c2f5e58c2",
                                "text": "I once asked a sleepwaker whether she could perceive any analogy between animal and mineral magnetism, when she replied, ' There is an analogy — but the latter is of a coarser nature.'"
                            },
                            {
                                "example_id": "fd41aa0c-f075-4f90-8ba5-a2018270283f",
                                "sense_id": "9a785ade-bb1f-3741-ac99-f49c2f5e58c2",
                                "text": "Another sleepwaker informed her magnetiser that if he would breathe upon his hand, and then lay it on her forehead, his power would be increased."
                            },
                            {
                                "example_id": "72676f69-952a-4f42-aded-7d5f97f50be4",
                                "sense_id": "9a785ade-bb1f-3741-ac99-f49c2f5e58c2",
                                "text": "A lady present when Mademoiselle M——had been mesmerized by me, went up to the sleepwaker and spoke to her for some time."
                            }
                        ]
                    },
                    {
                        "sense_id": "82a18a46-732a-3115-a389-af6942c0df84",
                        "entry_id": "54c65d98-0378-3172-9826-f2b5ae473644",
                        "glosses": [
                            "A sleepwalker; one who walks in their sleep."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4ab986c3-c958-49d0-b7f7-55619a3cbf80",
                                "sense_id": "82a18a46-732a-3115-a389-af6942c0df84",
                                "text": "As I have before said, he had been, in shildhood, a natural sleepwaker; and I now add , on the testimony of his father, that he would sometimes rise in the night, take out his flute, ( an instru- ment which he was studying professionally,) place music before him, and play from notes, continuing to turn over the leaves of the music-book correctly, although his eyes were closely shut."
                            },
                            {
                                "example_id": "4ab71d31-70b3-4660-baf1-e0084904154d",
                                "sense_id": "82a18a46-732a-3115-a389-af6942c0df84",
                                "text": "He begins to speak, arises from his bed, walks about, and now becomes a sleepwaker."
                            },
                            {
                                "example_id": "7bc1d592-59cc-4434-a788-c63f246c89ae",
                                "sense_id": "82a18a46-732a-3115-a389-af6942c0df84",
                                "text": "In addition, about 4 million Americans are occasional or habitual sleepwakers."
                            }
                        ]
                    }
                ],
