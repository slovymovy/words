{
    "word_family": [
        "imputation",
        "imputable",
        "imputabilité",
        "inimputable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b45185bb-4d4b-3efc-9a57-e988b3412461",
                    "sense_definition": "Attribuer à quelqu'un la responsabilité d'une faute, d'un acte blâmable ou d'un événement négatif.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attribution_faute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur refuse d'<w>imputer</w> cet échec au manque de préparation de son équipe."
                        },
                        {
                            "text": "On lui <w>impute</w> la disparition des documents confidentiels sans aucune preuve formelle."
                        }
                    ],
                    "synonyms": [
                        "attribuer",
                        "reprocher",
                        "assigner"
                    ],
                    "common_phrases": [
                        "imputer une faute",
                        "imputer à crime"
                    ]
                },
                {
                    "sense_id": "3cf3607b-b969-3fc0-a62a-d08a0e49a5b4",
                    "sense_definition": "Affecter une somme, une dépense ou un paiement à un compte ou à une ligne budgétaire déterminée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comptable va <w>imputer</w> ces frais de déplacement sur le budget du projet."
                        },
                        {
                            "text": "Cette réduction sera <w>imputée</w> directement sur votre prochaine facture."
                        }
                    ],
                    "synonyms": [
                        "affecter",
                        "déduire"
                    ],
                    "common_phrases": [
                        "imputer une dépense",
                        "imputer sur le budget"
                    ]
                },
                {
                    "sense_id": "e6f31fc9-b3f1-368c-964c-d6f697d9c443",
                    "sense_definition": "Attribuer spirituellement à quelqu'un une faute collective ou des mérites acquis par un autre.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "theologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon cette doctrine, les mérites du Christ sont <w>imputés</w> à tous les fidèles."
                        },
                        {
                            "text": "La tradition théologique affirme que la faute initiale fut <w>imputée</w> à l'ensemble des hommes."
                        }
                    ]
                }
            ]
        }
    ]
}