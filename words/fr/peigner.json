                        "peigner les poils"
                    ]
                },
                {
                    "sense_id": "7775aa14-5d87-3bc2-84d0-09894313395a",
                    "sense_definition": "Passer des fibres textiles comme le lin, la laine ou le chanvre au peigne pour les paralléliser.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cet atelier traditionnel, les artisans continuent de <w>peigner</w> le chanvre à la main."
                        },
                        {
                            "text": "Avant de filer la laine brute, l'ouvrier doit d'abord la <w>peigner</w> avec précaution."
