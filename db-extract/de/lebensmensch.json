                ],
                "senses": [
                    {
                        "sense_id": "6898c198-a58d-37f3-a625-9e894f2ab41b",
                        "entry_id": "fe5da710-b0a9-3e1c-8f3f-d2c19b73230b",
                        "glosses": [
                            "the most important person (whether a relative, a spouse or a friend) in one's life"
                        ],
                        "tags": [
                            "especially",
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "56767eac-1af2-46fe-a7ac-6911a122aed4",
                                "sense_id": "6898c198-a58d-37f3-a625-9e894f2ab41b",
                                "text": "Die gute Fee hört diesen Wunsch und sagt: »Heute Nacht wird ein Wunder geschehen, und der Wunsch wird sich erfüllen.« Tatsächlich geschieht, während man schläft, dieses Wunder, und man merkt beim Aufwachen, dass sich der Lebensmensch verändert hat. Er ist freundlich, zugewandt, geduldig, zärtlich, interessiert und wertschätzend. Er verhält sich wieder wie der Mensch, in den man sich verliebt hat."
                            }
                        ]
                    },
                    {
                        "sense_id": "485911de-0c94-377f-8074-f6a0f6dc9e85",
                        "entry_id": "fe5da710-b0a9-3e1c-8f3f-d2c19b73230b",
                        "glosses": [
                            "a life person; a person who is active in the real world and spends time doing outdoor or social activities"
                        ],
                        "tags": [
                            "masculine",
                            "rare",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "4140b3d0-2eeb-4c46-ac34-d4108417a582",
                                "sense_id": "485911de-0c94-377f-8074-f6a0f6dc9e85",
                                "text": "Und doch begreife ich es hinterdrein, daß es so kam, daß mich der Wunsch plagte, aus den Schranken meiner Natur einmal herauszutreten, nicht bloßer Büchermensch zu bleiben, sondern Lebensmensch zu sein und selbstsicher durch die Welt zu schreiten."
                            }
                        ]
                    }
                ],
