                    }
                ],
                "senses": [
                    {
                        "sense_id": "9610838e-2031-3669-bd1b-7aee6f980888",
                        "entry_id": "cbed6a6d-7e63-31d9-9c39-7db1f2ad9f54",
                        "glosses": [
                            "Petite malle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b40c81e-e3d6-4ef3-a1fe-bd9f1a9f581e",
                                "sense_id": "9610838e-2031-3669-bd1b-7aee6f980888",
                                "text": "J’ai donc demandé à l’entreprise de location de voiture si elle pouvait mettre un employé dans le premier vol du lendemain pour nous apporter la mallette."
                            },
                            {
                                "example_id": "28a5b283-e246-4e42-a757-e5c5fc99c94f",
                                "sense_id": "9610838e-2031-3669-bd1b-7aee6f980888",
                                "text": "La police de Kakegawa, dans le centre du Japon, a été dépêchée sur un parking où se trouvait une mallette métallique."
                            }
                        ]
                    },
                    {
                        "sense_id": "eafd98f3-3fa3-3236-99c4-ff08b1ca0856",
                        "entry_id": "cbed6a6d-7e63-31d9-9c39-7db1f2ad9f54",
                        "glosses": [
                            "Cartable, sac d’école."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea54cb57-6870-49bd-9310-0bb2124b2cb9",
                        "source_entry_id": "cbed6a6d-7e63-31d9-9c39-7db1f2ad9f54",
                        "source_sense_id": "9610838e-2031-3669-bd1b-7aee6f980888",
                        "source_sense_description": "Petite malle.",
                        "target_lang_word": "Handkoffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handkoffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18330393-6d41-37c5-8903-af992410a18e",
                                        "entry_id": "d0143837-4b3a-356c-9bc6-b48179d507cf",
                                        "glosses": [
                                            "Koffer, der aufgrund seiner relativ geringen Größe getragen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd70844a-9bee-43eb-820f-bab71f65c33e",
                                                "sense_id": "18330393-6d41-37c5-8903-af992410a18e",
                                                "text": "„Das Mädchen in den Turnschuhen schwang den Handkoffer über dem Kopf, als sei er federleicht.“"
                                            },
                                            {
                                                "example_id": "dfd33b50-c6f3-4c8a-a085-20d7f8b914bb",
                                                "sense_id": "18330393-6d41-37c5-8903-af992410a18e",
                                                "text": "„Als wir ins Flugzeug stiegen, war seine Hand, mit der er nach meinem Handkoffer faßte, ganz kalt.“"
                                            },
                                            {
                                                "example_id": "a9fe8e82-3cb4-4aa9-b3eb-93aa353fdd62",
                                                "sense_id": "18330393-6d41-37c5-8903-af992410a18e",
                                                "text": "„Sie rauchte eine Weile, legte die Briefe dann vorsichtig in ihren Handkoffer, schloß ihn zu.“"
                                            },
                                            {
                                                "example_id": "303af1e3-bb1e-4fbd-a551-248ae7c6ea6b",
                                                "sense_id": "18330393-6d41-37c5-8903-af992410a18e",
                                                "text": "„Wir sitzen auf gepackten Koffern, genauer, auf einem Handkoffer und drei Rucksäcken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e337f88e-0033-4d4f-a670-c20ff04b15a0",
                        "source_entry_id": "cbed6a6d-7e63-31d9-9c39-7db1f2ad9f54",
                        "source_sense_id": "9610838e-2031-3669-bd1b-7aee6f980888",
                        "source_sense_description": "Petite malle.",
                        "target_lang_word": "Aktenkoffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktenkoffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                        "entry_id": "7ae7f275-915c-35da-8405-91d1fa04b4b6",
                                        "glosses": [
                                            "handliches Transportbehältnis für Akten oder sonstige Schriftstücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd318dfa-c09b-4c71-8bd9-be7ff9f4c62d",
                                                "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                                "text": "Der Vertreter hatte seinen Aktenkoffer dabei."
                                            },
                                            {
                                                "example_id": "4535258c-873d-4599-b147-21b11865468d",
                                                "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                                "text": "„Bekleidet war er mit einer Baseballkappe mit auffälligem X-Emblem, einem schwarzen T-Shirt und einer schwarzen Hose, er trug einen roten Aktenkoffer.“"
                                            },
                                            {
                                                "example_id": "745f509c-19a5-4455-bd05-2e501f2ed959",
                                                "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                                "text": "„Schalck holt eine Versicherungspolice aus dem Aktenkoffer und knallt sie auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "df4333f3-d897-421b-81d7-442d1e3e2bfc",
                                                "sense_id": "569c370b-83ba-3208-b71a-491040b98112",
                                                "text": "„Ich werfe den Aktenkoffer daneben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
