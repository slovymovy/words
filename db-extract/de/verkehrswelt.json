                "senses": [
                    {
                        "sense_id": "b13d79a0-fda1-3f4d-9678-c8fc20d2a116",
                        "entry_id": "df422ded-1561-35b5-a18b-04de1c7280e7",
                        "glosses": [
                            "eine Gesamtheit von Personen, Gegebenheiten und Ereignissen, das Verkehrsgeschehen betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c789dec-8a34-48cc-bb9e-1c034afb8118",
                                "sense_id": "b13d79a0-fda1-3f4d-9678-c8fc20d2a116",
                                "text": "„Wie sieht die Verkehrswelt von morgen vor dem Hintergrund von Individualisierung und Digitalisierung aus?“"
                            },
                            {
                                "example_id": "e169d572-c66c-424e-84a1-18fdaf9d800a",
                                "sense_id": "b13d79a0-fda1-3f4d-9678-c8fc20d2a116",
                                "text": "„Verkehrserziehung vom Kinde aus bedeutet, beim Kinde zu beginnen und es mit allem auszustatten, was es zum kindgerechten, selbstaktiven Hineinwachsen in unsere Verkehrswelt benötigt.“"
                            },
                            {
                                "example_id": "74503978-ccd8-4813-b176-4881e7959d63",
                                "sense_id": "b13d79a0-fda1-3f4d-9678-c8fc20d2a116",
                                "text": "„Wer unbefugt einen Parkplatz für Behinderte blockiert und auch noch uneinsichtig ist, muss sich das gefallen lassen. Auf dieses und weitere besondere Urteile aus der Verkehrswelt, die Deutschlands Richter im Jahr 2012 gesprochen haben, verweisen Rechtsexperten vom ADAC, Auto Club Europa (ACE) und Deutschen Anwaltverein (DAV).“"
                            },
                            {
                                "example_id": "a8b0461b-b4c5-47c1-b162-143173e29460",
                                "sense_id": "b13d79a0-fda1-3f4d-9678-c8fc20d2a116",
                                "text": "„Die Vorstellung, man könnte die Verkehrswelt so sicher machen, daß sie für Kinder keine Gefahr mehr darstellt, wäre ebenso wirklichkeitsfremd, wie wenn man glaubte, Kinder könnten zu absolut sicherem Verhalten erzogen werden.“"
                            },
                            {
                                "example_id": "2ad730fa-6142-404f-8cf7-4cc68b277262",
                                "sense_id": "b13d79a0-fda1-3f4d-9678-c8fc20d2a116",
                                "text": "„Wie der Aufbruch in eine postfossile Verkehrswelt in Deutschland gelingen kann, zeigen Experten des InnoZ in der Studie „Die neue Verkehrswelt“ im Auftrag des Bundesverbandes Erneuerbare Energie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
