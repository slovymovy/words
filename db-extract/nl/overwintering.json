                            {
                                "example_id": "cbce2c46-a0d0-44f1-82d0-c674458fb7a5",
                                "sense_id": "4f4bba4e-eb14-315a-84e8-e80a7b9ccd06",
                                "text": "Het was niet de bedoeling geweest hier lang te blijven, maar alleen totdat ze de omgeving verkend zouden hebben en er een plaats voor een langere, bestendige overwintering gevonden zou zijn."
                            },
                            {
                                "example_id": "a7e47048-910d-4639-8866-fb97dc313046",
                                "sense_id": "4f4bba4e-eb14-315a-84e8-e80a7b9ccd06",
                                "text": "In de Champions League mocht Onana van trainer Erik ten Hag in de voorlaatste groepswedstrijd van de Champions League spelen tegen Besiktas. De Amsterdammers waren toen al zeker van overwintering in het miljardenbal. Ook keepte hij de bekerwedstrijd tegen de amateurs van BVV Barendrecht (4-0 overwinning)."
                            }
                        ]
                    }
