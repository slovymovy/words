                    {
                        "sense_id": "095b0251-ec76-3638-997b-09e59832314a",
                        "entry_id": "e5226187-ebf5-3eb8-ab8a-6640768446c4",
                        "glosses": [
                            "diakritisches Zeichen zur Anzeige eines Nasallautes, vertreten in den Sprachen Altnordisch, Älvdalisch, Apache, Chiricahua, Dogrib, Gwich’in, Litauisch, Mescalero, Navajo, Polnisch und Tutchone"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28d078d7-fcd7-4c57-8ded-b62398db2fa9",
                                "sense_id": "095b0251-ec76-3638-997b-09e59832314a",
                                "text": "Die lateinischen Buchstaben Ą, ą, Ę, ę, Į, į, Ų und ų enthalten ein Ogonek."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad106379-cb21-45c4-9b3d-bdd86797d80c",
