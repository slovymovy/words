                        "examples": [
                            {
                                "example_id": "addbac6a-d3d2-442c-83d1-3d165edc16bd",
                                "sense_id": "5fb84b74-e1fc-3f7c-8470-005a5cbf5470",
                                "text": "The rotations of memory are the commencement of those wonderful revolvings of the intellectual faculties by which the process of reason is carried on."
                            }
                        ]
                    },
                    {
                        "sense_id": "e04d4584-71a0-319e-b8af-a7fdd4c37d78",
                        "entry_id": "fc276134-b77e-345c-b7f1-39b5c2a4232b",
                        "glosses": [
                            "The process where you either take an non-closing linear shape or a 2D shape, take a 3D axis as the pivot, and basically revolve the linear shape around the axis to get a 3D object. (e.g. taking a 2D triangle and turning it into a cone, taking a circle and turning it into a sphere, taking a long U-shape and turning it into a test tube object)"
                        ],
                        "tags": [],
                        "examples": []
