                "senses": [
                    {
                        "sense_id": "ef7b8aaa-f002-3475-9166-5bd1ae325435",
                        "entry_id": "818753e0-4aaf-337b-8a81-6e4083cf673e",
                        "glosses": [
                            "iemand die steelt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "39a50687-803e-4a53-8999-203a167830ef",
                                "sense_id": "ef7b8aaa-f002-3475-9166-5bd1ae325435",
                                "text": "Je hoort ‘m brommen, op het Binnenhof: „Dat gáát maar op vakantie! Wie moet hier nu straks die ladelichters bij de banken betalen? De schoolboeken en de kinderopvang?”"
                            },
                            {
                                "example_id": "f2e041e6-fd23-4fb6-b3fc-ed34a7d8ca17",
                                "sense_id": "ef7b8aaa-f002-3475-9166-5bd1ae325435",
                                "text": "Nu naar Trump. Wel iemand anders! Toen hij de kandidaat van de Republikeinen werd, stonden een paar Nederlandse politieke leiders met hun neus vooraan om stevige taal over hem uit te slaan. Pechtold, Samsom en Zijlstra. Ze noemden Trump een ’mafklapper’, een charlatan en een ladelichter. Dat waren nog eens teksten. Trump zal ze hebben bewaard."
                            }
                        ]
                    }
                ],
