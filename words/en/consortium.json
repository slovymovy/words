                            },
                            {
                                "target_lang_word": "консорциум",
                                "target_lang_sense_clarification": "в контексте семейного права"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad3f7461-0ea4-3f73-baa7-8ffcfed97f56",
                    "sense_definition": "A group of different microbes living together in a symbiotic relationship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The microbial <w>consortium</w> in the soil helps break down complex organic pollutants.",
                            "target_lang_translations": {
                                "ru": "Микробный <w>консорциум</w> в почве помогает расщеплять сложные органические загрязнители."
                            }
                        },
                        {
                            "text": "Scientists are studying how this bacterial <w>consortium</w> functions as a single unit.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают, как этот бактериальный <w>консорциум</w> функционирует как единое целое."
                            }
                        }
                    ],
                    "common_phrases": [
