                        "tags": [
                            "comparative"
                        ],
                        "form": "невзыска́тельней"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffa5f6d8-5313-3057-9992-ce0ca53f89c4",
                        "entry_id": "48f544ec-8f06-3a57-b82e-2e6de2c870d7",
                        "glosses": [
                            "удовлетворяющийся немногим, нетребовательный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf144729-f5d8-487a-ad5f-56bdff45e930",
                                "sense_id": "ffa5f6d8-5313-3057-9992-ce0ca53f89c4",
                                "text": "Ты непрестанно встречаешься с вероломством их, за исключением немногих из них. Прости им будь невзыскателен."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a133372c-a0fb-4641-aca9-7560349c16f9",
                        "source_entry_id": "48f544ec-8f06-3a57-b82e-2e6de2c870d7",
                        "source_sense_id": "ffa5f6d8-5313-3057-9992-ce0ca53f89c4",
                        "target_lang_word": "undemanding",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undemanding",
