                "senses": [
                    {
                        "sense_id": "294b77c8-a76b-339a-981f-d13f3fa78b5b",
                        "entry_id": "9bcd51a3-9286-3d0d-9d17-317ba620feb0",
                        "glosses": [
                            "Cicuta, roślina o pierzastych liściach, drobnych, białych kwiatach zebranych w baldachy, zawierająca silnie trujące alkaloidy"
                        ],
                        "tags": [],
