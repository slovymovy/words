                                        "sense_id": "113db28d-080e-3adb-a8e0-c3f62acc032e",
                                        "entry_id": "df71f1f3-d23c-3ad1-a2f0-2a212d0102a8",
                                        "glosses": [
                                            "A male given name from Latin, borne by an early pope and by several saints."
                                        ],
                                        "tags": [
                                            "countable",
