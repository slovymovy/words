                                                "sense_id": "000a778a-5146-3610-ac33-36f6db6b49d4",
                                                "text": "Kies!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18e90fac-d77d-3044-bf68-89ed0612128d",
                                        "entry_id": "69bbd09a-3761-3a07-8cbc-3951e9416e35",
                                        "glosses": [
                                            "tweede persoon enkelvoud tegenwoordige tijd van kiezen"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "inversion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dccfd50b-43f4-4f23-8af6-63ac6fb052bf",
                                                "sense_id": "18e90fac-d77d-3044-bf68-89ed0612128d",
                                                "text": "Kies je?"
                                            },
                                            {
                                                "example_id": "0cdef260-6ee7-40ea-822f-23086f5810d9",
                                                "sense_id": "18e90fac-d77d-3044-bf68-89ed0612128d",
                                                "text": "'Er is niks om toe te geven,' kies ik ten slotte."
                                            },
                                            {
                                                "example_id": "483a4d04-be54-4543-8173-6246bb25701b",
                                                "sense_id": "18e90fac-d77d-3044-bf68-89ed0612128d",
                                                "text": "Kies je eigen weg, maak je eigen keuzes, leer je eigen lessen."
                                            }
                                        ]
                                    }
