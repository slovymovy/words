                                        "entry_id": "e8c5d3ce-e511-392d-a2a8-afb4c8f229a0",
                                        "glosses": [
                                            "Equality; comparability of strength or intensity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00bcb048-e678-4c87-9e16-6740dfe73c11",
                                                "sense_id": "558ccdb3-82ba-3e17-8af7-d49dc6f832e5",
                                                "text": "Altogether, Microsoft claims a 99% feature parity between 32-bit and 64-bit editions."
                                            },
                                            {
                                                "example_id": "c4c150b9-9b94-4be0-860a-f0963dc0ade5",
                                                "sense_id": "558ccdb3-82ba-3e17-8af7-d49dc6f832e5",
                                                "text": "For all their frailty at the back, Arsenal possessed genuine menace in attack and they carved through Chelsea with ease to restore parity nine minutes before half-time. Aaron Ramsey's pass was perfection and Gervinho took the unselfish option to set up Van Persie for a tap-in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40ac4173-c100-3f5a-963f-9856fdf0ed39",
                                        "entry_id": "e8c5d3ce-e511-392d-a2a8-afb4c8f229a0",
                                        "glosses": [
                                            "Senses related to classification into two sets.",
                                            "A set with the property of having all of its elements belonging to one of two disjoint subsets, especially a set of integers split in subsets of even and odd elements."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "106d690f-6918-4462-ad65-bbe73f81e695",
                                                "sense_id": "40ac4173-c100-3f5a-963f-9856fdf0ed39",
                                                "text": "Parity is always preserved in such operations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97863122-3023-3077-973d-aeaf5baa4f92",
                                        "entry_id": "e8c5d3ce-e511-392d-a2a8-afb4c8f229a0",
                                        "glosses": [
                                            "Senses related to classification into two sets.",
                                            "The classification of an element of a set with parity into one of the two sets."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28115005-4c88-40d9-8bd0-6a08ee419a95",
                                                "sense_id": "97863122-3023-3077-973d-aeaf5baa4f92",
                                                "text": "The particles' parities can switch at random."
                                            }
                                        ]
