                "senses": [
                    {
                        "sense_id": "da6d1ed7-4ae4-38b0-8629-c017ba1da133",
                        "entry_id": "0d00370f-4e88-3dd3-a147-2664abbdb882",
                        "glosses": [
                            "französische Bezeichnung der Untergrundbahn, vor allem in Paris und Moskau"
                        ],
                        "tags": [
                            "Bahn"
                        ],
                        "examples": [
                            {
                                "example_id": "1018fdfe-06c0-4ded-ae40-3edf351148a7",
                                "sense_id": "da6d1ed7-4ae4-38b0-8629-c017ba1da133",
                                "text": "„Und als ich die riesige Hakenkreuzfahne sah auf dem Place de la Concorde, da kroch ich ins Dunkel der Metro.“"
                            },
                            {
                                "example_id": "7964e0d8-688a-4bb3-92c1-4d2bd91680b4",
                                "sense_id": "da6d1ed7-4ae4-38b0-8629-c017ba1da133",
                                "text": "„Die Fahrt mit der Metro war lang und stickig gewesen, und Sylvia rann unter der Leinenbluse der Schweiß den Rücken hinunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4067ded8-ef50-4a38-b7dd-476fed108896",
                        "source_entry_id": "0d00370f-4e88-3dd3-a147-2664abbdb882",
                        "source_sense_id": "da6d1ed7-4ae4-38b0-8629-c017ba1da133",
                        "source_sense_description": "französische Bezeichnung der Untergrundbahn",
                        "target_lang_word": "métro",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06bd8ed4-3e3c-302d-bbd1-04c41150fcc8",
                                        "entry_id": "f3395e0a-937b-3bed-aa95-69c084e3a8d4",
                                        "glosses": [
                                            "Mesure en poésie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8939ecb2-fb7b-4bbd-8a26-03ae41611e38",
                                                "sense_id": "06bd8ed4-3e3c-302d-bbd1-04c41150fcc8",
                                                "text": "L'épopée n’emploie que le langage pur et simple (07), ou les mètres, soit qu’elle mélange ceux-ci entre eux, ou qu'elle ne vienne à mettre en usage qu’un seul genre de métro, comme on l’a fait jusqu'à présent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "métro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf3e7abe-fb26-39c0-b6a4-fc421d0c6e9e",
                                        "entry_id": "5c1b1767-1d13-3e49-be4d-36db8848b34a",
                                        "glosses": [
                                            "Chemin de fer métropolitain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc50f2c6-97de-4d88-b3b8-b304c75b614c",
                                                "sense_id": "bf3e7abe-fb26-39c0-b6a4-fc421d0c6e9e",
                                                "text": "[Le phénomène d’inertie] C’est en vertu de ce principe que nous embrassons avec confusion la dame d’en face aux arrêts subits du métro."
                                            },
                                            {
                                                "example_id": "f12a41ce-409e-4d5d-91d5-7eccccfda8a9",
                                                "sense_id": "bf3e7abe-fb26-39c0-b6a4-fc421d0c6e9e",
                                                "text": "Le métro c’est un train vitré, éclairé, actionné à l’électricité; il zizague sous terre dans d’infinis tunnels, comme un ver."
                                            },
                                            {
                                                "example_id": "6eb66cbc-cb30-479d-9b9e-a444db21a3d5",
                                                "sense_id": "bf3e7abe-fb26-39c0-b6a4-fc421d0c6e9e",
                                                "text": "Mais un sous sol organisé comme on le fait le plus souvent pour faciliter simplement l'accès, cela aurait pu être une station de métro, une immense station de métro avec un plafond bas, l’impression d’étouffer."
                                            },
                                            {
                                                "example_id": "d76c9417-9f26-41ad-a49f-e319502de8ce",
                                                "sense_id": "bf3e7abe-fb26-39c0-b6a4-fc421d0c6e9e",
                                                "text": "Ali et moi déambulons sous le tablier du métro aérien qui abrite, entre les étals du marché, les bicraves, les petits trafics du trabendo, […]."
                                            },
                                            {
                                                "example_id": "3df77d29-8536-4280-a0c4-ba4ad3e028b3",
                                                "sense_id": "bf3e7abe-fb26-39c0-b6a4-fc421d0c6e9e",
                                                "text": "Même problématique pour le prix des titres d’accès au métro parisien, et notamment celui du forfait mensuel connu sous le nom de carte orange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35c5896f-29c8-387a-aa94-62be5d0fbc51",
                                        "entry_id": "5c1b1767-1d13-3e49-be4d-36db8848b34a",
                                        "glosses": [
                                            "Train d’un service de chemin de fer métropolitain."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9524f93f-8b64-4584-b383-d1da4c662441",
                                                "sense_id": "35c5896f-29c8-387a-aa94-62be5d0fbc51",
                                                "text": "Dès huit heures du matin, on se pressait dans le métro en bourrant tous les Parisiens maussades à l'idée d'aller au travail pour leur piquer les place assises. Parfois, on s'asseyait sur les strapontins et on y restait même en pleine affluence, […]."
                                            },
                                            {
                                                "example_id": "2d8352f7-8c24-4b20-aaf5-7f127f2d8371",
                                                "sense_id": "35c5896f-29c8-387a-aa94-62be5d0fbc51",
                                                "text": "Dans combien de temps arrive le prochain métro ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5f03dd7-de08-3922-a969-cf3387f6d31e",
                                        "entry_id": "5c1b1767-1d13-3e49-be4d-36db8848b34a",
                                        "glosses": [
                                            "Les trains d’un service de chemin de fer métropolitain."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74bfb298-257c-43fc-baa6-116c24cff2eb",
                                                "sense_id": "f5f03dd7-de08-3922-a969-cf3387f6d31e",
                                                "text": "Et de toute façon, ce n’est pas comme si le métro de New York était plein de lecteurs de Joyce ou même d'Hemingway. (avril 2004 — Culture Libre, Lawrence Lessig, traduction wikisource)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd53fd95-299f-3119-8c1b-acbc7cff8ad8",
                                        "entry_id": "5c1b1767-1d13-3e49-be4d-36db8848b34a",
                                        "glosses": [
                                            "Station ou gare où les trains d’un service de chemin de fer métropolitain s’arrêtent."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee6f9a2f-7868-4ac8-bacc-29b5a8be0fb0",
                                                "sense_id": "fd53fd95-299f-3119-8c1b-acbc7cff8ad8",
                                                "text": "Je sors à l’instant du métro, je te rejoins tout de suite."
                                            },
                                            {
                                                "example_id": "faa2aeed-71e7-4e25-b74a-01ce4d80b83b",
                                                "sense_id": "fd53fd95-299f-3119-8c1b-acbc7cff8ad8",
                                                "text": "Le dedans de l’homme c’est un métro, y a des étages et des étages, à mesure qu’on va plus bas on se dégoûte davantage, mais y a quand même des distributeurs même au plus bas, avec du chocolat, des petits jouirs, des bonbons…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe0ae758-6d0d-3c26-84b3-99cd7deb3f2c",
                                        "entry_id": "5c1b1767-1d13-3e49-be4d-36db8848b34a",
                                        "glosses": [
                                            "Ligne d’un service de chemin de fer métropolitain."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "335a0ef6-4477-4d0b-bf7c-b5414432a3c5",
                                                "sense_id": "fe0ae758-6d0d-3c26-84b3-99cd7deb3f2c",
                                                "text": "Je prends quel métro pour arriver chez toi ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3052791a-bb89-3bdb-b93d-5d3662cd3ef0",
                                        "entry_id": "5c1b1767-1d13-3e49-be4d-36db8848b34a",
                                        "glosses": [
                                            "Service de transport public qui dessert une ville."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd4741d8-c02b-40ff-9b73-fd9713ca8bd2",
                                                "sense_id": "3052791a-bb89-3bdb-b93d-5d3662cd3ef0",
                                                "text": "Il faudra se débrouiller avec le métro."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "métro",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0959826c-10da-337e-aca4-e0d864a50f3e",
                                        "entry_id": "6621ddc2-6ae3-3030-bd1e-3d682b217453",
                                        "glosses": [
                                            "Métropole, mère-patrie."
                                        ],
                                        "tags": [
                                            "Antilles"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fdf25b01-a7cb-3a8e-a4e2-1e62d816b216",
                                        "entry_id": "6621ddc2-6ae3-3030-bd1e-3d682b217453",
                                        "glosses": [
                                            "Métropolitain."
                                        ],
                                        "tags": [
                                            "Antilles",
                                            "La Réunion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d53ca6aa-db02-4e51-a0d9-bff8eb2e48b0",
                                                "sense_id": "fdf25b01-a7cb-3a8e-a4e2-1e62d816b216",
                                                "text": "Camille eut honte. Ainsi ce type était-il un Métro ! Ce sale con était un putain de Zorey. Tout comme elle."
                                            },
                                            {
                                                "example_id": "0f12e6f4-f6d8-4acd-9790-f90a937f60bf",
                                                "sense_id": "fdf25b01-a7cb-3a8e-a4e2-1e62d816b216",
                                                "text": "Pour notre entrée en Guadeloupe, nous avions choisi des vêtements de lin blanc, chiffonnées après un long voyage, mais blanc et - mon Dieu pardon ! - nous avions une belle allure ! Un beau couple de « métros », fraîchement débarqués et qui écarquillent les yeux à travers les vitres du taxi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c76dd47-acae-3b37-9dc5-52d3d5823ef0",
                                        "entry_id": "6621ddc2-6ae3-3030-bd1e-3d682b217453",
                                        "glosses": [
                                            "Unité monétaire de France, franc français."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
