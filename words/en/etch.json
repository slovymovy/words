                    "frequency": "Middle",
                    "semantic_group_id": "engrave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craftsman used a sharp tool to <w>etch</w> intricate floral patterns into the silver tray."
                        },
                        {
                            "text": "She decided to <w>etch</w> the couple's wedding date onto the back of the watch."
                        }
                    ],
                    "synonyms": [
                        "engrave",
                        "incise",
                        "carve",
                        "inscribe"
                    ],
                    "common_phrases": [
