                    {
                        "form_id": "0c2ac525-2483-498f-bdb1-d22927fb9a1b",
                        "entry_id": "fa48b74e-8067-36a8-92d4-813e3a510e05",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Apokryphen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20e40bdd-ee83-3bac-86e8-2fc8e4195e67",
                        "entry_id": "fa48b74e-8067-36a8-92d4-813e3a510e05",
                        "glosses": [
                            "antike Schrift, die von biblischen Themen, Ereignissen oder Personen handelt, aber nicht in die Bibel (das heißt den Bibelkanon) aufgenommen wurde"
                        ],
                        "tags": [
                            "Theologie",
                            "meist allgemein im Plural verwendet"
                        ],
                        "examples": [
                            {
                                "example_id": "3e461c47-ad19-4e9c-add6-e5a3a88528a9",
                                "sense_id": "20e40bdd-ee83-3bac-86e8-2fc8e4195e67",
                                "text": "„Der literarische Wert und das hohe Niveau in Fragen des Glaubens und der Sitten stehen oft dem kanonisierten Alten Testament in keiner Weise nach, so daß die Frage offen bleibt, warum diese oder jene Apokryphe nicht zu den heiligen Schriften zählt.“"
                            },
                            {
                                "example_id": "ce7fe6e1-48e0-4e36-bec9-6965e8a23380",
                                "sense_id": "20e40bdd-ee83-3bac-86e8-2fc8e4195e67",
                                "text": "„Die in der Septuaginta enthaltenen, aber von der jüdischen Gemeinde in den Kanon nicht aufgenommenen Schriften bezeichnet man als Apokryphen, d. h. als verborgene, von der öffentlichen Verbreitung ausgeschlossene Schriften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acfe6fbd-fa7e-46e1-bc92-3b600bc792d8",
                        "source_entry_id": "fa48b74e-8067-36a8-92d4-813e3a510e05",
                        "source_sense_id": "20e40bdd-ee83-3bac-86e8-2fc8e4195e67",
                        "source_sense_description": "antike Schrift, mit biblischen Themen, aber nicht in die Bibelkanon aufgenommen",
                        "target_lang_word": "apocrypha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apocrypha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc7a80f5-1080-3138-bae9-20ef7555918d",
                                        "entry_id": "4c516710-9461-38d8-a4aa-8fdc9eecd518",
                                        "glosses": [
                                            "plural of apocryphon"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "apocrypha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f05776b-35a8-3dab-a04c-213543305a63",
                                        "entry_id": "230c3046-c1f5-3e19-ad56-8f99eb79ba8c",
                                        "glosses": [
                                            "Something, as a writing, that is of doubtful authorship or authority (formerly also used attributively)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f10043fd-f257-44f4-b22e-b77930d34d50",
                                                "sense_id": "9f05776b-35a8-3dab-a04c-213543305a63",
                                                "text": "But it may be objected, that these books being in the Jews' canon , ought to be acknowledged for divinely inspired , rather than the apocryphas that never were in it"
                                            },
                                            {
                                                "example_id": "9ee2bbb4-ca76-430f-b62d-e1df78bfb2b8",
                                                "sense_id": "9f05776b-35a8-3dab-a04c-213543305a63",
                                                "text": "Our entymological^([sic – meaning etymological]) approaches to the I or Change in the I Ching seem to confirm one of the well known apocryphas, I-Wei Ch'ien tso-tu."
                                            },
                                            {
                                                "example_id": "5f7476c6-362f-442d-9288-39821e07c45d",
                                                "sense_id": "9f05776b-35a8-3dab-a04c-213543305a63",
                                                "text": "Parts of the city were unearthed and we could clearly see an almost square citadel with massive walls and a deep moat, beyond which were the outer residential quarters, shopping centre, etc. This made me think of an apocrypha of the Bogomil teaching: 'I, the prophet Isaiah, blessed among the prophets by our Lord God Jesus Christ, have come by the Will of God to tell you what will happen in the last days of the human race...' He was talking of an uncertain future, while here before us we had a tale of realities of the past."
                                            },
                                            {
                                                "example_id": "bd59f052-ea0b-4580-9769-792ca2ec3ec6",
                                                "sense_id": "9f05776b-35a8-3dab-a04c-213543305a63",
                                                "text": "We are the women\nwith thread bags\nanchored deep in our bosoms\ncontaining blood agreements\nsilver coins and cloves of garlic\nand an apocrypha\nof Nanny’s secrets."
                                            },
                                            {
                                                "example_id": "fa5931ad-8b27-4774-b35c-25e81308cf0d",
                                                "sense_id": "9f05776b-35a8-3dab-a04c-213543305a63",
                                                "text": "The story of the Arsenal mural has drifted, over the years, into something more closely resembling a myth. What should be straightforward details are now shrouded in fog, tangled by apocrypha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acdcf9e5-7855-4522-b318-c20f5cf4d772",
                        "source_entry_id": "fa48b74e-8067-36a8-92d4-813e3a510e05",
                        "source_sense_id": "20e40bdd-ee83-3bac-86e8-2fc8e4195e67",
