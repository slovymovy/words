                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d35e103-5475-455b-bb2c-df03003e4d64",
                                                "sense_id": "0d7db4b4-2822-3a82-8af7-d356eca07ea8",
                                                "text": "Zklamal jsi mě, potom ale nečekej, že ti pomohu, až to budeš potřebovat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "potom",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "eef2a317-5e5a-36d1-82c5-ec183791b73b",
                                        "entry_id": "79e720d6-b171-3cce-8f76-fe1a5a88e5b1",
                                        "glosses": [
                                            "pak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d38e89-2c68-4916-a043-7a86ee95c897",
                                                "sense_id": "eef2a317-5e5a-36d1-82c5-ec183791b73b",
                                                "text": "Potom se to má povést, když ani nejsi schopný se plně soustředit!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
