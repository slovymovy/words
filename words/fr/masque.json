                    "frequency": "High",
                    "semantic_group_id": "visage_artifice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour la fête de carnaval, chaque enfant a fabriqué un magnifique <w>masque</w> d'animal."
                        },
                        {
                            "text": "Il portait un <w>masque</w> noir pour ne pas être reconnu pendant le bal."
                        }
                    ],
                    "synonyms": [
                        "loup"
                    ],
                    "common_phrases": [
