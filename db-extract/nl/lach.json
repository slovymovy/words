                        "sense_id": "ffbf57d2-cebd-3cab-8cd9-ed175340c1df",
                        "entry_id": "38e36bf0-02db-3baf-bed2-9644509df552",
                        "glosses": [
                            "een vrolijkheidsuiting door middel van het optrekken van de mondhoeken en vaak het voortbrengen van een geluid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9715da-b520-4ba0-952c-dce92814fe53",
                                "sense_id": "ffbf57d2-cebd-3cab-8cd9-ed175340c1df",
                                "text": "Na een paar lachen ging hij weer verder met zijn werk."
                            },
                            {
                                "example_id": "31ae69c4-a7e2-4378-81a3-556b20b3deab",
                                "sense_id": "ffbf57d2-cebd-3cab-8cd9-ed175340c1df",
                                "text": "' Haar lach stierf weg."
                            },
                            {
                                "example_id": "372452cc-2bb2-43ec-8ef8-b863c6060e31",
                                "sense_id": "ffbf57d2-cebd-3cab-8cd9-ed175340c1df",
                                "text": "' Haar lach stierf weg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b2a3bf8-5e76-4025-9ec5-554c8394900b",
                        "source_entry_id": "38e36bf0-02db-3baf-bed2-9644509df552",
                        "source_sense_id": "ffbf57d2-cebd-3cab-8cd9-ed175340c1df",
                        "source_sense_description": "een vrolijkheidsuiting door middel van het optrekken van de mondhoeken en vaak het voortbrengen van een geluid",
                        "target_lang_word": "laugh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laugh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a67b7f5-8e80-34ef-aaf9-2c9ca683fdda",
                                        "entry_id": "1ba2316a-9bee-3f4e-bbc8-a8a4275f5abc",
                                        "glosses": [
                                            "An expression of mirth particular to the human species; the sound heard in laughing; laughter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d4b67d9-8654-4cb0-8d84-5d94fd61de95",
                                                "sense_id": "9a67b7f5-8e80-34ef-aaf9-2c9ca683fdda",
                                                "text": "And the loud laugh that spoke the vacant mind."
                                            },
                                            {
                                                "example_id": "2f8a6aac-eecd-4b00-92c7-696d0477e016",
                                                "sense_id": "9a67b7f5-8e80-34ef-aaf9-2c9ca683fdda",
                                                "text": "That man is a bad man who has not within him the power of a hearty laugh."
                                            },
                                            {
                                                "example_id": "4b17dc3f-51b5-4e93-80ad-b02abde51936",
                                                "sense_id": "9a67b7f5-8e80-34ef-aaf9-2c9ca683fdda",
                                                "text": "His deep laughs boomed through the room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfa551de-7fe1-31d0-b988-d1633cd65375",
                                        "entry_id": "1ba2316a-9bee-3f4e-bbc8-a8a4275f5abc",
                                        "glosses": [
                                            "Something that provokes mirth or scorn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d26bdf35-1bfb-4f79-a362-40b58ddacd79",
                                                "sense_id": "dfa551de-7fe1-31d0-b988-d1633cd65375",
                                                "text": "“And this rug,” he says, stomping on an old rag carpet. “How much do you suppose that cost?” ¶ It was my first guess, so I said fifty dollars. ¶ “That’s a laugh,” he said. “I paid two thousand for that rug.”"
                                            },
                                            {
                                                "example_id": "e2ccc405-eb2b-4249-a5a8-52f3c1f8a234",
                                                "sense_id": "dfa551de-7fe1-31d0-b988-d1633cd65375",
                                                "text": "Life's a piece of shit / When you look at it / Life's a laugh and death's a joke, it's true."
                                            },
                                            {
                                                "example_id": "3db1f659-5f8f-4452-814b-2d6c04bdecfc",
                                                "sense_id": "dfa551de-7fe1-31d0-b988-d1633cd65375",
                                                "text": "Your new hat's an absolute laugh, dude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1991eb84-e4e0-34c5-beff-d301c8f15dc7",
                                        "entry_id": "1ba2316a-9bee-3f4e-bbc8-a8a4275f5abc",
                                        "glosses": [
                                            "A fun person."
                                        ],
                                        "tags": [
                                            "British",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eefc2703-1402-4c37-8ed1-d983b7b15afc",
                                                "sense_id": "1991eb84-e4e0-34c5-beff-d301c8f15dc7",
                                                "text": "a good laugh"
                                            },
                                            {
                                                "example_id": "d97b9c85-0522-403c-aa79-edecc0a1c10d",
                                                "sense_id": "1991eb84-e4e0-34c5-beff-d301c8f15dc7",
                                                "text": "2010, The Times, March 14, 2010, Tamzin Outhwaite, the unlikely musical star\nOuthwaite is a good laugh, yes, she knows how to smile: but deep down, she really is strong and stern."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laugh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56cb3368-b51c-3eac-9749-5446d13f9d81",
                                        "entry_id": "5239e6b9-3c75-34ca-9e55-49671e80ce7a",
                                        "glosses": [
                                            "To show mirth, satisfaction, or derision, by peculiar movement of the muscles of the face, particularly of the mouth, causing a lighting up of the face and eyes, and usually accompanied by the emission of explosive or chuckling sounds from the chest and throat; to indulge in laughter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f493c43f-07cb-4439-a0e2-cbc7f34871af",
                                                "sense_id": "56cb3368-b51c-3eac-9749-5446d13f9d81",
                                                "text": "There were many laughing children running on the school grounds."
                                            },
                                            {
                                                "example_id": "bdbbe1cf-4f94-4f38-98a9-2afefea07618",
                                                "sense_id": "56cb3368-b51c-3eac-9749-5446d13f9d81",
                                                "text": "But there was ſuch laughing, Queen Hecuba laught that her eyes ran ore."
                                            },
                                            {
                                                "example_id": "08c139da-ad2b-4e61-a26f-7397e933fb3e",
                                                "sense_id": "56cb3368-b51c-3eac-9749-5446d13f9d81",
                                                "text": "The waves beside them danced, but they / Outdid the sparkling waves in glee:— / A Poet could not but be gay / In such a laughing company: […]"
                                            },
                                            {
                                                "example_id": "e96a40ec-55fd-4430-bb0f-6524d70bd995",
                                                "sense_id": "56cb3368-b51c-3eac-9749-5446d13f9d81",
                                                "text": "The roars of laughter which greeted his proclamation were of two qualities; some men laughing because they knew all about cuckoo-clocks, and other men laughing because they had concluded that the eccentric Jake had been victimised by some wise child of civilisation."
                                            },
                                            {
                                                "example_id": "e2c66fc7-c3ec-4905-9b61-aad4caf263cc",
                                                "sense_id": "56cb3368-b51c-3eac-9749-5446d13f9d81",
                                                "text": "If life seems jolly rotten / There's something you've forgotten / And that's to laugh and smile and dance and sing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45ea74af-e287-353b-a830-81c0eb2bdee3",
                                        "entry_id": "5239e6b9-3c75-34ca-9e55-49671e80ce7a",
                                        "glosses": [
                                            "To be or appear cheerful, pleasant, mirthful, lively, or brilliant; to sparkle; to sport."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65e82a1e-7549-4bac-b6dd-259a59040e3f",
                                                "sense_id": "45ea74af-e287-353b-a830-81c0eb2bdee3",
                                                "text": "The green ſtem grows in ſtature and in ſize, / But only feeds with hope the farmer's eyes; / Then laughs the childiſh year with flow'rets crowned, / And laviſhly prefumes the fields around, / But no ſubſtantial nouriſhment receives, / Infirm the ſtalks, unſolid are the leaves."
                                            },
                                            {
                                                "example_id": "3ed172e0-6fe2-4807-95e3-d1422ca5a3a2",
                                                "sense_id": "45ea74af-e287-353b-a830-81c0eb2bdee3",
                                                "text": "In Folly’s Cup ſtill laughs the Bubble, Joy; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "047c41de-250b-3046-9887-4cb26009acaa",
                                        "entry_id": "5239e6b9-3c75-34ca-9e55-49671e80ce7a",
                                        "glosses": [
                                            "To make an object of laughter or ridicule; to make fun of; to deride; to mock."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b48c456-a838-4b63-94a1-35c5f79068ba",
                                                "sense_id": "047c41de-250b-3046-9887-4cb26009acaa",
                                                "text": "Don't laugh at my new hat, man!"
                                            },
                                            {
                                                "example_id": "e7a38d48-6604-4b11-8f12-c0096952f340",
                                                "sense_id": "047c41de-250b-3046-9887-4cb26009acaa",
                                                "text": "No Wit to flatter, left of all his ſtore! / No Fool to laugh at, which he valued more. / There, victor of his health, of fortune, friends, / And fame, this lord of uſeleſs, thouſands ends."
                                            },
                                            {
                                                "example_id": "c782c4d9-2b5b-4763-891e-7f676aba6a93",
                                                "sense_id": "047c41de-250b-3046-9887-4cb26009acaa",
                                                "text": "There was something about him, Harry, that amused me. He was such a monster. You will laugh at me, I know, but I really went in and paid a whole guinea for the stage-box. To the present day I can't make out why I did so; [...]"
                                            },
                                            {
                                                "example_id": "e77da9df-bdd2-472f-8382-e488ab0a5321",
                                                "sense_id": "047c41de-250b-3046-9887-4cb26009acaa",
                                                "text": "On the corner is a banker with a motorcar / The little children laugh at him behind his back"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "909f7c2c-5ebb-3cda-8123-b142d2657a5b",
                                        "entry_id": "5239e6b9-3c75-34ca-9e55-49671e80ce7a",
                                        "glosses": [
                                            "To affect or influence by means of laughter or ridicule."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dd4b735-0b49-4fc3-b375-d5d83da45409",
                                                "sense_id": "909f7c2c-5ebb-3cda-8123-b142d2657a5b",
                                                "text": "Will you laugh me aſleepe, for I am very heauy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcd0ef45-8cee-35ae-973f-6e5b09c94e44",
                                        "entry_id": "5239e6b9-3c75-34ca-9e55-49671e80ce7a",
                                        "glosses": [
                                            "To express by, or utter with, laughter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d4fac3-53d1-495e-9e8f-6cc36a7a4995",
                                                "sense_id": "fcd0ef45-8cee-35ae-973f-6e5b09c94e44",
                                                "text": "From his deepe cheſt laughes out a lowd applauſe, [...]"
                                            },
                                            {
                                                "example_id": "ad2dda7a-24ff-4fc4-8caa-ac60697e88df",
                                                "sense_id": "fcd0ef45-8cee-35ae-973f-6e5b09c94e44",
                                                "text": "Fairfax addressed her as \"my lady,\" she laughed her musical laugh, and glanced up at a picture of Gerald with eyes full of exultation."
                                            },
                                            {
                                                "example_id": "bf62d099-cdf0-47f8-ac2b-21db4e029c49",
                                                "sense_id": "fcd0ef45-8cee-35ae-973f-6e5b09c94e44",
                                                "text": "\"You refuse to take me seriously,\" Lute said, when she had laughed her appreciation. \"How can I take that Planchette rigmarole seriously?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
