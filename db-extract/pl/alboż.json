            {
                "entry_id": "80d9d284-5cd3-3698-93be-4423539c3b1d",
                "word": "alboż",
                "pos": "particle",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "866c13a1-454e-323b-8159-0b5fd649701a",
                        "entry_id": "80d9d284-5cd3-3698-93be-4423539c3b1d",
                        "glosses": [
                            "verstärkt eine Frage; denn, etwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afe579ed-a371-434b-9355-faaddee1cc61",
                                "sense_id": "866c13a1-454e-323b-8159-0b5fd649701a",
                                "text": "„Alboż to daleko do Wielkiejnocy? Zleci, jak z bicza strzelił! “",
                                "translation": "Ist es denn noch weit bis Ostern? Das vergeht im Nu!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ec5bd59-6944-4f80-9838-4feaf0c98ee6",
                        "source_entry_id": "80d9d284-5cd3-3698-93be-4423539c3b1d",
                        "source_sense_id": "866c13a1-454e-323b-8159-0b5fd649701a",
                        "source_sense_description": "verstärkt eine Frage; denn, etwa",
                        "target_lang_word": "denn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "denn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42f64363-262f-33a3-9e8d-a3498e43e049",
                                        "entry_id": "e8780cfd-1fe6-3727-affc-5c7515b854ab",
                                        "glosses": [
                                            "leitet einen Hauptsatz ein, der den Grund für das, was vorher festgestellt wurde, liefert"
                                        ],
                                        "tags": [
                                            "kausale Hauptsatzkonjunktion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6790e748-bd60-478f-85c9-ee74eebe74f0",
                                                "sense_id": "42f64363-262f-33a3-9e8d-a3498e43e049",
                                                "text": "Max geht es schlecht, denn er hat einen ganzen Kuchen gegessen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "denn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8810676-5ef7-31b4-8851-48608b9540bb",
                                        "entry_id": "b50557c5-9723-3d63-8d11-64ab60a64d5d",
                                        "glosses": [
                                            "Partikel in Fragesätzen, die die Anteilnahme des Sprechers ausdrückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc3d930-acd7-4671-a42a-e49d469a28e9",
                                                "sense_id": "d8810676-5ef7-31b4-8851-48608b9540bb",
                                                "text": "Was hast du denn?"
                                            },
                                            {
                                                "example_id": "13737544-3cc5-430d-9285-e57bb110bd53",
                                                "sense_id": "d8810676-5ef7-31b4-8851-48608b9540bb",
                                                "text": "Kannst du denn nicht mehr laufen?"
                                            },
                                            {
                                                "example_id": "17337823-e996-436c-8b9d-293ae89cb56d",
                                                "sense_id": "d8810676-5ef7-31b4-8851-48608b9540bb",
                                                "text": "„Wos is er denn, wos hat er denn, was kann er denn, wos mocht er denn, wos red er denn, wer glaubt er, daß er is.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9079db1b-dc56-3a73-9e7f-024ff2333b83",
                                        "entry_id": "b50557c5-9723-3d63-8d11-64ab60a64d5d",
                                        "glosses": [
                                            "Partikel in Fragesätzen, die die Dringlichkeit der Frage ausdrückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f9a39e2-74db-47a3-b39c-16904be42492",
                                                "sense_id": "9079db1b-dc56-3a73-9e7f-024ff2333b83",
                                                "text": "Wo bleibt er denn?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "98eec9cf-ba72-3835-bc31-dc6cad2aa7b3",
                                        "entry_id": "b50557c5-9723-3d63-8d11-64ab60a64d5d",
                                        "glosses": [
                                            "Partikel, die eine Folgerung ausdrückt, deren Begründung meist als vorausgesetzt angesehen oder nur angedeutet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98e8a7cd-d5fb-4be9-8def-35a891360683",
                                                "sense_id": "98eec9cf-ba72-3835-bc31-dc6cad2aa7b3",
                                                "text": "„Es ist unter euch allen, die ihr denn doch nur Naturalisten und Pfuscher seid, keiner, der nicht mehr oder weniger Hoffnung von sich gäbe; denn soviel ich alle beurteilen kann, so ist kein einziger Stock darunter, und Stöcke allein sind die Unverbesserlichen, sie mögen nun aus Eigendünkel, Dummheit oder Hypochondrie ungelenk und unbiegsam sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "denn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efd84960-9dae-3906-addb-273c7ed9fc3b",
                                        "entry_id": "4e520715-a67f-3cc0-b2b1-e6671d63eaaf",
                                        "glosses": [
                                            "als"
                                        ],
                                        "tags": [
                                            "vergleichende Subjunktion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "216b7355-2420-4602-a947-5c625bf661ff",
                                                "sense_id": "efd84960-9dae-3906-addb-273c7ed9fc3b",
                                                "text": "Rousseau ist als Schriftsteller viel bekannter denn als Musiker.\n(Aus einem französischen Deutsch-Lehrbuch)"
                                            },
                                            {
                                                "example_id": "a8f47bab-4c99-41f3-98bd-a2cd57ccdf16",
                                                "sense_id": "efd84960-9dae-3906-addb-273c7ed9fc3b",
                                                "text": "Er war nie glücklicher denn als kleiner Junge (im Sinne eines komparativen als)"
                                            },
                                            {
                                                "example_id": "9a8bc9ff-21a5-461a-a03b-5a2165854bac",
                                                "sense_id": "efd84960-9dae-3906-addb-273c7ed9fc3b",
                                                "text": "„Die populären Exorzisten verstanden sich letztlich eher als Heiler denn als Kirchenmänner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "denn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72a199da-7acd-3b7e-badf-90108a57ea6a",
                                        "entry_id": "143657fe-f464-3d8b-9eec-f2385164cd06",
                                        "glosses": [
                                            "ausgenommen; vorausgesetzt, dass …; außer wenn …"
                                        ],
                                        "tags": [
                                            "meistens in der Wendung „es sei denn“",
                                            "sonst veraltet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5e605cf-3fd8-484b-8bee-5ffb74957048",
                                                "sense_id": "72a199da-7acd-3b7e-badf-90108a57ea6a",
                                                "text": "Ich werde nicht kommen, es sei denn, das Wetter wird deutlich besser."
                                            },
                                            {
                                                "example_id": "5ad0ec60-65c1-4303-8bce-09fc63d610ef",
                                                "sense_id": "72a199da-7acd-3b7e-badf-90108a57ea6a",
                                                "text": "„Ich lasse dich nicht, du segnest mich denn.“ (Genesis 32,17 in der Luther-Übersetzung)"
                                            },
                                            {
                                                "example_id": "d7760329-6a21-47c0-aab0-674d232d2f93",
                                                "sense_id": "72a199da-7acd-3b7e-badf-90108a57ea6a",
                                                "text": "„Ich weiß, was Trost und Stärke sie [die Beichte] sie mir gegeben hat: Es weiß niemand, was sie vermag, denn wer mit dem Teufel oft und viel gefochten hat.“"
                                            },
                                            {
                                                "example_id": "dd4a0241-7e90-4b8a-8169-9500c15abf14",
                                                "sense_id": "72a199da-7acd-3b7e-badf-90108a57ea6a",
                                                "text": "„Wie anders hätten sie hereinkönnen, denn indem sie als Heizer heuerten und auf dem ersten Anlegeplatz zu dersertieren versuchten oder sich von einem Landsmann in der Bemannung irgendwo hinter der Kohle und hinter den Ballen verstecken ließen!“"
                                            },
                                            {
                                                "example_id": "44594022-133b-4ac7-a91e-bf7b574f41f8",
                                                "sense_id": "72a199da-7acd-3b7e-badf-90108a57ea6a",
                                                "text": "„Die Nürnberger hängen keinen – sie hätten ihn denn!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb43b93c-769c-3b16-a09a-b388493f16b5",
                                        "entry_id": "143657fe-f464-3d8b-9eec-f2385164cd06",
                                        "glosses": [
                                            "dann"
                                        ],
                                        "tags": [
                                            "North German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2379e252-2b5e-4bc4-8ff2-442506f79c4b",
