                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois rentrer tôt ce soir parce que ma <w>daronne</w> m'attend pour dîner.",
                            "target_lang_translations": {
                                "en": "I have to get home early tonight because my <w>mum</w> is waiting for me for dinner.",
                                "ru": "Мне сегодня вечером нужно рано вернуться домой, потому что <w>мама</w> ждёт меня к ужину.",
                                "nl": "Ik moet vanavond vroeg naar huis, want mijn <w>mam</w> wacht op me voor het avondeten.",
                                "de": "Ich muss heute Abend früh nach Hause, weil meine <w>Mama</w> mit dem Abendessen auf mich wartet.",
                                "pl": "Muszę dziś wcześnie wrócić do domu, bo moja <w>mama</w> czeka na mnie z kolacją.",
                                "it": "Devo rientrare presto stasera perché mia <w>mamma</w> mi aspetta per cena.",
                                "cs": "Dnes večer musím brzy přijít domů, protože mě <w>máma</w> čeká na večeři.",
                                "tr": "Bu akşam erken eve dönmem gerekiyor, çünkü <w>annem</w> akşam yemeği için beni bekliyor.",
                                "es": "Tengo que volver temprano esta noche porque mi <w>mamá</w> me espera para cenar.",
                                "zh": "我今晚得早点回家，因为我<w>老妈</w>在等我吃晚饭。"
                            }
                        },
                        {
                            "text": "Il a demandé de l'argent à sa <w>daronne</w> pour pouvoir s'acheter de nouvelles baskets.",
                            "target_lang_translations": {
                                "en": "He asked his <w>mum</w> for money so he could buy new trainers.",
                                "ru": "Он попросил у своей <w>мамы</w> денег, чтобы купить себе новые кроссовки.",
                                "nl": "Hij vroeg zijn <w>mam</w> om geld, zodat hij nieuwe sneakers kon kopen.",
                                "de": "Er hat seine <w>Mama</w> um Geld gebeten, damit er sich neue Turnschuhe kaufen konnte.",
                                "pl": "Poprosił swoją <w>mamę</w> o pieniądze, żeby kupić sobie nowe trampki.",
                                "it": "Ha chiesto dei soldi a sua <w>mamma</w> per potersi comprare delle scarpe da ginnastica nuove.",
                                "cs": "Požádal <w>mámu</w> o peníze, aby si mohl koupit nové tenisky.",
                                "tr": "Yeni spor ayakkabı alabilmek için <w>annesinden</w> para istedi.",
                                "es": "Le pidió dinero a su <w>mamá</w> para poder comprarse unas zapatillas deportivas nuevas.",
                                "zh": "他向他<w>老妈</w>要钱，好买一双新的运动鞋。"
                            }
                        }
                    ],
