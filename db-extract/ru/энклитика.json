                        "cross_references": [
                            {
                                "target_word": "enclitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d678417-a006-3812-bdc7-473f03a1e706",
                                        "entry_id": "7cfe38aa-5b1d-3a60-9dc2-269f1e205f65",
                                        "glosses": [
                                            "Relatif à l’enclitique, mot phonétiquement attaché au précédent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51efcc32-cd39-4484-b1fc-f3e41c26b01b",
                                                "sense_id": "8d678417-a006-3812-bdc7-473f03a1e706",
                                                "text": "T-il est une forme enclitique du pronom personnel sujet il à la forme interrogative."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enclitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26707bb9-59da-3322-a590-e6c36a020f1b",
                                        "entry_id": "5e6b3daa-e072-3f0f-85f3-16ca44e081bd",
                                        "glosses": [
                                            "Clitique phonétiquement attaché au mot précédent. Mot qui prend appui sur le mot précédent et forme avec lui une seule unité accentuelle."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e474b76d-8125-4274-b5ab-44710c60a927",
                                                "sense_id": "26707bb9-59da-3322-a590-e6c36a020f1b",
                                                "text": "Une enclitique est un petit mot que l'on joint au mot qui le précède, en appuyant sur la dernière syllabe de ce mot"
                                            },
                                            {
                                                "example_id": "d16dca3e-fefd-406d-894e-1a472ed22ba0",
                                                "sense_id": "26707bb9-59da-3322-a590-e6c36a020f1b",
                                                "text": "En français, les pronoms dans puis-je, est-ce et allez-y sont des enclitiques."
                                            },
                                            {
                                                "example_id": "62f34831-ef9a-4661-9970-913962b346b0",
                                                "sense_id": "26707bb9-59da-3322-a590-e6c36a020f1b",
                                                "text": "En japonais, la prolifération des suffixes fonctionnels et la complexité des enclitiques supposent que le sujet s’avance dans l’énonciation à travers des précautions, des reprises, des retards et des insistances dont le volume final […] fait précisément du sujet une grande enveloppe vide de la parole, et non ce noyau plein qui est censé diriger nos phrases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
