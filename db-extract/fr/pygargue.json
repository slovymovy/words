        "fr-extract.jsonl": [
            {
                "entry_id": "7229af3f-579d-37c4-8592-9fe57ce40292",
                "word": "pygargue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "be862177-065b-4bf0-a039-cce9675c09da",
                        "entry_id": "7229af3f-579d-37c4-8592-9fe57ce40292",
                        "tags": [
                            "plural"
                        ],
                        "form": "pygargues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "edb3de36-b308-3bae-bee7-29c8acaf4a5c",
                        "entry_id": "7229af3f-579d-37c4-8592-9fe57ce40292",
                        "glosses": [
                            "Nom donné aux espèces de rapaces diurnes du genre Haliaeetus, qui se nourrissent surtout de poissons (piscivores), au bec massif et dont les pattes ne sont pas recouvertes de plumes jusqu’aux serres (comme le sont les aigles vrais)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d824be9b-aa15-4d57-85f3-96a7f39f9896",
                                "sense_id": "edb3de36-b308-3bae-bee7-29c8acaf4a5c",
                                "text": "Le pygargue à queue blanche (Haliaeetus albicilla) est surtout friand de poissons, mais il ne dédaigne ni les mammifères ni le gibier d’eau : oies, foulques, canards etc."
                            },
                            {
                                "example_id": "deba48f8-8be4-4426-b0c2-4e0d95740de4",
                                "sense_id": "edb3de36-b308-3bae-bee7-29c8acaf4a5c",
                                "text": "Quand j’étais jeune, je rêvais des minutes entières sur une image qui représentait un pygargue en train d’enfoncer, la tête sous l’eau, ses serres dans le dos d’un gros brochet."
                            },
                            {
                                "example_id": "14dcad87-c37f-4350-a6b2-16c5ba02c12e",
                                "sense_id": "edb3de36-b308-3bae-bee7-29c8acaf4a5c",
                                "text": "Évidemment, c’est durant la saison de reproduction, et encore davantage pendant la période d’incubation des œufs, que le pygargue est le plus sensible au dérangement humain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2c2251a-105b-4983-9cca-c893d6313568",
                        "source_entry_id": "7229af3f-579d-37c4-8592-9fe57ce40292",
                        "source_sense_id": "edb3de36-b308-3bae-bee7-29c8acaf4a5c",
                        "source_sense_description": "Espèce de rapaces",
                        "target_lang_word": "Seeadler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seeadler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de741c06-0c15-3e2d-ba9e-6e6ebdf59d73",
                                        "entry_id": "ab4d3573-3612-3e97-81e8-feed9c2b4a82",
                                        "glosses": [
                                            "großer Greifvogel aus der Gattung Haliaeetus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e77fa38-cd48-48d9-a142-c4a9062593ee",
                                                "sense_id": "de741c06-0c15-3e2d-ba9e-6e6ebdf59d73",
                                                "text": "Seeadler sind beeindruckende Vögel."
                                            },
                                            {
                                                "example_id": "089ec714-57a2-49c3-984f-5345f175e979",
                                                "sense_id": "de741c06-0c15-3e2d-ba9e-6e6ebdf59d73",
                                                "text": "„Darß und Zingst sind Brutheimat des Seeadlers; zahlreiche See- und Küstenvögel brüten auf den Inseln Oie und Kirr, auf den Bülten, den Wiesen und großen Vogelschutzgebieten Hiddensees.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb16b923-6c2a-3973-8a44-b386e6bcf6e5",
                                        "entry_id": "ab4d3573-3612-3e97-81e8-feed9c2b4a82",
                                        "glosses": [
                                            "speziell der einheimische Haliaeetus albicilla"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86852488-a48b-4a23-9c4f-4047bafeea46",
                                                "sense_id": "bb16b923-6c2a-3973-8a44-b386e6bcf6e5",
                                                "text": "Der Seeadler ist auch der Wappenvogel Deutschlands."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7027193-c978-4d77-a219-9d4f95716e28",
                        "source_entry_id": "7229af3f-579d-37c4-8592-9fe57ce40292",
                        "source_sense_id": "edb3de36-b308-3bae-bee7-29c8acaf4a5c",
