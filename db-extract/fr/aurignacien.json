                    {
                        "sense_id": "dbdeff8c-0bab-3295-aba9-836a17ea428e",
                        "entry_id": "64fec09b-414a-3a70-a81b-d25a44863fa0",
                        "glosses": [
                            "Faciès industriel du début du paléolithique supérieur."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "66040ce1-c43f-4f82-bbbd-c8311c97b23b",
                                "sense_id": "dbdeff8c-0bab-3295-aba9-836a17ea428e",
                                "text": "L’Aurignacien, première phase de cette évolution, en Occident, est né de l'industrie moustiérienne, cela ne fait aucun doute aujourd'hui."
                            }
                        ]
                    }
