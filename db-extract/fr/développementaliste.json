                        "sense_id": "0313ab8b-289a-3e1d-acb7-3b92bdce0233",
                        "entry_id": "bd11cb79-b564-3990-993d-7bff119cab8e",
                        "glosses": [
                            "Relatif au développementalisme."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "cb379658-5764-4262-88f6-51c7f13fa264",
                                "sense_id": "0313ab8b-289a-3e1d-acb7-3b92bdce0233",
                                "text": "Une théorie développementaliste."
                            },
                            {
                                "example_id": "c166531f-6387-40a4-aea1-1e8ef59ac122",
                                "sense_id": "0313ab8b-289a-3e1d-acb7-3b92bdce0233",
                                "text": "Aussi le discours géographique d’antan, très focalisé sur la réalité marocaine et ses spécificités, a-t-il cédé la place à un discours normatif en termes de développement et intégrateur de son objet dans les canevas développementaux. De même, ce discours, qui est resté dans beaucoup de ses aspects fortement influencé par l’héritage colonial, a trouvé dans l’idéal développementaliste une aubaine pour se refaire une santé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "793f1e4c-1d35-4933-8a97-4ea908ca3b38",
                        "source_entry_id": "bd11cb79-b564-3990-993d-7bff119cab8e",
                        "source_sense_id": "0313ab8b-289a-3e1d-acb7-3b92bdce0233",
                        "target_lang_word": "developmentalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "developmentalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afb0eedc-a691-3558-949e-01c474b2f5cd",
                                        "entry_id": "839c5bb1-6c42-3c87-95bd-cabcdc7e7d67",
                                        "glosses": [
                                            "Of, or related to developmentalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8921247a-1f63-4141-9ef9-b11f33264306",
                                                "sense_id": "afb0eedc-a691-3558-949e-01c474b2f5cd",
                                                "text": "[Eisenhower] did it in the end by drawing heavily on Cold War rhetoric: he painted developmentalism as the first step on the road to communism, and by connecting developmentalist governments to the USSR he was able to tar them in the mind of American citizens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "developmentalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5960580-0088-3d12-b071-8d117bfc2ab3",
                                        "entry_id": "a75a61aa-5e03-3b9a-8767-398c4ceaed8c",
                                        "glosses": [
                                            "A follower or proponent of developmentalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ec1092-29bc-484f-a200-80ee31e33689",
                                                "sense_id": "e5960580-0088-3d12-b071-8d117bfc2ab3",
                                                "text": "He was a developmentalist, a universalist, and a believer in social values and cultural influences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
