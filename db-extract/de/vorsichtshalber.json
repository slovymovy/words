                        "sense_id": "e5a245f5-9285-3536-8514-b287f1654299",
                        "entry_id": "77184b69-01de-3e37-aca8-f8fc1fc8411f",
                        "glosses": [
                            "zur Sicherheit, aus Vorsicht, um ganz sicher zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae48257-c843-43a7-b428-24035ee4b662",
                                "sense_id": "e5a245f5-9285-3536-8514-b287f1654299",
                                "text": "Weil der Wetterdienst vor Unwetter mit Blitz und Donner warnte, zog er vorsichtshalber alle Stecker von elektrischen Geräten aus den Steckdosen."
                            },
                            {
                                "example_id": "9131c510-65ce-4bf9-a9fb-4a378db3d55b",
                                "sense_id": "e5a245f5-9285-3536-8514-b287f1654299",
                                "text": "[…] die Bundesregierung bereitet sich vorsichtshalber schon mal auf eine Staatspleite Griechenlands vor."
                            },
                            {
                                "example_id": "b64396c7-3a75-449b-bc25-140bdbeabd9e",
                                "sense_id": "e5a245f5-9285-3536-8514-b287f1654299",
                                "text": "Das Bundeskriminalamt gibt Entwarnung: In den Überresten des Briefes an Bundespräsident Gauck, den die Polizei vorsichtshalber gesprengt hat, fanden die Ermittler keine Hinweise auf Bombenmaterial."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
