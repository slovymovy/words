                                        "examples": [
                                            {
                                                "example_id": "7f892164-163f-4c72-91d2-493f9af76afa",
                                                "sense_id": "12c03070-0412-3ba5-88cb-e666b85e05fb",
                                                "text": "2009, J. C. Wheeler, J. Laker, The Vicuña in the Andean Altiplano, Iain J. Gordon (editor), The Vicuña, Springer, page 27,\nIt has been suggested that harvesting reduces the pressure for illegal hunting by providing communities that benefit from vicuña management with incentives to protect the animals over which they have rights."
                                            },
                                            {
                                                "example_id": "637f1719-95c4-430a-b964-d8c219703551",
                                                "sense_id": "12c03070-0412-3ba5-88cb-e666b85e05fb",
                                                "text": "Vicuña hide was so precious that by the early 1930s, these animals—wild relatives of the llama and alpaca—were threatened with extinction, according to Tschiffely[…]."
                                            },
                                            {
                                                "example_id": "3990a4a2-4ab6-4a61-9cc6-67e88f4262ae",
                                                "sense_id": "12c03070-0412-3ba5-88cb-e666b85e05fb",
                                                "text": "Vicuñas are the smallest members of the camelid family, as well as the most prized and endangered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
