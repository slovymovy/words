                                    {
                                        "sense_id": "cea202cf-9c3c-3ecc-ac51-30ea0cdc0ea8",
                                        "entry_id": "9a72bb5f-1704-3a53-855d-74c95533d180",
                                        "glosses": [
                                            "In an ironic manner; in a way displaying irony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e313b6-eb3c-4ffc-a2de-aeae7e7b157a",
                                                "sense_id": "cea202cf-9c3c-3ecc-ac51-30ea0cdc0ea8",
                                                "text": "My colleague ironically avoids doctors like the plague!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01693bf5-341c-371e-9ed5-9bcbe21c7ab0",
                                        "entry_id": "9a72bb5f-1704-3a53-855d-74c95533d180",
                                        "glosses": [
                                            "Used to draw attention to an ironic aspect of a situation being described."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "327c1ff0-d1cf-4412-8951-d3806d0fd04f",
                                                "sense_id": "01693bf5-341c-371e-9ed5-9bcbe21c7ab0",
                                                "text": "Ironically, the automated checkout system ended up costing more in repairs than the workers it was meant to replace."
                                            }
                                        ]
                                    }
