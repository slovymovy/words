                "senses": [
                    {
                        "sense_id": "c21d9aa1-b82b-3cbc-957d-3f58fd3a1894",
                        "entry_id": "447e32fd-8c19-30be-92a8-63ef947a072c",
                        "glosses": [
                            "Ausdrucksweise, Ausdrucksform oder Stil, den eine Person in ihren Reden oder schriftlichen Werken verwendet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f094b112-c29a-4425-b155-0b3d07d35752",
                                "sense_id": "c21d9aa1-b82b-3cbc-957d-3f58fd3a1894",
                                "text": "An seine Diktion muss ich mich erst gewöhnen."
                            },
                            {
                                "example_id": "28841553-5d28-4bd3-99f1-d5c2e0cd405c",
                                "sense_id": "c21d9aa1-b82b-3cbc-957d-3f58fd3a1894",
                                "text": "Ulla Lachauer, die kenntnisreiche und einfühlsame Autorin von Büchern und Filmen aus dem ehemaligen deutschen Osten, hat ihre Geschichte aufgeschrieben und bleibt dabei in der Diktion der Bäuerin."
                            },
                            {
                                "example_id": "ce1fa1d8-5241-4bb3-a5ac-a943d7d836c1",
                                "sense_id": "c21d9aa1-b82b-3cbc-957d-3f58fd3a1894",
                                "text": "Regierungssprecher Ulrich Wilhelm schloss sich am Montag dagegen eher der Diktion von US-Außenministerin Condoleezza Rice an. »Das Leiden und Sterben muss ein schnelles Ende haben«, sagte Regierungssprecher Ulrich Wilhelm am Montag in Berlin."
                            },
                            {
                                "example_id": "252d9c7a-9b8e-48f1-ba5f-b7dc6b5eb8cc",
                                "sense_id": "c21d9aa1-b82b-3cbc-957d-3f58fd3a1894",
                                "text": "Nur die abstrakte Diktion der deutschen Begriffsphilosophie verhinderte, daß man im Ausland die Rhetorik der klassischen Humanität nicht früher durchschaute."
                            },
                            {
                                "example_id": "934af205-a485-43a3-a810-b3e7e9e78762",
                                "sense_id": "c21d9aa1-b82b-3cbc-957d-3f58fd3a1894",
                                "text": "Stellt man zwischen der wissenschaftlichen, der populären und der schönen Diktion eine Vergleichung an, so zeigt sich, daß alle drei zwar den Gedanken, um den es zu thun ist, der Materie nach, gleich getreu überliefern und uns also alle drei zu einer Erkenntniß verhelfen, daß aber die Art und der Grad dieser Erkenntniß bei einer jeden merklich verschieden sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
