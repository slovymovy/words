    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3a2eebc2-07bc-378b-9fa1-09e130494f2e",
                "word": "sellout",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e7bf48d6-47c3-4499-b130-0f8845052cc8",
                        "entry_id": "3a2eebc2-07bc-378b-9fa1-09e130494f2e",
                        "tags": [
                            "plural"
                        ],
                        "form": "sellouts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5981b4b5-c197-31c1-8ce3-4acbf18df057",
                        "entry_id": "3a2eebc2-07bc-378b-9fa1-09e130494f2e",
                        "glosses": [
                            "An action in which principles are compromised for personal gain."
                        ],
                        "tags": [
                            "idiomatic",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "3d6de625-1766-4ac7-b75b-dfadd08316a4",
                                "sense_id": "5981b4b5-c197-31c1-8ce3-4acbf18df057",
                                "text": "A statement by the Coalition for Lesbian and Gay Rights (CLGR), which organized the protest, charged that WPIX's sale of air time to the Anita Bryant Ministries \"is a sell-out of the more than one million lesbians and gay residents in the WPIX broadcast service area."
                            },
                            {
                                "example_id": "95a36f3d-32b9-4329-bf90-e06b9b5da328",
                                "sense_id": "5981b4b5-c197-31c1-8ce3-4acbf18df057",
                                "text": "When his hearing came up, the sellout of Taiwan was particularly on my mind. I asked him if he thought that Taiwan should be pressured into making an accommodation with the Communist government in Beijing.\nThe candidate refused to answer my question."
                            }
                        ]
                    },
                    {
                        "sense_id": "602aaeca-8a7a-3644-bb8c-265e3471c3ef",
                        "entry_id": "3a2eebc2-07bc-378b-9fa1-09e130494f2e",
                        "glosses": [
                            "A person who sells out, who compromises their principles for financial gain or some other advantage."
                        ],
                        "tags": [
                            "idiomatic",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "34c42a9b-56fa-4643-9b29-986cdd0bb7dc",
                                "sense_id": "602aaeca-8a7a-3644-bb8c-265e3471c3ef",
                                "text": "The rock star used to be hardcore, but now he's just a sellout."
                            },
                            {
                                "example_id": "32a69057-5cdb-489f-827e-1540b6ee55b5",
                                "sense_id": "602aaeca-8a7a-3644-bb8c-265e3471c3ef",
                                "text": "The nineties were not an age for the aspirant. The worst thing you could be was a sellout, and not because selling out involved money. Selling out meant you needed to be popular, and any explicit desire for approval was enough to prove you were terrible."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3a480e9-28f7-3aee-b157-2995c6e9c47b",
                        "entry_id": "3a2eebc2-07bc-378b-9fa1-09e130494f2e",
                        "glosses": [
                            "The selling of an entire stock of something, especially tickets for an entertainment or sports event."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15fa9343-b104-4b1e-8b0e-f6336cbe8cff",
                                "sense_id": "f3a480e9-28f7-3aee-b157-2995c6e9c47b",
                                "text": "I performed in front of a sellout crowd."
                            },
                            {
                                "example_id": "487b15e3-a025-40ed-a165-1d89356a93d2",
                                "sense_id": "f3a480e9-28f7-3aee-b157-2995c6e9c47b",
                                "text": "Mel White recalls being a high school student and seeing Billy Graham preaching before sell-out crowds at San Francisco's Cow Palace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "084c0abd-16c7-4475-beb7-f82c7628c4e4",
                        "source_entry_id": "3a2eebc2-07bc-378b-9fa1-09e130494f2e",
                        "source_sense_description": "a person who compromises his or her principles",
                        "target_lang_word": "vendu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf1c1b0-035d-396e-82f8-de797411dc46",
                                        "entry_id": "ab0bfb38-d13f-38ec-bda4-36c4ea9b82c7",
                                        "glosses": [
                                            "Qui a fait l’objet d’une vente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ce9b94e-1494-4039-98a3-1fe62d97a569",
                                                "sense_id": "bcf1c1b0-035d-396e-82f8-de797411dc46",
                                                "text": "L'image de marque de l’agence immobilière en sortira grandie, parce que le bien visité sera plus beau, mais aussi parce que son panneau publicitaire comportera plus rapidement l’indication « vendu »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2441150-ae5c-304c-a9ad-8c1b6238b30c",
                                        "entry_id": "ab0bfb38-d13f-38ec-bda4-36c4ea9b82c7",
                                        "glosses": [
                                            "Se dit d’un homme livré à quelqu’un ou à un parti par intérêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef9a34e-a1fe-4ed7-ae3b-13b72c714014",
                                                "sense_id": "c2441150-ae5c-304c-a9ad-8c1b6238b30c",
                                                "text": "Cet homme est vendu au pouvoir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e906902f-e2d5-385f-a3fe-922af6933f92",
                                        "entry_id": "9812dae1-2fef-3792-ae6f-b7212432d8af",
                                        "glosses": [
                                            "Personne qui se livre, à quelqu’un ou à un parti, par intérêt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29f1f04f-a09d-4a0a-8943-3f2bac3d9e28",
                                                "sense_id": "e906902f-e2d5-385f-a3fe-922af6933f92",
                                                "text": "Ainsi le comprenait l'orateur qui flétrissait, il y a trois ans, dans un premier discours, ceux qu'on appelle des vendus, et qui s'annonçait déjà comme l'exécuteur des épurations nécessaires."
                                            },
                                            {
                                                "example_id": "77ce53e8-3805-452e-8767-b1aa989904dd",
                                                "sense_id": "e906902f-e2d5-385f-a3fe-922af6933f92",
                                                "text": "Tous les quarts d'heure,\nUn paon siffleur\nNous traite de péquenots, de vendus, d'abrutis,\nDe vieux débris\nEt j'en oublie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vendu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a28a458-1798-33c0-9252-3464d506089e",
                                        "entry_id": "d09f21d9-5dd2-3a6c-90bb-643528e0eaed",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe vendre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce30a9a-c118-4409-87cc-7432652460b7",
                                                "sense_id": "2a28a458-1798-33c0-9252-3464d506089e",
                                                "text": "À la fermeture de la boutique, vers 19 h 30, des sacs blancs sont posés sur le muret en face de la boulangerie. À l’intérieur : sandwiches et viennoiseries. « Tout ce qui n’a pas été vendu dans la journée », explique José Louiset, propriétaire des boulangeries Au bon vieux temps et du Fournil du Chapeau rouge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
