                                    },
                                    {
                                        "sense_id": "803a3362-a998-30e5-9c66-3f688dcbbbc9",
                                        "entry_id": "d610ddd9-1128-34ad-b8ec-ebe60776d799",
                                        "glosses": [
                                            "Wiederausbruch einer geheilt geglaubten Krankheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ec53d68-56ca-4c2d-a444-aaaa33d473f2",
                                                "sense_id": "803a3362-a998-30e5-9c66-3f688dcbbbc9",
                                                "text": "Nach seiner Therapie war er fast fünf Jahre lang trocken, aber dann kam der Rückfall."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "65271520-ba39-3090-bf1a-89ea50da7af4",
                                        "entry_id": "d610ddd9-1128-34ad-b8ec-ebe60776d799",
                                        "glosses": [
                                            "erneuter Gesetzesbruch eines bereits einschlägig vorbestraften Straftäters"
                                        ],
                                        "tags": [
                                            "Justiz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7fc1c0f-2b8d-43fa-8d0d-b0f19d4327c1",
                                                "sense_id": "65271520-ba39-3090-bf1a-89ea50da7af4",
                                                "text": "Bei Triebtätern ist ein Rückfall sehr wahrscheinlich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
