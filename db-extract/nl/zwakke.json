                        "glosses": [
                            "verbogen vorm van de stellende trap van zwak"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a416a42c-d8b9-49b1-afa2-6df316442430",
                                "sense_id": "212cdca7-788d-32f3-8bf2-24053b1fd900",
                                "text": "Hij droeg een groene bandana in zijn lange haar en had als een van de weinigen hoge leren bergschoenen om zijn zwakke enkels te beschermen."
                            },
                            {
                                "example_id": "7748cf59-ae8e-493a-99b8-16d03e0a8056",
                                "sense_id": "212cdca7-788d-32f3-8bf2-24053b1fd900",
                                "text": "Om drie uur 's nachts ging ze uitgeput op haar matras liggen en staarde naar de balken en het afbladderende plafond, waarvan de ruwe, hoge hoeken werden verlicht door het zwakke schijnsel van de kaars naast haar bed."
                            }
                        ]
                    }
                ],
