                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5526987b-9c4d-40ac-a2c4-e12cdead2b66",
                                "sense_id": "1eefdec8-ed0d-3583-a174-80e66bcb08bc",
                                "text": "Constance avait fortement improuvé l’envoi des mémoires, elle avait grondé les commis, et accusé Célestin de vouloir ruiner sa maison, croyant que Célestin seul avait eu cette idée."
                            },
                            {
                                "example_id": "e94eba53-048c-4146-bd21-e520aa21141f",
                                "sense_id": "1eefdec8-ed0d-3583-a174-80e66bcb08bc",
                                "text": "Ernestine et Célestin s'installèrent à Astrida, et Kawa, sous le ficus qui baignait d'ombre sa maison."
                            }
                        ]
                    }
                ],
