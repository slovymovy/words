                "senses": [
                    {
                        "sense_id": "675a2759-45a7-34b6-b797-b5ad3bcfd191",
                        "entry_id": "1f669d5d-6045-3bd2-b6e1-d42bfbe691a4",
                        "glosses": [
                            "Person, die als heilige oder andere wirkmächtige Figur verehrt wird, der man zutraut, bestimmten Personengruppen oder Objekten Schutz gewähren zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaf520c4-e3c6-4204-9da6-343e22931561",
                                "sense_id": "675a2759-45a7-34b6-b797-b5ad3bcfd191",
                                "text": "„Damals befand sich ein großer überregionaler Rossmarkt in Moosburg an der Isar. Der Heilige der Stadt, Sankt Kastulus, stand im Ruf, der Schutzpatron der Rossdiebe zu sein. In Moosburg stand aber auch ein Galgen, an dem viele der Hallertauer Pferdediebe ihr Leben aushauchten. Der Moosburger Pfarrer Anton Nagel berichtet um 1790, dass an einem Tag generationenübergreifend Diebe aus einer Holledauer Familie dort hingerichtet wurden – vom Großvater bis zum Enkel. Weitere solcher Diebesnester haben sich laut Nagel in Straßhof am Hennenbach entlang, Großgundertshausen, Hebrontshausen, Grafendorf und Rudelzhausen befunden.“"
                            },
                            {
                                "example_id": "2e33d57d-eb1d-4e7a-816e-d6fcba96d114",
                                "sense_id": "675a2759-45a7-34b6-b797-b5ad3bcfd191",
                                "text": "„Nataraja war der Schutzpatron der Cholas und erlangte daher besondere Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "474dfe30-0f87-4890-9120-45cf37438f76",
                        "source_entry_id": "1f669d5d-6045-3bd2-b6e1-d42bfbe691a4",
                        "source_sense_id": "675a2759-45a7-34b6-b797-b5ad3bcfd191",
                        "target_lang_word": "patron saint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patron saint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa3431e-3888-3d3c-8353-9d8945803824",
                                        "entry_id": "80e4c654-f840-3494-903e-02e824d21557",
                                        "glosses": [
                                            "A saint conceived as the patron (protector or supporter) of a particular place, group, person, or activity, for whom or for which his or her intercession is specially invoked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dead3822-f8e3-4b56-a26a-87e46d104b2e",
                                                "sense_id": "6aa3431e-3888-3d3c-8353-9d8945803824",
                                                "text": "When Aimé Humbert joined Josephine in Paris, he visited the Inspector of Police, and was so depressed by his meeting that she sent him to the Louvre ‘to look at the wonderful painting of St Marguerite, the patron saint of purity, trampling down the hideous dragon and looking so calm and peaceful’."
                                            },
                                            {
                                                "example_id": "5b2afd7b-b143-4464-8482-ebf2e5d968bb",
                                                "sense_id": "6aa3431e-3888-3d3c-8353-9d8945803824",
                                                "text": "My patron saint, St. John of Shanghai and San Francisco—also known as “St. John the Wonderworker”—is particularly noteworthy in this regard […]"
                                            },
                                            {
                                                "example_id": "99e90d9a-4a44-4ac7-b8b7-a55a0205a39d",
                                                "sense_id": "6aa3431e-3888-3d3c-8353-9d8945803824",
                                                "text": "Entering the tunnel, we pass a small shrine above our heads which contains a statue of St Barbara, the patron saint of tunnellers. It is traditional to have such shrines on every tunnel site."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8adc581c-79e9-37d5-841e-40bae6d9ecf4",
                                        "entry_id": "80e4c654-f840-3494-903e-02e824d21557",
                                        "glosses": [
                                            "An exemplar: an individual who exemplifies some trait or group."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f73ec5b-8c3d-4cd0-a84d-273816f0743c",
                                                "sense_id": "8adc581c-79e9-37d5-841e-40bae6d9ecf4",
                                                "text": "Janet is the patron saint of procrastination. I'm thinking of erecting her a shrine of doughnut boxes in the breakroom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3d53634-4e5a-46a8-900e-718dba476be4",
                        "source_entry_id": "1f669d5d-6045-3bd2-b6e1-d42bfbe691a4",
                        "source_sense_id": "675a2759-45a7-34b6-b797-b5ad3bcfd191",
                        "target_lang_word": "saint patron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saint patron",
