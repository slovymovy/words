                                                "example_id": "4eeac5fb-923c-4382-8785-c296f47fa596",
                                                "sense_id": "099d1972-69e7-3083-bdc6-0930fa7d9238",
                                                "text": "„Jedoch konnte er von Glück reden, dass er ein nicht noch schlimmerer Schwächling war.“"
                                            },
                                            {
                                                "example_id": "fe0a29d8-95fa-49e4-a968-158ba595570a",
                                                "sense_id": "099d1972-69e7-3083-bdc6-0930fa7d9238",
                                                "text": "„Der Schwächling fing zu weinen an und sagte, er werde nach Paris fahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
