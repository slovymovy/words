                {
                    "sense_id": "27705430-3d56-3e16-9584-412d84051fc6",
                    "sense_definition": "Extremely old-fashioned, primitive, or unenlightened.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plumbing system in this old building is positively <w>medieval</w>.",
                            "target_lang_translations": {
                                "ru": "Водопроводная система в этом старом здании просто <w>допотопная</w>.",
                                "zh": "这栋老建筑里的管道系统简直<w>原始</w>得要命。",
                                "es": "El sistema de fontanería de este edificio antiguo es totalmente <w>medieval</w>.",
                                "tr": "Bu eski binadaki tesisat sistemi tam anlamıyla <w>çağ dışı</w>.",
                                "de": "Das Sanitärsystem in diesem alten Gebäude ist geradezu <w>mittelalterlich</w>."
                            }
                        },
                        {
                            "text": "His parents have <w>medieval</w> attitudes regarding women and work.",
                            "target_lang_translations": {
                                "ru": "У его родителей <w>средневековые</w> взгляды на женщин и работу.",
                                "zh": "他父母在女性工作问题上的态度非常<w>落后</w>。",
                                "es": "Sus padres tienen actitudes <w>medievales</w> respecto a las mujeres y el trabajo.",
                                "tr": "Anne babasının kadınlar ve çalışma hayatı konusunda <w>ilkel</w> görüşleri var.",
                                "de": "Seine Eltern haben <w>mittelalterliche</w> Ansichten in Bezug auf Frauen und Arbeit."
                            }
                        }
