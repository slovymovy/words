                                    {
                                        "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                        "entry_id": "62e507e5-9ae2-3012-bd49-f65c65b39233",
                                        "glosses": [
                                            "ein aus Weizenmehl mit einem hohen Butteranteil hergestelltes Gebäck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b22a26-cf2f-440b-a819-5773c19500e7",
                                                "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                                "text": "Zum Teil mit Schokoladenglasur überzogene Butterkekse sind lecker."
                                            },
                                            {
                                                "example_id": "13ff0355-3c0b-45fc-a642-b6c662fa7096",
                                                "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                                "text": "„Nach dem Diebstahl eines überdimensionierten Metall-Butterkekses von der Bahlsen-Firmenzentrale in Hannover ist am Dienstag ein kurioses Erpresserschreiben aufgetaucht - unterzeichnet mit \"Krümelmonster\".“"
                                            },
                                            {
                                                "example_id": "58f0fef5-f58b-45ce-9327-32afe1c84e15",
                                                "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                                "text": "„Butterkeks enthält auf 100 Teile Getreideerzeugnisse mindestens 10 Teile Butter (oder entsprechende Mengen Butterreinfett oder Butterfett).“"
                                            },
                                            {
                                                "example_id": "e5e38611-b512-426a-96e3-d3ae24af2f09",
                                                "sense_id": "c4dcd4c9-788a-39fb-9414-1551e4a825a6",
                                                "text": "„Val kochte Tee und füllte einen Teller mit Butterkeksen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
