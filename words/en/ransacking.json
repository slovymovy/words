            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ed31c74-7480-3bb2-b145-1fc01c00b23f",
                    "sense_definition": "The act of searching a place thoroughly and often violently, typically leaving it in disorder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "acts of searching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian documented the various <w>ransackings</w> of the ancient city by invading armies.",
                            "target_lang_translations": {
                                "ru": "Историк задокументировал различные <w>разграбления</w> древнего города армиями захватчиков."
                            }
                        },
                        {
                            "text": "Lefebvre never saw any of these battles and <w>ransackings</w>, but one wonders what he would have made of them.",
                            "target_lang_translations": {
                                "ru": "Лефевр никогда не видел ни этих сражений, ни <w>погромов</w>, но интересно, что бы он о них подумал."
                            }
                        }
                    ],
                    "synonyms": [
                        "pillage",
                        "plunder",
                        "search",
                        "raid"
                    ],
                    "common_phrases": [
                        "violent ransackings",
                        "systematic ransackings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по тщательному и часто насильственному обыску места, обычно оставляющее после себя беспорядок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разграбление",
