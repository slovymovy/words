                ],
                "senses": [
                    {
                        "sense_id": "affdb907-8e98-399c-9809-6f4561aed2fd",
                        "entry_id": "3a698f7a-94c0-37db-a2ab-30b36fb738e8",
                        "glosses": [
                            "Phase von der Inbetriebnahme bis zur Stilllegung (Betriebszustand) einer Lüftungsanlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34fcb27a-b046-4a6d-8c2e-3a7a93cfecad",
                                "sense_id": "affdb907-8e98-399c-9809-6f4561aed2fd",
                                "text": "„Bei Lüftungsbetrieb ermöglicht das einen geringen ständigen Luftstrom von Hochdruckzonen zu Niederdruckzonen.“"
                            },
                            {
                                "example_id": "960014a4-3110-4ad2-bfd0-365e2a7e51d2",
                                "sense_id": "affdb907-8e98-399c-9809-6f4561aed2fd",
                                "text": "„Später sind es Zugerscheinungen auf Grund unzureichend erfolgter Erwärmung oder hohe Betriebskosten auf Grund unkontrollierbarer Vergeudung von Wärme und Kraft, welche dazu führen, den Lüftungsbetrieb einzustellen.“"
                            },
                            {
                                "example_id": "c9a4a4d5-2c5a-457c-a2ad-b176edd6c304",
                                "sense_id": "affdb907-8e98-399c-9809-6f4561aed2fd",
                                "text": "„Daher können bei andauerndem Lüftungsbetrieb selbst in großen Tiefgaragen im Winter bei geringen Außentemperaturen Bauteiltemperaturen um oder sogar unter dem Gefrierpunkt erreicht werden.“"
                            },
                            {
                                "example_id": "8cf172b7-4eb1-469b-86f7-a4ce08157f8c",
                                "sense_id": "affdb907-8e98-399c-9809-6f4561aed2fd",
                                "text": "„Lüftungsanlagen müssen dementsprechend so bemessen und ausgeführt werden, dass diese Werte bei gewöhnlichem Lüftungsbetrieb nicht überschritten werden.“"
                            },
                            {
                                "example_id": "a1b93ca0-fcaf-45d7-8f0f-1bf16433eaed",
                                "sense_id": "affdb907-8e98-399c-9809-6f4561aed2fd",
                                "text": "„Der Kühlbetrieb im Sommer wird nur mit Frischluft vorgenommen, der Heiz- und Lüftungsbetrieb im Winter ebenso.“"
                            },
                            {
                                "example_id": "3b7594b6-624d-49a1-9390-bb0548b9f9d1",
                                "sense_id": "affdb907-8e98-399c-9809-6f4561aed2fd",
                                "text": "„Der zum Kochen nötige Dampf wird von einem außerhalb des Küchenhauses angelegten Dampfkessel geliefert, welcher zugleich zur Heizung und zum Lüftungsbetrieb des Krankenhauses dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
