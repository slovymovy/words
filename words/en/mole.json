{
    "word_family": [
        "molehill",
        "moleskin"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b98e4b3-29cf-3733-8e7b-e4198b55f135",
                    "sense_definition": "A small burrowing mammal with dark velvety fur, a long muzzle, and very small eyes, known for digging tunnels underground.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "animal_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mole</w> dug a long tunnel under the garden lawn.",
                            "target_lang_translations": {
                                "ru": "<w>Крот</w> прорыл длинный туннель под газоном в саду.",
                                "zh": "<w>鼹鼠</w>在花园草坪下挖了一条长长的隧道。"
                            }
                        },
                        {
                            "text": "We found a small <w>mole</w> hiding in the dirt near the flowerbed.",
                            "target_lang_translations": {
                                "ru": "Мы нашли маленького <w>крота</w>, прячущегося в земле у клумбы.",
                                "zh": "我们在花坛附近的土里发现了一只躲藏的小<w>鼹鼠</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blind as a mole",
                        "mole hill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое роющее млекопитающее с темным бархатистым мехом и очень маленькими глазами, известное тем, что роет подземные туннели.",
                        "zh": "一种小型穴居哺乳动物，有深色天鹅绒般的皮毛、长吻和极小的眼睛，以在地下挖掘隧道而闻名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крот",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鼹鼠",
                                "target_lang_sense_clarification": "动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d3475fb-2c1a-3be1-96e9-e76cc3e4fa27",
                    "sense_definition": "A small, dark, permanent spot on the human skin.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "skin_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a small <w>mole</w> on her left cheek.",
                            "target_lang_translations": {
                                "ru": "У нее есть маленькая <w>родинка</w> на левой щеке.",
                                "zh": "她左脸颊上有一颗小<w>痣</w>。"
                            }
                        },
                        {
                            "text": "The doctor checked the <w>mole</w> to ensure it was healthy.",
                            "target_lang_translations": {
                                "ru": "Врач осмотрел <w>родинку</w>, чтобы убедиться, что она здорова.",
                                "zh": "医生检查了那颗<w>黑痣</w>以确保它没有病变。"
                            }
                        }
                    ],
                    "synonyms": [
                        "birthmark",
                        "nevus"
                    ],
                    "common_phrases": [
                        "facial mole",
                        "dark mole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое темное пятнышко на коже человека.",
                        "zh": "人体皮肤上的一种小型、深色、永久性的斑点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родинка",
                                "target_lang_sense_clarification": "на коже"
                            },
                            {
                                "target_lang_word": "родимое пятно",
                                "target_lang_sense_clarification": "пигментированное пятно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黑痣",
                                "target_lang_sense_clarification": "皮肤上的斑点"
                            },
                            {
                                "target_lang_word": "痣",
                                "target_lang_sense_clarification": "皮肤上的斑点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d12b990f-7bef-3bd9-97a2-23f75b66e8ea",
                    "sense_definition": "A spy who works inside an organization to betray its secrets to an enemy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "spy_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency discovered a <w>mole</w> leaking classified information to the press.",
                            "target_lang_translations": {
                                "ru": "Агентство обнаружило <w>крота</w>, сливающего секретную информацию прессе.",
                                "zh": "该机构发现了一名向媒体泄露机密信息的<w>内鬼</w>。"
                            }
                        },
                        {
                            "text": "They suspected a <w>mole</w> was working for the rival company.",
                            "target_lang_translations": {
                                "ru": "Они подозревали, что на компанию-конкурента работает <w>крот</w>.",
                                "zh": "他们怀疑有<w>卧底</w>在为竞争对手公司工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "suspected mole",
                        "hunt for a mole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шпион, внедренный в организацию для передачи секретов врагу.",
                        "zh": "潜伏在组织内部，向敌人出卖机密的间谍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крот",
                                "target_lang_sense_clarification": "шпион"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内鬼",
                                "target_lang_sense_clarification": "组织内部的背叛者"
                            },
                            {
                                "target_lang_word": "卧底",
                                "target_lang_sense_clarification": "潜伏人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e94e37d5-64c3-354f-a33b-345c1ccd73de",
                    "sense_definition": "The standard unit in chemistry for measuring the amount of a substance, containing Avogadro's number of particles.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "unit_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Calculate the mass of one <w>mole</w> of carbon atoms.",
                            "target_lang_translations": {
                                "ru": "Рассчитайте массу одного <w>моля</w> атомов углерода.",
                                "zh": "计算一<w>摩尔</w>碳原子的质量。"
                            }
                        },
                        {
                            "text": "A <w>mole</w> is a fundamental unit in the International System of Units.",
                            "target_lang_translations": {
                                "ru": "<w>Моль</w> — это основная единица в Международной системе единиц.",
                                "zh": "<w>摩尔</w>是国际单位制中的基本单位。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mole of substance",
                        "per mole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения количества вещества в химии, содержащая число Авогадро частиц.",
                        "zh": "化学中用于衡量物质数量的标准单位，包含阿伏伽德罗常数个粒子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моль",
                                "target_lang_sense_clarification": "единица измерения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摩尔",
                                "target_lang_sense_clarification": "化学计量单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd4b7fe8-5e81-39ad-a481-e862d069d5de",
                    "sense_definition": "A spicy sauce typical of Mexican cuisine, often containing chocolate and chili.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sauce_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We ordered chicken with <w>mole</w> sauce at the Mexican restaurant.",
                            "target_lang_translations": {
                                "ru": "Мы заказали курицу с соусом <w>моле</w> в мексиканском ресторане.",
                                "zh": "我们在墨西哥餐厅点了鸡肉配<w>莫雷酱</w>。"
                            }
                        },
                        {
                            "text": "Traditional <w>mole</w> takes a long time to prepare properly.",
                            "target_lang_translations": {
                                "ru": "Приготовление традиционного <w>моле</w> занимает много времени.",
                                "zh": "传统的<w>莫雷酱</w>需要很长时间才能制作得当。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chicken mole",
                        "mole poblano"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mexican cuisine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый соус мексиканской кухни, часто содержащий шоколад и перец чили.",
                        "zh": "墨西哥菜中一种典型的辛辣酱汁，通常含有巧克力和辣椒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моле",
                                "target_lang_sense_clarification": "соус"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莫雷酱",
                                "target_lang_sense_clarification": "墨西哥酱汁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0fb0612-664b-3aaa-93ad-4bc39d692f36",
                    "sense_definition": "A massive stone structure built in the sea to protect a harbor or act as a breakwater.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "structure_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship docked safely behind the protective <w>mole</w>.",
                            "target_lang_translations": {
                                "ru": "Корабль благополучно пришвартовался за защитным <w>молом</w>.",
                                "zh": "船只安全地停靠在防护<w>防波堤</w>后方。"
                            }
                        },
                        {
                            "text": "Waves crashed against the stone <w>mole</w> during the storm.",
                            "target_lang_translations": {
                                "ru": "Во время шторма волны разбивались о каменный <w>мол</w>.",
                                "zh": "暴风雨期间，海浪拍打着石质<w>防波堤</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stone mole",
                        "harbor mole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Массивное каменное сооружение в море для защиты гавани или в качестве волнореза.",
                        "zh": "建在海中用于保护港口或作为防波堤的大型石质结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мол",
                                "target_lang_sense_clarification": "сооружение"
                            },
                            {
                                "target_lang_word": "волнорез",
                                "target_lang_sense_clarification": "защита от волн"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "防波堤",
                                "target_lang_sense_clarification": "港口防护结构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e917d2b4-6402-338b-9dad-1bf976747490",
                    "sense_definition": "A river in England that flows into the Thames.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "river_name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The River <w>Mole</w> flows through the county of Surrey.",
                            "target_lang_translations": {
                                "ru": "Река <w>Мол</w> протекает через графство Суррей.",
                                "zh": "<w>莫尔河</w>流经萨里郡。"
                            }
                        },
                        {
                            "text": "They went for a walk along the banks of the <w>Mole</w>.",
                            "target_lang_translations": {
                                "ru": "Они отправились на прогулку по берегам <w>Мола</w>.",
                                "zh": "他们沿着<w>莫尔河</w>岸边散步。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в Англии, впадающая в Темзу.",
                        "zh": "英国的一条河流，汇入泰晤士河。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Мол",
                                "target_lang_sense_clarification": "река"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莫尔河",
                                "target_lang_sense_clarification": "河流名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64b7fab6-d621-3341-941f-34988a237197",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname_sense",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Mole</w> arrived late for the meeting.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Моул</w> опоздал на встречу.",
                                "zh": "<w>莫尔</w>先生开会迟到了。"
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Mole</w> yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера я встретил женщину по имени Сара <w>Моул</w>.",
                                "zh": "我昨天遇到了一位名叫莎拉·<w>莫尔</w>的女士。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一种姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Моул",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "莫尔",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}