                "senses": [
                    {
                        "sense_id": "ea4781ba-9d00-3f8b-8059-afb645c6486c",
                        "entry_id": "97425a28-517d-37eb-b51e-510353ee6a9f",
                        "glosses": [
                            "bläuliche bis graue Schichtwolke in mittlerer Höhe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c76e063-6de5-47f6-a32f-94867bdf5022",
                                "sense_id": "ea4781ba-9d00-3f8b-8059-afb645c6486c",
                                "text": "Oftmals bedeckt die Altostratus den gesamten Himmel, wobei auch teilweise von Altostratus bedeckte Himmel vorkommen."
                            },
                            {
                                "example_id": "5a8d4973-3cbb-4921-9bb6-e51edb159720",
                                "sense_id": "ea4781ba-9d00-3f8b-8059-afb645c6486c",
                                "text": "In manchen Bereichen ist die Altostratus gerade so dünn, dass ein wenig Sonne hindurchscheinen kann."
                            },
                            {
                                "example_id": "7d3a5726-4bbe-40a3-b57f-de429e14390f",
                                "sense_id": "ea4781ba-9d00-3f8b-8059-afb645c6486c",
                                "text": "„Altostratus sind ein Zeichen einer aufziehenden Warmfront und sagen uns, dass es in den nächsten drei bis sieben Stunden Regen geben wird“, so Neuen."
                            },
                            {
                                "example_id": "5892d5ce-2653-4155-853a-dfa0c906bb9a",
                                "sense_id": "ea4781ba-9d00-3f8b-8059-afb645c6486c",
                                "text": "Aus Cirrus- oder Cirrostratus-Wolken entwickeln sich Altostratus, aus ihnen werden Nimbostratus-Wolken, und es beginnt zu regnen."
                            },
                            {
                                "example_id": "d2375558-fc42-43a8-bf82-3f386391697a",
                                "sense_id": "ea4781ba-9d00-3f8b-8059-afb645c6486c",
                                "text": "Durch Altostratus kann die Sonne zeitweise „milchig“ hindurch scheinen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
