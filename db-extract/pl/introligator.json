                "senses": [
                    {
                        "sense_id": "b4b779cd-93d4-3108-af52-873b827e359d",
                        "entry_id": "40efc031-f6f4-36da-a537-aa3829c7b8bc",
                        "glosses": [
                            "osoba zajmująca się zawodowo oprawą książek i innych wydawnictw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89b07e29-04a5-46d7-9271-74177644dd86",
                                "sense_id": "b4b779cd-93d4-3108-af52-873b827e359d",
                                "text": "Drukarnia zatrudni krajacza i introligatorów."
                            },
                            {
                                "example_id": "482b2bab-3194-4040-9e7d-0aadb725c641",
                                "sense_id": "b4b779cd-93d4-3108-af52-873b827e359d",
                                "text": "Książki są często brudne, mokre, oblepione pajęczynami, ale znajomy introligator, pan Wiesio, potrafi przywrócić im dawny blask"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2e9a617-0f58-4c98-af36-79dc0766b598",
                        "source_entry_id": "40efc031-f6f4-36da-a537-aa3829c7b8bc",
                        "source_sense_id": "b4b779cd-93d4-3108-af52-873b827e359d",
                        "target_lang_word": "bookbinder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bookbinder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26eed288-131f-388b-af3d-533a73d7705a",
                                        "entry_id": "c535f7dd-8ce3-3e1c-9690-9d9df9f88aa1",
                                        "glosses": [
                                            "A person whose profession is binding pages together to form books."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8482a397-3284-4c95-adf0-ddb7dd14f35e",
                                                "sense_id": "26eed288-131f-388b-af3d-533a73d7705a",
                                                "text": "Places of Employment: About 69,000 bookbinders and bindery workers were employed [in the United States] in 1978. Many worked in shops that specialize in bookbinding; others work in the bindery departments of book printing firms, commercial printing plants, and large libraries. Some bookbinders worked for the Federal Government. Although bookbinders work in all parts of the country, employment is concentrated in large printing centers such as New York City, Chicago, Washington, D.C., Los Angeles, and Philadelphia. […] Training, Other Qualifications, and Advancement: A 4- or 5-year apprenticeship, which includes on-the-job training as well as related classroom instruction, generally is required to qualify as a skilled bookbinder. Apprenticeship applicants usually must have a high school education, mechanical aptitude, and be at least 18 years of age. […] Employment Outlook: Employment of bookbinders and bindery workers is expected to increase more slowly than the average for all occupations through the 1980's. Nevertheless, some job openings will arise as experienced workers retire, die, or change occupations. Despite the anticipated increase in the amount of bound printed materials, employment growth will be limited by the increasing mechanization of bindery operations. Job opportunities are expected to be better for skilled bookbinders than for bindery workers since many tasks that bindery workers used [to] perform by hand will be done by machine."
                                            },
                                            {
                                                "example_id": "ce352de8-774e-4c01-8e9a-8fe7fbf6e9c6",
                                                "sense_id": "26eed288-131f-388b-af3d-533a73d7705a",
                                                "text": "During his seven-year apprenticeship to a bookbinder, [Michael] Faraday came across a single volume that changed his life: Isaac Watts's The Improvement of the Mind. Now largely forgotten, it was an early self-help book that contained a list of sixteen general rules for the improvement of knowledge. It also contained an overview of books and reading, a guide for study and meditation, tips on improving one's memory, and other suggestions for the betterment of the self. Faraday happened to read it just as he was developing a fascination with science, particularly the then-mysterious field of electricity, and he embraced the book's principles and suggestions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c7567a7-a464-4bea-a5f5-18ba8ff73aa4",
                        "source_entry_id": "40efc031-f6f4-36da-a537-aa3829c7b8bc",
                        "source_sense_id": "b4b779cd-93d4-3108-af52-873b827e359d",
                        "target_lang_word": "Buchbinder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchbinder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                        "entry_id": "1bdbdda3-194b-356d-b43d-460c0fc95f92",
                                        "glosses": [
                                            "Person, die Bücher bindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1a68ca2-9d31-4104-9d78-5a43150f5172",
                                                "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                                "text": "„Aber die Buchbinder geben sich kaum die Mühe, Schnittfarben zu mischen. Sie verwenden gern einerlei Farbtöne und vernachlässigen die Ausbildung ihres Farbensinnes. Das ist schade.“"
                                            },
                                            {
                                                "example_id": "e9056e0f-c716-414c-8342-95baf03ea824",
                                                "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                                "text": "„Der Buchbinder wollte wissen, weshalb kein Arbeiter eingeladen war, da es doch um einen Arbeiterverein ginge.“"
                                            },
                                            {
                                                "example_id": "9d21089c-4b7c-41d5-a2e6-7edfed3c579a",
                                                "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                                "text": "„Der Buchbinder war, ohne es vorerst näher eingrenzen zu können, bis um 1505 in Süddeutschland tätig.“"
                                            },
                                            {
                                                "example_id": "81fcd2cb-7a7b-42c8-a9b3-ae32c3825cfb",
                                                "sense_id": "1aac9e6b-15a5-3dcb-b9f1-7a02b0b22c57",
                                                "text": "„Ferner war beim Buchbinder eine Kassette zu bestellen, die zur Aufnahme des Testaments bestimmt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c69ad59-95e6-4f22-a461-80739fff6fc8",
                        "source_entry_id": "40efc031-f6f4-36da-a537-aa3829c7b8bc",
                        "source_sense_id": "b4b779cd-93d4-3108-af52-873b827e359d",
                        "target_lang_word": "переплётчик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "переплётчик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1eedcf8a-4ce3-3c60-a773-60c06faa4479",
                                        "entry_id": "5e808e85-56f7-36b7-aef8-ad18ae47bf3f",
                                        "glosses": [
                                            "специалист по переплётному делу; тот, кто занимается переплетением, переплётными работами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea1d394c-c2c0-45df-ab0b-8249286072fe",
                                                "sense_id": "1eedcf8a-4ce3-3c60-a773-60c06faa4479",
                                                "text": "Он был искусный переплетчик и, несмотря на помешательство, оставил даже очень хорошую самостоятельную систему по части инсектологии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c51d7c5-6c8e-438a-9a9e-14bc9c121c5c",
                        "source_entry_id": "40efc031-f6f4-36da-a537-aa3829c7b8bc",
                        "source_sense_id": "b4b779cd-93d4-3108-af52-873b827e359d",
                        "target_lang_word": "интролигатор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "интролигатор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d69e3a-4c4d-34f0-a0bc-52503bac8900",
                                        "entry_id": "9a4b3258-be24-3f79-91a8-b14635589866",
                                        "glosses": [
                                            "устар. переплётчик"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6373a56-0105-4d80-a6d2-3347d8fe1a98",
                                                "sense_id": "a6d69e3a-4c4d-34f0-a0bc-52503bac8900",
                                                "text": "Проситель в малопонятных выражениях, из коих трудно было добраться до смысла, рассказывал следующее: он был «интролигатор», то есть переплётчик, и, обращаясь по своему мастерству с разными книгами, «посядал много науки в премудрость божаго слова пообширного рассуждения»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
