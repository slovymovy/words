                                        "glosses": [
                                            "Pertaining to, or in accordance with the theories of, ancient Greek physician and philosopher Hippocrates."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c1ff259-5646-4d64-9861-3adeb2ee026d",
                                                "sense_id": "110e1b12-5a62-3e89-997f-18fe9dfb8e31",
                                                "text": "As a means of restoring vigor to the generative organs, flagellation was recommended by the ancient physicians as an effectual remedy, in accordance with the Hippocratic principle of ubi stimulus, ibi affluxus."
                                            },
                                            {
                                                "example_id": "ccbf7d30-1735-4ede-bd74-e1128c76c9d2",
                                                "sense_id": "110e1b12-5a62-3e89-997f-18fe9dfb8e31",
                                                "text": "Technology doesn't have a Hippocratic oath."
                                            }
                                        ]
                                    }
                                ]
                            }
