                    },
                    {
                        "translation_id": "7f0c1bd9-942b-459f-a66c-86bbcae82d7f",
                        "source_entry_id": "e28f212a-03b5-37bd-b9d3-af5ebcf9b3d7",
                        "source_sense_description": "предполагать, допускать что-либо дурное",
                        "target_lang_word": "se douter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se douter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46facbc8-3ad4-33b5-bda8-9fb81e52b32f",
                                        "entry_id": "3893d863-e436-3d80-86bd-a56fef7da0c6",
                                        "glosses": [
                                            "Imaginer, penser, croire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ffe3dbe-df15-40ce-9df1-48292bf9b109",
                                                "sense_id": "46facbc8-3ad4-33b5-bda8-9fb81e52b32f",
                                                "text": "Je me doutais bien d’une supercherie, alors même que rien ne me permettait de supposer que vous ne fussiez pas Butteridge."
                                            },
                                            {
                                                "example_id": "91b41a8f-c2b0-4456-8744-69f3950de3d4",
                                                "sense_id": "46facbc8-3ad4-33b5-bda8-9fb81e52b32f",
                                                "text": "Qui pouvait se douter que la vieille possédât de l’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11b43e8d-17f8-3243-a360-7a44196ea35d",
                                        "entry_id": "3893d863-e436-3d80-86bd-a56fef7da0c6",
                                        "glosses": [
                                            "Croire sur quelque apparence, conjecturer, soupçonner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ffb55c8-a917-4288-bfc9-a63983108246",
                                                "sense_id": "11b43e8d-17f8-3243-a360-7a44196ea35d",
                                                "text": "Oh ! vous savez, vous ne seriez pas prévenu, vous vous douteriez pas des opérations qui s’y goupillent. C’est pépère, même coquet et bien propre."
                                            },
                                            {
                                                "example_id": "a0c1d854-cfba-479f-8212-9b4bc943a946",
                                                "sense_id": "11b43e8d-17f8-3243-a360-7a44196ea35d",
                                                "text": "Il déroulait les curiosités, dépistait les espionnages, se servant de ses amis, sans qu’ils se doutassent du rôle qu'il leur faisait jouer."
                                            },
                                            {
                                                "example_id": "44a27d45-5498-4519-8646-513b70a06517",
                                                "sense_id": "11b43e8d-17f8-3243-a360-7a44196ea35d",
                                                "text": "Je m’en suis toujours douté."
                                            },
                                            {
                                                "example_id": "7cec7035-ce6e-40dd-8525-7ea72f49a9a8",
                                                "sense_id": "11b43e8d-17f8-3243-a360-7a44196ea35d",
                                                "text": "Il a été pris lorsqu’il s’en doutait le moins."
                                            },
                                            {
                                                "example_id": "8bb09135-6dce-4409-a7d0-e751b29b2ccb",
                                                "sense_id": "11b43e8d-17f8-3243-a360-7a44196ea35d",
                                                "text": "Il ne se doutait pas qu’on eût des preuves contre lui."
                                            },
                                            {
                                                "example_id": "1bd68324-0df7-4d94-89cb-6a2953275ab6",
                                                "sense_id": "11b43e8d-17f8-3243-a360-7a44196ea35d",
                                                "text": "Il se croit très habile dans cet art, mais il ne s’en doute pas,",
                                                "translation": "Il ne le connaît que fort imparfaitement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
