                    {
                        "translation_id": "9e8fd891-0355-4a61-9005-f8a14bfc5789",
                        "source_entry_id": "2593b230-b531-3ecd-8147-e9a89331bb0d",
                        "source_sense_description": "shortened word",
                        "target_lang_word": "aphérèse",
