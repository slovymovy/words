{
    "word_family": [
        "master",
        "mind"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "52022125-b8ef-34d8-bb2d-0e1011d51e8b",
                    "sense_definition": "A person who plans and directs an ingenious or complex scheme or operation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organizer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Detectives believe they have arrested the <w>mastermind</w> behind the recent bank robbery.",
                            "target_lang_translations": {
                                "tr": "Dedektifler, son banka soygununun arkasındaki <w>beyni</w> yakaladıklarına inanıyor."
                            }
                        },
                        {
                            "text": "She was the criminal <w>mastermind</w> who organized the intricate smuggling ring.",
                            "target_lang_translations": {
                                "tr": "O, karmaşık kaçakçılık şebekesini organize eden suç <w>elebaşıydı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "architect",
                        "brainchild",
                        "director"
                    ],
                    "common_phrases": [
                        "criminal mastermind",
                        "mastermind behind"
                    ],
                    "target_lang_definitions": {
                        "tr": "Karmaşık veya ustaca hazırlanmış bir planı, operasyonu tasarlayıp yöneten kişi; elebaşı veya mimar."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "beyin",
                                "target_lang_sense_clarification": "bir planı veya operasyonu yöneten akıl hocası"
                            },
                            {
                                "target_lang_word": "elebaşı",
                                "target_lang_sense_clarification": "özellikle yasa dışı veya gizli bir eylemi yöneten kimse"
                            },
                            {
                                "target_lang_word": "mimar",
                                "target_lang_sense_clarification": "bir planın veya operasyonun arkasındaki kurucu akıl"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeaaca12-6ca3-3dfa-8cd5-aa23b54be5c4",
                    "sense_definition": "A person with outstanding intellect, creativity, or skill.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hired a tech <w>mastermind</w> to develop their next-generation software.",
                            "target_lang_translations": {
                                "tr": "Şirket, yeni nesil yazılımlarını geliştirmek için bir teknoloji <w>dehasını</w> işe aldı."
                            }
                        },
                        {
                            "text": "Many consider him a financial <w>mastermind</w> for turning around the struggling firm.",
                            "target_lang_translations": {
                                "tr": "Birçok kişi, zor durumdaki şirketi toparladığı için onu bir finans <w>dâhisi</w> olarak görüyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "genius",
                        "intellect",
                        "prodigy"
                    ],
                    "common_phrases": [
                        "financial mastermind"
                    ],
                    "target_lang_definitions": {
                        "tr": "Üstün zekâsı, yaratıcılığı veya yeteneği olan dâhi kimse."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "deha",
                                "target_lang_sense_clarification": "olağanüstü zekâya sahip kişi"
                            },
                            {
                                "target_lang_word": "üstün zekâ",
                                "target_lang_sense_clarification": "yüksek zekâ ve beceriye sahip kimse"
                            },
                            {
                                "target_lang_word": "dâhi",
                                "target_lang_sense_clarification": "alanında olağanüstü yetenekli kişi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c6dfe73-1156-3c60-81b7-9d5ede22b203",
                    "sense_definition": "To plan and direct a complex scheme, project, or operation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "organizer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>masterminded</w> the successful election campaign from start to finish.",
                            "target_lang_translations": {
                                "tr": "Başarılı seçim kampanyasını başından sonuna kadar o <w>planlayıp yönetti</w>."
                            }
                        },
                        {
                            "text": "The general was chosen to <w>mastermind</w> the secret military operation.",
                            "target_lang_translations": {
                                "tr": "General, gizli askerî operasyonu <w>yönetmesi</w> için seçildi."
                            }
                        }
                    ],
                    "synonyms": [
                        "engineer",
                        "orchestrate",
                        "direct"
                    ],
                    "common_phrases": [
                        "mastermind a plan",
                        "mastermind a campaign"
                    ],
                    "target_lang_definitions": {
                        "tr": "Karmaşık bir planı, projeyi veya operasyonu ustalıkla planlamak ve yönetmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "planlamak",
                                "target_lang_sense_clarification": "tasarlayıp hayata geçirmek"
                            },
                            {
                                "target_lang_word": "yönetmek",
                                "target_lang_sense_clarification": "bir projenin veya planın başında bulunmak"
                            },
                            {
                                "target_lang_word": "tezgâhlamak",
                                "target_lang_sense_clarification": "özellikle gizli veya karmaşık bir planı organize etmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}