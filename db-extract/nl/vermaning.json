                ],
                "senses": [
                    {
                        "sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                        "entry_id": "fa827805-5a24-37c5-9951-8910cd4d77b2",
                        "glosses": [
                            "met veel nadruk zeggen dat iemand zijn leven moet beteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "313a960a-b668-4a06-84c4-efc34a8e8a32",
                                "sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                                "text": "1.280 varkens in nood en dan wegkomen met een vermaning."
                            },
                            {
                                "example_id": "613299eb-9fe3-46aa-bb11-e4ea4faf05f5",
                                "sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                                "text": "Nogal onbeleefd in de ogen van Afrikaanse gezagsdragers, maar hij deed er de studenten in het warme zaaltje een plezier mee. Wie als gelijke wil worden behandeld, moet tegen een geintje en een stootje kunnen, is Macrons impliciete vermaning."
                            },
                            {
                                "example_id": "1c860d85-5285-49f4-8b24-48b70ca13016",
                                "sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                                "text": "Vanaf Sociale Zaken meldde zich staatssecretaris Tamara van Ark met een vermaning aan het adres van de gemeenten: hoogste tijd dat zij nu echt eens de 'taaleis'gaan handhaven in de bijstand. Dat betekent dat bijstandsgerechtigden de Nederlandse taal moeten beheersen of die snel moeten gaan leren."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d878327-09dc-36cc-adce-766e0eacaf91",
                        "entry_id": "fa827805-5a24-37c5-9951-8910cd4d77b2",
                        "glosses": [
                            "doopsgezinde kerk"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73482381-bc76-48b6-bc8c-0541be527133",
                        "source_entry_id": "fa827805-5a24-37c5-9951-8910cd4d77b2",
                        "source_sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                        "source_sense_description": "waarschuwing",
                        "target_lang_word": "warning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d18326c2-adc0-3421-9d3b-b2789cc5020a",
                                        "entry_id": "e15b9947-7123-3eed-b748-ac07747bacae",
                                        "glosses": [
                                            "present participle of warn"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "714d661c-5c3e-47b7-abf9-ad190e201b43",
                                                "sense_id": "d18326c2-adc0-3421-9d3b-b2789cc5020a",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness,[…]. It was with a palpable relief that he heard the first warning notes of the figure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "196576a3-8eb3-3c89-9b36-3945c174bf34",
                                        "entry_id": "eb6f05bc-cb42-3439-805c-3816cb415f62",
                                        "glosses": [
                                            "The action of the verb warn; an instance of warning someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17291c83-c313-47a7-a4f1-edf0f88351a5",
                                                "sense_id": "196576a3-8eb3-3c89-9b36-3945c174bf34",
                                                "text": "“[…] Churchill, my dear fellow, we have such greedy sharks, and wolves in lamb's clothing. Oh, dear, there's so much to tell you, so many warnings to give you, but all that must be postponed for the moment.”"
                                            },
                                            {
                                                "example_id": "e8cf8cff-826a-4628-8105-aca963a5443d",
                                                "sense_id": "196576a3-8eb3-3c89-9b36-3945c174bf34",
                                                "text": "Without much warning, a deep voice addressed the crowd, calling for a reverent silence as the Texans who died at the Alamo battle were named."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95bb4b0-520c-3649-9d00-cfdc0fd2923e",
                                        "entry_id": "eb6f05bc-cb42-3439-805c-3816cb415f62",
                                        "glosses": [
                                            "Something spoken or written that is intended to warn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba0af597-65be-4afe-ba9c-d882551eb4ae",
                                                "sense_id": "c95bb4b0-520c-3649-9d00-cfdc0fd2923e",
                                                "text": "The boss gave him a warning that he would be fired if he did not desist from his behaviour."
                                            },
                                            {
                                                "example_id": "c93e111d-0d40-4721-b7c8-894656861fe8",
                                                "sense_id": "c95bb4b0-520c-3649-9d00-cfdc0fd2923e",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c37516c-a253-390b-9fa4-9042ffe011c4",
                                        "entry_id": "2d4e0929-e6de-3aeb-804f-e049992d6a75",
                                        "glosses": [
                                            "Used to warn of danger in signs and notices."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e604cd8c-381b-4456-8fae-024874732f1c",
                        "source_entry_id": "fa827805-5a24-37c5-9951-8910cd4d77b2",
                        "source_sense_id": "27491f8d-02b4-3d6f-ba68-dadd0d70872e",
                        "source_sense_description": "waarschuwing",
                        "target_lang_word": "exhortation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exhortation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8d2daf2-ba15-3fe7-8f92-99af2af11834",
                                        "entry_id": "c8b4191e-85e8-3d0c-98ab-c670cd1ee183",
                                        "glosses": [
                                            "The act or practice of exhorting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a869ff-68cf-40ab-8d71-3fee334bcee2",
                                                "sense_id": "d8d2daf2-ba15-3fe7-8f92-99af2af11834",
                                                "text": "All gladly drew round the table, and Mrs. Palmer's exhortation of “Poor dears, do enjoy yourselves,” was fulfilled, even to her own satisfaction."
                                            },
                                            {
                                                "example_id": "7d5b15f3-51c9-40fd-87f5-76a79bb6f70b",
                                                "sense_id": "d8d2daf2-ba15-3fe7-8f92-99af2af11834",
                                                "text": "Earlier on the Other stage on Friday afternoon, Charli XCX took a more straightforward, rabble-rousing approach, a flurry of confetti cannon, inflatables and exhortations to wild hedonism: “I hope everyone gets really fucked up this weekend!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d95a4b-6348-321c-9b2c-0843c9c08bfa",
                                        "entry_id": "c8b4191e-85e8-3d0c-98ab-c670cd1ee183",
                                        "glosses": [
                                            "Language intended to give advice or to urge or encourage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a26ab0ec-0519-400c-8050-39808cc559f3",
                                                "sense_id": "52d95a4b-6348-321c-9b2c-0843c9c08bfa",
                                                "text": "Come good Lorenzo, faryewell a while,\nIle end my exhortation after dinner."
                                            },
                                            {
                                                "example_id": "9e1f2547-8931-4e34-aead-24d6d01eb943",
                                                "sense_id": "52d95a4b-6348-321c-9b2c-0843c9c08bfa",
                                                "text": "And ye haue forgotten the exhortation which speaketh vnto you as vnto children, My sonne, despise not thou the chastening of the Lord, nor faint when thou art rebuked of him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
