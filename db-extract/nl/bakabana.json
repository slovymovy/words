                        "examples": [
                            {
                                "example_id": "54984570-e46b-43cd-9110-3e4769141e0d",
                                "sense_id": "bf4153f1-22f4-3034-9b92-0947072b3d8f",
                                "text": "En in landen als Suriname snappen ze dat de banaan ook prima als smaakmaker bij een vol bord met pittige bami past in de vorm van bakabana (gebakken in deeg). Bananenpannenkoeken kennen ze ook over de hele wereld."
                            },
                            {
                                "example_id": "7ef8293f-3e11-4a8b-b42d-8ec4c1c4dfa6",
                                "sense_id": "bf4153f1-22f4-3034-9b92-0947072b3d8f",
                                "text": "De bakabana met pindasaus(€1,75) is redelijk, een ­dikker en knapperig deegjasje had hem echter niet misstaan. Maar de pindasaus maakt alles goed: o, wat is die goddelijk, met lekker veel stukjes noot erin."
                            }
                        ]
                    }
