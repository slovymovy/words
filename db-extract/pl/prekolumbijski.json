                "senses": [
                    {
                        "sense_id": "4368a128-8d01-3978-bc69-34077d70082c",
                        "entry_id": "790946bf-921d-3889-bed9-20e56e386d45",
                        "glosses": [
                            "odnoszący się do czasów przed odkryciem Ameryki przez Krzysztofa Kolumba"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5f7868-ca2c-4483-bdd0-65fb65bd5052",
                                "sense_id": "4368a128-8d01-3978-bc69-34077d70082c",
                                "text": "Wspólną cechą architektury prekolumbijskiej było wznoszenie budowli o kształcie piramidy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "835fdba1-7a58-4d4c-afa2-5356d958c13d",
                        "source_entry_id": "790946bf-921d-3889-bed9-20e56e386d45",
                        "source_sense_id": "4368a128-8d01-3978-bc69-34077d70082c",
                        "target_lang_word": "pre-Columbian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pre-Columbian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "178df853-4352-358d-89f5-4f70355a3e0b",
                                        "entry_id": "6801a8ff-4038-3817-9c66-866756cfc025",
                                        "glosses": [
                                            "Before the voyages of Christopher Columbus of the 1490s which introduced greatly widened contacts between Eurasia and the Americas."
                                        ],
                                        "tags": [
                                            "historical",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f1bf3b4-2198-45c1-b9c0-cf8fa4ee3147",
                                                "sense_id": "178df853-4352-358d-89f5-4f70355a3e0b",
                                                "text": "since pre-Columbian times"
                                            },
                                            {
                                                "example_id": "1d9aea1a-ec03-4ec3-9f98-0b289e467d83",
                                                "sense_id": "178df853-4352-358d-89f5-4f70355a3e0b",
                                                "text": "unknown in Europe in pre-Columbian times"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c88feab5-f56f-398d-be05-788b9cea2b6e",
                                        "entry_id": "6801a8ff-4038-3817-9c66-866756cfc025",
                                        "glosses": [
                                            "Referring to the cultures of the Americas before the European influence, specifically to the era before the continent was visited by Christopher Columbus."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4471a656-dbc0-4619-af12-f480d06e8f62",
                                                "sense_id": "c88feab5-f56f-398d-be05-788b9cea2b6e",
                                                "text": "pre-Columbian cultures"
                                            },
                                            {
                                                "example_id": "151841f7-587d-47ad-92fa-c921eea77b91",
                                                "sense_id": "c88feab5-f56f-398d-be05-788b9cea2b6e",
                                                "text": "pre-Columbian civilizations"
                                            },
                                            {
                                                "example_id": "538e03a1-f1a3-4bc9-8997-215da7cdfa78",
                                                "sense_id": "c88feab5-f56f-398d-be05-788b9cea2b6e",
                                                "text": "In fact, the dating of pre-Columbian Andean cultures was largely a matter of guesswork."
                                            },
                                            {
                                                "example_id": "4a9cb004-c468-4e42-b6f1-4750ff2e933e",
                                                "sense_id": "c88feab5-f56f-398d-be05-788b9cea2b6e",
                                                "text": "Boys trained to be warriors, but why did pre-Columbian peoples battle one another?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08368522-13a3-48df-8233-24263f70081a",
                        "source_entry_id": "790946bf-921d-3889-bed9-20e56e386d45",
                        "source_sense_id": "4368a128-8d01-3978-bc69-34077d70082c",
                        "target_lang_word": "précolombien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précolombien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2114337-33d9-3406-89bc-803a62e53a11",
                                        "entry_id": "25cc52b3-6c00-3597-8f62-75e52b744e5f",
                                        "glosses": [
                                            "Relatif aux peuples qui occupaient l’Amérique, en particulier sa partie centrale (sud du Mexique, Amérique centrale et nord de l’Amérique du Sud), à leur histoire et à leurs civilisations, avant le voyage de Christophe Colomb et la conquête par les Espagnols."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d29f65ec-e6a4-465c-bebd-cba5de067349",
                                                "sense_id": "c2114337-33d9-3406-89bc-803a62e53a11",
                                                "text": "Guanajuato est le type d’endroit qui donne envie de se renseigner davantage sur le passé du pays, d’autant plus que ses monuments disent la même chose que les livres: le legs mexicain est double, précolombien et espagnol, tricoté serré."
                                            },
                                            {
                                                "example_id": "c6c313b6-3013-4261-9e2f-3961863c5d03",
                                                "sense_id": "c2114337-33d9-3406-89bc-803a62e53a11",
                                                "text": "Très interactif, le périple que nous propose le musée nous transporte vers l’Amérique du Sud, à la découverte de la richesse et de la diversité des civilisations précolombiennes qui se sont développées au Pérou pendant des milliers d’années."
                                            },
                                            {
                                                "example_id": "a6ce9aa0-5fca-4968-8c85-7842ce369c3e",
                                                "sense_id": "c2114337-33d9-3406-89bc-803a62e53a11",
                                                "text": "Il l’aurait acheté auprès d’Eugène Boban, un archéologue amateur et antiquaire, qui voyageait entre la France et le Mexique et vendait des objets précolombiens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d8e2612-d6e2-4121-a21a-b7e7f7b73fcc",
