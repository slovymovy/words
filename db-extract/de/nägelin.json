                ],
                "senses": [
                    {
                        "sense_id": "57adef31-0fc7-355d-bb90-fb8d195b26cd",
                        "entry_id": "f6ddfdea-b901-3903-a2b1-a44c76e78340",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f5c9076-2d0b-4c94-913e-6501f5628925",
                                "sense_id": "57adef31-0fc7-355d-bb90-fb8d195b26cd",
                                "text": "Frau Nägelin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "60a2713d-64bd-40d8-90ea-1deafce0da7b",
                                "sense_id": "57adef31-0fc7-355d-bb90-fb8d195b26cd",
                                "text": "Herr Nägelin wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9dc1addf-c8b5-4038-a40e-ef24f39d62f8",
                                "sense_id": "57adef31-0fc7-355d-bb90-fb8d195b26cd",
                                "text": "Die Nägelins fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1f2e5375-7a8e-4dac-ba90-69c042bab2f8",
                                "sense_id": "57adef31-0fc7-355d-bb90-fb8d195b26cd",
                                "text": "Der Nägelin trägt nie die Pullover, die die Nägelin ihm strickt."
                            },
                            {
                                "example_id": "f2c386d5-9c7e-4231-99ad-636b8c3391a6",
                                "sense_id": "57adef31-0fc7-355d-bb90-fb8d195b26cd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Nägelin kommt, geht der Herr Nägelin.“"
                            },
                            {
                                "example_id": "8cd83866-053a-4fc6-974d-0ee57fcb5e01",
                                "sense_id": "57adef31-0fc7-355d-bb90-fb8d195b26cd",
                                "text": "Nägelin kommt und geht."
                            },
                            {
                                "example_id": "8ef3b94c-c35b-4ab1-9614-1ec1987d8c97",
                                "sense_id": "57adef31-0fc7-355d-bb90-fb8d195b26cd",
                                "text": "Nägelins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
