                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bdad15c-0c66-4df8-9fb6-2a4ed43f59e5",
                                                "sense_id": "5a493958-4276-3353-b335-8f7356e0e8ac",
                                                "text": "Stettin ist die Hauptstadt der polnischen Woiwodschaft Westpommern."
                                            },
                                            {
                                                "example_id": "02093e08-c64e-4f7d-b160-1cacd6ab77f5",
                                                "sense_id": "5a493958-4276-3353-b335-8f7356e0e8ac",
                                                "text": "Das heutige Stettin ist mit 410.000 Einwohnern eine der größten Städte Polens."
                                            },
                                            {
                                                "example_id": "ec929d69-d450-4e63-a668-e749db3e1841",
                                                "sense_id": "5a493958-4276-3353-b335-8f7356e0e8ac",
                                                "text": "Ich bin in Stettin geboren."
                                            },
                                            {
                                                "example_id": "3885f72e-3c84-4be6-b84f-6983522877b2",
                                                "sense_id": "5a493958-4276-3353-b335-8f7356e0e8ac",
                                                "text": "Ich habe in Stettin meinen Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "03d1739a-9bbd-49f0-b71b-f2fcbc9bf62d",
                                                "sense_id": "5a493958-4276-3353-b335-8f7356e0e8ac",
                                                "text": "Nach Stettin führen viele Wege."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c8b714cf-61c9-31f1-aa30-9f1c3567be24",
