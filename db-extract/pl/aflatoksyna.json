                "translations": [
                    {
                        "translation_id": "697cd486-73e2-4ab0-bf5f-11f8265c90bb",
                        "source_entry_id": "02259181-0ae1-3abc-b432-7271751d2372",
                        "source_sense_id": "194fb08c-44c3-3eb0-b098-cbe96a389b4f",
                        "target_lang_word": "aflatoxin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aflatoxin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b28ff6af-6ceb-3f78-9663-1879ff376bdc",
                                        "entry_id": "c23645ad-0c4d-392e-ba9e-6dbbdc1c7f9d",
                                        "glosses": [
                                            "Any of a family of mycotoxins, produced by molds of the Aspergillus genus, that can be toxic, carcinogenic, mutagenic or teratogenic; typically found as contaminants of animal food or peanuts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eccff421-5a68-41aa-8f6e-dd71f24dbb59",
                        "source_entry_id": "02259181-0ae1-3abc-b432-7271751d2372",
                        "source_sense_id": "194fb08c-44c3-3eb0-b098-cbe96a389b4f",
                        "target_lang_word": "aflatoxine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aflatoxine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0349b6b-91e8-37d0-91d2-7b988e496ec7",
                                        "entry_id": "f04a8a17-b6dd-327a-ba6d-d6576c921877",
                                        "glosses": [
                                            "Groupe de 18 mycotoxines de structures moléculaires très proches. Elles sont produites par des champignons microscopiques du genre Aspergillus proliférant sur des graines conservées en atmosphère chaude et humide. Ces toxines provoquent un empoisonnement nommé aflatoxicose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af4bcd7-2a51-413d-a7d0-765ac338c928",
                                                "sense_id": "c0349b6b-91e8-37d0-91d2-7b988e496ec7",
                                                "text": "L’aflatoxine est un poison produit par un champignon (Aspergillus flavus) qui se trouve dans les farines d’arachide mal séchées..."
                                            },
                                            {
                                                "example_id": "bab92375-ae95-444a-b834-9288fe3b9dea",
                                                "sense_id": "c0349b6b-91e8-37d0-91d2-7b988e496ec7",
                                                "text": "L’aflatoxine est suspectée de favoriser les lésions hépatiques, qui peuvent évoluer en cirrhose puis dégénérer en tumeurs."
                                            },
                                            {
                                                "example_id": "44d40c5f-8782-469b-9d72-111907a273d8",
                                                "sense_id": "c0349b6b-91e8-37d0-91d2-7b988e496ec7",
                                                "text": "Les molécules d'aflatoxine présentent dans l'ultraviolet une fluorescence qui est utilisée pour leur détection, les molécules de fluorescence bleue sont dénommées aflatoxines B ( blue ) et les molécules de fluorescence verte aflatoxines G."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e7753d3-7ae9-46d5-9a56-34424cdd6194",
                        "source_entry_id": "02259181-0ae1-3abc-b432-7271751d2372",
                        "source_sense_id": "194fb08c-44c3-3eb0-b098-cbe96a389b4f",
                        "target_lang_word": "Aflatoxin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aflatoxin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                        "entry_id": "3ec20275-440a-3280-a973-d14480949287",
                                        "glosses": [
                                            "mutagenes und krebserregendes Gift (Toxin), das von einigen Schimmelpilzarten gebildet wird"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98341c9f-c213-49e4-a8c6-1f4a3c4aca2c",
                                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                                "text": "„1990 begann der Irak mit der Produktion von erheblichen Mengen an Milzbrand-Endosporen, Botulinus-Toxin und Aflatoxin.“"
                                            },
                                            {
                                                "example_id": "b952f8ee-f056-4038-b55a-2a880f469766",
                                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                                "text": "„Aflatoxine sind tödliche Pilzgifte, die durch Schimmel auf Nüssen und Samen gebildet werden.“"
                                            },
                                            {
                                                "example_id": "0045f5bd-111a-4b27-b375-81d6064beb4f",
                                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                                "text": "„Die Molekülgruppe der Aflatoxine spielt wirtschaftlich eine große Rolle.“"
                                            },
                                            {
                                                "example_id": "a58b9910-bbfa-436c-b8e1-d5b3972cbe99",
                                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                                "text": "„Alleine in den Entwicklungsländern sind über 4,5 Milliarden Menschen regelmäßig zu hohen Dosen von Aflatoxinen ausgesetzt.“"
                                            },
                                            {
                                                "example_id": "530e87ce-3fb8-4cdd-a859-2ea2c8d44d51",
                                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                                "text": "„In Europa und den USA sind strenge Grenzwerte für Aflatoxine in Lebensmitteln festgesetzt, trotzdem sind sie auch hier in Pistazien, Erdnüssen und Trockenfrüchten nachweisbar.“"
                                            },
                                            {
                                                "example_id": "7d3380d8-d73e-4451-8b1e-700dd325488a",
                                                "sense_id": "6a5e4f45-ef74-3858-b4bc-5be5a39d4a33",
                                                "text": "„Aflatoxine sind thermostabil, sie können also durch Hitze nicht zerstört werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
