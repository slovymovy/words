        "réériger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "29782460-d8d7-32fb-8ad4-9ce9b4de43a5",
                    "sense_definition": "Construire, élever ou dresser verticalement un monument, une statue ou un édifice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La ville a décidé d'<w>ériger</w> un monument pour rendre hommage aux soldats disparus."
                        },
                        {
                            "text": "Une statue majestueuse a été <w>érigée</w> au milieu du jardin public pour le centenaire."
                        }
                    ],
                    "synonyms": [
                        "dresser"
                    ],
                    "common_phrases": [
                        "ériger un monument",
                        "ériger une statue"
                    ]
                },
                {
                    "sense_id": "aa4e8423-f00b-315c-914b-c9c6ab1feea6",
                    "sense_definition": "Attribuer à quelqu'un ou à quelque chose un statut supérieur, une autorité ou une importance nouvelle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "statut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas <w>ériger</w> une simple exception en règle générale pour tous les cas."
                        },
                        {
                            "text": "Ce critique a la fâcheuse habitude de s'<w>ériger</w> en censeur de la morale publique."
                        }
                    ],
                    "common_phrases": [
                        "ériger en règle",
                        "ériger en principe",
                        "s'ériger en juge"
                    ]
                },
                {
                    "sense_id": "0397229b-eb23-30b8-a189-06b02cb011c4",
                    "sense_definition": "Instituer, fonder ou établir officiellement une entité administrative, juridique ou religieuse.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'assemblée a voté une loi afin d'<w>ériger</w> ce bourg isolé en commune autonome."
                        },
                        {
                            "text": "Le pape a choisi d'<w>ériger</w> cet ancien diocèse en archevêché métropolitain au seizième siècle."
                        }
                    ],
                    "common_phrases": [
                        "ériger en commune"
                    ]
                }
            ]
        }
    ]
