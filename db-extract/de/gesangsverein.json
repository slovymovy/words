                "senses": [
                    {
                        "sense_id": "1050133e-385e-30d8-9702-c824ed4cb35c",
                        "entry_id": "99e5a0de-5565-3ba1-be83-a289d43715f9",
                        "glosses": [
                            "Zusammenschluss von Sängern zur Ausübung und Pflege des Chorgesangs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcb2e35b-9dbd-4dc2-988e-0bf5dffa6f45",
                                "sense_id": "1050133e-385e-30d8-9702-c824ed4cb35c",
                                "text": "Das jährliche Sommerfest des örtlichen Gesangsvereins zieht immer viele Besucher an."
                            },
                            {
                                "example_id": "7a768b40-a07f-4d28-9ad5-db129c969ab0",
                                "sense_id": "1050133e-385e-30d8-9702-c824ed4cb35c",
                                "text": "„Also, wir sind ja hier nicht beim Gesangsverein, da können wir ja gleich zum olympischen Winter-Eiswürfel-Gießen gehen, wenn das ein Foul gewesen sein soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e34cf1f-419d-41ac-bdd0-7cfa0733d779",
                        "source_entry_id": "99e5a0de-5565-3ba1-be83-a289d43715f9",
                        "source_sense_id": "1050133e-385e-30d8-9702-c824ed4cb35c",
                        "source_sense_description": "Zusammenschluss von Sängern zur Ausübung und Pflege des Chorgesangs",
                        "target_lang_word": "chorale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chorale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9467ba92-9441-3907-9d5c-b309e36fdeec",
                                        "entry_id": "82985918-0395-3618-8a4d-0890c927a743",
                                        "glosses": [
                                            "Ensemble de personnes qui chantent à l’unisson ou à plusieurs voix des œuvres musicales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2017ab-0c48-48b0-b30f-86f0516b8098",
                                                "sense_id": "9467ba92-9441-3907-9d5c-b309e36fdeec",
                                                "text": "La maison est toujours pleine de monde, des repas avec animation, des concours de rummikub, de boules, des conférences, la chorale, le club informatique, le karaoké…"
                                            },
                                            {
                                                "example_id": "f0887347-3c3f-4302-a2d5-3c908e8a5935",
                                                "sense_id": "9467ba92-9441-3907-9d5c-b309e36fdeec",
                                                "text": "Seulement, j’ai toujours chanté comme une gamelle, et il suffisait que je me mêle à une chorale pour que ma voix fasse dérailler tous les autres."
                                            },
                                            {
                                                "example_id": "12af683f-5b73-4a18-9800-e0a8030cc1f4",
                                                "sense_id": "9467ba92-9441-3907-9d5c-b309e36fdeec",
                                                "text": "À son arrivée, John pensa qu’il régnait une atmosphère plutôt maussade en dépit des efforts d’une chorale galloise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chorale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1461f2a4-872f-3fe5-b947-f6b602e9bf8c",
                                        "entry_id": "950769a4-e748-371c-90eb-bf5a11740569",
                                        "glosses": [
                                            "Féminin singulier de choral."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfde81a3-bca4-4331-91cf-3455a897ba27",
                                                "sense_id": "1461f2a4-872f-3fe5-b947-f6b602e9bf8c",
                                                "text": "Une société chorale est une société qui s’assemble pour chanter des chœurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
