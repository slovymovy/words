                                    {
                                        "sense_id": "7fccdd61-b2b7-372f-8eae-49d42c3f5325",
                                        "entry_id": "b0e4944d-62ab-3537-b2bb-9a07df0524fe",
                                        "glosses": [
                                            "good, fine."
                                        ],
