                                "target_lang_word": "鲈鱼",
                                "target_lang_sense_clarification": "泛指鲈鱼类"
                            },
                            {
                                "target_lang_word": "海鲈",
                                "target_lang_sense_clarification": "指海产鲈鱼"
                            }
                        ]
