                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "c334fa05-afdf-4613-8dbd-0e11027f6f2e",
                                "sense_id": "56d0d923-e398-324e-ba3f-91b453ab1898",
                                "text": "„Es entspricht allgemeiner Erfahrung, daß die Verständlichkeit leidet, wenn eine gewisse Grenze des Redetempos überschritten wird.“"
                            },
                            {
                                "example_id": "719bc1cc-de14-446f-ab08-abf3fac835ff",
                                "sense_id": "56d0d923-e398-324e-ba3f-91b453ab1898",
                                "text": "„Das ist nicht nur für die Schauspielerinnen ein gutes Stück Arbeit, denn auch das Publikum muss sich ob der hohen Redetempi beim Zuhören nicht wenig konzentrieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
