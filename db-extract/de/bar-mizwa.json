                ],
                "senses": [
                    {
                        "sense_id": "80ec6385-9634-34d6-803b-f55de089babc",
                        "entry_id": "1845a29e-e39d-3dd7-9d67-56a76e7f4741",
                        "glosses": [
                            "jüdischer Junge, der sich am Sabbat nach dessen 13. Geburtstag auf die religiösen Vorschriften des Judentums verpflichtet"
                        ],
                        "tags": [
                            "jüdische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "4b35a590-dc59-4cdc-8c48-10f97b25a874",
                                "sense_id": "80ec6385-9634-34d6-803b-f55de089babc",
                                "text": "„Drei Monate vorher wird der Bar-Mizwa im Anlegen der Tephelin (s. d. A.) und in den damit in Verbindung stehenden Gesetzen unterrichtet.“"
                            },
                            {
                                "example_id": "9cc4c99d-89c3-4e46-92e7-ff9b459f05ff",
                                "sense_id": "80ec6385-9634-34d6-803b-f55de089babc",
                                "text": "„Mit der Hilfe eines Lehrers und eines Rabbis bereitet sich Albert darauf vor, ein ‚Bar-Mizwa‘, ein vollwertiges Mitglied in der jüdischen Gemeinde zu werden.“"
                            },
                            {
                                "example_id": "dcab5ced-1c00-4bcf-834f-a40b37135c18",
                                "sense_id": "80ec6385-9634-34d6-803b-f55de089babc",
                                "text": "„Im Alter von 13 Jahren wurde ich wie jeder jüdische Junge ein Bar-Mizwa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
