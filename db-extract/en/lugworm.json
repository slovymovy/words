                    {
                        "sense_id": "a7b8519b-809f-309c-b7e9-36710ca29022",
                        "entry_id": "494e1dd3-7107-317e-b457-0ad58e6de010",
                        "glosses": [
                            "Any of several species of large marine annelid worm of the genus Arenicola",
                            "especially the northern lugworm (Arenicola marina), whose coiled castings can often be seen on beaches at low tide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a555197-f23f-4b4c-b4cc-e8bcf0f0569f",
                                "sense_id": "a7b8519b-809f-309c-b7e9-36710ca29022",
                                "text": "The lugworms were shorter and lighter, with hispid gills and mucus-coloured tails."
                            }
                        ]
                    },
                    {
                        "sense_id": "acf619a3-bd7c-3de8-9045-efbed95cfd14",
                        "entry_id": "494e1dd3-7107-317e-b457-0ad58e6de010",
                        "glosses": [
                            "Any of several species of large marine annelid worm of the genus Arenicola",
                            "black lugworm (Arenicola defodiens)."
                        ],
                        "tags": [],
                        "examples": []
                    }
