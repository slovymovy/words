                        "examples": [
                            {
                                "example_id": "b8ba7277-453b-4d70-af2a-58bef4a7397a",
                                "sense_id": "2aa1c032-cd59-30b9-8bf5-b9642e99394e",
                                "text": "In de middag staat het toegepast onderzoek centraal bij een bezoek aan de National Botanic Gardens. Evert van den Akker van TNO presenteert daar het Smart Dairy Farming-programma dat melkveehouders moet helpen om de melkopbrengst op een duurzame manier te vergroten."
                            },
                            {
                                "example_id": "8c5eb91d-4319-4df3-869c-50e6a2ff8de8",
                                "sense_id": "2aa1c032-cd59-30b9-8bf5-b9642e99394e",
                                "text": "Hij heeft een melkveebedrijf. Bij het afstoten van een deel van zijn veestapel heeft hij gekeken naar de melkopbrengst. Zijn 80 roodbonte MRIJ-koeien geven zo'n 7000 liter melk per jaar; de Lakenvelders - van oudsher sierkoeien - geven slechts 4000 liter. Die gaan daarom in de verkoop."
                            }
                        ]
                    }
