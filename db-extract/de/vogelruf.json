                        "examples": [
                            {
                                "example_id": "817bf32f-7b77-4d4f-808a-39cb7ead9137",
                                "sense_id": "67895c79-4265-3927-a6ab-cd13bcd8e4db",
                                "text": "Im Wald hört er einen Vogel und er erkannte sofort, dass es der Vogelruf einer Amsel war."
                            },
                            {
                                "example_id": "f41b309b-27c3-425e-9817-d00cc4c6dd3b",
                                "sense_id": "67895c79-4265-3927-a6ab-cd13bcd8e4db",
                                "text": "„Neben Amalias Stimme waren die tickende Wanduhr, die leisen Vogelrufe und das Rascheln der Zeitung die einzigen Geräusche im Haus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
