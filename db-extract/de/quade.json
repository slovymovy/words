                "senses": [
                    {
                        "sense_id": "747a641b-2d70-376f-919e-29949f8748fb",
                        "entry_id": "195c5f1b-89a1-38b3-a889-b33649b484b2",
                        "glosses": [
                            "Angehöriger eines kleinen suebischen Volkstammes der Germanen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b328aae1-1293-4efa-a573-7ff5041b7254",
                                "sense_id": "747a641b-2d70-376f-919e-29949f8748fb",
                                "text": "„Die Priester des heil. Petrus, welche nichts von diesem Befehle gewußt hatten, hatten die güldenen und silbernen Gefäße ihrer Kirche in einem abgelegenen Hause verborgen; ein Quade fand sie.“"
                            },
                            {
                                "example_id": "307be4bf-b6f9-42e9-b5e1-ae4e831262b7",
                                "sense_id": "747a641b-2d70-376f-919e-29949f8748fb",
                                "text": "„Im Jahr 254 fielen die Quaden erstmals in die römische Provinz Pannonien ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
