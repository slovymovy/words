                    },
                    {
                        "form_id": "25cf89e8-e586-46bb-9a20-d886695debba",
                        "entry_id": "ac6d4659-f652-3c3e-a34f-7352cf326b81",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "infrastructuurtjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70016481-f58a-3431-8524-393eb96fcf3e",
                        "entry_id": "ac6d4659-f652-3c3e-a34f-7352cf326b81",
                        "glosses": [
                            "het totaal van onroerende voorzieningen zoals (spoor)wegen, vliegvelden, havens, bekabeling, riolering enzovoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33be0580-a194-4a1b-b73c-9ac40d88dad5",
                                "sense_id": "70016481-f58a-3431-8524-393eb96fcf3e",
                                "text": "Projecten die nieuwe infrastructuur aanleggen zijn vaak erg groot en duren lang."
                            },
                            {
                                "example_id": "b28f7b52-9b40-4d8c-9222-5608ee087905",
                                "sense_id": "70016481-f58a-3431-8524-393eb96fcf3e",
                                "text": "Dat moet veranderen, vindt minister Madlener van Infrastructuur, want elk jaar belanden veel mensen na een fietsongeluk op de spoedeisende hulp. Vorig jaar waren dat 74.300 fietsers, van wie 48.900 met ernstig letsel, blijkt uit nieuwe cijfers van VeiligheidNL. En de groep met ernstig letsel wordt steeds groter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9300fbb7-7211-4e4c-8b65-62a84030a4ac",
                        "source_entry_id": "ac6d4659-f652-3c3e-a34f-7352cf326b81",
                        "source_sense_id": "70016481-f58a-3431-8524-393eb96fcf3e",
                        "source_sense_description": "het totaal van onroerende voorzieningen zoals (spoor)wegen, vliegvelden,...",
                        "target_lang_word": "Infrastruktur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Infrastruktur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f6a5f916-f364-3099-9344-89d41f286665",
                                        "entry_id": "7658bf3f-bec0-3fab-aaf7-15f41e103084",
                                        "glosses": [
                                            "zu Grunde liegendes Kernsystem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5280249d-9ed0-4774-8d4d-88a7ef263299",
                                                "sense_id": "f6a5f916-f364-3099-9344-89d41f286665",
                                                "text": "Der Anbieter der Infrastruktur stellt Programme, Hardware und Datenübertragungskapazität zur Verfügung, und das Unternehmen als Kunde ist für die Inhalte zuständig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "07a953da-2616-3a96-a622-7374235b67e9",
                                        "entry_id": "7658bf3f-bec0-3fab-aaf7-15f41e103084",
                                        "glosses": [
                                            "alle langlebigen Grundeinrichtungen und Anlagen, die für die Volkswirtschaft eines Landes notwendig sind und nur mittelbar der Produktion dienen"
                                        ],
                                        "tags": [
                                            "Wirtschaftsgeografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17e42c93-f27d-460f-86f8-eff9f9a7c27c",
                                                "sense_id": "07a953da-2616-3a96-a622-7374235b67e9",
                                                "text": "Zur Infrastruktur gehören unter anderem die Wasserleitungen, das Abwassersystem und die Telefonleitungen."
                                            },
                                            {
                                                "example_id": "bbd49022-8bd0-40d6-a858-7ee951b20acf",
                                                "sense_id": "07a953da-2616-3a96-a622-7374235b67e9",
                                                "text": "Die Brücke sowie angrenzende Infrastruktur wird durch Mittel des Bundes gefördert und im vollen Umfang durch regionale Firmen umgesetzt."
                                            },
                                            {
                                                "example_id": "12fd0bce-060f-453d-b398-4ffd262ffe08",
                                                "sense_id": "07a953da-2616-3a96-a622-7374235b67e9",
                                                "text": "Das Team um Anita Zaidi kam der Meldung zufolge zu dem Schluss, dass die Infektionen auf einen Mangel an Wissen und Ausbildung in Kombination mit einer unzureichenden Infrastruktur und zu geringen finanziellen Mitteln zurückgeführt werden können."
                                            },
                                            {
                                                "example_id": "0ecb7884-3fb8-410f-985d-1e33ec9efb30",
                                                "sense_id": "07a953da-2616-3a96-a622-7374235b67e9",
                                                "text": "„Die Ankömmlinge siedelten zunächst im Süden und Osten der Insel, nutzten dabei aber kaum die Infrastruktur und Techniken der Römer.“"
                                            },
                                            {
                                                "example_id": "8b924df3-a1a1-4906-8df1-69c686b772e8",
                                                "sense_id": "07a953da-2616-3a96-a622-7374235b67e9",
                                                "text": "„Er will Gesetze ändern, Steuern harmonisieren, die Infrastruktur verbessern.“"
                                            },
                                            {
                                                "example_id": "b06e3652-0abf-459f-b117-9bb2c22a7a9b",
                                                "sense_id": "07a953da-2616-3a96-a622-7374235b67e9",
                                                "text": "„In der Nordsee gibt es viele Infrastrukturen, von deren Funktionieren die Staaten an den Küsten abhängig sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee4f391d-79b5-43f4-b62e-58948527b384",
                        "source_entry_id": "ac6d4659-f652-3c3e-a34f-7352cf326b81",
                        "source_sense_id": "70016481-f58a-3431-8524-393eb96fcf3e",
                        "source_sense_description": "het totaal van onroerende voorzieningen zoals (spoor)wegen, vliegvelden,...",
                        "target_lang_word": "infrastructure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infrastructure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44df810b-2551-3213-bf46-74dce2b1bded",
                                        "entry_id": "01f8cb40-d026-3a4e-9565-71614df8e5a9",
                                        "glosses": [
                                            "An underlying base or foundation for a building, organization, or system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07daca87-2a20-4a61-a466-e4f4bc36846e",
                                                "sense_id": "44df810b-2551-3213-bf46-74dce2b1bded",
                                                "text": "Near-synonyms: understructure, underpinnings, underbuilding, underframework"
                                            },
                                            {
                                                "example_id": "02241d28-ee77-41dd-8cde-bb34d1849acd",
                                                "sense_id": "44df810b-2551-3213-bf46-74dce2b1bded",
                                                "text": "The parasitic tyranny's infrastructure depends on secrecy in order to be effective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a04f000-a5be-3314-a049-441e19d117b8",
                                        "entry_id": "01f8cb40-d026-3a4e-9565-71614df8e5a9",
                                        "glosses": [
                                            "The facilities, services and installations needed for the functioning of a community or society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "419ce562-696f-47d0-acc8-31c21f5c50db",
                                                "sense_id": "3a04f000-a5be-3314-a049-441e19d117b8",
                                                "text": "Meronyms: (literally, large objects and portions thereof) structures, substructures, understructures, superstructures"
                                            },
                                            {
                                                "example_id": "106ec920-ddd9-43c5-a00d-08d61f3e8620",
                                                "sense_id": "3a04f000-a5be-3314-a049-441e19d117b8",
                                                "text": "If we don't spend money to maintain our infrastructure, such as roads, bridges, water mains, sewers, and electrical grids, then it will begin to fail us."
                                            },
                                            {
                                                "example_id": "487180b2-e88b-4666-ac92-d70cd77689a4",
                                                "sense_id": "3a04f000-a5be-3314-a049-441e19d117b8",
                                                "text": "Infrastructure: It's our roads, bridges, dams, levees, airports, power grids... basically, anything that can be destroyed in an action movie... The problem is, though, when our infrastructure is not being destroyed by robots and/or saved by Bruce Willis we tend to find it a bit boring."
                                            },
                                            {
                                                "example_id": "b21ae626-fc5a-417b-87be-650aa2996d87",
                                                "sense_id": "3a04f000-a5be-3314-a049-441e19d117b8",
                                                "text": "About $7.4 billion will be allocated to states, tribes and territories for 2022 – the first-year allotment of nearly $44 billion in total SRF funding over the next five years from the infrastructure law, according to an EPA fact sheet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91851ad7-57b2-40b2-95fe-d572c1799fac",
                        "source_entry_id": "ac6d4659-f652-3c3e-a34f-7352cf326b81",
                        "source_sense_id": "70016481-f58a-3431-8524-393eb96fcf3e",
