                        "glosses": [
                            "Donner un caractère strasbourgeois ou rappelant Strasbourg à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29199ef8-82a4-4937-8cb7-438af2cf1c35",
                                "sense_id": "8fcd5637-acc4-3b52-b201-f7cdbab4e70a",
                                "text": "Pour compenser, on a strasbourgisé l'équipe : ça attaque et ça prend des buts à la con."
                            },
                            {
                                "example_id": "04495cee-0ad7-472b-b5d8-0dc389db59ad",
                                "sense_id": "8fcd5637-acc4-3b52-b201-f7cdbab4e70a",
                                "text": "Qui parmi les 3 va se sauver - Qui parmi les 17 va se strasbourgiser ?"
                            },
                            {
                                "example_id": "dd97bb1d-6b21-4dc0-bdb6-a80aa35721e5",
                                "sense_id": "8fcd5637-acc4-3b52-b201-f7cdbab4e70a",
                                "text": "Première fois que j'ai vraiment l'impression qu'on pourrait se Strasbourgiser si rien n'arrive assez vite."
                            }
                        ]
                    }
