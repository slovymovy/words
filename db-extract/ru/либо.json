                                "target_senses": [
                                    {
                                        "sense_id": "76b94bd2-fb90-3566-9bdb-d82a2f8cd38c",
                                        "entry_id": "2ebfe153-a9ee-3003-b2de-9145425002ad",
                                        "glosses": [
                                            "The gold or yellow tincture on a coat of arms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "973bbe70-2e04-436a-aadf-7d67ea5b4e0d",
                                                "sense_id": "76b94bd2-fb90-3566-9bdb-d82a2f8cd38c",
                                                "text": "The metals are gold and silver, these being termed \"or\" and \"argent\"."
                                            },
                                            {
                                                "example_id": "413462f2-9589-40e8-99fa-0e047a22d604",
                                                "sense_id": "76b94bd2-fb90-3566-9bdb-d82a2f8cd38c",
                                                "text": "In engraving, \"Or\" is expressed by dots."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "or",
                                "target_lang_code": "en",
                                "target_senses": [
