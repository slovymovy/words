                    }
                ],
                "senses": [
                    {
                        "sense_id": "44dee3c2-9af9-3587-b813-3c48b9d51483",
                        "entry_id": "86ac5fa1-3d8e-3979-9257-caf0f06b7081",
                        "glosses": [
                            "прийти, приехать, прилететь куда-либо, к кому-либо"
                        ],
                        "tags": [
                            "с определёнными затратами времени или сил"
                        ],
                        "examples": [
                            {
                                "example_id": "1113051e-bcab-4c47-8c6e-5898075d0041",
                                "sense_id": "44dee3c2-9af9-3587-b813-3c48b9d51483",
                                "text": "Наконец мне удалось добраться до самого директора треста."
                            },
                            {
                                "example_id": "359990e0-5400-4b8d-a6be-257dac5e0ade",
                                "sense_id": "44dee3c2-9af9-3587-b813-3c48b9d51483",
                                "text": "Насилу добрались до дома."
                            }
                        ]
                    },
                    {
                        "sense_id": "14a88fb6-7e45-36e5-a865-6189d7f3cd2a",
                        "entry_id": "86ac5fa1-3d8e-3979-9257-caf0f06b7081",
                        "glosses": [
                            "перен. достичь понимания чего-нибудь, найти разгадку, решение чего-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5de9f0-eb3e-454f-87d2-2205a97472f1",
                                "sense_id": "14a88fb6-7e45-36e5-a865-6189d7f3cd2a",
                                "text": "Мы сумели добраться до истины, до понимания сути проблемы."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b348bda-403b-3f5d-96a6-7c39eb659929",
                        "entry_id": "86ac5fa1-3d8e-3979-9257-caf0f06b7081",
                        "glosses": [
                            "перен. приступить к чему-нибудь после других дел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50706752-3da7-4a67-bc6e-aded1d1de19f",
                                "sense_id": "3b348bda-403b-3f5d-96a6-7c39eb659929",
                                "text": "Мы добрались уже до третьего тома и скоро приступим к четвёртому."
                            }
                        ]
                    },
                    {
                        "sense_id": "16648427-41c5-3d79-8f4e-80cd4b134e13",
                        "entry_id": "86ac5fa1-3d8e-3979-9257-caf0f06b7081",
                        "glosses": [
                            "фам. получить возможность расправиться с кем-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20db1a84-4c3b-4778-999a-815c3041b059",
                                "sense_id": "16648427-41c5-3d79-8f4e-80cd4b134e13",
                                "text": "Погоди, доберусь я до тебя!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c42bbee-8bf4-4874-b2d0-d34fa4198044",
                        "source_entry_id": "86ac5fa1-3d8e-3979-9257-caf0f06b7081",
                        "target_lang_word": "alcanzar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcanzar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "024c1b57-68cf-30a8-ac41-08d85cb30208",
                                        "entry_id": "a9a33b7e-b19d-361d-ad3d-f542fb8760c1",
                                        "glosses": [
                                            "Avanzar y llegar hasta algo o alguien que va adelante, física o figuradamente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5725c750-c4aa-4861-a9a4-b9036b30bc79",
                                                "sense_id": "024c1b57-68cf-30a8-ac41-08d85cb30208",
                                                "text": "Salí después que ellos, pero los alcancé porque corrí más rápido."
                                            },
                                            {
                                                "example_id": "b983aa44-2316-4335-a722-50c7fc63cf4e",
                                                "sense_id": "024c1b57-68cf-30a8-ac41-08d85cb30208",
                                                "text": "La hija ya alcanzó a su madre en estatura."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1bccd9c7-a15b-3af3-a0b4-e1e8f99acac2",
                                        "entry_id": "a9a33b7e-b19d-361d-ad3d-f542fb8760c1",
                                        "glosses": [
                                            "Llegar a tener algo que se deseaba o buscaba."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e5415e-4c71-44a5-9b85-9e72fb35252b",
                                                "sense_id": "1bccd9c7-a15b-3af3-a0b4-e1e8f99acac2",
                                                "text": "Juan alcanzó un lugar en el evento."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b474c12c-ba6c-3fe7-a951-55a84fc2975b",
                                        "entry_id": "a9a33b7e-b19d-361d-ad3d-f542fb8760c1",
                                        "glosses": [
                                            "Coger alguna cosa alargando la mano para tomarla."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c61a21e1-3fb0-4171-aae4-e496d49024c4",
                                                "sense_id": "b474c12c-ba6c-3fe7-a951-55a84fc2975b",
                                                "text": "Con una mano alcanzo (a tomar) el vaso de cristal."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "813192ab-d7da-3000-8ed8-e8a9dd93a48e",
                                        "entry_id": "a9a33b7e-b19d-361d-ad3d-f542fb8760c1",
                                        "glosses": [
                                            "Avanzar hasta tocar, juntarse o hacer impacto con algo o alguien."
                                        ],
                                        "tags": [
                                            "se emplea también como pronominal: alcanzarse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b1c8e9e-85e0-444b-92ce-68d5bd16c43c",
                                                "sense_id": "813192ab-d7da-3000-8ed8-e8a9dd93a48e",
                                                "text": "La bala perdida alcanzó a un peatón."
                                            },
                                            {
                                                "example_id": "83c669a9-2a73-4d21-9aa2-4cd8e33b6f79",
                                                "sense_id": "813192ab-d7da-3000-8ed8-e8a9dd93a48e",
                                                "text": "Ha resonado un grito, cual suele ser el de un hombre que sufre, no sé si por aquí o por allá. Me alcanza bien claro el acento de alguien que arrastra su paso penosamente."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3ba241fe-1c58-3962-8ead-38de17bdff22",
                                        "entry_id": "a9a33b7e-b19d-361d-ad3d-f542fb8760c1",
                                        "glosses": [
                                            "Lograr percibir algo con los sentidos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc824e0-614c-45eb-a777-2ec615f0a36b",
                                                "sense_id": "3ba241fe-1c58-3962-8ead-38de17bdff22",
                                                "text": "Y sobre aquel hambriento colchón, un alfamar del mismo jaez, del cual el color yo no pude alcanzar."
                                            },
                                            {
                                                "example_id": "dc490dd3-dc1b-4981-94ec-cbd2717efb2f",
                                                "sense_id": "3ba241fe-1c58-3962-8ead-38de17bdff22",
                                                "text": "Cuanto más que, si bien caigo en la cuenta, este vuestro libro no tiene necesidad de ninguna cosa de aquellas que vos decís que le falta, porque todo él es una invectiva contra los libros de caballerías, de quien nunca se acordó Aristóteles, ni dijo nada San Basilio, ni alcanzó Cicerón;(...)."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "56443209-e0e1-37c7-a6f8-dec4cd29d900",
                                        "entry_id": "a9a33b7e-b19d-361d-ad3d-f542fb8760c1",
                                        "glosses": [
                                            "Tener capacidad o poder para algo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ebc2fed-a688-4a3e-a71c-14282e39bfb4",
                                                "sense_id": "56443209-e0e1-37c7-a6f8-dec4cd29d900",
                                                "text": "El viento no fue tan fuerte, pero sí alcanzó a hacer daños."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "alcanzar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "69dd5aef-9a5e-34ea-8e52-0904356bab93",
                                        "entry_id": "caa83b1a-7174-35a1-8f4b-3979637b76e2",
                                        "glosses": [
                                            "Llegar a cierto punto, distancia o nivel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81644c8-58b6-4aa1-b290-6602885861b7",
                                                "sense_id": "69dd5aef-9a5e-34ea-8e52-0904356bab93",
                                                "text": "Desde aquí alcanzo a ver la montaña."
                                            },
                                            {
                                                "example_id": "50806f09-ea01-4d9a-ac9b-908137cb1254",
                                                "sense_id": "69dd5aef-9a5e-34ea-8e52-0904356bab93",
                                                "text": "Un excelente nivel alcanzaste y ahora juegas mejor que yo."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "52b7fbaf-58bf-3958-a008-85bf98ff24a3",
                                        "entry_id": "caa83b1a-7174-35a1-8f4b-3979637b76e2",
                                        "glosses": [
                                            "Ser o haber suficiente para un propósito."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "affede4e-b244-418e-a426-663f04606da8",
                                                "sense_id": "52b7fbaf-58bf-3958-a008-85bf98ff24a3",
                                                "text": "El dinero no le alcanza para tantos lujos que quiere darse."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    }
                                ]
                            }
                        ]
                    }
