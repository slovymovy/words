                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d929fb97-bfa8-4536-8a25-2a536dc3bf04",
                                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                                "text": "All der Flitter in diesem Haus machte ihn rasend. Er warf ihn hinaus und lebte von da an bescheiden und einfach."
                                            },
                                            {
                                                "example_id": "e571d841-e5c9-40ff-a8ae-115aa27aa978",
                                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                                "text": "„Von Guste, die er für seine Taufpatin hielt, erbte Janosch die Vorliebe für Gold und Flitter.“"
                                            },
                                            {
                                                "example_id": "6c7cbbe0-a68e-4e0a-b5b4-2604151192a5",
                                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                                "text": "„Ihren Flitter hatte sie abgelegt.“"
                                            },
                                            {
                                                "example_id": "6e48b5bb-0d5b-4a50-b61f-a2fc9b165c4c",
                                                "sense_id": "eeb28638-4b55-339e-b398-77844a03605e",
                                                "text": "„Äußerer Flitter ist ein ausgezeichnetes Gegengewicht gegen ein so schlechtes Geschenk der Natur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2701662-c0c4-401e-b3f5-a4e16ec38b6b",
                        "source_entry_id": "4c2742dc-8a8a-347f-a885-a0761e858d5a",
                        "source_sense_id": "d9ec5721-06cb-3125-a903-19da0e3e5900",
                        "source_sense_description": "unnötiger Gegenstand bzw. Ergänzung (insbesondere an einem Kleid)",
                        "target_lang_word": "Tand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b51348bb-a0a0-3ee3-add3-6da10716b998",
                                        "entry_id": "eae078cb-26da-3b83-9b7f-50ef6452a1df",
                                        "glosses": [
                                            "Ansammlung nutzloser Gegenstände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4063c5cb-a9a1-46ce-9a90-ff2135fac0ad",
                                                "sense_id": "b51348bb-a0a0-3ee3-add3-6da10716b998",
                                                "text": "„Tand, Tand, ist das Gebilde von Menschenhand!“"
                                            },
                                            {
                                                "example_id": "4f0d8a9d-2576-4a06-aa8e-63c74457aba4",
                                                "sense_id": "b51348bb-a0a0-3ee3-add3-6da10716b998",
                                                "text": "Sie gibt ihr ganzes Taschengeld für Tand aus, statt es zu sparen."
                                            },
                                            {
                                                "example_id": "e8e939ab-b927-4332-8da9-c7aa4a532d42",
                                                "sense_id": "b51348bb-a0a0-3ee3-add3-6da10716b998",
                                                "text": "„Sie hat eben nicht so ein enges Verhältnis zu weihnachtlichem Tand.“"
                                            },
                                            {
                                                "example_id": "2fbc0861-105d-46f1-9e95-599f8422b511",
                                                "sense_id": "b51348bb-a0a0-3ee3-add3-6da10716b998",
                                                "text": "„Rheingold! Rheingold! Reines Gold! O leuchtete noch in der Tiefe dein laut'rer Tand!“"
                                            },
                                            {
                                                "example_id": "41399014-72ea-4c49-9fc3-ef8a787e1cf8",
                                                "sense_id": "b51348bb-a0a0-3ee3-add3-6da10716b998",
                                                "text": "„Hierbei handelte es sich immer nur um Tand und billigen Putz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
