                                        "examples": [
                                            {
                                                "example_id": "ff615800-c7f3-45e8-a9b0-fa60d6bb6712",
                                                "sense_id": "b7242c84-ee48-3046-a35e-123e06c23cf4",
                                                "text": "I didn’t know much about medical supplies, so I took the list Docc handed me without much questioning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6deac0d6-87a2-39ca-b955-5cfc9cff4582",
                                        "entry_id": "e27fabe5-2597-3363-8ffd-eee78c34c1c0",
                                        "glosses": [
                                            "The act of challenging, wondering, and doubting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "340f90f8-d123-3a03-b4e8-2aa7bfaa0225",
                                        "entry_id": "e27fabe5-2597-3363-8ffd-eee78c34c1c0",
                                        "glosses": [
                                            "Interrogation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff4a2fc-e403-4d81-bec4-82513bf964c0",
                                                "sense_id": "340f90f8-d123-3a03-b4e8-2aa7bfaa0225",
                                                "text": "The official Central News agency said a Nationalist patrol boat Dec. 28 captured six Communist spies disguised as fishermen as they approached within 1,000 yards of the Paichuan in a motorized fishing craft. They were taken to Matsu for questioning."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "questioning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c3b438e-dfcb-3e9d-b3dd-6a0d95325fda",
                                        "entry_id": "aef1e862-20d7-3027-ae0b-997255c0850f",
                                        "glosses": [
                                            "Characterized by questions, inquisitiveness, doubt, or wonder; quizzical."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3aae882-d71d-453e-897a-29f056ff4012",
                                                "sense_id": "2c3b438e-dfcb-3e9d-b3dd-6a0d95325fda",
                                                "text": "Why do you have a questioning look? Are you puzzled about something?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5417a768-f9b2-3720-b1df-b42239300e17",
                                        "entry_id": "aef1e862-20d7-3027-ae0b-997255c0850f",
                                        "glosses": [
                                            "Unsure of one's sexual orientation or gender identity."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d8ca414-bd17-4fe3-bbf5-b9912f44f606",
                                                "sense_id": "5417a768-f9b2-3720-b1df-b42239300e17",
                                                "text": "We entertain the boy and it becomes more evident that his dad is trans and he is questioning; my coworker keeps frowning about it."
                                            },
                                            {
                                                "example_id": "736be7a7-0852-46e1-b3cb-d46f847696e4",
                                                "sense_id": "5417a768-f9b2-3720-b1df-b42239300e17",
                                                "text": "Girls broadly fared worse than boys, and there is “ongoing and extreme distress” among teens who identify as lesbian, gay, bisexual or questioning (LGBQ+)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "questioning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf753630-2833-3473-a861-677b7de399c2",
                                        "entry_id": "9fb8642e-6294-3840-bacf-c8f1ffb851fd",
                                        "glosses": [
