                                            {
                                                "example_id": "aaa010fc-2924-4d97-8c9c-fced89932462",
                                                "sense_id": "c9c33220-5403-30b7-8d8f-d7aed94c3b48",
                                                "text": "Každá víra má svoje esoterické jádro: u Židů je jím kabala, u křesťanů hermetismus, u mohamedánů súfismus, atp."
                                            },
                                            {
                                                "example_id": "7ecc2a65-d033-40db-8860-b2f6e5171378",
                                                "sense_id": "c9c33220-5403-30b7-8d8f-d7aed94c3b48",
                                                "text": "S indickými Upanišadami má kabala společné třebas učení o světech, které předcházely stvoření světa našeho, kdežto v jejím zdůrazňování světotvorných principií mužství a ženství upomíná na mystiku čínskou (Laotseovu)."
                                            }
