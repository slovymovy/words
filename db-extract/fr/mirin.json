                "senses": [
                    {
                        "sense_id": "47f6f32b-25cb-3d25-96d6-d9a0d2b7aa93",
                        "entry_id": "491d683c-1bc2-3154-84ca-c72c95d5aa1a",
                        "glosses": [
                            "Sorte de saké utilisé aujourd’hui presque uniquement comme assaisonnement en cuisine japonaise."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0ba6afe8-72df-4110-b538-5dae69f4e6ce",
                                "sense_id": "47f6f32b-25cb-3d25-96d6-d9a0d2b7aa93",
                                "text": "Le mirin et le vinaigre de riz, accompagnés de l’huile de sésame déjà évoquée précédemment, sont les trois éléments indispensables de toute cuisine familiale au Japon."
                            },
                            {
                                "example_id": "6b37fc83-1cd3-4283-be9e-d3d1eda8e642",
                                "sense_id": "47f6f32b-25cb-3d25-96d6-d9a0d2b7aa93",
                                "text": "Ajoutez la sauce soja, le mirin et les grains de la gousse de vanille préalablement fendue en deux et grattée."
                            },
                            {
                                "example_id": "d04c4bb8-8238-4d9a-8cb4-693083f1c97f",
                                "sense_id": "47f6f32b-25cb-3d25-96d6-d9a0d2b7aa93",
                                "text": "2 c. à soupe de sauce soja, 3 c. à soupe de mirin, 5 c. à soupe d’eau, 1 ou 2 c. à café de dashi naturel en poudre"
                            }
                        ]
                    }
                ],
