                "senses": [
                    {
                        "sense_id": "13341f85-574a-36b3-9aaf-e0c0998cd742",
                        "entry_id": "41004400-1029-336b-b0dd-b639258ea40a",
                        "glosses": [
                            "an Heidekrautgewächsen der Art Großfrüchtige Moosbeere gedeihende Frucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8391d599-840c-4937-803f-f45fdfb5862c",
                                "sense_id": "13341f85-574a-36b3-9aaf-e0c0998cd742",
                                "text": "„Der Saft ist herb und sehr sauer. Kranbeeren werden in der Küche niedrig dosiert eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7ec2829-d508-3156-94fa-e9944fe33468",
                        "entry_id": "41004400-1029-336b-b0dd-b639258ea40a",
                        "glosses": [
                            "niedriger, flächig wurzelnder Zwergstrauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c0750a-5508-4bea-a074-633ee306c5b2",
                                "sense_id": "e7ec2829-d508-3156-94fa-e9944fe33468",
                                "text": "Die Kranbeere stammt ursprünglich aus den Mooren Nordamerikas, wird aber seit dem 19. Jahrhundert auch in Europa kultiviert und als Kulturflüchtling in freier Natur gefunden."
                            },
                            {
                                "example_id": "5e03ec0e-2eb2-4300-9148-50d6aa7eaf64",
                                "sense_id": "e7ec2829-d508-3156-94fa-e9944fe33468",
                                "text": "„Der Acker, mit der Kranbeere bepflanzt, wird mit 1000 Dollars bezahlt und liefert circa 150 bis 200 Bushel Früchte, die á Bushel mit 2 Dollars 50 Cent. bezahlt werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61bf7e03-eb45-4b3b-830d-975129c77771",
