    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24861e4a-e44d-3cbf-acf5-5799df668c4f",
                    "sense_definition": "Extremely serious or urgent, requiring immediate action to avoid disaster.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "urgency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local hospital is in <w>dire</w> need of medical supplies after the earthquake.",
                            "target_lang_translations": {
                                "ru": "Местная больница испытывает <w>острую</w> нужду в медикаментах после землетрясения.",
                                "nl": "Het plaatselijke ziekenhuis heeft na de aardbeving <w>dringende</w> behoefte aan medische voorraden."
                            }
                        },
                        {
                            "text": "The old bridge was in <w>dire</w> need of repair before it became unsafe for cars.",
                            "target_lang_translations": {
                                "ru": "Старый мост <w>крайне</w> нуждался в ремонте, прежде чем он стал небезопасным для автомобилей.",
                                "nl": "De oude brug had <w>dringend</w> reparatie nodig voordat hij onveilig werd voor auto's."
                            }
                        }
                    ],
                    "synonyms": [
                        "urgent",
                        "pressing",
                        "acute",
                        "exigent"
                    ],
                    "antonyms": [
                        "trivial",
                        "minor"
                    ],
                    "common_phrases": [
                        "dire need",
                        "dire necessity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне серьезный или срочный, требующий немедленных действий для предотвращения катастрофы.",
                        "nl": "Uiterst ernstig of dringend, waarbij onmiddellijke actie vereist is om een ramp te voorkomen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "о нужде или необходимости"
                            },
                            {
                                "target_lang_word": "крайний",
                                "target_lang_sense_clarification": "о степени необходимости"
                            },
                            {
                                "target_lang_word": "неотложный",
                                "target_lang_sense_clarification": "требующий немедленного внимания"
                            },
                            {
                                "target_lang_word": "срочный",
                                "target_lang_sense_clarification": "не терпящий отлагательств"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dringend",
                                "target_lang_sense_clarification": "zeer urgent of noodzakelijk"
                            },
                            {
                                "target_lang_word": "acuut",
                                "target_lang_sense_clarification": "plotseling en hoogst ernstig"
                            },
                            {
                                "target_lang_word": "nijpend",
                                "target_lang_sense_clarification": "zeer krap of zorgwekkend, vooral bij nood of behoefte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9683684c-c260-3c93-8718-d96a277e1689",
                    "sense_definition": "Involving or likely to result in terrible or disastrous consequences.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequences",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If we do not act now, the environmental impact will have <w>dire</w> consequences for the planet.",
                            "target_lang_translations": {
                                "ru": "Если мы не начнем действовать сейчас, воздействие на окружающую среду будет иметь <w>ужасные</w> последствия для планеты.",
                                "nl": "Als we nu niet handelen, zal de impact op het milieu <w>rampzalige</w> gevolgen hebben voor de planeet."
                            }
                        },
                        {
                            "text": "The company found itself in <w>dire</w> straits after losing its biggest contract.",
                            "target_lang_translations": {
                                "ru": "Компания оказалась в <w>отчаянном</w> положении после потери своего крупнейшего контракта.",
                                "nl": "Het bedrijf kwam in <w>grote</w> problemen na het verlies van zijn grootste contract."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreadful",
                        "terrible",
                        "disastrous",
                        "grim"
                    ],
                    "antonyms": [
                        "favorable",
                        "promising"
                    ],
                    "common_phrases": [
                        "dire consequences",
                        "dire straits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влекущий за собой или способный привести к ужасным или катастрофическим последствиям.",
                        "nl": "Gepaard gaand met of waarschijnlijk leidend tot vreselijke of rampzalige gevolgen."
                    },
