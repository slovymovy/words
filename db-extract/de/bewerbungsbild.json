                ],
                "senses": [
                    {
                        "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                        "entry_id": "c4e2f7c8-d3fa-3358-b4fd-10c88fd678ce",
                        "glosses": [
                            "Fotografie eines Bewerbers/einer Bewerberin für eine Bewerbung bei einem Arbeitgeber auf einen Arbeits- oder (Schüler-)Praktikumsplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40908376-cd8c-4933-916c-df175a82aaaa",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "In einem Bewerbungsbild für einen Büroarbeitsplatz sollte man möglichst seriös wirken."
                            },
                            {
                                "example_id": "b5067519-9a7f-4682-9d96-8a7d02287178",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "„Knackige Kurzprofile, ein Fokus auf die Berufserfahrung und das Erwähnen von Hobbys, darauf legt Britta, Gründerin von dein-lebenslauf.com in Wert. Ein gutes Bewerbungsbild findet sie wichtig.“"
                            },
                            {
                                "example_id": "9057aa71-abe6-4878-8751-70c8c22ea645",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "„Da die visuelle Wahrnehmung so großen Einfluss auf unser Handeln hat, sollte das Bewerbungsbild keinesfalls unterschätzt werden!“"
                            },
                            {
                                "example_id": "a8a03254-7e2d-47d4-a188-4b16ad411a9d",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "„Deborah Dudda-Luzzato bewertet dies ganz anders: »Professionelle Fotoshootings für Bewerbungsbilder verschwenden Zeit und Geld. Wie der Bewerber oder die Bewerberin aussieht, interessiert uns nicht.«“"
                            },
                            {
                                "example_id": "1545f451-a8fb-4b7d-b32b-2695c90d7cfe",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "„»Wir haben uns immer bemüht, objektiv zu sein«, sagt Jockel Birkholz, Personalchef der Stadt. »Aber auch wir konnten uns nicht vom Bewerbungsbild oder der Aufmachung frei machen.«“"
                            },
                            {
                                "example_id": "ae36a1d8-26ae-4e6b-9177-d76bfd126cbf",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "„[…] es [kann] nicht schaden, den Lebenslauf auf Vordermann zu bringen und vielleicht noch ein aktuelles Bewerbungsbild machen zu lassen […].“"
                            },
                            {
                                "example_id": "652ad5ad-46e4-47d6-b3ca-f011270c3291",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "„[…] in Deutschland [wird] - anders als im angelsächsischen Raum - noch immer ein Bewerbungsbild erwartet.“"
                            },
                            {
                                "example_id": "01b6d40c-309b-46b0-84bd-f4a0859a22f0",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "„Entrümpeln Sie Ihr Skype-Profil: Stellen Sie Ihr aktuelles Bewerbungsbild als Profilfoto ein. Partyfotos machen sich nicht gut.“"
                            },
                            {
                                "example_id": "66123b00-4c5c-438f-9f6b-298d6c53191a",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "In Deutschland kann man die Kosten für das Erstellen von Bewerbungsbildern von der Steuer absetzen."
                            },
                            {
                                "example_id": "dffcc27e-b0fe-4eaf-b055-bc2b0c474bb0",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "„Leonie ist im 2. Lehrjahr und Azubi. Als angehende Portraitfotografin fotografiert sie Menschen: draußen, im Fotostudio, oft für Pass- und Bewerbungsbilder.“"
                            },
                            {
                                "example_id": "d26f3e10-2c28-4939-a6fd-fec247f2deeb",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "[Lockdown während der Coronapandemie:] „Ein Großteil der Aufgaben ist weggebrochen; es blieben nur die Dienstleistung Pass- und Bewerbungsbilder übrig.“"
                            },
                            {
                                "example_id": "8206520c-d787-4dc5-9a6f-0693214be601",
                                "sense_id": "9489f6a3-92e3-34a4-b080-8df504ccf6de",
                                "text": "[…] „kurz darauf [folgt] Francois Bouchers verführerisches Boudoirbild eines nackten ruhenden Mädchens, das zu einer Art Bewerbungsbild der künftigen Mätresse König Ludwigs XV. wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
