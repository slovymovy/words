                        "glosses": [
                            "Rendre dysharmonique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8947b907-d882-4cf6-8f1f-c0e7ba374619",
                                "sense_id": "afce8c7a-8ca8-3954-8564-91fdc24147a1",
                                "text": "Ces troubles psychiques vont dysharmoniser la trame PNEIB et le système neurovégétatif en particulier, entraînent l’apparition des premiers signes corporels."
                            },
                            {
                                "example_id": "6c0a2ba3-f933-473a-a960-3ded8e1c08db",
                                "sense_id": "afce8c7a-8ca8-3954-8564-91fdc24147a1",
                                "text": "Si la ville suppose l’organisation, la distribution, l’agencement de l’espace avec ses lieux institués, la périphérie, elle, l’anarchise, le désaccorde, le dysharmonise avec ses lieux destitués."
                            }
                        ]
                    }
