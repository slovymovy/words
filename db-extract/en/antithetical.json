                    },
                    {
                        "form_id": "72b1220b-ce9c-4551-b500-96fc291bf970",
                        "entry_id": "ed59cfc7-ab34-387e-a0ba-bd7c886b8d08",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most antithetical"
