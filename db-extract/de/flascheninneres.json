                ],
                "senses": [
                    {
                        "sense_id": "225ea1d8-8785-3dc2-bdab-5a27ab205563",
                        "entry_id": "c7ed2fb5-ba68-3d85-bf4a-0106799d4343",
                        "glosses": [
                            "innerer Teil/Inhalt einer Flasche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c4333d-1651-41f2-98b7-443e49cd8114",
                                "sense_id": "225ea1d8-8785-3dc2-bdab-5a27ab205563",
                                "text": "„Die Schleuderbewegungen einer Waschtrommel oder eines Trockners irritieren das labile Gefüge im Flascheninneren.“"
                            },
                            {
                                "example_id": "db05e52e-48d0-4c49-8cf6-3441b3bc7c03",
                                "sense_id": "225ea1d8-8785-3dc2-bdab-5a27ab205563",
                                "text": "„Denn das Wichtigste steckt natürlich auch beim Weingut Fuchs im Flascheninneren.“"
                            },
                            {
                                "example_id": "d871c48d-1c85-4dcb-b167-afbc8393c535",
                                "sense_id": "225ea1d8-8785-3dc2-bdab-5a27ab205563",
                                "text": "„Sie war fest aus Wachs um einen Holzpfropfen gegossen, der die Flüssigkeit im Flascheninneren hielt und ihr Auslaufen verhinderte.“"
                            },
                            {
                                "example_id": "9ce13ea4-bf9d-456e-9fed-434b21122bb6",
                                "sense_id": "225ea1d8-8785-3dc2-bdab-5a27ab205563",
                                "text": "„Die Flüssigkeit aus dem Flascheninneren hält den Korken so lange ausreichend feucht.“"
                            },
                            {
                                "example_id": "3fbd4c80-7075-44a2-8f8a-d1865afc5a2a",
                                "sense_id": "225ea1d8-8785-3dc2-bdab-5a27ab205563",
                                "text": "„Diese Art der Vorbereitung gewährleistet ferner eine absolute Keimfreiheit des Flascheninneren, weil die anwesende Flüssigkeit verdampft (Williams).“"
                            },
                            {
                                "example_id": "de34323b-9e34-4a27-9a52-abe63eb21d49",
                                "sense_id": "225ea1d8-8785-3dc2-bdab-5a27ab205563",
                                "text": "„Sauberes Trinkwasser wird verdunsten und sich am Flascheninneren niederschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
