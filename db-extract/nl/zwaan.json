                                ]
                            },
                            {
                                "target_word": "swan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6417a4-13e7-325a-ac82-951788b30dd5",
                                        "entry_id": "fd72d095-9e81-3107-b04f-af44c66e0bfe",
                                        "glosses": [
                                            "To travel or move about in an aimless, idle, or pretentiously casual way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa1f6707-a8d3-4918-89cd-6bc0285b338f",
                                                "sense_id": "6c6417a4-13e7-325a-ac82-951788b30dd5",
                                                "text": "He swans around that stinking office in his expensive clothes that are a little too tight for comfort, he swans around that stinking office without a care in the world."
                                            },
                                            {
                                                "example_id": "559bf6ed-d025-4b3b-a57a-5dab19f8221a",
                                                "sense_id": "6c6417a4-13e7-325a-ac82-951788b30dd5",
                                                "text": "One of the few strokes of good luck Emma had had in recent days was the news that Tatiana Flint-Hamilton, her only real rival for top billing as 'most photographable girl' at today's event had decided to swan off to Sardinia instead, leaving the limelight entirely to Emma."
                                            },
                                            {
                                                "example_id": "553356fa-c139-444b-bc3a-b0de975885e9",
                                                "sense_id": "6c6417a4-13e7-325a-ac82-951788b30dd5",
                                                "text": "On the other side: the rich, beautiful tapestry of WASP culture that constituted Levis's life—friends playing horseshoes at backyard cocktail parties, where girls swanned in chaise longues, clinking their gin and tonics."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10281406-9a5f-35d6-8646-65afaeca3786",
                                        "entry_id": "666a1955-ea3b-3b79-8449-76d4cd90da7b",
                                        "glosses": [
                                            "To declare (chiefly in first-person present constructions)."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d6cccf8-120d-4f15-a7fd-2e0d88489c0d",
                                                "sense_id": "10281406-9a5f-35d6-8646-65afaeca3786",
                                                "text": "\"Well, I swan, man, I had a better opinion of you than that.\""
                                            },
                                            {
                                                "example_id": "32ae4c83-25d3-46d5-abdc-365f1f13f0e8",
                                                "sense_id": "10281406-9a5f-35d6-8646-65afaeca3786",
                                                "text": "‘She slammed the door so hard I figured a window'd break […].’ ‘I swan,’ I said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0f17d17-c98c-4e06-adc2-3462bbc90834",
                        "source_entry_id": "63de5392-2f21-32a7-8fe4-e2dc1966764d",
                        "source_sense_id": "08239ccd-147c-388b-9339-edfcde339879",
                        "source_sense_description": "benaming voor watervogels met lange sierlijke hals uit het geslacht Cygnus",
                        "target_lang_word": "cygne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cygne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ce0c43-5fb7-369d-b1b3-01021ed32fc8",
                                        "entry_id": "99663157-ac2a-3567-be9c-289ecb3c055c",
                                        "glosses": [
                                            "Gros oiseau palmipède, aquatique, dont le plumage est d’ordinaire blanc et qui a un cou long et souple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58676ef3-baaa-4e24-9129-d9ba8b17a873",
                                                "sense_id": "d2ce0c43-5fb7-369d-b1b3-01021ed32fc8",
                                                "text": "Le cygne trompette, siffle, drense et drensite."
                                            },
                                            {
                                                "example_id": "535f2f36-d03e-40f5-abcc-47465663b5b3",
                                                "sense_id": "d2ce0c43-5fb7-369d-b1b3-01021ed32fc8",
                                                "text": "Vers le 20 mars, les chasseurs signalèrent les premiers cygnes, qui émigraient des territoires méridionaux et s’envolaient vers le nord en poussant d’aigres sifflements."
                                            },
                                            {
                                                "example_id": "b1b24106-844d-4df6-b3fe-09f6ce6b970b",
                                                "sense_id": "d2ce0c43-5fb7-369d-b1b3-01021ed32fc8",
                                                "text": "D’après des renseignements fournis par M. Zschokké, ces Cygnes ont le corps pie-noir, à l’exception du cou qui est resté tout noir."
                                            },
                                            {
                                                "example_id": "4b5f6ff6-4aa7-418b-8c03-243df621a3e4",
                                                "sense_id": "d2ce0c43-5fb7-369d-b1b3-01021ed32fc8",
                                                "text": "Ne voulaient-ils pas, dans leur délire, pêcher les poissons rouges, camper dans la cabane du cygne, manger ses œufs à la coque et faire rôtir le cygne noir, celui qui avait un bec orange avec une grosse bosse dessus ? On confisqua leurs engins de pêche juste à temps pour prévenir la dévastation."
                                            },
                                            {
                                                "example_id": "3bd24e5e-a86d-4ec2-8bc7-3fbfeb6c2d5c",
                                                "sense_id": "d2ce0c43-5fb7-369d-b1b3-01021ed32fc8",
                                                "text": "Voyant flotter un cygne sur l'étang, je fais un signe amical à ce cygne mais il s'en soucie comme d'une guigne. On pourrait y voir un signe des temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5785f123-4016-31c7-91f8-3122ce864de3",
                                        "entry_id": "99663157-ac2a-3567-be9c-289ecb3c055c",
                                        "glosses": [
                                            "Grand poète, homme éloquent, grand musicien."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3321091b-4388-4579-a2b0-01209c536b45",
                                                "sense_id": "5785f123-4016-31c7-91f8-3122ce864de3",
                                                "text": "Le cygne de Mantoue : Virgile."
                                            },
                                            {
                                                "example_id": "89bc6278-f1ea-461a-8e77-05c198ff5513",
                                                "sense_id": "5785f123-4016-31c7-91f8-3122ce864de3",
                                                "text": "Le cygne de Cambrai : Fénelon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e54c0d07-fded-3ab7-8473-48367d1827c5",
                                        "entry_id": "99663157-ac2a-3567-be9c-289ecb3c055c",
                                        "glosses": [
                                            "Glace flottante isolée."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48a01c08-aa37-48f5-bed0-8a02c04e47e7",
                                                "sense_id": "e54c0d07-fded-3ab7-8473-48367d1827c5",
                                                "text": "Les grands floes épais mis en liberté sont usés par la friction, rongés par les mouvements de la mer et par le dégel, ils constituent fréquemment des masses aux formes bizarres et élégantes d’une glace bleue-verdâtre très dure. Ils deviennent finalement des glaçons, les « cygnes » ou « bourguignons » des pêcheurs d’Islande qui les rencontrent à de grandes distances en mer libre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b6ee4d-39c2-3c78-950b-8b89c6dcbfc5",
                                        "entry_id": "99663157-ac2a-3567-be9c-289ecb3c055c",
                                        "glosses": [
                                            "Meuble représentant l’animal du même nom dans les armoiries. Représenté de profil avec ses pattes visibles contrairement à l’alcyon, couché dans son nid les pattes cachées. À rapprocher de canard, cane, canette, jars et oie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d46de5-4774-4d84-9565-7cdcfc9d15e7",
                                                "sense_id": "d3b6ee4d-39c2-3c78-950b-8b89c6dcbfc5",
                                                "text": "De sinople au cygne d’argent colleté d’une couronne d’or, qui est de Magnac-sur-Touvre → voir illustration « armoiries avec un cygne »"
                                            }
                                        ]
                                    },
