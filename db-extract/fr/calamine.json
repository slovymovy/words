                                "target_senses": [
                                    {
                                        "sense_id": "32fe6414-fa46-3fb9-a051-1f5b2bc20537",
                                        "entry_id": "a5406d33-aa60-3f88-b865-cb1bb190ca28",
                                        "glosses": [
                                            "Synonym of smithsonite, a pink form of zinc oxide (mainly zinc carbonate ZnCO₃) formed as a byproduct of zinc sublimation, now used in skin lotions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e924ea4d-9456-48fb-b7b8-2c0bc2ce8afc",
                                                "sense_id": "32fe6414-fa46-3fb9-a051-1f5b2bc20537",
                                                "text": "Poison Ivy, Lord,'ll make you itch\nYou're gonna need an ocean\nOf calamine lotion\nYou'll be scratchin' like a hound\nThe minute you start to mess around"
                                            },
                                            {
                                                "example_id": "ce713f73-f885-4d53-8fa2-7bfea69fb801",
                                                "sense_id": "32fe6414-fa46-3fb9-a051-1f5b2bc20537",
                                                "text": "For Secret Santa two years before, she had gifted him a bottle of calamine lotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fea808d8-b2a6-3119-ab11-628f5c629d13",
                                        "entry_id": "a5406d33-aa60-3f88-b865-cb1bb190ca28",
                                        "glosses": [
                                            "Synonym of hemimorphite, an orthorhombic-pyramidal mineral containing zinc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
