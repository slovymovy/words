                            }
                        ]
                    }
                },
                {
                    "sense_id": "092c178b-0bdd-3989-bdd7-5832e97551f9",
                    "sense_definition": "Indiquer une heure moins avancée en parlant d'un instrument de mesure du temps ; marcher trop lentement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "horlogerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille horloge <w>retarde</w> d'au moins cinq minutes chaque jour.",
                            "target_lang_translations": {
                                "en": "This old clock <w>loses</w> at least five minutes every day.",
                                "ru": "Эти старые часы <w>отстают</w> как минимум на пять минут каждый день.",
                                "de": "Diese alte Uhr <w>geht</w> jeden Tag mindestens fünf Minuten <w>nach</w>.",
                                "es": "Este viejo reloj <w>atrasa</w> al menos cinco minutos cada día.",
                                "zh": "这座老钟每天至少<w>慢</w>五分钟。"
                            }
                        },
                        {
                            "text": "Ma montre <w>retarde</w>, je vais devoir changer la pile très rapidement.",
                            "target_lang_translations": {
                                "en": "My watch is <w>running slow</w>, so I'll have to change the battery very quickly.",
                                "ru": "Мои часы <w>отстают</w>, так что мне придётся очень быстро поменять батарейку.",
                                "de": "Meine Uhr <w>geht</w> <w>nach</w>, ich werde die Batterie sehr bald wechseln müssen.",
                                "es": "Mi reloj <w>atrasa</w>, así que tendré que cambiar la pila cuanto antes.",
                                "zh": "我的表<w>走慢</w>了，我得尽快换电池。"
                            }
                        }
                    ],
                    "antonyms": [
                        "avancer"
                    ],
                    "common_phrases": [
                        "retarder de dix minutes",
                        "retarder d'une heure"
                    ],
                    "target_lang_definitions": {
                        "en": "To show a time earlier than the actual time, said of a clock or watch.",
                        "ru": "О часах или другом приборе времени: показывать время меньше фактического.",
                        "de": "Von einer Uhr gesagt: eine Zeit anzeigen, die hinter der tatsächlichen Zeit liegt.",
                        "es": "Dicho de un reloj: marcar una hora anterior a la real.",
                        "zh": "指钟表等计时器显示的时间比实际时间慢。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lose",
                                "target_lang_sense_clarification": "clock or watch running slow"
                            },
                            {
                                "target_lang_word": "run slow",
                                "target_lang_sense_clarification": "said of clocks and watches"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отставать",
                                "target_lang_sense_clarification": "о часах, показывающих меньше"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nachgehen",
                                "target_lang_sense_clarification": "von Uhren und Armbanduhren"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "atrasar",
                                "target_lang_sense_clarification": "relojes de pared o pulsera"
                            },
                            {
                                "target_lang_word": "retrasar",
                                "target_lang_sense_clarification": "relojes, uso más formal"
                            }
                        ],
                        "zh": [
