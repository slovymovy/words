                        "examples": [
                            {
                                "example_id": "a365452e-babc-406f-9c48-e4a9d9e5668a",
                                "sense_id": "9a2c246c-c971-30d9-b22e-950c6f92adfc",
                                "text": "Ce sont pour les trois-quarts des « vins de l’espèce vidogne », secs, ressemblant à ceux de Madère, avec moins de corps et de parfum mais forts et supportant les plus longs voyages."
                            },
