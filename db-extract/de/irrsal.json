                                        "sense_id": "5f1329ae-92c1-3e44-8ce2-33ed8db5471c",
                                        "entry_id": "ed032d6a-2c17-3a3c-8e8f-701e8eab6630",
                                        "glosses": [
                                            "État d'esprit qui tient pour vrai ce qui est faux et réciproquement."
