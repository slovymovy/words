                ],
                "senses": [
                    {
                        "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                        "entry_id": "232c5dfc-beb5-37ff-9850-6b7c9c4435e3",
                        "glosses": [
                            "Eigenschaft, gerne und viel zu reden, zu sprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f34d94c-cce0-4c02-8934-95521faeccf7",
                                "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                "text": "„Denn inzwischen war der Kaffee aufgetragen, und das Klappern der Tassen und die bald geweckte allgemeine Gesprächigkeit ließen vorläufig nur eine Unterhaltung im engsten Kreise zu.“"
                            },
                            {
                                "example_id": "67d43eb4-7fba-4553-b61d-f08d7c409cb0",
                                "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                "text": "„Was ist in dem geselligen Gastmahl reizender als die Unterhaltung, die belebte Gesprächigkeit, und was belebt diese mehr als der Wein?“"
                            },
                            {
                                "example_id": "aee5576d-f808-46de-a75c-b4124c6a48a8",
                                "sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                                "text": "„In deutlicher Geringschätzung wichen die herben Kelten der dringlichen Gesprächigkeit ihrer Nachbarn aus, mit unverhohlener Mißbilligung mieden sie ihre müßige Geselligkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74d8e6b7-a71a-46f4-8e9f-1ba60d3b4505",
                        "source_entry_id": "232c5dfc-beb5-37ff-9850-6b7c9c4435e3",
                        "source_sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                        "source_sense_description": "Eigenschaft, gerne und viel zu reden, zu sprechen",
                        "target_lang_word": "bavardage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bavardage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a212d2fe-d660-3119-b1e8-fc85617d07cc",
                                        "entry_id": "f934cdfd-c0ef-3cb6-bbff-f595068029e7",
                                        "glosses": [
                                            "Action de bavarder."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5277b5e-2b5b-4a83-b765-f05490af3ff9",
                                                "sense_id": "a212d2fe-d660-3119-b1e8-fc85617d07cc",
                                                "text": "Nous éloignons le plus possible de la guerre notre bavardage ; nous parlons de l’Amérique, des îles de la Sonde, où il voudrait aller ; puis nous tenons à en écarter nos corps mêmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24cf57d4-989b-3676-964e-80a3818dc8e9",
                                        "entry_id": "f934cdfd-c0ef-3cb6-bbff-f595068029e7",
                                        "glosses": [
                                            "Discours insignifiant et prolixe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce297656-1348-462f-b491-828de304564d",
                                                "sense_id": "24cf57d4-989b-3676-964e-80a3818dc8e9",
                                                "text": "Et voilà qu’Eugène passait les soirées entières dans le salon jaune, écoutant religieusement ces grotesques que lui, Aristide, avait si impitoyablement raillés. Quand il sut, par les bavardages de la ville, que son frère donnait des poignées de main à Granoux et en recevait du marquis, il se demanda avec anxiété ce qu’il devait croire."
                                            },
                                            {
                                                "example_id": "199fb8e8-7bec-429b-a2ce-b2df99a8a08e",
                                                "sense_id": "24cf57d4-989b-3676-964e-80a3818dc8e9",
                                                "text": "Le bavardage continue incessant et ne prendra fin que lorsque sonnera l’heure du repas : il faudra alors à regret rentrer chez soi, mais on recommencera le lendemain et toujours on trouvera matière à commérages !"
                                            },
                                            {
                                                "example_id": "e1d8901c-bbef-4590-aa77-a765df4e14b4",
                                                "sense_id": "24cf57d4-989b-3676-964e-80a3818dc8e9",
                                                "text": "Dans tous les articles, les auteurs s’attachent scrupuleusement aux faits, aux données brutes et concrètes : pas de bavardage, pas d’interprétations oiseuses, mais des informations précises étayées par des citations sourcées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "432b6dc8-cd35-3456-9410-f74ccff9930c",
                                        "entry_id": "f934cdfd-c0ef-3cb6-bbff-f595068029e7",
                                        "glosses": [
                                            "Sons émis par les pies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c89f79e-0fab-4b76-8e88-c492ff15544e",
                                                "sense_id": "432b6dc8-cd35-3456-9410-f74ccff9930c",
                                                "text": "La visite des assommoirs et des pièges à renard, dont il n’oublie jamais de mettre le valet les jours de chasse ; des travaux d’exploitation, d’élagage ou de réparation de routes, sont pour le garde une occasion excellente pour faire toute une série d’observations dont il sait tirer parti : ce sont d’abord les voies qu’il remarque sur la rosée des chemins gazonnés ; plus loin, il s’étonne de l’inquiétude qu’il observe chez les animaux qui rentrent du gagnage, le bavardage des pies, le coassement du corbeau, le pit-pit du rouge-gorge, la rupture de deux brins d’herbe noués la veille à travers un sentier, sont pour lui autant de circonstances et de renseignements précieux qui le conduisent souvent à une tente de collets, à la découverte d’un fusil caché sous les feuilles et à l’endroit où dix minutes avant il y avait un affûteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07005e21-8376-4ff8-8482-c0b9bd3549bd",
                        "source_entry_id": "232c5dfc-beb5-37ff-9850-6b7c9c4435e3",
                        "source_sense_id": "2c2fabba-b4ce-3242-883c-9d3454ecb6cd",
                        "source_sense_description": "Eigenschaft, gerne und viel zu reden, zu sprechen",
                        "target_lang_word": "loquacité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loquacité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                        "entry_id": "dc5dfe6f-cb88-373a-8619-24c174b28152",
                                        "glosses": [
                                            "Habitude de parler beaucoup ; tendance au bavardage ; état de celui ou de celle qui est loquace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2429dfc5-4827-4a3b-aa56-3485634feb5d",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "Cette rencontre était de nature à vivement frapper madame de Staël ; à son retour au château, elle en parla peu, malgré le besoin d’expansion qui, chez elle, dégénérait en loquacité ; mais elle en parut fortement préoccupée."
                                            },
                                            {
                                                "example_id": "afe61f3f-4a09-4f2e-b5be-fae86ba39fdd",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "Quoique très instruite, elle n’avoit ni les caprices, ni l’humeur qu’on attribue aux gens de lettres, qui tantôt se livrent à une loquacité importune, tantôt se renferment dans un silence méprisant."
                                            },
                                            {
                                                "example_id": "ebf92101-99de-460f-b98c-5d90a7b4eaf5",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "Comme si l’ivresse eût délié sa langue, l’ivresse qui met dans la bouche des hommes un balbutiement pareil à la voix des bêtes, lui, dès qu’il était saoul, devenait d’une loquacité terrible."
                                            },
                                            {
                                                "example_id": "274f5946-14dc-44a9-bb66-5e91d7559bbe",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "Pendant un moment, la morgue germanique lutta en lui avec la simplicité anglaise, et aussi avec sa bienveillance naturelle et sa loquacité, et elle eut le dessous."
                                            },
                                            {
                                                "example_id": "7599b54f-a532-4994-9c89-86844addd296",
                                                "sense_id": "6d8ef0c2-d2d7-3050-8d05-ebe343e21d43",
                                                "text": "L’un était […] probablement silencieux par ordre ; l’autre, gêné de trouver Mikkelsen et Münck parlant sa langue, était d’une loquacité un peu déconcertante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a430d1e-8822-33b1-8fae-98753529f7ad",
                                        "entry_id": "dc5dfe6f-cb88-373a-8619-24c174b28152",
                                        "glosses": [
                                            "Logorrhée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c3472f6-8168-4bb0-bb75-6975b1a73ede",
                                                "sense_id": "0a430d1e-8822-33b1-8fae-98753529f7ad",
                                                "text": "Ces sortes de réveils étaient marquées par un cri aigu et par la projection des membres, tantôt d’un côté, tantôt d’un autre, et les premiers jours par une loquacité semi-délirante qui n’inquiétait pas moins que la stupeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
