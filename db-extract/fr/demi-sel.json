                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "11194254-a780-4bbb-96c1-182046fbbec3",
                        "entry_id": "941093d5-b252-3c90-a8c1-860f773a4fc3",
                        "tags": [
                            "plural"
                        ],
                        "form": "demis-sel"
