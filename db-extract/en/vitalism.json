                "word": "vitalism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "889ce671-fcc4-4eb0-a4a2-83262354cf12",
                        "entry_id": "5d319089-60db-35ca-9c25-aec1ff932450",
