                "senses": [
                    {
                        "sense_id": "bb64273b-4289-3daa-ac31-14ad77247fc3",
                        "entry_id": "a0a6700c-ca15-3f15-9de7-26bf281afde2",
                        "glosses": [
                            "Cautériser par la chaleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73a31012-3242-4cf9-b8b2-cc600395543e",
                                "sense_id": "bb64273b-4289-3daa-ac31-14ad77247fc3",
                                "text": "Chez l’autre, je m’étais borné à thermocautériser le foyer pour l’asepsier; une agrafe infectée fut éliminée."
                            },
                            {
                                "example_id": "8df7ae6f-6121-4dd2-b670-573fdd903f6c",
                                "sense_id": "bb64273b-4289-3daa-ac31-14ad77247fc3",
                                "text": "Un peu plus tard, et à peu près simultanément, Pestalozza, en Italie, et Doléris ont imaginé de faire l’abrasion de la muqueuse endo-cervicale au bistouri, puis de thermocautériser la surface cruentée."
                            }
                        ]
                    }
