                    {
                        "sense_id": "42f91768-98ea-37f0-8eef-7638be9e235e",
                        "entry_id": "c4e5a16d-e7bc-33ba-b491-dd5248a6f232",
                        "glosses": [
                            "runder Säulenbau",
                            "antiker Tempel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeedca8e-8d6a-4724-b462-d8dff74a24dd",
                                "sense_id": "42f91768-98ea-37f0-8eef-7638be9e235e",
                                "text": "„Eine umfassendere Auseinandersetzung mit dem Monopteros der Roma und des Augustus auf der Athener Akropolis als einem Exponenten dieser neuen Bildersprache mag auf den ersten Blick verwundern,scheinen doch die grundsätzlichen, an den Bau zu richtenden Fragen von der Forschung beantwortet zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "3f426770-4012-338f-834c-bb6449e4f4a7",
                        "entry_id": "c4e5a16d-e7bc-33ba-b491-dd5248a6f232",
                        "glosses": [
                            "runder Säulenbau",
                            "neuzeitliches Ziergebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fefb5993-81ca-4b41-824b-286f8fccc67b",
                                "sense_id": "3f426770-4012-338f-834c-bb6449e4f4a7",
                                "text": "„Der Weisheitstempel, ein achtsäuliger klassizistischer Monopteros, steht auf dem höchsten Punkt der Parkanlage.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    }
