{
    "word_family": [
        "banterer",
        "banteringly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1be884fe-d4f3-3061-83d9-1e58eb75804a",
                    "sense_definition": "Sharp, good-humoured, playful, typically spontaneous conversation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "playful_conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two friends engaged in friendly <w>banter</w> while waiting for the bus.",
                            "target_lang_translations": {
                                "ru": "Двое друзей вели дружескую <w>перепалку</w>, ожидая автобуса."
                            }
                        },
                        {
                            "text": "I always enjoy the lighthearted <w>banter</w> between the show's co-hosts.",
                            "target_lang_translations": {
                                "ru": "Мне всегда нравится непринужденная <w>пикировка</w> между ведущими шоу."
                            }
                        }
                    ],
                    "synonyms": [
                        "pleasantry",
                        "raillery"
                    ],
                    "common_phrases": [
                        "friendly banter",
                        "lighthearted banter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остроумный, добродушный, игривый и обычно спонтанный разговор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутливая беседа",
                                "target_lang_sense_clarification": "дружеский обмен шутками"
                            },
                            {
                                "target_lang_word": "стеб",
                                "target_lang_sense_clarification": "разговорный, дружеский подкол"
                            },
                            {
                                "target_lang_word": "пикировка",
                                "target_lang_sense_clarification": "обмен колкостями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7c21b5e-8672-3758-8869-56e8479fd5a4",
                    "sense_definition": "Good-humoured bits of monologue and conversational prompts used by professionals to interact with the public.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "playful_conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cashier's cheerful <w>banter</w> made the long wait in line much more pleasant.",
                            "target_lang_translations": {
                                "ru": "Веселая <w>болтовня</w> кассира сделала долгое ожидание в очереди гораздо более приятным."
                            }
                        },
                        {
                            "text": "A bit of polite <w>banter</w> can help salespersons build quick rapport with customers.",
                            "target_lang_translations": {
                                "ru": "Немного вежливой <w>беседы</w> может помочь продавцам быстро установить контакт с покупателями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "polite banter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доброжелательные реплики, монологи и шутки, используемые профессионалами для общения с публикой или клиентами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любезная беседа",
                                "target_lang_sense_clarification": "вежливый разговор с клиентом"
                            },
                            {
                                "target_lang_word": "непринужденный разговор",
                                "target_lang_sense_clarification": "легкое общение для установления контакта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94f4a6e1-1cea-349d-bdd8-bdbd9ddac0be",
                    "sense_definition": "To engage in banter or playful conversation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "playful_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They love to <w>banter</w> with each other during lunch breaks.",
                            "target_lang_translations": {
                                "ru": "Они обожают <w>подшучивать</w> друг над другом во время обеденных перерывов."
                            }
                        },
                        {
                            "text": "The comedians began to <w>banter</w> back and forth on stage.",
                            "target_lang_translations": {
                                "ru": "Комики начали <w>перешучиваться</w> друг с другом на сцене."
                            }
                        }
                    ],
                    "common_phrases": [
                        "banter back and forth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести шутливый, игривый разговор, обмениваться колкостями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подшучивать",
                                "target_lang_sense_clarification": "вести шутливый диалог"
                            },
                            {
                                "target_lang_word": "перешучиваться",
                                "target_lang_sense_clarification": "обмениваться шутками"
                            },
                            {
                                "target_lang_word": "пикироваться",
                                "target_lang_sense_clarification": "обмениваться колкостями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "046ca871-a074-385d-9315-0a94bbe00812",
                    "sense_definition": "To tease someone mildly and in a good-humoured way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "playful_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His colleagues would often <w>banter</w> him about his terrible taste in music.",
                            "target_lang_translations": {
                                "ru": "Коллеги часто <w>подтрунивали</w> над ним из-за его ужасного вкуса в музыке."
                            }
                        },
                        {
                            "text": "She was gently <w>bantered</w> by her family on her messy room.",
                            "target_lang_translations": {
                                "ru": "Семья мягко <w>поддразнивала</w> ее за беспорядок в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "kid",
                        "chaff"
                    ],
                    "common_phrases": [
                        "gently banter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слегка и добродушно дразнить или подшучивать над кем-то."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтрунивать",
                                "target_lang_sense_clarification": "слегка шутить над кем-либо"
                            },
                            {
                                "target_lang_word": "добродушно подшучивать",
                                "target_lang_sense_clarification": "по-доброму дразнить"
                            },
                            {
                                "target_lang_word": "поддразнивать",
                                "target_lang_sense_clarification": "слегка дразнить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c00d3597-8278-3c15-a6c8-9c18b4b6f72e",
                    "sense_definition": "To joke about or ridicule a trait, habit, or action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "playful_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If they <w>banter</w> your love of study, you should ignore their remarks.",
                            "target_lang_translations": {
                                "ru": "Если они <w>высмеивают</w> твою любовь к учебе, тебе следует игнорировать их замечания."
                            }
                        },
                        {
                            "text": "He would often <w>banter</w> her strict morning routine, though he secretly admired it.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>подшучивал</w> над ее строгим утренним распорядком, хотя втайне восхищался им."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутить над какой-либо чертой характера, привычкой или действием или высмеивать их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высмеивать",
                                "target_lang_sense_clarification": "добродушно или иронично шутить над привычкой"
                            },
                            {
                                "target_lang_word": "подшучивать",
                                "target_lang_sense_clarification": "насмехаться над особенностью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1affc99c-1337-358c-a02a-aeaf3a67fc2a",
                    "sense_definition": "To delude, trick, or play a prank upon someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They amused themselves by <w>bantering</w> the new students with false promises of easy exams.",
                            "target_lang_translations": {
                                "ru": "Они развлекались тем, что <w>разыгрывали</w> новых студентов ложными обещаниями легких экзаменов."
                            }
                        },
                        {
                            "text": "It was clear they intended to <w>banter</w> him into believing the story.",
                            "target_lang_translations": {
                                "ru": "Было ясно, что они намеревались <w>одурачить</w> его, заставив поверить в эту историю."
                            }
                        }
                    ],
                    "synonyms": [
                        "wind up"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of tricking or playing a prank"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить в заблуждение, обманывать или разыгрывать кого-то (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разыгрывать",
                                "target_lang_sense_clarification": "устраивать розыгрыш"
                            },
                            {
                                "target_lang_word": "одурачивать",
                                "target_lang_sense_clarification": "вводить в заблуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e874bada-b5b0-3d95-b132-b0617795d8fa",
                    "sense_definition": "To play or do something amusing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "playful_interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the afternoon <w>bantering</w> in the garden with various lawn games.",
                            "target_lang_translations": {
                                "ru": "Они провели день, <w>резвясь</w> в саду и играя в различные игры на лужайке."
                            }
                        },
                        {
                            "text": "The children would <w>banter</w> away the hours with simple toys.",
                            "target_lang_translations": {
                                "ru": "Дети часами <w>забавлялись</w> простыми игрушками."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "used in the sense of doing something amusing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься чем-то забавным, весело проводить время (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резвиться",
                                "target_lang_sense_clarification": "весело проводить время"
                            },
                            {
                                "target_lang_word": "забавляться",
                                "target_lang_sense_clarification": "играть во что-то приятное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0321c664-c6c4-3737-81ba-e0bb817e5da9",
                    "sense_definition": "To challenge to a match.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "challenge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The champion was <w>bantered</w> to a game of chess by the young prodigy.",
                            "target_lang_translations": {
                                "ru": "Юный вундеркинд <w>вызвал</w> чемпиона на партию в шахматы."
                            }
                        },
                        {
                            "text": "He decided to <w>banter</w> his rival to a final decisive contest.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>вызвать</w> своего соперника на финальный решающий поединок."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "used in the sense of challenging to a match"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать на состязание или поединок (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "призывать к состязанию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c913258-8e6b-348c-b09e-d945a6f75dae",
                    "sense_definition": "To haggle or cheapen the price of goods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "negotiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She attempted to <w>banter</w> with the merchant over the cost of the silk.",
                            "target_lang_translations": {
                                "ru": "Она попыталась <w>поторговаться</w> с торговцем о стоимости шелка."
                            }
                        },
                        {
                            "text": "They spent an hour <w>bantering</w> the price down to a reasonable sum.",
                            "target_lang_translations": {
                                "ru": "Они провели час, <w>сбивая</w> цену до разумной суммы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "used in the sense of haggling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Торговаться или сбивать цену на товары (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торговаться",
                                "target_lang_sense_clarification": "сбивать цену"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}