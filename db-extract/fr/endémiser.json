                        "sense_id": "d55d22d3-71f3-3173-9ec6-5f7a416f1b3d",
                        "entry_id": "a83c43bc-aff9-3603-82ec-433f29e5cbe2",
                        "glosses": [
                            "Faire devenir endémique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "23fc6c2d-ef51-33b4-b347-eb01f63ad2cd",
                        "entry_id": "a83c43bc-aff9-3603-82ec-433f29e5cbe2",
                        "glosses": [
                            "Devenir endémique."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "e7640084-ee1c-4cc5-8a1b-ec627f79e3b4",
                                "sense_id": "23fc6c2d-ef51-33b4-b347-eb01f63ad2cd",
                                "text": "Dans l'Estuaire, peu touché au début du siècle, la maladie s'est rapidement développée pour s'endémiser dans les régions où elle sévit encore aujourd'hui."
                            },
                            {
                                "example_id": "032bfd91-ff1d-4b16-a301-deda9086ad30",
                                "sense_id": "23fc6c2d-ef51-33b4-b347-eb01f63ad2cd",
                                "text": "Les arboviroses ont de beaux jours devant elles, certaines vont s'endémiser."
                            },
                            {
                                "example_id": "dc040c80-92da-4c59-8c4a-c99834c98b9b",
                                "sense_id": "23fc6c2d-ef51-33b4-b347-eb01f63ad2cd",
                                "text": "En Italie, un virus qui s'endémise."
                            }
                        ]
                    }
