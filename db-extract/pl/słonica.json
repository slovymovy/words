                ],
                "senses": [
                    {
                        "sense_id": "746ba201-8486-36d7-94bb-a526343b1c8f",
                        "entry_id": "375d08ca-53d8-3a32-b47b-81f8fca27f29",
                        "glosses": [
                            "samica słonia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d6bf743-e5e2-4769-a55f-025f096cca36",
                                "sense_id": "746ba201-8486-36d7-94bb-a526343b1c8f",
                                "text": "Starsze słonice pomagają młodym matkom opiekować się słoniątkami."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ffed69f-878a-477c-a672-8702d23d91d7",
                        "source_entry_id": "375d08ca-53d8-3a32-b47b-81f8fca27f29",
                        "source_sense_id": "746ba201-8486-36d7-94bb-a526343b1c8f",
                        "target_lang_word": "female",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "female",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86a8dcaa-5ed6-3e26-914a-042aff743207",
                                        "entry_id": "d1da1db5-d174-395e-8574-13b8f1321f28",
                                        "glosses": [
                                            "Belonging to the sex which typically produces eggs (ova), or to the gender which is typically associated with it."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85e6bf8b-f30d-4f37-9b9d-3236fea5d63e",
                                                "sense_id": "86a8dcaa-5ed6-3e26-914a-042aff743207",
                                                "text": "female authors, the leading male and female artists, a female bird cooing at a male"
                                            },
                                            {
                                                "example_id": "2a02a6db-8136-4ff1-b513-0961438d5dfa",
                                                "sense_id": "86a8dcaa-5ed6-3e26-914a-042aff743207",
                                                "text": "Twice in her thirty-year career she held office in the blacksmiths' guild. Ms. [Fya] upper Bach was no fluke, either: legal and guild records from medieval Germany list other female blacksmiths, coppersmiths, tinsmiths, and pewterers. Some of these redoubtable women gained entry into the guild through \"widow's rights\"; others, however, made it on sheer mettle and muscle."
                                            },
                                            {
                                                "example_id": "04a70462-dbda-456f-98ed-c9c17914532e",
                                                "sense_id": "86a8dcaa-5ed6-3e26-914a-042aff743207",
                                                "text": "I turned to [gender-fluid] Alex. \"Hey, are you female today? [...] The Skofnung Sword [...] can't be drawn in the presence of women.\""
                                            },
                                            {
                                                "example_id": "92d18f07-a858-42fc-b56c-ac3db3e9d9ca",
                                                "sense_id": "86a8dcaa-5ed6-3e26-914a-042aff743207",
                                                "text": "Some mentioned factional tensions and bullying within the party involving other female MSPs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ec673c-fdab-37a5-8bf3-c67a0757fefe",
                                        "entry_id": "d1da1db5-d174-395e-8574-13b8f1321f28",
                                        "glosses": [
                                            "Characteristic of this sex/gender. (Compare feminine, womanly.)"
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e00223db-56ad-44e4-8056-b19fee244023",
                                                "sense_id": "61ec673c-fdab-37a5-8bf3-c67a0757fefe",
                                                "text": "stereotypically female pastimes, an insect with typically female coloration"
                                            },
                                            {
                                                "example_id": "51988350-f797-4a59-ab9d-31ab9970b315",
                                                "sense_id": "61ec673c-fdab-37a5-8bf3-c67a0757fefe",
                                                "text": "A travelling shot of a harbour view near Sydney's White Bay moves into a domestic interior as a female voice says, 'There was nowhere else to live except alone.'"
                                            },
                                            {
                                                "example_id": "2edee7c0-bffb-486e-847c-ef7d488a4e15",
                                                "sense_id": "61ec673c-fdab-37a5-8bf3-c67a0757fefe",
                                                "text": "More than that, we cannot find the same dynamics within female career trajectories as in the other two country groups, because the time-structure of female and male careers already shows great similarity within the older generation of elites. In addition, the pattern of the relation between female and male careers remains the same over time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d2c439d-37f0-3417-a3ce-84916ca69b6b",
                                        "entry_id": "d1da1db5-d174-395e-8574-13b8f1321f28",
                                        "glosses": [
                                            "Tending to lead to or regulate the development of sexual characteristics typical of this sex."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5d8aeae-1e31-4dee-a14b-11289aa0107c",
                                                "sense_id": "9d2c439d-37f0-3417-a3ce-84916ca69b6b",
                                                "text": "the female chromosome; estrogen, the primary female sex hormone, is produced by both females and males"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cdd3b9c-452f-358c-9f71-ad82afff7fe6",
                                        "entry_id": "d1da1db5-d174-395e-8574-13b8f1321f28",
                                        "glosses": [
                                            "Feminine; of the feminine grammatical gender."
                                        ],
                                        "tags": [
                                            "feminine",
                                            "form-of",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4a47a90-efce-471a-8e76-c94a33d2516e",
                                                "sense_id": "9cdd3b9c-452f-358c-9f71-ad82afff7fe6",
                                                "text": "The teacher's voice inflects the pulse of nêhiyawêwin as he teaches us. He says a prayer in the first class. Nouns, we learn, have a gender. In French, nouns are male or female, but in Cree, nouns are living or non-living, animate or inanimate."
                                            },
                                            {
                                                "example_id": "0dc59ceb-a7a5-4e74-a173-beca917d496c",
                                                "sense_id": "9cdd3b9c-452f-358c-9f71-ad82afff7fe6",
                                                "text": "If you are describing a female noun, you must make the adjective feminine by adding an 'e'. If you describe a male noun, you add an 'er'. For neutral nouns you add an 'es'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a47c8e7-7952-3ef1-b48f-e19b2b50b210",
                                        "entry_id": "d1da1db5-d174-395e-8574-13b8f1321f28",
                                        "glosses": [
                                            "Lacking the F factor, and able to receive DNA from another bacterium which does have this factor (a male)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa8a256d-9b3d-47e7-b60a-f714a997682c",
                                                "sense_id": "3a47c8e7-7952-3ef1-b48f-e19b2b50b210",
                                                "text": "In this process, one bacterium designated the male bacterium transfers its DNA into the female bacterium. Bacteria are determined to be male or female by a small piece of DNA, called F-plasmid, or sex factor. Bacteria with this small piece of DNA are labeled as males, and bacteria that do not have this factor are considered females."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7cc2fd4-225b-3411-89ab-f2fb36b27e21",
                                        "entry_id": "d1da1db5-d174-395e-8574-13b8f1321f28",
                                        "glosses": [
                                            "Having an internal socket, as in a connector or pipe fitting."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1ef784d-019b-4d8a-9316-43ea336910fb",
                                                "sense_id": "c7cc2fd4-225b-3411-89ab-f2fb36b27e21",
                                                "text": "A ground-joint union is made in three separate pieces and is used for joining two pipes. It consists of two machined pieces with female pipe threads, which are screwed on the pipes to be united, and a threaded collar which holds the two pieces of the union together."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "female",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0a5005a-5a1e-3642-99cd-74fd3538e4c3",
                                        "entry_id": "54a78c82-4a3e-33ba-a449-d82866f87097",
                                        "glosses": [
                                            "One of the female (feminine) sex or gender.",
                                            "A human of the feminine sex."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20866853-3bec-428d-af1d-b7b9a673aa3b",
                                                "sense_id": "d0a5005a-5a1e-3642-99cd-74fd3538e4c3",
                                                "text": "It would be years sometimes ere he saw the face of a female, and when he did, that face would not be overangelic."
                                            },
                                            {
                                                "example_id": "c090c8f8-d575-4859-9425-c3b6f4dac4bd",
                                                "sense_id": "d0a5005a-5a1e-3642-99cd-74fd3538e4c3",
                                                "text": "XY female patients with gonadal dysgenesis are sometimes referred to as “XY sex-reversed” patients or individuals with “XY sex reversal” (Simpson and Martin, 1981). Although widely used, this terminology is somewhat vague as it does not distinguish XY females with gonadal dysgenesis from XY females with androgen resistance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19eedd1e-836a-33c4-861f-b87bee8ccff5",
                                        "entry_id": "54a78c82-4a3e-33ba-a449-d82866f87097",
                                        "glosses": [
                                            "One of the female (feminine) sex or gender.",
                                            "An animal of the sex that produces eggs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e9c9261-9da6-479c-8ff7-a3175a2a24eb",
                                                "sense_id": "19eedd1e-836a-33c4-861f-b87bee8ccff5",
                                                "text": "Accumulated data indicate that in all species of sharks, the females grow larger than the males."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d4db13-2006-3363-a97a-09f6dfd74bed",
                                        "entry_id": "54a78c82-4a3e-33ba-a449-d82866f87097",
                                        "glosses": [
                                            "One of the female (feminine) sex or gender.",
                                            "A plant which produces only that kind of reproductive organ capable of developing into fruit after impregnation or fertilization; a pistillate plant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b55da893-cb41-3484-99b3-1ab45c2ad91d",
                                        "entry_id": "54a78c82-4a3e-33ba-a449-d82866f87097",
                                        "glosses": [
                                            "A bacterium which lacks the F factor, and is able to receive DNA from another bacterium which has that factor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1deef04b-7a4b-4566-bed3-66fce9a467d3",
                                                "sense_id": "b55da893-cb41-3484-99b3-1ab45c2ad91d",
                                                "text": "During mating, F+ male bacteria transfer the F factor to the recipient females, transforming them into F+ males."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "294c6a92-e13d-3bac-9904-134b2340f4f7",
                                        "entry_id": "54a78c82-4a3e-33ba-a449-d82866f87097",
                                        "glosses": [
                                            "A female connector, pipe fitting, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "647d3f25-b31c-4dad-a147-315d2ebcff7e",
                                                "sense_id": "294c6a92-e13d-3bac-9904-134b2340f4f7",
                                                "text": "These are the most common type, as they join females of the same diameter together. […] For example, you may need an adapter such as a 3-in. pipe thread (a common thread used to join pipes) female to 2 1⁄2 NH male."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
