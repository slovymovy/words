                        "entry_id": "588c4f3d-0add-3f79-b2f5-cb790c009dfe",
                        "glosses": [
                            "Substance ou médicament qui permet de traiter les œdèmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbf761fb-9f96-4632-be54-57811d7dd430",
                                "sense_id": "5904870e-113e-30c1-88c5-68d28bf3337b",
                                "text": "Le marronnier d’Inde est considéré comme l’arbre de la circulation sanguine, il est fluidifiant sanguin, vasoconstricteur et un anti-œdème."
                            },
                            {
                                "example_id": "1860a5ec-8029-4636-be63-800a9abd7c1f",
                                "sense_id": "5904870e-113e-30c1-88c5-68d28bf3337b",
                                "text": "La baisse de la pression artérielle doit être contrôlée, ni trop vite ni trop fort, en utilisant du nitroprussiate de sodium ou du labétolol à la seringue électrique, associé à des anti-œdèmes (mannitol, corticoïdes) et des antiépileptiques."
                            }
                        ]
                    }
