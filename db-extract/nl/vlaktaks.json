                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ed34ac6-3765-34a6-a96d-98bfe69bde44",
                                        "entry_id": "a42f79a7-e74c-3243-9f50-7735453a3dcc",
                                        "glosses": [
                                            "A tax, usually income tax, whose percentage rate or currency value remains constant, regardless of the amount to which the tax is applied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41337dc5-2050-4149-a471-f22194f889da",
                                                "sense_id": "3ed34ac6-3765-34a6-a96d-98bfe69bde44",
                                                "text": "Eyman's measure also would repeal the state tax on boats, 1 percent of the vessel's value, and replace it with a flat tax of $10.50 a year."
                                            },
                                            {
                                                "example_id": "71fef7a6-5b03-4714-9fcf-57dfa713bbac",
                                                "sense_id": "3ed34ac6-3765-34a6-a96d-98bfe69bde44",
                                                "text": "Several candidates for the 1996 Republican Presidential nomination and some of the top Republican leaders in Congress are advocating replacing the graduated income tax with a flat tax."
                                            },
                                            {
                                                "example_id": "3b8574cd-8a09-431c-8338-821c7a4de133",
                                                "sense_id": "3ed34ac6-3765-34a6-a96d-98bfe69bde44",
                                                "text": "A flat tax means scrapping all income tax bands and the various exemptions and loopholes and replacing them with a single low rate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
