                "senses": [
                    {
                        "sense_id": "74036cef-8886-3587-ab02-dcefd3af677b",
                        "entry_id": "e854f673-4d8c-3a47-b624-b7b33fe5f668",
                        "glosses": [
                            "Gerücht, das eine möglicherweise bevorstehende Firmenfusion zum Thema hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "916007ee-20f8-4e9b-bc74-0f3299e1fe06",
                                "sense_id": "74036cef-8886-3587-ab02-dcefd3af677b",
                                "text": "„Wenn heutzutage ein Dementi zu Fusionsgerüchten aus dem Hause Eon kommt, dann darf getrost davon ausgegangen werden, dass sich hier quasi gebrannte Kinder vor dem öffentlichen Verbrühen doppelt und dreifach abgesichert haben.“"
                            },
                            {
                                "example_id": "ee1962f7-57a2-4359-9e33-4220983acca7",
                                "sense_id": "74036cef-8886-3587-ab02-dcefd3af677b",
                                "text": "„Auch habe es Fusionsgerüchte gegeben um Qi und PMA, schreibt der Marktforscher.“"
                            },
                            {
                                "example_id": "ab5601fd-f211-4a01-84df-36cb66b39e35",
                                "sense_id": "74036cef-8886-3587-ab02-dcefd3af677b",
                                "text": "„Schon am Mittwoch hatten Fusionsgerüchte der Postbank-Aktie ein Kursplus von acht Prozent beschert.“"
                            },
                            {
                                "example_id": "07d2fca3-0ba5-43a1-8f3c-77062d29f19c",
                                "sense_id": "74036cef-8886-3587-ab02-dcefd3af677b",
                                "text": "„Mit dem Schwung der Fusionsgerüchte kann nun ein neuer Angriff auf das Jahreshoch eingeleitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
