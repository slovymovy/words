                    {
                        "sense_id": "bb105792-5fc1-37b1-a0a6-a8c385031a54",
                        "entry_id": "c5ad868c-3305-35ee-9583-6c39131cf5d8",
                        "glosses": [
                            "Couronne portée par la déesse égyptienne Isis aux époques ptolémaïque et romaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc72cb78-4c3c-4af4-94ff-5c35bac8db6a",
                                "sense_id": "bb105792-5fc1-37b1-a0a6-a8c385031a54",
                                "text": "Elle porte un basileion stylisé, consistant en un disque solaire, au centre d'une plante tréflée."
                            },
                            {
                                "example_id": "158cd34f-c22a-4018-b8cd-b0a84e23a5e7",
                                "sense_id": "bb105792-5fc1-37b1-a0a6-a8c385031a54",
                                "text": "L'une des couronnes d'Isis est appelée par Plutarque basileion ; il s'agit sans doute de la coiffure hathorique emplumée, la plus fréquente dans les représentations gréco-égyptiennes de la déesse, au point de devenir l'emblème isiaque par excellence."
                            },
                            {
                                "example_id": "699bfae7-6367-4844-a298-da38d2d37e4a",
                                "sense_id": "bb105792-5fc1-37b1-a0a6-a8c385031a54",
                                "text": "Dans sa version hellénisée, c'est le basileion (une couronne hathorique surmontée de deux hautes plumes) qui aura sa prédilection."
                            }
                        ]
                    }
                ],
