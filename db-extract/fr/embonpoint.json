        "fr-extract.jsonl": [
            {
                "entry_id": "289a8632-a9f9-3fcb-b813-158b940e9911",
                "word": "embonpoint",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7af149c0-1e3b-4074-b702-1998b26825f8",
                        "entry_id": "289a8632-a9f9-3fcb-b813-158b940e9911",
                        "tags": [
                            "plural"
                        ],
                        "form": "embonpoints"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                        "entry_id": "289a8632-a9f9-3fcb-b813-158b940e9911",
                        "glosses": [
                            "État d’une personne un peu grasse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e03c3c21-4e1b-4dc9-90b2-30bafc1cf073",
                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                "text": "C'était une grande femme qui avec moins d’embonpoint eût eu la taille belle, et une beauté romaine que bien des gens préféraient à celle de sa sœur."
                            },
                            {
                                "example_id": "0f050f93-beeb-4a16-b406-c7e3688a84b6",
                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                "text": "Quoique La Brière fût alors mince, il appartient à ce genre de tempéraments qui, formés tard, prennent à trente ans un embonpoint inattendu."
                            },
                            {
                                "example_id": "dff59e70-66cc-4f18-be14-af3ce4670e9c",
                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                "text": "C’était à cette époque une femme de cinquante-deux à cinquante-trois ans à peu près, qui conservait, grâce à son embonpoint plein de fraîcheur, les traits de sa première beauté."
                            },
                            {
                                "example_id": "ea6cfd3a-11bc-45f8-9d5c-25e897b18096",
                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                "text": "Bakounine était d’une colossale stature, encore que son embonpoint fût évidemment dû à sa maladie."
                            },
                            {
                                "example_id": "1d2be1e6-0bb4-4462-b7b5-a94f30d6dca9",
                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                "text": "Madame Toussaint était une grosse femme que l’embonpoint envahissait, malgré tout, malgré le tracas et le jeûne."
                            },
                            {
                                "example_id": "3a0534ea-c4bc-44d4-bf18-80cd91c28401",
                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                "text": "Elhamy, de son côté, changeait. Il prenait de l'embonpoint; ses traits s'empâtaient quelque peu."
                            },
                            {
                                "example_id": "8a873578-f311-4754-9de2-67729e024680",
                                "sense_id": "4a841610-7df0-3b7b-8e2d-34fb0578d3c4",
                                "text": "— La Verse ou le versage des blés, et de beaucoup de plantes céréales, est un accident occasionné, ou par de grands vents, des orages, de fortes pluies, ou par le trop d’embonpoint que prennent les plantes dans les temps chauds et humides."
                            }
                        ]
                    },
                    {
                        "sense_id": "306cc33a-4f35-3048-a937-9eb9b48036c7",
                        "entry_id": "289a8632-a9f9-3fcb-b813-158b940e9911",
                        "glosses": [
                            "État d’une chose un peu grasse."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "07b23c64-0898-4e80-9220-04c1b910e43e",
                                "sense_id": "306cc33a-4f35-3048-a937-9eb9b48036c7",
                                "text": "Sauf que depuis plusieurs années, les voitures ont pris de l'embonpoint, et pas seulement les SUV, mais tous les modèles: en moyenne, elles ont gagné 20 cm et sont 20% plus larges."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "771af23b-6cb7-46b7-97e2-7f8cb1014e3f",
                        "source_entry_id": "289a8632-a9f9-3fcb-b813-158b940e9911",
                        "target_lang_word": "Korpulenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Korpulenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1adb3ca6-aafd-32f4-8b57-63c451661210",
                                        "entry_id": "8076eb7a-84bd-33f7-aa1b-697ad53b4ff5",
                                        "glosses": [
                                            "Eigenschaft, dick/korpulent zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504e6ffa-f080-49b1-88c3-77c463cee75b",
                                                "sense_id": "1adb3ca6-aafd-32f4-8b57-63c451661210",
                                                "text": "„Er trank sehr viel, obgleich die Aerzte ihm sagten, dass ihm der Wein bei seiner Korpulenz schaden könne.“"
                                            },
                                            {
                                                "example_id": "afeffc4a-d9d2-4722-8f41-0acad67f5b0c",
                                                "sense_id": "1adb3ca6-aafd-32f4-8b57-63c451661210",
                                                "text": "„Doch da Korpulenz und Humor oft im innigsten Bunde stehen, gehen die Dicken meist gelassen an den Wartezimmern der Ärzte vorbei.“"
                                            },
                                            {
                                                "example_id": "71266dac-de61-4ab9-9f77-9e36dbc4e615",
                                                "sense_id": "1adb3ca6-aafd-32f4-8b57-63c451661210",
                                                "text": "„Er drehte sich um und fixierte wütend mit unerträglich gespannten Nerven einen älteren Herrn von einiger Korpulenz, den er nicht im geringsten kannte, und er war bereit loszuschlagen, wenn der andere sich rührte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f20ea5d4-7b0b-4673-adfd-2dd8fbc78eb6",
                        "source_entry_id": "289a8632-a9f9-3fcb-b813-158b940e9911",
                        "target_lang_word": "Übergewicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Übergewicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47eded72-178a-3410-830c-14d1e2374ee1",
                                        "entry_id": "97054ee3-8d54-3887-a847-7cf4c94d0a4a",
                                        "glosses": [
                                            "Körpergewicht, das einem Body-Mass-Index (BMI) zwischen 25 und 30 entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423fbda5-37b0-4ffe-a46e-7ad56bde2b6a",
                                                "sense_id": "47eded72-178a-3410-830c-14d1e2374ee1",
                                                "text": "Übergewicht kann Stoffwechselstörungen verursachen."
                                            },
                                            {
                                                "example_id": "e94d9e9c-cd1b-475b-95be-8b47555b0ea8",
                                                "sense_id": "47eded72-178a-3410-830c-14d1e2374ee1",
                                                "text": "„Ich hatte fünfzehn Kilo Übergewicht und brauchte Bewegung.“"
                                            },
                                            {
                                                "example_id": "9b811522-8649-43f9-9aa6-68ad1080f364",
                                                "sense_id": "47eded72-178a-3410-830c-14d1e2374ee1",
                                                "text": "„Übergewicht und Fettleibigkeit wurden zu unübersehbaren Begleiterscheinungen moderner Wohlstandsgesellschaften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8d23e23d-636c-34e6-90c4-1a0814a2c942",
                                        "entry_id": "97054ee3-8d54-3887-a847-7cf4c94d0a4a",
                                        "glosses": [
                                            "verlorenes oder gefährdetes Gleichgewicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3a5637-cefb-4970-ae19-1126e725d726",
                                                "sense_id": "8d23e23d-636c-34e6-90c4-1a0814a2c942",
                                                "text": "„Diese Politik war erfolgreich, bis im späten 19. Jahrhundert Deutschland auf dem Kontinent ein Übergewicht bekam und sich nicht mehr in die Gleichgewichtspolitik des Inselstaates einbinden ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4249890a-bfdb-3d5e-a523-7f4284b8b133",
                                        "entry_id": "97054ee3-8d54-3887-a847-7cf4c94d0a4a",
                                        "glosses": [
                                            "größere Bedeutung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d943732a-b7d5-43c9-89bb-a1f446c0b0a6",
                                                "sense_id": "4249890a-bfdb-3d5e-a523-7f4284b8b133",
                                                "text": "„Während es 1970 noch ein Patt mit 91 Deutsch- und 90 Romanischsprachigen gab, hat die deutsche Sprache heute ein klares Übergewicht erlangt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89cfe7f6-9503-4948-82d7-f97dcabf407d",
