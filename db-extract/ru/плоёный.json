                        "glosses": [
                            "подвергнутый плойке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8de0591f-e058-499e-a8d1-95fd4d28ba56",
                                "sense_id": "a8b23e74-7345-340f-9637-ff3c96ff32ad",
                                "text": "Плоёные волосы."
                            },
                            {
                                "example_id": "cc11ba63-5d98-406e-a374-0a44be60cdbf",
                                "sense_id": "a8b23e74-7345-340f-9637-ff3c96ff32ad",
                                "text": "Плоёная ткань."
                            },
                            {
                                "example_id": "36025687-c913-4a2f-a92a-7289e532bfa3",
                                "sense_id": "a8b23e74-7345-340f-9637-ff3c96ff32ad",
                                "text": "Перед маленьким зеркалом, при двух оплывших свечках натянул алые бриджи, надел плоёный воротник, тафтяной жилет, туфли с помпонами вдвое больше георгинов – все за десять минут ровно по часам."
                            }
                        ]
                    }
