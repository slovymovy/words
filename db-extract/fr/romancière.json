        "fr-extract.jsonl": [
            {
                "entry_id": "0f3f0032-b30b-3215-bf57-eb898b6d538c",
                "word": "romancière",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "47adaf88-3d47-4e55-aae3-f970109d8a74",
                        "entry_id": "0f3f0032-b30b-3215-bf57-eb898b6d538c",
                        "tags": [
                            "plural"
                        ],
                        "form": "romancières"
                    },
                    {
                        "form_id": "b5e7bad8-e18d-4ec0-8f21-88cc4574a396",
                        "entry_id": "0f3f0032-b30b-3215-bf57-eb898b6d538c",
                        "tags": [
                            "masculine"
                        ],
                        "form": "romancier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                        "entry_id": "0f3f0032-b30b-3215-bf57-eb898b6d538c",
                        "glosses": [
                            "Autrice qui écrit des romans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "258140bc-592d-4838-bc28-975302e6e772",
                                "sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                                "text": "Mademoiselle de Scudéri était la grande romancière du temps, et jouissait d’une réputation fabuleuse"
                            },
                            {
                                "example_id": "c5d280b2-f811-496e-bcc4-e081e9e52da3",
                                "sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                                "text": "C’est ainsi que la romancière interprète désormais la conception du roman qu’elle doit à Lukàcs, classique pour sa peinture de la vie privée, classique aussi pour son enchevêtrement avec la représentation du monde politique et social contemporain."
                            },
                            {
                                "example_id": "f90f9adc-6658-4316-b7df-82b64f5a62db",
                                "sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                                "text": "Elle m’avait fait découvrir des romancières anglaises contemporaines que j’appréciais presque autant que Daphné Du Maurier : Penelope Lively, Rose Tremain, Joanna Trollope, A. S. Byatt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9015698-6daf-46bd-9c70-3016e43e6ce4",
                        "source_entry_id": "0f3f0032-b30b-3215-bf57-eb898b6d538c",
                        "source_sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                        "target_lang_word": "Romancière",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romancière",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b543b914-97c3-3640-a4db-678a324a756e",
                                        "entry_id": "fae969c6-8b99-3364-a215-dfcd23c8259a",
                                        "glosses": [
                                            "Autorin/Schriftstellerin, die Romane verfasst"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19f4e7eb-4099-4756-8941-cb6f52de0656",
                                                "sense_id": "b543b914-97c3-3640-a4db-678a324a756e",
                                                "text": "„Einer Assia Djebar etwa erlaubt man es, sich aufzuspalten, in zwei verschiedene Autorinnen, die Romancière und die Akademikerin, die Schriftstellerin Assia Djebar und die Zivilperson Fatima-Zohra Imalayene, die 1999 in Montpellier unter bürgerlichem Namen über ihr eigenes Werk promoviert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5500998e-7f0a-447e-99c8-f383d1aa4220",
                        "source_entry_id": "0f3f0032-b30b-3215-bf57-eb898b6d538c",
                        "source_sense_id": "d46aeb9d-b32a-30a1-a44c-39079c43074a",
                        "target_lang_word": "Romancierin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romancierin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                        "entry_id": "eac72a6a-f8cd-33c7-bc2d-be66f025682c",
                                        "glosses": [
                                            "Autorin/Schriftstellerin, die Romane verfasst"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3157b3b2-5d5c-428a-a69f-fdbdaec208de",
                                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                                "text": "„Folglich leitet sie politische Aussagen der Romancierin Asena ab.“"
                                            },
                                            {
                                                "example_id": "e9e1c711-fa18-4c50-ada9-476b42768e20",
                                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                                "text": "„Soeben erhalte ich von Ricarda Huch (berühmte Romancierin in Zürich) einen wundervollen Brief über mein Buch, welches sie über alle Bücher der modernen Literatur stellt.“"
                                            },
                                            {
                                                "example_id": "23960aec-323d-469e-9fd3-06a72bd3a0ac",
                                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                                "text": "„Es ist nicht mehr als ein bloßer Zufall, daß sowohl ein Kosmologe aus dem Populärbereich als auch eine Romancierin wieder den meteoritischen Begriff ins Spiel brachten.“"
                                            },
                                            {
                                                "example_id": "a1c4dd71-7569-4ae4-a84e-30fb25ffe073",
                                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                                "text": "„Man hörte und fühlte in ihm noch immer den Hirtensänger und den Freiheitskämpfer, der sein Bein auf dem Felde gelassen hatte (man verzeihe der seinerzeit bekannten Romancierin und Übersetzerin diese Falschmeldung – M. J.) und dann mit dem Stelzfuß zur Höhe des Gelehrtenruhms emporgeklommen war.“"
                                            },
                                            {
                                                "example_id": "74656cb1-957b-4310-b53f-c7421e086732",
                                                "sense_id": "0622ccfc-d186-3b09-b59d-f3beb90a0d66",
                                                "text": "„Die Romancierin Maria Louise Rame schrieb im Jahr 1900: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
