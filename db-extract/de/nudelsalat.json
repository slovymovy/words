                            {
                                "example_id": "78ece80e-fac7-42c9-81b8-6a0ae468fc55",
                                "sense_id": "7659fbfa-c71d-3ca2-a5be-f2c9f890a3b4",
                                "text": "Nudelsalat mit Lauchzwiebeln verträgt er schlecht."
                            },
                            {
                                "example_id": "30e3c7a7-56e8-4cb4-bc1e-e586eadfffb0",
                                "sense_id": "7659fbfa-c71d-3ca2-a5be-f2c9f890a3b4",
                                "text": "Auf keiner Studentenparty fehlt eine große Schüssel Nudelsalat."
                            },
                            {
                                "example_id": "dc3c1823-3636-4347-be1b-2f646e3f9610",
                                "sense_id": "7659fbfa-c71d-3ca2-a5be-f2c9f890a3b4",
                                "text": "„Nudelsalat ist eine kalte Speise, die überwiegend aus gekochten Nudeln besteht und wird oft im Sommer zu Grillveranstaltungen gereicht. Es gibt eine Vielzahl von Variationsmöglichkeiten.“"
                            }
                        ],
