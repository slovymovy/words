                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "549bdfa8-9a14-47db-81d9-f10fa05f10f6",
                                "sense_id": "56787144-4b82-3bfc-ae4c-1030245c06ed",
                                "text": "Podczas EKOPIKNIKU czynne było również zaplecze gastronomiczne, gdzie oferowano bigos, grochówkę, ciastka i napoje"
                            },
                            {
                                "example_id": "716d9412-e437-45bd-b048-7cf89dce00dd",
                                "sense_id": "56787144-4b82-3bfc-ae4c-1030245c06ed",
                                "text": "Zaplanowano parkingi dla samochodów osobowych i autobusów, pawilon gastronomiczny, magazyn sprzętu, modernizację istniejącego budynku"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c8180bd-bd45-4e9f-8e8a-d1ed04652da3",
