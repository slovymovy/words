                ],
                "senses": [
                    {
                        "sense_id": "2a8ae611-82c1-30bb-b1b5-123bb0cbaac6",
                        "entry_id": "bbd61e1c-5d85-36ea-ad5d-50b05eaab22a",
                        "glosses": [
                            "Form (Flexionsform) des Verbs, mit der grammatische Kategorien wie Person, Numerus, Tempus, Modus und Genus verbi ausgedrückt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c34a4a-c303-45f2-831e-31c2448fe9b6",
                                "sense_id": "2a8ae611-82c1-30bb-b1b5-123bb0cbaac6",
                                "text": "„Für Frauen gibt es eine eigene Verbform, sie sagen »kochałam«.“"
                            },
                            {
                                "example_id": "8c3ba0d7-72cc-4bcb-b7b5-2eaa03175673",
                                "sense_id": "2a8ae611-82c1-30bb-b1b5-123bb0cbaac6",
                                "text": "„Es gibt drei Verbformen, mit denen man Einschätzungen des Geschehens ausdrückt.“"
                            },
                            {
                                "example_id": "9e3436f1-6a2b-419e-ac94-3b0f025839aa",
                                "sense_id": "2a8ae611-82c1-30bb-b1b5-123bb0cbaac6",
                                "text": "„Auf diese Weise blieben im Jiddischen viele Verbformen und -bedeutungen erhalten, deren Entsprechungen aus dem Deutschen längst verschwunden sind.“"
                            },
                            {
                                "example_id": "c05128c2-beda-4702-90d7-0f1726228434",
                                "sense_id": "2a8ae611-82c1-30bb-b1b5-123bb0cbaac6",
                                "text": "„Diese Konjugaion wird in allen Zeitstufen vorgenommen, das heißt, auf der Vergangenheits- und Zukunftsebene finden weitere Veränderungen der Verbformen statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
