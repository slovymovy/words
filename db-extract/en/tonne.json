            {
                "entry_id": "0c008e6e-bcbf-36b5-89d1-7a5957c40486",
                "word": "tonne",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "375db9c7-091e-4a42-a434-af2ecfec3c16",
                        "entry_id": "0c008e6e-bcbf-36b5-89d1-7a5957c40486",
                        "tags": [
                            "plural"
                        ],
                        "form": "tonnes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32edee27-0762-33ef-b926-d060d4a92b79",
                        "entry_id": "0c008e6e-bcbf-36b5-89d1-7a5957c40486",
                        "glosses": [
                            "A unit of mass equal to 1000 kilograms."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc78a5f-c8de-466c-8544-2675197d0f05",
                                "sense_id": "32edee27-0762-33ef-b926-d060d4a92b79",
                                "text": "Although loads of up to 900 tonnes could be handled by one of these locomotives, in practice the load is limited to 790 tonnes by drawgear."
                            },
                            {
                                "example_id": "4bc36ce6-2e39-4d8c-9692-be6e7144af6c",
                                "sense_id": "32edee27-0762-33ef-b926-d060d4a92b79",
                                "text": "The metric ton or 'tonne' is accepted as a synonym for the megagramme, and this form Is to be preferred on the grounds of brevity and familiarity in the industry. It may be as well to use the pronunciation 'tunnie' until the risk of confusion with the old ton has passed."
                            },
                            {
                                "example_id": "3e4f15c0-a97b-4a78-8d3b-5a2b10a9e014",
                                "sense_id": "32edee27-0762-33ef-b926-d060d4a92b79",
                                "text": "The British Steel Corporation, going metric but realising the possible confusion between a ton and a tonne (1,000 kilograms) has directed its staff to pronounce ‘tonne’ ‘tunnie’."
                            },
                            {
                                "example_id": "4efb54ca-1dc9-4b70-b7e8-abc48d0a5654",
                                "sense_id": "32edee27-0762-33ef-b926-d060d4a92b79",
                                "text": "The tonne rhymes with con (perhaps not in North America!) to distinguish it from the non-SI unit of weight, the ton rhyming with bun."
                            }
                        ]
                    }
                ],
                "translations": [],
