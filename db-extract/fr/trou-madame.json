        "fr-extract.jsonl": [
            {
                "entry_id": "168d3637-eb8f-30f2-a09c-9e6d20dbd6bd",
                "word": "trou-madame",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6165022b-14a6-34cb-a3e2-27e777d6eb0f",
                        "entry_id": "168d3637-eb8f-30f2-a09c-9e6d20dbd6bd",
                        "glosses": [
                            "Sorte de jeu avec lequel on jouait avec de petites boules qu’on tâchait de pousser dans des ouvertures en forme d’arcades."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a6d91030-7b0e-4709-b332-a01474cc8ce8",
                                "sense_id": "6165022b-14a6-34cb-a3e2-27e777d6eb0f",
                                "text": "Nous allâmes dîner à Versailles : le Roi fut de fort bonne humeur. L'on joua des bijoux, des hardes au trou-madame : j'en gagnai."
                            },
                            {
                                "example_id": "f1de9cc8-7496-42b1-b6ee-8fb29c0f1738",
                                "sense_id": "6165022b-14a6-34cb-a3e2-27e777d6eb0f",
                                "text": "À Quiberon, nous revîmes M. Rohan, sa rubiconde et haute épouse et son jeu du « trou-madame » qui remplace dans son établissement le billard obligé et qui paraît être une des curiosités du pays."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e0baeb6-c780-380c-8e9f-dffded904b60",
                        "entry_id": "168d3637-eb8f-30f2-a09c-9e6d20dbd6bd",
                        "glosses": [
                            "Jouer au trou-madame, faire l’amour."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c9cf89d0-9632-4a55-b112-d0818bbfc7d1",
                                "sense_id": "8e0baeb6-c780-380c-8e9f-dffded904b60",
                                "text": "Mercier était dans le vrai : chez Ramponneau, s’amuser, c’était “jouer çà cul contre pointe” ou “jouer au trou madame”, expressions d’époque."
                            }
                        ]
                    }
                ],
