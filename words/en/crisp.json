                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cooking_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should fry the bacon until it <w>crisps</w> nicely.",
                            "target_lang_translations": {
