                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae4db583-f340-39fb-9f0a-4322590410df",
                                        "entry_id": "365b88b7-c920-3606-a055-2921a97de4bb",
                                        "glosses": [
                                            "A building, wing or dependency set apart and adapted for lodging and feeding (and training) ungulates, especially horses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a4fd4e-ee96-4d77-a7cf-9c51e47d3d88",
                                                "sense_id": "ae4db583-f340-39fb-9f0a-4322590410df",
                                                "text": "There were stalls for fourteen horses in the squire's stables."
                                            },
                                            {
                                                "example_id": "a477e615-c0a9-4289-ae88-5e7b66f89488",
                                                "sense_id": "ae4db583-f340-39fb-9f0a-4322590410df",
                                                "text": "We made an odd party before the arrival of the Ten, particularly when the Celebrity dropped in for lunch or dinner. He could not be induced to remain permanently at Mohair because Miss Trevor was at Asquith, but he appropriated a Hempstead cart from the Mohair stables and made the trip sometimes twice in a day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9da487f9-b0bd-397f-a6c9-854c916ed54e",
                                        "entry_id": "365b88b7-c920-3606-a055-2921a97de4bb",
                                        "glosses": [
                                            "All the racehorses of a particular stable, i.e. belonging to a given owner."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a205e54b-9f47-3ac4-955f-fe0d5224590a",
                                        "entry_id": "365b88b7-c920-3606-a055-2921a97de4bb",
