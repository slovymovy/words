                "senses": [
                    {
                        "sense_id": "23a38653-064f-338f-9ed2-42a97cf7d434",
                        "entry_id": "85b12f3d-96b7-38a0-9b1a-6b07b6b290b8",
                        "glosses": [
                            "seidener Pyjama"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c82eef76-4688-46d9-aa62-7bd866a8c6ee",
                                "sense_id": "23a38653-064f-338f-9ed2-42a97cf7d434",
                                "text": "„Eine knochige Hand griff nach meinem Arm. Die Kühle der Finger drang durch meinen Seidenpyjama.“"
                            },
                            {
                                "example_id": "91f8c806-4b60-4a9a-b41d-37eb7b03c3cf",
                                "sense_id": "23a38653-064f-338f-9ed2-42a97cf7d434",
                                "text": "„Als er Dampf über dem Duschvorhang aufsteigen sah, zog er seinen Seidenpyjama aus und stellte sich unter die Brause.“"
                            },
                            {
                                "example_id": "0afb8343-9ca9-4c1a-984b-bcd8edbc2a87",
                                "sense_id": "23a38653-064f-338f-9ed2-42a97cf7d434",
                                "text": "„Er lief in seinem Seidenpyjama auf und ab, aufgewühlt und eine fast leere Rotweinflasche in der Hand.“"
                            },
                            {
                                "example_id": "01764e76-a11a-4d83-ab9c-45298a707938",
                                "sense_id": "23a38653-064f-338f-9ed2-42a97cf7d434",
                                "text": "„Er trägt einen Seidenpyjama, glänzende blaue Seide, und seine nackten Füße hängen über die Bettkante.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
