                "senses": [
                    {
                        "sense_id": "92c709a9-0c1a-35c6-822a-c1b48d4c2114",
                        "entry_id": "472636cb-3469-3dd3-9ba6-22d510d6530f",
                        "glosses": [
                            "im Aussagesatz die Wortstellungen, die sich vor, in oder nach der Satzklammer befinden."
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "316220cd-725d-46e7-9320-134536be5102",
                                "sense_id": "92c709a9-0c1a-35c6-822a-c1b48d4c2114",
                                "text": "Die Idee von den Stellungsfeldern orientiert sich daran, dass sich im Aussagesatz das finite Verb an der zweiten Satzgliedposition befindet und in vielen Fällen mit einem weiteren Prädikatsteil eine Satzklammer bildet."
                            },
                            {
                                "example_id": "83c9ac47-63dd-4cd8-84e6-cb7574e83f70",
                                "sense_id": "92c709a9-0c1a-35c6-822a-c1b48d4c2114",
                                "text": "In dem Satz \"Peter ist gestern nach Hause gekommen, viel zu spät\" bildet \"ist…gekommen\" die Satzklammer; auf diese bezogen befindet sich \"Peter\" im Vorfeld, \"gestern nach Hause\" im Mittelfeld und \"viel zu spät\" im Nachfeld."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
