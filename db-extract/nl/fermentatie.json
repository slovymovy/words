                    {
                        "translation_id": "be7bc6d4-2401-44c3-9a7e-7538eb0b35ac",
                        "source_entry_id": "4175e2d7-57e4-31ac-a065-680cc655c624",
                        "source_sense_id": "db9d611b-9b3b-351d-8aaf-116806b20862",
