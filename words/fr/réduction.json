                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants bénéficient d'une <w>réduction</w> sur le prix du billet de train."
                        },
                        {
                            "text": "Le magasin propose une <w>réduction</w> exceptionnelle de vingt pour cent pendant les soldes."
                        }
                    ],
                    "synonyms": [
                        "remise",
                        "ristourne"
                    ],
                    "antonyms": [
                        "augmentation"
                    ],
                    "common_phrases": [
