                "senses": [
                    {
                        "sense_id": "adb7fbd5-69d1-362b-bc9b-4845470f443b",
                        "entry_id": "73269a33-f491-345f-ba01-376497afd381",
                        "glosses": [
                            "Person, die traurig, ohne Energie und pessimistisch ist und das der Umgebung deutlich zeigt"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7c0a4a65-c11b-416b-ae9a-60cb39cd661f",
                                "sense_id": "adb7fbd5-69d1-362b-bc9b-4845470f443b",
                                "text": "Es bringt nichts, nur als Trauerkloß durch die Welt zu laufen. Hab Spaß!"
                            },
                            {
                                "example_id": "a77f6b38-1473-4688-aad6-1285fa3a77e6",
                                "sense_id": "adb7fbd5-69d1-362b-bc9b-4845470f443b",
                                "text": "Selbst die wohlgemeinte Aufforderung eines Freundes: „Hey, sei kein Trauerkloß und komm mit mir nach draußen!“, führt nicht dazu, dass ein Trauerkloß sich bewegt."
                            },
                            {
                                "example_id": "ba2bbfd7-c836-4596-9720-2d0f4b31dece",
                                "sense_id": "adb7fbd5-69d1-362b-bc9b-4845470f443b",
                                "text": "„Aus eigener Erfahrung wissen Margarita und ich, dass man nicht zum Trauerkloß werden muss, nur weil man Abgründe erlebt hat.“"
                            },
                            {
                                "example_id": "ffa6f7a6-d985-4659-a6af-b854f6505cba",
                                "sense_id": "adb7fbd5-69d1-362b-bc9b-4845470f443b",
                                "text": "Für sehr viele im Umfeld ist das [ein Flugzeugabsturz] eben zwei Jahre her, wir haben also „keinen Grund mehr, das zu dramatisieren oder immer den Trauerkloß zu spielen.“"
                            },
                            {
                                "example_id": "1597550e-6d52-4c2e-b7f0-5f191ff37eb2",
                                "sense_id": "adb7fbd5-69d1-362b-bc9b-4845470f443b",
                                "text": "Der Musiker, Moderator und Autor Dada Peng […] hatte schon in seinen jungen Jahren einige Begegnungen mit dem Tod. Ein Trauerkloß ist er trotzdem nicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
