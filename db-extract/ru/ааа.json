                                                "example_id": "f55319b3-5d90-4f4a-ad86-93fdca47d36b",
                                                "sense_id": "afdbaed6-0fdf-3874-82cd-7e12d6f390cf",
                                                "text": "Oh, so that's how it works."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52cccba5-3d74-3574-af25-e55bfbb9c610",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "A word to precede an offhand or annoyed remark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ee3aeb-0e79-4486-8265-ef89fef8a872",
                                                "sense_id": "52cccba5-3d74-3574-af25-e55bfbb9c610",
                                                "text": "Oh, leave me alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bef78ccd-decd-3c99-8f0e-d3736ad5d43e",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "A word to precede an added comment or afterthought."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1bcf9a8-aaab-4646-841c-bca5452537d0",
                                                "sense_id": "bef78ccd-decd-3c99-8f0e-d3736ad5d43e",
                                                "text": "Oh, and don't forget your coat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "461d4ad7-aa5e-3d5e-95fe-2216554bfeed",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "An invocation or address (similar to the vocative in languages with noun declension), often with a term of endearment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c285b2c9-6b62-4c3d-9f68-1f6e5f85ceab",
                                                "sense_id": "461d4ad7-aa5e-3d5e-95fe-2216554bfeed",
                                                "text": "Oh, gosh"
                                            },
                                            {
                                                "example_id": "5c1b7c30-9738-4b4f-b202-1fad7ce1cb89",
                                                "sense_id": "461d4ad7-aa5e-3d5e-95fe-2216554bfeed",
                                                "text": "Oh baby, baby, how was I supposed to know / That something wasn't right here?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d575ac6-2513-32ff-a18a-c9e0b99d2701",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "Exclamation for drama or emphasis (often poetic)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83cc5573-5dd0-439a-bfcd-3bab8e3fd59b",
                                                "sense_id": "0d575ac6-2513-32ff-a18a-c9e0b99d2701",
                                                "text": "Oh, when will it end?"
                                            },
                                            {
                                                "example_id": "09afc959-19df-41b9-95f3-d432ca1654d8",
                                                "sense_id": "0d575ac6-2513-32ff-a18a-c9e0b99d2701",
                                                "text": "And oh how stingingly acute, and pungently grievous and tormentive, are the remembrancing Reflections of a separate uncloathed Soul in the other World, upon a review of its mad Choice, foolish Hopes, fruitless Desires […]"
                                            },
                                            {
                                                "example_id": "82a6b97c-a408-4817-ac2c-6e18288ad505",
                                                "sense_id": "0d575ac6-2513-32ff-a18a-c9e0b99d2701",
                                                "text": "Oh, by what plots, by what forswearings, betrayings, oppressions, imprisonments, tortures, poisonings, and under what reasons of state and politic subtilty, have these forenamed kings […] pulled the vengeance of God upon themselves […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3113a7fd-bf1d-3275-a076-d2e83c7eefea",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "Expression of pain. See ouch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111270f6-afd5-4720-a094-41387e7c6bc9",
                                                "sense_id": "3113a7fd-bf1d-3275-a076-d2e83c7eefea",
                                                "text": "Oh! That hurt."
                                            },
                                            {
                                                "example_id": "91c80573-a268-47f9-96c4-e8840ee792f7",
                                                "sense_id": "3113a7fd-bf1d-3275-a076-d2e83c7eefea",
                                                "text": "\"Oh! . . . oh! . . . I can't bear it . . . It is too much . . . I die . . . I am going . . .\" were Polly's expressions of extasy",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aa5c101-b639-3032-9983-1de207062bfd",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "Space filler or extra syllable, especially in (popular) music."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e93f1d86-1fb9-4d1a-af66-717c65b8e7f3",
                                                "sense_id": "2aa5c101-b639-3032-9983-1de207062bfd",
                                                "text": "I'm off with the raggle-taggle gypsy-oh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "149c95e4-d1ab-389c-9e73-f5a1b2b386fb",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "Expression of mild scepticism."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa87c09-10b7-470c-8126-8fd100d187e2",
                                                "sense_id": "149c95e4-d1ab-389c-9e73-f5a1b2b386fb",
                                                "text": "\"You should watch where you're going!\" \"Oh?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "876234de-e9ad-392d-a684-c38cc6413324",
                                        "entry_id": "991f08ce-908a-3f96-8883-80f82bda30c9",
                                        "glosses": [
                                            "A word to mark a spoken phrase as imaginary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20fc58a7-6b6d-4d9f-81d2-79fe359cce5f",
                                                "sense_id": "876234de-e9ad-392d-a684-c38cc6413324",
                                                "text": "What if he says \"Oh, I need to see your ID\"?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63b99b33-da0e-3021-9843-39dbf327e6b4",
                                        "entry_id": "64dee961-2e6f-3cf8-be0f-79dda27a0ea1",
                                        "glosses": [
                                            "An utterance of oh; a spoken expression of surprise, acknowledgement, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1434ebba-2bf2-4ba7-aa10-fe51427a92b5",
                                                "sense_id": "63b99b33-da0e-3021-9843-39dbf327e6b4",
                                                "text": "There were ohs and ahs, and the people twisted about as they looked for her. Then they began to applaud."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oh",
                                "target_lang_code": "en",
