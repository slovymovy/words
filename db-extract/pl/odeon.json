                    {
                        "sense_id": "ac5b4ad6-8ac4-3adc-a37c-0e3a2a788cbb",
                        "entry_id": "010e81b2-6349-3562-9454-21b67e4d9099",
                        "glosses": [
                            "zadaszona budowla z amfiteatrem, w starożytnej Grecji i Rzymie, w której odbywały się konkursy muzyczne i recytatorskie"
                        ],
                        "tags": [],
