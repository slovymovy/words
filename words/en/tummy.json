                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小肚子",
                                "target_lang_sense_clarification": "指微凸的腹部"
                            },
                            {
                                "target_lang_word": "啤酒肚",
                                "target_lang_sense_clarification": "指因肥胖而突出的腹部"
                            }
                        ]
                    }
                }
            ]
