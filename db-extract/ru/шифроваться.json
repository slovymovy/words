                        ],
                        "form": "шифрова́вшись"
                    },
                    {
                        "form_id": "56055d48-ff24-49ce-bbfc-e384ec6c79b6",
                        "entry_id": "26c2dd2d-6a8c-3be8-86d8-6661faceb23e",
