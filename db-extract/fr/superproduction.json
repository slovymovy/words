                    {
                        "sense_id": "06b036f1-d8c4-3f00-a818-65605145b259",
                        "entry_id": "0fa2ca95-6702-3991-92f2-8f7b9dfae7f2",
                        "glosses": [
                            "Production cinématographique d'un film ou vidéoludique d’un jeu vidéo à gros budget et à grand spectacle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5025d6f3-78e5-4763-b9df-880d7e7fb97f",
                                "sense_id": "06b036f1-d8c4-3f00-a818-65605145b259",
                                "text": "Superproduction hollywoodienne ? Non, un Bresson intimiste, où l’auteur désenlumine la légende du Graal."
                            },
                            {
                                "example_id": "88fe721a-49a4-4609-9383-ab6b06f8d9d7",
                                "sense_id": "06b036f1-d8c4-3f00-a818-65605145b259",
                                "text": "Un peu plus d’un mois après la sortie de la superproduction Cyberpunk 2077, jeu vidéo le plus attendu de 2020 et ayant créé la polémique en raison de nombreux problèmes techniques, le studio CD Projekt a de nouveau présenté ses excuses aux consommateurs."
                            },
                            {
                                "example_id": "759c5c74-3bb7-4f4e-9b17-8f168a87f486",
                                "sense_id": "06b036f1-d8c4-3f00-a818-65605145b259",
                                "text": "J’adore les films de flics américains. Les superproductions où les fédéraux se penchent sur les cadavres, un Thermos Starbucks à la main."
                            }
                        ]
                    }
                ],
