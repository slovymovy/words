                                "target_senses": [
                                    {
                                        "sense_id": "f226011d-e216-3785-92f3-d4c5600edd6a",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "A supernatural detriment or hindrance; a bane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1fed9ae-0f33-4b95-97af-4ac93ad58318",
                                                "sense_id": "f226011d-e216-3785-92f3-d4c5600edd6a",
                                                "text": "If ye will not heare, and if yee will not lay it to heart, to giue glory vnto my name, saith the Lord of hostes; I will euen send a curse vpon you, and will curse your blessings: yea, I haue cursed them already, because yee doe not lay it to heart."
                                            },
                                            {
                                                "example_id": "4a46e150-3605-48fc-8a1d-9336ea72b359",
                                                "sense_id": "f226011d-e216-3785-92f3-d4c5600edd6a",
                                                "text": "Oh Portius, is there not some choſen Curſe,\nSome hidden Thunder in the Stores of Heav’n,\nRed with uncommon Wrath, to blaſt the Man\nWho owes his Greatneſs to his Country’s Ruin?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34bd3e04-2685-3681-90b0-e1d809931896",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "A prayer or imprecation that harm may befall someone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "068566ba-44ee-3daa-a6a0-d5af6e21631f",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "The cause of great harm, evil, or misfortune; that which brings evil or severe affliction; torment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4d1d21b-4fd7-42fb-a8a4-237eb3f704bc",
                                                "sense_id": "068566ba-44ee-3daa-a6a0-d5af6e21631f",
                                                "text": "The common curſe of mankinde, Folly and Ignorance[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1770f9b-fb37-345d-ba43-ff813216e721",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "A vulgar epithet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6af0c0a-7538-427e-af4a-e6d8f5552aa7",
                                                "sense_id": "e1770f9b-fb37-345d-ba43-ff813216e721",
                                                "text": "Swearing doesn't just mean what we now understand by \"dirty words\". It is entwined, in social and linguistic history, with the other sort of swearing: vows and oaths. Consider for a moment the origins of almost any word we have for bad language – \"profanity\", \"curses\", \"oaths\" and \"swearing\" itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e779498c-895c-38c8-8e48-68e84fdbf620",
                                        "entry_id": "07895232-050d-3c23-825e-e65c139773ed",
                                        "glosses": [
                                            "A woman's menses."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory",
                                            "slang",
                                            "usually",
                                            "with-definite-article"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "curse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78c51a55-adfa-356d-8a29-16955f262f1f",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To place a curse upon (a person or object)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f6466a9-5476-454e-8b94-67400aa7ba5e",
                                                "sense_id": "78c51a55-adfa-356d-8a29-16955f262f1f",
                                                "text": "And Balaam said unto God, Balak the son of Zippor, king of Moab, hath sent unto me, saying,\nBehold, there is a people come out of Egypt, which covereth the face of the earth: come now, curse me them; peradventure I shall be able to overcome them, and drive them out.\nAnd God said unto Balaam, Thou shalt not go with them; thou shalt not curse the people: for they are blessed."
                                            },
                                            {
                                                "example_id": "9fb6ed70-1cde-43c1-b920-341436d6f8d5",
                                                "sense_id": "78c51a55-adfa-356d-8a29-16955f262f1f",
                                                "text": "Captain Edward Carlisle[…]felt a curious sensation of helplessness seize upon him as he met her steady gaze,[…]; he could not tell what this prisoner might do. He cursed the fate which had assigned such a duty, cursed especially that fate which forced a gallant soldier to meet so superb a woman as this under handicap so hard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d2f5b9-5b5a-3fab-8de6-657df98202b3",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To call upon divine or supernatural power to send injury upon; to imprecate evil upon; to execrate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "295b8be6-db08-45fa-bd41-2471f51442c5",
                                                "sense_id": "23d2f5b9-5b5a-3fab-8de6-657df98202b3",
                                                "text": "Thou ſhalt not[…]curſe the ruler of thy people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a94fa5c8-ecf5-3cef-a440-684f8f61f4b2",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To speak or shout a vulgar curse or epithet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8224fa6d-bec9-3c71-aedd-1b93eff5a363",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To use offensive or morally inappropriate language."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "998e7f81-6ed2-4764-8df3-14a0fd9bda43",
                                                "sense_id": "8224fa6d-bec9-3c71-aedd-1b93eff5a363",
                                                "text": "Then beganne hee to curſe and to ſweare[…]"
                                            },
                                            {
                                                "example_id": "75c4d704-0e36-444f-876b-443223de4218",
                                                "sense_id": "8224fa6d-bec9-3c71-aedd-1b93eff5a363",
                                                "text": "[…]his Spirits heare me, / And yet I needes muſt curſe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0dfae06-8bb3-3029-9f15-341a81fa0817",
                                        "entry_id": "051bb820-0318-31f5-ada0-d5fa81840b43",
                                        "glosses": [
                                            "To bring great evil upon; to be the cause of serious harm or unhappiness to; to furnish with that which will be a cause of deep trouble; to afflict or injure grievously; to harass or torment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0313dad2-f819-4bb1-b800-347ce4030223",
                                                "sense_id": "b0dfae06-8bb3-3029-9f15-341a81fa0817",
                                                "text": "On Impious Realms, and barb’rous Kings, impoſe / Thy Plagues, and curſe 'em with ſuch Sons as thoſe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "776758e7-059a-4c36-af81-ed98173fd1e8",
                        "source_entry_id": "726476be-0179-3b6b-9aaf-7a1ac610760b",
                        "source_sense_id": "5daf1f66-8182-340a-8db8-cd1ace82917c",
                        "target_lang_word": "damn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07b5ee10-d020-3d97-8fe3-430c1432469d",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To condemn."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843cbf89-1109-4edb-9c3a-8ba77e17a4d4",
                                                "sense_id": "07b5ee10-d020-3d97-8fe3-430c1432469d",
                                                "text": "The official position is that anyone who does this will be damned for all eternity."
                                            },
                                            {
                                                "example_id": "e60118bc-323c-4447-8c09-f0d0a8a49e56",
                                                "sense_id": "07b5ee10-d020-3d97-8fe3-430c1432469d",
                                                "text": "Only God can damn."
                                            },
                                            {
                                                "example_id": "ac03afa1-3a41-45cb-a678-cc3736aae18b",
                                                "sense_id": "07b5ee10-d020-3d97-8fe3-430c1432469d",
                                                "text": "I damn you eternally, fiend!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59fa85cc-e36a-3224-a6aa-0b7c8124346b",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To condemn; to declare guilty; to doom; to adjudge to punishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "422fd883-f626-4ac5-8f14-53f7dffed30e",
                                                "sense_id": "59fa85cc-e36a-3224-a6aa-0b7c8124346b",
                                                "text": "He shall not live; look, with a spot I damn him."
                                            },
                                            {
                                                "example_id": "43fe2c20-f1cc-48be-abae-8b01732ef5fd",
                                                "sense_id": "59fa85cc-e36a-3224-a6aa-0b7c8124346b",
                                                "text": "Lack of access to support services can damn children with disabilities and lesser means to lives where they never harness their full range of abilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf89c886-0dff-3065-a5b7-a5135a570ec7",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To put out of favor; to ruin; to label negatively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d434b8a8-bf0a-4667-9350-425f0058c8c0",
                                                "sense_id": "cf89c886-0dff-3065-a5b7-a5135a570ec7",
                                                "text": "I’m afraid that if I speak out on this, I’ll be damned as a troublemaker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5997a55a-b85c-3515-90c4-94731692b2ab",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To condemn as unfit, harmful, invalid, immoral or illegal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51cf55f7-5437-4944-9492-1bba04ca12b6",
                                                "sense_id": "5997a55a-b85c-3515-90c4-94731692b2ab",
                                                "text": "1708 November 8, Alexander Pope, letter to Henry Cromwell\nYou are not so arrant a critic as to damn them [the works of modern poets] […] without hearing."
                                            },
                                            {
                                                "example_id": "d67b30e9-a46b-493e-bb31-0a871146c246",
                                                "sense_id": "5997a55a-b85c-3515-90c4-94731692b2ab",
                                                "text": "Homosexuality and suicide have some common characteristics. Both are damned by the Western Judeo-Christian culture as sins (although the latter has only been considered such since the sixth century)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e53af48-71a6-3e2f-a75e-f44245caaafc",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To curse; put a curse upon."
                                        ],
                                        "tags": [
                                            "sometimes",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23068781-c886-4201-940c-b95bf561ce75",
                                                "sense_id": "8e53af48-71a6-3e2f-a75e-f44245caaafc",
                                                "text": "That man stole my wallet. Damn him!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e391e11f-9191-3611-aa37-1913ffc59332",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To invoke damnation; to curse."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170765fd-056e-41b5-a6bb-0f7b758a37b0",
                                                "sense_id": "e391e11f-9191-3611-aa37-1913ffc59332",
                                                "text": "c. 1767-1774, Oliver Goldsmith, letter to Mrs. Bunbury\n[…] while I inwardly damn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "damn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "568102cf-5aa5-32b2-aa2f-785968a640a7",
                                        "entry_id": "cb5bea64-c58d-339f-9514-540aae87ff6e",
                                        "glosses": [
                                            "Generic intensifier. Fucking; bloody."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "sometimes",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d2cb0e-ada7-4a05-b4c8-40e05c697bfe",
                                                "sense_id": "568102cf-5aa5-32b2-aa2f-785968a640a7",
                                                "text": "Shut the damn door!"
                                            },
                                            {
                                                "example_id": "8de7b7e8-ee4a-487b-bbd4-f4f7ba0a6d58",
                                                "sense_id": "568102cf-5aa5-32b2-aa2f-785968a640a7",
                                                "text": "Damn freaks!"
                                            },
                                            {
                                                "example_id": "fb516832-9855-4721-b0c2-b68f5038a06d",
                                                "sense_id": "568102cf-5aa5-32b2-aa2f-785968a640a7",
                                                "text": "Damn psychos!"
                                            },
                                            {
                                                "example_id": "08cacfac-51a8-4519-a73d-040e29ed99e4",
                                                "sense_id": "568102cf-5aa5-32b2-aa2f-785968a640a7",
                                                "text": "The whole damn building came down!"
                                            },
                                            {
                                                "example_id": "1ee789db-7f57-4727-b668-623f320f1287",
                                                "sense_id": "568102cf-5aa5-32b2-aa2f-785968a640a7",
                                                "text": "Damn cultists are psychotic."
                                            },
                                            {
                                                "example_id": "07816750-80ba-490c-a7d5-c361d382a3f9",
                                                "sense_id": "568102cf-5aa5-32b2-aa2f-785968a640a7",
                                                "text": "Where's that damn FOURTH Chaos Emerald!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "damn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee49b845-4994-39b3-8e75-b65fa5b88fe3",
                                        "entry_id": "44f1d23d-f8c8-3f8f-a824-dc94e2f4afe6",
                                        "glosses": [
                                            "Very; extremely."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "sometimes",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cf61f54-bc71-4826-bf3a-b367855e5656",
                                                "sense_id": "ee49b845-4994-39b3-8e75-b65fa5b88fe3",
                                                "text": "That car was going damn fast!"
                                            },
                                            {
                                                "example_id": "9926e697-4e5a-4949-87c2-87ef8b087ad5",
                                                "sense_id": "ee49b845-4994-39b3-8e75-b65fa5b88fe3",
                                                "text": "How are you damn quick?"
                                            },
                                            {
                                                "example_id": "c6f41778-4f4c-477e-b2b5-ed135dbe3f65",
                                                "sense_id": "ee49b845-4994-39b3-8e75-b65fa5b88fe3",
                                                "text": "You must be so damn rapid."
                                            },
                                            {
                                                "example_id": "c2a55bd4-f578-4436-a631-f7ccbe385646",
                                                "sense_id": "ee49b845-4994-39b3-8e75-b65fa5b88fe3",
                                                "text": "I damn well hope you never come back."
                                            },
                                            {
                                                "example_id": "0184703f-727f-473a-a68d-37d6a1761d65",
                                                "sense_id": "ee49b845-4994-39b3-8e75-b65fa5b88fe3",
                                                "text": "We're begging, damn near down on our knees, and not getting one red cent."
                                            }
                                        ]
                                    }
                                ]
                            },
