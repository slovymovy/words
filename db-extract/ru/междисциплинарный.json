                ],
                "senses": [
                    {
                        "sense_id": "2e8de31f-e150-3840-b519-dba4cc32e064",
                        "entry_id": "195074b8-5f69-3c17-be88-a58e5c7e18d1",
                        "glosses": [
                            "касающийся двух или нескольких научных дисциплин, находящийся на их стыке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a04eb546-08f1-428c-ae84-d8ef9a6aa958",
                                "sense_id": "2e8de31f-e150-3840-b519-dba4cc32e064",
                                "text": "Электронные информационные ресурсы с удалённым доступом (полимодальные, интерактивные, гиперсвязанные и пр.) с реализацией междисциплинарных связей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76896548-c80a-4952-8c53-1d30e88018f6",
                        "source_entry_id": "195074b8-5f69-3c17-be88-a58e5c7e18d1",
                        "source_sense_id": "2e8de31f-e150-3840-b519-dba4cc32e064",
                        "target_lang_word": "interdisziplinär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interdisziplinär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                        "entry_id": "e0a23ff8-1971-39b3-91ba-92e8251d1c37",
                                        "glosses": [
                                            "über die Grenzen einer (Wissenschafts-)Disziplin hinaus; mehrere Disziplinen einbeziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174fa7b2-a389-468e-a000-19fca218512a",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "Viele Probleme müssen interdisziplinär betrachtet werden, um sie lösen zu können."
                                            },
                                            {
                                                "example_id": "7dd4d932-b096-43ed-a3bb-c13a53f5f24d",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Es kommt somit nicht überraschend, daß es alternative Vorschläge für interdisziplinäre Aktivitäten gibt.“"
                                            },
                                            {
                                                "example_id": "ff0a61ba-941d-4ddf-bbcf-0be1a5a703c4",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Interdisziplinäres Lernen und fächerübergreifende Projekte dürften dazu fast besser geeignet sein als ein zusätzliches Schulfach.“"
                                            },
                                            {
                                                "example_id": "d19554fb-b95e-435f-bb1e-399ab0c38953",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Lange Zeit haben fächerübergreifende Projekte den Sportunterricht eher selten einbezogen[…]. Dieser Umstand ist angesichts der bereits Mitte der 1970er Jahre präsentierten Grundlegungen zu einer interdisziplinären Sporterziehung von Siegbert A. Warwitz (1974) und der praxisorientierten Arbeiten seiner Arbeitsgruppe […] kaum nachvollziehbar.“"
                                            },
                                            {
                                                "example_id": "ef6e817c-0c56-445a-b5a7-079c8cdd5ca3",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Der Ausdruck interdisziplinäre Kooperation bezeichnet das die engen Fachgrenzen überwindende konstruktive Interagieren mehrerer Fachexperten im Sinne einer größeren Ökonomie, Effektivität, Lebens- und Sachnähe bei der Bewältigung komplizierterer Aufgaben.“"
                                            },
                                            {
                                                "example_id": "071daa8b-ac14-4996-9f86-70ba5d42499a",
                                                "sense_id": "2ad9ec2d-d1c7-3b52-840e-6c63a9402f20",
                                                "text": "„Fachübergreifende Themen wie Finanzkrise, Fachkräftemangel, Migration oder ethisches Handeln erfordern interdisziplinäre Kenntnisse, um umfassend erforscht werden zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
