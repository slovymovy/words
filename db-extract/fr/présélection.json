                "senses": [
                    {
                        "sense_id": "3165147f-a3ed-3e19-af7c-def65a9ebf7e",
                        "entry_id": "d601b88f-d90c-3df2-bd6e-3f02f1751d19",
                        "glosses": [
                            "Sélection ou choix préalable d’un nombre précis de personnes ou de choses en vue d’une sélection ultérieure plus restreinte, voire d’un unique élément final."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6a188f2-5d1a-4b60-9d60-739937b80bd3",
                                "sense_id": "3165147f-a3ed-3e19-af7c-def65a9ebf7e",
                                "text": "Présélection des 22 joueurs d’une équipe de football avant désignation des titulaires et des suppléants."
                            },
                            {
                                "example_id": "35a2f188-d0b4-4201-9f14-fdae9340e5a8",
                                "sense_id": "3165147f-a3ed-3e19-af7c-def65a9ebf7e",
                                "text": "Présélection, appelée nomination, des artistes qui vont concourir pour le titre de lauréat dans une catégorie lors de la remise des Césars ou des Oscars."
                            },
                            {
                                "example_id": "2949dc08-f2ad-44ab-96bc-a3663dce2d6d",
                                "sense_id": "3165147f-a3ed-3e19-af7c-def65a9ebf7e",
                                "text": "Présélection de quelques lieux de vacances avant de n’en retenir qu’un."
                            },
                            {
                                "example_id": "3de54c43-826f-4340-9d41-106aecc5e55e",
                                "sense_id": "3165147f-a3ed-3e19-af7c-def65a9ebf7e",
                                "text": "La société développe une suite de solutions digitales et innovantes de présélection à destination des professionnels du recrutement."
                            }
                        ]
                    },
                    {
                        "sense_id": "9fed3c40-8dcc-3f6d-a56a-00f750bc36e7",
                        "entry_id": "d601b88f-d90c-3df2-bd6e-3f02f1751d19",
                        "glosses": [
                            "Voie qu’emprunte un véhicule en cas de changement de direction."
                        ],
                        "tags": [
                            "Circulation"
                        ],
                        "examples": [
                            {
                                "example_id": "699f204d-f280-4764-ba8d-fa5227c786fc",
                                "sense_id": "9fed3c40-8dcc-3f6d-a56a-00f750bc36e7",
                                "text": "Le gros trolleybus bleu aborda la place Saint-François par la présélection de droite."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ba59dec-c8bf-35a6-af05-3fb0784459c7",
                        "entry_id": "d601b88f-d90c-3df2-bd6e-3f02f1751d19",
                        "glosses": [
                            "Dispositif à touches permettant de mettre en mémoire un élément à rappeler ultérieurement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dda5928d-b3c9-4013-b2cf-9ea2d329ea5d",
                                "sense_id": "5ba59dec-c8bf-35a6-af05-3fb0784459c7",
                                "text": "Ce poste de radio est doté de 36 présélections."
                            }
                        ]
                    }
                ],
