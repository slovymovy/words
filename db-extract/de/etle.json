                ],
                "senses": [
                    {
                        "sense_id": "77694c3a-e212-351a-ad4c-785c6ff9aad6",
                        "entry_id": "202acc7f-3939-31b9-9a9a-d75223680fb8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c89e1454-27eb-4ee7-8b94-378a2e684cb6",
                                "sense_id": "77694c3a-e212-351a-ad4c-785c6ff9aad6",
                                "text": "Frau Etle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1e1fba18-02e8-483b-95d8-85bae81e3ff5",
                                "sense_id": "77694c3a-e212-351a-ad4c-785c6ff9aad6",
                                "text": "Herr Etle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "56c773ed-4da8-4bab-b461-f52b6fbe7fae",
                                "sense_id": "77694c3a-e212-351a-ad4c-785c6ff9aad6",
                                "text": "Die Etles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "be027542-cf9e-4248-abeb-585d72d3d146",
                                "sense_id": "77694c3a-e212-351a-ad4c-785c6ff9aad6",
                                "text": "Der Etle trägt nie die Schals, die die Etle ihm strickt."
                            },
                            {
                                "example_id": "7fa56112-b8e2-4220-a43f-4163f9c10ac0",
                                "sense_id": "77694c3a-e212-351a-ad4c-785c6ff9aad6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Etle kommt, geht der Herr Etle.“"
                            },
                            {
                                "example_id": "4fc3185a-5808-42b6-ba59-074dced24e10",
                                "sense_id": "77694c3a-e212-351a-ad4c-785c6ff9aad6",
                                "text": "Etle kommt und geht."
                            },
                            {
                                "example_id": "60bc5656-4a1a-486d-90b8-b540f763100a",
                                "sense_id": "77694c3a-e212-351a-ad4c-785c6ff9aad6",
                                "text": "Etles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
