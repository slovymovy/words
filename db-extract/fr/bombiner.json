                "senses": [
                    {
                        "sense_id": "3c323e48-1901-3a7b-aab9-f37a425f01b9",
                        "entry_id": "42784c24-e0fb-37f4-b9e9-fb95e7efb467",
                        "glosses": [
                            "Bourdonner."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "046979f9-6990-48e2-9932-ebc400655567",
                                "sense_id": "3c323e48-1901-3a7b-aab9-f37a425f01b9",
                                "text": "A, noir corset velu des mouches éclatantes\nQui bombinent autour des puanteurs cruelles."
                            },
                            {
                                "example_id": "6d3850d3-7885-4786-b2fa-95d58c158c8c",
                                "sense_id": "3c323e48-1901-3a7b-aab9-f37a425f01b9",
                                "text": "Il s’offrait également aux demoiselles, trop occupées à bombiner dans le vide pour l’apercevoir."
                            },
                            {
                                "example_id": "c0a609ab-e6fe-4b75-b4a3-e562ecd77f0a",
                                "sense_id": "3c323e48-1901-3a7b-aab9-f37a425f01b9",
                                "text": "A, noir carcan poilu d’un scintillant morpion / Qui bombinait autour d’un nidoral impur"
                            },
                            {
                                "example_id": "1bb5eb02-a7ce-4b1f-a0a6-6f4bf02ce204",
                                "sense_id": "3c323e48-1901-3a7b-aab9-f37a425f01b9",
                                "text": "Une sourde animation bombinait dans le poste de police, au milieu duquel se tenait un chauffeur de grande maison en livrée, casquette et gants d’uniforme."
                            }
                        ]
                    }
                ],
