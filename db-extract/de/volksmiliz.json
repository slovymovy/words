                "senses": [
                    {
                        "sense_id": "36c4c3d1-ab07-373e-a601-14d31b91d01b",
                        "entry_id": "ad2db476-4671-3f38-a66f-fb83c0aaad67",
                        "glosses": [
                            "nicht ständige Streitkräfte als Ergänzung der Kampftruppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab7bee76-bb67-4603-b042-fc98a262ee1c",
                                "sense_id": "36c4c3d1-ab07-373e-a601-14d31b91d01b",
                                "text": "„Zum Höhepunkt der Epidemie patrouillierte nachts auf beiden Seiten Volksmiliz mit Schäferhunden.“"
                            },
                            {
                                "example_id": "33af6afa-4808-45a3-aae5-0d10c4cbee19",
                                "sense_id": "36c4c3d1-ab07-373e-a601-14d31b91d01b",
                                "text": "„Warum hatte die Volksmiliz es überhaupt zulassen können, dass sich diese Menschen illegal sammeln konnten?“"
                            },
                            {
                                "example_id": "817fbf64-a1dc-41ed-89ee-1fd1c2e236d9",
                                "sense_id": "36c4c3d1-ab07-373e-a601-14d31b91d01b",
                                "text": "„Der Ersatz der regulären Armee durch die Volksmiliz war und ist im Programm des internationalen Sozialismus.“"
                            },
                            {
                                "example_id": "6bee771b-e023-4409-a6c6-cf4f9256fd4c",
                                "sense_id": "36c4c3d1-ab07-373e-a601-14d31b91d01b",
                                "text": "„Mirosław Okoń, Waceks Vormund und bester Freund seines Vaters, war als Offizier in die neugegründete Miliz der Volksrepublik Polen übernommen worden und hatte an der Wojewodschafts-Kommandantur der Volksmiliz (KWMO) in Krakau gedient.“"
                            },
                            {
                                "example_id": "be045ceb-b24c-45e8-9bfa-171a09bec430",
                                "sense_id": "36c4c3d1-ab07-373e-a601-14d31b91d01b",
                                "text": "„Neben dem Feudalheer war niemals die alte Volksmiliz, die seit der angelsächsischen Herrschaft bestand, untergegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
