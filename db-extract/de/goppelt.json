                "senses": [
                    {
                        "sense_id": "14b9ef84-da4b-337e-b705-6e19e6bf08f6",
                        "entry_id": "63492dd6-4949-3d6d-b873-3439c4dce1d9",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "589619fa-c4fa-47a6-9c3a-431fd3debb8d",
                                "sense_id": "14b9ef84-da4b-337e-b705-6e19e6bf08f6",
                                "text": "Frau Goppelt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ef7619b1-790f-4eca-845d-9f8fa149e330",
                                "sense_id": "14b9ef84-da4b-337e-b705-6e19e6bf08f6",
                                "text": "Herr Goppelt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8782f4bc-8953-4d43-bfac-d0d874f84bd1",
                                "sense_id": "14b9ef84-da4b-337e-b705-6e19e6bf08f6",
                                "text": "Die Goppelts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "b7ab6c43-d3d7-4548-a67a-b3efb6d55c40",
                                "sense_id": "14b9ef84-da4b-337e-b705-6e19e6bf08f6",
                                "text": "Der Goppelt trägt nie die Pullover, die die Goppelt ihm strickt."
                            },
                            {
                                "example_id": "a33ed327-4e78-4124-92a4-211b8050010d",
                                "sense_id": "14b9ef84-da4b-337e-b705-6e19e6bf08f6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Goppelt kommt, geht der Herr Goppelt.“"
                            },
                            {
                                "example_id": "68d90343-84d6-4adf-ac24-fdc20e132fad",
                                "sense_id": "14b9ef84-da4b-337e-b705-6e19e6bf08f6",
                                "text": "Goppelt kommt und geht."
                            },
                            {
                                "example_id": "2d85c4cc-b175-4036-9b0a-62d82569c35e",
                                "sense_id": "14b9ef84-da4b-337e-b705-6e19e6bf08f6",
                                "text": "Goppelts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
