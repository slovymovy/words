                        "sense_id": "27f617e0-9c1c-3c1c-82ac-056a77a02348",
                        "entry_id": "7f881064-9d3b-348f-9caf-8d3f6f59ef52",
                        "glosses": [
                            "Donner un caractère clandestin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcaffd17-fd40-4255-b784-d091c7443e9a",
                                "sense_id": "27f617e0-9c1c-3c1c-82ac-056a77a02348",
                                "text": "Au pire, il y a une négation du phénomène, en essayant de supprimer les signes extérieurs de pauvreté, au risque de la clandestiniser."
                            },
                            {
                                "example_id": "f45b6f7c-a44d-4aad-8a66-86df89702d87",
                                "sense_id": "27f617e0-9c1c-3c1c-82ac-056a77a02348",
                                "text": "ami d’Edouard Herriot, il avait refusé de servir Vichy, mais il avait besoin, selon l’expression de Pedro, de se « clandestiniser » complètement, ce qu’il fit sous la direction de son mentor."
                            }
                        ]
                    }
