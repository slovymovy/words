                    {
                        "sense_id": "df4b617b-7ead-362f-a479-2cb7ba9f1414",
                        "entry_id": "78382862-e452-3d94-b9f9-ecd7d3970b11",
                        "glosses": [
                            "een buiten de omgeving uitstekend deel, vrij lang en puntig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "465ea63f-76f3-4016-ab30-6d51d8b21007",
                                "sense_id": "df4b617b-7ead-362f-a479-2cb7ba9f1414",
                                "text": "De bergbeklimmer was nog niet op die hoge piek geweest."
                            }
                        ]
                    },
                    {
                        "sense_id": "89df6995-51ce-3175-8264-38ab06a96dde",
                        "entry_id": "78382862-e452-3d94-b9f9-ecd7d3970b11",
                        "glosses": [
                            "natuurwetenschap: een signaal dat zich uit als een maximum in een kromme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63cfb3ca-11a6-498c-ab96-40c6e29f15d0",
                                "sense_id": "89df6995-51ce-3175-8264-38ab06a96dde",
                                "text": "Die twee pieken overlappen te veel om ze goed te kunnen scheiden."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca30df71-0b6c-3413-9f21-db4cb0d5c30a",
                        "entry_id": "78382862-e452-3d94-b9f9-ecd7d3970b11",
                        "glosses": [
                            "een kortstondige, sterke toename (van activiteit, aantallen en dergelijke)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c1317a-1e65-4567-8cfc-509845b5b451",
                                "sense_id": "ca30df71-0b6c-3413-9f21-db4cb0d5c30a",
                                "text": "Het uitschakelen van zo'n elektromotor geeft een fikse piek op de netspanning."
                            }
                        ]
                    },
                    {
                        "sense_id": "537bcd3f-7e81-3701-94fa-e045eb8034cb",
                        "entry_id": "78382862-e452-3d94-b9f9-ecd7d3970b11",
                        "glosses": [
                            "een (tijdelijk) optimale vorm waarin een uitzonderlijke prestatie kan worden geleverd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ad20da4-ddbf-4c8f-bb38-46b3a42d324c",
                                "sense_id": "537bcd3f-7e81-3701-94fa-e045eb8034cb",
                                "text": "De piek moet er bij de finale zijn, niet eerder."
                            }
                        ]
                    },
                    {
