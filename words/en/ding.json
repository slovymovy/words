{
    "word_family": [
        "ding"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b26e99dd-c1f7-31d5-b773-7920cfc962e1",
                    "sense_definition": "A historical prefecture of imperial China.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Ding</w> prefecture was a significant administrative center during the Tang dynasty.",
                            "target_lang_translations": {
                                "zh": "<w>定州</w>在唐代是一个重要的行政中心。"
                            }
                        },
                        {
                            "text": "Historical records describe the boundaries of the <w>Ding</w> region in ancient China.",
                            "target_lang_translations": {
                                "zh": "历史记录描述了中国古代<w>定州</w>地区的边界。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Dingzhou"
                    ],
                    "target_lang_definitions": {
                        "zh": "中国古代的一个行政区划名称。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "定州",
                                "target_lang_sense_clarification": "指代古代的定州地区。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59369d31-e7b0-3184-b522-cf9dc82a675a",
                    "sense_definition": "A former county in Hebei Province, China.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Ding</w> county was reorganized during the Republican era.",
                            "target_lang_translations": {
                                "zh": "<w>定县</w>在民国时期进行了重组。"
                            }
                        },
                        {
                            "text": "Many families in the region trace their roots back to <w>Ding</w> county.",
                            "target_lang_translations": {
                                "zh": "该地区的许多家庭都追溯其根源于<w>定县</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Dingxian"
                    ],
                    "target_lang_definitions": {
                        "zh": "中国河北省曾经的一个县。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "定县",
                                "target_lang_sense_clarification": "指代历史上的定县。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "407d7789-fa5f-3666-9848-f18524398cbe",
                    "sense_definition": "A common Chinese surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Ding</w> is our new professor of history.",
                            "target_lang_translations": {
                                "zh": "<w>丁</w>先生是我们新的历史学教授。"
                            }
                        },
                        {
                            "text": "The <w>Ding</w> family has lived in this city for generations.",
                            "target_lang_translations": {
                                "zh": "<w>丁</w>家在这个城市已经住了好几代了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "常见的中国姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丁",
                                "target_lang_sense_clarification": "作为姓氏使用。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a3d40925-d945-3009-80ce-8532625cd16e",
                    "sense_definition": "A small dent or mark on a surface caused by an impact.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car door has a small <w>ding</w> from the shopping cart.",
                            "target_lang_translations": {
                                "zh": "车门上有一个被购物车撞出的<w>凹痕</w>。"
                            }
                        },
                        {
                            "text": "I noticed a <w>ding</w> on the side of my laptop after I dropped it.",
                            "target_lang_translations": {
                                "zh": "笔记本电脑掉落后，我发现侧面有一个<w>凹痕</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "物体表面因碰撞而产生的凹痕。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "凹痕",
                                "target_lang_sense_clarification": "指物体表面受损后的凹陷。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f935f36-adf8-36df-a194-220f9fce60cd",
                    "sense_definition": "The short, high-pitched sound made by a bell.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard the <w>ding</w> of the elevator when it arrived at my floor.",
                            "target_lang_translations": {
                                "zh": "电梯到达我所在的楼层时，我听到了<w>叮当声</w>。"
                            }
                        },
                        {
                            "text": "The microwave gave a loud <w>ding</w> to signal that the food was ready.",
                            "target_lang_translations": {
                                "zh": "微波炉发出响亮的<w>叮当声</w>，提示食物已经热好了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "铃声或类似的高音响声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "叮当声",
                                "target_lang_sense_clarification": "形容清脆的铃声。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18d306d6-493c-3916-8567-3a7295905ec0",
                    "sense_definition": "A notification of rejection, often in an application process.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was disappointed to receive a <w>ding</w> from my top-choice university.",
                            "target_lang_translations": {
                                "zh": "收到第一志愿大学的<w>拒信</w>，我感到很失望。"
                            }
                        },
                        {
                            "text": "After the interview, I waited anxiously to see if I would get a <w>ding</w> or an offer.",
                            "target_lang_translations": {
                                "zh": "面试后，我焦急地等待着结果，看是会收到<w>拒信</w>还是录取通知。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in professional or academic application contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在申请过程中被拒绝的通知。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拒信",
                                "target_lang_sense_clarification": "指申请被拒绝的通知。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e90f5082-93a8-3b6a-916b-8cc0f2d2cd44",
                    "sense_definition": "To cause a small dent or mark on something by hitting it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>ding</w> the wall while moving the furniture.",
                            "target_lang_translations": {
                                "zh": "搬家具时小心点，别把墙壁<w>磕碰</w>坏了。"
                            }
                        },
                        {
                            "text": "I accidentally <w>dinged</w> my car door in the parking lot.",
                            "target_lang_translations": {
                                "zh": "我在停车场不小心<w>磕碰</w>到了车门。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "因碰撞而在物体表面留下凹痕。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "磕碰",
                                "target_lang_sense_clarification": "指造成轻微的损伤或凹痕。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2919ac3-3200-30c4-b9ef-15eaba65db6f",
                    "sense_definition": "To produce a short, high-pitched ringing sound.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bell will <w>ding</w> when the timer reaches zero.",
                            "target_lang_translations": {
                                "zh": "计时器归零时，铃声会<w>叮</w>地响一声。"
                            }
                        },
                        {
                            "text": "The doorbell <w>dinged</w> twice, but nobody was at the door.",
                            "target_lang_translations": {
                                "zh": "门铃<w>叮</w>了两声，但门口没人。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "发出清脆的响声。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "叮",
                                "target_lang_sense_clarification": "拟声词，指发出清脆的响声。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35234b96-a553-37ad-bda6-de0f623d72d0",
                    "sense_definition": "To reject someone from an application or selection process.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company <w>dinged</w> many qualified candidates due to the high volume of applicants.",
                            "target_lang_translations": {
                                "zh": "由于申请人数众多，该公司<w>拒绝</w>了许多合格的候选人。"
                            }
                        },
                        {
                            "text": "I was worried that my lack of experience would get me <w>dinged</w> by the hiring manager.",
                            "target_lang_translations": {
                                "zh": "我担心自己经验不足会被招聘经理<w>拒绝</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally in recruitment or admissions."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在申请或选拔过程中拒绝某人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "拒绝",
                                "target_lang_sense_clarification": "指在招聘或录取中淘汰某人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}