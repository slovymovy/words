                    },
                    {
                        "translation_id": "c99716d5-ced1-4846-a14e-ccb43e1de2e5",
                        "source_entry_id": "53c81759-bf3d-3047-b925-5232b46aa401",
                        "source_sense_description": "растение",
                        "target_lang_word": "Alge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                        "entry_id": "3255859d-a2a6-3bb7-ae31-dbf1b6bffa98",
                                        "glosses": [
                                            "niedere, meist im Wasser lebende pflanzliche Organismen, als Einzeller oder als Mehrzeller organisiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e9e571-55ef-4c8d-bf73-32c701c3b66b",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "Algen werden eine große Bedeutung für die Ernährung der Menschheit erlangen."
                                            },
                                            {
                                                "example_id": "aaa99969-560f-42f6-b3ef-636c85c5e8ef",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "Im Badesee wachsen zu viele Algen, so dass er für dieses Jahr gesperrt bleibt."
                                            },
                                            {
                                                "example_id": "625aa0ef-6875-415e-82c5-d7af3bcd0f6e",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "„An regnerischen Tagen trug der Westwind den Geruch von Motorenöl, Algen und Laich, der sich im Herbst mit Kohl und Porree mischte, über den Damm und die Auen bis zum Kirchberg hinauf.“"
                                            },
                                            {
                                                "example_id": "d453d940-99b3-410d-818e-fd39fcbec5c7",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "„Der Pool war so stark mit Chlor versetzt worden, dass jetzt zwar alle Algen eliminiert waren, aber auch alle Haare der Badenden sich in Gestrüpp verwandelten.“"
                                            },
                                            {
                                                "example_id": "92a11f9c-08e6-4c2d-adf8-fe4034ac26f4",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "„Eine arme Witfrau gab ihm gleichwohl in einer Holzschale ein wenig Magermilch, eine Handvoll Algen sowie einen getrockneten Kabeljaukopf, den sie selber ihm abgepellt, denn er erinnerte sich plötzlich, daß er ein allzu großer Mann sei, um sich dazu herabzulassen, einen getrockneten Kabeljaukopf selber abzupellen.“"
                                            },
                                            {
                                                "example_id": "e2b1c279-988f-418e-9b04-6960e03d9fdc",
                                                "sense_id": "5f222a9c-5198-3114-a744-9c7c2762d0fb",
                                                "text": "„Ein paar hundert Schritt weiter hatte Harbert an einem Felsbrocken zwischen Tang und Algen eine Kolonie doppelschaliger Muscheln entdeckt, die wenigstens den gröbsten Hunger stillen konnten.“"
                                            }
                                        ],
