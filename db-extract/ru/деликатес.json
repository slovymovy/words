                                        "sense_id": "06d47868-1bc7-3004-aa04-d474ace4ff9b",
                                        "entry_id": "0e5433c6-a519-35a0-8381-eb5e73c646bb",
                                        "glosses": [
                                            "The quality of being delicate."
                                        ],
                                        "tags": [
