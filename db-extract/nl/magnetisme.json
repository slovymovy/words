                                    {
                                        "sense_id": "d64b55ae-527f-3d6f-a1d5-0236d2169d2b",
                                        "entry_id": "e2261aa2-4afc-3a60-931d-64eaccf29c80",
                                        "glosses": [
                                            "Gesamtheit der magnetischen Erscheinungen, ein fundamentales physikalisches Phänomen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec4dfa6-5ac3-4e0f-8baa-90ece7bb1c88",
                                                "sense_id": "d64b55ae-527f-3d6f-a1d5-0236d2169d2b",
                                                "text": "Der Magnetismus des Materials ist stabil. (Internet-Beleg)"
                                            },
                                            {
                                                "example_id": "dc905997-4801-40eb-af15-ff3e1ea1e1bf",
                                                "sense_id": "d64b55ae-527f-3d6f-a1d5-0236d2169d2b",
                                                "text": "„Dazu brauchte man keinen Magnetismus.“"
                                            },
                                            {
                                                "example_id": "7493defb-4c9d-4610-8497-490cdcc10aa7",
                                                "sense_id": "d64b55ae-527f-3d6f-a1d5-0236d2169d2b",
                                                "text": "„Ich weiß nicht, durch welchen Magnetismus sie angelockt worden waren, durch welche mystische Benachrichtigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27246695-ba4d-4010-aa40-b3cd204b7d98",
                        "source_entry_id": "31400954-2bb1-3087-ab3d-ebc6f730eab1",
                        "source_sense_id": "99dbe424-5a4b-3d5a-82a5-0ea177b8ae76",
                        "target_lang_word": "magnetism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnetism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3552b416-ace0-3702-b2a5-f6a032fba544",
                                        "entry_id": "518ef2d5-042a-30af-8905-66aa9a2ac719",
                                        "glosses": [
                                            "The property of being magnetic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca59adfc-c815-4642-8bc2-c224d663e3fe",
                                                "sense_id": "3552b416-ace0-3702-b2a5-f6a032fba544",
                                                "text": "Earth is surrounded by a magnetosphere — an invisible bubble of magnetism generated by the powerful churning of molten metals at Earth’s core."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c93069fd-3193-355f-bf8f-48acb330ee1e",
                                        "entry_id": "518ef2d5-042a-30af-8905-66aa9a2ac719",
                                        "glosses": [
                                            "The science which treats of magnetic phenomena."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5fef1ee-8818-3c54-b7f2-e36cd0a7d20f",
                                        "entry_id": "518ef2d5-042a-30af-8905-66aa9a2ac719",
                                        "glosses": [
                                            "Power of attraction; power to excite the feelings and to gain the affections."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15d06b96-fb27-3abf-b9a2-41144f9063dd",
                                        "entry_id": "518ef2d5-042a-30af-8905-66aa9a2ac719",
                                        "glosses": [
                                            "Animal magnetism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06a07001-a9a8-4de4-95d6-e25de07be2e5",
                                                "sense_id": "15d06b96-fb27-3abf-b9a2-41144f9063dd",
                                                "text": "Mediums [...] should also realise that it is essential to lead a particularly abstinent life, and to conserve their magnetism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97fcaaa1-8efd-4bd9-9ebe-336566cafcd5",
                        "source_entry_id": "31400954-2bb1-3087-ab3d-ebc6f730eab1",
                        "source_sense_id": "99dbe424-5a4b-3d5a-82a5-0ea177b8ae76",
                        "target_lang_word": "magnétisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magnétisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c36dd92e-2789-3827-bcf2-8a5451f6ee84",
                                        "entry_id": "20f91a68-0416-3413-8ab7-b8a4bef836f8",
                                        "glosses": [
                                            "Partie de la physique qui regroupe les propriétés des aimants et des champs magnétiques."
                                        ],
                                        "tags": [
                                            "Magnétisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8d5e505-da07-433e-abc1-6914159c3fdb",
                                                "sense_id": "c36dd92e-2789-3827-bcf2-8a5451f6ee84",
                                                "text": "Pendant l’absence de nos naturalistes, M. Idrac mena à bien ses mesures de magnétisme terrestre […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2c0befd-80b1-3ccf-908c-b687ca71bc0b",
                                        "entry_id": "20f91a68-0416-3413-8ab7-b8a4bef836f8",
                                        "glosses": [
                                            "Doctrine dont les partisans croient qu’on peut produire sur le corps humain, par des attouchements ou par des passes, des impressions propres à guérir les maladies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea12926a-9deb-406a-a8e9-3dbb644da0b0",
                                                "sense_id": "d2c0befd-80b1-3ccf-908c-b687ca71bc0b",
                                                "text": "Endormir quelqu’un par le magnétisme."
                                            },
                                            {
                                                "example_id": "37f74708-2294-4d56-ba77-e075695a2bb4",
                                                "sense_id": "d2c0befd-80b1-3ccf-908c-b687ca71bc0b",
                                                "text": "Il commença le lendemain même un ouvrage qu’il intitula Traité de la volonté ; ses réflexions en modifièrent souvent le plan et la méthode ; mais l’événement de cette journée solennelle en fut certes le germe, comme la sensation électrique toujours ressentie par Mesmer à l’approche d’un valet fut l’origine de ses découvertes en magnétisme, science jadis cachée au fond des mystères d’Isis, de Delphes, dans l’antre de Trophonius, et retrouvée par cet homme prodigieux à deux pas de Lavater, le précurseur de Gall."
                                            },
                                            {
                                                "example_id": "81951423-a742-4470-b84c-83c7f3fb973f",
                                                "sense_id": "d2c0befd-80b1-3ccf-908c-b687ca71bc0b",
                                                "text": "Nous verrons ce matin ce qu’est le magnétisme, qui sont les magnétiseurs, qui les consultent, que raconte le recours à ces pratiques sur notre société, qui semble de plus en plus accepter le magnétisme…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84408fe7-c7b5-355e-b72d-70e36ece2e30",
                                        "entry_id": "20f91a68-0416-3413-8ab7-b8a4bef836f8",
                                        "glosses": [
                                            "Ce qui semble produire un tel effet."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90a7916b-b94a-4300-9069-a930fe65ac6e",
                                                "sense_id": "84408fe7-c7b5-355e-b72d-70e36ece2e30",
                                                "text": "Quant aux convulsionnaires, c’étaient les fauteurs et les fauteuses, les aboyeurs et les miaulantes, les extatiques et les illuminés. L’hystérie, le magnétisme, le mal caduc, l’imitation, la fourberie, telles étaient les causes et l’origine des convulsions."
                                            },
                                            {
                                                "example_id": "143bdcc5-2747-4b05-b0be-fd2fd3498c8f",
                                                "sense_id": "84408fe7-c7b5-355e-b72d-70e36ece2e30",
                                                "text": "Un étrange magnétisme s’en dégageait, si chargé de sens pour moi […]"
                                            },
                                            {
                                                "example_id": "21bd5620-73bc-4bb9-b28b-f0a079bdc468",
                                                "sense_id": "84408fe7-c7b5-355e-b72d-70e36ece2e30",
                                                "text": "Cette présence était comme un serpent qui se lovait autour de moi et m’étouffait dans ses anneaux. Pourquoi avait-il ce magnétisme destructif ?."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
