                        "glosses": [
                            "Saler préalablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1660a696-0480-4158-a5b5-750be698ab47",
                                "sense_id": "c93fd8d7-0ffc-3d32-b313-5a50edd7d276",
                                "text": "C’est pourquoi il est bon, si cela est possible, de présaler le maigre, de prolonger l’égouttage du saucisson frais embossé (Braathen 1963), de ralentir l’étuvage qui ne doit plus être considéré que comme une phase de maturation et non plus de dessiccation."
                            },
                            {
                                "example_id": "ab7f0199-f232-433a-ba7e-72e5920e63f1",
                                "sense_id": "c93fd8d7-0ffc-3d32-b313-5a50edd7d276",
                                "text": "Elle n’aurait pas jeté un os à un pauvre, je parle de l’un des siens, et quand l’été venait, elle allait à la mer pour se présaler !"
                            }
                        ]
                    }
