                        "examples": [
                            {
                                "example_id": "b13adf99-a546-4af8-89ee-6a134a2d78b4",
                                "sense_id": "440517b3-9cf1-3576-abea-9166d680bfd7",
                                "text": "He took a sip of Coke and gurked loudly."
                            },
                            {
                                "example_id": "1c17215b-0571-426b-8828-1dee2e3f6da2",
                                "sense_id": "440517b3-9cf1-3576-abea-9166d680bfd7",
                                "text": "Graham gurked, and his gurk felt a bit full."
                            },
                            {
                                "example_id": "8c7a9678-3772-4ea4-ae19-2fec4a732f47",
                                "sense_id": "440517b3-9cf1-3576-abea-9166d680bfd7",
                                "text": "He is sipping the fizzy cold cola and has to bite down on the cup lip to keep from gurking. Sinks his buck teeth into the Styrofoam leaving horseshoe impressions he can see with the tip of his tongue."
                            }
                        ]
                    }
