                        "entry_id": "df2681ea-40ed-3d57-b3f3-fd59b656eb8a",
                        "glosses": [
                            "Eumétazoaire présentant une symétrie bilatérale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4bf71ed-437b-4151-bce5-b5da755faaa4",
                                "sense_id": "b387d08a-44bb-313f-8bd4-61392b12b276",
                                "text": "Nous sommes un deutérostomien comme le concombre de mer, un oursin granule et un bilatérien comme la mouche du vinaigre, un crabe, un escargot de bourgogne, mais aussi tous les insectes et mollusques !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
