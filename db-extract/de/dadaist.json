                ],
                "senses": [
                    {
                        "sense_id": "3b9e2526-ed68-35e3-88f1-8318d9aaf589",
                        "entry_id": "a67c6b1a-2956-3ae4-9634-18904bde4e25",
                        "glosses": [
                            "Vertreter des Dadaismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ee1422-77a5-4ec7-adb9-822909f48426",
                                "sense_id": "3b9e2526-ed68-35e3-88f1-8318d9aaf589",
                                "text": "„Die Dadaisten selbst erzählen mit großer Gewissenhaftigkeit jeder seinen Anteil an Dada mit jener Bescheidenheit, die niemals den Wesensinhalt dieser Bewegung ausmachte.“"
                            },
                            {
                                "example_id": "88c3a7da-cbf9-4673-a41b-653929f99248",
                                "sense_id": "3b9e2526-ed68-35e3-88f1-8318d9aaf589",
                                "text": "„Ganz fälschlich hat man den Dadaismus als eine künstlerisch oder eine philosophisch eindeutig definierbare Weltanschauung ausgegeben, während sich der echte Dadaist gerade dadurch von andern unterschied, daß er überhaupt keine hatte…“"
                            },
                            {
                                "example_id": "a66ad53e-9c1d-464b-917f-a3a899f80412",
                                "sense_id": "3b9e2526-ed68-35e3-88f1-8318d9aaf589",
                                "text": "„Das zweigeschossige Café stammte aus der Zeit vor dem ersten Weltkrieg, war das Künstlercafé der Dadaisten gewesen und hatte in allen Epochen Maler, Schriftsteller, Emigranten der beiden Weltkriege und der sie begleitenden Kunst- und Kulturrevolution beherbergt.“"
                            },
                            {
                                "example_id": "a7cc30ce-8592-435e-b7cf-cf81ac87d5ab",
                                "sense_id": "3b9e2526-ed68-35e3-88f1-8318d9aaf589",
                                "text": "„Er lernt spätestens 1915 die Dadaisten kennen und arbeitet mit ihnen zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c344aa2b-54e6-4232-b29f-369d94d532db",
                        "source_entry_id": "a67c6b1a-2956-3ae4-9634-18904bde4e25",
                        "source_sense_id": "3b9e2526-ed68-35e3-88f1-8318d9aaf589",
                        "source_sense_description": "Vertreter des Dadaismus",
                        "target_lang_word": "Dadaist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dadaist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb18fb0d-e1c4-3933-9236-ff8b6f0af15e",
                                        "entry_id": "1fa33f5e-7b3d-345d-ac3b-8fc0072f7b78",
                                        "glosses": [
                                            "An artist or writer who practiced Dada."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fb16d8b-2fee-4cab-b1ac-e1e246770106",
                                                "sense_id": "fb18fb0d-e1c4-3933-9236-ff8b6f0af15e",
                                                "text": "To the world at large, relativity seemed to pull the rug out from under perceived reality. And for many advanced thinkers of the 1920s, from Dadaists to Cubists to Freudians, that was a fitting credo, reflecting what science historian David Cassidy calls \"the incomprehensiveness of the contemporary scene--the fall of monarchies, the upheaval of the social order, indeed, all the turbulence of the 20th century.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Dadaist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f31aec6d-4a94-3ccf-8ea6-35cecd3976d0",
                                        "entry_id": "1cfd02e3-18db-35bd-b03a-cff345fe06c5",
                                        "glosses": [
                                            "In the style of Dada."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee8aead-ff3d-4913-8d34-86c00a5395f4",
                                                "sense_id": "f31aec6d-4a94-3ccf-8ea6-35cecd3976d0",
                                                "text": "Breton's Surrealist movement transformed Dadaist despair -- at both the war and the technologies that had led to it -- into a constructive assault on social and sexual norms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6309bc2-1c7f-4418-af17-62f8e2066aa5",
                        "source_entry_id": "a67c6b1a-2956-3ae4-9634-18904bde4e25",
                        "source_sense_id": "3b9e2526-ed68-35e3-88f1-8318d9aaf589",
                        "source_sense_description": "Vertreter des Dadaismus",
                        "target_lang_word": "dadaist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dadaist",
