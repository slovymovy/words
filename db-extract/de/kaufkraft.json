                        "cross_references": [
                            {
                                "target_word": "purchasing power",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1329df5b-f5cd-3ea9-a541-30abcce414d8",
                                        "entry_id": "9334972e-e9e3-32ae-a06c-9438c7faa021",
                                        "glosses": [
                                            "The amount of goods and services that can be bought with a unit of currency."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30b25abc-b4e6-4e89-badc-a4c1da05c132",
                                                "sense_id": "1329df5b-f5cd-3ea9-a541-30abcce414d8",
                                                "text": "The exchange rates do not always reflect true differences in the purchasing power of currencies."
                                            },
                                            {
                                                "example_id": "f6dc03de-9edb-4e64-81d9-7da552571dda",
                                                "sense_id": "1329df5b-f5cd-3ea9-a541-30abcce414d8",
                                                "text": "But poverty’s scourge is fiercest below $1.25 (the average of the 15 poorest countries’ own poverty lines, measured in 2005 dollars and adjusted for differences in purchasing power): people below that level live lives that are poor, nasty, brutish and short."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54a920c3-92ee-3141-b4ae-52aec3a30f93",
                                        "entry_id": "9334972e-e9e3-32ae-a06c-9438c7faa021",
                                        "glosses": [
                                            "The amount of goods and services that can be bought by consumers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
