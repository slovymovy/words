        "fr-extract.jsonl": [
            {
                "entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
                "word": "gentillesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ea0a119a-0c13-473b-9d44-e660e9e02646",
                        "entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
                        "tags": [
                            "plural"
                        ],
                        "form": "gentillesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ada4a935-135c-3d8e-9e00-21ab9f61db44",
                        "entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
                        "glosses": [
                            "Agrément accompagné de délicatesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54059b9b-44b0-40b3-b535-46cb7b252856",
                                "sense_id": "ada4a935-135c-3d8e-9e00-21ab9f61db44",
                                "text": "Galamment, il lui baisa la main et badina un instant avec gentillesse."
                            },
                            {
                                "example_id": "04368444-2138-46bc-bc5c-7037076cb32e",
                                "sense_id": "ada4a935-135c-3d8e-9e00-21ab9f61db44",
                                "text": "Cette gentillesse qui abrégeait les formes et supprimait les fadaises ridicules que tout garçon se croit tenu de débiter à la belle fille dont il essaie de faire sa maîtresse, m’avait séduit."
                            },
                            {
                                "example_id": "8078cbe7-17da-4a39-866a-47981b53bbf6",
                                "sense_id": "ada4a935-135c-3d8e-9e00-21ab9f61db44",
                                "text": "Pour nombre de Saujonnais, Jeannette Grenon restera cette monitrice d’auto-école, connue pour sa grande gentillesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "91b5708c-8129-3f7a-b4f5-74302b0ba9c3",
                        "entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
                        "glosses": [
                            "Tour de souplesse agréable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8794aa44-b17e-46e6-82e3-9855d12fcb6f",
                                "sense_id": "91b5708c-8129-3f7a-b4f5-74302b0ba9c3",
                                "text": "Il a dressé son chien à mille gentillesses."
                            }
                        ]
                    },
                    {
                        "sense_id": "5622ec67-cec7-33ff-8dbf-5096d5852ea7",
                        "entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
                        "glosses": [
                            "Saillies agréables, spirituelles."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "171c4e66-0339-48f6-ba3e-3ebebf853967",
                                "sense_id": "5622ec67-cec7-33ff-8dbf-5096d5852ea7",
                                "text": "Dire des gentillesses."
                            }
                        ]
                    },
                    {
                        "sense_id": "214f082a-a022-35b4-90fe-858d45b555f8",
                        "entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
                        "glosses": [
                            "Trait de mauvaise conduite, de malice, etc."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "c58a5644-bb35-485b-80bc-1ce400ecb0a3",
                                "sense_id": "214f082a-a022-35b4-90fe-858d45b555f8",
                                "text": "Il a fait là une gentillesse dont il pourrait bien se repentir. — Cette gentillesse est un peu forte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "700b4eba-fd20-4916-bc36-5e7b45daa250",
                        "source_entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
                        "source_sense_id": "ada4a935-135c-3d8e-9e00-21ab9f61db44",
                        "source_sense_description": "Agrément accompagné de délicatesse",
                        "target_lang_word": "Höflichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Höflichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                        "entry_id": "6f700349-8662-37c3-b31f-c344fc125d34",
                                        "glosses": [
                                            "distanzierte, formale Freundlichkeit; Respekt von einer Person zu einer anderen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d7d846-3340-44dc-b13f-b0f89170d6fe",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "Etwas mehr Höflichkeit wäre durchaus angebracht!"
                                            },
                                            {
                                                "example_id": "f3cf238b-91a2-4069-b825-27d0569fa5e1",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "„Eher aus Höflichkeit ging ich darauf ein, ich hatte den Eindruck, Ada wollte einfach etwas für mich tun, auch wenn sie fort war.“"
                                            },
                                            {
                                                "example_id": "ab1d97ec-bd69-4041-8b71-be4422ff4639",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "„Eigentlich haben es Reisende leichter, durch Höflichkeit aufzufallen.“"
                                            },
                                            {
                                                "example_id": "bf40df81-5ece-49af-8b15-f6b20c3aa4fa",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "„Höflichkeit und Taktgefühl spielen meistens eine Rolle dabei, wenn wir von der Wahrheit abweichen.“"
                                            },
                                            {
                                                "example_id": "46b2af3e-6988-4146-98f5-0cbe98841b66",
                                                "sense_id": "aa5e11f2-d9ca-37c1-ab46-865838c161bd",
                                                "text": "Unser alltägliches Verhalten auf dem Flur oder auf der Straße wird, wenn es gut geht, von erlernter Höflichkeit gesteuert, aber die darunter liegenden Strebungen, die Hintergedanken, gehörten in das Forschungsfeld von Sigmund Freud, und sie sind immer noch da."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "335656a6-378e-3589-baa0-c2dd543555e6",
                                        "entry_id": "6f700349-8662-37c3-b31f-c344fc125d34",
                                        "glosses": [
                                            "eine höfliche Geste oder Floskel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f151eeb5-59bd-466d-a5f2-0b6d4a798c2e",
                                                "sense_id": "335656a6-378e-3589-baa0-c2dd543555e6",
                                                "text": "Sie tauschten untereinander Höflichkeiten aus."
                                            },
                                            {
                                                "example_id": "d27f99bc-2fac-4fbf-8c2c-6a231341e57c",
                                                "sense_id": "335656a6-378e-3589-baa0-c2dd543555e6",
                                                "text": "„Nach diesen gegenseitigen Höflichkeiten verneigte sich die gesamte Priesterschar zu beiden Seiten und man bat, sich zur dreiräumigen Halle der äußeren Abtei zu begeben, die die Bezeichnung Saal der Föhren und Reiher führte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
