                ],
                "senses": [
                    {
                        "sense_id": "5f2f21ba-da02-3acf-9f52-2bb6e6296ef6",
                        "entry_id": "7df1f750-1024-354f-a9a0-7e037c24545a",
                        "glosses": [
                            "французское кондитерское изделие из яичных белков, сахара и молотого миндаля"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d394284-6353-499e-8501-903bb4550c20",
                        "source_entry_id": "7df1f750-1024-354f-a9a0-7e037c24545a",
                        "source_sense_id": "5f2f21ba-da02-3acf-9f52-2bb6e6296ef6",
                        "target_lang_word": "macaron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macaron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84d16d35-1235-389c-948b-d7c59e94e2ed",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Petite pâtisserie ronde, dans laquelle il entre principalement des amandes et du sucre."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f87bbc8a-b530-4072-ba18-cf1299d28394",
                                                "sense_id": "84d16d35-1235-389c-948b-d7c59e94e2ed",
                                                "text": "Bébé a voulu prendre des macarons chez Ladurée."
                                            },
                                            {
                                                "example_id": "698c6d7b-b653-4a8f-9fb7-61913cbd4e2b",
                                                "sense_id": "84d16d35-1235-389c-948b-d7c59e94e2ed",
                                                "text": "La séance thé a été parfaite. Maman avait fait les choses comme il faut : le service à thé offert par mamie avec des dorures et des papillons verts et roses, des macarons de chez Ladurée et, quand même, du sucre roux (un truc de gauche)."
                                            },
                                            {
                                                "example_id": "406ae60f-a8bb-4fd5-aa4f-c87f3a758384",
                                                "sense_id": "84d16d35-1235-389c-948b-d7c59e94e2ed",
                                                "text": "Et la vanille Bourbon, à la puissance aromatique enivrante, d’anoblir flans, macarons, riz au lait, tartes aux pommes, gaufres, crèmes pâtissières et autres vanillades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d53df5b-cc2b-3105-a8b1-821319f200ec",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Macaron de Montmorillon : Petite pâtisserie ronde à base d'amande et d'amande amère, spécialité de la ville de Montmorillon dans la Vienne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0990f3bd-e50c-3958-9263-96cbf9dda6e4",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Macaron de Saint-Émilion : Petite pâtisserie semblable aux macarons de Montmorillon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "155ce504-8e41-3eaa-9b0a-354470bb73eb",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Macaron de Cormery : Petite pâtisserie en forme de couronne à base d'amande et de blanc d'œuf, spécialité de la ville de Cormery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "421c5cff-9516-397a-b076-db84f360bb04",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Macaron de Joyeuse : Petit gâteau sec à base d'amande et de noisette, spécialité de la ville de Joyeuse en Ardèche."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb8a5603-0820-3412-a668-042780ac717c",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Petit gâteau au blanc d’œuf, au sucre et à la noix de coco. Rocher coco, congolais."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a31cbd2-4723-3273-be32-2174511881ad",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Insigne de forme arrondie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1fbb423-6b11-48c0-b859-51bf945fbbf3",
                                                "sense_id": "7a31cbd2-4723-3273-be32-2174511881ad",
                                                "text": "A l'occasion du Championnat du Monde, la F.F.H.B. a adopté l'emblème ci-contre pour marquer cet événement exceptionnel. Il a été produit à plusieurs milliers d'exemplaires sous forme de macarons auto-collants et de cendriers."
                                            },
                                            {
                                                "example_id": "d78d6b4c-c806-409b-950d-80c81d1cbc02",
                                                "sense_id": "7a31cbd2-4723-3273-be32-2174511881ad",
                                                "text": "Les mœurs d'avant 39 n'étaient pas telles qu'il fût permis de se mêler aux tire-laine, à moins qu'ils ne fissent le métier sur une certaine échelle et nantis d'un ruban sinon d'un macaron dans l'ordre national de la Légion d'Honneur"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b69f2fd-b41e-3547-b2f9-5e626a9445c8",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Ornement rond, rosette, badge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972b9207-34fa-43f6-bda8-cb38840983c8",
                                                "sense_id": "9b69f2fd-b41e-3547-b2f9-5e626a9445c8",
                                                "text": "L'exubérance florale du macaron de la voûte de la chapelle Saint-Pierre est apparentée à celle de la sculpture des chapelles du déambulatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a522e628-0521-3ceb-8da6-d45a1100e0ba",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Dans les fortifications françaises de la Première Guerre mondiale, fortin détaché, isolé, sans aucune communication avec les autres ouvrages de défense du système fortifié dont il fait partie, ni avec l’arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf1849f1-397b-4a21-9212-4af10070dfe8",
                                                "sense_id": "a522e628-0521-3ceb-8da6-d45a1100e0ba",
                                                "text": "M. Viollette fit ensuite le procès de la dernière découverte de l’état-major : le système des macarons fermés.\n« C’est ce système qui a servi de base à la défense de Verdun. Or, ce système des îlots fermés, sans boyaux de communication, sans moyens de communication à l’arrière, a condamné, de la façon la plus fatale, tous les hommes qui l’occupaient à être faits prisonniers ! Et ceci explique pourquoi, dans l’énoncé des pertes de Verdun, je trouve 69 000 disparus !…\nM. le marquis de la Ferronnays. – Depuis l’Artois, les macarons sont condamnés. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da504693-3674-30e5-9ea9-e4ad0fa48362",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Forme de coiffure féminine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d95fccf-f88a-4a8e-a9db-0554b83a945f",
                                                "sense_id": "da504693-3674-30e5-9ea9-e4ad0fa48362",
                                                "text": "2 octobre 42 – Elle a la coiffure que j’aime le moins au monde : un macaron marron et natté qui lui tourne autour de la tête. C’est une coiffure courageuse, qui sèche les traits et que choisissent généralement des femmes déjà sèches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b65f973-ce22-3c91-bb7c-c5b94e54d1aa",
                                        "entry_id": "feef41c2-e2f8-387a-92d4-4d172d9481c4",
                                        "glosses": [
                                            "Roue de manœuvre du gouvernail ; barre à roue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d8d26fc-de6c-4721-b278-471dbe8d17d7",
                                                "sense_id": "5b65f973-ce22-3c91-bb7c-c5b94e54d1aa",
                                                "text": "Toutefois, une observation est à faire en ce qui concerne les vapeurs dont le gouvernail est actionné par une roue désignée sous le nom de macaron et sur laquelle agit le pilote. Dans certains bateaux, quand on appuie sur le macaron, le bateau oriente du même côté ; mais il existe d'autres bateaux dans lesquels la même cause produit un effet contraire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
