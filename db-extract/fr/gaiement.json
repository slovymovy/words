        "fr-extract.jsonl": [
            {
                "entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                "word": "gaiement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "596374c8-e1ac-4c7b-9de5-ee697f449463",
                        "entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                        "tags": [],
                        "form": "gaîment"
                    },
                    {
                        "form_id": "9320341f-ec01-41ae-827e-ea3a7abb825d",
                        "entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "gaiment"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "746b8040-f387-3ebe-823d-a1ec89504095",
                        "entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                        "glosses": [
                            "D’une manière gaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "641e4e88-5c73-4dda-bd79-562499de1f57",
                                "sense_id": "746b8040-f387-3ebe-823d-a1ec89504095",
                                "text": "Et nous nous promenons là tout gaiement, jusqu'à la route qui descend vers le canal […]"
                            },
                            {
                                "example_id": "ba05437b-0809-4c26-81a0-0cd14a0feb8f",
                                "sense_id": "746b8040-f387-3ebe-823d-a1ec89504095",
                                "text": "Voilà l'image de ma vie :je devrais fredonner gaiement sous la douche, tout à la joie de ce jour nouveau, et je m'engonce dans l’amère moiteur de maussades ruminements."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f375998-10f7-3d0b-becd-36a81232ac99",
                        "entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                        "glosses": [
                            "Rapidement, d'un bon train."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "04b98bd5-52c8-4971-a792-a1b3ba93f483",
                                "sense_id": "7f375998-10f7-3d0b-becd-36a81232ac99",
                                "text": "Aller gaiement : Aller son train."
                            },
                            {
                                "example_id": "f2a7a3cf-3a9f-4f54-8b84-670fe56d7974",
                                "sense_id": "7f375998-10f7-3d0b-becd-36a81232ac99",
                                "text": "Allez-y gaiement ! Que l’orbe d’argent\nCroisse sur vos fronts son reflet changeant ;\nBien avant dans la nuit, à la Saint-Jean\nDansez la villanelle !"
                            },
                            {
                                "example_id": "31c1bac9-f97f-40be-9558-fbfcc5440040",
                                "sense_id": "7f375998-10f7-3d0b-becd-36a81232ac99",
                                "text": "Tout cela nous avait même paru un bizarre assemblage de choses : un village d’Algérie, une soirée d’hiver très froide, et une pauvre noce campagnarde défilant gaiement en musique, au crépuscule, devant des Bédouins et des chameaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e80e5aa2-1fe6-45c7-8824-714a87dc2c36",
                        "source_entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                        "target_lang_word": "lively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6099874a-f454-3ebe-b1cb-bac946c0b61e",
                                        "entry_id": "2bed3e33-6c0c-3e1f-bf07-d04df526ef98",
                                        "glosses": [
                                            "Full of life; energetic, vivacious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7891f2-d88b-431f-a009-b6685284e316",
                                                "sense_id": "6099874a-f454-3ebe-b1cb-bac946c0b61e",
                                                "text": "But wherefore comes old Manoa in such haſt, / With youthful ſteps? much livelier then e're while / He ſeems."
                                            },
                                            {
                                                "example_id": "a1e58d4e-4df3-4771-8930-fc0a43f1e84b",
                                                "sense_id": "6099874a-f454-3ebe-b1cb-bac946c0b61e",
                                                "text": "[...] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of railway viaducts, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            },
                                            {
                                                "example_id": "41fc4f77-ee9d-4344-8e3d-6fbb7a850332",
                                                "sense_id": "6099874a-f454-3ebe-b1cb-bac946c0b61e",
                                                "text": "Since sick people were apt to be present, he could not always depend on a lively young crowd in the same ward with him, and the entertainment was not always good."
                                            },
                                            {
                                                "example_id": "02da16ae-aa58-4510-8980-bb1e8dcfd594",
                                                "sense_id": "6099874a-f454-3ebe-b1cb-bac946c0b61e",
                                                "text": "But with the lively [Giovani] Dos Santos pulling the strings behind strikers [Roman] Pavlyuchenko and [Jermain] Defoe, Spurs controlled the first half without finding the breakthrough their dominance deserved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99b6322a-5d53-3601-9365-afd4e82d1b79",
                                        "entry_id": "2bed3e33-6c0c-3e1f-bf07-d04df526ef98",
                                        "glosses": [
                                            "Bright, glowing, vivid; strong, vigorous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2070d39a-eb83-40ac-ac6a-9d466a3dd8fa",
                                                "sense_id": "99b6322a-5d53-3601-9365-afd4e82d1b79",
                                                "text": "The colours of the prism are manifestly more full, intense, and lively that those of natural bodies."
                                            },
                                            {
                                                "example_id": "ea1906ec-d766-4850-9d03-b513f7cd418a",
                                                "sense_id": "99b6322a-5d53-3601-9365-afd4e82d1b79",
                                                "text": "His faith must be not only living, but lively too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "243e164b-7b2d-3eae-abca-9b01e59b78fb",
                                        "entry_id": "2bed3e33-6c0c-3e1f-bf07-d04df526ef98",
                                        "glosses": [
                                            "Endowed with or manifesting life; living."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b88f176a-dcbc-404c-837d-48eece4288c4",
                                                "sense_id": "243e164b-7b2d-3eae-abca-9b01e59b78fb",
                                                "text": "c. 1600, Philemon Holland\nchaplets of gold and silver resembling lively flowers and leaves"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4138a22-b3a5-3ba4-b70c-10e048a49d53",
                                        "entry_id": "2bed3e33-6c0c-3e1f-bf07-d04df526ef98",
                                        "glosses": [
                                            "Representing life; lifelike."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8d04d7c-449c-4a18-af99-d160fb12fba4",
                                                "sense_id": "d4138a22-b3a5-3ba4-b70c-10e048a49d53",
                                                "text": "I spied the lively picture of my father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ef5bf24-724d-32e5-84cc-96f4592de655",
                                        "entry_id": "2bed3e33-6c0c-3e1f-bf07-d04df526ef98",
                                        "glosses": [
                                            "Airy; animated; spirited."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b81fe85f-f2e8-4cf8-b446-012e390a70a7",
                                                "sense_id": "1ef5bf24-724d-32e5-84cc-96f4592de655",
                                                "text": "From grave to gay, from lively to ſevere, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d614b53e-1f83-3ff7-a135-856652d56095",
                                        "entry_id": "2bed3e33-6c0c-3e1f-bf07-d04df526ef98",
                                        "glosses": [
                                            "Fizzy; foamy; tending to produce a large head in the glass."
                                        ],
                                        "tags": [
                                            "of beer"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4605040e-e70e-3fe2-8712-a29d7c16b4ee",
                                        "entry_id": "07a1169b-cb02-36d0-934f-4da87a7886f9",
                                        "glosses": [
                                            "Term of address."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bad08e31-d3d5-4427-9a8c-b71646815925",
                                                "sense_id": "4605040e-e70e-3fe2-8712-a29d7c16b4ee",
                                                "text": "Speak the word, my livelies, and I'll pilot her in."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b069c69a-7d8b-3007-b791-a5af6c943d0a",
                                        "entry_id": "146db809-ee9a-3859-a33c-d4d01e08c12d",
                                        "glosses": [
                                            "Vigorously."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba251c30-7d13-3955-bb00-029e48b83598",
                                        "entry_id": "146db809-ee9a-3859-a33c-d4d01e08c12d",
                                        "glosses": [
                                            "Vibrantly, vividly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc162032-3192-3ae3-b3bc-08903228c7e1",
                                        "entry_id": "146db809-ee9a-3859-a33c-d4d01e08c12d",
                                        "glosses": [
                                            "In a lifelike manner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2bc41e-6590-4930-bd87-308b134c0878",
                                                "sense_id": "bc162032-3192-3ae3-b3bc-08903228c7e1",
                                                "text": "Him to a dainty flowre she did transmew, / Which in that cloth was wrought, as if it liuely grew."
                                            },
                                            {
                                                "example_id": "ac9f5433-0a35-4ee9-93f7-dc6cbb60b0db",
                                                "sense_id": "bc162032-3192-3ae3-b3bc-08903228c7e1",
                                                "text": "the Painter Protogenes […] having perfected the image of a wearie and panting dog, […] but being unable, as he desired, lively to represent the drivel or slaver of his mouth, vexed against his owne worke, took his spunge, and moist as it was with divers colours, threw it at the picture […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c92e591f-bbcf-46be-917f-fcafbb34cd0d",
                        "source_entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                        "target_lang_word": "merrily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "merrily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8fdb002a-6d33-312d-a758-dce7c0bec2c5",
                                        "entry_id": "4320378a-29f8-361a-a4eb-326edb55c71e",
                                        "glosses": [
                                            "In a cheerful or merry way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ab30789-b84c-4a8f-a9a0-68943b899c72",
                                                "sense_id": "8fdb002a-6d33-312d-a758-dce7c0bec2c5",
                                                "text": "So quickly the poore mans ſubſtance is ſpent,\nBut merrily with the world it went,\nVVhen men eat berries of the hauthorne tree, […]\nAnd old men knew not vſurie:\nNow tis come to a wofull paſſe, […]"
                                            },
                                            {
                                                "example_id": "03ccccb1-b07b-47b7-82e1-83a44ca81c2c",
                                                "sense_id": "8fdb002a-6d33-312d-a758-dce7c0bec2c5",
                                                "text": "Ariell:\nWhere the Bee ſucks, there ſuck I,\nIn a Cowslips bell, I lie,\nThere I cowch when Owles doe crie,\nOn the Batts backe I doe flie\n  after Sommer merrily.\nMerrily, merrily, ſhall I liue now\nVnder the bloſſom that hangs on the Bow."
                                            },
                                            {
                                                "example_id": "63977960-5cfa-46e1-bfce-2792105a371d",
                                                "sense_id": "8fdb002a-6d33-312d-a758-dce7c0bec2c5",
                                                "text": "Then Heidi would sit down and chatter merrily away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d2581b1-266d-48c5-a76c-58f484f10bc4",
                        "source_entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                        "target_lang_word": "cheerfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheerfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c710f63-92b7-3f95-8bb8-97578e15f304",
                                        "entry_id": "51ad7a16-789d-37c1-9ad1-56da67663115",
                                        "glosses": [
                                            "In a cheerful manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f61161b-ffb3-4299-b371-41e5a18570fc",
                                                "sense_id": "1c710f63-92b7-3f95-8bb8-97578e15f304",
                                                "text": "That principle carried out consistently and logically, makes the individual not a claimant upon society, but a benefiter of it. He contributes whatever talent, natural or acquired, he may have, cheerfully to the promotion of the common good, […]"
                                            },
                                            {
                                                "example_id": "e0b4e27f-2e93-473e-87d4-0d64cd5a195c",
                                                "sense_id": "1c710f63-92b7-3f95-8bb8-97578e15f304",
                                                "text": "'Well, what have you done this time?' asked Sebastian cheerfully."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88951e53-75aa-4d2f-b38e-a74e804e3cb3",
                        "source_entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                        "target_lang_word": "gayly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gayly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2629098b-3fd1-32a3-af57-604cd524dcbf",
                                        "entry_id": "128070e0-fe1c-3a02-a4b9-319dc5bbe08d",
                                        "glosses": [
                                            "Cheerfully; in a gay manner."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ab63df-88e6-4ed5-83ea-942428aeb621",
                                                "sense_id": "2629098b-3fd1-32a3-af57-604cd524dcbf",
                                                "text": "Gayly to bourgeon and broadly to grow."
                                            },
                                            {
                                                "example_id": "0d931288-c9d4-41c9-b3d0-493599271722",
                                                "sense_id": "2629098b-3fd1-32a3-af57-604cd524dcbf",
                                                "text": "He was much over-dressed, in a gaudy vest of many colors, a blue neckerchief, bedropped gayly with yellow spots, and arranged with a flaunting tie, quite in keeping with the general air of the man."
                                            },
                                            {
                                                "example_id": "7640a8a3-1687-40e4-950c-d9ffe9c5838b",
                                                "sense_id": "2629098b-3fd1-32a3-af57-604cd524dcbf",
                                                "text": "In the lightness of my heart I sang catches of songs as my horse gayly bore me along the well-remembered road."
                                            },
                                            {
                                                "example_id": "20ad3839-b172-46c7-8e76-eefbe0451b95",
                                                "sense_id": "2629098b-3fd1-32a3-af57-604cd524dcbf",
                                                "text": "Gayly-dressed mavournins and blaring bands stepped lively along Fifth Avenue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5d70445-3015-44c0-8622-55b2956812fb",
                        "source_entry_id": "1200bf09-b26a-31d2-91d4-82b069e14d05",
                        "target_lang_word": "gaily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
