        "fr-extract.jsonl": [
            {
                "entry_id": "46ce4fce-f249-3a37-af06-39f4c25ff802",
                "word": "revirement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "80b9df27-e4a9-47ad-af15-fba6f75ec4a8",
                        "entry_id": "46ce4fce-f249-3a37-af06-39f4c25ff802",
                        "tags": [
                            "plural"
                        ],
                        "form": "revirements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fb42af9-f2d3-3864-9706-64b6007b3acc",
                        "entry_id": "46ce4fce-f249-3a37-af06-39f4c25ff802",
                        "glosses": [
                            "Action de se retourner en sens contraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3df9e933-098e-4ce5-a598-0abdfeae19d8",
                                "sense_id": "6fb42af9-f2d3-3864-9706-64b6007b3acc",
                                "text": "Le navire opéra un brusque revirement."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f2a5b8b-2d1e-381d-a727-5cb2a3fad2de",
                        "entry_id": "46ce4fce-f249-3a37-af06-39f4c25ff802",
                        "glosses": [
                            "Changement brusque et total qui survient dans l’opinion, dans la conduite d’un homme, d’un parti, d’un peuple."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "996b8aa8-1881-4ebc-beac-53faaf806acd",
                                "sense_id": "5f2a5b8b-2d1e-381d-a727-5cb2a3fad2de",
                                "text": "Le revirement d’Enzo Le Fée, qui voulait quitter la Bretagne cet été avant la nomination de Régis Le Bris, illustre cela."
                            },
                            {
                                "example_id": "d2982d95-d286-44bc-a62d-ef7b95cd9a1d",
                                "sense_id": "5f2a5b8b-2d1e-381d-a727-5cb2a3fad2de",
                                "text": "Privé de tout accommodement, […], le vice a peu de chance de séduire la vertu la plus chancelante. Elle s'en détourne avec horreur et trouve soudain dans cet instinctif revirement son équilibre et son salut."
                            },
                            {
                                "example_id": "07435cb4-7ab1-4460-8133-038cf9dee10e",
                                "sense_id": "5f2a5b8b-2d1e-381d-a727-5cb2a3fad2de",
                                "text": "[…], Mouley Hafid changea d’attitude à son égard. Il se manifesta chez lui un revirement complet correspondant à une crise de mysticisme ou de xénophobie."
                            },
                            {
                                "example_id": "07cf75e4-b040-454e-b2e6-fd7dd9efa503",
                                "sense_id": "5f2a5b8b-2d1e-381d-a727-5cb2a3fad2de",
                                "text": "Au contraire, il a plutôt indiqué qu’à moins d’un revirement, le MSSS pourrait se voir obligé de demander aux établissements de santé de se délester de 70 % des activités régulières des blocs opératoires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22d94539-9680-4265-b5fa-160f1df5cc59",
                        "source_entry_id": "46ce4fce-f249-3a37-af06-39f4c25ff802",
                        "target_lang_word": "change of heart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "change of heart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a804714d-f3de-3847-ba76-cd8553b8b511",
                                        "entry_id": "92015f04-1b07-3f14-ad54-578096f35f27",
                                        "glosses": [
                                            "A change of one's opinion, belief or decision."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79a19612-593f-476c-917b-92d4df26d8fd",
                                                "sense_id": "a804714d-f3de-3847-ba76-cd8553b8b511",
                                                "text": "He quit work on Friday, but on Monday he had a change of heart and decided to come back."
                                            },
                                            {
                                                "example_id": "d74dd6fa-3b02-4118-ad8e-57e5f671672e",
                                                "sense_id": "a804714d-f3de-3847-ba76-cd8553b8b511",
                                                "text": "We can go out driving on Slow Hand Row / We could stay inside and play games, I don't know / And you could have a change of heart"
                                            },
                                            {
                                                "example_id": "d9fee40b-305f-42d7-9423-2ff3a35bb2b4",
                                                "sense_id": "a804714d-f3de-3847-ba76-cd8553b8b511",
                                                "text": "\"I thought you were loyal to the cause, Paul.\"\n“I was,” Grayson answered. “Then I saw the kind of people who share your vision, and I had a change of heart.”"
                                            },
                                            {
                                                "example_id": "3bdcbb1e-2ebc-4825-b1f0-c84c948ec9ed",
                                                "sense_id": "a804714d-f3de-3847-ba76-cd8553b8b511",
                                                "text": "The Keswick-Carlisle, Bury-Rawtenstall, Watford-Croxley Green and Haltwhistle-Alston services had run out of friends, but the hit-listed Oldham-Rochdale and Inverness-Kyle of Lochalsh lines would benefit from a change of heart."
                                            },
                                            {
                                                "example_id": "ee24c69e-9ff7-456d-9730-81c2f804b066",
                                                "sense_id": "a804714d-f3de-3847-ba76-cd8553b8b511",
                                                "text": "Unfortunately, in 1979 Lipburger was convicted of erecting unapproved street signs and jailed for ten weeks. Following a change of heart, the government later invited Lipburger to move his construction to Vienna’s Prater Park, where it still sits today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a59756e-c81d-4649-b7df-a0ad8fdf46a1",
                        "source_entry_id": "46ce4fce-f249-3a37-af06-39f4c25ff802",
                        "target_lang_word": "change of tack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "change of tack",
                                "target_lang_code": "en",
