                        "entry_id": "b8390942-aa29-3187-9479-139651159859",
                        "glosses": [
                            "öffentlich zugängliche Einrichtung, in der staatlich konzessioniertes Glücksspiel betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8af8f9d5-b1f7-494c-a1e0-94a4fad5bee1",
                                "sense_id": "238f1670-8051-39d0-9e51-67ee76cce0e5",
                                "text": "Diese Spielbank darf nur in Abendgarderobe betreten werden."
                            },
                            {
                                "example_id": "e460f097-74e7-4ff7-9103-f36e6bce1705",
                                "sense_id": "238f1670-8051-39d0-9e51-67ee76cce0e5",
                                "text": "„Im Freien türmten sich die kostbaren Möbel des Kurhauses und der Spielbank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01ae8e58-6af2-4b0b-9e95-b63f4bcf5a54",
                        "source_entry_id": "b8390942-aa29-3187-9479-139651159859",
                        "source_sense_id": "238f1670-8051-39d0-9e51-67ee76cce0e5",
                        "source_sense_description": "öffentlich zugängliche Einrichtung, in der staatlich konzessioniertes Glücksspiel betrieben wird",
                        "target_lang_word": "casino",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "A public building or room for gambling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee64af84-aa6f-4a12-ac93-1c3b4caf68f2",
                                                "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                                                "text": "He went to the casino every night till 1:00 am."
                                            },
                                            {
                                                "example_id": "3d0712a6-c9dc-4c1d-86af-cb68f9876dae",
                                                "sense_id": "c6e5b652-13b9-34bf-b49e-ec98185df7b3",
                                                "text": "A bid by Donald Trump to build Sydney’s first casino was rejected 30 years ago after police expressed concerns about his links to the mafia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "A small house; a pleasure house or holiday home, especially in Italy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5131f7-55fb-4da7-9328-f7448eba1132",
                                                "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                                                "text": "Quirini [was] knowing in the belles Lettres, & highly skilled in making his Casino comfortable to all the Wits & Blues as we now call them in London."
                                            },
                                            {
                                                "example_id": "498446dc-833c-43a9-9d09-c8bd957e0cb4",
                                                "sense_id": "03682429-a314-372a-816f-f271df526d8a",
                                                "text": "I felt it strange, and regretted it, that so amiable a man should have contracted such dissolute habits, and at this very time, instead of living respectably with his charming Countess, had Baccelli, the superannuated dancing courtesan, in a casino in the neighbourhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72f7f3dd-5ceb-3764-bbdb-bc3b29f45f2c",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "A certain Italian card game for two to four players."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f9c9d79-956d-3782-a7c3-9bd8da0c0d70",
                                        "entry_id": "3843484f-0718-3eec-b695-4682b6d3e15b",
                                        "glosses": [
                                            "Any of certain cards with special meanings in this game."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b3fd47a-16fe-43b8-b5b8-5a18a571aeb8",
                        "source_entry_id": "b8390942-aa29-3187-9479-139651159859",
                        "source_sense_id": "238f1670-8051-39d0-9e51-67ee76cce0e5",
                        "source_sense_description": "öffentlich zugängliche Einrichtung, in der staatlich konzessioniertes Glücksspiel betrieben wird",
                        "target_lang_word": "casino",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casino",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a79967aa-e935-3e3a-b407-8bf3aa1e1ce4",
                                        "entry_id": "c83a8987-f71a-34c7-b848-b47f82955813",
                                        "glosses": [
                                            "Établissement de jeu, de lecture, de conversation, etc., avec ou sans théâtre, qui se trouve dans les stations balnéaires ou thermales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6709c6-b00b-421a-bd93-eea69bec6d4c",
                                                "sense_id": "a79967aa-e935-3e3a-b407-8bf3aa1e1ce4",
                                                "text": "Cette hypothèse paraît vraisemblable si l’on vient à songer […] qu’avant d’y arriver, les curieux reconnaissent, çà et là, plus d’un casino dont l’intérieur et le décor trahissent les spirituelles débauches de nos aïeux."
                                            },
                                            {
                                                "example_id": "44158887-d417-4883-9443-896d65289530",
                                                "sense_id": "a79967aa-e935-3e3a-b407-8bf3aa1e1ce4",
                                                "text": "Devant l’église, de petits groupes papotants se formèrent et presque tout le monde dévala par une ruelle poussiéreuse étouffée entre une grande prairie et des villas isolées, vers l’un des petits casinos du village, rendez-vous du dimanche matin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "365097c0-a23e-3618-956e-318cbd7db8f6",
                                        "entry_id": "c83a8987-f71a-34c7-b848-b47f82955813",
                                        "glosses": [
                                            "Établissement de jeu de hasard."
                                        ],
                                        "tags": [
                                            "Aujourd’hui"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b345e3b5-8f9e-493a-ab27-e9791081e2df",
                                                "sense_id": "365097c0-a23e-3618-956e-318cbd7db8f6",
                                                "text": "Les casinos ne sont que de gigantesques pièges, vers lesquels le client riche est rabattu, d’abord par le snobisme, ensuite par la publicité du mercantilisme de l’élégance, et enfin par des agents ou des agentes, subtils et caressants."
                                            },
                                            {
                                                "example_id": "b1a8d61a-2817-4f79-b3e5-643a2bfaa821",
                                                "sense_id": "365097c0-a23e-3618-956e-318cbd7db8f6",
                                                "text": "Il n’avais jamais compris pourquoi tous ces gens, dans les casinos, restaient longtemps autour des tables, silencieux, immobiles, avec leurs têtes de morts-vivants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b59da6f2-e0a7-3690-b8fd-63b0922b1487",
                                        "entry_id": "c83a8987-f71a-34c7-b848-b47f82955813",
                                        "glosses": [
                                            "Jeu des financiers, qui boursicotent, au lieu de financer l’investissement économique productif."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "668ee9bc-a889-452e-ba49-bdb69a57787c",
                                                "sense_id": "b59da6f2-e0a7-3690-b8fd-63b0922b1487",
                                                "text": "Or, après trois décennies d’hégémonie idéologique néolibérale et de pari sur la main invisible du marché, les retombées délétères du capitalisme de casino et l’effilochage du lien social qu’il entraine semble redonner, […], une nouvelle actualité à ce souci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
