                "senses": [
                    {
                        "sense_id": "dff28628-2717-3cac-8cd2-06f9381074f0",
                        "entry_id": "411fe011-72ca-3a86-b4ad-a506ee53cacc",
                        "glosses": [
                            "bepaald soort roofvogel die in kustgebieden leeft, Haliaeetus albicilla, de grootste Europese arend"
                        ],
                        "tags": [
                            "havikachtigen"
                        ],
                        "examples": [
                            {
                                "example_id": "78768cb6-87e5-414d-8411-c3425d90ae7c",
                                "sense_id": "dff28628-2717-3cac-8cd2-06f9381074f0",
                                "text": "De zeearend heeft zich in de laatste jaren weer als broedvogel in Nederland gevestigd."
                            },
                            {
                                "example_id": "adce88be-0459-4857-b05b-8852c242af50",
                                "sense_id": "dff28628-2717-3cac-8cd2-06f9381074f0",
                                "text": "Lena zat op de bank onder een groot schilderij van Bruno Liljefors, een zeearend die op een sneeuwhaas joeg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98e29f23-456d-4ccb-a44c-3b939f5cece3",
                        "source_entry_id": "411fe011-72ca-3a86-b4ad-a506ee53cacc",
                        "source_sense_id": "dff28628-2717-3cac-8cd2-06f9381074f0",
                        "source_sense_description": "bepaald soort roofvogel die in kustgebieden leeft, Haliaeetus albicilla",
                        "target_lang_word": "Seeadler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seeadler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de741c06-0c15-3e2d-ba9e-6e6ebdf59d73",
                                        "entry_id": "ab4d3573-3612-3e97-81e8-feed9c2b4a82",
                                        "glosses": [
                                            "großer Greifvogel aus der Gattung Haliaeetus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e77fa38-cd48-48d9-a142-c4a9062593ee",
                                                "sense_id": "de741c06-0c15-3e2d-ba9e-6e6ebdf59d73",
                                                "text": "Seeadler sind beeindruckende Vögel."
                                            },
                                            {
                                                "example_id": "089ec714-57a2-49c3-984f-5345f175e979",
                                                "sense_id": "de741c06-0c15-3e2d-ba9e-6e6ebdf59d73",
                                                "text": "„Darß und Zingst sind Brutheimat des Seeadlers; zahlreiche See- und Küstenvögel brüten auf den Inseln Oie und Kirr, auf den Bülten, den Wiesen und großen Vogelschutzgebieten Hiddensees.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb16b923-6c2a-3973-8a44-b386e6bcf6e5",
                                        "entry_id": "ab4d3573-3612-3e97-81e8-feed9c2b4a82",
                                        "glosses": [
                                            "speziell der einheimische Haliaeetus albicilla"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86852488-a48b-4a23-9c4f-4047bafeea46",
                                                "sense_id": "bb16b923-6c2a-3973-8a44-b386e6bcf6e5",
                                                "text": "Der Seeadler ist auch der Wappenvogel Deutschlands."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23dbac81-1229-4c27-897f-ee38dacedb9b",
                        "source_entry_id": "411fe011-72ca-3a86-b4ad-a506ee53cacc",
                        "source_sense_id": "dff28628-2717-3cac-8cd2-06f9381074f0",
                        "source_sense_description": "bepaald soort roofvogel die in kustgebieden leeft, Haliaeetus albicilla",
                        "target_lang_word": "sea eagle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sea eagle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d03387aa-998a-3a83-b69f-24f04f3b774e",
                                        "entry_id": "dfbd8721-7fc4-3976-97f1-8e645ba8de50",
                                        "glosses": [
                                            "An eagle with a distinctive white tail; specifically, a white-tailed eagle (Haliaeetus albicilla)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08bf9007-3308-40a8-ad9d-0b6a9df7f8b8",
                                                "sense_id": "d03387aa-998a-3a83-b69f-24f04f3b774e",
                                                "text": "His face is wild and keen like a sea-eagle’s, and from his bristling brows the eyes dart glances sharp as a glancing spear."
                                            },
                                            {
                                                "example_id": "b7f9c4bd-fdd0-460e-855d-4d1faba7ebbb",
                                                "sense_id": "d03387aa-998a-3a83-b69f-24f04f3b774e",
                                                "text": "\"Up on Rannoch Moor, we often see Sea Eagles,\" she says, although in the rain, there is no sign of them today. \"If we hit a deer, that's their lunch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1718e60-0bd4-39b4-9375-833af0104b0f",
                                        "entry_id": "dfbd8721-7fc4-3976-97f1-8e645ba8de50",
                                        "glosses": [
                                            "A genus of eagles (genus Haliaeetus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
