            {
                "entry_id": "50228574-b0b8-3fd2-a921-4fff282883a8",
                "word": "Roncier",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3101068b-ebff-3449-bf43-ae0a4b2a7525",
                        "entry_id": "50228574-b0b8-3fd2-a921-4fff282883a8",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fcb639e-d105-4fd7-b642-95ea8f742af3",
                                "sense_id": "3101068b-ebff-3449-bf43-ae0a4b2a7525",
                                "text": "Rendez-vous muni de votre référence client du service de l’eau indiquée sur votre facture Suez et votre compte client à la mairie de Saint-Pantaléon-de-Larche ou à l’accueil de Suez au 3, rue Roger-Roncier à Brive (zone de Beauregard) et au lieu-dit Les Mazories à Saint-Cyprien."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "591d06b7-4cf8-325c-a2f6-f4031345570f",
                "word": "roncier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9d8616ac-ceeb-4a78-ab66-fc9de740bc42",
                        "entry_id": "591d06b7-4cf8-325c-a2f6-f4031345570f",
                        "tags": [
                            "plural"
                        ],
                        "form": "ronciers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e3b3a77-2851-3616-89fa-e6497107b891",
                        "entry_id": "591d06b7-4cf8-325c-a2f6-f4031345570f",
                        "glosses": [
                            "Buisson de ronces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "068f14ef-0d9e-47b2-8325-c2085b93fcb6",
                                "sense_id": "8e3b3a77-2851-3616-89fa-e6497107b891",
                                "text": "Près du virage le plus dur de l’allée, il y avait un roncier."
                            },
                            {
                                "example_id": "f070c336-d4c2-4965-ae1f-2368a911ef55",
                                "sense_id": "8e3b3a77-2851-3616-89fa-e6497107b891",
                                "text": "Des joncs bordaient la sente. Impossible de s'écarter à cause des fondis et des ronciers. Les bestiaux ne pacageaient que dans les prés-clairières."
                            },
                            {
                                "example_id": "0bba2480-80a7-4da9-8612-709296190e66",
                                "sense_id": "8e3b3a77-2851-3616-89fa-e6497107b891",
                                "text": "Il avait déjà repéré bien des parcelles que les paysans délaissaient ou travaillaient mal parce qu’elles étaient trop loin ou envahies par les ronciers."
                            },
                            {
                                "example_id": "421311a9-11da-476a-be15-d8aebdd72726",
                                "sense_id": "8e3b3a77-2851-3616-89fa-e6497107b891",
                                "text": "Orties, sureau noir et ronciers montrent que seul un nombre restreint d’espèces fait bombance à l’azote – aux dépens des variétés plus frugales et de la repousse des arbres."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb9b1821-3e5d-3b8a-8995-16709370ac00",
                        "entry_id": "591d06b7-4cf8-325c-a2f6-f4031345570f",
                        "glosses": [
                            "Ensemble de difficultés."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc767c9f-1598-4101-99b8-34516e3cb3cc",
                        "source_entry_id": "591d06b7-4cf8-325c-a2f6-f4031345570f",
                        "target_lang_word": "Brombeerstrauch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brombeerstrauch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f73f63f-9b72-370f-ab58-2f5e5159645d",
                                        "entry_id": "96b916bd-1b6d-3649-9109-e4a4a1b140b8",
                                        "glosses": [
                                            "Gewächs, an dem Brombeeren wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8437762-f7a8-4aa0-a9d2-1572841ace3a",
                                                "sense_id": "1f73f63f-9b72-370f-ab58-2f5e5159645d",
                                                "text": "„Der gewundene Fußweg führte sie durch die Brombeersträucher.“"
                                            },
                                            {
                                                "example_id": "f2ba3d07-991f-4b2f-a4fe-4c5b32cc8a6a",
                                                "sense_id": "1f73f63f-9b72-370f-ab58-2f5e5159645d",
                                                "text": "„Er war von Unkraut und Brombeersträuchern überwuchert, ausgebleichte Grabsteine neigten sich zur Seite oder waren vollständig umgestürzt, und einige flache Vertiefungen im Boden markierten die Stellen, wo die Erde hölzerne Särge wieder in sich aufgenommen hatte.“"
                                            },
                                            {
                                                "example_id": "7527e5b9-fef0-4d95-814b-477ae3ac4b0a",
                                                "sense_id": "1f73f63f-9b72-370f-ab58-2f5e5159645d",
                                                "text": "„Sie hing über Kopf und Schultern von Lester Ballard, dessen leises Fluchen auf die Stechwinde und Brombeersträucher an kein Ohr drang.“"
                                            },
                                            {
                                                "example_id": "21357767-ec7a-4c5d-a9b4-0722a658cf95",
                                                "sense_id": "1f73f63f-9b72-370f-ab58-2f5e5159645d",
                                                "text": "„Der Ball hat es wahrscheinlich nicht gesehen, denn er verfolgt mich weiter, als ich schneller fliehe, durchs Unterholz springe und mir den Weg durch Brombeersträucher bahne, mit jedem Schritt schlammiges Wasser aufspritze, bis ich den Schotter der Turner Road erreiche.“"
                                            },
                                            {
                                                "example_id": "43729f3a-e612-4ebb-b00b-e9bb17beafd2",
                                                "sense_id": "1f73f63f-9b72-370f-ab58-2f5e5159645d",
                                                "text": "„Die Häuser hören auf, der 800er-Block ist unbebautes Land, erst im hohen Block danach gehen die Häuser weiter. Eine mit hohem Gras bewachsene Fläche, gesäumt von alten Apfelbäumen, deren runzlige Rinde sich in die Dunkelheit schraubt. Dahinter ein größeres Gebüsch, Brombeersträucher und Gestrüpp, alles voller Dornen, das ganze übrige Gelände frei.“"
                                            },
                                            {
                                                "example_id": "4f577343-2f5e-45b9-9a9d-320e4c099c04",
                                                "sense_id": "1f73f63f-9b72-370f-ab58-2f5e5159645d",
                                                "text": "„Zwischen Brombeersträuchern, Kletterpflanzen und dicht an dicht stehenden Bäumen thronte ein kleines Gebäude aus ungleichmäßigen Steinblöcken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
