                                            {
                                                "example_id": "5754523c-cd80-4045-8f47-1cc807f61bd9",
                                                "sense_id": "bcbeb0d5-b42b-3a7a-b605-02f18820a79b",
                                                "text": "an instrumental part"
                                            },
                                            {
                                                "example_id": "82fd85ed-ef3e-4dac-a2cf-bc8d88c6dab2",
                                                "sense_id": "bcbeb0d5-b42b-3a7a-b605-02f18820a79b",
                                                "text": "He defended the use of instrumental music in public worship."
                                            },
                                            {
                                                "example_id": "aa34c1e3-2f33-44dc-8605-b1a93f3ff9b5",
                                                "sense_id": "bcbeb0d5-b42b-3a7a-b605-02f18820a79b",
                                                "text": "Sweet voices mix'd with instrumental sounds."
