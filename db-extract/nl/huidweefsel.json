                    {
                        "sense_id": "96f0f280-8e0b-349a-a23a-39b203691f47",
                        "entry_id": "703a87c1-7eae-3dfd-ba24-1d48110ffc52",
                        "glosses": [
                            "alle cellen en hun onderlinge samenhang die samen de huid vormen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13fe7796-f01b-4b2d-8eb0-400e77557f7c",
                                "sense_id": "96f0f280-8e0b-349a-a23a-39b203691f47",
                                "text": "\"Een dag later komen ze er dan pas achter dat ze ernstige brandwonden hebben opgelopen\", zegt Ymke Lucas, brandwondenarts in het Rotterdamse Maasstad Ziekenhuis. De schade aan huidweefsel door bevriezing is vergelijkbaar met letsel door verbranding."
                            },
                            {
                                "example_id": "a54e65ac-631b-4c03-9617-bfb8590f8447",
                                "sense_id": "96f0f280-8e0b-349a-a23a-39b203691f47",
                                "text": "Zonder enig overleg gebruikten zij apparatuur, personeel en middelen van het ziekenhuis. Huidweefsel werd op kosten van het ziekenhuis in laboratoria onderzocht."
                            },
                            {
                                "example_id": "34193aa2-62de-466a-a21c-74437032e1ea",
                                "sense_id": "96f0f280-8e0b-349a-a23a-39b203691f47",
                                "text": "In zijn nieuwste spectaculaire persmoment heeft de Russische premier Poetin een walvis geschoten met een kruisboog op de woelige wateren van de Grote Oceaan. Voor de kust van het schiereiland Kamtsjatka verzamelde hij zo huidweefsel van het dier voor verder onderzoek."
                            }
                        ]
                    }
