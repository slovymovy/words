                "senses": [
                    {
                        "sense_id": "5bfef9a3-1a4c-3108-9cfd-01dea5a85a06",
                        "entry_id": "a80239df-df48-3d3b-9b05-c2ab6329150f",
                        "glosses": [
                            "aus einem einzigen Graph bestehendes Graphem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3155fc4-6acf-4396-bf90-bf2b8cc75d7e",
                                "sense_id": "5bfef9a3-1a4c-3108-9cfd-01dea5a85a06",
                                "text": "„In acht von zehn untersuchten Falltypen bestätigte sich die Hypothese, dass die Latenz vor dem komplexen Graphem etwas länger war als vor dem Monographem; dieser Unterschied war jedoch nicht signifikant.“"
                            },
                            {
                                "example_id": "851d6397-ee5c-4b78-9a41-34ca03ea752d",
                                "sense_id": "5bfef9a3-1a4c-3108-9cfd-01dea5a85a06",
                                "text": "„Im Inlaut intervokalisch jedoch begegnet konsequent in einer Umgebung, in der im Mhd. dem ein Digraphem oder ein bei Krafft digraphemisiertes Monographem vorangeht.“"
                            },
                            {
                                "example_id": "831fed57-1ffc-4f58-9e4e-b416d924f3d5",
                                "sense_id": "5bfef9a3-1a4c-3108-9cfd-01dea5a85a06",
                                "text": "„Phoneme bestehen im Deutschen aus einem Buchstaben (Monographem , zweien (Digraphem ) oder dreien .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
