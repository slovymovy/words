                "senses": [
                    {
                        "sense_id": "b46cca20-79c3-300c-9c73-b5aa0cf9763f",
                        "entry_id": "1b7af695-b32a-304c-84bb-39eb7f029551",
                        "glosses": [
                            "Krankheitsbild, das zusätzlich zu einer anderen Erkrankung auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb90edb7-131c-46cd-8507-8bac0088c791",
                                "sense_id": "b46cca20-79c3-300c-9c73-b5aa0cf9763f",
                                "text": "„Obwohl die Persönlichkeitsstörungen bei Alkoholismus prinzipiell in dem Begriff der Komorbidität eingeschlossen sind, wird diese diagnostische Klasse in der vorliegenden Arbeit gesondert aufgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34c82746-59b8-4fee-8ef6-fa937d362611",
                        "source_entry_id": "1b7af695-b32a-304c-84bb-39eb7f029551",
                        "source_sense_id": "b46cca20-79c3-300c-9c73-b5aa0cf9763f",
                        "source_sense_description": "Medizin: Krankheitsbild, das zusätzlich zu einer anderen Erkrankung auftritt",
                        "target_lang_word": "comorbidity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comorbidity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                                        "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                                        "glosses": [
                                            "The presence of one or more disorders (or diseases) in addition to a primary disease or disorder."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feb01312-b929-4823-8a38-6092de7a6328",
                                                "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                                                "text": "Extensive comorbidity is the hallmark of immunodeficiencies."
                                            },
                                            {
                                                "example_id": "78a45686-9d1d-4171-ba66-2111788e2b84",
                                                "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                                                "text": "The reported comorbidity between categorical personality disorders and OCD ranges between 33 and 87 percent (Bejerot et al, 1998)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                                        "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                                        "glosses": [
                                            "A disease thus coexisting."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a9e448-0f4e-4703-8919-4d4872a5da43",
                                                "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                                                "text": "Coronary artery disease is often a comorbidity of diabetes mellitus."
                                            },
                                            {
                                                "example_id": "a667cd72-8ee3-451e-9c99-ee0e07042791",
                                                "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                                                "text": "Yet in private conversations, members of his staff were also candid that the president has comorbidities that could make him more susceptible to a severe bout of the virus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b53b04-c313-3ca5-b602-e1c743a411b2",
                                        "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                                        "glosses": [
                                            "The effect of such additional disorders or diseases."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1af7bdc3-38b5-46f4-b7c3-9d5b9627bbfb",
                        "source_entry_id": "1b7af695-b32a-304c-84bb-39eb7f029551",
                        "source_sense_id": "b46cca20-79c3-300c-9c73-b5aa0cf9763f",
                        "source_sense_description": "Medizin: Krankheitsbild, das zusätzlich zu einer anderen Erkrankung auftritt",
                        "target_lang_word": "comorbidité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comorbidité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c14def5-561b-37a7-bea6-4371037eb95d",
                                        "entry_id": "32c8a10f-9a91-3f5a-871d-c1a0250bbf74",
                                        "glosses": [
                                            "Présence simultanée chez quelqu’un de plusieurs troubles ou de plusieurs diagnostics, pouvant découler d’une maladie initiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f25722e-c8ae-425e-93b4-8f41b9d333f0",
                                                "sense_id": "6c14def5-561b-37a7-bea6-4371037eb95d",
                                                "text": "le diabète est une maladie présentant une forte comorbidité : il est fréquent que d'autres maladies y soient associées."
                                            },
                                            {
                                                "example_id": "48de9c9b-0be8-4ace-bde6-8635abd0bbe6",
                                                "sense_id": "6c14def5-561b-37a7-bea6-4371037eb95d",
                                                "text": "D’une manière générale, les patients présentant une comorbidité entre trouble addictologique et trouble mental sont à risque de ne pas être diagnostiqués pour l’une des deux conditions."
                                            },
                                            {
                                                "example_id": "23b31570-20eb-40eb-a16b-8be8820a5fc8",
                                                "sense_id": "6c14def5-561b-37a7-bea6-4371037eb95d",
                                                "text": "De plus, le vaccin semble fonctionner chez l’ensemble des sous-populations étudiées, incluant les personnes âgées, les minorités ethniques et les personnes présentant des comorbidités (diabète, maladie cardiovasculaire) qui les rendent à haut risque de développer des formes graves de COVID-19."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc1568dc-3ff2-4fe2-9dff-1265a66b4efe",
                        "source_entry_id": "1b7af695-b32a-304c-84bb-39eb7f029551",
                        "source_sense_id": "b46cca20-79c3-300c-9c73-b5aa0cf9763f",
