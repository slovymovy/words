            "senses": [
                {
                    "sense_id": "226f924d-88ca-3690-bbc2-697a05ad320a",
                    "sense_definition": "In a direct or honest manner; <w>straightforwardly</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "honesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked him <w>straightforward</w> in the eye and told him the truth.",
                            "target_lang_translations": {
                                "ru": "Она посмотрела ему <w>прямо</w> в глаза и сказала правду.",
                                "de": "Sie sah ihm <w>direkt</w> in die Augen und sagte ihm die Wahrheit."
                            }
                        },
                        {
                            "text": "The witness answered the questions <w>straightforward</w> without any hesitation.",
                            "target_lang_translations": {
                                "ru": "Свидетель отвечал на вопросы <w>честно</w> и без колебаний.",
                                "de": "Der Zeuge beantwortete die Fragen <w>offen</w> und ohne zu zögern."
                            }
                        }
                    ],
                    "antonyms": [
                        "indirectly",
                        "evasively"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямо или честно; без обиняков.",
