                        "form": "ostinati"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc083cb4-90b9-3f0b-8121-2af29b5b10d2",
                        "entry_id": "dd9287d4-8914-3b68-b2b7-eb09a6ca0a0c",
                        "glosses": [
                            "Répétition obstinée d’une formule rythmique, mélodique ou harmonique accompagnant de manière immuable les différents éléments thématiques durant tout le morceau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d3158b1-69da-409b-ba5b-73b96dcda71e",
                                "sense_id": "fc083cb4-90b9-3f0b-8121-2af29b5b10d2",
                                "text": "Des sonorités plus transparentes distillées avec une impression de rareté, des ostinati rythmiques qui créent une vraie stimulation réciproque avec les percussions."
                            },
                            {
                                "example_id": "cc1d64e2-4525-4a19-8f61-d5d20e11059d",
                                "sense_id": "fc083cb4-90b9-3f0b-8121-2af29b5b10d2",
                                "text": "Tout y est passé, à commencer par un ostinato sur le thème des \"serviettes\" (sic) – sans aucune variation – repris à tue-tête par l'assemblée hilare au moment du refrain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60e60881-4ea5-4e34-8686-d1486c57f635",
                        "source_entry_id": "dd9287d4-8914-3b68-b2b7-eb09a6ca0a0c",
                        "source_sense_id": "fc083cb4-90b9-3f0b-8121-2af29b5b10d2",
                        "source_sense_description": "répétition musicale immuable",
                        "target_lang_word": "ostinato",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ostinato",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd0088c-ab54-3939-9e5b-e45b260008a4",
                                        "entry_id": "86fb62f8-8016-34ca-9c65-16dbda8340ce",
                                        "glosses": [
                                            "A piece of melody, a chord progression, or a bass figure that is repeated over and over as a musical accompaniment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "802a4004-8cc3-4ea9-93be-ad5268337146",
                                                "sense_id": "fdd0088c-ab54-3939-9e5b-e45b260008a4",
                                                "text": "The piece moves in alluring spans of swirling figures, jagged lines and pointillistic outbursts, often prodded forward by ostinatos in the perky piano."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
