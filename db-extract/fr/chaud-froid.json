            {
                "entry_id": "90a343cf-dd7d-3f0f-9008-92270572d5f3",
                "word": "chaud-froid",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b9fbc6e5-c62e-4e94-8cb1-d63c805e0391",
                        "entry_id": "90a343cf-dd7d-3f0f-9008-92270572d5f3",
                        "tags": [
                            "plural"
                        ],
                        "form": "chauds-froids"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34defbb5-376e-32cc-8d03-433593047b7b",
                        "entry_id": "90a343cf-dd7d-3f0f-9008-92270572d5f3",
                        "glosses": [
                            "Chaud et froid : maladie provoquée par du froid suivant du chaud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cdf4100-3a18-4eb2-aadc-93f56a09d945",
                                "sense_id": "34defbb5-376e-32cc-8d03-433593047b7b",
                                "text": "S’il a pris un chaud-froid, elle trouvera du cidre, de l’eau-de-vie ; elle lui fera un flip, comme sa mère : avec du poivre et des clous de girofle."
                            }
                        ]
                    },
                    {
                        "sense_id": "495e0205-db9d-37b2-aaf5-ec75f1b958ee",
                        "entry_id": "90a343cf-dd7d-3f0f-9008-92270572d5f3",
                        "glosses": [
                            "Mets composé de membres de volaille rôtie découpés et enveloppés dans une sauce et ensuite dans une gelée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66121f14-6ac5-48c0-9d9b-03b1f6f928c0",
                                "sense_id": "495e0205-db9d-37b2-aaf5-ec75f1b958ee",
                                "text": "Chaud-froid de mauviettes."
                            },
                            {
                                "example_id": "f657a920-01ec-4556-b747-2fca6fbebad8",
                                "sense_id": "495e0205-db9d-37b2-aaf5-ec75f1b958ee",
                                "text": "Des ennemis acharnés mastiquaient leur chaud-froid à deux mètres les uns des autres."
                            },
                            {
                                "example_id": "1e297f2c-97f5-4b81-8822-0bc043d43776",
                                "sense_id": "495e0205-db9d-37b2-aaf5-ec75f1b958ee",
                                "text": "Que d’opinions ont été faites ou défaites entre une selle d’agneau et un chaud-froid de volaille !"
                            },
                            {
                                "example_id": "c3612a3a-2d4a-4c3d-97d5-625f4704eea7",
                                "sense_id": "495e0205-db9d-37b2-aaf5-ec75f1b958ee",
                                "text": "Œufs en gelée, cornets, aspics et barquettes, ballottines, galantines, pâtés, chauds-froids, daubes, terrines, confits, tourtes, tartes, frangipanes : toutes ces dames avaient rempli avec zèle leurs devoirs sociaux."
                            }
                        ]
                    }
                ],
