    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ecb8816-1afd-30dc-8807-f70592ee27c5",
                    "sense_definition": "Wydać głośny okrzyk lub wypowiedzieć słowa podniesionym głosem, zwykle aby kogoś przywołać lub zwrócić na siebie uwagę.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę głośno <w>zawołać</w> mojego psa, bo uciekł do lasu.",
                            "target_lang_translations": {
                                "ru": "Я должен громко <w>позвать</w> свою собаку, так как она убежала в лес.",
                                "en": "I have to loudly <w>call</w> my dog because he ran into the forest."
                            }
                        },
                        {
                            "text": "Kiedy poczujesz zagrożenie, powinieneś natychmiast <w>zawołać</w> o pomoc.",
                            "target_lang_translations": {
                                "ru": "Когда почувствуешь опасность, тебе следует немедленно <w>позвать</w> на помощь.",
                                "en": "When you feel in danger, you should immediately <w>call out</w> for help."
                            }
                        }
                    ],
                    "synonyms": [
                        "krzyknąć",
                        "przywołać",
                        "wezwać"
                    ],
                    "common_phrases": [
                        "zawołać o pomoc",
                        "zawołać lekarza",
                        "zawołać taksówkę",
                        "zawołać po imieniu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издать громкий крик или произнести слова повышенным голосом, обычно чтобы кого-то позвать или обратить на себя внимание.",
                        "en": "To shout loudly or say something in a raised voice, usually to call someone or attract attention."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крикнуть",
                                "target_lang_sense_clarification": "громко сказать"
                            },
                            {
                                "target_lang_word": "позвать",
                                "target_lang_sense_clarification": "призвать на помощь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "call out",
                                "target_lang_sense_clarification": "to speak loudly or shout to attract attention"
                            },
                            {
                                "target_lang_word": "shout",
                                "target_lang_sense_clarification": "to utter a loud cry"
                            },
                            {
                                "target_lang_word": "cry out",
                                "target_lang_sense_clarification": "to yell, often for help"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c3c6fac-bd87-3773-b2e1-2a9517339f18",
                    "sense_definition": "Aspekt dokonany od: <w>wołać</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mama <w>zawołała</w> dzieci na obiad, gdy tylko zupa była gotowa.",
                            "target_lang_translations": {
                                "ru": "Мама <w>позвала</w> детей на обед, как только суп был готов.",
                                "en": "Mom <w>called</w> the children for dinner as soon as the soup was ready."
                            }
                        },
                        {
                            "text": "Chciałem go <w>zawołać</w>, ale był już zbyt daleko.",
                            "target_lang_translations": {
                                "ru": "Я хотел его <w>окликнуть</w>, но он был уже слишком далеко.",
                                "en": "I wanted to <w>call out to</w> him, but he was already too far away."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершенный вид от: <w>wołać</w>.",
                        "en": "Perfective aspect of: to call / shout."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позвать",
                                "target_lang_sense_clarification": "попросить подойти"
                            },
                            {
                                "target_lang_word": "окликнуть",
                                "target_lang_sense_clarification": "обратить внимание голосом"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "to ask someone to come or summon them"
                            },
                            {
                                "target_lang_word": "summon",
                                "target_lang_sense_clarification": "to call someone over"
                            }
                        ]
                    }
                }
            ]
        }
