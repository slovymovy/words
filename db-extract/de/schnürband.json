                "senses": [
                    {
                        "sense_id": "16ee3972-e759-3178-ab34-711214ec7fab",
                        "entry_id": "16210610-dee6-3339-ad6a-bc31feb3e2dd",
                        "glosses": [
                            "langes schmales Band zur Befestigung eines Schuhs"
                        ],
                        "tags": [
                            "North German",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "2f15772b-a982-47fd-9604-f8ff12dcf043",
                                "sense_id": "16ee3972-e759-3178-ab34-711214ec7fab",
                                "text": "„Er band sich die Schnürbänder seiner Fellschuhe und stand schon vor der Tür, als er sich noch einmal umdrehte.“"
                            },
                            {
                                "example_id": "37d2f97a-e103-472d-a8df-fd974a9cf67d",
                                "sense_id": "16ee3972-e759-3178-ab34-711214ec7fab",
                                "text": "„Dann löste sie das Schnürband aus einem Stiefel und band eine seiner Pfoten hinten an die Wand. Das würde ihn nur fünf Minuten aufhalten, aber hoffentlich verhindern, dass er ihr folgte.“"
                            },
                            {
                                "example_id": "1bfb0f38-b008-4250-9526-114bfbb68d43",
                                "sense_id": "16ee3972-e759-3178-ab34-711214ec7fab",
                                "text": "„Schnürbänder wurden festgezurrt, Nebenstehende mit Rucksäcken gerammt, alle machten sich bereit, sobald das Schiff anlegen würde, loszustürmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
