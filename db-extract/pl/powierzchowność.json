                                        "entry_id": "0e3ea08c-de12-3e3f-98e4-1c50a8de9eaf",
                                        "glosses": [
                                            "The property of being superficial, the tendency to judge by surface appearance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5933c198-517e-4be0-ac90-03b40c839c1c",
                                                "sense_id": "61ca0131-1c96-3a9a-b90c-a0a8a4b13cf6",
                                                "text": "Seeks companion with similar invisible handicap or circumstance which forced early awareness of mortality and is consequently very serious about life and has little time for superficiality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c96570d-60bc-4be5-928b-c0bc36488883",
