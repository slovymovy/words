                "senses": [
                    {
                        "sense_id": "5c449280-5ee3-3a3b-8d4d-80bb70622b63",
                        "entry_id": "34e653ce-2139-31fe-8d3d-5cbc27ce2630",
                        "glosses": [
                            "женское имя греческого происхождения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db7e3203-ba3d-4897-befc-4da4eba81893",
                                "sense_id": "5c449280-5ee3-3a3b-8d4d-80bb70622b63",
                                "text": "Когда дед переходил улицу, молоденькие — Этери, Нана и Галатея Чикваидзе выглядывали из окон."
                            }
                        ]
                    },
                    {
                        "sense_id": "7879fa75-5725-39a5-b877-9dc3c59420ff",
                        "entry_id": "34e653ce-2139-31fe-8d3d-5cbc27ce2630",
                        "glosses": [
                            "мифол. мраморная статуя, созданная Пигмалионом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5226db5a-7ed2-4416-ac6f-21c9b799e092",
                                "sense_id": "7879fa75-5725-39a5-b877-9dc3c59420ff",
                                "text": "А все же люди не так-то охотно освобождаются от желания согревать своих мраморных Галатей…"
                            }
                        ]
                    }
