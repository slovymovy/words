                                    },
                                    {
                                        "sense_id": "9ac541c8-125c-3e4c-bc45-42979236e8b6",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of effective refractory period."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7360cf58-e027-3ab4-b4d4-f16e5d0b8385",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of enterprise resource planning."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "671f1499-0c12-4eb3-9172-01e0e18d9aba",
                                                "sense_id": "7360cf58-e027-3ab4-b4d4-f16e5d0b8385",
                                                "text": "Businesses of all sizes depend on software to operate. Two of the most important operations of any business are managing its internal resources and staying in close contact with customers. Enterprise resource planning (ERP) products help companies keep their internal operations running smoothly, while customer relationship management (CRM) software maintains and maximizes their interactions with existing and potential customers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aae15c1-d566-30fd-9e9c-64a2f0a393f5",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of equity risk premium."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a6414ec-9134-3dc3-9f6d-6a7db1aca20f",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of erotic roleplay."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "abbreviation",
                                            "alt-of",
                                            "initialism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4b4254f-68b7-479d-957b-9c64a732f3e9",
                                                "sense_id": "9a6414ec-9134-3dc3-9f6d-6a7db1aca20f",
                                                "text": "The guild, called Abhorrent Taboo on WoW's Ravenholdt server, attracted gamers through its participation in Erotic Roleplay (ERP). In the case of massive multiplayer online games, this usually involves grinding avatars together to simulate sexual encounters and erotically-charged text chatting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a80acba-c8b6-3b6b-85da-85b0859c90db",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of estimated retail price."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9e2a227-fa3c-3f98-a990-06aa67297993",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of event-related potential."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ERP",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                        "entry_id": "7879e425-a560-386d-8967-42c4d86b2fd7",
                                        "glosses": [
                                            "Initialism of Electronic Road Pricing."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a03e09be-7301-4afb-a4f3-d975274dc414",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "Electronic road pricing (ERP)is one of the main tools which is keeping Singapore’s traffic problems within manageable levels."
                                            },
                                            {
                                                "example_id": "ab8b041e-d601-4e9d-a023-d09ee20cdc5e",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "Many car parks are now run using the same in-vehicle unit and cashcard and ERP gantries instead of the coupon system."
                                            },
                                            {
                                                "example_id": "b562b1ce-4d1f-497f-8533-591e8165a313",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "However, the term ERP is unique to Singapore, and it serves to differentiate the fact that charges are not collected at physical toll stations but are done automatically on the roadways."
                                            },
                                            {
                                                "example_id": "24c80c4e-70ff-4893-a531-bde50c6f3717",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "The Land Transport Authority (LTA) has called a tender to develop Singapore's next generation electronic road pricing system. The new system will be based on Global Navigation Satellite System technology."
                                            },
                                            {
                                                "example_id": "381da927-961f-4a97-b35f-32f47d2820ba",
                                                "sense_id": "39284b30-a9de-352a-ae32-bc4129da2135",
                                                "text": "Singapore has cleared the way for its next-generation Electronic Road Pricing (ERP) system, which will have islandwide coverage and the ability to charge according to distance travelled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
