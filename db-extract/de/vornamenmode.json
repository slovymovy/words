                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39a0eebd-9f9b-4d03-bed9-a053659f37f1",
                                "sense_id": "52348149-f758-3b68-a56c-f0443f4debb1",
                                "text": "„Im Zusammenhang mit der Veränderung von Vornamenmoden wird ab und an nach Namen gefragt, die vor ca. 50 Jahren beliebt waren…“"
                            },
                            {
                                "example_id": "950b18d5-0bed-4fe2-b65a-28b2ff794e14",
                                "sense_id": "52348149-f758-3b68-a56c-f0443f4debb1",
                                "text": "„Veränderungen in der Häufigkeitsverteilung können Aufschluß geben über Wandlungen in der sogenannten Vornamenmode, im Geschmack…“"
                            },
                            {
                                "example_id": "b13251e0-d538-4d04-848a-23d10a8738e0",
                                "sense_id": "52348149-f758-3b68-a56c-f0443f4debb1",
                                "text": "„Natürlich variieren die beliebtesten Vornamen noch etwas von Ort zu Ort, wenngleich die »Vornamenmode erstaunlich gleichmäßig das gesamte Bundesgebiet überzieht und beherrscht« (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
