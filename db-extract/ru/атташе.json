                                        "entry_id": "9188078b-38c6-3dd4-b2b4-2c7505ce41cf",
                                        "glosses": [
                                            "A diplomatic officer, usually one who plays a specific role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d04c2f11-3a2e-48d5-9796-9791714956f9",
                                                "sense_id": "63bc2e03-f0e5-395a-a40d-7284f77e9bd2",
                                                "text": "Little did anyone suspect that the military attaché was one of the world's craftiest spies."
                                            },
                                            {
                                                "example_id": "02be7022-a787-4a4a-ae29-8a2d21bd7d6e",
                                                "sense_id": "63bc2e03-f0e5-395a-a40d-7284f77e9bd2",
                                                "text": "One of the commercial attachés of the Department of Commerce in South America transmits the name and address of an engineer who desires to receive full information relative to an automotor for an interurban railway."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
