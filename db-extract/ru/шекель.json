                "translations": [
                    {
                        "translation_id": "39ddd95a-9a01-4039-9a63-6f8105e853da",
                        "source_entry_id": "065ddfec-54c7-30ed-8171-8ebf8b7f4668",
                        "source_sense_id": "a27e83de-02a9-31e9-8cb9-ffffa8600562",
                        "target_lang_word": "shekel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shekel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1d989b-669a-3b20-ab5d-4869a5f8b629",
                                        "entry_id": "52a42b56-f7db-3db1-a353-d0a30f2c2cc0",
                                        "glosses": [
                                            "A currency unit of both ancient and modern Israel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21c7e7ee-aa1e-424f-9df0-47232a44719d",
                                                "sense_id": "0d1d989b-669a-3b20-ab5d-4869a5f8b629",
                                                "text": "So David bought the threshingfloor and the oxen for fifty shekels of silver."
                                            },
                                            {
                                                "example_id": "f0d16aef-ec9d-4bc5-ade7-a1d03568b78f",
                                                "sense_id": "0d1d989b-669a-3b20-ab5d-4869a5f8b629",
                                                "text": "\"Beauty is naught to him, because there are lips more honey-sweet; and wealth is naught, because others can weigh him down with heavier shekels; and fame is naught, because there have been greater men than he.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66f5743d-783e-39f0-9765-b7d2fbc1d4a9",
                                        "entry_id": "52a42b56-f7db-3db1-a353-d0a30f2c2cc0",
                                        "glosses": [
                                            "Money."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe9f4baf-a8b6-455e-807c-52791ee50cae",
                                                "sense_id": "66f5743d-783e-39f0-9765-b7d2fbc1d4a9",
                                                "text": "Her gownlet cost five hundred beans; / Her furs, four figures in a row; / Her hat removed from papa's jeans / A hundred shekels more or so."
                                            },
                                            {
                                                "example_id": "a89eae30-275e-4695-8d92-4468bb2b77a4",
                                                "sense_id": "66f5743d-783e-39f0-9765-b7d2fbc1d4a9",
                                                "text": "[…] after the 1887-9 campaign was the great refuge of the destitute who, as they could not hope to rake in a breast-full of medals and decorations, expected, at any rate, to amass a good few shekels."
                                            },
                                            {
                                                "example_id": "2373eb3f-48f2-40f7-a11a-a20a68c64321",
                                                "sense_id": "66f5743d-783e-39f0-9765-b7d2fbc1d4a9",
                                                "text": "The mob had filched anything that might earn them a shekel or two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60e1a138-5b8e-3354-9819-04d2b528cdfc",
                                        "entry_id": "52a42b56-f7db-3db1-a353-d0a30f2c2cc0",
                                        "glosses": [
                                            "An ancient unit of weight equivalent to one-fiftieth of a mina."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "580372b0-06eb-46e2-8098-bce87b4a16e8",
                                                "sense_id": "60e1a138-5b8e-3354-9819-04d2b528cdfc",
                                                "text": "And it came to pass, as the camels had done drinking, that the man took a golden earring of half a shekel weight, and two bracelets for her hands of ten shekels weight of gold;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
