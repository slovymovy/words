                            {
                                "example_id": "a8a3cdd2-4273-4d64-8283-4e64a668c76f",
                                "sense_id": "e6168ae0-09d1-3bf5-a5dc-3589aa86f734",
                                "text": "Un chercheur américain, Rob Li, a su capter au meilleur des moments ce duel au soleil entre les deux bébés, dans les îles San Juan, à Seattle (États-Unis)."
                            }
                        ]
                    }
                ],
