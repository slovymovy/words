                "senses": [
                    {
                        "sense_id": "0bcbe218-a48e-39af-809c-0badf29e912b",
                        "entry_id": "78c898ef-530b-349a-ae2b-72cafce6bb19",
                        "glosses": [
                            "Fahrbahn für Autoscooter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35e7d39a-f20d-4550-9d82-7e8437cbdf01",
                                "sense_id": "0bcbe218-a48e-39af-809c-0badf29e912b",
                                "text": "„Als sie dort an der Autoscooterbahn eines 35-jährigen Mannes aus Möckmühl vorbeiliefen, hoben die drei Täter einen Autoscooter aus der Bahn und schoben ihn über den Festplatz.“"
                            },
                            {
                                "example_id": "8d9bbdf5-5b80-440a-93f1-0cc3c358bfd7",
                                "sense_id": "0bcbe218-a48e-39af-809c-0badf29e912b",
                                "text": "„In diesem Jahr wird die Autoscooterbahn am Sonntag, 5. Mai, 11 Uhr, zum Kirchraum.“"
                            },
                            {
                                "example_id": "ffd9267b-b1b2-4d46-a788-67580b92bd6e",
                                "sense_id": "0bcbe218-a48e-39af-809c-0badf29e912b",
                                "text": "„Ein Gottesdienst auf der Autoscooterbahn der Nieder Kerb lud gestern dazu ein, hierüber nachzudenken.“"
                            },
                            {
                                "example_id": "004706b9-26f3-4b25-be5b-f42bded5c1ea",
                                "sense_id": "0bcbe218-a48e-39af-809c-0badf29e912b",
                                "text": "„Die große Mehrheit, zumeist ältere Kirchgänger, hat sich dicht an dicht auf den Bänken niedergelassen, die auf der Autoscooterbahn aufgestellt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
