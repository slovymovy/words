                            {
                                "example_id": "1162eac3-dc96-4fb2-bf3b-376b32865c1c",
                                "sense_id": "443ee59b-1c63-3941-8195-90bdfa57682f",
                                "text": "„Das Mädchen nahm das scharfe Rindfleischsandwich mit Kartoffelbrei und Bratensoße.“"
                            },
