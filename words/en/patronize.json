    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3a44ad2-59ca-3bd9-8641-305d49065837",
                    "sense_definition": "To treat someone in a condescending way, behaving as though one is superior to them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condescend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stop speaking to me like a child and do not <w>patronize</w> me."
                        },
                        {
                            "text": "The manager tended to <w>patronize</w> junior employees instead of listening to their valid concerns."
                        }
                    ],
                    "synonyms": [
                        "condescend",
                        "infantilize"
                    ],
                    "common_phrases": [
                        "patronize someone"
                    ]
                },
                {
                    "sense_id": "3b159ffa-09b0-3d8e-860d-adaee23300f6",
                    "sense_definition": "To be a regular customer of a store, restaurant, or other business.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Local residents often choose to <w>patronize</w> small businesses rather than large supermarket chains."
                        },
                        {
                            "text": "We decided to <w>patronize</w> the new family-owned cafe downtown for breakfast."
                        }
                    ],
                    "common_phrases": [
                        "patronize local businesses"
                    ]
                },
                {
                    "sense_id": "60ae24d5-c9cf-3b03-878d-cb939d89fab0",
                    "sense_definition": "To act as a patron toward someone or something; to support, protect, or sponsor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wealthy nobility would often <w>patronize</w> young artists and classical musicians during the Renaissance."
                        },
                        {
                            "text": "The foundation was created specifically to <w>patronize</w> scientific research across the country."
                        }
                    ],
                    "common_phrases": [
                        "patronize the arts"
                    ]
                },
                {
                    "sense_id": "8df47632-92ef-3f5f-994c-5eb4059e62e9",
                    "sense_definition": "To blame or reproach.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "criticize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bishop chose not to <w>patronize</w> the dissenters for their vocal opposition."
                        },
                        {
                            "text": "In the historical text, the elders would frequently <w>patronize</w> those who broke the traditional rules."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in common use in this sense"
                        }
                    ]
                }
            ]
        }
    ]
