                "senses": [
                    {
                        "sense_id": "e86c941c-12c9-3dc1-bbe5-5a9df8e861ae",
                        "entry_id": "54ebff3a-e22c-3561-852f-335c3f78a28a",
                        "glosses": [
                            "der Bereich, der zwischen zwei voneinander getrennten Teilen eines Adverbs liegt"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "6b3cbae6-d874-48cb-88ae-0862cd1da310",
                                "sense_id": "e86c941c-12c9-3dc1-bbe5-5a9df8e861ae",
                                "text": "Mit Adverbialklammer sind Fälle wie die Trennung von „davon“ in „da“ und „von“ in Sätzen wie „Da hat er ja nichts von gewusst“ statt „Davon hat er ja nichts gewusst“ gemeint."
                            },
                            {
                                "example_id": "529a6549-aaa1-44da-bafa-a9ddd0303e6d",
                                "sense_id": "e86c941c-12c9-3dc1-bbe5-5a9df8e861ae",
                                "text": "„Während FLEISCHER (2002) in Bezug auf die hier zu untersuchende Konstruktion der Pronominaladverbien im gesprochenen Deutsch von ‚Spaltungskonstruktionen‘ (Fleischer, 2002: 388) spricht, ist in einem Großteil der Literatur auch die Rede von ‚Adverbklammer‘ (Weinrich, 2003: 566) oder ‚Adverbialklammer‘ (Eroms, 1999: 213, Ronneberger-Sibold, 1991: 216).“"
                            },
                            {
                                "example_id": "2416081f-e817-4264-9eb7-cc215b072faa",
                                "sense_id": "e86c941c-12c9-3dc1-bbe5-5a9df8e861ae",
                                "text": "„Unter dem Punkt ,Die Klammer heute' (S. 96 f.) wird auch die Adverbialklammer erwähnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
