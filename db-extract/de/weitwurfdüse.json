                "senses": [
                    {
                        "sense_id": "d3961a67-a346-3859-aa61-8c2b88751a05",
                        "entry_id": "7e5d968f-f5ee-38d4-a847-567b27c54156",
                        "glosses": [
                            "sich im Querschnitt verengender Auslass, der dazu dient, die Strömungsgeschwindigkeit von Gasen oder Flüssigkeiten wesentlich zu erhöhen, um weit in den Raum einblasen zu können"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "c0b05cb5-8c4f-42c5-b723-500e61d4d01c",
                                "sense_id": "d3961a67-a346-3859-aa61-8c2b88751a05",
                                "text": "„Typische Einsatzbereiche von Weitwurfdüsen sind große Räume oder Hallen wie z. B. Messehallen, Einkaufszentren, Flughäfen, Mehrzweckhallen und Konzertsäle, bei denen der Luftstrahl große Wurfweiten bei niedrigen Schall-Leistungspegeln erreicht.“"
                            },
                            {
                                "example_id": "708f7f1c-640c-4b7f-94de-4358d6d70df4",
                                "sense_id": "d3961a67-a346-3859-aa61-8c2b88751a05",
                                "text": "„Die Weitwurfdüsen sind wahlweise manuell oder mittels Stellmotor bis zu 30° in horizontaler und vertikaler Richtung schwenkbar.“"
                            },
                            {
                                "example_id": "e60b59b9-319a-4cf9-a928-f8814e3f5554",
                                "sense_id": "d3961a67-a346-3859-aa61-8c2b88751a05",
                                "text": "„Die verstellbaren Weitwurfdüsen der Serie DUK-V ermöglichen eine Anpassung des Zuluftstrahls an die jeweiligen Bedingungen.“"
                            },
                            {
                                "example_id": "b98ccbc0-92a6-4902-b244-cd49f8f2d83b",
                                "sense_id": "d3961a67-a346-3859-aa61-8c2b88751a05",
                                "text": "„GTI ist eine flexible Weitwurfdüse für die Belüftung großer Räume.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
