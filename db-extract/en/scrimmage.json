                    {
                        "sense_id": "b1f2b8b8-fb11-314e-9660-8651e2112eec",
                        "entry_id": "17cd74b2-33c7-3725-9ab2-b971da2eaa88",
                        "glosses": [
                            "A rough fight."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e724e806-3601-4714-847e-271a254a97c4",
                                "sense_id": "b1f2b8b8-fb11-314e-9660-8651e2112eec",
                                "text": "get caught up in a scrimmage"
                            },
                            {
                                "example_id": "df2fda5e-3ba2-4557-9739-9987d88fcc56",
                                "sense_id": "b1f2b8b8-fb11-314e-9660-8651e2112eec",
                                "text": "There was an instant of complete silence, but when Tough Bill threw himself on Strickland the lust of battle seized them all, and in a moment there was a confused scrimmage. Tables were overturned, glasses crashed to the ground."
                            }
                        ]
                    },
                    {
                        "sense_id": "d9c1ba9c-67fc-3308-a1ad-9dd17bbb20a8",
                        "entry_id": "17cd74b2-33c7-3725-9ab2-b971da2eaa88",
                        "glosses": [
                            "In some team sports, especially soccer, a practice game which does not count on a team's record."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "7c53cefb-ec0e-4a6f-9d78-d89ac901a4db",
                                "sense_id": "d9c1ba9c-67fc-3308-a1ad-9dd17bbb20a8",
                                "text": "Merchandise sales surged. The spring scrimmage, usually a yawn of an afterthought at Colorado, was packed."
                            }
                        ]
                    },
                    {
                        "sense_id": "b68e7e48-df88-3014-a9fa-baad568374f2",
                        "entry_id": "17cd74b2-33c7-3725-9ab2-b971da2eaa88",
                        "glosses": [
                            "In American football or Canadian football, a play that begins with a snap from the center while opposing teams are on either side of a line of scrimmage."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
