        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdc30410-baeb-373c-b568-5941afe3a607",
                    "sense_definition": "An obsolete or dialectal form of <w>ought</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older texts, one might read that a person <w>aught</w> to be more careful.",
                            "target_lang_translations": {
                                "pl": "W starszych tekstach można przeczytać, że człowiek <w>powinien</w> być bardziej ostrożny."
                            }
                        },
                        {
                            "text": "\"Ye <w>aught</w> to have known better,\" the old man muttered.",
                            "target_lang_translations": {
                                "pl": "„<w>Powinniście</w> byli to lepiej przemyśleć” – mruknął starzec."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This is an obsolete spelling of the modal verb."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Przestarzała lub dialektalna forma czasownika modalnego 'ought' (powinien)."
