                "senses": [
                    {
                        "sense_id": "54a50d7e-2109-3dec-9bb3-4fc1ff81cb58",
                        "entry_id": "01501080-a2bf-3a26-96d9-583f77b0a0bb",
                        "glosses": [
                            "neurologische Erkrankung, die sich in einer Änderung der Sprachmelodie des Patienten äußert, die von Dritten häufig als Akzent einer Fremdsprache interpretiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de8d71c-7201-472a-be6e-94467286b5fa",
                                "sense_id": "54a50d7e-2109-3dec-9bb3-4fc1ff81cb58",
                                "text": "„Neurologen haben die sehr seltene Störung Fremdsprachen-Akzent-Syndrom (FAS) getauft. “"
                            },
                            {
                                "example_id": "4e0e584b-60be-48d2-a2c7-b51502fd999d",
                                "sense_id": "54a50d7e-2109-3dec-9bb3-4fc1ff81cb58",
                                "text": "„Das Fremdsprachen-Akzent-Syndrom wird von Medizinern normalerweise mit einem Schlaganfall oder einer Gehirnverletzung in Verbindung gebracht.“"
                            },
                            {
                                "example_id": "3f2ba5d1-dcc4-417d-b5f6-d81ef522fa48",
                                "sense_id": "54a50d7e-2109-3dec-9bb3-4fc1ff81cb58",
                                "text": "„Seit ihrem Anfall im Januar leide sie unter dem sogenannten Fremdsprachen-Akzent-Syndrom, sagte die betroffene Kay Russell aus dem zentralenglischen Bishop’s Cleeve der Lokalzeitung »Gloucester Echo«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
