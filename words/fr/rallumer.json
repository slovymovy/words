    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "89ad6b30-9d6d-3c7a-a85a-736041289563",
                    "sense_definition": "Allumer de nouveau ce qui s'était éteint ou ce qu'on avait éteint.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il fait encore sombre, peux-tu <w>rallumer</w> la lumière s'il te plaît ?"
                        },
                        {
                            "text": "Après la coupure de courant, j'ai dû <w>rallumer</w> mon ordinateur pour continuer mon travail."
                        }
                    ],
                    "common_phrases": [
                        "rallumer la lumière",
                        "rallumer le feu",
                        "rallumer la télévision"
                    ]
                },
                {
                    "sense_id": "fc5d70a3-6ead-36e6-8123-5f48506a494f",
                    "sense_definition": "Recommencer à brûler ou à fonctionner après s'être éteint.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon écran s'est éteint brusquement puis s'est <w>rallumé</w> quelques secondes plus tard."
                        },
                        {
                            "text": "Le feu de cheminée semblait mort, mais il s'est <w>rallumé</w> avec le vent."
                        }
                    ],
                    "common_phrases": [
                        "se rallumer tout seul"
                    ]
                },
                {
                    "sense_id": "a2538b00-adec-3626-8dd7-206aba0c4dd0",
                    "sense_definition": "Donner une nouvelle ardeur ou une nouvelle force à un sentiment, un conflit ou un intérêt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette dispute risque de <w>rallumer</w> de vieilles querelles entre les deux familles."
                        },
                        {
                            "text": "Leur voyage à Venise a permis de <w>rallumer</w> la flamme de leur amour."
                        }
                    ],
                    "synonyms": [
                        "ranimer",
                        "raviver"
                    ],
                    "common_phrases": [
                        "rallumer la flamme",
                        "rallumer les tensions"
                    ]
                }
            ]
        }
    ]
