                        ],
                        "form": "dem Ellenbogen"
                    },
                    {
                        "form_id": "a8cdd1b5-ff62-458e-8863-77172f0480d4",
                        "entry_id": "fd1ca3bf-0e99-3c17-991f-f904e072c745",
                        "tags": [
                            "dative",
                            "plural"
                        ],
                        "form": "den Ellenbogen"
                    },
                    {
                        "form_id": "394278bf-6f87-4f6e-a36d-8dbfa292ef0d",
                        "entry_id": "fd1ca3bf-0e99-3c17-991f-f904e072c745",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Ellenbogen"
                    },
                    {
                        "form_id": "ac59834a-d650-4c0a-8550-686feeaa2248",
                        "entry_id": "fd1ca3bf-0e99-3c17-991f-f904e072c745",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Ellenbogen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5619ce9b-affb-3749-a883-44f62553287d",
                        "entry_id": "fd1ca3bf-0e99-3c17-991f-f904e072c745",
                        "glosses": [
                            "am Unterarm und Oberarm verbindendem Gelenk sitzender Knochenfortsatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "601abfcc-0d53-4587-af78-6c8a4ce83dc9",
                                "sense_id": "5619ce9b-affb-3749-a883-44f62553287d",
                                "text": "„Ich lag noch eine Weile mit den Ellenbogen auf das Kissen gestützt und dachte über diese Dinge nach.“"
                            },
                            {
                                "example_id": "84d9f366-8216-4770-b6c4-0923a7e5712f",
                                "sense_id": "5619ce9b-affb-3749-a883-44f62553287d",
                                "text": "„Er versuchte, sich Platz zu verschaffen, fuhr seine Ellenbogen aus.“"
                            },
                            {
                                "example_id": "68338df2-e75e-45db-a481-41d56bef94e0",
                                "sense_id": "5619ce9b-affb-3749-a883-44f62553287d",
                                "text": "„Da wurde ich ängstlich und warf noch einmal einen Blick auf das Dach hinauf, ich sah nur mit halbgeschlossenen Augen, daß die Lieblingsfrau dort oben auf den Ellenbogen lag und mich flehend ansah.“"
                            },
                            {
                                "example_id": "6ed6d7b9-0d50-43ae-829a-8606f63d0989",
                                "sense_id": "5619ce9b-affb-3749-a883-44f62553287d",
                                "text": "„Die Tasse in den Händen stützte er seine Ellenbogen auf und pustete auf den dampfenden Tee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
