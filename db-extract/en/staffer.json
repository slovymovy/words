                    {
                        "sense_id": "8f06a697-78a9-3225-9696-a4f3f6da7ba0",
                        "entry_id": "99a93a92-4218-3633-b978-b0f8cba4e25b",
                        "glosses": [
                            "A member of a staff; an employee."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d22b1e9-b4c5-47b7-99df-7a2669a0bb52",
                                "sense_id": "8f06a697-78a9-3225-9696-a4f3f6da7ba0",
                                "text": "The politician had a staffer send out the prepared statement."
                            },
                            {
                                "example_id": "62ae95e5-b95f-4249-aca2-559697c37087",
                                "sense_id": "8f06a697-78a9-3225-9696-a4f3f6da7ba0",
                                "text": "But some Democrats are raising red flags about DOGE staffers “infiltrating multiple agencies at once,” and “recklessly and haphazardly combining data without any verification or validation,” as one senior House Oversight Committee Democratic staffer put it to CNN."
                            }
                        ]
                    }
                ],
