                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a94380a-9a62-4110-a084-33f501258cb8",
                                                "sense_id": "d1c288fb-5ffb-3044-8895-99a855e539b0",
                                                "text": "con disfunzioni note, ci sono individui maschi sterili in modo cronico: non avranno mai una propria famiglia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad48f371-0727-3d89-94d5-cbaf0b70a403",
                                        "entry_id": "e52f9fb6-9b96-3c56-a46d-a11efa454804",
