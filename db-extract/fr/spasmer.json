                ],
                "senses": [
                    {
                        "sense_id": "431243e9-0ef3-3e29-beae-db38f4eb93d2",
                        "entry_id": "90e90ca9-3416-3bf1-974e-151f2a797ef3",
                        "glosses": [
                            "Être l'objet de spasmes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95c16d13-940b-4426-a2d6-baa238c37415",
                                "sense_id": "431243e9-0ef3-3e29-beae-db38f4eb93d2",
                                "text": "Dans un cas cependant, nous avons vu l'artère cérébelleuse postérieure et inférieure se spasmer sur toute sa partie visible, soit sur plus de 2 cm."
                            },
                            {
                                "example_id": "7e1123e1-f5a8-4c56-9e25-bbd579269e5e",
                                "sense_id": "431243e9-0ef3-3e29-beae-db38f4eb93d2",
                                "text": "La manière sotte qu’ils spasment, qu’ils tentaculent. Le défoutrement, somme toute, c’est laborieux."
                            },
                            {
                                "example_id": "24cb40e9-e732-466e-8132-1d008526c991",
                                "sense_id": "431243e9-0ef3-3e29-beae-db38f4eb93d2",
                                "text": "Les plis vestibulaires, on le sait, forment un sphincter qui tend à se spasmer dans les situations angoissantes."
                            }
                        ]
                    }
                ],
