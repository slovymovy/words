                            {
                                "example_id": "fb3e6c1e-19bd-4035-9f13-ade50cf7f4fc",
                                "sense_id": "b38b9eed-e3e7-3093-8c9b-975c8238471a",
                                "text": "„Es war mal ein Eierbecher,",
