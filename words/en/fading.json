    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c40319ad-b01b-372e-95f9-6257f99e35e8",
                    "sense_definition": "present participle and gerund of <w>fade</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "diminishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fading</w> light made it difficult to read the book outside.",
                            "target_lang_translations": {
                                "ru": "<w>Угасающий</w> свет затруднял чтение книги на улице."
                            }
                        },
                        {
                            "text": "She had a <w>fading</w> memory of her childhood home.",
                            "target_lang_translations": {
                                "ru": "У нее остались лишь <w>угасающие</w> воспоминания о доме ее детства."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fading light",
                        "fading memory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «угасать», «блекнуть» или «исчезать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угасающий",
                                "target_lang_sense_clarification": "о свете, надежде или чувствах"
                            },
                            {
                                "target_lang_word": "блекнущий",
                                "target_lang_sense_clarification": "о цвете или яркости"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30e882c6-f908-3b5b-a66b-5d2ff92852f1",
                    "sense_definition": "The process by which something loses color, strength, or brightness.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "diminishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>fading</w> of the old photograph was caused by years of direct sunlight.",
                            "target_lang_translations": {
                                "ru": "<w>Выцветание</w> старой фотографии было вызвано годами воздействия прямых солнечных лучей."
                            }
                        },
                        {
                            "text": "He noticed the slow <w>fading</w> of his enthusiasm for the project.",
                            "target_lang_translations": {
                                "ru": "Он заметил медленное <w>угасание</w> своего энтузиазма по отношению к проекту."
                            }
                        }
                    ],
                    "synonyms": [
                        "diminishment",
                        "decline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, при котором что-либо теряет цвет, силу или яркость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выцветание",
                                "target_lang_sense_clarification": "потеря цвета под воздействием света"
                            },
                            {
                                "target_lang_word": "угасание",
                                "target_lang_sense_clarification": "потеря силы, интереса или яркости"
                            }
                        ]
