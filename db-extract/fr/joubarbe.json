        "fr-extract.jsonl": [
            {
                "entry_id": "feb67160-971b-37cc-8c94-0ce11c58fe8e",
                "word": "joubarbe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1760f4e6-80cf-470b-89c2-4139753a75af",
                        "entry_id": "feb67160-971b-37cc-8c94-0ce11c58fe8e",
                        "tags": [
                            "plural"
                        ],
                        "form": "joubarbes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c44ded75-4e92-3519-babd-776720fc65ba",
                        "entry_id": "feb67160-971b-37cc-8c94-0ce11c58fe8e",
                        "glosses": [
                            "Crassulacée toujours verte, dont l’espèce la plus commune croît ordinairement sur les toits et sur les murs et se nomme artichaut bâtard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d58c7e5-12dc-4a74-8600-689edc9996b9",
                                "sense_id": "c44ded75-4e92-3519-babd-776720fc65ba",
                                "text": "les feuilles sont ou minces ou deliées, comme celles du mille-pertuis ; ou épaisses, comme celles du pourpier ; ou charnues, comme celles de plusieurs sortes de joubarbe ; ou drapées, comme celles du bouillon-blanc."
                            },
                            {
                                "example_id": "dc767dc4-3d25-43f8-993f-dd876f1cde77",
                                "sense_id": "c44ded75-4e92-3519-babd-776720fc65ba",
                                "text": "Les marches rompues et disjointes faisaient bascule sous le pied ou n’étaient retenues que par les filaments des mousses et des plantes pariétaires ; sur l’appui de la terrasse avaient crû des joubarbes, des ravenelles et des artichauts sauvages."
                            },
                            {
                                "example_id": "cf846320-985c-4dca-9641-f00e05e8b1c7",
                                "sense_id": "c44ded75-4e92-3519-babd-776720fc65ba",
                                "text": "Les joubarbes en floraison empourpraient les toits de chaume."
                            },
                            {
                                "example_id": "0bf8252b-d564-453f-afcd-8029e5d5ba16",
                                "sense_id": "c44ded75-4e92-3519-babd-776720fc65ba",
                                "text": "Nous devons citer comme curiosité botanique de Mont-Saint-Martin l'énorme touffe de Joubarbe (Sempervivum tectorum), garnissant le linteau de la porte de l'une des maisons du village."
                            },
                            {
                                "example_id": "1fa4cab3-1277-4611-85ff-6c14d3a67876",
                                "sense_id": "c44ded75-4e92-3519-babd-776720fc65ba",
                                "text": "On rapporte que jadis, pour guérir le rhume de cerveau de l’enfant, les mères appliquaient sur les oreilles et les tempes du petit malade des feuilles de joubarde trempées auparavant dans le lait d’une femme qui a un bébé du sexe masculin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "064d228a-0506-410a-b99d-b00e58f49bd9",
                        "source_entry_id": "feb67160-971b-37cc-8c94-0ce11c58fe8e",
                        "source_sense_id": "c44ded75-4e92-3519-babd-776720fc65ba",
                        "target_lang_word": "Hauswurz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hauswurz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                        "entry_id": "61675062-a5b5-3aa6-ab96-9b8761addf4a",
                                        "glosses": [
                                            "Pflanzengattung innerhalb der Familie der Dickblattgewächse; Sempervivum"
                                        ],
                                        "tags": [
                                            "wissenschaftlicher Name"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a2976b3-e9e2-4ffe-af0c-19a01975ffa4",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Hauswurz pflanzen ist für jeden Gartenfreund ein Muss.“"
                                            },
                                            {
                                                "example_id": "67f3e6ca-6270-4f22-b89f-f914cc1b5ab0",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Die Hauswurz verträgt besonders gut heiße und trockene oder besonders kalte Standorte.“"
                                            },
                                            {
                                                "example_id": "9010917c-ee3d-4630-af68-5e15651a45c3",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Ist der Hauswurz vertrocknet ist, müssen Sie ihn nicht gleich wegwerfen.“"
                                            },
                                            {
                                                "example_id": "5e1536a2-744e-4c73-8418-b0c819fce88a",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„‚Auch steinige Bereiche, zum Beispiel neben einer Einfahrt, können mit Steinbrech und Hauswurz bepflanzt werden.‘“"
                                            },
                                            {
                                                "example_id": "3922e32c-2ff8-4c80-a166-a67d261c7a3d",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Quasi unzerstörbar ist die Hauswurz (Sempervivum), nicht ohne Grund auch Steinrose genannt.“"
                                            },
                                            {
                                                "example_id": "bc94b9bb-7db9-42cf-b959-4de13ea7c06e",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Unbedingt anpflanzen sollte man außerdem die Hauswurz Sempervivum tectorum, denn sie schützt bei Gewitter zuverlässig vor dem Blitz.“"
                                            },
                                            {
                                                "example_id": "cf52c541-d37e-43a2-995d-d331d0334897",
                                                "sense_id": "7df98ee5-04d0-3371-b620-8f9d371e9633",
                                                "text": "„Jakob Eschmann senior ist einer der besten Enziankenner der Welt; seine Sammlung von 200 Enzian-Arten, 400 Hauswurzen und über 50 verschiedenen Seidelbasten ist im Mutterland der Gartenkultur, in England, berühmter als in der Schweiz, denn «Alpines» haben dort einen besonderen Stellenwert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e3141f0-76f5-4bb5-b81c-e181ddded70a",
                        "source_entry_id": "feb67160-971b-37cc-8c94-0ce11c58fe8e",
                        "source_sense_id": "c44ded75-4e92-3519-babd-776720fc65ba",
