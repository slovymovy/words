                    {
                        "sense_id": "2604c14b-80fa-335d-a959-0eb237ccff52",
                        "entry_id": "2bc3a084-0816-3ac4-8a79-610c6835a338",
                        "glosses": [
                            "de dag dat men een huwelijk sluit en de bruiloft viert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f338c92f-3532-4c5e-aa52-e5659a697e59",
                                "sense_id": "2604c14b-80fa-335d-a959-0eb237ccff52",
                                "text": "De fotograaf zou aanwezig zijn bij het ochtendritueel van de bruid, de ceremonie, het diner en het feest. Ook zou hij een fotoboek leveren, verschillende grote prints, bewerkte foto's en een cd waarop ze allemaal stonden. Maar toen hun bruiloftsdag begon regende het en was Kilcourse te laat."
                            },
                            {
                                "example_id": "acd22f7b-1e4b-45b0-b5b4-6f0514abb5fe",
                                "sense_id": "2604c14b-80fa-335d-a959-0eb237ccff52",
                                "text": "Weliswaar was het Afrikaanse geld de absolute voorwaarde voor baron Von Freital geweest, tot aan de bruiloftsdag van zijn dochter beschouwde hij zichzelf als haar eigenaar, met dezelfde vanzelfsprekendheid waarmee hij zeilboten en kastelen bezat."
                            }
                        ]
                    }
