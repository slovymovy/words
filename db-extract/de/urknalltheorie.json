                "senses": [
                    {
                        "sense_id": "90c680a4-19f8-3761-a84d-9e075000d378",
                        "entry_id": "59710807-ee92-39bd-a293-be1f9f8b023e",
                        "glosses": [
                            "Konzept zur Beschreibung der Entstehung des Universums durch den Urknall"
                        ],
                        "tags": [
                            "Kosmologie",
                            "Astrophysik"
                        ],
                        "examples": [
                            {
                                "example_id": "ecbc9e1e-4c82-4987-9023-301d7e0d5124",
                                "sense_id": "90c680a4-19f8-3761-a84d-9e075000d378",
                                "text": "Die Urknalltheorie nimmt an, dass das Weltall vor ca. 14 Milliarden Jahren durch einen Urknall entstand."
                            },
                            {
                                "example_id": "40da10a6-a69a-45f9-b410-3dfcb0391540",
                                "sense_id": "90c680a4-19f8-3761-a84d-9e075000d378",
                                "text": "„Die Urknalltheorie bedarf dringend eines Skorpions oder kleinen Mannes mit langem weißen Bart, der zusammengerollt in einer Scheibe liegt.“"
                            },
                            {
                                "example_id": "5fecbd33-a08a-4b1e-b899-3b5320b00b1e",
                                "sense_id": "90c680a4-19f8-3761-a84d-9e075000d378",
                                "text": "„Die Urknalltheorie von der Geschichte des Kosmos zeichnet das naive Bild vom frühen Universum als heißem, homogenem Gas, das ich zunächst skizziert habe, bevor ich Bedenken hinsichtlich der Plausibilität dieser Vorstellung äußerte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
