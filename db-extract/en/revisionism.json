                    },
                    {
                        "translation_id": "70826335-09a8-4324-a435-e450f8d8f907",
                        "source_entry_id": "83d903d4-4934-381c-9080-2ffe96e0b689",
                        "source_sense_description": "advocacy of a revision of some view",
                        "target_lang_word": "Geschichtsrevisionismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschichtsrevisionismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b2f635f-ba5b-3c22-bf4f-6b3e253b1f30",
                                        "entry_id": "2644e094-ce45-3fd8-9668-65d410f1be01",
                                        "glosses": [
                                            "der Versuch, historische Ereignisse entgegen allgemein anerkannter geschichtswissenschaftlicher Darstellungen umzudeuten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4315bde4-436c-4974-9c20-5558b1741c6f",
                                                "sense_id": "1b2f635f-ba5b-3c22-bf4f-6b3e253b1f30",
                                                "text": "„Seit den späten 1970er Jahren wird als Revisionismus aber überwiegend eine illegitime Form des Geschichtsrevisionismus verstanden, die zum Ziel hat, die Geschichtsschreibung zur NS-Zeit und das daraus resultierende negative Geschichtsbild zu Gunsten des Nationalsozialismus zu revidieren, indem dessen Führer entlastet, historische Ereignisse und die sie belegenden Quellen umgewertet, Verbrechen verharmlost, beschönigt, relativiert, gerechtfertigt oder auch ganz oder teilweise bestritten werden.“"
                                            },
                                            {
                                                "example_id": "a62ffce4-5199-445c-9ab5-35674b72b3c6",
                                                "sense_id": "1b2f635f-ba5b-3c22-bf4f-6b3e253b1f30",
                                                "text": "„Geschichtsrevisionismus findet sich nicht nur bei Rechtsextremen, sondern auch bei Rechtspopulisten, der intellektuellen Neuen Rechten und in der Gesamtgesellschaft.“"
                                            },
                                            {
                                                "example_id": "01c9ed15-4c3c-4d2b-ace8-a2d1852cb5f8",
                                                "sense_id": "1b2f635f-ba5b-3c22-bf4f-6b3e253b1f30",
                                                "text": "„Zu den Faktoren, die besondere Subkulturen herausbilden können, gehören vor allem nationale, ethnische, konfessionelle, geschlechterspezifische und generationenbedingte Aspekte - alle diese Aspekte sind jedoch auch für die Herausbildung von Geschichtsrevisionismen wichtig, was den Verdacht verstärkt, daß Interessengruppen in Form von sozialen Bewegungen und Subkulturen in ein gemeinsames Modell einbezogen werden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
