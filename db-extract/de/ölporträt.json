                "senses": [
                    {
                        "sense_id": "c567aa3a-d2d3-3940-8fa4-ed68c6ae882f",
                        "entry_id": "c7b5d4ca-e262-37a7-bdd6-d33eb1ada7cd",
                        "glosses": [
                            "mit Ölfarben gemaltes Porträt"
