                        "entry_id": "9feb2e05-ece3-3aa9-9bd2-6150f8ccb138",
                        "glosses": [
                            "A women's hairstyle in which the hair is swept upwards from the face and worn high over the forehead."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7449a03f-fbd6-345f-a791-6b2547538614",
                        "entry_id": "9feb2e05-ece3-3aa9-9bd2-6150f8ccb138",
                        "glosses": [
                            "A men's hairstyle of the 1950s."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ec59330-72a0-440f-8640-2bc6a507bf39",
                                "sense_id": "7449a03f-fbd6-345f-a791-6b2547538614",
                                "text": "Squat and perspiring, with a low pompadour and a thin black mustache, he was inevitably disheveled by evening."
                            },
                            {
                                "example_id": "71dd45f1-3219-48ef-ac26-bbcd79cb0475",
                                "sense_id": "7449a03f-fbd6-345f-a791-6b2547538614",
                                "text": "The Donald's strange pompadour and Hillary's strange server have eclipsed all the usual primary permutations."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e6e7f82-2f6f-3779-b0e9-d8b2057361d9",
                        "entry_id": "9feb2e05-ece3-3aa9-9bd2-6150f8ccb138",
                        "glosses": [
                            "A crimson or pink colour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a9028e4-732b-41ca-9b97-25c91ebe37ea",
                                "sense_id": "6e6e7f82-2f6f-3779-b0e9-d8b2057361d9",
                                "text": "[…] head, neck, and whole under parts fine but very deep crimson or pompadour-colour […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "0f864fea-1eac-3232-9446-07f138733581",
                        "entry_id": "9feb2e05-ece3-3aa9-9bd2-6150f8ccb138",
                        "glosses": [
                            "A corsage with low square neck."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e29f5966-04f7-302b-a676-ebbcadbe0ccd",
                        "entry_id": "9feb2e05-ece3-3aa9-9bd2-6150f8ccb138",
                        "glosses": [
                            "A pattern for silk, with leaves and flowers in pink, blue, and gold."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ce4c658c-3c7a-3c28-b12a-186eb1760d55",
                        "entry_id": "9feb2e05-ece3-3aa9-9bd2-6150f8ccb138",
                        "glosses": [
                            "A member of the 56th (West Essex) Regiment of Foot, an infantry regiment in the British Army, active from 1755 to 1881."
                        ],
                        "tags": [
                            "UK",
                            "historical",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc32e29b-8861-4612-b24d-17d60403e829",
                        "source_entry_id": "9feb2e05-ece3-3aa9-9bd2-6150f8ccb138",
                        "source_sense_description": "woman's hairstyle",
                        "target_lang_word": "banane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5db1451e-4527-3f3a-b58e-26844c840eed",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Fruit comestible du bananier, baie de forme allongée, d’abord vert puis jaune ponctué de taches noires à maturité, à chair farineuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8358f9-3d53-4d3e-b686-e879c27a94ce",
                                                "sense_id": "5db1451e-4527-3f3a-b58e-26844c840eed",
                                                "text": "Et le Progrès vint, qui l’obligea à mettre dans son étalage des artichauts et des aubergines de France, des pommes étrangères, […] des bananes, des noix aux formes insolites, des « grappes fruits » et des mangues…"
                                            },
                                            {
                                                "example_id": "60668f4d-93f1-47cb-90e2-9be0e8c89c5d",
                                                "sense_id": "5db1451e-4527-3f3a-b58e-26844c840eed",
                                                "text": "Le fait que 82% de la production totale des bananes et 98% des bananes plantain soient consommées dans les cent vingt pays producteurs, souvent à moins de 100 kilomètres du lieu de production, est un indicateur de l’importance majeure en matière de sécurité alimentaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2dae353-b0a0-358b-bbeb-5f35ab97b4c3",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Sacoche fixée à une ceinture et portée sur le ventre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1932de89-b427-4a57-a0ad-554cbf8be7c1",
                                                "sense_id": "f2dae353-b0a0-358b-bbeb-5f35ab97b4c3",
                                                "text": "Plus petite que la banane et extra-plate (comme une grosse ceinture), cette sacoche est bien connue des voyageurs car elle permet de garder les documents importants et l’argent à l’abri sous ses vêtements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffde4326-9fe2-3c26-8b21-e24b577d4618",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Coupe de cheveux que portaient les premiers rockers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65b43ff6-b786-4fd5-801f-e7a3cd72c014",
                                                "sense_id": "ffde4326-9fe2-3c26-8b21-e24b577d4618",
                                                "text": "Tu as pourtant l’air d’un gars costaud, un gars à qui on ne la fait pas, avec ton blouson, tes santiags et ta banane. Un vrai rocker…"
                                            },
                                            {
                                                "example_id": "14f960b1-0068-4248-b032-69b0abe167d3",
                                                "sense_id": "ffde4326-9fe2-3c26-8b21-e24b577d4618",
                                                "text": "Les pieds sur les bras des fauteuils, ils gesticulaient comme des dingues aux sons de « Be bop a lula » et « Tutti frutti » tout en réclamant le peigne (précieuse relique) dont se servait Schmoll pour remettre en place une banane fort secouée."
                                            },
                                            {
                                                "example_id": "c208e546-dffe-4e01-9ef8-475187171f5b",
                                                "sense_id": "ffde4326-9fe2-3c26-8b21-e24b577d4618",
                                                "text": "Nicola aime d'ailleurs beaucoup les Costars, une formation française de l’époque qui mélange la banane rock’n’roll outrancière des Stray Cats avec les tables de la loi édictées par Elvis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77692b1d-4a2c-39b8-8611-ed9ccfb14ab6",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Nigaud, personne ayant une pensée naïve ou idiote."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d07252-235d-4381-9739-2b2f2046e6e2",
                                                "sense_id": "77692b1d-4a2c-39b8-8611-ed9ccfb14ab6",
                                                "text": "Quand elle eut séché ses larmes et ravalé sa morve, Langer, un temps silencieux, éructa d’un tonitruant :\n— Tu m’as cru, hé ! banane ?"
                                            },
                                            {
                                                "example_id": "0125366e-6338-495e-9f39-8e65e4a973fc",
                                                "sense_id": "77692b1d-4a2c-39b8-8611-ed9ccfb14ab6",
                                                "text": "Avec son maillot de bain Zara marron foncé, Mme Zlotorynski ressemblait tout à fait à un canard rôti lentement, et j’étais une sacrée banane de ne pas avoir quitté New York vingt ans plus tôt pour venir m’installer à Miami."
                                            },
                                            {
                                                "example_id": "fa29051c-d2bc-459e-9b60-7f0384e2d387",
                                                "sense_id": "77692b1d-4a2c-39b8-8611-ed9ccfb14ab6",
                                                "text": "Somnambule ou pas, comme il arrive toujours en dernier, c’est lui qui débarrasse la table tous les dimanches matin. Ça lui fait les pieds, à cette banane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1c8ca8e-4e0c-3fde-9ed7-1f9eae609d76",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Mauvaise note."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec84ed22-082e-40b9-aef6-711656a10508",
                                                "sense_id": "e1c8ca8e-4e0c-3fde-9ed7-1f9eae609d76",
                                                "text": "Depuis peu, Jean-François est « en conflit ouvert » avec son père qu’il décrit comme intransigeant, ne manifestant jamais ses émotions, lui interdisant « tout ». […]. « Il suffit que j’obtienne un truc avec ma mère, par exemple sortir avec des copains, pour que mon père s’y oppose si j’ai eu récemment une banane à un devoir. »"
                                            },
                                            {
                                                "example_id": "713c238d-2342-46bc-9091-1049841fc73b",
                                                "sense_id": "e1c8ca8e-4e0c-3fde-9ed7-1f9eae609d76",
                                                "text": "Le gamin s'est pris une banane à l’interro. Du coup, les parents ont le banana spleen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "682704f6-f911-36ea-b107-f6fc7fa621fb",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Oreille."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c345f371-16b9-4bd6-9c55-1a9e21dcf5da",
                                                "sense_id": "682704f6-f911-36ea-b107-f6fc7fa621fb",
                                                "text": "Même votre humour a deux balles, ne peut entamer l’âme, les valeurs et le code de conduite qui existent depuis le long et difficile transfert de Liancourt à Chalons-sur-Marne, Maaaarrrrnnnneee, ça se gueule dans vos bananes d’abrutis inconscients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c464515-6cd3-3eec-9871-3130bdbb2ce5",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Sourire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec9cfbe-2c47-4bd4-aa56-5fe1db1aa0e5",
                                                "sense_id": "7c464515-6cd3-3eec-9871-3130bdbb2ce5",
                                                "text": "Vous ne devriez pas vous en plaindre, commente l’interlocuteur de Mishima, car les affaires ont l’air de drôlement tourner ici…, poursuit-il en regardant autour de lui des quantités de clients qui pénètrent dans le Magasin des Suicides, la banane aux lèvres."
                                            },
                                            {
                                                "example_id": "90b838cc-d485-4f54-b804-e3ae7bc66e2b",
                                                "sense_id": "7c464515-6cd3-3eec-9871-3130bdbb2ce5",
                                                "text": "Quelques gestes techniques bien sentis, deux ou trois accélérations fulgurantes sur le côté gauche et un pénalty transformé et chaleureusement célébré, bras croisés et banane aux lèvres, voilà la copie de l’homme le plus scruté de la planète foot depuis la bombinette lâchée par Marca."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "304395e5-6d30-31d6-8e02-6172b1d14175",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Sexe de l’homme ; pénis."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98fd17e8-156d-4219-8170-7ea6e5905574",
                                                "sense_id": "304395e5-6d30-31d6-8e02-6172b1d14175",
                                                "text": "Rien que d’y penser cela me soulevait l’estomac, j’imaginais les nuits de Chine auprès de lui, en train de tripoter sa banane flasque et récalcitrante pour qu’elle se levât, enfin, au chant du coq […]."
                                            },
                                            {
                                                "example_id": "78e93445-6acf-48f6-8e89-ff190b90a015",
                                                "sense_id": "304395e5-6d30-31d6-8e02-6172b1d14175",
                                                "text": "Angel accélère les mouvements de concombre et lèche les abricots de Julien en même temps, puis lui suce la banane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12619e56-17c8-3f75-9029-b99163d9071c",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Décoration."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bad56c2-be22-45ae-bfe3-781269cd47ab",
                                                "sense_id": "12619e56-17c8-3f75-9029-b99163d9071c",
                                                "text": "Vous en pleuriez d’attendrissement, de reconnaissance, trop heureux qu’il y ait eu cette fameuse petite guerre pour qu’on vous croie apte à quelque chose, et qu’on vous colle deux ou trois bananes sur la poitrine."
                                            },
                                            {
                                                "example_id": "1078b683-e014-461c-9895-e897dc64ab2d",
                                                "sense_id": "12619e56-17c8-3f75-9029-b99163d9071c",
                                                "text": "Par banane, les militaires, les « poilus », désignèrent les décorations, notamment la médaille militaire. Dans l’infanterie de marine, le terme qualifia principalement différentes médailles coloniales. […]. Puis banane fut employé pour n’importe quelle médaille, croix, décoration…"
                                            },
                                            {
                                                "example_id": "63d0e427-85ed-4660-84fc-d8167a0bc4b4",
                                                "sense_id": "12619e56-17c8-3f75-9029-b99163d9071c",
                                                "text": "Que de bananes sur ma poitrine à l’heure du bilan et des décorations, ! Si je n’ai pas la croix de guerre, je ferai un caprice !"
                                            },
                                            {
                                                "example_id": "a5d7999c-4b1d-4607-9838-4dc625839843",
                                                "sense_id": "12619e56-17c8-3f75-9029-b99163d9071c",
                                                "text": "Comme Risso et Albert, je reçois également la Légion d’honneur et la croix de guerre.\n— Les bananes, ici, ça pleut comme à Douala ! lance Albert à la cantonade.\n— À ce rythme-là, on va pas tarder à rattraper les généraux soviétiques, dis-je en prenant une coupe de champagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a3dbf06-f6a3-38c4-a440-43359630f61f",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Surnom donné, à cause de leur forme, aux hélicoptères Piasecki S-21 à double rotor pendant la guerre d’Algérie."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31473c99-ad10-4dfd-a1ee-ff9bb6627108",
                                                "sense_id": "9a3dbf06-f6a3-38c4-a440-43359630f61f",
                                                "text": "Dans la banane volante qui faisait la liaison régulière entre Ténérife et l’héliport Mytiléna, on était une quinzaine de mecs, en uniforme jaune et vert, couronné d’un col rouge."
                                            },
                                            {
                                                "example_id": "7363e640-486c-43c4-9a76-67ffd6d92b6e",
                                                "sense_id": "9a3dbf06-f6a3-38c4-a440-43359630f61f",
                                                "text": "Par le hublot de la banane qui commence sa descente pour nous déposer sur le piton, je vois le sol monter vers nous à une vitesse anormale : cent, cinquante, trente mètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c255b21e-253d-39b6-ad71-31579fa2393a",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Galon de l’uniforme d’un gardien."
                                        ],
                                        "tags": [
                                            "Québec",
                                            "Argot des prisons"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4503bb31-7587-47c1-945d-87144ee77240",
                                                "sense_id": "c255b21e-253d-39b6-ad71-31579fa2393a",
                                                "text": "Quatre barres ornent désormais chaque épaule de mon chemisier, ce que les détenus nomment communément des bananes. Il s’agit du plus haut grade du personnel correctionnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d73589da-be3b-3879-b50f-75536ebd5488",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Personne asiatique ayant vécu longtemps en Occident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aea775ec-9d90-40e3-9321-fe1cd8e54412",
                                                "sense_id": "d73589da-be3b-3879-b50f-75536ebd5488",
                                                "text": "« Comment mon questionnement s’est déroulé ? Chez les Asiatiques de France, on se considère comme des bananes ! Jaunes dehors et blancs dedans. On n’est pas très confortables avec ces choses-là », dit-il en souriant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab3a5fd3-1183-3537-aebc-d746448ef83b",
                                        "entry_id": "5b12b58d-ef37-3e1e-9dcb-62a30cf51486",
                                        "glosses": [
                                            "Type de piercing qui ressemble à une barre légèrement pliée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "banane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce2d594c-5ada-3887-9c46-99f4837e1d7f",
                                        "entry_id": "53b4861c-48b4-3376-9477-c5fc8e4d46b1",
                                        "glosses": [
                                            "Couleur vert bruni profond. #D1B606"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c943904-71c4-40db-8c04-34f376e92d9b",
                                                "sense_id": "ce2d594c-5ada-3887-9c46-99f4837e1d7f",
                                                "text": "Certains auteurs, dont Melzer, signalent la teinte banane, un peu comme chez Turci, que peut prendre l’intérieur du pied de ces russules ; nous avons aussi constaté ce fait, […]."
                                            },
                                            {
                                                "example_id": "38beeceb-7c8e-4ce3-a38a-cd1695ad0f04",
                                                "sense_id": "ce2d594c-5ada-3887-9c46-99f4837e1d7f",
                                                "text": "Depuis une dizaine d’années, à mesure que je les reçois par la poste, j’ai pour habitude de compiler les lettres de refus des maisons d’édition dans un élégant classeur couleur banane."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "banane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dae0cb7c-8761-3886-8d02-b8e8e6c3fd3b",
                                        "entry_id": "e4a19847-1d88-3b0a-8363-a21b39d2ae0a",
                                        "glosses": [
                                            "De couleur banane, d’un vert bruni profond. #D1B606"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a75c64d5-006b-468d-9c3c-91bc4af38273",
                                                "sense_id": "dae0cb7c-8761-3886-8d02-b8e8e6c3fd3b",
                                                "text": "Un sourire agréable et gracieux corrigeait la rudesse qu’un teint banane et des sourcils noirs et épais auraient pu donnera sa physionomie."
                                            },
                                            {
                                                "example_id": "169a11af-dfe8-4bd6-bf36-48b588aa9275",
                                                "sense_id": "dae0cb7c-8761-3886-8d02-b8e8e6c3fd3b",
                                                "text": "La lampe au gros abat-jour de soie, couleur banane, éclairait en plein ce visage las, vieillissant et pensif, aux traits épais et aux yeux tristes."
                                            },
                                            {
                                                "example_id": "1569a67b-8b58-4ccf-ad64-fb97053524df",
                                                "sense_id": "dae0cb7c-8761-3886-8d02-b8e8e6c3fd3b",
                                                "text": "Magalie, chaque fois qu’elle s’admirait devant son long miroir, fantasmait toujours au sujet de son teint banane, dans un narcissisme béat. Toute anomalie sur son maquillage sophistiqué appelait toujours une modification singulière."
                                            }
                                        ]
