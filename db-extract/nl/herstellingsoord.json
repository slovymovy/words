                        "glosses": [
                            "kuuroord waar patiënten tijdelijk verblijven om te herstellen van een aandoening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1a2c817-df54-4210-928e-51c468843ecf",
                                "sense_id": "9f227bbf-0632-39ff-9843-a69576ff9ade",
                                "text": "Een verblijf in zo'n herstellingsoord beschouwde hij als het einde van zijn leven en dat probeerde hij zo lang mogelijk uit te stellen."
                            },
                            {
                                "example_id": "cdb59e36-f5cf-4fc1-b592-e639fd2afed1",
                                "sense_id": "9f227bbf-0632-39ff-9843-a69576ff9ade",
                                "text": "In Nederland zou de inspectie de arts 'scherp in de gaten houden' als hij weer actief zou zijn. Jansen Steur blijkt echter na 2004 aan het werk te zijn gegaan in de kliniek Schlossberg in Bad Laasphe, een ‘neurologische fachklinik’ met herstellingsoord."
                            }
                        ]
