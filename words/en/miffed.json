            "senses": [
                {
                    "sense_id": "c63ffc98-3fb4-3d10-9882-914911ef6d0a",
                    "sense_definition": "Somewhat annoyed, irritated, or offended.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was visibly <w>miffed</w> that nobody had informed her about the meeting.",
                            "target_lang_translations": {
                                "nl": "Ze was zichtbaar <w>op haar tenen getrapt</w> dat niemand haar over de vergadering had geïnformeerd."
                            }
                        },
                        {
                            "text": "It is never wise to argue with someone who is already <w>miffed</w> at you.",
                            "target_lang_translations": {
                                "nl": "Het is nooit verstandig om in discussie te gaan met iemand die al <w>geïrriteerd</w> op je is."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyed",
                        "irritated",
                        "peeved",
                        "piqued"
                    ],
                    "antonyms": [
                        "pleased",
                        "delighted"
                    ],
                    "common_phrases": [
                        "a bit miffed",
                        "slightly miffed",
                        "miffed at",
                        "miffed about"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Enigszins geïrriteerd, gekrenkt of op de tenen getrapt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geïrriteerd",
                                "target_lang_sense_clarification": "licht boos of ontstemd"
                            },
                            {
                                "target_lang_word": "op de tenen getrapt",
                                "target_lang_sense_clarification": "licht beledigd of gekwetst"
                            },
                            {
                                "target_lang_word": "verbolgen",
                                "target_lang_sense_clarification": "misnoegd of ontstemd"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba4415ec-2a43-3b45-a014-dafe2cc6b39c",
                    "sense_definition": "Confused or unable to understand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex instructions left several of the new students completely <w>miffed</w>.",
                            "target_lang_translations": {
                                "nl": "De ingewikkelde instructies lieten verschillende nieuwe studenten volledig <w>in de war</w> achter."
                            }
                        },
                        {
                            "text": "He looked utterly <w>miffed</w> when presented with the unfamiliar technical terms.",
                            "target_lang_translations": {
                                "nl": "Hij keek volkomen <w>verbouwereerd</w> toen hij met de onbekende vaktermen werd geconfronteerd."
                            }
                        }
                    ],
                    "synonyms": [
                        "confused",
                        "baffled",
                        "perplexed"
                    ],
                    "antonyms": [
                        "comprehending",
                        "clearheaded"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "nonstandard or regional"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verward, verbijsterd of niet in staat het te begrijpen."
                    },
                    "translations": {
