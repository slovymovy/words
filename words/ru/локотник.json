{
    "word_family": [
        "локоть",
        "подлокотник",
        "локтевой"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a267a245-3d49-3fdb-a2e1-25d512ee1145",
                    "sense_definition": "Боковая опора у кресла или дивана для упора локтем; подлокотник.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "опора",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он удобно откинулся назад и положил уставшую руку на деревянный <w>локотник</w> кресла.",
                            "target_lang_translations": {
                                "en": "He leaned back comfortably and rested his tired arm on the wooden <w>armrest</w> of the armchair."
                            }
                        },
                        {
                            "text": "Мягкие <w>локотники</w> старого дивана уже заметно потерлись от долгого использования.",
                            "target_lang_translations": {
                                "en": "The soft <w>armrests</w> of the old sofa were already noticeably worn from long use."
                            }
                        }
                    ],
                    "synonyms": [
                        "подлокотник"
                    ],
                    "common_phrases": [
                        "деревянный локотник",
                        "локотник кресла"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A side support on an armchair or sofa designed to rest an elbow on; an armrest."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "armrest",
                                "target_lang_sense_clarification": "on an armchair or sofa"
                            },
                            {
                                "target_lang_word": "elbow rest",
                                "target_lang_sense_clarification": "support for the elbow on furniture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eeae6787-0f1c-386d-9698-7e1eef7b2c2d",
                    "sense_definition": "Верхняя деталь костыля, служащая упором для локтя.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "опора",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пациент отрегулировал <w>локотник</w> костыля по высоте, чтобы опора была максимально удобной.",
                            "target_lang_translations": {
                                "en": "The patient adjusted the height of the crutch's <w>forearm cuff</w> so that the support was as comfortable as possible."
                            }
                        },
                        {
                            "text": "Пластиковый <w>локотник</w> треснул во время долгой прогулки по неровной дороге.",
                            "target_lang_translations": {
                                "en": "The plastic <w>arm cuff</w> cracked during a long walk on an uneven road."
                            }
                        }
                    ],
                    "common_phrases": [
                        "локотник костыля"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The upper part of a crutch that serves as a support or cuff for the elbow or forearm."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forearm cuff",
                                "target_lang_sense_clarification": "on a crutch"
                            },
                            {
                                "target_lang_word": "arm cuff",
                                "target_lang_sense_clarification": "support piece of a crutch"
                            },
                            {
                                "target_lang_word": "elbow support",
                                "target_lang_sense_clarification": "of a crutch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ced22930-42ce-3859-bc33-1c11e15185ac",
                    "sense_definition": "Изогнутая металлическая пластина в составе наруча, защищающая локтевой сустав.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "доспех",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Стальной <w>локотник</w> крепился к наручу с помощью прочных кожаных ремешков.",
                            "target_lang_translations": {
                                "en": "The steel <w>couter</w> was attached to the vambrace using sturdy leather straps."
                            }
                        },
                        {
                            "text": "Мастер тщательно отполировал рыцарский <w>локотник</w>, чтобы он сверкал на солнце.",
                            "target_lang_translations": {
                                "en": "The craftsman carefully polished the knight's <w>elbow guard</w> so that it gleamed in the sun."
                            }
                        }
                    ],
                    "common_phrases": [
                        "стальной локотник"
                    ],
                    "target_lang_definitions": {
                        "en": "A curved metal plate in armor that protects the elbow joint."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "couter",
                                "target_lang_sense_clarification": "armor piece protecting the elbow"
                            },
                            {
                                "target_lang_word": "elbow cop",
                                "target_lang_sense_clarification": "armor plate for the elbow"
                            },
                            {
                                "target_lang_word": "elbow guard",
                                "target_lang_sense_clarification": "historical armor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}