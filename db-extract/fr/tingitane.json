                        "glosses": [
                            "synonyme de Maurétanie tingitane, ancienne province romaine qui entourait la ville actuelle de Tanger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abc8cf43-1f21-4f66-be42-3a9bf22a63fa",
                                "sense_id": "3f6779cf-2879-38b0-a637-4c4b06c7a6a7",
                                "text": "Ajoutons à cela que des colonies juives s’étaient installées en Tingitane."
                            },
                            {
                                "example_id": "2dd8128c-813c-4fe0-81d3-1c8782db091c",
                                "sense_id": "3f6779cf-2879-38b0-a637-4c4b06c7a6a7",
                                "text": "En dehors de son repérage sur l’embouchure de la Moulouya, nous connaissons mal la frontière officielle de la Tingitane et de la Césarienne."
                            },
                            {
                                "example_id": "1b77773a-7e29-4748-9ce3-80ecc469362a",
                                "sense_id": "3f6779cf-2879-38b0-a637-4c4b06c7a6a7",
                                "text": "Le commerce de la Tingitane passait, du moins pour le grand commerce, par les ports de l’Atlantique et de la Méditerrannée."
                            }
                        ]
                    }
