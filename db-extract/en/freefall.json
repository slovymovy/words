                "senses": [
                    {
                        "sense_id": "df203d8a-6030-3cbe-a877-e5af07a2f10e",
                        "entry_id": "341e8632-85ca-33d0-bd77-416dc8940bfa",
                        "glosses": [
                            "A state of motion affected by no acceleration or force other than that of gravity."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f9eae6e9-8617-3f1d-8c1a-66a623d89248",
                        "entry_id": "341e8632-85ca-33d0-bd77-416dc8940bfa",
                        "glosses": [
                            "As above, but allowing for the presence of incidental air resistance not caused intentionally by devices like parachutes or wings."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0a892074-7340-357e-afb7-95f7d58c8724",
                        "entry_id": "341e8632-85ca-33d0-bd77-416dc8940bfa",
                        "glosses": [
                            "The state of worsening out of control."
                        ],
                        "tags": [
                            "broadly",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "28da9870-651f-48f9-aa74-39a1a3c7400a",
                                "sense_id": "0a892074-7340-357e-afb7-95f7d58c8724",
                                "text": "Passenger numbers in freefall as UK battles COVID-19"
                            },
                            {
                                "example_id": "67d259b6-df9c-4ad9-96a0-a86846d8878e",
                                "sense_id": "0a892074-7340-357e-afb7-95f7d58c8724",
                                "text": "Even with the economy in free fall, demand for cheap, cute clothes persisted."
                            },
                            {
                                "example_id": "147b9e17-a572-48cd-b17e-6a8d6518a6cc",
                                "sense_id": "0a892074-7340-357e-afb7-95f7d58c8724",
                                "text": "As civil war continues in Iraq, the U.S. president's approval ratings are in freefall."
                            },
                            {
                                "example_id": "548a48e8-782f-4b90-80ca-04575b7564b7",
                                "sense_id": "0a892074-7340-357e-afb7-95f7d58c8724",
                                "text": "House prices were in freefall, if you owned one."
                            }
                        ]
                    }
