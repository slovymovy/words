                "senses": [
                    {
                        "sense_id": "92f21f9d-e9f5-357c-bc0c-407f280319fd",
                        "entry_id": "5a607e83-c3c0-3ad9-a1a1-2c90857976f1",
                        "glosses": [
                            "заманчивый, соблазнительный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97b95df6-a15c-421c-822f-b5bb19bc21c2",
                                "sense_id": "92f21f9d-e9f5-357c-bc0c-407f280319fd",
                                "text": "Манкая задача естественно вызывает позывы хотения, стремления, оканчивающиеся действием."
                            },
                            {
                                "example_id": "1a1abd10-e019-4525-ac79-66efd45824c1",
                                "sense_id": "92f21f9d-e9f5-357c-bc0c-407f280319fd",
                                "text": "Я считаю, что картина зрительская, и мы старались «вести» её чуть ниже, специально не гасили некоторые эмоции, манкие для зрителя."
                            }
                        ]
                    }
