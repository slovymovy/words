                {
                    "sense_id": "ff30f253-6336-3b50-9c98-630c4d6dc21f",
                    "sense_definition": "in een goede en stabiele verhouding staand",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "balans",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was een <w>evenwichtig</w> dieet samengesteld dat ervoor zorgde dat alle vitaminen in voldoende mate binnenkwamen.",
                            "target_lang_translations": {
                                "en": "A <w>balanced</w> diet had been put together that ensured all vitamins were consumed in sufficient quantities.",
                                "fr": "Un régime <w>équilibré</w> avait été élaboré pour garantir un apport suffisant en toutes les vitamines."
                            }
                        },
                        {
                            "text": "Een <w>evenwichtige</w> verdeling van de taken zorgt voor minder stress op de werkvloer.",
                            "target_lang_translations": {
                                "en": "A <w>balanced</w> distribution of tasks ensures less stress in the workplace.",
                                "fr": "Une répartition <w>équilibrée</w> des tâches permet de réduire le stress au travail."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitgewogen",
                        "gebalanceerd"
                    ],
                    "antonyms": [
                        "onevenwichtig"
                    ],
                    "common_phrases": [
                        "evenwichtige verdeling",
                        "evenwichtig dieet",
                        "evenwichtige opbouw"
                    ],
                    "target_lang_definitions": {
                        "en": "being in a good and stable proportion or balance",
                        "fr": "qui est dans une bonne proportion stable et harmonieuse"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "balanced",
                                "target_lang_sense_clarification": "in terms of proportions or components"
                            },
                            {
                                "target_lang_word": "well-balanced",
                                "target_lang_sense_clarification": "having all parts in the right amount"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "équilibré",
                                "target_lang_sense_clarification": "pour des proportions, un régime ou une répartition"
                            },
                            {
                                "target_lang_word": "harmonieux",
                                "target_lang_sense_clarification": "qui a de bonnes proportions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f02b4cb6-132c-3635-8a6c-dcd5c1fdd4d9",
                    "sense_definition": "geestelijk stabiel en niet snel uit het veld geslagen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persoonlijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij is een <w>evenwichtig</w> persoon die altijd rustig blijft tijdens een crisis.",
                            "target_lang_translations": {
                                "en": "She is a <w>balanced</w> person who always remains calm during a crisis.",
                                "fr": "C'est une personne <w>équilibrée</w> qui reste toujours calme en temps de crise."
                            }
                        },
                        {
                            "text": "Ondanks de grote druk bleef hij een <w>evenwichtige</w> indruk maken op zijn collega's.",
                            "target_lang_translations": {
                                "en": "Despite the great pressure, he continued to make a <w>level-headed</w> impression on his colleagues.",
                                "fr": "Malgré la forte pression, il continuait de donner une impression <w>posée</w> à ses collègues."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebalanceerd"
                    ],
                    "antonyms": [
                        "onevenwichtig"
                    ],
                    "common_phrases": [
                        "evenwichtig persoon",
                        "evenwichtig karakter"
                    ],
                    "target_lang_definitions": {
                        "en": "mentally stable and not easily upset or discouraged",
                        "fr": "mentalement stable et pas facilement déstabilisé"
                    },
                    "translations": {
