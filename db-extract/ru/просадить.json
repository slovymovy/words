                        "entry_id": "7887782a-dcfb-348c-b3d3-a575ca4b0894",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "просади́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc253ff3-c0fe-3568-9a30-18e29a5b94aa",
                        "entry_id": "7887782a-dcfb-348c-b3d3-a575ca4b0894",
                        "glosses": [
                            "разг. пробить, проломить, проколоть с размаху"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c86ac2-d38e-4360-9002-be9787d2f890",
                                "sense_id": "cc253ff3-c0fe-3568-9a30-18e29a5b94aa",
                                "text": "Змий три раза лизнул дверь, а в четвертый раз просадил язык насквозь."
                            },
                            {
                                "example_id": "1cece1e1-930a-4edd-85a8-1e200681b4a3",
                                "sense_id": "cc253ff3-c0fe-3568-9a30-18e29a5b94aa",
                                "text": "И Ганин одним бешеным прыжком кинулся к окну, просадил спиною хряснувшее стекло, ввалился в ледяную мглу и с размаху ударился головой в чью-то крепкую грудь, которая ёкнула от толчка."
                            },
                            {
                                "example_id": "9fd95070-5d5f-437d-846e-e92fb010655e",
                                "sense_id": "cc253ff3-c0fe-3568-9a30-18e29a5b94aa",
                                "text": "Кулику нашему просадили намедни ногу. Так две версты в гору прополз, винтовку не бросил и не пикнул даже."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8b29626-1397-391f-aeb3-825b9c056069",
                        "entry_id": "7887782a-dcfb-348c-b3d3-a575ca4b0894",
                        "glosses": [
                            "разг. израсходовать, истратить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c8edbb-73c2-4fc3-be4f-7b4287dc646d",
                                "sense_id": "c8b29626-1397-391f-aeb3-825b9c056069",
                                "text": "― Все давешнее проиграла и двенадцать тысяч гульденов своих просадила."
                            },
                            {
                                "example_id": "515d3807-670c-48de-8fbd-948f7d169197",
                                "sense_id": "c8b29626-1397-391f-aeb3-825b9c056069",
                                "text": "Один говорит: я двадцать пять тысяч на неё просадил, зато знаю, что она мне верна!"
                            },
                            {
                                "example_id": "43453974-65b3-47f7-b72a-89e8b444e77f",
                                "sense_id": "c8b29626-1397-391f-aeb3-825b9c056069",
                                "text": "Всё им отдал, всё на них просадил, а что получил?"
                            }
                        ]
                    }
                ],
