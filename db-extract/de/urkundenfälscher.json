                        "examples": [
                            {
                                "example_id": "2236629d-8d47-4ec5-a427-9aaf7db8e5ff",
                                "sense_id": "ee986e53-48fe-365d-97a3-2245fc32340b",
                                "text": "Der Urkundenfälscher konnte von der Polizei ausfindig gemacht und verhaftet werden."
                            },
                            {
                                "example_id": "d2dfc48c-c03c-4787-b6ea-52cb71e68d87",
                                "sense_id": "ee986e53-48fe-365d-97a3-2245fc32340b",
                                "text": "„Hunderttausende Steuerhinterzieher, Kleinbetrüger, Diebe, Körperverletzer, Verleumder, Versicherungsbetrüger, Urkundenfälscher erfahren jährlich, wovon ich spreche. Sie alle machen es wie Edathy: Sie zahlen, geben nichts zu, schweigen und sind erleichtert.“"
                            }
                        ],
