{
    "word_family": [
        "eigen",
        "eigendom",
        "eigenaar",
        "toeëigenen",
        "eigenen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f271228-01a2-37ae-a740-8ae3d26a6988",
                    "sense_definition": "Datgene wat kenmerkend of typerend is voor een bepaalde persoon, zaak of streek.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakteristiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>eigene</w> van deze streek gaat met de komst van de industrie helaas verloren.",
                            "target_lang_translations": {
                                "en": "The <w>uniqueness</w> of this region is unfortunately being lost with the arrival of industry."
                            }
                        },
                        {
                            "text": "Zij probeert in haar kunstwerken altijd het <w>eigene</w> van de menselijke natuur te vangen.",
                            "target_lang_translations": {
                                "en": "In her artworks, she always tries to capture the <w>essence</w> of human nature."
                            }
                        }
                    ],
                    "synonyms": [
                        "karakteristieke",
                        "typische"
                    ],
                    "common_phrases": [
                        "het eigene van"
                    ],
                    "target_lang_definitions": {
                        "en": "That which is characteristic, unique, or typical of a particular person, thing, or region."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "uniqueness",
                                "target_lang_sense_clarification": "distinctive character"
                            },
                            {
                                "target_lang_word": "characteristic nature",
                                "target_lang_sense_clarification": "what is typical"
                            },
                            {
                                "target_lang_word": "essence",
                                "target_lang_sense_clarification": "intrinsic nature"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44125654-4226-30fb-87b1-0bbe7930da45",
                    "sense_definition": "Datgene wat iemands persoonlijk bezit of eigendom is.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bezit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij verkocht zowel het huis van zijn ouders als het <w>eigene</w>.",
                            "target_lang_translations": {
                                "en": "He sold both his parents' house and his <w>own</w>."
                            }
                        },
                        {
                            "text": "Men moet het <w>eigene</w> goed beschermen tegen diefstal.",
                            "target_lang_translations": {
                                "en": "One must protect one's <w>own property</w> well against theft."
                            }
                        }
                    ],
                    "synonyms": [
                        "eigendom",
                        "bezit"
                    ],
                    "common_phrases": [
                        "het eigene"
                    ],
                    "target_lang_definitions": {
                        "en": "That which is one's personal property or possession."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "own property",
                                "target_lang_sense_clarification": "personal belongings"
                            },
                            {
                                "target_lang_word": "own",
                                "target_lang_sense_clarification": "what belongs to oneself"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4772101-d9de-33eb-a3cd-980f845c2146",
                    "sense_definition": "Aanvoegende wijs van het werkwoord <w>eigenen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>eigene</w> hem niet om zo te spreken tegen zijn meerderen.",
                            "target_lang_translations": {
                                "en": "May it not <w>befit</w> him to speak to his superiors in such a manner."
                            }
                        },
                        {
                            "text": "God <w>eigene</w> hem de kracht toe om deze zware taak te volbrengen.",
                            "target_lang_translations": {
                                "en": "May God <w>grant</w> him the strength to accomplish this difficult task."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "De aanvoegende wijs (conjunctief) is verouderd in het modern Nederlands."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Subjunctive form of the verb 'eigenen' (to befit, to suit, or to appropriate)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "befit",
                                "target_lang_sense_clarification": "subjunctive: may it befit"
                            },
                            {
                                "target_lang_word": "appropriate",
                                "target_lang_sense_clarification": "subjunctive: may one attribute/appropriate"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}