                "senses": [
                    {
                        "sense_id": "934f0fde-b6d4-399e-879f-e5946657bab6",
                        "entry_id": "db465f82-dd0b-30aa-bd8b-f65fb4c84902",
                        "glosses": [
                            "langes schmales Holzbrett, das Teil eines Fußbodens ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0da90d89-18ea-4b68-a1af-890aef137a16",
                                "sense_id": "934f0fde-b6d4-399e-879f-e5946657bab6",
                                "text": "„Nach Abtrocknen der Dielenbretter wurde der Fußboden mit Bohnerwachs versehen und danach mit einem Bohnerbesen glatt poliert.“"
                            },
                            {
                                "example_id": "42e7d952-1faa-497c-9f82-1b55b4135b3e",
                                "sense_id": "934f0fde-b6d4-399e-879f-e5946657bab6",
                                "text": "„Schon holte er sein Vergrößerungsglas und ein Maßband heraus und suchte auf den Knien eilig den Raum ab, maß, verglich und prüfte, wobei er mit seiner langen Nase fast auf die Dielenbretter stieß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c395de88-5047-48c1-be26-4bdcf0c48d12",
                        "source_entry_id": "db465f82-dd0b-30aa-bd8b-f65fb4c84902",
                        "source_sense_id": "934f0fde-b6d4-399e-879f-e5946657bab6",
                        "source_sense_description": "langes schmales Holzbrett, das Teil eines Fußbodens ist",
                        "target_lang_word": "floorboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "floorboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b024a60a-84d7-3bd4-8f49-d77279d083fd",
                                        "entry_id": "b5d8c31b-7607-32d9-9a05-7d3357e4e392",
                                        "glosses": [
                                            "Any of the long boards laid over joists to make a floor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "678287cd-f8a3-4c16-b304-9acbc6d6c820",
                                                "sense_id": "b024a60a-84d7-3bd4-8f49-d77279d083fd",
                                                "text": "There was a rat that lived under our duplex. […] It went in and out through a broken floorboard in the porch, and into our kitchens, but we didn’t believe in killing it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfa57164-c895-3287-a56c-dff91f5c725d",
                                        "entry_id": "b5d8c31b-7607-32d9-9a05-7d3357e4e392",
                                        "glosses": [
                                            "The floor of a car."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743496f5-330c-44c5-9167-598632bb7d6e",
                                                "sense_id": "bfa57164-c895-3287-a56c-dff91f5c725d",
                                                "text": "The officers said they found two rifles in the car, one on the front floorboard of the vehicle and another on the rear floorboard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "floorboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aed59d3e-985e-3fa9-8fa1-411e86c9ed7e",
                                        "entry_id": "c384fd2d-d6a7-3471-a72b-ea0a9b43edc3",
                                        "glosses": [
                                            "To sink the gas pedal into the floorboard of the car, in order to bring the car to the highest possible speed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b803e9e4-2a7e-45d3-84b3-fc6d8a275e54",
                                                "sense_id": "aed59d3e-985e-3fa9-8fa1-411e86c9ed7e",
                                                "text": "I floorboarded the gas pedal and cut over sharply to the right, threatening the Cadillac's fenders and its driver's life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
