                                        "examples": [
                                            {
                                                "example_id": "b3c604e6-ca4a-4135-848e-bba08f78ebc9",
                                                "sense_id": "c000f507-e463-3db9-a26f-cc4dd14ee749",
                                                "text": "They supposed that they had seene those most beutyfull Dryades, or the natyue nymphes or fayres of the fountaynes whereof the antiques spake so muche."
                                            },
                                            {
                                                "example_id": "2b36295b-6c06-4ee1-b08d-035144d0affb",
                                                "sense_id": "c000f507-e463-3db9-a26f-cc4dd14ee749",
                                                "text": "Wee eas'ly limme, some louely-Virgin face, / And can to life, a Lantscip represent, / Afford to Antiques, each his proper grace, / Or trick out this, or that compartement : / […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da45911-0b4f-3a03-9658-fdd2d270a2b6",
                                        "entry_id": "774770d7-7257-3dab-b23d-b2a851ff439f",
                                        "glosses": [
                                            "A style of type of thick and bold face in which all lines are of equal or nearly equal thickness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afbe1827-8dcc-389e-a083-3eaa3e6ca753",
                                        "entry_id": "774770d7-7257-3dab-b23d-b2a851ff439f",
                                        "glosses": [
                                            "Synonym of antic, specifically:",
                                            "Grotesque entertainment; an antic."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "018a5402-63c6-4702-b21a-2ac7826232ad",
                                                "sense_id": "afbe1827-8dcc-389e-a083-3eaa3e6ca753",
                                                "text": "[…] I do implore secretie, that the King would haue me present the Princesse (sweete chuck) with some delightfull ostentation, or show, or pageant, or antique, or fierworke : […]"
                                            }
                                        ]
                                    },
                                    {
