{
    "word_family": [
        "zoom",
        "zoomlens"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39074cf1-6570-31a8-b002-68687a51262a",
                    "sense_definition": "Met een camera of lens een beeld dichterbij halen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "optiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fotograaf <w>zoomt</w> in op de vogel in de boom.",
                            "target_lang_translations": {
                                "ru": "Фотограф <w>приближает</w> птицу на дереве."
                            }
                        },
                        {
                            "text": "Je kunt met deze camera heel ver <w>inzoomen</w>.",
                            "target_lang_translations": {
                                "ru": "С этой камерой можно очень сильно <w>приблизить</w> изображение."
                            }
                        }
                    ],
                    "antonyms": [
                        "uitzoomen"
                    ],
                    "common_phrases": [
                        "ver inzoomen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приближать изображение с помощью камеры или объектива."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приближать",
                                "target_lang_sense_clarification": "увеличивать масштаб изображения"
                            },
                            {
                                "target_lang_word": "зумировать",
                                "target_lang_sense_clarification": "использовать функцию зума"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fffbbd03-7e51-384b-9f67-2636b7bd13ce",
                    "sense_definition": "Iets nauwkeuriger of in meer detail bekijken of bespreken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laten we nu <w>inzoomen</w> op de details van dit plan.",
                            "target_lang_translations": {
                                "ru": "Давайте теперь <w>детально рассмотрим</w> подробности этого плана."
                            }
                        },
                        {
                            "text": "De journalist <w>zoomde</w> in op de oorzaken van het probleem.",
                            "target_lang_translations": {
                                "ru": "Журналист <w>сосредоточился на</w> причинах этой проблемы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inzoomen op"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассматривать или обсуждать что-либо более детально или внимательно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детально рассматривать",
                                "target_lang_sense_clarification": "изучать подробности"
                            },
                            {
                                "target_lang_word": "сосредоточиться на",
                                "target_lang_sense_clarification": "уделить особое внимание чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}