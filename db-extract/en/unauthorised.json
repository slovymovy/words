                        "examples": [
                            {
                                "example_id": "7c5b7b10-7f6d-4817-9c76-093fa8c62233",
                                "sense_id": "d637f5c4-a9ea-3f87-aad9-826e7df5d44c",
                                "text": "A dozen similar, but smaller footwarmers were made at Doncaster, without official sanction, and placed in the coaches of a train conveying some of the directors to London. Sturrock was taken to task by the chairman for having incurred this unauthorised expenditure, but before he left the meeting, the directors had ordered 200 footwarmers for public use."
                            },
                            {
                                "example_id": "80cb68d1-20fa-4d1f-bf14-8977b8bb52b2",
                                "sense_id": "d637f5c4-a9ea-3f87-aad9-826e7df5d44c",
                                "text": "Indeed, the day before Farage was milkshaked, Leave EU issued an unauthorised, and now withdrawn, re-edit of a Beastie Boys video, showing him and Ann Widdecombe pouring beer over their political opponents."
                            },
                            {
                                "example_id": "0cc10509-1917-4e80-8857-494ccbb966f1",
                                "sense_id": "d637f5c4-a9ea-3f87-aad9-826e7df5d44c",
                                "text": "[...] the fence provided by NR was substandard and poorly maintained, such that unauthorised access to the railway was straightforward."
                            }
                        ]
                    }
