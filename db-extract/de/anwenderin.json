                                        "entry_id": "5b2db9e1-df04-3a65-ac83-012897ce6cf2",
                                        "glosses": [
                                            "An exploiter, an abuser (a person who exploits others, that is treats and regards people unfairly, selfishly or unethically)."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
