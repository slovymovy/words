                ],
                "senses": [
                    {
                        "sense_id": "a4bb9477-3b02-3a28-9408-3c385125a49c",
                        "entry_id": "c5d15075-5a0a-3d29-ac54-e6f20c74980a",
                        "glosses": [
                            "leichte Holzsorte von geringerer Dichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "133c5e65-0d99-455d-96d6-c43d6c0c17b2",
                                "sense_id": "a4bb9477-3b02-3a28-9408-3c385125a49c",
                                "text": "„Nach Angaben des Handelsministeriums fuhren die Vereinigten Staaten im vergangenen Jahr Weichholz aus Kanada im Wert von 5,6 Milliarden Dollar ein.“"
                            },
                            {
                                "example_id": "48f08113-2799-4414-993c-f51a53e35f65",
                                "sense_id": "a4bb9477-3b02-3a28-9408-3c385125a49c",
                                "text": "„Imprägniertes Weichholz hält auch nicht lange, und T-Profile aus Stahl sind zwar einfach zu montieren, sie verbiegen aber leicht.“"
                            },
                            {
                                "example_id": "0a81196e-20c9-4ea3-be3b-45bf2b0530cf",
                                "sense_id": "a4bb9477-3b02-3a28-9408-3c385125a49c",
                                "text": "„Mit abgenagten Bäume entstünden keine Kosten, da es sich um Weichhölzer wie Weiden oder Zitterpappeln handele, die wirtschaftlich nicht interessant seien.“"
                            },
                            {
                                "example_id": "ae8381af-b744-41b6-b646-8e9c998b23a3",
                                "sense_id": "a4bb9477-3b02-3a28-9408-3c385125a49c",
                                "text": "„Im Ofen brennen Nadel- und Weichhölzer wie Kiefer und Fichte heller, erzeugen aber auch weniger Energie.“"
                            },
                            {
                                "example_id": "7f33ba30-76b6-4900-bbcd-04ffa17538f8",
                                "sense_id": "a4bb9477-3b02-3a28-9408-3c385125a49c",
                                "text": "„Offenbar ist die Grenze zwischen beiden rein willkürlich und eine Holzart wie die Eiche kann unter Umständen mit 0:55 specifischem Trockengewicht zum Weichholze, die Brockenfichte mit 0:80 und mehr zu Hartholz gerechnet werden müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd658033-aa1b-4ede-b2e1-59d87f4245c8",
                        "source_entry_id": "c5d15075-5a0a-3d29-ac54-e6f20c74980a",
                        "source_sense_id": "a4bb9477-3b02-3a28-9408-3c385125a49c",
                        "source_sense_description": "leichte Holzsorte von geringerer Dichte",
                        "target_lang_word": "softwood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "softwood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb9966a2-b63d-3aca-a917-35c94cbaa786",
                                        "entry_id": "f10ede27-b898-342e-afcc-f911bc394d41",
                                        "glosses": [
                                            "The wood from any gymnosperm, without regard to how soft this wood is."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7d72bd7-262f-4c31-b123-0936f442e28b",
                                                "sense_id": "fb9966a2-b63d-3aca-a917-35c94cbaa786",
                                                "text": "The bodies are sheeted in softwood, a double layer of ⅝-in. boards on the quarters, with a single thickness lining inside the steel ends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6948446-9c79-3e45-9890-151a4af6260e",
                                        "entry_id": "f10ede27-b898-342e-afcc-f911bc394d41",
                                        "glosses": [
                                            "Wood of this kind, but limited to those that are commercial timbers."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "417ff4ca-0f1a-3c3d-8b54-4e2a796c40dc",
                                        "entry_id": "f10ede27-b898-342e-afcc-f911bc394d41",
                                        "glosses": [
                                            "The tree or tree species that yields this wood."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc8e719e-f8f4-41db-b2b7-2892a3eb3d83",
                                                "sense_id": "417ff4ca-0f1a-3c3d-8b54-4e2a796c40dc",
                                                "text": "SYP is a softwood, but it is harder than many hardwoods."
                                            },
                                            {
                                                "example_id": "1e233252-f040-437f-947c-cbed1fb59da3",
                                                "sense_id": "417ff4ca-0f1a-3c3d-8b54-4e2a796c40dc",
                                                "text": "This softwood has been planted extensively throughout Scotland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63007bc8-2544-339f-8883-47946abe3e1f",
                                        "entry_id": "f10ede27-b898-342e-afcc-f911bc394d41",
                                        "glosses": [
                                            "Any commercial timber."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a9344b-d1ad-4eae-ac80-97baaf01dcb5",
                                                "sense_id": "63007bc8-2544-339f-8883-47946abe3e1f",
                                                "text": "You should have used softwood for the frame of this shed, instead of overbuilding it like this."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
