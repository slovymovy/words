    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "aaeb3de3-602e-3d5f-bc91-19fbb248e06a",
                "word": "spume",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5d529c68-6c7c-4631-a7b0-1cf685c7bf87",
                        "entry_id": "aaeb3de3-602e-3d5f-bc91-19fbb248e06a",
                        "tags": [
                            "plural"
                        ],
                        "form": "spumes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "335415ce-11bb-3477-808c-5956707444af",
                        "entry_id": "aaeb3de3-602e-3d5f-bc91-19fbb248e06a",
                        "glosses": [
                            "Foam or froth of liquid, particularly that of seawater."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8a7996f5-7c50-4653-aa4a-e828910488e7",
                                "sense_id": "335415ce-11bb-3477-808c-5956707444af",
                                "text": "Materials dark and crude, / Of spiritous and fiery spume."
                            },
                            {
                                "example_id": "ce753b19-75c7-4663-912b-00f4a9194126",
                                "sense_id": "335415ce-11bb-3477-808c-5956707444af",
                                "text": "No sluggish tide congenial to the glooms; / This, as it frothed by, might have been a bath / For the fiend's glowing hoof - to see the wrath / Of its black eddy bespate with flakes and spumes."
                            },
                            {
                                "example_id": "15dfcbd1-11da-4679-8304-bf89488c4986",
                                "sense_id": "335415ce-11bb-3477-808c-5956707444af",
                                "text": "The desert storm was riding in its strength; the travellers lay beneath the mastery of the fell simoom.[…]Roaring, leaping, pouncing, the tempest raged about the wanderers, drowning and blotting out their forms with sandy spume."
                            },
                            {
                                "example_id": "d07799a2-cd86-44c5-bf45-dabbaae054e0",
                                "sense_id": "335415ce-11bb-3477-808c-5956707444af",
                                "text": "Their breath froze in the air as it left their mouths, spouting forth in spumes of vapour that settled upon the hair of their bodies and formed into crystals of frost."
                            },
                            {
                                "example_id": "70c065ef-76e5-4c23-aaa8-613d021d24fb",
                                "sense_id": "335415ce-11bb-3477-808c-5956707444af",
                                "text": "The village itself is built on a ridge above the harbour, rows of sturdy cottages over which spume is hurled by easterly gales."
                            },
                            {
                                "example_id": "847cd6e3-50cc-4e89-8e91-8733d0679c44",
                                "sense_id": "335415ce-11bb-3477-808c-5956707444af",
                                "text": "A strong sea wind lashed at his city suit, salt rain stung his eyes, balls of spume skimmed across his path."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05bbda38-aa38-4c9c-9b97-0c58701d5e7e",
                        "source_entry_id": "aaeb3de3-602e-3d5f-bc91-19fbb248e06a",
                        "source_sense_id": "335415ce-11bb-3477-808c-5956707444af",
                        "source_sense_description": "foam of sea water",
                        "target_lang_word": "zeeschuim",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
