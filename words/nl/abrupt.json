                    "frequency": "Middle",
                    "semantic_group_id": "plotseling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto voor ons stopte <w>abrupt</w> voor het rode stoplicht.",
                            "target_lang_translations": {
