                "senses": [
                    {
                        "sense_id": "e56302a7-aa10-38d0-8879-bdb2ba470b6c",
                        "entry_id": "4c80fe4e-c0e3-398b-b53e-adc02b5e8f54",
                        "glosses": [
                            "kleiner Hügel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2092bdf9-5452-495d-8113-33828abf86cd",
                                "sense_id": "e56302a7-aa10-38d0-8879-bdb2ba470b6c",
                                "text": "„Ein Grenzer verfolgt eine flüchtige Schleuserin, hastet entlang zauberhaft funkelnder Lichtungen und Hügelchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65dea578-1f14-489a-9e7f-11b192e84b2d",
                        "source_entry_id": "4c80fe4e-c0e3-398b-b53e-adc02b5e8f54",
                        "source_sense_id": "e56302a7-aa10-38d0-8879-bdb2ba470b6c",
                        "source_sense_description": "kleiner Hügel",
                        "target_lang_word": "hillock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hillock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4277fbbb-7cf0-3256-96fa-dcc86ef25422",
                                        "entry_id": "ac377b6a-db08-34fc-81a8-6f895d6e84e4",
                                        "glosses": [
                                            "A small hill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befee3e6-3019-45fb-8c7c-9d1573c1ce34",
                                                "sense_id": "4277fbbb-7cf0-3256-96fa-dcc86ef25422",
                                                "text": "As he rounded a hillock, he perceived that the roadway was now a crying mass of wagons, teams, and men."
                                            },
                                            {
                                                "example_id": "6ab28da0-0ee7-44f6-bed8-bbd29af82b3d",
                                                "sense_id": "4277fbbb-7cf0-3256-96fa-dcc86ef25422",
                                                "text": "With the setting sun sending long shadows loping ahead of them over the smooth hillocks of the downs, they came up with the lagoon; a contentful return home, with appetite brisked up by a ten-mile walk, and plenty of food to satisfy it."
                                            },
                                            {
                                                "example_id": "63433fe7-b29a-42cd-9f24-05e71f8c8ad2",
                                                "sense_id": "4277fbbb-7cf0-3256-96fa-dcc86ef25422",
                                                "text": "Just upstream of Dryburgh Abbey, a reproduction of a classical Greek temple stands at the top of a wooded hillock on the river’s north bank."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38c798c8-6f6f-4ac5-9985-9191a81014e9",
                        "source_entry_id": "4c80fe4e-c0e3-398b-b53e-adc02b5e8f54",
                        "source_sense_id": "e56302a7-aa10-38d0-8879-bdb2ba470b6c",
                        "source_sense_description": "kleiner Hügel",
                        "target_lang_word": "knoll",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knoll",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55a87d73-bc5a-357b-b0b4-098b4d453dae",
                                        "entry_id": "a8a0d211-737d-318e-9f55-2b58adf9ac01",
                                        "glosses": [
                                            "A small mound or rounded hill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c546774-1a45-4e31-893b-57375d2a5e71",
                                                "sense_id": "55a87d73-bc5a-357b-b0b4-098b4d453dae",
                                                "text": "On knoll or hillock rears his crest, / Lonely and huge, the giant oak."
                                            },
                                            {
                                                "example_id": "ce67ff33-4a22-4db3-9007-d539b7a02561",
                                                "sense_id": "55a87d73-bc5a-357b-b0b4-098b4d453dae",
                                                "text": "In the northern hemisphere, June 21 has the most daylight hours. Pack a picnic—a chilled bottle of Sancerre, cheese, olives, and a nice baguette—and hit the grassy knoll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "984c20a7-1a21-3f08-8f5e-3145dab0e6c9",
                                        "entry_id": "a8a0d211-737d-318e-9f55-2b58adf9ac01",
                                        "glosses": [
                                            "A rounded, underwater hill with a prominence of less than 1,000 metres, which does not breach the water's surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knoll",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b77305e2-5ecd-3879-aab3-7596bfdf7884",
                                        "entry_id": "f415d580-4b70-3e27-a81b-bbc88cb9e44b",
                                        "glosses": [
                                            "A knell."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knoll",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "998cc4ab-fcef-3aef-b040-96d7e99f0922",
                                        "entry_id": "a0f3a457-6c3a-35c2-b5ab-527e3a98f196",
                                        "glosses": [
                                            "To ring (a bell) mournfully; to knell."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf01c4db-c6f8-3851-9735-73aa7f7a278c",
                                        "entry_id": "a0f3a457-6c3a-35c2-b5ab-527e3a98f196",
                                        "glosses": [
                                            "To sound (something) like a bell; to knell."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3bba12a-c548-4a17-98f5-1041ae7ff8fa",
                                                "sense_id": "cf01c4db-c6f8-3851-9735-73aa7f7a278c",
                                                "text": "If ever been where bells have knoll'd to church."
                                            },
                                            {
                                                "example_id": "61cc8b42-d45f-4598-a728-83c050deb387",
                                                "sense_id": "cf01c4db-c6f8-3851-9735-73aa7f7a278c",
                                                "text": "For a departed being's soul / The death hymn peals, and the hollow bells knoll: [...]"
                                            },
                                            {
                                                "example_id": "c0e48326-c6e2-46d2-806e-01d7a81c4579",
                                                "sense_id": "cf01c4db-c6f8-3851-9735-73aa7f7a278c",
                                                "text": "[A]ll that night I heard / The heavy clocks knolling the drowsy hours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "123424c1-2d35-3eb7-8559-5d201722ecad",
                                        "entry_id": "a0f3a457-6c3a-35c2-b5ab-527e3a98f196",
                                        "glosses": [
                                            "To call (someone, to church) by sounding or making a knell (as a bell, a trumpet, etc)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c31c86-1e38-49cf-b5b1-d567cc7e6c4f",
                                                "sense_id": "123424c1-2d35-3eb7-8559-5d201722ecad",
                                                "text": "Their office now was to guide the monster choruses and Sunday hymns; and like the trumpets of silver made of a whole piece “for the calling of the assembly, and for the journeying of the camps,” to knoll the people in to church."
                                            },
                                            {
                                                "example_id": "7e50fb35-14c3-4392-a4d0-fe89361806a0",
                                                "sense_id": "123424c1-2d35-3eb7-8559-5d201722ecad",
                                                "text": "The parishioners were not, however, to be permanently deprived of this means of grace, and for many a year they have been “knolled to church” by the bells of the Town Hall, a comely building […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "knoll",
                                "target_lang_code": "en",
                                "target_senses": [
