                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed15af25-e7d4-4fd3-a5c3-f0e1feebbf5b",
                        "source_entry_id": "615be25b-a165-30d6-ae2d-917bdc6fc9e1",
                        "source_sense_id": "32b6fe13-a456-3f65-b005-657d654a5971",
                        "source_sense_description": "een driewielige fiets die voorzien is van een laadbak",
                        "target_lang_word": "Lieferfahrrad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0a5178ac-51fd-4dc8-b014-e9e7a3d46a30",
                        "source_entry_id": "615be25b-a165-30d6-ae2d-917bdc6fc9e1",
                        "source_sense_id": "32b6fe13-a456-3f65-b005-657d654a5971",
                        "source_sense_description": "een driewielige fiets die voorzien is van een laadbak",
                        "target_lang_word": "cargo bike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cargo bike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b0e9c8d-2e45-37cc-b321-fb5bc4968d7b",
                                        "entry_id": "1bc5d141-6154-3fbd-b842-5f748fdc3d04",
                                        "glosses": [
                                            "A bicycle designed for carrying large or heavy loads; by extension, any other pedal cycle such as a tricycle or quadricycle designed in this way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80bc5d6f-6778-4e32-bf08-10b459882972",
                                                "sense_id": "0b0e9c8d-2e45-37cc-b321-fb5bc4968d7b",
                                                "text": "Demand for electric cargo bike couriers has boomed since first lockdown, bringing the hope of cleaner, quieter, safer streets."
                                            },
                                            {
                                                "example_id": "ec1a934f-318e-43b9-af44-d7d487af880e",
                                                "sense_id": "0b0e9c8d-2e45-37cc-b321-fb5bc4968d7b",
                                                "text": "It develops a use case in which an electrified three-wheeled cargo bike will become an on-demand, shared autonomous vehicle for the city."
                                            },
                                            {
                                                "example_id": "7cb1d0e4-60c3-40d3-ba24-43db2d318729",
                                                "sense_id": "0b0e9c8d-2e45-37cc-b321-fb5bc4968d7b",
                                                "text": "Zero-emission zones and zero-fatality cities have eliminated the last-mile advantages of moving goods by road. The need for transshipment from trucks to vans or cargo bikes at the fringes of the urban core has meant that road has lost the advantage it held over rail for so much of the last 100 years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5212e2e-de21-4077-9f7d-6eab97671537",
                        "source_entry_id": "615be25b-a165-30d6-ae2d-917bdc6fc9e1",
                        "source_sense_id": "32b6fe13-a456-3f65-b005-657d654a5971",
                        "source_sense_description": "een driewielige fiets die voorzien is van een laadbak",
                        "target_lang_word": "triporteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triporteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5de6a0dc-af32-3650-9a18-f15585830137",
                                        "entry_id": "c6aa1800-8a3b-31d9-a5f8-adf6d6ccca49",
                                        "glosses": [
                                            "Tricycle à pédales ou à moteur muni d'une caisse pour le transport des marchandises légères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e40afe-2417-4347-9a99-03c6c646f6ca",
                                                "sense_id": "5de6a0dc-af32-3650-9a18-f15585830137",
                                                "text": "Il met le pied sur la chaussée juste au moment où, juché sur un triporteur, le jeune livreur d’une grande épicerie voisine arrive comme un projectile."
                                            },
                                            {
                                                "example_id": "8c36729f-e242-460d-99f6-a17b3de6f4e5",
                                                "sense_id": "5de6a0dc-af32-3650-9a18-f15585830137",
                                                "text": "Elle vit la bonne pluie de Paris et sa bonne boue, les familiers immeubles gris et deux tours d’église et une crémerie, un restaurant, et les taxis de Paris, les triporteurs, les autos de maître, tous les passants, les camelots, les parapluies de Paris."
                                            },
                                            {
                                                "example_id": "b1c53025-967a-4a8f-9b26-33423029fd1f",
                                                "sense_id": "5de6a0dc-af32-3650-9a18-f15585830137",
                                                "text": "Le livreur de la supérette Mignot, à Malivert, faisait la tournée des clients à l’ancienne, avec un triporteur Peugeot 125 cc, modèle 1959. Ce véhicule, poussif dans les montées, avait une violente tendance à se renverser dans les virages, si on n’abordait pas ceux-ci avec d’infinies précautions."
                                            },
                                            {
                                                "example_id": "9b61ebc5-39d4-4d30-bae6-e57817185414",
                                                "sense_id": "5de6a0dc-af32-3650-9a18-f15585830137",
                                                "text": "Un accident de la circulation a coûté la vie à une femme circulant à vélo triporteur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
