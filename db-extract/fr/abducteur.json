                "senses": [
                    {
                        "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                        "entry_id": "308c9d47-4895-349d-9bec-3bfdc0b34799",
                        "glosses": [
                            "Qui produit l’abduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4fe81a8-e3e1-47f0-96a4-9765e65a9e6d",
                                "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                                "text": "Muscle abducteur."
                            },
                            {
                                "example_id": "ce980141-d63f-4ed3-b011-2ff0048498c3",
                                "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                                "text": "Les muscles abducteur du pouce et abducteur du gros orteil sont, sans conteste, deux formations homologues."
                            },
                            {
                                "example_id": "791584b6-86e0-41c3-8c27-4acbea29e3c3",
                                "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                                "text": "La disparition d’un muscle abducteur dans mon épaule droite, m’a ôté la capacité d’effectuer des déplacements rapides sur le clavier."
                            },
                            {
                                "example_id": "735a6da9-3c0c-484b-9400-73ceb07c868b",
                                "sense_id": "b7fad6ee-e8c6-3ee5-ba71-08560789004c",
                                "text": "À l’inverse, chez les oiseaux herbivores actuels, le muscle adducteur est très développé, leur permettant de broyer des plantes et des graines dures, alors que le muscle ptérygoïde est très réduit."
                            }
                        ]
                    }
                ],
