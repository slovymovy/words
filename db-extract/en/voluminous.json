                    },
                    {
                        "sense_id": "88ed84c1-231f-363b-aa6d-22083d5670b4",
                        "entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                        "glosses": [
                            "Consisting of many folds, coils, or convolutions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a581c084-f82c-410b-955a-6af3e3aca952",
                                "sense_id": "88ed84c1-231f-363b-aa6d-22083d5670b4",
                                "text": "I remember that the Baroness was clad in a voluminous silk dress, pale grey in colour, and adorned with flounces and a crinoline and train."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c2296d6-9ac4-312b-adae-63dc996ff62f",
                        "entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                        "glosses": [
                            "Of great volume, or bulk; large."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45666ec3-d0fd-4e0d-b4b0-ad4023d3ffe8",
                                "sense_id": "2c2296d6-9ac4-312b-adae-63dc996ff62f",
                                "text": "Matters of a much more extraordinary kind are to be the subject of this history, or I should grossly mis-spend my time in writing so voluminous a work […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "50f85f0b-75c0-3fe2-8c93-a3eba52cc99e",
                        "entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                        "glosses": [
                            "Having written much, or produced many volumes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f78811ff-ad68-4edb-b518-87aa226681d6",
                                "sense_id": "50f85f0b-75c0-3fe2-8c93-a3eba52cc99e",
                                "text": "a voluminous writer"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec1d0b0f-6958-44fa-a9ff-8052cdc3f72a",
