                        "glosses": [
                            "Annuler le fait d’avoir énoncé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "661e979a-a2c5-4222-9ffe-e5aff5fb425f",
                                "sense_id": "de4814ac-2975-32e8-9cc4-1e9a7aa8084c",
                                "text": "Proférer un seul mot, c’est le désénoncer : immobile autour de lui-même, surexposé sans ombre et de relief plein, le mot qui est dit annule la phrase qu’il assume."
                            },
                            {
                                "example_id": "64b2a49e-4256-451a-936c-f52dfaf4fa06",
                                "sense_id": "de4814ac-2975-32e8-9cc4-1e9a7aa8084c",
                                "text": "Écrire commence – sans chronologie linéaire – par dénoncer, par désénoncer, détruire, désintégrer les énoncés proliférants, les langues ordonnées et instrumentales, la littérature de représentations mortes."
                            }
                        ]
                    }
