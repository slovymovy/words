                        "glosses": [
                            "Relatif au rattachisme, courant qui prône la réunion de la Wallonie à la République française."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "856d2131-9f7c-4d83-aaf2-3cb5d5aa2e1e",
                                "sense_id": "59056acf-fe91-3e0e-94ef-0889ae7f0021",
                                "text": "Parfois même, on pourrait croire qu’en renonçant, en 1831, à leur revendication rattachiste pour adopter la Belgique, seule politique possible à l’époque, les Wallons ont par la même occasion renoncé à l’identité wallonne qui se développait depuis 1792 grâce à la République française."
                            }
                        ]
                    }
