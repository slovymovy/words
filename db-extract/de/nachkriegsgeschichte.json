                "senses": [
                    {
                        "sense_id": "aacd0455-006d-3f4c-9c5d-347eec288455",
                        "entry_id": "92fc0582-99f4-346f-b4f9-effe2de6b6af",
                        "glosses": [
                            "nach dem Ende eines Krieges (insbesondere dem Zweiten Weltkrieg) beginnende Phase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1ec0e75-4e8e-42e2-bf50-3d76228d72ee",
                                "sense_id": "aacd0455-006d-3f4c-9c5d-347eec288455",
                                "text": "„Spätestens an diesem Abend muss ihr klar geworden sein, dass sie für ihre Entscheidung, in einem der größten Verfahren der deutschen Nachkriegsgeschichte den wahrscheinlich schwierigsten Job angenommen zu haben, keine Anerkennung erwarten kann.“"
                            },
                            {
                                "example_id": "b16caafc-273a-44fd-b672-d354f492f145",
                                "sense_id": "aacd0455-006d-3f4c-9c5d-347eec288455",
                                "text": "„Über fünf Jahre liegt die Barschel-Affäre zurück – das schlimmste politische Bubenstück der westdeutschen Nachkriegsgeschichte.“"
                            },
                            {
                                "example_id": "6fde0d8c-b746-4827-a71d-e3d820c6ea27",
                                "sense_id": "aacd0455-006d-3f4c-9c5d-347eec288455",
                                "text": "„Die deutsche Nachkriegsgeschichte brachte mit den amerikanischen Besatzungssoldaten auch die schwarze Musik (die für mich wunderbare AFN-Kultur) nach Deutschland, mit Jazz und Sinatra, Gershwin und Cole Porter, Nashville und Motown.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e22de4fd-3df2-3846-b777-359413585b91",
                        "entry_id": "92fc0582-99f4-346f-b4f9-effe2de6b6af",
                        "glosses": [
                            "mündliche oder schriftliche Erzählung oder Überlieferung, die sich thematisch mit der Nachkriegszeit beschäftigt"
                        ],
