                    }
                ],
                "senses": [
                    {
                        "sense_id": "719762ce-b23b-3b07-b96f-ca11f63599e9",
                        "entry_id": "e23a91f7-c611-327a-9966-348962ba3b39",
                        "glosses": [
                            "onvoorstelbaar als vorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1252ed2-87e2-49cf-83cf-ec5dabe969ef",
                                "sense_id": "719762ce-b23b-3b07-b96f-ca11f63599e9",
                                "text": "Wat is dat nou toch weer voor abstracte uitspraak?"
                            }
                        ]
                    },
                    {
                        "sense_id": "fd917d18-0155-35df-8108-633165067af9",
                        "entry_id": "e23a91f7-c611-327a-9966-348962ba3b39",
                        "glosses": [
                            "door redenering afgeleid i.p.v. door aanschouwing verkregen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c022cbf4-572b-47b5-9940-7850123ba68f",
                                "sense_id": "fd917d18-0155-35df-8108-633165067af9",
                                "text": "Dat was nogal een abstract betoog."
                            },
                            {
                                "example_id": "c8e401c2-774e-4ba9-88b8-71002fbe7678",
                                "sense_id": "fd917d18-0155-35df-8108-633165067af9",
                                "text": "Risico is voor veel klimmers een abstract concept. Bergbeklimmers weten dat er verschrikkelijke dingen kunnen gebeuren maar zeggen altijd “Oh, ik ben heel voorzichtig."
                            }
                        ]
                    },
                    {
                        "sense_id": "69ab012c-8d90-35da-a01a-2a023090e431",
                        "entry_id": "e23a91f7-c611-327a-9966-348962ba3b39",
                        "glosses": [
                            "geen verband hebbend met de zichtbare werkelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95edc448-ff56-46ea-a2f7-74c0482621d2",
                                "sense_id": "69ab012c-8d90-35da-a01a-2a023090e431",
                                "text": "In die film speelden allerlei abstracte figuren."
                            },
                            {
                                "example_id": "efab2e39-f0a2-4c67-8283-332d17f77f31",
                                "sense_id": "69ab012c-8d90-35da-a01a-2a023090e431",
                                "text": "Een figuratieve ambachtsman die flirtte met pop-art, die niks moet hebben van het minimalisme van grote rode vlakken of barbaarse abstracte kunst, maar portretten maakt en reusachtige kleurrijke natuurschilderingen. Een vrolijke, innemende snuiter bovendien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ce3f05c-32cb-4a61-bf7e-1cf6a7be669c",
                        "source_entry_id": "e23a91f7-c611-327a-9966-348962ba3b39",
                        "target_lang_word": "abstracto",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
