                "senses": [
                    {
                        "sense_id": "04fa71a4-aa58-35ed-9e4d-9fe75d750b64",
                        "entry_id": "ce6b6f20-d330-317e-b970-ce906efbbcd0",
                        "glosses": [
                            "Faire perdre son caractère clandestin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a95711-946a-42f3-a396-c6b92ff6f881",
                                "sense_id": "04fa71a4-aa58-35ed-9e4d-9fe75d750b64",
                                "text": "Cette reconnaissance officielle du recours au télétravail permet ainsi de le «déclandestiniser» et donc d'assurer une meilleure sécurité au télétravailleur."
                            },
                            {
                                "example_id": "ec1af9a3-9460-4219-800a-8d2d07e71fbe",
                                "sense_id": "04fa71a4-aa58-35ed-9e4d-9fe75d750b64",
                                "text": "Il fallait déclandestiniser les camarades, recommencer le travail politique et s'attaquer aux moyens de production plutôt qu'aux hommes."
                            },
                            {
                                "example_id": "c7d668a1-3b49-4bf9-ba4b-0d2fec471f91",
                                "sense_id": "04fa71a4-aa58-35ed-9e4d-9fe75d750b64",
                                "text": "J'ai vu ton site, et vous avez l'air d'être une festivité clandestine, qui ne demande qu'à se déclandestiniser!!"
                            }
                        ]
                    }
                ],
