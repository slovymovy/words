                                    {
                                        "sense_id": "77e7af63-3fa0-311d-847c-481207b23bb4",
                                        "entry_id": "09ff5521-03e8-3e7a-b332-b7dfb85ba9b5",
                                        "glosses": [
                                            "устар. большая проезжая дорога"
