        "fr-extract.jsonl": [
            {
                "entry_id": "18be4097-7b7d-37f1-b6f2-28b832d22ebb",
                "word": "malpropreté",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7447aa55-c83a-43b9-afe2-bdcd6e616012",
                        "entry_id": "18be4097-7b7d-37f1-b6f2-28b832d22ebb",
                        "tags": [
                            "plural"
                        ],
                        "form": "malpropretés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7b33c2f-1708-34c4-82f5-e9d5704c50f2",
                        "entry_id": "18be4097-7b7d-37f1-b6f2-28b832d22ebb",
                        "glosses": [
                            "Défaut de propreté, saleté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "388b2d0a-7393-46fb-918c-4470bef672e2",
                                "sense_id": "c7b33c2f-1708-34c4-82f5-e9d5704c50f2",
                                "text": "Sa chambre est d’une grande malpropreté."
                            }
                        ]
                    },
                    {
                        "sense_id": "55a395e0-9087-3885-9112-e2a7a45a1b1d",
                        "entry_id": "18be4097-7b7d-37f1-b6f2-28b832d22ebb",
                        "glosses": [
                            "Parole ou action contraire à la morale, à l’honnêteté."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "34eb7be2-dbda-48d8-a4d0-bcaffaf98032",
                                "sense_id": "55a395e0-9087-3885-9112-e2a7a45a1b1d",
                                "text": "Enfin, que voulez-vous attendre de cette exécrable Chambre ? Il s’y trame sûrement quelque malpropreté."
                            },
                            {
                                "example_id": "0ee2215e-98fc-4352-a794-9991ce2b4c2a",
                                "sense_id": "55a395e0-9087-3885-9112-e2a7a45a1b1d",
                                "text": "Apprends, Pomme d'Api, que les grandes personnes ont le droit de faire entre elles les plus grosses malpropretés. Je ne sais pas ce qu'elles font : mais aux précautions qu'elles prennent pour nous le cacher, il faut que cela soit abominable..."
                            },
                            {
                                "example_id": "e9f0f6d8-5d37-42db-b31c-e372becdb302",
                                "sense_id": "55a395e0-9087-3885-9112-e2a7a45a1b1d",
                                "text": "Il n’ignorait pas les malpropretés auxquelles donne souvent lieu l’attribution de la Légion d’honneur à des industriels, à des commerçants, à des financiers."
                            },
                            {
                                "example_id": "2bd25541-963b-462a-9893-36bfc9dcbba4",
                                "sense_id": "55a395e0-9087-3885-9112-e2a7a45a1b1d",
                                "text": "J’ignorais leurs malpropretés morales et physiques, leurs tares, leurs perversions de tout ordre qui les souillaient, quelles abominations pouvaient s’y perpétrer et jusqu’où se dégradaient les sentiments les plus sacrés."
                            }
                        ]
                    }
                ],
