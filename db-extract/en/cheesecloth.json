                                        "entry_id": "00347918-f833-3fc8-948f-12d92cf1d040",
                                        "glosses": [
                                            "тонкая хлопчатобумажная ткань из редко сплетённых нитей, обычно используемая в качестве бинтов"
                                        ],
                                        "tags": [],
