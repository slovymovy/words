                ],
                "senses": [
                    {
                        "sense_id": "3482f844-fa41-3747-85fb-7930266009e0",
                        "entry_id": "37266449-7fb6-323f-a061-32be9962314a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44672b1d-92d3-4057-9366-78f288ff2008",
                                "sense_id": "3482f844-fa41-3747-85fb-7930266009e0",
                                "text": "Frau Heinle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5ec06d38-0e2e-481d-b834-3d962e7e9bb6",
                                "sense_id": "3482f844-fa41-3747-85fb-7930266009e0",
                                "text": "Herr Heinle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3f664cde-a843-4844-907e-e13cdb52c403",
                                "sense_id": "3482f844-fa41-3747-85fb-7930266009e0",
                                "text": "Die Heinles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "dfd3d2f9-9055-43f0-a40c-76903370eb03",
                                "sense_id": "3482f844-fa41-3747-85fb-7930266009e0",
                                "text": "Der Heinle trägt nie die Schals, die die Heinle ihm strickt."
                            },
                            {
                                "example_id": "192cbcd0-43b7-4361-86b9-80646c6f8500",
                                "sense_id": "3482f844-fa41-3747-85fb-7930266009e0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heinle kommt, geht der Herr Heinle.“"
                            },
                            {
                                "example_id": "a9619d4b-c154-462e-85cd-daf17765eec1",
                                "sense_id": "3482f844-fa41-3747-85fb-7930266009e0",
                                "text": "Heinle kommt und geht."
                            },
                            {
                                "example_id": "060f48a7-e131-4832-a31d-99b25f0317c7",
                                "sense_id": "3482f844-fa41-3747-85fb-7930266009e0",
                                "text": "Heinles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
