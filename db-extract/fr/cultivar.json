        "fr-extract.jsonl": [
            {
                "entry_id": "c65d68f4-7cde-3509-8a7a-bd9c82be9629",
                "word": "cultivar",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8d392ac9-a605-4422-bd39-c6ad2d86ffe5",
                        "entry_id": "c65d68f4-7cde-3509-8a7a-bd9c82be9629",
                        "tags": [
                            "plural"
                        ],
                        "form": "cultivars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "747a058d-960e-3350-9f62-7792b1c04a36",
                        "entry_id": "c65d68f4-7cde-3509-8a7a-bd9c82be9629",
                        "glosses": [
                            "Ensemble des individus d’une espèce de plante cultivée, qui résulte d’une sélection et qui peut être génétiquement reproduit à l’identique."
                        ],
                        "tags": [
                            "Agronomie",
                            "Ethnobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3ce9084e-bdac-4bca-b230-8ee2947db55f",
                                "sense_id": "747a058d-960e-3350-9f62-7792b1c04a36",
                                "text": "Mais la véritable solution qui entraîne l’adhésion générale réside dans la sélection de cultivars de palmiers résistants à la maladie."
                            },
                            {
                                "example_id": "ef8992bb-ea1f-4b68-9846-dcd6bffb916f",
                                "sense_id": "747a058d-960e-3350-9f62-7792b1c04a36",
                                "text": "Depuis le mois de mai, les bulbiculteurs néerlandais participent à un sondage qui a pour objectif de mettre à la disposition de l'ensemble de la profession la connaissance qu'ils ont de la sensibilité aux maladies des cultivars de bulbes de tulipes, narcisses, glaïeuls, crocus, hyacinthes, iris et lis."
                            },
                            {
                                "example_id": "1f409d55-e0b7-499d-855b-55e6a0c56706",
                                "sense_id": "747a058d-960e-3350-9f62-7792b1c04a36",
                                "text": "La plupart des peupliers cultivés en France […] sont des cultivars et leur utilisation est réglementée : seuls ceux qui sont enregistrés sur le catalogue national peuvent être commercialisés. La première version de ce catalogue date de 1961 […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfe9a7a4-fd3b-42a6-916d-a884a85a27f5",
                        "source_entry_id": "c65d68f4-7cde-3509-8a7a-bd9c82be9629",
                        "source_sense_id": "747a058d-960e-3350-9f62-7792b1c04a36",
                        "source_sense_description": "cultivar",
                        "target_lang_word": "Sorte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sorte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd3b776-c355-35e0-8202-2bc0975efa75",
                                        "entry_id": "1169ffe0-47a7-3792-878c-8d2c0017dcd9",
                                        "glosses": [
                                            "Art innerhalb einer größeren Gattung, die einheitliche Merkmale aufweist und sich dadurch von anderen Arten der Gattung unterscheidet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd6b13a9-0541-4adb-9454-6c59d417948d",
                                                "sense_id": "4dd3b776-c355-35e0-8202-2bc0975efa75",
                                                "text": "Er war nicht jemand von der Sorte, die sich leicht beeindrucken lässt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e038b8bc-c7fc-3c86-834b-608a83d32d50",
                                        "entry_id": "1169ffe0-47a7-3792-878c-8d2c0017dcd9",
                                        "glosses": [
                                            "Art innerhalb einer größeren Gattung, die einheitliche Merkmale aufweist und sich dadurch von anderen Arten der Gattung unterscheidet",
                                            "Zuchtform"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "655d5db4-fc7a-4b79-bc31-f232d967ec31",
                                                "sense_id": "e038b8bc-c7fc-3c86-834b-608a83d32d50",
                                                "text": "Diese Sorte lässt sich leicht mit anderen Rosensorten kreuzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "33ecbdc6-16fc-3333-8034-7ba60c702b59",
                                        "entry_id": "1169ffe0-47a7-3792-878c-8d2c0017dcd9",
                                        "glosses": [
                                            "ausländisches Bargeld"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c82ca3-c66c-40a4-a121-1ad8de4b23f5",
                                                "sense_id": "33ecbdc6-16fc-3333-8034-7ba60c702b59",
                                                "text": "Während Devisen auch Bankguthaben sein können, sind Sorten Münzen und Scheine."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df60e344-9895-4fcc-9ea7-ae20d40859e7",
                        "source_entry_id": "c65d68f4-7cde-3509-8a7a-bd9c82be9629",
                        "source_sense_id": "747a058d-960e-3350-9f62-7792b1c04a36",
