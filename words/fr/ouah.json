                },
                {
                    "sense_id": "614b7edf-c465-3ba2-b0ce-648c0a05f4f9",
                    "sense_definition": "Imite le cri ou l'aboiement d'un chien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aboiement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit chien aboie joyeusement en faisant <w>ouah</w> quand son maître rentre.",
                            "target_lang_translations": {
                                "en": "The little dog barks happily, going <w>woof</w> when its owner comes home.",
                                "ru": "Маленький пёс радостно лает «<w>гав</w>», когда хозяин возвращается домой.",
                                "de": "Der kleine Hund bellt fröhlich und macht dabei „<w>wau</w>“, wenn sein Herrchen nach Hause kommt.",
                                "es": "El perrito ladra alegremente haciendo «<w>guau</w>» cuando su dueño llega a casa.",
                                "zh": "小狗在主人回家时欢快地吠叫，还发出“<w>汪汪</w>”的声音。"
                            }
                        },
                        {
                            "text": "L'enfant s'amusait à répéter <w>ouah</w> pour imiter son animal de compagnie.",
                            "target_lang_translations": {
                                "en": "The child liked to amuse themselves by repeating <w>woof</w> to imitate their pet.",
                                "ru": "Ребёнок развлекался, повторяя «<w>гав</w>», подражая своему домашнему питомцу.",
                                "de": "Das Kind amüsierte sich damit, immer wieder „<w>wau</w>“ zu wiederholen, um sein Haustier nachzuahmen.",
                                "es": "El niño se divertía repitiendo «<w>guau</w>» para imitar a su mascota.",
                                "zh": "孩子喜欢一遍遍地发出“<w>汪汪</w>”的声音，模仿自己的宠物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ouaf-ouaf"
                    ],
