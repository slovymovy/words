                            {
                                "example_id": "c7d06e97-ac7d-466c-a1c1-53c028b98cee",
                                "sense_id": "0f7b3f9e-d54b-304c-9db3-28f82a2c80b4",
                                "text": "Zijn jaloersheid is spreekwoordelijk."
                            }
