        "fr-extract.jsonl": [
            {
                "entry_id": "8881f908-722c-3625-8ac1-4eebda6f3930",
                "word": "rush",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eeea1a13-2907-3085-b4be-a98008fb66ad",
                        "entry_id": "8881f908-722c-3625-8ac1-4eebda6f3930",
                        "glosses": [
                            "Attaque soudaine."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "64cb815c-dd3f-37c3-8e6c-e823af0ea90e",
                        "entry_id": "8881f908-722c-3625-8ac1-4eebda6f3930",
                        "glosses": [
                            "Attaque soudaine.",
                            "Coup offensif au filet."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a2f0ec49-bd1d-406f-80ac-6f62c9841d7c",
                                "sense_id": "64cb815c-dd3f-37c3-8e6c-e823af0ea90e",
                                "text": "Le rush est très utilisé en double, essentiellement par le joueur placé en avant."
                            }
                        ]
                    },
                    {
                        "sense_id": "b62ffe6c-4b85-3abb-9395-1ab526d73455",
                        "entry_id": "8881f908-722c-3625-8ac1-4eebda6f3930",
                        "glosses": [
                            "Attaque soudaine.",
                            "Sprint, attaque d’un coureur ou d’un cavalier parvenu en fin de course, qui accélère brutalement son allure pour dépasser ses concurrents."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "note": "Ce terme d’inspiration anglaise est critiqué par l'OQLF, qui recommande d'y substituer accélération",
                        "examples": [
                            {
                                "example_id": "6e62f49a-70cd-4694-a0ac-eff543352157",
                                "sense_id": "b62ffe6c-4b85-3abb-9395-1ab526d73455",
                                "text": "Robert Paul ne trouvait pas le « rush » qui lui aurait permis de grignoter les dix centimètres dont Strandwall le précédait. — (L’Auto, 27 août 1933, page 1, in Grubb Sports 1937, page 65)"
                            }
                        ]
                    },
                    {
                        "sense_id": "488f1925-e500-3ac9-b785-2661724d3137",
                        "entry_id": "8881f908-722c-3625-8ac1-4eebda6f3930",
                        "glosses": [
                            "Attaque soudaine.",
                            "Stratégie offensive basée sur une attaque éclair et négligeant totalement tout aspect défensif, généralement en début de partie ou en une période de temps très court, pour prendre l’ascendant sur l’adversaire."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "5a2a8288-4906-43e2-a295-a5aacc3b5d17",
                                "sense_id": "488f1925-e500-3ac9-b785-2661724d3137",
                                "text": "J’ai tenté le rush en début de partie et il a échoué, désormais l’adversaire a l’avantage."
                            }
                        ]
                    },
                    {
                        "sense_id": "aff9ca26-177c-35e8-8303-e5884d9cb3e4",
                        "entry_id": "8881f908-722c-3625-8ac1-4eebda6f3930",
                        "glosses": [
                            "Épreuve de tournage, document original (bobines de film, bande son, vidéocassettes) produit au tournage."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "note": "Ce terme d’inspiration anglaise est critiqué par l'OQLF, qui recommande d'y substituer épreuve de tournage",
                        "examples": [
                            {
                                "example_id": "048197c5-8641-46fe-af0d-e9d43ce296d1",
                                "sense_id": "aff9ca26-177c-35e8-8303-e5884d9cb3e4",
                                "text": "Rembobinez. On va passer ces « rushes » — il employait le terme américain qui signifie les scènes de la veille rapidement développées."
                            },
                            {
                                "example_id": "0e966168-cdce-42c7-8ab7-ebdf4a600be9",
                                "sense_id": "aff9ca26-177c-35e8-8303-e5884d9cb3e4",
                                "text": "Le tournage fut achevé au bout de trois semaines. Rollner ne s’était même pas donné la peine d’aller voir les « rushes » projetés dans un cinéma d’Hyères. Il y envoyait l’ingénieur du son."
                            },
                            {
                                "example_id": "b9deaf27-05dc-4a2a-92e4-0a64ea2969c4",
                                "sense_id": "aff9ca26-177c-35e8-8303-e5884d9cb3e4",
                                "text": "À Marchand, le réalisateur reprochera de « ribouler » quand il joue la colère. En pleine projection de rushes, sa voix s’élève, pour lancer à l’acteur sur l’écran : « Arrête de ribouler des yeux! »"
                            },
                            {
                                "example_id": "8c783ec2-37b3-48a2-af00-f2954f40d2cb",
                                "sense_id": "aff9ca26-177c-35e8-8303-e5884d9cb3e4",
                                "text": "Chacun de nous put acquérir pour une modique somme une K7 contant le reportage et vingt minutes de rush qu'il eut la gentillesse de rendre intelligentes, ce qui dut lui donner beaucoup de mal, car, honnêtement, nos déplacements rugbystiques n'ont jamais vraiment brillé ni par leur originalité, ni par la pertinence de nos pensées."
                            }
                        ]
                    },
                    {
                        "sense_id": "30d233c0-e1b5-3a88-a677-f45742bf860a",
                        "entry_id": "8881f908-722c-3625-8ac1-4eebda6f3930",
                        "glosses": [
                            "Ruée, cohue, afflux."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "note": "Ce terme d’inspiration anglaise est critiqué par l'OQLF, qui recommande d'y substituer cohue, afflux ou heure de pointe",
                        "examples": [
                            {
                                "example_id": "e869d20f-1ab0-4d21-9001-11de8cfa1160",
                                "sense_id": "30d233c0-e1b5-3a88-a677-f45742bf860a",
                                "text": "C’est plus tard, après les élections, quand il y a eu un rush vers l’Afrique du Sud, que ça a commencé vraiment à se gâter."
                            }
                        ]
                    },
                    {
                        "sense_id": "31e342de-3cc2-3e9a-a0f1-ad0b09dec7af",
                        "entry_id": "8881f908-722c-3625-8ac1-4eebda6f3930",
                        "glosses": [
                            "Situation où l’on est débordé, où l’on manque de temps dans l’immédiat."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "26a1007f-3c12-404f-b043-17dd23c7a353",
                                "sense_id": "31e342de-3cc2-3e9a-a0f1-ad0b09dec7af",
                                "text": "Je suis en plein rush, tu… Un peu plus tard, OK ?"
                            }
                        ]
                    }
                ],
