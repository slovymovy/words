                ],
                "senses": [
                    {
                        "sense_id": "d7d3dc48-58ae-3b2d-9a22-5c6658ac342f",
                        "entry_id": "437e7496-2f6c-385d-ac43-d99d3813cdab",
                        "glosses": [
                            "Qui a tendance à tolérer sans punir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea0b6331-4b87-4bc0-829c-cfd46e248aa2",
                                "sense_id": "d7d3dc48-58ae-3b2d-9a22-5c6658ac342f",
                                "text": "C'est bien notre chance, à nous, élevés au temps des interdits, c'est aussi la raison de nos faibles réticences que d'avoir été les derniers-nés de la société de rigueur et en même temps les premiers permissifs !"
                            },
                            {
                                "example_id": "2508699a-e56c-450e-be0d-d5af1c9ac5b7",
                                "sense_id": "d7d3dc48-58ae-3b2d-9a22-5c6658ac342f",
                                "text": "Observez ce que vous vous dites et notez sur un carnet vos pensées. Amusez-vous à les classer en soulageantes, permissives, anticipatoires."
                            },
                            {
                                "example_id": "88827368-8aa3-46a5-becf-0bb840fd7e22",
                                "sense_id": "d7d3dc48-58ae-3b2d-9a22-5c6658ac342f",
                                "text": "Les Dinehs n’accordaient pas autant d’importance aux choses de l’amour que les Occidentaux. Chez eux, le mariage, ou ce qui pouvait s’en rapprocher le plus, était quelque chose d’assez souple, et permissif, et les rapports sexuels, une chose aussi banale que de manger, de jouer ou de dormir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1660064-3fee-4bd3-98c9-710aea52382f",
                        "source_entry_id": "437e7496-2f6c-385d-ac43-d99d3813cdab",
                        "source_sense_id": "d7d3dc48-58ae-3b2d-9a22-5c6658ac342f",
                        "target_lang_word": "freizügig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freizügig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee500840-c72d-34c2-8097-2551e5860dc8",
                                        "entry_id": "38161572-d577-310f-80b8-69b1749a5fb0",
                                        "glosses": [
                                            "nicht streng an Regeln oder gesellschaftliche Konventionen haltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "914c8dc7-c67a-45df-ae88-161ae3fbe9f7",
                                                "sense_id": "ee500840-c72d-34c2-8097-2551e5860dc8",
                                                "text": "Die Vorschriften werden hier sehr freizügig gehandhabt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9adb32ce-744e-3a31-88c8-9d62d047c023",
                                        "entry_id": "38161572-d577-310f-80b8-69b1749a5fb0",
                                        "glosses": [
                                            "speziell in sexueller Hinsicht ungezwungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceafc664-aaeb-4ccb-a54c-1a36e46f18c6",
                                                "sense_id": "9adb32ce-744e-3a31-88c8-9d62d047c023",
                                                "text": "Junge Menschen kleiden sich mitunter gerne etwas freizügiger, wenn sie am Wochenende ausgehen."
                                            },
                                            {
                                                "example_id": "9b636b38-3243-44f8-bb5d-3418a5b71b00",
                                                "sense_id": "9adb32ce-744e-3a31-88c8-9d62d047c023",
                                                "text": "In meiner Familie konnte man immer sehr freizügig über Sexuelles sprechen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9d60fac5-2930-3cca-b244-eadfd02b0125",
                                        "entry_id": "38161572-d577-310f-80b8-69b1749a5fb0",
                                        "glosses": [
                                            "frei in der Wahl von Wohn- und Aufenthaltsort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a63fee-71fa-4356-a208-1935ffb09ede",
                                                "sense_id": "9d60fac5-2930-3cca-b244-eadfd02b0125",
                                                "text": "Seit dem Mauerfall dürfen auch die ostdeutschen Bürger wieder vollkommen freizügig reisen und leben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
