                "translations": [
                    {
                        "translation_id": "12ea07df-e19e-46b7-a6ec-0c5bcaffebc1",
                        "source_entry_id": "5399510a-e008-354b-92e3-ecb415afe94d",
                        "source_sense_id": "9b8149d3-75c3-33b6-8047-145c110c3ef4",
                        "target_lang_word": "viscacha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viscacha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd93c171-1246-3c4c-96f1-8bc33461b01e",
                                        "entry_id": "9f814eab-7aa5-36ed-a99c-8f1686ee3c1c",
                                        "glosses": [
                                            "Any of the several South American rodents, native to the Andes Mountains, of the genera Lagidium and Lagostomus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2470f0e8-4776-4a78-be11-02b21d8ca56a",
                                                "sense_id": "bd93c171-1246-3c4c-96f1-8bc33461b01e",
                                                "text": "From the tenderness of its covering, it is not, though a stronger and larger animal, so able to bear the severity of winter in the Andes as the Chinchilla, though it is not so decidedly an animal of the plains as the viscacha of Paraguay."
                                            },
                                            {
                                                "example_id": "443ba8d6-3296-4b06-ad8a-96d726afeeb1",
                                                "sense_id": "bd93c171-1246-3c4c-96f1-8bc33461b01e",
                                                "text": "The guanaco, the viscacha, and the hare of the Pampas, are found in Patagonia."
                                            },
                                            {
                                                "example_id": "d8cf21c6-91e0-459e-8dbc-338578fc3e04",
                                                "sense_id": "bd93c171-1246-3c4c-96f1-8bc33461b01e",
                                                "text": "A guard viscacha watches for predators. This guard sounds an alarm if it spots danger. Then the quick-moving viscachas scramble into their dens in the rocks or burrow into the ground."
                                            },
                                            {
                                                "example_id": "614c718a-06f9-4ade-8b51-9bcec7a5e361",
                                                "sense_id": "bd93c171-1246-3c4c-96f1-8bc33461b01e",
                                                "text": "The Andean cat's prey is small mammals such as the mountain viscacha, which look very much like a common North American cottontail rabbit. Mountain viscachas eat coarse spikegrass that is found near small mountain streams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
