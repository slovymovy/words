                                            "nominativ, akuzativ, vokativ a instrumentál plurálu slova hadr"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "021cc46c-9b4f-4b78-a7f2-dc9a24bee482",
