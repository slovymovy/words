                "senses": [
                    {
                        "sense_id": "92a8561e-452c-3d53-851c-61a222be3e2a",
                        "entry_id": "ea8de50f-aaa2-32d2-a080-82d7df7836d1",
                        "glosses": [
                            "Sorte de goélette pour le cabotage, en usage à la Guyane."
                        ],
                        "tags": [
                            "Guyane"
                        ],
                        "examples": [
                            {
                                "example_id": "cc8b7627-6e12-4495-808a-dc7b76254af0",
                                "sense_id": "92a8561e-452c-3d53-851c-61a222be3e2a",
                                "text": "Je suis arrivé hier à Cayenne sur une tapouille. Le bateau a mis quatre jours pour arriver, aussi je suis fatigué comme une bête."
                            },
                            {
                                "example_id": "913ac1d4-dad2-49d8-aa53-91a2bce98ad7",
                                "sense_id": "92a8561e-452c-3d53-851c-61a222be3e2a",
                                "text": "Dans la fine pluie d’un matin de février 1947, une tapouille se faufilait lentement dans le canal Laussat. Ses voiles délavées par le soleil et la pluie mais qui paraissaient blanches sur le gris du ciel, essayaient de récupérer les rares frissons de brise pour améliorer la lente progression du bateau."
                            },
                            {
                                "example_id": "acd166c8-437b-4e77-9f58-e32ff4a891f7",
                                "sense_id": "92a8561e-452c-3d53-851c-61a222be3e2a",
                                "text": "Des voiliers, goélettes, « sloops » ou « tapouilles » assurent la plus grande partie des transports entre Cayenne et les communes qui, pour la plupart, ne sont pas reliées par voie routière."
                            }
                        ]
                    }
