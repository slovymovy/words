                    {
                        "translation_id": "697d7c5a-528b-4074-85c3-bfbbcc6ed6eb",
                        "source_entry_id": "9500fa23-d3fd-3682-8c7f-3baf06d322ce",
                        "source_sense_id": "8db89993-3154-3b98-a1a0-3548fb697f35",
