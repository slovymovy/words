{
    "word_family": [
        "kopen",
        "verkoops",
        "inkoop",
        "verkoop",
        "afkopen",
        "omkopen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a72330e-8bde-3a30-bcbb-ca5e20b7cc0f",
                    "sense_definition": "met de dood of een ander zwaar verlies boeten voor een fout of risico",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boeten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest zijn roekeloze rijgedrag uiteindelijk met de dood <w>bekopen</w>.",
                            "target_lang_translations": {
                                "en": "He ultimately had to <w>pay for</w> his reckless driving with his life."
                            }
                        },
                        {
                            "text": "Zij heeft haar naïviteit duur moeten <w>bekopen</w> toen ze al haar geld verloor.",
                            "target_lang_translations": {
                                "en": "She had to <w>pay dearly for</w> her naivety when she lost all her money."
                            }
                        }
                    ],
                    "synonyms": [
                        "betalen"
                    ],
                    "common_phrases": [
                        "met de dood bekopen",
                        "duur bekopen"
                    ],
                    "target_lang_definitions": {
                        "en": "To pay for a mistake or risk with one's life or another heavy loss"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pay for",
                                "target_lang_sense_clarification": "suffer the consequences of a mistake"
                            },
                            {
                                "target_lang_word": "pay with",
                                "target_lang_sense_clarification": "lose something valuable as a result of an action"
                            },
                            {
                                "target_lang_word": "atone for",
                                "target_lang_sense_clarification": "make amends or suffer for a fault"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47da3649-b391-3a79-988b-cce511fb8507",
                    "sense_definition": "iemand bedriegen of oplichten bij een transactie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bedriegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oneerlijke handelaar probeerde de toeristen te <w>bekopen</w> met namaakgoederen.",
                            "target_lang_translations": {
                                "en": "The dishonest merchant tried to <w>cheat</w> the tourists with counterfeit goods."
                            }
                        },
                        {
                            "text": "Als je niet goed oplet op die markt, <w>bekopen</w> ze je waar je bij staat.",
                            "target_lang_translations": {
                                "en": "If you don't pay close attention at that market, they will <w>rip you off</w> right in front of your eyes."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vrij informeel of verouderend in deze betekenis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To cheat, deceive, or rip someone off during a transaction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheat",
                                "target_lang_sense_clarification": "deceive someone in a transaction"
                            },
                            {
                                "target_lang_word": "rip off",
                                "target_lang_sense_clarification": "overcharge or swindle someone"
                            },
                            {
                                "target_lang_word": "dupe",
                                "target_lang_sense_clarification": "trick or deceive someone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}