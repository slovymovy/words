                                    {
                                        "sense_id": "406450a9-d9c1-3b48-8f73-55017648d74d",
                                        "entry_id": "2bcf1213-a229-395e-b336-fdebeb2f3151",
                                        "glosses": [
                                            "Extremely costly; so expensive as to cause financial ruin."
                                        ],
                                        "tags": [],
