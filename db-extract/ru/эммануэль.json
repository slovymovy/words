                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emmanuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dad27b90-5ad4-361f-a89d-3336e230810e",
                                        "entry_id": "a2f09864-95aa-3433-a052-a39c9a0250ad",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae72c169-da10-447c-8153-a5a42156f0ba",
                                                "sense_id": "dad27b90-5ad4-361f-a89d-3336e230810e",
                                                "text": "Certes, les reports de Jean-Luc Mélenchon sur Emmanuel Macron sont un peu meilleurs mais, dans nos enquêtes qualitatives, il est évident que c’est un effet de la rediabolisation de Marine Le Pen d’entre les deux tours."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Emmanuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60f4bac6-185a-3751-95a8-abbad4bb2b8e",
                                        "entry_id": "5777a0d7-6498-34f2-a477-92a478fa08b6",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
