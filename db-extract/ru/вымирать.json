                                                "example_id": "e5d8d850-8f34-44d3-b14e-4c2a44dc726a",
                                                "sense_id": "7f68f689-a24d-3128-bbd1-82bf6347be95",
                                                "text": "Der Waldrapp ist in Deutschland ausgestorben, soll aber wieder angesiedelt werden."
                                            },
