                    {
                        "sense_id": "d8ffe722-bb5f-3e34-9d30-e6cb839ef2c5",
                        "entry_id": "2d189da1-269a-3eee-8abf-8629d45c8c0b",
                        "glosses": [
                            "to surpass or be better than something or someone else"
                        ],
