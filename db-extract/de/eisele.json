                ],
                "senses": [
                    {
                        "sense_id": "9c0c5558-474f-361a-b3b0-411fd4140e18",
                        "entry_id": "5ecf657e-2d66-36bc-929e-07dcfb1b983e",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2233a255-9e8a-419b-947d-607f8d1dae92",
                                "sense_id": "9c0c5558-474f-361a-b3b0-411fd4140e18",
                                "text": "Frau Eisele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f3272821-2d92-4e82-a5ef-72038de3f2f2",
                                "sense_id": "9c0c5558-474f-361a-b3b0-411fd4140e18",
                                "text": "Herr Eisele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f00de41c-4f3d-4b22-8220-caa2aa8fd468",
                                "sense_id": "9c0c5558-474f-361a-b3b0-411fd4140e18",
                                "text": "Die Eiseles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "741f03f3-cc3b-41d2-bbe1-b3acf034f45e",
                                "sense_id": "9c0c5558-474f-361a-b3b0-411fd4140e18",
                                "text": "Der Eisele trägt nie die Schals, die die Eisele ihm strickt."
                            },
                            {
                                "example_id": "fa30e6f3-84c0-4b5e-9978-a0681251c46f",
                                "sense_id": "9c0c5558-474f-361a-b3b0-411fd4140e18",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eisele kommt, geht der Herr Eisele.“"
                            },
                            {
                                "example_id": "7666313e-3125-47c4-b193-c7e1a2b57ba9",
                                "sense_id": "9c0c5558-474f-361a-b3b0-411fd4140e18",
                                "text": "Eisele kommt und geht."
                            },
                            {
                                "example_id": "d9a99a33-3986-43cc-abea-b1706591700d",
                                "sense_id": "9c0c5558-474f-361a-b3b0-411fd4140e18",
                                "text": "Eiseles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
