{
    "word_family": [
        "sap"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dd019be1-a7bb-34a7-ad53-05956c72ca03",
                    "sense_definition": "Excessively emotional, nostalgic, or sentimental in a way that is considered foolish or cheesy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>sappy</w> love song, but it reminded them of their first dance.",
                            "target_lang_translations": {
                                "ru": "Это была <w>слащавая</w> песня о любви, но она напоминала им об их первом танце."
                            }
                        },
                        {
                            "text": "He wrote a <w>sappy</w> poem for his girlfriend that made everyone in the room cringe.",
                            "target_lang_translations": {
                                "ru": "Он написал для своей девушки <w>сопливое</w> стихотворение, от которого всех в комнате передернуло."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно эмоциональный, сентиментальный или ностальгический до глупости или приторности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слащавый",
                                "target_lang_sense_clarification": "приторно-сентиментальный"
                            },
                            {
                                "target_lang_word": "сопливый",
                                "target_lang_sense_clarification": "разговорное, о слезливых фильмах, песнях"
                            },
                            {
                                "target_lang_word": "сентиментальный",
                                "target_lang_sense_clarification": "чрезмерно чувствительный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e167d05e-0754-3a9f-b148-a365e014871d",
                    "sense_definition": "Containing a large amount of plant sap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fireplace was filled with <w>sappy</w> pine logs that crackled loudly as they burned.",
                            "target_lang_translations": {
                                "ru": "Камин был заполнен <w>смолистыми</w> сосновыми поленьями, которые громко потрескивали при горении."
                            }
                        },
                        {
                            "text": "The air in the forest smelled fresh, filled with the scent of <w>sappy</w> grasses and pine needles.",
                            "target_lang_translations": {
                                "ru": "Воздух в лесу пах свежестью, наполненный ароматом <w>сочных</w> трав и хвои."
                            }
                        }
                    ],
                    "synonyms": [
                        "sapful"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий большое количество древесного сока или смолы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смолистый",
                                "target_lang_sense_clarification": "о древесине хвойных пород"
                            },
                            {
                                "target_lang_word": "сочный",
                                "target_lang_sense_clarification": "полный растительного сока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d0a0157-e735-38b0-92be-e36b8fd1d89e",
                    "sense_definition": "Full of juice; succulent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bit into the <w>sappy</w> fruit, and the sweet juice ran down her chin.",
                            "target_lang_translations": {
                                "ru": "Она откусила <w>сочный</w> плод, и сладкий сок потек у нее по подбородку."
                            }
                        },
                        {
                            "text": "The chef selected the most <w>sappy</w> peaches for the summer dessert.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар выбрал самые <w>сочные</w> персики для летнего десерта."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный сока; сочный (о плодах, фруктах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочный",
                                "target_lang_sense_clarification": "о фруктах и ягодах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e14edf0a-078c-31c1-929c-debf7a972086",
                    "sense_definition": "Having a soft, spongy texture due to high moisture content, often used to describe wood.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builder warned that the <w>sappy</w> wood would rot quickly if used for the outdoor deck.",
                            "target_lang_translations": {
                                "ru": "Строитель предупредил, что <w>сырая заболонная</w> древесина быстро сгниет, если использовать ее для открытой террасы."
                            }
                        },
                        {
                            "text": "Because the timber was <w>sappy</w> and soft, it was easily damaged by insects.",
                            "target_lang_translations": {
                                "ru": "Поскольку древесина была <w>непросушенной</w> и мягкой, насекомые легко ее повредили."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий или рыхлый из-за избытка влаги или сока (обычно о древесине, заболони)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заболонный",
                                "target_lang_sense_clarification": "о древесине с толстым слоем молодой древесины"
                            },
                            {
                                "target_lang_word": "сырой",
                                "target_lang_sense_clarification": "влажный и рыхлый (о лесоматериалах)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59748d63-072b-3608-98f6-5fec5277a698",
                    "sense_definition": "Tainted, musty, or beginning to spoil, especially regarding meat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher discarded the meat once it reached the <w>sappy</w> stage of decay.",
                            "target_lang_translations": {
                                "ru": "Мясник выбросил мясо, как только оно дошло до состояния <w>с душком</w>."
                            }
                        },
                        {
                            "text": "The cellar smelled of <w>sappy</w> meat that had been left out too long.",
                            "target_lang_translations": {
                                "ru": "В подвале пахло <w>подпорченным</w> мясом, которое слишком долго пролежало на воздухе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in older contexts to describe food spoilage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испорченный, с душком, затхлый (о мясе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с душком",
                                "target_lang_sense_clarification": "начинающий портиться (о мясе)"
                            },
                            {
                                "target_lang_word": "подпорченный",
                                "target_lang_sense_clarification": "начавший гнить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}