                        "target_lang_word": "Organisator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Organisator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                                        "entry_id": "f77a91f1-57ca-39a7-a289-abab6d6a6b01",
                                        "glosses": [
                                            "Person, die Aktionen oder Abläufe vorbereitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed72bc2-fa47-4450-a07c-7f88ef0c7448",
                                                "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                                                "text": "Die Organisatoren der Festspiele bekamen auch viel Applaus."
                                            },
                                            {
                                                "example_id": "e19c65ee-9c59-4e6f-afcb-16feb47467d9",
                                                "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                                                "text": "„Sie wurden die Organisatoren eines militanten tschechischen Nationalismus.“"
                                            },
                                            {
                                                "example_id": "a305f471-1393-43b0-9da5-06f9a671c40b",
                                                "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                                                "text": "Die Organisatoren des Etappenortes der DDR-Rundfahrt im Radsport haben Nordhausen weit über die Bezirksgrenzen bekannt gemacht."
                                            },
                                            {
                                                "example_id": "0501ba7c-7e82-46fc-8eba-7be23ef3d754",
                                                "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                                                "text": "„Fallada ist ein penibler Organisator, aber selbst Hand anlegen kann er seines Herzfehlers wegen nicht; eine Lebensversicherungsgesellschaft hat einen Vertrag mit ihm kürzlich abgelehnt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b21b051b-5834-45e3-8d74-f4147f06b265",
                        "source_entry_id": "2ded6c94-4019-315c-98b9-46684c282d5c",
                        "source_sense_id": "744b7889-53ac-309b-877b-9a215cc2e583",
                        "source_sense_description": "iemand die organiseert of die organisatietalent heeft",
                        "target_lang_word": "Veranstalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veranstalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                                        "entry_id": "3b27528a-0c41-3095-83bc-86aa718780b4",
                                        "glosses": [
                                            "Person oder Organisation, die eine Veranstaltung, eine gesellschaftliche Unternehmung (Ausstellung, Fest, Wettbewerb), vorbereitet und organisiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6448263f-d56a-49d0-abe3-31077665ce1c",
                                                "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                                                "text": "Der Veranstalter ist dabei sowohl für die Inhalte als auch für das Verhalten der Gäste und deren Sicherheit, jeweils im Rahmen seiner Sorgfaltspflicht, zuständig."
                                            },
                                            {
                                                "example_id": "bfe58ada-d472-4fa3-a764-8c9bef330633",
                                                "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                                                "text": "„Mit einer Geschwindigkeit von rund 13 Kilometern in der Stunde gehe es nicht um Spitzensport, so der Veranstalter.“"
                                            },
                                            {
                                                "example_id": "08b20157-4e02-41f5-8495-e808f093a79b",
                                                "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                                                "text": "„Gegen die noch immer beliebten Gatterjagden laufen die Tierschützer vom VgT (Verein gegen Tierfabriken) seit Jahren Sturm. Mehrere Prozesse gegen diverse Veranstalter sind anhängig.“"
                                            },
                                            {
                                                "example_id": "66e64a60-5cd4-438b-bc34-e2d429f1bfee",
                                                "sense_id": "c0161b32-e386-3d8c-901d-e8cc753e9668",
                                                "text": "„Laut Aussage der Veranstalter liege die Bestmarke im Drachensteigen derzeit bei 674 Fluggeräten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cf00985-b48f-4d41-bf5f-ad5f8510142c",
                        "source_entry_id": "2ded6c94-4019-315c-98b9-46684c282d5c",
