                    {
                        "sense_id": "c973ba6d-f592-330d-861c-a72589d47200",
                        "entry_id": "81986057-502a-3871-95da-6997675c4ca2",
                        "glosses": [
                            "unrechtmäßig in Besitz genommene Kunstwerke"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "045bed5f-b7f0-41cc-9103-5e4c3e9f3642",
                                "sense_id": "c973ba6d-f592-330d-861c-a72589d47200",
                                "text": "„Wie schwer es ist, 68 Jahre nach dem Zweiten Weltkrieg die rechtmäßigen Eigentümer von Raubkunst zu finden, zeigen die Restbestände der für das ‚Führermuseum‘ in Linz bestimmten Kunstwerke.“"
                            },
                            {
                                "example_id": "ac2eebd8-a7d9-4d0f-a56f-23c3ba8c166d",
                                "sense_id": "c973ba6d-f592-330d-861c-a72589d47200",
                                "text": "„Viele Gemälde aus französischen Museen kamen so als Raubkunst nach Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
