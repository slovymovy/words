                "senses": [
                    {
                        "sense_id": "4b9f726c-8a15-304c-ac8d-179af47e84ee",
                        "entry_id": "df63cc66-bc4b-3a39-9ec8-616672f21f1a",
                        "glosses": [
                            "Gruppe von Personen, die in einem bestimmten Bereich eine leitende Funktion innehaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a45b4c4c-d92c-48c3-aa0e-a979edc95836",
                                "sense_id": "4b9f726c-8a15-304c-ac8d-179af47e84ee",
                                "text": "„Zu selbstverständlich gehören Frauen inzwischen zur Führungsriege der deutschen Wirtschaft, zu qualifiziert sind weibliche Universitätsabsolventen, zu groß ist die Wertschätzung und der Wunsch nach einem kollegialen Miteinander.“"
                            },
                            {
                                "example_id": "4d6e656d-2dd3-4587-99c5-caa18636e4a6",
                                "sense_id": "4b9f726c-8a15-304c-ac8d-179af47e84ee",
                                "text": "„Doch abgesehen von der Führungsriege hatte die Partei keine Basis und keine wirkliche Struktur vorzuweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
