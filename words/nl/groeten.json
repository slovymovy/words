                    "sense_id": "1725da1c-8d86-3480-8fcf-937e85aef026",
                    "sense_definition": "Iemand welkom heten of gedag zeggen met woorden of een gebaar.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "greeting_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>groette</w> mij direct toen ik zijn huis binnenkwam.",
                            "target_lang_translations": {
                                "en": "He <w>greeted</w> me immediately when I entered his house.",
                                "ru": "Он сразу <w>поприветствовал</w> меня, когда я вошел в его дом.",
                                "pl": "Od razu mnie <w>przywitał</w>, gdy wszedłem do jego domu.",
                                "de": "Er <w>grüßte</w> mich sofort, als ich sein Haus betrat.",
                                "fr": "Il m'a <w>salué</w> immédiatement quand je suis entré dans sa maison.",
                                "it": "Mi ha <w>salutato</w> subito quando sono entrato in casa sua.",
                                "cs": "Okamžitě mě <w>pozdravil</w>, když jsem vešel do jeho domu.",
                                "tr": "Eve girdiğimde beni hemen <w>selamladı</w>.",
                                "es": "Él me <w>saludó</w> inmediatamente cuando entré en su casa.",
                                "zh": "我走进他家时，他立刻向我<w>问候</w>。"
                            }
                        },
                        {
                            "text": "Ik <w>groet</w> de buren altijd vriendelijk als ik ze op straat zie.",
                            "target_lang_translations": {
                                "en": "I always <w>greet</w> the neighbors kindly when I see them on the street.",
                                "ru": "Я всегда дружелюбно <w>здороваюсь</w> с соседями, когда вижу их на улице.",
                                "pl": "Zawsze przyjaźnie <w>witam</w> sąsiadów, gdy widzę ich na ulicy.",
                                "de": "Ich <w>grüße</w> die Nachbarn immer freundlich, wenn ich sie auf der Straße sehe.",
                                "fr": "Je <w>salue</w> toujours les voisins amicalement quand je les vois dans la rue.",
                                "it": "<w>Saluto</w> sempre i vicini gentilmente quando li vedo per strada.",
                                "cs": "Vždycky přátelsky <w>pozdravím</w> sousedy, když je vidím na ulici.",
                                "tr": "Komşuları sokakta gördüğümde her zaman nazikçe <w>selamlarım</w>.",
                                "es": "Siempre <w>saludo</w> amablemente a los vecinos cuando los veo en la calle.",
                                "zh": "我在街上见到邻居时，总是友好地跟他们<w>打招呼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "begroeten"
                    ],
                    "antonyms": [
                        "negeren"
                    ],
                    "common_phrases": [
                        "vriendelijk groeten",
                        "iemand groeten"
