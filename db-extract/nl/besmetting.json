                "senses": [
                    {
                        "sense_id": "4cd47b9b-46b4-387b-8a6d-c8432dfcbf0c",
                        "entry_id": "c361ce5d-89e5-385b-805c-f90d547e904b",
                        "glosses": [
                            "blootstelling aan een ziektekiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caeb8817-298f-4b0d-a750-ff6953bc7af5",
                                "sense_id": "4cd47b9b-46b4-387b-8a6d-c8432dfcbf0c",
                                "text": "Niet iedereen wordt van een besmetting ziek, er zijn genoeg gezonde dragers van ziektekiemen."
                            },
                            {
                                "example_id": "958e81bb-63dd-42ff-ad20-91072ff4376a",
                                "sense_id": "4cd47b9b-46b4-387b-8a6d-c8432dfcbf0c",
                                "text": "Volgens de Gezondheidsraad kan PrEP helpen het aantal besmettingen van hiv te verlagen. Critici vinden dat het seks zonder condoom aanspoort."
                            },
                            {
                                "example_id": "8f14bec7-2862-4f40-ae4e-88c3910ff17e",
                                "sense_id": "4cd47b9b-46b4-387b-8a6d-c8432dfcbf0c",
                                "text": "In veel Europese landen stabiliseert het aantal doden en besmettingen, in Zweden blijft de curve doorlopen."
                            },
                            {
                                "example_id": "b0d1a398-cf09-4874-8567-b24626e58f77",
                                "sense_id": "4cd47b9b-46b4-387b-8a6d-c8432dfcbf0c",
                                "text": "Sinds 5 oktober is voor heel het land weer een ophok- en afschermplicht van kracht voor houders van pluimvee en andere vogelsoorten. De maatregel werd afgekondigd vanwege een toename van het aantal besmettingen in september en uit angst voor meer besmettingen bij voornamelijk wilde vogels. De plicht om vogels binnen te laten geldt niet alleen voor bedrijven, maar ook voor hobbyhouders."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ef3b5c9-f152-3abf-8fcc-21f037927c5c",
                        "entry_id": "c361ce5d-89e5-385b-805c-f90d547e904b",
                        "glosses": [
                            "blootstelling aan een radioactieve isotoop, gewoonlijk door aanraking of inname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e74914a-0e5a-40bb-91fc-a89a0580123c",
                                "sense_id": "2ef3b5c9-f152-3abf-8fcc-21f037927c5c",
                                "text": "Vooral een besmetting met radioactief jodium is gevaarlijk na een kernongeluk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c6ba858-ba97-4479-9cc5-21b42e8d2e85",
                        "source_entry_id": "c361ce5d-89e5-385b-805c-f90d547e904b",
                        "source_sense_id": "4cd47b9b-46b4-387b-8a6d-c8432dfcbf0c",
