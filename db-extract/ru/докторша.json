                ],
                "senses": [
                    {
                        "sense_id": "bd4e9390-7c9d-34e9-af15-5ec377a4ddab",
                        "entry_id": "033415a0-d0c0-376c-aaa7-828a75be4633",
                        "glosses": [
                            "разг. женск. к доктор; специалист с высшим медицинским образованием; врач"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00b29ae6-de5f-4611-80af-fd05eb90256d",
                                "sense_id": "bd4e9390-7c9d-34e9-af15-5ec377a4ddab",
                                "text": "— Это у вас бред, — ласково сказала докторша, — вы в лечебнице, мы вас вылечим."
                            },
                            {
                                "example_id": "60f7213a-65d4-4a05-b9da-302465db0edf",
                                "sense_id": "bd4e9390-7c9d-34e9-af15-5ec377a4ddab",
                                "text": "А потом пятый «А» был в одном из флигелей при школьном дворе, и докторша в самом деле могла запутаться, потому что она у нас бывала редко, постоянно она работала в первой школе."
                            }
                        ]
                    },
                    {
                        "sense_id": "1caaf590-ac43-3e13-9663-1f6436f27210",
                        "entry_id": "033415a0-d0c0-376c-aaa7-828a75be4633",
                        "glosses": [
                            "разг. жена доктора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "412eec73-2e84-4560-b8e3-3bf214cef4e5",
                                "sense_id": "1caaf590-ac43-3e13-9663-1f6436f27210",
                                "text": "Эта докторша была одних лет с Анной Федоровной и большая её приятельница, сам же доктор вот уже с год заехал куда-то сперва в Оренбург, а потом в Ташкент, и уже с полгода как от него не было ни слуху ни духу, так что если бы не дружба с госпожою Красоткиной, несколько смягчавшая горе оставленной докторши, то она решительно бы истекла от этого горя слезами."
                            },
                            {
                                "example_id": "366b79e3-1896-4a8a-aeae-d9064d059759",
                                "sense_id": "1caaf590-ac43-3e13-9663-1f6436f27210",
                                "text": "Когда доктор ушёл, уведя свою жену, и поместился с нею в кибиточку, офицеры улеглись в корчме, укрывшись мокрыми шинелями; но долго не спали, то переговариваясь, вспоминая испуг доктора и веселье докторши, то выбегая на крыльцо и сообщая о том, что делалось в кибиточке."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0c0e34c-e2db-338f-94ba-b76885ca6a56",
                        "entry_id": "033415a0-d0c0-376c-aaa7-828a75be4633",
                        "glosses": [
                            "разг. женск. к доктор; женщина имеющая докторскую учёную степень"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9bc01ba-2ed1-4792-90d3-03ddd9630b1c",
                        "source_entry_id": "033415a0-d0c0-376c-aaa7-828a75be4633",
                        "source_sense_description": "женщина-врач",
                        "target_lang_word": "Ärztin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ärztin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                        "entry_id": "ee24931e-ff0f-3ebb-9449-64f97d1f562c",
                                        "glosses": [
                                            "Heilkundige, die ein Medizinstudium abgeschlossen hat und nach Erlangung der medizinischen Approbation körperliche und seelische Krankheiten behandelt"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Gesundheitswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd22190-ac45-4d86-ad83-d4c18b74d11e",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "Meine Ärztin hat mir dieses Medikament empfohlen."
                                            },
                                            {
                                                "example_id": "dd8cc088-4b8e-4939-926e-200ddfc584a5",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "Samanthas Töchter sind beide Ärztinnen geworden."
                                            },
                                            {
                                                "example_id": "622ffc90-c9c0-48e5-975a-e098e1b8b756",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "„Joyce sagt, dass sie früher Ärztin werden wollte.“"
                                            },
                                            {
                                                "example_id": "7e0d3d3e-16f8-4039-9cad-dba3faeb1eb4",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "„Besonders im Examen mußten sich die angehenden Ärztinnen auf alles gefaßt machen.“"
                                            },
                                            {
                                                "example_id": "7ba0af31-bfdb-432d-9f45-3fda516d30fa",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "„Das berufsernste Gesicht der Ärztin entspannt sich, ihre Wangen zeigen farbige Zeichen innerer Freude.“"
                                            },
                                            {
                                                "example_id": "ada7d190-3c90-4c75-8038-c5896fa0b167",
                                                "sense_id": "4c7e63bf-f94f-3aa2-8d20-c6744096a0d4",
                                                "text": "„Die Ärztin sagte dies sehr entschieden und erst jetzt fiel mir auf, dass sie gar keinen Arztkittel trug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
