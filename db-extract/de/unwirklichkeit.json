                ],
                "senses": [
                    {
                        "sense_id": "01c09ebd-dc60-33ef-998a-fcec59343da7",
                        "entry_id": "332435f0-bef9-349c-b9cc-ea8ab39d337d",
                        "glosses": [
                            "Eigenschaft, nicht real, sondern nur gedacht, irreal oder auch nicht nachvollziehbar zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17fbe608-4131-4a7d-9444-b735d9b3077f",
                                "sense_id": "01c09ebd-dc60-33ef-998a-fcec59343da7",
                                "text": "„Er komponierte einen Schwebezustand, dessen Klang der Unwirklichkeit des dramatischen Augenblicks kongenial entspricht.“"
                            },
                            {
                                "example_id": "4c0f746c-9a6c-40b7-8504-154653f4384c",
                                "sense_id": "01c09ebd-dc60-33ef-998a-fcec59343da7",
                                "text": "„Zum einen kann eine soziale Unwirklichkeit ausfindig gemacht werden, die gesellschaftlich Unmögliches ermöglicht.“"
                            },
                            {
                                "example_id": "03b6e1b3-3787-4cd5-b89b-a80ef52a44e7",
                                "sense_id": "01c09ebd-dc60-33ef-998a-fcec59343da7",
                                "text": "„Die Übergänge zwischen den Sphären des Festes und des Alltags werden vom Gefühl der Unwirklichkeit begleitet.“"
                            },
                            {
                                "example_id": "507c9bc7-3b10-45fc-a0ed-2d40005c0552",
                                "sense_id": "01c09ebd-dc60-33ef-998a-fcec59343da7",
                                "text": "„Und wenn dich die Wirklichkeit ermüdet, wirst du an der Unwirklichkeit ausruhen können.“"
                            },
                            {
                                "example_id": "94355e92-ec64-4b48-a95d-8d3df8c9aa28",
                                "sense_id": "01c09ebd-dc60-33ef-998a-fcec59343da7",
                                "text": "„Die Fiktion ‚setzt‘ die Unwirklichkeit der Wirklichkeit und die Wirklichkeit der Unwirklichkeit.“"
                            },
                            {
                                "example_id": "0f255cc7-26eb-43e6-afa1-f8dc29034f7a",
                                "sense_id": "01c09ebd-dc60-33ef-998a-fcec59343da7",
                                "text": "„Der Mensch ist frei, sich gegen die Wirklichkeit Gottes zu wenden, weil das All-Eine die göttliche Wirklichkeit und die gottlose Unwirklichkeit umfaßt.“"
                            },
                            {
                                "example_id": "82b0d623-b730-4912-99da-2b1365616570",
                                "sense_id": "01c09ebd-dc60-33ef-998a-fcec59343da7",
                                "text": "„Neurotiker betrachten die Wirklichkeit manchmal als etwas Unwirkliches und halten die Unwirklichkeit für wirklich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
