                ],
                "senses": [
                    {
                        "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                        "entry_id": "b98b7058-e454-36de-8ee2-5fe41405628b",
                        "glosses": [
                            "größeres Gerät zur Speicherung elektrischer Energie (in Form von Akkumulatoren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a0e3c4-2098-4da4-9421-4cfadac78947",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Es gibt […] noch nicht genug Batteriespeicher.“"
                            },
                            {
                                "example_id": "eed77262-804a-402e-a60e-37a5c188bb7a",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„«Falls die Solaranlage wegen einer Wolke keinen Strom produzieren kann, kommt dieser aus dem Batteriespeicher.»“"
                            },
                            {
                                "example_id": "1302401b-9401-4de5-9778-5e939bda8a87",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Bei einem Solargenerator handelt es sich im Grunde um eine kleine Photovoltaik-Anlage, die mit einem Batteriespeicher ausgestattet ist.“"
                            },
                            {
                                "example_id": "b3e8572d-f4db-4a1e-a4e8-212a24de3452",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Der Einsatz eines Batteriespeichers kann den Autarkiegrad auf 55 Prozent oder gar höher steigern.“"
                            },
                            {
                                "example_id": "aa63f22f-7f58-4628-b0cd-2ea13a870ae3",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Sofern eine ausreichend große Photovoltaikanlage sowie ein Batteriespeicher zur Zwischenspeicherung vorhanden sind, ließen sich laut Zahlen aus dem Jahr 2018 rund 60 % des Jahresstrombedarfs der Wärmepumpe aus selbst erzeugtem Solarstrom decken.“"
                            },
                            {
                                "example_id": "3d77ae8e-d28c-4d0b-83d3-c0640092342e",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Die Verbrauchzentrale hält einen klassischen Batteriespeicher aktuell für unwirtschaftlich, dem gegenüber stehen jedoch Kostenkalkulationen, die zeigen, dass eine Amortisation durchaus überschaubar sei.“"
                            },
                            {
                                "example_id": "81f81d45-b448-4341-b721-ee526a1c486f",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Eine Alternative zur Speicherung von Solarstrom in Batteriespeichern besteht in der Speicherung der Energie in Wärmespeichern.“"
                            },
                            {
                                "example_id": "76444a61-f615-46ee-b6a0-b911e2c20dcf",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Große Batteriespeicher werden wichtiger für die Energiewende.“"
                            },
                            {
                                "example_id": "e629b693-e3b5-4cf6-a635-a096f0b2753c",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„»Die Kosten großer Batteriespeicher sind massiv gesunken.«“"
                            },
                            {
                                "example_id": "11ec4590-9250-4ef9-9749-62d3f650727f",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Im Salzlandkreis in Sachsen-Anhalt baut das deutsch-norwegische Unternehmen Eco Stor in unmittelbarer Nähe des Umspannwerks Förderstedteinen einen gigantischen Batteriespeicher.“"
                            },
                            {
                                "example_id": "f2ee04df-f2a5-4b7f-bb1a-7373f01fc344",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Das Unternehmen will Europas größten Batteriespeicher errichten.“"
                            },
                            {
                                "example_id": "37c8816a-7fe8-4c8c-b27b-417830d4e874",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Als der Batteriespeicher im Stadtteil Lankow vor zehn Jahren eingeweiht wurde, war er der größte seiner Art in Europa.“"
                            },
                            {
                                "example_id": "619d27e4-6282-4491-a187-8cb49905cd9c",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Der Batteriespeicher soll in zwei Ausbaustufen gebaut werden.“"
                            },
                            {
                                "example_id": "905c4528-27fb-49f2-a1e0-d188e5d541ca",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Am 19.April wird in Bollingstedt-Gammelund der erste Spatenstich getätigt. Im Jahr 2026 soll der Batteriespeicher ans Netz gehen.“"
                            },
                            {
                                "example_id": "4b6fab19-fc93-4581-ad0d-7aa71821e19a",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Der Batteriespeicher könnte frühestens 2028 seinen Betrieb aufnehmen.“"
                            },
                            {
                                "example_id": "4b1cd3d5-ebcd-4c06-b75d-059833b73f69",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Mit dem Batteriespeicher könnte man nach Auskunft der Stadt zum Beispiel rund 170.000 Haushalte sechs Stunden mit Strom versorgen.“"
                            },
                            {
                                "example_id": "cc478fdc-1a3d-4136-abdd-e561c5031e14",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Seit zehn Jahren sorgt der Batteriespeicher des Energieversorgers WEMAG in Schwerin für ein stabiles Stromnetz.“"
                            },
                            {
                                "example_id": "cd6e4a28-46dc-4501-b48a-ef36e735f0f7",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Solaranlagen machen das Stromnetz immer komplexer. Batteriespeicher helfen dabei, das Netz stabil zu halten.“"
                            },
                            {
                                "example_id": "b77d5642-8496-4e92-8ad6-29ca93be4480",
                                "sense_id": "d883884b-2d11-3dbd-a941-e0b03062d3a7",
                                "text": "„Die Batterie soll die Stabilität des Schweizer Stromnetzes sicherstellen: «Das Stromnetz mit immer mehr Photovoltaikanlagen und Wärmepumpen hat Schwankungen, der Batteriespeicher kann diese stabilisieren», sagt Marcel Aumer, CEO der zuständigen Firma Flexbase.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
