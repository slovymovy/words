                "senses": [
                    {
                        "sense_id": "9f483297-cbf5-3548-b963-e4e06a3e0720",
                        "entry_id": "0f898f29-1978-3f55-8618-66eb9d50d22d",
                        "glosses": [
                            "automatisierter Prozess, dessen Endprodukt ein bestimmter Kunststoff ist"
                        ],
                        "tags": [
                            "selten im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9afd59f5-8e2d-4383-a015-d0c33b101712",
                                "sense_id": "9f483297-cbf5-3548-b963-e4e06a3e0720",
                                "text": "„Das Geheimnis der Kunststoffherstellung liegt in drei Hauptbereichen: Die Auswahl der geeigneten Rezeptur im Hinblick auf die gewünschten Eigenschaften; Die Gestaltung der Gussform und Prozessbedingungen; Das Design der Fertigungsanlagen“"
                            },
                            {
                                "example_id": "228d9874-a5d9-4246-b40e-c5c6208c7518",
                                "sense_id": "9f483297-cbf5-3548-b963-e4e06a3e0720",
                                "text": "„Zusammengefaßt kann gesagt werden, daß im Zwischenbericht umfangreiches Zahlen- und Datenmaterial vorliegt, welches einen guten Überblick über die Unternehmen der Kunststoffherstellung und -verarbeitung gibt.“"
                            },
                            {
                                "example_id": "412c94a5-3395-4b8d-8697-744af627615f",
                                "sense_id": "9f483297-cbf5-3548-b963-e4e06a3e0720",
                                "text": "Es dominiert die Verarbeitungs- und Konsumgüterindustrie, besondere Wachstumsindustrien sind die Kunststoffherstellung und die Elektronik."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
