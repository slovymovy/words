                "entry_id": "340c056d-b31b-3b6b-9640-d1fc6d68b95e",
                "word": "laxisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ad116192-e920-4777-9e6f-c82b8102c6b4",
                        "entry_id": "340c056d-b31b-3b6b-9640-d1fc6d68b95e",
                        "tags": [
                            "plural"
                        ],
                        "form": "laxismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1381ebad-9090-389f-8900-2e17eb109bba",
                        "entry_id": "340c056d-b31b-3b6b-9640-d1fc6d68b95e",
                        "glosses": [
                            "Système de pensées qui nie, ou limite, les interdits."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a7008216-84f5-3afb-8224-74f7403d93ea",
                        "entry_id": "340c056d-b31b-3b6b-9640-d1fc6d68b95e",
                        "glosses": [
                            "Trop grande tolérance, indulgence excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "404b103e-750a-4cab-8809-13a82b063098",
                                "sense_id": "a7008216-84f5-3afb-8224-74f7403d93ea",
                                "text": "L'ambivalence et le laxisme des autorités de l'État laïque et de la nouvelle intelligentsia séculière ébranlèrent le sécularisme même. Dès l'instant […] où l'influence européenne diminua, la laïcité déclina et son attrait se volatilisa."
                            },
                            {
                                "example_id": "7fc27d43-28f7-4ce1-a03b-a4338841df93",
                                "sense_id": "a7008216-84f5-3afb-8224-74f7403d93ea",
                                "text": "La recherche constante de la facilité, l'économie suscitée par ces laxismes, la recherche de l'aisance sont toutes des ouvertures à l'anarchie sociale."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb826c66-c0dd-3f14-8c11-078100bcfb9f",
                        "entry_id": "340c056d-b31b-3b6b-9640-d1fc6d68b95e",
                        "glosses": [
                            "Laisser-aller, manque de rigueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dd7615a-04aa-4e34-9499-f83cd8ce07cb",
                                "sense_id": "bb826c66-c0dd-3f14-8c11-078100bcfb9f",
                                "text": "Il aurait fallu que la langue française ne chût pas sous les coups répétés de l’invasion des anglicismes et du laxisme."
                            },
                            {
                                "example_id": "04583cb9-7358-4a12-85bc-35ee1c0e8f5b",
                                "sense_id": "bb826c66-c0dd-3f14-8c11-078100bcfb9f",
                                "text": "On nous avait promis des recommandations avant le congé des Fêtes. Le gouvernement n’a toujours pas tenu parole et nous garde dans le noir.\n (...),\n Les experts en santé publique sont surpris de ce laxisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a7ceb73-d29a-4304-83a1-f546ffddfda8",
                        "source_entry_id": "340c056d-b31b-3b6b-9640-d1fc6d68b95e",
                        "target_lang_word": "lenience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lenience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dfa3c52-e012-3947-8f1c-14d8f60762b1",
                                        "entry_id": "1c72c47b-48d4-37bf-b253-3162fad2d2fe",
                                        "glosses": [
                                            "Leniency: mercy or forgiveness in the assignment of punishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28bb4ed6-3add-4ebf-846d-babda054b33f",
                                                "sense_id": "8dfa3c52-e012-3947-8f1c-14d8f60762b1",
                                                "text": "There was lenience in the sentence given by the court, and he got the minimum prison time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55e829bc-7300-4d46-95cb-c49a41c6b5e9",
                        "source_entry_id": "340c056d-b31b-3b6b-9640-d1fc6d68b95e",
                        "target_lang_word": "permissiveness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permissiveness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "866fd1d9-0ae9-35cf-8570-3d5e48036bd4",
                                        "entry_id": "626d5085-22cf-31d0-9dc9-24a61423dafe",
                                        "glosses": [
                                            "The relative likelihood of something or someone to grant permission or allow something to happen."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c419d1d1-8139-4097-b8d0-fb850416e163",
                                                "sense_id": "866fd1d9-0ae9-35cf-8570-3d5e48036bd4",
                                                "text": "The permissiveness of campus life leads many college freshmen to try things they would never have experienced at home."
                                            },
                                            {
                                                "example_id": "808b9b0d-0775-4a84-8d67-7a2a9227cedb",
                                                "sense_id": "866fd1d9-0ae9-35cf-8570-3d5e48036bd4",
                                                "text": "It is no accident that capital punishment is reentering our society on the wave of the conservative reaction to the permissiveness and laxity of the past two decades."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
