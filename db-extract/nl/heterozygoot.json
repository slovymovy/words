                                "target_senses": [
                                    {
                                        "sense_id": "3653412e-369e-3709-96d4-7000bea58519",
                                        "entry_id": "418741b8-039a-37c4-9324-cf308476a545",
                                        "glosses": [
                                            "Of an organism: having two different alleles in a given gene."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b6ae264-c119-4ca8-a042-034b7d7874f8",
                                                "sense_id": "3653412e-369e-3709-96d4-7000bea58519",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, and individual plants are highly heterozygous and do not breed true. In addition, we are looking for rare alleles, so the more plants we try, the better."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f6abb8b-1d0b-42c9-8888-55f531ce9a3e",
                        "source_entry_id": "b7771404-cb53-3fe8-934f-a65503b96e25",
                        "source_sense_id": "8be9a5ba-c1da-3403-a243-0b136a0d6ca9",
                        "source_sense_description": "in het bezit zijnde van twee allelen van een gen bij een (diploïd) organisme",
                        "target_lang_word": "hétérozygote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hétérozygote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef73bafd-b9e7-3e12-853a-54d3b8d175f2",
                                        "entry_id": "419f7c78-5d73-3aa8-86d9-8fc341082868",
                                        "glosses": [
                                            "Qui possède deux allèles différents d’un gène sur un même locus pour chacun de ses chromosomes homologues."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4bf4f2f-3e87-46a3-91c8-061b3a169185",
                                                "sense_id": "ef73bafd-b9e7-3e12-853a-54d3b8d175f2",
                                                "text": "En cas de transmission récessive liée à l’X, les femmes sont très souvent homozygotes et n’expriment pas la maladie, tandis que les hommes sont forcément hétérozygotes et expriment toujours la maladie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hétérozygote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca1cbe39-a366-32cb-a6ec-abe5f37eee89",
                                        "entry_id": "350413a6-3e8a-338d-a402-4a59596f8e8d",
                                        "glosses": [
                                            "Organisme ou individu dont les allèles sont différents pour un même gène."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5224e4-a178-4e9e-8d9b-09b37c79dfd2",
                                                "sense_id": "ca1cbe39-a366-32cb-a6ec-abe5f37eee89",
                                                "text": "Un allèle peut être dominant mais deux allèles peuvent aussi s’exprimer simultanément dans un même trait. Dans de tels cas, les deux allèles influent sur le phénotype de l’hétérozygote. Par exemple, une plante à fleurs rouges croisée avec une plante à fleurs blanches donnera une plante à fleurs roses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
