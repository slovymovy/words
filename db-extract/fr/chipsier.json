                        "examples": [
                            {
                                "example_id": "f1bacf00-d902-4d73-98c7-f6c9df89c46e",
                                "sense_id": "b1eb3696-857c-3cf5-8d8a-c2f908626445",
                                "text": "Le chipsier français Brets, connu pour sa vaste gamme de chips aromatisées, a lancé un concours sur les réseaux sociaux pour demander aux internautes d’imaginer de futures saveurs."
                            },
                            {
                                "example_id": "472d0fac-78d5-43b7-ab38-d324f0039ec1",
                                "sense_id": "b1eb3696-857c-3cf5-8d8a-c2f908626445",
                                "text": "Si les parfumeurs ont leur nez, le chipsier breton a ses palais qui testent, goûtent et valident les nouvelles recettes naturelles élaborées par le labo d’Altho."
                            }
                        ]
