        "fr-extract.jsonl": [
            {
                "entry_id": "594435b6-0b78-3ba9-b1a6-e35186c51ee4",
                "word": "poucettes",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6e4b14b4-add8-325f-aeea-585d89d6f6c7",
                        "entry_id": "594435b6-0b78-3ba9-b1a6-e35186c51ee4",
                        "glosses": [
                            "Corde, chaînette ou mécanisme métallique dont on se sert pour attacher les pouces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd67f940-6e59-431d-a6f6-2cd09c3607c1",
                                "sense_id": "6e4b14b4-add8-325f-aeea-585d89d6f6c7",
                                "text": "C'est un flic qui lui a donné le tuyau, lors du transfert de Montpellier à Albi en fourgon: les poucettes immobilisent autant, voire plus, et plus petites elles sont plus pratiques à transporter."
                            },
                            {
                                "example_id": "716cfccd-3229-451d-a3e6-e6019b61a7dc",
                                "sense_id": "6e4b14b4-add8-325f-aeea-585d89d6f6c7",
                                "text": "Et il tira des poucettes de sa poche."
                            }
                        ]
                    },
                    {
                        "sense_id": "c051d7e4-505c-394e-a5d8-71815587f918",
                        "entry_id": "594435b6-0b78-3ba9-b1a6-e35186c51ee4",
                        "glosses": [
                            "Appareil de torture destiné à écraser les pouces."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00b8359f-7787-4b75-8961-3c9fd216f4f8",
                                "sense_id": "c051d7e4-505c-394e-a5d8-71815587f918",
                                "text": "Suivant la grosseur des pouces ou le calibre des poucettes, après un nombre plus ou moins grand de tours de l’ailette remontant la plaque de serrage, l’homme perd connaissance et le sang transsude par les pores de l’extrémité du pouce. Quelques minutes après la mise aux poucettes, la partie extrême du pouce enfle ; l’arrêt de la circulation donne à la chair des tons violâtres ; le pouce s’insensibilise alors par l’excès même de la douleur, à condition toutefois qu’on ne réveillé pas cette douleur par des mouvements : afin d’aggraver la torture, les gradés, qui connaissent cette particularité, viennent secouer ou tirer les poucettes."
                            },
                            {
                                "example_id": "57e88211-9031-4bc7-b3a3-d7596a4c5e35",
                                "sense_id": "c051d7e4-505c-394e-a5d8-71815587f918",
                                "text": "Nous avons en effet découvert une véritable chambre de tortures ! Chevalets, colliers pointus, cangues, brodequins, poucettes."
                            }
                        ]
                    }
                ],
