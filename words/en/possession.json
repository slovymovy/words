                            {
                                "target_lang_word": "着魔",
                                "target_lang_sense_clarification": "指被邪恶力量所困"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72b3fadc-cf45-39b5-a0c1-48e55bbdb357",
                    "sense_definition": "Control or occupancy of something for which one does not necessarily have private property rights.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ownership_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law distinguishes between actual <w>possession</w> and legal title to the land.",
                            "target_lang_translations": {
                                "ru": "Закон различает фактическое <w>владение</w> и юридическое право собственности на землю.",
                                "zh": "法律区分了土地的实际<w>占有</w>与法律所有权。"
                            }
                        },
                        {
                            "text": "The engineers took <w>possession</w> of the railway line to perform essential maintenance.",
                            "target_lang_translations": {
                                "ru": "Инженеры вступили во <w>владение</w> железнодорожной линией для проведения необходимого ремонта.",
                                "zh": "工程师们接管了铁路线以进行必要的维护。"
                            }
                        }
