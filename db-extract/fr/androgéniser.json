                "senses": [
                    {
                        "sense_id": "13431822-41d7-3b84-bc9d-7bce4a2f7db8",
                        "entry_id": "f8db94fb-8c33-3b4c-9e21-305e0b5047b7",
                        "glosses": [
                            "Administrer des androgènes à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfc751f9-7dfb-486b-ad0e-292276a01a48",
                                "sense_id": "13431822-41d7-3b84-bc9d-7bce4a2f7db8",
                                "text": "On a même pu « androgéniser » à la naissance des souris femelles qui ont ensuite, au vingt-cinquième jour, été « ovariectomisées », puis isolées."
                            },
                            {
                                "example_id": "af8ff6bf-3be3-4982-9e37-69decb6e6bf8",
                                "sense_id": "13431822-41d7-3b84-bc9d-7bce4a2f7db8",
                                "text": "Pour androgéniser la vache, deux produits furent utilisés: le propionate de testostérone (100 mg/mL) qui est un ester de la testostérone ayant une durée d’action de 48 heures et l’Interteston® dont la durée d’action est de 15 jours."
                            }
                        ]
                    }
