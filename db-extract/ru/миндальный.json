                        ],
                        "examples": [
                            {
                                "example_id": "a788e606-d61a-4bf6-86b9-c8a4bc858682",
                                "sense_id": "b51718e0-63f6-31e9-9b47-c089502fc250",
                                "text": "минда́льное молоко́",
                                "translation": "almond milk",
                                "english": "almond milk"
                            },
                            {
                                "example_id": "c0befd9a-ef12-400e-8e96-9842fefd5931",
                                "sense_id": "b51718e0-63f6-31e9-9b47-c089502fc250",
                                "text": "Его́ ти́хие успокои́тельные ре́чи и улы́бки де́йствовали смягча́юще успокои́тельно, как минда́льное ма́сло. И А́нна ско́ро почу́вствовала э́то.",
                                "translation": "His gentle, soothing words and smiles were as soothing and softening as almond oil. And Anna soon felt this.",
                                "english": "His gentle, soothing words and smiles were as soothing and softening as almond oil. And Anna soon felt this."
                            }
                        ]
                    }
