                "senses": [
                    {
                        "sense_id": "793e0c19-2be7-3a6f-9d57-f86bd8830293",
                        "entry_id": "c30af34b-185c-3f12-aa7a-1e8f1ea18221",
                        "glosses": [
                            "illusion"
                        ],
