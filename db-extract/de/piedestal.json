                ],
                "senses": [
                    {
                        "sense_id": "489478fd-c801-3204-af98-8335f36eda4b",
                        "entry_id": "99b5d5c2-77c9-3661-8d7f-1a6476c4490d",
                        "glosses": [
                            "Sockel, Podest"
                        ],
                        "tags": [
                            "wird auch übertragen benutzt"
                        ],
                        "examples": [
                            {
                                "example_id": "f30a3146-c531-4387-a26d-d487f20fe541",
                                "sense_id": "489478fd-c801-3204-af98-8335f36eda4b",
                                "text": "„Es hat zu unterst eine viereckige Basis mit einem Gesims, dann ein Piedestal, darauf ein anderes Gesims, und zuletzt abermals ein Piedestal.“"
                            },
                            {
                                "example_id": "a1c796f3-e357-4543-a3b5-850c41b7cef1",
                                "sense_id": "489478fd-c801-3204-af98-8335f36eda4b",
                                "text": "„Das Piedestal ist ebenfalls von Marmor mit einem eisernen Gitter umgeben.“"
                            },
                            {
                                "example_id": "7dc37981-d71b-4a55-8383-129d8de9f902",
                                "sense_id": "489478fd-c801-3204-af98-8335f36eda4b",
                                "text": "„Diese Säule erhebt sich schlank und schön mit gothischen Verzierungen auf einem kolossalen Piedestale.“"
                            },
                            {
                                "example_id": "2b0f401d-0cdd-4394-9d67-e9e2b4213939",
                                "sense_id": "489478fd-c801-3204-af98-8335f36eda4b",
                                "text": "„Athen ist ein Altar der Götter, das schönste Piedestal, auf welchem die vergangenen Jahrhunderte die Statue der Humanität aufstellen konnten.“"
                            },
                            {
                                "example_id": "8213d819-ca76-4f92-9c3e-77e338cda92a",
                                "sense_id": "489478fd-c801-3204-af98-8335f36eda4b",
                                "text": "„Zur Rechten des Piedestales kniete eine weibliche Figur (das befreyte Europa), das Piedestal mit Lorbern umwindend.“"
                            },
                            {
                                "example_id": "cc7c717f-3c2b-4fce-aa89-f1ce8c972711",
                                "sense_id": "489478fd-c801-3204-af98-8335f36eda4b",
                                "text": "„Warum könnt ihr Frauen uns nicht lieben mit unseren Fehlern? Warum stellt ihr uns auf ein monströses Piedestal?“"
                            },
                            {
                                "example_id": "0b86853b-07b9-4c71-bee8-50d0f7a79fab",
                                "sense_id": "489478fd-c801-3204-af98-8335f36eda4b",
                                "text": "Als er seine geliebte Rosalie mit einem anderen Mann in wilder Umarmung sah, stürzte sie von dem hohen Piedestal, auf das er sie gestellt hatte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "74c41d20-11a0-39ca-80f8-3b891fc87342",
                        "entry_id": "99b5d5c2-77c9-3661-8d7f-1a6476c4490d",
                        "glosses": [
                            "höheres Gestell mit schräg nach außen stehenden Beinen, das für Vorführungen (insbesondere mit Tieren) im Zirkus genutzt wird"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "fa372884-cf35-4386-937c-5dbbf98ad13b",
                                "sense_id": "74c41d20-11a0-39ca-80f8-3b891fc87342",
                                "text": "„Eduardo Cardenal arbeitete viele Jahre mit einer Äquilibristik-Darbietung, u.a. mit Handstand auf dem hohen Piedestal und dem Kopfstand auf dem Seil.“"
                            },
                            {
                                "example_id": "9886d348-62d5-47fc-86ec-3eb3e0f99014",
                                "sense_id": "74c41d20-11a0-39ca-80f8-3b891fc87342",
                                "text": "„Während er als stolzer Reiter im Roten Ring sein Dressurtalent beweist, zeigt sie hoch auf dem Piedestal ihr ganzes Können.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
