                        ]
                    },
                    {
                        "translation_id": "16fcfb42-95bb-4686-ae27-4c4cd607c4d2",
                        "source_entry_id": "8fb2e9f5-7071-3a01-ba7a-ae211a601cfe",
                        "source_sense_id": "7ef01ae3-3dd0-33c4-a6b4-a70bf115a6b6",
                        "source_sense_description": "Botanik: Pflanze, die an salzreiche Standorte angepasst ist",
                        "target_lang_word": "halophyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halophyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "928d9ca3-241f-3a43-b83a-2c0706ee0a51",
                                        "entry_id": "b8358fe1-1e69-3084-a7fe-7509d46f76b8",
                                        "glosses": [
                                            "Halophile, adaptée aux milieux salés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae1848ea-82a8-4518-a059-c15bd70360b3",
                                                "sense_id": "928d9ca3-241f-3a43-b83a-2c0706ee0a51",
                                                "text": "On imagine les conditions extrêmes auxquelles flore et faune doivent se plier : elles en tirent une grande originalité, telles ces plantes dites halophytes qui parviennent à pousser sur les boues salées des solontchak."
                                            },
                                            {
                                                "example_id": "484ee568-a41f-4e5b-ad7e-0c0675fecaad",
                                                "sense_id": "928d9ca3-241f-3a43-b83a-2c0706ee0a51",
                                                "text": "C’est une plante halophyte qui supporte les terrains salés et qui prend le pas sur d’autres espèces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "halophyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f865e8e-8973-39f9-a9d2-0a342585cba2",
                                        "entry_id": "3f850fb3-501d-330d-8578-70d851e062df",
                                        "glosses": [
                                            "Plante adaptée aux milieux salés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3363b14-aa15-4af2-8642-b39c39ff7d8c",
                                                "sense_id": "6f865e8e-8973-39f9-a9d2-0a342585cba2",
                                                "text": "L’une des halophytes les plus connues est la salicorne."
                                            },
                                            {
                                                "example_id": "f45747c5-d06e-40ea-a406-aa9e89b45fcb",
                                                "sense_id": "6f865e8e-8973-39f9-a9d2-0a342585cba2",
                                                "text": "Effet de la salinité du milieu de culture sur les voies de carboxylation d’une halophyte (Plantago maritima L. Var . graminaea) et d’une glycophyte (Plantago lanceolata L.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
