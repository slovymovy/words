                "senses": [
                    {
                        "sense_id": "6692bd2e-c928-35bc-a18a-9ee303334d86",
                        "entry_id": "7f11a43b-27d0-3b84-b518-3e9e700d9ff4",
                        "glosses": [
                            "een vrachtwagen waarmee men vloeistoffen, gassen of poeders kan vervoeren in een grote tank die deel uitmaakt van de vrachtwagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f457ed28-03d7-4f18-8fd1-2ad9a411bc29",
                                "sense_id": "6692bd2e-c928-35bc-a18a-9ee303334d86",
                                "text": "De tankwagen bevat volgens het gedupeerde transportbedrijf een onschuldig oliezuur, waarmee zeep, tandpasta en scheerschuim wordt gemaakt."
                            },
                            {
                                "example_id": "ecf43aed-274e-4be5-8997-fe171af140ab",
                                "sense_id": "6692bd2e-c928-35bc-a18a-9ee303334d86",
                                "text": "Zeker zes mensen, onder wie een gezin, zijn dinsdag in Italië om het leven gekomen door een ongeval waarbij een tankwagen vlam vatte."
                            }
                        ]
                    }
                ],
