                "senses": [
                    {
                        "sense_id": "9f02dfb4-6dbf-3bcd-8fa4-366dcaa4b852",
                        "entry_id": "883c9f32-10b3-391d-8933-be7b0ee1714b",
                        "glosses": [
                            "Salz, das als Streumittel bei der Glatteisbekämpfung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "985183eb-270a-4512-8a15-3753f7094073",
                                "sense_id": "9f02dfb4-6dbf-3bcd-8fa4-366dcaa4b852",
                                "text": "„Frost und Schnee bedeuten auch mehr Streusalz auf Österreichs Straßen.“"
                            },
                            {
                                "example_id": "07412a11-23a6-483a-a9f9-1441c821fe07",
                                "sense_id": "9f02dfb4-6dbf-3bcd-8fa4-366dcaa4b852",
                                "text": "„In einem zweiten Gutachten hieß es, dass am Tag des Unfalls zu viel Streusalz auf der Straße lag, nämlich ca. 80 bis 90 Gramm pro Quadratmeter statt 40 Gramm, die eigentlich genügt hätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1094fb4-9552-43f0-8715-d685a61885d4",
                        "source_entry_id": "883c9f32-10b3-391d-8933-be7b0ee1714b",
                        "source_sense_id": "9f02dfb4-6dbf-3bcd-8fa4-366dcaa4b852",
