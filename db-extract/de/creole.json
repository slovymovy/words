                        "entry_id": "b7821f1f-2873-3fa7-9812-e62db38e5270",
                        "glosses": [
                            "großer, ringförmiger Ohrschmuck, in den ein kleiner Schmuckstein eingehängt werden kann"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "bdc2014b-47d2-4aa7-a81e-eb74ca44aed1",
                                "sense_id": "3a2ec6c5-bee8-324c-b292-04e6e8fda5d1",
                                "text": "Sie trug Creolen aus Gold."
                            },
                            {
                                "example_id": "f883f227-f733-4d59-83e3-4a97ed289c04",
                                "sense_id": "3a2ec6c5-bee8-324c-b292-04e6e8fda5d1",
                                "text": "„Mama fragte nach einem Tisch am Fenster, für die Einkaufstour hatte sie eine lange Hose und einen eleganten Mantel angezogen, kleine Creolen in den Ohren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
