    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "217234be-4d61-35b2-acec-5edaf002a6d3",
                    "sense_definition": "The quality of being suitable, useful, or easy to use.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fast food is popular because of its cost and <w>convenience</w>.",
                            "target_lang_translations": {
                                "ru": "Фастфуд популярен из-за своей цены и <w>удобства</w>.",
                                "de": "Fast Food ist beliebt wegen seines Preises und seiner <w>Bequemlichkeit</w>.",
                                "zh": "快餐之所以受欢迎，是因为它价格便宜且<w>方便</w>。"
                            }
                        },
                        {
                            "text": "We bought this house for the <w>convenience</w> of being near the school.",
                            "target_lang_translations": {
                                "ru": "Мы купили этот дом ради <w>удобства</w> жить рядом со школой.",
                                "de": "Wir haben dieses Haus wegen der <w>Annehmlichkeit</w> gekauft, in der Nähe der Schule zu sein.",
                                "zh": "我们买这栋房子是为了<w>方便</w>去学校。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inconvenience"
                    ],
                    "common_phrases": [
                        "for your convenience",
                        "marriage of convenience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество быть подходящим, полезным или простым в использовании.",
                        "de": "Die Eigenschaft, angenehm, nützlich oder einfach in der Handhabung zu sein.",
                        "zh": "指某事物适合、有用或易于使用的特性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удобство",
                                "target_lang_sense_clarification": "свойство быть удобным"
                            },
                            {
                                "target_lang_word": "комфорт",
                                "target_lang_sense_clarification": "отсутствие затруднений"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Bequemlichkeit",
                                "target_lang_sense_clarification": "das Vorhandensein angenehmer Gefühle oder Erleichterungen"
                            },
                            {
                                "target_lang_word": "Komfort",
                                "target_lang_sense_clarification": "Annehmlichkeit und Wohlbefinden"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方便",
                                "target_lang_sense_clarification": "指事物易于使用或适合需求"
                            },
                            {
                                "target_lang_word": "便利",
                                "target_lang_sense_clarification": "指使用上的顺手或快捷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c32fcdd-009b-372a-9182-97fce69089dc",
                    "sense_definition": "A time that is suitable or fits into someone's schedule.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We will come over and begin the work at your <w>convenience</w>.",
                            "target_lang_translations": {
                                "ru": "Мы приедем и начнем работу в <w>удобное для вас время</w>.",
                                "de": "Wir kommen vorbei und beginnen mit der Arbeit, wenn es Ihnen <w>gelegen</w> kommt.",
                                "zh": "我们会在您<w>方便</w>的时候过来开始工作。"
                            }
                        },
                        {
                            "text": "Please reply to this email at your earliest <w>convenience</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, ответьте на это письмо при первой <w>возможности</w>.",
                                "de": "Bitte antworten Sie auf diese E-Mail bei nächster <w>Gelegenheit</w>.",
                                "zh": "请在您最<w>方便</w>的时候尽快回复这封邮件。"
                            }
                        }
                    ],
                    "antonyms": [
                        "inconvenience"
                    ],
                    "common_phrases": [
                        "at your convenience",
                        "at your earliest convenience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время, которое подходит или вписывается в чье-то расписание.",
                        "de": "Ein Zeitpunkt, der passend ist oder in den eigenen Zeitplan passt.",
                        "zh": "指适合某人日程安排的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удобное время",
                                "target_lang_sense_clarification": "подходящий момент"
                            },
                            {
                                "target_lang_word": "возможность",
                                "target_lang_sense_clarification": "удобный случай"
                            },
                            {
                                "target_lang_word": "усмотрение",
                                "target_lang_sense_clarification": "в выражении 'по вашему усмотрению'"
                            }
                        ],
                        "de": [
