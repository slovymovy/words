                        "glosses": [
                            "Something that wards off evil; an amulet or magic charm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95818481-6f99-493f-9d8b-8a613414e407",
                                "sense_id": "efd7f85b-a9d1-3e7b-9119-c0ebf6ede612",
                                "text": "Walking in nature, we see, identify, name, recognize. This recognition is our apotropaion, that is, our warding off of fear."
                            },
                            {
                                "example_id": "b26cd8b6-6a12-4b06-9662-59fc56a1b13b",
                                "sense_id": "efd7f85b-a9d1-3e7b-9119-c0ebf6ede612",
                                "text": "Ancient literature provides clear evidence for the body of the hunchback functioning as an apotropaion."
                            }
                        ]
                    }
