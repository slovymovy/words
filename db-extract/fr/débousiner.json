                "senses": [
                    {
                        "sense_id": "05f43877-db94-3179-bd56-d3e7b7003d04",
                        "entry_id": "13f32598-5bda-3df5-89dd-a9c30c781d90",
                        "glosses": [
                            "Débarrasser de la boue, des bourbiers."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "dd09bb16-f1d6-40f2-8db2-50e5db4421fb",
                                "sense_id": "05f43877-db94-3179-bd56-d3e7b7003d04",
                                "text": "L’homme assure le passage des bêtes d’une pâture à une autre, brûle les mauvaises herbes, et selon les termes de contrats ancestraux « débousine » et « démuterne » les prairies."
                            },
                            {
                                "example_id": "8d191ee1-f4a3-4ef4-9d2c-278212d25f2a",
                                "sense_id": "05f43877-db94-3179-bd56-d3e7b7003d04",
                                "text": "Conformément aux prescriptions du cahier des charges publié par le Ministère des Colonies, ces piles ont dû être construites à sec, à l’abri de batardeaux métalliques et assises sur le rocher, nettoyé et débousiné."
                            }
                        ]
                    }
