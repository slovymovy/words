                        "examples": [
                            {
                                "example_id": "4d90e02d-6e56-48f4-81d4-5ac6f42f9705",
                                "sense_id": "fcabe200-c9a2-33a5-b7e8-523674264215",
                                "text": "„Ihre Angehörigen sind wohlhabende Kubaner, die in Jersey leben, jenseits des Flusses, in Bergen County.“"
                            },
                            {
                                "example_id": "aa996328-228e-4067-a46a-c47aef8738ef",
                                "sense_id": "fcabe200-c9a2-33a5-b7e8-523674264215",
                                "text": "Er lebte zwar nach der Flucht in Miami, aber eigentlich war er Kubaner und sehnte sich nach Hause."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "536a4a69-eaf2-47c5-9be3-da447779a706",
                        "source_entry_id": "1219f21a-86c0-3da6-8d3d-7bb75a856673",
