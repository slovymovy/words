{
    "word_family": [
        "коршуний",
        "коршунёнок"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8450e23c-4d15-35d0-8c61-d526187e193a",
                    "sense_definition": "Крупная хищная птица семейства ястребиных с длинными крыльями и загнутым клювом",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "птицы",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В небе над полем медленно кружил одинокий <w>коршун</w>, высматривая добычу.",
                            "target_lang_translations": {
                                "en": "A lonely <w>kite</w> circled slowly in the sky above the field, looking for prey."
                            }
                        },
                        {
                            "text": "Хищный <w>коршун</w> внезапно камнем бросился вниз на мелкого грызуна.",
                            "target_lang_translations": {
                                "en": "The predatory <w>kite</w> suddenly swooped down like a stone onto a small rodent."
                            }
                        }
                    ],
                    "synonyms": [
                        "коршак"
                    ],
                    "common_phrases": [
                        "хищный коршун",
                        "кружение коршуна"
                    ],
                    "target_lang_definitions": {
                        "en": "A large bird of prey of the hawk family with long wings and a hooked beak"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kite",
                                "target_lang_sense_clarification": "bird of prey"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04116416-cb6c-35cc-a6f0-aa69e5769deb",
                    "sense_definition": "Употребляется как символ хищника, злого или угрожающего человека, нападающего внезапно и безжалостно",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "переносное значение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он налетел <w>коршуном</w> на испуганного соперника, не давая ему опомниться.",
                            "target_lang_translations": {
                                "en": "He pounced like a <w>hawk</w> on his frightened opponent, not giving him a chance to recover."
                            }
                        },
                        {
                            "text": "Кредиторы налетели <w>коршунами</w> на имущество обанкротившейся компании.",
                            "target_lang_translations": {
                                "en": "The creditors descended like <w>vultures</w> on the assets of the bankrupt company."
                            }
                        }
                    ],
                    "common_phrases": [
                        "налететь коршуном"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Часто используется в переносном смысле в разговорной речи или литературе"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used as a symbol of a predator, a cruel or threatening person who attacks suddenly and ruthlessly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kite",
                                "target_lang_sense_clarification": "rapacious person"
                            },
                            {
                                "target_lang_word": "vulture",
                                "target_lang_sense_clarification": "predatory or opportunistic person"
                            },
                            {
                                "target_lang_word": "hawk",
                                "target_lang_sense_clarification": "aggressive person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}