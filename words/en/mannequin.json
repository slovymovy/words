{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f1c553d-c43c-36b0-9094-3c933fb3db4a",
                    "sense_definition": "A life-size dummy or model of the human body, used to fit or display clothes in shops.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop assistant dressed the <w>mannequin</w> in the latest summer collection.",
                            "target_lang_translations": {
                                "zh": "店员给<w>人体模型</w>穿上了最新的夏季系列服装。"
                            }
                        },
                        {
                            "text": "She stopped to look at the elegant coat displayed on a <w>mannequin</w> in the window.",
                            "target_lang_translations": {
                                "zh": "她停下脚步，看着橱窗里<w>假人模特</w>身上展示的一件优雅大衣。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shop window mannequin",
                        "store mannequin"
                    ],
                    "target_lang_definitions": {
                        "zh": "（商店用来展示或试穿服装的）人体模型，服装模特儿"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "人体模型",
                                "target_lang_sense_clarification": "服装店展示服装的模型"
                            },
                            {
                                "target_lang_word": "假人模特",
                                "target_lang_sense_clarification": "服装展示用的人体塑料或木制模型"
                            },
                            {
                                "target_lang_word": "模特人偶",
                                "target_lang_sense_clarification": "橱窗或店内摆放的人形模型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b262eebd-3900-3408-a232-61e949bbf2e2",
                    "sense_definition": "An anatomical model of the human body used for medical or first-aid training.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each student practiced chest compressions on a CPR <w>mannequin</w>.",
                            "target_lang_translations": {
                                "zh": "每位学生都在心肺复苏<w>模拟人</w>上练习了胸外按压。"
                            }
                        },
                        {
                            "text": "The paramedic checked the airway of the training <w>mannequin</w>.",
                            "target_lang_translations": {
                                "zh": "急救人员检查了培训用<w>人体模型</w>的气道。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "CPR mannequin",
                        "training mannequin"
                    ],
                    "target_lang_definitions": {
                        "zh": "（用于医学或急救训练的）模拟人，人体模型"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "人体模型",
                                "target_lang_sense_clarification": "用于医学或急救教学的人形模型"
                            },
                            {
                                "target_lang_word": "模拟人",
                                "target_lang_sense_clarification": "医学急救培训用模型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81f94b32-b07a-3072-b72e-9f150d7d33d3",
                    "sense_definition": "A jointed model of the human body used by artists to study human poses and drapery.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The painter adjusted the wooden <w>mannequin</w> to test how the shadow fell.",
                            "target_lang_translations": {
                                "zh": "画家调整了木制<w>人体模型</w>的姿势，以观察阴影的投射效果。"
                            }
                        },
                        {
                            "text": "He keeps an articulated <w>mannequin</w> on his desk to help with figure drawing.",
                            "target_lang_translations": {
                                "zh": "他在书桌上放了一个关节<w>木偶模型</w>，用作人物画的参考。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "artist mannequin",
                        "wooden mannequin"
                    ],
                    "target_lang_definitions": {
                        "zh": "（美术绘画用的关节可活动的）人体关节木偶，木头人模型"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "人体模型",
                                "target_lang_sense_clarification": "美术绘画用的关节人偶"
                            },
                            {
                                "target_lang_word": "木偶模型",
                                "target_lang_sense_clarification": "艺术绘画用的木制关节小人"
                            },
                            {
                                "target_lang_word": "木头人",
                                "target_lang_sense_clarification": "用于画画摆姿势的关节木人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5fb2de3-4aab-3512-acef-4b3050a83b88",
                    "sense_definition": "A person employed to wear and display clothes; a fashion model.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the early twentieth century, high-society salons hired live <w>mannequins</w> to show off dresses.",
                            "target_lang_translations": {
                                "zh": "二十世纪初，上流社会的沙龙会雇佣真人<w>时装模特</w>来展示礼服。"
                            }
                        },
                        {
                            "text": "The <w>mannequin</w> glided across the room wearing a silk evening gown.",
                            "target_lang_translations": {
                                "zh": "那位身穿丝绸晚礼服的<w>时装模特</w>优雅地走过房间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fashion model"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Largely superseded by fashion model."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（旧时专指受雇展示服装的）时装模特"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "时装模特",
                                "target_lang_sense_clarification": "走秀或展示服装的真人模特（旧称）"
                            },
                            {
                                "target_lang_word": "模特儿",
                                "target_lang_sense_clarification": "展示服装的真人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}