                ],
                "senses": [
                    {
                        "sense_id": "7e26e063-381f-32f5-a715-7cdc3d396938",
                        "entry_id": "12ede84c-68f9-3864-8aca-4510fa1ee8e6",
                        "glosses": [
                            "Transport par des véhicules suspendus à des câbles aériens servant à la fois de chemin de roulement et de ligne électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c491923-9831-4fc7-a954-4983f2e1025c",
                                "sense_id": "7e26e063-381f-32f5-a715-7cdc3d396938",
                                "text": "Téléphérage : C'est le nom donné par le professeur Fleeming Jenkin à l'application aux chemins de fer aériens de l'électricité comme force motrice. Dans ce système, les véhicules suspendus par leurs roues à un câble tendu sur des poteaux, avec l'isolation nécessaire pour qu'ils puissent en même temps servir de conducteur pour le passage du courant ; …."
                            },
                            {
                                "example_id": "11e1e42d-bfea-4401-8406-7dc1704ee179",
                                "sense_id": "7e26e063-381f-32f5-a715-7cdc3d396938",
                                "text": "Au cours de la Grande Guerre, des installations de téléphérage fonctionnèrent dans les Vosges pour le ravitaillement des troupes d'Alsace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2636b8dc-4c88-4a96-b23c-7133c62cb359",
                        "source_entry_id": "12ede84c-68f9-3864-8aca-4510fa1ee8e6",
                        "source_sense_id": "7e26e063-381f-32f5-a715-7cdc3d396938",
                        "target_lang_word": "telpherage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telpherage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b730d25-905f-3fde-b3dd-aadd07c51ea7",
                                        "entry_id": "54033e69-e225-3582-a178-74f8f10cfd2c",
                                        "glosses": [
                                            "An automated transportation system powered by electricity, especially a cable car used to transport minerals or other goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "249b0f83-5da1-4918-ac50-38af16b22dd3",
                                                "sense_id": "0b730d25-905f-3fde-b3dd-aadd07c51ea7",
                                                "text": "I am almost afraid to speak of the probable uses to which telpherage may be put."
                                            },
                                            {
                                                "example_id": "5af7e6b3-7927-488a-979a-a0661e83f781",
                                                "sense_id": "0b730d25-905f-3fde-b3dd-aadd07c51ea7",
                                                "text": "the coming of the snows is no longer the year's curse but its promise, awaited eagerly for its influx of moneyed seekers after wintertime recreation, when the shining strands of telpherage have subdued every mountainside, and all is festival and wholesome sport and eugenically chosen stock"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
