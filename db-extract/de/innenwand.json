                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21b9a0a6-91db-4d9c-a808-ba28740f10ad",
                                "sense_id": "9e47462e-01a0-3369-b561-ca15ed8d37ce",
                                "text": "Die Innenwände sind noch in Ordnung und müssen nur neu gestrichen werden."
                            },
                            {
                                "example_id": "15bcbe8a-f11c-4f80-92d5-e1b74a162b07",
                                "sense_id": "9e47462e-01a0-3369-b561-ca15ed8d37ce",
                                "text": "„Der freigelegte Tempel besaß in seinen Innenwänden zahlreiche Nischen, in denen man eine Darstellung von gekreuzten Frauenhänden aus Ton fand.“"
                            }
