                "senses": [
                    {
                        "sense_id": "544a2799-d091-3cde-acb9-dd1f2696b5dd",
                        "entry_id": "af7b0f09-587f-3d93-97ce-7ab5ed7a5fb4",
                        "glosses": [
                            "Hôtel, auberge espagnole."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "94d2c033-4531-4f7a-8d8a-bb69904cbcb2",
                                "sense_id": "544a2799-d091-3cde-acb9-dd1f2696b5dd",
                                "text": "Nous descendîmes à un superbe parador, d'une propreté parfaite, où l'on nous donna deux belles chambres avec un balcon ouvrant sur une place."
                            },
                            {
                                "example_id": "3ac8ed63-a829-428d-9bc7-d2fb3c592ad3",
                                "sense_id": "544a2799-d091-3cde-acb9-dd1f2696b5dd",
                                "text": "Torrequemada est remarquable par l’absence complète de vitres : il n’y a de carreaux qu’au parador qui, malgré ce luxe inouï, n’en a pas moins une cuisine avec un trou dans le plafond."
                            }
                        ]
                    },
                    {
                        "sense_id": "f03a072f-a413-3c17-94ab-c463b75e1488",
                        "entry_id": "af7b0f09-587f-3d93-97ce-7ab5ed7a5fb4",
                        "glosses": [
                            "En Espagne, hôtel de grand confort, aménagé dans une demeure historique ou de caractère et dont la gestion dépend des services du tourisme national."
                        ],
                        "tags": [
                            "De nos jours",
                            "Hôtellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "3bc21bc7-b37f-4d38-a094-ff27d72617e0",
                                "sense_id": "f03a072f-a413-3c17-94ab-c463b75e1488",
                                "text": "La route d'Arenas de San Pedro (...) vous hisse, à quelque treize cents mètres, jusqu'au parador de Gredos, un ancien relais de diligences aménagé par l'État en hôtel confortable, décoré avec goût."
                            },
                            {
                                "example_id": "d625f826-ee2a-447f-9c2d-44d616e1a868",
                                "sense_id": "f03a072f-a413-3c17-94ab-c463b75e1488",
                                "text": "Tout ce qui pouvait encore tenir debout en Espagne en termes de châteaux forts moyenâgeux ou de couvents Renaissance avait été converti en parador."
                            }
                        ]
                    }
                ],
