                "senses": [
                    {
                        "sense_id": "54b3633b-1a40-356d-b953-6aefba9d137b",
                        "entry_id": "9aab77b3-e142-3bc5-a49c-89cd43cd017f",
                        "glosses": [
                            "op Kerstmis geboren kind"
                        ],
                        "tags": [
                            "kerst"
                        ],
                        "examples": [
                            {
                                "example_id": "42581646-4347-4031-964b-f371018d4596",
                                "sense_id": "54b3633b-1a40-356d-b953-6aefba9d137b",
                                "text": "De geboorte van een kerstkind is altijd groot nieuws."
                            },
                            {
                                "example_id": "5c1b85fa-7044-4484-b89a-7ea47ad2cf13",
                                "sense_id": "54b3633b-1a40-356d-b953-6aefba9d137b",
                                "text": "In deze kerstspecial wordt een ongewenst zwangere jonge vrouw in het klooster opgevangen. En ze moet uiteraard net bevallen: een kerstkind."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa56854f-7644-3491-934b-31ccdd2b9dc3",
                        "entry_id": "9aab77b3-e142-3bc5-a49c-89cd43cd017f",
                        "glosses": [
                            "afbeelding of voorstelling van de pasgeboren Jezus"
                        ],
                        "tags": [
                            "kerst"
                        ],
                        "examples": [
                            {
                                "example_id": "6001e544-600a-43e8-8f61-51d0429789d9",
                                "sense_id": "fa56854f-7644-3491-934b-31ccdd2b9dc3",
                                "text": "In een grote tent wordt het kerstverhaal uitgebeeld door ruim honderd - deels mechanische - poppen. Ieder jaar staat de kribbe in een decor dat nergens in de Bijbel is terug te vinden. Vorig jaar lag het kerstkind nog in Parijs en dit jaar is het leven in de Provence het thema rond de stal met de os en de ezel."
                            }
                        ]
                    }
