                "senses": [
                    {
                        "sense_id": "60c2d2f5-038a-3991-a318-7bdb3f6cf64f",
                        "entry_id": "51cb2e88-701a-335d-95a3-bb87b0c3eff6",
                        "glosses": [
                            "mit „u“ wiedergegebener Laut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0965fa-0f61-4f08-8f56-5642be62ccd2",
                                "sense_id": "60c2d2f5-038a-3991-a318-7bdb3f6cf64f",
                                "text": "„Kurzer reiner u-Laut wird ausgedrückt mit u in bull, pull, full; mit o in wolf, to, bosom; mit o o in book, took etc.; mit ou in would, should, could.“"
                            },
                            {
                                "example_id": "267593f9-583b-4e3f-8aff-30d50701c23f",
                                "sense_id": "60c2d2f5-038a-3991-a318-7bdb3f6cf64f",
                                "text": "„u = u-Laut in dt. Buch, it. nva ‚Traube' [u] Die Klangfarbe der langen und kurzen Vokale dürfte im wesentlichen die gleiche gewesen sein.“"
                            },
                            {
                                "example_id": "254288ca-a687-47d7-adf2-871cc2d5a969",
                                "sense_id": "60c2d2f5-038a-3991-a318-7bdb3f6cf64f",
                                "text": "„Beim unsilbischen gespannten u-Laut [u] kann bilabial eine Enge entstehen, in der ein schwaches Reibegeräusch erzeugt wird.“"
                            },
                            {
                                "example_id": "5fb398cb-8ea9-45b6-9938-8d0833b19a85",
                                "sense_id": "60c2d2f5-038a-3991-a318-7bdb3f6cf64f",
                                "text": "„u: langer, geschlossener u-Laut: Uhr, Mut, du - u = kurzer, offener u-Laut: uns, Mutter“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
