                ],
                "senses": [
                    {
                        "sense_id": "2764b3c2-bb61-3c75-a3d2-6b3e480876fa",
                        "entry_id": "81dd9d6e-5f5e-3887-9703-def69e02a86b",
                        "glosses": [
                            "związany z elekcją, dotyczący elekcji; wybrany przez głosowanie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c748e81-0f00-4f92-a1ce-69169042b4f5",
                        "source_entry_id": "81dd9d6e-5f5e-3887-9703-def69e02a86b",
                        "source_sense_id": "2764b3c2-bb61-3c75-a3d2-6b3e480876fa",
                        "target_lang_word": "elective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df2cd106-7f9c-351b-ac94-e00bd9f5f33e",
                                        "entry_id": "23c6975b-8414-32c8-90cd-dd83a192ceea",
                                        "glosses": [
                                            "Of, or pertaining to voting or elections; involving a choice between options."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a708e5d5-b8d1-4cd9-a5a1-51938f9bc8e8",
                                                "sense_id": "df2cd106-7f9c-351b-ac94-e00bd9f5f33e",
                                                "text": "1697, John Dryden, The Works of Virgil […] translated into English Verse, London: Jacob Tonson, dedicatory preface to the Marquess of Normanby,\nFor his Conscience could not but whisper to the Arbitrary Monarch, that the Kings of Rome were at first Elective, and Govern’d not without a Senate:"
                                            },
                                            {
                                                "example_id": "31a15b36-ce88-42ac-a964-2d36284f6657",
                                                "sense_id": "df2cd106-7f9c-351b-ac94-e00bd9f5f33e",
                                                "text": "Man thus endued with an elective voice,\nMust be supplied with objects of his choice."
                                            },
                                            {
                                                "example_id": "71fadc4d-d89f-4c0d-a793-d44031a4661c",
                                                "sense_id": "df2cd106-7f9c-351b-ac94-e00bd9f5f33e",
                                                "text": "[…] they rested their hopes of redress on the independent use of their elective franchise;"
                                            },
                                            {
                                                "example_id": "8cef75e9-8c22-4b22-8823-a7049c9cc5bc",
                                                "sense_id": "df2cd106-7f9c-351b-ac94-e00bd9f5f33e",
                                                "text": "See the populace, millions upon millions, handsome, tall, muscular, both sexes, clothed in easy and dignified clothes―teaching, commanding, marrying, generating, equally electing and elective;"
                                            },
                                            {
                                                "example_id": "cb996af3-947c-4724-90cb-a6e0ca8a8f64",
                                                "sense_id": "df2cd106-7f9c-351b-ac94-e00bd9f5f33e",
                                                "text": "1896, Mohandas Karamchand Gandhi, “The South African Question” in Speeches and Writings of M. K. Gandhi, Madras: G.A. Natesan, 3rd edition, 1922, p. 6,\n[The bill] says that no natives of countries (not of European origin) which have not hitherto possessed elective representative institutions […] shall be placed on the voters roll […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4ff0acb-100a-3b0e-a876-080eefc14ef9",
                                        "entry_id": "23c6975b-8414-32c8-90cd-dd83a192ceea",
                                        "glosses": [
                                            "Open to choice; freely chosen; (also, usually) unnecessary; minor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98e4c8be-7423-48fd-b588-371a7c5f1fd2",
                                                "sense_id": "a4ff0acb-100a-3b0e-a876-080eefc14ef9",
                                                "text": "After accounting for all of my required courses, there is hardly any room in my schedule for any elective ones."
                                            },
                                            {
                                                "example_id": "2b301f5b-1cd1-4f2b-97c3-591bcc3e9abc",
                                                "sense_id": "a4ff0acb-100a-3b0e-a876-080eefc14ef9",
                                                "text": "[…] his Lordship is deceived if he think any spontaneous action after once being checked in it, differs from an action voluntary and elective, for even the setting of a mans foot, in the posture for walking, and the action of ordinary eating was once deliberated of how and when it should be done, and though afterward it became easie & habitual so as to be done without fore-thought, yet that does not hinder but that the act is voluntary and proceedeth from election."
                                            },
                                            {
                                                "example_id": "d1a9ae80-4dcc-4ccc-98f8-5b392bb8550d",
                                                "sense_id": "a4ff0acb-100a-3b0e-a876-080eefc14ef9",
                                                "text": "1782, Frances Burney, Cecilia, London: T. Payne & Son, and T. Cadell, Volume 5, Book 9, Chapter 8, pp. 160-161,\n“You know not then,” said Cecilia, in a faint voice, “my inability to comply?”\n“Your ability, or inability, I presume are elective?”\n“Oh no!—my power is lost!—my fortune itself is gone!”"
                                            },
                                            {
                                                "example_id": "81bb7b3b-8d2f-438d-8583-9abad681059d",
                                                "sense_id": "a4ff0acb-100a-3b0e-a876-080eefc14ef9",
                                                "text": "[Her friends] are, after all, her elective siblings who have distanced themselves from the ways of the past, their families […]"
                                            },
                                            {
                                                "example_id": "c0ec3876-33d4-4842-b63a-0849d06b74c2",
                                                "sense_id": "a4ff0acb-100a-3b0e-a876-080eefc14ef9",
                                                "text": "“[…] That blog is a game that you don’t really take seriously, it’s like choosing an interesting elective evening class to complete your credits.”"
                                            },
                                            {
                                                "example_id": "a2f15f98-339f-48dd-a6cf-46ce58c54b79",
                                                "sense_id": "a4ff0acb-100a-3b0e-a876-080eefc14ef9",
                                                "text": "Now some adventuring imbecile had acquired an elective sickness and was paying its price."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7ce2025-944a-36e6-9ba7-ad5803f617d2",
                                        "entry_id": "23c6975b-8414-32c8-90cd-dd83a192ceea",
                                        "glosses": [
                                            "Scheduled and nonemergent (regardless of whether necessary or unnecessary and whether minor or serious)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78b24080-61d4-44ce-87cd-4860bfcd9ff8",
                                                "sense_id": "a7ce2025-944a-36e6-9ba7-ad5803f617d2",
                                                "text": "It was very confusing hearing my cancer surgery being classified as \"elective surgery\". Am I \"electing\" to live rather than die?"
                                            },
                                            {
                                                "example_id": "d83e1502-e35f-4e8f-9a4e-df47e091cac3",
                                                "sense_id": "a7ce2025-944a-36e6-9ba7-ad5803f617d2",
                                                "text": "The vast majority of surgical procedures are considered elective, which means they can be scheduled in advance. […] doctors warned that thousands of patients were suffering as a result of delayed elective procedures such as hernia repair and spinal fusion. […] Nitin Yerram, director of urological oncology at Hackensack University Medical Center in New Jersey, said most cancer surgeries are considered elective, a term that's often misunderstood. \"We tend to think more of tummy tucks and cosmetic surgery,\" Yerram said. \"However, all ‘elective’ means is it's a scheduled surgery with work-up done before that. The opposite of elective is emergent or trauma situation, such as a car crash, where it's not a scheduled procedure.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae06759c-24ba-3aba-903c-8d1d657442b2",
                                        "entry_id": "7b3a8e0b-142b-305e-ac03-388ae1fdfc28",
                                        "glosses": [
                                            "Something that is an option or may be freely chosen, especially a course of study."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a381af6-4465-4979-8f12-8ac0b693f690",
                                                "sense_id": "ae06759c-24ba-3aba-903c-8d1d657442b2",
                                                "text": "I still need to decide which electives to take along with my compulsory courses next semester."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6496505d-b12e-4943-9920-2e92c85183fd",
                        "source_entry_id": "81dd9d6e-5f5e-3887-9703-def69e02a86b",
                        "source_sense_id": "2764b3c2-bb61-3c75-a3d2-6b3e480876fa",
                        "target_lang_word": "électif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "électif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20e58539-5fa7-32e7-9034-acccdc7ab9bf",
                                        "entry_id": "08cad199-8083-3be6-b149-61390083436f",
                                        "glosses": [
                                            "Qui est nommé par élection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9ae289-9593-4d50-8edb-12f4f7e40128",
                                                "sense_id": "20e58539-5fa7-32e7-9034-acccdc7ab9bf",
                                                "text": "Roi électif."
                                            },
                                            {
                                                "example_id": "66a6393e-c41a-4f13-a1b2-b16d3cebc24c",
                                                "sense_id": "20e58539-5fa7-32e7-9034-acccdc7ab9bf",
                                                "text": "Le pape est électif."
                                            },
                                            {
                                                "example_id": "70d67f9a-0a8d-4a91-baf6-eb872f0e94df",
                                                "sense_id": "20e58539-5fa7-32e7-9034-acccdc7ab9bf",
                                                "text": "Un mandat électif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd87756-f41a-3ebf-874a-85c0798793be",
                                        "entry_id": "08cad199-8083-3be6-b149-61390083436f",
                                        "glosses": [
                                            "Qui se donne par élection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c35ae99-d9b7-47b2-8835-beaaca785283",
                                                "sense_id": "5dd87756-f41a-3ebf-874a-85c0798793be",
                                                "text": "Nous sommes, je crois, tous d’accord d’imiter dans cette réunion — essentiellement amicale… mais entièrement libre — et qui ne préjudicie en rien à la grande réunion préparatoire où vous interpellerez les candidats, où vous pèserez leurs mérites… d’imiter, dis-je, les formes… constitutionnelles de la Chambre… élective."
                                            },
                                            {
                                                "example_id": "e33e2529-b8ee-4e0f-ade4-e0ef0233d4d7",
                                                "sense_id": "5dd87756-f41a-3ebf-874a-85c0798793be",
                                                "text": "Royauté, couronne élective."
                                            },
                                            {
                                                "example_id": "1329cecb-4e3c-4c38-8673-84be10fa95b6",
                                                "sense_id": "5dd87756-f41a-3ebf-874a-85c0798793be",
                                                "text": "Emploi électif."
                                            },
                                            {
                                                "example_id": "158169e5-8ccc-491c-8085-f79ba447a7a8",
                                                "sense_id": "5dd87756-f41a-3ebf-874a-85c0798793be",
                                                "text": "La papauté est élective."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01c570b3-d522-3a16-a15c-37e29f9edc18",
                                        "entry_id": "08cad199-8083-3be6-b149-61390083436f",
                                        "glosses": [
                                            "Qui est le produit de préférences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c74a965-4439-4158-b551-d7661260d9fa",
                                                "sense_id": "01c570b3-d522-3a16-a15c-37e29f9edc18",
                                                "text": "Cette « ville à la carte », moins déterminée par la proximité spatiale que par les préférences et les capacités de déplacement des individus, s’affranchirait des relations de voisinage au profit de relations sociales électives et déterritorialisées ([…]), diminuant le poids traditionnel du quartier, […]."
                                            }
                                        ]
