        "nl-extract.jsonl": [
            {
                "entry_id": "58661f13-52f1-3a42-b2b9-4c73f60865c3",
                "word": "stokken",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "41b31cce-082f-3cb8-baff-8b45062dc266",
                        "entry_id": "58661f13-52f1-3a42-b2b9-4c73f60865c3",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord stok"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1c151e76-bed6-4440-8a38-b1d6cd261ae1",
                                "sense_id": "41b31cce-082f-3cb8-baff-8b45062dc266",
                                "text": "Ik zorgde altijd voor voldoende graan en schone stokken waarop ze konden slapen."
                            },
                            {
                                "example_id": "d2a1b282-d20a-4d44-9b70-017bdfd94f74",
                                "sense_id": "41b31cce-082f-3cb8-baff-8b45062dc266",
                                "text": "Wandelstokken? Inderdaad, ik was met de trend meegegaan en had een paar Leki Thermalite-wandelstokken aangeschaft. Deze deden ook dienst als tentpalen, twee vliegen in een klap dus. In totaal scheelden deze multifunctionele stokken mij 350 gram aan gewicht."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "e7d34a7b-7437-3fa5-a40d-2739653fd6bf",
                "word": "stokken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c31ca651-f853-3a40-abda-4cb17f324456",
                        "entry_id": "e7d34a7b-7437-3fa5-a40d-2739653fd6bf",
                        "glosses": [
                            "blijven hangen, blijven steken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62cb2238-c61d-4ed7-a38a-cd588a4cb28d",
                                "sense_id": "c31ca651-f853-3a40-abda-4cb17f324456",
                                "text": "Doordat de buitengewone noodremvoorziening in werking trad, stokte de lift tussen de zesde en de vijfde. Medewerkers en een monteur schoten te hulp."
                            },
                            {
                                "example_id": "9915e203-ffe6-454f-89de-d865d218a237",
                                "sense_id": "c31ca651-f853-3a40-abda-4cb17f324456",
                                "text": "Opvallend genoeg is in de laatste maand van het jaar de werkloosheid licht opgelopen, met 3000 mensen. Ook eerder in het jaar stokte de daling van de werkloosheid even. Economen van het Centraal Planbureau verwachten echter dat ook in 2019 de werkloosheid daalt, maar in een veel lager tempo."
                            }
                        ]
                    }
