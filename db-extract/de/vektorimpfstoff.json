                "senses": [
                    {
                        "sense_id": "26867d20-3af9-300f-ac70-95cd48d42ddf",
                        "entry_id": "1611ae00-ac27-3c64-8b88-d41079559e0d",
                        "glosses": [
                            "Vakzin (Impfstoff), das mit Hilfe eines umgebauten Virus (eines Vektors/einer Genfähre) in die Zellen des Impflings gelangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0570272c-2437-4515-83bb-5d2fc6508063",
                                "sense_id": "26867d20-3af9-300f-ac70-95cd48d42ddf",
                                "text": "„Bei dem Impfstoffkandidaten handelt es sich um einen Vektorimpfstoff auf Basis eines modifizierten Pockenvirus (Modified-Vaccinia-Ankara-Virus, MVA). Das teilte das Paul-Ehrlich-Institut in Langen heute zusammen mit den Antragsstellern der Studie in einer Pressekonferenz mit. In den MVA-Vektor wurde die Erbinformation für das Spike-Protein von SARS-CoV-2 integriert, das im Körper des Geimpften produziert wird und eine Immunreaktion auslöst.“"
                            },
                            {
                                "example_id": "5dfb194b-6ec2-4da4-97f6-5db43f6dca52",
                                "sense_id": "26867d20-3af9-300f-ac70-95cd48d42ddf",
                                "text": "„In diesem Vektorimpfstoff ist die genetische Information für das Spike-Oberflächenprotein des SARS-CoV-2 in die genetische Information des Pocken-Impfvirus MVA eingebaut.“"
                            },
                            {
                                "example_id": "25ee0124-f390-45f2-9841-1dabf2ff9e0e",
                                "sense_id": "26867d20-3af9-300f-ac70-95cd48d42ddf",
                                "text": "„Bereits im August 2020 erteilte Russland eine Notfallzulassung für den im eigenen Land entwickelten Vektorimpfstoff Gam-COVID-Vac.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
