                    "sense_id": "6e27efe3-d221-3fe5-be24-b7e90dcf0da0",
                    "sense_definition": "Een uitroep om iemand of iets onmiddellijk te laten stoppen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Halt</w>! Je mag hier niet zomaar naar binnen.",
                            "target_lang_translations": {
                                "en": "<w>Stop</w>! You are not allowed to just enter here.",
                                "ru": "<w>Стой</w>! Сюда нельзя просто так входить.",
                                "pl": "<w>Stój</w>! Nie możesz tak po prostu tutaj wejść.",
                                "de": "<w>Halt</w>! Du darfst hier nicht einfach so hineingehen.",
                                "fr": "<w>Halte</w> ! Vous ne pouvez pas entrer ici comme ça.",
                                "it": "<w>Alt</w>! Non puoi entrare qui così facilmente.",
                                "cs": "<w>Stůj</w>! Sem nesmíš jen tak vstoupit.",
                                "tr": "<w>Dur</w>! Buraya öylece giremezsin.",
                                "es": "¡<w>Alto</w>! No puedes entrar aquí sin más.",
                                "zh": "<w>站住</w>！你不能随便进去。"
                            }
                        },
                        {
                            "text": "De politieagent stak zijn hand op en riep luid: \"<w>Halt</w>!\"",
                            "target_lang_translations": {
                                "en": "The police officer raised his hand and shouted loudly: \"<w>Halt</w>!\"",
                                "ru": "Полицейский поднял руку и громко крикнул: \"<w>Стой</w>!\"",
                                "pl": "Policjant uniósł rękę i zawołał głośno: „<w>Stój</w>!”",
                                "de": "Der Polizist hob die Hand und rief laut: „<w>Halt</w>!“",
                                "fr": "Le policier a levé la main et a crié fort : \"<w>Halte</w> !\"",
                                "it": "Il poliziotto alzò la mano e gridò forte: \"<w>Alt</w>!\"",
                                "cs": "Policista zvedl ruku a hlasitě vykřikl: „<w>Stůj</w>!“",
                                "tr": "Polis memuru elini kaldırdı ve yüksek sesle \"<w>Dur</w>!\" diye bağırdı.",
                                "es": "El agente de policía levantó la mano y gritó fuerte: \"¡<w>Alto</w>!\"",
                                "zh": "警察举起手大声喊道：“<w>停</w>！”"
                            }
                        }
                    ],
                    "synonyms": [
                        "stop",
                        "ho"
                    ],
                    "antonyms": [
                        "vooruit"
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation to make someone or something stop immediately.",
                        "ru": "Возглас, используемый для того, чтобы заставить кого-то или что-то немедленно остановиться.",
                        "pl": "Okrzyk nakazujący komuś lub czemuś natychmiastowe zatrzymanie się.",
                        "de": "Ein Ausruf, um jemanden oder etwas sofort zum Anhalten zu bewegen.",
                        "fr": "Une exclamation utilisée pour ordonner à quelqu'un ou quelque chose de s'arrêter immédiatement.",
                        "it": "Un'esclamazione usata per ordinare a qualcuno o qualcosa di fermarsi immediatamente.",
                        "cs": "Výkřik používaný k tomu, aby někdo nebo něco okamžitě zastavilo.",
                        "tr": "Birini veya bir şeyi derhal durdurmak için kullanılan bir ünlem.",
                        "es": "Una exclamación utilizada para ordenar a alguien o algo que se detenga inmediatamente.",
                        "zh": "用于命令某人或某物立即停止的感叹词。"
                    },
