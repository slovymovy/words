                "senses": [
                    {
                        "sense_id": "7487fa18-f58e-300d-b09b-ac6d6e420fb8",
                        "entry_id": "8c9eb726-f26b-3c51-9627-3fbef3623305",
                        "glosses": [
                            "inoffizielle Bezeichnung für einen Kapitän der von 1829 bis 1991 existierenden Donaudampfschifffahrtsgesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed938928-3615-433b-a92a-99f40a7f81e6",
                                "sense_id": "7487fa18-f58e-300d-b09b-ac6d6e420fb8",
                                "text": "„Dabei kam ihm ein Zufall zu Hilfe: Als Peter Igelhoff, damals mit zungenbrecherischen Chansons wie dem vom Donaudampfschifffahrtsgesellschaftskapitän in aller Munde war, einen Auftritt in Breslau absagen musste, sprang Erhardt für ihn ein und besang auf hinreißend komische Weise das Objekt seiner heimlichen Begierde, «Fräulein Mabel».“"
                            },
                            {
                                "example_id": "1c435dad-08ae-479f-9885-b692b566effb",
                                "sense_id": "7487fa18-f58e-300d-b09b-ac6d6e420fb8",
                                "text": "„Der berühmte Donaudampfschifffahrtsgesellschaftskapitän etwa ist schon lange untergegangen, obwohl er durch die Rechtschreibreform sogar noch einen Buchstaben dazu gewann.“"
                            },
                            {
                                "example_id": "474ee86f-d3d3-4a20-bae4-1538b13a909c",
                                "sense_id": "7487fa18-f58e-300d-b09b-ac6d6e420fb8",
                                "text": "„Nun ist natürlich auch die deutsche Sprache dafür bekannt, sehr lange Kettenwörter bilden zu können, man denke nur an den berühmten Donaudampfschifffahrtsgesellschaftskapitän, der sich durch Hinzufügen immer weiterer Untereinheiten auch zum Donaudampfschifffahrtsgesellschaftskapitänskajütentürknaufpolierlappenaufbewahrungskasten erweitern lässt, ein prinzipiell unendliches Verfahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
