                                    },
                                    {
                                        "sense_id": "d27498dd-084d-3449-b21c-77e2a1a762d2",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A thread performing one instance of a particular task within a program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32f3911-f600-46d7-9da8-ac0a9bf9245c",
                                                "sense_id": "d27498dd-084d-3449-b21c-77e2a1a762d2",
                                                "text": "This FTP client spawns a separate worker for each file to be uploaded."
                                            }
                                        ]
