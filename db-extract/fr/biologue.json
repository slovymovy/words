                        "examples": [
                            {
                                "example_id": "7e4f6222-4589-4a56-ad6a-9d53ce5a582c",
                                "sense_id": "32ee4d28-00c3-36fb-93a9-33196956104b",
                                "text": "De tous temps les biologues se montrèrent fort préoccupés de la question passionnante de la suspension de la vie chez les animaux et dans certains organismes."
                            },
                            {
                                "example_id": "bd491110-1f2e-48aa-9d23-2c28a824451b",
                                "sense_id": "32ee4d28-00c3-36fb-93a9-33196956104b",
                                "text": "Je me souviens : ils écrivent biologue, et non biologiste, comme j’ai toujours entendu dire."
                            }
                        ]
                    }
