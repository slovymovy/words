                "senses": [
                    {
                        "sense_id": "164e54a9-0100-3473-a268-160f195906e7",
                        "entry_id": "d5f260fa-2496-3025-a4d4-6a048e3b09b2",
                        "glosses": [
                            "прост. понадобиться, сделаться надобным, нужным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8451769a-ee55-42d6-952d-b3b20fccb82d",
                                "sense_id": "164e54a9-0100-3473-a268-160f195906e7",
                                "text": "Таким манером мялось да тянулось у них это дело до тех пор, пока барыне в город не занадобилось ехать."
                            },
                            {
                                "example_id": "ea7325b9-58e7-41c4-8264-880f5be58edb",
                                "sense_id": "164e54a9-0100-3473-a268-160f195906e7",
                                "text": "Еда ― какая только занадобится душеньке твоей, девок ― бери любую."
                            }
                        ]
                    }
                ],
