                },
                {
                    "sense_id": "b53b28f7-92ab-333d-8a27-7f7425103fb2",
                    "sense_definition": "danie lub potrawa przyrządzona z mięsa wieprzowego",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziś na kolację przyrządzę pyszną <w>wieprzowinę</w> w sosie piwnym.",
                            "target_lang_translations": {
                                "ru": "Сегодня на ужин я приготовлю вкусную <w>свинину</w> в пивном соусе."
