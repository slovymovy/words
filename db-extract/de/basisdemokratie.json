                "senses": [
                    {
                        "sense_id": "872cbada-a684-3b4d-9e96-1d077faa9927",
                        "entry_id": "e2a50d2a-ebce-3f9c-b836-59b2e05ef68f",
                        "glosses": [
                            "Staatsform, bei der Entscheidungen nicht von Repräsentanten, sondern unmittelbar vom Volk getroffen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "360c8a02-a1fa-4ea3-941e-fb8071b8e16b",
                                "sense_id": "872cbada-a684-3b4d-9e96-1d077faa9927",
                                "text": "„Die Liberaldemokraten waren mal - wie die deutschen Grünen - als Müsli-Esser und Sandalenträger verschrien. Tatsächlich lehnen sie Kriege und Atomkraft ab und halten die Basisdemokratie in Ehren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
