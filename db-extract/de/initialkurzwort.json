                "senses": [
                    {
                        "sense_id": "b9d4ffff-471a-3606-8d3f-6ee0cabdd13e",
                        "entry_id": "6e30ef35-59a2-3f9b-8c29-c56f083e33e6",
                        "glosses": [
                            "Kurzwort, das aus den Initialen, also den Anfangsbuchstaben der einzelnen Bestandteile des zugrundeliegenden Ausdrucks gebildet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff6ca4d-608a-44b8-9b7d-ca3d0081a77e",
                                "sense_id": "b9d4ffff-471a-3606-8d3f-6ee0cabdd13e",
                                "text": "Beispiele für Initialkurzwörter im Deutschen sind '\"CDU\", \"LKW\", \"UNO\"."
                            },
                            {
                                "example_id": "b1ac7409-ff3a-4644-aeec-df7f51a033c6",
                                "sense_id": "b9d4ffff-471a-3606-8d3f-6ee0cabdd13e",
                                "text": "„Während die Initialkurzwörter als umstrittener Typ betrachtet werden können, bedürfen die Silbenkurzwörter einer näheren Erläuterung.“"
                            },
                            {
                                "example_id": "1b8c2346-0e23-4af0-83cd-d260d3f1c263",
                                "sense_id": "b9d4ffff-471a-3606-8d3f-6ee0cabdd13e",
                                "text": "„Anders ist es, wenn die Initialkurzwörter nicht als Buchstabenaufzählung, sondern lautwertrichtig ausgesprochen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
