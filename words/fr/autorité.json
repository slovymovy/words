                        "autorité morale"
                    ]
                },
                {
                    "sense_id": "09c828e3-bf9d-3b26-bd96-2f8c5ac8cc88",
                    "sense_definition": "Auteur, personnage ou texte de référence dont on invoque les propos pour appuyer une thèse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour défendre sa position, l'avocat s'est appuyé sur l'<w>autorité</w> d'un jurisconsulte renommé."
                        },
                        {
                            "text": "L'auteur cite plusieurs grandes <w>autorités</w> de la philosophie antique dans son essai."
