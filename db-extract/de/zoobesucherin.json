                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4b112e2-66d9-4445-9a5e-e14d544c0542",
                                "sense_id": "93df2789-f719-3969-a66d-c0cc1f5df2c2",
                                "text": "„Einer Zoobesucherin aus Italien wurde am Neujahrstag eine böse Überraschung beschert.“"
                            },
                            {
                                "example_id": "473ee0e9-7dc2-4e31-b205-dbd99278a225",
                                "sense_id": "93df2789-f719-3969-a66d-c0cc1f5df2c2",
                                "text": "„Eine Zoobesucherin in den USA ist beim Versuch verletzt worden, ein Foto mit einer Raubkatze zu schießen.“"
                            },
                            {
                                "example_id": "57982916-5297-4525-b997-4e5ae8de5615",
                                "sense_id": "93df2789-f719-3969-a66d-c0cc1f5df2c2",
                                "text": "„Aus mehr als 8000 eingereichten Vorschlägen wählte die Jury den Namen ‚Mayumi‘ aus. Das ist japanisch und bedeutet übersetzt ‚wahre Schönheit‘. Der Vorschlag kam von Zoobesucherin Jessica Kolzau.“"
                            }
                        ],
