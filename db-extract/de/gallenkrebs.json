                                "example_id": "d327b333-49e1-40f1-924a-386d4333a639",
                                "sense_id": "d8cef739-49a3-39cb-a859-69c8d2f1666e",
                                "text": "„Damals hatte er eine zweite Herzattacke überlebt, kurz darauf wurde Gallenkrebs diagnostiziert.“"
                            },
                            {
                                "example_id": "9e66d63d-f7b0-4d28-b9af-2614c3371bfa",
                                "sense_id": "d8cef739-49a3-39cb-a859-69c8d2f1666e",
                                "text": "„Gallenkrebs gehört mit rund 5500 Neuerkrankungen pro Jahr zwar zu den eher seltenen Krebsformen, ist jedoch besonders riskant.“"
                            },
                            {
                                "example_id": "f37518ea-459c-4ae9-acbf-d06198b352e2",
                                "sense_id": "d8cef739-49a3-39cb-a859-69c8d2f1666e",
                                "text": "„Die 57-jährige Soulgöre aus New York musste wegen Gallenkrebs ihre Tour absagen und die Veröffentlichung ihres neuen Albums verschieben.“"
                            }
                        ],
