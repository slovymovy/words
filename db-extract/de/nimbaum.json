                                        "glosses": [
                                            "Nom vernaculaire de Lagerstroemia indica, arbuste originaire du Japon et de Chine et produisant des grappes de fleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "824cc420-c68d-4a2f-9071-d11c871f92d6",
                                                "sense_id": "12d234a9-bb7e-3b51-9d7e-448d945fb784",
                                                "text": "Les fleurs du lilas des Indes ont une teinte et un parfum suave qui rappellent fortement le vrai lilas ; leur couleur est mauve ou parme clair."
                                            }
                                        ]
                                    },
