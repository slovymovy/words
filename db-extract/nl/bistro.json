                "senses": [
                    {
                        "sense_id": "fcf7c905-4e92-39e9-bf71-3719e90325a5",
                        "entry_id": "3aa9d0c3-e221-3a12-aa07-ed385e2171e1",
                        "glosses": [
                            "eetcafé, petit restaurant, vaak met een Frans karakter"
                        ],
                        "tags": [
                            "horeca"
                        ],
                        "examples": [
                            {
                                "example_id": "fbf7ba7d-3bb4-4de4-9d7e-b9b3fcff2c1f",
                                "sense_id": "fcf7c905-4e92-39e9-bf71-3719e90325a5",
                                "text": "Een bistro wordt ook wel petit restaurant genoemd. In Nederland spreekt men vaak van een eetcafé, in België en andere landen soms van een taverne."
                            },
                            {
                                "example_id": "961c6a94-692e-4af6-86fd-c8da333487ce",
                                "sense_id": "fcf7c905-4e92-39e9-bf71-3719e90325a5",
                                "text": "Als wij zelf een bistro zouden hebben, zouden wij die De hongerige wolf noemen. Dat is leuk, dan zit je ‘in de hongerige wolf’ en bovendien weet iedereen wel, dat een wolf van lekkere malse hapjes houdt."
                            },
                            {
                                "example_id": "8e2a230e-9632-4454-b878-559836a77700",
                                "sense_id": "fcf7c905-4e92-39e9-bf71-3719e90325a5",
                                "text": "Er waren ook mensen die zelf de PCT hadden gelopen en nu anderen wilden verrassen met Trail Magic. Zo kwam ik drie jongens uit de PCT Class of 2014 tegen die een volledige bistro hadden opgezet tussen de bomen. Ik werd met trompetgeschal verwelkomd en uitgenodigd om me te hullen in kleren uit hun Burning Man verkleeddoos en kon kiezen uit hamburgers, tosti’s, salades, pasta, koffie, bier of wiet."
                            }
                        ]
                    }
