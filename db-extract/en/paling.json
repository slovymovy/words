                        "entry_id": "572aace3-1f6f-3f44-8fe9-b885c798d87f",
                        "glosses": [
                            "รั้วที่ทำจากแผ่นสังกะสี"
                        ],
                        "tags": [
                            "Caribbean"
                        ],
                        "examples": [
