                                    {
                                        "sense_id": "2dfe000e-9428-3f3e-b025-596a5d73b588",
                                        "entry_id": "948c0a8e-9954-3c9c-acb8-84934773e03a",
                                        "glosses": [
                                            "Action d’éternuer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7f48721-e974-4d80-98db-6aad3b3074fc",
                                                "sense_id": "2dfe000e-9428-3f3e-b025-596a5d73b588",
                                                "text": "Soudain, nouveau bruit… Cette fois, il n’y a pas à se tromper… Un éternuement à demi étouffé a fait trembler les parois de la caisse…"
                                            },
                                            {
                                                "example_id": "9b09901a-1c3f-4d86-9f1e-f4544667fc81",
                                                "sense_id": "2dfe000e-9428-3f3e-b025-596a5d73b588",
                                                "text": "Longue marche dans le brouillard. Le régiment tousse, moins la compagnie du lieutenant Viard, où la toux est punie et où les soldats se rattrapent sur l’éternuement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "918b048e-c1c9-469c-99b8-2e5a86ed15a1",
                        "source_entry_id": "3ee579f5-f0ea-35d6-93e8-d2cfbc715ade",
                        "source_sense_description": "действие по значению гл. чихать",
                        "target_lang_word": "sternutation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sternutation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b55dcae6-488c-3011-a9a2-594d8a86b6b2",
                                        "entry_id": "4d46d607-29dd-3acf-a1e4-1c3dfb67995b",
                                        "glosses": [
                                            "Éternuement."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1ac39b9-0e85-48bb-abca-031217d500cf",
                                                "sense_id": "b55dcae6-488c-3011-a9a2-594d8a86b6b2",
                                                "text": "C’est en effet, ainsi que la sternutation est devenue dans un grand nombre de cas cause de maladie. On l’a vue, en effet, produire des hémorragies très-graves, des hernies, l’avortement, la cécité."
                                            },
                                            {
                                                "example_id": "8a595282-afec-47d2-9bb3-f2c85dc62793",
                                                "sense_id": "b55dcae6-488c-3011-a9a2-594d8a86b6b2",
                                                "text": "Ce personnage ne court plus aucun risque et n’attend même plus que les chatouillements de sa narine aboutissent à la sternutation."
                                            },
                                            {
                                                "example_id": "d2023b66-8ea8-409a-b00d-78886073a496",
                                                "sense_id": "b55dcae6-488c-3011-a9a2-594d8a86b6b2",
                                                "text": "Quelques éternuements répétés venant de la chambre des enfants ressemblaient à de minuscules détonations qui l’irritaient. Dzibayo avait une sternutation irrépressible et souffrait de violents maux de tête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
