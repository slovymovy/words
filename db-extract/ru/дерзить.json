                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "дерзи́вши"
                    },
                    {
                        "form_id": "4c0817d8-babe-452c-a48b-5815cc3ce108",
                        "entry_id": "21221453-07f5-3cf4-86cd-3fa8446b46b9",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… дерзи́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70c1ce6b-fbb2-3217-9c41-df372e6e9172",
                        "entry_id": "21221453-07f5-3cf4-86cd-3fa8446b46b9",
                        "glosses": [
                            "разг. вести себя непочтительно, вызывающе, говоря кому-либо грубые, оскорбительные слова; грубить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7bfcab3-3759-4b53-a4db-5936de480b1c",
                                "sense_id": "70c1ce6b-fbb2-3217-9c41-df372e6e9172",
                                "text": "Злись не злись, дерзи не дерзи, хоть родителей моих не добром помяни, ― не выпорю."
                            },
                            {
                                "example_id": "72421082-e7f5-48dc-8ed2-23aaa8ba3fd8",
                                "sense_id": "70c1ce6b-fbb2-3217-9c41-df372e6e9172",
                                "text": "Если за шалости Петю посылали в угол или ставили на колени, ― он становился неохотно, долго оправдывался, спорил даже, случалось, дерзил."
                            },
                            {
                                "example_id": "c5557d4d-6dfb-4e1b-8606-80678f9ba3d6",
                                "sense_id": "70c1ce6b-fbb2-3217-9c41-df372e6e9172",
                                "text": "― Мальчик плохо учится, дерзит, врёт на каждом шагу…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "373d9f48-e8a0-4b37-baa7-5a84b9a054b1",
                        "source_entry_id": "21221453-07f5-3cf4-86cd-3fa8446b46b9",
                        "source_sense_id": "70c1ce6b-fbb2-3217-9c41-df372e6e9172",
                        "target_lang_word": "answer back",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "answer back",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00b5b0ab-dc49-37e1-8123-8851497e1a98",
                                        "entry_id": "4e16b532-83c8-35c0-879a-ca1f83465ef8",
                                        "glosses": [
                                            "To reply impertinently to (someone); to talk back."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0d3084a-a1ae-4e6c-b796-aabbb9388338",
                                                "sense_id": "00b5b0ab-dc49-37e1-8123-8851497e1a98",
                                                "text": "I'll thank you not to answer back like that! Where are your manners?"
                                            },
                                            {
                                                "example_id": "b5e6d933-8ed4-486c-8ce7-f5078b076930",
                                                "sense_id": "00b5b0ab-dc49-37e1-8123-8851497e1a98",
                                                "text": "She answered him back rudely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a2b7187-4ad1-3cc2-98e5-5409aac55a55",
                                        "entry_id": "4e16b532-83c8-35c0-879a-ca1f83465ef8",
                                        "glosses": [
                                            "To reply to a question from (someone) at a later time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bf61b5a-081e-4f42-9dee-66e858f07826",
                                                "sense_id": "3a2b7187-4ad1-3cc2-98e5-5409aac55a55",
                                                "text": "Please answer me back before the end of the week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2847851-8c08-3df5-ac03-3a8317d5b932",
                                        "entry_id": "4e16b532-83c8-35c0-879a-ca1f83465ef8",
