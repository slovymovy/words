                },
                {
                    "sense_id": "725a1fbc-6203-366c-a6bf-a5d0f104ac5e",
                    "sense_definition": "An article providing only minimal information and intended for later development.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing_and_writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This Wikipedia article is currently just a <w>stub</w> and needs more details.",
                            "target_lang_translations": {
                                "ru": "Эта статья в Википедии сейчас всего лишь <w>заготовка</w> и требует доработки."
                            }
