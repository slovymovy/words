                ],
                "senses": [
                    {
                        "sense_id": "bd60928b-5839-36ce-a606-9294e174da5c",
                        "entry_id": "0bfe832c-ec60-3202-9771-038863150fa7",
                        "glosses": [
                            "Extrêmement fin, d'une épaisseur ou d'un diamètre nettement inférieur à la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c57c5ec-bbe1-4f49-bc76-1d3055a22096",
                                "sense_id": "bd60928b-5839-36ce-a606-9294e174da5c",
                                "text": "Poudre ultrafine."
                            },
                            {
                                "example_id": "7ead6fa0-5e99-4c09-a78d-a801b05cc99e",
                                "sense_id": "bd60928b-5839-36ce-a606-9294e174da5c",
                                "text": "Le désalinisateur, cette formidable petite machine filtrante, gobe tout dans ses membranes ultrafines."
                            },
                            {
                                "example_id": "0ecd8104-0f97-481f-b15a-3c9402b70033",
                                "sense_id": "bd60928b-5839-36ce-a606-9294e174da5c",
                                "text": "Selon lui, le brouillard que forment ces suies ultrafines dans l'atmosphère réduit l'impact des rayons solaires sur le sol, ce qui peut ralentir le réchauffement du climat."
                            },
                            {
                                "example_id": "d0dac61d-b428-47ab-a0e5-94dcd0f6cc81",
                                "sense_id": "bd60928b-5839-36ce-a606-9294e174da5c",
                                "text": "Nanometrix sait fabriquer des plaquettes de silicium — le matériau de base des puces électroniques insérées dans les ordinateurs — portant un revêtement ultrafin de photorésine, que l'on peut graver à l'aide de la lumière."
                            },
                            {
                                "example_id": "3ce33c05-f021-4a4e-8eba-f05f9824a46d",
                                "sense_id": "bd60928b-5839-36ce-a606-9294e174da5c",
                                "text": "C'est la firme Wrigley's, le numéro un du chewing-gum, qui commercialise cet étonnant produit baptisé Eclipse Flash. Dans un petit boîtier en plastique, 24 feuilles ultrafines, de la taille approximative d'un rectangle de sucre et dont le poids n'excède pas 0,045 g. Autrement dit, un souffle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fef6bb83-25cf-4ea1-83b1-fdf2e38dbae1",
                        "source_entry_id": "0bfe832c-ec60-3202-9771-038863150fa7",
                        "source_sense_id": "bd60928b-5839-36ce-a606-9294e174da5c",
                        "target_lang_word": "ultrafine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultrafine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "155bdc04-faf8-3ed1-902e-137a148260d2",
                                        "entry_id": "534d2983-7584-375c-a131-30563d7fccc6",
                                        "glosses": [
                                            "Very fine."
                                        ],
                                        "tags": [
                                            "of particles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16679176-d794-423a-800c-b66a267f0d3f",
                                                "sense_id": "155bdc04-faf8-3ed1-902e-137a148260d2",
                                                "text": "His idea is to stand billions of ultrafine wire loops around the edge of a silicon chip — hence the name racetrack — and use electric current to slide infinitesimally small magnets up and down along each of the wires to be read and written as digital ones and zeros."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ea20c68-e0b8-465d-9220-49232c8a8cc2",
                        "source_entry_id": "0bfe832c-ec60-3202-9771-038863150fa7",
                        "source_sense_id": "bd60928b-5839-36ce-a606-9294e174da5c",
                        "target_lang_word": "ultrathin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultrathin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb0dc637-9df1-3a45-bc5f-55bf01ae70ba",
                                        "entry_id": "4cfd6082-52ad-3f72-9458-9e743643b5d0",
                                        "glosses": [
                                            "Extremely thin; of utmost thinness."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6787feb5-68e5-433f-9419-a5b5e149d4e1",
                                                "sense_id": "fb0dc637-9df1-3a45-bc5f-55bf01ae70ba",
                                                "text": "When you build your esteem on the media's ultrathin, superslim image, you are going to lose by comparison."
                                            },
                                            {
                                                "example_id": "ac2b0a16-028c-467c-a5e4-b7c70903eb97",
                                                "sense_id": "fb0dc637-9df1-3a45-bc5f-55bf01ae70ba",
                                                "text": "Planar metamaterials with subwavelength thickness, or metasurfaces, consisting of single-layer or few-layer stacks of planar structures, can be readily fabricated using lithography and nanoprinting methods, and the ultrathin thickness in the wave propagation direction can greatly suppress the undesirable losses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
