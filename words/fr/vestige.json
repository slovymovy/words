            "senses": [
                {
                    "sense_id": "2d532b53-ef00-323f-9ce7-5a2cc16c2518",
                    "sense_definition": "Ce qui subsiste d'une chose détruite, démolie ou disparue ; ruine ou relique matérielle.",
