    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2b765988-b5b2-33fd-b3b7-feffd5789b19",
                "word": "boyhood",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b48ffab6-24e5-4e00-97e0-b097e6a49e31",
                        "entry_id": "2b765988-b5b2-33fd-b3b7-feffd5789b19",
                        "tags": [
                            "plural"
                        ],
                        "form": "boyhoods"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a3a2549-b1d4-3972-b2fb-1742ab6985d6",
                        "entry_id": "2b765988-b5b2-33fd-b3b7-feffd5789b19",
                        "glosses": [
                            "The state or condition of being a boy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d7c226d3-6f55-4baa-a460-1d475015f43e",
                                "sense_id": "4a3a2549-b1d4-3972-b2fb-1742ab6985d6",
                                "text": "And boyhood is a summer sun\nWhose waning is the dreariest one —\nFor all we live to know is known\nAnd all we seek to keep hath flown — […]"
                            },
                            {
                                "example_id": "0477bb1b-5754-41cf-af3e-467375aec00d",
                                "sense_id": "4a3a2549-b1d4-3972-b2fb-1742ab6985d6",
                                "text": "It is certainly my personal favourite, for it was by way of Hardwick's great Doric arch that I first sampled the roar and clatter of London streets, the trip being a boyhood reward for achieving (unexpected) success in a school examination!"
                            }
                        ]
                    },
                    {
                        "sense_id": "ebcfdb79-5675-31fe-b9f1-ba936798c888",
                        "entry_id": "2b765988-b5b2-33fd-b3b7-feffd5789b19",
                        "glosses": [
                            "The childhood of a boy."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82a4e2a3-54d1-4dc5-8288-ca5bb4483b70",
                        "source_entry_id": "2b765988-b5b2-33fd-b3b7-feffd5789b19",
                        "source_sense_description": "The state or period of being a boy",
                        "target_lang_word": "garçonnité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garçonnité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e77d47fa-5e4c-3e1a-a0d5-fafaecfdc0e4",
                                        "entry_id": "d5244f1c-d9f4-306d-99f1-7af716cbe82b",
                                        "glosses": [
                                            "État de garçon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25c6cb1-62b8-4654-b103-eddc9cc1ad3a",
                                                "sense_id": "e77d47fa-5e4c-3e1a-a0d5-fafaecfdc0e4",
                                                "text": "Ce numéro spécial est consacré à la « garçonnité », c’est-à-dire à l’apprentissage du masculin au cours de l’enfance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfb8d666-4df4-492c-9a19-40378f123971",
                        "source_entry_id": "2b765988-b5b2-33fd-b3b7-feffd5789b19",
                        "source_sense_description": "The state or period of being a boy",
                        "target_lang_word": "enfance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c568fcf4-fd9e-3685-8a79-e20df6f45e8d",
                                        "entry_id": "b7cae349-1f66-3a5c-ad9b-c990de9c42dd",
                                        "glosses": [
                                            "Première partie de la vie de l’être humain, précédant l’adolescence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6848c27e-fd30-487b-8e10-6008a3dae58c",
                                                "sense_id": "c568fcf4-fd9e-3685-8a79-e20df6f45e8d",
                                                "text": "Jadis, aux temps lointains de ma jeunesse, aux temps de mon enfance à jamais disparue, je me réjouissais en arrivant pour la première fois dans un endroit inconnu…"
                                            },
                                            {
                                                "example_id": "0355f974-8762-4e22-b067-72be236a976b",
                                                "sense_id": "c568fcf4-fd9e-3685-8a79-e20df6f45e8d",
                                                "text": "De ma tendre enfance je ne parlerai pas. […]. Eussé-je autrement décidé que je me garderais du ridicule qui s’attache à quiconque fait un sort aux minuties du premier âge."
                                            },
                                            {
                                                "example_id": "fa5f03f6-eac1-464f-9531-c2ecebf9cd64",
                                                "sense_id": "c568fcf4-fd9e-3685-8a79-e20df6f45e8d",
                                                "text": "Ma grand-mère a des principes, elle est le cadre rigide et clair de mon enfance, celui sur lequel on s'appuie, à l'opposé de l'agitation trouble de l'hôtel. Pas de bruit le dimanche chez mamie, pas de vélo, la table est un lieu de silence, pas une friterie de gare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eba206a5-a016-3d7f-8435-473f73827219",
                                        "entry_id": "b7cae349-1f66-3a5c-ad9b-c990de9c42dd",
                                        "glosses": [
                                            "État de celui qui est enfant, qui se comporte comme tel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7297481-accf-4597-bc3c-115ac21ee9fd",
                                                "sense_id": "eba206a5-a016-3d7f-8435-473f73827219",
                                                "text": "De sa bouche lisse, Amédée souriait, repris par l’hébétude de l’enfance."
                                            },
                                            {
                                                "example_id": "c70f909c-821a-4b30-96fd-03b537b8d430",
                                                "sense_id": "eba206a5-a016-3d7f-8435-473f73827219",
                                                "text": "être, tomber ou retomber en enfance, se dit d’une personne âgée qui n’a plus l’usage de la raison, se dit aussi d’une personne qui retrouve l’exubérance de sa jeunesse."
                                            },
                                            {
                                                "example_id": "b5a7a441-1729-4719-a1f9-ba92da00c9b2",
                                                "sense_id": "eba206a5-a016-3d7f-8435-473f73827219",
                                                "text": "Naturellement, on laissait tranquille ce désagréable vieillard que tout le monde croyait en enfance."
                                            },
                                            {
                                                "example_id": "2e80af1e-8c3a-4641-a331-5f627f250928",
                                                "sense_id": "eba206a5-a016-3d7f-8435-473f73827219",
                                                "text": "Les litanies de saint Antoine de Padoue que sa petite-ﬁlle vient lui réciter aux trois Angelus ont seules la vertu de calmer la grand-mère en enfance qu'on ne voit pas, cachée qu’elle demeure dans sa chambre, mais comme l’âme de la maison, on la devine partout présente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc78e743-ff9f-3f80-a743-9138007a64e9",
                                        "entry_id": "b7cae349-1f66-3a5c-ad9b-c990de9c42dd",
                                        "glosses": [
                                            "Commencement, début."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e9979b6-d0c8-4414-a806-7fb6b3434be2",
                                                "sense_id": "dc78e743-ff9f-3f80-a743-9138007a64e9",
                                                "text": "Les monuments qui nous restent de cette époque lointaine, attestent que les premiers Ardennais étaient des hommes demi-sauvages et appartenant à un peuple encore dans l’enfance de la civilisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d3e9d22-889e-3bda-8c8c-b2e4eca74915",
                                        "entry_id": "b7cae349-1f66-3a5c-ad9b-c990de9c42dd",
                                        "glosses": [
                                            "Ensemble des enfants."
                                        ],
                                        "tags": [
                                            "collectively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "699ab10d-6b19-43d2-a314-87f8699636fd",
                                                "sense_id": "9d3e9d22-889e-3bda-8c8c-b2e4eca74915",
                                                "text": "Le seul aspect de la femme révèle qu’elle n’est destinée ni aux grands travaux de l’intelligence, ni aux grands travaux matériels. Elle paie sa dette à la vie non par l’action mais par la souffrance, les douleurs de l’enfantement, les soins inquiets de l’enfance ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
