                ],
                "senses": [
                    {
                        "sense_id": "140cdb53-c658-3e63-b54f-26a0b4f61ef3",
                        "entry_id": "f443218a-471d-3446-9819-2cea04996dc3",
                        "glosses": [
                            "Geruch, der von Brennstoff (Alkohol, Benzin, Diesel, Kerosin) stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b1ec090-ccb1-4676-9c15-f1eefb4b800c",
                                "sense_id": "140cdb53-c658-3e63-b54f-26a0b4f61ef3",
                                "text": "„Auch der Treibstoffgeruch bleibt aus.“"
                            },
                            {
                                "example_id": "c92bf8e1-5454-48de-a784-ea2ed815f867",
                                "sense_id": "140cdb53-c658-3e63-b54f-26a0b4f61ef3",
                                "text": "„Es war eine vorerst unbekannte Menge Kerosin ausgetreten, was sich vor allem durch den intensiven Treibstoffgeruch am Unglücksort bemerkbar machte.“"
                            },
                            {
                                "example_id": "cd6c5d99-8177-4250-b3a7-d088811a9f7f",
                                "sense_id": "140cdb53-c658-3e63-b54f-26a0b4f61ef3",
                                "text": "„Heizöl auf dem Deilbach beschäftigt seit heute morgen die Velberter Feuerwehr. Im Bereich der Hauptstraße / Märkische Straße waren an dem Gewässer Ölschlieren und penetranter Treibstoffgeruch aufgefallen.“"
                            },
                            {
                                "example_id": "86012416-d36c-476a-8a9b-b76b9a888899",
                                "sense_id": "140cdb53-c658-3e63-b54f-26a0b4f61ef3",
                                "text": "„Die Maschine war am Sonntagabend auf dem Flug von London nach New York umgeleitet worden, nachdem der Flugkapitän im hinteren Teil der Kabine Treibstoffgeruch bemerkt hatte.“"
                            },
                            {
                                "example_id": "3931c699-2759-4a22-96c1-87f78836c56c",
                                "sense_id": "140cdb53-c658-3e63-b54f-26a0b4f61ef3",
                                "text": "„Klar denken war nicht möglich, zumal ich jetzt auch einen beunruhigenden, penetranten Treibstoffgeruch wahrnahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
