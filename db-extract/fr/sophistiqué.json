                        ],
                        "form": "sophistiqués"
                    },
                    {
                        "form_id": "a6b0b647-47d8-4733-a0d2-5860c681ae06",
                        "entry_id": "395292cb-f2c3-3fef-b925-5cb845aef9bd",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "sophistiquée"
                    },
                    {
                        "form_id": "30b374d1-4a0a-47ce-8f3b-141f15f17f54",
                        "entry_id": "395292cb-f2c3-3fef-b925-5cb845aef9bd",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "sophistiquées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a21f624-510c-352a-a48a-38e4e366e55d",
                        "entry_id": "395292cb-f2c3-3fef-b925-5cb845aef9bd",
                        "glosses": [
                            "Falsifié ; frelaté ; adultéré."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1797c5b7-d0b2-4f8b-a9c9-fc38d3fa3ebc",
                                "sense_id": "6a21f624-510c-352a-a48a-38e4e366e55d",
                                "text": "Vendeuses et revendeuses à faux poids de marchandise sophistiquée, avariée, pourrie quelquefois."
                            },
                            {
                                "example_id": "7345a320-eff1-49ff-b851-9a374e08bbad",
                                "sense_id": "6a21f624-510c-352a-a48a-38e4e366e55d",
                                "text": "Un marchand qui vend un œuf gâté, une viande avariée, un litre de lait sophistiqué, est tout simplement traité comme un empoisonneur qu’il est."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc61c93f-bd39-35df-972f-077343b1a921",
                        "entry_id": "395292cb-f2c3-3fef-b925-5cb845aef9bd",
                        "glosses": [
                            "Très raffiné ; étudié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b186497b-9353-4c15-b20d-d06d77e8a440",
                                "sense_id": "bc61c93f-bd39-35df-972f-077343b1a921",
                                "text": "La salade bulgare était un peu plus sophistiquée qu'ailleurs et l'agneau mangeable. En tout cas, Mara était ravie comme une enfant."
                            },
                            {
                                "example_id": "da0fdba5-c554-4918-9577-1644388e7051",
                                "sense_id": "bc61c93f-bd39-35df-972f-077343b1a921",
                                "text": "A leurs doigts sans cal, brillent de belles bagues d'or ou d'argent. Au poignet, de grosses montres frimeuses et sophistiquées classent leurs propriétaires ; elles peuvent aussi donner l'heure."
                            },
                            {
                                "example_id": "5ee83546-b632-49fa-9645-cceb29df9d11",
                                "sense_id": "bc61c93f-bd39-35df-972f-077343b1a921",
                                "text": "Ça vous inspire quoi ? demanda-t-elle après quelques minutes […]. Les artifices, reprit-elle, les gadgets sophistiqués, pour une bagnole, ou une moto, ça s'appelle le customing ou le tuning."
                            }
                        ]
                    },
                    {
                        "sense_id": "251d7a66-319b-3219-992f-bb4e1f6b95fe",
                        "entry_id": "395292cb-f2c3-3fef-b925-5cb845aef9bd",
                        "glosses": [
                            "D’une complication, d’une subtilité extrême."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c78bb12d-0885-47f4-89c8-db1e4aea1176",
                                "sense_id": "251d7a66-319b-3219-992f-bb4e1f6b95fe",
                                "text": "Une argumentation sophistiquée."
                            }
                        ]
                    },
                    {
                        "sense_id": "005da549-c0d5-323f-827f-728b55081748",
                        "entry_id": "395292cb-f2c3-3fef-b925-5cb845aef9bd",
                        "glosses": [
                            "Très perfectionné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a50bb13-78e8-4313-9e52-449056e8ffd4",
                                "sense_id": "005da549-c0d5-323f-827f-728b55081748",
                                "text": "Utilisant pour code personnel des algorithmes beaucoup plus sophistiqués que le matériel standard de cryptage des données, il était en principe impiratable par les superordinateurs du gouvernement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bda23602-9670-4d5b-9820-ff110abc99dd",
                        "source_entry_id": "395292cb-f2c3-3fef-b925-5cb845aef9bd",
                        "target_lang_word": "sophisticated",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sophisticated",
