                                                "sense_id": "d8354a70-57c0-3a19-845c-dd82231d1329",
                                                "text": "Das Thermometer mit der angespitzten Sonde eignet sich zum Messen der Kerntemperatur von Lebensmitteln."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
