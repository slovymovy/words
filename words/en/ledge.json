    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "509f50b0-8f1c-3e96-9f33-66a76d6eb86e",
                    "sense_definition": "A narrow surface projecting horizontally from a wall, cliff, or other vertical surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shelf_projection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain climber carefully placed his foot on a narrow rock <w>ledge</w>.",
                            "target_lang_translations": {
                                "ru": "Альпинист осторожно поставил ногу на узкий каменный <w>выступ</w>.",
                                "nl": "De bergbeklimmer zette zijn voet voorzichtig op een smalle rots<w>richel</w>."
                            }
                        },
                        {
                            "text": "A small bird built its nest on the window <w>ledge</w> outside my bedroom.",
                            "target_lang_translations": {
                                "ru": "Маленькая птичка свила гнездо на подоконном <w>выступе</w> за окном моей спальни.",
                                "nl": "Een klein vogeltje bouwde zijn nest op de venster<w>bank</w> buiten mijn slaapkamer."
                            }
                        }
                    ],
                    "synonyms": [
                        "shelf",
                        "projection",
                        "ridge"
                    ],
                    "common_phrases": [
                        "window ledge",
                        "rocky ledge",
                        "narrow ledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкая горизонтальная поверхность, выступающая из стены, скалы или другой вертикальной поверхности.",
                        "nl": "Een smal horizontaal oppervlak dat uitsteekt uit een muur, rots of ander verticaal oppervlak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выступ",
                                "target_lang_sense_clarification": "скалы, стены"
                            },
                            {
                                "target_lang_word": "уступ",
                                "target_lang_sense_clarification": "в скале или стене"
                            },
                            {
                                "target_lang_word": "карниз",
                                "target_lang_sense_clarification": "выступающая часть"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "richel",
                                "target_lang_sense_clarification": "smalle uitstekende rand"
                            },
                            {
                                "target_lang_word": "uitsteeksel",
                                "target_lang_sense_clarification": "algemene term voor iets dat uitsteekt"
                            },
                            {
                                "target_lang_word": "rand",
                                "target_lang_sense_clarification": "smalle strook aan de zijkant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90c1d3d6-34df-3740-a95a-5be86e05361c",
                    "sense_definition": "A shelf on which articles may be laid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shelf_projection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He placed his keys on the wooden <w>ledge</w> near the front door.",
                            "target_lang_translations": {
                                "ru": "Он положил ключи на деревянную <w>полку</w> у входной двери.",
                                "nl": "Hij legde zijn sleutels op de houten <w>plank</w> bij de voordeur."
                            }
                        },
                        {
                            "text": "The fireplace had a wide stone <w>ledge</w> where they displayed family photos.",
                            "target_lang_translations": {
                                "ru": "У камина был широкий каменный <w>выступ</w>, на котором стояли семейные фотографии.",
                                "nl": "De open haard had een brede stenen <w>richel</w> waar ze familiefoto's op uitstalden."
                            }
