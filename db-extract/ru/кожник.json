                ],
                "translations": [
                    {
                        "translation_id": "115fa133-895f-4a1e-818a-df8a20c25f0a",
                        "source_entry_id": "027dd8c4-13ce-39cc-9260-72a12f042ebd",
                        "source_sense_description": "врач",
                        "target_lang_word": "dermatologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dermatologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a738432-aeaa-31ae-a3d8-e0622bef7bcb",
                                        "entry_id": "da0c8d84-a522-390f-b8c6-3da65da9c89e",
                                        "glosses": [
                                            "A person who is skilled in, professes or practices dermatology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b58aa3-3417-4c54-9b9c-aadb73c821b1",
                                                "sense_id": "7a738432-aeaa-31ae-a3d8-e0622bef7bcb",
                                                "text": "We have offered our products to our own burn surgeons and to other specialists of our and other hospitals, namely dermatologists, plasticians and specialists for long-term illnesses."
                                            },
                                            {
                                                "example_id": "c5018ff8-4fa1-4d8d-8f70-493c67acda84",
                                                "sense_id": "7a738432-aeaa-31ae-a3d8-e0622bef7bcb",
                                                "text": "From now on, too, general practitioners should, as Southard emphasized, be urged to be at least as familiar with the general principles and methods of the psychiatrist as they are with those of the gynecologist, the dermatologist, and the pædiatrist."
                                            },
                                            {
                                                "example_id": "63eee226-3314-4867-87f0-d5b15eb14062",
                                                "sense_id": "7a738432-aeaa-31ae-a3d8-e0622bef7bcb",
                                                "text": "“When it comes to the dry skin, it’s really a matter of that top barrier that’s not holding onto the moisture as well,” said Dr. Jennifer Stein, a dermatologist at NYU Langone Health."
                                            },
                                            {
                                                "example_id": "9af96571-72bf-4048-9b57-84abfbc2aa54",
                                                "sense_id": "7a738432-aeaa-31ae-a3d8-e0622bef7bcb",
                                                "text": "According to dermatologists and estheticians, you can expect to see a noticeable difference around the age of 40 — which is why I consulted five of these skin experts who are 40+ themselves, getting their top tips for transitioning (and maintaining) an effective skin care regimen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
