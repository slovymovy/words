                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ab7db4c-86ab-4eae-bf22-9ac8dfcecf24",
                                                "sense_id": "f29d58d4-78cf-3cee-8395-16c5b148cf40",
                                                "text": "Wij weken."
                                            },
                                            {
                                                "example_id": "c300ab13-0b88-4cb8-861d-d80c09cd731b",
                                                "sense_id": "f29d58d4-78cf-3cee-8395-16c5b148cf40",
                                                "text": "Jullie weken."
                                            },
                                            {
                                                "example_id": "9509663a-2f83-45cc-8bf7-0dd3c83d11ef",
                                                "sense_id": "f29d58d4-78cf-3cee-8395-16c5b148cf40",
