                "senses": [
                    {
                        "sense_id": "10696253-87ba-39d7-b6aa-dbda4c7f5be3",
                        "entry_id": "67972863-b0b2-3c13-b361-eb3d840669ce",
                        "glosses": [
                            "Gespräch, bei dem ein Gesprächsleiter sich nur mit einer Person (Patient, Ratsuchender,…) befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "858992ef-a38b-47b3-ad8f-af6d838d1785",
                                "sense_id": "10696253-87ba-39d7-b6aa-dbda4c7f5be3",
                                "text": "„Auf dem Stundenplan der Patientin standen Einzel- und Gruppengespräche, Physiotherapie, Massagen, Sporttherapie, Entspannungsübungen und Ernährungsberatung.“"
                            },
                            {
                                "example_id": "f2777bf9-d5f9-4ebb-9304-8925426b2f13",
                                "sense_id": "10696253-87ba-39d7-b6aa-dbda4c7f5be3",
                                "text": "„Dieser leitete die Verhandlungen energisch, zuweilen autoritär und überwand in Einzelgesprächen tote Punkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
