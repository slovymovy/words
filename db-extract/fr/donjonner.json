                        "glosses": [
                            "Explorer des donjons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5fc95c2-f69b-484d-8798-8cb51f487b74",
                                "sense_id": "a32fe495-4fed-3cd4-aa59-1e5089b60a6c",
                                "text": "Prendre un maximum de fun, faire le leveling en guilde et/ou en solo, s'entraider, quêter, donjonner et atteindre ce foutu niveau 60 !"
                            },
                            {
                                "example_id": "e50451c4-fc32-40f2-8ef9-ece154da496a",
                                "sense_id": "a32fe495-4fed-3cd4-aa59-1e5089b60a6c",
                                "text": "Nous proposons des sorties de groupe deux fois par semaine : le jeudi et le dimanche soirs, pour donjonner et explorer ensemble !"
                            },
                            {
                                "example_id": "86f48e0d-6c6f-42c6-a4ba-f0531cd8387d",
                                "sense_id": "a32fe495-4fed-3cd4-aa59-1e5089b60a6c",
                                "text": "Quelqu'un de dispo au moins un soir par semaine pour donjonner avec nous et découvrir les raids."
                            }
                        ]
                    }
