                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "430a9ed3-3554-4383-8a2b-bd45cac932f4",
                                                "sense_id": "16a97952-7dba-317d-bb24-0b9328f92479",
                                                "text": "Takové malé bel, že jé nebelo hani nad zemňó hani pod zemňó — hale slešet jé belo jako kazatela."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8717ce9c-9101-4beb-9d1d-2d179437cdac",
                        "source_entry_id": "62541d3f-51b4-334b-b907-4998d663864d",
                        "source_sense_id": "c3e17adb-5e1d-31d2-a8da-0acb4564256f",
                        "source_sense_description": "measure of relative power",
                        "target_lang_word": "bel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5bbd1b-7f9b-3e79-8b48-bef6bfdb4521",
                                        "entry_id": "9e2ed38d-0685-3687-9079-5d4ba8c92f51",
                                        "glosses": [
                                            "Unité sans dimension, de symbole B, utilisée pour exprimer les rapports de deux grandeurs de même espèce. Le bel est le logarithme décimal de ce rapport : autrement dit, un rapport de 10:1 vaut 1 bel. Les unités pratiques les plus courantes sont le décibel (dB) et le centibel (cB)."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88b63cd5-b2a4-310b-94f8-4b14e1de6a33",
                                        "entry_id": "e11404a2-bdca-330c-a800-0441a920d167",
                                        "glosses": [
                                            "Variante de beau devant une voyelle."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "note": "Se place toujours avant le nom auquel il s’applique",
                                        "examples": [
                                            {
                                                "example_id": "6ce69879-bb49-4719-997d-5f7e2cc9fa8b",
                                                "sense_id": "88b63cd5-b2a4-310b-94f8-4b14e1de6a33",
                                                "text": "L’une sur son front blanc va de sa chevelure\nFormer les blonds anneaux. L’autre de son menton\nCaresse lentement le mol et doux coton.\n« Approche, bel enfant, approche, lui dit-elle,\nToi si jeune et si beau, près de moi jeune et belle. »"
                                            },
                                            {
                                                "example_id": "ea10c602-f434-4ffa-b18e-837c605a18ca",
                                                "sense_id": "88b63cd5-b2a4-310b-94f8-4b14e1de6a33",
                                                "text": "La nuit est chaude. Vous remontez en flânant la Canebière et vous la quittez au boulevard Dugommier. Vous arrivez vite au bel escalier monumental, tout battant neuf, qui monte à la gare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
