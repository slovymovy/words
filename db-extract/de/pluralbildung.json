                "senses": [
                    {
                        "sense_id": "0a33d416-7dbc-3635-852b-9fb3dc7bd8a2",
                        "entry_id": "f4bfb077-de4f-310e-8d44-608e6cd6ffb0",
                        "glosses": [
                            "Bildung einer Sprachform, die den Plural ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "924be18e-a43f-439b-9533-bc0329535499",
                                "sense_id": "0a33d416-7dbc-3635-852b-9fb3dc7bd8a2",
                                "text": "„Angesichts des regulären Charakters dieser Pluralbildung und der gleichen Bedeutung der drei Varianten erscheint es nach der Logik unserer bisherigen Agumentation angebracht, ein einziges Pluralmorphem /z/ als zugrundeliegend anzunehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "23b99ba4-ef22-3a97-b9df-cc6fb839346d",
                        "entry_id": "f4bfb077-de4f-310e-8d44-608e6cd6ffb0",
                        "glosses": [
                            "Sprachform, die den Plural ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d93bdd4-ce13-4fc0-9e32-e65ac55015a7",
                                "sense_id": "23b99ba4-ef22-3a97-b9df-cc6fb839346d",
                                "text": "„Der Duden empfiehlt die Pluralbildung Countys (im Gegensatz zu engl. counties) und als Genus das oder die.“"
                            },
                            {
                                "example_id": "3f924120-a17a-4266-88b7-b543ccc5f4e8",
                                "sense_id": "23b99ba4-ef22-3a97-b9df-cc6fb839346d",
                                "text": "„Besonders kniffelig wird es bei Homonymen, die zwar das gleiche grammatische Geschlecht haben, aber eine unterschiedliche Pluralbildung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
