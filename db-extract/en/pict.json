                                    {
                                        "sense_id": "207dddfe-e949-3f9a-af1f-b308cdddb2df",
                                        "entry_id": "528fa10a-9483-37ac-acac-1d366d69bb77",
                                        "glosses": [
                                            "Angehöriger eines alten keltischen Volkes in Schottland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba7ae390-2c24-482f-bf43-ae421ca3dfd1",
                                                "sense_id": "207dddfe-e949-3f9a-af1f-b308cdddb2df",
                                                "text": "„War man früher der Meinung, dass die Pikten eine vorindogermanische (also keine keltische) Sprache gesprochen hätten, ordnet man heute die Pikten durchaus den Kelten zu.“"
                                            },
                                            {
                                                "example_id": "37fbc6d9-7684-435b-8089-b98f7eb56dda",
                                                "sense_id": "207dddfe-e949-3f9a-af1f-b308cdddb2df",
                                                "text": "„Die Ureinwohner der Inseln, etwa die auf den Orkneys lebenden Pikten, sind von den Skandinaviern vermutlich unterdrückt, getötet oder als Sklaven verschleppt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
