                },
                {
                    "sense_id": "b1f729f2-9ae7-3f46-8097-99a9159147af",
                    "sense_definition": "Envahir brusquement et intensément, en parlant d'un sentiment ou d'une émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En montant sur scène pour recevoir son prix, l'actrice s'est sentie <w>submergée</w> par l'émotion.",
                            "target_lang_translations": {
                                "en": "As she walked onto the stage to accept her award, the actress was <w>overcome</w> with emotion.",
                                "ru": "Поднимаясь на сцену, чтобы получить награду, актриса почувствовала, что её <w>захлестнули</w> эмоции.",
                                "de": "Als sie die Bühne betrat, um ihren Preis entgegenzunehmen, fühlte sie sich von Gefühlen <w>überwältigt</w>.",
                                "es": "Al subir al escenario para recibir su premio, la actriz se sintió <w>embargada</w> por la emoción.",
                                "zh": "走上舞台领奖时，女演员感到自己被激动的情绪<w>淹没</w>了。"
                            }
                        },
                        {
                            "text": "Il a essayé de rester calme pour ne pas se laisser <w>submerger</w> par la panique.",
                            "target_lang_translations": {
                                "en": "He tried to stay calm so as not to be <w>overwhelmed</w> by panic.",
                                "ru": "Он старался сохранять спокойствие, чтобы паника его не <w>захлестнула</w>.",
                                "de": "Er versuchte, ruhig zu bleiben, um sich nicht von der Panik <w>überwältigen</w> zu lassen.",
                                "es": "Intentó mantener la calma para no dejarse <w>abrumar</w> por el pánico.",
                                "zh": "他努力保持镇定，以免被恐慌<w>淹没</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "envahir"
                    ],
                    "common_phrases": [
                        "submergé par l'émotion",
                        "se laisser submerger"
                    ],
                    "target_lang_definitions": {
                        "en": "To suddenly and intensely overwhelm a person, as a feeling or emotion does.",
                        "ru": "Внезапно и сильно охватить человека, о чувстве или эмоции.",
                        "de": "Einen Menschen plötzlich und heftig erfassen, etwa als Gefühl oder Emotion.",
                        "es": "Invadir de repente e intensamente a alguien, como hace un sentimiento o una emoción.",
                        "zh": "情绪或感受突然而强烈地袭向某人，使其难以自持。"
                    },
