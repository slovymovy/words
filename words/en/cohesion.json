{
    "word_family": [
        "cohere",
        "cohesive",
        "coherency"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb49efa8-fea3-3dff-a59a-16f53760a04a",
                    "sense_definition": "The state of working together effectively as a group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strong <w>cohesion</w> within the team helped them win the championship.",
                            "target_lang_translations": {
                                "ru": "Высокая <w>сплочённость</w> внутри команды помогла им выиграть чемпионат."
                            }
                        },
                        {
                            "text": "The military unit maintained high <w>cohesion</w> despite the difficult conditions.",
                            "target_lang_translations": {
                                "ru": "Воинское подразделение сохраняло высокую <w>сплочённость</w> несмотря на тяжёлые условия."
                            }
                        }
                    ],
                    "synonyms": [
                        "unity",
                        "solidarity"
                    ],
                    "common_phrases": [
                        "team cohesion",
                        "social cohesion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние эффективной совместной работы группы людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплочённость",
                                "target_lang_sense_clarification": "особенно применительно к коллективам и группам людей"
                            },
                            {
                                "target_lang_word": "еди́нство",
                                "target_lang_sense_clarification": "общность целей и солидарность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ecf54ad-aa02-3a32-af2b-2e3bbe6f6580",
                    "sense_definition": "The degree to which related parts of a system are logically connected.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "system_logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software design prioritizes high <w>cohesion</w> to make the code easier to maintain.",
                            "target_lang_translations": {
                                "ru": "Проектирование программного обеспечения уделяет приоритетное внимание высокой <w>связности</w>, чтобы облегчить поддержку кода."
                            }
                        },
                        {
                            "text": "Good system <w>cohesion</w> ensures that all components work together as a logical whole.",
                            "target_lang_translations": {
                                "ru": "Хорошая <w>связность</w> системы гарантирует, что все компоненты работают вместе как логическое целое."
                            }
                        }
                    ],
                    "common_phrases": [
                        "high cohesion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Степень логической взаимосвязанности компонентов системы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свя́зность",
                                "target_lang_sense_clarification": "логическая взаимосвязь элементов системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bdb4002-2d57-3889-8be6-e56d0271fd66",
                    "sense_definition": "The grammatical or lexical links that connect parts of a text.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author uses pronouns to create <w>cohesion</w> throughout the essay.",
                            "target_lang_translations": {
                                "ru": "Автор использует местоимения для создания <w>связности</w> во всём эссе."
                            }
                        },
                        {
                            "text": "Textual <w>cohesion</w> is essential for making a paragraph easy to read and understand.",
                            "target_lang_translations": {
                                "ru": "Текстовая <w>связность</w> необходима для того, чтобы абзац было легко читать и понимать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "textual cohesion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грамматические или лексические средства, связывающие части текста."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свя́зность",
                                "target_lang_sense_clarification": "лингвистическая характеристика текста"
                            },
                            {
                                "target_lang_word": "коге́зия",
                                "target_lang_sense_clarification": "термин, используемый в лингвистике для описания связей в тексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c724036-2476-3d29-8270-760526b0b594",
                    "sense_definition": "The physical force that holds molecules of the same substance together.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water droplets form spheres due to the strong <w>cohesion</w> between molecules.",
                            "target_lang_translations": {
                                "ru": "Капли воды образуют сферы благодаря сильной <w>когезии</w> между молекулами."
                            }
                        },
                        {
                            "text": "The <w>cohesion</w> of the liquid allows it to resist being pulled apart.",
                            "target_lang_translations": {
                                "ru": "<w>Когезия</w> жидкости позволяет ей сопротивляться разрыву."
                            }
                        }
                    ],
                    "antonyms": [
                        "adhesion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая сила, удерживающая молекулы одного вещества вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коге́зия",
                                "target_lang_sense_clarification": "физический термин для молекулярного сцепления"
                            },
                            {
                                "target_lang_word": "сцепле́ние",
                                "target_lang_sense_clarification": "общее понятие физического соединения частиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61bd1986-0529-3415-a7cb-c4fa8b726e96",
                    "sense_definition": "The process of distinct plant parts growing together into one structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cohesion</w> of the petals creates a unique shape in this flower species.",
                            "target_lang_translations": {
                                "ru": "<w>Срастание</w> лепестков создаёт уникальную форму у этого вида цветов."
                            }
                        },
                        {
                            "text": "Botanists study the <w>cohesion</w> of plant tissues during early development.",
                            "target_lang_translations": {
                                "ru": "Ботаники изучают <w>срастание</w> растительных тканей в процессе раннего развития."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс срастания отдельных частей растения в единую структуру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сраста́ние",
                                "target_lang_sense_clarification": "биологический процесс соединения частей растения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}