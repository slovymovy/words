                                            {
                                                "example_id": "f332fe38-5c37-42a7-8754-e50ed52d6198",
                                                "sense_id": "18cf9ed5-9a32-3c06-a32e-b6cd8c0e11b6",
                                                "text": "In winter the line between Barnard Castle and Kirkby Stephen was regularly blocked by snowdrifts; in 1947, for instance, it was closed for eight weeks and only three weeks before it was finally closed no trains were able to use it for three days because of thick snow."
                                            }
                                        ]
