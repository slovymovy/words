                                    {
                                        "sense_id": "a78f3ffa-1f94-331c-965a-0d73184c9d68",
                                        "entry_id": "33847154-17a8-3714-896b-0cb75ec36fb9",
                                        "glosses": [
                                            "sich heraushebend, absetzend; außergewöhnlich, ungewöhnlich, überdurchschnittlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af647980-53d2-46e8-bf20-9a9ee075b667",
                                                "sense_id": "a78f3ffa-1f94-331c-965a-0d73184c9d68",
                                                "text": "Das ist eine außerordentliche Leistung."
                                            },
                                            {
                                                "example_id": "016dfc3b-3df9-40c1-b524-2290a50b1bdc",
                                                "sense_id": "a78f3ffa-1f94-331c-965a-0d73184c9d68",
                                                "text": "„Der Machtbereich der askanischen Markgrafen hatte sich seit der Mitte des 13. Jahrhunderts außerordentlich erweitert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf0aa54a-40e1-36e9-a983-6ad935139f88",
                                        "entry_id": "33847154-17a8-3714-896b-0cb75ec36fb9",
                                        "glosses": [
                                            "sehr, viel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2316ba36-ac84-4a05-89f4-3588c7b85367",
                                                "sense_id": "cf0aa54a-40e1-36e9-a983-6ad935139f88",
                                                "text": "Das Essen war außerordentlich lecker."
                                            },
                                            {
                                                "example_id": "a4dfbf1c-4d1f-4305-a2e5-8bc02a0a0dce",
                                                "sense_id": "cf0aa54a-40e1-36e9-a983-6ad935139f88",
                                                "text": "„Die wirkliche Bahn des Mondes ist außerordentlich kompliziert, da er sich mit der Erde um die Sonne bewegt und auch unser Sonnensystem als Ganzes nicht ruht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "65c3a97e-8f72-37b9-a2dd-5795015b5d40",
                                        "entry_id": "33847154-17a8-3714-896b-0cb75ec36fb9",
                                        "glosses": [
                                            "außerhalb einer verfassten Ordnung liegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eeda2ef-4a7b-4658-a9a3-c97780e11777",
                                                "sense_id": "65c3a97e-8f72-37b9-a2dd-5795015b5d40",
                                                "text": "Ein außerordentlicher Professor."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39cbb865-9e6b-436b-9c65-d046f9582bc0",
                        "source_entry_id": "43c8e4a3-44a4-30f5-bb2d-f0e0bff5134e",
                        "source_sense_id": "baab1e26-3beb-39c0-b09b-0ef495132edb",
                        "target_lang_word": "ungeheuer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungeheuer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                        "entry_id": "0730714a-4f91-34ea-9b9e-99b099cc64cd",
                                        "glosses": [
                                            "sehr groß, sehr stark oder sehr intensiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbc7e8b-5efb-4629-b013-f08d090043d6",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Als Gregor Samsa eines Morgens aus unruhigen Träumen erwachte, fand er sich in seinem Bett zu einem ungeheuren Ungeziefer verwandelt."
                                            },
                                            {
                                                "example_id": "8673a4c0-5b08-43c0-b7d7-0fba5064c343",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Wir sprechen hier über ungeheure Summen."
                                            },
                                            {
                                                "example_id": "4c9c9cef-4c3b-44b8-befb-413904d3fff4",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Der nur eine knappe Viertelstunde dauernde Film [\"Die Reise zum Mond\" von 1902] macht auch heute noch ungeheuer viel Spaß."
                                            },
                                            {
                                                "example_id": "a02ca4c2-8d35-419b-9fee-bf862b192569",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Philippe Noiret spielt ungeheuer intensiv einen stillen Uhrmacher aus Lyon, dessen Leben aus den Fugen gerät."
                                            },
                                            {
                                                "example_id": "a7b865d2-7806-4e3d-8e29-b0f50c4a1433",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Das Gericht sprach bei der Urteilsverkündung [zum OPEC-Prozess] von einer \"ungeheuer beschwerlichen Sachaufklärung\"."
                                            },
                                            {
                                                "example_id": "6376d46b-6bd9-4bf5-9c93-e5c6e0d76ed6",
                                                "sense_id": "d63e78a1-faf5-3e91-b8c5-b3ac54c719cf",
                                                "text": "Adriana Altaras ist ein Multitalent: Schauspielerin, Regisseurin und Autorin, intelligent, schlagfertig und ungeheuer witzig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9a23905-38df-37f8-b382-49dfa3cfc567",
                                        "entry_id": "0730714a-4f91-34ea-9b9e-99b099cc64cd",
                                        "glosses": [
                                            "unheimlich, nicht geheuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8bcc4a7-73be-4e04-aed7-eb4ce2489912",
                                                "sense_id": "a9a23905-38df-37f8-b382-49dfa3cfc567",
                                                "text": "Ihr wurde immer etwas ungeheuer, wenn sie den dunklen Typ in der Einfahrt gegenüber sah."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
