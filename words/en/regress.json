{
    "word_family": [
        "regression",
        "regressive",
        "regressor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "418d2709-ba05-312a-b208-7213b23354b0",
                    "sense_definition": "To move backwards to an earlier or worse state or stage.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "move_backwards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient began to <w>regress</w> after the medication was stopped.",
                            "target_lang_translations": {
                                "ru": "После отмены лекарства состояние пациента начало <w>ухудшаться</w>."
                            }
                        },
                        {
                            "text": "If we do not continue to practice, our skills will surely <w>regress</w>.",
                            "target_lang_translations": {
                                "ru": "Если мы не продолжим тренироваться, наши навыки непременно <w>деградируют</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "retrogress",
                        "backslide"
                    ],
                    "antonyms": [
                        "advance",
                        "progress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращаться к более раннему, худшему состоянию или менее развитой стадии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регрессировать",
                                "target_lang_sense_clarification": "идти по пути ухудшения, упадка"
                            },
                            {
                                "target_lang_word": "ухудшаться",
                                "target_lang_sense_clarification": "о состоянии здоровья или навыках"
                            },
                            {
                                "target_lang_word": "откатываться назад",
                                "target_lang_sense_clarification": "терять прогресс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81dde224-0c5e-3d9a-a6ed-a9c47ba99b16",
                    "sense_definition": "To return to a previous, often less mature, pattern of behavior.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "move_backwards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under extreme stress, the child started to <w>regress</w> and began sucking his thumb again.",
                            "target_lang_translations": {
                                "ru": "Под сильным стрессом ребёнок начал <w>регрессировать</w> и снова стал сосать палец."
                            }
                        },
                        {
                            "text": "It is common for people to <w>regress</w> to old habits when they feel overwhelmed.",
                            "target_lang_translations": {
                                "ru": "Людям свойственно <w>возвращаться</w> к старым привычкам, когда они чувствуют себя перегруженными."
                            }
                        }
                    ],
                    "synonyms": [
                        "backslide"
                    ],
                    "antonyms": [
                        "progress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращаться к прежней, часто менее зрелой модели поведения (в психологии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регрессировать",
                                "target_lang_sense_clarification": "в психологическом контексте"
                            },
                            {
                                "target_lang_word": "впадать в детство",
                                "target_lang_sense_clarification": "проявлять инфантильные модели поведения"
                            },
                            {
                                "target_lang_word": "возвращаться",
                                "target_lang_sense_clarification": "к старым привычкам или паттернам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a60ba9e-9f76-39fa-a3d7-aa173a34a6b4",
                    "sense_definition": "To perform a statistical analysis to determine the relationship between variables.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "statistical_analysis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Researchers <w>regress</w> the dependent variable against several independent factors to find correlations.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>строят регрессию</w> зависимой переменной по нескольким независимым факторам, чтобы выявить корреляции."
                            }
                        },
                        {
                            "text": "You should <w>regress</w> the data to see if the trend is statistically significant.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>провести регрессионный анализ</w> данных, чтобы проверить, является ли тенденция статистически значимой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить регрессионный анализ для определения взаимосвязи между переменными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строить регрессию",
                                "target_lang_sense_clarification": "в статистике"
                            },
                            {
                                "target_lang_word": "проводить регрессионный анализ",
                                "target_lang_sense_clarification": "вычислять зависимость параметров"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7620d18-18f4-3623-9a7a-6222193d4937",
                    "sense_definition": "The act of returning to a previous, often worse, state or condition.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "move_backwards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics warned that the new law would be a <w>regress</w> to the bad old days.",
                            "target_lang_translations": {
                                "ru": "Критики предупреждали, что новый закон станет <w>шагом назад</w> к худшим временам прошлого."
                            }
                        },
                        {
                            "text": "Economic <w>regress</w> is a major concern for the developing nation.",
                            "target_lang_translations": {
                                "ru": "Экономический <w>регресс</w> вызывает серьёзную обеспокоенность у этой развивающейся страны."
                            }
                        }
                    ],
                    "synonyms": [
                        "regression"
                    ],
                    "antonyms": [
                        "progress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение к прежнему, более худшему или отсталому состоянию; упадок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регресс",
                                "target_lang_sense_clarification": "упадок, противоположность прогрессу"
                            },
                            {
                                "target_lang_word": "откат назад",
                                "target_lang_sense_clarification": "возврат к прошлому состоянию"
                            },
                            {
                                "target_lang_word": "упадок",
                                "target_lang_sense_clarification": "ухудшение положения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}