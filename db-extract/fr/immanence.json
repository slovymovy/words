                "senses": [
                    {
                        "sense_id": "2f85cc75-f0a3-3f97-8bd6-8819d9f53fc2",
                        "entry_id": "71f1bb3e-7e9a-3852-82a7-1795f6e251e5",
                        "glosses": [
                            "Le fait d’exister d’une manière immanente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65f0e9f4-8103-469b-b516-a361fd13d30b",
                                "sense_id": "2f85cc75-f0a3-3f97-8bd6-8819d9f53fc2",
                                "text": "Les panthéistes professent l’immanence de Dieu dans le monde. - Philosophie de l’immanence."
                            },
                            {
                                "example_id": "6585095d-cad6-408b-8ac0-b3ae837fd4e0",
                                "sense_id": "2f85cc75-f0a3-3f97-8bd6-8819d9f53fc2",
                                "text": "L'autour est l'oiseau de l'immanence, une foudre horizontale, capable de sauts ascendants, de quasi-voltes en l'air, d'une promptitude magnifique."
                            },
                            {
                                "example_id": "68639341-f048-45f5-ac27-c198e6025a65",
                                "sense_id": "2f85cc75-f0a3-3f97-8bd6-8819d9f53fc2",
                                "text": "Dans l’immanence pure de cet instant où je suis une fille de bientôt dix-neuf ans qui photographie le lieu qu'elle quitte, elle le sait, pour toujours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
