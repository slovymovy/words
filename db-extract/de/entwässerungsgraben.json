                "senses": [
                    {
                        "sense_id": "5373806c-d52a-3e6d-b937-5735c08a5d7e",
                        "entry_id": "03b3dbd3-84c8-3525-ab47-d6836c09b413",
                        "glosses": [
                            "Graben, der dem Ablauf von Bodenwasser dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1813c874-1164-4151-8db5-44dd6ae7b210",
                                "sense_id": "5373806c-d52a-3e6d-b937-5735c08a5d7e",
                                "text": "„Ein ausgedehntes System von Entwässerungsgräben erlaubte ihnen allerdings auch im Sumpfland Ackerbau, meinen nun Archäologen.“"
                            },
                            {
                                "example_id": "84ef07ea-b864-41aa-9be5-2fcef6368366",
                                "sense_id": "5373806c-d52a-3e6d-b937-5735c08a5d7e",
                                "text": "„Während der Wind über das moosige Gelände peitscht, glättet der Fahrer der Maschine die Entwässerungsgräben, die die Landschaft verunstalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
