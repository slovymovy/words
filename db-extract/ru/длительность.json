                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76d44e38-d27d-4549-9be3-c65cbb79b503",
                                                "sense_id": "189f60be-12d7-3b11-a6cd-f37c202094b8",
                                                "text": "Der Friede ist vermutlich nicht von Dauer."
