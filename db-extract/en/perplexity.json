                    {
                        "translation_id": "9fe89807-0f7d-46e1-83fd-6a8b06c0490a",
                        "source_entry_id": "9d4240ec-6b31-3002-9827-5bcb7d0febbf",
                        "source_sense_description": "state or quality of being perplexed",
                        "target_lang_word": "perplexité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perplexité",
