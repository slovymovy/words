                "senses": [
                    {
                        "sense_id": "70cc0e9e-3508-302f-a7c5-79b038be710d",
                        "entry_id": "ef3cd50c-acd3-359e-855b-94f487fd2957",
                        "glosses": [
                            "technisches Gebilde von höherer Komplexität aus Kunststoff"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "9bed742d-d17c-4a54-ac6f-c944d5908c18",
                                "sense_id": "70cc0e9e-3508-302f-a7c5-79b038be710d",
                                "text": "„Der allgemeine Begriff Apparatebau bedeutet bei uns die Konstruktion und Produktion von Kunststoffapparaten, die nach Material und Beschaffenheit dem WHG entsprechen und für die Wassertechnik geeignet sind.“"
                            },
                            {
                                "example_id": "33dfe27f-4c1e-4813-b8d6-bd7e69c2d936",
                                "sense_id": "70cc0e9e-3508-302f-a7c5-79b038be710d",
                                "text": "„Unsere werkseigene Fertigung garantiert eine sorgfältige Ausführung der von uns konstruierten Kunststoffapparate und umwelttechnischen Anlagen.“"
                            },
                            {
                                "example_id": "0ef8a3af-8456-482a-a742-2049a1e63525",
                                "sense_id": "70cc0e9e-3508-302f-a7c5-79b038be710d",
                                "text": "„In diesem Geschäftsfeld stellen wir für unsere Kunden Kunststoffbehälter und Kunststoffapparate nach deren individuellen Vorgaben und statischen Erfordernissen her.“"
                            },
                            {
                                "example_id": "d72ed9cf-5129-4bf6-8fe2-4cf85f820bce",
                                "sense_id": "70cc0e9e-3508-302f-a7c5-79b038be710d",
                                "text": "„Wir fertigen Kunststoffapparate, aus den Thermoplasten PE, PP und PVC, für verschiedenste Anwendungsbereiche wie z.B. Wasseraufbereitung, Galvanotechnik, Umwelttechnik und Chemikalienlagerung, an. “"
                            },
                            {
                                "example_id": "7ee3d61d-cf96-4b61-979d-2816c8e0d7cd",
                                "sense_id": "70cc0e9e-3508-302f-a7c5-79b038be710d",
                                "text": "„Unsere Aufgabe ist der Vertrieb von Kunststoffapparaten und Sonderkonstruktionen aus GFK (Glasfaser verstärkter Kunststoff); Verbundwerkstoffen, Thermoplasten und alle peripheren Zusatzteile.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
