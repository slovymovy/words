                                        "sense_id": "b62c80a5-846a-3a26-8c26-4599f34af409",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "A garment, usually worn by women, such as a shirt, blouse, or top, with short sleeves or no sleeves, that often fastens in the rear."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c1f3a54-bb73-34a2-a447-5ed4b192be2d",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "A coarse or flimsy coffin; a thin interior coffin enclosed within a more substantial one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa7d74e8-263c-4d9c-8195-b824219f6db7",
                                                "sense_id": "3c1f3a54-bb73-34a2-a447-5ed4b192be2d",
                                                "text": "Upstairs in that chill darkened room which nobody passes who can help it , the old Baronet lies in his coffin shell - an awful form faintly defined beneath the sheet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84282377-e00e-36b9-8873-c23bc056a94b",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "An unmarked vehicle for carrying corpses from a crime scene."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81aff40a-ccbc-4bb3-9a8b-46d8107d1991",
                                                "sense_id": "84282377-e00e-36b9-8873-c23bc056a94b",
                                                "text": "Then they lifted the body into the bag, setting it down like something breakable, zipped the bag, wrapped the whole thing in polythene and carried the stretcher into the shell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c73d8b3-e72b-3df6-8f79-467b70df58bc",
                                        "entry_id": "db2d2542-e931-39d2-a90c-fa996e8417df",
                                        "glosses": [
                                            "A string instrument, as a lyre, whose acoustical chamber is formed like a shell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c5b9c53-d3d1-4473-8a84-6104f3255d47",
                                                "sense_id": "5c73d8b3-e72b-3df6-8f79-467b70df58bc",
                                                "text": "The first lyre may have been made by drawing strings over the underside of a tortoise shell."
                                            },
                                            {
                                                "example_id": "4ca502a5-3918-4dc8-a78f-3ef20a7a7975",
                                                "sense_id": "5c73d8b3-e72b-3df6-8f79-467b70df58bc",
                                                "text": "when Jubal struck the chorded shell"
                                            }
                                        ]
                                    },
