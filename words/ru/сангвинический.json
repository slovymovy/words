                        "меланхолический"
                    ],
                    "common_phrases": [
                        "сангвинический темперамент",
                        "сангвинический тип",
                        "сангвинический характер"
                    ],
                    "target_lang_definitions": {
                        "en": "Characteristic of a sanguine person; characterized by liveliness, easy excitability, and rapid changes of emotion."
                    },
