                ],
                "senses": [
                    {
                        "sense_id": "5936e5b8-0758-3cfb-b59f-e15374b37be7",
                        "entry_id": "cec91792-0381-38f1-8793-d9232044329c",
                        "glosses": [
                            "Kapelle, die von einer Methodistengemeinde genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be9f5fc6-79f2-4234-b6aa-6e968e2308cb",
                                "sense_id": "5936e5b8-0758-3cfb-b59f-e15374b37be7",
                                "text": "„Die Methodistenkapelle von Liestal liegt an der Kasernenstrasse und demnach an der Zufahrtsstrasse zum Städtchen in einem Gebiet, das erst im Laufe des 19. Jahrhunderts überbaut worden ist.“"
                            },
                            {
                                "example_id": "d33fed18-67f1-4377-bea1-ec25b65233f2",
                                "sense_id": "5936e5b8-0758-3cfb-b59f-e15374b37be7",
                                "text": "„Das am 9. Dezember 1973 in seiner heutigen Form eingeweihte Gebäude geht auf eine Methodistenkapelle zurück, die an dieser Stelle seit 1864 bestand.“"
                            },
                            {
                                "example_id": "6eb36d0e-d088-44eb-a59e-a40070a46552",
                                "sense_id": "5936e5b8-0758-3cfb-b59f-e15374b37be7",
                                "text": "„Schließlich fand man gegen Miete Aufnahme in der Methodistenkapelle.“"
                            },
                            {
                                "example_id": "162efa13-80f0-4080-97df-79425b3faa97",
                                "sense_id": "5936e5b8-0758-3cfb-b59f-e15374b37be7",
                                "text": "„Architekt des frühen Heimatstilbaus war der am Technikum Burgdorf seit 1902 als Hauptlehrer tätige Albert Emil Brändli (1876–1949), der 1914 ebenfalls die konzeptionell verwandte Methodistenkapelle an der Bernstrasse in Bümpliz errichtete.“"
                            },
                            {
                                "example_id": "4ed12efc-6171-4669-992f-eebaa3f4d4f3",
                                "sense_id": "5936e5b8-0758-3cfb-b59f-e15374b37be7",
                                "text": "„Am Anfang fanden die Gottesdienste in einer Methodistenkapelle statt, doch bereits am 3. November hielt Pastor Trenkler den ersten Gottesdienst in der restaurierten ehemaligen katholisch-apostolischen Kapelle aus dem Jahre 1916 in der Szkolna-Str. ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
