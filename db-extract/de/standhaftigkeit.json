                "senses": [
                    {
                        "sense_id": "7ba920b5-573a-3982-a334-a4a2575b511f",
                        "entry_id": "d41f55f7-7979-38e4-b55e-c8283d0bf026",
                        "glosses": [
                            "Eigenschaft, standhaft zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ca55166-87a1-4071-8f06-be0d95faf383",
                                "sense_id": "7ba920b5-573a-3982-a334-a4a2575b511f",
                                "text": "„Darauf brachte sie das Gespräch auf den Mut und die Standhaftigkeit des Königs von Preussen, um Boris Gelegenheit zu einer Aeusserung zu geben.“"
                            },
                            {
                                "example_id": "e5415ca1-cf55-4bd5-93b5-d3b50335cbf1",
                                "sense_id": "7ba920b5-573a-3982-a334-a4a2575b511f",
                                "text": "„Er wußte bereits, daß ich einen Ausweisungsbefehl erhalten, und was ich dem Statthalter geantwortet hatte; als er hörte, daß ich auf meinem Entschluß beharrte, mich zu widersetzen, wagte er nicht, meine Standhaftigkeit zu verurteilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
