                                        "tags": [
                                            "colloquial",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4246a770-e3b0-4a4e-9d6d-5eb0e1c1c2a8",
                                                "sense_id": "7a136606-945b-3d23-833d-3efb59ee9470",
                                                "text": "Gestern absolvierte er erfolgreich das Football-Probetraining."
                                            },
                                            {
                                                "example_id": "e2421d63-b2d5-4dbf-9390-8341d2121609",
                                                "sense_id": "7a136606-945b-3d23-833d-3efb59ee9470",
                                                "text": "„Der amerikanische Nationalsport wird schlankweg »Football« genannt, als ob es kein anderes Fußballspiel gäbe, als ob es mit dem Fuß oder mit dem Ball etwas zu tun hätte.“"
                                            },
                                            {
                                                "example_id": "27dd5509-7a9e-41de-aecf-48e58761549d",
                                                "sense_id": "7a136606-945b-3d23-833d-3efb59ee9470",
                                                "text": "„Scott nahm Football sehr ernst und war fast während des gesamten Spiels nüchtern geblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "64ebfce0-fea0-3e7d-9cc3-210a9b96f08d",
                                        "entry_id": "59e16a03-fdc0-3d21-bc7c-b535bf17591f",
                                        "glosses": [
                                            "Ball, der bei einigen Sportarten verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4e59e3b-3f15-4122-9370-b6f89885aade",
                                                "sense_id": "64ebfce0-fea0-3e7d-9cc3-210a9b96f08d",
                                                "text": "Seine Großeltern kauften ihm einen Football in den USA."
