                        "cross_references": []
                    },
                    {
                        "translation_id": "341a1b54-f057-4122-9e3f-9e0de5f4ed2f",
                        "source_entry_id": "5b23af9a-0afc-3f72-aad8-accfdad48b7f",
                        "source_sense_id": "3d771bcd-2226-3c5b-992c-68e324379dcd",
