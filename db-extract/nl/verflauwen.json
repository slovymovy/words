        "nl-extract.jsonl": [
            {
                "entry_id": "8119333b-ecb2-3e51-98fc-7237b4ee9fe9",
                "word": "verflauwen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c5a21f3f-fa3a-348a-92a8-3ff2be46206b",
                        "entry_id": "8119333b-ecb2-3e51-98fc-7237b4ee9fe9",
                        "glosses": [
                            "minder scherp maken met name van bochten in de weg"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fa633a6b-3f8e-32d7-9cc8-4eede0bcc832",
                        "entry_id": "8119333b-ecb2-3e51-98fc-7237b4ee9fe9",
                        "glosses": [
                            "zwakker worden, krachteloos worden, minder levendig worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71252681-7782-46d3-b89e-10bc10a29b6b",
                                "sense_id": "fa633a6b-3f8e-32d7-9cc8-4eede0bcc832",
                                "text": ",,Wij zien er dit jaar vanaf. De discussie is wat aan het verflauwen, iedereen blijft bij zijn eigen standpunten. En Dokkum is voor veel mensen ook gewoon twee uur rijden, hé.”"
                            },
                            {
                                "example_id": "c7551a00-3918-4987-bcc6-21ca027f2ce5",
                                "sense_id": "fa633a6b-3f8e-32d7-9cc8-4eede0bcc832",
                                "text": "Een loopbaan van twintig jaar komt niet voor in de moderne motorsport. Coureurs staan op jonge leeftijd aan de top. Als na hun 30ste de reflexen verflauwen, haken ze af. Niet Valentino Rossi. Hij, begonnen als 16-jarige, valt nog altijd op door zijn scherpe rijstijl."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d04a0bf0-62fa-4cc7-a3a1-1d77b433f7f4",
                        "source_entry_id": "8119333b-ecb2-3e51-98fc-7237b4ee9fe9",
                        "source_sense_id": "c5a21f3f-fa3a-348a-92a8-3ff2be46206b",
                        "target_lang_word": "fase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a30d7abb-d706-4bf9-a193-799255c42198",
                        "source_entry_id": "8119333b-ecb2-3e51-98fc-7237b4ee9fe9",
                        "source_sense_id": "c5a21f3f-fa3a-348a-92a8-3ff2be46206b",
                        "target_lang_word": "weaken",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weaken",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb23acfe-eb29-3806-922a-91dab98e96f4",
                                        "entry_id": "55f03671-1ac4-3a4e-9c22-44bcd3a2bc22",
                                        "glosses": [
                                            "To make weaker or less strong."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d9d6f71-cc16-4970-ad33-6f6044355d7f",
                                                "sense_id": "cb23acfe-eb29-3806-922a-91dab98e96f4",
                                                "text": "weaken a bond"
                                            },
                                            {
                                                "example_id": "444dfced-be3a-4716-a20a-def41cd60ef7",
                                                "sense_id": "cb23acfe-eb29-3806-922a-91dab98e96f4",
                                                "text": "weaken a joint"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                                        "entry_id": "55f03671-1ac4-3a4e-9c22-44bcd3a2bc22",
                                        "glosses": [
                                            "To become weaker or less strong."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c41f92a1-c809-4cde-a132-924f5a1d239b",
                                                "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                                                "text": "Over the years my enthusiasm for the job has weakened."
                                            },
                                            {
                                                "example_id": "bc60c0d1-67b8-4a6b-ae48-17889a3a1b69",
                                                "sense_id": "4decdc16-cfb4-3aff-9e38-48f078c4e5dd",
                                                "text": "My friends, we are confronted with a serious situation. But it is typical of the security problems of the world today. Powerful and aggressive forces are constantly probing, now here, now there, to see whether the free world is weakened. In the face of this, there are no easy choices available. It is misleading for anyone to imply that there are. However, the present situation, though serious, is by no means desperate or hopeless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9954e831-c665-4042-915f-7b9b5de4b76d",
                        "source_entry_id": "8119333b-ecb2-3e51-98fc-7237b4ee9fe9",
                        "source_sense_id": "c5a21f3f-fa3a-348a-92a8-3ff2be46206b",
                        "target_lang_word": "calm down",
                        "target_lang_code": "en",
