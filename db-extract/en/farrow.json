                ],
                "senses": [
                    {
                        "sense_id": "2d3da2f8-90ce-3409-9a7b-c68390c962a3",
                        "entry_id": "81c22e92-0d31-3023-ab17-e47cfa5654bf",
                        "glosses": [
                            "A litter of piglets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64b95451-3a70-4749-935e-b0cbdf8d6957",
                                "sense_id": "2d3da2f8-90ce-3409-9a7b-c68390c962a3",
                                "text": "Aha! I know you, gammer! Hamlet, revenge! The old sow that eats her farrow!"
                            },
                            {
                                "example_id": "b744024b-127d-425a-bf04-8e75ec43a068",
                                "sense_id": "2d3da2f8-90ce-3409-9a7b-c68390c962a3",
                                "text": "At full speed he ran into a pigsty, where a sow was lying on her side with a farrow of eleven tugging at her."
                            },
                            {
                                "example_id": "18dda7f4-0951-4099-b713-fa824cc6cf59",
                                "sense_id": "2d3da2f8-90ce-3409-9a7b-c68390c962a3",
                                "text": "She is the womb and the tomb: the sow that eats her farrow."
                            }
                        ]
                    }
                ],
