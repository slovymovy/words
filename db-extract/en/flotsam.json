                                    {
                                        "sense_id": "7775f281-856f-3b90-9756-b2b0f50237b1",
                                        "entry_id": "4c861536-3fb4-3c14-98bb-aee3cd876c96",
                                        "glosses": [
                                            "drijvend afval op het water"
                                        ],
                                        "tags": [
                                            "waterbeheer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80d52c61-b42b-4f4a-b462-6730b041a8fa",
                                                "sense_id": "7775f281-856f-3b90-9756-b2b0f50237b1",
                                                "text": "⧖Grasbeloopen moeten in voorjaar en zomer door het slechten van mest- en molshoopen, ..., het spoedig verwijderen van veek of vloedmerk en voorwerpen, waaronder het gras zou kunnen verstikken, geregeld worden onderhouden, opdat tegen het najaar overal dicht, vastgeworteld kort gras aanwezig is,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "537a4208-aa41-4b48-a9b6-2b7a2460f101",
                        "source_entry_id": "ecc80a66-18f7-374b-b9a4-1254e6382766",
                        "source_sense_id": "39c8ec86-696e-34bf-929f-fa617ec57bb5",
                        "source_sense_description": "flotsam",
                        "target_lang_word": "épave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a545ebea-dfe6-3ec7-b7ca-762baf0f9e02",
                                        "entry_id": "63f718e1-273f-3f28-a874-1a32b71dcc14",
                                        "glosses": [
                                            "Qui est égaré et dont on ne connaît pas le propriétaire. S’utilise surtout pour les animaux d’élevage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5ecffe-cf85-4674-973e-1d1a924b423a",
                                                "sense_id": "a545ebea-dfe6-3ec7-b7ca-762baf0f9e02",
                                                "text": "Un cheval épave."
                                            },
                                            {
                                                "example_id": "46897782-ffdf-4984-8644-5f3d77215db3",
                                                "sense_id": "a545ebea-dfe6-3ec7-b7ca-762baf0f9e02",
                                                "text": "Des biens épaves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e888e4d-2775-3914-8950-c110ae376ef8",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Objet flottant rejeté par la mer sur la terre ferme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab4732a8-a93c-44f1-9d21-8b3899fbe637",
                                                "sense_id": "6e888e4d-2775-3914-8950-c110ae376ef8",
                                                "text": "Mais une épave, un reste de carcasse, le tronçon d’un mât, une hune brisée, quelques planches, cela résiste, cela surnage, cela ne peut fondre!"
                                            },
                                            {
                                                "example_id": "4f508577-3eee-4388-884a-f1c4b55be932",
                                                "sense_id": "6e888e4d-2775-3914-8950-c110ae376ef8",
                                                "text": "Il est possible que des épaves ou des embarcations aient été drossées à terre, et que des baleiniers survivants aient vécu avec les indigènes il y a cent-cinquante ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "195f20d8-84e4-345b-acb3-65864b0a1e55",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Embarcation qui a sombré."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "999f8a5b-5637-3ede-8ef1-bb1907ada1ab",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Véhicule rendu inutilisable suite à un accident, ou par la corrosion ou le pourrissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849cdad5-a2ae-4d30-a4b8-79f4828b74f5",
                                                "sense_id": "999f8a5b-5637-3ede-8ef1-bb1907ada1ab",
                                                "text": "En théorie il retape ces épaves : passage au marbre, tôlerie, mécanique, toujours réglo ; puis il revend les épaves remises à neuf, enfin, c'est ce qui apparaît au grand jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b959e5e5-c5bc-3f8e-8e42-038a55d524ef",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Débris qui restent après un cataclysme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5eb87296-8fed-316f-aa8b-402fc1037b02",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Personne tombée dans un état de détresse et d'impuissance physique et morale extrême."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf34c04b-6a46-493b-91c6-d32d7c009cac",
                                                "sense_id": "5eb87296-8fed-316f-aa8b-402fc1037b02",
                                                "text": "Je l’avoue honteusement, comme beaucoup d’automobilistes qui passent par là tous les jours, parfois je me dis : « Encore eux. Saouls comme ils l’étaient hier. Des épaves. »"
                                            },
                                            {
                                                "example_id": "286b074c-873c-4c88-bd28-53ab5e77fcb9",
                                                "sense_id": "5eb87296-8fed-316f-aa8b-402fc1037b02",
                                                "text": "Et si tu avais fait ça, Myron, ai-je poursuivi, impitoyable, ma mère ne serait pas devenue une épave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fbe5024-3d48-3abb-adbc-662150b72803",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Ce qui subsiste d’une fortune ruinée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64afc337-fb54-4b63-90bd-dd2ba99846bc",
                                                "sense_id": "0fbe5024-3d48-3abb-adbc-662150b72803",
                                                "text": "Il eut bien de la peine à recueillir quelques épaves de sa fortune."
                                            },
                                            {
                                                "example_id": "f7c9ca12-1104-47b6-ae0e-e0a28de41a12",
                                                "sense_id": "0fbe5024-3d48-3abb-adbc-662150b72803",
                                                "text": "Toute cette fortune est perdue ; il sera bien heureux s’il en recueille quelques épaves."
                                            },
                                            {
                                                "example_id": "446e1e8e-ec95-4d23-97b0-87384b832dcf",
                                                "sense_id": "0fbe5024-3d48-3abb-adbc-662150b72803",
                                                "text": "Aurélien, Dioclétien, Maxence font exception ; de ceux-là il reste des monuments et des monuments considérables, épaves de ce grand naufrage de l’empire romain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0f108d4-cd9c-337b-949a-e8b17368a8eb",
                                        "entry_id": "56c60859-b36c-3d9a-be72-d2fd75fa1755",
                                        "glosses": [
                                            "Chose perdue et non réclamée dont la propriété revient à l’État."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab1fc47-6b0c-448d-a9ff-e8f69bd70ca5",
                                                "sense_id": "d0f108d4-cd9c-337b-949a-e8b17368a8eb",
                                                "text": "Les animaux à pied fourchu appartiennent au pacha dans les épaves."
                                            },
                                            {
                                                "example_id": "32cf685b-1fdf-4efa-badb-5f62746deaac",
                                                "sense_id": "d0f108d4-cd9c-337b-949a-e8b17368a8eb",
                                                "text": "— Dans ce document, il n'est même pas fait mention de bois mort et de mort-bois, tellement ces épaves appartenaient de droit aux pauvres gens, comme espèce de part à Dieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38863cc8-e2d9-4e59-b954-053900788b52",
                        "source_entry_id": "ecc80a66-18f7-374b-b9a4-1254e6382766",
                        "source_sense_id": "39c8ec86-696e-34bf-929f-fa617ec57bb5",
                        "source_sense_description": "flotsam",
                        "target_lang_word": "débris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Reste d’une chose brisée ou en partie détruite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6e26bf7-ffcc-410b-b960-a945072012c4",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Jean Donnard et Pierre Kerhuon embarquaient les filets dans la chaloupe, amarrée au quai, près de la cale qu’ensanglantaient des débris de poissons fraîchement éventrés."
                                            },
                                            {
                                                "example_id": "f945e94b-3b21-4798-a147-cdc4b405d264",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Si l'on écrase entre deux pierres des grains de blé, l'enveloppe corticale de chaque grain est brisée, et les débris, qui portent le nom de son, se mêlent à la farine provenant de la trituration de la partie intérieure."
                                            },
                                            {
                                                "example_id": "d8dddf08-0176-4803-a9fd-3f6b129ef3b1",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Ce qui m’émerveillait le plus dans les premiers temps, c'était l’étonnante habileté de nos poneys à se tirer d'affaire au milieu d'un chaos de débris volcaniques où un piéton aurait pu difficilement trouver son chemin."
                                            },
                                            {
                                                "example_id": "0b5c0b2f-7245-4667-be59-e998fba24b38",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "D'énormes blocs de corail éblouissants de blancheur sortaient de l'eau et semblaient les débris d'une gigantesque convulsion."
                                            },
                                            {
                                                "example_id": "f70f4fb0-980b-49c8-9eb9-a2793bae9b96",
                                                "sense_id": "681a232c-2a29-31bf-87f0-aab5b644a94c",
                                                "text": "Après un certains laps de temps, les femmes brûlent les défrichements au feu courant. Ensuite elles ramassent les débris et les réincinèrent en petits tas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a88768e-b87c-31ce-880d-06a9fd44b285",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Reste d’une chose brisée ou en partie détruite.",
                                            "Les restes d'un repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ee565c-30a4-42c2-a4dd-82dc377b28f3",
                                                "sense_id": "9a88768e-b87c-31ce-880d-06a9fd44b285",
                                                "text": "Les débris d’un souper, les débris d’un pâté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cadae8a-e325-3481-9ebe-401bcc2b7583",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Reste d’une chose brisée ou en partie détruite.",
                                            "Ce qui reste d’une chose après sa ruine, sa destruction, son abolition ; bien qui reste à quelqu’un après un revers de fortune ; troupes qui restent après la défaite d’une armée, d’un corps, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d8650d-5f9e-48b6-a01e-140c46772ecb",
                                                "sense_id": "1cadae8a-e325-3481-9ebe-401bcc2b7583",
                                                "text": "Après une journée pendant laquelle j'avais écouté avec terreur le bruit du canon qui se rapprochait incessamment, je vis arriver mon père avec une centaine de cavaliers, débris de trois mille hommes qu'il commandait."
                                            },
                                            {
                                                "example_id": "6c381868-09d2-42b5-ba42-4c091e002877",
                                                "sense_id": "1cadae8a-e325-3481-9ebe-401bcc2b7583",
                                                "text": "Dans les débris de mon opulence se trouvait une somme assez forte en titres étrangers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03ec0f33-83d2-391f-bfb9-c4e45619efaa",
                                        "entry_id": "33b03177-a519-34bb-b015-df4e523e9fed",
                                        "glosses": [
                                            "Personne physiquement débile."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1eb62cd9-883f-41c2-915c-1701d11e8adc",
                        "source_entry_id": "ecc80a66-18f7-374b-b9a4-1254e6382766",
