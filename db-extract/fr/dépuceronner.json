                "senses": [
                    {
                        "sense_id": "2dbe34b6-8390-3342-a90c-1bd9a0608d3a",
                        "entry_id": "19ae407a-7272-3002-bfb2-92b6b6b71f81",
                        "glosses": [
                            "Débarrasser des pucerons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75073dc1-4f23-4032-b30e-d15696c10c4c",
                                "sense_id": "2dbe34b6-8390-3342-a90c-1bd9a0608d3a",
                                "text": "Et dire qu'il faut parfois acheter des larves de coccinelles pour \"dépuceronner\" (oui, j'ai employé le bon mot) les rosiers…"
                            },
                            {
                                "example_id": "51634aba-abab-4c7a-91c2-903d3ca2f5f2",
                                "sense_id": "2dbe34b6-8390-3342-a90c-1bd9a0608d3a",
                                "text": "Soso, c'est peut être un bon moyen pour dépuceronner le jardin, mais toi comment on va te dépuceronner ?"
                            },
                            {
                                "example_id": "6cf47def-4104-453c-8da8-f09d3991c676",
                                "sense_id": "2dbe34b6-8390-3342-a90c-1bd9a0608d3a",
                                "text": "Mais le rappeur est-il de nature à se laisser dépuceronner la cervelle par un raisonnement, par de petites granules roses Wittgenstein ?"
                            }
                        ]
                    }
