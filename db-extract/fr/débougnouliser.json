                ],
                "senses": [
                    {
                        "sense_id": "c3f2c406-0649-3015-8c54-1c714c3a199c",
                        "entry_id": "2953c942-3aa7-3a33-8dd4-543d66b676c4",
                        "glosses": [
                            "Faire perdre son caractère de bougnoule à."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "1e7c1f9f-db2e-40e6-8792-0c7f80061f03",
                                "sense_id": "c3f2c406-0649-3015-8c54-1c714c3a199c",
                                "text": "François Mauriac après avoir été progressiste est devenu maintenant « gâteux » et il faut tirer le cordeau, c’est-à-dire « débougnouliser » les bougnouls qui sont récupérables pour une France de demain, très « yeux bleus et cheveux blonds », et ensuite réexpédier par le prochain courrier les inassimilables, quittes à prendre de nouveaux « bougnouls », là où ils ne coûtent pas cher et sous un contrat tel qu’ils ne mettent pas en danger le fameux équilibre de la nation française."
                            },
                            {
                                "example_id": "a7920056-306b-4145-bac4-98a7e3b28f76",
                                "sense_id": "c3f2c406-0649-3015-8c54-1c714c3a199c",
                                "text": "Ouaip, pour vous débougnouliser, abandonnez les hadiths !"
                            }
                        ]
                    },
                    {
                        "sense_id": "cff7a81b-e401-34df-9e6e-84a86ba410df",
                        "entry_id": "2953c942-3aa7-3a33-8dd4-543d66b676c4",
                        "glosses": [
                            "Éliminer les bougnoules."
                        ],
                        "tags": [
                            "offensive",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "56529d85-79da-48cd-a284-87da8bb71a83",
                                "sense_id": "cff7a81b-e401-34df-9e6e-84a86ba410df",
                                "text": "Elle voulait dédiaboliser et je voulais débougnouliser."
                            }
                        ]
                    }
                ],
