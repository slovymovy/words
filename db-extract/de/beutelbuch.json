                "senses": [
                    {
                        "sense_id": "2a456297-b372-30fe-8486-f89b32c5e178",
                        "entry_id": "5daa6c1c-8f93-3e00-becf-41cbbcfbcdd6",
                        "glosses": [
                            "Buch mit einem verlängerten Einband, den man verschnüren kann, so dass das Buch geschützt ist und leicht mitgenommen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef16f2c-0eb7-480f-93af-a67053eb259e",
                                "sense_id": "2a456297-b372-30fe-8486-f89b32c5e178",
                                "text": "„Die Bezeichnung „Beutelbuch“ wäre passender, ist aber weniger gebräuchlich.“"
                            },
                            {
                                "example_id": "3c715613-2099-4629-b385-b4c810140163",
                                "sense_id": "2a456297-b372-30fe-8486-f89b32c5e178",
                                "text": "„Bei einem Beutelbuch ist das Material der Einbanddecke am unteren Schnitt nicht wie bei anderen Büchern über die Kante des Holzdeckels gezogen und innen angeklebt, sondern es ist beträchtlich verlängert, so daß man es fassen und das Buch daran in der Hand tragen oder das Ende unter den Gürtel schieben konnte.“"
                            },
                            {
                                "example_id": "bb109538-70ca-42e2-b469-e73ee6c37c83",
                                "sense_id": "2a456297-b372-30fe-8486-f89b32c5e178",
                                "text": "„Eine erste großangelegte Auflistung aller bekannten Darstellungen von Beutelbüchern in der bildenden Kunst erschien 1966.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
