                                    {
                                        "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                        "entry_id": "0ec643ba-fa70-3a52-936e-efad6b936f48",
                                        "glosses": [
                                            "Interjection dont on se sert pour avertir ou ordonner de faire silence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e61d2a30-6678-4682-866e-f6fc01be4946",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "Chut ! quelqu’un vient."
                                            },
                                            {
                                                "example_id": "6870f6cb-e76d-440a-9900-c8204106269d",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "Chut ! ça ne te regarde pas !"
                                            },
                                            {
                                                "example_id": "cbc4c399-7aa7-45b8-aa26-60bfbbed022d",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "Chut ! c’est la surprise ! pas un mot !"
                                            },
                                            {
                                                "example_id": "2946acd5-bee0-4069-ab99-a53527a7919e",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "Chut ! Frédéric Larsan qui travaille !… Ne le dérangeons pas !"
                                            },
                                            {
                                                "example_id": "b22325cd-c3b4-4e6a-b080-35336253fae3",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "— Mam’zelles ! Mam’zelles !\nDe toute la force de ses poumons, Ernestine, qui ne connaît pas les usages du monde, appelle ses maîtresses.\nQuatre «chut ! » lui ordonnent de baisser la voix."
                                            },
                                            {
                                                "example_id": "ad30eb44-6d79-462a-b280-79e6763e4aad",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "L’autre […] fait chut avec un doigt sur la bouche."
                                            },
                                            {
                                                "example_id": "34f3b8a1-90db-4998-9b7d-fbab7e261d25",
                                                "sense_id": "7c48b354-85d5-33c5-86ed-1cd8c0b48724",
                                                "text": "C’était une alternance de baisers, de murmures et de ricanements que combattait de temps à autre, venus de la salle, une vague de “chut” indignés. Les “chut” furent soudain couverts par les sirènes d’alarme dans la rue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chut",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "407fb771-2958-341d-977b-2ee8d77f4b3a",
                                        "entry_id": "71a8c348-1464-3845-ae27-eb84fd6576d6",
