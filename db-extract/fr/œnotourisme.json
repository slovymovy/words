                "senses": [
                    {
                        "sense_id": "7879a41c-8305-3d97-afd4-a58653a73282",
                        "entry_id": "bb60f0b1-f7f2-3376-b1d4-bd665d4be5ef",
                        "glosses": [
                            "Tourisme vitivinicole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e1dba0c-ae5a-44c7-88dc-b94ffb5080b2",
                                "sense_id": "7879a41c-8305-3d97-afd4-a58653a73282",
                                "text": "Le tourisme gastronomique et l’œnotourisme sont aussi suivis de près Rue de Valois."
                            },
                            {
                                "example_id": "5ef4db74-0aa9-4010-9ea2-e13ef1cc9ce9",
                                "sense_id": "7879a41c-8305-3d97-afd4-a58653a73282",
                                "text": "Les autres vignobles se sont intéressés à l’œnotourisme voilà seulement quelques années, afin de sécuriser et diversifier leurs activités, car la crise mondiale, les aléas climatiques et la guerre des cépages étrangers ont eu raison de nombreuses exploitations."
                            },
                            {
                                "example_id": "72befa5a-575f-4b89-bcd1-b2a95a366844",
                                "sense_id": "7879a41c-8305-3d97-afd4-a58653a73282",
                                "text": "De nombreux producteurs ont compris les avantages de l’œnotourisme et organisent des visites originales pour faire découvrir leur activité viticole."
                            }
                        ]
                    }
                ],
