                "senses": [
                    {
                        "sense_id": "d8887420-a2a5-3a21-ad02-64281ad7e58d",
                        "entry_id": "009870ef-3d7a-379c-892b-794fc187b939",
                        "glosses": [
                            "Rendre hydraulique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88468b3a-1927-4c35-b4da-67ca7c9356bd",
                                "sense_id": "d8887420-a2a5-3a21-ad02-64281ad7e58d",
                                "text": "Je souhaite hydrauliser un guindeau (treuil pour remonter l'ancre) sur un bateau de 20 mètres."
                            },
                            {
                                "example_id": "57179a39-2ca5-41db-97c9-4ed3e4083f40",
                                "sense_id": "d8887420-a2a5-3a21-ad02-64281ad7e58d",
                                "text": "Et je pense que ça doit être un sacré boulot d'\"hydrauliser\" une cab en capote manuelle..."
                            }
                        ]
                    },
                    {
                        "sense_id": "20beafb1-f90a-33bd-b392-1a61b6baa9aa",
                        "entry_id": "009870ef-3d7a-379c-892b-794fc187b939",
                        "glosses": [
                            "Hydrolyser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deb5b11a-f670-4edf-8441-e3ea06530c68",
                                "sense_id": "20beafb1-f90a-33bd-b392-1a61b6baa9aa",
                                "text": "D’après lui, dans les argiles très-grasses, la plus grande partie de la silice est à l’état d’acide silicique, pouvant hydrauliser une grande quantité de chaux;"
                            },
                            {
                                "example_id": "2524cb02-0fbf-40c4-955b-e8dc02a23daa",
                                "sense_id": "20beafb1-f90a-33bd-b392-1a61b6baa9aa",
                                "text": "Nous ne croyons pas qu’il en soit ainsi : bien qu’il faille une assez forte chaleur pour rompre l’union des substances actives, il en faut une bien plus forte pour hydrauliser la silice"
                            }
                        ]
                    }
                ],
