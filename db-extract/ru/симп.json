                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fd50aee-6533-33c9-9228-dc72c405d3f5",
                                        "entry_id": "5d0a9fdb-d21b-349e-b78e-7cede76cc24a",
                                        "glosses": [
                                            "To reminisce melancholically; to recall once fond memories now tinged with sadness, especially regarding a former lover."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e60e42e6-ad4f-4bb7-9dc9-6bc0e7720171",
                                                "sense_id": "0fd50aee-6533-33c9-9228-dc72c405d3f5",
                                                "text": "2018, mimi (@splendamami), Tweet.\nthe dick can't be that good honey stop simping over that boy"
