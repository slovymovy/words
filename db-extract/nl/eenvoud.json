                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6bf4bbf4-3909-302d-b960-5b14e4f77026",
                        "entry_id": "c71d067f-90cb-3a41-936f-e600223431d0",
                        "glosses": [
                            "afwezigheid van pracht en praal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "910ea85b-7b20-4203-ad96-0df81f761803",
                                "sense_id": "6bf4bbf4-3909-302d-b960-5b14e4f77026",
                                "text": "mooi in al zijn eenvoud"
                            }
                        ]
                    },
                    {
                        "sense_id": "6a298800-3534-30d8-9ee8-8ee2c983a1e7",
                        "entry_id": "c71d067f-90cb-3a41-936f-e600223431d0",
                        "glosses": [
                            "dat iets niet ingewikkeld of complex is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51547ce0-597d-4e0f-a6af-80f895dfeec6",
                                "sense_id": "6a298800-3534-30d8-9ee8-8ee2c983a1e7",
                                "text": "Eenvoud is een kenmerk van het ware."
                            },
                            {
                                "example_id": "fbb807dc-cf11-4750-9409-373912097d6b",
                                "sense_id": "6a298800-3534-30d8-9ee8-8ee2c983a1e7",
                                "text": "Het was prachtig en overweldigend geweest in de bergen maar ik verlangde naar de eenvoud en openheid van de woestijnheuvels van Noord-Californië die nu voor me lagen. Ik was lang genoeg uit mijn comfortzone geweest en verlangde naar de comfortzone die voor me lag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04b2f86e-469f-4dc8-8bd6-358c0bb1f14d",
                        "source_entry_id": "c71d067f-90cb-3a41-936f-e600223431d0",
                        "source_sense_id": "6bf4bbf4-3909-302d-b960-5b14e4f77026",
                        "source_sense_description": "afwezigheid van pracht en praal",
                        "target_lang_word": "Einfachheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einfachheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fae33c35-642a-3cd4-9f7c-bc3c8d1c9dfb",
                                        "entry_id": "1091aada-bba1-3d74-9687-41bc3201bf42",
                                        "glosses": [
                                            "die Eigenschaft, einfach zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a2a822-d96a-46e4-b9ac-0e64d94eb6a3",
                                                "sense_id": "fae33c35-642a-3cd4-9f7c-bc3c8d1c9dfb",
                                                "text": "Die Einfachheit der Prüfung war überraschend."
                                            },
                                            {
                                                "example_id": "cc50755c-2cfa-48d4-9b60-4744c7ebfedc",
                                                "sense_id": "fae33c35-642a-3cd4-9f7c-bc3c8d1c9dfb",
                                                "text": "„Die Einfachheit der Wortwahl dieses Gedichts täuscht leicht darüber hinweg, mit welcher Meisterschaft Busch in diesen Versen ein Thema behandelte, das ihn mit zunehmenden Jahren beschäftigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afb63f34-1b5f-4c5c-9225-97c3cc71ed80",
                        "source_entry_id": "c71d067f-90cb-3a41-936f-e600223431d0",
                        "source_sense_id": "6bf4bbf4-3909-302d-b960-5b14e4f77026",
                        "source_sense_description": "afwezigheid van pracht en praal",
                        "target_lang_word": "simplicity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simplicity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38a8de42-d21a-383a-ab40-5b53396d07d3",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "The quality or state of being unmixed or uncompounded"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdd8e06a-36eb-4db5-813f-131107a32821",
                                                "sense_id": "38a8de42-d21a-383a-ab40-5b53396d07d3",
                                                "text": "the simplicity of metals or of earths"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6aba2e3-d5ae-3696-ab69-96c7daaed06d",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "The quality or state of being not complex, or of consisting of few parts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2231a62d-a327-4a83-a737-7b44fbc9b177",
                                                "sense_id": "c6aba2e3-d5ae-3696-ab69-96c7daaed06d",
                                                "text": "the simplicity of a machine"
                                            },
                                            {
                                                "example_id": "d40ea879-3a5f-4f08-863e-331a2ca57129",
                                                "sense_id": "c6aba2e3-d5ae-3696-ab69-96c7daaed06d",
                                                "text": "2. Simplicity, with the least number of working parts, all readily visible and accessible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66a1472f-1dfd-3867-ab5d-4d148ba4c302",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "Lack of sharpness of mind; lack of ability to think using complex ideas; stupidity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b0d43ca-cabf-30ba-a2bc-b61e6178db32",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "Lack of artificial ornament, pretentious style, or luxury; plainness"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70974e6c-2f8a-4f3e-8778-b7db2ebe9a4f",
                                                "sense_id": "8b0d43ca-cabf-30ba-a2bc-b61e6178db32",
                                                "text": "simplicity of dress, of style, or of language"
                                            },
                                            {
                                                "example_id": "2b62ee5c-2664-42dd-949e-a576476c9d51",
                                                "sense_id": "8b0d43ca-cabf-30ba-a2bc-b61e6178db32",
                                                "text": "simplicity of diet"
                                            },
                                            {
                                                "example_id": "982b530f-2610-4c2a-beca-af88c49696c8",
                                                "sense_id": "8b0d43ca-cabf-30ba-a2bc-b61e6178db32",
                                                "text": "simplicity of life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea433ff0-ef03-3af0-bd73-bd5a2341b306",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "Lack of subtlety or abstruseness; clarity"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c56e8733-6e46-447d-b602-c9377fcb55ff",
                                                "sense_id": "ea433ff0-ef03-3af0-bd73-bd5a2341b306",
                                                "text": "the simplicity of a doctrine"
                                            },
                                            {
                                                "example_id": "e0351695-3bfb-4ec0-8d50-6ee399e018af",
                                                "sense_id": "ea433ff0-ef03-3af0-bd73-bd5a2341b306",
                                                "text": "the simplicity of an explanation or a demonstration"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3b37591-091b-3173-9fbc-7bc6b9f05906",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "The state or quality of being simple",
                                            "Lack of complication; efficiency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0984aaec-e8f6-441d-8633-30c53a351ec8",
                                                "sense_id": "c3b37591-091b-3173-9fbc-7bc6b9f05906",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1885c144-8a26-3d95-809a-553d6fe9ff27",
                                        "entry_id": "f6e4608c-47cd-3ff7-a116-a5972f8db70d",
                                        "glosses": [
                                            "An act or instance of foolishness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871e979b-89d1-48df-b001-c4776d184321",
                                                "sense_id": "1885c144-8a26-3d95-809a-553d6fe9ff27",
                                                "text": "speaking of the great simplicity we commit, in leaving yong children under the government and charge of their fathers and parents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25ce4620-1ada-4d42-aa0a-28796e5a6765",
                        "source_entry_id": "c71d067f-90cb-3a41-936f-e600223431d0",
                        "source_sense_id": "6bf4bbf4-3909-302d-b960-5b14e4f77026",
                        "source_sense_description": "afwezigheid van pracht en praal",
                        "target_lang_word": "simplicité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simplicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48440acc-6c91-3405-bae8-2587245efbdb",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Qualité de ce qui n’est pas composé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543f069e-38fe-4a36-b62e-23a02cb94e27",
                                                "sense_id": "48440acc-6c91-3405-bae8-2587245efbdb",
                                                "text": "Le lendemain, j’ai vu la chambre dans la simplicité de la lumière du jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a71f43-a819-3c02-a011-05c997b66536",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Caractère de ce qui n’est pas compliqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d3b6040-1f13-4e81-b72c-814dcc5790c7",
                                                "sense_id": "37a71f43-a819-3c02-a011-05c997b66536",
                                                "text": "Le mécanisme de ce cylindre, quoique de la dernière simplicité, ne fut d'abord que très-embrouillé dans ma tête; mais, en attendant que mes premières idées se nettoyassent, je fus si aise de les avoir eues, que j'en tressaillis, […]."
                                            },
                                            {
                                                "example_id": "b5466bc1-a1c5-438f-b522-e9c4ee82b520",
                                                "sense_id": "37a71f43-a819-3c02-a011-05c997b66536",
                                                "text": "Quels termes saurai-je trouver, suffisamment simples dans leur sublimité, — suffisamment sublimes dans leur simplicité, — pour la simple énonciation de mon thème ?"
                                            },
                                            {
                                                "example_id": "58aa93c5-0aab-42b2-8983-4a356cbec685",
                                                "sense_id": "37a71f43-a819-3c02-a011-05c997b66536",
                                                "text": "Même s’ils en font rêver plus d’un, tout le monde n’investit pas des tracteurs high-tech. À tous ceux qui recherchent la simplicité et l’efficacité avant tout, cet essai est fait pour vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f112eee-cc45-317e-a5b4-cf6eec2acbe7",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Caractère de ce qui est sans apprêt, sans recherche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06f1ecf-1b1e-4f73-ab8d-1e6d261697d2",
                                                "sense_id": "1f112eee-cc45-317e-a5b4-cf6eec2acbe7",
                                                "text": "Il est d’une grande simplicité dans ses vêtements, dans ses manières, dans son langage."
                                            },
                                            {
                                                "example_id": "5819cdd9-d672-417a-8c4a-46d6ae134118",
                                                "sense_id": "1f112eee-cc45-317e-a5b4-cf6eec2acbe7",
                                                "text": "Cet écrivain a une grande simplicité de style."
                                            },
                                            {
                                                "example_id": "723a11f8-5dcc-4da7-8e8d-35564f4096fb",
                                                "sense_id": "1f112eee-cc45-317e-a5b4-cf6eec2acbe7",
                                                "text": "D'ailleurs, j'aime rappeler que la simplicité n'est nullement absence de profondeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Qualité de ce qui est sans détours, sans déguisement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbee7f22-9a16-4bb7-8778-74b43a0b88ca",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "Pendant un moment, la morgue germanique lutta en lui avec la simplicité anglaise, et aussi avec sa bienveillance naturelle et sa loquacité, et elle eut le dessous."
                                            },
                                            {
                                                "example_id": "15d29628-0ada-4d50-bb4e-c174dd9aec9e",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "La simplicité d’un enfant."
                                            },
                                            {
                                                "example_id": "e1c77d9c-8045-42ee-938e-9173ca876e15",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "Simplicité de cœur."
                                            },
                                            {
                                                "example_id": "9925e14d-2e8d-4e78-8595-61d7bc9afac2",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "Aimable simplicité."
                                            },
                                            {
                                                "example_id": "39b3541b-a7d6-4e47-b7b2-ab85128f0e84",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "La simplicité a deux sœurs : la grâce et la dignité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a941a0fa-6759-383f-ae7f-281edbea2876",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Naïveté, trop grande facilité à croire, à se laisser tromper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a19e09f-d971-4290-ab41-c5acbcb4ab03",
                                                "sense_id": "a941a0fa-6759-383f-ae7f-281edbea2876",
                                                "text": "Je ne vis jamais une si grande simplicité."
                                            },
                                            {
                                                "example_id": "51af5216-dacc-4751-ab77-75d563b31b82",
                                                "sense_id": "a941a0fa-6759-383f-ae7f-281edbea2876",
                                                "text": "C’est une grande simplicité de croire cela."
                                            },
                                            {
                                                "example_id": "1b4abbb6-e5ba-4ef7-8ecb-164ede338496",
                                                "sense_id": "a941a0fa-6759-383f-ae7f-281edbea2876",
                                                "text": "Il y a de la simplicité dans son cas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
