{
    "word_family": [
        "immerse",
        "immersed",
        "immersing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "383014fb-e780-3b1f-a011-472ec2a3fbc7",
                    "sense_definition": "Deep engagement or involvement in an activity or subject.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book offers a total <w>immersion</w> into the complex history of the region.",
                            "target_lang_translations": {
                                "zh": "这本书让人完全<w>沉浸</w>在该地区复杂的历史中。"
                            }
                        },
                        {
                            "text": "Achieving fluency requires complete <w>immersion</w> in the target language environment.",
                            "target_lang_translations": {
                                "zh": "要达到流利程度，需要完全<w>沉浸</w>在目标语言环境中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "involvement",
                        "absorption"
                    ],
                    "common_phrases": [
                        "total immersion"
                    ],
                    "target_lang_definitions": {
                        "zh": "指全身心投入到某项活动或领域中。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沉浸",
                                "target_lang_sense_clarification": "指完全投入到某种状态或环境中。"
                            },
                            {
                                "target_lang_word": "专注",
                                "target_lang_sense_clarification": "指精神高度集中于某事。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53cc5463-5d0a-37e9-bb51-59874ed6c606",
                    "sense_definition": "A method of language teaching where students learn subjects through the target language.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school offers a bilingual <w>immersion</w> program for young students.",
                            "target_lang_translations": {
                                "zh": "学校为低年级学生提供双语<w>沉浸式教学</w>项目。"
                            }
                        },
                        {
                            "text": "Students in the <w>immersion</w> class learn science and math in French.",
                            "target_lang_translations": {
                                "zh": "参加<w>沉浸式教学</w>班的学生用法语学习科学和数学。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "immersion program"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种语言教学法，学生通过目标语言学习各门学科。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沉浸式教学",
                                "target_lang_sense_clarification": "指将学生置于目标语言环境中进行教学的方法。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07bba890-7edd-3d99-acff-23bb19606450",
                    "sense_definition": "The experience of losing oneself in a fictional world while reading or playing games.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game provides deep <w>immersion</w> through its realistic graphics and sound.",
                            "target_lang_translations": {
                                "zh": "这款游戏凭借逼真的画面和音效提供了极强的<w>代入感</w>。"
                            }
                        },
                        {
                            "text": "Good storytelling is essential for player <w>immersion</w> in virtual reality.",
                            "target_lang_translations": {
                                "zh": "优秀的叙事对于虚拟现实中的玩家<w>沉浸感</w>至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "engagement"
                    ],
                    "target_lang_definitions": {
                        "zh": "在阅读或玩游戏时，完全沉浸在虚构世界中的体验。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "代入感",
                                "target_lang_sense_clarification": "指在游戏或故事中感受到的身临其境的体验。"
                            },
                            {
                                "target_lang_word": "沉浸感",
                                "target_lang_sense_clarification": "指被环境或内容完全吸引的心理状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a2cd594-5910-3184-8a56-77446433444a",
                    "sense_definition": "The act of submerging something or someone completely in a liquid.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ritual involves the full <w>immersion</w> of the person in water.",
                            "target_lang_translations": {
                                "zh": "仪式包括将人完全<w>浸没</w>在水中。"
                            }
                        },
                        {
                            "text": "Brief <w>immersion</w> in cold water can help soothe sore muscles.",
                            "target_lang_translations": {
                                "zh": "在冷水中短暂<w>浸泡</w>有助于缓解肌肉酸痛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "submersion"
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物或某人完全浸入液体中的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "浸没",
                                "target_lang_sense_clarification": "指完全没入液体中。"
                            },
                            {
                                "target_lang_word": "浸泡",
                                "target_lang_sense_clarification": "指长时间置于液体中。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18bb3421-94fe-3852-a73b-d2f3da3a993a",
                    "sense_definition": "An electric heating element used to heat water in a tank.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Remember to turn off the <w>immersion</w> after the water is hot.",
                            "target_lang_translations": {
                                "zh": "水热了之后记得关掉<w>浸入式加热器</w>。"
                            }
                        },
                        {
                            "text": "The <w>immersion</w> heater is broken and needs to be replaced.",
                            "target_lang_translations": {
                                "zh": "<w>浸入式加热器</w>坏了，需要更换。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "immersion heater"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于加热水箱中水的电加热元件。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "浸入式加热器",
                                "target_lang_sense_clarification": "指直接放入水中加热的设备。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "604c6597-885b-31de-9e03-ea43ed50342b",
                    "sense_definition": "The disappearance of a celestial body behind another or into a shadow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers observed the <w>immersion</w> of the star behind the moon.",
                            "target_lang_translations": {
                                "zh": "天文学家观测到了恒星在月球背后的<w>掩食</w>现象。"
                            }
                        },
                        {
                            "text": "The <w>immersion</w> into the shadow marks the start of the eclipse.",
                            "target_lang_translations": {
                                "zh": "进入阴影的<w>掩食</w>过程标志着日食或月食的开始。"
                            }
                        }
                    ],
                    "antonyms": [
                        "emersion"
                    ],
                    "target_lang_definitions": {
                        "zh": "天体消失在另一个天体背后或进入阴影中。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "掩食",
                                "target_lang_sense_clarification": "指天体被遮挡或进入阴影的过程。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5448fbdc-56b9-3a63-8248-8c17a018fe8a",
                    "sense_definition": "A mathematical map whose differential is everywhere injective.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The function is a smooth <w>immersion</w> between the two manifolds.",
                            "target_lang_translations": {
                                "zh": "该函数是两个流形之间的光滑<w>浸入</w>。"
                            }
                        },
                        {
                            "text": "Every embedding is an <w>immersion</w>, but the reverse is not always true.",
                            "target_lang_translations": {
                                "zh": "每一个嵌入都是一个<w>浸入</w>，但反之则不一定成立。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "微分处处为单射的数学映射。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "浸入",
                                "target_lang_sense_clarification": "微分几何中的术语。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d5a4ab4-7448-3aaf-9369-ebdfbb1921c3",
                    "sense_definition": "A specific creative relationship with the environment practiced by a particular group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist explores the concept of <w>immersion</w> in the local urban landscape.",
                            "target_lang_translations": {
                                "zh": "这位艺术家探索了在当地城市景观中进行<w>沉浸</w>的概念。"
                            }
                        },
                        {
                            "text": "Their work is defined by a deep <w>immersion</w> in ecological themes.",
                            "target_lang_translations": {
                                "zh": "他们的作品以对生态主题的深度<w>沉浸</w>为特征。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "特定群体实践的一种与环境的特定创造性关系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "沉浸",
                                "target_lang_sense_clarification": "指艺术创作中与环境深度融合的状态。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}