                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1ec4de1-7915-40c3-bcf7-8b72f44277b2",
                        "source_entry_id": "f7e7b7de-ae93-3dc8-9f0b-5aa65e2182b6",
                        "source_sense_id": "531cb391-4b8d-35da-800b-e3253245d4c3",
                        "source_sense_description": "птица",
                        "target_lang_word": "Eisvogel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eisvogel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de823cd4-3775-361c-a892-ded72ec02448",
                                        "entry_id": "5fc9b978-49c8-3090-be9b-07e6f01af994",
                                        "glosses": [
                                            "leuchtend gefärbter, fischfressender Vogel (Alcedo, besonders A. atthis)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53d013cc-794e-434c-9128-1a7f388415f5",
                                                "sense_id": "de823cd4-3775-361c-a892-ded72ec02448",
                                                "text": "Die großen Verluste, die der Eisvogel in harten Wintern erleidet, sind schnell wieder ausgeglichen."
                                            },
                                            {
                                                "example_id": "0ef23a5f-cd33-4f57-b49a-9f171f9f5bb0",
                                                "sense_id": "de823cd4-3775-361c-a892-ded72ec02448",
                                                "text": "„Ein Eisvogel schoss ins Wasser und kämpfte sich mit seinem zappelnden Fang in die Luft.“"
                                            },
                                            {
                                                "example_id": "046c1cfa-9550-44ed-a6e5-6ca173c4ad02",
                                                "sense_id": "de823cd4-3775-361c-a892-ded72ec02448",
                                                "text": "„Harbert fing auch eine ganze Reihe anderer Vögel ein, Pelikane, Alectorpärchen, Eisvögel und Bläßhühner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c96cd6ae-e9f4-3231-aef4-3a4dc4e0b359",
                                        "entry_id": "5fc9b978-49c8-3090-be9b-07e6f01af994",
                                        "glosses": [
                                            "Vertreter der übergeordneten Familie Alcedinidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7cf08c8-eb59-423d-9cf0-9dde4103e7c1",
                                                "sense_id": "c96cd6ae-e9f4-3231-aef4-3a4dc4e0b359",
                                                "text": "Der Jägerliest oder Lachende Hans, der Kookaburra der Australier, gehört zu den Eisvögeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c98610b1-de7b-321f-8510-47a93766f4e0",
                                        "entry_id": "5fc9b978-49c8-3090-be9b-07e6f01af994",
                                        "glosses": [
                                            "ein Tagfalter (Gattung Limenitis)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be1e656-9708-4028-8e1f-a50ce7926147",
                                                "sense_id": "c98610b1-de7b-321f-8510-47a93766f4e0",
                                                "text": "Hier kommen sowohl Großer als auch Kleiner Eisvogel vor."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
