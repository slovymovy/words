                        "examples": [
                            {
                                "example_id": "2d810375-6040-411e-8353-6aea255d11e7",
                                "sense_id": "9818e3f4-7279-33d6-8c8d-799396a94415",
                                "text": "Deux chercheuses américaines spécialisées en microbiologie ont publié des travaux prometteurs sur l’intérêt de la mucine, une protéine contenue dans la morve."
                            },
                            {
                                "example_id": "f837e132-ffa4-4b50-8f51-295eea3ce1fa",
                                "sense_id": "9818e3f4-7279-33d6-8c8d-799396a94415",
                                "text": "Les glucoprotéides, qui se dédoublent sous l’influence des acides en albumines et matières sucrées: les mucines, secrétées par les muqueuses, appartiennent à ce groupe."
                            }
                        ]
                    }
