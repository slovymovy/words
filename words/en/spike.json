                    "frequency": "Middle",
                    "semantic_group_id": "nickname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous comedian <w>Spike</w> Milligan wrote many humorous poems.",
                            "target_lang_translations": {
                                "ru": "Знаменитый комик <w>Спайк</w> Миллиган написал много юмористических стихов."
                            }
                        },
                        {
                            "text": "They decided to call him <w>Spike</w> because of his messy hair.",
                            "target_lang_translations": {
                                "ru": "Они решили называть его <w>Спайк</w> из-за его взлохмаченных волос."
                            }
                        }
