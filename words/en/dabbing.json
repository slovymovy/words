            "senses": [
                {
                    "sense_id": "f9818a8b-ae49-304f-8892-96d71d1354fc",
                    "sense_definition": "The act of lightly pressing or touching something with a soft surface.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A careful <w>dabbing</w> with a cloth removed the fresh stain from the table.",
                            "target_lang_translations": {
                                "nl": "Voorzichtig <w>deppen</w> met een doek verwijderde de verse vlek van de tafel."
                            }
                        },
                        {
                            "text": "The artist applied paint through repeated <w>dabbing</w> on the canvas.",
                            "target_lang_translations": {
                                "nl": "De kunstenaar bracht verf aan door herhaaldelijk op het doek te <w>tippen</w>."
                            }
