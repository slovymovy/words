                "senses": [
                    {
                        "sense_id": "b3209e0e-f210-3e56-a5be-162fa6bb6aff",
                        "entry_id": "b676ad5f-72d9-3ac3-8ef6-a260df49122e",
                        "glosses": [
                            "de verkondiging van één of meerdere leugens terwijl men heeft gezworen de waarheid te vertellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68036939-b104-4cbc-a168-64631a48a76f",
                                "sense_id": "b3209e0e-f210-3e56-a5be-162fa6bb6aff",
                                "text": "Daar heb je bijvoorbeeld een koopman, een soldaat of een rechter die meent dat door het offeren van één muntje uit zoveel behaalde buit de hele poel van zijn leven in éénmaal gezuiverd is en dat al die meineden, al die uitspattingen, al die dronkenschappen, ruzies, moorden, oplichterijen, trouweloosheden, al dat verraad als het ware volgens contract worden afgekocht, en wel zo dat men weer een nieuwe reeks schurkenstreken kan beginnen."
                            },
                            {
                                "example_id": "b34d59fa-c694-42da-bef3-86256d453b15",
                                "sense_id": "b3209e0e-f210-3e56-a5be-162fa6bb6aff",
                                "text": "Eric nam nu het woord over van Ariadne en vertelde dat Heiskanen in hechtenis zat, aangeklaagd wegens meineed en valse aangifte, in beide gevallen een misdrijf, en hij kon een gevangenisstraf van vier jaar tegemoetzien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db308aff-1f8d-4bcf-899e-2d2dad354178",
                        "source_entry_id": "b676ad5f-72d9-3ac3-8ef6-a260df49122e",
                        "source_sense_id": "b3209e0e-f210-3e56-a5be-162fa6bb6aff",
                        "source_sense_description": "de verkondiging van één of meerdere leugens terwijl men heeft gezworen de waarheid te vertellen",
                        "target_lang_word": "Meineid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meineid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "815c49c7-dfe9-3430-b9d4-72edc7961d23",
                                        "entry_id": "354e0c9f-143a-3aee-935e-ae2713033225",
                                        "glosses": [
                                            "Verbrechen, das darin besteht, vor Gericht oder vor einer anderen zur Abnahme von Eiden zuständigen Stelle eine falsche Aussage zu beschwören (§ 154 StGB)"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8637a59-e5d1-4407-9ffd-3919c5566cb4",
                                                "sense_id": "815c49c7-dfe9-3430-b9d4-72edc7961d23",
                                                "text": "Als der Zeuge beschwor, zur Tatzeit mit dem Angeklagten eine Zechtour unternommen zu haben, leistete er einen Meineid."
                                            },
                                            {
                                                "example_id": "eeb7f253-0f83-44bd-aaa4-bdc136707776",
                                                "sense_id": "815c49c7-dfe9-3430-b9d4-72edc7961d23",
                                                "text": "„Dort, wo Giordano Bruno 33 Jahre zuvor im Büßerhemd kniend sein Todesurteil entgegennahm, im Festsaal des römischen Klosters St. Maria sopra Minerva, hat Galileo Galilei diesen Meineid geschworen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "882a462c-23a0-476f-8d23-8773495500cd",
                        "source_entry_id": "b676ad5f-72d9-3ac3-8ef6-a260df49122e",
                        "source_sense_id": "b3209e0e-f210-3e56-a5be-162fa6bb6aff",
                        "source_sense_description": "de verkondiging van één of meerdere leugens terwijl men heeft gezworen de waarheid te vertellen",
                        "target_lang_word": "perjury",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perjury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c1bcb34-5d07-3f81-baed-84dc0dda49bd",
                                        "entry_id": "3d856c53-2067-362a-8b61-3e8e0bdf244b",
                                        "glosses": [
                                            "The deliberate giving of false or misleading testimony under oath."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd27638a-3106-4cec-9a1e-1b22eb5c8920",
                                                "sense_id": "9c1bcb34-5d07-3f81-baed-84dc0dda49bd",
                                                "text": "We declare under penalty of perjury that the foregoing is true and correct."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6694edbb-bf12-44d5-a50a-6e396f170efb",
                        "source_entry_id": "b676ad5f-72d9-3ac3-8ef6-a260df49122e",
                        "source_sense_id": "b3209e0e-f210-3e56-a5be-162fa6bb6aff",
                        "source_sense_description": "de verkondiging van één of meerdere leugens terwijl men heeft gezworen de waarheid te vertellen",
                        "target_lang_word": "parjure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parjure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d60a06e-d537-3f65-82d2-c28badc85a3a",
                                        "entry_id": "6777bf23-22e5-3dd5-ab7d-c585b7676a21",
                                        "glosses": [
                                            "Faux serment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c76de495-22f6-4f09-bf1b-3341fc9eca0d",
                                                "sense_id": "0d60a06e-d537-3f65-82d2-c28badc85a3a",
                                                "text": "En signant ce traité qu’il était décidé à ne pas respecter, il a commis un parjure."
                                            },
                                            {
                                                "example_id": "22e1a17e-396f-4539-8b51-058c966ce23a",
                                                "sense_id": "0d60a06e-d537-3f65-82d2-c28badc85a3a",
                                                "text": "« La différence, monsieur, qui existe entre moi et vous, c’est que ma noblesse est fondée sur le serment, tandis que la vôtre est fondée sur le parjure. »"
                                            },
                                            {
                                                "example_id": "86be71d1-b5cf-4499-aaf5-e6a1bce3f36f",
                                                "sense_id": "0d60a06e-d537-3f65-82d2-c28badc85a3a",
                                                "text": "J’entendais bien mes propres paroles et consciemment j’affirmai coup sur coup ce mensonge par serment, rien que pour avoir l’amusante satisfaction de commettre un parjure patent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49207ea1-8db0-3146-83cb-d00551df3a98",
                                        "entry_id": "6777bf23-22e5-3dd5-ab7d-c585b7676a21",
                                        "glosses": [
                                            "Violation de serment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "adaaa2ba-f472-401d-b0d3-739edc4269c9",
                                                "sense_id": "49207ea1-8db0-3146-83cb-d00551df3a98",
                                                "text": "Ne pas respecter la neutralité d’un pays est un véritable parjure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2158cbf-d349-33ec-95f7-3a879ce6b05e",
                                        "entry_id": "6777bf23-22e5-3dd5-ab7d-c585b7676a21",
                                        "glosses": [
                                            "Celui, celle qui fait un faux serment, qui viole son serment, qui se parjure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "parjure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91480603-69fc-38bd-87a4-2cca736824fc",
                                        "entry_id": "08e6a55d-6709-30d7-b61f-86f353f06811",
                                        "glosses": [
                                            "Qui fait un faux serment, qui viole son serment, qui se parjure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4df32dc0-363c-41df-8ff4-c25021aead19",
                                                "sense_id": "91480603-69fc-38bd-87a4-2cca736824fc",
                                                "text": "Ah! Manon, lui dis-je d'un ton tendre, infidèle et parjure Manon! par où commencerai-je à me plaindre?"
                                            },
                                            {
                                                "example_id": "fe8b8ed3-0fb7-4c1e-b506-94be2f1c664e",
                                                "sense_id": "91480603-69fc-38bd-87a4-2cca736824fc",
                                                "text": "Ce que j’exige de toi comme homme de parole et d’honneur, à peine d’être reconnu sans foi, parjure et infâme, c’est de pardonner et de rendre ton affection paternelle au brave chevalier Wilfrid d’Ivanhoé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parjure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96cbc9b7-4abe-3309-986e-9ad8f99e565b",
                                        "entry_id": "c758f0b5-57b0-37ef-8939-9879914993bf",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de parjurer."
