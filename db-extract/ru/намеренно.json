                                "example_id": "91398a96-cbf7-473f-8144-4d8b0fe94375",
                                "sense_id": "d46c1215-94dc-36ce-ab06-7a316be8c0e9",
                                "text": "Я открыл дверь намеренно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b9279a7-e1fe-4ae6-ad2b-8c5a40c0b84d",
                        "source_entry_id": "9efa80ad-a326-32dd-94b4-53c7e6c26459",
                        "source_sense_id": "d46c1215-94dc-36ce-ab06-7a316be8c0e9",
                        "target_lang_word": "intentionnellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intentionnellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21d2b975-3166-3302-978c-bd18585337de",
                                        "entry_id": "64537562-b60e-3b21-8846-b40fb37184d0",
                                        "glosses": [
                                            "Avec intention, avec propos délibéré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ac79f58-0ee1-400e-8ce5-67198b635112",
                                                "sense_id": "21d2b975-3166-3302-978c-bd18585337de",
                                                "text": "Il m’a heurté intentionnellement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f022fbc-fe91-4be9-9905-46397311aa0c",
                        "source_entry_id": "9efa80ad-a326-32dd-94b4-53c7e6c26459",
                        "source_sense_id": "d46c1215-94dc-36ce-ab06-7a316be8c0e9",
                        "target_lang_word": "délibérément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "délibérément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                                        "entry_id": "cedc834b-2783-31bf-8730-248b55baab03",
                                        "glosses": [
                                            "D’une manière délibérée, hardiment, avec résolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74a86077-cf9e-4a8d-b512-4e18b315e0b9",
                                                "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                                                "text": "On se permet délibérément toutes les infidélités qu’on ne croit pas dignes d’une peine éternelle."
                                            },
                                            {
                                                "example_id": "67a12d1e-6361-4b47-a61c-8afdc2731e6c",
                                                "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                                                "text": "Je n’ai jamais permis qu’on chassât sur mes terres, et jamais, jamais je n’ai chassé, car cette idée que j’aurais pu, délibérément et de sang froid, arracher la vie à un être quelconque, me semblait impossible et monstrueuse."
                                            },
                                            {
                                                "example_id": "33230675-1b3d-4059-a801-55743593744f",
                                                "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                                                "text": "Le 27 août 1964, dans une petite salle de la banlieue de Florence, le mythe de l'Ouest prend du plomb dans l'aile. Une poignée de spectateurs découvrent un bon petit western rital, maquillé en série B made in USA, qui écorne délibérément la légende imprimée par John Ford."
                                            },
                                            {
                                                "example_id": "d08f5d59-1db5-4149-920b-7a14a8ed210c",
                                                "sense_id": "6a312c48-be0e-3bce-997b-7904cdf91234",
                                                "text": "Il importe peu que l’auteur du harcèlement n’ait pas délibérément cherché à nuire au salarié."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2a487f1-338c-45bc-81c6-45af4631435d",
                        "source_entry_id": "9efa80ad-a326-32dd-94b4-53c7e6c26459",
                        "source_sense_id": "d46c1215-94dc-36ce-ab06-7a316be8c0e9",
                        "target_lang_word": "exprès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exprès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                        "entry_id": "e066ebd1-5ea7-3dd7-9f50-2f31e15377e4",
                                        "glosses": [
                                            "Qui est énoncé d’une manière formelle et impérative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14456bde-5afa-492c-9359-46cf4e10068e",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "Ce soin ne peut être réalisé qu’avec le consentement exprès du patient."
                                            },
                                            {
                                                "example_id": "ea7cab68-246d-454c-9b0b-1a5f7d6b8cce",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "Monsieur, il s’agit de réformes dans l’état, et nullement de révolutions ; il s'agit d’améliorer, et non d’innover en quoi que ce soit : c’est la teneur expresse de nos cahiers."
                                            },
                                            {
                                                "example_id": "c176f44f-67e7-4ac5-8030-b87dc2754f33",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "Il est de toute évidence qu’il eût fallu, au contraire, accorder aux tuberculeux des surpensions, à la condition expresse qu’ils se résignassent à la claustration du sanatorium."
                                            },
                                            {
                                                "example_id": "97f2586f-3226-4ecd-ab99-b793e7f79d07",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "– Tout ce qui a été fait, dit-elle, l’aura toujours été selon les volontés expresses de votre belle-fille."
                                            },
                                            {
                                                "example_id": "f587d5f1-8955-4ea8-96de-2f0e07a70f7e",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "« L’affirmation et l’opiniâtreté sont signes exprès de bêtises », écrit Montaigne, et je le croirais, mais j’aurais préféré que sa phrase fût un peu moins… affirmative."
                                            },
                                            {
                                                "example_id": "d48983ed-d8ce-41db-a073-b569f70b7bbd",
                                                "sense_id": "a1ea06e5-04c9-3ee3-974e-3b0702de87e2",
                                                "text": "Mais il avait aussi l’ordre exprès de veiller à ce que les indigènes conservassent leurs oripeaux quoi qu’il advînt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exprès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26fd4f11-77b9-34f7-9ffe-9ce9534121e8",
                                        "entry_id": "76562636-ff31-3c52-b127-88a05633952a",
                                        "glosses": [
                                            "Avec intention formelle et délibérée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c1daad3-ad3f-4947-9c83-a24646a33812",
                                                "sense_id": "26fd4f11-77b9-34f7-9ffe-9ce9534121e8",
                                                "text": "C’est un recueil de ses chroniques théâtrales avec une préface de Courteline. J’y rencontre des pages de maître, noyées exprès dans un flot d’outrance volontaire et préméditée."
                                            },
                                            {
                                                "example_id": "275588f5-5df0-4507-927d-ffc7a1f09908",
                                                "sense_id": "26fd4f11-77b9-34f7-9ffe-9ce9534121e8",
                                                "text": "Il n’accusait point les clous de se tordre exprès, ni le bois de se fendre, ni le plâtre du mur d’éclater par morceaux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exprès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8fe70f8-a44c-3027-b153-e64636d585b0",
                                        "entry_id": "fea96457-6088-3dd3-8f1e-66194afde234",
                                        "glosses": [
                                            "Personne chargée d’acheminer une lettre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b1694a5-2120-49bc-87bf-7052d69b0aa6",
                                                "sense_id": "c8fe70f8-a44c-3027-b153-e64636d585b0",
                                                "text": "Cependant l’exprès berrichon qui, de la Châtre, où M. Harley avait relayé et rédigé ses lettres pour Boussac, était venu au petit trot (en une grande journée) remplir ce bizarre message, avait, conformément à ses instructions, demandé à parler à mademoiselle Jane."
                                            },
                                            {
                                                "example_id": "f742d721-db23-4ce5-a972-037e98349f10",
                                                "sense_id": "c8fe70f8-a44c-3027-b153-e64636d585b0",
                                                "text": "Quelques jours plus tard, un exprès, accouru d’Orsel à toute bride, remit à Dominique une lettre cachetée de noir dont la lecture le bouleversa, lui, si parfaitement maître de ses émotions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f405ae5-70c6-3d90-a5f0-8c95675273d0",
                                        "entry_id": "fea96457-6088-3dd3-8f1e-66194afde234",
                                        "glosses": [
                                            "Lettre reçue par livraison rapide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c731ce7-e6b4-4260-9de7-7dc0edf5a2cf",
                                                "sense_id": "3f405ae5-70c6-3d90-a5f0-8c95675273d0",
                                                "text": "Je viens de recevoir un exprès dans ma boîte postale."
                                            },
                                            {
                                                "example_id": "9b4b66b9-a4ec-43a4-b225-3a8df97843cc",
                                                "sense_id": "3f405ae5-70c6-3d90-a5f0-8c95675273d0",
                                                "text": "Je me hâte d’envoyer un exprès à Mylady, afin qu’elle me donne les ordres néceſſaires pour un cas auſſi urgent, je n’en écrirai pas davantage pour ne pas retarder le départ de l’exprès."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exprès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dee08bbc-7dd2-3e21-8014-0aa37506b34b",
                                        "entry_id": "d7411368-330c-327b-a0dd-267cd1ef2fae",
                                        "glosses": [
                                            "Celui qui est envoyé spécialement pour porter ou pour recevoir des lettres, des nouvelles, des ordres, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e259d2e1-5b82-4cf5-ab70-66f712e85021",
                                                "sense_id": "dee08bbc-7dd2-3e21-8014-0aa37506b34b",
                                                "text": "M. Philippe, le fils du banquier, poussa même la complaisance jusqu’à prévenir par un exprès M. Tournevau, emprisonné dans sa famille."
                                            },
                                            {
                                                "example_id": "7ae64ca7-8271-4db7-b0ce-3abed295a000",
                                                "sense_id": "dee08bbc-7dd2-3e21-8014-0aa37506b34b",
                                                "text": "Très juste, dit le président, qui dépêcha aussitôt un exprès à tous ces personnages."
                                            },
                                            {
                                                "example_id": "a475bc96-6944-4bc9-b40e-3f377a7aae38",
                                                "sense_id": "dee08bbc-7dd2-3e21-8014-0aa37506b34b",
                                                "text": "Une heure après sa mort, l’exprès était parti, et, plus heureux que ses deux prédécesseurs, il était, vers la fin du cinquième jour, arrivé à Louesche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4646a8d-d3eb-4e23-bc69-6a3ef33f7ef9",
                        "source_entry_id": "9efa80ad-a326-32dd-94b4-53c7e6c26459",
                        "source_sense_id": "d46c1215-94dc-36ce-ab06-7a316be8c0e9",
                        "target_lang_word": "à dessein",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à dessein",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0f12c1c-b863-3832-ae01-4e0a75627b8e",
                                        "entry_id": "8241676a-565c-3833-874f-b24705744950",
                                        "glosses": [
                                            "Exprès ; avec intention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f47fb3b-db1a-4bc0-9111-2b32e466e2b1",
                                                "sense_id": "f0f12c1c-b863-3832-ae01-4e0a75627b8e",
                                                "text": "Six jours après l’événement, Gendebien, collègue de d'Elhougne à la Chambre, écrivait au comte de Celles, le 18 août 1831 : « On nous a laissé ou plutôt fait cerner volontairement, de propos délibéré, et à dessein prémédité de faire passer notre armée sous les fourches caudines à Louvain. »"
                                            },
                                            {
                                                "example_id": "3a2496ac-0e0d-450f-ad7f-3b76cf3a1a80",
                                                "sense_id": "f0f12c1c-b863-3832-ae01-4e0a75627b8e",
                                                "text": "Il est à noter que le gingembre est oublié à dessein sur les chevaux atteints de mélanose, la queue, en se relevant, décèlerait une tare que le marchand a grand intérêt à cacher."
                                            },
                                            {
                                                "example_id": "87f25e18-8e5c-4751-8919-0fb8f037e194",
                                                "sense_id": "f0f12c1c-b863-3832-ae01-4e0a75627b8e",
                                                "text": "Son prédécesseur, Gaétan Barrette, était certes « cassant ». Le problème est qu’il le fut à très mauvais dessein. À preuve, l’état lamentable dans lequel il a laissé le réseau de santé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eddea7a-be3e-46e4-9a11-8ae09cafe812",
                        "source_entry_id": "9efa80ad-a326-32dd-94b4-53c7e6c26459",
                        "source_sense_id": "d46c1215-94dc-36ce-ab06-7a316be8c0e9",
                        "target_lang_word": "sciemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sciemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                                        "entry_id": "cd5c0703-9cf9-3e4c-838a-c79e5fc37e87",
                                        "glosses": [
                                            "Avec pleine connaissance de ce que l’on fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341a06cf-413d-4392-8a66-47e45e288f87",
                                                "sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                                                "text": "Les généraux renégats sont les représentants d'une classe qui, pour survivre en tant que telle, a renoncé à la nation chilienne et est sciemment devenue l'alliée de l'impérialisme nord-américain."
                                            },
                                            {
                                                "example_id": "da2ad3c6-7453-49c2-8d74-21b2b30870db",
                                                "sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                                                "text": "À quatre heures de l’après-midi, nous étions sur nos lits, attendant le dîner, mot aussi creux que nos estomacs, car il n’y avait à peu près rien à manger, les paysans affamant sciemment les succursales de l’Intourist, dont dépendait notre hôtel."
                                            },
                                            {
                                                "example_id": "2e4275a9-39d6-4704-acb4-808e071489bb",
                                                "sense_id": "6511e960-6b12-3035-9a46-188d107c8c49",
                                                "text": "Depuis fort longtemps, « on » oppose le Christianisme à l'Islam ! Depuis fort longtemps, « on » arbore les valeurs chrétiennes comme supérieures aux valeurs musulmanes en omettant sciemment les legs de ces dernières aux premières."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
