                },
                {
                    "sense_id": "772a7198-0d59-317d-8b75-5a27ae53ef70",
                    "sense_definition": "zu einer vereinbarten Verabredung oder einem Termin pünktlich erscheinen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich konnte den wichtigen Termin beim Zahnarzt wegen einer Erkältung nicht <w>wahrnehmen</w>."
