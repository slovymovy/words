                {
                    "sense_id": "14a4dbe1-d966-3e57-9b03-a941dfb77ae3",
                    "sense_definition": "To reprimand or rebuke someone angrily, especially a child.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher had to <w>scold</w> the student for talking during the exam.text",
                            "target_lang_translations": {
                                "tr": "Öğretmen, sınav sırasında konuştuğu için öğrenciyi <w>azarlamak</w> zorunda kaldı."
                            }
                        },
                        {
                            "text": "Parents often <w>scold</w> a child for playing in the street.text",
                            "target_lang_translations": {
                                "tr": "Ebeveynler, sokakta oynadığı için bir çocuğu sık sık <w>azarlar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "criticize"
                    ],
                    "common_phrases": [
                        "scold a child"
                    ],
                    "target_lang_definitions": {
                        "tr": "Özellikle bir çocuğu öfkeyle azarlamak veya ayıplamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "azarla-",
                                "target_lang_sense_clarification": "öfkeyle sert bir şekilde uyarmak, azarlamak"
                            },
                            {
                                "target_lang_word": "azarlamak",
                                "target_lang_sense_clarification": "sertçe çıkışmak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f104cbe-e2a0-3cf7-ba9b-e287aade147e",
                    "sense_definition": "A person who constantly finds fault and rebukes others angrily.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was known as the village <w>scold</w> because he complained about everything.text",
                            "target_lang_translations": {
                                "tr": "Yaşlı adam her şeyden şikayet ettiği için köyün <w>huysuz adamı</w> olarak bilinirdi."
                            }
                        },
                        {
                            "text": "She grew tired of being seen as a constant <w>scold</w> by her family.text",
                            "target_lang_translations": {
                                "tr": "Ailesi tarafından sürekli bir <w>dırdırcı</w> olarak görülmekten bıkmıştı."
                            }
