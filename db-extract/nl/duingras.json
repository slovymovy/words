                        "glosses": [
                            "gras dat in de duinen groeit Ammophila arenaria"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76fb78ae-56fd-4c9b-aceb-bf0265f36d8d",
                                "sense_id": "b3bfbee0-e6c5-30a5-81f6-0a6d6bbd31f7",
                                "text": "Daarom wordt het duingras extra voorzichtig teruggeplaatst zodat er geen enkel spoor overblijft van het graafwerk eerder die nacht. \"Een mooie start van bunkerdag\", zegt Ruud."
                            },
                            {
                                "example_id": "6259b09c-5417-4d61-b24f-6cbb931e789e",
                                "sense_id": "b3bfbee0-e6c5-30a5-81f6-0a6d6bbd31f7",
                                "text": "Deze werkzaamheden zijn eind mei afgerond. Er kunnen dan weer duingrassen op de dijk groeien. Her en der zorgen bosjes en open zanderige plekken dat allerlei hagedissen zich thuis voelen."
                            }
                        ]
