                                        "entry_id": "d03d4fdb-cc68-3628-aee3-b1468ca06b2f",
                                        "glosses": [
                                            "анат. часть пищеварительного тракта, канал, соединяющий полость рта с пищеводом"
                                        ],
                                        "tags": [],
