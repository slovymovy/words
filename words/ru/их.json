                    "sense_definition": "Употребляется для эмоционального восклицания, выражения досады, удивления или усиления сказанного.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Их</w>, какую прекрасную возможность мы только что упустили!",
                            "target_lang_translations": {
                                "pl": "<w>Ech</w>, jaką wspaniałą okazję właśnie zaprzepaściliśmy!"
                            }
                        },
                        {
                            "text": "<w>Их</w>, да разве можно было так сильно ошибиться в простом вопросе?",
                            "target_lang_translations": {
                                "pl": "<w>Ech</w>, czy naprawdę można było tak bardzo pomylić się w prostej kwestii?"
                            }
                        }
