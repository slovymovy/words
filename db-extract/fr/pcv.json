                        "entry_id": "71bd74f5-690c-3131-8366-c11e04dabda0",
                        "glosses": [
                            "Appel téléphonique où l'appelé accepte de payer à la place de l'appelant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bb616c0-683d-4d1e-936b-04a88a5821c1",
                                "sense_id": "29b987e8-8360-3cca-8059-8248f73f5311",
                                "text": "Un après-midi, Louis téléphona à Brossier en P.C.V. Il devait donner le numéro de la cabine et on le rappellerait au bout d'une demi-heure."
                            },
                            {
                                "example_id": "157dd92e-84ee-42d6-9bd6-a0b0513d6574",
                                "sense_id": "29b987e8-8360-3cca-8059-8248f73f5311",
                                "text": "Secouant la tête d'un air atterré, il se dirigea vers la cabine et fit le numéro de l’opératrice afin d'appeler, à sa grande honte, le bureau en PCV. Personne ne décrocha."
                            }
                        ]
                    }
