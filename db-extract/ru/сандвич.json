                ],
                "translations": [
                    {
                        "translation_id": "fd1ef777-6c8b-47e2-a4d5-a1a251d89235",
                        "source_entry_id": "9993ac22-3007-3b2d-b9d8-819718645e45",
                        "source_sense_id": "25a318cb-6afc-3cd2-9448-417c174c43dd",
                        "target_lang_word": "sandwich",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sandwich",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18e48596-63ea-366b-86ea-7b7332e2ee22",
                                        "entry_id": "6ccd261f-42cd-39bf-b077-55923cc3e194",
                                        "glosses": [
                                            "A dish or foodstuff where at least one piece, but typically two or more pieces, of bread serves as the wrapper or container of some other food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b2649cd-2af6-4419-a6c2-df9d47e6f9c0",
                                                "sense_id": "18e48596-63ea-366b-86ea-7b7332e2ee22",
                                                "text": "The most famous place in Copenhagen, Ida Davidsen, has a menu of 190 different kinds of open sandwich."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c08025a9-bd41-3d33-b1e3-1e4cd7ba1f0b",
                                        "entry_id": "6ccd261f-42cd-39bf-b077-55923cc3e194",
                                        "glosses": [
                                            "Any combination formed by layering one type of material between two layers of some other material."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8614a97-6369-3947-a398-c7ca38f03455",
                                        "entry_id": "6ccd261f-42cd-39bf-b077-55923cc3e194",
                                        "glosses": [
                                            "A layer cake or sandwich cake."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a92ec78-aa11-4662-bbb7-3823b9407884",
                                                "sense_id": "c8614a97-6369-3947-a398-c7ca38f03455",
                                                "text": "[…] our local agricultural fair in Warwickshire even has a category for Victoria sandwiches baked by male bakers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4ea02e-32b3-3954-917b-bcde9ca3aaab",
                                        "entry_id": "6ccd261f-42cd-39bf-b077-55923cc3e194",
                                        "glosses": [
                                            "A sandwichman (one who wears a sandwich board)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60c11ba6-cd07-4b9c-9099-838bedd4bab9",
                                                "sense_id": "ce4ea02e-32b3-3954-917b-bcde9ca3aaab",
                                                "text": "We have, and not so very long ago, seen women employed as 'sandwiches'."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sandwich",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d25454f6-7c98-36c9-afe7-e71edf9469a3",
                                        "entry_id": "e8816163-2c41-3c77-a651-a57f6ff40a85",
                                        "glosses": [
                                            "To place (an item) physically between two other, usually flat, items."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c743c520-fd6d-469f-96e6-0f7e8b37b404",
                                                "sense_id": "d25454f6-7c98-36c9-afe7-e71edf9469a3",
                                                "text": "We saw a few Gresley Moguls on goods, as a limited amount of freight traffic was sandwiched in even on this busy day."
                                            },
                                            {
                                                "example_id": "21047800-d9d6-4d32-a2c3-57adff0c8def",
                                                "sense_id": "d25454f6-7c98-36c9-afe7-e71edf9469a3",
                                                "text": "An oddity of the auto-train services, incidentally, was the occasional \"doubling\", usually for football excursions, when the load was increased to four coaches with the engine sandwiched between."
                                            },
                                            {
                                                "example_id": "9c0609c9-da37-4cb7-9eb6-bc5692dbf8fd",
                                                "sense_id": "d25454f6-7c98-36c9-afe7-e71edf9469a3",
                                                "text": "But as the game looked destined for a stalemate at half-time, the hammer blow arrived. A corner was just about cleared, only for the Scots to switch off.\nVladimir Coufal overlapped with space and time on his side, his delivery being met by Schick, who steered his header home while sandwiched between Liam Cooper and Grant Hanley."
                                            },
                                            {
                                                "example_id": "04d8a051-1274-4168-aaf6-e1d536ef0b38",
                                                "sense_id": "d25454f6-7c98-36c9-afe7-e71edf9469a3",
                                                "text": "One can't escape the huge nuclear facility at Sellafield (supplier of much of the line's remaining freight traffic), or miss the wild shingle beaches with exposed and precarious bungalows sandwiched between the railway and the shore at Braystones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc68d7d9-fef9-3b1c-a8e3-097e7a5ca0e6",
                                        "entry_id": "e8816163-2c41-3c77-a651-a57f6ff40a85",
                                        "glosses": [
                                            "To put or set between two other events in time."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "362f90b9-104a-4e0c-ab43-b3c28b946d14",
                                                "sense_id": "dc68d7d9-fef9-3b1c-a8e3-097e7a5ca0e6",
                                                "text": "Street BASIC is becoming the language taught in junior high; it is sandwiched between Logo, which is taught in elementary school, and Pascal, which is taught in high school."
                                            },
                                            {
                                                "example_id": "07b77a69-8de9-4b5b-95ac-73d558724996",
                                                "sense_id": "dc68d7d9-fef9-3b1c-a8e3-097e7a5ca0e6",
                                                "text": "Dirk Kuyt sandwiched a goal in between Carroll's double as City endured a night of total misery, with captain Carlos Tevez limping off early on with a hamstring strain that puts a serious question mark over his participation in Saturday's FA Cup semi-final against Manchester United at Wembley."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0b10319-5bd8-38e7-af03-d1c02cedd8d2",
                                        "entry_id": "e8816163-2c41-3c77-a651-a57f6ff40a85",
                                        "glosses": [
                                            "To double penetrate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45243c59-7ce1-4674-abf5-0d5a80518b3f",
                                                "sense_id": "c0b10319-5bd8-38e7-af03-d1c02cedd8d2",
                                                "text": "They sandwiched her, the footballer at her back, his dick tucked into the perfect seam of her ass as he fingered her pussy while the shorter, leaner, covered-in-tattoos Monsieur Artiste kissed her and pinched her nipples"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                        "entry_id": "e8816163-2c41-3c77-a651-a57f6ff40a85",
                                        "glosses": [
                                            "To feed sandwiches to."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9d8c0ac-35a8-45fc-b5fc-c6a98f0fab46",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "But one or two evil-disposed characters muttered they might be sure the lady had her own turn to serve, and they might be sure they wasn't \"teaed and muffined and sandwiched for nothing!\""
                                            },
                                            {
                                                "example_id": "b0f85a35-d0cd-4958-97ca-3ab2699c2c46",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "The association of veteran firemen, which has a membership of 200, kept open house for New Year callers, and all comers were bountifully sandwiched and coffeed."
                                            },
                                            {
                                                "example_id": "e839ebba-03bc-45ab-b349-247063feb766",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "Here at Camp Wheeler we “coffeed” and “sandwiched” the drafted men when they came from Camp Gordon several weeks ago, and the men from Camp Pike more recently."
                                            },
                                            {
                                                "example_id": "7f23626b-bb10-40f3-b4af-0edb8af19863",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "There we were met by enterprising citizens and coffeed and sandwiched by pretty girls."
                                            },
                                            {
                                                "example_id": "cb2f2df5-dd17-4bad-b0ec-5a19f8e767ba",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "Five soldiers had been sandwiched and coffeed at the Elks canteen, were a little short of money, needed haircuts."
                                            },
                                            {
                                                "example_id": "5bd50f9a-7851-4bf9-92e1-e4bf1c396286",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "I clothed desperate families, and sandwiched and teaed many distracted souls."
                                            },
                                            {
                                                "example_id": "b7128e11-9adb-4aef-a566-9666b3430acd",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "I write this on the kitchen table at the home of the kind Mr. and Mrs. Lloyd Ebert, who sandwiched and coffee’d me."
                                            },
                                            {
                                                "example_id": "fda94414-f1aa-4d09-a85b-ff5c41f1dfd5",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "Mrs. Robert (Helen) Adickes, of Flintridge, mate of the chairman of the Pilots For Goldwater committee, was in there pitching as usual seeing that everyone was fed and coffeed or, in the case of the young colts and fillies, sandwiched and popped."
                                            },
                                            {
                                                "example_id": "6bffc533-1a5b-4444-8bd1-c08588b6f9e7",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "Hostesses like Laurie McCormack, who’s used to keeping politicians, press and businessmen coffeed and sandwiched on special visits to the train, sat back and let Jay Montague and other merchants reverse roles."
                                            },
                                            {
                                                "example_id": "a38004bb-02ef-4674-9a80-88b5a0554f32",
                                                "sense_id": "55033423-fe71-3d1c-997b-a23eb53e609c",
                                                "text": "“In the daytimes, he fixes things for people,” I said, “and in return they keep him sandwiched and coffeed.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee9cce7-3ce6-3c11-a15e-b44afe356a52",
                                        "entry_id": "e8816163-2c41-3c77-a651-a57f6ff40a85",
                                        "glosses": [
                                            "To eat sandwiches."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d46c96a1-ad9e-4654-9441-9e30593ad2ef",
                                                "sense_id": "cee9cce7-3ce6-3c11-a15e-b44afe356a52",
                                                "text": "Mr. and Mrs. Ted Craig (he^([sic]) speaker of the assembly) emerging from a popular drive-in after having sandwiched and coffeed . . ."
                                            },
                                            {
                                                "example_id": "54118ca0-821e-49b9-9513-d7a29c453ac6",
                                                "sense_id": "cee9cce7-3ce6-3c11-a15e-b44afe356a52",
                                                "text": "He coffeed and sandwiched along the highway."
                                            },
                                            {
                                                "example_id": "45dccaee-882f-45c6-a6d4-dbe2060aea76",
                                                "sense_id": "cee9cce7-3ce6-3c11-a15e-b44afe356a52",
                                                "text": "The Red Knight and his squire might be sandwiching at the very next table."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sandwich",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8fab602-f8ef-37d1-8947-b501e4ebe494",
                                        "entry_id": "c9934a43-56e3-3a11-a9da-56b4a0bf6bc4",
                                        "glosses": [
                                            "Of a meal or serving size that is smaller than a dinner."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
