                                "example_id": "7bc396dc-8cfe-4fc6-a6c0-c2e5f2ecfe1a",
                                "sense_id": "4e81c320-6c7c-3539-9f25-07f10d11fa83",
                                "text": "In veel landen zijn bordelen tegen de wet."
