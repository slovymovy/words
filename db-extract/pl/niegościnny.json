                                                "example_id": "ea19eb7d-82b5-4f90-9245-f41cdd818c4a",
                                                "sense_id": "36367602-75d0-312b-9929-bc308674fb3d",
                                                "text": "The townspeople were unwelcoming, making little effort to make the newcomer feel welcome."
                                            }
                                        ]
