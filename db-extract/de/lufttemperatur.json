                        "source_sense_id": "c9527bf1-1cff-3f41-85a6-b067e693861d",
                        "source_sense_description": "Meteorologie: Temperatur, die man in der Luft in der Nähe des Bodens misst",
                        "target_lang_word": "luchttemperatuur",
                        "target_lang_code": "nl",
