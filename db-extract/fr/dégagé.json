                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f287d45a-5907-3ebd-81d4-09e49a4ed2f0",
                        "entry_id": "8485ad75-34e2-34b9-88f0-27382960aaf1",
                        "glosses": [
                            "Qualifie un ton, des airs, un peu trop libres."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "31b4ac2c-b407-42ca-8334-9821033477dd",
                                "sense_id": "f287d45a-5907-3ebd-81d4-09e49a4ed2f0",
                                "text": "Duchotel, bas. — Mais pas du tout !… Tais-toi donc !… (Haut, riant pour se donner l’air dégagé.) Ah ! ah ! tu… vas bien ?"
                            }
                        ]
                    }
