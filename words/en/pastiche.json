{
    "word_family": [
        "pastichio"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "471a0940-e6ee-31f6-9315-15b6a4086df9",
                    "sense_definition": "A work of art, literature, or music that imitates the style of a previous artist or period.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The modern film is a clever <w>pastiche</w> of classic 1940s detective movies."
                        },
                        {
                            "text": "Critics often dismiss the novel as a mere <w>pastiche</w> of Victorian literature."
                        }
                    ],
                    "synonyms": [
                        "imitation",
                        "parody"
                    ],
                    "common_phrases": [
                        "artistic pastiche"
                    ]
                },
                {
                    "sense_id": "0f680414-4525-3914-a98c-ace0c4f98274",
                    "sense_definition": "An incongruous mixture of different elements or styles.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The building's design is a strange <w>pastiche</w> of modern glass and ancient stone."
                        },
                        {
                            "text": "Her essay was a confusing <w>pastiche</w> of unrelated ideas and poorly cited facts."
                        }
                    ],
                    "synonyms": [
                        "hodgepodge",
                        "medley",
                        "potpourri"
                    ],
                    "common_phrases": [
                        "confusing pastiche"
                    ]
                },
                {
                    "sense_id": "c99c4630-0500-3ac6-95ad-2eec035eb26b",
                    "sense_definition": "A musical composition consisting of various sections or melodies from other works.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra performed a lively <w>pastiche</w> of popular opera themes."
                        },
                        {
                            "text": "The composer created a <w>pastiche</w> that blended jazz rhythms with classical melodies."
                        }
                    ],
                    "synonyms": [
                        "medley",
                        "potpourri"
                    ],
                    "common_phrases": [
                        "musical pastiche"
                    ]
                },
                {
                    "sense_id": "c4a4152a-3100-3cd7-8395-5e8aececc2a8",
                    "sense_definition": "A technique in postmodern writing that combines various genres and styles to create a new form.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "imitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author uses <w>pastiche</w> to challenge traditional narrative structures in her latest play."
                        },
                        {
                            "text": "Postmodern literature often relies on <w>pastiche</w> to explore the fragmentation of modern identity."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d398678f-83ad-3d04-9d9b-01fbba4fb584",
                    "sense_definition": "To create or compose something by mixing various styles or elements.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mixture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director <w>pastiched</w> several different film genres to create a unique visual experience."
                        },
                        {
                            "text": "He <w>pastiched</w> various historical architectural styles to design the new city library."
                        }
                    ],
                    "synonyms": [
                        "blend",
                        "mix"
                    ]
                }
            ]
        }
    ]
}