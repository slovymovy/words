                "senses": [
                    {
                        "sense_id": "da802748-1ca9-3390-99d1-ca02b72bebf8",
                        "entry_id": "6b27d768-3d5c-3deb-9584-827774a22f05",
                        "glosses": [
                            "Rendre grabataire."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "78672052-e33b-4632-8bdf-bad27f91c7e5",
                                "sense_id": "da802748-1ca9-3390-99d1-ca02b72bebf8",
                                "text": "Je dois être ferme avec elle, pour son propre bien-être ; rester manger en chambre tout le temps risque de la grabatariser plus rapidement avec le grand âge."
                            },
                            {
                                "example_id": "7e4a1f78-ca12-4f5e-a443-97df7ace9d01",
                                "sense_id": "da802748-1ca9-3390-99d1-ca02b72bebf8",
                                "text": "Confiné au lit, grabatarisé par ses douleurs, son état se dégrade un peu plus chaque jour, ses forces l'abandonnement, ses muscles fondent à vue d’œil, sa peau s'abime."
                            },
                            {
                                "example_id": "8447909f-bbc2-46f0-ac7c-db8c60608e16",
                                "sense_id": "da802748-1ca9-3390-99d1-ca02b72bebf8",
                                "text": "En phase chronique : difficulté articulaire, handicap, grabatarisé…"
                            }
                        ]
                    }
