                "senses": [
                    {
                        "sense_id": "843b758d-6de2-3257-8aec-e81f97fd264a",
                        "entry_id": "4a1348bf-a9be-3672-a140-f2158c221e15",
                        "glosses": [
                            "Hautwunde in Folge des Stiches einer Bettwanze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0c834ae-5f29-4784-89e3-922bea2d17cc",
                                "sense_id": "843b758d-6de2-3257-8aec-e81f97fd264a",
                                "text": "„Warlam sah, dass sich zwei gegenseitig die angeschwollenen Wanzenbisse am Rücken kratzten.“"
                            },
                            {
                                "example_id": "a47ebe28-b963-48e2-86e9-5368da47cab8",
                                "sense_id": "843b758d-6de2-3257-8aec-e81f97fd264a",
                                "text": "„Wanzenbisse sind üblicherweise nicht quer verteilt aufzufinden. Häufig sind mehrere Bisse linear nebeneinander zu erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
