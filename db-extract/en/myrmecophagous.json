                        "examples": [
                            {
                                "example_id": "e0893f72-b6d3-43f4-b1f9-8745549ff2b1",
                                "sense_id": "e3c6182f-871a-3659-aa40-f7d36418479e",
                                "text": "\"Although I made no further study of stomach contents, the myrmecophagous habits of 'Gastrophryne' have come to my attention frequently in the course of routine field work. Individuals kept in confinement for a day or more almost invariably voided feces which consisted mainly or entirely of ant remains, chiefly the heads, as these are most resistant to digestion.\""
                            }
                        ]
