                                ]
                            },
                            {
                                "target_word": "opérateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84c226f7-d549-3422-ab45-027c57ec0201",
                                        "entry_id": "cf92d897-31ec-31fb-bebf-96e48319487d",
                                        "glosses": [
                                            "Application, habituellement définie sur un ensemble de fonctions."
