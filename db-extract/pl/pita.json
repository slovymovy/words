                                "example_id": "018b13a3-351a-41ad-854b-cdd124f8c356",
                                "sense_id": "76577a87-f931-3fc3-85b6-c441eb0a125f",
                                "text": "Dziś na kolację mamy pitę z gyros i tzatzyki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0c39df08-2e54-3c1e-83f0-48ecd3d882d7",
                        "entry_id": "7d97fee2-6f93-3e97-9d5a-53f16741bff9",
