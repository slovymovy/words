                                "example_id": "e8a39987-6c09-4689-ae7f-3986bf5b4c90",
                                "sense_id": "89bf3da8-0320-3a00-9b6c-12e22c1e9935",
                                "text": "„Abgabeverbote an Jugendliche sind eine der zahlreichen Massnahmen zur Tabakprävention, die in der Schweiz auf allen Staatsebenen unternommen werden.“"
                            }
