                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e9b8d6c-16d8-42b7-a77e-d85f81a4d0df",
                        "source_entry_id": "a6701fe0-e4e6-32b1-a272-aee54b19c5df",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Vilém",
