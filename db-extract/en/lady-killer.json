                                "target_word": "Schürzenjäger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17ac0a5a-1bdf-3a60-9fba-7bca5c1f04df",
                                        "entry_id": "959de170-d384-380a-9b09-3e9d5e25b6c8",
                                        "glosses": [
                                            "Mann, der beständig Frauen umwirbt und diese zu erotisch-sexuellen Abenteuern mit sich zu bewegen trachtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d9b3859-31a0-43df-b84e-1f779b40b7b2",
                                                "sense_id": "17ac0a5a-1bdf-3a60-9fba-7bca5c1f04df",
                                                "text": "Don Juan und Casanova sind Sinnbilder des Schürzenjägers."
                                            },
                                            {
                                                "example_id": "f5e470a4-eb62-4011-8424-c481a33b369a",
                                                "sense_id": "17ac0a5a-1bdf-3a60-9fba-7bca5c1f04df",
                                                "text": "„Wobei das Wort für ›Huhn‹, galinha, nicht, wie etwa chicken im Englischen (›Don't be a chicken about it!‹), für ›Memme‹, sondern, etwas überraschend, trotz des weiblichen a galinha, für einen Mann steht, der hinter den Frauen her ist, den Schürzenjäger oder Frauenheld.“"
                                            },
                                            {
                                                "example_id": "d38b7066-bb4c-4465-8dbc-3dbfc07be4fe",
                                                "sense_id": "17ac0a5a-1bdf-3a60-9fba-7bca5c1f04df",
                                                "text": "„Er war als Schürzenjäger berüchtigt, und nicht alle Frauen ließen sich freiwillig mit ihm ein.“"
                                            },
                                            {
                                                "example_id": "f6c0e7f4-b0e7-424e-a17d-e593972f8c23",
                                                "sense_id": "17ac0a5a-1bdf-3a60-9fba-7bca5c1f04df",
                                                "text": "„Auch hier wissen wir, dass Tony Curtis kein Millionär ist und auch keineswegs frigide, sondern ein Saxofon spielender Schürzenjäger.“"
                                            },
                                            {
                                                "example_id": "4b090fa8-5e4a-4ce3-8d57-9e5aafe95668",
                                                "sense_id": "17ac0a5a-1bdf-3a60-9fba-7bca5c1f04df",
                                                "text": "„Erblickt ein Schürzenjäger ein Mädchen oder eine Frau, die sich einer gewissen Wohlgestalt erfreut, so stellt er ihr auf alle erdenkliche Art und Weise nach, um ihr die Sprödigkeit zu nehmen und sie sich geneigt zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
