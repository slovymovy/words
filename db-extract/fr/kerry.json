                                "target_senses": [
                                    {
                                        "sense_id": "e0336c6e-017d-3406-8e14-6315c05d3500",
                                        "entry_id": "2404ccf0-1999-3729-803a-e5d9f0242e31",
                                        "glosses": [
                                            "A county of Ireland. County seat: Tralee."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b804c74-f96a-3f93-a88b-288365ff5bd0",
                                        "entry_id": "2404ccf0-1999-3729-803a-e5d9f0242e31",
                                        "glosses": [
                                            "A village and community in Powys, Wales, originally in Montgomeryshire (OS grid ref SO1489). Welsh spelling: Ceri."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22bacd22-dbc1-33d4-9f68-64b36238dd99",
                                        "entry_id": "2404ccf0-1999-3729-803a-e5d9f0242e31",
                                        "glosses": [
                                            "A rural locality in Scenic Rim Region, Queensland, Australia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48a35061-bb6b-3b77-9f15-92dd4f241f60",
                                        "entry_id": "2404ccf0-1999-3729-803a-e5d9f0242e31",
                                        "glosses": [
                                            "A surname from Middle English derived from the place name, or from the Middle English given name Kendrick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14cc272a-5833-4216-8bce-b64366a7c5c8",
                                                "sense_id": "48a35061-bb6b-3b77-9f15-92dd4f241f60",
                                                "text": "A ticket of John Kerry and John Edwards with, effectively, four first names, would send the wrong message to the world. Also no candidate has ever been elected president, with a girl's name like \"Kerry\" for a \"surname\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e23f457-2164-3bfb-b7b2-8d00fa98dbd3",
                                        "entry_id": "2404ccf0-1999-3729-803a-e5d9f0242e31",
                                        "glosses": [
                                            "A male given name transferred from the surname or place name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85ac12ee-10c7-4cb2-8493-38bbda3ea561",
                                                "sense_id": "5e23f457-2164-3bfb-b7b2-8d00fa98dbd3",
                                                "text": "Kerry O'Leary - for so was he called to distinguish him from those of the name in the adjoining county - soon made his appearance in the court-yard beneath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88545c37-a8c2-3b4e-bdad-d076f4957f74",
                                        "entry_id": "2404ccf0-1999-3729-803a-e5d9f0242e31",
                                        "glosses": [
                                            "A female given name transferred from the surname or place name, originally of Australian usage, also spelled Keri, Kerri and Kerrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b29b8d-79d5-4920-a5e2-c4c876e2f70f",
                                                "sense_id": "88545c37-a8c2-3b4e-bdad-d076f4957f74",
                                                "text": "After nearly 20 months of celebrity theater and an incalculable amount of effort and courtroom expense, the misdemeanor trial of Kerry Kennedy ended on Friday in breakneck fashion, as jurors took one hour to find her not guilty of driving under the influence of a drug: a sleeping pill that she said she took by accident."
                                            }
                                        ]
                                    }
                                ]
                            },
