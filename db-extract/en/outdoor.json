    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d3a25474-26dc-3023-957a-c31fc3b2ae8f",
                "word": "outdoor",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e032bf2-302d-3f4e-898c-43c99e774cc1",
                        "entry_id": "d3a25474-26dc-3023-957a-c31fc3b2ae8f",
                        "glosses": [
                            "Situated in, designed to be used in, or carried on in the open air."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc9b8f44-2f89-4c5a-a226-3cf1e3ed0fc8",
                                "sense_id": "4e032bf2-302d-3f4e-898c-43c99e774cc1",
                                "text": "A very neat old woman, still in her good outdoor coat and best beehive hat, was sitting at a polished mahogany table on whose surface there were several scored scratches so deep that a triangular piece of the veneer had come cleanly away,[…]."
                            }
                        ]
                    },
                    {
                        "sense_id": "e229d15f-f8c3-368a-9e64-f440f3c95369",
                        "entry_id": "d3a25474-26dc-3023-957a-c31fc3b2ae8f",
                        "glosses": [
                            "Pertaining to charity administered or received away from, or independently from, a workhouse or other institution."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6b66ac50-98d9-4920-8d37-b71ab3a11d64",
                                "sense_id": "e229d15f-f8c3-368a-9e64-f440f3c95369",
                                "text": "Believing social policy should be directed by experts to bring about the greatest happiness of the greatest number, Benthamites judged the old Poor Law outdoor relief system a recipe for waste and idleness."
                            }
                        ]
                    }
                ],
                "translations": [
