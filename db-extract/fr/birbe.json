        "fr-extract.jsonl": [
            {
                "entry_id": "256fd94d-9824-30cc-b6ab-1724aefeaba8",
                "word": "birbe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a724845-d795-41fa-b8eb-d5cc3cb225f5",
                        "entry_id": "256fd94d-9824-30cc-b6ab-1724aefeaba8",
                        "tags": [
                            "plural"
                        ],
                        "form": "birbes"
                    },
                    {
                        "form_id": "88cd1d74-b77b-4640-9cc6-eee4e99bdc88",
                        "entry_id": "256fd94d-9824-30cc-b6ab-1724aefeaba8",
                        "tags": [],
                        "form": "birbaillon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bdc7b92-3a97-3cda-9b27-9015bbf03861",
                        "entry_id": "256fd94d-9824-30cc-b6ab-1724aefeaba8",
                        "glosses": [
                            "Homme d’âge plus que mûr."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b680f7b8-0582-4fda-ba3e-835d44edcf57",
                                "sense_id": "6bdc7b92-3a97-3cda-9b27-9015bbf03861",
                                "text": "Comme il avait suffisamment payé à boire aux jeunes gens, on ne lui avait point fait le charivari ainsi qu’il est coutume de faire aux vieux birbes qui prennent des femmes de beaucoup moins âgées qu’eux."
                            },
                            {
                                "example_id": "6379e524-36fe-4c7a-9ec9-ca67e1365f86",
                                "sense_id": "6bdc7b92-3a97-3cda-9b27-9015bbf03861",
                                "text": "Nos jeunes femmes n’ont pas le goût de se faire féconder par les vieux birbes qu’elles ne peuvent épouser que quand ils sont déjà perclus de douleurs et de rhumatismes souvent blennorragiques."
                            },
                            {
                                "example_id": "4f313f58-ae7b-47ce-906a-409f4616886e",
                                "sense_id": "6bdc7b92-3a97-3cda-9b27-9015bbf03861",
                                "text": "II se peut, pour tout salaire de ma périlleuse gymnastique, que je lorgne seulement quelques couples de vieux birbes jouant au bésigue."
                            },
                            {
                                "example_id": "2e57915e-4770-4037-b3ba-45ee5d5192cb",
                                "sense_id": "6bdc7b92-3a97-3cda-9b27-9015bbf03861",
                                "text": "Il s’empresse d’indiquer le bon chemin aux provinciaux, il donne du feu aux plus hideux des bourgeois, il indique l’heure aux plus pressés des passants, il répond avec politesse aux prostituées, il suit les enterrements, il caresse la barbe des birbes."
                            },
                            {
                                "example_id": "811c1acc-bfd7-4b29-91a0-829285031aa2",
                                "sense_id": "6bdc7b92-3a97-3cda-9b27-9015bbf03861",
                                "text": "C’est une bonne idée de vous marier, avant que vous ne deveniez un vieux birbe aigri et neurasthénique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da0c0f55-4bfc-4dac-af2c-c3cb5172251c",
                        "source_entry_id": "256fd94d-9824-30cc-b6ab-1724aefeaba8",
                        "source_sense_id": "6bdc7b92-3a97-3cda-9b27-9015bbf03861",
                        "target_lang_word": "dotard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dotard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "549adc40-85af-3337-a289-8ec2f4bf2df4",
                                        "entry_id": "4260fcb1-0f3b-3b95-a275-67282fcf671c",
                                        "glosses": [
                                            "An old person with impaired intellect; a senile person; one in their dotage."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51147d37-6437-4d6b-9ad8-5e7e36538ea4",
                                                "sense_id": "549adc40-85af-3337-a289-8ec2f4bf2df4",
                                                "text": "Dotard, (ſaide he) let be thy deepe aduiſe;\nSeemes that through many yeares thy wits thee faile,\nAnd that weake eld hath left thee nothing wiſe,\nEls neuer ſhould thy iudgement be ſo frayle,\nTo meaſure manhood by the ſword or mayle."
                                            },
                                            {
                                                "example_id": "5432c7fb-2eb6-49d4-a959-051d3d30109a",
                                                "sense_id": "549adc40-85af-3337-a289-8ec2f4bf2df4",
                                                "text": "I ſpeake not like a dotard, nor a foole,\nAs vnder priuiledge of age to bragge,\nWhat I haue done being yong, or what would doe,\nWere I not old, […]"
                                            },
                                            {
                                                "example_id": "28d9cb93-6ba8-4b83-8769-863506f58c26",
                                                "sense_id": "549adc40-85af-3337-a289-8ec2f4bf2df4",
                                                "text": "The man who had ſome virtue whilſt he was ſtruggling for a crown, often becomes a voluptuous tyrant when it graces his brow; and, when the lover is not loſt in the huſband, the dotard, a prey to childiſh caprices, and fond jealouſies, neglects the ſerious duties of life, and the careſſes which ſhould excite confidence in his children are laviſhed on the overgrown child, his wife."
                                            },
                                            {
                                                "example_id": "f0b5cef5-0541-4dc5-b993-c61b12c95da4",
                                                "sense_id": "549adc40-85af-3337-a289-8ec2f4bf2df4",
                                                "text": "Lawns, houses, chattels, groves, and fields,\nAll that the fertile valley shields;\nWages of folly--baits of crime,\nOf life's uneasy game the stake,\nPlaythings that keep the eyes awake\nOf drowsy, dotard Time;—"
                                            },
                                            {
                                                "example_id": "bc828046-4706-41ff-a2cb-4b324ab7f935",
                                                "sense_id": "549adc40-85af-3337-a289-8ec2f4bf2df4",
                                                "text": "He early determined to marry and wive,\n For better or worse\n With his elderly nurse,\nWhich the poor little boy didn't live to contrive:\n His health didn't thrive—\n No longer alive,\nHe died an enfeebled old dotard at five!"
                                            },
                                            {
                                                "example_id": "c824a21d-d7d1-47a6-bad7-7c23ee73546e",
                                                "sense_id": "549adc40-85af-3337-a289-8ec2f4bf2df4",
                                                "text": "Whatever [Donald] Trump might have expected, he will face results beyond his expectation. I will surely and definitely tame the mentally deranged U. S. dotard with fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a27f3b13-751d-3d4d-bac1-e39b8a084465",
                                        "entry_id": "4260fcb1-0f3b-3b95-a275-67282fcf671c",
                                        "glosses": [
                                            "One who dotes on another, showing excessive fondness; a doter."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
