                    {
                        "translation_id": "81ebee03-767f-4f63-9535-165f2be026b5",
                        "source_entry_id": "554ae4a4-3913-3440-a691-9fbe80d7a0be",
                        "source_sense_id": "305d27a9-6459-3f39-95af-2957790aa5b6",
