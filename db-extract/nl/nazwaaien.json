                        ],
                        "examples": [
                            {
                                "example_id": "68e35eed-0e11-44f3-85c4-198e409dc72c",
                                "sense_id": "04b1ec20-069b-38f4-b37b-99cd1bd3d9f3",
                                "text": "Vitaliteitscoach Daphne de Jong is zaterdagavond als beste Maestro-dirigente van Holten gekozen door de vakjury en het publiek. Met haar zelfverzekerde dirigeerslag loodste ze het 25-koppige orkest van HMV overtuigend door het nummer Skyfall van Adele. Medefinalisten Ria Kappert en Frank Fridrichs hadden het nazwaaien."
                            }
                        ]
