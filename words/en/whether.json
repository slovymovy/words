{
    "word_family": [],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "7353ae6e-abba-3aec-bdb1-78cb0b17cb8d",
                    "sense_definition": "Introduces an indirect question or a clause expressing doubt or uncertainty.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "uncertainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not sure <w>whether</w> the store is still open at this hour.",
                            "target_lang_translations": {
                                "ru": "Я не уверен, открыт <w>ли</w> еще магазин в этот час."
                            }
                        },
                        {
                            "text": "Do you know <w>whether</w> he is coming to the party tonight?",
                            "target_lang_translations": {
                                "ru": "Ты знаешь, придет <w>ли</w> он сегодня на вечеринку?"
                            }
                        }
                    ],
                    "synonyms": [
                        "if"
                    ],
                    "common_phrases": [
                        "know whether",
                        "wonder whether"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводит косвенный вопрос или придаточное предложение, выражающее сомнение или неуверенность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ли",
                                "target_lang_sense_clarification": "в косвенных вопросах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0789e47-8b4e-356f-96ad-9c81f56e34e6",
                    "sense_definition": "Used to introduce two or more alternatives or possibilities, typically followed by or.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "alternatives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I cannot decide <w>whether</w> to go for a walk or stay home.",
                            "target_lang_translations": {
                                "ru": "Я не могу решить, пойти <w>ли</w> мне на прогулку или остаться дома."
                            }
                        },
                        {
                            "text": "It does not matter <w>whether</w> we go by bus or by train.",
                            "target_lang_translations": {
                                "ru": "Неважно, поедем <w>ли</w> мы на автобусе или на поезде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whether or not",
                        "decide whether"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения двух или более альтернатив или возможностей, обычно в паре с 'or'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ли",
                                "target_lang_sense_clarification": "при выборе между вариантами"
                            },
                            {
                                "target_lang_word": "или ... или",
                                "target_lang_sense_clarification": "сопоставление альтернатив"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a94ba24f-bccb-3ed7-9b2b-6ddc96795347",
                    "sense_definition": "Used to indicate that something is true in any of the cases mentioned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "alternatives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is coming to the meeting <w>whether</w> you like it or not.",
                            "target_lang_translations": {
                                "ru": "Он придет на встречу, <w>независимо от того</w>, нравится вам это или нет."
                            }
                        },
                        {
                            "text": "We will finish the project on time <w>whether</w> or not it rains.",
                            "target_lang_translations": {
                                "ru": "Мы закончим проект вовремя <w>вне зависимости</w> от того, пойдет ли дождь."
                            }
                        }
                    ],
                    "synonyms": [
                        "regardless of if"
                    ],
                    "common_phrases": [
                        "whether or not",
                        "whether you like"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на то, что утверждение верно в любом из упомянутых случаев."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "независимо от того,",
                                "target_lang_sense_clarification": "в любом случае"
                            },
                            {
                                "target_lang_word": "будь то",
                                "target_lang_sense_clarification": "неважно, какой из вариантов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7137acd6-9bec-3f2b-bca0-b575cc770a0a",
                    "sense_definition": "Introduces a direct question between two alternatives.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alternatives",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whether</w> is easier to say, your sins are forgiven or arise and walk?",
                            "target_lang_translations": {
                                "ru": "<w>Что</w> легче сказать: прощаются тебе грехи твои, или: встань и ходи?"
                            }
                        },
                        {
                            "text": "<w>Whether</w> had you rather be a king or a common man?",
                            "target_lang_translations": {
                                "ru": "<w>Кем</w> бы ты скорее был: королем или простым человеком?"
                            }
                        }
                    ],
                    "synonyms": [
                        "which"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature or religious texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводит прямой вопрос между двумя альтернативами (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "что",
                                "target_lang_sense_clarification": "который из двух (устар.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "341674ba-af78-30ed-82fb-6fe95c3343a5",
                    "sense_definition": "Which of the two.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was unclear to <w>whether</w> side the victory would eventually fall.",
                            "target_lang_translations": {
                                "ru": "Было неясно, на <w>чью</w> сторону в итоге склонится победа."
                            }
                        },
                        {
                            "text": "In the morning sow your seed, for you know not <w>whether</w> shall prosper.",
                            "target_lang_translations": {
                                "ru": "Утром сей семя твое, ибо ты не знаешь, <w>которое</w> из них будет успешнее."
                            }
                        }
                    ],
                    "synonyms": [
                        "whichever"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Который из двух (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "который",
                                "target_lang_sense_clarification": "из двух возможных (устар.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "027eeb14-6e7b-3d3e-8b49-be3f42be4100",
                    "sense_definition": "Which one of two people or things.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whether</w> of them two did the will of his father?",
                            "target_lang_translations": {
                                "ru": "<w>Кто</w> из двух исполнил волю отца?"
                            }
                        },
                        {
                            "text": "I told them we were in a country with gold, but we knew not <w>whether</w>.",
                            "target_lang_translations": {
                                "ru": "Я сказал им, что мы в стране, где есть золото, но мы не знали, в <w>какой</w> именно."
                            }
                        }
                    ],
                    "synonyms": [
                        "which"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "found in historical texts like the King James Bible"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кто или что из двух людей или предметов (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кто из двух",
                                "target_lang_sense_clarification": "выбор одного из пары (устар.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}