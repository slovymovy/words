                                                "example_id": "7930c996-3e97-47db-a55c-031b099847aa",
                                                "sense_id": "478e64c0-43aa-3a4a-a936-82db334d3965",
                                                "text": "Too many people die from breast cancer."
                                            }
                                        ]
