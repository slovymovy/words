                                        "entry_id": "6c422720-2dd7-3c76-b618-3d5765b5e1a7",
                                        "glosses": [
                                            "Recycling (Nederland) of recyclage (Vlaanderen) is het opnieuw gebruiken van materialen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918193a3-3e56-442e-aa5c-9a38168dac8b",
                                                "sense_id": "9750e2f3-b852-34db-ab3a-a0c32393223e",
