                "senses": [
                    {
                        "sense_id": "b0d9bb56-3968-35ef-a6e4-05dee708a609",
                        "entry_id": "5e6f8d9c-1e26-3827-afdc-9ac16bebbd89",
                        "glosses": [
                            "breite Vielfalt an Ansichten, Überzeugungen und Einstellungen innerhalb einer Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a2a9b5-6d0e-4a02-8946-301d186f895a",
                                "sense_id": "b0d9bb56-3968-35ef-a6e4-05dee708a609",
                                "text": "„Weder linke noch rechte Intoleranz dürfen das Meinungsspektrum unserer Demokratie in die Zange nehmen.“"
                            },
                            {
                                "example_id": "1d92b230-64ee-4821-bab6-3bd10db8559e",
                                "sense_id": "b0d9bb56-3968-35ef-a6e4-05dee708a609",
                                "text": "„Über Gebühr links? So lautet ein oft gehörter Vorwurf an die ARD. Dabei ist es ihr Auftrag, ein breites Meinungsspektrum abzubilden – ob in der Corona- oder in der Klimakrise.“"
                            },
                            {
                                "example_id": "27963ba7-1b85-46e5-8eb0-c6ef9226856e",
                                "sense_id": "b0d9bb56-3968-35ef-a6e4-05dee708a609",
                                "text": "„Von Zeit zu Zeit gibt es Kritik unter anderem aus Politik und Medienbranche sowie in sozialen Netzwerken, dass das Meinungsspektrum bei Kommentaren zum Beispiel in der ARD nicht ausgeglichen genug sei und es zu wenig konservative Stimmen gebe.“"
                            },
                            {
                                "example_id": "1c6f1c57-5747-42f9-8550-eff75236fe3a",
                                "sense_id": "b0d9bb56-3968-35ef-a6e4-05dee708a609",
                                "text": "„Sie haben sich spieltheoretisch einmal genauer angesehen, was passieren kann, wenn Abstimmungsteilnehmer ihre Information über das herrschende Meinungsspektrum überwiegend aus sozialen Netzwerken aggregieren.“"
                            },
                            {
                                "example_id": "e6fc3ba7-b45c-4011-823b-30d5e55e0b1f",
                                "sense_id": "b0d9bb56-3968-35ef-a6e4-05dee708a609",
                                "text": "„Nun aber gefährden die zunehmenden Repressionen des Regenbogens die pluralistische Demokratie der offenen Gesellschaft, indem sie das Meinungsspektrum einengen, das reagierende Ressentiment von rechts nähren und die demokratische Mitte zerreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
