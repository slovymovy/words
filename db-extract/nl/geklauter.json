                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb594efa-2e5b-47a1-9481-96381e88f49f",
                                                "sense_id": "20b98ab4-5929-32cc-9a2e-69c00f9493e7",
                                                "text": "It was his hope that he should find something of archaeologic compensation for his clamberings. He found Noah's Ark."
                                            }
