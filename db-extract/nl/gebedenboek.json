                    {
                        "sense_id": "5fde7329-09e6-3295-8507-fc6b4581751e",
                        "entry_id": "889918fb-dea5-3414-a461-35a0237996b8",
                        "glosses": [
                            "boek waarin door de kerk goedgekeurde gebeden staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fe1801d-6f8e-4d1e-9dc2-47ef209fe7e0",
                                "sense_id": "5fde7329-09e6-3295-8507-fc6b4581751e",
                                "text": "Ze durfde niets te vragen, trok zich weer terug en deed de deur dicht; nu eens ging ze in haar fauteuil zitten, dan weer pakte ze haar gebedenboek of knielde ze neer voor de iconen."
                            },
                            {
                                "example_id": "e840081f-b84c-43ef-bf0a-5ade4b19ac13",
                                "sense_id": "5fde7329-09e6-3295-8507-fc6b4581751e",
                                "text": "Bijzondere aankopen die het fonds steunt zijn bijvoorbeeld een middeleeuws gebedenboek voor het Joods Historisch Museum, een jonge Rembrandt voor De Lakenhal en een uniek skelet van een Tyrannosaurus Rex."
                            }
                        ]
                    }
