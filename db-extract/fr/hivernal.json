                    {
                        "form_id": "95f8964c-2104-4fb4-a9ef-0ce01a9a239b",
                        "entry_id": "a38eda7d-1dc1-346f-9b5d-4237c105c4a8",
                        "tags": [
                            "Moins courant"
                        ],
                        "form": "hibernal"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48c115d7-cef3-33d8-b058-2e70fbf1900c",
                        "entry_id": "a38eda7d-1dc1-346f-9b5d-4237c105c4a8",
                        "glosses": [
                            "Relatif à l’hiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a024436-f054-40ae-93fa-0e89cfaaa06a",
                                "sense_id": "48c115d7-cef3-33d8-b058-2e70fbf1900c",
                                "text": "Dans toute la vallée moyenne on observe généralement deux périodes de grande pluviosité : l’une hivernale (novembre-décembre), l’autre vernale (février-avril) […]"
                            },
                            {
                                "example_id": "0b207394-ca0c-4b81-b10b-00447cff892c",
                                "sense_id": "48c115d7-cef3-33d8-b058-2e70fbf1900c",
                                "text": "La coordonnatrice des bénévoles chez Accueil et Intégration Bas-Saint-Laurent, Colette Schoonbroodt, lui a fourni ses habits hivernaux, un bien nécessaire pour survivre aux rudes hivers de la région."
                            },
                            {
                                "example_id": "25b30da2-efed-47e5-b3a4-01e2c2e637e3",
                                "sense_id": "48c115d7-cef3-33d8-b058-2e70fbf1900c",
                                "text": "Avec 32 jours sans pluie (ou presque), la France a battu en février son record de sécheresse hivernale de 1989."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23112c9f-557a-44e9-9353-a333a7c7400c",
                        "source_entry_id": "a38eda7d-1dc1-346f-9b5d-4237c105c4a8",
                        "source_sense_id": "48c115d7-cef3-33d8-b058-2e70fbf1900c",
                        "target_lang_word": "winterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                        "entry_id": "2a72df60-190e-3d16-94a6-1d68a8b8cb7c",
                                        "glosses": [
                                            "charakteristisch für den Winter; dem Winter entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08e0a185-3ab7-49b9-a193-fce46f728681",
                                                "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                                "text": "„Mit Ausnahme der südlichen Landschaften war das Land rau und winterlich, von Natur aus eher zur Viehzucht als zum Ackerbau geeignet.“"
                                            },
                                            {
                                                "example_id": "9bc8148f-fac5-42fd-aec3-c17c5f75536e",
                                                "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                                "text": "„Während im übrigen Land noch winterliches Schmuddelwetter herrscht, ist es am Bodensee schon frühlingshaft mild.“"
                                            },
                                            {
                                                "example_id": "3c4c90f8-2e7f-4ed5-8162-0d4c3b5bd1bf",
                                                "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                                "text": "„Jeff Bridges reitet im zehnfach oscarnominierten Remake eines herbstlichen John-Wayne-Klassikers durch eine winterliche Welt.“"
                                            },
                                            {
                                                "example_id": "9e9fc3c9-c84d-407b-bb0b-4478f3418c5b",
                                                "sense_id": "dae1d15e-6f3d-361a-8bfb-f3dd73103657",
                                                "text": "„Auf dem Watzmann ist es selbst in dieser Jahreszeit noch winterlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0198155-1cde-4513-8b59-1cb475afe35f",
                        "source_entry_id": "a38eda7d-1dc1-346f-9b5d-4237c105c4a8",
                        "source_sense_id": "48c115d7-cef3-33d8-b058-2e70fbf1900c",
