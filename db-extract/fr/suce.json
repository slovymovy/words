                                "target_senses": [
                                    {
                                        "sense_id": "463f8ee5-564c-32e5-9d3c-dd9d23ae8d49",
                                        "entry_id": "95a5e998-a6b5-36b8-924c-d23ad743a9bb",
                                        "glosses": [
                                            "Gegenstand aus teils Latex oder Silikon, teils Gummi oder Kunststoff, an dem Babys oder Kleinkinder saugen, um ihr Saugbedürfnis zu stillen (und sie damit zu beruhigen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c705b145-fa1c-4345-9bf0-1a06cbf8d87b",
                                                "sense_id": "463f8ee5-564c-32e5-9d3c-dd9d23ae8d49",
                                                "text": "Findet euer Kleiner auch nur mit Schnuller in den Schlaf?"
                                            },
                                            {
                                                "example_id": "44004f32-d2ec-4816-b12c-aff9f670a9d4",
                                                "sense_id": "463f8ee5-564c-32e5-9d3c-dd9d23ae8d49",
                                                "text": "„Nur Babys brauchen einen Schnuller.“"
                                            },
                                            {
                                                "example_id": "1b19082a-49ed-4250-ac62-62ffcbd2c486",
                                                "sense_id": "463f8ee5-564c-32e5-9d3c-dd9d23ae8d49",
                                                "text": "„Die Enkelin nuckelte an einem großen Schnuller und versuchte einzuschlafen.“"
                                            },
                                            {
                                                "example_id": "e4d2a4a2-f9f6-4445-97d7-2f5ca47fc8d5",
                                                "sense_id": "463f8ee5-564c-32e5-9d3c-dd9d23ae8d49",
                                                "text": "„Schnell steckten sie Sung einen Schnuller in den Mund, wenn er nachts aufwachte und schrie.“"
                                            },
                                            {
                                                "example_id": "0e531211-7085-4c1a-94c0-630870e5e7a1",
                                                "sense_id": "463f8ee5-564c-32e5-9d3c-dd9d23ae8d49",
                                                "text": "„Das Weinen verstummte sofort, als der Kleine den Schnuller bekam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b8fd9d7-e6be-3d48-a651-afd4c87d5d1e",
                                        "entry_id": "95a5e998-a6b5-36b8-924c-d23ad743a9bb",
                                        "glosses": [
                                            "die mütterliche Brustwarze nachahmender Aufsatz aus Latex oder Silikon mit einem Loch, der auf eine Flaschenkopf gestülpt oder geschraubt wird, damit Säuglinge und Kleinkinder aus der Flasche ihr Trinken (vor allem Milch) saugen können"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1204467-6653-404b-b40b-fce77ed5d9f3",
                                                "sense_id": "0b8fd9d7-e6be-3d48-a651-afd4c87d5d1e",
                                                "text": "„Die meisten Kleinen sogen ihre Milch durch den Schnuller aus einer Flasche […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1d0cdf6f-a4d2-3a64-ad20-4427a4976b9f",
                                        "entry_id": "95a5e998-a6b5-36b8-924c-d23ad743a9bb",
                                        "glosses": [
                                            "männliches Geschlechtsorgan"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0237a756-86d4-4bc3-9c71-3244e4c76df3",
                                                "sense_id": "1d0cdf6f-a4d2-3a64-ad20-4427a4976b9f",
                                                "text": "„Er spielte fleißig ungeniert mit seinem Dings, dem kleinen Schnuller…“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7410e2c8-5ff7-31ae-94ba-f420f0a7b235",
                                        "entry_id": "95a5e998-a6b5-36b8-924c-d23ad743a9bb",
