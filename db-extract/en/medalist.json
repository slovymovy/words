                                                "text": "Les médaillés de sainte-Hélène."
                                            },
                                            {
                                                "example_id": "6463dd7a-f74e-4337-9197-2a35cb50bc03",
                                                "sense_id": "4923053c-fdc9-3b9a-ba82-dfc81308d5e1",
