                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "62c80111-9d5c-48da-a971-2046d1e89803",
                        "source_entry_id": "b863c3c9-0a75-3832-a2b2-460d3c779634",
                        "source_sense_id": "c4b51240-f566-328f-b4eb-ed92d983430a",
                        "source_sense_description": "taal die de standaardtaal is in een gebied waar ook dialecten worden gesproken",
                        "target_lang_word": "standard language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "standard language",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e4fc454-c00a-367b-8e74-ade3b4da4214",
                                        "entry_id": "ecda3dd0-d272-3b28-bbbf-51a3d0148420",
                                        "glosses": [
                                            "A form of a language that is institutionally promoted, regarded as the most correct or neutral variety, and is used by a population for public and formal purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b14376-bc01-43c1-9642-ce9ed1b1363e",
                                                "sense_id": "0e4fc454-c00a-367b-8e74-ade3b4da4214",
                                                "text": "In modern standard languages, norms of usage often seem to be superimposed by prescriptive norms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e58f7f11-3802-3291-8636-2f480c579f9e",
                                        "entry_id": "ecda3dd0-d272-3b28-bbbf-51a3d0148420",
                                        "glosses": [
                                            "A language that has a standard form as one of its varieties; a language that has undergone standardization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d38aec-6109-41ca-add1-f91883a96dc3",
                                                "sense_id": "e58f7f11-3802-3291-8636-2f480c579f9e",
                                                "text": "Some remain clusters of dialects like those of the Pamirs; others are at varying levels of stabilisation; some may be young standard languages, having only recently achieved that status; [...]"
                                            },
                                            {
                                                "example_id": "b60386ba-9fd6-4896-9aa6-a9a80f2a8ab3",
                                                "sense_id": "e58f7f11-3802-3291-8636-2f480c579f9e",
                                                "text": "Not all standard languages have the backing of institutions such as the Académie française. English is a good example of a standard language without such a regulatory body."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
