                "senses": [
                    {
                        "sense_id": "bdbd70dc-4c53-3523-8881-4b291ae2471b",
                        "entry_id": "ed292dcf-a85a-3134-97d9-c1a00681c928",
                        "glosses": [
                            "Fête religieuse de l’islam."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd25ef3d-a9a5-4d6a-9dbe-6563f7241174",
                                "sense_id": "bdbd70dc-4c53-3523-8881-4b291ae2471b",
                                "text": "Cet Aïd est pour nous tous un Aïd d'espoir ; espoir en une paix proche et en des jours à venir de bonheur ; espoir en une vie fraternelle, en des Aïds de joie, des Aïds qui feront de tous les enfants, des enfants heureux et confiants en l'avenir."
                            }
                        ]
                    },
                    {
                        "sense_id": "c016f44c-6ae4-3b3f-9545-5c5dae8ccda8",
                        "entry_id": "ed292dcf-a85a-3134-97d9-c1a00681c928",
                        "glosses": [
                            "Aïd el-Kebir."
                        ],
                        "tags": [
                            "especially",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a60914ea-e15e-4e76-9288-2bb391373b71",
                                "sense_id": "c016f44c-6ae4-3b3f-9545-5c5dae8ccda8",
                                "text": "« Cette année, deux abattoirs étaient agréés dans l’Oise pour pratiquer l’abattage rituel dans le cadre de l’Aïd-el-Kébir, l’abattoir pérenne de la société Bigard à Formerie, et l’abattoir temporaire « Les abattoirs de Creil », agréé pour la durée de l’Aïd, nous a précisé le cabinet de la Préfète de l’Oise."
                            },
                            {
                                "example_id": "640f9cc3-2ad6-4382-b984-891248472940",
                                "sense_id": "c016f44c-6ae4-3b3f-9545-5c5dae8ccda8",
                                "text": "Chaque point sur cette image correspond à une des 100 000 personnes participant aux rassemblements pour l' Aïd à Narayanganj, au Bangladesh."
                            }
                        ]
                    }
