                            "plural"
                        ],
                        "form": "die Geldpolitiken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "68e51e68-9267-3288-b71f-8001158b4d87",
                        "entry_id": "3dd4dfc9-fffb-35ab-9ec3-d7a75cd68d92",
                        "glosses": [
                            "Gesamtheit aller wirtschaftspolitischen Maßnahmen, die eine Regierung oder Zentralbank ergreift, um ihre Ziele zu verwirklichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f3f229e-056f-415d-98bd-2d8c154941e2",
                                "sense_id": "68e51e68-9267-3288-b71f-8001158b4d87",
                                "text": "„Es fehlte eine zentrale Instanz, die die Geldpolitik koordinierte und die Banken kontrollierte.“"
                            },
                            {
                                "example_id": "ccb4a64b-ea8d-4ba6-be6c-239f13d9aa91",
                                "sense_id": "68e51e68-9267-3288-b71f-8001158b4d87",
                                "text": "„Weitere Faktoren sind die geopolitischen Risiken und die Geldpolitik der grossen Länder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2552a45-0c52-435b-a95e-39b81c059f57",
                        "source_entry_id": "3dd4dfc9-fffb-35ab-9ec3-d7a75cd68d92",
                        "source_sense_id": "68e51e68-9267-3288-b71f-8001158b4d87",
                        "target_lang_word": "货币政策",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2c08b665-a14e-4aec-9921-6e407508993a",
                        "source_entry_id": "3dd4dfc9-fffb-35ab-9ec3-d7a75cd68d92",
                        "source_sense_id": "68e51e68-9267-3288-b71f-8001158b4d87",
                        "target_lang_word": "monetary policy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monetary policy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1106839a-1af2-31f2-a75d-dc5450e0db5b",
                                        "entry_id": "3b403c67-ce5b-3588-b288-1b968d89bf69",
                                        "glosses": [
                                            "The process by which the government, central bank, or monetary authority manages the supply of money, or trading in foreign exchange markets."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5089964c-811d-4b42-b100-c6278c67d859",
                                                "sense_id": "1106839a-1af2-31f2-a75d-dc5450e0db5b",
                                                "text": "So what’s the Fed to do? It must manage interest rates without a working monetary policy compass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3139b45-b617-4294-85c0-00e8b112d7ab",
                        "source_entry_id": "3dd4dfc9-fffb-35ab-9ec3-d7a75cd68d92",
                        "source_sense_id": "68e51e68-9267-3288-b71f-8001158b4d87",
                        "target_lang_word": "politique monétaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politique monétaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40cf859c-5600-3e57-b085-30b1ff10a254",
                                        "entry_id": "61fd414e-783f-35c0-90bd-41e454ca6267",
                                        "glosses": [
                                            "Levier par lequel l'autorité monétaire, généralement la banque centrale, agit sur l’offre de monnaie dans le but de remplir ses objectifs."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "102634cb-ec06-410a-803e-cb2bb45654a3",
                                                "sense_id": "40cf859c-5600-3e57-b085-30b1ff10a254",
                                                "text": "Si les banques centrales n'étaient plus obligées d'intervenir sur les marchés des changes pour maintenir la fixité des taux, les gouvernements pourraient utiliser la politique monétaire pour réaliser l'équilibre intérieur et extérieur."
                                            },
                                            {
                                                "example_id": "26bf3a09-e8c2-479b-a693-3aede5295b12",
                                                "sense_id": "40cf859c-5600-3e57-b085-30b1ff10a254",
                                                "text": "À ces avantages souvent soulignés dans la littérature, on peut ajouter que les politiques d'Inflation Targeting augmentent souvent la crédibilité de la politique monétaire car elles soulignent la réactivité de la banque centrale aux variations de l'inflation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
