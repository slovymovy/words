                ],
                "translations": [
                    {
                        "translation_id": "57edc9ec-375e-491c-add5-f697e32bae5a",
                        "source_entry_id": "4ff09c0b-65c1-3fc2-92c3-499669e57d18",
                        "source_sense_id": "97009d75-8f4b-372c-a638-0e8c11496ea6",
