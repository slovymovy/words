                        "glosses": [
                            "Sport, der in der Schule ausgeübt wird, Teil des Schulunterrichts ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02c23273-1d0d-404f-86ce-4c5a01a4fc59",
                                "sense_id": "0058756b-cdb0-3157-8c0c-cc14dbf82723",
                                "text": "„Ich stelle mir vor, wie ich meiner Tochter beim Schulsport zuschaue, sehe ihre Zöpfe und ihre Sommersprossen und wie ich mit ihr an der Hand den Strand entlangspaziere, während sie in der anderen Hand einen Eimer mit einer kleinen Schaufel hält.“"
                            }
                        ],
