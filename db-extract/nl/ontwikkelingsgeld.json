                        "glosses": [
                            "geld dat aan een land wordt gegeven in het kader van de ontwikkelingssamenwerking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "806bb416-50a5-40b0-8c3e-c5c1d7f249ad",
                                "sense_id": "77c9e9e2-0eb2-35d6-9f51-7a68b99d2cde",
                                "text": "De VVD wil opheldering van minister Ploumen (Ontwikkelingssamenwerking) over miljoenen Nederlands ontwikkelingsgeld voor Zuid-Soedan dat in rook is opgegaan door de burgeroorlog in dat Afrikaanse land. Daarover schreef de Volkskrant vanmorgen."
                            },
                            {
                                "example_id": "e93b8711-776f-4ddd-88df-3a41389d5558",
                                "sense_id": "77c9e9e2-0eb2-35d6-9f51-7a68b99d2cde",
                                "text": "Door een rammelende subsidieboekhouding van de Nederlandse Antillen is van 270 miljoen aan ontwikkelingsgeld niet te achterhalen of dat goed is besteed. Bovendien is met een deel van de subsidies gefraudeerd, meldt het AD."
                            },
                            {
                                "example_id": "91afb944-506b-442f-b42f-3872cbcd31f0",
                                "sense_id": "77c9e9e2-0eb2-35d6-9f51-7a68b99d2cde",
                                "text": "Minister Lilianne Ploumen (Ontwikkelingssamenwerking) liet weten niet te zullen schromen om ontwikkelingsgeld in te zetten als drukmiddel, maar zover is het volgens haar nog niet. De missie verkeert nog in de opbouwfase en ze wil ook de bevolking niet direct in de steek laten."
                            }
                        ]
