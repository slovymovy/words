                ],
                "senses": [
                    {
                        "sense_id": "e558aa5f-85d9-30fa-b23f-6c4134710687",
                        "entry_id": "15880a22-127a-314b-885e-57052d4b5740",
                        "glosses": [
                            "кулин. русское национальное блюдо — горячий суп на огуречном рассоле, приправленный солёными огурцами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12f20644-305f-4f8e-868e-c673520daa4f",
                                "sense_id": "e558aa5f-85d9-30fa-b23f-6c4134710687",
                                "text": "Варите рассольник до готовности, положив в самом конце лавровый лист, перец и посолив по вкусу."
                            },
                            {
                                "example_id": "bc3cb0ed-4633-4156-bd54-d7d981b15348",
                                "sense_id": "e558aa5f-85d9-30fa-b23f-6c4134710687",
                                "text": "Однажды после обеда Лев Степанович, употребивши довольно рассольника с потрохами, жирной индейки и разных сдобных и слоёных пирожков и смочив всё это кислыми щами, перешёл в гостиную закусить обед арбузом и выпить княжевишной наливки."
                            }
                        ]
                    }
                ],
