    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                "word": "Ralph",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a07d1aa6-6d22-34ab-9d18-4e7b887d75b3",
                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                        "glosses": [
                            "A male given name from the Germanic languages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "606371aa-0e3a-4311-b65b-c603b04519df",
                                "sense_id": "a07d1aa6-6d22-34ab-9d18-4e7b887d75b3",
                                "text": "There were none fine but Adam, Ralph, and Gregory: / The rest were ragged, old, and beggarly"
                            },
                            {
                                "example_id": "3657cc4e-1be4-40d1-bc22-919fb471da31",
                                "sense_id": "a07d1aa6-6d22-34ab-9d18-4e7b887d75b3",
                                "text": "Regarding the correct pronunciation, especially of the name Ralph: according to a friend at the BBC, the possibilities of this name - either aristocratic 'Rafe' or vulgar, almost Australasian 'Ralff' - lie in its potential for wilful mispronunciation against type. I saw him cast confusion into an over-confident studio guest by introducing him as 'Sir Rafe Halpern'. This was nothing to the consternation, almost disintegration of the personality, of the artistic, aloof actor brought on as 'Rolf Fiennes' ('Fiennes', naturally, pronounced superbly)."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f1b32e7-8104-3419-94da-7368f769cc2b",
                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                        "glosses": [
                            "A surname originating as a patronymic."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "77bc2a75-6a7d-3a11-b386-d767eea87362",
                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                        "glosses": [
                            "Fictional person used in references to vomiting."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8a978933-28b9-4543-bc41-980e63269c82",
                                "sense_id": "77bc2a75-6a7d-3a11-b386-d767eea87362",
                                "text": "He's outside calling Ralph [i.e. vomiting]."
                            }
                        ]
                    },
                    {
                        "sense_id": "a93d94dc-7650-3b42-94cc-d6a61d3efb6e",
                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                        "glosses": [
                            "An unincorporated community in Harding County, South Dakota, United States."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5ebce03e-ff46-352d-aca8-060bacf7d9b0",
                        "entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                        "glosses": [
                            "An unincorporated community in Webster County, West Virginia, United States."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce2b4794-5500-4e71-aecc-15ea66652844",
                        "source_entry_id": "d75c448a-ac56-31c5-88bc-c43012495960",
                        "source_sense_description": "male given name",
                        "target_lang_word": "Raoul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Raoul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                                        "entry_id": "d4acc6eb-c2b8-32c1-8e22-ead7517a7d4d",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38c9161b-208c-45ce-ba78-2b73950f02fd",
                                                "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                                                "text": "– Arsène Lupin ou Raoul d’Andrésy, qu’importe ! L’essentiel, c’est de réussir."
                                            },
                                            {
                                                "example_id": "569e0298-8ece-48ad-95de-3005d7f471cc",
                                                "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                                                "text": "Raoul n’était pas un Lovelace. Bien des sentiments de probité et de délicatesse s’opposaient en lui au déchaînement d’instincts et d’appétits dont il connaissait la violence excessive."
                                            },
                                            {
                                                "example_id": "664ff3e9-3f0d-426d-8e63-0a979d6c6ed5",
                                                "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                                                "text": "Résultat : ils n’en auront pas ! Nous les mangerons nous deux, Raoul…"
                                            },
                                            {
                                                "example_id": "40131e95-dd0f-4857-9e40-8bcc46ddb4a9",
                                                "sense_id": "65623a47-ecd4-3f60-990f-6921c9c2cf29",
                                                "text": "La glose est définitoire, ce qui autorise Raoul de Presles à ne pas redéfinir ou regloser le terme dans la deuxième occurrence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Raoul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d3e35d3-be92-309e-a95b-ad6a2c47ce61",
                                        "entry_id": "45ac8c87-dfd4-363d-97f9-b54946818977",
                                        "glosses": [
                                            "Capitaine de soirée."
                                        ],
                                        "tags": [
                                            "Luxembourg"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Raoul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c77ecb1c-50d0-3f69-abab-075ffdd4f891",
                                        "entry_id": "80b7ed44-8e4c-3ccb-b8ba-37a7ce16e011",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "395d07a3-c530-4b1e-b5bf-323ae82ab230",
                                                "sense_id": "c77ecb1c-50d0-3f69-abab-075ffdd4f891",
                                                "text": "Après deux ans d’une pause forcée, Stéphane Quéré et Gurvan Raoul, agriculteurs au hameau de Kerantosfal, renouent avec la tradition et proposent jeudi, de 17 h à 22 h, un marché en fête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
