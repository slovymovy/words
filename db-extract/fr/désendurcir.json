                ],
                "senses": [
                    {
                        "sense_id": "78a6e1bc-e812-3c77-8faf-6e5f029e8459",
                        "entry_id": "261467a7-66c7-3a43-b00d-389894d20a80",
                        "glosses": [
                            "Faire perdre son caractère endurci à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8f4c84a-b996-4368-b660-9ec6e137994c",
                                "sense_id": "78a6e1bc-e812-3c77-8faf-6e5f029e8459",
                                "text": "Désendurcir les cœurs, pour comprendre l’Évangile."
                            },
                            {
                                "example_id": "91e2d9a3-de3a-4536-bcbb-4d79a400b2ec",
                                "sense_id": "78a6e1bc-e812-3c77-8faf-6e5f029e8459",
                                "text": "Inversement, au printemps, les tissus se désendurcissent, ce qui leur permet d’ailleurs de reprendre leur croissance."
                            },
                            {
                                "example_id": "3f09be7c-9ad2-4720-bece-6d29efd86d34",
                                "sense_id": "78a6e1bc-e812-3c77-8faf-6e5f029e8459",
                                "text": "Comme cela a été observé chez le cabernet sauvignon et le cabernet franc (Wolf et al, 1991), la vitesse de la perte de la tolérance au froid des bourgeons varie selon la nature du cépage : le pinot noir se désendurcit plus rapidement que le chardonnay."
                            },
                            {
                                "example_id": "19d08df2-0100-4899-8534-6f5b818ae95f",
                                "sense_id": "78a6e1bc-e812-3c77-8faf-6e5f029e8459",
                                "text": "Jeunes gens, désendurcissez-vous !"
                            }
                        ]
                    }
                ],
