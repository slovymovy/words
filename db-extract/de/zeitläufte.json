                        "entry_id": "0a33f95d-f889-3d07-bda0-29d82ee916da",
                        "glosses": [
                            "ein mit bestimmten Ereignissen erfüllter Zeitabschnitt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c53c8469-b41f-4272-86ff-a9c4d23acd16",
                                "sense_id": "eba2fd7c-8212-3656-ba53-30629b093bf1",
                                "text": "„Auch wenn die Zeitläufte dagegen sprachen, schaute ich in Lohmanns glänzendes, treuherziges Gesicht und glaubte ihm.“"
                            },
                            {
                                "example_id": "c3a2d387-f6a0-4800-a0cc-aafa983e29e0",
                                "sense_id": "eba2fd7c-8212-3656-ba53-30629b093bf1",
                                "text": "„Pückler bewundert ihn sehr dafür, aber auch, daß Barras es geschafft hat, als Lebemann und homme à femme die schwierigsten Zeitläufte zu überstehen.“"
                            },
                            {
                                "example_id": "c8854c28-9e4a-4846-afaf-d3e8deb12c59",
                                "sense_id": "eba2fd7c-8212-3656-ba53-30629b093bf1",
                                "text": "„Da, in Zornhof, bei der Inge kam es in Anbetracht unserer Lage und der Zeitläufte nicht in Frage, daß ich den Kostverächter spielte…“"
                            },
                            {
                                "example_id": "ae8f571b-776d-4b09-a56d-06aac79342c7",
                                "sense_id": "eba2fd7c-8212-3656-ba53-30629b093bf1",
                                "text": "„Die Ökonomik ist eine Wissenschaft der Dynamik des Wandels der Gesellschaft, des Fortschritts, der Veränderungen durch neue Technologien, der Unberechenbarkeit der Zeitläufte.“"
                            }
                        ],
