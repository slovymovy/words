                "senses": [
                    {
                        "sense_id": "1461d49d-84e8-3c01-a948-3f4b0963367d",
                        "entry_id": "9c4e3aa2-fdb6-3d6b-ad35-e25d773f701e",
                        "glosses": [
                            "Donner un caractère perceptuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3992b64-bd89-4ef9-84be-ad6936151fd7",
                                "sense_id": "1461d49d-84e8-3c01-a948-3f4b0963367d",
                                "text": "Dans la perspective scientifique, on ne peut pas perceptualiser Dieu sous une forme matérielle, du fait que la nature divine est insondable, et par conséquent, hors de la portée humaine. pourtant, il y a des indice, des phénomènes qui prouvent son existence; en vertu de quoi, on constate qu'Il est tout puissant et omniscient."
                            },
                            {
                                "example_id": "f2b8d1ef-3821-4c6d-bcb7-e0b05e70ad68",
                                "sense_id": "1461d49d-84e8-3c01-a948-3f4b0963367d",
                                "text": "Il convient à présent de voir sous quelles formes se concrétisent ou se perceptualisent (au sens d'une mise en scène visant la perception) les réactualisations du deuil originaire au moment de chaque nouvelle situation de deuil."
                            }
                        ]
                    }
