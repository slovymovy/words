                    {
                        "sense_id": "a8e19b52-68e1-3473-9110-4af8385e95f1",
                        "entry_id": "d5857fc9-b09b-329c-91f2-def66aae330d",
                        "glosses": [
                            "выпускник медицинского института, проходящий интернатуру"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f312f403-3ded-4fde-9bab-a7f9e23483c7",
                                "sense_id": "a8e19b52-68e1-3473-9110-4af8385e95f1",
                                "text": "Стать интерном — идеал всякого студента-медика, так как, будучи студентом, интерн уже имеет за собой большую практику, и когда кончает курс — выходит опытным и знающим врачом."
                            }
                        ]
                    }
                ],
