                        "examples": [
                            {
                                "example_id": "e46b8ae2-3d12-463c-a723-b7678b61559c",
                                "sense_id": "1cc5fc13-238e-39a2-be88-4d37c97b8bef",
                                "text": "… même si, comme le pensent et le disent beaucoup de huit-marsistes, Nagib Mikati s’est révélé au bout du compte être plus haririen que nature …."
                            },
                            {
                                "example_id": "500925ef-9e7d-4e2f-9a83-7e0fd4237edc",
                                "sense_id": "1cc5fc13-238e-39a2-be88-4d37c97b8bef",
                                "text": "Il était clair pourtant, dès le début, que n’ayant pu mettre sur pied une équipe ministérielle qu’avec l’appoint des centristes, les huit-marsistes se devaient de prendre en compte cette faiblesse congénitale et agir en fonction."
                            }
                        ]
                    }
