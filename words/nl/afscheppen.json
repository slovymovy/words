{
    "word_family": [
        "scheppen",
        "opscheppen",
        "uitscheppen",
        "afschepper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0e58d6fd-d8b4-3104-b868-34ab30e3b7a8",
                    "sense_definition": "Met een lepel, schep of spaan een bovenlaag van een vloeistof verwijderen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistof_verwijderen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet eerst het vet van de soep <w>afscheppen</w> voordat je deze serveert.",
                            "target_lang_translations": {
                                "en": "You must first <w>skim</w> the fat off the soup before serving it."
                            }
                        },
                        {
                            "text": "Er zijn speciale boten ingezet om de olie van het wateroppervlak te <w>afscheppen</w>.",
                            "target_lang_translations": {
                                "en": "Special boats have been deployed to <w>skim</w> the oil off the water's surface."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vet afscheppen",
                        "olie afscheppen"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove the top layer of a liquid using a spoon, ladle, or skimmer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "skim",
                                "target_lang_sense_clarification": "removing a layer from a liquid"
                            },
                            {
                                "target_lang_word": "skim off",
                                "target_lang_sense_clarification": "removing fat or oil from the surface"
                            },
                            {
                                "target_lang_word": "ladle off",
                                "target_lang_sense_clarification": "scooping off the top layer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "439e6be7-9190-32ae-8f57-cb3831cbc818",
                    "sense_definition": "Iets minder belangrijk of groots maken; onzin of overdrijvingen uit een verhaal verwijderen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nuanceren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij probeerde de wilde geruchten over haar relatie flink te <w>afscheppen</w>.",
                            "target_lang_translations": {
                                "en": "She tried hard to <w>tone down</w> the wild rumors about her relationship."
                            }
                        },
                        {
                            "text": "Laat ik dat overdreven verhaal eerst eens een beetje <w>afscheppen</w>.",
                            "target_lang_translations": {
                                "en": "Let me first <w>deflate</w> that exaggerated story a bit."
                            }
                        }
                    ],
                    "synonyms": [
                        "debunken",
                        "nuanceren"
                    ],
                    "common_phrases": [
                        "een verhaal afscheppen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe downplaying or debunking exaggerated stories."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To tone down, debunk, or remove exaggerations and nonsense from a story or rumor."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tone down",
                                "target_lang_sense_clarification": "making a story less extreme or exaggerated"
                            },
                            {
                                "target_lang_word": "debunk",
                                "target_lang_sense_clarification": "exposing false or exaggerated claims"
                            },
                            {
                                "target_lang_word": "deflate",
                                "target_lang_sense_clarification": "reducing the exaggeration of a story"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}