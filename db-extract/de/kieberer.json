                "senses": [
                    {
                        "sense_id": "619f7800-b1fb-30b9-815d-4f3f249c298e",
                        "entry_id": "5b0aa281-4cb6-3978-8bda-8e883db409af",
                        "glosses": [
                            "Angehöriger der Polizei"
                        ],
                        "tags": [
                            "Austrian German",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "67071a9c-cc3a-4332-bfe1-520f630b62a2",
                                "sense_id": "619f7800-b1fb-30b9-815d-4f3f249c298e",
                                "text": "„Der Kieberer hat aber nach wie vor mit analogen Verbrechen genug zu tun, zum Beispiel mit Einbrüchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01e71202-21ff-4414-bced-7b0dfc2efcd9",
                        "source_entry_id": "5b0aa281-4cb6-3978-8bda-8e883db409af",
                        "source_sense_id": "619f7800-b1fb-30b9-815d-4f3f249c298e",
                        "source_sense_description": "österreichisch, abwertend, vor allem wienerisch: Angehöriger der Polizei",
                        "target_lang_word": "cop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe883a2a-04c3-3a20-a616-baf27598340d",
                                        "entry_id": "c402ba5f-a749-3b65-8709-929dc782db20",
                                        "glosses": [
                                            "To obtain, to purchase (items including but not limited to drugs), to get hold of, to take."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "484eea5f-2dd4-4364-9d6b-8a9197b84e1a",
                                                "sense_id": "fe883a2a-04c3-3a20-a616-baf27598340d",
                                                "text": "You see yourself as the kind of guy who wakes up early on Sunday morning and steps out to cop the Times and croissants."
                                            },
                                            {
                                                "example_id": "1c39e2f8-21ec-49b3-94fb-9e5294eb04f4",
                                                "sense_id": "fe883a2a-04c3-3a20-a616-baf27598340d",
                                                "text": "He sold me a bulging paper sack full of Cambodian Red for two dolla' MPC. A strange experience, copping from a kid, but it was righteous weed."
                                            },
                                            {
                                                "example_id": "222c55fd-bb11-4386-a355-277d280c21ad",
                                                "sense_id": "fe883a2a-04c3-3a20-a616-baf27598340d",
                                                "text": "Heroin appeared on the streets of our town for the first time, and Innie watched helplessly as his sixteen-year-old brother began taking the train to Harlem to cop smack."
                                            },
                                            {
                                                "example_id": "433346c6-0ca3-4ac1-af32-9fa9d2d97b19",
                                                "sense_id": "fe883a2a-04c3-3a20-a616-baf27598340d",
                                                "text": "Off the juice, codeine got me trippin' copped the coupe, woke up, roof is missin'..."
                                            },
                                            {
                                                "example_id": "4679941e-19f3-4434-9f5e-22d7c7954f24",
                                                "sense_id": "fe883a2a-04c3-3a20-a616-baf27598340d",
                                                "text": "Uh, copped a BMW, new deposit, I picked up another bag Like fuck it, I'ma count while I'm in it..."
                                            },
                                            {
                                                "example_id": "19eb471b-db22-40f3-b500-ab4388b08807",
                                                "sense_id": "fe883a2a-04c3-3a20-a616-baf27598340d",
                                                "text": "Oh, come on. Help a brother out. People see you coppin', might inspire them. Look, I know you ain't payin' bills right now. Man must have bare peas saved up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68299f21-b8b7-3620-89af-026c607c40b9",
                                        "entry_id": "c402ba5f-a749-3b65-8709-929dc782db20",
                                        "glosses": [
                                            "To (be forced to) take; to receive; to shoulder; to bear, especially blame or punishment for a particular instance of wrongdoing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9886fed7-6ddf-4f0c-9186-3df357561f16",
                                                "sense_id": "68299f21-b8b7-3620-89af-026c607c40b9",
                                                "text": "When caught, he would often cop a vicious blow from his father."
                                            },
                                            {
                                                "example_id": "2283eafe-fb41-4035-90a1-057ca98e2403",
                                                "sense_id": "68299f21-b8b7-3620-89af-026c607c40b9",
                                                "text": "I take no shame to fight the lame / When they deserve to cop it."
                                            },
                                            {
                                                "example_id": "823f2c9b-03de-408a-846e-5431afd1a904",
                                                "sense_id": "68299f21-b8b7-3620-89af-026c607c40b9",
                                                "text": "You bust in the house, another bitch’s mouth is suckin on your man's dick\nWhat do you do: think straight? Or do you run to the back,\nOpen the trunk to the nickel-plate 38?\n“Wait wait, baby, please!”\nThat's the shit he's coppin when he’s down on both his knees"
                                            },
                                            {
                                                "example_id": "242eff01-9a81-4052-a0e0-8a17f69cee99",
                                                "sense_id": "68299f21-b8b7-3620-89af-026c607c40b9",
                                                "text": "I now understand that my dad didn't really have much of a father-son relationship and may have found my behaviour hard to deal with. Maybe that is why I copped a beating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec64b7a5-9936-39ab-b706-0efab7082c16",
                                        "entry_id": "c402ba5f-a749-3b65-8709-929dc782db20",
                                        "glosses": [
                                            "To see and record a railway locomotive for the first time."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8a5a047-b739-332a-ac1a-7a9bf532b4a1",
                                        "entry_id": "c402ba5f-a749-3b65-8709-929dc782db20",
                                        "glosses": [
                                            "To steal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d838a1-11e9-41e3-87f9-72bd72050ccc",
                                                "sense_id": "b8a5a047-b739-332a-ac1a-7a9bf532b4a1",
                                                "text": "Copycat tryna cop my manner / Watch your back when you can't watch mine / Copycat tryna cop my glamor / Why so sad, bunny? Can't have mine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5196ddd-0024-3e57-89f8-eed09db95261",
                                        "entry_id": "c402ba5f-a749-3b65-8709-929dc782db20",
                                        "glosses": [
                                            "To adopt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c32a8af2-cf9d-4e73-81f3-612db29c870d",
                                                "sense_id": "b5196ddd-0024-3e57-89f8-eed09db95261",
                                                "text": "No need to cop a 'tude with me, junior."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6baa5692-4edd-3a41-98e9-e3a89db13f0b",
                                        "entry_id": "c402ba5f-a749-3b65-8709-929dc782db20",
                                        "glosses": [
                                            "To admit, especially to a crime or wrongdoing."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8270a14e-1f7f-4b0d-91f5-9843c3aa0991",
                                                "sense_id": "6baa5692-4edd-3a41-98e9-e3a89db13f0b",
                                                "text": "I already copped to the murder. What else do you want from me?"
                                            },
                                            {
                                                "example_id": "e421194a-ba81-48a3-b5f7-70db29cbd51a",
                                                "sense_id": "6baa5692-4edd-3a41-98e9-e3a89db13f0b",
                                                "text": "Harold copped to being known as \"Dirty Harry\"."
                                            },
                                            {
                                                "example_id": "9b3b5411-8eb4-41b1-9d98-01920a1bf156",
                                                "sense_id": "6baa5692-4edd-3a41-98e9-e3a89db13f0b",
                                                "text": "He shot a guy in a bar on Martin Luther King Day and copped to first-degree manslaughter"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1ce662-419b-305d-a505-0fbf50628f11",
                                        "entry_id": "c402ba5f-a749-3b65-8709-929dc782db20",
                                        "glosses": [
                                            "To recruit a prostitute into the stable."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "948e99f8-70eb-4d92-a0df-f0cc8fb13287",
                                                "sense_id": "eb1ce662-419b-305d-a505-0fbf50628f11",
                                                "text": "I said, 'Tell your tricks to call you here.'\nShe laid the bearskin and freaked the joint off with her lights and other crap. Except for the fake stars it was a fair mock-up of her pad where I had copped her."
                                            },
                                            {
                                                "example_id": "283da437-ece4-4400-8cf1-80825be1f224",
                                                "sense_id": "eb1ce662-419b-305d-a505-0fbf50628f11",
                                                "text": "The code was to call a pimp and tell him you have his hoe plus turn over her night trap but that was bull because the HOE was out of his stable months before I copped her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cdcfd6b-7205-3346-ae32-19c3e99d07cc",
                                        "entry_id": "c402ba5f-a749-3b65-8709-929dc782db20",
                                        "glosses": [
                                            "To take (a look, glance, etc.)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ff25849-400d-43a4-a826-d756a2af76f0",
                                                "sense_id": "7cdcfd6b-7205-3346-ae32-19c3e99d07cc",
                                                "text": "Cop an eyeful of this!"
                                            }
                                        ]
                                    }
                                ]
                            },
