                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d5db0a-aab5-4340-bbc7-3183e26219a9",
                                "sense_id": "824f7ceb-aa9f-31ad-8c47-8fe826824a4e",
                                "text": "W tym tumulcie z łatwością udało się uniknąć pościgu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e2bd2b3e-454f-3278-a265-3bb3b1990f10",
