                ],
                "senses": [
                    {
                        "sense_id": "21a6a9e5-a88c-3c4c-ab04-3343482164b5",
                        "entry_id": "1790dd50-46cc-3f00-a756-4002291ec1fb",
                        "glosses": [
                            "To destroy the composure of; to disturb or agitate."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d53db1ac-bb34-45ec-886b-4d14bc182154",
                                "sense_id": "21a6a9e5-a88c-3c4c-ab04-3343482164b5",
                                "text": "I am glad I have done being in love with him. I should not like a man who is so soon discomposed by a hot morning."
                            },
                            {
                                "example_id": "9e5272ad-5472-4f3e-a62d-f85ab4e2aa99",
                                "sense_id": "21a6a9e5-a88c-3c4c-ab04-3343482164b5",
                                "text": "You will not be discomposed by the Lord Chancellor, I dare say?"
                            },
                            {
                                "example_id": "95f8160b-f941-4725-be5f-b732fc4dceae",
                                "sense_id": "21a6a9e5-a88c-3c4c-ab04-3343482164b5",
                                "text": "That thought appeared to discompose her greatly, though Jasper made light of it by rapidly back-scratching with his hind legs and giving a short stern bark, just to assure her that strangers would be rushed off the property on sight."
                            }
                        ]
                    },
                    {
                        "sense_id": "73ba39fb-61a1-3b05-8d36-1e6a13213443",
                        "entry_id": "1790dd50-46cc-3f00-a756-4002291ec1fb",
                        "glosses": [
                            "To disarrange, or throw into a state of disorder."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d028b37d-636a-4387-ae34-520a50a41330",
                                "sense_id": "73ba39fb-61a1-3b05-8d36-1e6a13213443",
                                "text": "If e'er with airy horns I planted heads,\nOr rumpled petticoats, or tumbled beds,\nOr caus'd suspicion when no soul was rude,"
                            }
                        ]
                    }
                ],
