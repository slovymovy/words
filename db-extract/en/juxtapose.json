                                "sense_id": "0b241ab6-9bfe-331d-9e2d-071f05997811",
                                "text": "The documentary effectively juxtaposes the lives of two rival politicians."
                            },
                            {
                                "example_id": "20accd57-6223-4f87-9a43-83f6fb83c677",
                                "sense_id": "0b241ab6-9bfe-331d-9e2d-071f05997811",
                                "text": "In the study, they juxtaposed economic growth with social welfare indicators."
                            }
                        ]
