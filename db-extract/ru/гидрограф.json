                                        "entry_id": "ac643119-c720-3edb-9f48-b058fafd61de",
                                        "glosses": [
                                            "A graph of water table versus time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "890478fe-b18e-4c74-a9f7-58341d0f377d",
                                                "sense_id": "2db598e0-8d14-31e8-be58-fe4b4591e110",
                                                "text": "A comparison of Silurian dolomite aquifer water-level hydrographs and pumpage graphs indicates that in general water-level decline is directly proportional to pumpage and suggests that recharge balances discharge."
                                            }
                                        ]
