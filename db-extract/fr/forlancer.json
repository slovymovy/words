                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2776ac9-553a-47d9-8722-7bf09a9393b9",
                        "source_entry_id": "0b4547f1-3a00-3ee5-9fb7-946121cbd771",
                        "source_sense_id": "cf561607-81b0-3942-af36-38d4e83d90eb",
                        "target_lang_word": "verjagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verjagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73b63116-788b-3c18-b100-7ee405c0dc2b",
                                        "entry_id": "dda01257-858f-3d43-aeb5-93540a247e58",
                                        "glosses": [
                                            "jemanden gewaltsam vertreiben, verscheuchen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef817c2-02fb-45bf-a87c-53a6b9720b1d",
                                                "sense_id": "73b63116-788b-3c18-b100-7ee405c0dc2b",
                                                "text": "Er wurde wie ein Hund verjagt."
                                            },
                                            {
                                                "example_id": "f76f1e08-81a3-4a86-8b9e-9a64d9a85df7",
                                                "sense_id": "73b63116-788b-3c18-b100-7ee405c0dc2b",
                                                "text": "Sie weiß nur, sie werden verjagt aus dem zerbombten Königsberg, das mittlerweile Kaliningrad heißt und nicht mehr zu Deutschland gehört, sondern zur Sowjetunion, ihrer Heimat."
                                            },
                                            {
                                                "example_id": "7bef3893-7fde-47a2-8c3a-55e115573680",
                                                "sense_id": "73b63116-788b-3c18-b100-7ee405c0dc2b",
                                                "text": "Knapp ein Jahrhundert lang, von 750 bis 660 vor Christus, hatten Schwarzafrikaner das mächtigste Reich der Erde beherrscht – bis die Assyrer sie vom Thron verjagten."
                                            },
                                            {
                                                "example_id": "5447e338-8721-4315-948b-720cd6e613f6",
                                                "sense_id": "73b63116-788b-3c18-b100-7ee405c0dc2b",
                                                "text": "Hecker will die Republik. Wenn man erst den badischen Großherzog verjagt habe, werde sich auch das restliche Vaterland erheben und die deutsche Republik errichten, glaubt er."
                                            },
                                            {
                                                "example_id": "d410f727-4b56-4507-908b-4718389c5833",
                                                "sense_id": "73b63116-788b-3c18-b100-7ee405c0dc2b",
                                                "text": "Denn heute sind Nord- und Süditaliener innerlich weiter voneinander entfernt, als zu jener Zeit, da Garibaldi die Bourbonen aus Sizilien und Neapel verjagte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
