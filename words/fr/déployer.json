    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3f3fde16-4614-39f7-b66b-2aa7952b4462",
                    "sense_definition": "Étendre ou ouvrir ce qui était plié, roulé ou fermé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'oiseau blessé a enfin réussi à <w>déployer</w> ses ailes pour s'envoler dans le ciel."
                        },
                        {
                            "text": "Nous devons <w>déployer</w> la carte routière sur la table pour choisir le meilleur itinéraire."
                        }
                    ],
                    "synonyms": [
                        "déplier"
                    ],
                    "antonyms": [
                        "plier",
                        "replier"
                    ],
                    "common_phrases": [
                        "déployer ses ailes",
                        "déployer une carte",
                        "déployer les voiles"
                    ]
                },
                {
                    "sense_id": "b4cdac2e-9fb6-3012-bc4e-92ae42985682",
                    "sense_definition": "Disposer des troupes ou des moyens matériels sur le terrain en vue d'une opération.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a décidé de <w>déployer</w> des troupes supplémentaires le long de la frontière."
                        },
                        {
                            "text": "La préfecture va <w>déployer</w> les forces de l'ordre autour du stade avant le début du match."
                        }
                    ],
                    "common_phrases": [
                        "déployer des troupes",
                        "déployer les forces de l'ordre"
                    ]
                },
                {
                    "sense_id": "604c1aad-c725-3e08-9a4e-fcbcbccdc3ad",
                    "sense_definition": "Manifester avec force ou mettre en œuvre pleinement des efforts, de l'énergie ou des talents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe a dû <w>déployer</w> des efforts considérables pour achever le chantier avant l'hiver."
                        },
                        {
                            "text": "Elle va <w>déployer</w> toute son énergie pour convaincre les investisseurs de soutenir son entreprise."
                        }
                    ],
                    "common_phrases": [
                        "déployer des efforts",
                        "déployer toute son énergie"
                    ]
                },
                {
                    "sense_id": "da9cd0e2-43c6-3baf-997b-9155a4ddd00b",
                    "sense_definition": "Installer et mettre en service un logiciel ou un système informatique sur un ensemble de machines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les informaticiens vont <w>déployer</w> une mise à jour critique sur tous les serveurs ce week-end."
                        },
                        {
                            "text": "Il est recommandé de faire des tests approfondis avant de <w>déployer</w> une application en production."
