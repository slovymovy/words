                                "de": "Ich habe <w>dafür</w> im Moment keine Zeit.",
                                "fr": "Je n'ai pas le temps pour <w>ça</w> en ce moment.",
                                "it": "Non ho tempo per <w>questo</w> al momento.",
                                "cs": "Na <w>to</w> momentálně nemám čas.",
                                "tr": "Şu anda <w>bunun için</w> vaktim yok.",
                                "es": "No tengo tiempo para <w>eso</w> en este momento."
                            }
                        },
                        {
                            "text": "We hebben <w>daar</w> gisteren nog over gesproken.",
                            "target_lang_translations": {
                                "en": "We spoke about <w>that</w> just yesterday.",
                                "ru": "Мы об <w>этом</w> только вчера говорили.",
                                "pl": "Rozmawialiśmy o <w>tym</w> jeszcze wczoraj.",
                                "de": "Wir haben gestern noch <w>darüber</w> gesprochen.",
                                "fr": "Nous <w>en</w> avons encore parlé hier.",
                                "it": "<w>Ne</w> abbiamo parlato proprio ieri.",
                                "cs": "O <w>tom</w> jsme mluvili ještě včera.",
                                "tr": "Daha dün <w>bunun hakkında</w> konuşmuştuk.",
                                "es": "Ayer mismo hablamos de <w>ello</w>."
                            }
                        }
