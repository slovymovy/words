                                            {
                                                "example_id": "4cab91e9-1df1-47f0-8b81-0771dcce7f77",
                                                "sense_id": "f08c8a19-3d01-3ae0-b430-fa88b51fe73d",
                                                "text": "„Noach war sechshundert Jahre alt, als die Flut, das Wasser, über die Erde kam.“"
                                            },
                                            {
                                                "example_id": "23a4909c-31f0-4f76-9f13-9be96f08d899",
                                                "sense_id": "f08c8a19-3d01-3ae0-b430-fa88b51fe73d",
