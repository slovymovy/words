        "fr-extract.jsonl": [
            {
                "entry_id": "8fe80702-8f27-3c62-9877-7c80bb120192",
                "word": "prône",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c160a54c-5f2d-4630-871d-9ca4fb838c16",
                        "entry_id": "8fe80702-8f27-3c62-9877-7c80bb120192",
                        "tags": [
                            "plural"
                        ],
                        "form": "prônes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "35dec064-f0e6-3f38-9c9a-cfa2106ee62a",
                        "entry_id": "8fe80702-8f27-3c62-9877-7c80bb120192",
                        "glosses": [
                            "Instruction chrétienne que le curé ou un vicaire fait tous les dimanches en chaire, à la messe paroissiale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17a4ae8c-2cfe-4a8d-ae99-ec4ec49d6cc7",
                                "sense_id": "35dec064-f0e6-3f38-9c9a-cfa2106ee62a",
                                "text": "On ne doit dans les règles commencer la moisson qu’après qu’elle a été indiquée au prône de l’Église paroissiale."
                            },
                            {
                                "example_id": "54bc0c60-6e89-4181-bace-710ea46eb3db",
                                "sense_id": "35dec064-f0e6-3f38-9c9a-cfa2106ee62a",
                                "text": "Elle eut un air aussi stupide que peut l’être celui d’un paysan breton écoutant le prône de son curé."
                            },
                            {
                                "example_id": "4eb56be4-678d-48e1-9138-09504acecb75",
                                "sense_id": "35dec064-f0e6-3f38-9c9a-cfa2106ee62a",
                                "text": "Venez à la messe, ne manquez pas mon prône surtout, j’ai quelque chose de très sérieux, de très intéressant, de très grave à vous apprendre ; venez, vous verrez que vous ne vous en repentirez pas."
                            },
                            {
                                "example_id": "bcf0fc02-5682-497d-826b-732cd48f5db2",
                                "sense_id": "35dec064-f0e6-3f38-9c9a-cfa2106ee62a",
                                "text": "— Mêmes les gamines grandelettes peuvent prier en se rendant à l'école et au retour : ça leur fera oublier les prônes du maître d’école, ce suppôt de Satan-là."
                            },
                            {
                                "example_id": "b5951d67-fb5a-49ae-b449-64f9b5ed21c6",
                                "sense_id": "35dec064-f0e6-3f38-9c9a-cfa2106ee62a",
                                "text": "On chauffait le four cependant pour faire encore une grosse fournée de fars et de gâteaux pour les fêtes patronales, celle du village, celle de la profession, la Saint-Crépin, celle du maître Tremblot, la Saint-Joseph, celle de la maîtresse celle des mémères, et pour les douze fêtes carillonnées qu’imposait encore en ce temps-là le propre du temps d’un maître artisan. On comprenait alors la plainte du patron savetier de la fable, si incompréhensible pour le travailleur moderne : « On nous ruine en fêtes, et M. le curé de quelque nouveau saint charge toujours son prône ! »."
                            }
                        ]
                    },
                    {
                        "sense_id": "813c0c67-76f4-33b9-a4ce-0c4055602e6f",
                        "entry_id": "8fe80702-8f27-3c62-9877-7c80bb120192",
                        "glosses": [
                            "Remontrance importune qu’une personne fait à une autre."
                        ],
                        "tags": [
                            "dated",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7fb31c74-7c78-4bbb-af75-b22883f5044a",
                                "sense_id": "813c0c67-76f4-33b9-a4ce-0c4055602e6f",
                                "text": "Je me moque de son prône."
                            },
                            {
                                "example_id": "e80f6dba-060b-437d-8c8d-adcd3d239bb5",
                                "sense_id": "813c0c67-76f4-33b9-a4ce-0c4055602e6f",
                                "text": "Quand donc finira-t-il son prône ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "bdaa204c-bf89-3bf0-abf2-23eedb79db68",
                        "entry_id": "8fe80702-8f27-3c62-9877-7c80bb120192",
                        "glosses": [
                            "Bulletin municipal."
                        ],
                        "tags": [
                            "Finistère"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3824e21-6873-426e-9d4d-230c7589a43a",
                        "source_entry_id": "8fe80702-8f27-3c62-9877-7c80bb120192",
                        "target_lang_word": "Predigt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Predigt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                        "entry_id": "cb14f869-57f2-3e9d-982e-6b7db252c802",
                                        "glosses": [
                                            "religiöse Ansprache durch einen Prediger an die Gläubigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9487cb91-b804-4a15-ba26-b3ec5c59867d",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "Bei der Predigt am letzten Sonntag sprach der Priester über die Heilbarkeit der Homophobie."
                                            },
                                            {
                                                "example_id": "7e654e3e-4f6e-47ff-9961-892be800ad3b",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "„Die Predigten dieses Mannes ärgerten mich nicht, ich suchte mein Vergnügen darin, herauszubringen, wie er eigentlich auf seine Feststellungen kam.“"
                                            },
                                            {
                                                "example_id": "dbd8cff5-25f0-413d-8ec3-2eeba9bc63cf",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "„In seinen Predigten hatte der Mystiker das Loslassen, letztlich auch von sich selbst, als die Voraussetzung benannt, Gott in sich einlassen zu können.“"
                                            },
                                            {
                                                "example_id": "3ffae972-4874-4440-8824-bf59073b4571",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "„Als er eintraf, bestellte er für fünf Dollar Tricks, die er bei seinen Predigten vorführen wollte.“"
                                            },
                                            {
                                                "example_id": "86031b48-acd8-45f7-80be-23c829b253fe",
                                                "sense_id": "b2bece01-050a-35f1-9429-49225e15bb76",
                                                "text": "„Da war der alte Lenkes endlich in den Ruhestand geschickt worden, und seine ständigen Predigten von Gottes Strafe, dem ewigen Fegefeuer und dem Jüngsten Gericht hatten ein Ende gehabt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7b5e184-ff16-3014-8c7c-68804ec22212",
                                        "entry_id": "cb14f869-57f2-3e9d-982e-6b7db252c802",
                                        "glosses": [
                                            "eine an Moral oder Gewissen appellierende Ansprache, um jemanden auf ein Fehlverhalten aufmerksam zu machen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f55e31c-c528-4c6e-98a7-4dcf279f353a",
                                                "sense_id": "e7b5e184-ff16-3014-8c7c-68804ec22212",
                                                "text": "Anstatt mir hier eine Predigt zu halten, solltest du lieber mit gutem Beispiel vorangehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bc06ff4-2763-4c7b-98fa-da5f02e18ee6",
                        "source_entry_id": "8fe80702-8f27-3c62-9877-7c80bb120192",
                        "target_lang_word": "sermon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sermon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91271d0f-a591-3369-8f04-63d6c6a7075b",
                                        "entry_id": "8740e233-50df-355c-b9bb-9b3404832d31",
                                        "glosses": [
                                            "To discourse to or of, as in a sermon."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc3bf762-d23c-4472-8894-7e4066cb51e0",
                                                "sense_id": "91271d0f-a591-3369-8f04-63d6c6a7075b",
                                                "text": "January 23 1583, Edmund Spenser, letter to Walter Raleigh\nTo some I know this methode will seem displeasaunt, which had rather have good discipline delivered plainly in way of precepts, or sermoned at large, as they use, then thus clowdily enwrapped in allegorical devises"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f0683ee-9107-366c-810b-b0d744005160",
                                        "entry_id": "8740e233-50df-355c-b9bb-9b3404832d31",
                                        "glosses": [
                                            "To tutor; to lecture."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba3368e2-c273-4024-9d00-841f3e850449",
                                                "sense_id": "2f0683ee-9107-366c-810b-b0d744005160",
                                                "text": "Come, sermon me no further."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sermon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00c8ae46-75eb-3b10-af6e-7c5cafbe6ad7",
                                        "entry_id": "f8b3324e-203f-30ab-b278-f0a872c66901",
                                        "glosses": [
                                            "Religious discourse; a written or spoken address on a religious or moral matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c313a5-8464-4bac-88f3-6db45f027d69",
                                                "sense_id": "00c8ae46-75eb-3b10-af6e-7c5cafbe6ad7",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdec74ea-8b19-36e5-8c06-7e5782a5d89a",
                                        "entry_id": "f8b3324e-203f-30ab-b278-f0a872c66901",
                                        "glosses": [
                                            "A lengthy speech of reproval."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb84d3f5-3c5e-4d74-8034-ddf8e9c370d6",
                        "source_entry_id": "8fe80702-8f27-3c62-9877-7c80bb120192",
                        "target_lang_word": "homily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c135975-e047-335f-885d-c3c12b7f5259",
                                        "entry_id": "1e35f580-cd44-39f8-8ad7-971fa504ac73",
                                        "glosses": [
                                            "A sermon, especially concerning a practical matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1603679-c008-404f-9429-9185220ce959",
                                                "sense_id": "3c135975-e047-335f-885d-c3c12b7f5259",
                                                "text": "O moſt gentle Iupiter! What tedious homilie of Loue haue you wearied your pariſhioners withall, and neuer cri'de, haue patience good people."
                                            },
                                            {
                                                "example_id": "3621303b-82bd-4638-83d3-95e7a67a228c",
                                                "sense_id": "3c135975-e047-335f-885d-c3c12b7f5259",
                                                "text": "But to return to the Homily on St. Gregory. It is printed from a Tranſcript I had made of it from one made by Dr. Hopkins, I believe, out of the Cottonian Book, Vitellius D. 17. […] The Homily is one of thoſe which were prepared by Ælfrick, to be uſed in the Engliſh Saxon Church: […]"
                                            },
                                            {
                                                "example_id": "3db5be84-2ea8-4bc7-8825-3388f98d431d",
                                                "sense_id": "3c135975-e047-335f-885d-c3c12b7f5259",
                                                "text": "[W]e must pay attention not only to the rich tradition of the homily in the early Church and the retrieval of this preaching form by Vatican II but also to the evolving understandings of the homily from those who have tried to respond to the changing cultural patterns, pastoral needs, and theological trends of the day."
                                            },
                                            {
                                                "example_id": "6d770176-2f4e-45e3-9086-9ed7c23dda1c",
                                                "sense_id": "3c135975-e047-335f-885d-c3c12b7f5259",
                                                "text": "[W]hen one approaches Origen's homilies, this aspect of the work of the priest must be kept in mind. The purpose of his sermons was to instruct and to lead beginners in the faith to a higher level of understanding and maturity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6550a0a-24ed-3567-865c-886e03bfdcf9",
                                        "entry_id": "1e35f580-cd44-39f8-8ad7-971fa504ac73",
                                        "glosses": [
                                            "A moralizing lecture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43501e93-9d04-4dcd-b058-bade8ae619bd",
                                                "sense_id": "f6550a0a-24ed-3567-865c-886e03bfdcf9",
                                                "text": "How expreſſe and poſitive the doctrine of our Church is againſt them, our English Homily entitled Againſt the perill of idolatry, abundantly declareth; […]"
                                            },
                                            {
                                                "example_id": "99b28e4a-0ac6-4d5d-b557-2beaa599bf36",
                                                "sense_id": "f6550a0a-24ed-3567-865c-886e03bfdcf9",
                                                "text": "But if it be as I have heard my father / Deal out in his long homilies, 'tis a thing— / Oh God! I dare no think on 't!"
                                            },
                                            {
                                                "example_id": "547c8b70-0230-4b81-9388-f8ab8ee27b44",
                                                "sense_id": "f6550a0a-24ed-3567-865c-886e03bfdcf9",
                                                "text": "Will it be said, that Literature and Christianity, are two distinct things? Or, that it would be preposterous to expect that every writer should give us a homily, when we want to laugh, or a sermon, when we wish to think?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2730d726-6d97-3ae6-bd13-4545b6d04275",
                                        "entry_id": "1e35f580-cd44-39f8-8ad7-971fa504ac73",
                                        "glosses": [
                                            "A platitude."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "homily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5681bda-a1be-3cc3-a6e0-79797e78c5b4",
                                        "entry_id": "1c1aba51-4a97-31b5-acac-f61e1d7ef4b5",
                                        "glosses": [
                                            "In a homey manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b83dac9b-0f25-49f0-9340-073293b9fe29",
                                                "sense_id": "b5681bda-a1be-3cc3-a6e0-79797e78c5b4",
                                                "text": "Rocky handed it [the beer] to Bob, whose demurrals petered out as he held the can's cold actuality in his hand. It bore the smiling face of Lynn Swann. He opened it. Leo farted homily to close the transaction."
