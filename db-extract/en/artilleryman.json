                    {
                        "translation_id": "2f928ed3-2b6a-451b-9915-6a2c610d0f19",
                        "source_entry_id": "b7c27371-add6-3618-9260-4d98361bab44",
                        "source_sense_id": "ffe75044-794f-38ae-a17f-9b3d2ca8f510",
