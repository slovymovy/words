                                    }
                                ]
                            },
                            {
                                "target_word": "Shakespeare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2deec0c9-6f8d-35ed-a044-289e863f2db7",
                                        "entry_id": "101e4b74-62ed-3547-a164-d3c73fecd306",
                                        "glosses": [
                                            "Any form or style of language that is eloquent, especially in English; poetry."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4065aea6-961b-4a3c-81b2-07b71d768bc5",
                                                "sense_id": "2deec0c9-6f8d-35ed-a044-289e863f2db7",
                                                "text": "This may not be poetry, but in competition with \"Ryan has good velocity and excellent location\" it is pure Shakespeare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eacc5d0c-e78d-3c00-9f53-ebdc87253f36",
                                        "entry_id": "101e4b74-62ed-3547-a164-d3c73fecd306",
                                        "glosses": [
                                            "A playwright of the standing of William Shakespeare."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ce6d22b-3be9-486e-8843-111f063b8a3d",
                                                "sense_id": "eacc5d0c-e78d-3c00-9f53-ebdc87253f36",
                                                "text": "Caine, he said, might be a budding Shakespeare but in Shakespeare's time all it took to put on a play was a barn, a crude stage, […]"
                                            }
                                        ]
