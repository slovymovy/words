                ],
                "senses": [
                    {
                        "sense_id": "5c2813f6-6015-3e66-b1f0-3928f8214173",
                        "entry_id": "2e8ff5c5-4827-3d05-b0bc-428733e278ad",
                        "glosses": [
                            "Oreille."
                        ],
                        "tags": [
                            "dated",
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "652cb761-c057-481f-b70c-c4a9f6b00f38",
                                "sense_id": "5c2813f6-6015-3e66-b1f0-3928f8214173",
                                "text": "Y a-t-il du bon sens, s’écria-t-elle, empruntant au monsieur les propres termes de son trivial répertoire, y a-t-il du bon sens, je vous le demande, messieurs et mesdames, à venir au théâtre avec une tête pareille et de telles esgourdes !"
                            },
                            {
                                "example_id": "3062d6d8-bdf2-40fd-a82d-0bc5e8d4db84",
                                "sense_id": "5c2813f6-6015-3e66-b1f0-3928f8214173",
                                "text": "Écoutez ça, si les asticots n’ont pas encore boulotté vos esgourdes, tas d’ânes !"
                            },
                            {
                                "example_id": "d54af2a1-83d0-4ef0-8784-9281c7a45361",
                                "sense_id": "5c2813f6-6015-3e66-b1f0-3928f8214173",
                                "text": "Ferme ta boîte !... et ouvre bien tes esgourdes, puisque le ciel a permis que tu ne fusses pas sourd aujourd’hui !"
                            },
                            {
                                "example_id": "611a4f1c-a814-4c3a-a35f-284b839f87a6",
                                "sense_id": "5c2813f6-6015-3e66-b1f0-3928f8214173",
                                "text": "Il dégoise, l’ostrogoth de la téloche formaté au formol, tel un psittacidé déréglé et moche... Il clabaude aux esgourdes des blaireaux enfarinés et des tordus pasteurisés […]."
                            },
                            {
                                "example_id": "0a60f99b-dc3e-4443-8725-8f1a03c72394",
                                "sense_id": "5c2813f6-6015-3e66-b1f0-3928f8214173",
                                "text": "J’ai le claque-merde qui r’foule\nEt du pelage dans les esgourdes..."
                            }
                        ]
                    }
                ],
