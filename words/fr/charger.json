                    "antonyms": [
                        "décharger"
                    ],
                    "common_phrases": [
                        "charger un fusil",
                        "charger une arme"
                    ]
                },
                {
                    "sense_id": "97743beb-e75b-3dfe-bb0f-2bce2069a741",
                    "sense_definition": "Apporter des témoignages ou des éléments qui accusent une personne et aggravent sa situation judiciaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
