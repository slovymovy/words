                "forms": [],
                "senses": [
                    {
                        "sense_id": "5acdf0d8-54aa-3e68-a5e4-4f09db541b9b",
                        "entry_id": "c2c33915-6067-3595-ad9f-e331a49eff45",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord vocaal"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "b93c27ac-d790-4d30-834e-a2a243489375",
                                "sense_id": "5acdf0d8-54aa-3e68-a5e4-4f09db541b9b",
                                "text": "De vocalen van het stedelijk plat uit de Randstad gaan over in ronde Zeeuwse ondertonen."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8807de5-dee1-389c-92d9-f547cba6f651",
                        "entry_id": "c2c33915-6067-3595-ad9f-e331a49eff45",
                        "glosses": [
                            "deel van muziek dat wordt gezongen"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "75eca426-3bc4-444c-9f9c-2a909403c7de",
                                "sense_id": "e8807de5-dee1-389c-92d9-f547cba6f651",
                                "text": "De stemmen klinken misschien wat zwakker dan voorheen, maar bij de tekstregel „New spirit has arrived” barst een crescendo los waarbij de vocalen moeiteloos opgaan in een grootse popsound."
                            },
                            {
                                "example_id": "7ebcff00-fed1-4df4-8531-347036c1328d",
                                "sense_id": "e8807de5-dee1-389c-92d9-f547cba6f651",
                                "text": "Sterke songs in de traditie van de Britse beat uit de jaren zestig en de onderkoelde passie in de vocalen van de zich als Chrissie Kerr aankondigende Hynde, vormden de voornaamste attracties van het hecht musicerende kwartet."
                            },
                            {
                                "example_id": "cc3b33b4-6e51-4fdd-95af-ca56a2b6bac4",
                                "sense_id": "e8807de5-dee1-389c-92d9-f547cba6f651",
                                "text": "De bezetting van de nieuwe \"Herd\" is: Bill Chase, Harry Hall, Bill Byrne, Richie Cooper, John Madrid (trompetten), Bob Burgess, Bruce Fowler, Vinnie Bendido (trombones), Sal Nistico, Frank Vicari, Steve Lederer (tenors), Ronnie Cuber (bariton), John Hicks (piano), Monk Montgomery (bas) en Jack Ranelli (drums) met Herman op klarinet, sopraan- en altsax en voor de vocalen."
                            }
                        ]
                    }
