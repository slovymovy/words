                    "sense_id": "5cb0b7d4-6654-354f-be1d-33b59e6a7b32",
                    "sense_definition": "Instruction, consigne ou ligne de conduite imposée par une autorité ou une organisation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "instruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le personnel doit impérativement respecter chaque nouvelle <w>directive</w> émise par la direction."
                        },
                        {
                            "text": "Le ministre a communiqué une <w>directive</w> claire pour encadrer les dépenses publiques."
                        }
                    ],
                    "synonyms": [
