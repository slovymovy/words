{
    "word_family": [
        "compare",
        "comparison",
        "comparative",
        "comparatively",
        "incomparable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2d456e3e-7675-3579-a287-a4f24af28c36",
                    "sense_definition": "Similar in size, amount, or quality to something else",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two cars are <w>comparable</w> in price but the first one has better features.",
                            "target_lang_translations": {
                                "ru": "Эти две машины <w>сопоставимы</w> по цене, но у первой характеристики лучше."
                            }
                        },
                        {
                            "text": "The increase in risk is <w>comparable</w> to the risk of other long-term illnesses.",
                            "target_lang_translations": {
                                "ru": "Увеличение риска <w>сравнимо</w> с риском других хронических заболеваний."
                            }
                        }
                    ],
                    "antonyms": [
                        "different",
                        "unequal"
                    ],
                    "common_phrases": [
                        "comparable in size",
                        "comparable in price",
                        "broadly comparable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Схожий по размеру, количеству или качеству с чем-либо другим"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопоставимый",
                                "target_lang_sense_clarification": "по характеристикам"
                            },
                            {
                                "target_lang_word": "сравнимый",
                                "target_lang_sense_clarification": "по величине или качеству"
                            },
                            {
                                "target_lang_word": "аналогичный",
                                "target_lang_sense_clarification": "подобный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                    "sense_definition": "Able to be compared to something else because of similar characteristics",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An elephant is <w>comparable</w> in size to a double-decker bus.",
                            "target_lang_translations": {
                                "ru": "Слон <w>сопоставим</w> по размеру с двухэтажным автобусом."
                            }
                        },
                        {
                            "text": "You cannot say that robbing a bank is like pickpocketing because the two are simply not <w>comparable</w>.",
                            "target_lang_translations": {
                                "ru": "Нельзя сказать, что ограбление банка — это то же самое, что карманная кража, потому что эти вещи просто <w>несопоставимы</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "incomparable"
                    ],
                    "common_phrases": [
                        "not comparable",
                        "directly comparable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, который можно сравнить с чем-либо из-за схожих черт"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сравнимый",
                                "target_lang_sense_clarification": "допускающий сравнение"
                            },
                            {
                                "target_lang_word": "сопоставимый",
                                "target_lang_sense_clarification": "имеющий общие черты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2beb9c7a-5c8e-3efd-b6ac-6e52d8f57281",
                    "sense_definition": "Having comparative and superlative forms",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word big is a <w>comparable</w> adjective because it can take the forms bigger and biggest.",
                            "target_lang_translations": {
                                "ru": "Слово «big» — это прилагательное, <w>имеющее степени сравнения</w>, так как оно может принимать формы «bigger» и «biggest»."
                            }
                        },
                        {
                            "text": "Some linguists argue that absolute adjectives like unique are not <w>comparable</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые лингвисты утверждают, что абсолютные прилагательные, такие как «unique», <w>не имеют степеней сравнения</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gradable"
                    ],
                    "antonyms": [
                        "ungradable"
                    ],
                    "common_phrases": [
                        "comparable adjective"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий степени сравнения (сравнительную и превосходную)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имеющий степени сравнения",
                                "target_lang_sense_clarification": "в лингвистике"
                            },
                            {
                                "target_lang_word": "градуируемый",
                                "target_lang_sense_clarification": "о качественных прилагательных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d6ce2d3-5b4b-3e2f-9391-54d55f616a33",
                    "sense_definition": "Constituting a pair in a particular partial order",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Six and forty-two are <w>comparable</w> in the divides order but six and nine are not.",
                            "target_lang_translations": {
                                "ru": "Шесть и сорок два <w>сравнимы</w> в отношении делимости, а шесть и девять — нет."
                            }
                        },
                        {
                            "text": "In this set, any two elements are <w>comparable</w> under the given relation.",
                            "target_lang_translations": {
                                "ru": "В этом множестве любые два элемента <w>сравнимы</w> в рамках данного отношения."
                            }
                        }
                    ],
                    "antonyms": [
                        "incomparable"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Образующий пару в определенном частичном порядке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сравнимый",
                                "target_lang_sense_clarification": "в математике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "daa6a3eb-a590-380f-8756-89e017cdd642",
                    "sense_definition": "An item or property that is suitable for comparison to another, especially in real estate",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comparison_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The appraiser could not find any <w>comparables</w> because there had been no sales nearby.",
                            "target_lang_translations": {
                                "ru": "Оценщик не смог найти <w>аналогов</w>, так как поблизости не было продаж."
                            }
                        },
                        {
                            "text": "When valuing the house, we looked at several <w>comparables</w> in the same neighborhood.",
                            "target_lang_translations": {
                                "ru": "При оценке дома мы изучили несколько <w>сопоставимых объектов</w> в том же районе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "market comparables",
                        "recent comparables"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект или объект недвижимости, подходящий для сравнения с другим"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аналог",
                                "target_lang_sense_clarification": "для оценки стоимости"
                            },
                            {
                                "target_lang_word": "сопоставимый объект",
                                "target_lang_sense_clarification": "в недвижимости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}