                        "glosses": [
                            "Having no back, especially where one would be expected, as with a chair or a dress."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "839f1a1e-468d-4256-bdf1-157360bb4610",
                                "sense_id": "e7b23da0-1a1e-3d90-812c-75fee4931716",
                                "text": "a backless surgical gown"
                            },
                            {
                                "example_id": "d7ff3b50-6aad-455e-87f1-44bca3ab1e1c",
                                "sense_id": "e7b23da0-1a1e-3d90-812c-75fee4931716",
                                "text": "The apartment was almost dismantled; chairs lay backless about the floor amid china shepherdesses and toreadors; pictures were thrown over the sofa, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a87086fc-b017-3260-9fae-8c04df4b6dc0",
                        "entry_id": "cd0f59fc-c35b-31c5-a5f3-5062ddb9cec2",
                        "glosses": [
