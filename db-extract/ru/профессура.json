                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3f1c926-0883-35e4-af23-5e32b5a6b884",
                        "entry_id": "088dc272-e434-3f05-8598-a9e3d132981a",
                        "glosses": [
                            "книжн. звание, должность профессора в научном или учебном заведении, а также пребывание в этой должности; профессорская кафедра по какой-либо дисциплине"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c007f69-695b-4086-b100-1c924905ed6f",
                                "sense_id": "c3f1c926-0883-35e4-af23-5e32b5a6b884",
                                "text": "И прощай все мечты о профессуре, о блестящей научной деятельности."
                            }
                        ]
                    },
                    {
                        "sense_id": "641167a7-2e6d-3411-b0c4-51c661055094",
                        "entry_id": "088dc272-e434-3f05-8598-a9e3d132981a",
                        "glosses": [
                            "собир. совокупность профессоров"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c75b39c-a684-4c09-b8b8-18b897cb118d",
                                "sense_id": "641167a7-2e6d-3411-b0c4-51c661055094",
                                "text": "Зато некоторые, особенно профессура, относились к нам очень тепло, приглашали к себе."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e758623e-7158-4927-8fc0-c691a428e6c3",
                        "source_entry_id": "088dc272-e434-3f05-8598-a9e3d132981a",
                        "source_sense_description": "должность",
                        "target_lang_word": "professorship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "professorship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29b3211f-a365-34c3-b93a-43577828e45e",
                                        "entry_id": "65f70557-c241-3457-85b4-69419618c9a9",
                                        "glosses": [
                                            "The office of a professor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49391cae-981f-4f9e-80ca-7b0839002388",
                                                "sense_id": "29b3211f-a365-34c3-b93a-43577828e45e",
                                                "text": "And as regards histories of art, they are quite valueless to you unless you are seeking the ostentatious oblivion of an art professorship."
                                            },
                                            {
                                                "example_id": "22567c17-44d0-4131-9f6a-b1ba6077853e",
                                                "sense_id": "29b3211f-a365-34c3-b93a-43577828e45e",
                                                "text": "She earned a professorship at Los Angeles City College, and taught theatre there for two years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a2e50b3-8194-4fb2-b781-0864dedf566e",
                        "source_entry_id": "088dc272-e434-3f05-8598-a9e3d132981a",
                        "source_sense_description": "должность",
                        "target_lang_word": "Professur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Professur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e24032a3-6246-3768-a8d2-7fae399585b6",
                                        "entry_id": "5fc14eda-826c-31b2-a26a-4f1cb2fd7391",
                                        "glosses": [
                                            "Amt, Titel eines Professors"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9756758-8644-4040-8c85-49bd31399738",
                                                "sense_id": "e24032a3-6246-3768-a8d2-7fae399585b6",
                                                "text": "„Er wehrte zunächst ab, als ihm der Wirt die Chronik brachte; doch dann nahm er sie doch und schlug den Sommer nach, in dem er auf seine erste Professur berufen worden war.“"
                                            },
                                            {
                                                "example_id": "0d2bc03f-fa1a-4199-83cb-33ada0af86c5",
                                                "sense_id": "e24032a3-6246-3768-a8d2-7fae399585b6",
                                                "text": "„Neben meiner Professur am Konservatorium Klagenfurt habe ich etwa mit meinem Jazzquartett, der Organ Band, und im Duo mit Matthias Bublath verschiedene Projekte am Laufen.“"
                                            },
                                            {
                                                "example_id": "9336f0dd-29e2-43f7-a53e-8049026f2827",
                                                "sense_id": "e24032a3-6246-3768-a8d2-7fae399585b6",
                                                "text": "„Im Juli 1764 war es unglücklicherweise die Professur für Dichtkunst, die als nächste neu besetzt werden musste.“"
                                            },
                                            {
                                                "example_id": "8166e98b-ee7d-434c-b39f-5b33fa6b3cc2",
                                                "sense_id": "e24032a3-6246-3768-a8d2-7fae399585b6",
                                                "text": "„Autor und Autorinnen, zwei Frauen und ein Mann, alle mit Professuren in Astronomie ausgestattet, behaupten mit unangenehm überzeugenden Argumenten, dass die Menschheit von Beginn an in falschen Vorstellungen von der Welt befangen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
