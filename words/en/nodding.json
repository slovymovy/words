{
    "word_family": [
        "nod"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a3ddcd0-eb00-3ab2-9214-28d68ea0cb58",
                    "sense_definition": "present participle and gerund of <w>nod</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>nodding</w> her head to show that she understood the instructions.",
                            "target_lang_translations": {
                                "ru": "Она <w>кивала</w> головой, показывая, что поняла инструкции."
                            }
                        },
                        {
                            "text": "He kept <w>nodding</w> off during the long and boring afternoon lecture.",
                            "target_lang_translations": {
                                "ru": "Он постоянно <w>дремал</w> во время долгой и скучной дневной лекции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nodding head",
                        "nodding off"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени или герундий глагола «кивать» или «дремать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кивающий",
                                "target_lang_sense_clarification": "в значении движения головой вверх-вниз"
                            },
                            {
                                "target_lang_word": "дремлющий",
                                "target_lang_sense_clarification": "в значении засыпания на ходу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17ba095e-72a3-374b-8dd5-c7ff80a78c78",
                    "sense_definition": "The act of moving the head up and down.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>noddings</w> of the crowd indicated their clear agreement with the speaker.",
                            "target_lang_translations": {
                                "ru": "Кивки толпы свидетельствовали об их явном согласии с оратором."
                            }
                        },
                        {
                            "text": "His rhythmic <w>noddings</w> suggested he was listening intently to the music.",
                            "target_lang_translations": {
                                "ru": "Его ритмичные кивки говорили о том, что он внимательно слушает музыку."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в движении головой вверх и вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кивание",
                                "target_lang_sense_clarification": "процесс или акт кивания головой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "14b67a17-d228-39cd-b2ea-8cbf14ea7ce0",
                    "sense_definition": "Describing a plant or flower that hangs or faces downwards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>nodding</w> bluebells looked beautiful in the morning dew.",
                            "target_lang_translations": {
                                "ru": "Поникающие колокольчики выглядели прекрасно в утренней росе."
                            }
                        },
                        {
                            "text": "Many alpine flowers have a <w>nodding</w> habit to protect their pollen from rain.",
                            "target_lang_translations": {
                                "ru": "Многие альпийские цветы имеют поникающую форму, чтобы защитить пыльцу от дождя."
                            }
                        }
                    ],
                    "synonyms": [
                        "nutant"
                    ],
                    "common_phrases": [
                        "nodding flower"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описание растения или цветка, который свисает или направлен вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поникающий",
                                "target_lang_sense_clarification": "ботанический термин для растений с опущенными вниз соцветиями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}