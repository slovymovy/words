{
    "word_family": [
        "beat",
        "downbeat",
        "upbeat"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9eff98e3-f92b-3203-838e-00892306a11d",
                    "sense_definition": "Unusual, unconventional, or not ordinary in a way that is often interesting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unconventional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has such an <w>offbeat</w> sense of humor that hardly anyone finds his jokes amusing.",
                            "target_lang_translations": {
                                "ru": "У него настолько <w>своеобразное</w> чувство юмора, что почти никто не находит его шутки смешными."
                            }
                        },
                        {
                            "text": "The director is known for making <w>offbeat</w> films that challenge traditional storytelling methods.",
                            "target_lang_translations": {
                                "ru": "Режиссер известен созданием <w>нестандартных</w> фильмов, которые бросают вызов традиционным методам повествования."
                            }
                        }
                    ],
                    "synonyms": [
                        "unconventional",
                        "quirky",
                        "eccentric",
                        "unusual",
                        "outlandish",
                        "bizarre"
                    ],
                    "antonyms": [
                        "conventional",
                        "ordinary",
                        "standard",
                        "traditional"
                    ],
                    "common_phrases": [
                        "offbeat sense of humor",
                        "offbeat style",
                        "offbeat comedy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Необычный, нетрадиционный или незаурядный, часто в интересном или привлекательном смысле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нестандартный",
                                "target_lang_sense_clarification": "не такой, как все"
                            },
                            {
                                "target_lang_word": "необычный",
                                "target_lang_sense_clarification": "оригинальный"
                            },
                            {
                                "target_lang_word": "своеобразный",
                                "target_lang_sense_clarification": "имеющий свои особенности"
                            },
                            {
                                "target_lang_word": "эксцентричный",
                                "target_lang_sense_clarification": "выходящий за рамки привычного"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6deac2bb-c26b-3458-aaf0-385840db6f6c",
                    "sense_definition": "The beats in a musical measure that are not normally accented.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The congregation clapped along on the <w>offbeat</w> during the gospel performance.",
                            "target_lang_translations": {
                                "ru": "Прихожане хлопали в <w>слабую долю</w> во время исполнения госпела."
                            }
                        },
                        {
                            "text": "Reggae music is characterized by a strong emphasis on the <w>offbeat</w> rather than the downbeat.",
                            "target_lang_translations": {
                                "ru": "Музыка регги характеризуется сильным акцентом на <w>слабую долю</w>, а не на сильную."
                            }
                        }
                    ],
                    "antonyms": [
                        "downbeat"
                    ],
                    "common_phrases": [
                        "on the offbeat",
                        "clapping on the offbeat"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in music theory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабая доля в музыкальном такте, на которую обычно не падает акцент."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слабая доля",
                                "target_lang_sense_clarification": "в музыке"
                            },
                            {
                                "target_lang_word": "офф-бит",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3fad9f9-fa6e-30aa-a90d-b1096d33cc07",
                    "sense_definition": "An unconventional person who chooses not to conform to standard social norms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unconventional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Being an <w>offbeat</w> or a creative person is a risk that many artists are willing to take.",
                            "target_lang_translations": {
                                "ru": "Быть <w>оригиналом</w> или творческой личностью — это риск, на который готовы пойти многие художники."
                            }
                        },
                        {
                            "text": "The city was full of <w>offbeats</w> and dreamers who didn't fit into corporate life.",
                            "target_lang_translations": {
                                "ru": "Город был полон <w>чудаков</w> и мечтателей, которые не вписывались в корпоративную жизнь."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonconformist",
                        "individualist",
                        "maverick",
                        "oddball",
                        "eccentric"
                    ],
                    "antonyms": [
                        "conformist"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe people informally"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неординарный человек, который предпочитает не следовать общепринятым социальным нормам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оригинал",
                                "target_lang_sense_clarification": "необычный человек"
                            },
                            {
                                "target_lang_word": "чудак",
                                "target_lang_sense_clarification": "человек со странностями"
                            },
                            {
                                "target_lang_word": "нонконформист",
                                "target_lang_sense_clarification": "человек, не следующий правилам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}