                ],
                "senses": [
                    {
                        "sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                        "entry_id": "3b600b09-d37d-33b2-884c-5c40d8ef827f",
                        "glosses": [
                            "die absichtliche Beschädigung oder Zerstörung von Sachen, die jemand anderem gehören oder im öffentlichen Eigentum sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "667a39fa-c178-4e37-bfee-4d2a63303ff4",
                                "sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                                "text": "„Sie stehen hier vor Gericht und sind angeklagt wegen schwerer Sachbeschädigung und wegen Diebstahls.“"
                            },
                            {
                                "example_id": "2bfc1933-6c64-4c8b-b9c8-e4b896a92da4",
                                "sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                                "text": "Für die einen sind sie Kunst, für die anderen Sachbeschädigung: Graffiti haben ein kurzes Haltbarkeitsdatum."
                            },
                            {
                                "example_id": "982805c2-03eb-453e-9396-982a09d6819a",
                                "sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                                "text": "Bisher \"begingen\" die Flüchtlinge [in Ungarn; Anm. d. Erst.] lediglich eine Ordnungswidrigkeit. Jetzt muss, wer schwarz über die Grenze tritt, mit einer Haftstrafe von bis zu drei Jahren rechnen. Kommt Sachbeschädigung hinzu - etwa wenn ein Flüchtling einen Grenzzaun durchschneidet - erhöht sich das Strafmaß auf fünf Jahre."
                            },
                            {
                                "example_id": "63f0d819-5495-4d8d-98db-5fdfc748a51f",
                                "sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                                "text": "Walter F. muss sich ab kommenden Donnerstag wegen 20 Sachbeschädigungen vor dem Amtsgericht Barmbek verantworten."
                            },
                            {
                                "example_id": "b977513d-3393-45b1-9552-7e230418e404",
                                "sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                                "text": "Wie die Politikerin selbst auf ihrem Facebook-Profil verkündete, erfolgte am Sonntag der dritte Farbanschlag auf ihr Büro in Berlin. Die Polizei bestätigte dem Tagesspiegel, dass eine Anzeige wegen Sachbeschädigung eingegangen ist."
                            },
                            {
                                "example_id": "0d729712-b0d9-4f2f-a72a-9098ab2e49de",
                                "sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                                "text": "Seit Jahrzehnten plagen sich Gerichte mit der Frage herum, ob „das Ablassen der Luft aus den Reifen eines Fahrzeugs“ Sachbeschädigung ist und deshalb nach Paragraph 303 des Strafgesetzbuches bestraft werden kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c71fede-4281-416d-b217-58c979ec6227",
                        "source_entry_id": "3b600b09-d37d-33b2-884c-5c40d8ef827f",
                        "source_sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                        "target_lang_word": "property damage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4a4964db-3a77-4fcc-bf37-3922b258d8a1",
                        "source_entry_id": "3b600b09-d37d-33b2-884c-5c40d8ef827f",
                        "source_sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                        "target_lang_word": "vandalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vandalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1610396-02d9-31c6-a1cc-6aec2f491250",
                                        "entry_id": "dfea5851-fcc9-36d0-8c23-751a79b7a69b",
                                        "glosses": [
                                            "Willful damage to or destruction of any property, such as graffiti or defacement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca108c9-cf3c-449b-b4bb-d2d671749207",
                                                "sense_id": "d1610396-02d9-31c6-a1cc-6aec2f491250",
                                                "text": "As we turned down the street I was appalled by the vandalism: spray paint and smashed windows that were everywhere."
                                            },
                                            {
                                                "example_id": "7ae7778c-07ec-4301-823a-58b49f7fa6c1",
                                                "sense_id": "d1610396-02d9-31c6-a1cc-6aec2f491250",
                                                "text": "Bradford once boasted two stations with overall roofs. The pair were swept away in the 1970s in an act of corporate and civic vandalism."
                                            },
                                            {
                                                "example_id": "0ec5b467-2a0a-4124-8f0d-45c9b295a50a",
                                                "sense_id": "d1610396-02d9-31c6-a1cc-6aec2f491250",
                                                "text": "President Donald Trump seemed to issue a warning to individuals who participate in Tesla vandalisms, as reports of destruction to vehicles, dealerships and charging stations surge across the country. […] When asked about his comments at the White House on Friday afternoon, Trump called the vandalism suspects \"terrorists\" and appeared to argue what was happening with Tesla vehicles was worse than what happened during the Jan. 6 riots at the Capitol."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "912e9388-9a70-4038-b5b8-4177001cc43e",
                        "source_entry_id": "3b600b09-d37d-33b2-884c-5c40d8ef827f",
                        "source_sense_id": "e6d0e784-bc20-33d8-b76c-d1c619cf90e0",
                        "target_lang_word": "dommage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dommage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c63b0388-1ccc-3977-9de4-d9db91ac2d6d",
                                        "entry_id": "9a87ced4-82d1-3675-88d9-a5344c74749f",
                                        "glosses": [
                                            "Dégât matériel ou préjudice moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3bbe20-6c4b-4195-a6b0-94afbacb6b7c",
                                                "sense_id": "c63b0388-1ccc-3977-9de4-d9db91ac2d6d",
                                                "text": "La déconfiture de ce banquier me porte dommage."
                                            },
                                            {
                                                "example_id": "8245b807-2283-41d0-8e88-78ee2e2d33b2",
                                                "sense_id": "c63b0388-1ccc-3977-9de4-d9db91ac2d6d",
                                                "text": "Les assaillants, amplement pourvus d’explosifs, causèrent, tant à Berlin qu’en Franconie, des dommages énormes."
                                            },
                                            {
                                                "example_id": "40b31da4-0507-49fe-bbe9-8dd2605b5424",
                                                "sense_id": "c63b0388-1ccc-3977-9de4-d9db91ac2d6d",
                                                "text": "Vint l’heure du noble devoir patriotique. Fagerolle tira ses mois d’embastillement militaire sans trop de dommages, dans un régiment de marsouins, à Toulon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab3a853-9b3d-3182-a637-c745f8953311",
                                        "entry_id": "9a87ced4-82d1-3675-88d9-a5344c74749f",
                                        "glosses": [
                                            "Dégât."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e18bf496-304b-4636-8998-45b6ab94d47a",
                                                "sense_id": "dab3a853-9b3d-3182-a637-c745f8953311",
                                                "text": "Ces deux incendies n’ont occasionné aucun dommage corporel. Outre des pollutions, seuls des dommages matériels ont été causés, d’une part aux deux véhicules qui ont été totalement détruits, et d’autre part aux équipements situés à proximité directe ainsi qu’à la chaussée."
                                            },
                                            {
                                                "example_id": "ed58f04c-7bda-4d98-b629-ef509cf967ca",
                                                "sense_id": "dab3a853-9b3d-3182-a637-c745f8953311",
                                                "text": "La grêle, l’inondation a causé beaucoup de dommage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62192834-6f04-3d90-9726-3c0b75a0e88e",
                                        "entry_id": "9a87ced4-82d1-3675-88d9-a5344c74749f",
                                        "glosses": [
                                            "Locution: (Vieilli) (Régionalisme) être en dommage: être en infraction, causer du tort aux biens d'autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e840b76d-7d71-491c-aa07-bc98dcfd62c7",
                                                "sense_id": "62192834-6f04-3d90-9726-3c0b75a0e88e",
                                                "text": "Quand il était devenu plus grand, son indépendance et ce besoin continuel de mouvement qu’il avait s’étaient beaucoup accentués. Il n’en faisait plus qu’à sa tête ; il était toujours en dommage, – détachait les chevaux pour aller galoper au loin, – braconnait en tout temps avec un vieux fusil qui ne partait pas, – et s’attirait des démêlés fréquents avec le garde champêtre, au grand désespoir de son oncle Méry, qui avait rêvé de lui apprendre un métier et de faire de lui un homme tranquille. C’était vrai, il avait réellement été « un peu mauvais sujet dans les temps », et, au pays, on s’en souvenait toujours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9c0695-e5bd-3e8a-93da-6ba10ebbc966",
                                        "entry_id": "9a87ced4-82d1-3675-88d9-a5344c74749f",
                                        "glosses": [
                                            "Chose regrettable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33455566-bd47-42f6-9f7f-710429deb76a",
                                                "sense_id": "bf9c0695-e5bd-3e8a-93da-6ba10ebbc966",
                                                "text": "C’est dommage d’éternuer dans le son à son âge…"
                                            },
                                            {
                                                "example_id": "44045e78-3715-4dbe-9e93-44bc4471d4d0",
                                                "sense_id": "bf9c0695-e5bd-3e8a-93da-6ba10ebbc966",
                                                "text": "— C’est dommage que vous n’ayez point appris cela plus tôt."
                                            },
                                            {
                                                "example_id": "f04be7aa-5e61-4adc-bd55-9f1552efaf1f",
                                                "sense_id": "bf9c0695-e5bd-3e8a-93da-6ba10ebbc966",
                                                "text": "— Il est bien dommage que vous n’ayez pu arriver à temps."
                                            },
                                            {
                                                "example_id": "cf82e91a-bebe-45be-ab4a-9b6cade9eeff",
                                                "sense_id": "bf9c0695-e5bd-3e8a-93da-6ba10ebbc966",
                                                "text": "Quel dommage que vous ne soyez pas venu ce jour-là !"
                                            },
                                            {
                                                "example_id": "c99b49cf-6fe0-4b75-9724-eb6bf6857ef6",
                                                "sense_id": "bf9c0695-e5bd-3e8a-93da-6ba10ebbc966",
                                                "text": "« Le beau temps ! dit Madeleine avec un épanouissement de femme heureuse.\n— Et qui ferait tout oublier, ajouta Olivier, ce qui n’est pas dommage.\n— Seriez-vous homme à avoir des soucis ? » demanda en souriant M. de Nièvres."
                                            },
                                            {
                                                "example_id": "37022833-6dd2-4f33-b768-c51740764ee2",
                                                "sense_id": "bf9c0695-e5bd-3e8a-93da-6ba10ebbc966",
                                                "text": "– On ne la voit plus en ces côtés, disait-elle, et ce n’est pas grand dommage !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
