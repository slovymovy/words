                        "target_lang_word": "heropvoeding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heropvoeding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a88ff247-ac7a-36f8-bb77-21487e414acd",
                                        "entry_id": "4fc8fe7c-c3a1-3ffc-a044-e13456a0f770",
                                        "glosses": [
                                            "opnieuw iemand opvoeden vooral gericht om de slechte eerste opvoeding te corrigeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1415304e-0e69-4763-83b2-dd2b5daa9d82",
                                                "sense_id": "a88ff247-ac7a-36f8-bb77-21487e414acd",
                                                "text": "De criminele jochies hadden een langdurige heropvoeding nodig voordat ze als brave burgers wilden gaan leven."
                                            },
                                            {
                                                "example_id": "a0a72043-8c47-4096-aed6-7b9f79e61200",
                                                "sense_id": "a88ff247-ac7a-36f8-bb77-21487e414acd",
                                                "text": "Bestuurders klagen over het gebrek aan vrijzinnigheid van de toekomstige generatie, maar ware creatievelingen worden niet gewaardeerd. Vorig jaar morde haast niemand toen de zeventienjarige blogger en filmmaker Amos Yee door de rechtbank tot vier weken celstraf en ‘heropvoeding’ werd veroordeeld. In een weliswaar grof en ongepolijst, maar satirisch en intelligent videoblog schoffeerde Yee Singapores eerste premier Lee Kuan Yew en Margaret Thatcher. Zelfs premier Lee Hsien Loong eiste dat de tiener werd aangepakt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9683c75-822b-4d7f-a3e4-857af4d27647",
                        "source_entry_id": "83fdff9c-7b3c-3bd5-9feb-9193d330fd7b",
