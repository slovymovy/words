                            },
                            {
                                "target_lang_word": "广阔",
                                "target_lang_sense_clarification": "指空间、地域等广而大"
                            },
                            {
                                "target_lang_word": "大范围",
                                "target_lang_sense_clarification": "指破坏、影响等波及范围大"
                            },
                            {
                                "target_lang_word": "严重",
                                "target_lang_sense_clarification": "常用于 damage，表示损害很大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1a87b82-4855-3beb-be15-e8b093955f96",
                    "sense_definition": "Describing a physical property that is proportional to the size or amount of material in the system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mass and volume are examples of <w>extensive</w> properties in thermodynamics.",
                            "target_lang_translations": {
                                "ru": "Масса и объем являются примерами <w>экстенсивных</w> величин в термодинамике.",
                                "zh": "在热力学中，质量和体积都是<w>广延</w>性质的例子。"
                            }
                        },
                        {
                            "text": "The scientist calculated the <w>extensive</w> variables of the chemical system.",
                            "target_lang_translations": {
                                "ru": "Ученый рассчитал <w>экстенсивные</w> переменные химической системы.",
                                "zh": "这位科学家计算了该化学系统的<w>广延</w>变量。"
                            }
                        }
                    ],
                    "antonyms": [
                        "intensive"
                    ],
                    "common_phrases": [
                        "extensive property",
                        "extensive variable"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "physics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий физическое свойство, пропорциональное размеру системы или количеству вещества.",
                        "zh": "指一种物理性质，其大小与系统的规模或物质的量成正比。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экстенсивный",
                                "target_lang_sense_clarification": "термин в физике и термодинамике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "广延",
                                "target_lang_sense_clarification": "物理学、热力学术语，指数值随系统大小或物质量而变化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc4d6802-d564-3be6-a89a-2b1f4b86f90a",
                    "sense_definition": "Serving to extend or lengthen specific body parts or tissues.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The therapist focused on the <w>extensive</w> motion of the injured muscle.",
                            "target_lang_translations": {
                                "ru": "Терапевт сосредоточился на <w>разгибательном</w> движении травмированной мышцы.",
                                "zh": "治疗师着重关注了受伤肌肉的<w>伸展的</w>动作。"
                            }
                        },
                        {
                            "text": "Certain exercises promote an <w>extensive</w> action in the limbs.",
                            "target_lang_translations": {
                                "ru": "Определенные упражнения стимулируют <w>разгибательное</w> действие в конечностях.",
                                "zh": "某些锻炼有助于促进四肢的<w>伸展</w>作用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lengthening"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "medicine"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий для вытягивания или удлинения определенных частей тела или тканей.",
                        "zh": "指使特定身体部位或组织伸开、拉长的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгибательный",
                                "target_lang_sense_clarification": "о мышцах или физиологических движениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伸展的",
                                "target_lang_sense_clarification": "医学或生理学中，指使身体部位伸开、拉长"
                            },
                            {
                                "target_lang_word": "伸肌的",
                                "target_lang_sense_clarification": "用于动作、作用时可表示伸开的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}