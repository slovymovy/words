                    {
                        "sense_id": "62337190-f388-3855-a7fe-00d171bd3838",
                        "entry_id": "4feeaf0f-d337-3a89-a863-0d69e20650b0",
                        "glosses": [
                            "Ort in der pakistanischen Provinz Belutschistan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e457ee91-0fd3-417f-95c3-2d1c971f4b4a",
                                "sense_id": "62337190-f388-3855-a7fe-00d171bd3838",
                                "text": "„Bridas schlug vor, eine 875 Meilen lange Pipeline von ihren Yashlar-Feldern durch den Süden Afghanistans nach Sui in der Provinz Belutschistan zu bauen, wo Pakistans Gasreserven und Pipeline-Netz ihren Ursprung haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
