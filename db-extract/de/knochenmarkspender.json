                    {
                        "sense_id": "975af207-56e2-3d7d-88b7-aa2701e5aad5",
                        "entry_id": "a07f19b4-4b55-3f89-b28d-714a5c1da533",
                        "glosses": [
                            "Person, die sich eine bestimmte Menge an Knochenmark aus dem eigenen Körper zur weiteren Verwendung entnehmen lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40d75a84-690a-4c8c-9eeb-e27879f39e38",
                                "sense_id": "975af207-56e2-3d7d-88b7-aa2701e5aad5",
                                "text": "„Die Behandlung schlägt nicht an, oder man findet keine geeigneten Knochenmarkspender.“"
                            },
                            {
                                "example_id": "80360d1a-3272-4061-95f6-59d975fe5047",
                                "sense_id": "975af207-56e2-3d7d-88b7-aa2701e5aad5",
                                "text": "„Doch sich allein auf den Altruismus zu verlassen, kann tödlich sein: So sterben in den USA jährlich 2000 bis 3000 Menschen, bevor ein passender Knochenmarkspender gefunden ist.“"
                            },
                            {
                                "example_id": "5c09d8c6-e297-454a-92bb-e69201e787b2",
                                "sense_id": "975af207-56e2-3d7d-88b7-aa2701e5aad5",
                                "text": "„Die DKMS ist Deutschlands größte Datei für Knochenmarkspender.“"
                            }
                        ],
