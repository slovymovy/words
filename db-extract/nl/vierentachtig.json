                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aa91c7d-f4aa-47d0-8fc4-de807c91d528",
                                "sense_id": "a9ba85b9-9571-3322-b2cb-ad706f359ea5",
                                "text": "Het is weer de vierentachtig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "3ea9ba29-aacd-4c02-9ff8-1a914a6c06e4",
                                "sense_id": "a9ba85b9-9571-3322-b2cb-ad706f359ea5",
                                "text": "Haar vijfentachtigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de vierentachtig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b0202b2-2b2e-3437-bb68-33e3d503f9af",
                        "entry_id": "4a4b2244-5d6c-3a10-a538-56342587a1a1",
                        "glosses": [
                            "groep van 84 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b77c94ac-2830-4c17-8906-3af1f5fb6c58",
                                "sense_id": "8b0202b2-2b2e-3437-bb68-33e3d503f9af",
                                "text": "De vierentachtig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
