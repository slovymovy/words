                        ],
                        "examples": [
                            {
                                "example_id": "2cee220d-2d15-4be7-ba89-1317eaa2c18c",
                                "sense_id": "6b4b21a0-b3ae-3de8-8252-8bbcd1112302",
                                "text": "„Überraschend eisig bläst der Wind an diesem Morgen über die Filderebene.“"
                            },
                            {
                                "example_id": "df977e8e-3102-4403-a9f2-c30fceffdb38",
                                "sense_id": "6b4b21a0-b3ae-3de8-8252-8bbcd1112302",
                                "text": "„Wie steht die Hotelbranche auf der Filderebene, die vor allem von Firmenkunden lebt, nach Corona da?“"
                            },
                            {
                                "example_id": "df17f907-3678-4e25-8be7-26ffec093804",
                                "sense_id": "6b4b21a0-b3ae-3de8-8252-8bbcd1112302",
                                "text": "„In Summe ist das Projekt für den ÖPNV auf der Filderebene ein Schritt nach vorn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
