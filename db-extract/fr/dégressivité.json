                        "glosses": [
                            "Progressivité décroissante ou négative."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "8bca0e88-9cbf-4e3a-9906-ac3c92d3b3cb",
                                "sense_id": "b41d1d64-c127-3871-8a43-77c2b18d2851",
                                "text": "« Pour le MR, un enfant est un enfant. Nous nous opposons à toute dégressivité des allocations familiales. Le choix d’avoir un enfant est un droit inaliénable », a rappelé Charles Michel."
                            },
                            {
                                "example_id": "e799a208-d572-4a6e-9e45-4421ae5ee3cb",
                                "sense_id": "b41d1d64-c127-3871-8a43-77c2b18d2851",
                                "text": "Sans doute, était-il possible d'instituer ce qu'on a appelé une dégressivité, ce que j'appellerai, pour parler un meilleur français, une progressivité descendante, en accordant aux possesseurs de petits revenus, contre déclaration de leur avoir, des abattements de taxation pouvant aller jusqu'au dégrèvement total."
                            }
                        ]
                    }
