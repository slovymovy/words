                "senses": [
                    {
                        "sense_id": "fa0c0011-d574-3ae0-bb9e-c0d3a8e6388d",
                        "entry_id": "89f9df5a-3d03-30bd-854c-414ae6897473",
                        "glosses": [
                            "Faire chauffer de l'eau salée pour en enlever les impuretés qui montent à la surface (écume)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3662061d-5b5e-4404-81ab-f683e041cd21",
                                "sense_id": "fa0c0011-d574-3ae0-bb9e-c0d3a8e6388d",
                                "text": "Le moyen employé à scheloter est insuffisant ; les augelots reçoivent bien une partie du schelot que le mouvement de l'eau leur envoie ; mais une partie tombre à côté ;"
                            },
                            {
                                "example_id": "a601ebf0-9533-4aff-a623-f7fa51709130",
                                "sense_id": "fa0c0011-d574-3ae0-bb9e-c0d3a8e6388d",
                                "text": "Au bout de 17 heures le sel commence à paraître ; cependant on amène encore de l'eau et on schelote pendant neuf heures ; alors la chaudière est pleine d'eau à 27° de l'aréomètre, et prête à fournir le sel."
                            }
                        ]
                    }
                ],
