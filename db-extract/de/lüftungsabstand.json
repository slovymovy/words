                ],
                "senses": [
                    {
                        "sense_id": "c81af668-a53e-3f32-900f-61ebedd10acd",
                        "entry_id": "c3f88136-9857-3c48-95eb-3ca16e3f947e",
                        "glosses": [
                            "räumlicher oder zeitlicher Zwischenraum, räumliche Entfernung zwischen zwei Punkten, Zeitabschnitt zwischen zwei Zeitpunkten auch im übertragenen Sinn; die Luftzirkulation betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c83976-b1f7-47be-aa7d-8eddf5a229b5",
                                "sense_id": "c81af668-a53e-3f32-900f-61ebedd10acd",
                                "text": "„Oft verbirgt sich ein Schimmelpilzbefall hinter Holzverkleidungen, alten Bodenbelägen oder Tapeten und hinter Möbeln, die ohne ausreichenden Lüftungsabstand an Außenwänden stehen.“"
                            },
                            {
                                "example_id": "0f91de09-4e89-40db-a749-ab3a16a3dd68",
                                "sense_id": "c81af668-a53e-3f32-900f-61ebedd10acd",
                                "text": "„Steht der Flachbild-Fernseher hingegen in einer Schrankwand, können fehlende Lüftungsabstände unter Umständen sogar zur Überhitzung und auf lange Sicht zu irreparablen Schäden führen.“"
                            },
                            {
                                "example_id": "010faa4c-bafc-4ae1-8478-1ecb6d2d2128",
                                "sense_id": "c81af668-a53e-3f32-900f-61ebedd10acd",
                                "text": "„Wichtig dabei ist, dass die Doppelwände mit einem Lüftungsabstand aufgebaut werden.“"
                            },
                            {
                                "example_id": "f62b7684-223d-45f9-9215-b02c0d56b39c",
                                "sense_id": "c81af668-a53e-3f32-900f-61ebedd10acd",
                                "text": "„Dieser Lüftungsabstand ist bei allen neuen Ansätzen, d. h. bei jeder Unterbrechung der Fassade der Facade-Paneele durch Fenster oder andere Elemente, erforderlich.“"
                            },
                            {
                                "example_id": "a3a05c26-c515-4904-8984-8a3fe86fb880",
                                "sense_id": "c81af668-a53e-3f32-900f-61ebedd10acd",
                                "text": "„Es muss ein Lüftungsabstand von 300 mm um die Lüftungsschlitze oder Lüftungsöffnungen eingehalten werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
