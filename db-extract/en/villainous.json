                    },
                    {
                        "translation_id": "750bcd3e-cb21-4357-b30d-b711c72b635d",
                        "source_entry_id": "b9646c3c-1982-3442-aaad-fdd63143a009",
                        "source_sense_description": "of, relating to, or appropriate to a villain",
                        "target_lang_word": "bösartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bösartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af5e1735-9d95-3f31-bfbf-e3024ce241ae",
                                        "entry_id": "cf3fbad5-56a5-3f4b-888c-3ca145e03541",
                                        "glosses": [
                                            "böse, schlecht geartet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84e1fb43-5af1-4fb7-be0e-895d4c7ba5df",
                                                "sense_id": "af5e1735-9d95-3f31-bfbf-e3024ce241ae",
                                                "text": "Der neue Chef erwies sich leider als ziemlich bösartig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23bae877-85f1-44b9-a98f-9fafee106f93",
                        "source_entry_id": "b9646c3c-1982-3442-aaad-fdd63143a009",
                        "source_sense_description": "of, relating to, or appropriate to a villain",
                        "target_lang_word": "злой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "злой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7fafdd05-0363-3249-ae0f-a388d7067066",
                                        "entry_id": "75ed7fe5-92ce-3718-827e-e472543954ac",
                                        "glosses": [
                                            "несущий в себе зло"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2dedf26-b072-480e-8cdf-9a1d861e03c0",
                                                "sense_id": "7fafdd05-0363-3249-ae0f-a388d7067066",
                                                "text": "Ему в ответ // Злой дух коварно усмехнулся."
                                            },
                                            {
                                                "example_id": "ba36a2a2-3177-4635-8000-d7de8205d94d",
                                                "sense_id": "7fafdd05-0363-3249-ae0f-a388d7067066",
                                                "text": "За добрые дела мы ждём награды, а злые дела навлекают на нас кару."
                                            },
                                            {
                                                "example_id": "793e2bdc-ff7a-4d5b-ae93-f4efd02458b9",
                                                "sense_id": "7fafdd05-0363-3249-ae0f-a388d7067066",
                                                "text": "Такие имена давались в качестве защитных, чтобы злые силы не позарились на дитя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a874a6c-bf28-37fc-910f-b03a5b07d73c",
                                        "entry_id": "75ed7fe5-92ce-3718-827e-e472543954ac",
                                        "glosses": [
                                            "вызванный, пропитанный злобой, злорадством, недоброжелательностью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1fcb5ab-8988-4e92-8a8c-6a7ef3b6db1a",
                                                "sense_id": "6a874a6c-bf28-37fc-910f-b03a5b07d73c",
                                                "text": "При каждом новом воспоминании о нанесённой ему обиде рыдания подступали к горлу, он вздрагивал, и злое чувство приливало к сердцу и охватывало все его существо."
                                            },
                                            {
                                                "example_id": "a58c7eec-d5a8-4b1e-9a81-baa3fb51ba91",
                                                "sense_id": "6a874a6c-bf28-37fc-910f-b03a5b07d73c",
                                                "text": "По этому поводу по рукам пошла довольно злая эпиграмма неизвестного автора."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "572d7554-6307-31b9-b275-92a2c93c7859",
                                        "entry_id": "75ed7fe5-92ce-3718-827e-e472543954ac",
                                        "glosses": [
                                            "чрезвычайно лютый, хищный, кровожадный (о животных)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a5a7ed-bd5e-4ff0-acac-6e5a02760291",
                                                "sense_id": "572d7554-6307-31b9-b275-92a2c93c7859",
                                                "text": "Около домика рвётся на цепи злая собака."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "544a0d65-d7f0-3739-8589-33d9ebc2fdf5",
                                        "entry_id": "75ed7fe5-92ce-3718-827e-e472543954ac",
                                        "glosses": [
                                            "выражающий злобу, злость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1502eff-f594-400d-990a-f34d946751a2",
                                                "sense_id": "544a0d65-d7f0-3739-8589-33d9ebc2fdf5",
                                                "text": "Он понял её мысли, и напряжённая, злая улыбка искривила его губы."
                                            },
                                            {
                                                "example_id": "c80cfcf6-dbd7-4de6-bbbe-d48d0c17e3e5",
                                                "sense_id": "544a0d65-d7f0-3739-8589-33d9ebc2fdf5",
                                                "text": "Его злые глаза зорко глядели на Филиппа и словно хотели уничтожить его."
                                            },
                                            {
                                                "example_id": "0adcc38f-f63d-4f0d-a099-28c35d31e427",
                                                "sense_id": "544a0d65-d7f0-3739-8589-33d9ebc2fdf5",
                                                "text": "Двое мужчин были одеты по-городскому, ― один скуластый, крепкий, с низким ёжиком волос, у другого ― длинное, злое лицо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdc92980-3821-3449-ab0a-a953ed3b45da",
                                        "entry_id": "75ed7fe5-92ce-3718-827e-e472543954ac",
                                        "glosses": [
                                            "сердитый, недобрый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c74709ae-87b4-4174-91e1-0b160050414f",
                                                "sense_id": "fdc92980-3821-3449-ab0a-a953ed3b45da",
                                                "text": "Он был зол на всех."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25260549-a989-3abf-9e39-42e2aeb30dd0",
                                        "entry_id": "75ed7fe5-92ce-3718-827e-e472543954ac",
                                        "glosses": [
                                            "приносящий беды, неприятности; плохой, неблагоприятный; губительный, жестокий"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1ae94a-5f37-4ada-8f8a-1c0264f87d8b",
                                                "sense_id": "25260549-a989-3abf-9e39-42e2aeb30dd0",
                                                "text": "Так именно кашляют чахоточные люди, железное здоровье которых подкашивает эта злая болезнь."
                                            },
                                            {
                                                "example_id": "6e1f28cd-eeba-4370-aaad-a805dbbe789a",
                                                "sense_id": "25260549-a989-3abf-9e39-42e2aeb30dd0",
                                                "text": "Он был виноват и в том, что злое время настало на Руси и все изменили, все продались, кто английскому, кто немецкому капиталу."
                                            },
                                            {
                                                "example_id": "00981f25-6255-4caf-abb9-643cf3706df7",
