                    ]
                },
                {
                    "sense_id": "0362ff35-bd61-351b-96e6-8ea319cd5dfb",
                    "sense_definition": "Une personne importante, remarquable ou qui possède une vraie valeur sociale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne_notable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a travaillé dur toute sa vie pour enfin devenir <w>quelqu'un</w> dans sa profession."
                        },
                        {
                            "text": "Avec ses nouveaux succès, il a l'impression d'être enfin <w>quelqu'un</w> aux yeux des autres."
