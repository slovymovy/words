                        "sense_id": "4130f4f3-47ca-3f4c-822d-a901ca8c22b3",
                        "entry_id": "777afd2e-f887-3fd3-a638-34325db095c6",
                        "glosses": [
                            "Synonym of inhabitant /dweller."
