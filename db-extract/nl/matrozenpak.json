                        "sense_id": "a353cd9f-c090-3122-b0a2-bb9e377dc4d2",
                        "entry_id": "43b25fa6-bfb4-3665-943a-689f36b2f050",
                        "glosses": [
                            "kleding voor (jonge) jongens met een blauwe kraag, vaak met witte biezen, die op de rug een vierkant vormt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21722684-98d5-4f30-afd9-e65ff3dfe1e3",
                                "sense_id": "a353cd9f-c090-3122-b0a2-bb9e377dc4d2",
                                "text": "In dagboekaantekeningen uit de tijd dat de jongen twaalf was, had de vader zich afgevraagd of hij verliefd zou kunnen worden op zijn in matrozenpak gestoken zoon."
                            }
                        ]
                    },
                    {
                        "sense_id": "b14befd6-cb3c-3d3b-a63b-1f92b7f22729",
                        "entry_id": "43b25fa6-bfb4-3665-943a-689f36b2f050",
                        "glosses": [
                            "ceremoniële kleding van matrozen met een blauwe kraag, vaak met witte biezen, die op de rug een vierkant vormt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4750de64-e963-4ff1-9159-63e3be99e805",
                                "sense_id": "b14befd6-cb3c-3d3b-a63b-1f92b7f22729",
                                "text": "Een van de eerste schepen die vetrokken was het Italiaanse tallship Amerigo Vespucci. De tijdens Sail strak in het matrozenpak gestoken bemanning stond nu in werkoveralls op het dek en werd uitgezwaaid door een handjevol buurtbewoners van de Java-kade."
                            }
                        ]
                    }
