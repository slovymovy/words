                ],
                "senses": [
                    {
                        "sense_id": "03290f7e-9b52-31d4-9b91-0bb86185ad2e",
                        "entry_id": "770fe898-4170-3ad2-b254-29045363a522",
                        "glosses": [
                            "Relatif à la pataphysique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96e5e76-c425-4dcf-add5-97ba2a738d49",
                                "sense_id": "03290f7e-9b52-31d4-9b91-0bb86185ad2e",
                                "text": "* Je préparais un café pataphysique autour du thème : « Virtualité de l'être ».\n * C naze comme tème !\n * Comment ça, c'est naze ?\n * C naze parce que ça crie rien à la gueule du monde."
                            },
                            {
                                "example_id": "2941270c-ddf3-4b6e-bbac-49ca1073c65a",
                                "sense_id": "03290f7e-9b52-31d4-9b91-0bb86185ad2e",
                                "text": "Le calendrier pataphysique compte douze mois de vingt-huit jours et un de vingt-neuf jours, et le treize y tombe toujours un vendredi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92f3c428-5f65-4719-9dfa-c948f96f710f",
                        "source_entry_id": "770fe898-4170-3ad2-b254-29045363a522",
                        "source_sense_id": "03290f7e-9b52-31d4-9b91-0bb86185ad2e",
