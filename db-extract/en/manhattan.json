                        "sense_id": "1ed908e4-6af2-33bf-a4b6-2f07ce71c812",
                        "entry_id": "de20b222-88dc-36b1-8c45-a407cfe49f4c",
                        "glosses": [
                            "An indigenous people of North America who lived in present day New York State."
                        ],
                        "tags": [],
