                },
                {
                    "sense_id": "27f8d8fe-0c27-3875-8d7c-f279bec8c143",
                    "sense_definition": "To damage someone's reputation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal threatened to <w>tar</w> his reputation permanently.",
                            "target_lang_translations": {
                                "ru": "Скандал угрожал навсегда <w>запятнать</w> его репутацию."
                            }
                        },
                        {
                            "text": "Do not <w>tar</w> everyone with the same brush just because of one person's mistake.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>стричь всех под одну гребёнку</w> только из-за ошибки одного человека."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tar with the same brush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порочить, очернять чью-либо репутацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятнать",
                                "target_lang_sense_clarification": "порочить репутацию"
                            },
                            {
                                "target_lang_word": "марать",
                                "target_lang_sense_clarification": "очернять доброе имя"
                            },
                            {
                                "target_lang_word": "очернять",
                                "target_lang_sense_clarification": "порочить кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaeffe60-197f-3799-94b4-718656cf752e",
                    "sense_definition": "To create a computer archive file.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>tar</w> the directory before transferring it over the network.",
                            "target_lang_translations": {
                                "ru": "Перед отправкой по сети каталог следует <w>заархивировать через tar</w>."
                            }
                        },
                        {
                            "text": "It is common practice to <w>tar</w> and compress files for easier storage.",
                            "target_lang_translations": {
                                "ru": "Обычно файлы <w>упаковывают в tar</w> и сжимают для более удобного хранения."
                            }
