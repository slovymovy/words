                        "sense_id": "6311f322-4242-3dee-ada9-10793db0f6f1",
                        "entry_id": "ff846a19-6204-39d6-b540-eca0b2dfd0ca",
                        "glosses": [
                            "очаровывать, пленять, оказывать сильное, покоряющее воздействие"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16d55e91-a2d7-486b-86cb-86aca9f2e05a",
                                "sense_id": "6311f322-4242-3dee-ada9-10793db0f6f1",
                                "text": "Каждого своего собеседника он обвораживал мягким голосом."
                            },
                            {
                                "example_id": "f9de45c3-1c5a-46ec-b8c4-d8481c8d2760",
                                "sense_id": "6311f322-4242-3dee-ada9-10793db0f6f1",
                                "text": "Женщина счастлива и достигает всего, чего она может желать, когда она обворожит мужчину. И потому главная задача женщины — уметь обвораживать его."
                            }
                        ]
                    }
