                        "target_lang_word": "Schluckauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schluckauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                        "entry_id": "352b6e0b-0bd1-323f-bdcf-511eba49ebe5",
                                        "glosses": [
                                            "unwillkürliches, ruckartiges Einatmen bei gleichzeitigem Von-sich-Geben von glucksenden Geräuschen, hervorgerufen durch ruckartiges Zusammenziehen des Zwerchfells (ähnlich wie beim Husten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ab7698-7d1d-4827-995c-f28932029f9c",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "Der Schluckauf geht meistens schnell vorüber."
                                            },
                                            {
                                                "example_id": "c97aabe5-64e8-45f3-985a-555e07800290",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "Ein anhaltender Schluckauf ist ziemlich lästig."
                                            },
                                            {
                                                "example_id": "acaf9465-f158-4ac6-9b0e-cfa11c7adf17",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "Die meisten Hausrezepte gegen Schluckauf, ein Stück Würfelzucker, Luft anhalten, funktionieren nicht."
                                            },
                                            {
                                                "example_id": "57fbf9c9-d812-4944-8fda-db34b436bc74",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "„Einen Schluckauf haben, das war nichts Schlimmes, das hatte doch jeder schon mal gehabt.“"
                                            },
                                            {
                                                "example_id": "eacfd738-c89a-4342-a3c4-2332b03ed566",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "„Wenn ich Sonette lese, bekomme ich auch immer gleich Schluckauf.“"
                                            },
                                            {
                                                "example_id": "c5691d6d-e6bb-42ad-9b48-fd18616fea2f",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "„Er hatte in jenen Tagen viel Schluckauf, und er weinte oft.“"
                                            },
                                            {
                                                "example_id": "82f90f56-aef3-47aa-a856-b550fe3fcfb5",
                                                "sense_id": "f27a0f13-71a7-3d85-ad16-a2a91659cce6",
                                                "text": "„Schluckauf, Sodbrennen, Reflux: Diese Symptome hängen mit dem Zwerchfell zusammen. […] Der Schluckauf ist nichts weiter als eine Verkrampfung, eine plötzliche Verkrampfung des Zwerchfells, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
