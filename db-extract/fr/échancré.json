                                "target_senses": [
                                    {
                                        "sense_id": "da284026-19e9-36bb-830c-402a9399a4e7",
                                        "entry_id": "53fd88b9-1997-311b-b969-457d1b23cdb5",
                                        "glosses": [
                                            "An act of revealing; the process of revealing; something revealed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f79da31-4f83-4eb1-be34-23f754e67c79",
                                                "sense_id": "da284026-19e9-36bb-830c-402a9399a4e7",
                                                "text": "It became clear that we were witnessing a great revealing of secrets."
                                            },
                                            {
                                                "example_id": "f1fd5428-7221-4b78-9dd8-0c5d05c55993",
                                                "sense_id": "da284026-19e9-36bb-830c-402a9399a4e7",
                                                "text": "In these letters, and the remembered conversations, we have fuller revealings of the inner man, greater depth of discovery into that vast and labyrinthine mind[…]"
                                            },
                                            {
                                                "example_id": "13b26498-4f3f-4b2f-8078-c549597ee46a",
                                                "sense_id": "da284026-19e9-36bb-830c-402a9399a4e7",
                                                "text": "She paused a moment; while vaguely to his secret self Pierre revolved these strange revealings; but now he was all attention again as Isabel resumed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
