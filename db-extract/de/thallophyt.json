                "translations": [
                    {
                        "translation_id": "f240cc29-10bd-42cd-bed8-1d3916ff58a1",
                        "source_entry_id": "154b4015-bae6-3e27-aaa1-b74e1d377a88",
                        "source_sense_id": "d802583f-4376-3bf9-a36a-5b2b5efca8ed",
                        "source_sense_description": "Vertreter der niederen Pflanzen, deren Thallus nicht in die beim Kormus der höheren Pflanzen üblichen Grundorgane Wurzel, Sprossachse und Blatt/Blätter gegliedert ist",
                        "target_lang_word": "thallophyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thallophyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "197a048d-41da-3b61-b0f9-4fe459db4e87",
                                        "entry_id": "75a7d5ae-e150-3fc4-875b-9abd5b07a044",
                                        "glosses": [
                                            "Any of very many primitive plants that consist of a thallus (plant body not differentiated into roots, stems and leaves), formerly collected in the obsolete taxonomic group Thallophyta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb42004-0111-41ba-9a01-9fec4bd056d0",
                                                "sense_id": "197a048d-41da-3b61-b0f9-4fe459db4e87",
                                                "text": "1994, Estrelita A. Madriaga, Anthony Lee, Felicitas B. Ventura, Orlando A. Oronce (coordinator), Biology: Science and Technology II, page 347,\nThey lack the vascular tissues; thus, they are called thallophytes. Algae are thallophytes with chlorophyll. […] Fungi are thallophytes without chlorophyll."
                                            },
                                            {
                                                "example_id": "225d3c5c-425b-4a9e-a8b9-84658c271a29",
                                                "sense_id": "197a048d-41da-3b61-b0f9-4fe459db4e87",
                                                "text": "1994, Pat E. Rasmussen, Chapter IV.5: Mercury in Vegetation of the Precambrian Shield, Carl J. Watras, John W. Huckabee (editors), Mercury Pollution: Integration and Synthesis, page 422,\nIn general, the usefulness of the thallophytes as Hg bioindicators was limited by their sporadic occurrence in the forest environment. Because of the importance of the thallophytes as components of the food chain, however, several samples from different groups (summarized in Table 2) were collected for comparison with values reported in the literature."
                                            },
                                            {
                                                "example_id": "a1f1fb31-15b2-4d6b-9b63-3b14fbafb049",
                                                "sense_id": "197a048d-41da-3b61-b0f9-4fe459db4e87",
                                                "text": "Fossile^([sic]) records along with molecular, cytological and morphological phylogenetic work favour a single origin of land plants from charophycean thallophytes, and indicate that several major lineages of vascular plants had evolved more than 400 million years ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
