                "translations": [
                    {
                        "translation_id": "fb6719c6-6896-4776-bb06-fa9cea511d13",
                        "source_entry_id": "54d1a84d-8526-368e-aaf5-fafa9d513264",
                        "source_sense_id": "3b17030c-20b9-3645-9d9e-10851f9e986d",
                        "source_sense_description": "Schwingungsdämpfer bei Kraftfahrzeugen",
                        "target_lang_word": "shock absorber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shock absorber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "806c5776-6be9-3e09-aed6-3f75eef0e22f",
                                        "entry_id": "4b1f5b0c-af04-375b-a081-e073813e95ba",
                                        "glosses": [
                                            "A mechanical device designed to smooth out or damp any sudden shock impulse and dissipate kinetic energy; usually consists of a combination of a spring and a dashpot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "899fe391-9a04-4364-abdb-0ba0c12c4096",
                                                "sense_id": "806c5776-6be9-3e09-aed6-3f75eef0e22f",
                                                "text": "Hydraulic shock absorbers are used to damp out vertical and lateral oscillations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "814902e2-c649-4e84-bb1e-157181cd4a9b",
                        "source_entry_id": "54d1a84d-8526-368e-aaf5-fafa9d513264",
                        "source_sense_id": "3b17030c-20b9-3645-9d9e-10851f9e986d",
                        "source_sense_description": "Schwingungsdämpfer bei Kraftfahrzeugen",
                        "target_lang_word": "damper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cd5ff54-79b2-336d-9461-50a38ce034d8",
                                        "entry_id": "a6610187-9534-3a87-9f4d-0b8df3fca57d",
                                        "glosses": [
                                            "Something that damps or checks:",
                                            "A valve or movable plate in the flue or other part of a stove, furnace, etc., used to check or regulate the draught of air."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a55a1426-c960-312a-ace1-606c90011f42",
                                        "entry_id": "a6610187-9534-3a87-9f4d-0b8df3fca57d",
                                        "glosses": [
                                            "Something that damps or checks:",
                                            "A contrivance (sordine), as in a pianoforte, to deaden vibrations; or, as in other pieces of mechanism, to check some action at a particular time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1c2b4780-b94e-3859-9647-28cd31a9759d",
                                        "entry_id": "a6610187-9534-3a87-9f4d-0b8df3fca57d",
                                        "glosses": [
                                            "Something that damps or checks:",
                                            "Something that kills the mood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8d2284a-6974-4db4-b7ec-e9c022a63015",
                                                "sense_id": "1c2b4780-b94e-3859-9647-28cd31a9759d",
                                                "text": "Nor did Sabrina′s presence seem to act as any damper at the modest little festivities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3992d653-2883-3fe7-993f-879d197b9ee1",
                                        "entry_id": "a6610187-9534-3a87-9f4d-0b8df3fca57d",
                                        "glosses": [
                                            "Something that damps or checks:",
                                            "A device that decreases the oscillations of a system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c4aacb3-a526-308e-af22-d1ad74b3ffe1",
                                        "entry_id": "a6610187-9534-3a87-9f4d-0b8df3fca57d",
                                        "glosses": [
                                            "Something that damps or checks:",
                                            "A shock absorber."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5789a6b1-deef-4cf7-a893-e8916b835837",
                                                "sense_id": "4c4aacb3-a526-308e-af22-d1ad74b3ffe1",
                                                "text": "In general, steel springs were stipulated for primary suspension, although rubber was accepted for auxiliary springing; hydraulic dampers were specified and the use of laminated springs ruled out."
                                            },
                                            {
                                                "example_id": "fc2cde14-542f-4e25-b9ac-1ee9119e436b",
                                                "sense_id": "4c4aacb3-a526-308e-af22-d1ad74b3ffe1",
                                                "text": "However, complaints quickly surfaced about the ride quality of the SIG BT41 bogies, which was only cured by the fitting of additional dampers to the bogies and couplers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "706a4d9e-739d-33a0-949d-4ec08ccf6fe3",
                                        "entry_id": "a6610187-9534-3a87-9f4d-0b8df3fca57d",
                                        "glosses": [
                                            "Bread made from a basic recipe of flour, water, milk, and salt, but without yeast."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4c90ad2-b704-4741-9b92-9584a7af17d7",
                                                "sense_id": "706a4d9e-739d-33a0-949d-4ec08ccf6fe3",
                                                "text": "1827, Peter Cunningham, Two Years in New South Wales, ii.190, quoted in G. A. Wilkes, A Dictionary of Australian Colloquialisms, 1978, →ISBN,\nThe farm-men usually bake their flour into flat cakes, which they call dampers, and cook these in the ashes."
                                            },
                                            {
                                                "example_id": "d8ba410f-c4d6-4a96-9249-ceaf4a25626e",
                                                "sense_id": "706a4d9e-739d-33a0-949d-4ec08ccf6fe3",
                                                "text": "The flour bespattering Squeaker's now neglected clothes spoke eloquently of his clumsy efforts at damper making."
                                            },
                                            {
                                                "example_id": "030db094-e20b-4cb7-bd5e-0daab7c9c93b",
                                                "sense_id": "706a4d9e-739d-33a0-949d-4ec08ccf6fe3",
                                                "text": "You hypocritically claim that you are trying to ‘protect’ us; but your modern policy of ‘protection’ (so-called) is killing us off just as surely as the pioneer policy of giving us poisoned damper and shooting us down like dingoes!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "920a328d-4131-3221-b04c-045ef4bef039",
                                        "entry_id": "a6610187-9534-3a87-9f4d-0b8df3fca57d",
                                        "glosses": [
                                            "A shop till."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ac772b2-02db-4994-acdf-7253670ad123",
                                                "sense_id": "920a328d-4131-3221-b04c-045ef4bef039",
                                                "text": "A certain class of 'City Arabs' do nothing but steal provisions from shop doors and sell them for one-tenth of their value, or less, […] while a fourth again do nothing but \"draw the dampers,\" i. e. steal from shop-tills."
                                            }
                                        ]
                                    }
                                ]
                            },
