                    },
                    {
                        "translation_id": "f2672083-b1e8-43cb-af1a-141aee485ca2",
                        "source_entry_id": "01842fc2-f6a4-3b93-97e8-a9349901e7b3",
                        "source_sense_description": "элемент и вещество",
                        "target_lang_word": "argon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd699c1-a756-3030-83e9-597986992b50",
                                        "entry_id": "88769b11-8b81-3ee2-bd85-beed622bd240",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 18 et de symbole Ar qui fait partie de la série chimique de gaz nobles."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb92275b-5d01-41ba-ab99-a7292a31fb35",
                                                "sense_id": "fcd699c1-a756-3030-83e9-597986992b50",
                                                "text": "Parmi les trois isotopes stables de l’argon (³⁶Ar, ³⁸Ar et ⁴⁰Ar), le ⁴⁰Ar représente 99,6%."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "488bc9d4-90c5-39d2-8132-21160beb7271",
                                        "entry_id": "88769b11-8b81-3ee2-bd85-beed622bd240",
                                        "glosses": [
                                            "Gaz monoatomique de cet élément (Ar), incolore, inodore et inerte, ayant la propriété d’entrer très difficilement en combinaison. Fait partie des gaz constitutifs de l’atmosphère."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecc6298b-6a42-45a3-9088-31c4b0fe52f7",
                                                "sense_id": "488bc9d4-90c5-39d2-8132-21160beb7271",
                                                "text": "[Mars] possède une atmosphère 200 fois moins massive que la nôtre, faite principalement de 95,3 % de CO2, 2,7 % d’azote et de 1,6 % d’argon."
                                            },
                                            {
                                                "example_id": "57cc6325-6aeb-41f7-b68b-19a34cd793e1",
                                                "sense_id": "488bc9d4-90c5-39d2-8132-21160beb7271",
                                                "text": "Pour obtenir le froid intense requis à la pointe de l’instrument, on utilise la détente d’un gaz, en général de l’argon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d4981c9-c286-3c6d-8c97-b6334093166b",
                                        "entry_id": "88769b11-8b81-3ee2-bd85-beed622bd240",
                                        "glosses": [
                                            "Atome (ou, par ellipse, noyau) d’argon."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac27229a-c113-4305-9382-a41251fa3040",
                                                "sense_id": "4d4981c9-c286-3c6d-8c97-b6334093166b",
                                                "text": "Cette étude a permis […] d’identifier deux types d’isomères, les uns avec les argons d’un seul côté du plan moléculaire, les autres avec les deux côtés occupés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "argon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56ca9085-87ba-3289-a4e8-8137189005af",
                                        "entry_id": "a684b4c9-b37f-3924-bf89-c3543cfdefab",
                                        "glosses": [
                                            "Bâton ou morceau de bois courbé en arc dont on se sert pour prendre les oiseaux."
                                        ],
