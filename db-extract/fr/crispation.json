                "senses": [
                    {
                        "sense_id": "0b7c278a-088e-3445-b896-12698824d8ec",
                        "entry_id": "75e7848f-238b-3df9-a005-93c5baa15121",
                        "glosses": [
                            "Resserrement par lequel certaines choses se contractent en se ridant à la surface."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4e5e509-af05-39e6-9310-239cef2fabbb",
                        "entry_id": "75e7848f-238b-3df9-a005-93c5baa15121",
                        "glosses": [
                            "Contraction qui se produit dans les entrailles, dans les nerfs, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a37c80df-cbef-4ddc-870d-325b0fccf039",
                                "sense_id": "d4e5e509-af05-39e6-9310-239cef2fabbb",
                                "text": "Je sentais l'intensité du courant grandir et à mesure ma gorge, mes mâchoires, tous les muscles de mon visage, jusqu'à mes paupières se contacter dans une crispation de plus en plus douloureuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "1721fb08-1552-34b7-ba58-48bf68f70f3b",
                        "entry_id": "75e7848f-238b-3df9-a005-93c5baa15121",
                        "glosses": [
                            "Ce qui cause une vive impatience."
                        ],
                        "tags": [
                            "familiar",
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "a5a81898-a57a-4cea-8e23-5e6df0723615",
                                "sense_id": "1721fb08-1552-34b7-ba58-48bf68f70f3b",
                                "text": "Le premier ministre ukrainien, Denys Chmyhal, a appelé dimanche l’Allemagne à renforcer son soutien militaire à l’Ukraine, tout en reconnaissant les efforts déjà accomplis, lors d’un déplacement à Berlin qui tourne la page de récentes crispations entre les deux pays."
                            },
                            {
                                "example_id": "3249b6f1-0085-4983-a1a9-f259d041fdbe",
                                "sense_id": "1721fb08-1552-34b7-ba58-48bf68f70f3b",
                                "text": "Toute petite, elle a senti que sa mère était une triste déchue ; dès lors, elle l’a aimée davantage et elle a contracté pour jamais une crispation farouche, une sorte de rancune contre le monde en général."
                            }
                        ]
                    }
                ],
