                        "examples": [
                            {
                                "example_id": "fff37c10-9970-4c6e-b9e8-ff423239712b",
                                "sense_id": "c38011ac-1d1e-35c1-9354-3fa43dc0df95",
                                "text": "„Laut Polizei handelte es sich dabei aber lediglich um einen überarbeiteten Messingring geringen Werts.“"
                            },
                            {
                                "example_id": "aec30a75-8f03-4d02-9482-501d58f7a42e",
                                "sense_id": "c38011ac-1d1e-35c1-9354-3fa43dc0df95",
                                "text": "„Letzte Pflichtstation am ersten Nürnberg-Tag: der Schöne Brunnen, mit seinem nahtlos ins eiserne Gitter eingeschmiedeten Messingring, um den sich allerlei Sagen ranken.“"
                            }
                        ],
