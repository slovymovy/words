                "translations": [
                    {
                        "translation_id": "32c2f1ae-aee3-4a0b-a951-1f69afe0975b",
                        "source_entry_id": "ebdff516-acf3-39e1-a8a0-0996fb7b1f99",
                        "source_sense_id": "279b12af-2273-34e8-b0d6-2ffd9805251f",
