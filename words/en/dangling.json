{
    "word_family": [
        "dangle",
        "dangler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "51876b46-0e1c-3ab8-abea-8f68559a85f2",
                    "sense_definition": "Hanging or suspended loosely from above so as to swing freely.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "suspension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat tried to catch the <w>dangling</w> string hanging from the curtain.",
                            "target_lang_translations": {
                                "ru": "Кот пытался поймать <w>свисающую</w> со шторы нитку.",
                                "zh": "猫试图抓住从窗帘上<w>垂下</w>的绳子。",
                                "es": "El gato intentó atrapar el hilo <w>colgante</w> que caía de la cortina."
                            }
                        },
                        {
                            "text": "She wore a pair of <w>dangling</w> earrings that sparkled in the light.",
                            "target_lang_translations": {
                                "ru": "На ней были <w>висячие</w> серьги, которые сверкали на свету.",
                                "zh": "她戴着一对在灯光下闪闪发光的<w>垂坠</w>耳环。",
                                "es": "Llevaba unos pendientes <w>colgantes</w> que brillaban con la luz."
                            }
                        }
                    ],
                    "synonyms": [
                        "hanging",
                        "swinging",
                        "pendulous"
                    ],
                    "common_phrases": [
                        "dangling earrings",
                        "dangling rope",
                        "dangling wires"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободно свисающий или подвешенный сверху так, что может раскачиваться.",
                        "zh": "指物体从高处悬挂下来，可以自由摆动。",
                        "es": "Que cuelga o está suspendido de forma suelta desde arriba, permitiendo que se balancee libremente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свисающий",
                                "target_lang_sense_clarification": "о предметах, висящих вниз"
                            },
                            {
                                "target_lang_word": "болтающийся",
                                "target_lang_sense_clarification": "свободно висящий и качающийся"
                            },
                            {
                                "target_lang_word": "висячий",
                                "target_lang_sense_clarification": "находящийся в висячем положении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悬挂的",
                                "target_lang_sense_clarification": "指物体处于悬挂状态"
                            },
                            {
                                "target_lang_word": "垂下的",
                                "target_lang_sense_clarification": "指物体向下垂落"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "colgante",
                                "target_lang_sense_clarification": "que cuelga o pende"
                            },
                            {
                                "target_lang_word": "pendulante",
                                "target_lang_sense_clarification": "que se balancea como un péndulo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cc1343a-de72-3ba6-90a1-76ff157faed8",
                    "sense_definition": "Left in a state of uncertain waiting or suspense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suspense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please finish the story and don't leave me <w>dangling</w> like this.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, дорасскажи историю и не оставляй меня в таком <w>подвешенном состоянии</w>.",
                                "zh": "请把故事讲完，别让我这样<w>悬着</w>心。",
                                "es": "Por favor, termina la historia y no me dejes <w>en vilo</w> de esta manera."
                            }
                        },
                        {
                            "text": "The negotiations were left <w>dangling</w> after the main investor withdrew.",
                            "target_lang_translations": {
                                "ru": "Переговоры остались <w>незавершенными</w> после того, как главный инвестор отказался от участия.",
                                "zh": "主要投资者撤资后，谈判陷入了<w>悬而未决</w>的状态。",
                                "es": "Las negociaciones quedaron <w>en suspenso</w> después de que el inversor principal se retirara."
                            }
                        }
                    ],
                    "synonyms": [
                        "waiting",
                        "unresolved"
                    ],
                    "common_phrases": [
                        "leave me dangling"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'leave someone dangling'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставленный в состоянии неопределенного ожидания или неизвестности.",
                        "zh": "指处于一种不确定的等待或悬而未决的状态。",
                        "es": "Dejado en un estado de espera incierta o suspenso."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в подвешенном состоянии",
                                "target_lang_sense_clarification": "о ситуации или человеке в ожидании решения"
                            },
                            {
                                "target_lang_word": "в неопределенности",
                                "target_lang_sense_clarification": "без четкого ответа или завершения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悬而未决的",
                                "target_lang_sense_clarification": "指事情没有结果"
                            },
                            {
                                "target_lang_word": "处于不确定状态",
                                "target_lang_sense_clarification": "指人或事处于等待中"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "en vilo",
                                "target_lang_sense_clarification": "en estado de incertidumbre o espera ansiosa"
                            },
                            {
                                "target_lang_word": "en suspenso",
                                "target_lang_sense_clarification": "situación sin resolver o pendiente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5329b569-4070-38a0-907c-a0edad3e7ddf",
                    "sense_definition": "The present participle and gerund of <w>dangle</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>dangling</w> his keys while waiting for the bus.",
                            "target_lang_translations": {
                                "ru": "Он <w>покачивал</w> ключами в ожидании автобуса.",
                                "zh": "他在等公交车时不停地<w>晃动</w>着钥匙。",
                                "es": "Él estaba <w>balanceando</w> sus llaves mientras esperaba el autobús."
                            }
                        },
                        {
                            "text": "The children enjoyed <w>dangling</w> their feet in the cool water of the pool.",
                            "target_lang_translations": {
                                "ru": "Детям нравилось <w>болтать</w> ногами в прохладной воде бассейна.",
                                "zh": "孩子们喜欢把脚<w>垂在</w>凉爽的池水里晃动。",
                                "es": "Los niños disfrutaban <w>balanceando</w> sus pies en el agua fresca de la piscina."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dangling your feet",
                        "dangling a carrot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «болтать» или «махать».",
                        "zh": "动词 dangle 的现在分词或动名词，指使某物悬挂并摆动。",
                        "es": "Participio presente o gerundio del verbo colgar o balancear algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болтающий",
                                "target_lang_sense_clarification": "раскачивающий чем-либо"
                            },
                            {
                                "target_lang_word": "размахивающий",
                                "target_lang_sense_clarification": "совершающий колебательные движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晃动",
                                "target_lang_sense_clarification": "使物体来回摆动"
                            },
                            {
                                "target_lang_word": "垂下",
                                "target_lang_sense_clarification": "让某物悬垂"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "balanceando",
                                "target_lang_sense_clarification": "haciendo oscilar algo"
                            },
                            {
                                "target_lang_word": "colgando",
                                "target_lang_sense_clarification": "dejando algo suspendido"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "61a6a656-e4df-30bc-9c2a-5ff8023241ba",
                    "sense_definition": "The act of hanging something so that it can move or swing freely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suspension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>dangling</w> of the loose wire against the wall was very distracting.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>болтание</w> незакрепленного провода о стену очень отвлекало.",
                                "zh": "松动的电线不断撞击墙壁发出的<w>晃动</w>声让人非常分心。",
                                "es": "El constante <w>balanceo</w> del cable suelto contra la pared distraía mucho."
                            }
                        },
                        {
                            "text": "The <w>dangling</w> of the bait attracted several large fish to the surface.",
                            "target_lang_translations": {
                                "ru": "<w>Покачивание</w> приманки привлекло к поверхности несколько крупных рыб.",
                                "zh": "鱼饵的<w>晃动</w>吸引了几条大鱼游向水面。",
                                "es": "El <w>balanceo</w> del cebo atrajo a varios peces grandes a la superficie."
                            }
                        }
                    ],
                    "synonyms": [
                        "suspension"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по подвешиванию чего-либо так, чтобы оно могло свободно двигаться или качаться.",
                        "zh": "指悬挂某物使其可以自由移动或摆动的动作。",
                        "es": "El acto de colgar algo de modo que pueda moverse o balancearse libremente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскачивание",
                                "target_lang_sense_clarification": "процесс движения висящего предмета"
                            },
                            {
                                "target_lang_word": "болтание",
                                "target_lang_sense_clarification": "свободное свисание с движением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晃动",
                                "target_lang_sense_clarification": "指悬挂物的摆动过程"
                            },
                            {
                                "target_lang_word": "悬垂",
                                "target_lang_sense_clarification": "指悬挂的状态或动作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "balanceo",
                                "target_lang_sense_clarification": "acción de oscilar"
                            },
                            {
                                "target_lang_word": "oscilación",
                                "target_lang_sense_clarification": "movimiento de vaivén"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7999616f-a4df-3319-bf14-f3bec41056b9",
                    "sense_definition": "The act of following or trailing around someone, often in a persistent or subservient manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "following",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>dangling</w> after the famous actress became a source of local gossip.",
                            "target_lang_translations": {
                                "ru": "Его постоянное <w>хождение по пятам</w> за знаменитой актрисой стало поводом для местных сплетен.",
                                "zh": "他总是<w>纠缠</w>在那位著名女演员身后，成了当地的谈资。",
                                "es": "Su constante <w>ir detrás</w> de la famosa actriz se convirtió en motivo de chismes locales."
                            }
                        },
                        {
                            "text": "The young man's <w>dangling</w> at the skirts of the nobility was seen as quite pathetic.",
                            "target_lang_translations": {
                                "ru": "То, как молодой человек <w>вился</w> вокруг знати, выглядело довольно жалко.",
                                "zh": "那个年轻人<w>依附</w>在贵族身边转悠的样子看起来相当可怜。",
                                "es": "El hecho de que el joven <w>fuera detrás</w> de la nobleza era visto como algo bastante patético."
                            }
                        }
                    ],
                    "synonyms": [
                        "trailing",
                        "shadowing"
                    ],
                    "common_phrases": [
                        "dangling at the skirts"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used to describe social trailing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по постоянному следованию за кем-то, часто навязчиво или подобострастно.",
                        "zh": "指持续地、往往以卑微或纠缠的方式跟随某人。",
                        "es": "El acto de seguir o ir detrás de alguien de manera persistente o servil."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хождение по пятам",
                                "target_lang_sense_clarification": "навязчивое следование за кем-то"
                            },
                            {
                                "target_lang_word": "хвостиком",
                                "target_lang_sense_clarification": "о человеке, который везде следует за другим"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纠缠",
                                "target_lang_sense_clarification": "指死缠烂打地跟随"
                            },
                            {
                                "target_lang_word": "尾随",
                                "target_lang_sense_clarification": "指像影子一样跟着"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ir detrás de",
                                "target_lang_sense_clarification": "seguir a alguien de forma insistente"
                            },
                            {
                                "target_lang_word": "ser la sombra de",
                                "target_lang_sense_clarification": "seguir a alguien a todas partes"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}