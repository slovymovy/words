                        "source_sense_id": "a12515a0-361a-39ca-bcf1-5e9f78d2cc80",
                        "source_sense_description": "opgewekte stemming",
                        "target_lang_word": "Fröhlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fröhlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                        "entry_id": "bf264646-eeca-3a4e-b1ad-37f1c4f8bd9d",
                                        "glosses": [
                                            "Zustand, Stimmung einer Person oder Gruppe voller erkennbarer Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17cf35cf-c8d0-4521-a5ea-40d01854e1f3",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "Ihre Fröhlichkeit wirkte auf alle anderen ansteckend."
                                            },
                                            {
                                                "example_id": "e08ccdd2-c7b1-4e28-8ce5-ffb261643579",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "„In diesem Augenblick trat die Sonne völlig aus den Wolken heraus, und der kraftvolle Schall des einzelnen Schusses und der Glanz der hellen Sonne flossen für alle zu einem einzigen Eindruck von Kühnheit und Fröhlichkeit zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edf062ee-bc3c-4f7f-8586-e6120761e7e3",
                        "source_entry_id": "70833fd5-fecd-3cb4-9144-148355edd8b6",
                        "source_sense_id": "a12515a0-361a-39ca-bcf1-5e9f78d2cc80",
                        "source_sense_description": "opgewekte stemming",
                        "target_lang_word": "Heiterkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heiterkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                        "entry_id": "ed69b608-134e-3e17-8b08-b5c5bed4a816",
                                        "glosses": [
                                            "frohe, heitere, aufgelockerte Stimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a76224-4a71-4f0d-8032-57b2ffb218bb",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "Mit einem lustigen Witz trug er zur allgemeinen Heiterkeit bei."
                                            },
                                            {
                                                "example_id": "346d4350-f5a1-4464-9ae4-70e9e40d732c",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„Die subversive Heiterkeit des künstlerischen Werkes von Yves Klein ist nur die Vorderseite seines hintergründigen Ernstes.“"
                                            },
                                            {
                                                "example_id": "cdebacbc-11df-481a-8d97-c7f5ce2e27f9",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„In unserer Runde hat er den Eindruck unerschöpflicher Vitalität und Lebensfreude vermittelt, sein freundliches Wesen, sein stiller Humor, seine Gelassenheit haben mich, der ich oft und schnell vom Gipfel der Heiterkeit ins Tal der Schwermut gleite, immer beschämt.“"
                                            },
                                            {
                                                "example_id": "f7608300-8cea-48ce-af37-02e62236c723",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„Nach diesem Entschluß brachte mich Lias Heiterkeit um den Appetit.“"
                                            },
                                            {
                                                "example_id": "114b9851-2f06-4162-86bb-1bd1bb4071f4",
                                                "sense_id": "a86e7149-b23d-34d5-9788-ae966bc72280",
                                                "text": "„Dieser Sandersche Schmerzensschrei stellte die Heiterkeit wieder her, und unter Tappen und Tasten war man endlich bis in Nähe der Hoftür gekommen, wo, nach rechts hin, einige der Fässer weniger dicht nebeneinander lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
