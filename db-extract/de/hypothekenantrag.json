                "senses": [
                    {
                        "sense_id": "a0ab3eb4-88c2-3222-97ab-4ae3b42c01c1",
                        "entry_id": "f599e043-412e-33ed-b538-00aea81c9cad",
                        "glosses": [
                            "Antrag auf Gewährung eines Hypothekarkredits"
                        ],
                        "tags": [
                            "Bankwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "21054f31-91a1-45fe-bff2-79d0c986fd8b",
                                "sense_id": "a0ab3eb4-88c2-3222-97ab-4ae3b42c01c1",
                                "text": "„Es werden zum Schiffsregister ein Antrag auf Vormerkung zur Übertragung des Eigentums und ein Antrag auf Eintragung einer Hypothek gestellt. Der Antrag auf Vormerkung wird mit 9.15 Uhr, der Hypothekenantrag mit 9.16 Uhr präsentiert. Eine Rangbestimmung enthalten die Anträge nicht.“"
                            },
                            {
                                "example_id": "7497762f-f808-4006-82ad-27654b56d592",
                                "sense_id": "a0ab3eb4-88c2-3222-97ab-4ae3b42c01c1",
                                "text": "„Der Durchschnittsbetrag pro Hypothekenantrag für ein Eigenheim betrug 2011 durchschnittlich 127.486 Euro, 11,4 Prozent weniger als noch im Vorjahr.“"
                            },
                            {
                                "example_id": "a50a2415-3c92-4c63-9faf-3553aacc6d0f",
                                "sense_id": "a0ab3eb4-88c2-3222-97ab-4ae3b42c01c1",
                                "text": "„Für den Hypothekenantrag für selbstgenutztes Eigentum verlangen Banken von privaten Kunden diverse Unterlagen, jeweils in der aktuellsten Fassung, teils auch als Kopie.“"
                            },
                            {
                                "example_id": "3f851b25-984f-4729-b9d5-dac7f41c26ac",
                                "sense_id": "a0ab3eb4-88c2-3222-97ab-4ae3b42c01c1",
                                "text": "„Die Immobilienbewerter, die den Wert einer Immobilie zum Zeitpunkt eines Hypothekenantrags bestimmten, gaben mitunter dem Druck der Kreditgeber nach und setzten hohe Preise fest.“"
                            },
                            {
                                "example_id": "4fb38441-30d2-4003-98d0-d3421d4d8cb0",
                                "sense_id": "a0ab3eb4-88c2-3222-97ab-4ae3b42c01c1",
                                "text": "„Der Refinanzierungsindex erfasst alle Hypothekenanträge zur Refinanzierung einer bestehenden Hypothek.“"
                            },
                            {
                                "example_id": "f7511d58-ec07-4ee8-a8ff-3097dbcb198c",
                                "sense_id": "a0ab3eb4-88c2-3222-97ab-4ae3b42c01c1",
                                "text": "„Der Verband der US-Hypothekenbanken hat für die Woche zum 26. Dezember auf saisonbereinigter Basis eine Stagnation bei der Zahl der Hypothekenanträge ausgewiesen.“"
                            },
                            {
                                "example_id": "e703179c-569a-4311-b4c1-a3310e9b28c2",
                                "sense_id": "a0ab3eb4-88c2-3222-97ab-4ae3b42c01c1",
                                "text": "„Zur Wochenmitte gibt es Zahlen zu den Hypothekenanträgen bis Ende September.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
