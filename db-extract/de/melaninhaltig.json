                    {
                        "form_id": "f347301b-5971-492b-9f9c-d4650f16d40b",
                        "entry_id": "85415826-3218-3329-b1c0-786ce5382be7",
                        "tags": [
                            "positive",
                            "predicative",
                            "singular",
                            "neuter"
                        ],
                        "form": "es ist melaninhaltig"
                    },
                    {
                        "form_id": "c1b74094-db1a-4b58-81ed-d1d3c416e62b",
                        "entry_id": "85415826-3218-3329-b1c0-786ce5382be7",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind melaninhaltig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08edfcc1-34a9-3c56-9c15-68c6f09a8c28",
                        "entry_id": "85415826-3218-3329-b1c0-786ce5382be7",
                        "glosses": [
                            "das Pigment Melanin enthaltend, aufweisend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d94f0c8-d035-4a4e-abdc-9e2429315a13",
                                "sense_id": "08edfcc1-34a9-3c56-9c15-68c6f09a8c28",
                                "text": "„Zur gefäßreichen Chorioidea hin wird die Retina vom melaninhaltigen Pigmentepithel begrenzt.“"
                            },
                            {
                                "example_id": "30afc697-d712-4230-bab1-829b7fa692d1",
                                "sense_id": "08edfcc1-34a9-3c56-9c15-68c6f09a8c28",
                                "text": "„Bei sehr tiefer Lage der melaninhaltigen Nävuszellen im mittleren bis unteren Korium ist die Farbe dunkelblau bis violett (blauer Naevus).“"
                            },
                            {
                                "example_id": "8cccc977-22a9-4cd7-b9c5-965edecc5713",
                                "sense_id": "08edfcc1-34a9-3c56-9c15-68c6f09a8c28",
                                "text": "„Auch im Centrum einer Anzalil von Knötchen finden sich melaninhaltige, meist ziemlich grosse, rundliche oder polygonale Zellen, die aber immer in den Alveolen selbst liegen.“"
                            },
                            {
                                "example_id": "526ab054-91ee-4ce5-8e84-8d3ec1dc4bf0",
                                "sense_id": "08edfcc1-34a9-3c56-9c15-68c6f09a8c28",
                                "text": "„Wirksame Extrakte sind auch aus den melaninhaltigen Geschwülsten (Melanomen) gewonnen worden.“"
                            },
                            {
                                "example_id": "8a32ef67-632a-4612-b83d-e984cf5a94ea",
                                "sense_id": "08edfcc1-34a9-3c56-9c15-68c6f09a8c28",
                                "text": "„Spindelförmig pigmentierte Melanozyten und melaninhaltige Makrophagen liegen unterhalb des Epithels im Bindegewebe […].“"
                            },
                            {
                                "example_id": "c3fa0d7a-effc-4d07-a343-f82eb9be1504",
