                        "examples": [
                            {
                                "example_id": "dd05788c-743a-4e08-8fcb-6b17609e88c5",
                                "sense_id": "691cd04e-b8aa-3d0a-9c93-9e9c8d07430f",
                                "text": "„Dieser Rückgang betrifft jedoch keineswegs nur die Lage Moselweißer/Layer Hamm, sondern eine Vielzahl ehemaliger Rebflächen in und um Koblenz, die heute zum Teil sogar vollständig aufgegeben wurden.“"
                            }
                        ],
