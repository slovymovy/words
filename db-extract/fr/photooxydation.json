                    },
                    {
                        "form_id": "dfa3cc08-47ea-4a2b-bd4d-451c4188a326",
                        "entry_id": "99657993-7abc-3460-b6f8-4dcbfa37b62b",
                        "tags": [],
                        "form": "photo-oxydation"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "965a7157-4867-3a8f-aefc-69e33b778010",
                        "entry_id": "99657993-7abc-3460-b6f8-4dcbfa37b62b",
                        "glosses": [
                            "Oxydation provoquée par le rayonnement lumineux."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "a5d92c9e-47d7-44d3-ba6e-aa9706f58cdc",
                                "sense_id": "965a7157-4867-3a8f-aefc-69e33b778010",
                                "text": "La photooxydation est une réaction d’oxydation qui ne peut se produire qu’en présence d'un rayonnement."
                            },
                            {
                                "example_id": "782328a0-55d9-4b44-8650-4d96630bac84",
                                "sense_id": "965a7157-4867-3a8f-aefc-69e33b778010",
                                "text": "Les plus légers s'évaporent ou se dissolvent, et l'estimation avancée de 25 pour cent semble raisonnable pour un pétrole brut léger. Les composés de masse moyenne sont dégradés par photooxydation et par les microorganismes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "098e33e1-7516-4c17-81e1-0a957ad2bc32",
                        "source_entry_id": "99657993-7abc-3460-b6f8-4dcbfa37b62b",
                        "source_sense_id": "965a7157-4867-3a8f-aefc-69e33b778010",
                        "target_lang_word": "Photooxidation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Photooxidation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23286fcd-6bd3-30b7-9748-4e321a38afd4",
                                        "entry_id": "0dfdacbc-ddd9-33b5-bb97-d60888e3e457",
                                        "glosses": [
                                            "Oxidationsreaktionen, die durch Licht oder höherfrequente elektromagnetische Strahlung ausgelöst wird"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adf4c05a-4010-441e-8535-ade7df0e77b2",
                                                "sense_id": "23286fcd-6bd3-30b7-9748-4e321a38afd4",
                                                "text": "Die Photooxidation mit einem Ultravioletten Strahler (UV-V oder auch XUV Lampen <200nm) bewirkt eine starke Ozonbildung und die Oxidation von Geruchsstoffen. Fettpartikel, Öle und ähnliche Stoffe können hingegen nicht durch Photooxidation oxidiert oder gar vollständig abgebaut werden."
                                            },
                                            {
                                                "example_id": "53ef9fd1-f450-4ac0-84ab-7468a6ce240f",
                                                "sense_id": "23286fcd-6bd3-30b7-9748-4e321a38afd4",
                                                "text": "„Photooxidationen sind Oxidationsreaktionen, die durch Licht ausgelöst werden“"
                                            },
                                            {
                                                "example_id": "185f1b10-1067-4815-9225-a8ad6073013a",
                                                "sense_id": "23286fcd-6bd3-30b7-9748-4e321a38afd4",
                                                "text": "„In Gegenwart von Sauerstoff werden Kunststoffe gleichzeitig oxidiert (Photooxidation). Außerdem sind die Photooxidationsreaktionen von gleichzeitig ablaufenden thermischen Folgeprozessen (Oxidation) überlagert.“"
                                            },
                                            {
                                                "example_id": "55ec7860-2b00-4028-b8cc-5d02fbb25387",
                                                "sense_id": "23286fcd-6bd3-30b7-9748-4e321a38afd4",
                                                "text": "„In Gewässern werden die PAH mit niedrigem Molekulargewicht zumeist mikrobiell entfernt, die Verbindungen mit höherem Molekulargewicht dagegen durch Photooxidation und Sedimentierung.“"
                                            },
                                            {
                                                "example_id": "16c980ef-4a7b-49c9-ab7a-a558bf610945",
                                                "sense_id": "23286fcd-6bd3-30b7-9748-4e321a38afd4",
                                                "text": "„Ozon zerstört das Laub von Bäumen und anderen Pflanzen (Photooxidation) und verschlechtert damit das Erscheinungsbild von Städten, Nationalparks und Erholungsgebieten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
