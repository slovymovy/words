                "senses": [
                    {
                        "sense_id": "bdd43d58-ce89-317f-8fcc-91bf56e32d05",
                        "entry_id": "3da2bdf8-6e1d-3b5e-84b7-9fe47ed577ab",
                        "glosses": [
                            "Faire prendre à quelque chose la nature du liège par l'imprégnation de subérine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea22dffe-8335-4871-95f4-e6eb1e2d9a03",
                                "sense_id": "bdd43d58-ce89-317f-8fcc-91bf56e32d05",
                                "text": "S. se résorbe de plus en plus; à l'endostome, les cellules commencent à subériser leurs parois."
                            },
                            {
                                "example_id": "d3c80399-43b5-440e-98f1-2a560e8d649f",
                                "sense_id": "bdd43d58-ce89-317f-8fcc-91bf56e32d05",
                                "text": "En effet, celui-ci ne tarde pas à se subériser complètement, isolant ainsi du cylindre central le parenchyme cortical tout entier qui entre bientôt en voie de dégénérescence et d'exfoliation."
                            }
                        ]
                    }
