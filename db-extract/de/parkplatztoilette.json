                "senses": [
                    {
                        "sense_id": "22afa38b-66f9-359f-9ca4-13533d7d1a37",
                        "entry_id": "7de592e6-84f5-381f-9b08-57152e68fcb6",
                        "glosses": [
                            "Toilette an einem Parkplatz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d1eec1d-bb53-45bd-82b0-5d0cddb4b9ca",
                                "sense_id": "22afa38b-66f9-359f-9ca4-13533d7d1a37",
                                "text": "„Auf der Parkplatztoilette hatten sie sich am Morgen frisch gemacht, und nun aßen sie während der Fahrt die deftigen Sandwiches, die Lindsay aus dem Bistro mitgebracht hatte.“"
                            },
                            {
                                "example_id": "7726f176-5067-44f5-94f8-e24f2f501950",
                                "sense_id": "22afa38b-66f9-359f-9ca4-13533d7d1a37",
                                "text": "„Im Morgengrauen stehen unter dem Vordach einer Parkplatztoilette rund 40 Kilometer nördlich von Houston etwa hundert Männer und einige Frauen und beten.“"
                            },
                            {
                                "example_id": "63a7d4f4-6b1f-47ac-b0d1-7786cb330df5",
                                "sense_id": "22afa38b-66f9-359f-9ca4-13533d7d1a37",
                                "text": "„Ein niedersächsischer Polizist hat selbst vor einer durchaus ekeligen Hilfeleistung nicht Halt gemacht: Der 29-Jährige erwies sich als wahrer ‚Freund und Helfer‘ und fischte für eine Rentnerin deren Autoschlüssel aus der Fäkaliengrube einer Parkplatztoilette, wie die Polizei gestern mitteilte.“"
                            },
                            {
                                "example_id": "5aaad11d-1ab3-48a5-833c-935167fd7177",
                                "sense_id": "22afa38b-66f9-359f-9ca4-13533d7d1a37",
                                "text": "„Im Gebäude der Parkplatztoilette können die Politiker und ihre teuren Experten die Billigvariante aus Edelstahl studieren und sich anschließend für die Kostenersparnis loben, mit der die Umrüstung erfolgen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
