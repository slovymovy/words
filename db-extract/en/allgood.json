                        ],
                        "examples": [
                            {
                                "example_id": "deed9087-f784-45cb-ad7a-4b6d2362a3b1",
                                "sense_id": "f36412f8-ef18-3007-a4bd-59d3b203fb4a",
                                "text": "God is absolute power, in that He totally annihilates inability, nor can power and will in Him be restrained, since He is almighty, and allgood."
                            },
                            {
                                "example_id": "49366d7b-3f0c-494d-b1f3-dc81cf406f20",
                                "sense_id": "f36412f8-ef18-3007-a4bd-59d3b203fb4a",
                                "text": "No, he replied, it is not satisfactory, and though he will bear it if it is of necessity, he cannot regard it as the creation of a God \"allgood, allwise, allpotent.\""
                            },
                            {
                                "example_id": "84c0489b-455b-4e36-af65-6a6e622bce4f",
                                "sense_id": "f36412f8-ef18-3007-a4bd-59d3b203fb4a",
                                "text": "Almighty God! That shinest with the sun, That slumb'rest not when day grows into night! Thou Source of all, of tranquil peace and joy! Thou king of glory and majestic light ! Thou allgood Father!"
                            }
                        ]
                    }
                ],
