                        ],
                        "form": "депо́"
                    },
                    {
                        "form_id": "f8d10d30-1f8d-4627-a6df-889bf4df9edd",
                        "entry_id": "81b1fa32-2b45-396c-b056-6af2952253db",
                        "tags": [
