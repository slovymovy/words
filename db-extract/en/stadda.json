                        "glosses": [
                            "A double-bladed handsaw for cutting the teeth of combs."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5dbae30b-9e37-471b-84f7-3b8d7053b929",
                                "sense_id": "e857d923-dc0d-3463-a750-65ed6412d973",
                                "text": "This comb shaped flat was now gripped in a wooden knee vice or \"clam\" and the teeth cut by means of a double bladed saw called a \"stadda\"."
                            },
                            {
                                "example_id": "25c18cc0-15e9-4f6c-8f2e-ee4bad66468a",
                                "sense_id": "e857d923-dc0d-3463-a750-65ed6412d973",
                                "text": "The gaps between the teeth along the body of the comb indicate that the stadda was held at an angle as the bases of the gaps are not square to the width of the comb."
                            }
                        ]
                    }
