                        ]
                    },
                    {
                        "translation_id": "a6aedfe2-f0bb-41cc-a609-9af50130c668",
                        "source_entry_id": "46e91f2d-1131-3af1-b6e3-41247a913fb6",
                        "source_sense_id": "8704477d-f3c0-325c-bf7e-760206bddeac",
                        "source_sense_description": "inflammation of the gall bladder",
                        "target_lang_word": "Gallenblasenentzündung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gallenblasenentzündung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7664e7f8-fd6e-3238-a840-6ba2b9cc73e2",
                                        "entry_id": "716a12bb-b336-3e54-871c-bc81c59f0176",
                                        "glosses": [
                                            "akute oder chronische Entzündung der Gallenblase"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b9acf8e-d2ed-487e-8d3d-8cdf614ecf9a",
                                                "sense_id": "7664e7f8-fd6e-3238-a840-6ba2b9cc73e2",
                                                "text": "„Nach einer Mitteilung des Hofs seien bei ihm Untersuchungen wegen einer Gallenblasenentzündung notwendig geworden, berichtete die Staatsagentur SPA ohne weitere Angaben.“"
                                            },
                                            {
                                                "example_id": "b3730b61-13c4-4e44-b1b0-429f1d8b992b",
                                                "sense_id": "7664e7f8-fd6e-3238-a840-6ba2b9cc73e2",
                                                "text": "„Der Arzt, den Frau Helena Lewicka holte, stellte eine akute Gallenblasenentzündung fest und empfahl strenge Diät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d68c5b73-cee8-4266-a744-7defacc6725f",
                        "source_entry_id": "46e91f2d-1131-3af1-b6e3-41247a913fb6",
                        "source_sense_id": "8704477d-f3c0-325c-bf7e-760206bddeac",
                        "source_sense_description": "inflammation of the gall bladder",
                        "target_lang_word": "холецисти́т",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "холецисти́т",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0ac5e3cb-1fc4-3fb5-8ed6-8ba393fcaa95",
                                        "entry_id": "c721f876-c5ef-3b50-b6be-1552aa053a40",
                                        "glosses": [
                                            "мед. воспаление желчного пузыря"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afeb8205-0300-4c15-b11d-6c9ac14d34b4",
                                                "sense_id": "0ac5e3cb-1fc4-3fb5-8ed6-8ba393fcaa95",
                                                "text": "И вот я смотрел на женщину с красивыми длинными ногами, в красивом шерстяном платье, с красивым и несколько бледным лицом, на котором читались намёки на увядание, но и прекрасная зрелость, вегетативный невроз, холецистит, любовь к сладкой пище, ежегодные морские купания, и говорил ей спокойно: «Ты ему понравилась?»"
                                            },
                                            {
                                                "example_id": "3b15efc1-47ef-4200-b15b-1251b47c9dd2",
                                                "sense_id": "0ac5e3cb-1fc4-3fb5-8ed6-8ba393fcaa95",
                                                "text": "Кроме того, растительное масло обладает мощным желчегонным действием, а значит, препятствует развитию холецистита и желчнокаменной болезни."
                                            },
                                            {
                                                "example_id": "4d84afd5-2b6f-4a01-902a-f5f78637f42f",
                                                "sense_id": "0ac5e3cb-1fc4-3fb5-8ed6-8ba393fcaa95",
                                                "text": "— Это вы ей назначили поднимать гемоглобин яичницей с салом? При холецистите? — Откуда вы эту глупость взяли?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
