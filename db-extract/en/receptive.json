                    {
                        "translation_id": "7bee9f2d-5d3b-4efd-ad01-ab20a88c39a3",
                        "source_entry_id": "b3e57e4d-91ad-3598-b99d-a4a2ef8a4128",
                        "source_sense_description": "ready to receive something, especially new concepts or ideas",
                        "target_lang_word": "réceptif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réceptif",
