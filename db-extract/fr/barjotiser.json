                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37c07ae0-65e7-4dc4-b903-8cf5bc485df5",
                                "sense_id": "eae22aa7-78a2-3610-9824-c61e3ed9c8cc",
                                "text": "Oui mais lui il barjotise pour pas cher (rire)."
                            },
                            {
                                "example_id": "8ccf48ce-50f0-45d4-8adb-c46e5e5e04dd",
                                "sense_id": "eae22aa7-78a2-3610-9824-c61e3ed9c8cc",
                                "text": "Alors, m'arrive de psychoter, de paranoyer, de barjotiser, et même de gagatiser, et de venir alors vous péter les c...euh, de vous casser les noix."
                            }
                        ]
