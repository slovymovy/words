                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d5ead05-eda4-4b7a-b8c5-31a1ce36b1b9",
                                "sense_id": "c37e2d77-19b0-3cbb-84b7-ea1fcd0f1dd6",
                                "text": "\"Geweldige chauffeurs die met grote snelheden in de mist overal langs scheuren en tussendoor kruipen in de files, desnoods over de vluchtstrook. Op het laatste moment ritsen om enkele auto’s op te schieten. Autorijden is verworden tot een stijlloos voortsnellen. Ikke ikke en de rest kan stikken.\""
                            },
                            {
                                "example_id": "955a1463-3113-4dd7-9a03-bf9b53f273f8",
                                "sense_id": "c37e2d77-19b0-3cbb-84b7-ea1fcd0f1dd6",
                                "text": "Voortsnellen naar de afgrond is niet tegen te gaan na het verbreken van de betrekking die aan de hemel verbindt.”"
                            }
                        ]
                    }
