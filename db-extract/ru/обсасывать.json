                ],
                "senses": [
                    {
                        "sense_id": "59a6ba1d-dc73-3fd3-91bf-51bc73215a9e",
                        "entry_id": "83e7589f-5cc6-3034-b5a3-b7a61679c9d2",
                        "glosses": [
                            "сосать что-либо со всех сторон"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3feb8ca-56c1-4bcd-9b5b-d507dcfafcde",
                                "sense_id": "59a6ba1d-dc73-3fd3-91bf-51bc73215a9e",
                                "text": "Веревкин со свистом и шипеньем обсасывал каждую кость и с умилением вытирал лоснившиеся жирные губы салфеткой."
                            },
                            {
                                "example_id": "0365fc2b-2d4c-47af-8ba2-68604111e4b0",
                                "sense_id": "59a6ba1d-dc73-3fd3-91bf-51bc73215a9e",
                                "text": "По горькому опыту знаю, что наоборот, ― ласкового теленка обсасывает всякий, кому не лень."
                            },
                            {
                                "example_id": "4cca4350-930d-449d-9e23-f8270de73c74",
                                "sense_id": "59a6ba1d-dc73-3fd3-91bf-51bc73215a9e",
                                "text": "Арап, не отвечая, продолжает громко обсасывать конфету."
                            },
                            {
                                "example_id": "b3d4a0f8-cbd1-456c-b955-7eb7b0d58666",
                                "sense_id": "59a6ba1d-dc73-3fd3-91bf-51bc73215a9e",
                                "text": "Волны гребенчатые укачивают диких казарок, плетни огорода лижут, обсасывают."
                            },
                            {
                                "example_id": "e7e08b85-6a82-493a-a795-d1cc7498f1ff",
                                "sense_id": "59a6ba1d-dc73-3fd3-91bf-51bc73215a9e",
                                "text": "Он нес свою отерханную винтовку, держа ее за ремень; обсасывал с усов ледяные сосульки."
                            }
                        ]
                    },
                    {
                        "sense_id": "40cc881a-91ce-31ed-b397-ce00cccbd78c",
                        "entry_id": "83e7589f-5cc6-3034-b5a3-b7a61679c9d2",
                        "glosses": [
                            "прост. излишне подробно, до мелочей изучать, рассматривать, обрабатывать и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00997fcf-9f79-4f49-9887-0331f5a4231f",
                                "sense_id": "40cc881a-91ce-31ed-b397-ce00cccbd78c",
                                "text": "Обсасываю тему с удовольствием."
                            },
                            {
                                "example_id": "66388730-f3f0-4e51-8e93-9974f57732ef",
                                "sense_id": "40cc881a-91ce-31ed-b397-ce00cccbd78c",
                                "text": "Он аккуратно, молчаливо обсасывал каждую кандидатуру и решал коротко: ― Не надо!.."
                            },
                            {
                                "example_id": "544c3d41-dded-4e48-9e58-21365adf8290",
                                "sense_id": "40cc881a-91ce-31ed-b397-ce00cccbd78c",
                                "text": "― Ты себе выдумала историю и обсасываешь её со всех сторон."
                            }
                        ]
                    }
                ],
