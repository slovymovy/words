            {
                "entry_id": "681fd635-b1ef-30f8-b46d-e9c5a11e3f06",
                "word": "Dol",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b1dc77b-373e-3a15-9193-e75d3c312752",
                        "entry_id": "681fd635-b1ef-30f8-b46d-e9c5a11e3f06",
                        "glosses": [
                            "A township in Lop, Hotan prefecture, Xinjiang autonomous region, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d54ae14c-df8e-401c-89d0-f3f4e072bda5",
                                "sense_id": "1b1dc77b-373e-3a15-9193-e75d3c312752",
                                "text": "Journey across desert. Two Langars at 5th and 8th mile. Enter on cultivation at 14th mile, close to the village of Dol. Road excellent."
                            },
                            {
                                "example_id": "810f2fbc-a827-48ba-8949-12e424378bda",
                                "sense_id": "1b1dc77b-373e-3a15-9193-e75d3c312752",
                                "text": "Obul Kasem Imin, a Uighur from Dol village in Lop county, near Khotan, was reportedly taken into custody by public security officers from Lop County in September 1996 for \"speaking out against the government\"."
                            },
                            {
                                "example_id": "921c5e92-b39e-46e4-bf32-7eb4bb18cddc",
                                "sense_id": "1b1dc77b-373e-3a15-9193-e75d3c312752",
                                "text": "Memtimin Abla, deputy chief of police of the Lop county police department, told RFA that the three attackers were all from Dol township in Lop county and between the ages of 18 and 20."
                            },
                            {
                                "example_id": "233f5622-689f-412b-87c3-15ec1a9e753e",
                                "sense_id": "1b1dc77b-373e-3a15-9193-e75d3c312752",
                                "text": "“Head out boldly and bring back the cash,” a village official in Dol Township in southern Xinjiang told dozens of farmers, according a local government report last year. The village officials urged team leaders to take special care of three villagers in their 60s who had signed up to pick cotton, the report said."
                            }
                        ]
                    }
