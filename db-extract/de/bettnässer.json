                "senses": [
                    {
                        "sense_id": "70e6a46d-8d41-377d-87fd-710b1f2b1ee5",
                        "entry_id": "c5df977e-3edf-3c2d-a96e-6eff6f199ed1",
                        "glosses": [
                            "Mensch, der nachts unbewusst Wasser lässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0e03747-2776-45ed-b813-bba9a75c7bc6",
                                "sense_id": "70e6a46d-8d41-377d-87fd-710b1f2b1ee5",
                                "text": "Kleinkinder sind oft Bettnässer, Erwachsene seltener."
                            },
                            {
                                "example_id": "2ab089f7-8b37-4c60-ae3d-a3cd8eebf873",
                                "sense_id": "70e6a46d-8d41-377d-87fd-710b1f2b1ee5",
                                "text": "„Dazu passt die Geschichte vom Bettnässer, dem sein Freund rät, sich doch psychiatrisch behandeln zu lassen gegen das Bettnässen.“"
                            },
                            {
                                "example_id": "79b58434-4ea8-4020-8603-216865036a3a",
                                "sense_id": "70e6a46d-8d41-377d-87fd-710b1f2b1ee5",
                                "text": "„Starr vor Angst blieb er die ganze Nacht über in seinem Urin liegen, wusste ja, was einem Bettnässer passierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
