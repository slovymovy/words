                {
                    "sense_id": "d54273bb-e6e3-3ec6-a304-eb2f524744c2",
                    "sense_definition": "Qualité morale d'une personne honnête, incorruptible et fidèle à ses devoirs de probité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce magistrat est admiré pour son <w>intégrité</w> irréprochable et son sens de la justice."
                        },
                        {
                            "text": "Personne ne peut mettre en doute l'<w>intégrité</w> morale de cette femme d'affaires."
                        }
                    ],
                    "synonyms": [
                        "probité",
                        "honnêteté",
                        "droiture",
                        "incorruptibilité"
                    ],
                    "antonyms": [
                        "corruption",
                        "malhonnêteté"
                    ],
                    "common_phrases": [
                        "intégrité morale",
                        "douter de son intégrité",
                        "manquer d'intégrité"
                    ]
                },
                {
                    "sense_id": "e4b6be87-de5f-3329-bc48-dd4e18cc433f",
                    "sense_definition": "État d'une chose qui est demeurée dans son ensemble, intacte et non diminuée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le traité international vise à garantir l'<w>intégrité</w> territoriale de toutes les nations."
                        },
                        {
                            "text": "Le port du casque assure l'<w>intégrité</w> physique des cyclistes en cas de chute."
                        }
                    ],
                    "synonyms": [
                        "totalité",
                        "plénitude"
                    ],
                    "antonyms": [
                        "altération",
                        "dégradation",
                        "mutilation"
                    ],
                    "common_phrases": [
                        "intégrité territoriale",
                        "intégrité physique",
                        "préserver l'intégrité"
                    ]
                },
                {
                    "sense_id": "bd5c069e-34c6-3e0d-a64e-52ddee1ee549",
                    "sense_definition": "Propriété d'une information ou d'un ensemble de données qui n'a subi aucune altération ni modification non autorisée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'administrateur informatique effectue des contrôles réguliers pour vérifier l'<w>intégrité</w> des données sauvegardées."
