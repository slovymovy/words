                "senses": [
                    {
                        "sense_id": "703e34a9-04fc-31ef-a0d6-5959b2a734f7",
                        "entry_id": "a5177645-4bc2-3829-91ff-78825f8a57fb",
                        "glosses": [
                            "Action d’être soumis à la flamme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0f5730-5ae1-44d9-b2a9-357d7dcadf2c",
                                "sense_id": "703e34a9-04fc-31ef-a0d6-5959b2a734f7",
                                "text": "Le flambage d’un poulet."
                            },
                            {
                                "example_id": "019fdefb-8f72-45cc-921d-939b456845b3",
                                "sense_id": "703e34a9-04fc-31ef-a0d6-5959b2a734f7",
                                "text": "Le flambage d’un instrument en vue de le rendre aseptique."
                            },
                            {
                                "example_id": "2098a164-87fc-44cf-ab28-a502464a7826",
                                "sense_id": "703e34a9-04fc-31ef-a0d6-5959b2a734f7",
                                "text": "Le flambage consistait à passer très vite le tissu sur une flamme, pour brûler le duvet en surface."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d3fa02e-3591-3672-b09c-830767a5c3db",
                        "entry_id": "a5177645-4bc2-3829-91ff-78825f8a57fb",
                        "glosses": [
                            "Action, pour une structure soumise à une charge de compression, de se déverser latéralement."
                        ],
                        "tags": [
                            "Résistance des matériaux"
                        ],
                        "examples": [
                            {
                                "example_id": "9104355f-8e77-4689-a0fa-0e765d5aee07",
                                "sense_id": "2d3fa02e-3591-3672-b09c-830767a5c3db",
                                "text": "On peut dire que sur dix écroulements survenus dans les constructions métalliques, il y en a huit dus au flambage."
                            }
                        ]
                    }
                ],
