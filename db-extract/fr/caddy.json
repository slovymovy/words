                        "source_sense_id": "2e8e23da-1701-318e-85bd-9cc9b63695cb",
                        "source_sense_description": "chariot de supermarché",
                        "target_lang_word": "winkelkar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
