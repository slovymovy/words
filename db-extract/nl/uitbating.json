                ],
                "senses": [
                    {
                        "sense_id": "9702c7a5-fd4e-381c-97d0-6b4ab2a7a03f",
                        "entry_id": "f37453d9-f32e-3a19-82b8-07c84ea91fa7",
                        "glosses": [
                            "beheer van bezittingen om er voordeel uit te behalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c303ab52-6972-4c86-9b6e-d4c6911158cd",
                                "sense_id": "9702c7a5-fd4e-381c-97d0-6b4ab2a7a03f",
                                "text": "De stijgende kosten om de uitbating te garanderen, worden niet gecompenseerd door stijgende inkomsten."
                            }
                        ]
                    },
                    {
                        "sense_id": "48d6f069-235c-3f6e-8224-72ac84c865b0",
                        "entry_id": "f37453d9-f32e-3a19-82b8-07c84ea91fa7",
                        "glosses": [
                            "beheren van een (dochter)onderneming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28a67ac-9a57-419d-b19a-563566bf0065",
                                "sense_id": "48d6f069-235c-3f6e-8224-72ac84c865b0",
                                "text": "Het stadion in Lille werd gebouwd door een onderneming van de groep Eiffage, die ook voor de uitbating zorgt. De metropolitaine regio betaalt een jaarlijkse vergoeding, maar krijgt ook opbrengsten uit het gebruik van het stadion."
                            },
                            {
                                "example_id": "7ae09dd7-e44a-48a3-921b-21844d4c4e23",
                                "sense_id": "48d6f069-235c-3f6e-8224-72ac84c865b0",
                                "text": "LRM stapte in 2006 mee in de droom van Peter Geurden om een Limburgse hotelgroep van hoog niveau uit te bouwen. Hij beschikte over twee hoteluitbatingen: ECU en Atlantis in Genk. Op dat moment werd tegelijk 10,5 miljoen euro geïnvesteerd in het designhotel Carbon in Genk en het prestigehotel Eburon in Tongeren, en lag ook de overname van Eurotel in Lanaken op tafel."
                            }
                        ]
                    },
                    {
                        "sense_id": "30557abc-8972-354d-92db-2f6e2049cbe0",
                        "entry_id": "f37453d9-f32e-3a19-82b8-07c84ea91fa7",
                        "glosses": [
                            "exploitatie en beheer in het bijzonder van een horecaonderneming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95089997-3d15-430c-b77d-b64f7e76fcf8",
                                "sense_id": "30557abc-8972-354d-92db-2f6e2049cbe0",
                                "text": "‘Het faillissement van de uitbater van de cafetaria is uiteraard geen leuk nieuws. De stad huurt het zwembad, maar niet de cafetaria. Toch zullen we, samen met Sportoase, zo snel mogelijk naar een nieuwe uitbating zoeken.’"
                            }
                        ]
                    }
