        "nl-extract.jsonl": [
            {
                "entry_id": "84a90c4a-306d-31b8-9ba5-f2f98acf9a77",
                "word": "schietgat",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "f3361580-3603-408f-868c-d37b01560bbb",
                        "entry_id": "84a90c4a-306d-31b8-9ba5-f2f98acf9a77",
                        "tags": [
                            "plural"
                        ],
                        "form": "schietgaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "51ecca13-2f82-3ae1-96ef-29b6632ab504",
                        "entry_id": "84a90c4a-306d-31b8-9ba5-f2f98acf9a77",
                        "glosses": [
                            "een opening in een muur van een kasteel, vesting of bunker waardoor geschoten kan worden op de vijand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8799993-ba93-4e3c-861b-7021786b43bb",
                                "sense_id": "51ecca13-2f82-3ae1-96ef-29b6632ab504",
                                "text": "Erbuiten lichtte de muziektempel rood, groen en blauw op in het midden van de bossen, naast de prachtige vijver. De rook van de kunstinstallatie – door de Nederlandse kunstenaar Chiam Van Luit – die uit de schietgaten van het kasteel kringelde, maakte het filmische decor compleet."
                            },
                            {
                                "example_id": "15cb21fb-e8de-4737-b8a0-98b75b1e0030",
                                "sense_id": "51ecca13-2f82-3ae1-96ef-29b6632ab504",
                                "text": "„We leveren ook inhoudelijk een bijdrage”, stelt Evans. „Want wij hebben de oorlogservaring die Pollard en Bosquet niet hebben.” Hij wijst op de schietgaten in de zuidmuur, die duidelijk is gerestaureerd. „Volgens de bronnen hebben de soldaten in de nacht van 17 juni schietgaten in de muur gemaakt, evenals een houten platform om over de muur te kunnen schieten. In Afghanistan hebben we ook wel eens schietgaten in een hut moeten hakken; dat kost veel tijd en moeite. Toen ik de anderen vroeg wat zij die nacht zouden hebben gedaan, terwijl het koud en regenachtig was, antwoordden ze: ‘Wachten tot de officier van dienst langs was geweest en daarna gaan slapen. De volgende dag hadden we wel een kar gepakt om over de muur te kunnen schieten.’ Door een schietgat zie je bijna niets en bovendien moet je oppassen dat de vijand je wapen niet grijpt.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "4dbc10a4-965e-3fe4-a487-7b8fd97c35b5",
                        "entry_id": "84a90c4a-306d-31b8-9ba5-f2f98acf9a77",
                        "glosses": [
                            "gaten ontstaan door een schot met een vuurwapen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3e52756-2174-4615-8130-ca6229419e68",
                                "sense_id": "4dbc10a4-965e-3fe4-a487-7b8fd97c35b5",
                                "text": "Aan de Benkoelenstraat is een woning meerdere keren beschoten. Er zitten schietgaten in de gevel. In totaal zouden het er vijftien zijn. Deze straat is ook afgezet voor onderzoek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62bdd41f-3441-4fa6-a5fc-43b86150b5fe",
                        "source_entry_id": "84a90c4a-306d-31b8-9ba5-f2f98acf9a77",
                        "source_sense_id": "51ecca13-2f82-3ae1-96ef-29b6632ab504",
                        "source_sense_description": "gat om door te schieten",
                        "target_lang_word": "loophole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loophole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69551f97-ba9e-34ce-bf59-03c36c3da17c",
                                        "entry_id": "d0b7fa0b-20b9-3ed7-b0b8-a05534bacf5b",
                                        "glosses": [
                                            "A slit in a castle wall; today, any similar window for shooting a ranged weapon or letting in light."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c32130-cd56-4f1f-86be-fb0b7418ac8c",
                                                "sense_id": "69551f97-ba9e-34ce-bf59-03c36c3da17c",
                                                "text": "[…] and having a fair loophole, as it were, from a broken hole in the tree, he took a sure aim, without being seen, waiting till they were within about thirty yards of the tree, so that he could not miss."
                                            },
                                            {
                                                "example_id": "3b8ce0c3-e789-4d6a-9f79-caf382412eb0",
                                                "sense_id": "69551f97-ba9e-34ce-bf59-03c36c3da17c",
                                                "text": "There was a loophole in this wall, to let the light in, just at the height of a person's head, who was sitting near the chimney."
                                            },
                                            {
                                                "example_id": "3ed159bd-6de8-4648-962d-650dfb74f522",
                                                "sense_id": "69551f97-ba9e-34ce-bf59-03c36c3da17c",
                                                "text": "The sun had shifted round, and the myriad windows of the Ministry of Truth, with the light no longer shining on them, looked grim as the loopholes of a fortress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d23de02-144e-3193-b11c-5a24127736c1",
                                        "entry_id": "d0b7fa0b-20b9-3ed7-b0b8-a05534bacf5b",
                                        "glosses": [
                                            "A method of escape, especially an ambiguity or exception in a rule or law that can be exploited in order to avoid its effect."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0eee0b3-24bc-41be-8e36-1b8af5e4dc62",
                                                "sense_id": "0d23de02-144e-3193-b11c-5a24127736c1",
                                                "text": "Coupling the poor girl's intelligence with my previous knowledge, and the result of our good friend's inquiries on the spot, I left him no loophole of escape, and laid bare the whole villany which by these lights became plain as day."
                                            },
                                            {
                                                "example_id": "7b244412-4e9c-4069-8fba-b14cba115fb2",
                                                "sense_id": "0d23de02-144e-3193-b11c-5a24127736c1",
                                                "text": "You have a contract that says you will work until Island Towers is finalized, which I interpret as completion of construction, or I can stop you working elsewhere. And there's no loopholes, because you drafted it and you're the best."
                                            },
                                            {
                                                "example_id": "c2fb522f-181a-4c12-bb93-dafe3a1bfce4",
                                                "sense_id": "0d23de02-144e-3193-b11c-5a24127736c1",
                                                "text": "They would rather ask more from the vast majority of Americans and put our recovery at risk than close even a single tax loophole that benefits the wealthy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loophole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cdfd1ac-6f97-3104-adbb-8c6dba7a9613",
                                        "entry_id": "6d6a753b-2607-3271-b5bb-a15bf657a014",
                                        "glosses": [
                                            "To prepare a building for defense by preparing slits or holes through which to fire on attackers"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12e9d469-8326-451d-866f-262c173b4dd0",
                                                "sense_id": "0cdfd1ac-6f97-3104-adbb-8c6dba7a9613",
                                                "text": "The lower windows were barricaded, and the whole building loopholed for musketry fire."
                                            },
                                            {
                                                "example_id": "813c5578-2838-49ca-8d53-e8a7441d7225",
                                                "sense_id": "0cdfd1ac-6f97-3104-adbb-8c6dba7a9613",
                                                "text": "The doors were barricaded, the shutters closed upon the windows and loopholed, and provisions were brought in from the outhouses."
                                            },
                                            {
                                                "example_id": "43601d12-fcf0-44c7-bafe-9f48619fb644",
                                                "sense_id": "0cdfd1ac-6f97-3104-adbb-8c6dba7a9613",
                                                "text": "The Germans were loopholing it for defence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fa2fdb2-2591-3b08-b3af-037e29e9a520",
                                        "entry_id": "6d6a753b-2607-3271-b5bb-a15bf657a014",
                                        "glosses": [
                                            "To exploit (a law, etc.) by means of loopholes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3753f598-ceca-44b0-ac76-7eb92e0ba359",
                                                "sense_id": "7fa2fdb2-2591-3b08-b3af-037e29e9a520",
                                                "text": "Abroad they had developed loopholing the law into an art; in Israel they jettisoned loopholing for ignoring the law wherever possible. Obeying laws was for naive fools."
                                            },
                                            {
                                                "example_id": "35fa063f-df87-4a74-8740-01bf79e76372",
                                                "sense_id": "7fa2fdb2-2591-3b08-b3af-037e29e9a520",
                                                "text": "De-moralizing the subject can be, quite simply, demoralizing, as stirring statements of ideals turn into persnickety rules with exceptions crying out to be loopholed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fffc7ff2-b765-41b1-a4fd-5caa60c99f51",
                        "source_entry_id": "84a90c4a-306d-31b8-9ba5-f2f98acf9a77",
                        "source_sense_id": "51ecca13-2f82-3ae1-96ef-29b6632ab504",
                        "source_sense_description": "gat om door te schieten",
                        "target_lang_word": "embrasure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embrasure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1104ac6-ee54-3c0d-814d-d19ed3d5a249",
                                        "entry_id": "a0a26e7f-2514-3671-973a-eaff4ff42670",
                                        "glosses": [
                                            "Any of the indentations between the merlons of a battlement; an opening in a wall or parapet through which ordnance can be fired."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1999c0-7518-49f7-a9e7-8573ef4eea1d",
                                                "sense_id": "e1104ac6-ee54-3c0d-814d-d19ed3d5a249",
                                                "text": "Near-synonym: crenel (sometimes hyponymous technically)"
                                            },
                                            {
                                                "example_id": "bf9daf67-8795-481b-81d1-d96c2ab48350",
                                                "sense_id": "e1104ac6-ee54-3c0d-814d-d19ed3d5a249",
                                                "text": "But there were less casualties than might have been expected, and the barricade rose steadily, a wall of concrete two feet thick, with embrasures for two machine-guns and a small field gun."
                                            },
                                            {
                                                "example_id": "f8380b13-143e-463f-a530-a9147822815a",
                                                "sense_id": "e1104ac6-ee54-3c0d-814d-d19ed3d5a249",
                                                "text": "The walls are slitted with embrasures through which bowmen could fire, indicating that the belfry also served as a stronghold during border skirmishes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "884507ac-1a2d-3976-8eb1-ad7a8486cc3e",
                                        "entry_id": "a0a26e7f-2514-3671-973a-eaff4ff42670",
                                        "glosses": [
                                            "Any small protected space."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f717eb4b-7f83-44a4-8e15-0bb0ce676057",
                                                "sense_id": "884507ac-1a2d-3976-8eb1-ad7a8486cc3e",
                                                "text": "She had a special seat there, a little embrasure between two upright slabs of sandstone, which was sheltered and private."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9230d8f9-b333-34dd-9432-123bb1eba466",
                                        "entry_id": "a0a26e7f-2514-3671-973a-eaff4ff42670",
                                        "glosses": [
                                            "The slanting indentation in a wall for a door or window, such that the space is larger on the inside than the outside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b8f274-252d-4b3a-ba45-a27cafa9ecd9",
                                                "sense_id": "9230d8f9-b333-34dd-9432-123bb1eba466",
                                                "text": "Now he stands in a window embrasure, Liz's prayer book in hand."
                                            },
                                            {
                                                "example_id": "8e009368-2c3f-41f7-8ac0-f4f8994e9160",
                                                "sense_id": "9230d8f9-b333-34dd-9432-123bb1eba466",
                                                "text": "When the fit had spent itself he walked weakly to the window and, lifting the sash, sat in a corner of the embrasure and leaned his elbow upon the sill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5812fc8-361e-31d6-93a8-9ee9614200ce",
                                        "entry_id": "a0a26e7f-2514-3671-973a-eaff4ff42670",
                                        "glosses": [
                                            "An embrace."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b45bce6-4aa3-453e-8452-d5c9022aa28a",
                                                "sense_id": "c5812fc8-361e-31d6-93a8-9ee9614200ce",
                                                "text": "And suddenly; where injury of chance / Puts back leave-taking, justles roughly by / All time of pause, rudely beguiles our lips / Of all rejoindure, forcibly prevents / Our lock'd embrasures, strangles our dear vows / Even in the birth of our own labouring breath:"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19a4b4e5-9135-444d-96c2-c3e212500974",
                        "source_entry_id": "84a90c4a-306d-31b8-9ba5-f2f98acf9a77",
                        "source_sense_id": "4dbc10a4-965e-3fe4-a487-7b8fd97c35b5",
                        "source_sense_description": "kogelgat",
                        "target_lang_word": "bullet hole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bullet hole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d5f25be-ce25-3274-87de-955bb2e190b8",
                                        "entry_id": "caca31e2-6da1-39a8-8f93-1eb84fa4fe54",
                                        "glosses": [
                                            "A circular wound or hole caused by the projectile of a firearm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b09a22bc-46dd-463b-b231-6ddebf910c7a",
                                                "sense_id": "8d5f25be-ce25-3274-87de-955bb2e190b8",
                                                "text": "The car was covered in bullet holes after the gang shootout."
                                            },
                                            {
                                                "example_id": "75efbae2-44d7-438d-8cc1-6196b6feb4fe",
                                                "sense_id": "8d5f25be-ce25-3274-87de-955bb2e190b8",
                                                "text": "Can’t say I saw any road or any upkeep, unless the body of a middle-aged negro, with a bullet-hole in the forehead, upon which I absolutely stumbled three miles farther on, may be considered as a permanent improvement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
