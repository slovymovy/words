                "senses": [
                    {
                        "sense_id": "a4e1872c-734e-35ab-b08e-ccc8209e1ed8",
                        "entry_id": "7628950b-0bdc-377a-825e-12bbe535427b",
                        "glosses": [
                            "eine Reihe militärischer Offensiven während des Vietnamkriegs, die von der nordvietnamesischen Armee und dem Vietcong während des Neujahrsfests Tet durchgeführt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a4f1f4e-9c03-44da-b037-6bda9558472d",
                                "sense_id": "a4e1872c-734e-35ab-b08e-ccc8209e1ed8",
                                "text": "„»Dann sind sie sicher mit der Tet-Offensive im Januar 1968 vertraut.«“"
                            },
                            {
                                "example_id": "6d8e6ccf-7610-4dbc-8339-d086ae7b5704",
                                "sense_id": "a4e1872c-734e-35ab-b08e-ccc8209e1ed8",
                                "text": "„›Südostasien, oder was hast du gesagt? In den letzten 50 Jahren ist da unten in Scheißsüdostasien, soviel ich weiß, nicht mehr viel abgegangen, was mit dem Mist hier vergleichbar wär, und bei der Tet-Offensive warst du bestimmt noch nicht mal 'n Funkeln in Papas Augen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
