                "senses": [
                    {
                        "sense_id": "eaa50a93-f2aa-3b4e-8468-0394070b6c8d",
                        "entry_id": "d66b4332-b766-346c-b190-0988d296978c",
                        "glosses": [
                            "massenhaftes Auftreten der Pest innerhalb einer Population"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eb0f52a-f81a-4cd5-884e-917c19ba2022",
                                "sense_id": "eaa50a93-f2aa-3b4e-8468-0394070b6c8d",
                                "text": "„Die jiddische Sprache wurde geboren in den Judenpogromen durch die Kreuzfahrer und den Blutprozessen zur Zeit der Pestepidemien, an denen man Juden die Schuld gab.“"
                            },
                            {
                                "example_id": "1e44202a-4a84-4bea-aa97-cd3fa8b8806b",
                                "sense_id": "eaa50a93-f2aa-3b4e-8468-0394070b6c8d",
                                "text": "„Die Pestepidemien, die von 1347 bis 1353 in Europa wüteten (»Schwarzer Tod«), bedeuteten einen einschneidenden Wendepunkt für die Juden in Deutschland.“"
                            }
                        ],
