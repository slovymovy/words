                "senses": [
                    {
                        "sense_id": "f1ff416c-a533-3d20-8dcc-ffe5420ad327",
                        "entry_id": "8a4411a9-35a0-336c-bb26-8be5ee9c26c2",
                        "glosses": [
                            "het eisen van een straf die door de wet op bepaalde handelingen of gedragingen zijn gesteld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4625b7c1-e22e-4ad0-a7bc-fb8f795ca000",
                                "sense_id": "f1ff416c-a533-3d20-8dcc-ffe5420ad327",
                                "text": "Het strafprocesrecht is grotendeels vastgelegd in het Wetboek van Strafvordering (Sv). Daarin is geregeld welke bevoegdheden politie en justitie hebben bij de opsporing van strafbare feiten en de manier waarop het proces tegen een verdachte van een strafbaar feit moet worden gevoerd."
                            },
                            {
                                "example_id": "4e169f66-107c-45a3-a931-20da505de382",
                                "sense_id": "f1ff416c-a533-3d20-8dcc-ffe5420ad327",
                                "text": "Gezien de feiten kan het Openbaar Ministerie een strafvordering tussen 20 en 30 jaar eisen. Op 21 februari wordt de zaak behandeld."
                            },
                            {
                                "example_id": "fbc9e7d4-c750-41bf-97ff-78798016eb0e",
                                "sense_id": "f1ff416c-a533-3d20-8dcc-ffe5420ad327",
                                "text": "De verdediging onderbouwde de ziekte van haar zus onvoldoende. Bovendien is het belang van strafvordering groter dan haar persoonlijk belang, aldus de rechters."
                            }
                        ]
                    }
