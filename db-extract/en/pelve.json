                        "entry_id": "5a3fd82f-1e50-36d0-b426-1034b8234118",
                        "glosses": [
                            "Synonym of pelvis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf82713-35a8-4b0b-b3a2-16bcc1e590b8",
                                "sense_id": "d76816d4-42fe-3ec4-a0b0-4be00d10b4b1",
                                "text": "Calcium phosphate may form gravel and small calculi in the pelve of the kidney; the calculi are smooth and facetted, and of various de grees of hardness."
                            },
                            {
                                "example_id": "f2ce5c06-e01a-4b7d-9fc4-f71a1e068952",
                                "sense_id": "d76816d4-42fe-3ec4-a0b0-4be00d10b4b1",
                                "text": "The pregnancy had reached term. The fetal head was plunged in the pelve for a greater part; the back was found in the left part of the womans abdomen; heart-beats were not heard."
                            },
                            {
                                "example_id": "1fba36e7-ae38-4584-b5e4-adc62eb605c3",
                                "sense_id": "d76816d4-42fe-3ec4-a0b0-4be00d10b4b1",
                                "text": "The pubis was often chopped off from the pelve at Wardell (Pl. 7e, f), a method which was rarely used at Glenrock. The reason is unclear, although it may have been done to break the connection between the pelves at the pubis symphysis."
                            },
                            {
                                "example_id": "417e4092-9baf-483a-8583-3967549a1bea",
                                "sense_id": "d76816d4-42fe-3ec4-a0b0-4be00d10b4b1",
                                "text": "The pelve is wider, and so is its pelvic inlet bone."
                            }
                        ]
                    }
