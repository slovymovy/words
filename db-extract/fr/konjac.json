                "forms": [
                    {
                        "form_id": "2988cc9c-7044-4951-8c04-3c0f1a8b36b0",
                        "entry_id": "d07a5d87-64cb-3bf3-840a-60c5d1a74e90",
                        "tags": [
                            "plural"
                        ],
                        "form": "konjacs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8765309f-fb9e-3a1f-b616-20285b853986",
                        "entry_id": "d07a5d87-64cb-3bf3-840a-60c5d1a74e90",
                        "glosses": [
                            "Plante de la famille des Araceae qui pousse naturellement dans les forêts de Thaïlande, du Viêt Nam et de Chine méridionale, et dont le rhizome sert à la préparation d’une gelée alimentaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b03533e-c560-4982-8edf-f81374fa0879",
                                "sense_id": "8765309f-fb9e-3a1f-b616-20285b853986",
                                "text": "Nous sommes à table. Une grande assiette est remplie de toutes sortes d’ingrédients : bœuf finement tranché, nouilles de konjac, tofu, shiitaké, oignon vert et autres légumes."
                            },
                            {
                                "example_id": "f2db175c-077f-4bf8-80bc-9acc58721cd2",
                                "sense_id": "8765309f-fb9e-3a1f-b616-20285b853986",
                                "text": "Lorsqu’il reste un peu de place dans le carton, ils y glissent des gelées de konjac achetées au supermarché près de chez eux ou des madeleines et des biscuits faits par la sœur aînée de Mitsurô."
                            },
                            {
                                "example_id": "dc9debc3-c634-43c0-ab87-becf37aa65c7",
                                "sense_id": "8765309f-fb9e-3a1f-b616-20285b853986",
                                "text": "Pour l’heure, seules les fibres de konjac, à savoir les glucomannanes, peuvent porter une allégation de type « contribue à la perte de poids[…] » ."
                            }
                        ]
                    }
                ],
