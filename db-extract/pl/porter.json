                                "example_id": "a27d9b8c-427d-4f10-ba27-bbf243e25430",
                                "sense_id": "2ee4be80-8b07-3cd9-9e48-e5005b4b811f",
                                "text": "Porter angielski jest słabszy od porteru bałtyckiego"
                            }
