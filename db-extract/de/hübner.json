                ],
                "senses": [
                    {
                        "sense_id": "86ded7cd-d6ca-3bfd-a202-41469519783d",
                        "entry_id": "704adb63-6d4f-3d7c-8db4-e1fcc0a9a43f",
                        "glosses": [
                            "freier Eigentümer, Besitzer einer Hufe"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "48f5f454-e73b-4674-a186-720c1c57547d",
                                "sense_id": "86ded7cd-d6ca-3bfd-a202-41469519783d",
                                "text": "„Wie schon die ‚Ur-Hübner‘ den Bestandsschutz stets bedachten, sind auch die derzeitigen Hübner um Kontinuität bemüht.“"
                            },
                            {
                                "example_id": "bffa3537-02dc-4dd3-bd56-26a7301c5de0",
                                "sense_id": "86ded7cd-d6ca-3bfd-a202-41469519783d",
                                "text": "„Item so es kalt wehre, das der hübner über essen nicht leide mögtt, soll der schultheiss dem junkern und den hübnern machen feuer ohne rauch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
