                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to live with",
                                "target_lang_sense_clarification": "to reside in someone else's house"
                            },
                            {
                                "target_lang_word": "to lodge",
                                "target_lang_sense_clarification": "to stay as a paying guest or tenant"
                            },
                            {
                                "target_lang_word": "to board",
                                "target_lang_sense_clarification": "to live in someone's home, usually with meals"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63af603a-4ad7-349e-a5cd-7751b3d531cb",
                    "sense_definition": "bij iemand gaan wonen in hetzelfde huis",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wonen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de scheiding besloot hij tijdelijk bij zijn zus te gaan <w>inwonen</w>.",
                            "target_lang_translations": {
