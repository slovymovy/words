    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d16205bc-c2ee-3486-9265-4ceb6f132824",
                    "sense_definition": "Aandachtig en zoekend kijken naar iets of iemand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De receptionist knikt terwijl zijn ogen de toonbank <w>afspeuren</w> naar stof of een verdwaald geldbriefje.",
                            "target_lang_translations": {
                                "en": "The receptionist nods while his eyes <w>scan</w> the counter for dust or a stray banknote."
                            }
                        },
                        {
                            "text": "Met een bezorgde blik bleef zij de menigte <w>afspeuren</w> in de hoop haar vriend te zien.",
                            "target_lang_translations": {
                                "en": "With a worried look, she kept <w>scanning</w> the crowd in the hope of seeing her friend."
                            }
                        }
                    ],
                    "synonyms": [
                        "afspieden",
                        "afzoeken"
                    ],
                    "common_phrases": [
                        "de menigte afspeuren",
                        "de horizon afspeuren"
                    ],
                    "target_lang_definitions": {
                        "en": "To look attentively and searchingly for someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scan",
                                "target_lang_sense_clarification": "to look through an area quickly but carefully"
                            },
                            {
                                "target_lang_word": "scout",
                                "target_lang_sense_clarification": "to look around an area to find something"
                            },
                            {
                                "target_lang_word": "search",
                                "target_lang_sense_clarification": "to look through visually"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab02a185-b1b6-3bfb-bf59-2058ba99ed14",
                    "sense_definition": "Een gebied of ruimte heel grondig en systematisch doorzoeken om iets te vinden.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "zoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het gebied waar de onderzoekers de oceaanbodem gaan <w>afspeuren</w>, ligt in een zeer afgelegen deel van de oceaan.",
                            "target_lang_translations": {
                                "en": "The area where the researchers are going to <w>scour</w> the ocean floor is located in a very remote part of the ocean."
                            }
                        },
                        {
                            "text": "De politiehelikopter bleef urenlang het bos <w>afspeuren</w> naar de vermiste wandelaar.",
                            "target_lang_translations": {
                                "en": "The police helicopter kept <w>combing</w> the forest for hours for the missing hiker."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorzoeken",
                        "doorspeuren",
                        "uitkammen",
                        "afzoeken"
                    ],
                    "common_phrases": [
                        "het gebied afspeuren",
                        "de grond afspeuren"
                    ],
                    "target_lang_definitions": {
                        "en": "To search an area or space very thoroughly and systematically to find something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scour",
                                "target_lang_sense_clarification": "to search a place thoroughly"
                            },
                            {
                                "target_lang_word": "comb",
                                "target_lang_sense_clarification": "to search systematically and in great detail"
                            },
                            {
                                "target_lang_word": "sweep",
                                "target_lang_sense_clarification": "to search an area systematically, often with sensors or a team"
                            }
                        ]
                    }
                }
            ]
        }
    ]
