                "senses": [
                    {
                        "sense_id": "a8b13e57-27c5-37cd-ad2c-df603d94713e",
                        "entry_id": "55decccd-1df7-39a4-af9a-0cacf48abd03",
                        "glosses": [
                            "Vorgang der Vermenschlichung von Dingen, Konzepten oder Vorgängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55b24556-8c24-4fbe-8fcf-b66e2f7f584e",
                                "sense_id": "a8b13e57-27c5-37cd-ad2c-df603d94713e",
                                "text": "„Dabei gilt Peewski, der auf undurchsichtige Weise zu seinem Medienimperium kam und politisch früh aufstieg, geradezu als Personifizierung von Korruption und Vetternwirtschaft.“"
                            },
                            {
                                "example_id": "9fcfb51e-bb81-48e7-bc51-9a51140a52f9",
                                "sense_id": "a8b13e57-27c5-37cd-ad2c-df603d94713e",
                                "text": "„Eine zweite ergiebige Quelle für Namen von Nebenstrecken(bahnen) ist die Anthropomorphisierung, die Personifizierung der Lokomotive meist mittels Koseformen von Vornamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a151cf24-51a8-431f-8886-995651cd645f",
                        "source_entry_id": "55decccd-1df7-39a4-af9a-0cacf48abd03",
                        "source_sense_id": "a8b13e57-27c5-37cd-ad2c-df603d94713e",
                        "source_sense_description": "Vorgang der Vermenschlichung von Dingen, Konzepten oder Vorgängen",
                        "target_lang_word": "personnification",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personnification",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc010fb2-ef25-361d-8aec-3a2cf5e96d67",
                                        "entry_id": "5cc47997-4484-3874-ac4e-6af76b2de0c9",
                                        "glosses": [
                                            "Action de personnifier, consistant à faire d’un être inanimé ou d’une abstraction un personnage réel."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f29cb86-6eae-40db-ad76-9ae3a62563e3",
                                                "sense_id": "fc010fb2-ef25-361d-8aec-3a2cf5e96d67",
                                                "text": "On dit par personnification : être dans les bras de la mort, du sommeil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dae8537b-bf50-323d-8592-fdad1bdd4c21",
                                        "entry_id": "5cc47997-4484-3874-ac4e-6af76b2de0c9",
                                        "glosses": [
                                            "Résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "130320d1-59b9-4f76-a382-95f4381acc6c",
                                                "sense_id": "dae8537b-bf50-323d-8592-fdad1bdd4c21",
                                                "text": "Les Grecs vivaient au grand air. […], et bien qu'ils eussent élevé au rang des déesses la personnification du Foyer, ils se trouvaient bien partout, excepté chez eux."
                                            },
                                            {
                                                "example_id": "efd1ebdd-7fb5-4270-a9a2-ff3c0e0cb987",
                                                "sense_id": "dae8537b-bf50-323d-8592-fdad1bdd4c21",
                                                "text": "[…] ; ces derniers chevaux, placés à côté des coursiers d’Orient, auraient pu passer pour la personnification de la matière, et les autres pour celle de l’ombre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
