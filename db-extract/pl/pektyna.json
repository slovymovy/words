                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e11b11b4-902e-471e-9a00-9a20265cd7f2",
                        "source_entry_id": "e470299b-6157-342c-98be-2aa7aef99e01",
                        "source_sense_id": "6cc2323e-3c36-3e0d-b956-36d52ab97421",
                        "target_lang_word": "pectin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pectin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b504f4e-76df-38a1-a02c-1a5cfed639e1",
                                        "entry_id": "51f9fa36-e455-3a39-be4a-5d4b1efe9e9d",
                                        "glosses": [
                                            "A polysaccharide extracted from the cell walls of plants, especially of fruits; under acidic conditions it forms a gel. It is often used in processed foods, especially jellies and jams where it causes thickening (setting)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69973738-285b-4ab4-8512-c54848081f0f",
                                                "sense_id": "7b504f4e-76df-38a1-a02c-1a5cfed639e1",
                                                "text": "Apple is rich in pectin and so is often added to other fruits when making jam so it will set."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5556791d-6f1e-4678-8a9b-5474bed1bcc2",
                        "source_entry_id": "e470299b-6157-342c-98be-2aa7aef99e01",
                        "source_sense_id": "6cc2323e-3c36-3e0d-b956-36d52ab97421",
                        "target_lang_word": "pektin",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "79a81a1c-9cf9-422f-8a6b-f5f991f2baa5",
                        "source_entry_id": "e470299b-6157-342c-98be-2aa7aef99e01",
                        "source_sense_id": "6cc2323e-3c36-3e0d-b956-36d52ab97421",
                        "target_lang_word": "pectine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pectine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69290096-07d7-3cd1-88c9-894f1a9f2c54",
                                        "entry_id": "d263af68-b9c4-39c6-8fc6-486c93df8189",
                                        "glosses": [
                                            "Polyoside rattachée aux glucides composée d'une chaîne principale d'acide uronique lié en 1-4, acide polygalacturonique en zig-zag, polymère de polysaccharides acides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02bd353d-cc11-4485-8ba0-51b7984f9e42",
                                                "sense_id": "69290096-07d7-3cd1-88c9-894f1a9f2c54",
                                                "text": "Nos résultats concordent avec ceux obtenus par McComb et McCready : avant tout dosage, il est nécessaire de désestérifier les pectines, par exemple en les laissant 30 mn à température ambiante en présence de soude 0,05 N."
                                            },
                                            {
                                                "example_id": "c35a73a5-d4a2-4091-9a2c-571eeb5e8098",
                                                "sense_id": "69290096-07d7-3cd1-88c9-894f1a9f2c54",
                                                "text": "La pectine est présente en grande quantité dans certaines algues, dans les pépins et les zestes de groseilles, pomme et coing."
                                            },
                                            {
                                                "example_id": "d3e0acc5-507c-4659-bc37-3ae3f6645e8b",
                                                "sense_id": "69290096-07d7-3cd1-88c9-894f1a9f2c54",
                                                "text": "Lorsque la pomme mûrit et/ou pourrit, les pectinases brisent la pectine (un sucre qui donne sa fermeté à la pomme), ce qui ramollit le fruit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5a99940-7647-4a83-a058-f31faaa747d0",
                        "source_entry_id": "e470299b-6157-342c-98be-2aa7aef99e01",
                        "source_sense_id": "6cc2323e-3c36-3e0d-b956-36d52ab97421",
                        "target_lang_word": "Pektin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pektin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "701ebe3b-e968-31e2-a096-ea19c65cd68e",
                                        "entry_id": "fac195a0-083d-3708-8e9b-7574e63e1dcc",
                                        "glosses": [
                                            "Substanz im pflanzlichen Gewebe, die zum Gelieren dienen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec814bd-701b-48c3-9708-5ae99446d1db",
                                                "sense_id": "701ebe3b-e968-31e2-a096-ea19c65cd68e",
                                                "text": "Pektin ist ein hervorragender und preiswerter Entgifter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27ed5015-c6e0-444a-9515-071a584e6485",
                        "source_entry_id": "e470299b-6157-342c-98be-2aa7aef99e01",
                        "source_sense_id": "6cc2323e-3c36-3e0d-b956-36d52ab97421",
                        "target_lang_word": "пекти́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пекти́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "73c2943d-d362-3dec-a777-224f165f54b6",
                                        "entry_id": "283c65b9-c93e-3d41-a19a-37c1d28dd7e8",
                                        "glosses": [
                                            "смесь полимеров растительного происхождения с относительно невысокой молекулярной массой (пектиновых кислот и некоторых полисахаридов), ценный пищевой продукт, содержится во всех частях многих растений; добывается из отходов переработки некоторых плодов, применяется в пищевой промышленности в качестве гелеобразователя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ac29d78-3815-43cd-9f7e-f140dc9a31d2",
                                                "sense_id": "73c2943d-d362-3dec-a777-224f165f54b6",
                                                "text": "Айва как ни один другой фрукт богата пектином, поэтому ее сок при уваривании быстро трансформируется в желеобразную массу. [Алла Дружинина. Просто конфетка! (2002) // «Семейный доктор», 2002.12.15]"
                                            }
                                        ]
                                    }
                                ]
                            }
