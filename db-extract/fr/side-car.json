            {
                "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                "word": "side-car",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b0294a2c-e71e-47b5-bf5c-369e4a802a3b",
                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                        "tags": [
                            "plural"
                        ],
                        "form": "side-cars"
                    },
                    {
                        "form_id": "b7cea5fd-8a9d-4f3a-a801-409461b7a540",
                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "sidecar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                        "glosses": [
                            "Remorque agencée pour accueillir une personne et s'accrochant latéralement sur une motocyclette ou un vélo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "071a1edf-756f-4589-8c14-1104fcd2ef44",
                                "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                "text": "Ça alors! Une Glory de 1948!! Avec un side-car!"
                            },
                            {
                                "example_id": "36fa65f0-f0f7-40d1-b8aa-0645e7aa0bac",
                                "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                "text": "Après 15 000 euros de travaux, le musée a rouvert le 1ᵉʳ juillet, doté d’une nouvelle scénographie, lors d’une inauguration en grande pompe, avec déploiement d’une moto allemande avec side-car et d’une jeep dehors."
                            },
                            {
                                "example_id": "fb446e7e-8f85-47c7-98ed-1273a886ac15",
                                "sense_id": "ee2f1398-8767-3600-90a5-b689119df047",
                                "text": "La Clodoaldienne Élisabeth Gelin - comédienne et auteure de pièces de théâtre - a publié son premier roman l’an dernier, La passagère du side-car."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7cfdb0e-1a7d-347e-9976-12a27c20a929",
                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                        "glosses": [
                            "Attelage comprenant la motocyclette et le side-car."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "af393e57-3ccc-44e8-88a6-8182bab3410a",
                                "sense_id": "e7cfdb0e-1a7d-347e-9976-12a27c20a929",
                                "text": "Les mains dans les poches, la pipe à la bouche, je n'avais pas fini de contempler le défilé qu'une moto side-car s'arrêta devant moi."
                            },
                            {
                                "example_id": "721bc1ee-271b-4a17-954d-2302cba5dc4b",
                                "sense_id": "e7cfdb0e-1a7d-347e-9976-12a27c20a929",
                                "text": "Un side-car est donc un véhicule à trois roues."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8c4f828-e279-35a3-845a-b2e85c339344",
                        "entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                        "glosses": [
                            "Discipline du motocyclisme, pratiquée avec l’attelage."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "678af9bf-424c-4644-853e-3c33464bfd94",
                        "source_entry_id": "63429758-0057-3b5d-8483-a23e1f79deec",
                        "source_sense_description": "1 - Side-car",
                        "target_lang_word": "Beiwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beiwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                        "entry_id": "3a3699d5-fe3b-3f6f-b4ab-1497290326d5",
                                        "glosses": [
                                            "kleines Fahrzeug, das seitlich an einem Motorrad angebracht ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed6e5ea7-c83b-4737-933b-a780436de0c8",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "Motorräder mit Beiwagen sieht man heute weniger oft als vor Jahrzehnten."
                                            },
                                            {
                                                "example_id": "53b3eb38-2fd5-4b61-b5b5-d8b27bac59a2",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "„Ich ging nach vorn und kuckte aus dem Fenster, da stand ein Motorrad mit Beiwagen, ein Russe darauf.“"
                                            },
                                            {
                                                "example_id": "19f26aa2-2d52-4b7c-b02d-21bdb43d0683",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "„Es ist ein Motorradfahrer mit Beiwagen, der von einer kurzen Fahrt mit seiner Frau nach Haus kommt.“"
                                            },
                                            {
                                                "example_id": "176af4ca-77a8-48fe-8a2c-31707de78ef4",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "„Stattdessen versperrte eine olivgrüne Harley-Davidson den Eingang, sodass man über den Beiwagen klettern musste.“"
                                            },
                                            {
                                                "example_id": "36837240-28a3-4ab1-a084-26e8f28f7e55",
                                                "sense_id": "d7d31197-08ce-3cab-98a1-0396127400bd",
                                                "text": "„Heute leben Rachel, Simon und ihr gemeinsamer Sohn Patrick friedlich in Rachels Heimatstadt Nantes, und das Transportmittel der Familie ist – wie kann es anders sein – ein Motorrad mit Beiwagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9be87a3e-22bb-3d6b-87a7-33168269a0aa",
                                        "entry_id": "3a3699d5-fe3b-3f6f-b4ab-1497290326d5",
                                        "glosses": [
                                            "Wagen ohne eigenen Antrieb (Anhänger) bei Schienenfahrzeugen (Straßenbahn, U-Bahn)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a717780e-649d-4ace-8ab0-3f0832369f22",
                                                "sense_id": "9be87a3e-22bb-3d6b-87a7-33168269a0aa",
                                                "text": "„Im September 1899 standen für das 15,5 km lange Streckennetz 26 Trieb- und 20 Beiwagen zur Verfügung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e28fe000-2241-4df0-8cca-108ba89821cd",
