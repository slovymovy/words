{
    "word_family": [
        "deaf",
        "deafness",
        "deafeningly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42fd6040-683e-357e-adc2-82a16df03e6a",
                    "sense_definition": "To make someone unable to hear, either temporarily or permanently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hearing_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The massive explosion came close to <w>deafening</w> several nearby soldiers.",
                            "target_lang_translations": {
                                "tr": "Büyük patlama yakındaki birkaç askeri neredeyse <w>sağır ediyordu</w>."
                            }
                        },
                        {
                            "text": "A severe ear infection during childhood <w>deafened</w> him for the rest of his life.",
                            "target_lang_translations": {
                                "tr": "Çocukluğundaki şiddetli bir kulak enfeksiyonu onu hayatının geri kalanında <w>sağır bıraktı</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin geçici veya kalıcı olarak işitme yetisini kaybetmesine neden olmak, sağır etmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "sağır etmek",
                                "target_lang_sense_clarification": "işitme yetisini kaybettirmek"
                            },
                            {
                                "target_lang_word": "sağır bırakmak",
                                "target_lang_sense_clarification": "kalıcı olarak işitemez duruma getirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d777430-9b6e-3e47-b43f-3255952fd122",
                    "sense_definition": "To overwhelm or stun someone with extremely loud noise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hearing_loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The roaring crowd threatened to <w>deafen</w> the players on the field.",
                            "target_lang_translations": {
                                "tr": "Kükreyen kalabalık sahadaki oyuncuların <w>kulaklarını sağır edecek</w> gibiydi."
                            }
                        },
                        {
                            "text": "Music from the front speakers began to <w>deafen</w> the audience in the small venue.",
                            "target_lang_translations": {
                                "tr": "Ön hoparlörlerden gelen müzik, küçük mekândaki izleyicilerin <w>kulaklarını sağır etmeye</w> başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "stun"
                    ],
                    "common_phrases": [
                        "deafen the ears"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı ve çok yüksek bir sesle birini sersemletmek veya kulaklarını tırmalamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kulakları sağır etmek",
                                "target_lang_sense_clarification": "aşırı yüksek sesle rahatsız etmek/sersemletmek"
                            },
                            {
                                "target_lang_word": "kulak zarlarını patlatmak",
                                "target_lang_sense_clarification": "mecazi olarak çok gürültülü olmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fb06e9e-13c2-3bae-9f5a-8768fa723006",
                    "sense_definition": "To make a structure, such as a floor or wall, soundproof.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The builders added thick insulation to <w>deafen</w> the shared wall between the apartments.",
                            "target_lang_translations": {
                                "tr": "İnşaatçılar, daireler arasındaki ortak duvara <w>ses yalıtımı yapmak</w> için kalın bir yalıtım malzemesi eklediler."
                            }
                        },
                        {
                            "text": "Special materials were used to <w>deafen</w> the floor and keep footsteps from carrying below.",
                            "target_lang_translations": {
                                "tr": "Zemini <w>ses geçirmez hale getirmek</w> ve ayak seslerinin alt kata gitmesini engellemek için özel malzemeler kullanıldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "soundproof"
                    ],
                    "common_phrases": [
                        "deafen a wall",
                        "deafen a floor"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used chiefly in traditional architecture and construction"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Duvar veya zemin gibi bir yapıyı ses geçirmez hale getirmek, ses yalıtımı yapmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ses yalıtımı yapmak",
                                "target_lang_sense_clarification": "ses geçirmez hale getirmek"
                            },
                            {
                                "target_lang_word": "ses geçirmez yapmak",
                                "target_lang_sense_clarification": "yapıyı sese karşı yalıtmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}