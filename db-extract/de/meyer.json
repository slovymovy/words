                    }
                ],
                "senses": [
                    {
                        "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                        "entry_id": "67c91fe2-32cf-39a6-9c39-f9656fc5bce2",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7657e166-132a-452a-93d8-dae30195cc96",
                                "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                                "text": "Thorsten Meyer wird der Ehrenpreis verliehen."
                            },
                            {
                                "example_id": "f2758379-2186-46f1-a877-2703f9955213",
                                "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                                "text": "Anlässlich der Verleihung kommen auch die Meyers aus Süddeutschland."
                            },
                            {
                                "example_id": "d3cb009d-10c6-44f7-bad3-414e364cc5d6",
                                "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                                "text": "Frau Meyer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e1786b3e-8efc-458b-b541-c6eed6d9827d",
                                "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                                "text": "Herr Meyer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "09a3a199-29e6-4e22-9b3a-5936fe6eac5e",
                                "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                                "text": "Die Meyers fliegen heute nach Montreal."
                            },
                            {
                                "example_id": "6b95b8cc-cc26-4bac-904d-0ba34f4200e5",
                                "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                                "text": "Der Meyer trägt nie die Pullover, die die Meyer ihm strickt."
                            },
                            {
                                "example_id": "8273a9f4-4ef4-4242-ad0e-1075be3ce63b",
                                "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meyer kommt, geht der Herr Meyer.“"
                            },
                            {
                                "example_id": "ef137afd-6213-45e2-8574-1b121ab42ff6",
                                "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                                "text": "Meyer kommt und geht."
                            },
                            {
                                "example_id": "5326f8da-2208-4f6d-b859-61e744373b60",
                                "sense_id": "c863bbf6-53d0-3b54-b160-241a9a5cb7da",
                                "text": "Meyers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
