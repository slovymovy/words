    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fc091fb-c24a-3ccd-96d3-ffb8534aa9c7",
                    "sense_definition": "Exprimer ou représenter une action ou un personnage uniquement par des gestes et sans paroles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant ce jeu de société, chaque joueur doit <w>mimer</w> un métier sans prononcer un seul mot."
                        },
                        {
                            "text": "L'acteur commence à <w>mimer</w> une scène comique pour amuser les enfants réunis dans la salle."
                        }
                    ],
                    "synonyms": [
                        "imiter"
                    ],
                    "common_phrases": [
                        "mimer une scène",
                        "mimer un personnage"
                    ]
                },
                {
                    "sense_id": "8bec3a87-3da9-322d-bc77-752779969019",
                    "sense_definition": "Reproduire ou simuler les caractéristiques, le comportement ou les réactions de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce robot moderne est capable de <w>mimer</w> avec précision la démarche d'un être humain."
                        },
                        {
                            "text": "La nouvelle molécule synthétique parvient à <w>mimer</w> les effets protecteurs de cette hormone."
                        }
                    ],
                    "synonyms": [
                        "imiter",
                        "reproduire",
                        "simuler"
                    ],
                    "common_phrases": [
                        "mimer les effets"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "56609986-a165-3c6d-a990-1d0d52a1e0a0",
                    "sense_definition": "Géant de la mythologie scandinave, associé au savoir et gardien d'une source sacrée sous les racines d'Yggdrasil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Dans les récits nordiques, le dieu Odin donne un œil à <w>Mimer</w> pour acquérir la connaissance suprême."
                        },
                        {
                            "text": "La tête coupée de <w>Mimer</w> continue de murmurer des conseils précieux aux divinités rassemblées."
                        }
                    ]
                }
            ]
        }
