                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b707327-407e-35c4-9d27-a8fcb573443e",
                        "entry_id": "84369caa-34e3-32da-aba8-f6d1425945a8",
                        "glosses": [
                            "Attentat-suicide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "878d7966-c8e6-4937-9430-80670d286377",
                                "sense_id": "0b707327-407e-35c4-9d27-a8fcb573443e",
                                "text": "Das Sondereinsatzkommando der Polizei konnte das Selbstmordattentat rechtzeitig verhindern.",
                                "translation": "Le commando d’intervention spéciale de la police a pu empêcher l’attentat-suicide à temps."
                            },
                            {
                                "example_id": "c5190328-1a1a-42b5-b98d-3d4558da1b33",
                                "sense_id": "0b707327-407e-35c4-9d27-a8fcb573443e",
                                "text": "Die Zahl der Toten nach dem Selbstmordattentat in Peshawar stieg derweil auf 52. Drei weitere Menschen erlagen nach Behördenangaben im Krankenhaus ihren Verletzungen.",
                                "translation": "Le nombre de morts suite à l’attentat-suicide de Peshawar s’élève désormais à 52 personnes. Selon les autorités, trois autres victimes ont succombé à leurs blessures à l’hôpital."
                            },
                            {
                                "example_id": "0128268b-dc80-4f7e-9d92-498010be8021",
                                "sense_id": "0b707327-407e-35c4-9d27-a8fcb573443e",
                                "text": "Am Ende der Szene trug sie zur Vervollständigung des Klischees auch noch einen verdächtig nach Selbstmordattentat aussehenden Gürtel, der aber lediglich Putzmittel enthielt.",
                                "translation": "À la fin de la scène, pour pousser le cliché à son paroxysme, elle portait une ceinture suspecte digne d’un attentat-suicide, mais qui ne contenait en réalité que des détergents."
                            }
                        ]
                    }
                ],
