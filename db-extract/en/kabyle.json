                    {
                        "translation_id": "cad410ee-1c89-4041-9125-b6ffaf6bba05",
                        "source_entry_id": "73ddf996-e238-318d-a50d-cc3877807d3e",
                        "source_sense_id": "6274b524-e85c-38fc-bd69-f94987d1b2b2",
                        "source_sense_description": "language",
                        "target_lang_word": "Kabylisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kabylisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a5fa21f-2fa2-33dc-9759-7b83c9156026",
                                        "entry_id": "751ae926-1c22-3e50-af83-79e52c14d97a",
                                        "glosses": [
                                            "von 2–3 (nach neueren Untersuchungen 5,5) Millionen, zumeist mehrsprachigen (Arabisch, Französisch) Menschen gesprochene/r nordalgerische/r Berberdialekt/Berbersprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec86061-30ec-42d5-aafe-764fcff1bd66",
                                                "sense_id": "8a5fa21f-2fa2-33dc-9759-7b83c9156026",
                                                "text": "„Das allgemeine Resultat scheint zu sein, dass Temrht, Schilha, Ghadāmssi, Kabylisch u. s. w. als verschiedene Sprachen zu betrachten sind, unter einander nur verwandt wie etwa Portugiesisch, Spanisch und Italienisch.“"
                                            },
                                            {
                                                "example_id": "8deeda10-fe80-471f-a289-09e66ee46558",
                                                "sense_id": "8a5fa21f-2fa2-33dc-9759-7b83c9156026",
                                                "text": "„Im Jahre 1884 schickte ihn die Bibelgesellschaft nach Algier mit dem Auftrage, biblischen Text ins Kabylische zu übersetzen.“"
                                            },
                                            {
                                                "example_id": "11fb3974-1211-4e5f-8ca4-9c4db6df371f",
                                                "sense_id": "8a5fa21f-2fa2-33dc-9759-7b83c9156026",
                                                "text": "„Wir verständigten uns in unserer eigenen Sprache, einer merkwürdigen Mischung aus Arabisch, Kabylisch und Französisch.“"
                                            },
                                            {
                                                "example_id": "ec4a8231-bf43-4b2d-83e3-e6492ad6e26a",
                                                "sense_id": "8a5fa21f-2fa2-33dc-9759-7b83c9156026",
                                                "text": "„Die sprecherreichsten berber. Sprachen sind Tamaschek/Tamazight (3,5 Mio.), Taschelheit/Tachelhit (3,5 Mio.) und Kabylisch (3 Mio.).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
