                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "English",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4114f17e-6590-3d62-95fd-fbdba5fd52d9",
                                        "entry_id": "0e3f1110-b4a6-398a-b8ba-a4393a73d862",
                                        "glosses": [
                                            "Of or pertaining to England."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecb6316a-7a40-4a3e-904d-83015d8456bf",
                                                "sense_id": "4114f17e-6590-3d62-95fd-fbdba5fd52d9",
                                                "text": "During the war of 1914–18 the English working class were in contact with foreigners to an extent that is rarely possible. The sole result was that they brought back a hatred of all Europeans, except the Germans, whose courage they admired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7d24fd7-6367-3400-a54d-27e64b376a86",
                                        "entry_id": "0e3f1110-b4a6-398a-b8ba-a4393a73d862",
                                        "glosses": [
                                            "English-language; of or pertaining to the language, descended from Anglo-Saxon, which developed in England."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc4019eb-f20c-4673-8afa-6876aaf9a3f4",
                                                "sense_id": "a7d24fd7-6367-3400-a54d-27e64b376a86",
                                                "text": "Those immigrants Anglicised their names to make them sound more English."
                                            },
                                            {
                                                "example_id": "2236c4d3-c4d2-4b9d-b71b-355defb3297b",
                                                "sense_id": "a7d24fd7-6367-3400-a54d-27e64b376a86",
                                                "text": "Honest, honest, English is just a language of confusions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e99f5c40-a928-3bf8-8fec-16615297acd8",
                                        "entry_id": "0e3f1110-b4a6-398a-b8ba-a4393a73d862",
                                        "glosses": [
                                            "Of or pertaining to the people of England (e.g. Englishmen and Englishwomen)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3ca44c5-42b7-4fc3-8a4e-36a82417bdd0",
                                                "sense_id": "e99f5c40-a928-3bf8-8fec-16615297acd8",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke. He was dressed out in broad gaiters and bright tweeds, like an English tourist, and his face might have belonged to Dagon, idol of the Philistines."
                                            },
                                            {
                                                "example_id": "0206ca04-1a63-4a83-8a9c-4f4cdcab6c88",
                                                "sense_id": "e99f5c40-a928-3bf8-8fec-16615297acd8",
                                                "text": "These first English migrants to Jamestown endured terrible disease and arrived during a period of drought and colder-than-normal winters. The migrants to Roanoke on the outer banks of Carolina, where the English had gone in the 1580s, disappeared. And a brief effort to settle the coast of Maine in 1607 and 1608 failed because of an unusually bitter winter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c6806b9-7223-3604-972d-522946ee456b",
                                        "entry_id": "0e3f1110-b4a6-398a-b8ba-a4393a73d862",
                                        "glosses": [
                                            "Of or pertaining to the avoirdupois system of measure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3596565c-704e-43bb-a5a5-5c52e1f86a60",
                                                "sense_id": "8c6806b9-7223-3604-972d-522946ee456b",
                                                "text": "an English ton"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "215d498b-cb78-31e0-99a5-02ead915d53c",
                                        "entry_id": "0e3f1110-b4a6-398a-b8ba-a4393a73d862",
                                        "glosses": [
                                            "Non-Amish, so named for speaking English rather than a variety of German."
                                        ],
                                        "tags": [],
                                        "examples": []
