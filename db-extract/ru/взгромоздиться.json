                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86781b20-4d1f-3388-9fe5-2b0e7a73c950",
                                        "entry_id": "ac5d9ed6-7d4c-36ce-aa83-97c116fdff91",
                                        "glosses": [
                                            "mit der Hilfe von Händen und Füßen (kletternd) etwas Hohes besteigen/ersteigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40c7428f-aba9-4bbe-a707-4f25d5a8e31f",
                                                "sense_id": "86781b20-4d1f-3388-9fe5-2b0e7a73c950",
                                                "text": "„Ich erkletterte ihn nie mehr wieder. Ich erkletterte auch keinen anderen Baum mehr.“"
                                            },
                                            {
                                                "example_id": "1d17ec52-86a5-45fb-9e05-bc4052ae5a4e",
                                                "sense_id": "86781b20-4d1f-3388-9fe5-2b0e7a73c950",
                                                "text": "„Am Fuße des Berges angelangt, gewahrten wir mit einiger Bestürzung, daß die Felsenmauer, welche jene Kuppe trug, höher und steiler war, als wir geglaubt, und daß es uns kaum gelingen dürfte, sie in ihrer ganzen Höhe zu erklettern.“ (1862)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8daedbd-b38e-3980-bc9a-27fd4579a4c7",
                                        "entry_id": "ac5d9ed6-7d4c-36ce-aa83-97c116fdff91",
                                        "glosses": [
                                            "eine höhere Position erklimmen, sich nach oben arbeiten"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "531f4a5d-9a12-428e-960d-af7526d8da6a",
                                                "sense_id": "e8daedbd-b38e-3980-bc9a-27fd4579a4c7",
                                                "text": "„Erich Hackls neuer Roman ‚Sara und Simon‘ erklettert die Charts.“"
                                            },
                                            {
                                                "example_id": "400a81f7-bde4-48fd-b07e-bb7b67f32d20",
                                                "sense_id": "e8daedbd-b38e-3980-bc9a-27fd4579a4c7",
                                                "text": "„In kürzester Frist erkletterte ich die Karriereleiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
