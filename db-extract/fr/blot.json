                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a037e75-d6d4-487a-9c19-a56d106700df",
                        "entry_id": "09066e2a-7ee6-392e-aacb-046c2ec3ee95",
                        "tags": [
                            "plural"
                        ],
                        "form": "blots"
                    },
                    {
                        "form_id": "ba3b0243-f2ca-451d-813c-9f104414cbc6",
                        "entry_id": "09066e2a-7ee6-392e-aacb-046c2ec3ee95",
                        "tags": [],
                        "form": "blaud"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6945b479-edf8-39b1-966c-3648c156c509",
                        "entry_id": "09066e2a-7ee6-392e-aacb-046c2ec3ee95",
                        "glosses": [
                            "Instrument pour mesurer la marche d’un navire (élément du loch)."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "bfe2c6b6-50d6-4722-be87-55110d52514b",
                                "sense_id": "6945b479-edf8-39b1-966c-3648c156c509",
                                "text": "Le blot est une pièce de bois, longue d’un-demi pied, large de deux pouces, et coupée par les bouts en forme de nacelle.On y met du plomb pour jeter le blot, et faire qu’il se tienne plus immobile sur la mer."
                            }
                        ]
                    },
                    {
                        "sense_id": "2bd7bac9-f758-3afe-b216-f4f8b6068e4b",
                        "entry_id": "09066e2a-7ee6-392e-aacb-046c2ec3ee95",
                        "glosses": [
                            "Perchoir."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "49df0206-3a82-4e92-94a1-1eabd27b8711",
                                "sense_id": "2bd7bac9-f758-3afe-b216-f4f8b6068e4b",
                                "text": "Nous perchons sur le blot les oiseaux neufs, pour les afaiter."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec6995a8-7fab-3634-8eda-7099d250eee2",
                        "entry_id": "09066e2a-7ee6-392e-aacb-046c2ec3ee95",
                        "glosses": [
                            "Ensemble de biens."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4aa5a1b0-b80f-4ec7-abc0-646faac78967",
                                "sense_id": "ec6995a8-7fab-3634-8eda-7099d250eee2",
                                "text": "… il falloit que tous les fraits fussent distraits sur tout le blot des biens qui avaient esté exposez par le Seigneur."
                            },
                            {
                                "example_id": "c5ae4641-3c23-4306-b87e-7ae181a23df6",
                                "sense_id": "ec6995a8-7fab-3634-8eda-7099d250eee2",
                                "text": "& afin que lesdits Vendeurs se ressentent de leurs peines & labeurs, auront chacun d’eux la somme de vingt livres parisis par an, pour leurs salaires & vaccations, qui seront pris sur tout le blot du profit revenant desdites ventes."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c3bba84-8ad2-3fd0-a1f8-5a90b85f9e78",
                        "entry_id": "09066e2a-7ee6-392e-aacb-046c2ec3ee95",
                        "glosses": [
                            "Lot de marchandises (sens conservé très proche du précédent)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d6385d2c-6dde-421f-b0ce-421715e35ae7",
                                "sense_id": "1c3bba84-8ad2-3fd0-a1f8-5a90b85f9e78",
                                "text": "S’il me fourgue tout le blot pour trois cent balles, je carme recta"
                            },
                            {
                                "example_id": "d3d9db4e-ecba-44dd-941b-fd1ee238b666",
                                "sense_id": "1c3bba84-8ad2-3fd0-a1f8-5a90b85f9e78",
                                "text": "Je prends tout le blot, toi et ton tableau"
                            }
                        ]
                    },
                    {
                        "sense_id": "16a93d9c-861f-38cd-af69-eef2c3998554",
                        "entry_id": "09066e2a-7ee6-392e-aacb-046c2ec3ee95",
                        "glosses": [
                            "Prix, tarif."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "8c1ccd7f-ef56-4b94-bfac-a8a31d1847bf",
                                "sense_id": "16a93d9c-861f-38cd-af69-eef2c3998554",
                                "text": "— Si je comprends bien, tu prends la succession de Mandarès. Du coquille j’en ai, cinq rames, total deux briques. Et cash !\n— Oh ben, à ce blot là, tu peux le garder et t’en faire des cornets à frites."
                            },
                            {
                                "example_id": "c29f49b5-dfdb-46fb-95e0-eac9e6be4a8f",
                                "sense_id": "16a93d9c-861f-38cd-af69-eef2c3998554",
                                "text": "Il serait éclairé aussi sec, le Willy, si doué du don de double vue il pouvait mater, à pas huit cents mètres de chez sézigue, Johnny et Paulo aux prises avec un maquignon en voitures, pour l’achat au meilleur blot de la charrette, sa première, que Paulo a décidé d’attriquer."
                            },
                            {
                                "example_id": "b039fe31-389d-48a0-9ddf-c6d85344a7a9",
                                "sense_id": "16a93d9c-861f-38cd-af69-eef2c3998554",
                                "text": "— Ceux qui ne sont pas contents, c’est le même blot !"
                            }
                        ]
                    },
                    {
                        "sense_id": "23c51bc0-bbc1-3c1c-a694-c64211a882ea",
                        "entry_id": "09066e2a-7ee6-392e-aacb-046c2ec3ee95",
                        "glosses": [
                            "Marché (conclu)."
                        ],
                        "tags": [
                            "broadly",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "443b962d-1dd8-4485-8b5f-213810494288",
                                "sense_id": "23c51bc0-bbc1-3c1c-a694-c64211a882ea",
                                "text": "Pour lui c'était le contraire du jour, comme des petites fêtes par-dessus le blot."
                            }
                        ]
                    },
                    {
                        "sense_id": "8407cbef-4dd6-3d1d-bd44-8de9d800e555",
                        "entry_id": "09066e2a-7ee6-392e-aacb-046c2ec3ee95",
                        "glosses": [
                            "Affaire, tâche, boulot."
                        ],
                        "tags": [
                            "broadly",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e70e4cc5-1ade-4631-870f-b023739529dd",
                                "sense_id": "8407cbef-4dd6-3d1d-bd44-8de9d800e555",
                                "text": "Quand je restais trop longtemps dehors, je recevais des bochons, ça faisait pas mon blot, si bien qu’un matin, bonsoir la compagnie !…"
                            },
                            {
                                "example_id": "d21c3076-287e-4400-aed6-0ce9799abc66",
                                "sense_id": "8407cbef-4dd6-3d1d-bd44-8de9d800e555",
                                "text": "– Tu parles d’un blot !\nIl lâcha les deux brancards, équilibra le charreton sur son pied, et s’essuya le cou."
                            },
                            {
                                "example_id": "7657bce2-98f1-4933-ab9c-42d38726a778",
                                "sense_id": "8407cbef-4dd6-3d1d-bd44-8de9d800e555",
                                "text": "Il ne s’agit plus d’une chatte en chaleur, mais d’une criminelle, à présent, et ce n’est plus du tout le même blot, hein ?"
                            }
                        ]
                    }
                ],
