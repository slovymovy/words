                        {
                            "text": "The sailors were looking for some <w>lush</w> to drink.",
                            "target_lang_translations": {
                                "it": "I marinai cercavano degli <w>alcolici</w> da bere.",
                                "fr": "Les marins cherchaient de l'<w>alcool</w> à boire."
