                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaa01b46-72d0-41b5-9474-7db232790fb0",
                                "sense_id": "1bae69f3-5158-39ed-9b11-bad17213e83e",
                                "text": "„Ebenso wenig passt es in das friedliche Bild, dass die Japaner im Zweiten Weltkrieg genau hier Massenselbstmorde veranlassten.“"
                            },
                            {
                                "example_id": "3ed901c8-daf4-479a-b2ea-31bd579b85d9",
                                "sense_id": "1bae69f3-5158-39ed-9b11-bad17213e83e",
                                "text": "„In dem Artikel heißt es, die Tragödie des Massenselbstmordes der Credisten von vor zehn Jahren nähere sich nun dem Ende.“"
                            }
                        ],
