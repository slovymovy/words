                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a1f00bc-dea0-419f-8c06-a37be33646ae",
                                                "sense_id": "97d6389b-847a-3d6f-b8db-8d3e30392d8d",
                                                "text": "Vor dem Verkauf wog er die Waren ab."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c5206ab-be3b-4bfb-8303-132c29e0ebcc",
                        "source_entry_id": "584751e1-dc0c-34f0-a56a-16e20c0d04d2",
                        "source_sense_id": "05bc4e21-6a9a-38de-9ef0-352e7b86c4fb",
                        "source_sense_description": "ausgleichen",
                        "target_lang_word": "ausgleichen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ausgleichen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1736b43f-db93-336b-bf85-a209e5693dcb",
                                        "entry_id": "8d010698-e720-3296-a794-79235b15670f",
                                        "glosses": [
                                            "eine Differenz an einem oder mehreren Werkstücken/Gegenständen auf Null vermindern"
                                        ],
                                        "tags": [
                                            "Handwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18552419-40eb-4ae3-b2bf-23616cccfc28",
                                                "sense_id": "1736b43f-db93-336b-bf85-a209e5693dcb",
                                                "text": "„Bevor ich mit der Verlegung des Korkbodens beginne muss ich die Unebenheiten des Bodens durch eine flüssige Masse ausgleichen.“"
                                            },
                                            {
                                                "example_id": "fbd5336e-15bf-49a7-8bbd-5bbae533f31f",
                                                "sense_id": "1736b43f-db93-336b-bf85-a209e5693dcb",
                                                "text": "Bevor Sie einen Bodenbelag verlegen können, sollten Sie in der Regel zuvor den Boden ausgleichen. Dafür stehen verschiedene Ausgleichsmassen zur Verfügung, womit man selbst unebene Untergründe in plane Flächen verwandeln kann."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e1fb2aa-24d4-3bd0-ba79-2c71a2560540",
                                        "entry_id": "8d010698-e720-3296-a794-79235b15670f",
                                        "glosses": [
                                            "eine offene Rechnung bezahlen; Schulden/Verbindlichkeiten bedienen; Verluste verringern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6354d9b9-ade5-4ce1-a51f-6da5457088f0",
                                                "sense_id": "7e1fb2aa-24d4-3bd0-ba79-2c71a2560540",
                                                "text": "Seit 2014 sinkt die Zahl europäischer Gäste in der Türkei. […] viele Hotelbesitzer in Antalya haben bereits damit begonnen, ihre Werbung auf Länder im Nahen Osten und auf den Balkan auszurichten, um ihre Verluste auszugleichen."
                                            },
                                            {
                                                "example_id": "1865a4fd-fa81-4ca3-a1d3-b80776da483d",
                                                "sense_id": "7e1fb2aa-24d4-3bd0-ba79-2c71a2560540",
                                                "text": "Ganze 2,4 Millionen Euro kostet den Verein [FC Kaiserslautern] die Miete für das Fritz-Walter-Stadion am berühmten Betzenberg […]. Höchstens 425.000 Euro könne der Verein, so verlautete aus seinen Reihen, nach dem ihm drohenden Abstieg in die dritte Liga noch zahlen. Doch wie soll diese Differenz ausgeglichen werden?"
                                            },
                                            {
                                                "example_id": "3233f416-878c-4561-b9ac-f04f8d351040",
                                                "sense_id": "7e1fb2aa-24d4-3bd0-ba79-2c71a2560540",
                                                "text": "Bei Kurzarbeit kann die Arbeitszeit deutlich zurückgehen - theoretisch auf Null. […] Die Arbeitsagentur [gewährt] dann nach Prüfung bestimmter Voraussetzungen Kurzarbeitergeld, das einen Teil des wegfallenden Einkommens ausgleicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cff04304-e1cd-3a0d-83f5-fe62e2b98816",
                                        "entry_id": "8d010698-e720-3296-a794-79235b15670f",
                                        "glosses": [
                                            "bei einem Konto durch entsprechende Soll- oder Habenbuchung den Saldo auf Null bringen"
                                        ],
                                        "tags": [
                                            "Buchhaltung"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a99c1197-7113-3264-9c08-d2ea402113af",
                                        "entry_id": "8d010698-e720-3296-a794-79235b15670f",
                                        "glosses": [
                                            "in einem Streit/Konflikt von zwei oder mehreren Personen vermitteln"
                                        ],
                                        "tags": [
                                            "Kommunikation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38514cb2-55ae-4637-906b-821c9f19024d",
                                                "sense_id": "a99c1197-7113-3264-9c08-d2ea402113af",
                                                "text": "Ein Mediator versucht, die unterschiedlichen Interessen der sich streitenden Beteiligten auszugleichen."
                                            },
                                            {
                                                "example_id": "3b8210b0-10d3-4556-a9c5-ed0d7e349196",
                                                "sense_id": "a99c1197-7113-3264-9c08-d2ea402113af",
                                                "text": "Die Eltern müssen nicht nur ihre eigenen Interessen verfolgen, sondern sie müssen gleichzeitig für ihre Kinder sprechen und die Interessen der Kinder mit ihren eigenen Interessen ausgleichen."
                                            },
                                            {
                                                "example_id": "94f8c5f0-9e6b-4ae2-a9e5-71d25438c85d",
                                                "sense_id": "a99c1197-7113-3264-9c08-d2ea402113af",
                                                "text": "Stets muß der Notar als neutraler Dritter Informationsvorsprünge einer Partei ausgleichen, ein Machtgefälle berücksichtigen und bemüht sein, daß kein Beteiligter über den Tisch gezogen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8605e455-4664-356f-b28d-d2beb96b7963",
                                        "entry_id": "8d010698-e720-3296-a794-79235b15670f",
                                        "glosses": [
                                            "einen Mangel oder etwas Fehlendes ergänzen oder aufwiegen; wettmachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c388dfdf-9080-4847-a8d3-ca45b3873776",
                                                "sense_id": "8605e455-4664-356f-b28d-d2beb96b7963",
                                                "text": "Ich konnte meine Fünf in Mathe durch Zweien jeweils in Deutsch und Englisch ausgleichen."
                                            },
                                            {
                                                "example_id": "16191d1f-9da8-40f8-8568-886f1d25dcc6",
                                                "sense_id": "8605e455-4664-356f-b28d-d2beb96b7963",
                                                "text": "Die Schülerinnen und Schüler entdecken, wie menschliche Stärken und Schwächen einander ausgleichen können."
                                            },
                                            {
                                                "example_id": "623a3882-c909-4bff-be74-e05323868856",
                                                "sense_id": "8605e455-4664-356f-b28d-d2beb96b7963",
                                                "text": "Bei Durchfallerkrankungen muss man den Flüssigkeitsverlust schnell ausgleichen."
                                            },
                                            {
                                                "example_id": "f589af48-fadd-48ac-bb77-46a048821538",
                                                "sense_id": "8605e455-4664-356f-b28d-d2beb96b7963",
                                                "text": "[…] die Ernährung kann ein Defizit [an Vitamin D] kaum ausgleichen."
                                            },
                                            {
                                                "example_id": "d2fe5049-bfb8-4918-b5c1-a98e94107def",
                                                "sense_id": "8605e455-4664-356f-b28d-d2beb96b7963",
                                                "text": "Das Hochspannungskabel hat eine Kapazität von 1400 Megawatt und soll die Stromschwankungen in Deutschland durch zunehmenden Wind- und Sonnenstrom ausgleichen."
                                            },
                                            {
                                                "example_id": "35d72076-b8b5-4a21-bd02-690c1c7755b3",
                                                "sense_id": "8605e455-4664-356f-b28d-d2beb96b7963",
                                                "text": "Bildungsreformen konnten die Benachteiligung [von beispielsweise alleinerzogenen Schülern] in der Vergangenheit nur geringfügig ausgleichen. Vielmehr führt die derzeitige Struktur von Schule noch immer zu einer bedeutenden Chancenungleichheit unter den Schülern, das heißt es besteht […] ein signifikanter Zusammenhang zwischen Bildungserfolg und Herkunft."
                                            },
                                            {
                                                "example_id": "f6cb5506-cf9a-4162-99e6-c2b6a7f8da13",
                                                "sense_id": "8605e455-4664-356f-b28d-d2beb96b7963",
                                                "text": "Ein Handelskrieg wird immer wahrscheinlicher. Die aktuelle Nähe zu China kann aber für Deutschland die Kosten der Eiszeit mit den USA nur bedingt ausgleichen."
                                            },
                                            {
                                                "example_id": "5b859c1c-5bf3-454b-ae50-e80f1f7df5a7",
                                                "sense_id": "8605e455-4664-356f-b28d-d2beb96b7963",
                                                "text": "[Krankenhäuser müssen in Deutschland einen] Zwei-Wochen-Vorrat [… an Medikamenten] vom Gesetz her vorhalten, um kurzfristige Engpässe ausgleichen zu können."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
