            {
                "entry_id": "c51b957c-def1-3953-9306-d004c07447b3",
                "word": "tantalus",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "36a9f712-78ff-4698-82a8-0c6382be0672",
                        "entry_id": "c51b957c-def1-3953-9306-d004c07447b3",
                        "tags": [
                            "plural"
                        ],
                        "form": "tantaluses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "524017a3-2b28-348d-bb79-4a5edacd8275",
                        "entry_id": "c51b957c-def1-3953-9306-d004c07447b3",
                        "glosses": [
                            "A stork of the genus Mycteria (formerly Tantalus), especially the American wood stork, Mycteria americana."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9574ab12-214d-3155-9bb2-762d56f3b82f",
                        "entry_id": "c51b957c-def1-3953-9306-d004c07447b3",
                        "glosses": [
                            "A stand in which to lock up drink decanters while keeping them visible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "149b53df-91c3-42d2-bdd7-31326275d38e",
                                "sense_id": "9574ab12-214d-3155-9bb2-762d56f3b82f",
                                "text": "Yes, there was a tantalus containing brandy and whisky on the sea-chest."
                            },
                            {
                                "example_id": "bcc75dc9-c1e5-4c9c-808a-b026a9723c42",
                                "sense_id": "9574ab12-214d-3155-9bb2-762d56f3b82f",
                                "text": "“A small boy, sir. Said I was to be sure and see you got it most particular.” He unlocked a cupboard near the window and produced a tantalus. “Whisky, sir, or cocktail?”"
                            },
                            {
                                "example_id": "1f17aed9-7329-4e68-9303-8aaee4e0a2b0",
                                "sense_id": "9574ab12-214d-3155-9bb2-762d56f3b82f",
                                "text": "And stockrooms heavy with the Tantalus\non which the family fortune has been made"
                            }
                        ]
                    },
                    {
                        "sense_id": "24e27e43-7a96-36ab-bf69-7d652cd0c1e9",
                        "entry_id": "c51b957c-def1-3953-9306-d004c07447b3",
                        "glosses": [
                            "Something of an evasive or retreating nature, something consistently out of reach; a tantalising thing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff7c172b-6da4-41dd-b973-5bc129a27f65",
                                "sense_id": "24e27e43-7a96-36ab-bf69-7d652cd0c1e9",
                                "text": "Over all, there brooded the shadow of his injuries and the tantalus of their slow healing."
                            }
                        ]
                    }
                ],
