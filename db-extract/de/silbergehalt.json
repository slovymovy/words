                ],
                "senses": [
                    {
                        "sense_id": "1c2938a5-03f4-3e79-a29e-e0f62c691c3b",
                        "entry_id": "808610a6-4447-35ef-ac6a-b048eac028b8",
                        "glosses": [
                            "Gehalt an Silber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "006d9e61-f708-422a-8506-f65282635c92",
                                "sense_id": "1c2938a5-03f4-3e79-a29e-e0f62c691c3b",
                                "text": "Das Erz aus diesem Bergwerk besitzt einen hohen Silbergehalt."
                            },
                            {
                                "example_id": "23cfe5a0-bae3-4f95-8a5c-1a72f1493103",
                                "sense_id": "1c2938a5-03f4-3e79-a29e-e0f62c691c3b",
                                "text": "Der Preis antiker Sammlermünzen ist auch abhängig von ihrem Silbergehalt."
                            },
                            {
                                "example_id": "892c975a-af70-42ba-8a5c-2d2a20e61301",
                                "sense_id": "1c2938a5-03f4-3e79-a29e-e0f62c691c3b",
                                "text": "„Beim Handel Ware gegen Geld kam es dagegen auf das Vertrauen in den Silber- oder Goldgehalt der Münzen an und auf die Verlässlichkeit ihrer Wertbezeichnungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
