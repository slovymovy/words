                                        "examples": [
                                            {
                                                "example_id": "d533a754-52ae-4f23-898a-21e180aca757",
                                                "sense_id": "aa5e91c3-f312-3ee4-b3e7-7bdb636840f6",
                                                "text": "I am supposed to report Münchhaussen's^([sic]) doings; am supposed to be writing fiction, scientifiction, to be correct."
                                            },
                                            {
                                                "example_id": "ccb8e9fc-d558-49e4-92cf-21e97d8525d7",
                                                "sense_id": "aa5e91c3-f312-3ee4-b3e7-7bdb636840f6",
                                                "text": "1926, Hugo Gernsback, Amazing Stories, \"A New Sort of Magazine\"\nThere is the usual fiction magazine, the love story and the sex-appeal type of magazine, the adventure type, and so on, but a magazine of \"Scientifiction\" is a pioneer in its field in America. By \"scientifiction\" I mean the Jules Verne, H. G. Wells, and Edgar Allan Poe type of story—a charming romance intermingled with scientific fact and prophetic vision."
                                            },
                                            {
                                                "example_id": "ab143bc1-6f95-4a1f-b8ad-1c62ac50bee1",
                                                "sense_id": "aa5e91c3-f312-3ee4-b3e7-7bdb636840f6",
                                                "text": "Lewis's novels are the scientifiction of a philosopher."
                                            }
                                        ]
                                    }
                                ]
                            }
