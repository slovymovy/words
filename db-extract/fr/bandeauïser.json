                        ],
                        "examples": [
                            {
                                "example_id": "3be5b874-b0e1-4e15-b842-03a0c88c88ea",
                                "sense_id": "e1bf4290-47d6-3c7c-b64d-9570f8563724",
                                "text": "bon ben je vais laisser les poseurs de bandeaux bandeauïser en rond faut bien que les gens s'occupent et je repars à mes chères lectures !"
                            },
                            {
                                "example_id": "eb09824e-b731-40c3-8f2c-d09412879f4d",
                                "sense_id": "e1bf4290-47d6-3c7c-b64d-9570f8563724",
                                "text": "Son attitude relève, à mon sens, d'une curieuse compréhension et application du principe collaboratif sur Wikipédia, les uns font et les autres inspectent partout et bandeauïsent à tour de bras."
                            },
                            {
                                "example_id": "ee40e5f3-88de-4f6a-a4d2-e2e539f3ea8d",
                                "sense_id": "e1bf4290-47d6-3c7c-b64d-9570f8563724",
                                "text": "Il semblerait que je ne sois pas le seul à ne pas avoir compris immédiatement puisque des gens remplissent/catégorisent/bandeauïsent cette référence comme un article"
                            }
                        ]
                    }
