                "senses": [
                    {
                        "sense_id": "e711acf5-2d93-3e9b-8984-ea24cd44b96a",
                        "entry_id": "0b001e18-c01b-3a0d-a68c-aba768fbb54a",
                        "glosses": [
                            "A stone or metal flat plate or surface on which food is fried or baked."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0ddc2ac-422f-4da4-8ded-8f973c1917b8",
                                "sense_id": "e711acf5-2d93-3e9b-8984-ea24cd44b96a",
                                "text": "Such a clatter as the little spoon made, and such a beating as the batter got, it quite foamed, I assure you; and when Daisy poured some on to the griddle, it rose like magic into a puffy flapjack that made Demi's mouth water."
                            },
                            {
                                "example_id": "64a1a270-69f0-44d0-81b5-13b05465594a",
                                "sense_id": "e711acf5-2d93-3e9b-8984-ea24cd44b96a",
                                "text": "Some people when making scones do not trouble to light the oven but use the frying pan: of course if you have a griddle it is better than oven or pan, but very few people possess this useful utensil."
                            }
                        ]
                    }
                ],
