                                        "examples": [
                                            {
                                                "example_id": "ca517957-b411-49d5-8774-96946027eb51",
                                                "sense_id": "0135be0b-b7b5-3715-b22c-693f60ff4af5",
                                                "text": "I'd like a shot of whisky in my coffee."
                                            },
                                            {
                                                "example_id": "025c3793-f6ea-4586-b7fe-8b2c0cbd3766",
                                                "sense_id": "0135be0b-b7b5-3715-b22c-693f60ff4af5",
                                                "text": "You can kiss a hundred boys in bars\nShoot another shot, try to stop the feeling"
