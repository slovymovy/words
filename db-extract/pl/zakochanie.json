                                "target_senses": [
                                    {
                                        "sense_id": "d375a6f3-486e-3672-91ab-c394de9dd2ed",
                                        "entry_id": "a29c3612-28b4-3b97-9975-fd794d056e45",
                                        "glosses": [
                                            "An immensely strong love or sexual attraction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc790e3d-32ed-4817-9007-4fe0bc74af4a",
                                                "sense_id": "d375a6f3-486e-3672-91ab-c394de9dd2ed",
                                                "text": "As to the former, he is under a singular species of infatuation, to render himself thus subservient to the plans of Melliphant. Happily, however, we have effected our escape from them, and are on the road to our peaceful dwelling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0461f162-eb23-368e-8ad3-7e88c6f090d0",
                                        "entry_id": "a29c3612-28b4-3b97-9975-fd794d056e45",
                                        "glosses": [
                                            "The act of infatuating; the state of being infatuated; madness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecff2a43-c77a-3b57-819e-4d166f71855c",
                                        "entry_id": "a29c3612-28b4-3b97-9975-fd794d056e45",
                                        "glosses": [
                                            "Something which infatuates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57a36f44-f1f8-49a1-b1e4-0c2d323a7570",
                        "source_entry_id": "9eb3554d-35c5-319f-bb91-ae70cdb11508",
                        "source_sense_id": "d54f081c-ce6a-3bc0-bf5e-d5e32d0a94c4",
                        "target_lang_word": "Verliebtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verliebtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8029e48a-40b5-3ce0-8021-640756fddced",
                                        "entry_id": "baff6bf9-5867-36d2-8dc0-192ac06943ac",
                                        "glosses": [
                                            "der Zustand, verliebt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d082fb1-7c28-4e50-8d84-6bf4b6bbd192",
                                                "sense_id": "8029e48a-40b5-3ce0-8021-640756fddced",
                                                "text": "„Im Rostowschen Hause hatte sich in jener Zeit eine ganz besondere Atmosphäre von Verliebtheit gebildet, wie das häufig in solchen Häusern geschieht, wo es besonders anmutige junge Mädchen gibt.“"
                                            },
                                            {
                                                "example_id": "c35bec07-df77-4c06-b11a-144f9d49c417",
                                                "sense_id": "8029e48a-40b5-3ce0-8021-640756fddced",
                                                "text": "„Ich beugte mich ihren Wünschen und hoffte in meiner immer noch zunehmenden Verliebtheit auf die Natur, die auf die Dauer stets stärker ist als alle Vorurteile.“"
                                            },
                                            {
                                                "example_id": "4a07e00e-2e67-49ce-ae26-c6842396ef71",
                                                "sense_id": "8029e48a-40b5-3ce0-8021-640756fddced",
                                                "text": "„Gewiß hatte auch bei ihm bei aller möglichen Verliebtheit die Tatsache eine Rolle gespielt, daß er Marie aus einer sündigen in eine sündlose Situation rettete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
