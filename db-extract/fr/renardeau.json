                                "target_senses": [
                                    {
                                        "sense_id": "5bd2cd43-72cc-3b59-8999-007bfa3c0287",
                                        "entry_id": "32bc8da7-3035-3705-abdb-e82ec1a1bdfc",
                                        "glosses": [
                                            "A little or young fox; kit; a fox whelp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa801b02-6b5d-4c14-90d0-7d8fb4742045",
                                                "sense_id": "5bd2cd43-72cc-3b59-8999-007bfa3c0287",
                                                "text": "The tender foxling, not arrived at the maturity of slyness, who never tasted chicken of his own stealing, shall take him without a ruffle of his plumage — only by pronouncing its dingy brown to be rich crimson."
                                            },
                                            {
                                                "example_id": "68595b96-3481-44dc-9ca4-3c120f24cff9",
                                                "sense_id": "5bd2cd43-72cc-3b59-8999-007bfa3c0287",
                                                "text": "The foxling made himself thoroughly at home. Seizing on a huge turkey's foot from the Sprite's larder, he dragged it into a dark corner, where he growled over it quite horribly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
