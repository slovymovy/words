                                        "sense_id": "a6dd0f60-038d-32fe-b102-218f91fdd87d",
                                        "entry_id": "23347128-f794-30a5-bbb8-ea654b5f731b",
                                        "glosses": [
                                            "Any interesting or pleasing sounds."
                                        ],
                                        "tags": [
