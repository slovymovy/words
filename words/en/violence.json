                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать насилию или грубому физическому воздействию.",
                        "zh": "对某人施加暴力或进行粗暴的身体侵害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подвергать насилию",
                                "target_lang_sense_clarification": "совершать насилие"
                            },
                            {
                                "target_lang_word": "применять силу",
                                "target_lang_sense_clarification": "воздействовать силой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "施暴",
