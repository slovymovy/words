                "senses": [
                    {
                        "sense_id": "1554e4a9-15ea-332c-9cb3-dfd4ed74d081",
                        "entry_id": "93a5b69b-b8be-31fa-93ca-c26de7dcc3fb",
                        "glosses": [
                            "Faire perdre son caractère lié à la philosophie à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "620dd2b1-2eb4-47d5-8ff5-67642dd610f5",
                                "sense_id": "1554e4a9-15ea-332c-9cb3-dfd4ed74d081",
                                "text": "Au xviiᵉ siècle, Descartes renouvelle la philosophie, et avec lui philosophent Bossuet et Leibnitz ; mais, en même temps, commencent à déphilosopher Arnauld, Régis, dans le sens d'Aristote ; Spinosa, Malebranche, Fénelon, dans celui de Zénon ; Locke, dans celui d'Épicure."
                            },
                            {
                                "example_id": "3c842728-52cb-45ac-b9b2-f4cbcfe41265",
                                "sense_id": "1554e4a9-15ea-332c-9cb3-dfd4ed74d081",
                                "text": "La phénoménologie devient une « ontologie directe » qui oblige à se « déphilosopher »."
                            }
                        ]
                    }
                ],
