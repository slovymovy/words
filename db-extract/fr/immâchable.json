                        "glosses": [
                            "Que l’on ne peut pas mâcher."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d746e3cb-2512-4e25-b662-9c5cd5975afe",
                                "sense_id": "90a6e6e9-0322-305f-9d30-e3cdb32ac611",
                                "text": "Mais surtout il convient de séparer la noix du corail en ôtant l’immâchable membrane qui les lie."
                            },
                            {
                                "example_id": "7c068944-7b7a-4b49-9ae1-ad25978c3d18",
                                "sense_id": "90a6e6e9-0322-305f-9d30-e3cdb32ac611",
                                "text": "Un aliment ou un produit que je n’aime pas du tout : Le céleri en branche, fibreux, immâchable, d’une consistance que mon palais refuse obstinément !"
                            },
                            {
                                "example_id": "8788ec77-b790-49f4-819d-ad2b218f8481",
                                "sense_id": "90a6e6e9-0322-305f-9d30-e3cdb32ac611",
                                "text": "Il y a le magret fumé avec ses chips de betterave, la hampe de bœuf fumée en carpaccio (immâchable et duraille) sur lesquels on a dispersé des copeaux de foie gras, le joli céleri cuit au four, lard, échalotes, moelle de bœuf, la pintade alourdie par son cantal fondu, son chou sauvage et jus de jambon cuit."
                            }
                        ]
                    }
