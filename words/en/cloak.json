{
    "word_family": [
        "cloakroom",
        "uncloak"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0cabc68b-6245-3f8f-8789-9643c5e2a8f5",
                    "sense_definition": "A long outer garment worn over the shoulders covering the back, often with a hood.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mysterious traveler wore a heavy <w>cloak</w> to protect himself from the cold wind.",
                            "target_lang_translations": {
                                "ru": "Таинственный путешественник носил тяжелый <w>плащ</w>, чтобы защититься от холодного ветра."
                            }
                        },
                        {
                            "text": "She pulled her velvet <w>cloak</w> tight around her shoulders as she stepped into the night.",
                            "target_lang_translations": {
                                "ru": "Она плотнее запахнула бархатную <w>накидку</w> на плечах, выходя в ночь."
                            }
                        }
                    ],
                    "synonyms": [
                        "cape",
                        "mantle"
                    ],
                    "common_phrases": [
                        "velvet cloak",
                        "hooded cloak",
                        "heavy cloak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинная верхняя одежда, надеваемая на плечи и закрывающая спину, часто с капюшоном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плащ",
                                "target_lang_sense_clarification": "верхняя одежда в виде накидки"
                            },
                            {
                                "target_lang_word": "мантия",
                                "target_lang_sense_clarification": "торжественное или официальное облачение"
                            },
                            {
                                "target_lang_word": "накидка",
                                "target_lang_sense_clarification": "свободная одежда без рукавов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee674815-cc29-3cd8-9388-cee1cb65bdf8",
                    "sense_definition": "A covering that hides or surrounds something, often used metaphorically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain peak was hidden under a thick <w>cloak</w> of mist all morning.",
                            "target_lang_translations": {
                                "ru": "Горная вершина все утро была скрыта под густым <w>покровом</w> тумана."
                            }
                        },
                        {
                            "text": "The spies moved through the city under a <w>cloak</w> of darkness to avoid being seen.",
                            "target_lang_translations": {
                                "ru": "Шпионы передвигались по городу под <w>покровом</w> темноты, чтобы остаться незамеченными."
                            }
                        }
                    ],
                    "synonyms": [
                        "shroud",
                        "blanket",
                        "veil"
                    ],
                    "common_phrases": [
                        "cloak of darkness",
                        "cloak of secrecy",
                        "cloak of mist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оболочка, которая скрывает или окружает что-либо, часто используется метафорически."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покров",
                                "target_lang_sense_clarification": "слой, скрывающий что-либо (ночи, тумана)"
                            },
                            {
                                "target_lang_word": "завеса",
                                "target_lang_sense_clarification": "то, что скрывает или отделяет"
                            },
                            {
                                "target_lang_word": "пелена",
                                "target_lang_sense_clarification": "густой слой тумана или дыма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ded0bb38-37bc-3467-a77f-7c7b420db235",
                    "sense_definition": "Something that conceals the true nature of something else; a disguise or pretext.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used his charity work as a <w>cloak</w> for his illegal business activities.",
                            "target_lang_translations": {
                                "ru": "Он использовал благотворительность как <w>прикрытие</w> для своей незаконной деятельности."
                            }
                        },
                        {
                            "text": "The politician's friendly smile was merely a <w>cloak</w> for his ruthless ambition.",
                            "target_lang_translations": {
                                "ru": "Дружелюбная улыбка политика была лишь <w>маской</w>, скрывающей его безжалостные амбиции."
                            }
                        }
                    ],
                    "synonyms": [
                        "pretext",
                        "guise",
                        "mask",
                        "facade"
                    ],
                    "common_phrases": [
                        "cloak for",
                        "convenient cloak"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что скрывает истинную природу чего-либо; маскировка или предлог."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикрытие",
                                "target_lang_sense_clarification": "маскировка истинных намерений"
                            },
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "видимость, скрывающая суть"
                            },
                            {
                                "target_lang_word": "личина",
                                "target_lang_sense_clarification": "притворство, фальшивый облик"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "652d8ab2-0582-3c7d-b585-2764f1026349",
                    "sense_definition": "A text replacement for a user's hostname or IP address to protect their identity online.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The administrator assigned a <w>cloak</w> to the user to prevent IP tracking on the server.",
                            "target_lang_translations": {
                                "ru": "Администратор назначил пользователю <w>клок</w>, чтобы предотвратить отслеживание IP на сервере."
                            }
                        },
                        {
                            "text": "You can request a virtual <w>cloak</w> to hide your connection details from other chat members.",
                            "target_lang_translations": {
                                "ru": "Вы можете запросить виртуальную <w>маску</w>, чтобы скрыть данные о вашем подключении от других участников чата."
                            }
                        }
                    ],
                    "synonyms": [
                        "mask",
                        "vhost"
                    ],
                    "common_phrases": [
                        "user cloak",
                        "host cloak"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "technical jargon used in IRC and networking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Замена текста для имени хоста или IP-адреса пользователя для защиты его личности в сети."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клок",
                                "target_lang_sense_clarification": "технический термин в IRC"
                            },
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "скрытие реального адреса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2f9bf25-d8f8-3314-88b3-5f52bff26e95",
                    "sense_definition": "To hide, cover up, or conceal something from view or knowledge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick fog began to <w>cloak</w> the valley, making it impossible to see the road.",
                            "target_lang_translations": {
                                "ru": "Густой туман начал <w>окутывать</w> долину, из-за чего дорогу стало совершенно не видно."
                            }
                        },
                        {
                            "text": "The organization tried to <w>cloak</w> in secrecy the details of the new project.",
                            "target_lang_translations": {
                                "ru": "Организация пыталась <w>окружить</w> завесой тайны детали нового проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "conceal",
                        "hide",
                        "mask",
                        "shroud"
                    ],
                    "antonyms": [
                        "reveal",
                        "uncover",
                        "expose"
                    ],
                    "common_phrases": [
                        "cloak in secrecy",
                        "cloak in mystery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрывать, утаивать или маскировать что-либо от глаз или знания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окутывать",
                                "target_lang_sense_clarification": "окружать туманом или тайной"
                            },
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "делать невидимым или тайным"
                            },
                            {
                                "target_lang_word": "маскировать",
                                "target_lang_sense_clarification": "скрывать под чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f13fa39c-052b-3da3-acc1-d02df7bcdfdb",
                    "sense_definition": "To cover someone or something with a cloak or similar garment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The servant proceeded to <w>cloak</w> the king before he stepped out into the rain.",
                            "target_lang_translations": {
                                "ru": "Слуга принялся <w>накидывать плащ</w> на короля, прежде чем тот вышел под дождь."
                            }
                        },
                        {
                            "text": "She would <w>cloak</w> her shoulders with a shawl whenever the evening air turned chilly.",
                            "target_lang_translations": {
                                "ru": "Она <w>набрасывала</w> на плечи шаль всякий раз, когда вечерний воздух становился прохладным."
                            }
                        }
                    ],
                    "synonyms": [
                        "drape",
                        "envelop",
                        "wrap"
                    ],
                    "antonyms": [
                        "undress"
                    ],
                    "common_phrases": [
                        "cloak the shoulders"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Накрывать кого-либо или что-либо плащом или подобной одеждой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укутывать",
                                "target_lang_sense_clarification": "плотно закрывать одеждой"
                            },
                            {
                                "target_lang_word": "накидывать",
                                "target_lang_sense_clarification": "надевать сверху на плечи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c1ec633-9034-33eb-96bb-2305f3ffe407",
                    "sense_definition": "To make something invisible using advanced or futuristic technology.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot decided to <w>cloak</w> the ship to avoid detection by the enemy radar.",
                            "target_lang_translations": {
                                "ru": "Пилот решил <w>замаскировать</w> корабль, чтобы избежать обнаружения вражескими радарами."
                            }
                        },
                        {
                            "text": "In many science fiction movies, aliens <w>cloak</w> their vessels to observe Earth secretly.",
                            "target_lang_translations": {
                                "ru": "Во многих научно-фантастических фильмах пришельцы <w>скрывают</w> свои корабли, чтобы тайно наблюдать за Землей."
                            }
                        }
                    ],
                    "antonyms": [
                        "uncloak"
                    ],
                    "common_phrases": [
                        "cloak the ship",
                        "cloaking device"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо невидимым с помощью передовых или футуристических технологий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маскировать",
                                "target_lang_sense_clarification": "делать невидимым для радаров"
                            },
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "использовать режим невидимости"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}