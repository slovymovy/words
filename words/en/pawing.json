    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0d122190-cfd9-3454-b0bc-7255f294d313",
                    "sense_definition": "Present participle and gerund of <w>paw</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was <w>pawing</w> at the door to be let inside.",
                            "target_lang_translations": {
                                "cs": "Pes <w>škrábal</w> na dveře, aby ho někdo pustil dovnitř."
                            }
                        },
                        {
                            "text": "Constant <w>pawing</w> at the carpet has left it quite worn.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>hrabání</w> do koberce ho značně poničilo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pawing at"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost zvířete, které škrábe nebo tlapou naráží do předmětu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "škrábání",
                                "target_lang_sense_clarification": "obecné označení pro pohyb tlapou po povrchu"
                            },
                            {
                                "target_lang_word": "hrabání",
                                "target_lang_sense_clarification": "intenzivnější pohyb tlapami, často u dveří nebo v zemi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af0a6056-1bcb-3499-bd36-e5664b5da7d6",
                    "sense_definition": "The act of striking or scraping something with a paw or hand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The door showed signs of <w>pawing</w> from the excited dog.",
                            "target_lang_translations": {
                                "cs": "Dveře vykazovaly známky <w>škrábání</w> od rozrušeného psa."
                            }
                        },
                        {
                            "text": "Persistent <w>pawing</w> at the gate finally got the owner's attention.",
                            "target_lang_translations": {
                                "cs": "Vytrvalé <w>drápání</w> na bránu konečně upoutalo majitelovu pozornost."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt úderů nebo škrábání tlapou či rukou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "škrábání",
                                "target_lang_sense_clarification": "opakovaný pohyb tlapou"
                            },
                            {
                                "target_lang_word": "drápání",
                                "target_lang_sense_clarification": "intenzivní kontakt drápů s povrchem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
