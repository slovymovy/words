                "senses": [
                    {
                        "sense_id": "d9daa921-a500-37d5-8ec9-93726de389e2",
                        "entry_id": "5e5aecc3-9e25-38e5-9bf2-803f41a89e99",
                        "glosses": [
                            "weibliche Person, die in Funk und Fernsehen die Nachrichten vorträgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28afea43-d073-4895-97ba-13d8fbc8fe98",
                                "sense_id": "d9daa921-a500-37d5-8ec9-93726de389e2",
                                "text": "„Die alterslose Nachrichtensprecherin war vielleicht die Freundin des uralten Wettermannes.“"
                            },
                            {
                                "example_id": "7f8651e5-105c-477a-a812-becbd4b57fb6",
                                "sense_id": "d9daa921-a500-37d5-8ec9-93726de389e2",
                                "text": "„So muss sich diese Nachrichtensprecherin gefühlt haben, als sie während der Livesendung eine Nierenkolik hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23e78a03-e167-40aa-b945-364e32968894",
                        "source_entry_id": "5e5aecc3-9e25-38e5-9bf2-803f41a89e99",
                        "source_sense_id": "d9daa921-a500-37d5-8ec9-93726de389e2",
                        "source_sense_description": "weibliche Person, die in Funk und Fernsehen die Nachrichten vorträgt",
                        "target_lang_word": "newscaster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "newscaster",
                                "target_lang_code": "en",
