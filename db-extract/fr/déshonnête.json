                ],
                "senses": [
                    {
                        "sense_id": "a8771095-be2f-3063-b023-0148b1688013",
                        "entry_id": "929b6751-e0f4-302c-bead-40b35f5e3bc2",
                        "glosses": [
                            "that is contrary to the proprieties, against common decency"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b75a034-a357-471d-99c1-7e510c9e2585",
                                "sense_id": "a8771095-be2f-3063-b023-0148b1688013",
                                "text": "Garce avait un sens très bon, on l'a rendu déshonnête ; Aujourd'hui, fille est devenu déshonnête à son tour en certains cas ; on ne peut plus dire une pension de filles, il faut dire : de jeunes filles ou de jeunes personnes ; où s'arrêtera-t-on ? (Dorothée Aquino-Weber, Sara Cotelli, Andres Kristol, Sociolinguistique historique du domaine gallo-roman : enjeux et methodologies, Berne, 2009)"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
