                                "target_senses": [
                                    {
                                        "sense_id": "3a5ada8a-1738-333f-bf44-d855d2051d47",
                                        "entry_id": "1dd14386-d437-315c-9a92-45e3ed315892",
                                        "glosses": [
                                            "Alternative form of Ulaanbaatar."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "048d03ad-4ed8-4fcc-bd81-dca6d4e43590",
                                                "sense_id": "3a5ada8a-1738-333f-bf44-d855d2051d47",
                                                "text": "Extensive deposits of copper and molybdenum ore, situated some 200 miles northwest of Ulan Bator between the Selenga and Orkhon Rivers, will eventually be extracted by open‐pit methods and processed at the still unfinished town of Erdenet."
                                            },
                                            {
                                                "example_id": "c0ba01d3-2035-4ed4-bd07-bb9de147ade6",
                                                "sense_id": "3a5ada8a-1738-333f-bf44-d855d2051d47",
                                                "text": "Ulan Bator is the world’s coldest capital, and even in early September, snow is not unusual. But we arrived on a crystal-clear day with bright sunshine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07cc7233-dd21-4d22-a0c0-19dbce1e9491",
                        "source_entry_id": "8d374c05-1d71-3256-b498-a98364d0c524",
                        "source_sense_id": "6b70cab9-7334-3faa-b9d4-c4d4745d383b",
