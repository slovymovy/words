                "senses": [
                    {
                        "sense_id": "6dc3d81c-f86b-3aeb-8932-a417e1bd242f",
                        "entry_id": "531b5207-52f0-3078-a681-d82897a5c042",
                        "glosses": [
                            "диал. волнистая поверхность прибрежного песка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fadfd92-28b7-4fa0-a541-26b1d11fb9d1",
                                "sense_id": "6dc3d81c-f86b-3aeb-8932-a417e1bd242f",
                                "text": "И меня по ветряному свею, // По тому ль песку, // Поведут с веревкою на шее // Полюбить тоску."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8210de2-0087-3b9e-9d0d-920dc4df89c3",
                        "entry_id": "531b5207-52f0-3078-a681-d82897a5c042",
                        "glosses": [
                            "диал. сухой снег в мороз, сдуваемый в земли"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd0319b-9da3-4bfe-b285-84886cff40e1",
                                "sense_id": "c8210de2-0087-3b9e-9d0d-920dc4df89c3",
                                "text": "Метут сарозекские вьюги, заваливая дома по окна сугробами, а железную дорогу холмами плотного мерзлого свея."
                            }
                        ]
                    }
                ],
