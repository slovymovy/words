{
    "word_family": [
        "chercheur",
        "chercheuse",
        "recherche",
        "rechercher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "087a5d8c-1c60-3626-99a5-a40cbdcf83a0",
                    "sense_definition": "Tenter de trouver une personne ou un objet dont on ignore l'emplacement exact.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "trouver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>cherche</w> mes clés partout depuis ce matin sans réussir à mettre la main dessus."
                        },
                        {
                            "text": "Les enfants <w>cherchent</w> leurs jouets préférés sous le lit."
                        }
                    ],
                    "synonyms": [
                        "rechercher"
                    ],
                    "common_phrases": [
                        "chercher ses clés",
                        "chercher du travail"
                    ],
                    "antonyms": [
                        "trouver"
                    ]
                },
                {
                    "sense_id": "ce282c41-c4a6-3ccf-b67a-abb9c99a99ff",
                    "sense_definition": "Aller ou venir auprès d'une personne ou d'une chose pour la prendre et l'emmener.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "recuperer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Paul doit aller <w>chercher</w> sa fille à l'école à la fin des cours."
                        },
                        {
                            "text": "Je viendrai te <w>chercher</w> en voiture devant la gare après le travail."
                        }
                    ],
                    "common_phrases": [
                        "aller chercher quelqu'un",
                        "venir chercher un colis"
                    ]
                },
                {
                    "sense_id": "5032e0c9-127a-372f-83b0-5a7892b8113e",
                    "sense_definition": "S'efforcer d'atteindre un résultat ou essayer d'accomplir une action.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tenter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques <w>cherchent</w> à comprendre l'origine de ce phénomène naturel."
                        },
                        {
                            "text": "Nous <w>cherchons</w> à régler ce problème le plus rapidement possible."
                        }
                    ],
                    "synonyms": [
                        "essayer",
                        "tenter"
                    ],
                    "common_phrases": [
                        "chercher à comprendre",
                        "chercher une solution"
                    ]
                },
                {
                    "sense_id": "33c1952c-bd84-3e72-bfdf-baebb707b3fa",
                    "sense_definition": "Provoquer quelqu'un ou adopter un comportement susceptible de déclencher un conflit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "provoquer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête de te moquer de moi, tu me <w>cherches</w> ou quoi ?"
                        },
                        {
                            "text": "Il préfère garder le silence pour éviter de <w>chercher</w> les ennuis."
                        }
                    ],
                    "synonyms": [
                        "provoquer",
                        "narguer"
                    ],
                    "common_phrases": [
                        "chercher la bagarre",
                        "chercher des histoires",
                        "chercher les ennuis"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier dans le sens de provoquer"
                        }
                    ]
                },
                {
                    "sense_id": "64352a47-0d60-3108-8b59-14ea2aeda7b0",
                    "sense_definition": "Faire une introspection pour mieux se connaître et définir sa place ou sa vocation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "introspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À cet âge, il est tout à fait naturel qu'un adolescent se <w>cherche</w> encore."
                        },
                        {
                            "text": "Elle a entrepris un long voyage parce qu'elle se <w>cherchait</w> sur le plan professionnel."
                        }
                    ],
                    "common_phrases": [
                        "se chercher une voie"
                    ]
                }
            ]
        }
    ]
}