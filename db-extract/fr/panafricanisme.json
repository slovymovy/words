                                        "entry_id": "80094b7c-242c-38d5-b13d-9e9ce797e3cc",
                                        "glosses": [
                                            "Streben nach einem besonders engen Verbund, intensiver Zusammenarbeit aller Staaten in Afrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ec8040a-171b-4b69-89b8-4256a0f65554",
                                                "sense_id": "e9ff0c18-7640-3ce8-9db5-52b81aaab416",
                                                "text": "„Während Mugabe in Fort Hare mit dem südafrikanischen schwarzen Nationalismus in Berührung kam, lernte Nkrumah den Panafrikanismus auf dem amerikanischen Kontinent kennen, wo dieser bis in die 1940er Jahre lebendiger war als in Afrika selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
