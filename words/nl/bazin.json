                {
                    "sense_id": "a0c38746-d235-388c-a7b3-b17e93d38b64",
                    "sense_definition": "vrouwelijke leidinggevende of werkgeefster",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "leidinggevende",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij sprak gisteren lang met haar nieuwe <w>bazin</w> over haar taken.",
                            "target_lang_translations": {
                                "en": "Yesterday she talked at length with her new <w>boss</w> about her duties.",
                                "ru": "Вчера она долго обсуждала свои обязанности со своей новой <w>начальницей</w>."
                            }
                        },
                        {
                            "text": "Aan de bar dronk ik samen met de <w>bazin</w> van het café een biertje.",
                            "target_lang_translations": {
                                "en": "At the bar, I had a beer together with the café's <w>landlady</w>.",
                                "ru": "У барной стойки я выпил пива вместе с <w>хозяйкой</w> кафе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de bazin van het café"
                    ],
                    "target_lang_definitions": {
