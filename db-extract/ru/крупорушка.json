                "senses": [
                    {
                        "sense_id": "db5d609c-798b-313d-be12-c2652cb16a97",
                        "entry_id": "6e049069-6976-30b4-822f-e86b4dfe275c",
                        "glosses": [
                            "небольшое предприятие по переработке зерна в крупу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "729ac310-adeb-40ef-b89e-9e5e0392ac7f",
                                "sense_id": "db5d609c-798b-313d-be12-c2652cb16a97",
                                "text": "Пахом и Влас, зашпилив воз и увязав его поводьями, торопливо пошли в крупорушку."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb35fc0f-f2fc-3031-9a8e-73526145612f",
                        "entry_id": "6e049069-6976-30b4-822f-e86b4dfe275c",
                        "glosses": [
                            "машина для такой переработки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baf2ea3a-6c1d-425b-87f4-b24b3dcca4c0",
                                "sense_id": "eb35fc0f-f2fc-3031-9a8e-73526145612f",
                                "text": "В детстве я сам кормил свиней кукурузой, пропущенной через крупорушку, — пояснил я."
                            }
                        ]
                    }
