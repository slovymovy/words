                "senses": [
                    {
                        "sense_id": "0d943627-f751-3eed-bf96-20b660c3b5e4",
                        "entry_id": "2fc339dd-ccdb-337f-af01-713f1d3c3559",
                        "glosses": [
                            "Donner un caractère xénophile à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b346e28a-f7ef-43e7-97bd-a6c219e1f260",
                                "sense_id": "0d943627-f751-3eed-bf96-20b660c3b5e4",
                                "text": "Un autre vous dira que les Évangiles sont écrits de façon très simple, et pourra vouloir les « archaïser », les « xénophiliser » bien qu’ils soient en grec."
                            },
                            {
                                "example_id": "bfe68ca6-c9ad-4855-8bc3-c29fa71eb4a1",
                                "sense_id": "0d943627-f751-3eed-bf96-20b660c3b5e4",
                                "text": "Ah dans les bonnes campagnes où la loi des mœurs françaises règne, là c’est pas encore xénophilisé en chanson à mort comme aujourd’hui, avec dans l’acte délictueux une remarquable faiblesse du taux visible de Whities, une espèce qui disparaît à vue d’œil et qu’il faut protéger comme la truite authentique dans les rivières pro-EDF."
                            }
                        ]
                    }
