                ],
                "senses": [
                    {
                        "sense_id": "2bdd8020-1e33-377d-b002-b0adc559ac71",
                        "entry_id": "c7d94801-1e5b-3cbb-b9cb-223ff9df801e",
                        "glosses": [
                            "Dire bonjour, souvent en s’embrassant sur les joues."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": [
                            {
                                "example_id": "bd33615b-7bf8-4549-b938-049e3591845e",
                                "sense_id": "2bdd8020-1e33-377d-b002-b0adc559ac71",
                                "text": "Je relirai cette lettre une fois, deux fois, dix fois, et puis je courrai vers le collège, j’entrerai sur la sonnerie, sans même prendre le temps de boujouter mes copines de récré."
                            },
                            {
                                "example_id": "f11cc94c-4bfe-4b04-82fc-f28293a097f4",
                                "sense_id": "2bdd8020-1e33-377d-b002-b0adc559ac71",
                                "text": "Ils savent que je n’aime pas trop boujouter."
                            },
                            {
                                "example_id": "f35dcad7-5ad0-4bdd-8d02-2aed58e5cdef",
                                "sense_id": "2bdd8020-1e33-377d-b002-b0adc559ac71",
                                "text": "Les femmes se boujoutent Tante Blanche m’embrasse."
                            }
                        ]
                    }
