                    },
                    {
                        "translation_id": "2a283189-e59d-4c30-b3d0-f2d4ac62478f",
                        "source_entry_id": "74e38d9a-dff1-312c-9889-dfe582c13ff5",
                        "source_sense_id": "23d82aae-99e3-3968-a57d-f8fbf40177ef",
                        "target_lang_word": "bouilli",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouilli",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a414f8f1-9856-3e70-af9c-3455e07d3b76",
                                        "entry_id": "03a2a8e6-c7d6-34ab-9797-d42a7da4705e",
                                        "glosses": [
                                            "Qu’on a fait bouillir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca04404-fe91-4176-aa5f-190c278f2252",
                                                "sense_id": "a414f8f1-9856-3e70-af9c-3455e07d3b76",
                                                "text": "C’étaient des restes de bœuf bouilli achetés chez un rôtisseur tant soit peu regrattier, et fricassés au beurre avec des oignons coupés en tranches minces, jusqu’à ce que le beurre fût absorbé par la viande et par les oignons, de manière que ce mets de portier présentât l’aspect d’une friture."
                                            },
                                            {
                                                "example_id": "b215cfe0-3ef1-4dde-9996-c5f569df4f37",
                                                "sense_id": "a414f8f1-9856-3e70-af9c-3455e07d3b76",
                                                "text": "En réalité, ce vin du Caucase, quelque peu aigrelet, accompagne convenablement la poule bouillie, disons le « pilau », – ce qui permet de lui trouver une saveur spéciale."
                                            },
                                            {
                                                "example_id": "6be657bc-0434-4409-8266-4c32f9d36a60",
                                                "sense_id": "a414f8f1-9856-3e70-af9c-3455e07d3b76",
                                                "text": "C'est chez la veuve Thorsdal que j'appris à savourer les délices de la cuisine islandaise. Le dîner se composait invariablement de poisson bouilli."
                                            },
                                            {
                                                "example_id": "7014d083-a858-42cc-8c24-6d88517298b2",
                                                "sense_id": "a414f8f1-9856-3e70-af9c-3455e07d3b76",
                                                "text": "Quand on eut mangé le bœuf bouilli, on servit des quartiers de veau, des oies en daube, des fricassées de lapin et de poulet : de quoi nourrir un village pendant des semaines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de42d67-01cd-3ae4-89bd-8691024319b7",
                                        "entry_id": "03a2a8e6-c7d6-34ab-9797-d42a7da4705e",
                                        "glosses": [
                                            "Congestionné, les traits défaits."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de563596-fa24-4d0e-9bc0-62ceafa56dd2",
                                                "sense_id": "5de42d67-01cd-3ae4-89bd-8691024319b7",
                                                "text": "Mme Frontenac regagnait sa chambre et n’en redescendait, les yeux gonflés et la face bouillie, qu’après plusieurs ambassades et députations des enfants consternés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouilli",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9badcc9-8a3c-3bf4-93f9-88670aece80a",
                                        "entry_id": "a484917f-3538-334e-aefd-f5980e964e44",
                                        "glosses": [
                                            "Plat composé d'une viande, ordinairement de bœuf, cuite dans un pot, dans une marmite, et qui a servi à faire du bouillon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7611fc43-7b3d-40ae-9291-eb2bdc00a949",
                                                "sense_id": "b9badcc9-8a3c-3bf4-93f9-88670aece80a",
                                                "text": "Son bonheur ne pouvait pas être cette félicité bourgeoise qui se repaît d’un bouilli périodique, d’une douce bassinoire en hiver, d’une lampe pour la nuit et de pantoufles neuves à chaque trimestre."
                                            },
                                            {
                                                "example_id": "b247c33e-3e59-42ee-bd68-1f9c0159e77e",
                                                "sense_id": "b9badcc9-8a3c-3bf4-93f9-88670aece80a",
                                                "text": "Madelon leur servit une bonne soupe, qu’ils avalèrent en un clin d’œil, puis un bon bouilli aux choux, qui disparut également, enfin une salade et du fromage, qu’ils savourèrent avec moins d’avidité, leur faim se trouvant apaisée."
                                            },
                                            {
                                                "example_id": "181e2c84-6a1a-4a4c-ac5b-9ea1c146167b",
                                                "sense_id": "b9badcc9-8a3c-3bf4-93f9-88670aece80a",
                                                "text": "Le dîner se composait d'une soupe copieuse, d'un bon bouilli et d'une entrée suffisante pour huit personnes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouilli",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba17a592-fb87-3c43-b30a-2a06fbaa7850",
                                        "entry_id": "3035b795-1379-3c58-b10a-ae42346efba7",
                                        "glosses": [
                                            "Participe passé masculin singulier de bouillir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c66f5650-d53c-4a50-924e-e8f1be8f5b27",
                                                "sense_id": "ba17a592-fb87-3c43-b30a-2a06fbaa7850",
                                                "text": "Après avoir bouilli pendant deux heures, la viande en fut retirée et lavée pour la décharbonner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
