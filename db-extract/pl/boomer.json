                                    },
                                    {
                                        "sense_id": "20bf4596-48c0-33f8-8ead-f1c28f9550e1",
                                        "entry_id": "ee223556-b35b-3b63-b4fb-421e20f581d0",
                                        "glosses": [
                                            "Person mit unzeitgemäßen, meist sehr konservativen Ansichten und Meinungen"
                                        ],
