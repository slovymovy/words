                                        "glosses": [
                                            "Effrayer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc3bcce-e275-496e-9f14-915c4564004c",
                                                "sense_id": "f1d35c11-baaa-335b-9626-62a7cd8593ae",
                                                "text": "Lors de la Coupe du monde 2027 en Australie, Grégory Alldritt aura 30 ans, alors que Charles Ollivon, autre candidat, en aura 34 et semble donc moins sûr de voir le pays des bestioles qui font peur."
                                            },
                                            {
                                                "example_id": "e096846a-e0e9-45a4-9898-84f67613935a",
                                                "sense_id": "f1d35c11-baaa-335b-9626-62a7cd8593ae",
                                                "text": "J’ai tué personne là-bas, je tirais en l’air pour leur faire peur…"
                                            },
                                            {
                                                "example_id": "60a87c37-e939-4ad2-a36d-b071aee8b410",
                                                "sense_id": "f1d35c11-baaa-335b-9626-62a7cd8593ae",
                                                "text": "Les hold-up lui faisaient peur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
