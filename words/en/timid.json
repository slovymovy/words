                    "semantic_group_id": "personality_traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "John is a very <w>timid</w> person, so I doubt he will be brave enough to face his brother.",
                            "target_lang_translations": {
                                "ru": "Джон очень <w>робкий</w> человек, поэтому я сомневаюсь, что ему хватит смелости противостоять своему брату."
                            }
                        },
                        {
                            "text": "The <w>timid</w> child hid behind her mother's legs when the stranger tried to say hello.",
                            "target_lang_translations": {
                                "ru": "<w>Застенчивый</w> ребенок спрятался за мамины ноги, когда незнакомец попытался поздороваться."
                            }
                        },
                        {
                            "text": "He made a <w>timid</w> attempt to speak during the meeting, but his voice was barely audible.",
                            "target_lang_translations": {
                                "ru": "Он предпринял <w>робкую</w> попытку высказаться во время встречи, но его голос был едва слышен."
                            }
                        }
                    ],
                    "synonyms": [
