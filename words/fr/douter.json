    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "272921ef-e0a4-36a7-9fec-23b4dcd82f10",
                    "sense_definition": "Être dans l'incertitude quant à la vérité, la réalité ou la réalisation de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "incertitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>doute</w> sincèrement qu'il vienne à cette réunion demain matin."
                        },
                        {
                            "text": "Il ne faut jamais <w>douter</w> de ses capacités face aux difficultés."
                        }
                    ],
                    "antonyms": [
                        "croire"
                    ],
                    "common_phrases": [
                        "douter de tout"
                    ]
                },
                {
                    "sense_id": "f9001769-f876-3b24-8fdf-3bed7f625b77",
                    "sense_definition": "Avoir le pressentiment, l'intuition ou le soupçon de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "soupcon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me <w>doutais</w> bien qu'il préparait une surprise pour mon anniversaire."
                        },
                        {
                            "text": "Elle ne se <w>doutait</w> de rien avant d'ouvrir la porte."
                        }
                    ],
                    "synonyms": [
                        "soupçonner",
                        "pressentir"
                    ],
                    "antonyms": [
                        "ignorer"
                    ],
                    "common_phrases": [
                        "s'en douter",
                        "ne se douter de rien"
                    ]
                },
                {
                    "sense_id": "ad42490c-0376-37a8-b873-6efb60e577f7",
                    "sense_definition": "Hésiter ou balancer avant de prendre une décision ou d'agir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat a longtemps <w>douté</w> avant d'accepter cette proposition d'embauche."
                        },
                        {
                            "text": "Ce jeune aventurier ne <w>doute</w> de rien et ose tout affronter."
                        }
                    ],
                    "synonyms": [
                        "hésiter",
                        "balancer"
                    ],
                    "antonyms": [
                        "trancher"
                    ],
                    "common_phrases": [
                        "ne douter de rien"
                    ]
                },
                {
                    "sense_id": "ae26507c-c182-32b6-b6e5-8ffa20c2d565",
                    "sense_definition": "Remettre en cause ses croyances religieuses ou ses convictions philosophiques.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "foi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce drame, il a commencé à <w>douter</w> profondément de sa foi."
                        },
                        {
                            "text": "Le philosophe nous invite à <w>douter</w> pour parvenir à la certitude."
                        }
                    ]
                }
            ]
        }
    ]
