                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8443083e-a4d4-3c7d-a09a-84c126ce9385",
                                        "entry_id": "3c079e67-f141-328d-bb5b-fc6a82b240bb",
                                        "glosses": [
                                            "A logarithmic scale used to express the energy released by an earthquake, each increase of 1 representing a 31-fold increase in energy, and a 10-fold increase in the measured wave amplitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b35a7d04-c4e7-4a8f-a2aa-c0f35e213563",
                                                "sense_id": "8443083e-a4d4-3c7d-a09a-84c126ce9385",
                                                "text": "“The Richter scale is an old scale developed for California. It is only good for smaller quakes, and is not very good at differentiating the sizes of bigger shocks,” said McGuire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Richter scale",
                                "target_lang_code": "en",
                                "target_senses": [
