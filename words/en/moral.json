                            {
                                "target_lang_word": "莫拉尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dc158a5-a358-343a-882f-9559442115c0",
                    "sense_definition": "A township in Shelby County, Indiana, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited <w>Moral</w> township during their trip to Indiana.",
                            "target_lang_translations": {
                                "ru": "Они посетили тауншип <w>Морал</w> во время поездки в Индиану.",
                                "zh": "他们在印第安纳州旅行期间参观了<w>莫拉尔</w>镇区。"
                            }
                        },
                        {
                            "text": "The population of <w>Moral</w> has grown slightly over the years.",
                            "target_lang_translations": {
