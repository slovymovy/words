                {
                    "sense_id": "f7674d39-e642-3042-a85b-fb9713102b6e",
                    "sense_definition": "Управлять кем-либо, заставлять действовать в своих интересах.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она умеет ловко <крутить> своим начальником, чтобы получать премии.",
                            "target_lang_translations": {
