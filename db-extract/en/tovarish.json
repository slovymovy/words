                    {
                        "translation_id": "dd24d831-5873-48a8-a425-adaff9880a0c",
                        "source_entry_id": "caed8438-0933-3bb0-b1de-22bad94b4640",
                        "source_sense_id": "c7e4935e-5689-3982-8e4e-01c818c98d2a",
                        "source_sense_description": "comrade, especially with reference to the former USSR — see also comrade",
                        "target_lang_word": "това́рищ",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "това́рищ",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f47003b1-eaf6-38c9-a20a-8559318f21a5",
                                        "entry_id": "12504af2-ba3b-360f-a9cc-8df5a51c150a",
                                        "glosses": [
                                            "тот, кто связан с кем-либо общей профессией, местом работы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f7276db-c06d-3ef3-8a05-b93584ca1c57",
                                        "entry_id": "12504af2-ba3b-360f-a9cc-8df5a51c150a",
                                        "glosses": [
                                            "тот, кто связан с кем-либо узами дружбы; друг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1060f278-5223-4a3b-8fed-3b2dedf62e4c",
                                                "sense_id": "2f7276db-c06d-3ef3-8a05-b93584ca1c57",
                                                "text": "Мы с ними давние товарищи."
                                            },
                                            {
                                                "example_id": "02b71a45-688c-4968-83a3-f42658c39135",
                                                "sense_id": "2f7276db-c06d-3ef3-8a05-b93584ca1c57",
                                                "text": "Он снова простирает руки товарищам минувших лет."
                                            },
                                            {
                                                "example_id": "0b614f5f-a277-4ff4-b00b-4f9329f7ce88",
                                                "sense_id": "2f7276db-c06d-3ef3-8a05-b93584ca1c57",
                                                "text": "Великим подспорьем всего его существования, неизменным товарищем и другом была ему его тётка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e000d61-56e4-39a2-94f9-1138f114ad53",
                                        "entry_id": "12504af2-ba3b-360f-a9cc-8df5a51c150a",
                                        "glosses": [
                                            "тот, кто идейно связан с кем-либо; соратник"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8bff032-115f-3acf-b568-33964ef4ffb1",
                                        "entry_id": "12504af2-ba3b-360f-a9cc-8df5a51c150a",
                                        "glosses": [
                                            "полит., истор. член революционной политической партии, гражданин социалистической страны, член социалистического общества (в частности — советского общества)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edabb4df-89a0-4dc5-b614-9eea161b1cd5",
                                                "sense_id": "e8bff032-115f-3acf-b568-33964ef4ffb1",
                                                "text": "Дело было поручено трём партийным и трём беспартийным товарищам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07380d3-36b1-3a2f-8be8-33b754a915d3",
                                        "entry_id": "12504af2-ba3b-360f-a9cc-8df5a51c150a",
                                        "glosses": [
                                            "полит., истор. часть официального именования человека перед фамилией или званием, часть обращения перед фамилией или званием, обращение к человеку (в революционных партиях и социалистических государствах)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fe4d3f3-0857-4fc5-b75a-edfa63ca5f85",
                                                "sense_id": "a07380d3-36b1-3a2f-8be8-33b754a915d3",
                                                "text": "Здравствуйте, товарищи!"
                                            },
                                            {
                                                "example_id": "594a0b96-0207-45a8-8e33-14076557a2c2",
                                                "sense_id": "a07380d3-36b1-3a2f-8be8-33b754a915d3",
                                                "text": "Товарищ Иванов!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98a5999d-d5d1-386f-8961-4ae174843188",
                                        "entry_id": "12504af2-ba3b-360f-a9cc-8df5a51c150a",
                                        "glosses": [
                                            "юр. участник гражданско-правового товарищества"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30c65005-303b-3647-93a4-6e603b547343",
                                        "entry_id": "12504af2-ba3b-360f-a9cc-8df5a51c150a",
                                        "glosses": [
                                            "истор., офиц. кого. то же, что помощник, заместитель (в наименованиях званий и должностей Российской империи)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "831d34ef-9d60-4854-8c59-fdebecf7ec0a",
                                                "sense_id": "30c65005-303b-3647-93a4-6e603b547343",
                                                "text": "Товарищем министра внутренних дел назначен был тайный советник Осип Петрович Козодавлев."
                                            },
                                            {
                                                "example_id": "f0c52c58-adab-4703-af1d-cfb14a4f3fe3",
                                                "sense_id": "30c65005-303b-3647-93a4-6e603b547343",
                                                "text": "Позднее, к 60-м годам, к тем же кружкам принадлежал студент Н. Неклюдов, вожак студенческой братии, который начал свою известность с Петропавловской крепости, а кончил должностью товарища министра внутренних дел и умер в здании «у Цепного моста», превратившись из архикрасного в белоснежного государственника и обличителя крамолы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
