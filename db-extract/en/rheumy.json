    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "610cb511-21e4-38ba-a332-175bd27abb54",
                "word": "rheumy",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0fd27d38-e97d-4e98-800f-ee67e110b500",
                        "entry_id": "610cb511-21e4-38ba-a332-175bd27abb54",
                        "tags": [
                            "comparative"
                        ],
                        "form": "rheumier"
                    },
                    {
                        "form_id": "ca0438c0-5009-43b4-bdf1-093e31a9af86",
                        "entry_id": "610cb511-21e4-38ba-a332-175bd27abb54",
                        "tags": [
                            "superlative"
                        ],
                        "form": "rheumiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23bfef23-ee16-333c-b791-063747f0f8bf",
                        "entry_id": "610cb511-21e4-38ba-a332-175bd27abb54",
                        "glosses": [
                            "Of, relating to, or made of rheum (“thin or watery discharge of mucus or serum”); watery."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c518f877-1819-30ed-83f3-8016ea0e0824",
                        "entry_id": "610cb511-21e4-38ba-a332-175bd27abb54",
                        "glosses": [
                            "Producing rheum from the mucous membranes; (also figuratively) especially of the eyes: filled with rheum; watery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0efa9a3-2431-416d-bf46-7dd1a4602422",
                                "sense_id": "c518f877-1819-30ed-83f3-8016ea0e0824",
                                "text": "So, too-much Cold couers vvith hoary Fleece / The head of Age, his fleſh diminiſhes, / VVithers his face, hollovves his rheumy eyes, / And makes himſelf euen his ovvn ſelf deſpiſe; […]"
                            },
                            {
                                "example_id": "42d7871b-1309-4cdb-9f37-a41fea9b30fc",
                                "sense_id": "c518f877-1819-30ed-83f3-8016ea0e0824",
                                "text": "The Northern Breath, that freezes Floods, he binds; / VVith all the race of Cloud-diſpelling VVinds: / […] / From his divided Beard tvvo Streams he pours, / His Head and rhumy Eyes diſtill in Shovvers."
                            },
                            {
                                "example_id": "d40ff06a-de59-4223-a0d6-b6f3f4f59018",
                                "sense_id": "c518f877-1819-30ed-83f3-8016ea0e0824",
                                "text": "But were it not curious to know how Sieyes, now in these days (for he is said to be still alive) looks out on all that Constitution masonry, through the rheumy soberness of extreme age?"
                            },
                            {
                                "example_id": "436b0c27-f4e3-4256-b062-35ee5ab0c3a9",
                                "sense_id": "c518f877-1819-30ed-83f3-8016ea0e0824",
                                "text": "Her lips were clammy, but in her rheumy eyes there still burned the light of a vague desire."
                            },
                            {
                                "example_id": "4f56bc2b-c333-45aa-b949-85949dbb993d",
                                "sense_id": "c518f877-1819-30ed-83f3-8016ea0e0824",
                                "text": "[…] Gately draws himself up to his full menacing height and shines his flashlight in the little homeowner’s rheumy eyes and addresses him the way menacing criminals speak in popular entertainment— […]"
                            },
                            {
                                "example_id": "1d74b3ce-540b-4ee0-8374-432e962c3830",
                                "sense_id": "c518f877-1819-30ed-83f3-8016ea0e0824",
                                "text": "Awoke calm in the morning, clearheaded. Lungs rheumier than usual, though."
                            },
                            {
                                "example_id": "58c90bbc-954c-4b0d-b501-9f2d00ac7231",
                                "sense_id": "c518f877-1819-30ed-83f3-8016ea0e0824",
                                "text": "Her wizened face beneath straggling gray hair gathered in a bun, held the kindest, but rheumiest of faded blue eyes."
                            },
                            {
                                "example_id": "9b6a62ce-5d63-43c9-a8f0-fdcd9197284a",
                                "sense_id": "c518f877-1819-30ed-83f3-8016ea0e0824",
                                "text": "Eventually we'd find a date and we'd meet up, his eyes a little rheumier, his untrained eyebrows even more adventurous than last year."
                            }
                        ]
                    },
                    {
                        "sense_id": "47bc01c7-cdc4-3e70-95d2-40b3c28a8330",
                        "entry_id": "610cb511-21e4-38ba-a332-175bd27abb54",
                        "glosses": [
                            "Especially of the air: damp, moist."
                        ],
                        "tags": [
                            "literary",
                            "obsolete",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "e590c802-ef56-45df-be23-2ba8d74a1a05",
                                "sense_id": "47bc01c7-cdc4-3e70-95d2-40b3c28a8330",
                                "text": "And vvill he ſteale out of his vvholſome bed / To dare the vile contagion of the Night? / And tempt the Rhevvmy, and vnpurged Ayre, / To adde vnto hit^([sic – meaning his]) ſickneſſe?"
                            },
                            {
                                "example_id": "e37022b0-1c9d-410e-9e79-ff0e9b82331f",
                                "sense_id": "47bc01c7-cdc4-3e70-95d2-40b3c28a8330",
                                "text": "The reumy vault vvill force your eyes to vveepe, / VVhilſt you behold true deſolation: […]"
                            },
                            {
                                "example_id": "88f20675-53a7-407b-ac22-e7770a7b900f",
                                "sense_id": "47bc01c7-cdc4-3e70-95d2-40b3c28a8330",
                                "text": "Avoiding observation as much as they conveniently could, the two sisters walked from the long wooden shed which formed the station here, into the rheumy air and along the road to the open country."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e290ad7-5325-491f-b40a-107c82bff3a9",
                        "source_entry_id": "610cb511-21e4-38ba-a332-175bd27abb54",
                        "source_sense_description": "producing rheum from the mucous membranes; especially of the eyes: filled with rheum — see also watery",
                        "target_lang_word": "chassieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chassieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2bb13bb0-8e1a-3226-922c-78152b9a6b7f",
                                        "entry_id": "ccde8862-2132-38f2-aff2-80b5bdef5dea",
                                        "glosses": [
                                            "Qui est affecté de chassie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f7dc74-4f9a-4720-942a-7ecdd2ac7b4d",
                                                "sense_id": "2bb13bb0-8e1a-3226-922c-78152b9a6b7f",
                                                "text": "Upper Renfrew Lane était une rue sale mais respectable. Une grosse femme aux yeux chassieux répondit au coup de sonnette de Poirot, au numéro 17."
                                            },
                                            {
                                                "example_id": "51341ea9-ce48-46e5-a465-2f57006625f8",
                                                "sense_id": "2bb13bb0-8e1a-3226-922c-78152b9a6b7f",
                                                "text": "C'était un homme maigre, au visage émacié, aux yeux chassieux."
                                            },
                                            {
                                                "example_id": "c12888a5-8143-4876-8631-087ca5164c59",
                                                "sense_id": "2bb13bb0-8e1a-3226-922c-78152b9a6b7f",
                                                "text": "Parfois on voyait apparaître dans notre café un petit colporteur difforme avec des yeux chassieux et mélancoliques, qui offrait d’une façon importune du papier à lettres, des crayons et des livres à bon marché, […]"
                                            },
                                            {
                                                "example_id": "bfa34322-3491-4d65-8e9f-663769c1fde9",
                                                "sense_id": "2bb13bb0-8e1a-3226-922c-78152b9a6b7f",
                                                "text": "Hérissé de barbe gluante… des trous sous les pommettes… Les os en saillie aiguë… Les orbites caves… les paupières chassieuses…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60f84cc8-4827-3aaa-ae0c-321aa8195f51",
                                        "entry_id": "ccde8862-2132-38f2-aff2-80b5bdef5dea",
                                        "glosses": [
                                            "Qui est incommodé par la chassie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d13a5f2-e7c7-458f-b80a-83c14e9cdd4a",
                                                "sense_id": "60f84cc8-4827-3aaa-ae0c-321aa8195f51",
                                                "text": "Ses vêtements sales et usés, sa barbe hirsute et son regard chassieux ne laissent aucun doute sur son « état »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99432d8e-1147-3d1b-9f48-47e47c9482de",
                                        "entry_id": "ccde8862-2132-38f2-aff2-80b5bdef5dea",
                                        "glosses": [
                                            "Qui a l’apparence de la chassie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "730c195f-1bbc-4209-b4f8-1938a50325e3",
                                                "sense_id": "99432d8e-1147-3d1b-9f48-47e47c9482de",
                                                "text": "Les murs avaient un aspect lépreux, et étaient couverts de coutures et de cicatrices comme un visage défiguré par quelque horrible maladie. Une humidité chassieuse y suintait."
                                            },
                                            {
                                                "example_id": "9bb97052-f38a-4447-bea9-07e43b12a060",
                                                "sense_id": "99432d8e-1147-3d1b-9f48-47e47c9482de",
                                                "text": "Et pourtant Mark refusait de laisser tomber, et pendant ce temps-là sa moustache avait blanchi, et un voile de déception chassieuse avait commencé à troubler son regard."
                                            },
                                            {
                                                "example_id": "1732f12e-f87d-4f9c-8a48-7660edcfe310",
                                                "sense_id": "99432d8e-1147-3d1b-9f48-47e47c9482de",
                                                "text": "… un escalier en échelle, de vieilles ferrailles entassées dans un coin, un tas de bois, plus loin une petite fenêtre chassieuse ouverte sur la cour, des bouteilles à droite et à gauche, un panier de haillons… que sais-je ? — un intérieur sombre, lézardé, hideux !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chassieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21e0dd48-4c2f-390e-9e4c-162af1a64efd",
                                        "entry_id": "fcc6826c-ddce-3c9f-b68f-849cac70cb87",
                                        "glosses": [
                                            "Personne affectée de chassie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11282cec-2c19-419e-83b9-5a68f43ee050",
                                                "sense_id": "21e0dd48-4c2f-390e-9e4c-162af1a64efd",
                                                "text": "Au lieu d’écrire des Syllabus qui ne peuvent réjouir que des bilieux, chagrineux, chassieux, ces deux chefs de mon Église distribueraient leurs faveurs à celles et à ceux qui sauraient le mieux m’adorer…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
