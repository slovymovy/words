                ],
                "senses": [
                    {
                        "sense_id": "ffac162e-727e-36f3-94cf-37d11d1bc67f",
                        "entry_id": "c6dd7aad-f85e-39d3-8a7a-88460b304c2e",
                        "glosses": [
                            "Stadt, in der eine Universität ansässig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdbd718c-61a7-4bde-abc6-979860e64122",
                                "sense_id": "ffac162e-727e-36f3-94cf-37d11d1bc67f",
                                "text": "Eine italienische Universitätsstadt heißt Padua."
                            },
                            {
                                "example_id": "41c2bbe3-2d82-4cbf-89d4-8a07e7455834",
                                "sense_id": "ffac162e-727e-36f3-94cf-37d11d1bc67f",
                                "text": "„Vielmehr schwärmt Helmstedt von der Zeit, als es noch eine Universitätsstadt war.“"
                            },
                            {
                                "example_id": "64805bd3-a184-456f-a4e7-9cfc42f5c43e",
                                "sense_id": "ffac162e-727e-36f3-94cf-37d11d1bc67f",
                                "text": "„Adrian hatte schon eine Woche früher in seinem neuen Gymnasium unten in der Universitätsstadt das Abitur hinter sich gebracht.“"
                            },
                            {
                                "example_id": "bcb47dec-3498-4761-9515-f287b5317bf3",
                                "sense_id": "ffac162e-727e-36f3-94cf-37d11d1bc67f",
                                "text": "„Wenn Wolfenbüttel schon keine Universitätsstadt war, dann mußten die Wissenschaftler eben hierher kommen.“"
                            },
                            {
                                "example_id": "9a73030f-22ca-4363-a1b1-5f0f05524bbe",
                                "sense_id": "ffac162e-727e-36f3-94cf-37d11d1bc67f",
                                "text": "„Auf den Straßen der stolzen Universitätsstadt kam es zu unwürdigen Szenen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "911506a8-e2d9-483a-b9b4-d8d852552ccc",
                        "source_entry_id": "c6dd7aad-f85e-39d3-8a7a-88460b304c2e",
