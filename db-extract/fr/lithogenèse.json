                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c31622d1-da61-4acd-b731-d9796a88a2a7",
                                "sense_id": "166c2a3d-42dd-333d-89df-f587167b13a4",
                                "text": "Le facteur essentiel de la lithogenèse est la sursaturation en sels insolubles que sont oxalate, phosphates et urates de calcium."
                            },
                            {
                                "example_id": "729f17c7-af2c-4fb1-a078-c4ec7e83b28d",
                                "sense_id": "166c2a3d-42dd-333d-89df-f587167b13a4",
                                "text": "Le terme de lithogenèse désigne l’ensemble des processus qui aboutissent à la formation d’un calcul dans les voies urinaires."
                            }
                        ]
                    }
