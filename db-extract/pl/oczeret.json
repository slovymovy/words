                "senses": [
                    {
                        "sense_id": "1be3609e-8d10-3534-b082-bc41b3b6ddba",
                        "entry_id": "c9d6c855-c5c5-31a9-8baa-fb6b83a59953",
                        "glosses": [
                            "Schoenoplectus Rchb., rodzaj roślin kłączowych z rodziny ciborowatych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cc630d2b-2189-35c3-ac32-44854c93599e",
                        "entry_id": "c9d6c855-c5c5-31a9-8baa-fb6b83a59953",
                        "glosses": [
                            "szuwary"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3fcc5a7a-c22c-4ffa-a9e3-33d7bc0a5c05",
                                "sense_id": "cc630d2b-2189-35c3-ac32-44854c93599e",
                                "text": "Perkoz zniknął w gęstym oczerecie."
                            },
                            {
                                "example_id": "3d6ed360-b464-42ab-8d77-f6e3b028d533",
                                "sense_id": "cc630d2b-2189-35c3-ac32-44854c93599e",
                                "text": "Nad głowami płynących ulatywały miliony ptactwa wodnego, pelikanów, dzikich gęsi, żurawi, kaczek i czajek, kulonów i rybitew; w oczeretach przybrzeżnych słychać było taki gwar, takie kotłowanie się wody i szum skrzydeł, że rzekłbyś, iż odbywają się tam sejmy lub wojny ptasie"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32d366c9-3012-4bfa-9cc3-47ddb016b5b8",
                        "source_entry_id": "c9d6c855-c5c5-31a9-8baa-fb6b83a59953",
