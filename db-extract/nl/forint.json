                                        "glosses": [
                                            "The basic unit of currency of Hungary; formerly subdivided into 100 fillér."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90ba307d-86e7-4875-b375-53217f7bf59b",
                                                "sense_id": "4981cb4d-043d-3e7f-ae51-41a8f6a90cab",
                                                "text": "Better yet, there were no cover charges, and we didn’t bother to order drinks in half the spots. So, despite having a Slovak beer and shots of both the traditional Hungarian fruit spirit palinka and the bittersweet digestif Unicum, the entire evening cost 2,000 forints, under $10."
                                            }
                                        ]
                                    }
