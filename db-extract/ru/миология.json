                "senses": [
                    {
                        "sense_id": "1b13c989-b79f-3744-ad81-247ef820b51e",
                        "entry_id": "62325abc-b030-3865-a4e0-3ad2e751fcdc",
                        "glosses": [
                            "научн., мед. раздел анатомии, изучающий строение мышц, мышечной системы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f57c30bb-2338-4fca-be1d-fd65697f00ca",
                                "sense_id": "1b13c989-b79f-3744-ad81-247ef820b51e",
                                "text": "Как мы уже выяснили ранее (в главе Миологии), человеческий организм имеет три генотипа это: эктоморф (астеник), мезоморф (нормостеник) и эндоморф (гиперстеник)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3b1fb95-42e1-4d9e-80c4-251d92a851ad",
                        "source_entry_id": "62325abc-b030-3865-a4e0-3ad2e751fcdc",
                        "source_sense_id": "1b13c989-b79f-3744-ad81-247ef820b51e",
                        "target_lang_word": "myology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1257787f-9ab7-35a2-baf6-a6fdf44d1928",
                                        "entry_id": "e23e4c56-3481-36ba-94eb-00f5f5115de9",
                                        "glosses": [
                                            "The physiological study of muscles."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc84c85f-4c34-422f-be8d-a04531d6732d",
                                                "sense_id": "1257787f-9ab7-35a2-baf6-a6fdf44d1928",
                                                "text": "Examination of the myology of the Comephoridae, an endemic fish family in Lake Baikal, has revealed their morphological peculiarities."
                                            },
                                            {
                                                "example_id": "866ef852-0e9a-4d43-99c5-2a6a2bbf240e",
                                                "sense_id": "1257787f-9ab7-35a2-baf6-a6fdf44d1928",
                                                "text": "Given this, there is an urgent need for detailed compared behavioural and anatomical studies of dasyurids, especially focused on osteology, myology and arthrology."
                                            },
                                            {
                                                "example_id": "008230e9-a081-4b15-85ac-81a81dd0e378",
                                                "sense_id": "1257787f-9ab7-35a2-baf6-a6fdf44d1928",
                                                "text": "He greets me as if I'd been waiting all my life to learn the secrets of Bovine Myology and Muscle Profiling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
