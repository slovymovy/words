                        ],
                        "examples": [
                            {
                                "example_id": "828e2c9d-afaf-415f-99f2-4d17496300dc",
                                "sense_id": "a8a32b7b-9bc3-352d-b49c-e950c55326ca",
                                "text": "- Ils ont des claouis en or massif, ces deux-là, fit Tony d’un air dégoûté en désignant les deux Jacques, Bollène et Sultan, qui étaient les deux gros gagnants pour le moment, avec Maurice qui se maintenait."
                            },
                            {
                                "example_id": "85cee1c1-f43a-460e-8a4d-9d5ae2d07004",
                                "sense_id": "a8a32b7b-9bc3-352d-b49c-e950c55326ca",
                                "text": "Quand on reçoit un coup dans les claouis, on ioule comme n'importe quel Tyrolien !"
                            },
                            {
                                "example_id": "a39d36c8-6287-4616-a192-c3934c24af08",
                                "sense_id": "a8a32b7b-9bc3-352d-b49c-e950c55326ca",
                                "text": "Si on était dans le civil, je lui couperais les claouis."
                            }
                        ]
                    }
