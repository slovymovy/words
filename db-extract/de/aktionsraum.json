                "senses": [
                    {
                        "sense_id": "0e6766f3-9c8a-33f8-9873-aa9c568eb1d8",
                        "entry_id": "1c235656-9977-3309-8d15-4b2ac437b85b",
                        "glosses": [
                            "räumliche Ausdehnung des Lebensraumes eines Tieres"
                        ],
                        "tags": [
                            "Verhaltensforschung"
                        ],
                        "examples": [
                            {
                                "example_id": "ac9d27d8-eea5-4eb9-a198-6f8af33765be",
                                "sense_id": "0e6766f3-9c8a-33f8-9873-aa9c568eb1d8",
                                "text": "„»Wenn man sieht, wie Wölfe, welchen Aktionsraum sie haben auch in Deutschland, dann kommen sie durchaus nah an die Dörfer, können sogar mal eine ihrer Pfoten in ein besiedeltes Gebiet hineinsetzen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                        "entry_id": "1c235656-9977-3309-8d15-4b2ac437b85b",
                        "glosses": [
                            "Ort oder räumliche Ausdehnung, in der etwas (meist etwas von Menschen Gemachtes) passiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e80fc82-ed5d-4674-a8d9-c49549e7a450",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "„Der Aktionsraum der Flugzeuge erstreckt sich sogar über tausend Kilometer.“"
                            },
                            {
                                "example_id": "2504b1ff-a5af-4e12-b05e-be2e077cbcb6",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "„Europa ist unser Markt, Europa ist unser Aktionsraum.“"
                            },
                            {
                                "example_id": "50a4f135-2e97-4299-b1bd-3aa959019aa9",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "„[…] Schauspieler. Ihr Aktionsraum ist die Bühne.“"
                            },
                            {
                                "example_id": "a1da0065-23d5-41aa-b9f8-d9b0a6d7daee",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "„Das Ruhrgebiet als Aktionsraum organisierter süditalienischer Kriminalität – diese Botschaft sollte auf keinen Fall hängen bleiben in der Bevölkerung.“"
                            },
                            {
                                "example_id": "34658bde-8068-4e19-8fc2-465950d42ce8",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "„Wir haben es mit italienischer Mafiakriminalität in Deutschland zu tun. Deutschland ist früher schon Rückzugsraum/Ruheraum gewesen, aber ist jetzt Investitionsraum, ist auch Aktionsraum. Wir haben in Duisburg sechs Morde gehabt vor einigen Jahren.“"
                            },
                            {
                                "example_id": "fc1ee04a-3b38-4063-be3c-1d6dc5a094b4",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "„»Mit militärischen Mitteln versuchen wir, den Aktionsraum des islamischen Staates einzudämmen«, sagte Steinmeier […]“"
                            },
                            {
                                "example_id": "a9e2789a-c899-437f-81ed-6c8ad23a1ddd",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "„Hisbollah – […] Deutschland ist für die Bewegung nach Einschätzung des Verfassungsschutzes kein Aktionsraum, sondern ein Rückzugsort.“"
                            },
                            {
                                "example_id": "405fdab3-656c-483c-b48b-6aa437d30cfa",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "„Der Aktionsraum Schule gewinnt ohnehin immer mehr an Bedeutung in Bezug auf Bewegung und Spielen.“"
                            },
                            {
                                "example_id": "79ea18c3-9ac8-4c3f-9d10-41e50a43d86b",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "[Chile:] „Die Arbeitsgesetze wurden völlig verändert, der Aktionsraum der Gewerkschaften stark beschnitten.“"
                            },
                            {
                                "example_id": "c68f4f97-4275-434b-8d4b-22e05ec9b991",
                                "sense_id": "87377361-3022-3561-a40b-3a27dd070d69",
                                "text": "„Wo Parteien und politische Organisationen gänzlich verboten waren, eröffnete sich ein zunächst ganz unverdächtiger Aktionsraum, auf dem man dennoch politisch handeln konnte, wenn auch nur auf lokaler Ebene.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
