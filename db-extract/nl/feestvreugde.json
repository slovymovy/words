                            {
                                "example_id": "0f8f2bde-29fa-4be4-a4c2-20a3e185b4f7",
                                "sense_id": "9454a97b-85dd-379f-9dc7-cc0e636d4061",
                                "text": "Ook doelman Remko Pasveer deelde in de feestvreugde. De ervaren doelman, die dit seizoen nog niet overtuigde, werd de eerste keeper die drie keer redde op schoten op doel van Haaland in de Champions League."
                            },
                            {
                                "example_id": "9febc3ec-ee20-4c90-a519-f7bf7bf6abcb",
                                "sense_id": "9454a97b-85dd-379f-9dc7-cc0e636d4061",
                                "text": "Een ding lijkt duidelijk: bij Red Bull Racing is de feestvreugde over de wereldtitel van Max Verstappen verdwenen."
                            }
                        ]
                    }
