                "forms": [],
                "senses": [
                    {
                        "sense_id": "e328e5e1-cd27-329e-ab2b-ff18dd29b753",
                        "entry_id": "120d9198-cc05-30cd-b552-23ecee39765f",
                        "glosses": [
