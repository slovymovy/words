{
    "word_family": [
        "inspiration",
        "inspirational",
        "inspirer",
        "inspiringly",
        "uninspired"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05a05c89-22d9-386f-8af9-170b94a2ad1f",
                    "sense_definition": "To fill someone with the urge or ability to do or feel something, especially something creative or positive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "motivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher's passion for history helped <w>inspire</w> her students to study harder.",
                            "target_lang_translations": {
                                "ru": "Страсть учителя к истории помогла <w>вдохновить</w> ее учеников учиться усерднее."
                            }
                        },
                        {
                            "text": "Great leaders often <w>inspire</w> confidence in their followers during difficult times.",
                            "target_lang_translations": {
                                "ru": "Великие лидеры часто <w>внушают</w> доверие своим последователям в трудные времена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inspire confidence",
                        "inspire others"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполнять кого-либо желанием или способностью делать или чувствовать что-либо, особенно что-то творческое или позитивное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдохновлять",
                                "target_lang_sense_clarification": "пробуждать творческий подъем или желание действовать"
                            },
                            {
                                "target_lang_word": "воодушевлять",
                                "target_lang_sense_clarification": "вызывать душевный подъем и энтузиазм"
                            },
                            {
                                "target_lang_word": "вдохнуть",
                                "target_lang_sense_clarification": "вселить надежду или энергию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59e6635e-10d2-3283-b613-2238f910a0ba",
                    "sense_definition": "To give rise to a particular feeling, quality, or reaction in someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motivation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The majestic mountains <w>inspire</w> awe in everyone who visits the national park.",
                            "target_lang_translations": {
                                "ru": "Величественные горы <w>вызывают</w> трепет у каждого, кто посещает национальный парк."
                            }
                        },
                        {
                            "text": "Her courageous actions <w>inspire</w> respect from both her friends and her enemies.",
                            "target_lang_translations": {
                                "ru": "Ее мужественные поступки <w>внушают</w> уважение как друзьям, так и врагам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inspire awe",
                        "inspire respect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать в ком-либо определенное чувство, качество или реакцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внушать",
                                "target_lang_sense_clarification": "вызывать чувства, такие как уважение или доверие"
                            },
                            {
                                "target_lang_word": "вселять",
                                "target_lang_sense_clarification": "порождать чувство уверенности или страха"
                            },
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "быть причиной определенной эмоциональной реакции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ee94086-4c35-3f22-9e61-628a01256a9c",
                    "sense_definition": "To draw air into the lungs; to inhale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked the patient to <w>inspire</w> deeply while he listened to his chest.",
                            "target_lang_translations": {
                                "ru": "Врач попросил пациента глубоко <w>вдохнуть</w>, пока он слушал его грудную клетку."
                            }
                        },
                        {
                            "text": "It is difficult to <w>inspire</w> the air when the smoke is so thick.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>вдыхать</w> воздух, когда дым такой густой."
                            }
                        }
                    ],
                    "antonyms": [
                        "expire"
                    ],
                    "common_phrases": [
                        "inspire deeply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Втягивать воздух в легкие; делать вдох."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вдыхать",
                                "target_lang_sense_clarification": "процесс втягивания воздуха"
                            },
                            {
                                "target_lang_word": "вдохнуть",
                                "target_lang_sense_clarification": "сделать один вдох"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec390e46-771e-3093-ad29-03076f24f6dd",
                    "sense_definition": "To spread a rumor or information indirectly or secretly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to <w>inspire</w> a rumor about his opponent through anonymous sources.",
                            "target_lang_translations": {
                                "ru": "Политик пытался <w>инспирировать</w> слух о своем оппоненте через анонимные источники."
                            }
                        },
                        {
                            "text": "They managed to <w>inspire</w> a story in the press to distract the public.",
                            "target_lang_translations": {
                                "ru": "Им удалось <w>вбросить</w> историю в прессу, чтобы отвлечь общественность."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Косвенно или тайно распространять слухи или информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внушать",
                                "target_lang_sense_clarification": "исподволь навязывать определенную мысль"
                            },
                            {
                                "target_lang_word": "инспирировать",
                                "target_lang_sense_clarification": "тайно подстрекать или давать толчок к распространению чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}