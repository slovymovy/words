                },
                {
                    "sense_id": "0c371cd7-b4ae-35c6-87b3-664d776acf63",
                    "sense_definition": "Any cyprinid fish belonging to the genus Rutilus, or similar related species.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local river provides a favorable habitat for several species of wild <w>roach</w>.",
                            "target_lang_translations": {
                                "ru": "Местная река представляет собой благоприятную среду обитания для нескольких видов дикой <w>плотвы</w>."
