                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fd4c8ab-359b-4284-82cd-cdce3ae1eb42",
                                "sense_id": "f5650bd6-ac88-3760-8751-608bf02646ac",
                                "text": "Frau Heckelmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "698b7053-3875-4e3d-bc58-e35cf3294ba2",
                                "sense_id": "f5650bd6-ac88-3760-8751-608bf02646ac",
                                "text": "Herr Heckelmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0f43523d-527e-40b0-aa40-b80b2317032a",
                                "sense_id": "f5650bd6-ac88-3760-8751-608bf02646ac",
                                "text": "Die Heckelmanns kommen heute aus dem Westerwald."
                            },
                            {
                                "example_id": "037965c5-cccf-441b-9be5-587b4a116611",
                                "sense_id": "f5650bd6-ac88-3760-8751-608bf02646ac",
                                "text": "Der Heckelmann trägt nie die Schals, die die Heckelmann ihm strickt."
                            },
                            {
                                "example_id": "bfe4960b-777a-45ef-bcb3-d77a63275fe6",
                                "sense_id": "f5650bd6-ac88-3760-8751-608bf02646ac",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heckelmann kommt, geht der Herr Heckelmann.“"
                            },
                            {
                                "example_id": "12e71f9c-f3a2-4c54-8573-8e2e7002ab9f",
                                "sense_id": "f5650bd6-ac88-3760-8751-608bf02646ac",
                                "text": "Heckelmann kommt und geht."
                            },
                            {
                                "example_id": "3996c43a-ecaf-4863-854e-995634a40796",
                                "sense_id": "f5650bd6-ac88-3760-8751-608bf02646ac",
                                "text": "Heckelmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
