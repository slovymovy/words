                        "examples": [
                            {
                                "example_id": "5c7b0941-ac79-408e-a0ac-73b54532e897",
                                "sense_id": "fe80597b-a5ee-3b76-93d7-d461309c623f",
                                "text": "Er zijn zeker mensen die zich met retoriek bezighouden."
                            },
                            {
                                "example_id": "5e3bc46e-4d93-4b42-845f-6be8bc166c9c",
                                "sense_id": "fe80597b-a5ee-3b76-93d7-d461309c623f",
                                "text": "Natuur- en milieuliefhebbers hebben dit soort retoriek nooit helemaal achter zich gelaten. Recentelijk spraken bijvoorbeeld de Britse tv-persoonlijkheid David Attenborough en chimpansee-onderzoeker Jane Goodall zich nog uit tegen bevolkingsgroei. Ze waarschuwen tegenwoordig vooral voor de effecten ervan op klimaatverandering."
                            }
                        ]
                    }
