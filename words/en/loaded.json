                },
                {
                    "sense_id": "780c9e03-3ed0-3e78-a12d-287f5a7609ae",
                    "sense_definition": "Carrying strong emotional implications or hidden meanings beyond the literal definition.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "biased",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Freedom\" can be a <w>loaded</w> word depending on the political context.",
                            "target_lang_translations": {
                                "ru": "«Свобода» может быть <w>многозначительным</w> словом в зависимости от политического контекста.",
                                "zh": "根据政治背景，“自由”可能是一个<w>意味深长</w>的词。"
                            }
                        },
                        {
                            "text": "Her silence was a <w>loaded</w> response that communicated more than words could.",
                            "target_lang_translations": {
                                "ru": "Её молчание было <w>многозначительным</w> ответом, который сообщал больше, чем могли бы слова.",
                                "zh": "她的沉默是一种<w>意味深长</w>的回应，传达出的信息比言语更多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "charged",
                        "pregnant"
                    ],
                    "antonyms": [
                        "neutral"
                    ],
                    "common_phrases": [
                        "loaded word",
                        "loaded term",
                        "loaded phrase"
