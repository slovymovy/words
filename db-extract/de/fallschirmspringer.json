                "senses": [
                    {
                        "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                        "entry_id": "2da32624-d635-3a69-80ea-739b187708d9",
                        "glosses": [
                            "eine Person, die unter Benutzung eines Fallschirms aus einem Luftfahrzeug abspringt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dabb71ee-2175-4b93-8199-8ab1ecac62fe",
                                "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                                "text": "„‚Man hat einfach keine Zeit, Angst zu haben‘, sagte mir ein Fallschirmspringer.“"
                            },
                            {
                                "example_id": "2c08408e-fc66-486a-b231-3c0d9eeeea0c",
                                "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                                "text": "„Ende des Monats waren laut diesen Quellen 3000 französische Fallschirmspringer im Lande stationiert.“"
                            },
                            {
                                "example_id": "e35e0025-a621-4a78-b398-d6c39ef21ba3",
                                "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                                "text": "„Danach wollte Volker Fallschirmspringer werden.“"
                            },
                            {
                                "example_id": "cd518342-b760-4550-9197-0f4748fbaab7",
                                "sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                                "text": "„Es gab etwa dreißig solche Partisanengruppen; mehr als die Hälfte war von sowjetischen Fallschirmspringern aufgebaut worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77e7c179-2df0-426b-9306-9f71f9e3342c",
                        "source_entry_id": "2da32624-d635-3a69-80ea-739b187708d9",
                        "source_sense_id": "0f857c1a-17f6-3ad2-b862-582dc2b00213",
                        "source_sense_description": "Person, die unter Benutzung eines Fallschirms aus großen Höhen abspringt",
                        "target_lang_word": "parachutist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parachutist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3445f3c-d081-3668-885b-271a8dacd4fb",
                                        "entry_id": "62a4667d-3299-3f30-b45f-3dc006656c52",
                                        "glosses": [
                                            "Someone who jumps from an aircraft using a parachute, especially as a sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2452500e-908e-4ecc-90ea-ef33d9707641",
                                                "sense_id": "d3445f3c-d081-3668-885b-271a8dacd4fb",
                                                "text": "If any of the extreme sports can be considered truly high risk, then B.A.S.E. Jumping is that sport. […] Modern B.A.S.E. jumping is believed to have started in 1978, where daring parachutists first began jumping off of El Capitan, a 3,000 foot (915m) cliff high above Yosemite National Park."
                                            },
                                            {
                                                "example_id": "f21d26b2-a14d-4d95-ba85-c55c37b6d090",
                                                "sense_id": "d3445f3c-d081-3668-885b-271a8dacd4fb",
                                                "text": "I waited and he came to the point: he wanted me simply to talk to a patient he had inherited, a sports parachutist who had Roman Candled into a tree and broken and disarticulated his back."
                                            },
                                            {
                                                "example_id": "ff9130b4-d3b8-421c-9dab-15533634d195",
                                                "sense_id": "d3445f3c-d081-3668-885b-271a8dacd4fb",
                                                "text": "Some hit the rocky outcrops\n Some fell into the sea\n Some even 'Roman Candled'\n (A parachutist I would never be)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39f0d5f7-96ef-4486-906f-911abee8e65e",
                        "source_entry_id": "2da32624-d635-3a69-80ea-739b187708d9",
