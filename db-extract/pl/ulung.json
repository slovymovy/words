                    }
                ],
                "translations": [
                    {
                        "translation_id": "da7f066f-d2a2-4c51-bc97-51b2382a05f7",
                        "source_entry_id": "01ad163a-b79c-3d6f-96f1-07c4c1999f47",
                        "source_sense_id": "aba36cd3-dd02-3833-a777-5fe9893dd28e",
                        "target_lang_word": "oolong",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oolong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d01d448-1d11-3010-9961-e8d30dd67a6e",
                                        "entry_id": "b4550c91-6229-3eda-a151-62bc6178d560",
                                        "glosses": [
                                            "A partially fermented tea, often roasted, which combines the characteristics of green tea and black tea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a99abca-948d-4805-ba05-e3069f07b319",
                                                "sense_id": "6d01d448-1d11-3010-9961-e8d30dd67a6e",
                                                "text": "Flavour and aroma of semi-fermented teas is dictated by the extent of fermentation and, for this reason, oolong has a considerably stronger flavour than pouchong, which undergoes a significantly shorter fermentation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cb47a47-cf40-4d7f-a0d8-54103aa82bac",
                        "source_entry_id": "01ad163a-b79c-3d6f-96f1-07c4c1999f47",
                        "source_sense_id": "aba36cd3-dd02-3833-a777-5fe9893dd28e",
                        "target_lang_word": "乌龙",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
