                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472583d9-55cb-4cca-9e9c-7f1bb298ff3d",
                                "sense_id": "2d7d75f8-bd85-38d5-a1ad-8ecb79fb7492",
                                "text": "Słychać było jedynie brzęczenie much."
                            }
