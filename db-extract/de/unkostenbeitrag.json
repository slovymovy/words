                "senses": [
                    {
                        "sense_id": "6973316a-09e9-3f0f-93fd-0d996f9b0ebf",
                        "entry_id": "ca543d1d-9df9-3ff8-8746-5feff256b41a",
                        "glosses": [
                            "Kostenbeitrag; Entgelt zur (teilweisen) Abdeckung der Kosten für eine ohne Gewinnabsicht erbrachte Leistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e688ed-5493-47df-a0ba-4a4b0e89ce30",
                                "sense_id": "6973316a-09e9-3f0f-93fd-0d996f9b0ebf",
                                "text": "Die Teilnehmer dieser Tagung müssen einen kleinen Unkostenbeitrag entrichten."
                            },
                            {
                                "example_id": "f0ff1ecb-d1b1-4456-b897-3baf958f21c4",
                                "sense_id": "6973316a-09e9-3f0f-93fd-0d996f9b0ebf",
                                "text": "„Man zahlt bei jeder Teilnahme einen Unkostenbeitrag in Höhe von einigen Hundert Dollar und erklärt sich ferner einverstanden, der Stiftung fünf Prozent des persönlichen Vermögens zu hinterlassen.“"
                            },
                            {
                                "example_id": "d795a91e-d52c-4639-8216-d293680902b8",
                                "sense_id": "6973316a-09e9-3f0f-93fd-0d996f9b0ebf",
                                "text": "„Im Anschluss kassierte er den Unkostenbeitrag in Höhe von vierzig Euro von jedem und dann nahmen wir alle schon ganz gespannt in dem Kleinbus Platz.“"
                            },
                            {
                                "example_id": "06b4b2e9-576d-4d07-9ded-903e2e8780c8",
                                "sense_id": "6973316a-09e9-3f0f-93fd-0d996f9b0ebf",
                                "text": "„Das Angebot reicht von Kultur, Workshops, Gruppenaktivitäten und vielem mehr, meist kostenlos oder gegen einen kleinen Unkostenbeitrag.“"
                            },
                            {
                                "example_id": "8b0ed78f-87d4-48a3-82a2-287d3ab95e27",
                                "sense_id": "6973316a-09e9-3f0f-93fd-0d996f9b0ebf",
                                "text": "„Für einen kleinen Unkostenbeitrag würde ich Ihnen auch noch eine zweite Kassette zukommen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
