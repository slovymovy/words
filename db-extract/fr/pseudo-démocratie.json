                    {
                        "sense_id": "b5940ac1-1409-3d47-9616-d58dd14ef67f",
                        "entry_id": "a0c4eff5-ffa4-3ff3-be7d-de82f27e7ed5",
                        "glosses": [
                            "Régime politique qui se prétend une démocratie mais n’en est pas vraiment une."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf451238-5a93-461c-a862-691e21c1a83a",
                                "sense_id": "b5940ac1-1409-3d47-9616-d58dd14ef67f",
                                "text": "En Uruguay, la dictature sortante va, elle aussi, tenter de mettre en place une pseudo-démocratie sous tutelle."
                            },
                            {
                                "example_id": "0c0218ae-4489-4a48-bdb9-abcd146417e6",
                                "sense_id": "b5940ac1-1409-3d47-9616-d58dd14ef67f",
                                "text": "Tout pays dans lequel le contrôle des dépenses ne dépend pas exclusivement du parlement est donc une pseudo-démocratie."
                            },
                            {
                                "example_id": "8433d945-4589-4397-8000-261d9b364bed",
                                "sense_id": "b5940ac1-1409-3d47-9616-d58dd14ef67f",
                                "text": "Le système politique du Liban est une drôle de démocratie. C'est un pays confessionnel, une démocratie dite associative, autrement dit une pseudo-démocratie."
                            }
                        ]
                    }
