{
    "word_family": [
        "severe",
        "severely"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e1152268-6915-32ce-9fd2-aea1b963ce0b",
                    "sense_definition": "The quality of being strict, harsh, or unyielding in manner or treatment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>severity</w> of the judge's tone made the courtroom go completely silent.",
                            "target_lang_translations": {
                                "zh": "法官语气的<w>严厉</w>让法庭变得鸦雀无声。"
                            }
                        },
                        {
                            "text": "He treated his students with a <w>severity</w> that made them fear his classes.",
                            "target_lang_translations": {
                                "zh": "他对待学生的那种<w>严厉</w>让他们对他的课感到恐惧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "severeness"
                    ],
                    "common_phrases": [
                        "judge with severity"
                    ],
                    "target_lang_definitions": {
                        "zh": "指态度或对待方式上的严厉、苛刻或不妥协。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "严厉",
                                "target_lang_sense_clarification": "指在言行或管教上非常严格。"
                            },
                            {
                                "target_lang_word": "苛刻",
                                "target_lang_sense_clarification": "指要求过高，不近人情。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b8e2cae-ee51-3b72-8b45-8f7b945c157a",
                    "sense_definition": "The degree of intensity, seriousness, or badness of an undesirable situation or condition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>severity</w> of the storm caused significant damage to the coastal town.",
                            "target_lang_translations": {
                                "zh": "这场风暴的<w>严重性</w>给沿海城镇造成了重大破坏。"
                            }
                        },
                        {
                            "text": "Doctors were concerned about the <w>severity</w> of the injury after the accident.",
                            "target_lang_translations": {
                                "zh": "事故发生后，医生们对伤势的<w>严重性</w>感到担忧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "severity of injury",
                        "severity of damage"
                    ],
                    "target_lang_definitions": {
                        "zh": "指不良情况或状况的强度、严重程度或恶劣程度。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "严重性",
                                "target_lang_sense_clarification": "指事态或后果的严重程度。"
                            },
                            {
                                "target_lang_word": "剧烈程度",
                                "target_lang_sense_clarification": "指某种现象或状况的强烈程度。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}