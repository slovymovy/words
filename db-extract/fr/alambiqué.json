                                    {
                                        "sense_id": "93a64684-b65d-3b2c-9e26-463fe4971cd4",
                                        "entry_id": "9318ac27-609e-3a00-827c-10c9a29d45cb",
                                        "glosses": [
                                            "overdrachtelijk: onduidelijk, moeilijk te doorgronden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
