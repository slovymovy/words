                        "entry_id": "2f03d724-8f0a-3d45-a0eb-cfc36551a875",
                        "glosses": [
                            "Action de poser un graffiti à l'aide d'une bombe de peinture en aérosol."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d83833d4-f945-4c61-86d2-920a953a21d5",
                                "sense_id": "b605622f-1329-3e83-9b12-34689d4b1df3",
                                "text": "On étudie ici l'usage d'un support particulier pour les bombages : le panneau de signalisation routière. Dès que se diffuse le graffiti bombé en Corse au début des années 1970, ils est la cible des bombeurs."
                            },
                            {
                                "example_id": "9ca3ef7c-3df8-42a5-85be-2f8984214b4d",
                                "sense_id": "b605622f-1329-3e83-9b12-34689d4b1df3",
                                "text": "Le détournement d’affiche par les militants adverses, le plus souvent par graffiti ou bombage, constitue une pratique aussi ancienne que l’affiche politique elle-même."
                            }
                        ]
                    }
