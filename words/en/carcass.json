                            {
                                "target_lang_word": "trup",
                                "target_lang_sense_clarification": "ciało zmarłego człowieka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e164f90-46b7-3767-9e6c-c62f626607be",
                    "sense_definition": "The body of a slaughtered animal prepared for food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dead_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butcher hung the beef <w>carcass</w> in the cold storage room.",
                            "target_lang_translations": {
                                "pl": "Rzeźnik powiesił <w>tuszę</w> wołową w chłodni."
                            }
                        },
                        {
                            "text": "Inspectors checked the <w>carcass</w> for quality before processing.",
                            "target_lang_translations": {
                                "pl": "Inspektorzy sprawdzili jakość <w>tuszy</w> przed przetworzeniem."
