                        "round scad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая из нескольких морских рыб семейства ставридовых, обычно встречающихся в западной части Атлантического океана."
                    },
                    "translations": {
                        "ru": [
                            {
