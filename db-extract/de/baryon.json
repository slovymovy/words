                        "entry_id": "c26cba91-d7a2-3e1b-8865-07eeb30f5591",
                        "glosses": [
                            "Teilchen, das aus drei Quarks besteht"
                        ],
                        "tags": [
                            "physics",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "335153d7-bf2a-4172-a3a9-2a937ebf7497",
                                "sense_id": "f2b07a87-c796-3a41-87ee-47f1a033b4c7",
                                "text": "Im Universum gibt es mehr Baryonen als Antibaryonen (Baryonenasymmetrie)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7096ccf5-15d9-45d1-a802-acb8881399d2",
                        "source_entry_id": "c26cba91-d7a2-3e1b-8865-07eeb30f5591",
                        "source_sense_id": "f2b07a87-c796-3a41-87ee-47f1a033b4c7",
                        "source_sense_description": "Teilchen, das aus drei Quarks besteht",
                        "target_lang_word": "baryon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baryon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66261233-7869-30b8-bccc-b743a4ce37b9",
                                        "entry_id": "5f9f3cea-190d-300e-b4dd-66b057244c04",
                                        "glosses": [
                                            "A heavy subatomic particle created by the binding of quarks by gluons; a hadron containing three quarks. Baryons have half-odd integral spin and are thus fermions. This category includes the common proton and neutron of the atomic nucleus."
                                        ],
                                        "tags": [
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54869bc-50f3-478f-815a-47f54edcc5ba",
                                                "sense_id": "66261233-7869-30b8-bccc-b743a4ce37b9",
                                                "text": "Without prejudging on the actual nature of the relationship between the V₁ and the nucleon it seems practical to have a collective name for these particles and other which possibly may still be discovered and which may also have to be taken along in the conservation principle just mentioned. It is proposed to use the fitting name \"baryon\" for this purpose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
