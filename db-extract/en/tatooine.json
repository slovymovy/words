        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ef54a739-d2e4-37f4-bb9b-9fd2e561ce39",
                "word": "Tatooine",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "69665780-12f9-3df0-b050-02aee4ed3c04",
                        "entry_id": "ef54a739-d2e4-37f4-bb9b-9fd2e561ce39",
                        "glosses": [
                            "A fictional desert planet in Star Wars."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3ef1b49-cf68-404b-9ed6-f4ecc519ac52",
                                "sense_id": "69665780-12f9-3df0-b050-02aee4ed3c04",
                                "text": "Planets that orbit two stars are called \"circumbinary planets.\" They're also sometimes called \"Tatooine planets,\" after the most well-known example."
                            },
                            {
                                "example_id": "71cff458-61d9-4c76-b381-68adc64f6f91",
                                "sense_id": "69665780-12f9-3df0-b050-02aee4ed3c04",
                                "text": "Glass surrounds the cabin to provide unrivaled views of the environment, whether it’s an earthly vista or the binary sunset over the fictional Tatooine desert."
                            },
                            {
                                "example_id": "8d20af1b-8760-4a16-9b27-2d5d50e07531",
                                "sense_id": "69665780-12f9-3df0-b050-02aee4ed3c04",
                                "text": "Because the majority of stars are thought to be locked in such binary systems, learning about their early lives — especially how they form and maintain Tatooine-type planets — is of great interest to astronomers."
                            },
                            {
                                "example_id": "ff4c9d15-0296-4954-922e-bf476849f61c",
                                "sense_id": "69665780-12f9-3df0-b050-02aee4ed3c04",
                                "text": "Moisture farming is not just for the deserts of Tatooine — advances in fog harvesting technology may provide an additional fresh water source in foggy coastal areas with little precipitation."
                            },
                            {
                                "example_id": "6ef7ad80-6143-4d4e-91bb-3a79e6a9f31b",
                                "sense_id": "69665780-12f9-3df0-b050-02aee4ed3c04",
                                "text": "The more interesting case is circumbinary planets (CBPs), popularly known as Tatooine-like worlds, where the stars are so close together that a planet would need to orbit both to be at a safe distance."
                            },
                            {
                                "example_id": "00b29b9c-acf1-42e0-abcd-7f7f9ba954e7",
                                "sense_id": "69665780-12f9-3df0-b050-02aee4ed3c04",
                                "text": "From the ground it could almost look like two suns in the sky, creating a Tatooine effect."
                            }
                        ]
                    }
                ],
