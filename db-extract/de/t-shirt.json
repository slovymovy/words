                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5044412d-5dcb-36b2-96ab-aa83124f2ce9",
                                        "entry_id": "edc01f21-fb7d-317b-a89f-b655c1d7665e",
                                        "glosses": [
                                            "A lightweight shirt without buttons, usually with short sleeves and no collar. Often made of cotton and frequently bears a picture or slogan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fafc93c-b035-4dca-81f5-40fc443fe25d",
                                                "sense_id": "5044412d-5dcb-36b2-96ab-aa83124f2ce9",
                                                "text": "Many bands make more money from T-shirt sales than from sale of tickets."
                                            },
                                            {
                                                "example_id": "8f0bef98-0927-42ed-a596-5a0a9e700ad1",
                                                "sense_id": "5044412d-5dcb-36b2-96ab-aa83124f2ce9",
                                                "text": "Think of banking today and the image is of grey-suited men in towering skyscrapers. Its future, however, is being shaped in converted warehouses and funky offices in San Francisco, New York and London, where bright young things in jeans and T-shirts huddle around laptops, sipping lattes or munching on free food."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4139c43-43ed-3f9f-8d97-4385197bdfd6",
                                        "entry_id": "edc01f21-fb7d-317b-a89f-b655c1d7665e",
                                        "glosses": [
                                            "An undershirt."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3aa361ca-ca68-4fd6-a24e-e5a04f8300a2",
                        "source_entry_id": "82122d76-05f8-32e3-8deb-026dd6a03d4f",
                        "source_sense_id": "6bed945e-3cb4-373d-a853-864b38c867c8",
                        "source_sense_description": "dünne Bekleidung für den Oberkörper mit kurzen Ärmeln ohne Knöpfe",
                        "target_lang_word": "t-shirt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "t-shirt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f186ad4-37d3-3e20-a68a-1e560256cc29",
                                        "entry_id": "b2dd9700-3f89-3c5f-bb69-83d4ea113cc1",
                                        "glosses": [
                                            "Maillot de corps avec des manches courtes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef80fc98-d300-4af0-aec8-72e32e8dffb6",
                                                "sense_id": "8f186ad4-37d3-3e20-a68a-1e560256cc29",
                                                "text": "Epuisé de ma journée, je décide de ne pas m’habiller, de ne pas me raser, de ne même pas me coiffer, et ce sont, je crois, les signes avant-coureurs de la dépression, j’enfile donc un jean troué, un t-shirt noir au hasard dont je ne suis même pas sûr qu’il m’appartienne, d’horribles baskets et la grosse croix en diamants de ma mère, que je porte chaque fois que je suis déprimé, donc tous les jours."
                                            },
                                            {
                                                "example_id": "67207462-cf06-4a68-9463-069165909d3f",
                                                "sense_id": "8f186ad4-37d3-3e20-a68a-1e560256cc29",
                                                "text": "Un ami est venu vous voir pendant que vous dormiez. Il m'a dit qu'il vous a apporté des jeans, des cotons ouatés, des t-shirts, un imperméable, des livres et plein d'autres choses."
                                            },
                                            {
                                                "example_id": "b1231387-5a92-4c5f-92be-e32ff51210c1",
                                                "sense_id": "8f186ad4-37d3-3e20-a68a-1e560256cc29",
                                                "text": "En compensation de leur temps donné, ces indispensables personnes reçoivent un t-shirt et une casquette souvenir et sont bien entendu nourries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
