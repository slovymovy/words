                            {
                                "example_id": "ba8e6170-c75f-4be6-85cc-b79bb0d3fc41",
                                "sense_id": "10a10ef5-355e-3f0c-9063-96c1f321c0fc",
                                "text": "Bijna elke snelle tegenstoot van Willem II leidde tot een grote doelkans. Bij de 1-0 na zeven minuten was Nunnely weggelopen uit de rug van Michal Sadílek, een kwartier later schoot hij in kansrijke positie maar net voorlangs. Bij zijn derde grote kans was de buitenspeler Daniel Schwaab veel te snel af, om na rust tegenover een weifelende Nick Viergever na ruim een uur spelen de 2-0 te maken."
                            },
                            {
                                "example_id": "f97e9f40-748d-4f8f-8fba-1c884a37ff6b",
                                "sense_id": "10a10ef5-355e-3f0c-9063-96c1f321c0fc",
                                "text": "Twente heeft een sterke fase achter de rug, maar opeens is daar VVV met een gevaarlijke tegenstoot."
                            }
                        ]
                    },
