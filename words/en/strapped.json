    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c99f07d2-0de1-3a7d-98f9-665b74959f94",
                    "sense_definition": "Short of money; broke or impoverished.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financial_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families are too <w>strapped</w> to afford a summer vacation this year.",
                            "target_lang_translations": {
                                "ru": "Многие семьи слишком <w>стеснены в средствах</w>, чтобы позволить себе летний отпуск в этом году.",
                                "it": "Molte famiglie sono troppo <w>al verde</w> per permettersi una vacanza estiva quest'anno."
                            }
                        },
                        {
                            "text": "I would love to go out for dinner, but I am currently <w>strapped</w> for cash.",
                            "target_lang_translations": {
                                "ru": "Я бы с удовольствием сходил поужинать, но сейчас я <w>на мели</w>.",
                                "it": "Mi piacerebbe uscire a cena, ma al momento sono <w>a corto</w> di soldi."
                            }
                        }
                    ],
                    "synonyms": [
                        "cash-strapped",
                        "strapped for cash",
                        "impoverished"
                    ],
                    "antonyms": [
                        "wealthy",
                        "rich"
                    ],
                    "common_phrases": [
                        "strapped for cash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal spoken English to describe being short of money."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий нехватку денег; на мели или обедневший.",
                        "it": "A corto di denaro; al verde o in difficoltà economiche."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на мели",
                                "target_lang_sense_clarification": "без денег"
                            },
                            {
                                "target_lang_word": "стесненный в средствах",
                                "target_lang_sense_clarification": "имеющий финансовые трудности"
                            },
                            {
                                "target_lang_word": "без гроша",
                                "target_lang_sense_clarification": "разговорное, без денег"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "al verde",
                                "target_lang_sense_clarification": "senza soldi, colloquiale"
                            },
                            {
                                "target_lang_word": "in ristrettezze economiche",
                                "target_lang_sense_clarification": "che ha difficoltà finanziarie"
                            },
                            {
                                "target_lang_word": "senza un soldo",
                                "target_lang_sense_clarification": "molto povero"
                            }
                        ]
                    }
                },
                {
