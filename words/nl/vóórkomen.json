                },
                {
                    "sense_id": "aef41f20-620d-33ce-a640-68e8d1ee6141",
                    "sense_definition": "voor een rechter of rechtbank moeten verschijnen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verdachte moet morgen voor de politierechter <w>vóórkomen</w>.",
                            "target_lang_translations": {
                                "en": "The suspect must <w>appear</w> before the police judge tomorrow.",
                                "ru": "Подозреваемый должен завтра <w>предстать</w> перед полицейским судьей."
                            }
                        },
                        {
                            "text": "Er is een gezegde dat luidt: voorkómen is beter dan <w>vóórkomen</w>.",
                            "target_lang_translations": {
                                "en": "There is a saying that goes: prevention is better than <w>standing trial</w>.",
                                "ru": "Есть поговорка: лучше предотвратить, чем потом <w>предстать</w> перед судом."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschijnen"
                    ],
                    "common_phrases": [
                        "voor de rechter vóórkomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to appear before a judge or in a court of law",
                        "ru": "предстать перед судьей или судом"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appear",
                                "target_lang_sense_clarification": "to come before a court or authority"
                            },
                            {
                                "target_lang_word": "stand trial",
                                "target_lang_sense_clarification": "to be tried in a court of law"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "предстать",
                                "target_lang_sense_clarification": "перед судом"
                            },
                            {
                                "target_lang_word": "явиться",
                                "target_lang_sense_clarification": "в суд"
                            }
                        ]
                    }
                }
            ]
        },
        {
