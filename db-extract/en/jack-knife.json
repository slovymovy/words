                        "entry_id": "d48046e5-a52d-3817-8962-c276c11245ec",
                        "glosses": [
                            "To fold in the middle, as a jackknife does."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97b27250-e610-4093-b082-50050899351f",
                                "sense_id": "8636ced2-9a41-39ec-8305-557679329df6",
                                "text": "The cat jackknifed in the air and landed gracefully on its feet."
                            },
                            {
                                "example_id": "473e5c23-f0c0-4722-892c-1c011be97099",
                                "sense_id": "8636ced2-9a41-39ec-8305-557679329df6",
                                "text": "There was a world inside that tall grass. You could plop yourself down in the middle of it with the scraggly stems against the back of your neck and the endless grasses rising up and jackknifing against the bigbluesky, and the ranch and all of its players would fade into a distant dream."
                            }
                        ]
                    },
                    {
                        "sense_id": "9130adf6-ebaa-3fa3-beea-8336b3641501",
                        "entry_id": "d48046e5-a52d-3817-8962-c276c11245ec",
                        "glosses": [
                            "To cause a semi-trailer truck to fold like a jackknife in a traffic accident."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cd19f662-18c2-416c-96bc-de677c6211d3",
                                "sense_id": "9130adf6-ebaa-3fa3-beea-8336b3641501",
                                "text": "Before I knew what was happening, I'd jack-knifed the truck."
                            },
                            {
                                "example_id": "5ca8602d-0195-46f6-8800-3206323cba95",
                                "sense_id": "9130adf6-ebaa-3fa3-beea-8336b3641501",
                                "text": "Before I knew what was happening, I'd jack-knifed."
                            }
                        ]
                    }
