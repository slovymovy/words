                                "target_senses": [
                                    {
                                        "sense_id": "d3450893-fc75-39d5-8eac-9bef14f17d65",
                                        "entry_id": "0a960a3f-0871-3eae-bd2a-eee335ebdc06",
                                        "glosses": [
                                            "Caractère expressif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7136ef77-ca12-4a77-8158-ecc7c4517920",
                                                "sense_id": "d3450893-fc75-39d5-8eac-9bef14f17d65",
                                                "text": "Sa façon de jouer, ses notes filées sont d’une expressivité chargée d’émotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01422ef5-80bb-3b9a-9343-f75830ab9afa",
                                        "entry_id": "0a960a3f-0871-3eae-bd2a-eee335ebdc06",
                                        "glosses": [
                                            "Capacité d’un gène ou d’un génotype à exprimer différents phénotypes en fonction de son environnement."
                                        ],
                                        "tags": [
                                            "Génétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c360f71-dcac-4234-ad74-845a1697cb27",
                                                "sense_id": "01422ef5-80bb-3b9a-9343-f75830ab9afa",
                                                "text": "Ils pensent que cette sénescence favorise l’expressivité de certains gènes léthaux ou subléthaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
