                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "переживать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "097f6bef-4c4a-305d-b649-cec8bbc0d6c5",
                                        "entry_id": "dbc6d740-a90a-322c-bbe0-4d4d69541f2c",
                                        "glosses": [
                                            "продолжать жить на протяжении определённого, как правило, тяжёлого, трудного периода времени, и после него"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efce6624-2d13-46be-8061-965f23e40454",
                                                "sense_id": "097f6bef-4c4a-305d-b649-cec8bbc0d6c5",
                                                "text": "Воины - это люди, которые позволяют человечеству переживать самые тяжёлые времена."
                                            },
                                            {
                                                "example_id": "92a71626-f163-41ed-81d5-f89cb619e548",
                                                "sense_id": "097f6bef-4c4a-305d-b649-cec8bbc0d6c5",
                                                "text": "Компания успешно переживает кризис."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6170752-4b9e-3af9-8464-ca59da490f54",
                                        "entry_id": "dbc6d740-a90a-322c-bbe0-4d4d69541f2c",
                                        "glosses": [
                                            "испытывать волнение, беспокойство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d35ea948-4fdf-4b02-80c2-aadaeae63f5f",
                                                "sense_id": "a6170752-4b9e-3af9-8464-ca59da490f54",
                                                "text": "Мне больно смотреть, как она переживает."
                                            },
                                            {
                                                "example_id": "40adebbb-2283-4f4d-9814-43501933073b",
                                                "sense_id": "a6170752-4b9e-3af9-8464-ca59da490f54",
                                                "text": "В спорте нельзя слишком сильно переживать — иначе ничего не добьешься."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95a447d3-7cb2-346f-90cf-26b056c7ab61",
                                        "entry_id": "dbc6d740-a90a-322c-bbe0-4d4d69541f2c",
                                        "glosses": [
                                            "детально вспоминать прожитое"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e9fec4-a318-49a3-a837-bc73c11694aa",
                                                "sense_id": "95a447d3-7cb2-346f-90cf-26b056c7ab61",
                                                "text": "Все пережитые эмоции возникали передо мной, почти обретая призрачную плоть, терзали душу, заставляли вновь и вновь переживать самые страшные моменты в моей жизни."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
