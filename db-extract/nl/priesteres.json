                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d0e72d3-643c-4a3f-b9f9-d200a258244e",
                        "source_entry_id": "e2beb421-3f84-365c-95b3-b49d5191d7f1",
                        "source_sense_id": "93fdb210-ec73-3964-8467-9d261dbcf0d4",
                        "source_sense_description": "een vrouw die de taak heeft religieuze rituelen te verzorgen",
                        "target_lang_word": "Priesterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Priesterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b918203-b507-3e4d-b12b-35e1368ddf8f",
                                        "entry_id": "2ecdb111-8b73-3569-9190-79d717ea5aec",
                                        "glosses": [
                                            "weiblicher Priester"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "239fd0fb-f911-4318-84dd-342fe9c507e6",
                                                "sense_id": "2b918203-b507-3e4d-b12b-35e1368ddf8f",
                                                "text": "In der römisch-katholischen Kirche ist das Priestertum Männern vorbehalten, es gibt also keine Priesterinnen."
                                            },
                                            {
                                                "example_id": "4c3bc92e-df62-4736-a504-bed5b67bfd27",
                                                "sense_id": "2b918203-b507-3e4d-b12b-35e1368ddf8f",
                                                "text": "„Seit 1996 können auch Frauen in der altkatholischen Kirche zu Priesterinnen geweiht werden.“"
                                            },
                                            {
                                                "example_id": "b1848419-8610-45d3-9696-f4bc0af14d0b",
                                                "sense_id": "2b918203-b507-3e4d-b12b-35e1368ddf8f",
                                                "text": "„Darauf, Priesterin der Kunst zu sein, hat sie verzichtet und hat die magische Welt der Harmonien verlassen, um in jene der Haushaltssorgen und Apfelmarmeladen überzutreten.“"
                                            },
                                            {
                                                "example_id": "97b73766-e6bc-4236-8d1f-d5149c184322",
                                                "sense_id": "2b918203-b507-3e4d-b12b-35e1368ddf8f",
                                                "text": "„Man gab eine Tragödie, in der eine hübsche Schauspielerin die stumme Rolle einer Priesterin zu spielen hatte.“"
                                            },
                                            {
                                                "example_id": "ac4c03e1-08e0-429a-a373-04a4825e9281",
                                                "sense_id": "2b918203-b507-3e4d-b12b-35e1368ddf8f",
                                                "text": "„Er erwartet Priesterinnen der Lust, Bacchantinnen und dämonische Raubtiere, und ist nicht ganz sicher, ob er nicht mit herausgerissener Leber oder zumindest ohne Hoden in Eduards Opel zurücktransportiert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "205bf2ee-33a4-4d6b-9644-cd6b9770fbc0",
                        "source_entry_id": "e2beb421-3f84-365c-95b3-b49d5191d7f1",
                        "source_sense_id": "93fdb210-ec73-3964-8467-9d261dbcf0d4",
                        "source_sense_description": "een vrouw die de taak heeft religieuze rituelen te verzorgen",
                        "target_lang_word": "priestess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "priestess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5c4d262-d2c7-39ce-a312-4808009fb517",
                                        "entry_id": "094fd2df-1fb2-3092-85d0-1e0d7fe4946d",
                                        "glosses": [
                                            "A woman with religious duties and responsibilities in certain religions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b102832-4547-433a-93a2-e3c291e790f3",
                                                "sense_id": "b5c4d262-d2c7-39ce-a312-4808009fb517",
                                                "text": "Sir Knight, said she (whose looks, language, and gesture create strange thoughts within me) be pleased to know, that I am (I will not say the first) of those Ladies of Honour, who wait upon the high-born, illustrious, and refulgent Maulkina, Daughter to the high and mighty Prince Paraclet, Prince of No-Land, on the confines of whose Territories we now are, so it is that the Divine Maulkina having been a vowed Votaress to Diana (whose Priestess she was, and whose Oracles she exhibited) upon a night as she sat at the feet of the Image of that chaste Deity […]"
                                            },
                                            {
                                                "example_id": "f3737fea-28e1-465c-a19c-00076a0d0c67",
                                                "sense_id": "b5c4d262-d2c7-39ce-a312-4808009fb517",
                                                "text": "Among the Northern tribes also the woman was held in all moral aspects the equal of man. Alike the blue-eyed wife of the Barbarian and the proud Roman matron were, as the bearers and breeders of the race, the equals of the fighters and rulers of the race. The importance of their functions was fully recognized and respected, and the priestess at the sylvan altar, the vestals serving the fires and the temples at Rome were held worthy to speak face to face with the gods and convey their blessings to man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e145383-7576-3a28-a806-b7ac281cb4c1",
                                        "entry_id": "094fd2df-1fb2-3092-85d0-1e0d7fe4946d",
                                        "glosses": [
                                            "A female Christian priest or minister, typically in a Protestant, Old Catholic, or independent Catholic denomination."
                                        ],
                                        "tags": [
                                            "slur",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31634d6b-5d45-4d6c-8c83-f8f4c0610a3c",
                                                "sense_id": "5e145383-7576-3a28-a806-b7ac281cb4c1",
                                                "text": "The “extenuating circumstances” set forth by the Rev. Mr. Higgins certainly bring home not only the nature of Bishop Hall's problem but its cause; however, the problems of parish life under a deaconess are insignificant in comparison with the very grave issues raised by the ordination of a priestess."
                                            },
                                            {
                                                "example_id": "1df2379b-c6a6-40a5-8b65-757730d07ea7",
                                                "sense_id": "5e145383-7576-3a28-a806-b7ac281cb4c1",
                                                "text": "He has cleverly figured out that the deluded pro-priestess faction of the church already has its necessary two-thirds majority and that the time to act is now."
                                            },
                                            {
                                                "example_id": "4181242f-6337-44d2-b6c1-8ea28845ed67",
                                                "sense_id": "5e145383-7576-3a28-a806-b7ac281cb4c1",
                                                "text": "THE Church of England is considering taking legal action against a recalcitrant opponent of women priests in Hull who refuses to take down a church sign which says: \"This Anglican parish has no part in the apostasy of priestesses.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7cd9560-8cd3-365e-8888-91d311125978",
                                        "entry_id": "094fd2df-1fb2-3092-85d0-1e0d7fe4946d",
                                        "glosses": [
                                            "A priest’s wife."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "490e7839-a340-4133-ac19-752348928702",
                                                "sense_id": "c7cd9560-8cd3-365e-8888-91d311125978",
                                                "text": "As ſoon as they were parted, the Prieſteſs ﬂounced out of the Houſe, call'd for her Coachman, and bid him put in his Horſes, for away would ſhe go […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "priestess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b309d3a3-7f21-3801-b601-1c5cee99dfcb",
                                        "entry_id": "0cbc2568-443a-3e59-a1a4-a55569724ab8",
                                        "glosses": [
                                            "To oversee (a pagan ceremony, etc.) as priestess."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12ca2934-4f3f-4e45-b251-1a05e6da1807",
                                                "sense_id": "b309d3a3-7f21-3801-b601-1c5cee99dfcb",
                                                "text": "Ye Ye Ife, a gifted feminist ritualist and priestess of Oshun from San Diego, trained in the Yoruba tradition, designed and priestessed the ritual with me."
                                            },
                                            {
                                                "example_id": "405b7222-3c9f-42e3-ad73-7d0da9e3c827",
                                                "sense_id": "b309d3a3-7f21-3801-b601-1c5cee99dfcb",
                                                "text": "Priestessing the earth is for me personally the only natural response to the awe and deep love this evokes in me."
                                            },
                                            {
                                                "example_id": "518f7019-fbd1-43f9-9415-60a10140dd68",
                                                "sense_id": "b309d3a3-7f21-3801-b601-1c5cee99dfcb",
                                                "text": "I priestessed the ceremony. I played Hecate. One time I played Demeter and my daughter played Persephone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21131109-257b-47aa-8baf-fa5ce4460ed6",
                        "source_entry_id": "e2beb421-3f84-365c-95b3-b49d5191d7f1",
                        "source_sense_id": "93fdb210-ec73-3964-8467-9d261dbcf0d4",
                        "source_sense_description": "een vrouw die de taak heeft religieuze rituelen te verzorgen",
                        "target_lang_word": "prêtresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prêtresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5858ea9c-c0fd-31f5-9292-3a6fc804673f",
                                        "entry_id": "38d1bf6e-0b25-3d83-91f1-bbda1c6d8f56",
                                        "glosses": [
                                            "Femme qui exerce une fonction sacrée et qui préside aux cérémonies d’un culte religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8df9c78c-646a-4a33-b99e-4d7a6de421a5",
                                                "sense_id": "5858ea9c-c0fd-31f5-9292-3a6fc804673f",
                                                "text": "Par exemple, avez-vous quelquefois réfléchi à certains mots irréguliers de notre langue qui ne prennent pas le féminin, comme les autres mots de la même famille, tels que : poëte, auteur, écrivain, peintre, sculpteur, architecte, compositeur, littérateur, etc. ? Pourquoi ne dit-on pas : peintresse, architectesse, poëtesse, comme on dit : prophétesse ou prêtresse ; ni sculptrice ou autrice, comme on dit : actrice ou lectrice ; ni littérateuse ou compositeuse, comme on dit : chanteuse ou danseuse ; ni écrivaine, comme on dit : souveraine ? Pourquoi, dans ces cas-là, faut-il avoir recours à la périphrase : une femme auteur, une femme peintre, une femme compositeur, et ainsi de suite ?"
                                            },
                                            {
                                                "example_id": "2e3743fa-4d5f-4143-b31c-84df8da9996f",
                                                "sense_id": "5858ea9c-c0fd-31f5-9292-3a6fc804673f",
                                                "text": "Prêtresse d’Apollon, de Diane."
                                            },
                                            {
                                                "example_id": "759c7ff9-eadd-4434-b484-8046a043f437",
                                                "sense_id": "5858ea9c-c0fd-31f5-9292-3a6fc804673f",
                                                "text": "Elle vint à lui, et, avec cette instinctive science de l’amour qui devait faire d’elle la plus conquérante des prêtresses de l’amour, Marion Delorme lui jeta ses bras autour du cou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3ae9313-1f8e-3eee-beae-9433ad09407b",
                                        "entry_id": "38d1bf6e-0b25-3d83-91f1-bbda1c6d8f56",
                                        "glosses": [
                                            "Épouse d’un prêtre, dans les rites non latins de l’Église catholique, les Églises orthodoxes ou les Églises orientales."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcfbf965-f00a-4b1f-bdf5-c6325539cc73",
                                                "sense_id": "b3ae9313-1f8e-3eee-beae-9433ad09407b",
                                                "text": "Les femmes des curés sont appelées prêtresses par honneur, mais n’exercent aucune fonction sacerdotale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
