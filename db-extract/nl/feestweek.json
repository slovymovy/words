                    {
                        "sense_id": "99ac1b62-e9c9-3c9e-820e-b2c2004df129",
                        "entry_id": "d373d2e9-16b2-3355-8c06-099db367c9d5",
                        "glosses": [
                            "een week waarin men feest viert; een week die men gebruikt om feest te vieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e8b1ca4-486f-4cb2-8747-13b8082bf3a2",
                                "sense_id": "99ac1b62-e9c9-3c9e-820e-b2c2004df129",
                                "text": "Met een playbackshow, de prijsuitreiking van de ballonnenwedstrijd en muziek in de tent, kende Westerhaar zaterdag een passende afsluiting van een gevarieerde feestweek."
                            },
                            {
                                "example_id": "bb7f172f-a158-40c7-ae28-7b2e64df8759",
                                "sense_id": "99ac1b62-e9c9-3c9e-820e-b2c2004df129",
                                "text": "Bewoners van de direct naast de ijshal gelegen woningen mogen bovendien negen dagen naar een hotel, op kosten van Augustinus. De politie zal tijdens de feestweek extra patrouilleren en er zullen ook geluidsmetingen zijn."
                            },
                            {
                                "example_id": "d43df360-dbdf-4a3c-b7b1-33b534d17dd8",
                                "sense_id": "99ac1b62-e9c9-3c9e-820e-b2c2004df129",
                                "text": "De openbare basisschool in Markvelde is na een feestweek nu definitief gesloten."
                            }
                        ]
                    }
