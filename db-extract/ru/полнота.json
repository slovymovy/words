                        ],
                        "form": "полноте́"
                    },
                    {
                        "form_id": "0c6b0a28-609b-49c9-a2f3-0ab50a07c368",
                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                        "tags": [
                            "plural",
