                        "sense_id": "8e12d13a-9199-3541-8a05-625ed8c1c0d4",
                        "entry_id": "f7f83ec1-aba1-3b39-8c64-81bdc107638a",
                        "glosses": [
                            "Qui peut être ordonné, rangé dans un certain ordre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d764aad6-4c9b-4e06-9b0a-90dc71e238b2",
                                "sense_id": "8e12d13a-9199-3541-8a05-625ed8c1c0d4",
                                "text": "Une seule chose, comme telle et envisagée sous un seul aspect, n’est pas matière ordonnable. L’ordre suppose donc deux termes au moins."
                            },
                            {
                                "example_id": "7c95b890-a8f2-498b-951d-6c2a24b59613",
                                "sense_id": "8e12d13a-9199-3541-8a05-625ed8c1c0d4",
                                "text": "Par permutation des lignes et des colonnes, la matrice ordonnable autorise tous les reclassements automatisés qui engendrent de nouvelles configurations, donc de nouvelles interprétations esthétiques."
                            },
                            {
                                "example_id": "096cc279-1e9e-45a0-896c-056665461a95",
                                "sense_id": "8e12d13a-9199-3541-8a05-625ed8c1c0d4",
                                "text": "Un domaine d’empiricité est alors descriptible et ordonnable."
                            }
                        ]
                    }
                ],
