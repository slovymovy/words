{
    "word_family": [
        "square",
        "squareness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b4c2974b-da58-3707-911d-268b8bb85289",
                    "sense_definition": "In a direct, straightforward, and honest manner, leaving no room for doubt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "directness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blame for the project's failure lies <w>squarely</w> on the shoulders of the management team.",
                            "target_lang_translations": {
                                "ru": "Вина за провал проекта ложится <w>целиком и полностью</w> на плечи руководства.",
                                "de": "Die Schuld am Scheitern des Projekts liegt <w>voll und ganz</w> auf den Schultern des Managementteams."
                            }
                        },
                        {
                            "text": "You must look <w>squarely</w> at the facts before making such a serious accusation.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>прямо</w> взглянуть на факты, прежде чем выдвигать столь серьезное обвинение.",
                                "de": "Sie müssen den Tatsachen <w>direkt</w> ins Auge sehen, bevor Sie eine so schwerwiegende Anschuldigung erheben."
                            }
                        }
                    ],
                    "synonyms": [
                        "directly",
                        "straightforwardly",
                        "unambiguously"
                    ],
                    "antonyms": [
                        "indirectly",
                        "evasively"
                    ],
                    "common_phrases": [
                        "blame squarely on",
                        "look squarely at",
                        "face squarely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямо, честно и открыто, не оставляя места для сомнений.",
                        "de": "Auf eine direkte, ehrliche und offene Weise, ohne Raum für Zweifel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "открыто и честно"
                            },
                            {
                                "target_lang_word": "непосредственно",
                                "target_lang_sense_clarification": "напрямую, без посредников"
                            },
                            {
                                "target_lang_word": "целиком и полностью",
                                "target_lang_sense_clarification": "в полной мере (о вине или ответственности)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "direkt",
                                "target_lang_sense_clarification": "ohne Umschweife oder Umwege"
                            },
                            {
                                "target_lang_word": "geradeheraus",
                                "target_lang_sense_clarification": "offen und ehrlich"
                            },
                            {
                                "target_lang_word": "voll und ganz",
                                "target_lang_sense_clarification": "in Bezug auf Verantwortung oder Schuld"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7af743e-b05a-326f-9edc-0e3d9546a828",
                    "sense_definition": "In a firm, solid, or stable way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I stand <w>squarely</w> behind my decision and will not change my mind under pressure.",
                            "target_lang_translations": {
                                "ru": "Я <w>твёрдо</w> стою на своём решении и не изменю своего мнения под давлением.",
                                "de": "Ich stehe <w>fest</w> hinter meiner Entscheidung und werde meine Meinung unter Druck nicht ändern."
                            }
                        },
                        {
                            "text": "The new company is <w>squarely</w> focused on expanding its reach in the international market.",
                            "target_lang_translations": {
                                "ru": "Новая компания <w>полностью</w> сосредоточена на расширении своего присутствия на международном рынке.",
                                "de": "Das neue Unternehmen ist <w>voll und ganz</w> darauf konzentriert, seine Reichweite auf dem internationalen Markt auszubauen."
                            }
                        }
                    ],
                    "synonyms": [
                        "firmly",
                        "solidly",
                        "steadfastly"
                    ],
                    "antonyms": [
                        "weakly",
                        "unsteadily"
                    ],
                    "common_phrases": [
                        "stand squarely behind",
                        "squarely focused on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твёрдо, уверенно или непоколебимо.",
                        "de": "Auf eine feste, stabile oder unerschütterliche Weise."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твёрдо",
                                "target_lang_sense_clarification": "непоколебимо и уверенно"
                            },
                            {
                                "target_lang_word": "полностью",
                                "target_lang_sense_clarification": "целиком сосредоточен на чем-либо"
                            },
                            {
                                "target_lang_word": "определённо",
                                "target_lang_sense_clarification": "с уверенностью и чёткостью"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fest",
                                "target_lang_sense_clarification": "stabil und unerschütterlich"
                            },
                            {
                                "target_lang_word": "felsenfest",
                                "target_lang_sense_clarification": "sehr fest, besonders bei Überzeugungen"
                            },
                            {
                                "target_lang_word": "entschieden",
                                "target_lang_sense_clarification": "mit fester Absicht"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db8bc8a6-add9-3278-bdd6-ded535445322",
                    "sense_definition": "In the shape of a square or at right angles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy stone blocks were cut <w>squarely</w> so they would fit together without gaps.",
                            "target_lang_translations": {
                                "ru": "Тяжелые каменные блоки были вырезаны <w>ровно</w> под прямым углом, чтобы они плотно прилегали друг к другу без зазоров.",
                                "de": "Die schweren Steinblöcke wurden <w>rechtwinklig</w> zugeschnitten, damit sie lückenlos zusammenpassten."
                            }
                        },
                        {
                            "text": "The architect ensured that the pillars were set <w>squarely</w> to the base of the building.",
                            "target_lang_translations": {
                                "ru": "Архитектор позаботился о том, чтобы колонны были установлены <w>перпендикулярно</w> основанию здания.",
                                "de": "Der Architekt stellte sicher, dass die Säulen <w>rechtwinklig</w> zum Fundament des Gebäudes aufgestellt wurden."
                            }
                        }
                    ],
                    "synonyms": [
                        "orthogonally"
                    ],
                    "common_phrases": [
                        "cut squarely",
                        "set squarely"
                    ],
                    "target_lang_definitions": {
                        "ru": "В форме квадрата или под прямым углом.",
                        "de": "In der Form eines Quadrats oder im rechten Winkel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ровно",
                                "target_lang_sense_clarification": "под прямым углом или симметрично"
                            },
                            {
                                "target_lang_word": "перпендикулярно",
                                "target_lang_sense_clarification": "под углом 90 градусов"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "rechtwinklig",
                                "target_lang_sense_clarification": "im 90-Grad-Winkel"
                            },
                            {
                                "target_lang_word": "quadratisch",
                                "target_lang_sense_clarification": "in der Form eines Quadrats"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}