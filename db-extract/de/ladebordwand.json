                "senses": [
                    {
                        "sense_id": "3aca9f1a-4c5e-3ed2-b251-af6a123e0b8a",
                        "entry_id": "0afa00aa-8982-33c3-a289-99e1da57a0b1",
                        "glosses": [
                            "eine Hubladebühne; die hintere Bordwand eines LKW"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98710c0b-e41c-4e53-bafd-fda7821512a8",
                                "sense_id": "3aca9f1a-4c5e-3ed2-b251-af6a123e0b8a",
                                "text": "„Ein Überladewagen ist ein landwirtschaftlicher Transportanhänger mit speziellen Vorrichtungen zum besonders schnellen Überladen des Transportguts auf andere Fahrzeuge. Hierzu wird zum Teil die Ladewanne mit Hilfe einer Hydraulik angehoben und über eine seitliche Ladebordwand des zu beladenden Fahrzeuges gekippt.“"
                            },
                            {
                                "example_id": "0ca90df1-59a8-4522-a425-138ae65ded5a",
                                "sense_id": "3aca9f1a-4c5e-3ed2-b251-af6a123e0b8a",
                                "text": "„Der LKW hatte inzwischen gewendet und stand jetzt mit geöffneter Ladebordwand zur Kirchentür.“"
                            },
                            {
                                "example_id": "9ea1676d-e347-4a42-a494-fc589c599f38",
                                "sense_id": "3aca9f1a-4c5e-3ed2-b251-af6a123e0b8a",
                                "text": "„Der junge Mann reckte sich neben dem LKW, während der Ältere die Ladebordwand hydraulisch herabließ und so die Ladefläche freigab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
