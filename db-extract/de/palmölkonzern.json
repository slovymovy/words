                    {
                        "sense_id": "661a476c-0bd7-35a9-8035-089f3489ac76",
                        "entry_id": "0479c4c6-71df-3744-8dd7-76284338c2a7",
                        "glosses": [
                            "Konzern, der aus Palmfrüchten Öl produziert und dieses anschließend verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db894a9c-7526-4803-836a-10fc479f1e25",
                                "sense_id": "661a476c-0bd7-35a9-8035-089f3489ac76",
                                "text": "„Hunderte Landkonflikte mit Palmölkonzernen gibt es in Indonesien, der in Bungku gilt als einer der schlimmsten.“"
                            },
                            {
                                "example_id": "b2f330c6-68d7-4ae0-b3e8-a11bcef5cdbd",
                                "sense_id": "661a476c-0bd7-35a9-8035-089f3489ac76",
                                "text": "„Palmölkonzerne wie SinarMas, Wilmar u.a. liefern Palmöl v.a. an Konzerne wie Unilever und Nestlé zur Verarbeitung in diversen Haushaltsprodukten und Lebensmitteln aber auch an die EU, die zu „Biodiesel“ weiterverarbeitetes Palmöl importiert.“"
                            }
                        ],
