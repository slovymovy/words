                                    {
                                        "sense_id": "6def474f-f040-30e1-b46c-209bfa728e83",
                                        "entry_id": "c3583fec-304f-3459-9c8c-8dd8107daf30",
                                        "glosses": [
                                            "The condition of being uninformed or uneducated; lack of knowledge or information."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f1a81bc-2af1-4cc8-b64c-943987ce0ae5",
                                                "sense_id": "6def474f-f040-30e1-b46c-209bfa728e83",
                                                "text": "She shows total ignorance about the topic at hand."
                                            },
                                            {
                                                "example_id": "56583bdd-b471-4065-8e60-25089437c6a7",
                                                "sense_id": "6def474f-f040-30e1-b46c-209bfa728e83",
                                                "text": "The guard was paying no attention whatever to the running of his train, in total disregard of rules, and, as the recently-published report of a Ministry of Transport Inspecting Officer of Railways shows, there were other disquieting features in the case, such as ignorance on the part of responsible men of rules and appendix instructions and a lax attitude to regulations of which they professed to be aware, combined with failure to look at staff notice boards."
                                            },
                                            {
                                                "example_id": "f3568ab0-767d-48c1-b8d2-e7d6b8d43ce5",
                                                "sense_id": "6def474f-f040-30e1-b46c-209bfa728e83",
                                                "text": "There had been the whisky and Perrier in the morning but, in my ignorance of alcoholics then, I could not imagine one whisky harming anyone who was driving in an open car in the rain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d089e8-5bbf-3283-a42b-a29db165d171",
                                        "entry_id": "c3583fec-304f-3459-9c8c-8dd8107daf30",
                                        "glosses": [
                                            "Sins committed through ignorance."
                                        ],
