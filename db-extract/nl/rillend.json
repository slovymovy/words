        "nl-extract.jsonl": [
            {
                "entry_id": "62ca94f4-26eb-3ec6-b6bd-3b8896a2ebde",
                "word": "rillend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7157e5d-dc1a-3598-a92d-7d4af1afb908",
                        "entry_id": "62ca94f4-26eb-3ec6-b6bd-3b8896a2ebde",
                        "glosses": [
                            "een bibberende beweging maken tegen de kou"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa39a6b6-2bc3-4f34-a4f5-a64b5fad8342",
                                "sense_id": "a7157e5d-dc1a-3598-a92d-7d4af1afb908",
                                "text": "Een bibberende en rillende hond. De familie had geen idee wie de eigenaar van het dier was en dus begon Dirk Jan Karsten een zoekactie op Twitter. 'Van wie is dit hondje? Bibberend en nat zat ie voor onze voordeur', stuurde Karsten de wereld in, vergezeld met een foto van de hond."
                            },
                            {
                                "example_id": "3a0542f3-e44f-4cba-8450-68fa350f6abe",
                                "sense_id": "a7157e5d-dc1a-3598-a92d-7d4af1afb908",
                                "text": "'Het klinkt misschien raar als Flandrien, maar ik kan niet tegen die kou', prevelde een rillende Boonen na de aankomst in Gent."
                            },
                            {
                                "example_id": "511c85b1-7d23-4acf-8a12-ce431e275c10",
                                "sense_id": "a7157e5d-dc1a-3598-a92d-7d4af1afb908",
                                "text": "Hulpsheriff Jessop, die zelf drie dochters heeft, ontfermt zich direct over de rillende baby en geeft hem, terwijl hij het jochie opwarmt, een paar kusjes."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e59b917-ff46-3990-8fa3-65645bba6b3e",
                        "entry_id": "62ca94f4-26eb-3ec6-b6bd-3b8896a2ebde",
                        "glosses": [
                            "een bibberende beweging maken door angst"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74e66b52-aee6-4a8e-bc5f-3c747f211b63",
                        "source_entry_id": "62ca94f4-26eb-3ec6-b6bd-3b8896a2ebde",
                        "source_sense_id": "a7157e5d-dc1a-3598-a92d-7d4af1afb908",
                        "source_sense_description": "een bibberende beweging maken tegen de kou",
                        "target_lang_word": "quivering",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quivering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe071626-6280-365b-82e2-dc6ddbda5818",
                                        "entry_id": "64f0732d-2369-3b72-9eab-2147e73354ea",
                                        "glosses": [
                                            "shaking, shivering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba5dea1-afba-454c-a28d-24e0111f6c33",
                                                "sense_id": "fe071626-6280-365b-82e2-dc6ddbda5818",
                                                "text": "The quivering mass of jello rocked back and forth incessantly but remained on the plate."
                                            },
                                            {
                                                "example_id": "8701accb-5562-4ad9-89d9-e4498cf8aea2",
                                                "sense_id": "fe071626-6280-365b-82e2-dc6ddbda5818",
                                                "text": "You envied me in all my great successes — Jerusalem, Lazarus, Mock Election, pupils, drawings, lectures ; and at all times tried to prove they were not successes, with a pale face and quivering lip — more pale and more quivering than usual."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quivering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a19fb42-7d7d-35b2-b103-9317d8ac7d5c",
                                        "entry_id": "fb0db118-36a3-32d1-a7f0-d013135b7c57",
                                        "glosses": [
                                            "present participle and gerund of quiver"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "quivering",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0becc30e-7959-3b49-8160-ae452d097ccc",
                                        "entry_id": "a8d7acef-c164-3517-acbe-ee918c9cafc8",
                                        "glosses": [
                                            "A motion by which something quivers or trembles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "093e75cb-2b97-4a78-bfe3-41c7731091a1",
                                                "sense_id": "0becc30e-7959-3b49-8160-ae452d097ccc",
                                                "text": "quiverings of the eyelid"
                                            },
                                            {
                                                "example_id": "74f7c2d2-40cb-4742-a740-873e3a97d51b",
                                                "sense_id": "0becc30e-7959-3b49-8160-ae452d097ccc",
                                                "text": "The quiverings of incipient harmony were hushed, and the divine sat in speechless and almost terrified astonishment, while she undid the door, and stood up in the sacred desk from which his maledictions had just been thundered."
                                            },
                                            {
                                                "example_id": "f1063160-8fa3-4fc8-b049-434f345947d1",
                                                "sense_id": "0becc30e-7959-3b49-8160-ae452d097ccc",
                                                "text": "And now the lion lunged suddenly to earth and with a few spasmodic quiverings lay still."
                                            },
                                            {
                                                "example_id": "eea04f8e-7d54-4349-9872-fc08cf5d1d37",
                                                "sense_id": "0becc30e-7959-3b49-8160-ae452d097ccc",
                                                "text": "There remained only the quiverings—the windows, the steel springs of the bed, the dishes, a chair touching the wall.\nThere came at last a silence so complete she could hear the ticking of the clock under the bed, and the snoring of Sophronie's children behind the wall of the girls' bedroom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
