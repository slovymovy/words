                        "glosses": [
                            "een aangename stemming waarin men veel lacht, zich goed voelt en het leven optimistisch bekijkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d18ba139-2f9e-43ee-b0d7-5d45f76df2df",
                                "sense_id": "f9fc6470-595c-3fde-8ea3-827ee769e14e",
                                "text": "Met elke somberheid is het dan gedaan, enkel vrolijkheid die zich ontvouwt."
                            }
                        ]
