                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ebc077-a43b-43df-a989-201011db072a",
                                "sense_id": "13142515-9e99-332c-aff5-88e5883801ee",
                                "text": "De onderzoekers hebben met onderwatercamera's de zeebodem bij de afgebroken ijsmassa Larsen A-ijsplaat gefilmd, op twee verschillende momenten: in 2007 en 2011."
                            },
                            {
                                "example_id": "be545dc3-80de-45d1-b3d1-4a0e8c05e1f9",
                                "sense_id": "13142515-9e99-332c-aff5-88e5883801ee",
                                "text": "Op een zogeheten redplank, gezekerd met een lang touw, schoven twee brandweermannen stapje voor stapje over de ijsplaat richting het dier in nood. Het team waar de mannen toe behoren is gespecialiseerd in oppervlaktereddingen."
                            }
                        ]
