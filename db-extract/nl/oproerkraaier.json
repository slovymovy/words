                "senses": [
                    {
                        "sense_id": "2515ae74-0400-3420-9abc-9157bec58d94",
                        "entry_id": "b77bee04-3b11-3518-b8e3-09941c79bfe5",
                        "glosses": [
                            "iemand die op luidruchtige wijze aangeeft dat hij het ergens niet mee eens is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "850ff776-ce97-4c47-bb85-b9d75f80f49a",
                                "sense_id": "2515ae74-0400-3420-9abc-9157bec58d94",
                                "text": "Na zijn makke tweet zei Trump later op de dag dat de ‘haat en de verdeeldheid hier en nu moeten stoppen.’ De president veroordeelde daarna het geweld ‘dat van vele kanten komt’. Hij weigerde nog altijd uitdrukkelijk te benoemen dat de oproerkraaiers blanke nationalisten, neonazi’s en aanhangers van de Ku Klux Klan waren, die met antisemitische slogans en met de controversiële confederale vlag doorheen de straten van Charlottesville waren opgetrokken."
                            },
                            {
                                "example_id": "dff95857-31a5-4343-938b-a36e86d615aa",
                                "sense_id": "2515ae74-0400-3420-9abc-9157bec58d94",
                                "text": "Een kleine jonge vrouw heeft in Brazilië met succes een einde gemaakt aan een straatgevecht door één van de gespierde oproerkraaiers in bedwang te houden met een extreme dijklem. Een YouTube-filmpje van het opmerkelijke incident gaat inmiddels de hele wereld over. Internationale media spreken van 'the girl with thunder thighs' (het meisje met de bliksemdijen)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49cfe01e-577c-458d-8dc3-9ce8d142fe27",
                        "source_entry_id": "b77bee04-3b11-3518-b8e3-09941c79bfe5",
                        "source_sense_id": "2515ae74-0400-3420-9abc-9157bec58d94",
                        "source_sense_description": "(politiek) iemand die op luidruchtige wijze aangeeft dat hij het ergens niet mee eens is",
                        "target_lang_word": "agitator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agitator",
