{
    "word_family": [
        "halting",
        "haltingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21c5d88d-a119-3cda-8814-f2adc41936d9",
                    "sense_definition": "To bring something to a complete stop or to cause it to cease moving or progressing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stop-action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police officer signaled for the driver to <w>halt</w> the vehicle immediately.",
                            "target_lang_translations": {
                                "ru": "Полицейский подал водителю сигнал немедленно <w>остановить</w> автомобиль.",
                                "zh": "警察示意司机立即<w>停止</w>车辆。"
                            }
                        },
                        {
                            "text": "The construction crew had to <w>halt</w> work because of the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Строительной бригаде пришлось <w>прекратить</w> работу из-за сильного дождя.",
                                "zh": "由于大雨，施工队不得不<w>中止</w>工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stop",
                        "freeze",
                        "immobilize"
                    ],
                    "antonyms": [
                        "start",
                        "continue",
                        "resume"
                    ],
                    "common_phrases": [
                        "halt work",
                        "halt production",
                        "halt progress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью остановить что-либо или заставить прекратить движение или развитие.",
                        "zh": "使某物完全停止或使其停止移动或发展。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "останавливать",
                                "target_lang_sense_clarification": "заставлять прекратить движение или процесс"
                            },
                            {
                                "target_lang_word": "прекращать",
                                "target_lang_sense_clarification": "делать так, чтобы что-то перестало происходить"
                            },
                            {
                                "target_lang_word": "приостанавливать",
                                "target_lang_sense_clarification": "временно прекращать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停止",
                                "target_lang_sense_clarification": "使动作或过程不再进行"
                            },
                            {
                                "target_lang_word": "中止",
                                "target_lang_sense_clarification": "使正在进行的事情中断"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "422bd3cd-7d68-3f32-b784-a1ca95d60905",
                    "sense_definition": "To stop moving or acting, either for a short time or permanently.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stop-action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers decided to <w>halt</w> for a few minutes to catch their breath.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы решили <w>остановиться</w> на несколько минут, чтобы перевести дух.",
                                "zh": "徒步旅行者决定<w>停下</w>几分钟喘口气。"
                            }
                        },
                        {
                            "text": "The train <w>halted</w> at the edge of the tunnel due to a signal failure.",
                            "target_lang_translations": {
                                "ru": "Поезд <w>встал</w> у края туннеля из-за сбоя сигнала.",
                                "zh": "由于信号故障，火车在隧道口<w>停下</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stop",
                        "pause",
                        "brake"
                    ],
                    "antonyms": [
                        "proceed",
                        "advance"
                    ],
                    "common_phrases": [
                        "halt briefly",
                        "halt suddenly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перестать двигаться или действовать на короткое время или навсегда.",
                        "zh": "停止移动或行动，无论是短时间还是永久。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "останавливаться",
                                "target_lang_sense_clarification": "прекращать движение"
                            },
                            {
                                "target_lang_word": "встать",
                                "target_lang_sense_clarification": "перестать двигаться (о транспорте или человеке)"
                            },
                            {
                                "target_lang_word": "замирать",
                                "target_lang_sense_clarification": "становиться неподвижным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停下",
                                "target_lang_sense_clarification": "停止移动或动作"
                            },
                            {
                                "target_lang_word": "停留",
                                "target_lang_sense_clarification": "在某处暂时停止移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b306622-df0f-37eb-991c-c9c8a9c770c7",
                    "sense_definition": "To cause a process, activity, or operation to discontinue or end.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stop-action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>halt</w> operations at the factory until safety standards were met.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>приостановить</w> работу завода до тех пор, пока не будут соблюдены стандарты безопасности.",
                                "zh": "公司决定在达到安全标准之前<w>暂停</w>工厂的运营。"
                            }
                        },
                        {
                            "text": "The government may <w>halt</w> funding for the project if results do not improve.",
                            "target_lang_translations": {
                                "ru": "Правительство может <w>прекратить</w> финансирование проекта, если результаты не улучшатся.",
                                "zh": "如果结果没有改善，政府可能会<w>终止</w>该项目的资金支持。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terminate",
                        "shut down",
                        "break off",
                        "desist"
                    ],
                    "antonyms": [
                        "initiate",
                        "maintain"
                    ],
                    "common_phrases": [
                        "halt operations",
                        "halt funding",
                        "halt negotiations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести к прекращению или завершению процесса, деятельности или операции.",
                        "zh": "导致一个过程、活动或操作中断或结束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прекращать",
                                "target_lang_sense_clarification": "о деятельности или финансировании"
                            },
                            {
                                "target_lang_word": "сворачивать",
                                "target_lang_sense_clarification": "постепенно прекращать работу или проект"
                            },
                            {
                                "target_lang_word": "приостанавливать",
                                "target_lang_sense_clarification": "официально прерывать процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "终止",
                                "target_lang_sense_clarification": "使活动或过程彻底结束"
                            },
                            {
                                "target_lang_word": "暂停",
                                "target_lang_sense_clarification": "暂时中断某项活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0a1b4dd-5b90-3eb5-a9ca-26d334b565f2",
                    "sense_definition": "To stop marching, often as a formal military command.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stop-action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sergeant shouted for the soldiers to <w>halt</w> at the gate.",
                            "target_lang_translations": {
                                "ru": "Сержант крикнул солдатам <w>стой</w> у ворот.",
                                "zh": "中士大喊一声，命令士兵在门口<w>立定</w>。"
                            }
                        },
                        {
                            "text": "The parade will <w>halt</w> in front of the town hall for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Парад <w>остановится</w> перед ратушей для проведения церемонии.",
                                "zh": "游行队伍将在市政厅前<w>停下</w>举行仪式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "stop"
                    ],
                    "antonyms": [
                        "march"
                    ],
                    "common_phrases": [
                        "halt and salute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить маршировать, часто в качестве официальной военной команды.",
                        "zh": "停止行进，通常作为正式的军事命令。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стой",
                                "target_lang_sense_clarification": "военная команда"
                            },
                            {
                                "target_lang_word": "останавливаться",
                                "target_lang_sense_clarification": "прекращать марш"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立定",
                                "target_lang_sense_clarification": "军事口令，要求停止行进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e778cac-2816-328b-bfbc-7fb44b18365e",
                    "sense_definition": "To hesitate or be uncertain about how to proceed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He seemed to <w>halt</w> between two choices, unable to make a final decision.",
                            "target_lang_translations": {
                                "ru": "Казалось, он <w>колеблется</w> между двумя вариантами, не в силах принять окончательное решение.",
                                "zh": "他在两个选择之间似乎有些<w>犹豫</w>，无法做出最终决定。"
                            }
                        },
                        {
                            "text": "Do not <w>halt</w> in your resolve to finish this difficult task.",
                            "target_lang_translations": {
                                "ru": "Не <w>колеблитесь</w> в своей решимости довести это трудное дело до конца.",
                                "zh": "不要在完成这项艰巨任务的决心上<w>迟疑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stay",
                        "desist"
                    ],
                    "antonyms": [
                        "decide"
                    ],
                    "common_phrases": [
                        "halt between opinions"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Колебаться или проявлять неуверенность в том, как действовать дальше.",
                        "zh": "在如何行动上犹豫不决或不确定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колебаться",
                                "target_lang_sense_clarification": "быть в нерешительности"
                            },
                            {
                                "target_lang_word": "запинаться",
                                "target_lang_sense_clarification": "действовать с неуверенностью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "犹豫",
                                "target_lang_sense_clarification": "拿不定主意"
                            },
                            {
                                "target_lang_word": "迟疑",
                                "target_lang_sense_clarification": "行动前表现出的不确定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7f47842-b351-31a9-b8e2-92abdbd5e52e",
                    "sense_definition": "To walk with a limp or move with an uneven gait.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "limping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man began to <w>halt</w> slightly after his long journey on foot.",
                            "target_lang_translations": {
                                "ru": "Старик начал слегка <w>прихрамывать</w> после долгого пешего путешествия.",
                                "zh": "长途跋涉后，老人开始有些<w>跛行</w>。"
                            }
                        },
                        {
                            "text": "The injured horse continued to <w>halt</w> despite the vet's treatment.",
                            "target_lang_translations": {
                                "ru": "Раненая лошадь продолжала <w>хромать</w>, несмотря на лечение ветеринара.",
                                "zh": "尽管接受了兽医的治疗，受伤的马依然<w>一瘸一拐</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти прихрамывая или двигаться неровной походкой.",
                        "zh": "走路时一瘸一拐或步态不稳。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хромать",
                                "target_lang_sense_clarification": "идти неровно из-за травмы"
                            },
                            {
                                "target_lang_word": "прихрамывать",
                                "target_lang_sense_clarification": "слегка хромать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跛行",
                                "target_lang_sense_clarification": "因腿部受伤而走路不稳"
                            },
                            {
                                "target_lang_word": "一瘸一拐",
                                "target_lang_sense_clarification": "形容走路姿势不平稳"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c07426e0-4fae-33f1-a870-384e9b1a6fd6",
                    "sense_definition": "A temporary or permanent stop or cessation of movement or activity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stop-noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>halt</w> of the bus caused several passengers to stumble.",
                            "target_lang_translations": {
                                "ru": "Внезапная <w>остановка</w> автобуса заставила нескольких пассажиров споткнуться.",
                                "zh": "公交车的突然<w>停止</w>导致几名乘客摔倒了。"
                            }
                        },
                        {
                            "text": "The strike brought a <w>halt</w> to all train services across the country.",
                            "target_lang_translations": {
                                "ru": "Забастовка привела к <w>прекращению</w> всего железнодорожного сообщения в стране.",
                                "zh": "罢工导致全国所有的火车服务陷入<w>停顿</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "hiatus",
                        "moratorium",
                        "recess",
                        "close",
                        "finish"
                    ],
                    "antonyms": [
                        "start",
                        "continuation"
                    ],
                    "common_phrases": [
                        "bring to a halt",
                        "come to a halt",
                        "grind to a halt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная или полная остановка или прекращение движения или деятельности.",
                        "zh": "运动或活动的暂时或永久性停止。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остановка",
                                "target_lang_sense_clarification": "прекращение движения"
                            },
                            {
                                "target_lang_word": "прекращение",
                                "target_lang_sense_clarification": "завершение деятельности"
                            },
                            {
                                "target_lang_word": "пауза",
                                "target_lang_sense_clarification": "временная остановка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停止",
                                "target_lang_sense_clarification": "动作或状态的终结"
                            },
                            {
                                "target_lang_word": "停顿",
                                "target_lang_sense_clarification": "短暂的停止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb4bd170-45fe-3bc2-a8f2-19312d4b1558",
                    "sense_definition": "A small, minor railway station, usually unstaffed and with very few facilities.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "railway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train only stops at the village <w>halt</w> if a passenger requests it.",
                            "target_lang_translations": {
                                "ru": "Поезд останавливается на деревенском <w>полустанке</w> только по требованию пассажира.",
                                "zh": "火车只有在乘客要求时才会在村里的<w>小站</w>停靠。"
                            }
                        },
                        {
                            "text": "We waited at the lonely <w>halt</w> in the middle of the woods for the morning train.",
                            "target_lang_translations": {
                                "ru": "Мы ждали утреннего поезда на одиноком <w>полустанке</w> посреди леса.",
                                "zh": "我们在森林中间那个荒凉的<w>停靠站</w>等候早班火车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terminus",
                        "endpoint"
                    ],
                    "common_phrases": [
                        "railway halt"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая железнодорожная станция, обычно без персонала и с минимумом удобств.",
                        "zh": "小型火车站，通常无人值守且设施极少。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полустанок",
                                "target_lang_sense_clarification": "небольшая ж/д станция"
                            },
                            {
                                "target_lang_word": "платформа",
                                "target_lang_sense_clarification": "остановочный пункт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小站",
                                "target_lang_sense_clarification": "规模很小的火车站"
                            },
                            {
                                "target_lang_word": "停靠站",
                                "target_lang_sense_clarification": "列车临时停靠的地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82e63b29-79d9-38f7-9ce9-209392df487e",
                    "sense_definition": "The condition of being lame or having a limp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "limping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The veteran walked with a noticeable <w>halt</w> in his step.",
                            "target_lang_translations": {
                                "ru": "Ветеран шел с заметной <w>хромотой</w>.",
                                "zh": "这位老兵走路时带着明显的<w>跛行</w>。"
                            }
                        },
                        {
                            "text": "Years of hard labor had left him with a permanent <w>halt</w>.",
                            "target_lang_translations": {
                                "ru": "Годы тяжелого труда оставили его с пожизненной <w>хромотой</w>.",
                                "zh": "多年的繁重劳动让他留下了永久性的<w>跛行</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in this sense today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние хромоты или неровной походки.",
                        "zh": "跛脚或步态不稳的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хромота",
                                "target_lang_sense_clarification": "дефект походки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跛行",
                                "target_lang_sense_clarification": "走路不稳的状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d6e8644-8471-31b9-b436-f6598b4a5638",
                    "sense_definition": "Lame or limping in movement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "limping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biblical passage mentions the poor, the blind, and the <w>halt</w>.",
                            "target_lang_translations": {
                                "ru": "В библейском отрывке упоминаются нищие, слепые и <w>хромые</w>.",
                                "zh": "圣经段落中提到了穷人、盲人和<w>跛的</w>人。"
                            }
                        },
                        {
                            "text": "He was <w>halt</w> in one leg after the accident.",
                            "target_lang_translations": {
                                "ru": "После аварии он был <w>хромым</w> на одну ногу.",
                                "zh": "事故发生后，他的一条腿变得<w>跛的</w>了。"
                            }
                        }
                    ],
                    "traits": [
