                "senses": [
                    {
                        "sense_id": "682cd4e6-94ae-3a4c-ba05-bc2e081e990e",
                        "entry_id": "b1b783ae-bfaa-362a-95ed-ad1ddd3a18c2",
                        "glosses": [
                            "de overwinning behaald hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa6cc958-5071-481a-8928-e35fbe9b47d9",
                                "sense_id": "682cd4e6-94ae-3a4c-ba05-bc2e081e990e",
                                "text": "Alle heiligen samen zijn de triomferende kerk die samen met de strijdende kerk (de mensen die in het ondermaanse hun best doen en daarbij wel eens een zonde begaan) de ene grote Rooms-katholieke kerk vormen, zo is de leer."
                            },
                            {
                                "example_id": "5bab72d9-c688-4388-b6c7-b6d7252adbad",
                                "sense_id": "682cd4e6-94ae-3a4c-ba05-bc2e081e990e",
                                "text": "In het algemeen klassement bleef Wiggins de Australiër Cadel Evans en de Kazak Alexandre Vinokoerov voor. Evans gaf bijna anderhalve minuut toe op de triomferende Brit."
                            },
                            {
                                "example_id": "7ab426c2-494b-49b8-b747-dbf244be4141",
                                "sense_id": "682cd4e6-94ae-3a4c-ba05-bc2e081e990e",
                                "text": "Mourinho had dan ook geen enkele twijfel dat hij, jarenlang naar tevredenheid assistent van Van Gaal bij Barça en daarna de triomferende hoofdcoach bij Porto en Chelsea, in 2008 de opvolger van Frank Rijkaard bij Barcelona zou worden."
                            }
                        ]
                    }
