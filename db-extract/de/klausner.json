                ],
                "senses": [
                    {
                        "sense_id": "af0aac2b-52b4-3a71-9096-22e6bc8ee8cf",
                        "entry_id": "783ac4b4-240e-35bd-a11f-4bac4ae551ba",
                        "glosses": [
                            "Mann, der in einer Klause lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50e7b13c-253e-4fd3-9eb4-3bca8d25683c",
                                "sense_id": "af0aac2b-52b4-3a71-9096-22e6bc8ee8cf",
                                "text": "„Maria trat an der Hand des Klausners aus den finstern unterirdischen Gewölben ans Tageslicht.“"
                            },
                            {
                                "example_id": "ca53cfb9-95dd-413d-b11c-df1c5c5bdad2",
                                "sense_id": "af0aac2b-52b4-3a71-9096-22e6bc8ee8cf",
                                "text": "„Ich mochte ohngefähr eine halbe Stunde unter Obstbäumen, über Wiesen, durch Wald und über Felsengeröll gegangen seyn, als ich unter Bäumen versteckt eine kleine einsame Kapelle gewahrte. Ich trat hinein und fand dort einen Klausner, der mit einer Schaar Kinder laut betete.“"
                            },
                            {
                                "example_id": "5bc93a09-5e5c-4207-956e-4c722c8c843f",
                                "sense_id": "af0aac2b-52b4-3a71-9096-22e6bc8ee8cf",
                                "text": "„Zum gottgefälligen Büßerleben zogen sich Eremiten, Klausner und Inklusen in die Waldeinsamkeit zurück und lebten dort in Höhlen oder Hütten, vom Volk mit schaudernder Ehrfurcht bestaunt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
