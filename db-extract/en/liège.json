                                    {
                                        "sense_id": "1d3b64d9-9cf8-3728-a1e3-0b4f4b440e49",
                                        "entry_id": "82b107b7-6df4-300e-a629-d1cc1ccb8b33",
                                        "glosses": [
                                            "Ville wallonne de Belgique, chef-lieu de la province de Liège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9498ccf-225a-4909-883b-9bd773a04c4d",
                                                "sense_id": "1d3b64d9-9cf8-3728-a1e3-0b4f4b440e49",
                                                "text": "Si par malheur les crues de l’Ourthe coïncidaient avec celles de la Meuse, des inondations catastrophiques affectaient toute la vallée en aval de Liège."
                                            },
                                            {
                                                "example_id": "c578b793-591f-44a8-bde8-f5ed677f8b55",
                                                "sense_id": "1d3b64d9-9cf8-3728-a1e3-0b4f4b440e49",
                                                "text": "Il faut encore mentionner la villa de Seilles, entre Namur et Huy, celle de Montcy-Saint-Pierre, chef-lieu du Castrensis, et, vraisemblablement, celle qui occupe le futur site de Liège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d6c5ce-6921-3604-9960-3b5f953f77c2",
                                        "entry_id": "82b107b7-6df4-300e-a629-d1cc1ccb8b33",
                                        "glosses": [
                                            "Une des dix provinces belges et une des cinq situées en Wallonie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cb05891-c1b0-498d-b077-fd741a9fa772",
