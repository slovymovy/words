                        "examples": [
                            {
                                "example_id": "f0ce8b56-e6de-4875-b3c4-fc527d9cfa7f",
                                "sense_id": "b235a03a-0231-3936-b110-05604020d48d",
                                "text": "Egg (de l’anglais, signifiant “œuf”) : Une personne n’ayant pas encore réalisé, ou qui se dénie qu’elle est transgenre ; une personne transgenre toujours en voie de se définir comme telle. Lorsqu’elle le réalise, on dit que “l’œuf se fissure”"
                            },
                            {
                                "example_id": "7830fae3-69e6-486b-b14f-e6671c286c8a",
                                "sense_id": "b235a03a-0231-3936-b110-05604020d48d",
                                "text": "Même si je suis clairement un egg, j'avais envie de me présenter."
                            }
                        ]
