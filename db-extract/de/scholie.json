                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8057e651-88c2-4f98-a2d8-78d9866db765",
                        "source_entry_id": "d2c8c23e-d262-3842-abde-4afcb282a8db",
                        "source_sense_id": "7f3458eb-f2b7-3ec2-92e0-3f487222acd9",
                        "source_sense_description": "erklärende Randbemerkung in antiken Literaturwerken",
                        "target_lang_word": "scholium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scholium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a271505-530a-3447-a92a-c3f3ab9d3db8",
                                        "entry_id": "220f5add-855d-3663-b1a0-f2b9624962ae",
                                        "glosses": [
                                            "A note added to a text as an explanation, criticism or commentary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5716a5f-dac5-4bd2-af56-1a125c01b0df",
                                                "sense_id": "4a271505-530a-3447-a92a-c3f3ab9d3db8",
                                                "text": "And when I shulde make scholias, notis, and gloses in the margent as himself and his master doith."
                                            },
                                            {
                                                "example_id": "5fe0c4b0-f611-49f8-9fce-c9f6ba32ef3b",
                                                "sense_id": "4a271505-530a-3447-a92a-c3f3ab9d3db8",
                                                "text": "Mr. Fox was fain to make soom Scholia’s on it, to reconcile a gloss like that of Orleance, which corrupts the Text."
                                            },
                                            {
                                                "example_id": "a7446bb6-6b24-4a34-8174-da250e71f5d1",
                                                "sense_id": "4a271505-530a-3447-a92a-c3f3ab9d3db8",
                                                "text": "Almost every word admits a scholium, and a long one too."
                                            },
                                            {
                                                "example_id": "2be33bc8-0965-4eef-84ce-5e0d5a86d673",
                                                "sense_id": "4a271505-530a-3447-a92a-c3f3ab9d3db8",
                                                "text": "Short Scholia are added to almost every chapter, containing various readings, or various translations, selected with much judgment and critical acumen."
                                            },
                                            {
                                                "example_id": "394497e9-c61d-4947-be97-10b948854500",
                                                "sense_id": "4a271505-530a-3447-a92a-c3f3ab9d3db8",
                                                "text": "Judy, however, did not choose to receive the laugh as a scholium explanatory of the remark."
                                            },
                                            {
                                                "example_id": "8f0e42b7-3321-41a0-80d8-9863bdca471f",
                                                "sense_id": "4a271505-530a-3447-a92a-c3f3ab9d3db8",
                                                "text": "From a scholium on the Iliad (24. 496) we know that Bacchylides spoke of Theano as having borne fifty sons to Antenor."
                                            },
                                            {
                                                "example_id": "6d285600-3af9-4782-a3a2-54d6dd872f38",
                                                "sense_id": "4a271505-530a-3447-a92a-c3f3ab9d3db8",
                                                "text": "Sluiter examines a tension inherent in such scholarly works as lexica, scholia, epitomai, and commentaries: although the very titles of these works claim no more than secondary status, their authors engage nonetheless in a rhetoric of self-legitimation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f566034-a979-3be8-896d-7a4c4050062f",
                                        "entry_id": "220f5add-855d-3663-b1a0-f2b9624962ae",
                                        "glosses": [
                                            "A note added to a proof as amplification."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac752de2-9215-41fa-9e05-72c3658d747f",
                                                "sense_id": "4f566034-a979-3be8-896d-7a4c4050062f",
                                                "text": "Scholium, is a remark made leisurely, and as it were by the by, on that Proposition, Subject or Discourse before advanced, treated of, or delivered."
                                            },
                                            {
                                                "example_id": "ad9e792a-6e28-4ccd-b0c3-57d69f243a62",
                                                "sense_id": "4f566034-a979-3be8-896d-7a4c4050062f",
                                                "text": "Which is evident likewise concerning the Orbits of Mars, Jupiter and Saturn, from the Scholium to Prop. 9."
                                            },
                                            {
                                                "example_id": "5d87ce85-3f67-40de-b2f8-7c9f8bfdcceb",
                                                "sense_id": "4f566034-a979-3be8-896d-7a4c4050062f",
                                                "text": "Some…cast all their…metaphysical and…moral learning into the method of mathematicians, and bring every thing relating to those abstracted or those practical sciences under theorems, problems, postulates, scholiums, corollaries, &c."
                                            },
                                            {
                                                "example_id": "049a1b3e-950b-4ad6-b8d9-a788638746ea",
                                                "sense_id": "4f566034-a979-3be8-896d-7a4c4050062f",
                                                "text": "A scholium is a remark applied to some preceding propositions, in order to point out their relative connection, or general utility and application."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f7cecc-63ed-32c4-8dc9-9830d0c4c948",
                                        "entry_id": "220f5add-855d-3663-b1a0-f2b9624962ae",
                                        "glosses": [
                                            "A “copy-book maxim”, trite saying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff47acd1-a48f-4fd5-a7ef-1204a05728a7",
                                                "sense_id": "a4f7cecc-63ed-32c4-8dc9-9830d0c4c948",
                                                "text": "The old scholium, that ‘too much familiarity breeds contempt’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
