                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b80e71-10ee-439c-83d4-12a71cea8a11",
                                "sense_id": "b13a4259-2f23-3056-9cfa-c40bb2afa781",
                                "text": "Deze zondag is er een winterfair bij Landgoed Algoed in Enschede. Je kunt er kerstinkopen doen onder het genot van een glaasje glühwein en diverse lekkernijen."
                            },
                            {
                                "example_id": "87dfaad9-3648-4ed1-9ca0-3c90284f5ee7",
                                "sense_id": "b13a4259-2f23-3056-9cfa-c40bb2afa781",
                                "text": "De nieuwe blokkades komen omdat het vervuilde voer ook blijkt geleverd aan de Belgische voerbedrijven Leroy en Algoed. De Nederlandse Voedsel en Waren Autoriteit VWA heeft geen aanwijzingen dat deze bedrijven aan ondernemers in ons land hebben geleverd."
                            }
                        ]
                    }
