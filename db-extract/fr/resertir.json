                ],
                "senses": [
                    {
                        "sense_id": "1ac0c6c1-2004-3ac8-9ec4-d9c4f9357b93",
                        "entry_id": "f92c9351-238c-351c-b8d0-967af0b963f9",
                        "glosses": [
                            "Autre orthographe de ressertir (sertir à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4681488-d3f9-4763-be52-fffaecdb4bff",
                                "sense_id": "1ac0c6c1-2004-3ac8-9ec4-d9c4f9357b93",
                                "text": "Elle marqua tant d'intérêt que Monsieur lui proposa de \"réformer\" toutes ses pierreries, c'est-à-dire de les faire resertir selon la mode du jour, ce qui fut fait dans les jours qui suivaient."
                            },
                            {
                                "example_id": "caff5f73-8320-409c-b09a-045983917d80",
                                "sense_id": "1ac0c6c1-2004-3ac8-9ec4-d9c4f9357b93",
                                "text": "Le lendemain du mariage, j’avais rendez-vous à dix heures chez la diamantaire chez qui j’avais acquis ce qui aurait du être la bague de fiançailles de Sally il y a deux ans et demi, pour la faire nettoyer et resertir (je raconterai cet épisode un autre jour….)."
                            }
                        ]
                    }
