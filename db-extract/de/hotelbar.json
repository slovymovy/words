                ],
                "senses": [
                    {
                        "sense_id": "cb443186-a5c3-3d9c-ab38-c842dc434bfa",
                        "entry_id": "f37868f6-92b6-3b4d-b332-2e051ec21758",
                        "glosses": [
                            "Bar in einem Hotel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f78aa0-36c0-4175-8bed-745334e1c0a3",
                                "sense_id": "cb443186-a5c3-3d9c-ab38-c842dc434bfa",
                                "text": "„Hier in der Hotelbar konnte man alles auf seine Zimmerrechnung setzen lassen.“"
                            },
                            {
                                "example_id": "bcd3d950-1870-4a26-84d7-4ccdd8816c38",
                                "sense_id": "cb443186-a5c3-3d9c-ab38-c842dc434bfa",
                                "text": "„Douglas und Andrew machten sich auf in die Hotelbar, um sich zu betrinken, und Reg und Jez machten sich an den Rallye-Motorrädern zu schaffen, damit sie für das Rennen am nächsten Morgen startklar waren.“"
                            },
                            {
                                "example_id": "a7987254-65ce-4f69-9930-314cf54b878c",
                                "sense_id": "cb443186-a5c3-3d9c-ab38-c842dc434bfa",
                                "text": "„Die Hotelbar ist nur noch mau besetzt.“"
                            },
                            {
                                "example_id": "c11744a5-5db1-412b-b20c-a9f00751a940",
                                "sense_id": "cb443186-a5c3-3d9c-ab38-c842dc434bfa",
                                "text": "„Als Ari am Abend im Hotel eintraf, nachdem Kristín und Stefnir schlafen gegangen waren, war an der Hotelbar kein Platz mehr frei gewesen, als ob die Leute beschlossen hätten, den Beginn der Osterferien genau dort einzuläuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
