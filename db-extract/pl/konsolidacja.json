                "senses": [
                    {
                        "sense_id": "ec79c9f4-c564-335e-9700-47d74e9e8d1a",
                        "entry_id": "ff90a211-c8e3-3a4e-803e-1aa149d284a0",
                        "glosses": [
                            "proces integrowania różnych elementów w celu osiągnięcia jednolitości i spójności w obrębie danej grupy lub struktury"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8df8624f-6e00-4c87-80d1-9da9ddb1cb06",
                                "sense_id": "ec79c9f4-c564-335e-9700-47d74e9e8d1a",
                                "text": "Po wielu negocjacjach i wspólnych wysiłkach, konsolidacja partii politycznej doprowadziła do jednolitej strategii i spójnego stanowiska wobec kluczowych kwestii społecznych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "63195766-96dd-3dc0-8079-90acda7c92dc",
                        "entry_id": "ff90a211-c8e3-3a4e-803e-1aa149d284a0",
                        "glosses": [
                            "proces zastąpienia kilku pożyczek jedną z ujednoliconymi warunkami spłaty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e60c99-dbb6-4b3c-948f-1a0bddff0127",
                                "sense_id": "63195766-96dd-3dc0-8079-90acda7c92dc",
                                "text": "Konsolidacja studenckich pożyczek ułatwiła nieco absolwentowi spłatę zadłużenia."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "d2500b9a-0ff2-3ad0-bf97-1dadcd7dddca",
                        "entry_id": "ff90a211-c8e3-3a4e-803e-1aa149d284a0",
                        "glosses": [
                            "proces łączenia niewielkich przesyłek w celu transportu ich w jednym kontenerze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c1d5f05-8026-4e68-aa25-9a700becd5a6",
                                "sense_id": "d2500b9a-0ff2-3ad0-bf97-1dadcd7dddca",
                                "text": "Przeprowadziliśmy konsolidację przesyłek, co pozwoliło nam zoptymalizować koszty transportu."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "e768ec36-f8be-3a28-b0c6-b4b053f92c39",
                        "entry_id": "ff90a211-c8e3-3a4e-803e-1aa149d284a0",
                        "glosses": [
                            "proces utrwalania informacji w mózgu"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "a1c06432-7b97-44b8-9188-286caf039098",
                                "sense_id": "e768ec36-f8be-3a28-b0c6-b4b053f92c39",
                                "text": "Za proces konsolidacji odpowiedzialny jest m.in. neuron."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "8d49a417-1e98-3a6e-b2fd-e550a1357dcb",
                        "entry_id": "ff90a211-c8e3-3a4e-803e-1aa149d284a0",
                        "glosses": [
                            "proces umacniania i stabilizacji systemu demokratycznego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4515e4d7-acf3-4949-8736-1b1c9399fd31",
                                "sense_id": "8d49a417-1e98-3a6e-b2fd-e550a1357dcb",
                                "text": "Konsolidacja następuje po tranzycji ustrojowej, a kończy się zazwyczaj wyborami lub referendum."
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    },
                    {
                        "sense_id": "bed138a4-210c-3335-a1b2-dc8fe6dbccc1",
                        "entry_id": "ff90a211-c8e3-3a4e-803e-1aa149d284a0",
                        "glosses": [
                            "proces łączenia skompilowanych modułów i tworzenia pliku wykonywalnego lub innego pliku obiektowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16748d69-e2e1-4f6a-a423-7745edd0600a",
                                "sense_id": "bed138a4-210c-3335-a1b2-dc8fe6dbccc1",
                                "text": "Podczas konsolidacji do pliku wynikowego mogą być dołączone odpowiednie nagłówki."
                            }
                        ],
                        "sense_index_json": "\"1.6\""
                    }
