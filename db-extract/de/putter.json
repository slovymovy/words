                                "target_senses": [
                                    {
                                        "sense_id": "60bba3e4-d26c-336e-a585-c7e0622963e4",
                                        "entry_id": "0701b731-c373-35d7-810f-94da563fb427",
                                        "glosses": [
                                            "To be active, but not excessively busy, at a task or a series of tasks."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6003016-9d36-4b9b-8b42-798c1c24d38c",
                                                "sense_id": "60bba3e4-d26c-336e-a585-c7e0622963e4",
                                                "text": "We tiptoed into the house, up the stairs and along the hall into the room where the Professor had been spending so much of his time. 'Twas locked, of course, but the Deacon man got a big bunch of keys out of his pocket and commenced to putter with the lock."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "putter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4855e77-935c-3c77-a300-191cc69d4cb1",
                                        "entry_id": "d50619a8-4dff-3500-a146-3138957f3e51",
                                        "glosses": [
                                            "One who puts or places."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d6ca016-77c7-4c09-98f9-866b6e735326",
                                                "sense_id": "c4855e77-935c-3c77-a300-191cc69d4cb1",
                                                "text": "He was a model of anal defensiveness: fastidious in his dress and appearance, a collector and putter of things in order, a classifier and labeler."
                                            },
                                            {
                                                "example_id": "0c5e2893-32a3-4b14-8f14-e20a51d108e2",
                                                "sense_id": "c4855e77-935c-3c77-a300-191cc69d4cb1",
                                                "text": "[…] for example, Gleitman (1990:30), in support of her claim for universal alignments of syntax and semantics, argues for the universal naturalness of three arguments for 'put' verbs (a putter, a puttee, and a location)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca47072-47e9-3f04-901d-4e735e0ea7dd",
                                        "entry_id": "d50619a8-4dff-3500-a146-3138957f3e51",
                                        "glosses": [
                                            "A shot-putter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28ce31cd-0ddd-3d86-9d0b-1c0a67f9fe65",
                                        "entry_id": "d50619a8-4dff-3500-a146-3138957f3e51",
                                        "glosses": [
                                            "One who pushes the small wagons in a coal mine, to transport the coal mined by the getter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "putter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58525000-1803-39e1-805d-1d24d464fb28",
                                        "entry_id": "0213832d-4042-325c-8269-d71341e68225",
                                        "glosses": [
                                            "To produce intermittent bursts of sound in the course of operating."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5bc0db-0214-4cdd-bb0a-4bff07fe4bef",
                                                "sense_id": "58525000-1803-39e1-805d-1d24d464fb28",
                                                "text": "By the time the engine had puttered and died Atkins and some of the others were out of the trenches and walking towards this new wonder machine."
                                            },
                                            {
                                                "example_id": "76290fd0-5319-4967-8d47-ba870075b18b",
                                                "sense_id": "58525000-1803-39e1-805d-1d24d464fb28",
                                                "text": "Timmy's dad drove an old blue truck that puttered and sputtered to get to the top of the mountain, that led to the valley, where … the WILDCAT waited."
                                            },
                                            {
                                                "example_id": "b4df078a-a92b-47a6-b263-cc4f4317dc3e",
                                                "sense_id": "58525000-1803-39e1-805d-1d24d464fb28",
                                                "text": "As I reluctantly left Tangkoko for the last time, bumping along the trail on a motorbike, Raoul, the alpha male who had smacked my leg, wandered out from among the trees. He was alone, and after I puttered by, I glanced back to see him swagger into the middle of the path to watch me go."
                                            },
                                            {
                                                "example_id": "89a5e9f0-7e4e-4587-b953-d04498394f86",
                                                "sense_id": "58525000-1803-39e1-805d-1d24d464fb28",
                                                "text": "My boyfriend, the cello owner, makes little noises while he putters around, which distracts me from reading my 20,000-word long-form articles about Iraq. So I noise-cancel him too."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
