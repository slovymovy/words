                                "sense_id": "60aa9c6a-ccbf-34ea-8fad-03fcb01ca524",
                                "text": "There is also an in-depth discussion of Celtic deities and the Celtic way of life and worship, so that an intermediate practitioner can expand upon the spellwork to build a series of magical rituals."
                            },
                            {
                                "example_id": "16113c3f-22ea-44dd-a7f1-875f8b8a78c6",
                                "sense_id": "60aa9c6a-ccbf-34ea-8fad-03fcb01ca524",
                                "text": "The spellwork she had utilized to quicker get her to her destination had taken too much from the dark mage."
                            }
