                    },
                    {
                        "translation_id": "9d12ded8-d38b-4f7c-9960-7873a646e603",
                        "source_entry_id": "797afb98-faba-3217-9b66-f3f4d20ff805",
                        "source_sense_id": "17d63a04-5173-3c5f-bf28-bbf07458309e",
                        "source_sense_description": "Stoff, der Materialien weich macht",
                        "target_lang_word": "plastifiant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plastifiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de714c19-8e59-3ed0-86aa-c53a611fe2f2",
                                        "entry_id": "10f7457b-b563-3035-9c41-384bd066b418",
                                        "glosses": [
                                            "Molécule ajoutée aux formulations de différents types de matériaux pour les rendre plus flexibles, plus résistants, plus résilients ou plus faciles à manipuler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e2ea5a-ac0a-475f-b384-3975b4168f74",
                                                "sense_id": "de714c19-8e59-3ed0-86aa-c53a611fe2f2",
                                                "text": "Le durcisseur est principalement du MDI, éventuellement dilué dans du plastifiant pour ajuster le rapport de mélange et contient généralement un promoteur d’adhésion, choisi parmi les silanes (1 à 2% en masse)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plastifiant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8b0045-cc9a-3dd4-bf01-96f4d9392d33",
                                        "entry_id": "eeb30023-98b1-347e-9cc0-5b4748867c91",
                                        "glosses": [
                                            "Relatif à la modification des matériaux pour les rendre plus flexibles, plus résistants, plus résilients ou plus faciles à manipuler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e581ad03-8c54-45ba-858f-d1ec7e43c1c4",
                                                "sense_id": "ed8b0045-cc9a-3dd4-bf01-96f4d9392d33",
                                                "text": "Indéchiffrables sur les étiquettes (la réglementation qui encadre leur usage impose désormais de les mentionner, mais pas de détailler leur composition), ces substances plastifiantes, qui donnent leur consistance (souple, semi-rigide, rigide) à la quasi-totalité des produits en PVC (polychlorure de vinyle), sont redoutables. — (« Phtalates : Prise de tétine », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 65)"
                                            },
                                            {
                                                "example_id": "912b0a52-e27d-421b-a349-bea66dfa4133",
                                                "sense_id": "ed8b0045-cc9a-3dd4-bf01-96f4d9392d33",
                                                "text": "Roquette, le spécialiste des produits dérivés de l'amidon, a ouvert dans son usine de Lestrem (Pas-de-Calais) un pilote de diester d'isosorbide, un produit intermédiaire biosourcé, aux propriétés plastifiantes, alternative aux phtalates utilisés dans les matériaux flexibles."
                                            }
                                        ]
                                    }
                                ]
