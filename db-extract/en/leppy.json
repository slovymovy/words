                "senses": [
                    {
                        "sense_id": "b0ab5357-1166-3f05-89c1-c63c0703012a",
                        "entry_id": "db530534-c887-319d-a0c5-f25abee037f4",
                        "glosses": [
                            "A young animal, particularly a cow calf or bull calf, a lamb, or a colt, which has been abandoned or orphaned."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "00abb737-607b-4afe-be1e-1f29c40c13ea",
                                "sense_id": "b0ab5357-1166-3f05-89c1-c63c0703012a",
                                "text": "When those big bands take off, the mares never come back for those leppies. We were branding one time and saw a little bunch move out and a mom left a leppy behind."
                            },
                            {
                                "example_id": "cb5a7001-2ebd-4968-8bc4-9f6018a324df",
                                "sense_id": "b0ab5357-1166-3f05-89c1-c63c0703012a",
                                "text": "Out on the range, he would have been a stunted leppy."
                            },
                            {
                                "example_id": "84854cf0-6777-4f5a-a828-59711718455e",
                                "sense_id": "b0ab5357-1166-3f05-89c1-c63c0703012a",
                                "text": "I have heard a famous rodeo announcer crack the same old joke every year, \"A leppy is a little calf whose ma has died, and whose pa has run away with another cow.\""
                            }
                        ]
                    }
                ],
