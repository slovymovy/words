                        "source_sense_description": "Zeit mit hohem Verkehrsaufkommen, weil die Berufstätigen zur Arbeit beziehungsweise nach Hause fahren",
                        "target_lang_word": "heure de pointe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
