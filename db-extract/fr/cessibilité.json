                        "glosses": [
                            "Qualité d’une chose susceptible d’être cédée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc1596aa-5588-4e26-89ea-7be1b3fc3e84",
                                "sense_id": "df75fb06-7849-3ba0-bde9-242d90f18c52",
                                "text": "Il est excessivement remarquable que le fait d’être déjà vendu n’empêche jamais le parlementaire vivant d’être encore à vendre. C’est un des rares cas commerciaux de cessibilité permanente."
                            },
                            {
                                "example_id": "db5bf01e-884f-4189-9a82-2f95665eb658",
                                "sense_id": "df75fb06-7849-3ba0-bde9-242d90f18c52",
                                "text": "Arrêté de cessibilité, arrêté pris par le préfet pour déterminer les propriétés qui doivent être cédées à la commune, au département ou à l’État."
                            }
                        ]
                    }
