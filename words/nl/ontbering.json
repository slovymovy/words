{
    "word_family": [
        "ontberen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a09ce78a-659e-35be-9ad4-780f510ed1e7",
                    "sense_definition": "Een ernstig gebrek aan eerste levensbehoeften, zoals voedsel, water of onderdak.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gebrek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de lange tocht door de woestijn moesten de reizigers veel <w>ontberingen</w> doorstaan.",
                            "target_lang_translations": {
                                "en": "During the long journey through the desert, the travelers had to endure many <w>hardships</w>."
                            }
                        },
                        {
                            "text": "Zij stierven uiteindelijk van <w>ontbering</w> door het aanhoudende gebrek aan voedsel en drinkwater.",
                            "target_lang_translations": {
                                "en": "They eventually died of <w>privation</w> due to the persistent lack of food and drinking water."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebrek",
                        "armoede"
                    ],
                    "common_phrases": [
                        "sterven van ontbering",
                        "ontberingen doorstaan"
                    ],
                    "target_lang_definitions": {
                        "en": "A severe lack of basic necessities of life, such as food, water, or shelter."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "privation",
                                "target_lang_sense_clarification": "the state of lacking basic necessities of life"
                            },
                            {
                                "target_lang_word": "deprivation",
                                "target_lang_sense_clarification": "the damaging lack of material and social necessities"
                            },
                            {
                                "target_lang_word": "hardship",
                                "target_lang_sense_clarification": "severe suffering or privation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15c6ac17-9fef-360f-bdd2-f91bf60dd774",
                    "sense_definition": "Een zware beproeving of moeilijke omstandigheid die men moet ondergaan.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "beproeving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bergbeklimmers blikten terug op een reis vol <w>ontberingen</w> maar waren blij dat ze de top hadden bereikt.",
                            "target_lang_translations": {
                                "en": "The mountain climbers looked back on a journey full of <w>hardships</w> but were glad they had reached the summit."
                            }
                        },
                        {
                            "text": "Na alle <w>ontberingen</w> van de oorlog probeerden de burgers hun leven weer op te bouwen.",
                            "target_lang_translations": {
                                "en": "After all the <w>ordeals</w> of the war, the citizens tried to rebuild their lives."
                            }
                        }
                    ],
                    "synonyms": [
                        "beproeving",
                        "ellende",
                        "kwelling",
                        "misère",
                        "rampspoed"
                    ],
                    "common_phrases": [
                        "reis vol ontberingen"
                    ],
                    "target_lang_definitions": {
                        "en": "A severe trial or difficult circumstance that one must undergo."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hardship",
                                "target_lang_sense_clarification": "a condition that is difficult to endure; suffering"
                            },
                            {
                                "target_lang_word": "ordeal",
                                "target_lang_sense_clarification": "a painful or horrific experience"
                            },
                            {
                                "target_lang_word": "trial",
                                "target_lang_sense_clarification": "a trying or difficult experience"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}