                "senses": [
                    {
                        "sense_id": "2db69b0c-c749-33bb-9852-6ac75d5f3ca2",
                        "entry_id": "b70f64de-9acb-3afb-a2c2-c7be82b9fcc2",
                        "glosses": [
                            "nieuwe aandelen in omloop brengen door het bedrijf waarvan de aandelen zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea565879-4c16-4b1e-9251-2fca65410f55",
                                "sense_id": "2db69b0c-c749-33bb-9852-6ac75d5f3ca2",
                                "text": "In latere correspondentie wordt dan ook niet meer gerept over de aandelenuitgifte: eind augustus ondertekent Wang een brief aan ADO waarin afgesproken wordt om in drie termijnen (september, november en december) in totaal 3,7 miljoen euro over te maken."
                            },
                            {
                                "example_id": "3f54c245-2ed2-43aa-9360-2c4ea728a2b9",
                                "sense_id": "2db69b0c-c749-33bb-9852-6ac75d5f3ca2",
                                "text": "Het moederbedrijf van Thuisbezorgd, Takeaway.com, kreeg in 2016 een notering aan de Amsterdamse effectenbeurs. Daarbij kondigde het aan dat de opbrengst van de aandelenuitgifte gebruikt zou worden voor intensieve marketing in Duitsland, waar het bedrijf in felle concurrentie is verwikkeld met bezorger Delivery Hero."
                            },
                            {
                                "example_id": "e6103266-7e6a-4926-bee1-5c2e156704b7",
                                "sense_id": "2db69b0c-c749-33bb-9852-6ac75d5f3ca2",
                                "text": "De aandelenuitgifte en de verkoop van bepalende spelers leggen PEC Zwolle geen windeieren. De club heeft de jaarcijfers over afgelopen seizoen ingeleverd bij de KNVB en ziet het eigen vermogen met bijna 4 miljoen euro toenemen."
                            }
                        ]
                    }
