                                        "sense_id": "a10315d7-eddb-3907-8440-7f3d1e31ec16",
                                        "entry_id": "5f154fa9-27dd-35cb-9f08-6d8110bafae5",
                                        "glosses": [
                                            "To become less excited, intense, or angry."
                                        ],
