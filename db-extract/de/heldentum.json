                                        "entry_id": "6711d654-0ebe-3972-8b65-3e6b4ed474f6",
                                        "glosses": [
                                            "ampie capacità di lotta, difesa ed azione dimostrate contro quanto moralmente ritenuto destabilizzante, pericoloso e minaccioso"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c751270-7445-4ade-90e0-a184aed2c35c",
                                                "sense_id": "0484e83b-6bed-3b55-b27a-7a884aa8cdd4",
                                                "text": "contro le associazioni criminali, l'eroismo delle forze dell'ordine è acclamato anche dai cittadini"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16b63454-4694-4437-82cb-a4899981a108",
                        "source_entry_id": "c690870d-9720-3935-9603-ca0423e9fa17",
