                "senses": [
                    {
                        "sense_id": "ea70dc87-4cfa-3847-a36f-9d8beb0d0274",
                        "entry_id": "abefd149-0ee1-3662-9afa-0638488bb540",
                        "glosses": [
                            "тлея, горя, испускать дым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41e730ef-c492-4863-adc2-e808c891423e",
                                "sense_id": "ea70dc87-4cfa-3847-a36f-9d8beb0d0274",
                                "text": "Вон его папироса в пепельнице: ещё живая. Ещё дымится. Что же ты стоишь?"
                            }
                        ]
                    },
                    {
                        "sense_id": "890f7ab2-f574-38b9-91d6-914f14fd90b2",
                        "entry_id": "abefd149-0ee1-3662-9afa-0638488bb540",
                        "glosses": [
                            "перен. выделять испарения, создавая туман"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67c6b28c-efa8-4d98-a2ab-07bd30d94a41",
                                "sense_id": "890f7ab2-f574-38b9-91d6-914f14fd90b2",
                                "text": "Дубравы делались черней; // Туман над озером дымился, // И красный месяц в облаках // Тихонько по небу катился."
                            }
                        ]
                    }
