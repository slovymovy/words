    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d047e359-5a45-3af9-b778-57ca824d90e1",
                    "sense_definition": "Polite, friendly, and socially conventional remarks made at the beginning of a conversation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "polite_conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After exchanging a few brief <w>pleasantries</w> about the weather, they got straight down to business.",
                            "target_lang_translations": {
                                "ru": "Обменявшись несколькими короткими <w>любезностями</w> о погоде, они сразу перешли к делу."
                            }
                        },
                        {
                            "text": "The host welcomed the guests with warm <w>pleasantries</w> before introducing the main speaker.",
                            "target_lang_translations": {
                                "ru": "Хозяин поприветствовал гостей теплыми <w>любезностями</w>, прежде чем представить главного спикера."
                            }
                        }
                    ],
                    "synonyms": [
                        "small talk",
                        "niceties",
                        "politenesses"
                    ],
                    "common_phrases": [
                        "exchanging pleasantries",
                        "exchange pleasantries",
                        "brief pleasantries"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливые, дружелюбные и социально принятые замечания, высказываемые в начале разговора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любезности",
                                "target_lang_sense_clarification": "вежливые слова при встрече"
                            },
                            {
                                "target_lang_word": "приветствия",
                                "target_lang_sense_clarification": "слова приветствия и вежливости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "567d10ef-5feb-32e5-8d12-6410438e8c41",
                    "sense_definition": "An ironic or euphemistic term for insults, bad language, or hostile remarks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ironic_remarks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two rivals traded bitter <w>pleasantries</w> across the courtroom before the judge arrived.",
                            "target_lang_translations": {
                                "ru": "Два соперника обменялись горькими <w>«любезностями»</w> в зале суда до прибытия судьи."
                            }
                        },
                        {
                            "text": "He ignored the angry <w>pleasantries</w> shouted by the protesters outside the building.",
                            "target_lang_translations": {
                                "ru": "Он проигнорировал гневные <w>колкости</w>, которые выкрикивали протестующие у здания."
                            }
                        }
                    ],
                    "synonyms": [
                        "insults",
                        "barbs",
                        "jibes"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used ironically or euphemistically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ироничное или эвфемистическое обозначение оскорблений, грубых слов или враждебных замечаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«любезности»",
                                "target_lang_sense_clarification": "иронически об оскорблениях или колкостях"
                            },
                            {
                                "target_lang_word": "колкости",
                                "target_lang_sense_clarification": "язвительные замечания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "915cb236-db92-38b7-8780-b1c013d35d99",
                    "sense_definition": "The plural form of <w>pleasantry</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The book is full of witty <w>pleasantries</w> that keep the reader amused.",
                            "target_lang_translations": {
                                "ru": "Книга полна остроумных <w>шуток</w>, которые развлекают читателя."
                            }
                        },
                        {
                            "text": "She was known for her charming <w>pleasantries</w> and lighthearted jokes.",
                            "target_lang_translations": {
                                "ru": "Она была известна своими очаровательными <w>любезностями</w> и беззаботными шутками."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма множественного числа от слова pleasantry (шутливое или приятное замечание)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шутки",
                                "target_lang_sense_clarification": "милые шутливые замечания"
                            },
                            {
                                "target_lang_word": "любезности",
                                "target_lang_sense_clarification": "приятные, милые замечания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
