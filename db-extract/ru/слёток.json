                "senses": [
                    {
                        "sense_id": "a1754821-725d-3640-a435-d018293df8ec",
                        "entry_id": "70bdb28e-913c-30af-b561-61f7f1d7d538",
                        "glosses": [
                            "охотн. молодая птица, только что начавшая вылетать из гнезда"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8dbc06b-4413-434a-a284-3b95cb32f1f5",
                                "sense_id": "a1754821-725d-3640-a435-d018293df8ec",
                                "text": "Если вам попадётся в парке или в лесу молодой беспомощный слёток дрозда или другой птицы — не стремитесь спешить ему на помощь!"
                            },
                            {
                                "example_id": "0d5113a0-c5f5-48bb-b6ed-7fd5ae4ba05f",
                                "sense_id": "a1754821-725d-3640-a435-d018293df8ec",
                                "text": "Опять событие: самец навестил балкон, да не один, с двумя слётками."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1f89887-9070-3739-bd35-796f54139845",
                        "entry_id": "70bdb28e-913c-30af-b561-61f7f1d7d538",
                        "glosses": [
                            "перен., разг., пренебр., устар. выскочка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922007dc-cd83-4769-a96b-a96da3f63fb0",
                                "sense_id": "d1f89887-9070-3739-bd35-796f54139845",
                                "text": "Эти петербургские слётки всегда зазнаются, пока их не ударишь по носу."
                            }
                        ]
                    }
                ],
