                                        "entry_id": "bdf0de5d-880e-32b4-808f-38c9517fb1a3",
                                        "glosses": [
                                            "Relatif aux mercenaires (ou soldats réguliers) hindous au service d’une armée occidentale (britannique, française ou portugaise) à l’époque de la colonisation de l’Inde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8620f8ff-5f78-4eae-b5dd-664dbbe68de5",
                                                "sense_id": "2b8961a2-c368-3995-8a2a-5cff27a32574",
                                                "text": "Vous irez prendre aussitôt le commandement des 13ᵉ, 15ᵉ et 31ᵉ régiments d’infanterie européenne, que sir William Maxwell, gouverneur de Bombay, mettra sous vos ordres avec quatre ou cinq régiments de cavalerie indigène et d’infanterie cipaye."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cipaye",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ee48ec8-0c6c-3811-9168-45ed04f44072",
                                        "entry_id": "20352a88-f350-3bd1-b6a6-47fa30bc7bf2",
                                        "glosses": [
                                            "À l’époque de la colonisation de l’Inde, mercenaire (ou soldat régulier) hindou, au service d’une armée occidentale (britannique, française ou portugaise)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7f83131-dd8a-44a7-b8d5-d1065b7071f8",
                                                "sense_id": "7ee48ec8-0c6c-3811-9168-45ed04f44072",
                                                "text": "[…], les autres commandaient les troupes indigènes de cipayes, tous chèrement appointés, […]."
                                            },
                                            {
                                                "example_id": "8049a1c9-9a28-4430-a863-1a6c96fae2cc",
                                                "sense_id": "7ee48ec8-0c6c-3811-9168-45ed04f44072",
                                                "text": "Cette situation fut jugée anormale par le gouverneur général des Indes James Broun-Ramsay car les cipayes des armées de Madras et de Bombay avaient déjà accepté une obligation de servir outre-mer si cela était nécessaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
