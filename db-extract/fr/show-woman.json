                                        "entry_id": "6565abba-6576-3040-afd5-e0402001da9b",
                                        "glosses": [
                                            "A female showperson, especially one with a central role."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854668da-2ebb-4e33-b720-b3def346dd56",
                                                "sense_id": "4b6ebab9-7383-3183-b513-fd149b55f6f6",
                                                "text": "A consummate showwoman, she led the community theater in Barringtonville for many years. In lieu of flowers, donations to the theater may be made in her honor."
                                            }
