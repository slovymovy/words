                                        "glosses": [
                                            "een verteringsenzym dat in de maag eiwitten in kleine stukken breekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71842957-8fa6-473f-b260-526a390e6780",
                                                "sense_id": "f19f929f-8a5c-3c10-bee8-ecbc9cb54e22",
                                                "text": "Om te zorgen dat pepsine niet de cellen beschadigt die deze stof produceren, wordt het aangemaakt als pepsinogeen, dat bij aanraking met zuur of pepsine in pepsine verandert."
                                            }
                                        ]
