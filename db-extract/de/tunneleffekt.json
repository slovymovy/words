                ],
                "senses": [
                    {
                        "sense_id": "06933b41-5f2f-3d4c-97d1-7f5dd006064e",
                        "entry_id": "3770c4ef-0e29-33c0-a399-8be05db50fad",
                        "glosses": [
                            "Bezeichnung für einen nur quantentheoretisch zu verstehenden Effekt, dass ein atomares Teilchen eine Potentialbarriere auch dann überwinden kann, wenn seine Energie geringer als die Höhe der Barriere ist"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "787918a9-36a6-480a-b9cc-50d5c0ea792b",
                                "sense_id": "06933b41-5f2f-3d4c-97d1-7f5dd006064e",
                                "text": "„Mit einer gewissen Wahrscheinlichkeit, die die Halbwertszeit des Zerfalls bestimmt, verlässt es den Mutterkern jedoch trotzdem mittels des quantenmechanischen Tunneleffekts.“"
                            },
                            {
                                "example_id": "556f94fe-1639-4d51-b86b-8561e621da45",
                                "sense_id": "06933b41-5f2f-3d4c-97d1-7f5dd006064e",
                                "text": "„Der Tunneleffekt hat eine große Bedeutung in verschiedenen Bereichen der Physik, wie zum Beispiel bei der Beschreibung des Alpha-Zerfalls, der Kernfusion, der Funktionsweise der Feldemissions- und Rastertunnelmikroskopie oder bei der Erklärung des Zustandekommens der chemischen Bindung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
