                                                "sense_id": "614d09ba-9efa-3de3-ab8e-4daffb4ba4a6",
                                                "text": "He hurried out, glad to escape, leaving Cora frowning enigmatically under her hair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "364e993c-d127-370b-b966-e01dd2a31d27",
                                        "entry_id": "5cc8809c-f161-3e16-9bac-3a0e10480b44",
                                        "glosses": [
                                            "Behaving mysteriously or strangely."
                                        ],
