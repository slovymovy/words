        "fr-extract.jsonl": [
            {
                "entry_id": "6f6e5c25-1210-392d-996c-9b7345ae1e79",
                "word": "irrémissiblement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "555173a5-0882-3f6f-93bd-955b60480e23",
                        "entry_id": "6f6e5c25-1210-392d-996c-9b7345ae1e79",
                        "glosses": [
                            "D’une manière irrémissible ; sans rémission ; sans miséricorde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08a880a3-a7a9-4e56-929f-8ec8e486fdee",
                                "sense_id": "555173a5-0882-3f6f-93bd-955b60480e23",
                                "text": "— Je ne me fais plus aucune illusion, lui disait-elle, même dans les moments où elle osait se livrer à tout son amour : je suis damnée, irrémissiblement damnée."
                            },
                            {
                                "example_id": "27a7a9a9-4b2a-4086-9c30-6ab60baccf17",
                                "sense_id": "555173a5-0882-3f6f-93bd-955b60480e23",
                                "text": "Hervé, en arrivant à la pointe, vit tout de suite que le malheureux bateau était irrémissiblement perdu."
                            },
                            {
                                "example_id": "11cce379-b8e4-4557-ad56-5917172ab286",
                                "sense_id": "555173a5-0882-3f6f-93bd-955b60480e23",
                                "text": "S'il est un crime d'État qui doit être irrémissiblement puni et cruellement expié, n'est-ce pas celui qui trompe une nation sur sa puissance militaire, en lui faisant croire qu'elle a des forces qu'en réalité elle n'a pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c8d2d96-0453-4e72-9d79-aa8f308b7f69",
                        "source_entry_id": "6f6e5c25-1210-392d-996c-9b7345ae1e79",
                        "source_sense_id": "555173a5-0882-3f6f-93bd-955b60480e23",
                        "target_lang_word": "unforgivably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unforgivably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0eef616e-13fb-35a3-b942-8bab056e6483",
                                        "entry_id": "0975839a-e300-3f83-9f84-6de4413e9164",
                                        "glosses": [
                                            "In an unforgivable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c303401b-e7f9-4162-9f3c-e02bca184d72",
                                                "sense_id": "0eef616e-13fb-35a3-b942-8bab056e6483",
                                                "text": "Mr. Dukakis charged that when it came to advising President Reagan on Iran, Mr. Bush was \"disastrously and completely and unforgivably wrong.\""
                                            },
                                            {
                                                "example_id": "20589a04-395f-42cd-8a15-23029e59f586",
                                                "sense_id": "0eef616e-13fb-35a3-b942-8bab056e6483",
                                                "text": "The astonished Ken Wharfe came by just in time to witness this bizarre spectacle and in an appropriately policemanly manner rebuked the butler for his 'unforgivably disloyal' and 'deeply unprofessional' behaviour."
                                            },
                                            {
                                                "example_id": "95b897b4-6940-4a43-9310-b000aaecca16",
                                                "sense_id": "0eef616e-13fb-35a3-b942-8bab056e6483",
                                                "text": "Specifically, and unforgivably, she restarted the Heathrow Third Runway bandwagon, which had been stalled for more than a decade and even declared dead by most commentators."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
