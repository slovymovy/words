{
    "word_family": [
        "kukelaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34750052-0185-3020-9c7f-49c0db4f9ee5",
                    "sense_definition": "vallen of op een onhandige manier naar beneden tuimelen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude vaas begon te wankelen en <w>kukelde</w> zo van de tafel af.",
                            "target_lang_translations": {
                                "en": "The old vase started to wobble and <w>toppled</w> right off the table."
                            }
                        },
                        {
                            "text": "Hij verloor zijn evenwicht en <w>kukelde</w> pardoes in de sloot.",
                            "target_lang_translations": {
                                "en": "He lost his balance and <w>tumbled</w> straight into the ditch."
                            }
                        }
                    ],
                    "synonyms": [
                        "tuimelen"
                    ],
                    "common_phrases": [
                        "naar beneden kukelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To fall or tumble down in a clumsy or awkward manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "topple",
                                "target_lang_sense_clarification": "to fall over or forward, often unsteadily"
                            },
                            {
                                "target_lang_word": "tumble",
                                "target_lang_sense_clarification": "to fall suddenly or clumsily"
                            },
                            {
                                "target_lang_word": "pitch",
                                "target_lang_sense_clarification": "to fall forward or headlong"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5bbdfbb-cc8a-389e-a91b-46e34d64e9bb",
                    "sense_definition": "het geluid maken dat een haan voortbrengt",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeg in de ochtend begon de haan luid te <w>kukelen</w> op het erf.",
                            "target_lang_translations": {
                                "en": "Early in the morning, the rooster began to <w>crow</w> loudly in the yard."
                            }
                        },
                        {
                            "text": "Ik werd wakker omdat de haan buiten zat te <w>kukelen</w>.",
                            "target_lang_translations": {
                                "en": "I woke up because the rooster was <w>crowing</w> outside."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make the sound that a rooster produces."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crow",
                                "target_lang_sense_clarification": "the characteristic loud cry of a rooster"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}