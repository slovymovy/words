                        "examples": [
                            {
                                "example_id": "06ea9d2c-177a-48e0-b117-ce3f9738b2c3",
                                "sense_id": "4662fc22-f846-3476-8a85-bf1df8d783e4",
                                "text": "„Im längsten Eisenbahntunnel der Welt werden künftig die Züge mit Tempo 250 unter dem Gotthard hindurchfliegen.“"
                            },
                            {
                                "example_id": "cbef43a3-7896-4068-bb07-a8d96a7388ee",
                                "sense_id": "4662fc22-f846-3476-8a85-bf1df8d783e4",
                                "text": "„Ab sofort verbindet ein mehr als 13 Kilometer langer Eisenbahntunnel unter dem Bosporus die europäische und die asiatische Seite der türkischen Millionenmetropole.“"
                            }
                        ],
