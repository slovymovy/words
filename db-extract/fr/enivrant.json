                "senses": [
                    {
                        "sense_id": "96f2fc81-f458-3916-b44e-d8864d0a5284",
                        "entry_id": "ab17032e-af9b-3fee-bc98-3768887ad640",
                        "glosses": [
                            "Qui enivre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3cceaef-10d0-4c23-b35e-60cfd45f7bb2",
                                "sense_id": "96f2fc81-f458-3916-b44e-d8864d0a5284",
                                "text": "L’alcool donne au vin sa force et sa propriété enivrante ; il dérive du sucre, et n'existe jamais tout formé dans le raisin."
                            },
                            {
                                "example_id": "c28b86e1-d683-4643-b09f-a786bf30daa0",
                                "sense_id": "96f2fc81-f458-3916-b44e-d8864d0a5284",
                                "text": "Des porches cintrés s'exhale parfois une odeur enivrante; des constructions […] fournissent ici comme un écho de ce relent particulier aux boutiques des mastroquets, et l'on surprend souvent dans l'air, le puissant arôme des distillations qui s'opèrent."
                            },
                            {
                                "example_id": "618b1fcf-404e-4cd2-99f9-a6d299181467",
                                "sense_id": "96f2fc81-f458-3916-b44e-d8864d0a5284",
                                "text": "Louanges enivrantes. — Applaudissements enivrants."
                            }
                        ]
                    }
                ],
