                "translations": [
                    {
                        "translation_id": "6c5198e0-91b8-4b25-9f2b-a21d361e6b74",
                        "source_entry_id": "60107135-2ed7-3527-83cc-50929d5c9712",
                        "source_sense_id": "7c846ac4-384d-3572-9bbd-ad63e6e798a7",
                        "target_lang_word": "Miniatur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Miniatur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcbbd1bd-739e-3593-8896-79339d72b02e",
                                        "entry_id": "a1f04266-17b5-3a25-9263-199914dbb088",
                                        "glosses": [
                                            "kleines Bild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bdb5990-7c0b-43f7-ab8a-83b903676876",
                                                "sense_id": "fcbbd1bd-739e-3593-8896-79339d72b02e",
                                                "text": "In der Ausstellung werden auch Miniaturen aus der blauen Phase gezeigt."
                                            },
                                            {
                                                "example_id": "35ac97a3-197e-4762-9ea7-ceb567787836",
                                                "sense_id": "fcbbd1bd-739e-3593-8896-79339d72b02e",
                                                "text": "„Darüber hinaus galt er als talentierter Kalligraph, er legte Gärten an, malte Miniaturen und philosophierte über den Sufismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81de6883-76bf-3e2e-b797-586132f86f1f",
                                        "entry_id": "a1f04266-17b5-3a25-9263-199914dbb088",
                                        "glosses": [
                                            "Miniaturmodell, Figur oder Nachbau in kleinem Maßstab"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56bef5ad-dc62-4cf1-8690-dad52910cdde",
                                                "sense_id": "81de6883-76bf-3e2e-b797-586132f86f1f",
                                                "text": "Die Miniatur stellt eine Frau und einen Mann beim Tanzen dar."
                                            },
                                            {
                                                "example_id": "9325204f-4d78-46f8-9c51-8aef030655c6",
                                                "sense_id": "81de6883-76bf-3e2e-b797-586132f86f1f",
                                                "text": "Man hat die ganze Stadt in Miniatur nachgebaut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1cc68b83-c774-3aff-b1de-bfc4551e824b",
                                        "entry_id": "a1f04266-17b5-3a25-9263-199914dbb088",
                                        "glosses": [
                                            "verzierte Buchstaben in alten Handschriften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb54335-83e4-4d94-af4b-727715d0af5d",
                                                "sense_id": "1cc68b83-c774-3aff-b1de-bfc4551e824b",
                                                "text": "Die Bibel hatte herrliche Miniaturen vorzuweisen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
