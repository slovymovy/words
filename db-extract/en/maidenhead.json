                                "target_senses": [
                                    {
                                        "sense_id": "fa1de313-15e6-30cf-83c7-42583127ab7e",
                                        "entry_id": "93e2e300-46d4-3770-9b88-0ddf67a32d9c",
                                        "glosses": [
                                            "fyziologický stav dívky nebo ženy, která dosud neměla vaginální pohlavní styk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f474e4fa-2419-4050-a20c-5639b02d2178",
                                                "sense_id": "fa1de313-15e6-30cf-83c7-42583127ab7e",
                                                "text": "Vášeň soucitu, ten soucit, kterým pouze trpíme, ta bolest, která žene lidi, aby ustoupili tam, kde se nemá ustupovat, a aby lichotili tam, kde je na místě mluvit pravdu, ten soucit, který připravil mnoho žen o panenství a mnoho politiků o čest – ten zemře."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d6117bc-489d-3fb6-bece-28acb724222e",
                                        "entry_id": "93e2e300-46d4-3770-9b88-0ddf67a32d9c",
                                        "glosses": [
                                            "žití v panenství jako životní stav, typicky ze spirituálních pohnutek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430ef958-f6ac-4a50-88d0-c41a71e20532",
                                                "sense_id": "1d6117bc-489d-3fb6-bece-28acb724222e",
                                                "text": "rozhodnout se pro panenství"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e65cfe6-d8ac-4391-9761-2ccc95bab43c",
                        "source_entry_id": "fbb04c93-9051-32e0-bb7d-6e054846faa1",
