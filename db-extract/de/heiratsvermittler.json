                "senses": [
                    {
                        "sense_id": "00b4bc25-2544-37f3-a5bc-521b247c8f7c",
                        "entry_id": "07889054-fe5b-32e2-a0fd-ae824659bffb",
                        "glosses": [
                            "Person, die sich bemüht, Paare zwecks Heirat zusammenzubringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cec6a1e7-6d51-48cd-a7e7-d6a24ced360e",
                                "sense_id": "00b4bc25-2544-37f3-a5bc-521b247c8f7c",
                                "text": "„Im folgenden Witz weist der Heiratsvermittler seinen Sohn in das schwierige Geschäft des Verkuppelns ein.“"
                            },
                            {
                                "example_id": "ddd3da50-db5e-4cc6-9bcc-6b827aad0cc9",
                                "sense_id": "00b4bc25-2544-37f3-a5bc-521b247c8f7c",
                                "text": "„In den Pointen über die Ehefrauen und ihre Mütter, über die Heiratsvermittler und ihre Angebote erklingt dieses Lachen und verwandelt sich zugleich in ein Lächeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
