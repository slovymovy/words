{
    "word_family": [
        "apocrypha"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "82761839-810b-32cf-bcf3-55962cc5d016",
                    "sense_definition": "Relating to the Apocrypha, a collection of ancient Jewish and Christian religious texts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar spent years studying <w>apocryphal</w> texts to understand early religious traditions.",
                            "target_lang_translations": {
                                "zh": "这位学者花了多年时间研究<w>次经</w>文献，以了解早期的宗教传统。"
                            }
                        },
                        {
                            "text": "Many historical debates focus on whether certain books should be considered <w>apocryphal</w> or canonical.",
                            "target_lang_translations": {
                                "zh": "许多历史争论的焦点在于某些书籍究竟应被视为<w>次经</w>还是正典。"
                            }
                        }
                    ],
                    "antonyms": [
                        "canonical"
                    ],
                    "common_phrases": [
                        "apocryphal books",
                        "apocryphal literature"
                    ],
                    "target_lang_definitions": {
                        "zh": "指《次经》的，与《次经》相关的，即古代犹太教和基督教宗教文献的汇编。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "次经的",
                                "target_lang_sense_clarification": "指属于《次经》范畴的宗教文献。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da43cc39-c221-3960-8c16-301f052ffaab",
                    "sense_definition": "Of doubtful authenticity or lacking official recognition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "authenticity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document's origins remain <w>apocryphal</w> despite extensive research by historians.",
                            "target_lang_translations": {
                                "zh": "尽管历史学家进行了广泛的研究，该文件的来源依然<w>真实性存疑</w>。"
                            }
                        },
                        {
                            "text": "Experts often dismiss <w>apocryphal</w> claims that lack supporting evidence.",
                            "target_lang_translations": {
                                "zh": "专家们经常驳回那些缺乏证据支持的<w>伪托</w>主张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spurious"
                    ],
                    "antonyms": [
                        "canonical"
                    ],
                    "common_phrases": [
                        "apocryphal claims",
                        "apocryphal origins"
                    ],
                    "target_lang_definitions": {
                        "zh": "指真实性存疑的，或缺乏官方认可的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "伪托的",
                                "target_lang_sense_clarification": "指托名或真实性未被证实的。"
                            },
                            {
                                "target_lang_word": "来源不明的",
                                "target_lang_sense_clarification": "指缺乏确凿证据支持其真实来源的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fe3c587-0a5c-3d01-953e-669933784db0",
                    "sense_definition": "Of questionable truthfulness or accuracy; often used to describe popular but unverified stories.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authenticity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The story about the inventor is likely <w>apocryphal</w> but remains a popular legend.",
                            "target_lang_translations": {
                                "zh": "关于这位发明家的故事很可能是<w>杜撰</w>的，但它依然是一个广为流传的传说。"
                            }
                        },
                        {
                            "text": "He shared an <w>apocryphal</w> tale that sounded too good to be true.",
                            "target_lang_translations": {
                                "zh": "他分享了一个听起来好得不像是真的<w>传闻</w>故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anecdotal"
                    ],
                    "common_phrases": [
                        "apocryphal tale",
                        "apocryphal story"
                    ],
                    "target_lang_definitions": {
                        "zh": "指真实性或准确性值得怀疑的；常用于描述广为流传但未经证实的轶事或故事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "杜撰的",
                                "target_lang_sense_clarification": "指编造的、非真实的。"
                            },
                            {
                                "target_lang_word": "传闻的",
                                "target_lang_sense_clarification": "指仅凭口头流传，缺乏事实依据的。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}