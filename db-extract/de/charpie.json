                "senses": [
                    {
                        "sense_id": "048be0f8-e6ce-393c-bcb7-479a345b1420",
                        "entry_id": "62e03c12-cbc5-3bd9-b1be-5fccc3a36ced",
                        "glosses": [
                            "bis ins 20. Jahrhundert benutztes Wundverbandsmaterial aus zerzupftem Leinen oder Baumwollstoff"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "89774993-b4ac-4039-b54f-8422d8c23ec3",
                                "sense_id": "048be0f8-e6ce-393c-bcb7-479a345b1420",
                                "text": "„[…] diese wurde möglichst sorgfältig entfernt und die Wunde darauf mit Charpie ausgefüllt und verschlossen.“"
                            },
                            {
                                "example_id": "c0b25c75-395a-429c-bbe5-93148bf96390",
                                "sense_id": "048be0f8-e6ce-393c-bcb7-479a345b1420",
                                "text": "„Beide waren bedeutende Patriotinnen, zupften während der Kriege Charpie und spielten für vaterländische Kassen.“"
                            },
                            {
                                "example_id": "27b978ff-b15e-43da-97ac-4595217701c7",
                                "sense_id": "048be0f8-e6ce-393c-bcb7-479a345b1420",
                                "text": "„Diejenigen aber, die den allgemeinen Gang der Dinge zu verstehen suchten und mit Heroismus und opferwilliger Selbsthingabe an ihm teilnehmen wollten, waren die nutzlosesten Mitglieder der Gesellschaft; sie sahen alles verkehrt und alles, was sie für nützlich hielten und daher taten, erwies sich als nutzloser Unfug, wie etwa die Regimenter Pierres und Mamonows, die plündernd durch die russischen Dörfer zogen, und die Charpie, die von den Damen gezupft wurde und nie bis zu den Verwundeten kam, und dergleichen mehr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
