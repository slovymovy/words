                "senses": [
                    {
                        "sense_id": "8e91ff40-7f22-3937-b169-b00577186308",
                        "entry_id": "c56b2df9-1dd8-323f-adbe-be58c5e41b43",
                        "glosses": [
                            "altes, schlechtes, altmodisches Fahrzeug mit Mängeln, das aber meist noch fährt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "14ec114c-e43e-43db-a4ba-9674b881f6b2",
                                "sense_id": "8e91ff40-7f22-3937-b169-b00577186308",
                                "text": "Diese Schrottkarre springt schon wieder nicht an!"
                            },
                            {
                                "example_id": "545ce2f0-bb47-44ee-b040-5a41f7af6cf5",
                                "sense_id": "8e91ff40-7f22-3937-b169-b00577186308",
                                "text": "Nachdem der TÜV abgelaufen war, hab ich dann die Schrottkarre für 'nen Appel unnen Ei an 'nen Gebrauchtwagenhändler vertickt."
                            },
                            {
                                "example_id": "6637289f-9d4c-44d6-bb54-19df53cd954c",
                                "sense_id": "8e91ff40-7f22-3937-b169-b00577186308",
                                "text": "„Voll die alte Schrottkarre, so was klau ich doch nicht!“"
                            },
                            {
                                "example_id": "1109356e-258f-44c8-9727-e5f32ba6b964",
                                "sense_id": "8e91ff40-7f22-3937-b169-b00577186308",
                                "text": "„Das Taxi, zu dem wir geführt wurden, war eine Schrottkarre vom Feinsten und hatte keine Kofferraumklappe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb0f56f3-566c-461b-8087-1ec56e35c1b9",
                        "source_entry_id": "c56b2df9-1dd8-323f-adbe-be58c5e41b43",
                        "source_sense_id": "8e91ff40-7f22-3937-b169-b00577186308",
                        "source_sense_description": "umgangssprachlich: altes, schlechtes, altmodisches Fahrzeug mit Mängeln, das aber meist noch fährt",
                        "target_lang_word": "clunker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clunker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9d57926-7fc4-3ae7-9f3a-b37c091fc1c4",
                                        "entry_id": "b942d8fc-b7e0-3c68-9e58-1f37edc9cc33",
                                        "glosses": [
                                            "A decrepit motor car."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "850d071a-2179-48de-bc3c-91248931b75f",
                                                "sense_id": "c9d57926-7fc4-3ae7-9f3a-b37c091fc1c4",
                                                "text": "The only rig nobody'd recognize is that clunker that Vic drove here in, and he won't take it."
                                            },
                                            {
                                                "example_id": "0dd67f8e-0d84-40d3-bcf5-99cebde2968f",
                                                "sense_id": "c9d57926-7fc4-3ae7-9f3a-b37c091fc1c4",
                                                "text": "2008 July 9, Jacqueline Mitchell, “America's Most Stolen Vehicles”, in Forbes magazine,\nSo don't think for a moment that your old but tired vehicle matters only to you. Your clunker is cash money to professional thieves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd568ef2-0b1c-36f6-9dfb-7875768eab86",
                                        "entry_id": "b942d8fc-b7e0-3c68-9e58-1f37edc9cc33",
                                        "glosses": [
                                            "Anything which is in poor condition or of poor quality."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b2df3f1-781f-48e9-b742-ac60a1e28f81",
                                                "sense_id": "bd568ef2-0b1c-36f6-9dfb-7875768eab86",
                                                "text": "It seemed silly for the crowd to applaud or groan over what you had already felt in your fingers or even in your arms as you braced to shoot or for that matter in your eyes: when he was hot he could see the separate threads wound into the strings looping the hoop. Yet at the start of the game when you came out for warm-up and could see all the town clunkers sitting in the back of the bleachers elbowing each other and the cheerleaders wisecracking with the racier male teachers, the crowd then seemed right inside you, your liver and lungs and stomach."
                                            },
                                            {
                                                "example_id": "5b677c6f-4ce3-45b0-a0ab-5c1f686ed937",
                                                "sense_id": "bd568ef2-0b1c-36f6-9dfb-7875768eab86",
                                                "text": "I bought an old clunker of a typewriter."
                                            },
                                            {
                                                "example_id": "4eea4af7-8239-4956-975c-024371258136",
                                                "sense_id": "bd568ef2-0b1c-36f6-9dfb-7875768eab86",
                                                "text": "All of the stories have a subtle undercurrent of brutality, and the writing is consistently sharp, direct and darkly funny, and there’s not a clunker in the bunch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68434c1d-421f-4818-8083-c72524683154",
                        "source_entry_id": "c56b2df9-1dd8-323f-adbe-be58c5e41b43",
                        "source_sense_id": "8e91ff40-7f22-3937-b169-b00577186308",
