                "senses": [
                    {
                        "sense_id": "d0679031-9c00-3622-a6cc-61c7153990cd",
                        "entry_id": "3a37b95b-c2f9-3cba-8917-abe7b938ee83",
                        "glosses": [
                            "Stewardess"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "c00f04c7-deef-4ac1-809a-e73407fc97d0",
                                "sense_id": "d0679031-9c00-3622-a6cc-61c7153990cd",
                                "text": "Man sollte die Damen, die die Gäste bedienen, nicht Saftschubse nennen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f34ad488-7c21-4109-afe9-8bd30d7ea289",
                        "source_entry_id": "3a37b95b-c2f9-3cba-8917-abe7b938ee83",
                        "source_sense_id": "d0679031-9c00-3622-a6cc-61c7153990cd",
                        "source_sense_description": "umgangssprachlich, abwertend: Stewardess",
                        "target_lang_word": "trolley dolly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trolley dolly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bd0c8c3-e463-39c3-95da-8c4491d6ff62",
                                        "entry_id": "30aadc16-fdd2-3e0b-9023-6c46d4b67cbd",
                                        "glosses": [
                                            "A female flight attendant."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea9bed0b-7ecf-4316-a7f6-ae75334114a5",
                                                "sense_id": "6bd0c8c3-e463-39c3-95da-8c4491d6ff62",
                                                "text": "I am sure these people were once normal. That is until they walked into BA's superior 'trolley dolly' school. From day one, I am positive it was drummed into them that all economy passengers are scum."
                                            },
                                            {
                                                "example_id": "93ca48c3-438d-480e-8d9f-92afbd000a03",
                                                "sense_id": "6bd0c8c3-e463-39c3-95da-8c4491d6ff62",
                                                "text": "But that was the 1960s and the lot of the trolley dolly has changed: political correctness put an end to age restrictions and the responsibilities go beyond asking passengers whether they want \"chicken or fish\"."
                                            },
                                            {
                                                "example_id": "b9ea735c-e860-4632-803f-c4dfe75ef673",
                                                "sense_id": "6bd0c8c3-e463-39c3-95da-8c4491d6ff62",
                                                "text": "It was sickening and the gross unfairness of it left Cate seriously questioning why she'd ever wanted to be a defence lawyer in the first place. Why hadn't she followed her early adolescent ambitions of becoming a high-flying trolley-dolly - a tart with a cart?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
