        "fr-extract.jsonl": [
            {
                "entry_id": "b88cb25c-82f3-348b-ba33-ab040536631b",
                "word": "symboliquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "38e5d496-dd7c-32e7-be0e-a94555d85ece",
                        "entry_id": "b88cb25c-82f3-348b-ba33-ab040536631b",
                        "glosses": [
                            "D'une manière symbolique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78f0a220-20bf-4fec-bb3b-cf4f04f16339",
                                "sense_id": "38e5d496-dd7c-32e7-be0e-a94555d85ece",
                                "text": "En lui tendant la pantoufle, le prince exprime symboliquement qu'il l'accepte telle qu'elle est, sale et dégradée."
                            },
                            {
                                "example_id": "4031821e-35d1-4405-8286-1a33fba17e93",
                                "sense_id": "38e5d496-dd7c-32e7-be0e-a94555d85ece",
                                "text": "Il y a quelque chose de très fort dans ce mythe du milieu géographique du pays. […]. Tant géographiquement que symboliquement, c’est là que se trouvent les «Forgotten Americans» sur qui Trump comptait pour l’appuyer dans sa quête d’une grandeur renouvelée pour l’Amérique."
                            },
                            {
                                "example_id": "9a14ddec-db3a-4e9c-8b8d-f5c72567ac44",
                                "sense_id": "38e5d496-dd7c-32e7-be0e-a94555d85ece",
                                "text": "Au contraire, Ulysse symboliquement s’annule : « Mon nom est Personne »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "447d318f-2237-4226-a04f-48428b92fa27",
                        "source_entry_id": "b88cb25c-82f3-348b-ba33-ab040536631b",
                        "source_sense_id": "38e5d496-dd7c-32e7-be0e-a94555d85ece",
                        "target_lang_word": "symbolically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symbolically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b65cbd09-7d2e-3cac-90d8-f30fc1f9c32e",
                                        "entry_id": "0d576970-3b7d-3a2a-9b5a-4ab89645f206",
                                        "glosses": [
                                            "In a symbolic manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215295a5-0c0c-4d32-8451-c16dad8eba73",
                                                "sense_id": "b65cbd09-7d2e-3cac-90d8-f30fc1f9c32e",
                                                "text": "Haha, memes are funny! Until they totally become racist. Pepe the Frog lived a very normal meme life right up until online trolls turned him into a green thing of hate in 2016. It got so bad his creator symbolically killed him off in 2017."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abb58797-927a-30b0-b8a5-39193225ee5c",
                                        "entry_id": "0d576970-3b7d-3a2a-9b5a-4ab89645f206",
                                        "glosses": [
                                            "By means of symbols or a symbol."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aafa24b0-0f5c-3c0a-b23e-2b127a344878",
                                        "entry_id": "0d576970-3b7d-3a2a-9b5a-4ab89645f206",
                                        "glosses": [
                                            "As symbols or a symbol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16134501-1186-4128-8bf2-362e1968358e",
                                                "sense_id": "aafa24b0-0f5c-3c0a-b23e-2b127a344878",
                                                "text": "In the end, the deadlock was resolved by a minor -- but for the National Party symbolically important -- addition to one of the other subsections of the language clause."
                                            }
                                        ]
                                    }
                                ]
