                "senses": [
                    {
                        "sense_id": "7acdaccb-1b4c-3bc8-b8cb-aa01fc0eaab5",
                        "entry_id": "af4da666-bea3-3906-9ff9-d14d72ce1883",
                        "glosses": [
                            "Faire perdre son caractère impérial ou impérialiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4d29f9a-d87f-4842-9222-4d7e558e104f",
                                "sense_id": "7acdaccb-1b4c-3bc8-b8cb-aa01fc0eaab5",
                                "text": "Il tenta donc une conciliation des Prétendants, mais échoua dans l’entreprise de désimpérialiser les ministres Saxons."
                            },
                            {
                                "example_id": "3b4c217e-0963-4ec4-881d-d6ff4889c200",
                                "sense_id": "7acdaccb-1b4c-3bc8-b8cb-aa01fc0eaab5",
                                "text": "Que l’Allemagne se désimpérialise, se démocratise, qu’elle change d’Empereur ou même rejette l’Empire, c’est son affaire, mais c’est la nôtre de la déprussifier ou de la déprussianiser."
                            }
                        ]
                    }
