                "senses": [
                    {
                        "sense_id": "8bd03609-f15c-3fbc-affb-9a598b7acad2",
                        "entry_id": "66f62281-db68-3b2e-bb2a-59b2539a5129",
                        "glosses": [
                            "potężne państwo, posiadające broń atomową"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "225c4f55-7e77-44c7-a9f7-04e43f04a736",
                                "sense_id": "8bd03609-f15c-3fbc-affb-9a598b7acad2",
                                "text": "Ameryka powoli urosła do roli supermocarstwa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bb3768e-2754-4aaf-a19d-d9bd6720dd66",
                        "source_entry_id": "66f62281-db68-3b2e-bb2a-59b2539a5129",
                        "source_sense_id": "8bd03609-f15c-3fbc-affb-9a598b7acad2",
                        "target_lang_word": "supervelmoc",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7cc5de36-ae57-4547-918f-5f3c43b12b11",
                        "source_entry_id": "66f62281-db68-3b2e-bb2a-59b2539a5129",
                        "source_sense_id": "8bd03609-f15c-3fbc-affb-9a598b7acad2",
                        "target_lang_word": "superpotencia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superpotencia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "14d06495-5043-3f27-9ebd-ffb7231be830",
                                        "entry_id": "7277ab6d-b95a-3bd1-8176-dbe9183d24e1",
                                        "glosses": [
                                            "Estado con una posición de incuestionable liderazgo en el sistema internacional, con la habilidad y medios para tener influencia en eventos y proyectos de poder a escala global."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c464e36-3a43-43af-9d3d-4c7f49bc6d6b",
                                                "sense_id": "14d06495-5043-3f27-9ebd-ffb7231be830",
                                                "text": "«La derrota de la Armada, en efecto, significó la derrota de la pretensión española de ser la principal potencia en Europa. A partir de ese momento, la otra superpotencia, el enemigo tradicional de España, Francia, la desafiaría sin tregua»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c596084e-62fb-49c1-9026-3494d89f1963",
                        "source_entry_id": "66f62281-db68-3b2e-bb2a-59b2539a5129",
                        "source_sense_id": "8bd03609-f15c-3fbc-affb-9a598b7acad2",
                        "target_lang_word": "Supermacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Supermacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                        "entry_id": "98132006-ca39-3c97-b9a7-a792ba7f601b",
                                        "glosses": [
                                            "„Staat, der globale Entwicklungen aufgrund seiner überragenden Fähigkeiten und Potentiale beeinflussen und bestimmen kann.“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a59769-8de0-4287-aee5-683733cd91b9",
                                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                                "text": "Die Supermacht kontrollierte das Weltgeschehen."
                                            },
                                            {
                                                "example_id": "2ee7e7ce-6ceb-4be8-8b87-b1dc36070693",
                                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                                "text": "„Politisch werden die meisten Regierenden von den Supermächten umworben, auch finanziell.“"
                                            },
                                            {
                                                "example_id": "cfc12595-a781-4eed-869e-2972608ceb60",
                                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                                "text": "„An der Grenze am Ussuri kam es zu kriegerischen Auseinandersetzungen zwischen den roten Supermächten.“"
                                            },
                                            {
                                                "example_id": "d1aeabff-c67b-458f-ac15-f74e2d4f6e05",
                                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                                "text": "„Das Klima zwichen den beiden Supermächten vereiste, ein alles vernichtender Atomkrieg rückte in den Bereich des Möglichen.“"
                                            },
                                            {
                                                "example_id": "994bead2-67a7-49a7-a268-ee2eb24b06e2",
                                                "sense_id": "0476ef8a-cbea-3f38-8bcf-0299bdd1ad48",
                                                "text": "„Alles, was Amerika als Supermacht, als Weltpolizei, als mächtige Wirtschaftskraft, als verhasste und geliebte Idee, als Standard, an dem man sich misst und reibt, gegen den man anrennt, in den letzten 70 Jahren hinter sich gebracht hat, steht Deutschland ab jetzt in Europa bevor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
