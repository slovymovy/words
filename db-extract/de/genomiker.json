                "senses": [
                    {
                        "sense_id": "e41db33a-41b8-3dad-ad77-59b4c8d6f88a",
                        "entry_id": "b13ea83e-a8df-3393-81d2-a43e89f96942",
                        "glosses": [
                            "Wissenschaftler, der sich auf die Erforschung von Genomen spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a05fa494-2678-4fe9-bdc0-0e43aec2d3f1",
                                "sense_id": "e41db33a-41b8-3dad-ad77-59b4c8d6f88a",
                                "text": "„Nebenbei hat der Genomiker sein eigenes Erbgut komplett entziffern lassen.“"
                            },
                            {
                                "example_id": "39348fbc-8a2b-4ccf-9609-af61fabe0b4a",
                                "sense_id": "e41db33a-41b8-3dad-ad77-59b4c8d6f88a",
                                "text": "„Es gehört zum wissenschaftlichen Überzeugungssystem der Genomiker und synthetisierenden Molekularbiologen, daß sie ›alles im Griff‹ haben.“"
                            },
                            {
                                "example_id": "05b2c6b4-4390-43ea-b4d9-aa7f037a9915",
                                "sense_id": "e41db33a-41b8-3dad-ad77-59b4c8d6f88a",
                                "text": "„Es ist nicht mehr allein die Entwicklungsbiologie die Erkenntnisse aus der Erforschung des Wurmes zieht auch Physiologen, Ökologen, Genomiker, Neurobiologen und Evolutionsbiologen nutzen den Modellorganismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "764e8605-674e-44ca-9853-5a41b30850d7",
                        "source_entry_id": "b13ea83e-a8df-3393-81d2-a43e89f96942",
                        "source_sense_id": "e41db33a-41b8-3dad-ad77-59b4c8d6f88a",
                        "source_sense_description": "Wissenschaftler, der sich auf die Erforschung von Genomen spezialisiert hat",
                        "target_lang_word": "genomicist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genomicist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a575905-dde8-3048-9f35-0448c4aac0ff",
                                        "entry_id": "d7008090-887c-327a-b0b5-a691a0534f6f",
                                        "glosses": [
                                            "A scientist whose speciality is genomics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f71256-75b6-4f7f-af78-d01542e954b7",
                                                "sense_id": "3a575905-dde8-3048-9f35-0448c4aac0ff",
                                                "text": "2009, C. Neal Stewart, Jr., Weedy and Invasive Plant Genomics, Wiley (Wiley-Blackwell), page xv,\nSimply, most weed scientists don't know about molecular genetics and most genomicists have yet to discover the world of fast-evolving weeds."
                                            },
                                            {
                                                "example_id": "7859029c-fc4c-48da-9a94-1207ae87ea5f",
                                                "sense_id": "3a575905-dde8-3048-9f35-0448c4aac0ff",
                                                "text": "Like many genomicists working at this turning point in race-based medicine and genomic policy, company scientists struggled to align their definition of race with critical thought and ideas from the public domain."
                                            },
                                            {
                                                "example_id": "a2d8684b-f53b-4d73-a80b-9318148e5835",
                                                "sense_id": "3a575905-dde8-3048-9f35-0448c4aac0ff",
                                                "text": "This occurred because genetic data clustering is highly dependent on the genomicists’ initial racially distorted hypotheses and methodologies. Because genetic data are chosen and analyzed by genomicists immersed in racialized cultures which provide them the means of making sense of human genetic variation they, as I discuss later in the book, are apt to design studies and interpret data to suggest a relatively small fraction of genetic variation between socially defined racial groups connotes biological 'race.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
