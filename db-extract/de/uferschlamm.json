                        "sense_id": "823de581-a291-318d-b266-6263b05b7ac1",
                        "entry_id": "b9251670-ee00-3a30-bba8-e5fa0d9105d5",
                        "glosses": [
                            "Schlamm am Ufer eines Gewässers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19fe894e-2aff-48fa-bc19-5f4d5aef94e0",
                                "sense_id": "823de581-a291-318d-b266-6263b05b7ac1",
                                "text": "„Der niedrige Uferschlamm liegt gerippt und glitschig da wie die poröse Schwarte eines tief eingesunkenen Tieres, und dahinter wellt sich die Landschaft dem Süden und den Bergen entgegen.“"
                            },
                            {
                                "example_id": "e30f92f5-0276-47bd-ae31-2e8a0db49678",
                                "sense_id": "823de581-a291-318d-b266-6263b05b7ac1",
                                "text": "„Court sah zu ihm auf, spuckte hustend Wasser aus und erbrach sich dann auf den Uferschlamm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
