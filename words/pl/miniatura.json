                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "painting_miniature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hrabina nosiła przy sobie małą <w>miniaturę</w> z podobizną zmarłego męża.",
                            "target_lang_translations": {
                                "ru": "Графиня носила с собой маленькую <w>миниатюру</w> с портретом покойного мужа."
                            }
                        },
                        {
                            "text": "Kolekcja obejmuje liczne <w>miniatury</w> namalowane na porcelanie.",
                            "target_lang_translations": {
                                "ru": "Коллекция включает в себя многочисленные <w>миниатюры</w>, написанные на фарфоре."
                            }
                        }
                    ],
                    "common_phrases": [
