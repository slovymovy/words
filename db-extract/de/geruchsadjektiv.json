                "senses": [
                    {
                        "sense_id": "29c1f703-ded6-333a-8dcd-c9fcf45ecc34",
                        "entry_id": "f0eaa88d-b788-3d8e-a527-f302eaa3a7cd",
                        "glosses": [
                            "Wortart, welche die Beschaffenheit oder den Zustand von Geruch beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6340d3dd-ac41-4baf-835c-69156e3dccd3",
                                "sense_id": "29c1f703-ded6-333a-8dcd-c9fcf45ecc34",
                                "text": "„Wenn wir also den Wortschatz des Geruchs strukturell untersuchen wollen, so müssen wir getrennt Wortfelder der Geruchssubstantive, Geruchsverben und Geruchsadjektive analysieren.“"
                            },
                            {
                                "example_id": "43d0101f-06f5-4ef7-82f2-572cfe9336cd",
                                "sense_id": "29c1f703-ded6-333a-8dcd-c9fcf45ecc34",
                                "text": "„Die Aufzählung von Paul Faure beinhaltet vor allem leiblichkeitsbeschreibende Begriffe, was sich am Geruchsadjektiv tonisch („stärkend“) beeindruckend verdeutlicht.“"
                            },
                            {
                                "example_id": "157fe647-7263-4e03-9a3c-54b6b2ac6c52",
                                "sense_id": "29c1f703-ded6-333a-8dcd-c9fcf45ecc34",
                                "text": "„Semantische und syntaktische Klassifizierung der deutschen Geruchsadjektive anhand des Romans von Patrick Süskinds ,,Das Parfum\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
