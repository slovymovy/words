                "senses": [
                    {
                        "sense_id": "4b9ed762-5d0d-30f9-8c5b-3e5280156d9b",
                        "entry_id": "288e9f65-4f30-3da0-affa-c6d44855c1e0",
                        "glosses": [
                            "Art der Fragestellung, bei der der Fragende den Befragten so beeinflusst, dass dieser eine Antwort gibt, die der Fragende erwartet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ffc09df-1f2c-41d5-9085-afda1aa36b64",
                                "sense_id": "4b9ed762-5d0d-30f9-8c5b-3e5280156d9b",
                                "text": "Ein Beispiel für eine Suggestivfrage wäre: „Sind Sie nicht auch der Meinung, dass Ihrer Frau das mintgrüne Kleid viel besser steht?“"
                            },
                            {
                                "example_id": "910084c2-a65e-4c54-8817-b2514127d57c",
                                "sense_id": "4b9ed762-5d0d-30f9-8c5b-3e5280156d9b",
                                "text": "„Eine ‚rhetorische Frage‘ ist im Englischen ‚a rhetoric question‘, aber eine Suggestivfrage ist ‚a leading question‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bea062c-f356-457b-ab15-2b2c1a7a07be",
                        "source_entry_id": "288e9f65-4f30-3da0-affa-c6d44855c1e0",
                        "source_sense_id": "4b9ed762-5d0d-30f9-8c5b-3e5280156d9b",
                        "target_lang_word": "leading question",
