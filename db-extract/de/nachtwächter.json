                "senses": [
                    {
                        "sense_id": "4c0258cf-557d-3ab3-95da-41bd13cd3fec",
                        "entry_id": "646c2bc0-7cc9-3bb4-812e-5a968bce6e6c",
                        "glosses": [
                            "Person, die in der Nacht ein Gebäude oder Gelände bewacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3457884c-0e9a-4638-97e5-c2ae7aafbbe2",
                                "sense_id": "4c0258cf-557d-3ab3-95da-41bd13cd3fec",
                                "text": "Der Nachtwächter patrouilliert in regelmäßigen Abständen durch das ganze Betriebsgelände."
                            },
                            {
                                "example_id": "fa3c2b80-5b23-4793-983d-37652dae10e2",
                                "sense_id": "4c0258cf-557d-3ab3-95da-41bd13cd3fec",
                                "text": "„Unsere Armeeabteilung teilte sich in zwei Brigaden: diejenigen, die tagsüber Wache schoben, und die Nachtwächter.“"
                            },
                            {
                                "example_id": "32f66292-3bda-4390-8058-c6eb0af41b71",
                                "sense_id": "4c0258cf-557d-3ab3-95da-41bd13cd3fec",
                                "text": "„In der zweiten Nacht brannte das Beckmannsche Haus ab, ohne daß der Nachtwächter Feuer geblasen hatte.“"
                            },
                            {
                                "example_id": "c75cd8ab-6c9e-405d-bf84-c7a2c62b01b4",
                                "sense_id": "4c0258cf-557d-3ab3-95da-41bd13cd3fec",
                                "text": "„Das zermürbende Leben der Arbeiter am Witwatersrand kennt er aus eigener Anschauung, er hat als Nachtwächter in einer der Minen gearbeitet.“"
                            },
                            {
                                "example_id": "3744b22b-a12f-46b6-944b-a217df2cf2d3",
                                "sense_id": "4c0258cf-557d-3ab3-95da-41bd13cd3fec",
                                "text": "„Ich suche den Nachtwächter, um ihn für seine Hilfe zu entlohnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
