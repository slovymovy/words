                "senses": [
                    {
                        "sense_id": "8fc59553-a2d6-35ae-b88f-460c27a3e4a5",
                        "entry_id": "0c190a98-6b85-3505-a698-fb355ccf3b89",
                        "glosses": [
                            "das Tal, in dem die Tauber fließt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "8a03adc2-0ef1-4da5-aa6d-511ef77c4ce4",
                                "sense_id": "8fc59553-a2d6-35ae-b88f-460c27a3e4a5",
                                "text": "„Zu Besuch bei einem Autodidakten im Taubertal.“"
                            },
                            {
                                "example_id": "793f73b9-1514-4ba1-a251-e790304db1a5",
                                "sense_id": "8fc59553-a2d6-35ae-b88f-460c27a3e4a5",
                                "text": "„Der Radbus ergänzt das Radtransportangebot auf der Tauberbahn, die in Weikersheim das Taubertal verlässt und in das Vorbachtal abzweigt.“"
                            },
                            {
                                "example_id": "99cf1ff2-7b9d-4fcd-a2cb-bb93d10da3b6",
                                "sense_id": "8fc59553-a2d6-35ae-b88f-460c27a3e4a5",
                                "text": "„Pünktlich zum Vesper hatte es auch aufgehört zu regnen - der verdiente Abschluss für einen perfekten Tag in den Weinbergen des Taubertals!“"
                            },
                            {
                                "example_id": "e8630f2b-a31b-4e80-a68d-48cfd7a9b9b4",
                                "sense_id": "8fc59553-a2d6-35ae-b88f-460c27a3e4a5",
                                "text": "„Der weitere Ausbau der Wasserversorgung im mittleren Taubertal ist ein bedeutendes Projekt und gleichzeitig eine Investition in eine nachhaltige Wasserversorgung.“"
                            },
                            {
                                "example_id": "047fe80e-55f2-414d-8592-4c7e7ca9ce90",
                                "sense_id": "8fc59553-a2d6-35ae-b88f-460c27a3e4a5",
                                "text": "„Am Montagnachmittag ereigneten sich im Taubertal gleich zwei schwerere Fahrradunfälle, berichtet die Polizei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
