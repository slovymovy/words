    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "65523e85-d752-3965-a5c1-413d7fc8f9f5",
                    "sense_definition": "Iemand aanmoedigen of stimuleren om iets te gaan doen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stimuleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar probeerde de leerlingen te <w>prikkelen</w> om meer vragen te stellen.",
                            "target_lang_translations": {
                                "en": "The teacher tried to <w>stimulate</w> the students to ask more questions."
                            }
                        },
                        {
                            "text": "De steeds hogere huur <w>prikkelde</w> hem om eindelijk te gaan verhuizen.",
                            "target_lang_translations": {
                                "en": "The ever-increasing rent <w>prodded</w> him to finally move."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand prikkelen tot"
                    ],
                    "target_lang_definitions": {
                        "en": "To encourage or stimulate someone to take action or do something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spur",
                                "target_lang_sense_clarification": "to urge or encourage to action"
                            },
                            {
                                "target_lang_word": "prod",
                                "target_lang_sense_clarification": "to encourage or prompt someone"
                            },
                            {
                                "target_lang_word": "stimulate",
                                "target_lang_sense_clarification": "to encourage interest or activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "579c3ac8-75c9-3f35-8847-c875889d34dc",
                    "sense_definition": "Een scherp of branderig gevoel op de huid of in de slijmvliezen veroorzaken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_gevoel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterke geur van de uien begon mijn ogen te <w>prikkelen</w>.",
                            "target_lang_translations": {
                                "en": "The strong smell of the onions began to <w>sting</w> my eyes."
                            }
                        },
                        {
                            "text": "De rook van het kampvuur kan de keel behoorlijk <w>prikkelen</w>.",
                            "target_lang_translations": {
                                "en": "The smoke from the campfire can <w>irritate</w> the throat considerably."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de keel prikkelen",
                        "de ogen prikkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause a sharp or burning sensation on the skin or in the mucous membranes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sting",
                                "target_lang_sense_clarification": "to cause a sharp, localized pain"
                            },
                            {
                                "target_lang_word": "irritate",
                                "target_lang_sense_clarification": "to induce physical pain or inflammation"
                            },
                            {
                                "target_lang_word": "prickle",
                                "target_lang_sense_clarification": "to cause a tingling or slight stinging sensation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abebd5a3-afb7-3900-aaa9-09fd7879cdac",
                    "sense_definition": "Iemand een beetje boos of geïrriteerd maken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irritatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn constante opmerkingen begonnen haar na een tijdje flink te <w>prikkelen</w>.",
                            "target_lang_translations": {
                                "en": "His constant remarks started to <w>irritate</w> her quite a bit after a while."
                            }
                        },
                        {
                            "text": "Hij voelde zich snel <w>geprikkeld</w> door het lawaai van de buren.",
                            "target_lang_translations": {
                                "en": "He felt easily <w>annoyed</w> by the noise from the neighbors."
                            }
                        }
                    ],
                    "common_phrases": [
                        "iemand mateloos prikkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make someone slightly angry or annoyed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irritate",
                                "target_lang_sense_clarification": "to provoke impatience or displeasure"
                            },
                            {
                                "target_lang_word": "needle",
                                "target_lang_sense_clarification": "to tease in order to provoke"
                            },
                            {
                                "target_lang_word": "annoy",
                                "target_lang_sense_clarification": "to make someone slightly angry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "948ebc7d-7f64-34c9-b692-980b9db34220",
                    "sense_definition": "De zintuigen of hartstochten op een spannende of seksuele manier opwekken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stimuleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De parfumreclame was bedoeld om de zinnen van de consument te <w>prikkelen</w>.",
                            "target_lang_translations": {
                                "en": "The perfume advertisement was intended to <w>arouse</w> the consumer's senses."
                            }
                        },
                        {
                            "text": "Zij schreef verhalen die de fantasie en de zinnen <w>prikkelen</w>.",
                            "target_lang_translations": {
                                "en": "She wrote stories that <w>excite</w> the imagination and the senses."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de zinnen prikkelen",
                        "de fantasie prikkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To excite the senses or passions in an exciting or sexual way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "arouse",
                                "target_lang_sense_clarification": "to sexually stimulate or induce feelings"
                            },
                            {
                                "target_lang_word": "excite",
                                "target_lang_sense_clarification": "to stir the emotions or stimulate"
                            },
                            {
                                "target_lang_word": "titillate",
                                "target_lang_sense_clarification": "to excite someone in a sexual way"
                            }
                        ]
                    }
                }
            ]
        },
        {
