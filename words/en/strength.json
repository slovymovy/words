                {
                    "sense_id": "94f7499d-f85b-3506-b24b-9602a9223cc0",
                    "sense_definition": "A measure of the connectivity and robustness of a graph.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We calculated the <w>strength</w> of the network to determine its vulnerability.",
                            "target_lang_translations": {
                                "ru": "Мы рассчитали <w>прочность</w> сети, чтобы определить ее уязвимость.",
                                "tr": "Hassasiyetini belirlemek için ağın <w>dayanıklılığını</w> hesapladık."
                            }
                        },
                        {
                            "text": "The graph <w>strength</w> indicates how many edges must be removed to disconnect it.",
                            "target_lang_translations": {
                                "ru": "<w>Прочность</w> графа показывает, сколько ребер нужно удалить, чтобы разъединить его.",
                                "tr": "Graf <w>dayanıklılığı</w>, grafı bağlantısız hale getirmek için kaç kenarın çıkarılması gerektiğini gösterir."
                            }
                        }
