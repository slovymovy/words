    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fd2e848e-8735-3da4-a47d-17138ee48624",
                "word": "Tianjin",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cc2dd15b-34f8-368d-bfcd-643d40bb6285",
                        "entry_id": "fd2e848e-8735-3da4-a47d-17138ee48624",
                        "glosses": [
                            "A direct-administered municipality and major city in northern China, between Beijing and the Bohai Bay."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "497b4449-fa2f-43e3-a4d8-f491fbc95979",
                                "sense_id": "cc2dd15b-34f8-368d-bfcd-643d40bb6285",
                                "text": "The vast majority of factories are state owned. We visited state-owned factories ranging in size from the one thousand six hundred-worker Dong Feng (“East Wind”) Watch Factory in Tianjin to the huge one hundred fifty thousand-worker Anshan Iron and Steel Company in the Northeast."
                            },
                            {
                                "example_id": "ba6bc404-d68a-4185-be87-d547ef458b5c",
                                "sense_id": "cc2dd15b-34f8-368d-bfcd-643d40bb6285",
                                "text": "Watch or run in the fourth annual 42-kilometer Tianjin race on a 15-day tour starting October 23 in Beijing."
                            },
                            {
                                "example_id": "45b1b933-5318-44a9-88a1-c24abd5e81f4",
                                "sense_id": "cc2dd15b-34f8-368d-bfcd-643d40bb6285",
                                "text": "As of March this year, pipelines accommodating 17 MW were already installed between Donghai and a pilot wind project in Bohai Bay near Tianjin."
                            },
                            {
                                "example_id": "b7c55ce9-af66-49d6-9e29-311f694b8bee",
                                "sense_id": "cc2dd15b-34f8-368d-bfcd-643d40bb6285",
                                "text": "Fears that the death toll from the explosion disaster in Tianjin, northeast China, could top 200 were stoked today as state media declared that 112 people had died as a result of Wednesday’s accident, with 95 more missing."
                            },
                            {
                                "example_id": "c730d481-3a35-4b1a-a503-71a3304f441b",
                                "sense_id": "cc2dd15b-34f8-368d-bfcd-643d40bb6285",
                                "text": "Germany's Foreign Minister Annalena Baerbock arrived in the Chinese port city of Tianjin on Thursday to begin her three-day tour of the country.[…]\nOn Thursday, Baerbock is set to visit a school in Tianjin that teaches German as part of the German Foreign Office's PASCH initiative."
                            }
                        ]
                    }
                ],
