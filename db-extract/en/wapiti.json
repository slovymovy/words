                    {
                        "translation_id": "855d0584-97fe-43c1-adef-dddb487363c2",
                        "source_entry_id": "48280293-ba05-3aab-803a-856bef794f45",
                        "source_sense_id": "f6f86d11-a0a9-36dd-b7bb-7dc2b22ef15c",
                        "source_sense_description": "the American elk",
                        "target_lang_word": "wapiti",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
