                "senses": [
                    {
                        "sense_id": "0606c0e3-00c2-3a09-b1d0-f8e007a56cec",
                        "entry_id": "bcbb0800-805a-3c9f-85c7-2a16ae2598b1",
                        "glosses": [
                            "жарг. комп. игр. уровень в компьютерной игре, включая локации, миссии, задания и прочее окружение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fe89517-f933-49de-8930-c8d5b50f98f9",
                                "sense_id": "0606c0e3-00c2-3a09-b1d0-f8e007a56cec",
                                "text": "Я всё-таки сконвертировал мапу, добавил в мод, но заходя на сервер мапы новой не появляется."
                            },
                            {
                                "example_id": "9ee2f625-ccfe-4d3f-87c9-636f62c9a2d7",
                                "sense_id": "0606c0e3-00c2-3a09-b1d0-f8e007a56cec",
                                "text": "Сделал мапу на подобие доты, герои стандартные, несколько новых предметов."
                            },
                            {
                                "example_id": "0effee62-5db7-4b63-a7c6-eabe9cb34929",
                                "sense_id": "0606c0e3-00c2-3a09-b1d0-f8e007a56cec",
                                "text": "Возвращаемся в игру, ставим классы и начинаем бегать по мапам и играм."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a81b4797-1745-4557-845f-efc9c86f77ba",
                        "source_entry_id": "bcbb0800-805a-3c9f-85c7-2a16ae2598b1",
                        "source_sense_id": "0606c0e3-00c2-3a09-b1d0-f8e007a56cec",
                        "target_lang_word": "map",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "map",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "baf732a3-e311-37bc-9344-0673b6787841",
                                        "entry_id": "bd31ea0b-f5c5-34c6-a7a3-c7ed4b00e4d0",
                                        "glosses": [
                                            "A visual representation of an area, whether real or imaginary, showing the relative positions of places and other features."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d9345d4-5ef9-4bc0-99f0-413641e876a8",
                                                "sense_id": "baf732a3-e311-37bc-9344-0673b6787841",
                                                "text": "a map of Australia, a map of Lilliput"
                                            },
                                            {
                                                "example_id": "05a00550-a785-48c5-9e3e-60ccf86f3958",
                                                "sense_id": "baf732a3-e311-37bc-9344-0673b6787841",
                                                "text": "He bought a map for the tour of Edinburgh Castle."
                                            },
                                            {
                                                "example_id": "f3c16829-8593-4158-b47c-8a65e69c05d9",
                                                "sense_id": "baf732a3-e311-37bc-9344-0673b6787841",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            },
                                            {
                                                "example_id": "d0e93ee0-1d1f-45a4-b701-ad580e0a5e6c",
                                                "sense_id": "baf732a3-e311-37bc-9344-0673b6787841",
                                                "text": "Anna, it is a map."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fddfa19-bc71-3ad5-8660-88e03cb3bfeb",
                                        "entry_id": "bd31ea0b-f5c5-34c6-a7a3-c7ed4b00e4d0",
                                        "glosses": [
                                            "A graphical or logical representation of any structure or system, showing the positions of or relationships between its components."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e356d9d-dba6-4fcc-a5d1-24a60fc94454",
                                                "sense_id": "9fddfa19-bc71-3ad5-8660-88e03cb3bfeb",
                                                "text": "a map of the Earth's magnetic field"
                                            },
                                            {
                                                "example_id": "43a1da9b-b09f-4a65-ac39-6752191f0dd6",
                                                "sense_id": "9fddfa19-bc71-3ad5-8660-88e03cb3bfeb",
                                                "text": "The 256 bytes of internal RAM are subdivided as shown in the memory map above."
                                            },
                                            {
                                                "example_id": "893abac4-2061-450f-ba22-212007446d82",
                                                "sense_id": "9fddfa19-bc71-3ad5-8660-88e03cb3bfeb",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3403492e-25e0-3367-9bbd-6f6bf2a23d63",
                                        "entry_id": "bd31ea0b-f5c5-34c6-a7a3-c7ed4b00e4d0",
                                        "glosses": [
                                            "A function, especially a function satisfying a certain property (e.g. continuity, linearity, etc.; see Usage notes)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61be07dc-193e-43d9-bb8c-e6cafddff993",
                                                "sense_id": "3403492e-25e0-3367-9bbd-6f6bf2a23d63",
                                                "text": "Let f be a map from ℝ to ℝ"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84d9286c-e487-3423-a591-614cc6155f48",
                                        "entry_id": "bd31ea0b-f5c5-34c6-a7a3-c7ed4b00e4d0",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the genera Araschnia (especially, Araschnia levana) and Cyrestis, having map-like markings on the wings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81bc792b-7792-385f-97ee-32231624c7a9",
                                        "entry_id": "bd31ea0b-f5c5-34c6-a7a3-c7ed4b00e4d0",
                                        "glosses": [
                                            "The face."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35bc22e9-9c4b-427c-9dea-d15283d812f0",
                                                "sense_id": "81bc792b-7792-385f-97ee-32231624c7a9",
                                                "text": "And as the eye rested on him, he too filled me with pity and terror, for his map was flushed and his manner distraught. He looked like Jack Dempsey at the conclusion of his first conference with Gene Tunney, the occasion, if you remember, when he forgot to duck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0d7005f-023f-36cc-bd2e-35635c6f7283",
                                        "entry_id": "bd31ea0b-f5c5-34c6-a7a3-c7ed4b00e4d0",
                                        "glosses": [
                                            "An imaginary or fictional area, often predefined and confined, where a game or a session thereof takes place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca58ab0-b417-4c6e-a187-2f9b6b6a2ad3",
                                                "sense_id": "b0d7005f-023f-36cc-bd2e-35635c6f7283",
                                                "text": "I don't want to play this map again!"
                                            },
                                            {
                                                "example_id": "27abb20f-fbc8-4639-998c-d333f9516fd2",
                                                "sense_id": "b0d7005f-023f-36cc-bd2e-35635c6f7283",
                                                "text": "Jack loves playing on this Fortnite map."
                                            },
                                            {
                                                "example_id": "60769c8b-8136-4507-a295-3028664ba213",
                                                "sense_id": "b0d7005f-023f-36cc-bd2e-35635c6f7283",
                                                "text": "On top of that, each of Evolve's maps are dim, open arenas with little to interact with besides the occasional hostile organism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cc07368-f344-36ef-a9e8-e10e27ca783c",
                                        "entry_id": "bd31ea0b-f5c5-34c6-a7a3-c7ed4b00e4d0",
                                        "glosses": [
                                            "Synonym of associative array."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "map",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffc50ed5-c455-3121-94bf-e427e9bfea46",
                                        "entry_id": "244485e2-479d-3a57-920e-f70233273a41",
                                        "glosses": [
                                            "To represent by means of a map."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60976d11-73ca-4f9d-b4e0-5ec3d9297c5c",
                                                "sense_id": "ffc50ed5-c455-3121-94bf-e427e9bfea46",
                                                "text": "This large atlas maps the whole world in very great detail."
                                            },
                                            {
                                                "example_id": "f3efbf10-5e93-49c8-840c-bcfd82837517",
                                                "sense_id": "ffc50ed5-c455-3121-94bf-e427e9bfea46",
                                                "text": "Figure 3 maps the pressure distribution within the human circulatory system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49780342-61d7-3359-a25d-d1b35b7a35b5",
                                        "entry_id": "244485e2-479d-3a57-920e-f70233273a41",
                                        "glosses": [
                                            "To create a map of; to examine or survey in order to gather information for a map."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cefaf586-f402-41ac-856d-a52f10b87f1a",
                                                "sense_id": "49780342-61d7-3359-a25d-d1b35b7a35b5",
                                                "text": "The team is mapping the route of the new railway line."
                                            },
                                            {
                                                "example_id": "adf5810b-88c5-43f9-ae0a-8bbb140aeafa",
                                                "sense_id": "49780342-61d7-3359-a25d-d1b35b7a35b5",
                                                "text": "The space probe is mapping the Earth's gravitational field."
                                            },
                                            {
                                                "example_id": "93af5ec0-ab1b-405a-970b-21301af72aab",
                                                "sense_id": "49780342-61d7-3359-a25d-d1b35b7a35b5",
                                                "text": "To provide the surveys required for modernisation schemes on British Railways, extensive sections of line in the Home Counties are to be mapped from the air. […] The track will be photographed from 1,500 ft. to provide maps of a scale of about 104 ft. to 1 in."
                                            },
                                            {
                                                "example_id": "9c5bbbe2-c4c8-40b5-bc77-e986f3ef79f1",
                                                "sense_id": "49780342-61d7-3359-a25d-d1b35b7a35b5",
                                                "text": "This equipment is designed to map the neurons of the human brain in three dimensions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2389ce5-0197-3279-b7da-527a6f5f0581",
                                        "entry_id": "244485e2-479d-3a57-920e-f70233273a41",
                                        "glosses": [
                                            "To have a direct relationship; to correspond."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12f34ae8-d3d7-43d0-8753-93c90f9a2414",
                                                "sense_id": "f2389ce5-0197-3279-b7da-527a6f5f0581",
                                                "text": "This doesn't map to my understanding of how things should work."
                                            },
                                            {
                                                "example_id": "60748a9c-83fb-43ff-b10d-d25c1325720f",
                                                "sense_id": "f2389ce5-0197-3279-b7da-527a6f5f0581",
                                                "text": "Significantly, the aural-oral data does not map closely to the visual linguistic landscape at NIE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d70ab97-921e-3b5a-9216-0d0c38a23349",
                                        "entry_id": "244485e2-479d-3a57-920e-f70233273a41",
                                        "glosses": [
                                            "To create a direct relationship to; to create a correspondence with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e15746d-ec99-48a8-a7dc-8e0a8e777bc3",
                                                "sense_id": "1d70ab97-921e-3b5a-9216-0d0c38a23349",
                                                "text": "Map \"volume down\" to the F2 key."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c77ce7d-69a3-3143-a7d2-47f442d33c0b",
                                        "entry_id": "244485e2-479d-3a57-920e-f70233273a41",
                                        "glosses": [
                                            "To act as a function on something, taking it to something else."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd15f338-3040-4c44-a5ca-5bbe1f8039fa",
                                                "sense_id": "7c77ce7d-69a3-3143-a7d2-47f442d33c0b",
                                                "text": "f maps A to B, mapping every a∈A to f(a)∈B."
                                            },
                                            {
                                                "example_id": "cd2ee82f-06d8-4e07-876d-11078e97066b",
                                                "sense_id": "7c77ce7d-69a3-3143-a7d2-47f442d33c0b",
                                                "text": "Equivalently: f:A→B,a↦f(a)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "273ac674-8342-3586-8b2b-7a8cd09654b3",
                                        "entry_id": "244485e2-479d-3a57-920e-f70233273a41",
                                        "glosses": [
                                            "To assign a drive letter to a shared folder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
