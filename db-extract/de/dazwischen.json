        "de-extract.jsonl": [
            {
                "entry_id": "858b6d58-95f9-3bef-a55c-f8408182131c",
                "word": "dazwischen",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e702c193-e126-3f49-ae7f-a38302cb82d6",
                        "entry_id": "858b6d58-95f9-3bef-a55c-f8408182131c",
                        "glosses": [
                            "zwischen den erwähnten Sachen"
                        ],
                        "tags": [
                            "räumlich"
                        ],
                        "examples": [
                            {
                                "example_id": "5e779a14-d0f3-415c-b589-f39397a6d9d8",
                                "sense_id": "e702c193-e126-3f49-ae7f-a38302cb82d6",
                                "text": "Auf dem Bild sieht man zwei Bäume und dazwischen ein Reh."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a5a88b3-8d0d-3e74-b6d5-55298cb95e6a",
                        "entry_id": "858b6d58-95f9-3bef-a55c-f8408182131c",
                        "glosses": [
                            "im erwähnten Bereich, zwischen den erwähnten Werten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "264ba03e-8b24-459d-b6d6-919d00b48531",
                                "sense_id": "3a5a88b3-8d0d-3e74-b6d5-55298cb95e6a",
                                "text": "Dieses Gerät kostet 300 Euro, das günstigere kostet 220 Euro. Das da vorne liegt irgendwo dazwischen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "617d9c5d-5357-3902-bab0-bf5098b23bcd",
                        "entry_id": "858b6d58-95f9-3bef-a55c-f8408182131c",
                        "glosses": [
                            "zwischen den erwähnten Zeitpunkten"
                        ],
                        "tags": [
                            "temporal"
                        ],
                        "examples": [
                            {
                                "example_id": "b7a468ca-0a30-471c-977c-1d449a319363",
                                "sense_id": "617d9c5d-5357-3902-bab0-bf5098b23bcd",
                                "text": "Bevor das Konzert anfängt muss noch aufräumen. Und dazwischen sollte ich mich irgendwann noch umziehen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "e0d1ba52-3cf0-3b7d-8774-830af24db657",
                        "entry_id": "858b6d58-95f9-3bef-a55c-f8408182131c",
                        "glosses": [
                            "in eine Menge hineingemischt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5ce4862-6b07-4a85-8b28-08c151527b6c",
                                "sense_id": "e0d1ba52-3cf0-3b7d-8774-830af24db657",
                                "text": "Bei so vielen Menschen sind leider auch immer ein paar Spinner dazwischen."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
