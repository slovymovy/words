                        "glosses": [
                            "Graver à la molette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b2a121-8cc0-4bbe-b9bd-15444659863e",
                                "sense_id": "820ec869-7637-3f6e-bc98-168c38d8581c",
                                "text": "Nul verrier ne livrera ouvrage qu’il ne soit visité par les gardes, et ne mectra pièce de voirie œuvre qu’elle ne soit bien mise et recuite, et s’il faict armoirie sur voirre elle sera girisée, et, s’il ne pouvait la giriser, le fera assavoir aux gardes à peine d’amande."
                            }
                        ]
                    }
