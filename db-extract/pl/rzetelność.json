                        "source_sense_id": "a479b2ce-8145-3964-90e6-8da99afad07d",
                        "target_lang_word": "Redlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Redlichkeit",
