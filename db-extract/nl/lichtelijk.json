                    },
                    {
                        "translation_id": "4788ecab-64e5-427a-bdb2-82ee1a20e750",
                        "source_entry_id": "8f1cdd3b-2bf4-35bd-be12-d73369c71440",
                        "source_sense_id": "ea5fd58b-2541-38fc-a5d3-ca870420a873",
                        "target_lang_word": "rather",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "Used to specify a choice or preference; preferably, in preference to. (Now usually followed by than)"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6985433d-9eb4-46db-9da8-e00f54733bb0",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "They'd rather've spent the money on a holiday."
                                            },
                                            {
                                                "example_id": "3f437654-38dc-4671-9ebc-24ef1cd492cb",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "I s'pose we'd better clean the kitchen, but we had much rather not do anything right now."
                                            },
                                            {
                                                "example_id": "fef32885-b769-4b6a-8e8f-c4f65b5d4061",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "Tomorrow's impossible. We'd rather you came next weekend."
                                            },
                                            {
                                                "example_id": "28297418-812d-4248-89ef-724c1091feb2",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "I'd rather not have spent all the money, but it really was an emergency."
                                            },
                                            {
                                                "example_id": "8651f868-e047-4a08-93b4-404591b5be21",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "I would like this one rather than the other one."
                                            },
                                            {
                                                "example_id": "25c1a0f3-2dce-44be-b6fc-186eb0d74c96",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "Firstly, I continue to base most species treatments on personally collected material, rather than on herbarium plants."
                                            },
                                            {
                                                "example_id": "0c25c80d-c580-4282-a9d3-cb8031637e52",
                                                "sense_id": "1ceb6583-9c8f-3bd7-888f-d4fa7dfc54a4",
                                                "text": "I'd rather dance with you than talk with you / So why don't we just move into the other room"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ad0e3f-4a8c-31b9-8a9e-def6efc738bd",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "Used to introduce a contradiction; on the contrary."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b68130dc-b292-4c2f-a670-687ebc05286e",
                                                "sense_id": "a6ad0e3f-4a8c-31b9-8a9e-def6efc738bd",
                                                "text": "It wasn't supposed to be popular; rather, it was supposed to get the job done."
                                            },
                                            {
                                                "example_id": "8bfc92a5-70c1-4c93-a3c1-055934060d6e",
                                                "sense_id": "a6ad0e3f-4a8c-31b9-8a9e-def6efc738bd",
                                                "text": "She didn't go along, but rather went home instead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "Introducing a qualification or clarification; more precisely. (Now usually preceded by or.)"
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c292e80b-ea09-4d07-8388-39aeb83b0332",
                                                "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                                "text": "What the pupil already knew was indeed rather taken for granted than expressed, but it performed the useful function of transcending all textbooks, and supplanting all studies."
                                            },
                                            {
                                                "example_id": "8279c8eb-4516-48da-9e59-054180cf5cd1",
                                                "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                                "text": "1898, J. A. Hamilton, \"Stanley, Edward George Geoffrey Smith\", in Sidney Lee (Ed.), Dictionary of National Biography, Volume LIV: Stanhope–Stovin, The MacMillan Company, page 60,\nHis ‘Iliad’ is spirited and polished, and, though often rather a paraphrase than a translation, is always more truly poetic than most of the best translations."
                                            },
                                            {
                                                "example_id": "35fffaf1-35d2-4c2c-8218-9b8e7501acc2",
                                                "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                                "text": "All this was extraordinarily distasteful to Churchill.[…]Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connection—or rather as a transition from the subject that had started their conversation—such talk had been distressingly out of place."
                                            },
                                            {
                                                "example_id": "a0a5e332-7e2e-4275-948b-5cfe9b7a97e8",
                                                "sense_id": "9e49cd2b-90f8-3a63-89c2-589d5d3f5fdc",
                                                "text": "I didn't want to leave. Or rather I did, just not alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "Somewhat, quite; to an unexpected degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac05a5f9-8ad8-40e0-8485-d1a3dd59f5c7",
                                                "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                                "text": "It's been rather/quite a good meal overall, but this melon is rather too tasteless."
                                            },
                                            {
                                                "example_id": "761e0f4c-81ae-4100-bb7a-2f3f3e8c8dd3",
                                                "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                                "text": "We had some rather worse news today."
                                            },
                                            {
                                                "example_id": "50b8286a-129e-4b14-a946-0f408f3774fe",
                                                "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                                "text": "We’ll be seeing rather a lot of you over the next few days."
                                            },
                                            {
                                                "example_id": "e354a8d8-964a-4794-8583-14b0075beead",
                                                "sense_id": "d203acef-531f-30d8-b0d5-a44aebb25c36",
                                                "text": "I'd rather like a cup of tea. - Oh, would you? I'd rather have a mug of beer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ebde4dd-d742-350c-bb6d-c6c9c93bd3a6",
                                        "entry_id": "f330b719-879f-3ead-a584-a8ffcd80906d",
                                        "glosses": [
                                            "More quickly."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d53d710-1d9e-4e42-a891-14768be490d4",
                                                "sense_id": "4ebde4dd-d742-350c-bb6d-c6c9c93bd3a6",
                                                "text": "Pompey, being elated and filled with confidence by this victory, made all haste to engage Sertorius himself, and the rather lest Metellus should come in for a share in the honour of the victory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rather",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38a6c378-f6cb-3dc0-8a6f-7883a5ed1eba",
                                        "entry_id": "72ebcd8d-043c-3046-bb47-10e251334349",
