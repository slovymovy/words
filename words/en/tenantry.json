{
    "word_family": [
        "tenant",
        "tenancy",
        "tenantable",
        "untenantable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19459809-5a18-3040-aa98-6686696424fb",
                    "sense_definition": "The tenants of an estate or property considered collectively as a group.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The landlord invited the local <w>tenantry</w> to a banquet to celebrate the annual harvest.",
                            "target_lang_translations": {
                                "nl": "De landheer nodigde de plaatselijke <w>pachters</w> uit voor een banket om de jaarlijkse oogst te vieren."
                            }
                        },
                        {
                            "text": "Widespread poverty among the <w>tenantry</w> led to protests across the rural countryside.",
                            "target_lang_translations": {
                                "nl": "Wijdverbreide armoede onder de <w>pachtersstand</w> leidde tot protesten op het platteland."
                            }
                        }
                    ],
                    "common_phrases": [
                        "local tenantry",
                        "rural tenantry"
                    ],
                    "target_lang_definitions": {
                        "nl": "De huurders of pachters van een landgoed of eigendom gezamenlijk beschouwd als een groep."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "de pachters",
                                "target_lang_sense_clarification": "als groep van landpachters"
                            },
                            {
                                "target_lang_word": "de huurders",
                                "target_lang_sense_clarification": "als groep van bewoners of gebruikers"
                            },
                            {
                                "target_lang_word": "pachtersstand",
                                "target_lang_sense_clarification": "de stand of gezamenlijke groep van pachters"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a008434e-1cf4-3a85-8858-f9b609ef6504",
                    "sense_definition": "The state, condition, or period of being a tenant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were never painted during my <w>tenantry</w>, becoming dingier and dingier as the years went by.",
                            "target_lang_translations": {
                                "nl": "De muren werden nooit geverfd tijdens mijn <w>huurtijd</w>, waardoor ze in de loop der jaren steeds valer werden."
                            }
                        },
                        {
                            "text": "Throughout his brief <w>tenantry</w>, he maintained the cottage and garden in excellent condition.",
                            "target_lang_translations": {
                                "nl": "Gedurende zijn korte <w>huurperiode</w> hield hij het huisje en de tuin in uitstekende staat."
                            }
                        }
                    ],
                    "synonyms": [
                        "tenantship"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used; tenancy is the standard modern term."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De toestand, voorwaarde of periode van het huurder- of pachter-zijn."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "huurtijd",
                                "target_lang_sense_clarification": "periode van huur"
                            },
                            {
                                "target_lang_word": "huurschap",
                                "target_lang_sense_clarification": "status of toestand als huurder"
                            },
                            {
                                "target_lang_word": "pachtperiode",
                                "target_lang_sense_clarification": "periode van pachten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}