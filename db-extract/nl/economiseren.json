                                    {
                                        "sense_id": "c0d10321-c42b-38e0-8b49-f6ee646f370f",
                                        "entry_id": "5561c9ee-c3c3-3dd2-acc5-e2f6a87bb0a1",
                                        "glosses": [
                                            "Dépenser avec ménagement, avec le souci d’épargner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871dfd62-6526-44aa-9635-f9b125445994",
                                                "sense_id": "c0d10321-c42b-38e0-8b49-f6ee646f370f",
                                                "text": "Il a bien économisé les revenus de cette terre."
                                            },
                                            {
                                                "example_id": "cc179ee0-cbcd-47cf-a082-b1ed4b02e8c5",
                                                "sense_id": "c0d10321-c42b-38e0-8b49-f6ee646f370f",
                                                "text": "Économiser le bois, la lumière."
                                            },
                                            {
                                                "example_id": "c6e79b71-d8b6-4e9d-ba06-9b114565e36b",
                                                "sense_id": "c0d10321-c42b-38e0-8b49-f6ee646f370f",
                                                "text": "Il est de pauvres vieux qui se couchent à quatre heures du soir, au mois de décembre, pour économiser la chandelle !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f78eb1-195c-39a0-8338-d1efc912c411",
                                        "entry_id": "5561c9ee-c3c3-3dd2-acc5-e2f6a87bb0a1",
                                        "glosses": [
                                            "Préserver, en parlant de personnes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba246c5-d961-4154-922e-53e835a8589a",
                                                "sense_id": "95f78eb1-195c-39a0-8338-d1efc912c411",
                                                "text": "Se souvenant de la fatigue qui l'avait assommée, pour ne point y succomber, elle s’injectait de la volonté. Toutefois, pour s’économiser, elle ralentit l'allure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09c5f853-6907-3798-9946-06f738357643",
                                        "entry_id": "5561c9ee-c3c3-3dd2-acc5-e2f6a87bb0a1",
                                        "glosses": [
                                            "Faire des économies."
                                        ],
