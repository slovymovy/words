                                        "glosses": [
                                            "A small flask for carrying gunpowder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1addd1f3-37aa-4453-b92e-4b95d27b82b9",
                        "source_entry_id": "832cb023-00a8-3450-b8af-add39cae32be",
                        "source_sense_description": "помещение",
                        "target_lang_word": "powder room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "powder room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7cac458-872e-33e4-b9df-e74c9eda1fb8",
                                        "entry_id": "900a9dba-faa7-3591-8ab6-c128be1afc2a",
                                        "glosses": [
                                            "Synonym of ladies' room: a lavatory intended for use by women."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982db0c7-05d7-4c50-8e62-104466dcfd18",
                                                "sense_id": "e7cac458-872e-33e4-b9df-e74c9eda1fb8",
                                                "text": "If you'll excuse me, I need to visit the powder room to see a man about a dog."
                                            },
                                            {
                                                "example_id": "cd093c26-ecc2-48df-8364-7253da8b1f8d",
                                                "sense_id": "e7cac458-872e-33e4-b9df-e74c9eda1fb8",
                                                "text": "They are the authors of the small powder room in the Hofbrau House at Broadway and Fifty-third Street, New York, a very modern creation."
                                            },
                                            {
                                                "example_id": "d2a770c8-efce-43c9-b49e-f1db08b12719",
                                                "sense_id": "e7cac458-872e-33e4-b9df-e74c9eda1fb8",
                                                "text": "There are separate lavatories for ladies and gentlemen in each coach and the provision of a special powder room for ladies in the first class is an entirely new feature."
                                            },
                                            {
                                                "example_id": "e2a2021a-9b70-4e4b-abb1-b7be68eaa736",
                                                "sense_id": "e7cac458-872e-33e4-b9df-e74c9eda1fb8",
                                                "text": "Whispers in the powder room / She cries on every tune"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00f1e11a-e851-383e-ba62-555008ff4e03",
                                        "entry_id": "900a9dba-faa7-3591-8ab6-c128be1afc2a",
                                        "glosses": [
                                            "Synonym of half bath: a small room with a toilet and sink but no bathtub or shower."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71f2b3a4-ac55-481d-82c3-32a181b8820b",
                                                "sense_id": "00f1e11a-e851-383e-ba62-555008ff4e03",
                                                "text": "The house — four stories high and 22 feet wide — has five bedrooms, three full bathrooms and a powder room, along with three fireplaces and a finished basement with a gym and laundry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e71e3bc-f78f-3990-838f-d1ce69b6c442",
                                        "entry_id": "900a9dba-faa7-3591-8ab6-c128be1afc2a",
                                        "glosses": [
                                            "A room used to store gunpowder, particularly (historical) on a ship equipped with cannon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ebe20e5-493c-446f-a02e-0f4db7e71dee",
                                                "sense_id": "2e71e3bc-f78f-3990-838f-d1ce69b6c442",
                                                "text": "Are you insane? Don't take a candle into the powder room!"
                                            },
                                            {
                                                "example_id": "f5ee358c-6a04-4a40-8d9b-8cc18d1d3aa6",
                                                "sense_id": "2e71e3bc-f78f-3990-838f-d1ce69b6c442",
                                                "text": "Mutiny is a thing of the fatallest nature in all enterprises whatsoever; a thing so incalculable, swift-frightful; not to be dealt with in fright. But mutiny in a Robespierre Convention, above all,—it is like fire seen sputtering in the ship’s powder-room!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f9adb10-fc0e-3b9f-849d-0223f7d669a6",
                                        "entry_id": "900a9dba-faa7-3591-8ab6-c128be1afc2a",
                                        "glosses": [
                                            "A room used to powder hair and wigs."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
