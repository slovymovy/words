                "senses": [
                    {
                        "sense_id": "e547ee53-c8eb-32ea-bb20-3d932d38dd18",
                        "entry_id": "dc54f5b9-28eb-324c-9734-3a525a452c54",
                        "glosses": [
                            "in tropischen Regionen auftretende nicht-venerische Infektionskrankheit aus der Gruppe der tropischen Treponematosen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92bb20a-7208-41f2-90b5-9b751f77df25",
                                "sense_id": "e547ee53-c8eb-32ea-bb20-3d932d38dd18",
                                "text": "„Vermutlich war es der Auslöser jener afrikanischen Hautkrankheit, die unter dem Namen Frambösie bekannt ist und hauptsächlich durch Körperkontakt von nackt miteinander spielenden Kindern übertragen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2cdc549-c4dc-4e22-8dd2-8961986fa18e",
                        "source_entry_id": "dc54f5b9-28eb-324c-9734-3a525a452c54",
                        "source_sense_id": "e547ee53-c8eb-32ea-bb20-3d932d38dd18",
