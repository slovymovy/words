                "senses": [
                    {
                        "sense_id": "8ae4545d-c2ea-32fc-8ec6-c29db8f5d7d3",
                        "entry_id": "484213a8-476a-3af0-ba94-35ab57db942c",
                        "glosses": [
                            "van een persoon dat deze stug aan zijn eigen ideeën blijft vasthouden zonder zich aan anderen aan te passen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9ce162c-1eb1-4e8c-9fee-ea1bae51a1d4",
                                "sense_id": "8ae4545d-c2ea-32fc-8ec6-c29db8f5d7d3",
                                "text": "De wei bleef er apathisch bij, iedereen stond duidelijk te wachten op Guns N’ Roses. Dat was buiten Chrissie Hynde gerekend. Zij schudde de festivalgangers wakker met een portie pop- en punkrock die door menige hardrocker wellicht als ‘te soft’ werd bestempeld (‘Iedereen zal een hamburger gaan eten tijdens het concert van The Pretenders’, hoorden we een obstinate hardrockliefhebber voorspellen) maar ons vanaf de eerste noot omverblies. Met haar humor, vastbeslotenheid en présence pakte Chrissie het publiek gaandeweg in. Er volgde een salvo van hits, waarvan we vooral een strak gespeeld ‘Message of love’ en een grandioos gezongen ‘I’ll stand by you’ onthouden. Kippenvel."
                            },
                            {
                                "example_id": "f5350129-f573-4d33-bb30-7dcd82f7e017",
                                "sense_id": "8ae4545d-c2ea-32fc-8ec6-c29db8f5d7d3",
                                "text": "De meer ervaren rechercheurs weten vaak het beste hoe ze met een jonge verdachte moeten omgaan, zegt ze. 'Kinderen worden soms wel heel vermanend toegesproken in de verhoorkamer. Er zijn verdachten die obstinaat worden van zo veel autoriteit, terwijl het uiteindelijke doel toch waarheidsvinding is.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b1ddba9-4728-4f22-b790-bb150eff1d42",
                        "source_entry_id": "484213a8-476a-3af0-ba94-35ab57db942c",
                        "source_sense_id": "8ae4545d-c2ea-32fc-8ec6-c29db8f5d7d3",
                        "source_sense_description": "van een persoon dat deze stug aan zijn eigen ideeën blijft vasthouden zonder zich aan anderen aan te passen",
                        "target_lang_word": "obstinate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstinate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "261c2b8a-e40a-369c-9eaf-face94b320e4",
                                        "entry_id": "6e507293-90c3-365a-b14e-b781097a2549",
                                        "glosses": [
                                            "Stubbornly adhering to an opinion, purpose, or course, usually with implied unreasonableness; persistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e6830f-826b-4744-84cc-275678b29c99",
                                                "sense_id": "261c2b8a-e40a-369c-9eaf-face94b320e4",
                                                "text": "From this consideration it is that we have derived the custom, in times of war, to punish […] those who are obstinate to defend a place that by the rules of war is not tenable […]"
                                            },
                                            {
                                                "example_id": "d6102396-742f-42ff-8d83-f9bfb9a11b8c",
                                                "sense_id": "261c2b8a-e40a-369c-9eaf-face94b320e4",
                                                "text": "[…] the junior Osborne was quite as obstinate as the senior: when he wanted a thing, quite as firm in his resolution to get it; and quite as violent when angered, as his father in his most stern moments"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77b7564f-9761-30cc-93ec-c6843feef7ab",
                                        "entry_id": "6e507293-90c3-365a-b14e-b781097a2549",
                                        "glosses": [
                                            "Not easily subdued or removed."
                                        ],
                                        "tags": [
                                            "of inanimate things"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2adf9b9-04f1-4b39-9225-860a03d9759f",
                                                "sense_id": "77b7564f-9761-30cc-93ec-c6843feef7ab",
                                                "text": "1925-29, Mahadev Desai (translator), M.K. Gandhi, The Story of My Experiments with Truth, Part IV, Chapter XXIX,\nNow it happened that Kasturbai […] had again begun getting haemorrhage, and the malady seemed to be obstinate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae82ed82-bce8-3b94-8180-94591f857740",
                                        "entry_id": "6e507293-90c3-365a-b14e-b781097a2549",
                                        "glosses": [
                                            "Typical of an obstinate person; fixed and unmoving."
                                        ],
                                        "tags": [
                                            "of a facial feature"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1df7acbd-e454-4714-8817-688fc5029a15",
                                                "sense_id": "ae82ed82-bce8-3b94-8180-94591f857740",
                                                "text": "He had the same pile of curly hair, but he was clean-shaven with a heavy, obstinate jowl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
