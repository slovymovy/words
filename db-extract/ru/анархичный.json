                    },
                    {
                        "sense_id": "6645e03b-8d3b-3d11-853c-b59921c591ca",
                        "entry_id": "e8cfb036-03a8-335b-a435-2e134662f13d",
                        "glosses": [
                            "разг. неорганизованный, беспорядочный"
                        ],
                        "tags": [],
