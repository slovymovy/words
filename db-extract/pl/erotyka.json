                                    {
                                        "sense_id": "62a34f02-67ee-3177-a6e4-c3dc5336be46",
                                        "entry_id": "e8108111-1a14-35bc-b74b-65b264d3d6cf",
                                        "glosses": [
                                            "a sexual interest in something; an attraction, fetish, etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65d672c4-e63c-4cfc-9cad-155ae0fa9723",
                                                "sense_id": "62a34f02-67ee-3177-a6e4-c3dc5336be46",
                                                "text": "There is a range of fantasies available to all of us in this culture. I think that everyone has a range of possibilities. Nevertheless, we all specialize; we all have preferences. A lot of people have those [sadomasochistic] fantasies cut ^([sic]) it isn't their primary eroticism, or even something they want to try."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fc2450d-4921-4531-bc4e-7e25afa98a1e",
                        "source_entry_id": "119fdd96-9e8d-3a52-8760-a16fdaa22176",
                        "source_sense_id": "9533de9b-b702-3bdb-842e-af2f3cdc98a0",
                        "target_lang_word": "erotika",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erotika",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3f64d5b3-7e7b-3295-9b76-7740a1b9d0a3",
                                        "entry_id": "4c699cf2-73b8-38d5-86fa-27891bb2147b",
                                        "glosses": [
                                            "fyzická láska, smyslnost"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c0920ba-9d98-485b-9f70-b54b86800193",
                                                "sense_id": "3f64d5b3-7e7b-3295-9b76-7740a1b9d0a3",
                                                "text": "Láska je základem života a erotika je jádrem lásky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47f6c13b-f5cd-47a7-a0d5-83b6d7f80e2d",
                        "source_entry_id": "119fdd96-9e8d-3a52-8760-a16fdaa22176",
                        "source_sense_id": "9533de9b-b702-3bdb-842e-af2f3cdc98a0",
                        "target_lang_word": "Erotik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erotik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1500a15b-4f32-34cc-a9cf-15c5a2beb490",
                                        "entry_id": "f0099ef9-3316-3a33-8860-d6126c83fb7d",
                                        "glosses": [
                                            "physische und zugleich psychische Anziehungskraft zwischen Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe395d93-b92c-49c5-b738-e9ed76f437e1",
                                                "sense_id": "1500a15b-4f32-34cc-a9cf-15c5a2beb490",
                                                "text": "„Aber wie in einem Gegensatz hierzu empfindet man Goethes Erotik als ein rein immanentes Ereignis und als habe seine Innerlichkeit dessen Kosten gleichsam allein zu tragen; und es ist wundervoll, wie das Reservierte, Selbstsüchtige, ja Rücksichtslose, das mit solchem solipsistischen Erleben der Liebe sich zu verbinden pflegt, bei ihm nie spürbar wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                        "entry_id": "f0099ef9-3316-3a33-8860-d6126c83fb7d",
                                        "glosses": [
                                            "oft nur euphemistisch für: Sex, Sexualität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee21c44-d6a9-4340-93d5-b5216cf9c540",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "In Anzeigen wird Erotik oft nur als Stichwort für alles Mögliche, was mit Sexualität zu tun hat, verwendet."
                                            },
                                            {
                                                "example_id": "2ac74348-afe0-492c-b167-2bfe16c29330",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "„Erotik war ein Gesellschaftsspiel.“"
                                            },
                                            {
                                                "example_id": "210a5384-69c2-4695-a73c-e7cdb1110003",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "„Er habe nichts gegen Erotik im Fernsehen, sagt der Mann, der jahrzehntelang Dozent am Germanistischen Institut der Universität Krakau war und sogar schon für polnische Präsidenten gedolmetscht hat.“"
                                            },
                                            {
                                                "example_id": "b6b70a38-9f15-4a27-b60e-b2aad1f2c9f9",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "„Immerhin hatte er Zeit für die Mitteilung, die azraëlistische Kirche wolle die sakrale Erotik, die im Okzident seit mehreren tausend Jahren verloren gegangen sei, neu begründen.“"
                                            },
                                            {
                                                "example_id": "3df40568-503b-4800-b276-6d3e7603ae81",
                                                "sense_id": "cf1562e3-4228-3d0a-88d1-91012798e2b3",
                                                "text": "„Sie bekam in wenigen Minuten einen kurzen, aber intensiven Lehrkurs in geflüsterter, einfachster Erotik, gegen die ein paar Straßenhunde ein ideales Liebespaar waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3181d15a-1b01-41ed-a496-e1487598bdaa",
                        "source_entry_id": "119fdd96-9e8d-3a52-8760-a16fdaa22176",
                        "source_sense_id": "9533de9b-b702-3bdb-842e-af2f3cdc98a0",
                        "target_lang_word": "эротика",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "эротика",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a57c4292-303b-3e9a-be64-4688d7c207f9",
                                        "entry_id": "11393f9d-94cf-3e19-8544-78cb5be0289e",
                                        "glosses": [
                                            "чувственность, половое влечение, сексуальность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0afba181-48ff-4da1-9654-e7976c40fedc",
                                                "sense_id": "a57c4292-303b-3e9a-be64-4688d7c207f9",
                                                "text": "Книжность, романтизм, изысканность, эротика — вот характерные признаки «александрийской» поэзии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b10730-3e83-312a-a390-fdc04919b4c3",
                                        "entry_id": "11393f9d-94cf-3e19-8544-78cb5be0289e",
                                        "glosses": [
                                            "собир. совокупность всего, что связано с проявлением чувственности, сексуальной привлекательности (во внешности, в манере поведения, в интимных отношениях и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f624deca-1a85-4c2a-8cec-94e4c7cbab72",
                                                "sense_id": "03b10730-3e83-312a-a390-fdc04919b4c3",
                                                "text": "Не девушка, а сплошная эротика — даже этот невинный жест в её исполнении имеет глубокий сексуальный смысл."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d07584-667a-345c-8e34-941ca35d412d",
                                        "entry_id": "11393f9d-94cf-3e19-8544-78cb5be0289e",
                                        "glosses": [
                                            "особое внимание к описанию, изображению обнажённого тела, половых отношений; сексуальная направленность произведений массовой культуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "027bd384-76c2-4b8c-ae5e-5c654946e245",
                                                "sense_id": "69d07584-667a-345c-8e34-941ca35d412d",
                                                "text": "Открылись эротические театры, порнопродукция стала вытеснять искусство, телевидение слишком увлеклось дозволенностью темы и в погоне за зрителем достигло обратного эффекта — эротика на экране стала раздражать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad02910-bdc1-3f33-9c84-a92ce16d1f96",
                                        "entry_id": "11393f9d-94cf-3e19-8544-78cb5be0289e",
                                        "glosses": [
                                            "разг., собир. произведения литературы и искусства, насыщенные чувственностью, посвящённые описанию, изображению проявления полового влечения, сексуальности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133d8e94-e09d-466b-a954-4b07c03afdad",
                                                "sense_id": "1ad02910-bdc1-3f33-9c84-a92ce16d1f96",
                                                "text": "Эротика Брюсова — подражание древним поэтам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
