                                "target_senses": [
                                    {
                                        "sense_id": "e0193b02-e5c4-3384-bd7f-8184c54c92ff",
                                        "entry_id": "bd639d56-c06e-34b4-90bf-25d695802a08",
                                        "glosses": [
