                {
                    "sense_id": "97b5f9f3-0406-3893-9df7-1699b2700017",
                    "sense_definition": "behorend tot jezelf, niet van een ander of gedeeld met anderen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bezit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na lang sparen heb ik eindelijk een <w>eigen</w> auto gekocht.",
                            "target_lang_translations": {
                                "en": "After saving for a long time, I finally bought my <w>own</w> car.",
                                "ru": "После долгих накоплений я наконец-то купил <w>собственный</w> автомобиль."
                            }
                        },
                        {
                            "text": "Veel mensen dromen ervan om ooit een <w>eigen</w> huis te bezitten.",
                            "target_lang_translations": {
                                "en": "Many people dream of one day owning their <w>own</w> house.",
                                "ru": "Многие люди мечтают когда-нибудь владеть <w>своим</w> домом."
                            }
                        }
                    ],
                    "synonyms": [
                        "privé",
                        "persoonlijk"
                    ],
                    "common_phrases": [
                        "eigen huis",
                        "eigen land",
                        "eigen bedrijf"
                    ],
                    "target_lang_definitions": {
                        "en": "belonging to yourself, not to someone else or shared with others",
                        "ru": "принадлежащий самому себе, не чужой и не общий"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "own",
                                "target_lang_sense_clarification": "belonging to oneself"
                            },
                            {
