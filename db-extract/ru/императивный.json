                        ],
                        "form": "императи́вна"
                    },
                    {
                        "form_id": "08768301-ba87-4f0c-8121-93fb524fe490",
                        "entry_id": "9695ad75-0cbc-3975-b6e4-c75050d86b0f",
                        "tags": [
