                ],
                "senses": [
                    {
                        "sense_id": "3a8f9c91-c5d5-3e5a-b198-735e2879e363",
                        "entry_id": "af431a61-e1ad-36e2-b9d1-21972423e591",
                        "glosses": [
                            "Imitation de la manière d’un artiste ou d’un écrivain, soit par jeu, soit à dessein de suggérer la critique des procédés que l’on contrefait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a5316e-e696-4b34-b91a-81464e0b4dda",
                                "sense_id": "3a8f9c91-c5d5-3e5a-b198-735e2879e363",
                                "text": "La Bruyère, au chapitre de la Société et de la Conversation, a fait un agréable pastiche de Montaigne."
                            }
                        ]
                    },
                    {
                        "sense_id": "40361470-75b2-38d2-b942-eb1dc0cb7c54",
                        "entry_id": "af431a61-e1ad-36e2-b9d1-21972423e591",
                        "glosses": [
                            "Imitation du costume, du ton et du style d’une époque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf0bb598-d8eb-4728-8a33-1af8411b7032",
                                "sense_id": "40361470-75b2-38d2-b942-eb1dc0cb7c54",
                                "text": "Un charmant pastiche du XVIIIᵉ siècle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c86ad73c-2d74-4c07-81d0-dd9b73f37ee3",
                        "source_entry_id": "af431a61-e1ad-36e2-b9d1-21972423e591",
