                        "entry_id": "dc2dbbc0-ca9e-3d96-9cac-07b407b7b923",
                        "glosses": [
                            "To surpass in miraculousness."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0c32139c-bae0-40d2-b29c-cb65389a544b",
                                "sense_id": "6eab9d4d-b0a9-3da0-b6da-ddc97652a66e",
                                "text": "Why, to believe this seriously, is to outmiracle the prophecies and miracles themselves."
                            },
                            {
                                "example_id": "2baf988d-270b-44ef-a66a-c91a90b57377",
                                "sense_id": "6eab9d4d-b0a9-3da0-b6da-ddc97652a66e",
                                "text": "As wonders of doctrine, they were hardly likely to outmiracle the Jesuits. They involved no intervention of the divine in the bodies of human individuals."
                            }
                        ]
                    }
