                                        "sense_id": "fcf0c2b5-cbee-35bb-93b1-738dc3bcb2a5",
                                        "entry_id": "701b9b1a-0910-3700-8f99-83b7301e428e",
                                        "glosses": [
                                            "een Japanse kooktechniek, waarbij gesneden vis of vlees wordt gebakken (yaki) in een marinade van sojasaus, waardoor het een speciale glans (teri) krijgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7259b49d-c75b-4fff-9ab8-874feccc25dc",
                                                "sense_id": "fcf0c2b5-cbee-35bb-93b1-738dc3bcb2a5",
                                                "text": "De bond legde voor het onderzoek twintig huismerken van vijf supermarkten en 52 producten van A-merken naast elkaar. Zo blijkt de teriyaki-woksaus van Fair Trade Original zeven suikerklontjes te bevatten, terwijl in die van Go-Tan omgerekend anderhalf suikerklontje zit."
                                            },
                                            {
                                                "example_id": "e285d481-c0cd-4634-99dd-f16e6ed6586a",
                                                "sense_id": "fcf0c2b5-cbee-35bb-93b1-738dc3bcb2a5",
                                                "text": "Een mager kipgerecht met een knipoog naar de Aziatische keuken. De teriyakisaus komt ditmaal niet uit pot, maar maken we zelf met verse ingrediënten."
                                            }
                                        ]
                                    }
                                ]
                            }
