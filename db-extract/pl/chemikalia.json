                        "sense_id": "9dc765b0-ca3c-3a93-881f-0fe07d22a17b",
                        "entry_id": "69889148-ff2b-37aa-b91f-899a6b5e6c01",
                        "glosses": [
                            "preparaty, odczynniki i inne substancje chemiczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe478d7c-3bf0-48eb-9408-f4c4c3e3e714",
                                "sense_id": "9dc765b0-ca3c-3a93-881f-0fe07d22a17b",
                                "text": "Jak na razie, za wykorzystywanie seksualne więźniów, bicie, polewanie ich chemikaliami i zimną wodą oraz rażenie prądem amerykańskie dowództwo ukarało żołnierzy oficjalną naganą"
                            }
