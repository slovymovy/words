                "senses": [
                    {
                        "sense_id": "415aebd0-f457-3e20-8b78-9bed8f2b54d8",
                        "entry_id": "088833e7-988c-365d-962b-a571fdfdf0af",
                        "glosses": [
                            "mad, insane, crazy, senseless, out of one's mind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1916b788-03ee-43b9-9d70-cdef84f5d374",
                                "sense_id": "415aebd0-f457-3e20-8b78-9bed8f2b54d8",
                                "text": "1638, Statenvertaling of the Bible, Galatians 3:1.\nO gij uitzinnige Galaten, wie heeft u betoverd, dat gij der waarheid niet zoudt gehoorzaam zijn ...",
                                "translation": "O foolish Galatians, who hath bewitched you, that ye should not obey the truth ...",
                                "english": "O foolish Galatians, who hath bewitched you, that ye should not obey the truth ..."
                            },
                            {
                                "example_id": "c5a27445-5f79-4561-be5a-cd74b10ea3ed",
                                "sense_id": "415aebd0-f457-3e20-8b78-9bed8f2b54d8",
                                "text": "De winnende atleet was uitzinnig van vreugde.",
                                "translation": "The victorious athlete was mad for joy.",
                                "english": "The victorious athlete was mad for joy."
                            }
                        ]
                    }
