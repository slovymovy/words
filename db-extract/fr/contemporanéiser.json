                "senses": [
                    {
                        "sense_id": "03f448f4-02f1-357e-9f08-2da737028bc8",
                        "entry_id": "e0f11211-feaa-3584-aa67-d4f64a1f3129",
                        "glosses": [
                            "Donner un caractère contemporain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "314a7092-3c0b-44c4-b82b-27200b50a493",
                                "sense_id": "03f448f4-02f1-357e-9f08-2da737028bc8",
                                "text": "Elle permet au théologien de raconter à neuf, de contemporanéiser la mort de Jésus, d’y intéresser à neuf le lecteur, voire d’en raviver la «passion»."
                            },
                            {
                                "example_id": "34d581e7-0a10-4a8e-a713-ee2436c169f4",
                                "sense_id": "03f448f4-02f1-357e-9f08-2da737028bc8",
                                "text": "Si ce détail s’inscrit clairement en faux par rapport à la temporalité du panoramique introductif, il confirme en revanche la volonté de contemporanéiser le propos général en l’inscrivant dans la réalité de 1937."
                            }
                        ]
                    }
