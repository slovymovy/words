                                        "sense_id": "1ca9a6a4-69c7-3730-8951-31a279581805",
                                        "entry_id": "946615e7-f125-36f9-85b8-5c25f4c3ecdb",
                                        "glosses": [
                                            "acht Kanten aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05153003-f654-4796-8c61-0b5ba1f1266b",
                                                "sense_id": "1ca9a6a4-69c7-3730-8951-31a279581805",
                                                "text": "„Untergebracht ist der achtkantige Klotz in einer klimatisierten Betonhöhle, die 50 Meter unter der Erde liegt.“"
                                            },
                                            {
                                                "example_id": "5e80b47a-4132-4577-93ad-4640e3edaedd",
                                                "sense_id": "1ca9a6a4-69c7-3730-8951-31a279581805",
                                                "text": "„Rundum wird der Raum von schlanken achtkantigen Säulen aus Gusseisen gestützt.“"
                                            }
                                        ],
