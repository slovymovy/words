    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b5e0f7da-deee-32b8-beac-acd360de4b5a",
                    "sense_definition": "sich von einem Ort hierher bewegen und ankommen",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Freund <w>kommt</w> heute um acht Uhr am Hauptbahnhof an."
                        },
                        {
                            "text": "Er <w>kam</w> gestern nach einer langen Reise sehr spät nach Hause."
                        }
                    ],
                    "synonyms": [
                        "eintreffen"
                    ],
                    "antonyms": [
                        "gehen",
                        "weggehen"
                    ],
                    "common_phrases": [
                        "nach Hause kommen",
                        "zu spät kommen",
                        "pünktlich kommen"
                    ]
                },
                {
                    "sense_id": "22b7e2ae-cfc1-3385-8643-92f694a2929d",
                    "sense_definition": "seine Herkunft an einem bestimmten Ort oder in einer Familie haben",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "herkunft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele meiner Kollegen <w>kommen</w> aus verschiedenen Ländern Europas."
                        },
                        {
                            "text": "Sie <w>kam</w> aus einer angesehenen Familie von Musikern und Ärzten."
                        }
                    ],
                    "common_phrases": [
                        "aus Deutschland kommen",
                        "von weit her kommen"
                    ]
                },
                {
                    "sense_id": "2f5a192c-a630-3ef9-8b99-24788560247c",
                    "sense_definition": "zu jemandem hingehen oder an einer Feier oder Versammlung teilnehmen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "besuch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kommst</w> du morgen Abend auch zu meiner Geburtstagsparty?"
                        },
                        {
                            "text": "Am Wochenende <w>kamen</w> viele Gäste zum Fest in den Garten."
                        }
                    ],
                    "synonyms": [
                        "hingehen",
                        "einfinden"
                    ],
                    "antonyms": [
                        "abreisen",
                        "gehen"
                    ],
                    "common_phrases": [
                        "zu Besuch kommen",
                        "zur Party kommen"
                    ]
                },
                {
                    "sense_id": "64d67c51-ac52-37f8-a2d0-91db182e9f95",
                    "sense_definition": "im Imperativ verwendet, um jemanden zu ermuntern oder anzutreiben",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aufforderung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ach <w>komm</w>, das wird doch sicher gar nicht so schlimm werden."
                        },
                        {
                            "text": "<w>Kommt</w>, wir beeilen uns ein wenig, sonst verpassen wir den Bus!"
                        }
                    ],
                    "common_phrases": [
                        "komm schon",
                        "komm mal her"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "in der Umgangssprache als Aufforderungspartikel genutzt"
