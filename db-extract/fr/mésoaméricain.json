                "senses": [
                    {
                        "sense_id": "1a0f9a39-ac99-3d82-8e0d-9c5016532661",
                        "entry_id": "e8668630-b1f4-3d9c-b3fc-0427f8cacbf1",
                        "glosses": [
                            "Relatif à la partie du continent américain sous domination ou sous influence aztèque en histoire précolombienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cdf007f-6826-4219-b7d0-19c132a34684",
                                "sense_id": "1a0f9a39-ac99-3d82-8e0d-9c5016532661",
                                "text": "Les religions mésoaméricaines présentent des points communs caractéristiques dont les plus emblématiques sont la construction de pyramides à degrés et le rite des sacrifices humains."
                            }
                        ]
                    },
                    {
                        "sense_id": "57909b17-a3be-3780-9fa7-313865649caa",
                        "entry_id": "e8668630-b1f4-3d9c-b3fc-0427f8cacbf1",
                        "glosses": [
                            "Relatif à la Mésoamérique, partie des Amériques qui va du tiers sud du Mexique au Costa Rica, en incluant le Belize, le Guatemala, l’ouest du Honduras, le Salvador et le versant pacifique du Nicaragua."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9632c621-4dc0-4045-aaf8-a969768a54e6",
                                "sense_id": "57909b17-a3be-3780-9fa7-313865649caa",
                                "text": "Elle a donc réalisé des images syncrétiques, mêlant des références issues des cultures européenne, mésoaméricaine et orientale puisqu’elle a développé dès les années 1940 une recherche poussée sur l’hindouisme, le bouddhisme et le taoïsme."
                            }
                        ]
                    }
