                    {
                        "sense_id": "3db3bff5-0d92-3154-9b9d-063850562899",
                        "entry_id": "9f056f14-174b-3179-ae3c-804fc651434a",
                        "glosses": [
                            "Relatif à l’hydrologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a17340-e9d7-4ee3-8f33-f245cbe08846",
                                "sense_id": "3db3bff5-0d92-3154-9b9d-063850562899",
                                "text": "Études hydrologiques."
                            },
                            {
                                "example_id": "9d83fb95-946f-4c18-93ef-b515ee1d094b",
                                "sense_id": "3db3bff5-0d92-3154-9b9d-063850562899",
                                "text": "Pour que ces épidémies si spéciales et si terribles éclatent dans une contrée, il est besoin de conditions générales, climatériques, météorologiques, hydrologiques, ou, comme on dit, géodynamiques, dont tout signale l’existence, bien qu’aucune recherche n’en ait encore révélé la nature."
                            }
                        ]
                    },
                    {
                        "sense_id": "34caf108-d544-3181-8984-edecb64415a9",
                        "entry_id": "9f056f14-174b-3179-ae3c-804fc651434a",
                        "glosses": [
                            "Relatif à l’hydrologie de corps planétaire où le fluide n’est pas de l’eau, mais se comporte de façon similaire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ab102144-63c3-4409-b31c-51e7800b8c5a",
                                "sense_id": "34caf108-d544-3181-8984-edecb64415a9",
                                "text": "Véritable petite planète, [Titan] est en effet le seul corps extraterrestre connu à posséder un cycle hydrologique, avec nuages, lacs et mers, et pluie."
                            }
                        ]
                    }
