                "translations": [
                    {
                        "translation_id": "abfa23cd-4df2-46f5-8bf9-bff638b03481",
                        "source_entry_id": "8706fbae-3773-35e5-a249-6161afbcf258",
                        "source_sense_description": "неаккуратный человек; неряха, грязнуля",
                        "target_lang_word": "souillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "souillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                        "entry_id": "ad167be4-6fae-3791-8458-ef2616dd1956",
                                        "glosses": [
                                            "Celui, celle qui tache, qui salit ses vêtements, qui est malpropre."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc676744-581a-452d-82a6-78cf4a17d0c6",
                                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                                "text": "Un souillon."
                                            },
                                            {
                                                "example_id": "8df9d2c6-e19a-4ab2-8982-27081f881bac",
                                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                                "text": "Une petite souillon."
                                            },
                                            {
                                                "example_id": "761f7d4e-0161-45d9-998d-2192e72382f6",
                                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                                "text": "Cette petite Mathilde, un souillon d’ingénue, tenait sa loge très sale."
                                            },
                                            {
                                                "example_id": "ed5c1a26-e175-4965-8a1a-57ce02aa1ed6",
                                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                                "text": "Et (on la buvait des yeux, vous comprenez) elle ne fut pas indifférente comme quelqu’un qui se serait forcé à l’indifférence ; elle ne fut pas non plus familière comme une qui serait restée souillon en dedans, non."
                                            },
                                            {
                                                "example_id": "b018362f-56c0-4c51-bc64-75c3b237961f",
                                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                                "text": "Ma mère m’habillait mal et mon père me reprochait d’être mal habillée : je devins une souillon."
                                            },
                                            {
                                                "example_id": "f9bf7cf6-4282-47ec-b7ec-c13cf3e2b8e2",
                                                "sense_id": "f4a161f6-3871-3af4-9737-4852fa45371c",
                                                "text": "Les circonstances avaient si profondément altéré leurs positions que lui aurait certainement semblé à un étranger un parfait gentleman, et sa femme tout à fait une petite souillon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96efa24c-e063-49b4-a825-c61d303b5037",
                        "source_entry_id": "8706fbae-3773-35e5-a249-6161afbcf258",
                        "source_sense_description": "неумелый, плохой художник",
                        "target_lang_word": "barbouilleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbouilleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22f70472-c931-3a9b-a135-72a3179903d6",
                                        "entry_id": "1f420d2e-1feb-3ca8-8021-2ce20bf9ab49",
                                        "glosses": [
                                            "Personne qui barbouille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26503310-d4c4-4e0f-a573-1847b1030d9c",
                                                "sense_id": "22f70472-c931-3a9b-a135-72a3179903d6",
                                                "text": "Dans le contexte culturel de la publication de ce livre, il est observé que, « Les intentions des barbouilleurs nocturnes sont de corsiser les noms des lieux » (Ettori, op. cit. : 360)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb8fe22-39a9-33c3-9833-c878c30bba10",
                                        "entry_id": "1f420d2e-1feb-3ca8-8021-2ce20bf9ab49",
                                        "glosses": [
                                            "Mauvais peintre, mauvais écrivain."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "233ce15e-0992-4cc5-b1a7-800d04b3b59c",
                                                "sense_id": "dfb8fe22-39a9-33c3-9833-c878c30bba10",
                                                "text": "Ce que les romans du dix-septième siècle appelaient le coup de foudre, qui décide du destin du héros et de sa maîtresse, est un mouvement de l\"âme qui, pour avoir été gâté par un nombre infini de barbouilleurs, n\"en existe pas moins dans la nature; …."
                                            },
                                            {
                                                "example_id": "7bea7709-0ca1-40e6-9c5f-51963cc4c235",
                                                "sense_id": "dfb8fe22-39a9-33c3-9833-c878c30bba10",
                                                "text": "Ces peintures, faites par des barbouilleurs de province, prenaient de la barbarie même du travail un aspect hétéroclite et formidable."
                                            },
                                            {
                                                "example_id": "156cb899-970f-4701-9a56-821179f5d615",
                                                "sense_id": "dfb8fe22-39a9-33c3-9833-c878c30bba10",
                                                "text": "La duchesse d’Armonville avait lancé un petit rire énigmatique et, somme toute, puisque par le fait d’un oncle éloigné, mort à propos, le barbouilleur superbe possédait une fortune de trois cent mille francs, il devenait un peu moins ridicule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f649a51b-2160-4117-b673-acf6cad8221f",
                        "source_entry_id": "8706fbae-3773-35e5-a249-6161afbcf258",
                        "source_sense_description": "тот, кто совершает промахи",
                        "target_lang_word": "nul",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c965735e-077f-3e78-9057-3545c7b2e60c",
                                        "entry_id": "ee8d9be6-f532-3ad3-9109-bc59ed4f0c87",
                                        "glosses": [
                                            "Égal à zéro, en parlant d’un nombre, d’une grandeur ou d’une valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "021e60ce-d099-4d62-81f6-8a01ed8f96fd",
                                                "sense_id": "c965735e-077f-3e78-9057-3545c7b2e60c",
                                                "text": "La charge d'un neutron est nulle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2fdc767-c3a4-31ca-8da3-1bab16e75a28",
                                        "entry_id": "ee8d9be6-f532-3ad3-9109-bc59ed4f0c87",
                                        "glosses": [
                                            "Égal à zéro, en parlant d’un nombre, d’une grandeur ou d’une valeur.",
                                            "de norme nulle, ou égal à l’élément neutre d’un groupe additif ou d’un espace vectoriel."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19eaa951-5a66-47aa-ab86-13916fff56d6",
                                                "sense_id": "f2fdc767-c3a4-31ca-8da3-1bab16e75a28",
                                                "text": "Deux vecteurs nuls ont une somme nulle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbfe2bb8-816a-31d9-a3a1-c356b533803f",
                                        "entry_id": "ee8d9be6-f532-3ad3-9109-bc59ed4f0c87",
                                        "glosses": [
                                            "Qui est sans valeur, sans effet, qui se réduit à rien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5d061a8-968f-4514-a8c6-b802a66fdbb1",
                                                "sense_id": "fbfe2bb8-816a-31d9-a3a1-c356b533803f",
                                                "text": "Les capitaines de goélettes m’avaient tous conseillé d'entrer à l’étale de basse mer quand le courant est nul."
                                            },
                                            {
                                                "example_id": "d07f8d14-a995-49df-8fee-e2f5b57d7d40",
                                                "sense_id": "fbfe2bb8-816a-31d9-a3a1-c356b533803f",
                                                "text": "La Grande-Bretagne, qui s’est isolée tout récemment, et a des conditions écologiques relativement uniformes, a un endémisme presque nul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c48517d-77b8-31a2-a1a2-e3b648de622b",
                                        "entry_id": "ee8d9be6-f532-3ad3-9109-bc59ed4f0c87",
                                        "glosses": [
                                            "Il se dit des actes qui, étant contraires aux lois, pour le fond ou dans la forme, sont comme s’ils n’étaient pas, et ne peuvent avoir leur effet."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff7dde6e-1d18-4eb8-be01-0348242147a7",
                                                "sense_id": "0c48517d-77b8-31a2-a1a2-e3b648de622b",
                                                "text": "Élection nulle pour vice de forme."
                                            },
                                            {
                                                "example_id": "738e5ae9-4da1-4829-87a0-e8d7cbd813a9",
                                                "sense_id": "0c48517d-77b8-31a2-a1a2-e3b648de622b",
                                                "text": "Ce testament est nul dans le fond et dans la forme."
                                            },
                                            {
                                                "example_id": "e537a0bc-89c0-446f-9406-b150d5d838ef",
                                                "sense_id": "0c48517d-77b8-31a2-a1a2-e3b648de622b",
                                                "text": "L’arrêt le déclare nul, de nul effet, de nulle valeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20c75d0f-3fc4-3a72-8614-421ed5a48dab",
                                        "entry_id": "ee8d9be6-f532-3ad3-9109-bc59ed4f0c87",
                                        "glosses": [
                                            "Mauvais, de mauvaise qualité, sans intérêt, qui ne vaut rien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cad0b95-308e-4ad0-abbd-36d94a550446",
                                                "sense_id": "20c75d0f-3fc4-3a72-8614-421ed5a48dab",
                                                "text": "Parfois, quand tous ces grotesques tapaient à bras raccourcis sur la République, on voyait ses yeux rire sans que ses lèvres perdissent leur moue d’homme grave. Sa façon recueillie d’écouter, sa complaisance inaltérable lui avaient concilié toutes les sympathies. On le jugeait nul, mais bon enfant."
                                            },
                                            {
                                                "example_id": "4613fd47-6d09-430d-b3b3-22c30a454c44",
                                                "sense_id": "20c75d0f-3fc4-3a72-8614-421ed5a48dab",
                                                "text": "Je sais fort bien qui est Mr Kipling, bien que vous ayez cru bon dans votre \"Étude en rouge\" de me faire passer pour un béotien en décrivant ma culture littéraire comme nulle !"
                                            },
                                            {
                                                "example_id": "51820bf5-e02a-411e-b6d4-dd048f92a9d7",
                                                "sense_id": "20c75d0f-3fc4-3a72-8614-421ed5a48dab",
                                                "text": "— […]. En fait elle est aussi nulle que toi.\nBennett réfléchit quelques temps, en se demandant comment on quantifiait la nullité.\n— Peut-être même encore plus nulle, dit-il au bout d'un moment de réflexion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1abf88f-1e21-30f8-85f8-8b083a7afb1d",
                                        "entry_id": "ed072682-e565-3f49-a60c-1b1b15121623",
                                        "glosses": [
                                            "(Devant un nom) Aucun."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5159482a-ac09-430c-a01f-0fc3d44fb9dd",
                                                "sense_id": "a1abf88f-1e21-30f8-85f8-8b083a7afb1d",
                                                "text": "Nul besoin de la préposition 'à' pour relier le verbe 'pallier' à son complément."
                                            },
                                            {
                                                "example_id": "6703da71-478f-48b1-ad1a-d91120ca2e71",
                                                "sense_id": "a1abf88f-1e21-30f8-85f8-8b083a7afb1d",
                                                "text": "Quoiqu’il résidât dans la ville principale de Mars, Ulfète, nulle cité ne le réclamait comme citoyen."
                                            },
                                            {
                                                "example_id": "fc552e03-36bf-4003-ad95-22ba4a53b518",
                                                "sense_id": "a1abf88f-1e21-30f8-85f8-8b083a7afb1d",
                                                "text": "Dans dix ans, parmi les vestiges de Beaumat, les souffles du vent, les croassements des corbeaux et la chute des pierres retentiront seuls ; nulle oreille humaine ne les entendra et la cloche du village elle-même se taira, fatiguée de tinter seulement pour les morts."
                                            },
                                            {
                                                "example_id": "62e0802a-6f7d-436a-8791-31befdf5dc3d",
                                                "sense_id": "a1abf88f-1e21-30f8-85f8-8b083a7afb1d",
                                                "text": "Les autres s'accroupirent en cercle et quelques-uns se postèrent à mi–chemin du village pour que nul bavard indiscret ne vînt aux nouvelles avant de savoir ce qui motivait ce retour nocturne."
                                            },
                                            {
                                                "example_id": "87703ba3-7ad5-4f28-b9d4-951b20240f87",
                                                "sense_id": "a1abf88f-1e21-30f8-85f8-8b083a7afb1d",
                                                "text": "La vieille route est une fondrière que sauf le « piéton », porteur de la gazette ou de lettres, nul étranger n’emprunte plus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4501f69c-b6bb-3656-8ddb-178a94382ef6",
                                        "entry_id": "1f1c5ec9-92e9-3168-bdd4-a6e027d91ee1",
                                        "glosses": [
                                            "Personne qui est nulle."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1511938c-a245-401d-81c2-4238043d16d9",
                                                "sense_id": "4501f69c-b6bb-3656-8ddb-178a94382ef6",
                                                "text": "Quel nul ! C’est un incapable."
                                            },
                                            {
                                                "example_id": "66be48de-cd39-493a-9537-a2a8ad5448f3",
                                                "sense_id": "4501f69c-b6bb-3656-8ddb-178a94382ef6",
                                                "text": "Oh le nul ! (expression enfantine)"
                                            },
                                            {
                                                "example_id": "eb5a13a1-7dcc-4a76-8a82-293a8a1f123a",
                                                "sense_id": "4501f69c-b6bb-3656-8ddb-178a94382ef6",
                                                "text": "Vous êtes tous des nuls !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a31a850c-ad2f-3444-a908-de621c0f09f1",
                                        "entry_id": "559c2ecb-76f7-3b38-80f0-312a63d079ac",
                                        "glosses": [
                                            "Résultat d’un match ou d’une partie au score à égalité ne permettant pas de départager les joueurs."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23335aed-85f9-4dae-9145-857c5a9e8afa",
                                                "sense_id": "a31a850c-ad2f-3444-a908-de621c0f09f1",
                                                "text": "Mais Auriac en toute fin de rencontre sauva le nul."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nul",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff541b9c-408a-38d2-abc3-a19591079abf",
                                        "entry_id": "71295d82-823f-39f6-8824-0596aaae7bce",
                                        "glosses": [
                                            "ou Personne, aucune personne."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a89c5d-32c6-4d7b-928f-80e6fb2979f2",
                                                "sense_id": "ff541b9c-408a-38d2-abc3-a19591079abf",
                                                "text": "La partie basse de New York ne fut bientôt plus qu’une fournaise d’où nul n’avait chance d’échapper."
                                            },
                                            {
                                                "example_id": "4cd984df-5e97-4327-a1a6-173171e74f63",
                                                "sense_id": "ff541b9c-408a-38d2-abc3-a19591079abf",
                                                "text": "Faites une France très forte, et nul n’osera jamais convoiter ses colonies."
                                            },
                                            {
                                                "example_id": "7cb2aced-5034-4298-9680-d42e8d1c83fc",
                                                "sense_id": "ff541b9c-408a-38d2-abc3-a19591079abf",
                                                "text": "Le canon grondait en avant de nous, comme un orage lointain ; nous entendions cela depuis Toul ; ce n'était pour moi qu'une sorte d'éloquence. Nul parmi nous ne savait rien de la guerre."
                                            },
                                            {
                                                "example_id": "36ba0e90-bb4f-4ca1-b004-f1de3bd66fa0",
                                                "sense_id": "ff541b9c-408a-38d2-abc3-a19591079abf",
                                                "text": "Il contempla son verre où la lumière de la lampe se réfractait et soupira :\n— Nul n'y peut rien!"
                                            },
                                            {
                                                "example_id": "fc0c1ed8-d500-40f4-ae07-c6fe301ce4b7",
                                                "sense_id": "ff541b9c-408a-38d2-abc3-a19591079abf",
                                                "text": "Après cinq semaines d’une navigation harassante, ils étaient enfin arrivés à destination. Mais ça n’était que le début de leur campagne, et nul n’ignorait qu’elle en ait été la partie la plus facile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c7b04e8-cc46-4d34-abf7-3f2ca6402f05",
                        "source_entry_id": "8706fbae-3773-35e5-a249-6161afbcf258",
                        "source_sense_description": "тот, кто совершает промахи",
                        "target_lang_word": "nullité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nullité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d604c262-f62c-3859-97a4-ea4363079032",
                                        "entry_id": "d44d6275-2565-361f-af90-584b0b0ce202",
                                        "glosses": [
                                            "Caractère de ce qui est nul ou sans valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c6d9fc9-2494-4fb5-b2ac-82c1f7674d0f",
                                                "sense_id": "d604c262-f62c-3859-97a4-ea4363079032",
                                                "text": "Elle trembla d'avoir à reconnaître en Julie un cœur désenchanté, une jeune femme à qui l'expérience d'un jour, d'une nuit peut-être, avait suffi pour apprécier la nullité de Victor."
                                            },
                                            {
                                                "example_id": "0780f47b-6507-4eb5-94bc-746855f3f5c4",
                                                "sense_id": "d604c262-f62c-3859-97a4-ea4363079032",
                                                "text": "Il n’avait pas l’air rébarbatif de ces graves personnages qui ne rient jamais, par principe, et dont la nullité se couvre d’un masque sérieux."
                                            },
                                            {
                                                "example_id": "c7048f8f-fb46-4c2f-a381-573423e94b5e",
                                                "sense_id": "d604c262-f62c-3859-97a4-ea4363079032",
                                                "text": "Sa prodigieuse nullité n'avait d'égale que sa politesse que seule la dame des toilettes appréciait encore, bien qu'elle dût subir ses petites entrées une fois par heure et rétablir à chaque fois la propreté des lieux."
                                            },
                                            {
                                                "example_id": "8b9b5d36-a106-4d90-b4f1-f2181aa428fc",
                                                "sense_id": "d604c262-f62c-3859-97a4-ea4363079032",
                                                "text": "— […]. En fait elle est aussi nulle que toi.\nBennett réfléchit quelques temps, en se demandant comment on quantifiait la nullité.\n— Peut-être même encore plus nulle, dit-il au bout d'un moment de réflexion."
                                            },
                                            {
                                                "example_id": "76c8d2d4-773d-4897-bd92-60433a15b27a",
                                                "sense_id": "d604c262-f62c-3859-97a4-ea4363079032",
                                                "text": "« Je suis très content que ces affaires sortent, on vendait des fortunes des trucs effarants de nullité », dénonce un ancien consultant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4743a0-de1c-31ea-83c4-ff07bd0e963e",
                                        "entry_id": "d44d6275-2565-361f-af90-584b0b0ce202",
                                        "glosses": [
                                            "Celui qui est sans aucun mérite, sans aucun talent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90db10c8-df3b-4416-aa0f-2888b7040cbd",
                                                "sense_id": "2b4743a0-de1c-31ea-83c4-ff07bd0e963e",
                                                "text": "Je me dis que, passant une journée avec lui, je verrais bien s'il avait quelque chose dans le ventre. Il ne me fallu pas longtemps pour apercevoir que j'avais affaire à une nullité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9c9a590-56db-3329-ae26-cfcea7e08fad",
                                        "entry_id": "d44d6275-2565-361f-af90-584b0b0ce202",
                                        "glosses": [
                                            "Nature ou qualité intrinsèque d'une personne nulle ou dépourvue d'une quelconque valeur personnelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40cf76a-0645-407d-ab41-e50b09cb671e",
                                                "sense_id": "d9c9a590-56db-3329-ae26-cfcea7e08fad",
                                                "text": "Et cette catastrophe en cours nous amène inévitablement aux mêmes conclusions : incompétence, inorganisation, absence de vision à long terme, improvisation. En résumé : nullité de nos dirigeants, et en particulier de ceux en charge du système de santé français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a514e01-d4aa-3d9d-af8e-596abfbbb233",
                                        "entry_id": "d44d6275-2565-361f-af90-584b0b0ce202",
                                        "glosses": [
                                            "Vice, défaut qui rend un acte nul, de nul effet, sans valeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eaaa8ca-59b1-4c44-994d-74214242f1f7",
                                                "sense_id": "5a514e01-d4aa-3d9d-af8e-596abfbbb233",
                                                "text": "Dans tous les cas où l'action en nullité ou en rescision d'une convention n'est pas limitée à un moindre temps par une loi particulière, cette action dure cinq ans."
                                            },
                                            {
                                                "example_id": "478d5fe6-7b43-406d-9abb-227cda38757d",
                                                "sense_id": "5a514e01-d4aa-3d9d-af8e-596abfbbb233",
                                                "text": "La décision du juge qui prononce la nullité prend le nom d’annulation, elle est en principe rétroactive (…). Il importe de bien distinguer la nullité d'un acte de son annulation par le juge."
                                            },
                                            {
                                                "example_id": "ad3f8513-7c9d-416c-ba74-fb85aa0dde66",
                                                "sense_id": "5a514e01-d4aa-3d9d-af8e-596abfbbb233",
                                                "text": "Et en septembre 2011 un incident procédural se produisit : les aveux du principal suspect, S., mineur au moment des faits, ont été annulés du fait de l’absence d’avocats en garde à vue, et l’intéressé, détenu depuis deux ans, a été remis en liberté par la Cour de cassation à la suite d’une nullité de procédure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nullité",
                                "target_lang_code": "fr",
