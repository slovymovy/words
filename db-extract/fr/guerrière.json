                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warrior",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63cca0dd-1a30-3318-884e-9a86be96f547",
                                        "entry_id": "08a41d82-fbf5-30d7-b99d-dccffd9e3700",
                                        "glosses": [
                                            "A person who is actively engaged in battle, conflict or warfare; a soldier or combatant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee1d032e-5c09-43e9-85a9-7ecbb6d6148c",
                                                "sense_id": "63cca0dd-1a30-3318-884e-9a86be96f547",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            },
                                            {
                                                "example_id": "7ba8db62-6ad4-45b6-9b1c-f8a010b926b9",
                                                "sense_id": "63cca0dd-1a30-3318-884e-9a86be96f547",
                                                "text": "[Link:] Gee, it sure is boring around here.\n [King Harkinian:] My boy, this peace is what all true warriors strive for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "434aba44-e3e8-341b-99d0-8ffeb7a152d9",
                                        "entry_id": "08a41d82-fbf5-30d7-b99d-dccffd9e3700",
                                        "glosses": [
                                            "A person who is aggressively, courageously, or energetically involved in an activity, such as athletics."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43d31e1a-459b-4c12-bdda-54d71695d4f0",
                        "source_entry_id": "b63adb4d-307b-3c68-98a7-ce3818daad4e",
                        "source_sense_id": "4c7b7633-64d8-332a-8d93-3358a91ae664",
                        "source_sense_description": "Celle qui fait la guerre",
                        "target_lang_word": "warrioress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warrioress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69f4104f-f067-384e-937f-214c8270a8f1",
                                        "entry_id": "4d6df0ea-fd0d-3f2a-b623-208e6a6bcef1",
                                        "glosses": [
                                            "A female warrior."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c3e2ff8-fc34-4779-860a-7ff713a3993a",
                                                "sense_id": "69f4104f-f067-384e-937f-214c8270a8f1",
                                                "text": "Eftsoones that warriouresse with haughty crest / Did forth issue all ready for the fight […]."
                                            },
                                            {
                                                "example_id": "3639d6c9-c365-4de0-a5b6-f8a9cbccd777",
                                                "sense_id": "69f4104f-f067-384e-937f-214c8270a8f1",
                                                "text": "\"[...] which furnished the battery just below our stand, and which, as soon as the unwieldy old warrioress had occupied the post of honor reserved for her in their midst, sent forth a martial acclaim of welcome that made the earth tremble under our feet, and resounded through the air, shivering, with the strong concussion, more than one pane of glass in the windows of Princess Street far below.\""
                                            },
                                            {
                                                "example_id": "d758384d-aaa1-4d9a-ab04-f142bcd23476",
                                                "sense_id": "69f4104f-f067-384e-937f-214c8270a8f1",
                                                "text": "You can partially or totally ignore the situation for a short while longer, you can become immobilised with fear, or you can become an urban warrior (or warrioress) and groove on the greatest, most spectacular tragicomic, science-'fiction' drama ever enacted on this planet (probably) until the lights go out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
