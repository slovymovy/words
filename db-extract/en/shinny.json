                "senses": [
                    {
                        "sense_id": "1f85fd2b-f3c5-3cf6-b453-9bb2e5c056b2",
                        "entry_id": "734efb60-71a8-364e-9b3f-e2d3533ac6c2",
                        "glosses": [
                            "An informal game of pickup hockey played with minimal equipment: skates, sticks and a puck or ball."
                        ],
                        "tags": [
                            "Canada",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5c95828c-ade1-4ad5-81cd-aa6e13358e99",
                                "sense_id": "1f85fd2b-f3c5-3cf6-b453-9bb2e5c056b2",
                                "text": "In shinny, everyone wins. Though rules are scaled back, the game is not loosened beyond all form, and the driving competitive element remains."
                            },
                            {
                                "example_id": "6539674b-cc39-49bc-a27f-a3517a1e7f23",
                                "sense_id": "1f85fd2b-f3c5-3cf6-b453-9bb2e5c056b2",
                                "text": "Hockey fiction shows that the focus on ludus in organized hockey threatens to strangle the primal play spirit, which is why shinny is more easily romanticized than versions of the game that seem to require fighting, that motivate parents to violence, and, at the highest level, give rise to lockouts and strikes. In shinny the playful core of hockey is retained, while the overly confining rules and restrictions are discarded."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5c80911-acab-3b34-9f7e-89b9ea91bba0",
