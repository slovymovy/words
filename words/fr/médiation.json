    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ca9b48c-b63a-3f2c-9d51-01a79e1d6792",
                    "sense_definition": "Entremise destinée à concilier des personnes ou des groupes en désaccord.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conciliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a proposé une <w>médiation</w> pour régler ce conflit entre les deux employés."
                        },
                        {
                            "text": "Grâce à la <w>médiation</w> d'un ami commun, ils ont enfin recommencé à se parler."
                        }
                    ],
                    "synonyms": [
                        "conciliation",
                        "entremise",
                        "intercession"
                    ],
                    "common_phrases": [
                        "proposer une médiation",
                        "accepter une médiation"
                    ]
                },
                {
                    "sense_id": "b5a0b85d-516d-3304-880e-f7f5ff15541d",
                    "sense_definition": "Procédure amiable de résolution d'un litige, souvent préalable ou alternative à une action en justice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux entreprises ont entamé une procédure de <w>médiation</w> pour éviter un long procès."
                        },
                        {
                            "text": "Le client mécontent a décidé de faire une demande de <w>médiation</w> auprès du service compétent."
                        }
                    ],
                    "synonyms": [
                        "conciliation"
                    ],
                    "common_phrases": [
                        "médiation judiciaire",
                        "procédure de médiation",
                        "demande de médiation"
                    ]
                },
                {
                    "sense_id": "ee777c8b-293a-33cd-8d74-55dc50c56885",
                    "sense_definition": "Ensemble d'actions visant à faciliter l'accès du public aux œuvres et aux institutions artistiques ou culturelles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce musée organise des ateliers de <w>médiation</w> culturelle pour les groupes scolaires de la région."
                        },
                        {
                            "text": "Elle travaille dans la <w>médiation</w> afin de rendre l'art contemporain plus accessible à tous."
                        }
                    ],
                    "common_phrases": [
                        "médiation culturelle"
                    ]
                },
                {
                    "sense_id": "57433abd-26ec-3d32-bf8b-dd3517c0c1ef",
                    "sense_definition": "Moyen ou intermédiaire par lequel une réalité, une idée ou un message est transmis ou rendu accessible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'apprentissage d'une langue passe nécessairement par la <w>médiation</w> de symboles et de concepts partagés."
                        },
                        {
                            "text": "Selon ce philosophe, toute connaissance du monde extérieur s'opère par la <w>médiation</w> des sens."
                        }
                    ],
                    "synonyms": [
                        "intermédiaire"
                    ],
                    "common_phrases": [
                        "par la médiation de"
                    ]
                }
            ]
        }
    ]
