                    {
                        "translation_id": "80441a3c-776a-4fc8-87bd-507ef7b40dc3",
                        "source_entry_id": "0a0421a7-f292-356f-8fe3-71f75486cb36",
                        "source_sense_id": "3bca9697-db08-3af4-9261-8406182906c5",
                        "source_sense_description": "stof",
                        "target_lang_word": "mutagène",
                        "target_lang_code": "fr",
