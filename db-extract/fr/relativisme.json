                        "entry_id": "57349820-aaaf-370b-bb5b-e59901a9477a",
                        "glosses": [
                            "Doctrine où les valeurs sont relatives aux circonstances et variables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87afd65e-408f-418a-9b48-16ed6d25050c",
                                "sense_id": "1d56957e-6175-3b2b-9d29-cdbd3837591d",
                                "text": "Ses ouvrages […] contiennent nombre de pensées inspirées par ce vaillant optimisme matérialiste et orientées contre l’agnosticisme, le relativisme et d'autres variétés d'idéalisme."
                            }
                        ]
                    }
                ],
                "translations": [
