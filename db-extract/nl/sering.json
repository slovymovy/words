                "translations": [
                    {
                        "translation_id": "8f03fd07-367c-41b0-a4ad-55fe42ed3e2f",
                        "source_entry_id": "d469bc12-dfc6-36e0-a2e3-d0f3f12781a7",
                        "source_sense_id": "72df513e-aa4e-36b7-a1f0-004e339bcff2",
                        "source_sense_description": "boomsoort met welriekende bloesem, meest paars of wit in de vorm van een kaars",
                        "target_lang_word": "Flieder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flieder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b826d0b3-8629-3919-a671-c2d6fefee865",
                                        "entry_id": "7064d820-74c6-3825-a162-5e10774c2b82",
                                        "glosses": [
                                            "stark duftender Blütenstrauch aus der Familie der Ölbaumgewächse: Syringa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269a7d78-8f84-4192-8de5-d73e67643c6b",
                                                "sense_id": "b826d0b3-8629-3919-a671-c2d6fefee865",
                                                "text": "In unserem Garten steht ein großer, lilafarbener Flieder."
                                            },
                                            {
                                                "example_id": "60d1a53e-b024-4204-a78a-b5d100a214e0",
                                                "sense_id": "b826d0b3-8629-3919-a671-c2d6fefee865",
                                                "text": "„An einem Bach stand eine verfallene Mühle, von blühendem Flieder umgeben.“"
                                            },
                                            {
                                                "example_id": "0545831d-f254-45ac-83bc-4f08b5834e69",
                                                "sense_id": "b826d0b3-8629-3919-a671-c2d6fefee865",
                                                "text": "„Als sie die große Parkwiese zweimal umschritten hatten, war Cécile müde geworden und nahm auf einer von Flieder und Goldregen überwachsenen Bank PLatz, die zum großen Teil im Schatten lag.“"
                                            },
                                            {
                                                "example_id": "89f4c8a3-d4bc-4ee3-8d06-36f2f1819b1e",
                                                "sense_id": "b826d0b3-8629-3919-a671-c2d6fefee865",
                                                "text": "„Clerfayt sah eine Vase mit weißem Flieder und einen langen Zweig flacher, weißer Orchideen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0210c72c-25c2-3f35-9867-685c3bef3f42",
                                        "entry_id": "7064d820-74c6-3825-a162-5e10774c2b82",
                                        "glosses": [
                                            "Schwarzer Holunder (Sambucus nigra)"
                                        ],
                                        "tags": [
                                            "North German",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0cfb73a-9018-45b1-a853-f65b7f699c94",
                                                "sense_id": "0210c72c-25c2-3f35-9867-685c3bef3f42",
                                                "text": "Im Wegrain steht ein Flieder, wenn die Beeren dunkelblau sind, werde ich sie ernten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1437dccc-d707-4f28-bb8e-526cad898c18",
                        "source_entry_id": "d469bc12-dfc6-36e0-a2e3-d0f3f12781a7",
                        "source_sense_id": "72df513e-aa4e-36b7-a1f0-004e339bcff2",
                        "source_sense_description": "boomsoort met welriekende bloesem, meest paars of wit in de vorm van een kaars",
                        "target_lang_word": "lilac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lilac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbfdeebd-4c54-3c35-8e6b-08604842dc1a",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A large shrub of the genus Syringa, especially Syringa vulgaris, bearing white, pale-pink, or purple flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129e9219-75a3-4df4-8a78-6b0089b6fa66",
                                                "sense_id": "fbfdeebd-4c54-3c35-8e6b-08604842dc1a",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341999fd-4eff-3e50-a505-a48ff3cf66a2",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A flower of the lilac shrub."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fced0e6-1221-4050-8ae9-0643ec0aac6f",
                                                "sense_id": "341999fd-4eff-3e50-a505-a48ff3cf66a2",
                                                "text": "[…] O death, I cover you over with roses and early lilies, / But mostly and now the lilac that blooms the first, / Copious I break, I break the sprigs from the bushes, / With loaded arms I come, pouring for you, / For you and the coffins all of you O death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68dc6f2-ceaf-3d27-8fe1-d6ee9145cdd5",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A pale purple color, the color of some lilac flowers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2980c96-7335-3947-a1aa-41a27edc7a0f",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A cat having a lilac-colored (pale brown) coat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
