                                        "glosses": [
                                            "Celle dont la profession est de vendre."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f96b021-85be-4644-99ff-d576a9fb5138",
                                                "sense_id": "c2573605-512a-3973-bb5b-84474a2a589d",
                                                "text": "Des vendeuses de fruits passaient, leur corbeille pleine dans les bras."
                                            },
                                            {
                                                "example_id": "14e9df82-7e13-4dad-8764-79363740c8e6",
                                                "sense_id": "c2573605-512a-3973-bb5b-84474a2a589d",
                                                "text": "Un après-midi, alors qu’il fait ses courses au centre commercial Leclerc, Georges dont l’attention est portée sur des après-rasages, tout en poussant son caddy, heurte une vendeuse accroupie qui range une étagère."
                                            },
                                            {
                                                "example_id": "548dad44-4ff6-44be-8e18-17f2854ae35d",
                                                "sense_id": "c2573605-512a-3973-bb5b-84474a2a589d",
                                                "text": "Quand elle accompagnait Ruth, dans les friperies de Barbès, elle repartait souvent avec une chemise XXL, espérant que la vendeuse pense que c'était un cadeau pour son père."
                                            }
                                        ]
                                    }
                                ]
