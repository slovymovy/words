{
    "word_family": [
        "boeien",
        "boei",
        "boeier"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d45e665-8ba3-3c19-b14e-d7a407adb079",
                    "sense_definition": "veel aandacht en interesse voor iets of iemand hebben",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De studenten luisterden <w>geboeid</w> naar het spannende verhaal van de docent.",
                            "target_lang_translations": {
                                "en": "The students listened <w>fascinated</w> to the teacher's exciting story."
                            }
                        },
                        {
                            "text": "Zij bleef de hele avond <w>geboeid</w> kijken naar de interessante documentaire.",
                            "target_lang_translations": {
                                "en": "She remained <w>captivated</w> watching the interesting documentary all evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "geïnteresseerd",
                        "gebiologeerd",
                        "gefascineerd"
                    ],
                    "antonyms": [
                        "ongeboeid"
                    ],
                    "common_phrases": [
                        "geboeid luisteren",
                        "geboeid kijken"
                    ],
                    "target_lang_definitions": {
                        "en": "having a lot of attention and interest in something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fascinated",
                                "target_lang_sense_clarification": "extremely interested"
                            },
                            {
                                "target_lang_word": "captivated",
                                "target_lang_sense_clarification": "having one's attention fully captured"
                            },
                            {
                                "target_lang_word": "engrossed",
                                "target_lang_sense_clarification": "deeply interested and giving full attention"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c877f5c-e912-34d5-8e6e-bf3c16b39db0",
                    "sense_definition": "van een persoon dat de handen en/of voeten aan elkaar gebonden zijn zodat die persoon in zijn bewegingen is beperkt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vastgebonden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>geboeide</w> gevangene is door de politie naar een andere gevangenis gebracht.",
                            "target_lang_translations": {
                                "en": "The <w>handcuffed</w> prisoner was taken to another prison by the police."
                            }
                        },
                        {
                            "text": "De verdachte werd <w>geboeid</w> afgevoerd na de achtervolging.",
                            "target_lang_translations": {
                                "en": "The suspect was led away in <w>handcuffs</w> after the chase."
                            }
                        }
                    ],
                    "synonyms": [
                        "geketend",
                        "vastgebonden"
                    ],
                    "antonyms": [
                        "ongeboeid"
                    ],
                    "common_phrases": [
                        "geboeid afgevoerd"
                    ],
                    "target_lang_definitions": {
                        "en": "of a person, having the hands and/or feet bound together so that movement is restricted"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "handcuffed",
                                "target_lang_sense_clarification": "secured with metal cuffs on the wrists"
                            },
                            {
                                "target_lang_word": "shackled",
                                "target_lang_sense_clarification": "bound by chains or fetters"
                            },
                            {
                                "target_lang_word": "bound",
                                "target_lang_sense_clarification": "tied up"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b7e87efd-0c16-3550-b833-86ff50bd3e3d",
                    "sense_definition": "met veel aandacht",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het publiek keek <w>geboeid</w> toe hoe de goochelaar zijn trucs uitvoerde.",
                            "target_lang_translations": {
                                "en": "The audience watched <w>intently</w> as the magician performed his tricks."
                            }
                        },
                        {
                            "text": "Zij volgde de presentatie <w>geboeid</w> vanaf de eerste rij.",
                            "target_lang_translations": {
                                "en": "She followed the presentation <w>raptly</w> from the front row."
                            }
                        }
                    ],
                    "synonyms": [
                        "aandachtig",
                        "gebiologeerd"
                    ],
                    "antonyms": [
                        "ongeboeid"
                    ],
                    "common_phrases": [
                        "geboeid toekijken"
                    ],
                    "target_lang_definitions": {
                        "en": "with great attention or interest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intently",
                                "target_lang_sense_clarification": "with earnest and eager attention"
                            },
                            {
                                "target_lang_word": "with fascination",
                                "target_lang_sense_clarification": "in a captivated manner"
                            },
                            {
                                "target_lang_word": "raptly",
                                "target_lang_sense_clarification": "completely fascinated by what one is seeing or hearing"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea96b23c-4afd-349d-b0a2-4ca7e7263f3b",
                    "sense_definition": "voltooid deelwoord van <w>boeien</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het boek heeft mij van het begin tot het einde <w>geboeid</w>.",
                            "target_lang_translations": {
                                "en": "The book <w>fascinated</w> me from beginning to end."
                            }
                        },
                        {
                            "text": "De politie heeft de verdachte direct op straat <w>geboeid</w>.",
                            "target_lang_translations": {
                                "en": "The police <w>handcuffed</w> the suspect immediately on the street."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of the verb 'boeien' (to fascinate/captivate or to handcuff/bind)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fascinated",
                                "target_lang_sense_clarification": "past participle of fascinate"
                            },
                            {
                                "target_lang_word": "handcuffed",
                                "target_lang_sense_clarification": "past participle of handcuff"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}