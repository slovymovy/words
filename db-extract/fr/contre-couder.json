                "senses": [
                    {
                        "sense_id": "543e502c-84cb-32ce-b7c5-b487be7e2f3a",
                        "entry_id": "33c19ce3-2983-3552-a5f2-0555d8d19a4a",
                        "glosses": [
                            "Couder dans le sens opposé (ce qu’on a déjà coudé dans un sens)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db8bb51c-5f74-49e7-b5ce-c6ede6e01d2b",
                                "sense_id": "543e502c-84cb-32ce-b7c5-b487be7e2f3a",
                                "text": "Amincir la barre, la contourner, couder, contre-couder, 5 angles vifs — fondre le fer;"
                            },
                            {
                                "example_id": "dc111245-eab8-4925-852d-ed775e8e823c",
                                "sense_id": "543e502c-84cb-32ce-b7c5-b487be7e2f3a",
                                "text": "Percer la barre, la plier, la couder et contre-couder en zigzags à angles droits vifs, la contourner en plusieurs sens, la tordre en spirale."
                            },
                            {
                                "example_id": "12247aa8-9bad-4594-8f59-d231f5900a80",
                                "sense_id": "543e502c-84cb-32ce-b7c5-b487be7e2f3a",
                                "text": "Aalis put alors admirer une douzaine de vieux ciseaux à bois à la belle facture, un assortiment de lames droites ou obliques, de gouges contre-coudées, de cuillères et de burins."
                            }
                        ]
                    }
