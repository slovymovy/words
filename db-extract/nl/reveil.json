                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ad87194-35af-3bc6-9c65-8a47f5682660",
                        "entry_id": "e0f44b40-00b8-323e-be15-395e6d5980fc",
                        "glosses": [
                            "opleving of vernieuwing van het geestelijke leven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01b0ccba-2786-4bd7-a0e0-90e49b1ae096",
                                "sense_id": "5ad87194-35af-3bc6-9c65-8a47f5682660",
                                "text": "Eeklo, Lommel, Gent, Deerlijk, Malderen, Londerzeel, Tervuren, Beernem ... in al die gemeenten is er dit jaar op Allerheiligen meer dan chrysanten en heilige stilte. Drie jaar na de eerste editie van kerkhoffestival Reveil zijn er straks op 1 november op meer dan zeventig locaties optredens, met 92 artiesten, meer dan op Rock Werchter: meestal muziek, en hier en daar ook poëzie. Op het programma staan onder anderen Ozark Henry, Isbells, Senne Guns, Jonas Winterland, Maud Vanhauwaert en Jan Swerts."
                            },
                            {
                                "example_id": "839240c5-3673-4cf0-8499-9876e344d70c",
                                "sense_id": "5ad87194-35af-3bc6-9c65-8a47f5682660",
                                "text": "En toen KRO-coryfee Willebrord Frequin destijds PvdA-premier Joop den Uyl toevoegde: ‘Volgens de heer Van Agt kunt u doodvallen’, at Den Uyl zijn handvol pinda’s op om vervolgens te zeggen: ‘Och, ik volg de ontwikkelingen van het ethisch réveil op de voet’."
                            }
                        ]
                    }
