                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5b281d72-4e6f-4a8e-94f3-55eebab0f24b",
                        "entry_id": "ae9d46a2-b865-3e4b-9920-6db78e9cf07e",
                        "tags": [
                            "plural"
                        ],
                        "form": "chalandages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e39d7ff7-c35e-3d56-b87b-9652f1a64704",
                        "entry_id": "ae9d46a2-b865-3e4b-9920-6db78e9cf07e",
                        "glosses": [
                            "Action d’aller dans les magasins pour y effectuer des achats et observer les différents produits vendus."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6ecbd50a-53b8-3a0f-b6f0-30bf5e42be83",
                        "entry_id": "ae9d46a2-b865-3e4b-9920-6db78e9cf07e",
                        "glosses": [
                            "Transport de marchandises par chaland."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9509fba6-8da6-47d1-9330-518b5951e6a9",
                                "sense_id": "6ecbd50a-53b8-3a0f-b6f0-30bf5e42be83",
                                "text": "Peu à peu apparurent : […]; trois sociétés de transport : chalandage, remorquage, tramways."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a827e4f-7ee6-33a1-8c3f-5f5d46b13d88",
                        "entry_id": "ae9d46a2-b865-3e4b-9920-6db78e9cf07e",
                        "glosses": [
                            "Opération de chargement et de déchargement du minerai de nickel entre le port et le cargo minéralier situé au large."
                        ],
                        "tags": [
                            "Nouvelle-Calédonie"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed5adca-1c96-4131-9c3d-c46f7aa61061",
                                "sense_id": "3a827e4f-7ee6-33a1-8c3f-5f5d46b13d88",
                                "text": "Quant aux Kanak, ils se concentrent aux postes du trafic et du chalandage."
                            },
                            {
                                "example_id": "9bc371a4-70c0-468a-b119-ccd6741712d8",
                                "sense_id": "3a827e4f-7ee6-33a1-8c3f-5f5d46b13d88",
                                "text": "Il a dû travailler au nickel ou au chalandage. Il est catéchiste de l'Église catholique."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6f8d561-f983-3062-8aee-050cd46e9ae5",
                        "entry_id": "ae9d46a2-b865-3e4b-9920-6db78e9cf07e",
                        "glosses": [
                            "Exploitation à tour de rôle de différentes parties d’une terre en indivision par les propriétaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fefad2-5dc3-43ad-a1fe-1ffd84608478",
                                "sense_id": "f6f8d561-f983-3062-8aee-050cd46e9ae5",
                                "text": "Les prés changent chaque année d’exploitant. C’est la coutume connue le plus souvent sous le nom de chalandage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5180c64-3042-4ffc-9b21-9f09d5411331",
                        "source_entry_id": "ae9d46a2-b865-3e4b-9920-6db78e9cf07e",
