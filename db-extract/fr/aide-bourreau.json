                        "glosses": [
                            "Personne chargée d’assister un bourreau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bc7757f-23a5-4540-aa2e-92caa34a6fe9",
                                "sense_id": "df414258-3202-34b5-9b83-fc6f27251ff3",
                                "text": "Dans la cour de la prison de la Santé, un aide-bourreau, en salopette, vérifie au niveau à bulle d’air le parallélisme des bois de justice."
                            },
                            {
                                "example_id": "6e2c53ef-8896-4459-9a4a-e93f268e0089",
                                "sense_id": "df414258-3202-34b5-9b83-fc6f27251ff3",
                                "text": "La charrette attendait au bas des marches, encadrée de cinq aides-bourreaux coiffés du bonnet rouge, chaussés de sabots et armés de piques."
                            },
                            {
                                "example_id": "ff648c79-b194-4603-9a30-0a09361471a1",
                                "sense_id": "df414258-3202-34b5-9b83-fc6f27251ff3",
                                "text": "Le plus jeune des aides-bourreaux, Gros, ramassa la tête par les cheveux qui avaient conservé leurs frisures – on eût dit une « tête à perruque » – et par deux fois fit le tour de l’échafaud en la montrant au peuple."
                            }
                        ]
                    }
