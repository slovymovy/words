                ],
                "senses": [
                    {
                        "sense_id": "85cb1e4b-191b-395f-8b79-e509720a5150",
                        "entry_id": "fb9d1e19-de84-38ae-9817-361ea20502ac",
                        "glosses": [
                            "Auteur d’un ouvrage écrit en collaboration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a12a61-ae45-4b2f-a322-e00bf5bda92f",
                                "sense_id": "85cb1e4b-191b-395f-8b79-e509720a5150",
                                "text": "Elle est le co-auteur avec Nadine Dormoy-Savage de « À chacun sa France »."
                            },
                            {
                                "example_id": "bf1f519f-e983-4298-81e9-521e575a5b2d",
                                "sense_id": "85cb1e4b-191b-395f-8b79-e509720a5150",
                                "text": "Il est auteur ou co-auteur de plusieurs ouvrages et chapitres et de plus d’une centaine de publications."
                            },
                            {
                                "example_id": "5eed5126-c32c-47df-b2aa-2f2f67cf5e64",
                                "sense_id": "85cb1e4b-191b-395f-8b79-e509720a5150",
                                "text": "Pour Quentin Müller, co-auteur de Les Esclaves de l’homme-pétrole (éd. Marchialy), « si les gens veulent le regarder, qu’ils le fassent, mais s’ils peuvent garder à l’esprit au prix de quoi elle s’est faite, ça serait bien »."
                            }
                        ]
                    },
                    {
                        "sense_id": "28412a93-41f3-35fa-81e9-4e9684d0d393",
                        "entry_id": "fb9d1e19-de84-38ae-9817-361ea20502ac",
                        "glosses": [
                            "Personne aidant activement l’auteur principal d’un acte criminel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "148aee46-6f87-4bc6-be02-47964a678fbb",
                                "sense_id": "28412a93-41f3-35fa-81e9-4e9684d0d393",
                                "text": "Le co-auteur d’un crime n’est point un complice, dans le sens légal de ce mot; il est un des auteurs du crime, et doit être puni comme tel."
                            },
                            {
                                "example_id": "02b9a803-bc2a-4325-b9e5-46f3ba11a291",
                                "sense_id": "28412a93-41f3-35fa-81e9-4e9684d0d393",
                                "text": "Ce n’est cependant point un acte de co-auteur, puisque ce complice ne prend point part à l’action même du vol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5288ef83-9d98-4ed1-8001-5dbfd2f2d118",
                        "source_entry_id": "fb9d1e19-de84-38ae-9817-361ea20502ac",
                        "target_lang_word": "συσσυγγραφέας",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "συσσυγγραφέας",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "21f46b3a-3960-36c1-aec7-7d3fc1e1431f",
                                        "entry_id": "033e19b0-f962-32ea-bcac-a57341e315c8",
                                        "glosses": [
                                            "αυτός που συγγράφει ένα βιβλίο από κοινού με άλλον συγγραφέα"
                                        ],
                                        "tags": [
                                            "επάγγελμα"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86e0f91d-3600-497a-ada1-973c46ea374a",
                                                "sense_id": "21f46b3a-3960-36c1-aec7-7d3fc1e1431f",
                                                "text": "※ Είναι συγγραφέας της βιογραφίας του Κεμπεκιανού διαφημιστή Ζακ Μπουσάρ και συσσυγγραφέας ενός βιβλίου για τα μέσα κοινωνικής δικτύωσης σε επιχειρήσεις.",
                                                "translation": "«Ξένοι συγγραφείς», ΕΚΔΟΣΕΙΣ GEMA, πρόσβαση: 21. 7. 2025"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f8b802-db33-3b24-ab73-65be0b7cef06",
                                        "entry_id": "033e19b0-f962-32ea-bcac-a57341e315c8",
                                        "glosses": [
                                            "αυτός που συμμετέχει στην παραγωγή οποιουδήποτε έργου, συνεργαζόμενος με έναν ή περισσότερους άλλους"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7d72932-88e0-4d74-8eab-e27faa1970da",
                                                "sense_id": "a4f8b802-db33-3b24-ab73-65be0b7cef06",
                                                "text": "※ Ο Jonathan Mayer, συσσυγγραφέας της μελέτης του Πανεπιστημίου του Stanford εξήγησε ότι: “Δεν περιμέναμε ότι θα βρούμε επαρκή αποδεικτικά στοιχεία. Κάναμε λάθος. Βρήκαμε ότι τα μεταδεδομένα των τηλεφωνικών συνδιαλέξεων αποτελούν δίχως αμφιβολία ευαίσθητα δεδομένα, ακόμη και για ένα μικρό δείγμα του πληθυσμού σε ένα μικρό χρονικό διάστημα αναφοράς.",
                                                "translation": "2014 «Με ποιους τρόπους παρακολουθούνται όλες οι ψηφιακές τηλεπικοινωνίες;», 9. 11. 2014, ipaidia.gr, πρόσβαση: 21. 7. 2025"
                                            },
                                            {
                                                "example_id": "8e353e67-909a-4c09-be14-a37c4a321b72",
                                                "sense_id": "a4f8b802-db33-3b24-ab73-65be0b7cef06",
                                                "text": "※ «Η νευροπάθεια μικρών ινών έχει μια πολύ ισχυρή σχέση με καρδιακές παθήσεις και καρδιακές προσβολές», δήλωσε ο δρ Christopher Klein, καθηγητής Νευρολογίας στην κλινική Mayo και συσσυγγραφέας της μελέτης.",
                                                "translation": "2025 «Νευροπάθεια μικρών ινών - Ποιους απειλεί», 10. 2. 2025, Ελεύθερος τύπος, πρόσβαση: 21. 7. 2025"
                                            },
                                            {
                                                "example_id": "982c14f9-6009-4c6f-b33b-d9f376f4d04c",
                                                "sense_id": "a4f8b802-db33-3b24-ab73-65be0b7cef06",
                                                "text": "※ «Οι γιατροί, και ειδικά οι νευρολόγοι, έχουν μεγαλύτερη επίγνωση αυτής της πάθησης απ’ ό,τι πριν από 10 χρόνια. Ωστόσο, συχνά ξεχνούν να ρωτήσουν γι’ αυτά τα συμπτώματα, επομένως οι ασθενείς πρέπει οπωσδήποτε να τους ενημερώνουν από μόνοι τους», είπε ο δρ Brian Callaghan, συσσυγγραφέας της μελέτης του «Neurology».",
                                                "translation": "2025 «Νευροπάθεια μικρών ινών - Ποιους απειλεί», 10. 2. 2025, Ελεύθερος τύπος, πρόσβαση: 21. 7. 2025"
                                            },
                                            {
                                                "example_id": "bccde0b0-5df7-4538-afc9-6dff728a335e",
                                                "sense_id": "a4f8b802-db33-3b24-ab73-65be0b7cef06",
                                                "text": "συμμελετητής"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
