                ],
                "translations": [
                    {
                        "translation_id": "738343ee-b39c-4648-8640-d0baa34dc441",
                        "source_entry_id": "6d213ce3-a9cd-3373-b757-e0c603e03bfd",
                        "source_sense_id": "a0ca8141-9cc4-3094-9292-def8eded2854",
                        "source_sense_description": "Schuppen/kleine Hütte, in dem/in der Werkzeug untergebracht ist",
                        "target_lang_word": "Werkzeugschuppen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werkzeugschuppen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79ca96e6-e44d-3188-b9e8-4f90950230ae",
                                        "entry_id": "c282927a-69db-322c-af4e-5a884e00a9a6",
                                        "glosses": [
                                            "Schuppen, in dem Werkzeuge aufbewahrt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03995db2-3ebf-4e3a-880a-2ae37eeb6a8c",
                                                "sense_id": "79ca96e6-e44d-3188-b9e8-4f90950230ae",
                                                "text": "„Das Grab des Ezra Weeden, der laut seinem umgestoßenen und schwer beschädigten Granitgrabstein 1740 geboren wurde und 1824 verstarb, fand man ausgehoben und durchwühlt vor, was anscheinend mit einem aus einem anliegenden Werkzeugschuppen gestohlenen Spaten geschehen war.“"
                                            },
                                            {
                                                "example_id": "272304f3-cfcf-441b-97a3-1bc560bd3e00",
                                                "sense_id": "79ca96e6-e44d-3188-b9e8-4f90950230ae",
                                                "text": "„Im Werkzeugschuppen fanden sich drei alte Kanus aus Holz.“"
                                            },
                                            {
                                                "example_id": "36b8be6e-3c69-4e17-a3ce-1bcec53a321d",
                                                "sense_id": "79ca96e6-e44d-3188-b9e8-4f90950230ae",
                                                "text": "„An der Rückseite gab es einen kleinen Werkzeugschuppen, ebenfalls mit einem dicken Vorhängeschloss versehen.“"
                                            },
                                            {
                                                "example_id": "c9621ad3-af2f-45c2-8f37-ac2511734868",
                                                "sense_id": "79ca96e6-e44d-3188-b9e8-4f90950230ae",
                                                "text": "„Auf der Terrasse stand ein Grill: ein mit dem Schweißbrenner der Länge nach aufgeschnittenes und auf ein schmiedeeisernes Gestell gesetztes 200-Liter-Metallfass. Im Garten ein paar tote Bäume. Ein Zaun. Ein Werkzeugschuppen aus Blech.“"
                                            },
                                            {
                                                "example_id": "4bb065a8-bd8a-46d1-a57c-190df1e7017a",
                                                "sense_id": "79ca96e6-e44d-3188-b9e8-4f90950230ae",
                                                "text": "„Chus Leiche lag in einem Werkzeugschuppen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99a7d81b-b972-4711-b2ff-f82e8931cca3",
                        "source_entry_id": "6d213ce3-a9cd-3373-b757-e0c603e03bfd",
                        "source_sense_id": "a0ca8141-9cc4-3094-9292-def8eded2854",
                        "source_sense_description": "Schuppen/kleine Hütte, in dem/in der Werkzeug untergebracht ist",
                        "target_lang_word": "Geräteschuppen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geräteschuppen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef2265de-9fee-3a7f-aeea-cc5194438048",
                                        "entry_id": "730f04da-e0f9-3559-8e95-78cc56e38e99",
                                        "glosses": [
                                            "kleines, einfaches Gebäude zur Unterbringung von Geräten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da1ce0eb-ea1a-4952-b186-9e1ff5f2b14d",
                                                "sense_id": "ef2265de-9fee-3a7f-aeea-cc5194438048",
                                                "text": "„Im Gebüsch verborgen beobachte ich, daß die Hühner für die Nacht in einem Stall eingeschlossen werden, der vom Wohnhaus aus kaum zu sehen ist, weil ein Geräteschuppen sich vor ihn schiebt.“"
                                            },
                                            {
                                                "example_id": "53aff28c-cd32-44ea-bc31-ec6b3f1926f4",
                                                "sense_id": "ef2265de-9fee-3a7f-aeea-cc5194438048",
                                                "text": "„Wegen des Ehebruchs der Tante lebt der Onkel bereits seit sieben Tagen im Hof und hält sich vorwiegend im Geräteschuppen auf.“"
                                            },
                                            {
                                                "example_id": "bbbed8e7-bfe1-44fa-ba2f-7defb43a5dbe",
                                                "sense_id": "ef2265de-9fee-3a7f-aeea-cc5194438048",
                                                "text": "„Der Geräteschuppen und das Vorratshaus, die Backstube und der Holzstall schlossen sich rechtwinklig als zwei niedrigere Flügel an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ab81906-6b7e-4658-94b5-d52c492f295e",
                        "source_entry_id": "6d213ce3-a9cd-3373-b757-e0c603e03bfd",
                        "source_sense_id": "448d8d31-81a6-311b-8b36-65376df88e9b",
                        "source_sense_description": "Hütte im Garten, in der Gartenwerkzeug untergebracht wird",
                        "target_lang_word": "Gartenschuppen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gartenschuppen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e003ed49-2ee6-3ad9-907f-c4d0bbbecdc6",
                                        "entry_id": "de14a57a-476b-39e5-b6c7-84cb2d0afd9d",
                                        "glosses": [
                                            "Schuppen im Garten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "357e1c07-e925-4475-8281-49072cd5f467",
                                                "sense_id": "e003ed49-2ee6-3ad9-907f-c4d0bbbecdc6",
                                                "text": "„Im Gartenschuppen, der eigentlich Teil des Anbaus war, den aber der Gärtner für seine eigenen Zwecke nutzte, hatte ich einen Blumentopf gefunden, in den ich einen Löwenzahn in voller Blüte eingepflanzt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
