                                        "glosses": [
                                            "Boden unter dem Belag eines Fußbodens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b52f813-8c64-4e25-aa17-9dcef4f6b366",
                                                "sense_id": "484fc2f2-9f13-3eaa-b28c-55dbdfacdc6c",
                                                "text": "Das Parkett liegt lose auf dem Unterboden, es wird schwimmend verlegt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
