                        "glacer d'effroi"
                    ]
                },
                {
                    "sense_id": "db9f8453-5946-333b-afa5-7bb8f668d506",
                    "sense_definition": "Recouvrir une préparation culinaire d'une fine pellicule de sucre ou de gelée lisse et brillante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef pâtissier va <w>glacer</w> le gâteau avec du chocolat fondant."
                        },
                        {
                            "text": "Elle a appris à <w>glacer</w> des biscuits avec du sucre et du citron."
                        }
