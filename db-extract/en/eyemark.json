    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3c4d273b-72b4-344e-a2e7-a926ed4c282c",
                "word": "eyemark",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5bfc72b0-025b-428a-875e-742050d15531",
                        "entry_id": "3c4d273b-72b4-344e-a2e7-a926ed4c282c",
                        "tags": [
                            "plural"
                        ],
                        "form": "eyemarks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e964004-c326-3c2c-9369-73a939af1506",
                        "entry_id": "3c4d273b-72b4-344e-a2e7-a926ed4c282c",
                        "glosses": [
                            "Something that is eye-catching; a landmark or spectacle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f68ac458-6439-47c0-a333-9af549de16fa",
                                "sense_id": "1e964004-c326-3c2c-9369-73a939af1506",
                                "text": "An eyemark and the country's core, Inspirer, prophet evermore;"
                            },
                            {
                                "example_id": "11ca8ee3-0800-4a44-abb6-cb7a60072aa5",
                                "sense_id": "1e964004-c326-3c2c-9369-73a939af1506",
                                "text": "They had good telescopes with them; \"and one friend after another searched out the spot in the distance which had become the dearest to him; neither was I without a little eyemark of the like, which, though it rose not conspicuous in the landscape, drew me to it beyond all else with a kindly magic."
                            },
                            {
                                "example_id": "e2b66046-177c-477b-9ce3-8de7441b8118",
                                "sense_id": "1e964004-c326-3c2c-9369-73a939af1506",
                                "text": "'Slife, will you stand rhyming there upon a stage, to be an eyemark to all that pass ?"
                            },
                            {
                                "example_id": "4dfcabe2-83ff-4b75-a07f-33b73e577d60",
                                "sense_id": "1e964004-c326-3c2c-9369-73a939af1506",
                                "text": "The art of holding attention by all lawful means is prime, as to style. The children were my eyemark, here."
                            }
                        ]
                    },
                    {
                        "sense_id": "89928120-bd1f-3b0b-89d7-27fe0445edee",
                        "entry_id": "3c4d273b-72b4-344e-a2e7-a926ed4c282c",
                        "glosses": [
                            "A visual basis of comparison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0e777ad-800d-485a-a55d-96f1999621e1",
                                "sense_id": "89928120-bd1f-3b0b-89d7-27fe0445edee",
                                "text": "The new comer was right eager to know who of the townspeople might follow such laudable ways, and therefore he taketh an eyemark against the lifting day-brow, both of his growth and the manner of attire he wore, that he might rather know him if he should happen to see him afterwards."
                            },
                            {
                                "example_id": "dd5b6154-3b93-4546-af60-9cf2288eb549",
                                "sense_id": "89928120-bd1f-3b0b-89d7-27fe0445edee",
                                "text": "Fortunately we have no standard of proportions as an eyemark, hence no one will suffer by comparison."
                            },
                            {
                                "example_id": "03fe383a-7bb0-478d-867a-ec315a2bdb51",
                                "sense_id": "89928120-bd1f-3b0b-89d7-27fe0445edee",
                                "text": "In order to control cutoff register with the Insetrol equipment, the web-offset preprinter must print special “eyemarks” on the web at the same time"
                            }
                        ]
                    },
                    {
                        "sense_id": "06ccb702-69d8-32b0-9536-2d54c2e1b511",
                        "entry_id": "3c4d273b-72b4-344e-a2e7-a926ed4c282c",
                        "glosses": [
                            "A mark around or near the eye."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb9a6d97-0c59-4eca-a2d6-eb42234608b4",
                                "sense_id": "06ccb702-69d8-32b0-9536-2d54c2e1b511",
                                "text": "In Hindostan the L. cristatus occurs in winter chiefly, being of a browner plumage, with indistinct eyemark; this will probably be the typical L. phoenicurus of Pallas, finding its summer resort in Siberia"
                            },
                            {
                                "example_id": "ec56dab9-1849-41fb-8f80-3a16dd8fe951",
                                "sense_id": "06ccb702-69d8-32b0-9536-2d54c2e1b511",
                                "text": "A woman whom she had convicted of having the devil's eyemark, was disguised, and, after an interval, again brought before her ; she acquitted her."
                            },
                            {
                                "example_id": "94e03ecf-9926-4ca3-bfab-b042a9629f90",
                                "sense_id": "06ccb702-69d8-32b0-9536-2d54c2e1b511",
                                "text": "The other one, on the south side [Figure 8], is much more elaborate, has symmetric claws, a dead slit eye, and no eyemarks."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd4df7d7-b237-3af9-9ea8-14600cad41cf",
                        "entry_id": "3c4d273b-72b4-344e-a2e7-a926ed4c282c",
                        "glosses": [
                            "A marking that resembles an eye."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6837ef2-f51a-43af-becf-d3017c1733ec",
                                "sense_id": "fd4df7d7-b237-3af9-9ea8-14600cad41cf",
                                "text": "while the front wings, with waved lining of colors similar to those of the other pair, bore near the edge an eyemark of darkest brown bordered with white."
                            },
                            {
                                "example_id": "7ba4f6d1-ba14-4424-95fc-719659daa956",
                                "sense_id": "fd4df7d7-b237-3af9-9ea8-14600cad41cf",
                                "text": "The first blue spot of the eyemark mostly small, the second and third sometimes separate, but mostly joined together in front."
                            }
                        ]
                    },
                    {
                        "sense_id": "59321118-9315-3c5b-97b3-427f374af54a",
                        "entry_id": "3c4d273b-72b4-344e-a2e7-a926ed4c282c",
                        "glosses": [
                            "The focal point of the eye; the point on which the eye is focused."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ab2f575-da57-4d25-978d-8b80fa1a342b",
                                "sense_id": "59321118-9315-3c5b-97b3-427f374af54a",
                                "text": "Produced by NAC Inc. (Japan), it shows the subject's eyemark as a spot superimposed on the entire field of view being observed or recorded. From these records, analyses can be made on time history of the eyemark, timing of eye fixation, direction and distance of eye movement under stimuli, relative motion between the eye and head, and distribution of eye fixation distances."
                            },
                            {
                                "example_id": "aef40e11-d47a-48eb-a65c-af94c6871e05",
                                "sense_id": "59321118-9315-3c5b-97b3-427f374af54a",
                                "text": "In Event A, the time from occurrence of a dangerous incident to movement of the eyemark to the immobile car while operating HMI2 or HMI3 was shorter than that of HMI1."
                            }
                        ]
                    }
                ],
