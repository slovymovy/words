                        "examples": [
                            {
                                "example_id": "96b277bf-7a76-4186-94d7-91dac1a0a27a",
                                "sense_id": "56b12211-6071-32f3-bb0f-d2431b786a62",
                                "text": "Voor de Deen Asgreen (28) is het de eerste Tourritwinst in zijn carrière, voor zijn ploeg QuickStep is het de 50ste keer dat de Belgische wielerploeg de dagzege in de Franse wielerronde pakt. Eenkhoorn, Nederlands kampioen in 2022, was in de sprint rapper dan medevluchters Jonas Abrahamsen en zijn eigen ploegmaat Victor Campenaerts."
                            },
                            {
                                "example_id": "7ca60597-66cf-40de-9a59-1965b110193f",
                                "sense_id": "56b12211-6071-32f3-bb0f-d2431b786a62",
                                "text": "In het klassement verandert weinig: de Zwitserse Marlen Reusser blijft leider, Demi Vollering volgt op negen seconden. Morgen is de slotrit van de Zwitserse wielerronde."
                            },
                            {
                                "example_id": "86c9beb4-ab0d-45b8-ab92-3b7c4bc975b9",
                                "sense_id": "56b12211-6071-32f3-bb0f-d2431b786a62",
                                "text": "De 106de editie van de Giro d'Italia blijft momenteel weinig bespaard. Na het uitvallen van Remco Evenepoel raakte de Italiaanse wielerronde opnieuw een grote favoriet kwijt: Tao Geoghegan Hart van de Ineos-ploeg."
                            }
                        ]
                    }
