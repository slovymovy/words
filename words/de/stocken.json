    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2075f4b7-b1c4-351a-a4b5-5e30fefd071a",
                    "sense_definition": "in einer Bewegung, einem Ablauf oder im Sprechen innehalten oder nicht mehr richtig vorankommen",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "unterbrechung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der Autobahn <w>stockte</w> der Verkehr wegen einer Baustelle über viele Kilometer."
                        },
                        {
                            "text": "Mitten im Satz <w>stockte</w> seine Rede, weil er plötzlich den Faden verloren hatte."
                        },
                        {
                            "text": "Vor lauter Schreck <w>stockte</w> ihr für einen kurzen Moment der Atem."
                        }
                    ],
                    "synonyms": [
                        "stillstehen"
                    ],
                    "antonyms": [
                        "fließen"
                    ],
                    "common_phrases": [
                        "der Atem stockt",
                        "ins Stocken geraten",
                        "der Verkehr stockt"
                    ]
                },
                {
                    "sense_id": "44d0d6b7-8fef-3854-94e6-e6d36e90e56a",
                    "sense_definition": "von einer Flüssigkeit: durch Hitze oder Kälte fest oder dicklich werden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "festwerden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Man muss die Eimasse bei mittlerer Hitze erwärmen, bis sie gleichmäßig <w>stockt</w>."
                        },
                        {
                            "text": "Die Soße darf nicht kochen, damit das Eigelb darin nicht klumpt oder unerwünscht <w>stockt</w>."
                        }
                    ],
                    "common_phrases": [
                        "Eier stocken lassen"
                    ]
                },
                {
                    "sense_id": "6bf9a767-0df9-36e8-b137-12309ab6886e",
                    "sense_definition": "durch Feuchtigkeit modrig werden oder Schimmel ansetzen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verderben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn man feuchte Wäsche zu lange im Korb liegen lässt, beginnt sie zu <w>stocken</w>."
                        },
                        {
                            "text": "In dem feuchten Kellerraum <w>stockten</w> bereits die alten Bücher in den Regalen."
                        }
                    ]
                },
                {
                    "sense_id": "9632eeaa-3681-36d3-8bea-75b3afd2d09f",
                    "sense_definition": "von Bäumen oder Pflanzen: an einem bestimmten Standort wachsen oder stehen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf dem kargen Hang <w>stocken</w> seit vielen Jahrzehnten wetterfeste Kiefern."
                        },
                        {
                            "text": "In diesem Waldgebiet <w>stockt</w> vorwiegend ein dichter Mischwald aus Buchen und Fichten."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "forstfachsprachlich"
                        }
                    ]
                },
