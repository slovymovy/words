                                        "glosses": [
                                            "Tomar notas o comentarios."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71ec324-c514-46bf-8907-8003ab9fce9b",
                                                "sense_id": "73a7c7c2-23c2-3ff3-8c31-2cf634b2e67a",
                                                "text": "Rousseau anotó sus teorías en varios de sus escritos, particularmente en Sobre el Contrato Social."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a183636a-5496-378c-872d-97f03850526a",
