                ],
                "senses": [
                    {
                        "sense_id": "afee0f77-defe-3cb7-9098-54e045cf3846",
                        "entry_id": "e6b2ac44-efe9-31e9-8258-4e738e42eff1",
                        "glosses": [
                            "derjenige Teil einer Gesellschaft, der Bildung für einen Wert an sich erachtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06db7db-919d-4739-97e3-286db7679c12",
                                "sense_id": "afee0f77-defe-3cb7-9098-54e045cf3846",
                                "text": "„Almanache und Wochenzeitschriften waren in der Zeit der deutschen Romantik eine auflagenstarke und beliebte Lektüre des Bildungsbürgertums, wobei Hauff erzählerisch sicher mehr zu bieten hatte als so manche billige Massenproduktion.“"
                            },
                            {
                                "example_id": "76ba0e9d-bbba-409d-90ef-d5165de46768",
                                "sense_id": "afee0f77-defe-3cb7-9098-54e045cf3846",
                                "text": "„Andererseits sollte das Hochdeutsche für alle Belange des öffentlichen Lebens, das staatsbürgerliche Engagement und die Teilnahme an der Kultur des deutschen Bildungsbürgertums Verwendung finden.“"
                            },
                            {
                                "example_id": "6fd8365d-3544-4f10-b77c-482ef6240f40",
                                "sense_id": "afee0f77-defe-3cb7-9098-54e045cf3846",
                                "text": "„Auf die rigide gegliederte Gesellschaft des Kaiserreichs musste die Verbindung ohnehin brüskierend wirken: Ernst Georg Jünger, Sohn eines Hannoveraner Gymnsiallehrers, entstammt dem Bildungsbürgertum, Lilys Vater ist Fabrikarbeiter, ihre Mutter Bäuerin.“"
                            },
                            {
                                "example_id": "8411c348-e9ed-44ea-9fa5-3f82f2e4f27c",
                                "sense_id": "afee0f77-defe-3cb7-9098-54e045cf3846",
                                "text": "„Darum werden wir sie in ihrer ganzen Fülle abschütteln, indem wir uns stellvertretend für alle Stilregeln die größte und erhabenste vorknöpfen, die das Bildungsbürgertum zu bieten hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
