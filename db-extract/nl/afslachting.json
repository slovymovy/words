                        "entry_id": "3f704a0d-fe95-3108-9e16-b770a2a769fe",
                        "glosses": [
                            "het zinloos vermoorden van mensen op een gruwelijke manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd562cc-af3c-4a87-997a-1a75222de946",
                                "sense_id": "548ccb6f-6399-3575-ad66-6f50fa821621",
                                "text": "De Commissie heeft de afslachting van de onschuldigen veel te lang getolereerd"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eea29eef-b3c2-46ca-a0e5-b41a472baec4",
                        "source_entry_id": "3f704a0d-fe95-3108-9e16-b770a2a769fe",
                        "source_sense_id": "548ccb6f-6399-3575-ad66-6f50fa821621",
                        "source_sense_description": "het zinloos vermoorden van mensen op een gruwelijke manier",
                        "target_lang_word": "Blutbad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutbad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "723517fa-b55c-305d-b310-c523c16bfba6",
                                        "entry_id": "a14b9f5a-822a-3785-a080-524beed11fe7",
                                        "glosses": [
                                            "brutale Ermordung vieler Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c2bf92-ce55-4008-9c07-ecf786157045",
                                                "sense_id": "723517fa-b55c-305d-b310-c523c16bfba6",
                                                "text": "Der Amokläufer richtete ein entsetzliches Blutbad an."
                                            },
                                            {
                                                "example_id": "08b28ca5-44a3-4c3a-b65c-f1416b08303d",
                                                "sense_id": "723517fa-b55c-305d-b310-c523c16bfba6",
                                                "text": "„Alle Ghettos, alle diese verkrüppelten Seelen, die Blutbäder und Pogrome, die Gaskammern und Kalköfen; all dies berührte niemanden, alles ging verloren.“"
                                            },
                                            {
                                                "example_id": "4e26f8b0-729e-46ac-b3dd-530919898713",
                                                "sense_id": "723517fa-b55c-305d-b310-c523c16bfba6",
                                                "text": "„Im Jahr darauf folgte ein Blutbad.“"
                                            },
                                            {
                                                "example_id": "144535d0-f690-490d-a1bd-3d1dd68eae4d",
                                                "sense_id": "723517fa-b55c-305d-b310-c523c16bfba6",
                                                "text": "„Das Blutbad von Borodino lag hinter ihnen, es konnte nur noch vorwärts gehen.“"
                                            },
                                            {
                                                "example_id": "b538c94b-2075-42fe-adfb-c41e71c55f63",
                                                "sense_id": "723517fa-b55c-305d-b310-c523c16bfba6",
                                                "text": "„Auch die Hintergründe des Blutbads von 1757 waren vielschichtiger, als er es darstellte – und manches in seinem »Bericht« ist längst als Mythos entlarvt.“"
                                            },
                                            {
                                                "example_id": "49005f3d-b865-452a-ad89-fc31cffc39bf",
                                                "sense_id": "723517fa-b55c-305d-b310-c523c16bfba6",
                                                "text": "„Die erste Welle der Gewalt nach Zia-ul-Haqs Tod gipfelte im Mai 1990 im Zentrum von Hyderabad in einem Blutbad.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a50f45ca-5a48-49c4-9d55-d386686537a9",
                        "source_entry_id": "3f704a0d-fe95-3108-9e16-b770a2a769fe",
                        "source_sense_id": "548ccb6f-6399-3575-ad66-6f50fa821621",
                        "source_sense_description": "het zinloos vermoorden van mensen op een gruwelijke manier",
                        "target_lang_word": "Massaker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Massaker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                        "entry_id": "2938efed-e8fb-3644-87fa-e761059d30f7",
                                        "glosses": [
                                            "die Ermordung vieler Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28731287-d0da-48d1-82a4-dceecaa0b187",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "Frauen und Kinder waren einem Massaker zum Opfer gefallen."
                                            },
                                            {
                                                "example_id": "ae678078-1349-44fe-b865-215d0a0cc0de",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Kaiser hält es für möglich, dass Grimmelshausen 1636 vor Ort war, als kaiserliche Truppen das von Schweden gehaltene Magdeburg zurückeroberten; fünf Jahre zuvor hatten sie, angeführt von Tilly, schon einmal die Stadt gestürmt und rund 20000 Menschen getötet - eines der schlimmsten Massaker des Kriegs.“"
                                            },
                                            {
                                                "example_id": "b019709f-a768-4c48-b216-e26bf20c1407",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Bald nach dem Massaker stürmen Indianer auf die Grönländer zu, schwingen steinerne Tomahawks und schießen mit Pfeil und Bogen - steinzeitliche Waffen, die den eisernen Schwertern und Streitäxten der Wikinger aber kaum unterlegen sind.“"
                                            },
                                            {
                                                "example_id": "41cd8335-e7e8-48d1-98c5-2405744cd012",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Erst nach dem Ende der Volksrepublik Polen wagen die Überlebenden, an dieses Massaker zu erinnern.“"
                                            },
                                            {
                                                "example_id": "19817c0e-9afa-48fc-9b2b-45207b5e19d3",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "„Irgendwann kamen wir zum Monument, dem ersten und damals einzigen Denkmal, das 35 Jahre nach dem Massaker eingeweiht worden war, am falschen Ort und am falschen Tag.“"
                                            },
                                            {
                                                "example_id": "bdfc9994-1085-453b-be59-1acf33ba4809",
                                                "sense_id": "4dbb8b27-f44d-3585-9df8-5badcc911e3a",
                                                "text": "Das Massaker von Babyn Jar vor 75 Jahren wurde nach der gleichnamigen Schlucht auf dem Stadtgebiet Kiews genannt, wo im Jahr 1941 die deutsche Wehrmacht, Sicherheitspolizei und Sicherheitsdienst mehr als 33.000 Juden ermordeten. \"Babyn Jar\" war die größte einzelne Mordaktion an jüdischen Männern, Frauen und Kindern im Zweiten Weltkrieg."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d398e47b-6421-4351-943c-9b4a6b7bd3c0",
                        "source_entry_id": "3f704a0d-fe95-3108-9e16-b770a2a769fe",
                        "source_sense_id": "548ccb6f-6399-3575-ad66-6f50fa821621",
                        "source_sense_description": "het zinloos vermoorden van mensen op een gruwelijke manier",
                        "target_lang_word": "bloodbath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloodbath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "446c649d-eab7-32e3-a9b2-7b86b7b62544",
                                        "entry_id": "d2b8c3c6-d188-3234-ab49-4149407f8be1",
                                        "glosses": [
                                            "Indiscriminate killing or slaughter; a massacre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db33e819-5f51-4f7a-adf6-25d1fd70a451",
                                                "sense_id": "446c649d-eab7-32e3-a9b2-7b86b7b62544",
                                                "text": "There lay the steed; here lay the man; Gude friends that day did twin: They leuch na a' to the feast that cam Whan the het bluid-bath was done."
                                            },
                                            {
                                                "example_id": "9620f71a-24c9-47f3-aafa-249f7a6ef2e1",
                                                "sense_id": "446c649d-eab7-32e3-a9b2-7b86b7b62544",
                                                "text": "He made a \"Stockholm BLUTBAD\" still famed in History (kind of open, ordered or permitted, Massacre of eighty or a hundred of his chief enemies there), \"Bloodbath,\" so they name it; in Stockholm, where indeed he was lawful King, and not without unlawful enemies, had a bloodbath been the way to deal with them."
                                            },
                                            {
                                                "example_id": "090af8b1-6c7e-46ad-b852-68b5611408c2",
                                                "sense_id": "446c649d-eab7-32e3-a9b2-7b86b7b62544",
                                                "text": "In movie terms, it suggests Paul Verhoeven in Robocop/Starship Troopers mode, an R-rated bloodbath where the grim spectacle of children murdering each other on television is bread-and-circuses for the age of reality TV, enforced by a totalitarian regime to keep the masses at bay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c988676e-ccaf-3591-8143-35dffae8b24a",
                                        "entry_id": "d2b8c3c6-d188-3234-ab49-4149407f8be1",
                                        "glosses": [
                                            "An aggressive or very violent contest or confrontation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a655153-41a9-4c37-91a1-300b50578ed4",
                                                "sense_id": "c988676e-ccaf-3591-8143-35dffae8b24a",
                                                "text": "Although the Hampden Park blood bath of '94 caused Yale and Harvard to break off football relations for the next two years, they kept close watch on each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e7993db-f324-3147-b064-b270c7a9efc6",
                                        "entry_id": "d2b8c3c6-d188-3234-ab49-4149407f8be1",
                                        "glosses": [
                                            "An upset (as of a game with unexpected results, or a national presidential convention) or heavy defeat."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f659763-95c3-44ef-b4db-6e905cae20d8",
                                                "sense_id": "4e7993db-f324-3147-b064-b270c7a9efc6",
                                                "text": "Robert Halfon, a senior Tory backbencher, warned that a general election now would be a “bloodbath” for his party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f601cb3d-b543-3362-82fa-600f4b0fccf3",
                                        "entry_id": "d2b8c3c6-d188-3234-ab49-4149407f8be1",
                                        "glosses": [
                                            "A large financial loss or massive layoff brought about by negative economic conditions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170e8f3f-f929-4579-a9ef-785c18eadb10",
                                                "sense_id": "f601cb3d-b543-3362-82fa-600f4b0fccf3",
                                                "text": "In an interview after the victory, Daley sought to assure Blacks that there would be no personnel bloodbath at City Hall."
                                            },
                                            {
                                                "example_id": "5b7dc86d-f178-4635-a1cc-c3131672d524",
                                                "sense_id": "f601cb3d-b543-3362-82fa-600f4b0fccf3",
                                                "text": "The point is, Amodei is a salesman, and it’s in his interest to make his product appear inevitable and so powerful it’s scary. Axios framed Amodei’s economic prediction as a “white-collar bloodbath.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f053cfb6-c731-3646-a431-91b3c0eb9050",
                                        "entry_id": "d2b8c3c6-d188-3234-ab49-4149407f8be1",
                                        "glosses": [
                                            "A bath taken in warm blood used as a restorative or medical treatment."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7e79b57-b9fd-4914-ae79-1327a1cec623",
                                                "sense_id": "f053cfb6-c731-3646-a431-91b3c0eb9050",
                                                "text": "On Blood-Baths: An Historical Notice. By Dr. Hecker. According to a dark tradition which is incidentally mentioned by Pliny, the ancient kings of Egypt used to bathe in human blood when they were seized with leprosy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1feabd78-3cc2-464a-8683-89038a42d3bd",
                        "source_entry_id": "3f704a0d-fe95-3108-9e16-b770a2a769fe",
                        "source_sense_id": "548ccb6f-6399-3575-ad66-6f50fa821621",
                        "source_sense_description": "het zinloos vermoorden van mensen op een gruwelijke manier",
                        "target_lang_word": "carnage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carnage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48dc2c09-7199-3d8c-931a-400b2e3094ea",
                                        "entry_id": "607dee27-10c3-32a6-88cf-6897d25dad4b",
                                        "glosses": [
                                            "Death and destruction."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e801b076-4abb-4f6d-bd94-49770d4a86e7",
                                                "sense_id": "48dc2c09-7199-3d8c-931a-400b2e3094ea",
                                                "text": "There was carnage after the school play ended with 96 deaths."
                                            },
                                            {
                                                "example_id": "3e8207e5-000d-4e24-9e3d-6797fdbe07d1",
                                                "sense_id": "48dc2c09-7199-3d8c-931a-400b2e3094ea",
                                                "text": "Unleash the wolves / Carnage has no rules / Comparison, competition / We'll bury one and all, all"
                                            },
                                            {
                                                "example_id": "97ce40c8-0a25-483c-8406-bc3d4b917708",
                                                "sense_id": "48dc2c09-7199-3d8c-931a-400b2e3094ea",
                                                "text": "Carnage consumes all we’ve ever loved / The innocent blistered by the flame / Trial by fire we burn in shame"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "952f57d4-a91a-36f7-a172-1e86c5c7e36f",
                                        "entry_id": "607dee27-10c3-32a6-88cf-6897d25dad4b",
                                        "glosses": [
                                            "The corpses, gore, etc. that remain after a massacre."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e815d0ad-f1e6-3b6a-b316-2844f2a8ee82",
                                        "entry_id": "607dee27-10c3-32a6-88cf-6897d25dad4b",
                                        "glosses": [
                                            "Any great loss by a team; a game in which one team wins overwhelmingly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efbf6b37-2b99-413c-8ef1-78b6f9f4a077",
                                                "sense_id": "e815d0ad-f1e6-3b6a-b316-2844f2a8ee82",
                                                "text": "The game against Sri Lanka and Australia was carnage with Australia winning by 287 runs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2ffcb77-2100-345d-a5ec-e32d9ca9bd33",
                                        "entry_id": "607dee27-10c3-32a6-88cf-6897d25dad4b",
                                        "glosses": [
                                            "A heavy drinking binge and its aftermath."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b112e4ad-014a-4e00-a48e-80c1b37f82e2",
                                                "sense_id": "f2ffcb77-2100-345d-a5ec-e32d9ca9bd33",
                                                "text": "The lads had recently returned from a wild summer on the party island of Ibiza, an increasingly popular hotspot for working-class British youth. But this was not a scene of drunken holiday carnage in tacky discos."
                                            },
                                            {
                                                "example_id": "cf7652a8-fb75-4940-b7b0-e8319709df96",
                                                "sense_id": "f2ffcb77-2100-345d-a5ec-e32d9ca9bd33",
                                                "text": "Within three hours we'd drunk the place dry. Miraculously, we all made it back on the bus, but I've never seen a more bacchanalian scene of wanton debauchery than the ride back to the hotel. It was total carnage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b318a5c0-711b-3226-bdab-835ded6ddf2d",
                                        "entry_id": "607dee27-10c3-32a6-88cf-6897d25dad4b",
                                        "glosses": [
                                            "Any chaotic situation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b41f0c1e-562d-4c12-8186-519fc08c431f",
                                                "sense_id": "b318a5c0-711b-3226-bdab-835ded6ddf2d",
                                                "text": "Mothers and children trapped in poverty in our inner cities, rusted out factories, scattered like tombstones across the across the landscape of our nation, an education system flush with cash, but which leaves our young and beautiful students deprived of all knowledge, and the crime, and the gangs, and the drugs that have stolen too many lives and robbed our country of so much unrealized potential. This American carnage stops right here and stops right now."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92f8dc5f-4fd5-4087-b4ee-017eac5b3b73",
                        "source_entry_id": "3f704a0d-fe95-3108-9e16-b770a2a769fe",
