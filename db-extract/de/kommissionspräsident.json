                "senses": [
                    {
                        "sense_id": "d66b353a-e2bd-3fef-b5bb-a8780c985954",
                        "entry_id": "7b3046e4-324f-3779-a9e5-9ee5d5bb0be5",
                        "glosses": [
                            "Person, die innerhalb einer Kommission das Amt des Präsidenten innehat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1c123fc-7e2b-4628-b364-736e023d121e",
                                "sense_id": "d66b353a-e2bd-3fef-b5bb-a8780c985954",
                                "text": "Der Rat wird sie misstrauisch belauern und dem Parlament wie dem Kommissionspräsidenten deren Chuzpe nicht verzeihen."
                            },
                            {
                                "example_id": "01d4a810-c457-4d74-8262-65de20eabe46",
                                "sense_id": "d66b353a-e2bd-3fef-b5bb-a8780c985954",
                                "text": "Der 45-Jährige überlegt nun gar, bei der Europawahl um die Nachfolge von EU-Kommissionspräsident Jean-Claude Juncker zu rittern."
                            },
                            {
                                "example_id": "f4ef66ca-5e5f-4152-b58d-215ccf0266b3",
                                "sense_id": "d66b353a-e2bd-3fef-b5bb-a8780c985954",
                                "text": "„Der scheidende Kommissionspräsident José Manuel Barroso sagte bei einer Pressekonferenz, er wisse von der Zahlungsaufforderung nichts.“"
                            }
                        ],
