                        "glosses": [
                            "Recherche über Hintergründe, die Vorgeschichte von etwas oder jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c806c69d-8c27-4719-a094-2e7b40b2537c",
                                "sense_id": "c9b2f0e7-e0c7-3dd8-974c-5317b8170419",
                                "text": "„›Sie ist für die Hintergrundrecherchen zuständig und sagte, der Klient habe es vorgezogen, uns keine Informationen zu übermitteln.‹“"
                            },
                            {
                                "example_id": "d6822269-df84-46bf-8c9d-6d0cdf6800e4",
                                "sense_id": "c9b2f0e7-e0c7-3dd8-974c-5317b8170419",
                                "text": "„Sie enthüllten nicht plötzlich, nach beinahe zwanzig Jahren, Informationen, die bei Hintergrundrecherchen und Lügendetektortest nie ans Licht gekommen waren.“"
                            }
                        ],
