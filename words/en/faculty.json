{
    "word_family": [
        "facultative"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "393eac80-e047-33f8-8543-6689dbccb993",
                    "sense_definition": "The teaching and administrative staff at a school, college, or university, viewed as a group.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "university_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university <w>faculty</w> voted to change the grading system next semester.",
                            "target_lang_translations": {
                                "ru": "Университетский <w>преподавательский состав</w> проголосовал за изменение системы оценок в следующем семестре.",
                                "zh": "大学<w>教职员工</w>投票决定在下学期更改评分系统。"
                            }
                        },
                        {
                            "text": "She has been a respected member of the <w>faculty</w> for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Она была уважаемым членом <w>преподавательского состава</w> более двадцати лет.",
                                "zh": "她作为受人尊敬的<w>教职员工</w>已经工作了二十多年。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "faculty member",
                        "join the faculty",
                        "teaching faculty",
                        "faculty meeting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преподавательский и административный состав учебного заведения.",
                        "zh": "大学或学院的全体教职员工。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преподавательский состав",
                                "target_lang_sense_clarification": "штат сотрудников"
                            },
                            {
                                "target_lang_word": "профессура",
                                "target_lang_sense_clarification": "коллектив профессоров"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "教职员工",
                                "target_lang_sense_clarification": "学校的教学与行政人员"
                            },
                            {
                                "target_lang_word": "全体教师",
                                "target_lang_sense_clarification": "学校的教学人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10501437-f50d-3b97-bc2b-64743e392362",
                    "sense_definition": "A specific department or group of related departments within a university focusing on a major area of knowledge.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "university_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was appointed as the new dean of the <w>Faculty</w> of Medicine.",
                            "target_lang_translations": {
                                "ru": "Он был назначен новым деканом медицинского <w>факультета</w>.",
                                "zh": "他被任命为医<w>学院</w>的新任院长。"
                            }
                        },
                        {
                            "text": "Students from the engineering <w>faculty</w> won the design competition.",
                            "target_lang_translations": {
                                "ru": "Студенты инженерного <w>факультета</w> выиграли конкурс дизайна.",
                                "zh": "工程<w>学院</w>的学生赢得了设计比赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Faculty of Arts",
                        "Faculty of Science",
                        "law faculty",
                        "faculty dean"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подразделение университета, специализирующееся на определенной области знаний.",
                        "zh": "大学内负责特定学科领域教学与研究的学术部门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "факультет",
                                "target_lang_sense_clarification": "подразделение вуза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "院系",
                                "target_lang_sense_clarification": "大学的教学单位"
                            },
                            {
                                "target_lang_word": "学院",
                                "target_lang_sense_clarification": "大学下属的专业学院"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d31acff6-b612-3e8a-9cb1-b5ad978f72e6",
                    "sense_definition": "A natural physical or mental ability, power, or skill.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ability_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his old age, he retained all his mental <w>faculties</w> and a sharp wit.",
                            "target_lang_translations": {
                                "ru": "Несмотря на преклонный возраст, он сохранил все свои умственные <w>способности</w> и острый ум.",
                                "zh": "尽管年事已高，他依然保持着敏锐的思维和所有的心理<w>机能</w>。"
                            }
                        },
                        {
                            "text": "The accident temporarily impaired her <w>faculty</w> of speech.",
                            "target_lang_translations": {
                                "ru": "Авария временно нарушила её <w>способность</w> говорить.",
                                "zh": "那场事故暂时损害了她的语言<w>机能</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ability",
                        "capability",
                        "capacity",
                        "power",
                        "talent",
                        "gift",
                        "endowment"
                    ],
                    "common_phrases": [
                        "mental faculties",
                        "critical faculties",
                        "faculty of speech",
                        "in full possession of one's faculties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественная физическая или умственная способность, сила или навык.",
                        "zh": "人天生的身体或心理机能、能力或天赋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способность",
                                "target_lang_sense_clarification": "умение, навык"
                            },
                            {
                                "target_lang_word": "дар",
                                "target_lang_sense_clarification": "талант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机能",
                                "target_lang_sense_clarification": "身体或心理的运作能力"
                            },
                            {
                                "target_lang_word": "能力",
                                "target_lang_sense_clarification": "做某事的天赋或本领"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0411d50d-9a6f-3a6b-84c6-d637eb4c11dd",
                    "sense_definition": "An official power, authority, or privilege granted by a higher authority, often in a legal or religious context.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "authority_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest received a special <w>faculty</w> to perform the ceremony outside the church.",
                            "target_lang_translations": {
                                "ru": "Священник получил особое <w>разрешение</w> на проведение церемонии вне церкви.",
                                "zh": "牧师获得了一项在教堂外举行仪式的特殊<w>特许</w>。"
                            }
                        },
                        {
                            "text": "Local laws confer the <w>faculty</w> to seize property in specific debt cases.",
                            "target_lang_translations": {
                                "ru": "Местные законы предоставляют <w>полномочие</w> изымать имущество в определенных случаях задолженности.",
                                "zh": "地方法律赋予了在特定债务案件中扣押财产的<w>权限</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "power"
                    ],
                    "common_phrases": [
                        "grant a faculty",
                        "special faculty"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное право или полномочие, предоставляемое властью (часто в юридическом или религиозном контексте).",
                        "zh": "由更高权威授予的正式权力、特权或许可。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полномочие",
                                "target_lang_sense_clarification": "власть, право"
                            },
                            {
                                "target_lang_word": "разрешение",
                                "target_lang_sense_clarification": "позволение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "权限",
                                "target_lang_sense_clarification": "正式授予的权力范围"
                            },
                            {
                                "target_lang_word": "特许",
                                "target_lang_sense_clarification": "特殊的许可或权利"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}