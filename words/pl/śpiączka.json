    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0da0869-0f69-3e80-a402-c21576761880",
                    "sense_definition": "stan głębokiego zaburzenia świadomości i braku przytomności, w którym chory nie reaguje na silne bodźce",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarze wprowadzili poszkodowanego pacjenta w stan <w>śpiączki</w> farmakologicznej po wypadku.",
                            "target_lang_translations": {
                                "ru": "После аварии врачи ввели пострадавшего пациента в состояние медикаментозной <w>комы</w>."
                            }
                        },
                        {
                            "text": "Po wielu tygodniach leczenia chory nagle obudził się ze <w>śpiączki</w>.",
                            "target_lang_translations": {
                                "ru": "После многих недель лечения больной внезапно вышел из <w>комы</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "koma",
                        "nieprzytomność"
                    ],
                    "common_phrases": [
                        "śpiączka farmakologiczna",
                        "zapaść w śpiączkę",
                        "wybudzić ze śpiączki"
                    ],
                    "target_lang_definitions": {
                        "ru": "состояние глубокого нарушения сознания и отсутствия реакций на внешние раздражители"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кома",
                                "target_lang_sense_clarification": "медицинское состояние глубокого беспамятства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d1631a0-b14b-3882-a75b-6cc9e43b2975",
                    "sense_definition": "silna, trudna do opanowania potrzeba snu lub stan ospałości",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po obfitym obiedzie ogarnęła mnie nagła <w>śpiączka</w> i musiałem chwilę odpocząć.",
                            "target_lang_translations": {
                                "ru": "После плотного обеда на меня навалилась внезапная <w>сонливость</w>, и мне пришлось немного отдохнуть."
                            }
                        },
                        {
                            "text": "Z powodu zmiany pogody przez cały dzień walczę ze straszną <w>śpiączką</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за перемены погоды я весь день борюсь с ужасной <w>сонливостью</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "senność",
                        "ospałość"
                    ],
                    "common_phrases": [
                        "poobiednia śpiączka"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie silnej senności"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сильная, непреодолимая тяга ко сну или состояние вялости и сонливости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сонливость",
                                "target_lang_sense_clarification": "состояние полудрёмы, тяга ко сну"
                            },
                            {
                                "target_lang_word": "спячка",
                                "target_lang_sense_clarification": "разговорное обозначение сильного желания спать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c937846-26b8-31f6-8830-d3a9a23cde7e",
                    "sense_definition": "stan bierności, bezczynności, obojętności lub braku energii życiowej",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Całe miasteczko zdawało się trwać w zimowej <w>śpiączce</w> aż do nadejścia wiosny.",
                            "target_lang_translations": {
                                "ru": "Казалось, весь городок пребывал в зимней <w>спячке</w> до самого наступления весны."
                            }
                        },
                        {
                            "text": "Wreszcie instytucja obudziła się z wieloletniej <w>śpiączki</w> i zaczęła działać.",
                            "target_lang_translations": {
                                "ru": "Наконец учреждение очнулось от многолетней <w>спячки</w> и начало действовать."
                            }
                        }
                    ],
                    "synonyms": [
                        "apatia",
                        "ospałość"
                    ],
                    "common_phrases": [
                        "zimowa śpiączka"
                    ],
                    "target_lang_definitions": {
                        "ru": "состояние пассивности, бездействия, оцепенения или отсутствия жизненной энергии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спячка",
                                "target_lang_sense_clarification": "период застоя или бездействия"
                            },
                            {
                                "target_lang_word": "оцепенение",
                                "target_lang_sense_clarification": "пассивное, замершее состояние"
                            },
                            {
                                "target_lang_word": "летаргия",
                                "target_lang_sense_clarification": "состояние крайней пассивности и застоя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}