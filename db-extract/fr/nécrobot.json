                        "sense_id": "a0ecb472-639b-3fc1-8cae-7bf97bb48a51",
                        "entry_id": "effd13fd-ae98-346a-a2af-dd7bc0cf2803",
                        "glosses": [
                            "Robot dont des composants proviennent d'organismes morts."
                        ],
