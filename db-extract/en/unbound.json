    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cf4075a5-b387-3b71-ac5e-9126c370b15d",
                "word": "unbound",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "70cc9ee3-91f2-3c10-930e-5024f8851df6",
                        "entry_id": "cf4075a5-b387-3b71-ac5e-9126c370b15d",
                        "glosses": [
                            "Not bound.",
                            "Not obligated."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bdeba5ef-398b-4f49-ba99-4ed3c6f1aa91",
                                "sense_id": "70cc9ee3-91f2-3c10-930e-5024f8851df6",
                                "text": "Near-synonyms: unconstrained, unrestrained, unencumbered; unfettered, fetterless"
                            },
                            {
                                "example_id": "6b9d15cf-23cc-4343-becb-d2bc8256bf0f",
                                "sense_id": "70cc9ee3-91f2-3c10-930e-5024f8851df6",
                                "text": "The terms of the contract inadvertently left certain unbound aspects to subjective interpretation."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2ec462d-db68-317a-ac5d-a204c9fa817b",
                        "entry_id": "cf4075a5-b387-3b71-ac5e-9126c370b15d",
                        "glosses": [
                            "Not bound.",
                            "Not tied up."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6d2b5c98-f738-43ba-acc6-e4e35694ec9f",
                                "sense_id": "e2ec462d-db68-317a-ac5d-a204c9fa817b",
                                "text": "Near-synonyms: unfettered, fetterless, unrestrained, unchained, unshackled, shackleless, unmanacled, unhandcuffed"
                            },
                            {
                                "example_id": "a2fcde13-e819-497f-9a5c-1eb7d0cbab36",
                                "sense_id": "e2ec462d-db68-317a-ac5d-a204c9fa817b",
                                "text": "The hostages' hands were left unbound."
                            }
                        ]
                    },
                    {
                        "sense_id": "866f480b-df80-3e19-8fdb-1d7207e9cdcb",
                        "entry_id": "cf4075a5-b387-3b71-ac5e-9126c370b15d",
                        "glosses": [
                            "Not bound.",
                            "Without a binding."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d6f256fc-8944-4870-b05b-52f1ffd8ab5b",
                                "sense_id": "866f480b-df80-3e19-8fdb-1d7207e9cdcb",
                                "text": "an unbound book"
                            },
                            {
                                "example_id": "2e1c787d-63da-4f1b-a2fe-644dd08eafbf",
                                "sense_id": "866f480b-df80-3e19-8fdb-1d7207e9cdcb",
                                "text": "Beneath an old ebony table were two long carved oak chests. I lifted the lid of one, and at the top was a once-white surplice covered with dust, and beneath was a mass of tracts — Commonwealth Quartos, unbound — a prey to worms and decay."
                            }
                        ]
                    },
                    {
                        "sense_id": "940fbbcc-cdb0-3411-985e-ee5f18c84cea",
                        "entry_id": "cf4075a5-b387-3b71-ac5e-9126c370b15d",
                        "glosses": [
                            "Not bound.",
                            "Lying beyond the proton or neutron drip line; having a negative particle separation energy; capable of decaying by the spontaneous exothermic emission of one or more nucleons."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5547c5b4-02b9-46ed-a873-13820f241fb1",
                                "sense_id": "940fbbcc-cdb0-3411-985e-ee5f18c84cea",
                                "text": "Helium-2 is unbound, as it is energetically favorable for it to split into two separate protons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc257037-1932-4ea8-b590-d008d09b9320",
                        "source_entry_id": "cf4075a5-b387-3b71-ac5e-9126c370b15d",
                        "source_sense_description": "not bound or tied up",
                        "target_lang_word": "ungebunden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    }
                ],
                "word_linkages": []
