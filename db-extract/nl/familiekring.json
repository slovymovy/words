                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce61f419-5856-4470-bea0-124699e52134",
                                "sense_id": "363415cb-6726-36c7-b8f5-73b1cc7a9b66",
                                "text": "Wayne kijkt zijn familiekring rond."
                            },
                            {
                                "example_id": "e778a5ef-12ca-403a-a861-12c59d99e8bb",
                                "sense_id": "363415cb-6726-36c7-b8f5-73b1cc7a9b66",
                                "text": "Volgens de rechtbank is niet bewezen dat moeder Linda H. en stiefvader Leo den H. achter de dood van de vrouw zitten. Het OM, dat vorige maand tien jaar cel eiste tegen de twee vanwege moord, baseerde die eis op drie verklaringen van getuigen uit de familiekring."
                            }
                        ]
                    }
                ],
