                        "examples": [
                            {
                                "example_id": "e90d4438-7211-4915-bc9f-4057bda51979",
                                "sense_id": "589f8932-4e9a-3350-ad1e-ea53ea91b98e",
                                "text": "Spouting water: Early Hawaiians named this l l/2-mile strip of coast Waikiki, or “spouting water,” its inland part a swamp nurtured by descending mountain streams and gushy spring waters. As early as the 1400s, Hawaiians utilized this water ..."
                            },
                            {
                                "example_id": "73863bac-488e-4df8-9725-e883e72c7fa5",
                                "sense_id": "589f8932-4e9a-3350-ad1e-ea53ea91b98e",
                                "text": "Off with my beige bikini set, then he parted my legs and went straight for the gushy pussy and gushy it was. I was seeping like a loose faucet."
                            },
                            {
                                "example_id": "699872d5-12ff-4350-8fb1-f75bda32ca1f",
                                "sense_id": "589f8932-4e9a-3350-ad1e-ea53ea91b98e",
                                "text": "Just as underground water wells up in a gushy spring, when a bore is sunk down to that depth, […]"
                            },
                            {
                                "example_id": "7f3d9802-735b-46d6-bac3-8883b92b560e",
                                "sense_id": "589f8932-4e9a-3350-ad1e-ea53ea91b98e",
                                "text": "“I can't believe it's gonna rain for our entire spring break.” “Oh, don't worry, Vi, we're gonna let it get real gushy, then we are going mudding!” “Yes! I mean, whatever. Mudding's dumb.”"
                            }
                        ]
