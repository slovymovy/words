                                        "entry_id": "6ca89fcc-bd9d-34b2-a6b4-f67477e70769",
                                        "glosses": [
                                            "von einer Vorlage mehrere möglichst gleiche Exemplare anfertigen; vervielfältigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb99a669-f54e-4197-b88c-7d2d78ef1e6e",
                                                "sense_id": "3e87ccb6-99df-3bdc-b0a0-9c3c3f937874",
                                                "text": "Kopieren Sie mir bitte die Unterlagen, denn ich brauche sie morgen für die Verhandlung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "062810b8-69d3-39b8-ae3b-510924207de2",
                                        "entry_id": "6ca89fcc-bd9d-34b2-a6b4-f67477e70769",
                                        "glosses": [
                                            "jemanden nachmachen, imitieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "159f42ff-9914-46f7-9073-3cb147993585",
                                                "sense_id": "062810b8-69d3-39b8-ae3b-510924207de2",
                                                "text": "Der Anton kopiert schon wieder den Tobi; er läuft genauso wie Tobi."
                                            },
                                            {
                                                "example_id": "6abf830f-44ba-46ee-82be-0856a15cb36f",
                                                "sense_id": "062810b8-69d3-39b8-ae3b-510924207de2",
                                                "text": "Die Konkurrenz kopiert die neue Kollektion."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e06c1d3-f9d3-43c2-ac84-0abfde08f58a",
                        "source_entry_id": "cc62487b-a0ee-36b3-b8af-1c958d3dac46",
                        "source_sense_id": "7fe4cdd7-a28b-3572-a815-260d47d8bda1",
                        "target_lang_word": "copier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaea923b-d035-3736-ab89-b57c6d4c0852",
                                        "entry_id": "02be11c1-f661-3adc-85af-c177a80aa17a",
                                        "glosses": [
                                            "Reproduire par écrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96993c2f-b80b-4e4c-a1c1-e04937c9c37b",
                                                "sense_id": "eaea923b-d035-3736-ab89-b57c6d4c0852",
                                                "text": "Copier un contrat, un exploit."
                                            },
                                            {
                                                "example_id": "7fac0a41-a867-4706-8499-0feb86b38a17",
                                                "sense_id": "eaea923b-d035-3736-ab89-b57c6d4c0852",
                                                "text": "Copier un écrit mot à mot."
                                            },
                                            {
                                                "example_id": "1d2c4911-43b6-4e5f-b1c9-49a1c5dd8fdc",
                                                "sense_id": "eaea923b-d035-3736-ab89-b57c6d4c0852",
                                                "text": "Copier un passage de quelque ouvrage."
                                            },
                                            {
                                                "example_id": "32ae7797-9d78-4a4b-b932-66059e67a508",
                                                "sense_id": "eaea923b-d035-3736-ab89-b57c6d4c0852",
                                                "text": "Copier de la musique."
                                            },
                                            {
                                                "example_id": "c68fecbd-7ad5-4126-b483-39f7904de7b2",
                                                "sense_id": "eaea923b-d035-3736-ab89-b57c6d4c0852",
                                                "text": "Copier en plusieurs exemplaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                        "entry_id": "02be11c1-f661-3adc-85af-c177a80aa17a",
                                        "glosses": [
                                            "Reproduire par une imitation exacte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15923d7a-febe-47de-918e-d477d630cd66",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Cet article est directement copié du Dictionnaire de l'Académie."
                                            },
                                            {
                                                "example_id": "f9b26197-98fd-46a5-a3ad-dbfba3c09570",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Copier fidèlement, exactement."
                                            },
                                            {
                                                "example_id": "4918312c-1a7c-4de8-b791-9c0f42457cfb",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Ce jeune homme copie en tout son père, copie jusqu’aux défauts de son ami."
                                            },
                                            {
                                                "example_id": "5653d41d-f208-4a1e-b7fb-f231843d0e86",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Il s’attache à copier ce qu’il y a de meilleur dans son modèle."
                                            },
                                            {
                                                "example_id": "15b56e5b-fd14-4cac-beb0-6fd2b6f450b6",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Copier un auteur, un artiste, Tâcher d’imiter sa manière."
                                            },
                                            {
                                                "example_id": "be9cf598-56f7-411e-a7b1-e9e860247e59",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Mais New York ne copiait aucun peuple pour le désordre et le gâchis de son administration intérieure, […]."
                                            },
                                            {
                                                "example_id": "c2737dd3-5cd6-4847-a2a1-c9b916a926d1",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Copier un tableau."
                                            },
                                            {
                                                "example_id": "7774c5e6-1df8-41ef-b902-9ee817debd44",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Copier une statue."
                                            },
                                            {
                                                "example_id": "7b4d486b-eb45-4d4c-91b4-e252a8e5b5da",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Copier un bas-relief."
                                            },
                                            {
                                                "example_id": "f312f663-61fa-4fee-934f-4768e25ea0e4",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Ce tableau est bien copié."
                                            },
                                            {
                                                "example_id": "3a477202-3f1e-4d31-836f-ad4d7680e755",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Ce dôme, ce palais est copié sur tel bâtiment. Absolument,"
                                            },
                                            {
                                                "example_id": "dfdc76ab-b24a-4c9c-8e93-de81b734125e",
                                                "sense_id": "21eb95b9-692c-3ae9-9dfe-6a632dce4531",
                                                "text": "Cet écrivain manque d’invention, mais il copie assez habilement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61e0a34c-f771-3e3a-8a16-4fc310e5e54e",
                                        "entry_id": "02be11c1-f661-3adc-85af-c177a80aa17a",
                                        "glosses": [
                                            "Se dit d’un peintre qui se répète, qui n’est pas varié dans les attitudes, dans son ton ; ou d’un auteur qui n’a qu’un petit nombre d’idées, qui ne sait point varier les formes qu’il emploie."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26b774ab-4500-426f-ae53-49200fa76c56",
                                                "sense_id": "61e0a34c-f771-3e3a-8a16-4fc310e5e54e",
                                                "text": "Ce peintre, cet écrivain a peu d’imagination, et il lui arrive souvent de se copier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b71bd6e9-0328-38ad-8860-023d5a344de6",
                                        "entry_id": "02be11c1-f661-3adc-85af-c177a80aa17a",
                                        "glosses": [
                                            "Tricher en classe ou à un examen en regardant la copie de son voisin de classe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2f76cca-ce12-462a-b5e2-4fc6ba7bad82",
                                                "sense_id": "b71bd6e9-0328-38ad-8860-023d5a344de6",
                                                "text": "« – Moi, je suis complètement nul. Tu me feras copier sur toi.\n– Copier quoi ?\n– Les devoirs, parbleu ! Pour que ça ne se voie pas, j’ajouterai quelques fautes, et alors… »\nIl se frotta les mains joyeusement.\nJe fus stupéfait. Copier sur son voisin, c’était une action déshonorante. Et il parlait d’y avoir recours non pas dans un cas désespéré, mais d’une façon quotidienne !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5091c0c2-735d-3d33-95dd-bf34995cc28a",
                                        "entry_id": "02be11c1-f661-3adc-85af-c177a80aa17a",
                                        "glosses": [
                                            "Recevoir par CB."
                                        ],
                                        "tags": [
                                            "CB"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
