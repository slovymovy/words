                "senses": [
                    {
                        "sense_id": "2149a3c7-87a3-3814-8296-69df3aca619b",
                        "entry_id": "0ba32e13-f650-3477-aee1-1ab36fa4af40",
                        "glosses": [
                            "Personne qui a commis un suicide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "038235c3-6142-466c-ae50-022f48502f18",
                                "sense_id": "2149a3c7-87a3-3814-8296-69df3aca619b",
                                "text": "En Allemagne, en France, et même dans l’Angleterre victorienne, la montée de l’autoritarisme familial produit des schizophrènes, des suicidés, des alcooliques. L'éducation devient persécution."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f22c418d-ccf1-445a-ae9e-71c95d25ffca",
                        "source_entry_id": "0ba32e13-f650-3477-aee1-1ab36fa4af40",
                        "source_sense_id": "2149a3c7-87a3-3814-8296-69df3aca619b",
                        "target_lang_word": "Selbstmörder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstmörder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49c0999f-683b-30c3-8df8-c8c464da50e0",
                                        "entry_id": "20f7adc3-d001-37a3-90f2-29a7d728b2ce",
                                        "glosses": [
                                            "Person, die sich absichtlich selbst das Leben nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c32bdad-b46f-42e4-92ab-e63b4ecb8b9d",
                                                "sense_id": "49c0999f-683b-30c3-8df8-c8c464da50e0",
                                                "text": "Selbstmörder wurden früher außerhalb der Friedhofsmauern verscharrt."
                                            },
                                            {
                                                "example_id": "5133d006-e785-4db7-a0fb-bdae8515dcdf",
                                                "sense_id": "49c0999f-683b-30c3-8df8-c8c464da50e0",
                                                "text": "„Wenig später machte der erste Selbstmörder von der Aussichtsterrasse Gebrauch.“"
                                            },
                                            {
                                                "example_id": "58400111-b93f-456d-9715-ccee0a66c103",
                                                "sense_id": "49c0999f-683b-30c3-8df8-c8c464da50e0",
                                                "text": "„Sie verrieten und bekämpften einander, gingen auf die Selbstmörder los, komplottierten für den abtrünnigen General, ließen sich von den Touristen aus Großbritannien mit Krümeln abspeisen.“"
                                            },
                                            {
                                                "example_id": "95ca23d5-160c-40a6-b0c6-e93a5c3902c2",
                                                "sense_id": "49c0999f-683b-30c3-8df8-c8c464da50e0",
                                                "text": "„Sarale wurde außerhalb des Zauns begraben, wie es das Gesetz für Selbstmörder verlangte.“"
                                            },
                                            {
                                                "example_id": "234e54d1-ba0e-4e44-a336-4d3b2604188c",
                                                "sense_id": "49c0999f-683b-30c3-8df8-c8c464da50e0",
                                                "text": "„Der Selbstmörder, so die Schranke, durfte ihn gewiss nicht erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
