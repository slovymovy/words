                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a64bf53d-bd81-4d41-911a-df4da80a22b7",
                                "sense_id": "81818808-e96d-376e-ba83-38fc4aa9e19f",
                                "text": "Тут натуральное отступает перед возможностями синтетики ― пластика, техногеля, полиуретана."
                            },
                            {
                                "example_id": "46aa8e66-90bc-4a56-adab-93a4821af904",
                                "sense_id": "81818808-e96d-376e-ba83-38fc4aa9e19f",
                                "text": "Подберите для своей работы цветовую гамму из пряжи: подойдут любые нитки, будь то хлопок, синтетика или шерсть."
                            }
                        ]
                    }
