                                        "entry_id": "f048cba5-2afc-34ea-a8a7-59c73be394d6",
                                        "glosses": [
                                            "een stuk materiaal dat alleen elektronische geleiding kent en dat dient om een stroom door een eletrolyt of een vacuüm te voeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccc11dc1-1202-47a0-bbc7-c1ef7b5967e6",
                                                "sense_id": "aa9f8118-9f4e-39fd-a237-40038a00ba13",
