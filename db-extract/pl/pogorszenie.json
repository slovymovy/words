                                        "glosses": [
                                            "результат такого действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d6b1597-aad0-4280-821f-629a0934cd63",
                                                "sense_id": "e8aa93ec-087d-3e5d-9bc0-34564bd1e062",
                                                "text": "Это приводит как к ухудшению здоровья, так и экономическим потерям, оцениваемым в миллиарды долларов."
                                            }
