                "senses": [
                    {
                        "sense_id": "2701ec38-c36e-347c-9b51-109e3665c9aa",
                        "entry_id": "a4e416d8-c645-3c6b-8745-2bb20047b828",
                        "glosses": [
                            "Apparat zur Messung der elektrischen Ladung"
                        ],
                        "tags": [
                            "historical",
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "f1cf29ec-3f7d-4589-85cf-9a4e2afac881",
                                "sense_id": "2701ec38-c36e-347c-9b51-109e3665c9aa",
                                "text": "„Um die Stärke eines galvanischen Stromes mit dem Voltameter zu messen, braucht man dasselbe nur in den Schliessungsdraht einzuschalten und den Stand der Uhr zu merken.“"
                            },
                            {
                                "example_id": "68666fd0-3eac-4dbd-9499-f385e66dfc88",
                                "sense_id": "2701ec38-c36e-347c-9b51-109e3665c9aa",
                                "text": "„Die Equipe überprüfte mithilfe eines Voltameters zunächst alle möglichen Drahtverbindungen – über 56 000 an der Zahl – und zeichnete einen neuen Bauplan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
