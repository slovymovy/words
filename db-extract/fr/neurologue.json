                ],
                "senses": [
                    {
                        "sense_id": "df0ae4ee-7b10-3622-a304-faafdb21e1a2",
                        "entry_id": "9e5587c9-a503-3875-b9f9-871ad47fe3e1",
                        "glosses": [
                            "Médecin spécialiste du système nerveux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0dd02c-a48f-4b6c-b78c-d4f65f80a0a9",
                                "sense_id": "df0ae4ee-7b10-3622-a304-faafdb21e1a2",
                                "text": "\"Nous avions déjà montré que le profil du microbiote intestinal chez les patients atteints de la maladie d'Alzheimer était altéré par rapport aux personnes ne souffrant pas de pareils troubles\", explique le neurologue Giovanni Frisoni de l'Université de Genève (UNIGE) dans un communiqué."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0eda41a-693e-4147-8bb3-39783c0c069b",
                        "source_entry_id": "9e5587c9-a503-3875-b9f9-871ad47fe3e1",
                        "source_sense_id": "df0ae4ee-7b10-3622-a304-faafdb21e1a2",
                        "source_sense_description": "Docteur en neurologie (1):",
                        "target_lang_word": "Neurologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neurologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb2913f1-83ea-3b60-93c0-29571b50fbb1",
                                        "entry_id": "f3823393-d803-3925-bf05-1842bc52a4e0",
                                        "glosses": [
                                            "ein Facharzt für Nervenheilkunde (Neurologie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a06657d9-4ded-4e54-8bb6-fe7115f718ed",
                                                "sense_id": "fb2913f1-83ea-3b60-93c0-29571b50fbb1",
                                                "text": "Jeder Patient mit Verdacht auf einen Schlaganfall wird von einem Neurologen untersucht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c853188-fb82-4449-9b54-e960ae033411",
                        "source_entry_id": "9e5587c9-a503-3875-b9f9-871ad47fe3e1",
                        "source_sense_id": "df0ae4ee-7b10-3622-a304-faafdb21e1a2",
                        "source_sense_description": "Docteur en neurologie (1):",
                        "target_lang_word": "Neurologin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neurologin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0f9eef4-c515-325b-a90a-5f637f52a55b",
                                        "entry_id": "61f1bbe1-fd3c-3fdd-a8a9-84ac6fab2e2a",
                                        "glosses": [
                                            "eine Fachärztin für Nervenheilkunde (Neurologie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af8372c-8b56-4f0c-b0e7-ccc7676db52a",
                                                "sense_id": "e0f9eef4-c515-325b-a90a-5f637f52a55b",
                                                "text": "Nach dem Schlaganfall wurde ich von einer Neurologin untersucht."
                                            },
                                            {
                                                "example_id": "6d965f59-9b3c-49fe-b8a0-5bcebbfeb48f",
                                                "sense_id": "e0f9eef4-c515-325b-a90a-5f637f52a55b",
                                                "text": "„Die Neurologin kam, legte mir eine Blutdruckmanschette an und pumpte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ff750a4-673f-41d4-80b4-019075262a32",
                        "source_entry_id": "9e5587c9-a503-3875-b9f9-871ad47fe3e1",
                        "source_sense_id": "df0ae4ee-7b10-3622-a304-faafdb21e1a2",
                        "source_sense_description": "Docteur en neurologie (1):",
                        "target_lang_word": "neurologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "702938e6-9bb2-38a4-b5d7-7f454e316d1d",
                                        "entry_id": "95a26307-01b4-3538-b8b3-0e7bff6a219c",
                                        "glosses": [
                                            "A doctor or scientist who practices or specializes in neurology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d41657-ae7d-489d-9348-d1c4c9ebfd8d",
                                                "sense_id": "702938e6-9bb2-38a4-b5d7-7f454e316d1d",
                                                "text": "When a neurologist ruled out medical causes like Lyme disease, Ms. Abaspour recalled, her husband said, “I think we should just give her a placebo — it’s all in her head.”"
                                            },
                                            {
                                                "example_id": "5cf1fd9f-e1d5-4bcc-b3c8-f860c8014f68",
                                                "sense_id": "702938e6-9bb2-38a4-b5d7-7f454e316d1d",
                                                "text": "And most neurologists are in the habit of prescribing antispasticity drugs like tizanidine and baclofen, which are oral and inexpensive, but which cause drowsiness and weaken every muscle in the body, not just the target ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
