                                        "sense_id": "4a6d782f-328a-30a4-af6f-55e589559489",
                                        "entry_id": "cfed6fb1-40d9-377f-809c-bae98407f1e0",
                                        "glosses": [
                                            "Becoming weaker or smaller."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5346f853-5a9b-48ba-8317-e360b04fbbec",
                                                "sense_id": "4a6d782f-328a-30a4-af6f-55e589559489",
                                                "text": "his waning strength"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad0745a4-ce46-3f46-8abe-336a0e6f104d",
                                        "entry_id": "cfed6fb1-40d9-377f-809c-bae98407f1e0",
                                        "glosses": [
                                            "Of the lunar phase: as it shrinks when viewed from the Earth."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "418de9cb-f569-4f54-954e-a9858dd13bf2",
                                                "sense_id": "ad0745a4-ce46-3f46-8abe-336a0e6f104d",
                                                "text": "the waning moon"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "waning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5abb382f-c50e-32c5-91d8-a4679afdb00d",
                                        "entry_id": "7d89a3b7-35ac-305d-aaa0-ea72ad49ac2a",
                                        "glosses": [
                                            "The fact or act of becoming less or less intense or present; fading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a36fead7-889d-4510-827a-e920e18ced96",
                                                "sense_id": "5abb382f-c50e-32c5-91d8-a4679afdb00d",
                                                "text": "the waning of her energy"
                                            },
                                            {
                                                "example_id": "401c4e6d-9d96-4c2e-9849-c88bb848253f",
                                                "sense_id": "5abb382f-c50e-32c5-91d8-a4679afdb00d",
                                                "text": "And boyhood is a summer sun\nWhose waning is the dreariest one —\nFor all we live to know is known\nAnd all we seek to keep hath flown — […]"
                                            },
                                            {
                                                "example_id": "e960140f-14ed-4cec-9636-4c63169f18e7",
                                                "sense_id": "5abb382f-c50e-32c5-91d8-a4679afdb00d",
                                                "text": "Soothed again, but only soothed to deeper gloom, Ahab, who had sterned off from the whale, sat intently watching his final wanings from the now tranquil boat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "898f5ae2-8113-307a-ad23-0d9c6562abe7",
                                        "entry_id": "7d89a3b7-35ac-305d-aaa0-ea72ad49ac2a",
                                        "glosses": [
                                            "The fact or act of becoming smaller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "511826ca-69b9-4cd0-a6b4-65c26e2381a6",
                                                "sense_id": "898f5ae2-8113-307a-ad23-0d9c6562abe7",
                                                "text": "17th century, Joseph Hall, Epistle to Mr. R. B.\nThis earthly moon, the Church, hath her fulls and wanings, and sometimes her eclipses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a40faa1-88fb-4d59-a584-bf5b858d0c1a",
                        "source_entry_id": "4c6a1ef3-9453-383a-996e-dcf6dcb95a14",
                        "source_sense_description": "En mathématiques",
                        "target_lang_word": "fallend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fallend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                        "entry_id": "66d29564-9de6-3d83-b145-a5abfc0772af",
                                        "glosses": [
                                            "sich von oben nach unten bewegend, in der Höhe abnehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33893e7-7caa-4179-956a-eb066a3ba594",
                                                "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                                "text": "Der leise fallende Schnee deckte gleichmäßig die Erde zu."
                                            },
                                            {
                                                "example_id": "e18d6d2d-7645-444a-895f-9f974e0e39cf",
                                                "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                                "text": "Der vom Gerüst fallende Arbeiter schrie laut auf: „Aaaaahhhhh …“."
                                            },
                                            {
                                                "example_id": "9c50cf3b-c60d-480c-b9bb-afdbaacc7df7",
                                                "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                                "text": "Ein fallender Apfel inspirierte Newton angeblich bei der Entdeckung der Gravitationsgesetze."
                                            },
                                            {
                                                "example_id": "bc605b14-cd66-47c6-a636-c8093f5a40b5",
                                                "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                                "text": "„Seit Jahren wird von der fallenden Arbeitslosigkeit in Deutschland erzählt. Bemerkt habe ich davon in meinem Bekanntenkreis noch nichts.“"
                                            },
                                            {
                                                "example_id": "60a904b6-ce9b-40b3-af0e-2afa2d10ecb1",
                                                "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                                "text": "Die fallenden Aktienkurse nach der Lehman-Pleite lösten die größte Finanzkrise seit dem schwarzen Freitag 1929 aus."
                                            },
                                            {
                                                "example_id": "c1f17fe1-1181-4f37-b339-5f22a9aae9d9",
                                                "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                                "text": "Als Konsequenz aus der Finanzkrise will die EU hochspekulative Hedgefonds an die Leine legen. In Deutschland werden bestimmte Wetten auf fallende Kurse untersagt."
                                            },
                                            {
                                                "example_id": "e23c06d2-bc55-4072-8b92-3f240780d051",
                                                "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                                "text": "Trotz stetig fallender Ölpreise will die OPEC die derzeitige Fördermenge der erdölexportierenden Länder beibehalten."
                                            },
                                            {
                                                "example_id": "e371d964-6116-4030-b805-1466314558a3",
                                                "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                                "text": "Eine fallende Melodie am Satzende zeigt im Deutschen, dass eine Aussage abgeschlossen ist."
                                            },
                                            {
                                                "example_id": "3f80a526-b34c-4c8e-acf3-85dd55ce911c",
                                                "sense_id": "ce94c878-8f4d-33b2-a49d-98aa9aeee23d",
                                                "text": "„Das kontinuierlich fallende Niveau der Talkshows bringt mich dazu, den Fernseher einfach auszulassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
