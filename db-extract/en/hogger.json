                    {
                        "sense_id": "962604cf-9b1b-38b5-ab4c-2db3e74edec6",
                        "entry_id": "a9579380-7f55-34da-8b10-9be1f5b77249",
                        "glosses": [
                            "A shot that comes to rest short of or on the far hog line and is removed from play."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d05fe74c-5710-3513-9eb9-99e8b20c10a3",
                        "entry_id": "a9579380-7f55-34da-8b10-9be1f5b77249",
                        "glosses": [
                            "The engineer of a locomotive."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "eab72773-244b-47e2-9121-2301d3551cee",
                                "sense_id": "d05fe74c-5710-3513-9eb9-99e8b20c10a3",
                                "text": "Twenty- five demerit marks would make most hoggers sit up and take notice ; but not Jones."
                            },
                            {
                                "example_id": "35449c59-ea21-4592-9d3c-ad5198734a93",
                                "sense_id": "d05fe74c-5710-3513-9eb9-99e8b20c10a3",
                                "text": "What had happened was this : A yardgoat crew had gone into this lead and left the gate wide open, and neither the hogger nor the fire boy on the passenger saw this open switch right in broad daylight."
                            },
                            {
                                "example_id": "e2d4b2e0-6dc2-4015-a746-7adeff701e68",
                                "sense_id": "d05fe74c-5710-3513-9eb9-99e8b20c10a3",
                                "text": "\"Go ahead and laugh,\" snapped the conductor. \"But I'll bet this kid will be bossin' a Monarch, maybe even No. 23, long before you get to be hogger of a yardgoat!\""
                            },
                            {
                                "example_id": "dfbdcf19-0628-4bb3-9236-a4465bf688a3",
                                "sense_id": "d05fe74c-5710-3513-9eb9-99e8b20c10a3",
                                "text": "Even though he was a veteran railroader, many white hoggers snubbed him until they saw that he was thoroughly qualified, a response that would not have greeted a new white runner."
                            }
                        ]
                    }
