                        ],
                        "form": "die Gartenhäuser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd4bd2f4-b80b-3e58-a0a2-ae4990848f43",
                        "entry_id": "69f58824-296d-373c-90dc-edc063b7e066",
                        "glosses": [
                            "ein in einem Garten errichtetes (kleines) Haus, das zum vorübergehenden Aufenthalt, aber nicht zum dauerhaften Wohnen geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b9a6444-fa96-4d9e-b3f4-7b0665a6d35e",
                                "sense_id": "bd4bd2f4-b80b-3e58-a0a2-ae4990848f43",
                                "text": "Der Rasenmäher ist im Gartenhaus."
                            },
                            {
                                "example_id": "3e7637ae-cba9-414c-b597-06211140c984",
                                "sense_id": "bd4bd2f4-b80b-3e58-a0a2-ae4990848f43",
                                "text": "„Der Maler Lech wohnt in einem Gartenhaus Schwabings.“"
                            },
                            {
                                "example_id": "b293a6e2-23f8-42d5-995e-8923c06517d4",
                                "sense_id": "bd4bd2f4-b80b-3e58-a0a2-ae4990848f43",
                                "text": "„Vorsichtig schlichen sie um das Haus herum und sahen, dass unten im Gartenhaus noch Licht brannte.“"
                            },
                            {
                                "example_id": "d5c3a5e2-9d39-49e5-b5d9-025bf448b047",
                                "sense_id": "bd4bd2f4-b80b-3e58-a0a2-ae4990848f43",
                                "text": "„Im Gartenhaus Greens trafen sich nach dem Essen die Freunde, wobei es sich oft ereignete, dass Kant bei seiner Ankunft Green schlafend vorfand.“"
                            },
                            {
                                "example_id": "61571b87-81d2-4915-8d6b-ff6052003ca0",
                                "sense_id": "bd4bd2f4-b80b-3e58-a0a2-ae4990848f43",
                                "text": "„Er kommt bei einem Maler in einem Gartenhaus unter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e98a5631-9700-344d-85a3-009bbf765446",
                        "entry_id": "69f58824-296d-373c-90dc-edc063b7e066",
                        "glosses": [
                            "an einem bepflanzten Innenhof gelegener Teil eines Büro- oder Wohnhauses, oft das Hinterhaus eines zusätzlich aus Vorderhaus und Seitenflügeln bestehenden Gebäudekomplexes, den man in Berlin häufig als Mietshaus in besseren Wohnlagen antrifft."
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "6b623c14-9df7-4119-95d5-68a87142b0a1",
                                "sense_id": "e98a5631-9700-344d-85a3-009bbf765446",
                                "text": "Die Gewerberäume zur Büronutzung befinden sich im Erdgeschoß des Gartenhauses eines renovierten Altbaus in der Sonnenallee."
                            },
                            {
                                "example_id": "38b4d71f-90c6-4b42-84cd-26885d279f32",
                                "sense_id": "e98a5631-9700-344d-85a3-009bbf765446",
                                "text": "„Gegen die Späher des MfS wurde im Gartenhaus der Vertretung ein gegen Überwachung jeder Art isolierter Raum eingebaut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
