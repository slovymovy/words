                ],
                "senses": [
                    {
                        "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                        "entry_id": "0dbbaca2-ba41-3161-a40b-90c0661eecf0",
                        "glosses": [
                            "Toilette für Männer mit Becken zum Urinieren im Stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ad5ecc-9235-4260-ab39-72fcd52f62b8",
                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                "text": "„Im Pissoir des »Adler« hatte ein Unbekannter an die Wand geschrieben, »der Arbeiter, wo Hindenburg oder Hitler wählt, gehört mein Lebetag gequält«.“"
                            },
                            {
                                "example_id": "7d6b78f7-50e4-4e19-a6b4-ee7caf755aac",
                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                "text": "„Die ersten öffentlichen Pissoirs wurden errichtet, die Anwohner allerdings protestierten gegen die neuen »Stinkbuden«.“"
                            },
                            {
                                "example_id": "e9e6684a-4ecc-48d3-9e2e-709b427c1443",
                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                "text": "„Stuff stellt sich im Pissoir an das Becken neben Kalübbe.“"
                            },
                            {
                                "example_id": "431d1441-fb6b-44b7-b621-eef63400543e",
                                "sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                                "text": "„Als zwei Männer hereinkamen, die sich am Pissoir weiter auf italienisch unterhielten, atmete er unwillkürlich ganz flach und rührte sich nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd954bd6-c62b-4ac8-9c79-decafb8a62ff",
                        "source_entry_id": "0dbbaca2-ba41-3161-a40b-90c0661eecf0",
                        "source_sense_id": "90dd5c48-4346-3fb7-adcb-5a078cc87b3c",
                        "source_sense_description": "Toilette für Männer mit Becken zum Urinieren im Stehen",
                        "target_lang_word": "pissoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pissoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "765330c4-fa36-3194-b78a-ff39b77a0e87",
                                        "entry_id": "3014c41b-a0f9-30be-ba85-0844fece32d8",
                                        "glosses": [
                                            "ou Cabinet d’aisance."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47dd9f3c-e465-427b-b1c9-ef02deaa76bf",
                                                "sense_id": "765330c4-fa36-3194-b78a-ff39b77a0e87",
                                                "text": "Cette pièce I est très-petite à la vérité ; mais comme pissoir , elle est suffisante; d'ailleurs on auroit pu la rendre plus grande , sans altérer la construction des murs; […]."
                                            },
                                            {
                                                "example_id": "f37a1c28-3027-4e91-90fa-4bdd12f515af",
                                                "sense_id": "765330c4-fa36-3194-b78a-ff39b77a0e87",
                                                "text": "Derrière ce poste, la porte tout à fait pourrie d'un cabinet de toilette, ou plutôt d'un pissoir puant dans lequel les condamnés viennent encore pour fumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fb1f26b-d14a-37bc-87b3-3f38cbebe281",
                                        "entry_id": "3014c41b-a0f9-30be-ba85-0844fece32d8",
                                        "glosses": [
                                            "Urinoir."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b55dc11-5f56-4833-81b3-1767f558eb0c",
                                                "sense_id": "6fb1f26b-d14a-37bc-87b3-3f38cbebe281",
                                                "text": "Au pissoir, Schabowski s’adresse avec chaleur à Modrow : « Tes critiques étaient fondées. Je suis solidaire avec toi »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f055abe2-82ed-33e8-bdfd-f437f2c7d82f",
                                        "entry_id": "3014c41b-a0f9-30be-ba85-0844fece32d8",
                                        "glosses": [
                                            "Lieu public pour pisser."
                                        ],
