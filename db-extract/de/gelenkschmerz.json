                        "sense_id": "296697bd-f56e-3866-b273-1006890aeb22",
                        "entry_id": "8138c9db-10b5-3f4b-81ae-bbce87c22bb7",
                        "glosses": [
                            "Schmerz, der in einem Gelenk des menschlichen Körpers – zum Beispiel im Knie – verspürt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa57eb1-82e5-48ee-81a7-afbdf362d16d",
                                "sense_id": "296697bd-f56e-3866-b273-1006890aeb22",
                                "text": "Gelenkschmerzen können simple Ursachen wie Überlastung haben, aber auch ernsthafte wie Arthritis oder Arthrose."
                            },
                            {
                                "example_id": "a41ef9c4-a3e8-45b0-a37c-412702ac2d74",
                                "sense_id": "296697bd-f56e-3866-b273-1006890aeb22",
                                "text": "Gegen Abend nahmen die Gelenkschmerzen zu."
                            },
                            {
                                "example_id": "f445ecae-13b4-4a4a-968b-8368754addca",
                                "sense_id": "296697bd-f56e-3866-b273-1006890aeb22",
                                "text": "Manchmal hilft eine Kältetherapie gegen Gelenkschmerz."
                            }
                        ],
                        "sense_index_json": "\"1\""
