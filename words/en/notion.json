{
    "word_family": [
        "notional",
        "notionally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a024f30e-0f7a-3e41-8bae-f3f190c00067",
                    "sense_definition": "A general understanding, idea, or concept of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "idea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>notion</w> of time travel has fascinated scientists and writers for centuries.",
                            "target_lang_translations": {
                                "ru": "<w>Понятие</w> путешествия во времени веками очаровывало ученых и писателей."
                            }
                        },
                        {
                            "text": "She had a vague <w>notion</w> that the meeting was scheduled for Tuesday morning.",
                            "target_lang_translations": {
                                "ru": "У нее было смутное <w>представление</w> о том, что встреча назначена на утро вторника."
                            }
                        }
                    ],
                    "synonyms": [
                        "concept",
                        "idea",
                        "conception"
                    ],
                    "antonyms": [
                        "fact",
                        "reality"
                    ],
                    "common_phrases": [
                        "vague notion",
                        "preconceived notion",
                        "abstract notion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее понимание, идея или концепция чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понятие",
                                "target_lang_sense_clarification": "логически оформленная мысль или концепция"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "знание или осведомленность о чем-либо"
                            },
                            {
                                "target_lang_word": "идея",
                                "target_lang_sense_clarification": "основная мысль или замысел"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a670512c-3cef-33ba-9ce2-838bf9a69b44",
                    "sense_definition": "A personal belief, sentiment, or opinion about a particular matter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rejected the <w>notion</w> that success is only measured by wealth.",
                            "target_lang_translations": {
                                "ru": "Он отверг <w>мнение</w> о том, что успех измеряется только богатством."
                            }
                        },
                        {
                            "text": "Many people challenge the <w>notion</w> that technology always improves our quality of life.",
                            "target_lang_translations": {
                                "ru": "Многие люди оспаривают <w>убеждение</w>, что технологии всегда улучшают качество нашей жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "belief",
                        "opinion",
                        "view",
                        "sentiment"
                    ],
                    "common_phrases": [
                        "challenge the notion",
                        "popular notion",
                        "mistaken notion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Личное убеждение, чувство или мнение по конкретному вопросу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мнение",
                                "target_lang_sense_clarification": "точка зрения или оценка"
                            },
                            {
                                "target_lang_word": "убеждение",
                                "target_lang_sense_clarification": "твердая уверенность в чем-либо"
                            },
                            {
                                "target_lang_word": "взгляд",
                                "target_lang_sense_clarification": "позиция по какому-либо вопросу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73abc020-8690-3567-867c-0cb81bf1ec0b",
                    "sense_definition": "A sudden inclination, impulse, or desire to do something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inclination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a sudden <w>notion</w> to quit my job and travel the world.",
                            "target_lang_translations": {
                                "ru": "У меня возникло внезапное <w>желание</w> бросить работу и отправиться в кругосветное путешествие."
                            }
                        },
                        {
                            "text": "She often acts on a <w>notion</w> without thinking about the consequences.",
                            "target_lang_translations": {
                                "ru": "Она часто действует по <w>наитию</w>, не задумываясь о последствиях."
                            }
                        }
                    ],
                    "synonyms": [
                        "impulse",
                        "inclination",
                        "whim",
                        "fancy"
                    ],
                    "common_phrases": [
                        "have a notion",
                        "sudden notion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная склонность, импульс или желание что-то сделать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причуда",
                                "target_lang_sense_clarification": "странное или внезапное желание"
                            },
                            {
                                "target_lang_word": "импульс",
                                "target_lang_sense_clarification": "внезапное побуждение к действию"
                            },
                            {
                                "target_lang_word": "желание",
                                "target_lang_sense_clarification": "внезапно возникшее стремление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d57bd841-2045-3ff3-b8b1-6080beeb37cb",
                    "sense_definition": "Small items used in sewing and haberdashery, such as buttons, zippers, or thread.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sewing_items",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The craft store has a large section dedicated to sewing <w>notions</w> like needles and pins.",
                            "target_lang_translations": {
                                "ru": "В магазине товаров для рукоделия есть большой отдел, посвященный швейной <w>галантерее</w>, такой как иголки и булавки."
                            }
                        },
                        {
                            "text": "I need to buy some <w>notions</w> before I can finish making this dress.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить кое-какие <w>швейные принадлежности</w>, прежде чем я смогу закончить это платье."
                            }
                        }
                    ],
                    "synonyms": [
                        "haberdashery"
                    ],
                    "common_phrases": [
                        "sewing notions"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мелкие предметы, используемые в шитье и галантерее, такие как пуговицы, молнии или нитки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галантерея",
                                "target_lang_sense_clarification": "швейные принадлежности и мелкие товары"
                            },
                            {
                                "target_lang_word": "швейные принадлежности",
                                "target_lang_sense_clarification": "инструменты и материалы для шитья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09f1a45b-5ced-3e36-b09b-b7fbbe485ece",
                    "sense_definition": "A small, clever invention or a decorative knickknack.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The peddler sold various Yankee <w>notions</w> and household gadgets to the villagers.",
                            "target_lang_translations": {
                                "ru": "Разносчик продавал жителям деревни различные американские <w>безделушки</w> и бытовые приспособления."
                            }
                        },
                        {
                            "text": "His desk was covered in strange little <w>notions</w> he had collected over the years.",
                            "target_lang_translations": {
                                "ru": "Его стол был завален странными маленькими <w>вещицами</w>, которые он собирал годами."
                            }
                        }
                    ],
                    "synonyms": [
                        "knickknack",
                        "trinket",
                        "gadget",
                        "device"
                    ],
                    "common_phrases": [
                        "Yankee notions"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое умное изобретение или декоративная безделушка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безделушка",
                                "target_lang_sense_clarification": "маленькая декоративная вещь"
                            },
                            {
                                "target_lang_word": "приспособление",
                                "target_lang_sense_clarification": "небольшое хитроумное устройство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}