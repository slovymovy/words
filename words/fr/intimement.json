                        "intimement persuadé"
                    ]
                },
                {
                    "sense_id": "9b836957-074b-3d81-b004-55d43dc58353",
                    "sense_definition": "D'une manière étroite et familière, ou avec une grande proximité affective ou conceptuelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces deux événements historiques sont <w>intimement</w> liés l'un à l'autre."
                        },
                        {
                            "text": "Ils se connaissent <w>intimement</w> depuis des années et n'ont aucun secret entre eux."
                        }
                    ],
                    "synonyms": [
                        "étroitement"
                    ],
                    "common_phrases": [
                        "intimement liés",
                        "connaître intimement"
                    ]
                },
                {
                    "sense_id": "d03090a9-5864-35d9-9d0b-0eb258d94105",
                    "sense_definition": "De manière très étroite et homogène, en parlant des composants d'une matière ou d'un mélange.",
