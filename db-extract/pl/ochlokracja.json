                ],
                "senses": [
                    {
                        "sense_id": "292866cf-b53d-306d-94de-dc8c73a7f432",
                        "entry_id": "a7b03fc8-e8a0-3a6d-8ad6-b5d2584ceb00",
                        "glosses": [
                            "rządy motłochu, zwyrodniała forma demokracji, w której władza jest sprawowana bez żadnych struktur i zasad prawnych, bezpośrednio przez niezorganizowany i ulegający emocjom tłum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "556bb82c-5ba0-4edc-8a4f-30212816f1f2",
                                "sense_id": "292866cf-b53d-306d-94de-dc8c73a7f432",
                                "text": "„Ochlokracja\" sprzyjać miała bezklasowości podporządkowanego społeczeństwa, w którym posłuszeństwo zbudowano na strachu i przymusie pracy, a kultura materialna nie znajdywała bodźców do rozwoju"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a231e8cd-2912-4877-a528-d99114820bc3",
                        "source_entry_id": "a7b03fc8-e8a0-3a6d-8ad6-b5d2584ceb00",
                        "source_sense_id": "292866cf-b53d-306d-94de-dc8c73a7f432",
                        "target_lang_word": "ochlocracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ochlocracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db74e3c8-c0ae-3ca3-ad1c-73b52d477ae3",
                                        "entry_id": "292653f9-0186-3b06-ade6-d058708f5bb4",
                                        "glosses": [
                                            "Mob rule; government by the masses; mobocracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76a6e87b-d8bd-48c4-86e1-51b35d10a01f",
                                                "sense_id": "db74e3c8-c0ae-3ca3-ad1c-73b52d477ae3",
                                                "text": "Referendums are snapshots of sentiment at a given point in time. Government by referendum is government by crowd acclamation: not democracy, but ochlocracy. That is exactly why we have representative democracy. If referendums would be a poor way to decide on health and safety, air traffic control, or education, they are an exceedingly poor way to decide a matter as momentous as membership of the EU. This is and should be a matter for Parliament, taking all factors into account."
                                            },
                                            {
                                                "example_id": "4338b099-7dfd-4094-b939-832f7c278197",
                                                "sense_id": "db74e3c8-c0ae-3ca3-ad1c-73b52d477ae3",
                                                "text": "This constitutes a grave threat to the American Republic and degrades it into an Ochlocracy, or government by mob rule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22942c57-268f-4766-9b39-0fe6a7c3e329",
                        "source_entry_id": "a7b03fc8-e8a0-3a6d-8ad6-b5d2584ceb00",
                        "source_sense_id": "292866cf-b53d-306d-94de-dc8c73a7f432",
                        "target_lang_word": "ochlokracie",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ochlokracie",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "90b666bf-2f25-3f23-941c-c5cd8544fa4d",
                                        "entry_id": "a93066a7-1289-3bb5-a610-7858d125663b",
