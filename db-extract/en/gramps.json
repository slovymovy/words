                                    {
                                        "sense_id": "cc7a864c-a6c5-3672-9b45-4e7fad4a04b3",
                                        "entry_id": "50920b06-7172-3daf-a713-c566a23d2d24",
                                        "glosses": [
                                            "Grand-père."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1081319a-2e4e-4d74-aa64-41d421228edf",
                                                "sense_id": "cc7a864c-a6c5-3672-9b45-4e7fad4a04b3",
                                                "text": "Papy Louis et Mamy Albertine dubonnisent, Robert et Jacqueline saint-raphaélisent, Vincent fruite un évian sur fond de jardin quand la cloche de l’église Saint-Boniface pique huit heures."
                                            },
                                            {
                                                "example_id": "bb0e0714-087c-44e5-887f-4d339a1eef3a",
                                                "sense_id": "cc7a864c-a6c5-3672-9b45-4e7fad4a04b3",
                                                "text": "Papy fait de la résistance (film de Jean-Marie Poiré)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca908028-c0ac-3a94-9f6d-90be24e002fd",
                                        "entry_id": "50920b06-7172-3daf-a713-c566a23d2d24",
                                        "glosses": [
                                            "Homme âgé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e63a4a8b-b0bf-464a-8cc1-0564384f0583",
                                                "sense_id": "ca908028-c0ac-3a94-9f6d-90be24e002fd",
                                                "text": "Et j’ai retrouvé l’espoir raisonnable de mourir très vieux, dans un monde où je m’épanouirai comme papy grincheux."
                                            },
                                            {
                                                "example_id": "9cd717d0-b214-4e48-bcd6-73de4099f730",
