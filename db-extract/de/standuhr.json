                ],
                "senses": [
                    {
                        "sense_id": "c7654772-dcf1-3053-8000-66a289cce640",
                        "entry_id": "013b4215-f2a0-370d-8a47-1972b301f1e8",
                        "glosses": [
                            "Pendeluhr, die auf dem Boden steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04dc08ba-492e-469c-8b3a-8917f5688bbd",
                                "sense_id": "c7654772-dcf1-3053-8000-66a289cce640",
                                "text": "In der Bibliothek befindet sich eine alte Standuhr."
                            },
                            {
                                "example_id": "4fe78ba2-bdd0-4919-a5fb-4b888bdab583",
                                "sense_id": "c7654772-dcf1-3053-8000-66a289cce640",
                                "text": "„Auf der Standuhr hat sich beim Umzug ein Pantoffel gefunden, den man vor Jahren vergeblich gesucht hatte.“"
                            },
                            {
                                "example_id": "0841078e-79ce-4105-9c29-6dbff262ed5d",
                                "sense_id": "c7654772-dcf1-3053-8000-66a289cce640",
                                "text": "„Die alte Standuhr in der Diele schlug siebenmal.“"
                            },
                            {
                                "example_id": "63e108a7-ff97-4910-a300-42a17a2d6b8c",
                                "sense_id": "c7654772-dcf1-3053-8000-66a289cce640",
                                "text": "„Das Pendel einer Standuhr zählte die Sekunden, die er schwieg.“"
                            },
                            {
                                "example_id": "bed1f9b7-904b-46e8-89e7-d7d5bc873b35",
                                "sense_id": "c7654772-dcf1-3053-8000-66a289cce640",
                                "text": "„Es war eine alte Standuhr in einer Ecke hinter der Tür.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
