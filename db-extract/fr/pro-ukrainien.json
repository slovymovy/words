                    {
                        "sense_id": "3634b0e0-f898-34fa-bf61-745aa08a4121",
                        "entry_id": "ad51236d-7b2a-31b2-9543-afebf13bf00e",
                        "glosses": [
                            "Favorable à l’Ukraine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a14716db-8077-4d85-b608-262275b97107",
                                "sense_id": "3634b0e0-f898-34fa-bf61-745aa08a4121",
                                "text": "Et sur la forme, son tri revendiqué entre les journalistes et l’exclusion manu militari d’une manifestante pro-ukrainienne n’ont pas manqué de « re-diaboliser » Marine Le Pen."
                            },
                            {
                                "example_id": "18d7dd81-6c5a-4cf0-b2ee-60afeea4c248",
                                "sense_id": "3634b0e0-f898-34fa-bf61-745aa08a4121",
                                "text": "Il resituait l’idéologie de cette société secrète dans la mouvance plus générale du panslavisme et distinguait, dans la Confrérie, un mouvement prorusse et un mouvement pro-ukrainien."
                            },
                            {
                                "example_id": "fbc1c03f-86c0-4434-adf5-af034954c0c0",
                                "sense_id": "3634b0e0-f898-34fa-bf61-745aa08a4121",
                                "text": "Environ 800 civils auraient été pris en otage, des deux côtés, pro-russe et pro-ukrainien."
                            }
                        ]
                    }
