                "senses": [
                    {
                        "sense_id": "ae91c7a7-b7ca-3f25-8175-cf9ca9c56b3b",
                        "entry_id": "558f4323-4fd3-3200-be95-9f4db5f591b8",
                        "glosses": [
                            "afkomstig van levende wezens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffa16c87-3979-4619-b425-05211368c78f",
                                "sense_id": "ae91c7a7-b7ca-3f25-8175-cf9ca9c56b3b",
                                "text": "De onderzoekers vonden zogenoemd biogeen grafiet in het gesteente, dat werd geproduceerd door levende organismen. Ze hebben hoop dat deze ontdekking meer kennis van het oudste leven op aarde zal opleveren."
                            },
                            {
                                "example_id": "6af74aa2-8738-411f-83b8-cf23de1fcfee",
                                "sense_id": "ae91c7a7-b7ca-3f25-8175-cf9ca9c56b3b",
                                "text": "‘Het proces van het leven loopt ten einde; het cyanogeen of biogeen gas verliest knallend zijn vermogen om te exploderen en verandert in dode albumine."
                            }
                        ]
                    }
