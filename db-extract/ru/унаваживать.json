                                "target_senses": [
                                    {
                                        "sense_id": "dbd565ec-ad01-3f21-82d5-7f5fc4bf3ed5",
                                        "entry_id": "64267b3c-4d27-3580-bb69-c3cb7171f512",
                                        "glosses": [
                                            "Manure; animal excrement."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab70749e-1b1d-4f5f-afa7-567b088555fd",
                                                "sense_id": "dbd565ec-ad01-3f21-82d5-7f5fc4bf3ed5",
                                                "text": "Poor Tom, that eats the swimming frog, the toad, the todpole, the wall-newt, and the water; that in the fury of his heart, when the foul fiend rages, eats cow-dung for sallets; swallows the old rat and the ditch-dog; drinks the green mantle of the standing pool[…]"
                                            },
                                            {
                                                "example_id": "af0586e9-4267-44e2-8120-b93aacb9045c",
                                                "sense_id": "dbd565ec-ad01-3f21-82d5-7f5fc4bf3ed5",
                                                "text": "Behold, I will corrupt your seed, and spread dung upon your faces, even the dung of your solemn feasts; and one shall take you away with it."
                                            },
                                            {
                                                "example_id": "5fc63de5-d2ef-4e62-afdf-ad092ae4375f",
                                                "sense_id": "dbd565ec-ad01-3f21-82d5-7f5fc4bf3ed5",
                                                "text": "The labourer at the dung cart is paid at 3d. or 4d. a day; and on one estate, Lullington, scattering dung is paid a 5d. the hundred heaps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b18331dd-5837-3edf-9d2c-4169ecc86e35",
                                        "entry_id": "64267b3c-4d27-3580-bb69-c3cb7171f512",
                                        "glosses": [
                                            "A type of manure, as from a particular species or type of animal."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dung",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc969a69-28d3-39ce-a340-e64f6e6c42b6",
                                        "entry_id": "7d655696-4482-3068-b62d-59f59f8256e7",
                                        "glosses": [
                                            "To fertilize with dung."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "393999cb-e249-4b7f-92d8-9a319623cac5",
                                                "sense_id": "dc969a69-28d3-39ce-a340-e64f6e6c42b6",
                                                "text": "a cart he found, That carry'd compost forth to dung the ground"
                                            },
                                            {
                                                "example_id": "5e4b74c4-9fe1-4fbc-860d-4263e56ddfea",
                                                "sense_id": "dc969a69-28d3-39ce-a340-e64f6e6c42b6",
                                                "text": "She had been dunging the roses and was fairly covered in muck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2394d91b-096c-3651-8d64-a1e9edc2c881",
                                        "entry_id": "7d655696-4482-3068-b62d-59f59f8256e7",
                                        "glosses": [
                                            "To immerse or steep, as calico, in a bath of hot water containing cow dung, done to remove the superfluous mordant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "575891cb-0ab5-348a-ad2a-1c732e3d3eb5",
                                        "entry_id": "7d655696-4482-3068-b62d-59f59f8256e7",
                                        "glosses": [
                                            "To release dung: to defecate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74466798-5a93-40eb-a97b-a00c691706f8",
                                                "sense_id": "575891cb-0ab5-348a-ad2a-1c732e3d3eb5",
                                                "text": "[…] for hungry birds have devoured ſeeds, and having moiſtened and warmed them in their bellies, a little after have dunged in the forky twiſtes of Trees, and together with their dung excluded the ſeed whole which erſt they had ſwallowed: and ſometimes it brings forth there where they dung it, […]"
                                            }
                                        ]
                                    }
