                                "sense_id": "95986e07-f9f1-31e2-94e6-94fec1c230ff",
                                "text": "Pamphile, maître d’Épicure, qui enseignait dans l’île de Samos."
                            },
                            {
                                "example_id": "f710718a-2ac1-4544-a5f6-d5dba15f41af",
                                "sense_id": "95986e07-f9f1-31e2-94e6-94fec1c230ff",
                                "text": "Pamphile d’Amphipolis, peintre du IVe siècle av. J.-C., fondateur de l’école de Sicyone."
                            },
                            {
                                "example_id": "86571d1b-507d-4679-944c-e36dcd02dbde",
                                "sense_id": "95986e07-f9f1-31e2-94e6-94fec1c230ff",
                                "text": "Pamphile d’Alexandrie, grammairien grec du premier siècle, auteur du Leimon, lexique de 95 livres, vers 50."
                            }
                        ]
                    }
