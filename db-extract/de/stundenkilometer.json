                                        "entry_id": "d496b803-987e-343a-87ac-ac59c3fcea7e",
                                        "glosses": [
                                            "Vitesse d’un corps en mouvement, calculée par le rapport de la distance parcourue, exprimée en kilomètres, au temps de parcours, exprimé en heures."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77bed184-3593-48fb-87ad-e43f1f69b241",
                                                "sense_id": "0ecdd5ef-08f8-3bd9-9fdd-36e216466931",
                                                "text": "Il n’y avait pas de vent. Notre vitesse était de 210 kilomètres-heure."
                                            },
                                            {
                                                "example_id": "af215bfa-4cd2-48b5-823f-cd963a6aafd6",
                                                "sense_id": "0ecdd5ef-08f8-3bd9-9fdd-36e216466931",
                                                "text": "Le ciel est huit dixième couvert par cumulus et cumulo-nimbus, et un vent de S.-S.-E. à S.-E. de 60 kilomètres-heure augmente notre vitesse jusqu’à 240 kilomètres-heure."
                                            },
                                            {
                                                "example_id": "536a74e3-688e-4c48-aa4a-d6ca7b868550",
                                                "sense_id": "0ecdd5ef-08f8-3bd9-9fdd-36e216466931",
                                                "text": "En quelques secondes l’aiguille du spidomètre avait dépassé les cent cinquante kilomètres-heure et il fut tenté de s'emparer du coupé pour regagner Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
