                    {
                        "translation_id": "2b6d7adb-ba03-4cdc-92df-b1118f797b86",
                        "source_entry_id": "7462d1b6-37c7-3a5e-8341-579b4e364563",
                        "source_sense_id": "bae4191e-cc7a-306a-a7bc-2b0954f51792",
                        "target_lang_word": "ипохондрик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ипохондрик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "69da398a-c6d1-3fab-9eb3-b688811e3525",
                                        "entry_id": "19c6860e-aa4d-32e8-ae05-8f1fee7bd6c6",
                                        "glosses": [
                                            "тот, кто страдает ипохондрией"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920d9380-2fb0-43ec-bd4f-651ad757d8fe",
                                                "sense_id": "69da398a-c6d1-3fab-9eb3-b688811e3525",
                                                "text": "❬…❭ Путешествуй, ипохондрик, чтобы исцелиться от своей ипохондрии! Путешествуй, мизантроп, чтобы полюбить человечество! Путешествуй, кто только может! ❬…❭"
                                            },
                                            {
                                                "example_id": "eb4ea39c-48c6-4259-8cbc-9e1087535a28",
                                                "sense_id": "69da398a-c6d1-3fab-9eb3-b688811e3525",
                                                "text": "❬…❭ В таких случаях мысль о болезни полностью овладевает ипохондриком и гонит его от одного врача к другому, причём каждому он выкладывает массу жалоб на неприятные и болезненные ощущения самого различного рода и в самых различных частях тела. От описанного типа вялого неврастеника-ипохондрика несколько отличаются субъекты, у которых наряду с той же, а, может быть, и еще большей истощаемостью, резко выявляется склонность к увлечению той или иной работой, теми или другими интересами .. ❬…❭ .. у боящегося за свое сердце ипохондрика навязчивой часто делается боязнь упасть от внезапного обморока, сердечного припадка и даже «разрыва сердца», боязнь, заставляющая его сердце отчаянно биться, а его самого обливаться холодным потом, лишь только он на улице окажется один, и принуждающая его выходить из дому не иначе, как с провожатым. У некоторых, напротив, развивается боязнь шумной толпы, движения, страх езды на трамвае или по железной дороге и др. ❬…❭"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
