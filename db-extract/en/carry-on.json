                    {
                        "translation_id": "592e4c59-5b63-49d4-b385-3b6e78e3fd9a",
                        "source_entry_id": "0dc56f99-7571-3f8f-a451-05bdd484d28a",
                        "source_sense_description": "the luggage which is taken onto an airplane with a passenger",
                        "target_lang_word": "Handgepäck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handgepäck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bdbc0db1-6b9c-3698-8321-cb269dfbd6a8",
                                        "entry_id": "fbd51952-d373-352f-8c1b-d26eda9ed6e6",
                                        "glosses": [
                                            "Gepäckstück, das ein Reisender bei sich hat, Kabinengepäck, Bordgepäck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98df868f-4d30-4238-8a5f-7bafec8a93f9",
                                                "sense_id": "bdbc0db1-6b9c-3698-8321-cb269dfbd6a8",
                                                "text": "Während des Fluges muss das Handgepäck im Gepäckfach oder unter dem Sitz verstaut werden."
                                            },
                                            {
                                                "example_id": "ebe53cfb-be11-479d-ae4b-2dc307a8a09c",
                                                "sense_id": "bdbc0db1-6b9c-3698-8321-cb269dfbd6a8",
                                                "text": "„International gibt es zur erlaubten Größe des Handgepäcks allerdings keine festgesetzte Norm, der Weltluftfahrtverband IATA spricht nur Empfehlungen aus.“"
                                            },
                                            {
                                                "example_id": "9828aebc-6bdd-4b5d-9fc5-2469ebf123f0",
                                                "sense_id": "bdbc0db1-6b9c-3698-8321-cb269dfbd6a8",
                                                "text": "„Grundsätzlich reise ich nur mit Handgepäck.“"
                                            },
                                            {
                                                "example_id": "cb864711-b679-4ffb-b74e-184ea659a7cc",
                                                "sense_id": "bdbc0db1-6b9c-3698-8321-cb269dfbd6a8",
                                                "text": "„Soweit auf Bahnhöfen Gepäckträger bestellt sind, haben sie Reise- und Handgepäck zu den von den Reisenden bezeichneten Stellen zu bringen.“"
                                            },
                                            {
                                                "example_id": "36394958-9a38-4360-abbc-0644c68f5a2a",
                                                "sense_id": "bdbc0db1-6b9c-3698-8321-cb269dfbd6a8",
                                                "text": "„Sie gingen zusammen zu ihrem Handgepäck und stellten sich in die Warteschlange, die sich in Bewegung gesetzt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
