                    "frequency": "High",
                    "semantic_group_id": "collaboration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>coopération</w> entre les deux équipes a permis de terminer le projet en avance."
                        },
                        {
                            "text": "Ce traité encourage la <w>coopération</w> internationale dans le domaine de la recherche scientifique."
                        }
                    ],
                    "synonyms": [
                        "collaboration",
                        "concours",
                        "entraide"
                    ],
                    "antonyms": [
                        "concurrence",
                        "opposition",
                        "rivalité"
                    ],
                    "common_phrases": [
