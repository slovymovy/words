                                                "sense_id": "821bfdef-aed0-362a-87e0-b53e1e1972c8",
                                                "text": "Kannst du mich durch die Hamburger Herbertstraße schleusen?"
                                            },
                                            {
                                                "example_id": "20399cb4-1958-40c8-856e-8622eee85f73",
                                                "sense_id": "821bfdef-aed0-362a-87e0-b53e1e1972c8",
                                                "text": "Der Taxifahrer schleuste seinen Wagen geschickt durch den dichten Autobahnverkehr."
                                            }
