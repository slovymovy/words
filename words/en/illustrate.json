{
    "word_family": [
        "illustration",
        "illustrator",
        "illustrative",
        "illustrious"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87d42fda-0cf0-3a41-a84f-b30abe755196",
                    "sense_definition": "To provide a book or publication with pictures, diagrams, or other decorative features.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_arts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist was hired to <w>illustrate</w> the new children's book with colorful drawings.",
                            "target_lang_translations": {
                                "ru": "Художника наняли, чтобы <w>проиллюстрировать</w> новую детскую книгу красочными рисунками."
                            }
                        },
                        {
                            "text": "She decided to <w>illustrate</w> a book by creating detailed sketches for every chapter.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>оформить</w> книгу, создав подробные эскизы к каждой главе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "illustrate a book",
                        "illustrate with drawings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать книгу или издание рисунками, диаграммами или другими декоративными элементами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иллюстрировать",
                                "target_lang_sense_clarification": "снабжать текст изображениями"
                            },
                            {
                                "target_lang_word": "оформлять",
                                "target_lang_sense_clarification": "художественно украшать издание"
                            },
                            {
                                "target_lang_word": "делать иллюстрации",
                                "target_lang_sense_clarification": "создавать рисунки для книги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c003dfe-51b2-37d0-bf02-c33cb12433fd",
                    "sense_definition": "To clarify something by giving or serving as an example or a comparison.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "explanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher used a simple story to <w>illustrate</w> the point she was making.",
                            "target_lang_translations": {
                                "ru": "Учительница использовала простую историю, чтобы <w>пояснить</w> свою мысль."
                            }
                        },
                        {
                            "text": "These statistics clearly <w>illustrate</w> the point that the economy is improving.",
                            "target_lang_translations": {
                                "ru": "Эта статистика наглядно <w>иллюстрирует</w> тот факт, что экономика улучшается."
                            }
                        }
                    ],
                    "common_phrases": [
                        "illustrate the point",
                        "illustrate the importance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разъяснять что-либо, приводя пример или служа примером для сравнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иллюстрировать",
                                "target_lang_sense_clarification": "пояснять примером"
                            },
                            {
                                "target_lang_word": "пояснять",
                                "target_lang_sense_clarification": "делать более понятным"
                            },
                            {
                                "target_lang_word": "наглядно показывать",
                                "target_lang_sense_clarification": "демонстрировать на примере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "977ae4b9-0555-39e1-b293-aa1e517e7983",
                    "sense_definition": "To shed light upon or brighten physically.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rising sun began to <w>illustrate</w> the morning sky with a soft golden glow.",
                            "target_lang_translations": {
                                "ru": "Восходящее солнце начало <w>озарять</w> утреннее небо мягким золотистым сиянием."
                            }
                        },
                        {
                            "text": "Poets often use the word to describe how the stars <w>illustrate</w> the dark night.",
                            "target_lang_translations": {
                                "ru": "Поэты часто используют это слово, чтобы описать, как звезды <w>освещают</w> темную ночь."
                            }
                        }
                    ],
                    "synonyms": [
                        "illuminate",
                        "light up",
                        "irradiate"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in a literal sense of lighting up"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освещать или делать физически ярче (архаичное использование)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освещать",
                                "target_lang_sense_clarification": "наполнять светом"
                            },
                            {
                                "target_lang_word": "озарять",
                                "target_lang_sense_clarification": "ярко освещать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53d05a98-d3d2-3301-ab58-43f915cf9905",
                    "sense_definition": "To give renown or honor to someone or something; to make famous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His heroic actions served to <w>illustrate</w> his family name for generations to come.",
                            "target_lang_translations": {
                                "ru": "Его героические поступки послужили тому, чтобы <w>прославить</w> его фамилию на поколения вперед."
                            }
                        },
                        {
                            "text": "The king sought to <w>illustrate</w> his reign through great monuments and victories.",
                            "target_lang_translations": {
                                "ru": "Король стремился <w>возвеличить</w> свое правление великими памятниками и победами."
                            }
                        }
                    ],
                    "synonyms": [
                        "glorify"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "meaning to make illustrious"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прославлять или делать кого-либо/что-либо знаменитым (архаичное использование)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прославлять",
                                "target_lang_sense_clarification": "делать известным"
                            },
                            {
                                "target_lang_word": "обессмертить",
                                "target_lang_sense_clarification": "сделать имя вечным"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}