                        "entry_id": "e18bbfc5-66af-3b99-91d6-f5f80122c4f5",
                        "glosses": [
                            "Agent de texture utilisé en industrie alimentaire pour améliorer la tenue d'un aliment pour le rendre plus attractif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d253056b-5566-41c4-8bba-6d6a0cbe1358",
                                "sense_id": "7c016478-6cf6-3895-b91c-ad8b015ebc9e",
                                "text": "Le Monooléate de sorbitane polyoxyéthylène ou polysorbate 80 (E433) et le carboxyméthylcellulose ou gomme de cellulose (E466) utilisés dans la préparation des crèmes glacées, mayonnaises, vinaigrettes, crèmes dessert... apportent des risque d’allergie et d’inflammation intestinale pouvant favoriser surpoids et diabète.."
                            },
                            {
                                "example_id": "28de6439-40db-4364-b8e0-97fd8ec0709b",
                                "sense_id": "7c016478-6cf6-3895-b91c-ad8b015ebc9e",
                                "text": "La dégradation des carboxyméthylcelluloses dans le sol est d’autant plus rapide que leur degré de substitution est plus faible."
                            }
                        ]
                    }
