                "senses": [
                    {
                        "sense_id": "17dffa74-5dd1-325b-8bbb-7f68ff5da1de",
                        "entry_id": "71c9440c-3f80-3811-aea8-044f8a23ae1f",
                        "glosses": [
                            "Abbindesystem, durch das der Blutfluss in den Venen und Arterien gestaut oder vollständig unterbrochen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "725aada5-c01d-44b7-a928-b68d7351de3a",
                                "sense_id": "17dffa74-5dd1-325b-8bbb-7f68ff5da1de",
                                "text": "„Dann nahm er die blutige Handfläche nur lange genug von ihrem Bauch, um einen Streifen von seinem Hemdschoß abzuschneiden und zu einer Aderpresse zu verknoten.“"
                            },
                            {
                                "example_id": "7452a198-415a-4669-bbd4-1c0b50c77f96",
                                "sense_id": "17dffa74-5dd1-325b-8bbb-7f68ff5da1de",
                                "text": "„Während Olga eine Aderpresse an seinem Arm anbrachte, um das herausschießende Blut zu stoppen, schnitten die anderen den Fisch auf und holten zu jedermanns Freude die unversehrt gebliebene Schwimmblase heraus.“"
                            },
                            {
                                "example_id": "29441625-d01a-49dc-badf-085b749b6a60",
                                "sense_id": "17dffa74-5dd1-325b-8bbb-7f68ff5da1de",
                                "text": "„Mit dem zweiten band er ihm die Schenkel ab, legte ihn als Aderpresse an, um die Blutung aus dem klaffenden Schnitt über dem Knie zu stillen.“"
                            },
                            {
                                "example_id": "b682e370-fe66-4c93-bf3c-eb8b8c9402dd",
                                "sense_id": "17dffa74-5dd1-325b-8bbb-7f68ff5da1de",
                                "text": "„Der Kleine Italo öffnete meinen Gurt und zog mir mit einem Ruck die Hose aus, dann machte er mir aus einem billigen Füllfederhalter und der Krawatte des Fisches eine Aderpresse.“"
                            },
                            {
                                "example_id": "51f5b69a-de70-416b-905f-12bfe302648f",
                                "sense_id": "17dffa74-5dd1-325b-8bbb-7f68ff5da1de",
                                "text": "„Er sah zehn Minuten lang zu, wie er blutete; dann legte er eine Aderpresse auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
