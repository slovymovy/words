                                            {
                                                "example_id": "d61d19d1-47e9-4d11-9889-f932a99a3e0f",
                                                "sense_id": "6e4f10ab-37eb-3665-9db0-42d7828424d2",
                                                "text": "„Die Wangen des Babys waren von der Kälte gerötet; ein leises Rasseln begleitete jedes Ausatmen.“"
                                            },
                                            {
                                                "example_id": "41c66b8a-7513-48d4-a294-897a2fff427e",
                                                "sense_id": "6e4f10ab-37eb-3665-9db0-42d7828424d2",
                                                "text": "„Mein Heer vereinigt sich wieder, und hinter den verrammelten Toren lässt sich das verräterische Rasseln von Riegeln und Ketten vernehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
