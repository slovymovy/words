                                        "entry_id": "0786c32f-2e59-397b-9815-f8e28a6c08bc",
                                        "glosses": [
                                            "bepaald type kunststof dat licht en buigzaam en toch sterk en slijtvast is"
                                        ],
                                        "tags": [
                                            "materiaalkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0667e147-9caa-4d31-a50a-cecb052229eb",
                                                "sense_id": "f7f3f79e-31c2-3643-b2cf-e03005db4436",
                                                "text": "Polyurethaan wordt gebruikt als isolatiemateriaal in woningen."
                                            },
                                            {
                                                "example_id": "7b6cf9a7-fb1e-4c7e-b1d8-d282a67ce7e9",
                                                "sense_id": "f7f3f79e-31c2-3643-b2cf-e03005db4436",
                                                "text": "Als er polyurethaan op je handen komt kan je dat er niet afhalen, het zal er vanaf moeten slijten."
                                            },
                                            {
                                                "example_id": "083a39e6-ed21-45cd-98f2-ce3bb76c40fb",
                                                "sense_id": "f7f3f79e-31c2-3643-b2cf-e03005db4436",
                                                "text": "Zo ontdekte ik harsen, polyurethaan en elastomeren. Fantastische materialen waarmee ik als productontwerper ben gaan experimenteren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa15232b-9f38-3dc9-a175-f79610ba62fe",
                                        "entry_id": "0786c32f-2e59-397b-9815-f8e28a6c08bc",
                                        "glosses": [
                                            "polymeer gevormd door de reactie van een twee- of meervoudig isocyanaat met een twee- of meervoudige alcohol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f67addd5-ca58-4066-8145-3a368c881d8d",
                                                "sense_id": "fa15232b-9f38-3dc9-a175-f79610ba62fe",
                                                "text": "Polyurethanen kunnen elastomeren zijn, maar ook harde of zachte schuimen, afhankelijk van de precieze aard van de monomeren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d87b42f1-741b-44b4-b674-12c84ab74867",
                        "source_entry_id": "0679441f-705a-3abf-a5f4-6ff143470df8",
                        "source_sense_id": "45ec43cd-1e51-3f9a-8bf0-f241d489a59f",
