                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "687ff7d6-23f0-4d64-b069-5e1d056d0efc",
                                "sense_id": "bd0aec44-4640-3a12-8ee7-6d208670f7a4",
                                "text": "Megsie is an honorary employee because she helps other customers while she shops here."
                            },
                            {
                                "example_id": "ef8140c2-6e3b-4853-97a1-15210047bc70",
                                "sense_id": "bd0aec44-4640-3a12-8ee7-6d208670f7a4",
                                "text": "I consider you an honorary member of our family because you've been with us for so long."
                            }
                        ]
