                    },
                    {
                        "translation_id": "582eb5a0-529a-4e06-892a-36d58610920e",
                        "source_entry_id": "cb2db43f-7085-34be-ab60-9728396a785d",
                        "source_sense_id": "985d8e59-60c9-35d3-ae6c-872d4aba38da",
