                        "cross_references": [
                            {
                                "target_word": "beznadějně",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "af6c909c-4bfd-3027-b21d-433bf5fc9484",
                                        "entry_id": "b439b9f1-3320-328c-a7bb-c1a05f1cec0e",
                                        "glosses": [
                                            "bez šance na úspěch nebo příznivý výsledek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4508129f-899b-4ed1-8d29-84285c57a159",
                                                "sense_id": "af6c909c-4bfd-3027-b21d-433bf5fc9484",
                                                "text": "V intelektuální debatě bude víc než polovina účastníků souhlasit s tvrzením, že v případě beznadějně nevyléčitelné nemoci, krutých bolestí, bezmoci a dalšího lidského utrpení by mělo být povoleno, aby na kompetentní žádost takového pacienta lékař ukončil jeho život."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b1e7b56-ee5f-327b-ad8e-bae84bafb6ff",
                                        "entry_id": "b439b9f1-3320-328c-a7bb-c1a05f1cec0e",
                                        "glosses": [
                                            "úplně, naprosto"
                                        ],
                                        "tags": [
                                            "colloquially",
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee88eac8-804f-4930-a724-4dfdba73e064",
                                                "sense_id": "6b1e7b56-ee5f-327b-ad8e-bae84bafb6ff",
                                                "text": "Beznadějně vyprodanou derniéru politické satiry Ovčáček čtveráček, kterou ansámbl Městského divadla Zlín odehraje v úterý 7. února v pražských Bohnicích, bude možno sledovat živě v téměř šedesáti kinech po celé zemi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16311058-e07d-4777-9056-315f3a1f210c",
