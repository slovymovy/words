                        "translation_id": "a1833c20-bde0-495b-8e24-4cab7f645c06",
                        "source_entry_id": "99e5456b-a062-36cf-847c-a618a5ac4154",
                        "target_lang_word": "decade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33243f46-3a0e-3745-acd6-356ec5988f4e",
                                        "entry_id": "29383982-7d78-3a6c-8e0f-ae99b2e1360d",
                                        "glosses": [
                                            "A group, set, or series of ten , particularly"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a04c66a-19ed-4c33-a4fa-902469d37b7b",
                                                "sense_id": "33243f46-3a0e-3745-acd6-356ec5988f4e",
                                                "text": "a decade of soldiers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                                        "entry_id": "29383982-7d78-3a6c-8e0f-ae99b2e1360d",
                                        "glosses": [
                                            "A group, set, or series of ten",
                                            "A period of ten years , particularly such a period beginning with a year ending in 0 and ending with a year ending in 9."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38528750-5226-4b0e-af29-164afe283234",
                                                "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                                                "text": "The 1960s was a turbulent decade."
                                            },
                                            {
                                                "example_id": "776628f9-a4fc-4c9c-8ef0-c7774d5bf985",
                                                "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                                                "text": "I haven’t seen my cousin in over a decade!"
                                            },
                                            {
                                                "example_id": "672b2195-9003-47ba-b6a4-3f6528c3ad48",
                                                "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                                                "text": "The repeated exposure, over decades, to most taxa here treated has resulted in repeated modifications of both diagnoses and discussions, as initial ideas of the various taxa underwent—often repeated—conceptual modification."
                                            },
                                            {
                                                "example_id": "91499038-8a70-4cea-88c0-4e53ceb8c642",
                                                "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                                                "text": "Thru May: 1920s — The Decade That Roared. New exhibition portraying historical events and everyday life during the Roaring Twenties."
                                            },
                                            {
                                                "example_id": "4aaa0ace-34fb-4b1a-99fc-0806e5098215",
                                                "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                                                "text": "Athletes' use of herbal supplements has skyrocketed in the past two decades."
                                            },
                                            {
                                                "example_id": "3473a593-6195-43d7-ad91-e1a25eb8a5c9",
                                                "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                                                "text": "Some of these employees have been with the company for decades, which made the company's claims that it offers good training, positive management and excellent job security and benefit packages all the more compelling."
                                            },
                                            {
                                                "example_id": "08966e1d-7604-4ebc-ba66-7fae5ed52296",
                                                "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                                                "text": "We would pick a decade / We wished we could live in instead of this / I'd say the 1830s but without all the racists"
                                            },
                                            {
                                                "example_id": "23a58339-6dd0-4f20-9cbe-fd0d03b4e152",
                                                "sense_id": "c78510d1-5a15-36f1-a4e4-8c9647e89982",
                                                "text": "President Donald Trump likes to boast about the brilliance of his late uncle John Trump, who spent decades as a professor of electrical engineering at the renowned Massachusetts Institute of Technology (MIT). And when speaking about all manner of subjects, the president likes to make up stories filled with dramatic but fictional details. […] First, the president’s uncle died in 1985. Kaczynski was publicly revealed as the Unabomber more than a decade later, in 1996, when he was captured; before that, he had lived as a recluse in the Montana wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca3c037f-4563-328d-8dea-de69d42ab7cd",
                                        "entry_id": "29383982-7d78-3a6c-8e0f-ae99b2e1360d",
                                        "glosses": [
                                            "A group, set, or series of ten",
                                            "A period of ten days, particularly those in the ancient Egyptian, Coptic, and French Revolutionary calendars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e89bc9-5bc1-4f1a-b3b3-846effd8229b",
                                                "sense_id": "ca3c037f-4563-328d-8dea-de69d42ab7cd",
                                                "text": "The year was divided up into twelve months renamed after the seasons [...]; each month comprised three ‘decades’ of ten days – with the décadi replacing Sundays as a day of rest; and each day was reconsecrated to a natural product or farming tool or technique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df73d1ac-4d5c-312c-8ca3-af8dcc69330a",
                                        "entry_id": "29383982-7d78-3a6c-8e0f-ae99b2e1360d",
                                        "glosses": [
                                            "A group, set, or series of ten",
                                            "A work in ten parts or books, particularly such divisions of Livy's History of Rome."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20dfc0e7-485d-3abb-9879-3d15ec99b2cd",
                                        "entry_id": "29383982-7d78-3a6c-8e0f-ae99b2e1360d",
                                        "glosses": [
                                            "A group, set, or series of ten",
                                            "A series of prayers counted on a rosary, typically consisting of an Our Father, followed by ten Hail Marys, and concluding with a Glory Be and sometimes the Fatima Prayer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32f9a67e-567e-3b08-8e76-364a662ad1de",
                                        "entry_id": "29383982-7d78-3a6c-8e0f-ae99b2e1360d",
                                        "glosses": [
                                            "A group, set, or series of ten",
                                            "Any of the sets of ten sequential braille characters with predictable patterns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac9a41f9-0306-3884-821a-2d1fd0be9c83",
                                        "entry_id": "29383982-7d78-3a6c-8e0f-ae99b2e1360d",
                                        "glosses": [
                                            "A group, set, or series of ten",
                                            "A set of ten electronic devices used to represent digits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68804ffb-cca6-3fa4-9309-c83fcddb310e",
                                        "entry_id": "29383982-7d78-3a6c-8e0f-ae99b2e1360d",
                                        "glosses": [
                                            "A set of resistors, capacitors, etc. connected so as to provide even increments between one and ten times a base electrical resistance."
                                        ],
