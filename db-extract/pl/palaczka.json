                    {
                        "translation_id": "b880d86b-cbb4-474e-8348-e0fb2ce4b914",
                        "source_entry_id": "6993247e-f3bc-3fc4-a0ce-3f3a81bb16f3",
                        "source_sense_id": "413185fe-48f4-3995-903f-91c7bfd0b162",
                        "target_lang_word": "fumeuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fumeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31ef9f1b-e76b-303b-9d07-1406a8893c30",
                                        "entry_id": "93cd4d75-4146-316f-b6ad-8a60b2d52cf6",
                                        "glosses": [
                                            "Femme qui fume du tabac ou d’autres substances psychoactives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b5205d-9c3f-4611-a262-524db9f8730a",
                                                "sense_id": "31ef9f1b-e76b-303b-9d07-1406a8893c30",
                                                "text": "Les accros à la nicotine ont du mal à croire à l’existence de cette étrange créature : la fumeuse occasionnelle."
                                            },
                                            {
                                                "example_id": "f75f5ddc-75b3-49d7-bec3-54cc84fdb84f",
                                                "sense_id": "31ef9f1b-e76b-303b-9d07-1406a8893c30",
                                                "text": "Les petites bêtes des tropiques : cafards, margouillats, araignées, mille-pattes accourent près de la fumeuse, attirées par l’opium."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17399f20-f7ee-3b5f-a4fb-3f5c83b84021",
                                        "entry_id": "93cd4d75-4146-316f-b6ad-8a60b2d52cf6",
                                        "glosses": [
                                            "Femme qui fume de la nourriture pour la conserver ou lui donner un goût de fumée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cc4f1e5-d3a0-4bfc-bf8b-e9a4f1f1007a",
                                                "sense_id": "17399f20-f7ee-3b5f-a4fb-3f5c83b84021",
                                                "text": "Nous reviendrons sur l’importance pour la carrière d’une femme d’épouser un propriétaire de pirogue, mais nous examinerons d’abord comment elles se débrouillent en tant que fumeuses de poisson et commerçantes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fumeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee2c21a6-e4bf-30ee-8165-d0c7fa71cd40",
                                        "entry_id": "729fecf7-9b97-3d5d-ad25-26e387903d73",
                                        "glosses": [
                                            "Sorte de voyeuse ou ponteuse, petite chaise basse à large dossier, dont la manchette dissimule un espace pour ranger des ustensiles pour fumer, et sur laquelle on s’assied à califourchon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3485f83-bd55-4043-bd06-281aa753cead",
                                                "sense_id": "ee2c21a6-e4bf-30ee-8165-d0c7fa71cd40",
                                                "text": "Raoule, étendue dans une fumeuse, suivait tous les mouvements de Jacques ; lorsqu’elle lui vit accepter une cigarette, elle faillit bondir de rage."
                                            },
                                            {
                                                "example_id": "c9a1060a-8278-4e65-8eeb-a45ddf1dfafb",
                                                "sense_id": "ee2c21a6-e4bf-30ee-8165-d0c7fa71cd40",
                                                "text": "À droite de la table, un fauteuil ; à gauche entre la chaise-longue et la table, et un peu au-dessus, une chaise dite « fumeuse » avec accoudoir, le siège face au public."
                                            },
                                            {
                                                "example_id": "304f3d71-545b-42a4-a66a-77cbc6db2b58",
                                                "sense_id": "ee2c21a6-e4bf-30ee-8165-d0c7fa71cd40",
                                                "text": "Je suis rentrée pas très réchauffée… On aimerait voir un visage en ouvrant sa porte ; on aimerait voir autre chose qu’une fumeuse, une table de jeu et une rocking-chair…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fumeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6eb1df17-49f9-30f9-8704-bbb1508318cc",
                                        "entry_id": "f84bf8ab-5531-31f6-a51f-70d6472dbcc2",
                                        "glosses": [
                                            "Féminin singulier de fumeux."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0cbdf1c-b464-41ec-acdf-4abf93959683",
                                                "sense_id": "6eb1df17-49f9-30f9-8704-bbb1508318cc",
                                                "text": "On m’a indiqué le plus ancien cocher de la ville, dans la fumeuse Kneipe où il boit la bière d’octobre, capiteuse et parfumée."
                                            },
                                            {
                                                "example_id": "c072b769-9d31-4f0a-89f0-1f05f948da3e",
                                                "sense_id": "6eb1df17-49f9-30f9-8704-bbb1508318cc",
                                                "text": "Remarquez en passant qu’il n’est pas nécessaire de renouveler la querelle fumeuse des anciens et des modernes, puisque les deux revues sont l’œuvre de mes auteurs et jouées par les mêmes acteurs à quelque chose près."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
