                        "examples": [
                            {
                                "example_id": "0f50bf9f-20e3-4208-be93-ea37e3c39abb",
                                "sense_id": "d8bf8d6b-fdb1-311f-aa79-97927061cce0",
                                "text": "Thomas, das ist ein solider und ernster Kopf; er muß Kaufmann werden, darüber besteht kein Zweifel. Christian dagegen scheint mir ein wenig Tausendsassa zu sein, wie? ein wenig Incroyable …",
                                "translation": "Tom is a very solid chap. He'll have to go into the business, no doubt of that. But Christian is a devil of a fellow—a young incroyable, hey?",
                                "english": "Tom is a very solid chap. He'll have to go into the business, no doubt of that. But Christian is a devil of a fellow—a young incroyable, hey?"
                            }
                        ]
                    }
