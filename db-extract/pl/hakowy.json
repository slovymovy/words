                "senses": [
                    {
                        "sense_id": "7b89540c-7ab3-3d13-bdb5-27b97b28d79e",
                        "entry_id": "22a832b4-488c-39e0-be77-9e4f57a6701a",
                        "glosses": [
                            "związany z hakiem (zakrzywionym prętem używanym do zawieszania lub zaczepiania)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "066d7d94-8d29-45a5-90db-56bb22b2ef61",
                                "sense_id": "7b89540c-7ab3-3d13-bdb5-27b97b28d79e",
                                "text": "Po prostej początkowo wspinaczce hakowej, czyli wbijaniu kolejnych haków w szczeliny, przekładaniu ławeczek, stawaniu na nich i wbijaniu wyżej następnego haka, zrobiło się trudniej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c9d2d8cd-397f-3fae-ac2c-f82de4b4c8b3",
                        "entry_id": "22a832b4-488c-39e0-be77-9e4f57a6701a",
                        "glosses": [
                            "związany z hakiem (informacją zbieraną w celu skompromitowania kogoś)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "70f354e4-2e44-4ee5-b7d4-8c732d08e5e9",
                                "sense_id": "c9d2d8cd-397f-3fae-ac2c-f82de4b4c8b3",
                                "text": "Jestem przekonany, że działa jakaś grupa hakowa, która szykuje nowe polityczne rozdanie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
