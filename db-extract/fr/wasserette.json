                        "examples": [
                            {
                                "example_id": "d1f45885-763d-4ba2-b699-2b426bc632c8",
                                "sense_id": "c1b02710-1228-32f3-823c-4d20829932e7",
                                "text": "Ah si, il y a bien un truc qui me fait marrer, c'est le gérant de la wasserette (comme on dit ici) qui se trouve juste à côté de chez nous."
                            },
                            {
                                "example_id": "b0b79d6c-a664-447b-ba6b-6a4cd815c80f",
                                "sense_id": "c1b02710-1228-32f3-823c-4d20829932e7",
                                "text": "Je terminai ma traversée de la ville, des enfants jouaient dans la rue, de l'intérieur des cafés des hommes me dévisageaient, le linge tournait dans les machines silencieuses des wasserettes, les écrans des cybercafés luisaient, nimbant le visage fasciné et anxieux des adolescents."
                            },
                            {
                                "example_id": "f307bd7b-9771-4764-994e-6a324caca269",
                                "sense_id": "c1b02710-1228-32f3-823c-4d20829932e7",
                                "text": "Cette technique est vieille comme le monde et a été introduite par Al Capone pour intégrer les revenus de ses trafics d'alcool et d'armes dans la comptabilité de ses wasserettes qui étaient elles-mêmes imposées par le fisc américain."
                            }
                        ]
                    }
