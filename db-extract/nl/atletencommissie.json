                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01b36c9f-ad3d-4900-a7aa-c6156f89d133",
                                "sense_id": "efe2d115-a880-31ff-ae56-ccf05983affb",
                                "text": "Russische sporters willen in februari allemaal meedoen aan de Olympische Winterspelen in Pyeongchang, ook al is het noodgedwongen onder een neutrale vlag. Dat heeft voorzitter Sofia Velikaja van de atletencommissie van het Russisch Olympisch Comité gezegd."
                            },
                            {
                                "example_id": "3dc046d6-add4-48bb-856e-b5a35734f128",
                                "sense_id": "efe2d115-a880-31ff-ae56-ccf05983affb",
                                "text": "Kort na het besluit van het Internationaal Olympisch Comité om Rusland te weren van de Winterspelen in Pyeongchang, zat Chiel Warners dinsdagavond met de baas van het IOC, Thomas Bach, aan de telefoon. De voormalige tienkamper is voorzitter van de atletencommissie van NOC*NSF en maakt ook deel uit van de atletencommissie van het wereldantidopingbureau WADA."
                            }
                        ]
