    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "db05deb6-828f-38a1-af45-bb7aeadb818d",
                    "sense_definition": "Pronom relatif introduisant une proposition relative, représentant un antécédent animé ou inanimé comme sujet, ou un animé après une préposition.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "relatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voisin <w>qui</w> habite au premier étage arrose ses plantes tous les matins."
                        },
                        {
                            "text": "C'est une amie fidèle avec <w>qui</w> je voyage souvent pendant les vacances."
                        }
                    ],
                    "common_phrases": [
                        "la personne qui",
                        "ceux qui"
                    ]
                },
                {
                    "sense_id": "6214222a-694e-357d-8ae9-42f1f7b077c2",
                    "sense_definition": "Pronom interrogatif servant à demander l'identité d'une ou de plusieurs personnes.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Qui</w> a laissé la porte du jardin ouverte ce matin ?"
                        },
                        {
                            "text": "Je me demande <w>qui</w> viendra à notre fête samedi prochain."
                        }
                    ],
                    "synonyms": [
                        "qui est-ce qui",
                        "qui est-ce que"
                    ]
                },
                {
                    "sense_id": "9fcedfb3-2c5b-37af-a7e5-bb01f5ca8317",
                    "sense_definition": "Celui qui, quiconque ou toute personne qui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rira bien <w>qui</w> rira le dernier lors de cette compétition amicale."
                        },
                        {
                            "text": "Cette maison semblait accueillante pour <w>qui</w> arrivait après un long voyage."
                        }
                    ]
                },
                {
                    "sense_id": "dd6887e0-fe32-3969-a1a9-9c71e7f26983",
                    "sense_definition": "Ce qui, employé dans des tournures présentatives avec voici ou voilà.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voilà <w>qui</w> me semble être une excellente solution à notre problème."
                        },
                        {
                            "text": "Le train arrive enfin à l'heure, voilà <w>qui</w> est rassurant."
                        }
                    ],
                    "common_phrases": [
                        "voilà qui est fait"
                    ]
                },
                {
                    "sense_id": "455de7e5-1e06-38a7-b3b1-10fa59609b35",
                    "sense_definition": "Les uns... les autres, celui-ci... celui-là, employé de manière répétée pour marquer une répartition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distributif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants couraient dans tous les sens, <w>qui</w> vers la plage, <w>qui</w> vers le parc."
                        },
                        {
                            "text": "Après la réunion, les collègues discutaient, <w>qui</w> debout, <w>qui</w> assis près de la fenêtre."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "b115e17e-5a62-3f75-8aaa-6215b3486079",
                    "sense_definition": "Variante régionale équivalente à la conjonction de condition si.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Qui</w> vous venez demain, prévenez-moi avant midi pour préparer le repas."
                        },
                        {
                            "text": "<w>Qui</w> pleut tout l'après-midi, nous devrons reporter notre promenade en forêt."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Régional ou dialectal"
                        }
                    ]
                }
            ]
        }
    ]
