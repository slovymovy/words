                "senses": [
                    {
                        "sense_id": "6e11db90-c27d-31bb-8fec-0a26a49f9555",
                        "entry_id": "4ce0801c-0d49-3e1c-8cd1-bdda44fc0a92",
                        "glosses": [
                            "Mammifère de l’ordre des Proboscidea muni d’une trompe, ordre représenté par la famille des éléphantidés et quelques espèces fossiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3d6917b-fd3d-43ce-b159-b019583ba053",
                                "sense_id": "6e11db90-c27d-31bb-8fec-0a26a49f9555",
                                "text": "Parmi les ossements et les défenses de mammouth qui constituaient la charpente de huttes circulaires, on a rencontré des omoplates ou des mâchoires de l’énorme proboscidien, peintes en rouge d’un décor géométrique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1beaca24-48e5-4584-bee4-d100e6d65187",
