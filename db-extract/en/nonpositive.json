                                "target_senses": [
                                    {
                                        "sense_id": "38de71fa-09b4-34d5-b161-b6f4301c4685",
                                        "entry_id": "694a9022-d945-3af9-bdc3-0ec211a3500a",
                                        "glosses": [
                                            "Qui exprime une négation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac800c9f-8655-4743-a3bf-a3d2726dcb4b",
                                                "sense_id": "38de71fa-09b4-34d5-b161-b6f4301c4685",
                                                "text": "Réponse négative."
                                            },
                                            {
                                                "example_id": "3ac698ce-6338-4123-b1a4-a87ae80c1564",
                                                "sense_id": "38de71fa-09b4-34d5-b161-b6f4301c4685",
                                                "text": "Argument négatif, preuves négatives : Argument, preuves que l’on tire du défaut, de l’absence, du silence, par opposition à argument positif, preuves positives."
                                            },
                                            {
                                                "example_id": "eaeb6640-3c64-4e8f-b038-19daca98e911",
                                                "sense_id": "38de71fa-09b4-34d5-b161-b6f4301c4685",
                                                "text": "Résultat négatif : Résultat purement critique, qui ne fait que détruire, sans rien substituer à ce qu’il détruit."
                                            },
                                            {
                                                "example_id": "e17fbefa-ee52-49a1-8b72-cc1ad05aab4d",
                                                "sense_id": "38de71fa-09b4-34d5-b161-b6f4301c4685",
                                                "text": "Un bonheur négatif : Un bonheur qui consiste dans l’absence de maux, de souffrances physiques et morales."
                                            },
                                            {
                                                "example_id": "4bbe6416-1d31-47f3-abe4-72c733a887f5",
                                                "sense_id": "38de71fa-09b4-34d5-b161-b6f4301c4685",
                                                "text": "Un esprit négatif : Esprit porté à nier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39564750-22d0-39a6-a9c4-2f9bd85f79f0",
                                        "entry_id": "694a9022-d945-3af9-bdc3-0ec211a3500a",
                                        "glosses": [
                                            "D’une négation logique. Pas affirmatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a82e9ad1-4574-46bc-ae4c-e4c7be156dcf",
                                                "sense_id": "39564750-22d0-39a6-a9c4-2f9bd85f79f0",
                                                "text": "Une proposition négative."
                                            },
                                            {
                                                "example_id": "35520e43-2a7a-4ef4-a259-1543c8abd11a",
                                                "sense_id": "39564750-22d0-39a6-a9c4-2f9bd85f79f0",
                                                "text": "Les formes affirmative et négative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c452f1c4-6e4c-3043-9eb0-9eefe9e4e708",
                                        "entry_id": "694a9022-d945-3af9-bdc3-0ec211a3500a",
                                        "glosses": [
                                            "Plus petit que zéro ; parfois : plus petit que ou égal à zéro."
                                        ],
                                        "tags": [],
                                        "note": "zéro est, en mathématiques en langue française, parfois considéré comme positif et négatif. Ce n’est pas le cas dans d’autres langues : p. ex. en anglais, zéro n’est ni positive ni negative. → voir strictement négatif",
                                        "examples": [
                                            {
                                                "example_id": "c9f78c86-d5a9-4c0c-98d4-711ebfa8006a",
                                                "sense_id": "c452f1c4-6e4c-3043-9eb0-9eefe9e4e708",
                                                "text": "Les grandeurs négatives, quantités négatives correspondent aux nombres négatifs."
                                            },
                                            {
                                                "example_id": "3ca54238-83f0-4988-8b0f-1f292bb20dda",
                                                "sense_id": "c452f1c4-6e4c-3043-9eb0-9eefe9e4e708",
                                                "text": "La rencontre de Lucile et Gabriel reste à mes yeux la rencontre de deux grandes souffrances, et contrairement à la loi mathématique qui veut que la multiplication de deux nombres négatifs produise un nombre positif, de cette rencontre ont surgi la violence et le désarroi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3060960-3b88-37e1-b482-c0aa0e73a561",
                                        "entry_id": "694a9022-d945-3af9-bdc3-0ec211a3500a",
                                        "glosses": [
                                            "S’emploie aussi en ce sens dans le langage ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef74b32a-32e8-451a-9114-4753962e29e7",
                                                "sense_id": "d3060960-3b88-37e1-b482-c0aa0e73a561",
                                                "text": "Ce qu’un homme doit au-delà de ce qu’il possède est un avoir négatif, une quantité négative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ab813cb-4ce0-3f2a-8813-553797a96a95",
                                        "entry_id": "694a9022-d945-3af9-bdc3-0ec211a3500a",
                                        "glosses": [
                                            "Électricité négative ou résineuse : Celle que l’on développe en frottant un morceau d’ébonite avec du drap, avec de la laine, par opposition à l’électricité positive qui est dégagée sur le verre poli par frottement du drap. De nos jours, nommée électricité statique."
                                        ],
                                        "tags": [
                                            "dated",
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2673f9b-66cb-32b6-b7d3-ab2b7897ade2",
                                        "entry_id": "694a9022-d945-3af9-bdc3-0ec211a3500a",
                                        "glosses": [
                                            "Pôle négatif : Le pôle d’une pile électrique opposé au pôle positif."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38c01f77-67ac-4c73-bdef-8d8ddf6c1d25",
                                                "sense_id": "c2673f9b-66cb-32b6-b7d3-ab2b7897ade2",
                                                "text": "Dans une telle pile en circuit fermé, le courant va du pôle négatif au pôle positif par l’intérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc9929f-3a7f-32d7-860e-bc5f0021225b",
                                        "entry_id": "694a9022-d945-3af9-bdc3-0ec211a3500a",
                                        "glosses": [
                                            "Épreuve négative : Épreuve photographique où les blancs sont venus en noir et inversement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d0eed2f-7e1a-3ac5-9807-a0288d5fe963",
                                        "entry_id": "694a9022-d945-3af9-bdc3-0ec211a3500a",
                                        "glosses": [
                                            "Qualifie une température ambiante, voire une température résultante, inférieure à zéro degré Celsius (0°C)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ddc5f6-5c52-47e5-8812-cd284c32d967",
                                                "sense_id": "8d0eed2f-7e1a-3ac5-9807-a0288d5fe963",
                                                "text": "Ce matin, les autres dormaient encore quand je suis allée chercher des bûches dans la remise pour allumer le feu dans le poêle. Pour le moment, les températures de la nuit sont négatives dans la région de Berlin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "négatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a606c88-7818-3e83-b50e-7db3471237fe",
