    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c94eb56-8d20-3246-92eb-ecbefb7435f5",
                    "sense_definition": "Révéler la véritable identité ou les intentions cachées d'une personne malhonnête.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le détective a réussi à <w>démasquer</w> le coupable grâce à de nouveaux indices."
                        },
                        {
                            "text": "Les enquêteurs craignaient de ne jamais pouvoir <w>démasquer</w> cet espion redoutable."
                        }
                    ],
                    "synonyms": [
                        "dévoiler",
                        "confondre"
                    ],
                    "antonyms": [
                        "dissimuler",
                        "masquer"
                    ],
                    "common_phrases": [
                        "démasquer un coupable",
                        "démasquer un imposteur",
                        "démasquer un espion"
                    ]
                },
                {
                    "sense_id": "8edc72b2-5b0c-34a6-9eed-94ed271e1b13",
                    "sense_definition": "Enlever le masque qui couvre le visage de quelqu'un ou son propre masque.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la fin de la fête, tout le monde a dû se <w>démasquer</w> devant les invités."
                        },
                        {
                            "text": "L'homme refusa d'abord de se <w>démasquer</w>, mais il finit par obéir aux gardes."
                        }
                    ],
                    "antonyms": [
                        "masquer"
                    ],
                    "common_phrases": [
                        "se démasquer"
                    ]
                },
                {
                    "sense_id": "b1606473-acf8-30b9-97a2-089bea9bc021",
                    "sense_definition": "Faire apparaître ou rendre visible quelque chose qui était dissimulé à la vue.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "découverte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le brouillard s'est levé rapidement, <w>démasquant</w> le campement secret dans la vallée."
                        },
                        {
                            "text": "Le soldat a retiré les branchages, <w>démasquant</w> l'ouverture cachée dans le mur."
                        }
                    ],
                    "synonyms": [
                        "découvrir",
                        "révéler"
                    ],
                    "antonyms": [
                        "cacher",
                        "dissimuler"
                    ]
                },
                {
                    "sense_id": "24244450-2f7c-3fa7-8852-aa408e80052b",
                    "sense_definition": "Découvrir des pièces d'artillerie jusque-là dissimulées afin de les mettre en état de faire feu.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artillerie a reçu l'ordre de <w>démasquer</w> une batterie de canons sur la colline."
                        },
                        {
                            "text": "Les troupes ont soudain <w>démasqué</w> leurs mitrailleuses pour repousser l'assaut."
                        }
                    ],
                    "common_phrases": [
                        "démasquer une batterie"
                    ]
                }
            ]
        }
    ]
