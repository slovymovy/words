                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a sad fact that many marriages are now <w>divorced</w>.",
                            "target_lang_translations": {
                                "ru": "Печальный факт, что многие браки сейчас <w>расторгаются</w>.",
                                "zh": "一个令人悲伤的事实是，现在许多婚姻都已<w>解除</w>。",
                                "nl": "Het is een triest feit dat veel huwelijken tegenwoordig worden <w>ontbonden</w>.",
                                "pl": "Smutnym faktem jest to, że wiele małżeństw jest obecnie <w>rozwiązanych</w>.",
                                "de": "Es ist eine traurige Tatsache, dass viele Ehen heute <w>geschieden</w> werden.",
                                "fr": "C'est un triste fait que de nombreux mariages sont désormais <w>dissous</w>.",
                                "it": "È un triste fatto che molti matrimoni siano ormai <w>sciolti</w>.",
                                "cs": "Je smutným faktem, že mnoho manželství je dnes <w>rozvedených</w>.",
                                "tr": "Üzücü bir gerçek ki, günümüzde birçok evlilik <w>feshediliyor</w>.",
                                "es": "Es un hecho triste que muchos matrimonios ahora estén <w>disueltos</w>."
                            }
                        },
                        {
                            "text": "Once the union is <w>divorced</w>, the assets must be divided.",
                            "target_lang_translations": {
                                "ru": "Как только союз <w>расторгнут</w>, активы должны быть разделены.",
                                "zh": "一旦婚姻关系<w>解除</w>，资产就必须进行分割。",
                                "nl": "Zodra het huwelijk is <w>ontbonden</w>, moeten de bezittingen worden verdeeld.",
                                "pl": "Gdy związek zostanie <w>rozwiązany</w>, majątek musi zostać podzielony.",
                                "de": "Sobald die Ehe <w>geschieden</w> ist, muss das Vermögen aufgeteilt werden.",
                                "fr": "Une fois l'union <w>dissoute</w>, les actifs doivent être partagés.",
                                "it": "Una volta che l'unione è <w>sciolta</w>, i beni devono essere divisi.",
                                "cs": "Jakmile je svazek <w>rozveden</w>, majetek musí být rozdělen.",
                                "tr": "Birlik <w>feshedildiğinde</w>, varlıklar paylaştırılmalıdır.",
                                "es": "Una vez que la unión es <w>disuelta</w>, los bienes deben dividirse."
                            }
                        }
