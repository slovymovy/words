                                        "sense_id": "6cf3253f-49d1-3108-a83a-c818b56211b9",
                                        "entry_id": "e1798e60-1a72-3f70-a3e0-42fd9a7b35a5",
                                        "glosses": [
                                            "Having or demonstrating undivided and constant support for someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e24a5654-a04f-44e1-bf57-a3556557ddba",
                                                "sense_id": "6cf3253f-49d1-3108-a83a-c818b56211b9",
                                                "text": "Dogs are very loyal animals, which is why they make wonderful pets."
                                            },
                                            {
                                                "example_id": "74fd9687-0b82-4134-91d4-d5e01659e533",
                                                "sense_id": "6cf3253f-49d1-3108-a83a-c818b56211b9",
                                                "text": "George is a loyal and loving husband."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9775cc27-139c-3a00-ab09-5c761f28db71",
                                        "entry_id": "e1798e60-1a72-3f70-a3e0-42fd9a7b35a5",
                                        "glosses": [
                                            "Firm in allegiance to a person or institution; allegiant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e73da18-d1d4-34cb-8dfd-129f9ec46715",
                                        "entry_id": "e1798e60-1a72-3f70-a3e0-42fd9a7b35a5",
                                        "glosses": [
                                            "Faithful to a person or cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ba4a48-db8f-4820-8cf4-419567b420d0",
                                                "sense_id": "8e73da18-d1d4-34cb-8dfd-129f9ec46715",
                                                "text": "We must remain loyal to the mission."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a93a8f5-033d-4492-a7db-23f4871432c6",
                        "source_entry_id": "36ee0886-d6a3-3c3b-926d-65a3bf1e00c7",
