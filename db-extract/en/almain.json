                                "sense_id": "26f4f702-7b30-3bf4-ae09-f214646215a4",
                                "text": "The x. of Awgust Maximilian emperowr of Almayne came to kynge Henry of England besyde Terwen, and there the emperowre had wages of the kynge."
                            },
                            {
                                "example_id": "6992645b-917b-442c-b249-67298d1bba9d",
                                "sense_id": "26f4f702-7b30-3bf4-ae09-f214646215a4",
                                "text": "The merchants who owned the goods claimed that the King of Almain was the lord of the town, and the Bishop could not do justice in the matter."
                            }
                        ]
                    }
