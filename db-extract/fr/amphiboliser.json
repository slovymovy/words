                "senses": [
                    {
                        "sense_id": "b0fdc939-aec8-3b50-98c4-8913d8b3dc4d",
                        "entry_id": "68ba1a6f-eae4-39e5-950d-7c050317e0f1",
                        "glosses": [
                            "Donner un caractère amphibolique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf92d71-9580-42d7-a852-7abaee452af8",
                                "sense_id": "b0fdc939-aec8-3b50-98c4-8913d8b3dc4d",
                                "text": "Car le secret du tawhîd qu’il faut découvrir, c’est le vêtement recouvrant la condition divine par lequel l’âme de l’âme (l’Aimé au sens réel) s’amphibolise."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f0b8c7d-d2a1-3e1f-9fc9-24c99b9a8603",
                        "entry_id": "68ba1a6f-eae4-39e5-950d-7c050317e0f1",
                        "glosses": [
                            "Donner un caractère amphibolique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca5b609b-1d9f-4f5e-90d7-ff940a8eff74",
                                "sense_id": "3f0b8c7d-d2a1-3e1f-9fc9-24c99b9a8603",
                                "text": "Comme il leur confère en même temps un certain degré d’immunité, on peut donc dire que le sérum anticobraïque amphibolise les animaux auxquels on l’injecte."
                            }
                        ]
                    },
                    {
                        "sense_id": "95e296b2-d07c-3b3b-b318-c653c308f421",
                        "entry_id": "68ba1a6f-eae4-39e5-950d-7c050317e0f1",
                        "glosses": [
                            "Donner un caractère amphibolique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69270f2f-ea26-4eb4-96bf-ff2fd7b5964e",
                                "sense_id": "95e296b2-d07c-3b3b-b318-c653c308f421",
                                "text": "Ensuite, jusqu’au Martoulet, la route traverse un grand massif de leptynite, fortement amphibolisé, surtout vers le sud."
                            }
                        ]
                    }
                ],
