                "translations": [
                    {
                        "translation_id": "d0a6b789-31ea-480d-99fc-20c960890fe5",
                        "source_entry_id": "22516b87-109a-3632-a395-78156147821a",
                        "source_sense_id": "e347ece4-0835-311e-a88b-2d75b7ac2c46",
                        "target_lang_word": "jerrycan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jerrycan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6972db71-98c4-3c3a-9d9f-bee287e7d4c1",
                                        "entry_id": "231e9293-cb2e-3d4e-842a-d7e54ff3814c",
                                        "glosses": [
                                            "A robust container for fuel or water, of a certain more or less rectangular shape, often made from pressed steel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13eae70-f603-4a5d-8f4c-6af96f03774b",
                                                "sense_id": "6972db71-98c4-3c3a-9d9f-bee287e7d4c1",
                                                "text": "The police fell back, swatting and cursing. At the gateway, somebody grabbed a jerrycan of water from Jonamon's hut and flung its contents at the swarm."
                                            },
                                            {
                                                "example_id": "5ea24a51-fb18-423f-bcf8-0d3e3c8e9282",
                                                "sense_id": "6972db71-98c4-3c3a-9d9f-bee287e7d4c1",
                                                "text": "Anyone with half a brain and a jerrycan of fertilizer's got an army."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1737eedf-3443-40fe-b7eb-1a799a4e6617",
                        "source_entry_id": "22516b87-109a-3632-a395-78156147821a",
                        "source_sense_id": "e347ece4-0835-311e-a88b-2d75b7ac2c46",
                        "target_lang_word": "kanystr",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kanystr",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2c2ed7a8-be46-3e13-b901-ee1dfff5a392",
                                        "entry_id": "5fcffa99-ebb2-301d-bdc3-ca8fcd509882",
                                        "glosses": [
                                            "nádoba na palivo s uzávěrem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea423b66-294c-4f67-8501-8b7e651812b3",
                                                "sense_id": "2c2ed7a8-be46-3e13-b901-ee1dfff5a392",
                                                "text": "Několik výtržníků vzalo z vojenského auta stojícího před budovou kanystr s benzínem, další skupina výtržníků převrátila osobní vůz zn. Gaz ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48ad4e51-114e-4ba4-9237-50f328bd9416",
                        "source_entry_id": "22516b87-109a-3632-a395-78156147821a",
                        "source_sense_id": "e347ece4-0835-311e-a88b-2d75b7ac2c46",
                        "target_lang_word": "Kanister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9ef15ac-c7da-3682-a12b-9483fdbcb1a5",
                                        "entry_id": "e1a18715-575a-38be-9c72-e9ba6d167fe6",
                                        "glosses": [
                                            "verschließbarer, oftmals eckiger Behälter, der zum Transport und zur Aufbewahrung von Flüssigkeiten (Wasser, Öl, Treibstoff) benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c885fc-e2b1-4b65-ad2c-a706710edbed",
                                                "sense_id": "d9ef15ac-c7da-3682-a12b-9483fdbcb1a5",
                                                "text": "Manche Deutsche fahren mit Kanistern über die Grenze, wenn das Benzin in den Nachbarländern billiger ist."
                                            },
                                            {
                                                "example_id": "a318e438-8260-41bc-9582-d19230717784",
                                                "sense_id": "d9ef15ac-c7da-3682-a12b-9483fdbcb1a5",
                                                "text": "Bei den im Sommer dieses Jahres festgenommenen mutmaßlichen Terroristen in Baden-Württemberg wurden unter anderem zwölf Kanister Wasserstoffperoxid sicher gestellt."
                                            },
                                            {
                                                "example_id": "e5460e61-1810-495c-a98a-5ff20d354545",
                                                "sense_id": "d9ef15ac-c7da-3682-a12b-9483fdbcb1a5",
                                                "text": "Was nichts daran ändert, dass die Kinder weiterhin viel körperliche Arbeit verrichten müssen, morgens vor der Schule schleppen sie schwere Kanister von der Wasserstelle nach Hause, am Nachmittag hüten sie die Kühe und Ziegen."
                                            },
                                            {
                                                "example_id": "06150dea-81c5-4a2b-984a-7078241e5e5e",
                                                "sense_id": "d9ef15ac-c7da-3682-a12b-9483fdbcb1a5",
                                                "text": "Die Mädchen schütten einen Kanister Benzin über sich und zünden sich einfach an."
                                            },
                                            {
                                                "example_id": "8c6dc2fb-7457-4fff-94fd-615066c564a5",
                                                "sense_id": "d9ef15ac-c7da-3682-a12b-9483fdbcb1a5",
                                                "text": "„In Gedanken ist sie bei dem Kanister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97020c02-95e5-488f-a675-672464b7a72a",
                        "source_entry_id": "22516b87-109a-3632-a395-78156147821a",
                        "source_sense_id": "e347ece4-0835-311e-a88b-2d75b7ac2c46",
                        "target_lang_word": "Benzinkanister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Benzinkanister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                        "entry_id": "c2815bf3-9276-3487-8758-3a0b2a0279fc",
                                        "glosses": [
                                            "verschließbarer Behälter, meist aus Blech oder Plastik, der zum Transport und Aufbewahren von Benzin benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5490390b-00cc-4301-a9b6-c4debe5ca287",
                                                "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                                "text": "Der Benzinkanister ist leer."
                                            },
                                            {
                                                "example_id": "1e22ecf6-119b-4026-b9f4-3b747d2e2ac6",
                                                "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                                "text": "„Es fanden sich Berge von grünen Benzinkanistern.“"
                                            },
                                            {
                                                "example_id": "c56a57a6-6137-4f83-933c-329bb0b25b53",
                                                "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                                "text": "„Einmal die Woche hatte sie das schwere Gerät über die Straße hinter sich hergezogen, und manchmal hatte sie einen roten Benzinkanister dabeigehabt.“"
                                            },
                                            {
                                                "example_id": "712002fd-8576-4732-a16b-3abfdfdbbcdf",
                                                "sense_id": "b0bc49fe-7712-3835-ab21-f630b2da3f6d",
                                                "text": "„Autoreifen, Benzinkanister und Zigarettenkartons lagen herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37c39e52-8d10-439e-afbf-5a45db7fef07",
                        "source_entry_id": "22516b87-109a-3632-a395-78156147821a",
                        "source_sense_id": "e347ece4-0835-311e-a88b-2d75b7ac2c46",
